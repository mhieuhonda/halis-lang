# ============================================================================
# tools/hlserve_hmr_client.hls — the HMR client snippet, in Halis (the
# byte-faithful twin of hlserve_overlay.py's OVERLAY_SNIPPET: the
# self-contained CSS+JS the dev server injects before </body> — the
# WebSocket client, the error overlay and the status banner, exactly
# as the Python years shipped them).
# ============================================================================

fn sv_overlay_snippet() -> str {
    return     "<script id=\"hlserve-hmr-client\">\n" +
    "(function(){\n" +
    "  if (window.__HLSERVE_HMR__) return; // already loaded\n" +
    "  window.__HLSERVE_HMR__ = true;\n" +
    "  var PROTO_VERSION = 1;\n" +
    "  var wsUrl = (location.protocol === \"https:\" ? \"wss://\" : \"ws://\")\n" +
    "            + location.host + \"/ws\";\n" +
    "  var overlay = null;\n" +
    "  var bannerEl = null;\n" +
    "  var statsEl = null;\n" +
    "  var lastErrors = null;\n" +
    "  var client_id = null;\n" +
    "\n" +
    "  function ensureOverlay() {\n" +
    "    if (overlay) return overlay;\n" +
    "    overlay = document.createElement(\"div\");\n" +
    "    overlay.id = \"hlserve-overlay\";\n" +
    "    overlay.style.cssText = [\n" +
    "      \"position:fixed\",\"top:0\",\"left:0\",\"right:0\",\"bottom:0\",\n" +
    "      \"z-index:2147483647\",\"background:rgba(40,0,0,0.92)\",\n" +
    "      \"color:#fdd\",\"font-family:Menlo,Consolas,monospace\",\n" +
    "      \"font-size:14px\",\"padding:24px 32px\",\n" +
    "      \"overflow:auto\",\"display:none\",\n" +
    "      \"box-sizing:border-box\",\"line-height:1.5\"\n" +
    "    ].join(\";\");\n" +
    "    var h = document.createElement(\"div\");\n" +
    "    h.style.cssText = \"font-weight:bold;color:#fff;font-size:18px;\"\n" +
    "                    + \"margin-bottom:12px;border-bottom:1px solid #800;\"\n" +
    "                    + \"padding-bottom:8px;\";\n" +
    "    h.textContent = \"hls-serve — compile errors\";\n" +
    "    overlay.appendChild(h);\n" +
    "    var close = document.createElement(\"button\");\n" +
    "    close.textContent = \"x\";\n" +
    "    close.style.cssText = \"position:fixed;top:24px;right:32px;\"\n" +
    "        + \"background:#400;color:#fdd;border:1px solid #800;\"\n" +
    "        + \"padding:4px 10px;cursor:pointer;font-size:14px;\";\n" +
    "    close.onclick = function(){ overlay.style.display = \"none\"; };\n" +
    "    overlay.appendChild(close);\n" +
    "    var body = document.createElement(\"div\");\n" +
    "    body.id = \"hlserve-overlay-body\";\n" +
    "    overlay.appendChild(body);\n" +
    "    document.body.appendChild(overlay);\n" +
    "    return overlay;\n" +
    "  }\n" +
    "\n" +
    "  function ensureStatsBar() {\n" +
    "    if (statsEl) return statsEl;\n" +
    "    statsEl = document.createElement(\"div\");\n" +
    "    statsEl.id = \"hlserve-stats\";\n" +
    "    statsEl.style.cssText = [\n" +
    "      \"position:fixed\",\"bottom:0\",\"right:0\",\"z-index:2147483646\",\n" +
    "      \"background:rgba(0,40,0,0.9)\",\"color:#afa\",\"font-family:Menlo,\"\n" +
    "      + \"Consolas,monospace\",\"font-size:12px\",\"padding:4px 10px\",\n" +
    "      \"border-top-left-radius:6px\",\"max-width:50vw\",\"overflow:hidden\",\n" +
    "      \"white-space:nowrap\",\"text-overflow:ellipsis\",\"pointer-events:none\"\n" +
    "    ].join(\";\");\n" +
    "    statsEl.textContent = \"hls-serve: connecting…\";\n" +
    "    document.body.appendChild(statsEl);\n" +
    "    return statsEl;\n" +
    "  }\n" +
    "\n" +
    "  function showOverlay(errors) {\n" +
    "    var o = ensureOverlay();\n" +
    "    var body = document.getElementById(\"hlserve-overlay-body\");\n" +
    "    body.innerHTML = \"\";\n" +
    "    errors.forEach(function(e){\n" +
    "      var d = document.createElement(\"div\");\n" +
    "      d.style.cssText = \"margin-bottom:12px;padding:8px 0;\"\n" +
    "                      + \"border-bottom:1px dotted #800;\";\n" +
    "      var sev = (e.severity || \"error\").toUpperCase();\n" +
    "      var sevColor = sev === \"ERROR\" ? \"#f88\" :\n" +
    "                     sev === \"WARNING\" ? \"#fc8\" : \"#8cf\";\n" +
    "      var head = document.createElement(\"div\");\n" +
    "      head.innerHTML = \"<span style=\\\"color:\" + sevColor + \";\"\n" +
    "        + \"font-weight:bold;\\\">\" + sev + \"</span> \"\n" +
    "        + \"<span style=\\\"color:#fff;\\\">\" + (e.file || \"(no file)\")\n" +
    "        + \"</span>\"\n" +
    "        + (e.line ? \"<span style=\\\"color:#aaf;\\\">:\" + e.line\n" +
    "                  + (e.col ? \":\" + e.col : \"\") + \"</span>\" : \"\");\n" +
    "      d.appendChild(head);\n" +
    "      var msg = document.createElement(\"div\");\n" +
    "      msg.style.cssText = \"margin-left:16px;margin-top:4px;color:#fdd;\";\n" +
    "      msg.textContent = e.message || \"(no message)\";\n" +
    "      d.appendChild(msg);\n" +
    "      body.appendChild(d);\n" +
    "    });\n" +
    "    o.style.display = \"block\";\n" +
    "  }\n" +
    "\n" +
    "  function hideOverlay() {\n" +
    "    if (overlay) overlay.style.display = \"none\";\n" +
    "  }\n" +
    "\n" +
    "  function setStats(text, color) {\n" +
    "    ensureStatsBar();\n" +
    "    statsEl.textContent = \"hls-serve: \" + text;\n" +
    "    statsEl.style.background = \"rgba(\" + (color || \"0,40,0\") + \",0.9)\";\n" +
    "  }\n" +
    "\n" +
    "  function applyErrors(payload) {\n" +
    "    lastErrors = payload;\n" +
    "    var errs = (payload && payload.errors) || [];\n" +
    "    var real = errs.filter(function(e){\n" +
    "      return (e.severity || \"error\") === \"error\";\n" +
    "    });\n" +
    "    if (real.length > 0) {\n" +
    "      showOverlay(real);\n" +
    "      setStats(real.length + \" error(s)\", \"40,0,0\");\n" +
    "    } else if (errs.length > 0) {\n" +
    "      setStats(errs.length + \" warning(s)\", \"40,30,0\");\n" +
    "    }\n" +
    "  }\n" +
    "\n" +
    "  function applyOk(payload) {\n" +
    "    hideOverlay();\n" +
    "    var stats = payload.stats || {};\n" +
    "    var wasmKB = (stats.wasm_bytes || 0) / 1024;\n" +
    "    wasmKB = wasmKB.toFixed(1);\n" +
    "    var jsKB = (stats.js_bytes || 0) / 1024;\n" +
    "    jsKB = jsKB.toFixed(1);\n" +
    "    setStats(\"ok | wasm \" + wasmKB + \" KB | js \" + jsKB + \" KB | \"\n" +
    "             + (stats.elapsed_ms || 0) + \" ms\");\n" +
    "  }\n" +
    "\n" +
    "  function hotReload(wasmUrl) {\n" +
    "    // Re-fetch the wasm module and re-instantiate the existing Halis\n" +
    "    // instance. Preserves all JS-side state.\n" +
    "    if (typeof Halis === \"undefined\" || !Halis.__instance) {\n" +
    "      // Can't hot-swap; fall back to full reload.\n" +
    "      location.reload();\n" +
    "      return;\n" +
    "    }\n" +
    "    fetch(wasmUrl, {cache: \"no-store\"})\n" +
    "      .then(function(r){ return r.arrayBuffer(); })\n" +
    "      .then(function(buf){\n" +
    "        var bytes = new Uint8Array(buf);\n" +
    "        if (Halis.hotReload) {\n" +
    "          return Halis.hotReload(bytes);\n" +
    "        }\n" +
    "        // Fall back: full re-instantiation with the same imports.\n" +
    "        return Halis.__instance.instantiate(bytes, Halis.__imports || {});\n" +
    "      })\n" +
    "      .then(function(){\n" +
    "        setStats(\"hot-reloaded\", \"0,40,0\");\n" +
    "      })\n" +
    "      .catch(function(e){\n" +
    "        // Hot reload failed; fall back to full page reload.\n" +
    "        setStats(\"hot-reload failed: \" + e.message, \"40,0,0\");\n" +
    "        setTimeout(function(){ location.reload(); }, 500);\n" +
    "      });\n" +
    "  }\n" +
    "\n" +
    "  // Console forwarder: hook console.log/warn/error and forward to WS.\n" +
    "  function forwardConsole(method, ws_level) {\n" +
    "    var orig = console[method] ? console[method].bind(console) : null;\n" +
    "    console[method] = function(){\n" +
    "      try {\n" +
    "        if (ws && ws.readyState === 1) {\n" +
    "          var args = Array.prototype.slice.call(arguments).map(function(a){\n" +
    "            try { return typeof a === \"string\" ? a : JSON.stringify(a); }\n" +
    "            catch(_) { return String(a); }\n" +
    "          });\n" +
    "          ws.send(JSON.stringify({type:\"log\", level:ws_level, args:args}));\n" +
    "        }\n" +
    "      } catch(_) {}\n" +
    "      if (orig) orig.apply(console, arguments);\n" +
    "    };\n" +
    "  }\n" +
    "\n" +
    "  var ws = null;\n" +
    "  function connect() {\n" +
    "    try { ws = new WebSocket(wsUrl); }\n" +
    "    catch(e) { setTimeout(connect, 2000); return; }\n" +
    "    ws.onopen = function(){\n" +
    "      ensureStatsBar();\n" +
    "      setStats(\"connected\");\n" +
    "      try {\n" +
    "        ws.send(JSON.stringify({type:\"identify\", client:\"browser\",\n" +
    "                                id: Math.random().toString(36).slice(2)}));\n" +
    "      } catch(_) {}\n" +
    "    };\n" +
    "    ws.onmessage = function(ev){\n" +
    "      var msg;\n" +
    "      try { msg = JSON.parse(ev.data); } catch(_) { return; }\n" +
    "      if (msg.version && msg.version !== PROTO_VERSION) {\n" +
    "        setStats(\"proto mismatch (server v\" + msg.version + \")\", \"40,0,0\");\n" +
    "        return;\n" +
    "      }\n" +
    "      switch (msg.type) {\n" +
    "        case \"hello\":\n" +
    "          client_id = msg.client_id;\n" +
    "          break;\n" +
    "        case \"connected\":\n" +
    "          break;\n" +
    "        case \"ok\":\n" +
    "          applyOk(msg);\n" +
    "          break;\n" +
    "        case \"errors\":\n" +
    "          applyErrors(msg);\n" +
    "          break;\n" +
    "        case \"warnings\":\n" +
    "          break;\n" +
    "        case \"progress\":\n" +
    "          if (msg.phase && msg.percent != null) {\n" +
    "            setStats(msg.phase + \" \" + msg.percent + \"%\", \"0,30,40\");\n" +
    "          }\n" +
    "          break;\n" +
    "        case \"reload\":\n" +
    "          // Full reload: server-side reload (HTML change, glue change).\n" +
    "          location.reload();\n" +
    "          break;\n" +
    "        case \"hot-reload\":\n" +
    "          if (msg.wasm_url) hotReload(msg.wasm_url);\n" +
    "          break;\n" +
    "        case \"pong\":\n" +
    "          break;\n" +
    "      }\n" +
    "    };\n" +
    "    ws.onclose = function(){\n" +
    "      setStats(\"disconnected — retrying\", \"40,30,0\");\n" +
    "      setTimeout(connect, 1000);\n" +
    "    };\n" +
    "    ws.onerror = function(){\n" +
    "      try { ws.close(); } catch(_) {}\n" +
    "    };\n" +
    "  }\n" +
    "\n" +
    "  forwardConsole(\"log\", \"log\");\n" +
    "  forwardConsole(\"warn\", \"warn\");\n" +
    "  forwardConsole(\"error\", \"error\");\n" +
    "\n" +
    "  // Catch uncaught client errors.\n" +
    "  window.addEventListener(\"error\", function(ev){\n" +
    "    if (ws && ws.readyState === 1 && ev.message) {\n" +
    "      try {\n" +
    "        ws.send(JSON.stringify({type:\"error\", message: ev.message,\n" +
    "                                stack: ev.error && ev.error.stack\n" +
    "                                  ? ev.error.stack : \"\"}));\n" +
    "      } catch(_) {}\n" +
    "    }\n" +
    "  });\n" +
    "\n" +
    "  if (typeof WebSocket !== \"undefined\") {\n" +
    "    // Wait for DOMContentLoaded so document.body exists.\n" +
    "    if (document.readyState === \"loading\") {\n" +
    "      document.addEventListener(\"DOMContentLoaded\", connect);\n" +
    "    } else {\n" +
    "      connect();\n" +
    "    }\n" +
    "  }\n" +
    "})();\n" +
    "</script>\n" +
    ""
}
