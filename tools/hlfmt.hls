# ============================================================================
# hlfmt.hls — Stage 14 release: a minimal self-hosted HLS formatter.
# ----------------------------------------------------------------------------
# This file demonstrates that the Halis toolchain can self-host its own
# formatter. It implements a SUBSET of hlfmt.py's behaviour:
#   - reads a .hls file from argv[1]
#   - re-indents to canonical 4-space indent based on { } depth
#   - normalises leading whitespace
#   - preserves blank lines && `#` comments
#   - writes the formatted output to stdout (or argv[2] if given)
#
# Limitations vs the Python hlfmt.py:
#   - Does NOT preserve the full token-stream idempotency guarantees.
#   - Does NOT do binary-operator spacing normalization.
#   - String literals may be miscounted for brace tracking.
#
# Usage:
#   bin/hlc tools/hlfmt.hls bin/hlfmt.c
#   gcc -O2 -o bin/hlfmt bin/hlfmt.c -lm
#   bin/hlfmt input.hls [output.hls]
# ============================================================================

# Count the unmatched `{` braces in a line, ignoring those inside `"` strings.
# (HLS string literals are bytes — the lexer treats `"` as the delimiter.)
fn brace_delta(line: str) -> int {
    let mut delta: int = 0
    let mut i: int = 0
    let mut in_str: bool = false
    while i < line.len() {
        let c: int = line.byte_at(i)
        if in_str {
            if c == 34 {  # `"`
                in_str = false
            }
            i = i + 1
            continue
        }
        if c == 34 {
            in_str = true
            i = i + 1
            continue
        }
        if c == 35 {  # `#` — comment to end of line
            break
        }
        if c == 123 {  # `{`
            delta = delta + 1
        }
        if c == 125 {  # `}`
            delta = delta - 1
        }
        i = i + 1
    }
    return delta
}

# Strip leading whitespace from a line. Returns the line with no leading
# spaces or tabs.
fn lstrip(line: str) -> str {
    let mut i: int = 0
    while i < line.len() {
        let c: int = line.byte_at(i)
        if c != 32 && c != 9 {  # space or tab
            break
        }
        i = i + 1
    }
    if i == 0 {
        return line
    }
    return line.slice(i, line.len())
}

fn main() -> int uses IO {
    let argv: list[str] = args()
    if argv.len() < 2 {
        println("usage: hlfmt <input.hls> [output.hls]")
        return 1
    }
    let in_path: str = argv.get(1)
    let src: str = read_file(in_path)

    # Split on `\n`. The native runtime's str.split handles bytes.
    let lines: list[str] = src.split("\n")
    let mut depth: int = 0
    let mut i: int = 0
    let mut out_path: str = ""
    if argv.len() >= 3 {
        out_path = argv.get(2)
    }

    # Build the output incrementally — for stdout, print as we go; for
    # a file, accumulate into a buffer.
    let mut output: str = ""
    while i < lines.len() {
        let line: str = lines.get(i)
        let stripped: str = lstrip(line)
        # Skip the final empty line from the split (trailing newline).
        if i == lines.len() - 1 && stripped.len() == 0 {
            i = i + 1
            continue
        }
        # If the line starts with `}`, decrease depth BEFORE emitting.
        if stripped.len() > 0 && stripped.byte_at(0) == 125 {  # `}`
            depth = depth - 1
            if depth < 0 {
                depth = 0
            }
        }
        # Emit the line with the current indent + stripped content.
        let mut indent_str: str = ""
        let mut j: int = 0
        while j < depth {
            indent_str = indent_str + "    "
            j = j + 1
        }
        output = output + indent_str + stripped + "\n"
        # Update depth based on braces in this line.
        depth = depth + brace_delta(stripped)
        if depth < 0 {
            depth = 0
        }
        i = i + 1
    }

    if out_path.len() == 0 || out_path == "-" {
        print(output)
    } else {
        write_file(out_path, output)
        println("Wrote " + out_path)
    }
    return 0
}
