# ============================================================================
# tools/hlprove.hls — the Stage 17 proof assistant for Halis, in Halis.
# ----------------------------------------------------------------------------
# The native twin of tools/hlprove.py: one self-contained tool that drives
# the REAL front-end (tools/hlfront.hls — hl_load_crate + hl_check, the
# same lexer/parser/checker/proof fixpoint bin/hlc runs) and folds in the
# retired lab interpreter's analysis passes (tools.hlinterp.proof +
# tools.hlinterp.ffi_taint, ported over the native ExprN/StmtN pools).
#
# The modes, byte for byte the .py's own:
#
#   (default)  proof report — which panic checks the interval prover
#              proved dead per contracted function. The annotations are
#              the checker's own (src/hlc/proof.hls through hlfront —
#              the ONE definition, never re-implemented); the seeded
#              facts are the retired engine's, ported here because the
#              in-tree pass does not snapshot them for a report.
#   --smt      one SMT-LIB2 (.smt2) file per contracted function, the
#              QF_LIA bridge (str lengths abstracted to Int).
#   --z3       decide the bridge with the z3 BINARY on PATH; --cvc5 the
#              same with the cvc5 binary. One backend per run (asking
#              for both is a usage error, exit 2). Halis cannot import
#              python modules, so there is NO module fallback: with no
#              binary the mode degrades exactly the way the .py did
#              when neither binary nor module existed — nothing is
#              decided, the report says what to install.
#   --suggest-invariants / --infer-invariants / --shapes / --sidechannel
#   / --consttime / --taint — the .py's analysis modes, folded in over
#              the native AST.
#
# The laws (the .py's, kept):
#   - exit 0 on a clean report (analysis modes never fail a run);
#   - exit 1 on a violated #[ct] claim (after the full report is on the
#     screen — the verifier has teeth the audit lacks) and on a subject
#     that fails to parse or check ("compile error: ...");
#   - exit 2 on usage errors (no file, --z3 with --cvc5);
#   - every verdict is proven or refused with its reason; nothing is
#     ever claimed without a solver verdict behind it.
#
# Process shape: hl_check panics on a program that does not check, and
# the language has no exceptions — the front-end runs in a probe child
# that re-executes this binary with --probe-load <path> (the
# hls-audit / hllint pattern); the parent reads the exit code and maps
# a non-zero child to the .py's clean "compile error:" refusal.
# ============================================================================

import "./hlfront.hls"
import "std.str"

# ============================================================================
# Part 0 — the small shared helpers (padding, sorting, spawning, PATH).
# ============================================================================

# pad_left(s, w) — the %-28s convention of the .py's report lines.
fn pad_left(s: str, w: int) -> str {
    if s.len() >= w {
        return s
    }
    let mut out: str = s
    let mut n: int = s.len()
    while n < w {
        out = out + " "
        n = n + 1
    }
    return out
}

# sort_str_list(xs) — Python's sorted() over strings (bytewise <).
fn sort_str_list(xs: list[str]) -> list[str] {
    let mut out: list[str] = []
    let mut i: int = 0
    while i < xs.len() {
        let v: str = xs.get(i)
        let mut res: list[str] = []
        let mut placed: bool = false
        let mut j: int = 0
        while j < out.len() {
            if !placed && v < out.get(j) {
                res.push(v)
                placed = true
            }
            res.push(out.get(j))
            j = j + 1
        }
        if !placed {
            res.push(v)
        }
        out = res
        i = i + 1
    }
    return out
}

# list_has_str(xs, s) — membership.
fn list_has_str(xs: list[str], s: str) -> bool {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) == s {
            return true
        }
        i = i + 1
    }
    return false
}

# pv_join_str_list(xs, sep) — ", ".join(...) etc.
fn pv_join_str_list(xs: list[str], sep: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < xs.len() {
        if i > 0 {
            out = out + sep
        }
        out = out + xs.get(i)
        i = i + 1
    }
    return out
}

# py_mod(a, b) — Python's floor modulo (b > 0): the .py's % in the
# modular-candidate text renders non-negative residues.
fn py_mod(a: int, b: int) -> int {
    if b == 0 {
        return 0
    }
    let r: int = a % b
    if r < 0 {
        return r + b
    }
    return r
}

# pv_upper(s) — Python's str.upper() over the ASCII range (the report
# kinds are ASCII lowercase; the language has no .upper(), std.str's
# str_to_upper_ascii is the law).
fn pv_upper(s: str) -> str {
    return str_to_upper_ascii(s)
}

# ----------------------------------------------------------------------------
# Child plumbing — spawn, drain both pipes, wait (hllint's run_child).
# ----------------------------------------------------------------------------

struct RunRes {
    code: int, # -1: the spawn itself failed
    out: str,
    err: str,
    spawned: bool
}

fn run_child(argv: list[str]) -> RunRes uses Proc {
    let r: RunRes = RunRes {
        code: -1, out: "", err: "", spawned: false
    }
    if argv.len() == 0 {
        return r
    }
    # proc_spawn's args list becomes the child's argv[1..] — the
    # program travels as the FIRST parameter, separately, so the list
    # handed to it must NOT repeat argv[0] (hlwasm's convention; the
    # hllint years let the duplicate ride because their child scanned
    # for its mode flag at any position — a solver binary would have
    # taken the stray copy for an input file).
    let rest: list[str] = []
    let mut ai: int = 1
    while ai < argv.len() {
        rest.push(argv.get(ai))
        ai = ai + 1
    }
    let pid: int = proc_spawn(argv.get(0), rest, 0, 1, 1)
    if pid < 1 {
        return r
    }
    r.spawned = true
    let mut out: str = ""
    let mut chunk: str = proc_child_read(pid, 1, 65536)
    while chunk != "" {
        out = out + chunk
        chunk = proc_child_read(pid, 1, 65536)
    }
    let mut err: str = ""
    let mut chunk2: str = proc_child_read(pid, 2, 65536)
    while chunk2 != "" {
        err = err + chunk2
        chunk2 = proc_child_read(pid, 2, 65536)
    }
    r.code = proc_wait(pid)
    proc_child_close(pid, 1)
    proc_child_close(pid, 2)
    r.out = out
    r.err = err
    return r
}

# self_path() — the running binary's own path (args()[0]).
fn self_path() -> str uses Args {
    let a: list[str] = args()
    if a.len() == 0 {
        return ""
    }
    return a.get(0)
}

# which_hit(name) — the first PATH entry holding `name`, "" when absent
# (the harness's which(): a regular file in a PATH directory).
fn which_hit(name: str) -> str uses Fs, Proc {
    if name == "" || name.contains("/") {
        return ""
    }
    let penv: str = env_get("PATH")
    if penv == "" {
        return ""
    }
    let dirs: list[str] = penv.split(":")
    let mut i: int = 0
    while i < dirs.len() {
        let mut cand: str = dirs.get(i)
        if cand == "" {
            cand = "."
        }
        let full: str = cand + "/" + name
        if file_exists(full) {
            return full
        }
        i = i + 1
    }
    return ""
}

# first_err_line(err) — a probe's panic text: the first non-empty stderr
# line minus the "panic: " prefix and the compiler's leading
# "syntax error: " / "lex error: " / "type error: " classifier (the
# interpreter-era HLError the .py printed carried neither wrapper —
# hllint's panic_text law, word for word).
fn first_err_line(err: str) -> str {
    let lines: list[str] = err.split("\n")
    let mut t: str = ""
    let mut i: int = 0
    while i < lines.len() {
        let c: str = lines.get(i).trim()
        if c != "" {
            t = c
            break
        }
        i = i + 1
    }
    if t.starts_with("panic: ") {
        t = t.slice(7, t.len())
    }
    if t.starts_with("syntax error: ") {
        return t.slice(14, t.len())
    }
    if t.starts_with("lex error: ") {
        return t.slice(11, t.len())
    }
    if t.starts_with("type error: ") {
        return t.slice(12, t.len())
    }
    return t
}

# ----------------------------------------------------------------------------
# Temp files for the deciders (the .py's tempfile.NamedTemporaryFile):
# /tmp/hlprove-<pid>-<seq>.smt2, removed after every decide (the .py's
# os.unlink in a finally block).
# ----------------------------------------------------------------------------

fn tmp_seq_next() -> int uses Clock {
    let n: int = clock_ms() % 1000000
    return n
}

fn tmp_name(seq: int) -> str uses Proc {
    return "/tmp/hlprove-" + proc_pid().to_str() + "-" + seq.to_str() + ".smt2"
}

fn rm_file(path: str) -> void uses Proc {
    if path == "" {
        return
    }
    let r: RunRes = run_child(["rm", "-f", path])
    if !r.spawned {
        return
    }
}

# ----------------------------------------------------------------------------
# Python's os.path trio, for the --smt output dir (the .py's
# `os.path.dirname(os.path.abspath(path)) or "."`): abspath is the cwd
# join plus the LEXICAL normpath (no symlink knowledge — hls-tlog's
# law), dirname is everything above the last slash.
# ----------------------------------------------------------------------------

fn pv_path_is_abs(p: str) -> bool {
    if p.len() == 0 {
        return false
    }
    return p.byte_at(0) == 47
}

fn pv_path_dirname(p: str) -> str {
    let n: int = p.len()
    if n == 0 {
        return "."
    }
    let mut k: int = n - 1
    while k > 0 && p.byte_at(k) == 47 {
        k = k - 1
    }
    while k >= 0 {
        if p.byte_at(k) == 47 {
            if k == 0 {
                return "/"
            }
            return p.slice(0, k)
        }
        k = k - 1
    }
    return "."
}

# pv_normpath(p) — the lexical normpath: drop empty and "." components,
# cancel ".." against what came before (kept at the head of a relative
# path with nothing to cancel against).
fn pv_normpath(p: str) -> str {
    if p == "" {
        return "."
    }
    let abs: bool = pv_path_is_abs(p)
    let comps: list[str] = p.split("/")
    let out: list[str] = []
    let mut i: int = 0
    while i < comps.len() {
        let c: str = comps.get(i)
        if c == "" || c == "." {
            i = i + 1
            continue
        }
        if c == ".." {
            if out.len() > 0 && out.get(out.len() - 1) != ".." {
                out.pop()
            } else if !abs {
                out.push("..")
            }
            i = i + 1
            continue
        }
        out.push(c)
        i = i + 1
    }
    if out.len() == 0 {
        if abs {
            return "/"
        }
        return "."
    }
    let mut r: str = ""
    if abs {
        r = "/"
    }
    let mut j: int = 0
    while j < out.len() {
        r = r + out.get(j)
        if j + 1 < out.len() {
            r = r + "/"
        }
        j = j + 1
    }
    return r
}

# pv_abspath(p) — os.path.abspath: the cwd join, then the lexical norm.
fn pv_abspath(p: str) -> str uses Proc {
    let mut raw: str = p
    if !pv_path_is_abs(raw) {
        raw = cwd_get() + "/" + raw
    }
    return pv_normpath(raw)
}

# pv_out_dir(path) — dirname(abspath(path)) or "." (the .py's law).
fn pv_out_dir(path: str) -> str uses Proc {
    let d: str = pv_path_dirname(pv_abspath(path))
    if d == "" {
        return "."
    }
    return d
}

# ============================================================================
# Part 1 — the usage doc (the .py's module docstring, byte for byte) and
# the CLI parsing.
# ============================================================================

fn usage_doc() -> str {
    return "hlprove — the Stage 17 proof assistant for Halis (HLS).\n"
    + "\n"
    + "Usage:\n"
    + "  python3 tools/hlprove.py <file.hls> [--fast] [--smt] [--z3] [--cvc5]\n"
    + "                            [--suggest-invariants] [--infer-invariants]\n"
    + "                            [--shapes]\n"
    + "\n"
    + "Modes:\n"
    + "  (default)  proof report — which panic checks the interval prover\n"
    + "             proved dead per contracted function (the SAME annotations\n"
    + "             the native codegen uses under `-O fast`).\n"
    + "  --smt      additionally write one SMT-LIB2 (.smt2) file per contracted\n"
    + "             function: a QF_LIA encoding of the contract (str lengths\n"
    + "             are abstracted to Int). The files are runnable by external\n"
    + "             z3 — the roadmap's \"SMT solver z3 via a bridge generated\n"
    + "             from HLS\".\n"
    + "  --z3       run z3 on each generated .smt2 (if a z3 binary is\n"
    + "             available) and report sat/unsat per query.\n"
    + "  --cvc5     Stage 99: the same bridge, decided by CVC5 instead —\n"
    + "             the cvc5 binary if present, else the cvc5 python module\n"
    + "             (pip install cvc5). Inference under --cvc5 reports its\n"
    + "             verdicts as cvc5-verified; --z3 and --cvc5 are mutually\n"
    + "             exclusive (one backend decides per run).\n"
    + "  --suggest-invariants\n"
    + "             scan every loop and suggest candidate invariants (loop\n"
    + "             header bounds for const for-ranges, the while condition as\n"
    + "             an invariant text, and the set of variables mutated in the\n"
    + "             body) — the automatic inference rule set from the roadmap.\n"
    + "  --infer-invariants\n"
    + "             Stage 97: SMT-based loop-invariant discovery. Every loop\n"
    + "             is summarised (entry facts, per-variable transition\n"
    + "             relation, condition), candidates are generated from\n"
    + "             templates, and an SMT solver decides initiation and\n"
    + "             preservation.\n"
    + "             Only solver-verified invariants are reported as inferred;\n"
    + "             failed candidates are reported with their failing\n"
    + "             obligation. With --smt, the verified obligations are also\n"
    + "             written as .smt2 files (one per loop). The deciding\n"
    + "             backend follows the mode flag: z3 by default, cvc5 under\n"
    + "             --cvc5 — both decide the SAME obligations, so a verdict\n"
    + "             must agree across them (the Stage 99 gate pins it).\n"
    + "  --shapes    Stage 100: the separation-logic fragment — heap shapes.\n"
    + "             Three reports per function: the heap FOOTPRINT (every\n"
    + "             list binding classified read/write over alias classes —\n"
    + "             assignment aliases, clone() is fresh, unknown provenance\n"
    + "             is the wildcard class), the SEPARATION verdicts\n"
    + "             (own(a) * own(b) — writes disjoint — proven from freshness\n"
    + "             evidence, refused with the reason otherwise: f(xs, xs)\n"
    + "             aliases the parameters, so separation is never assumed),\n"
    + "             and the cursor-loop SHAPE TRIPLES (lseg * cell * lseg):\n"
    + "             anchored on <cursor> op <root>.len() (or range(a,\n"
    + "             <root>.len())), an affine self-step, and a frame check\n"
    + "             with teeth — every write through the anchor's alias class\n"
    + "             must be the cursor cell and no push/pop may touch it (the\n"
    + "             check that justifies treating len as loop-invariant in the\n"
    + "             obligations). Initiation and preservation are decided by\n"
    + "             the same backend as the invariants (z3, or cvc5 under\n"
    + "             --cvc5); with no solver the candidates are reported\n"
    + "             UNVERIFIED and nothing is claimed. Analysis-only: no\n"
    + "             compilation unit changes, interpreter and native binaries\n"
    + "             agree byte for byte.\n"
    + "  --sidechannel\n"
    + "             Stage 101: the cryptographic side-channel analysis. The\n"
    + "             #[secrets(...)] parameters are the taint roots; the pass\n"
    + "             tracks the marking through the bodies (assignment,\n"
    + "             arithmetic, calls — interprocedurally, by fixpoint) and\n"
    + "             reports every SINK where a secret becomes observable:\n"
    + "             branch / match on a secret-derived condition, memory\n"
    + "             access with a secret-dependent address (index, slice,\n"
    + "             map key), secret-decided loop bounds, and division/\n"
    + "             modulo with a secret operand. .len() on a secret value\n"
    + "             is public by policy — every use is counted and printed\n"
    + "             so the report states its assumption. Data-only flow\n"
    + "             (store, return, a call keeping the value internal) is\n"
    + "             never a leak — that is the point of the sink list.\n"
    + "  --consttime\n"
    + "             Stage 102: the constant-time VERIFIER. Every fn marked\n"
    + "             #[ct] claims to be constant-time over every secret that\n"
    + "             reaches it; the claim is proven, not trusted. Each claim\n"
    + "             is discharged in its OWN taint universe — only that fn's\n"
    + "             #[secrets(...)] parameters are roots, the rest of the\n"
    + "             program starts public — so a leak in an unrelated marked\n"
    + "             fn can never violate a claim it has no part in. The\n"
    + "             verdict is per claim: VERIFIED (no secret-derived branch,\n"
    + "             address, loop bound or division anywhere the secrets\n"
    + "             reach — own body included, transitively) or VIOLATED,\n"
    + "             with the sink lines, the one-line why, and the incoming\n"
    + "             chain (caller -> callee, the parameter each hop travels\n"
    + "             as) so the violation is attributable. A violation makes\n"
    + "             the run exit 1 — the verifier has teeth the Stage 101\n"
    + "             analysis deliberately lacks.\n"
    + "  --taint    Stage 109: the FFI taint-flow report. First the census:\n"
    + "             every extern declaration, classified (#[taint_source] —\n"
    + "             every call result is typed tainted[ret];\n"
    + "             #[taint_sink(...)] — the declared sink parameters; or\n"
    + "             unmarked — the taint lattice TRUSTS the return, which is\n"
    + "             a decision an auditor should see). Then the flows, per\n"
    + "             fn: every #[taint_source] call site, every taint_unwrap\n"
    + "             escape with its provenance, every sanitizer cut, and\n"
    + "             every sink an unwrapped value reaches — the accepted-risk\n"
    + "             flows the hatch exists to name. Analysis-only (exit 0\n"
    + "             either way; the checker's rules are the teeth, this is\n"
    + "             the map)."
}

# ============================================================================
# Part 2 — the retired engine's facts, ported over the native AST.
# ----------------------------------------------------------------------------
# The .py's checker seeded per-fn interval facts (boot/proof.py's
# pv_seed_from_requires + propagate_stmts) and reported them; the in-tree
# proof pass computes the SAME intervals internally but keeps no report
# snapshot, so the engine's facts side lives here, over the native pools.
# Bounds mirror boot/proof.py exactly: numeric, unknown (-inf/+inf) and
# the symbolic `("len", owner, delta)` tuples, printed the Python way.
# ============================================================================

# One bound: numeric, unknown, or symbolic (var <= len(owner) + delta).
struct Bnd {
    inf: bool, # true = no info (-inf as lo, +inf as hi)
    sym: bool, # true = the symbolic ("len", owner, delta) tuple
    num: int, # numeric value (kind numeric)
    owner: str, # symbolic owner
    delta: int # symbolic delta
}

fn bnd_none() -> Bnd {
    return Bnd {
        inf: true, sym: false, num: 0, owner: "", delta: 0
    }
}

fn bnd_num(v: int) -> Bnd {
    return Bnd {
        inf: false, sym: false, num: v, owner: "", delta: 0
    }
}

fn bnd_sym(owner: str, delta: int) -> Bnd {
    return Bnd {
        inf: false, sym: true, num: 0, owner: owner, delta: delta
    }
}

# bnd_numeric(b) — a bound usable in arithmetic: None for unknown and
# symbolic (boot's _numeric_bound).
fn bnd_is_num(b: Bnd) -> bool {
    if b.inf || b.sym {
        return false
    }
    return true
}

# bnd_text(b, is_lo) — the str(Interval) rendering of one bound:
# -inf / +inf for unknown, the Python tuple repr for symbolic.
fn bnd_text(b: Bnd, is_lo: bool) -> str {
    if b.inf {
        if is_lo {
            return "-inf"
        }
        return "+inf"
    }
    if b.sym {
        return "('len', '" + b.owner + "', " + b.delta.to_str() + ")"
    }
    return b.num.to_str()
}

# The interval (boot's Interval: lo/hi with None = unbounded).
struct Iv {
    lo: Bnd,
    hi: Bnd
}

fn pv_iv_top() -> Iv {
    return Iv {
        lo: bnd_none(), hi: bnd_none()
    }
}

fn iv_of(lo_v: int, hi_v: int) -> Iv {
    return Iv {
        lo: bnd_num(lo_v), hi: bnd_num(hi_v)
    }
}

fn iv_is_const(a: Iv) -> bool {
    return bnd_is_num(a.lo) && bnd_is_num(a.hi) && a.lo.num == a.hi.num
}

# iv_text(a) — str(Interval): "[lo, hi]".
fn iv_text(a: Iv) -> str {
    return "[" + bnd_text(a.lo, true) + ", " + bnd_text(a.hi, false) + "]"
}

# pv_iv_add — boot's pv_iv_add (unknown/symbolic on either side stays unknown
# per bound).
fn pv_iv_add(a: Iv, b: Iv) -> Iv {
    let mut lo: Bnd = bnd_none()
    if bnd_is_num(a.lo) && bnd_is_num(b.lo) {
        lo = bnd_num(a.lo.num + b.lo.num)
    }
    let mut hi: Bnd = bnd_none()
    if bnd_is_num(a.hi) && bnd_is_num(b.hi) {
        hi = bnd_num(a.hi.num + b.hi.num)
    }
    return Iv {
        lo: lo, hi: hi
    }
}

fn pv_iv_sub(a: Iv, b: Iv) -> Iv {
    let mut lo: Bnd = bnd_none()
    if bnd_is_num(a.lo) && bnd_is_num(b.hi) {
        lo = bnd_num(a.lo.num - b.hi.num)
    }
    let mut hi: Bnd = bnd_none()
    if bnd_is_num(a.hi) && bnd_is_num(b.lo) {
        hi = bnd_num(a.hi.num - b.lo.num)
    }
    return Iv {
        lo: lo, hi: hi
    }
}

fn pv_iv_neg(a: Iv) -> Iv {
    let mut lo: Bnd = bnd_none()
    if bnd_is_num(a.hi) {
        lo = bnd_num(-a.hi.num)
    }
    let mut hi: Bnd = bnd_none()
    if bnd_is_num(a.lo) {
        hi = bnd_num(-a.lo.num)
    }
    return Iv {
        lo: lo, hi: hi
    }
}

# pv_iv_mul — boot's conservative corner product. A product that itself
# would overflow int64 collapses to TOP (the in-tree engine's guard;
# boot computed it in arbitrary precision — a documented divergence,
# sound either way: the bound only ever feeds `fits`, which rejects
# anything outside int64).
fn pv_iv_mul(a: Iv, b: Iv) -> Iv {
    if !bnd_is_num(a.lo) || !bnd_is_num(a.hi) || !bnd_is_num(b.lo)
    || !bnd_is_num(b.hi) {
        return pv_iv_top()
    }
    let c1: int = a.lo.num * b.lo.num
    let c2: int = a.lo.num * b.hi.num
    let c3: int = a.hi.num * b.lo.num
    let c4: int = a.hi.num * b.hi.num
    let mut lo_v: int = c1
    if c2 < lo_v {
        lo_v = c2
    }
    if c3 < lo_v {
        lo_v = c3
    }
    if c4 < lo_v {
        lo_v = c4
    }
    let mut hi_v: int = c1
    if c2 > hi_v {
        hi_v = c2
    }
    if c3 > hi_v {
        hi_v = c3
    }
    if c4 > hi_v {
        hi_v = c4
    }
    return iv_of(lo_v, hi_v)
}

# iv_join_vals — boot's iv_widen: the UNION of two intervals (min lo,
# max hi); unknown/symbolic stays unknown.
fn iv_join_vals(a: Iv, b: Iv) -> Iv {
    let mut lo: Bnd = bnd_none()
    if bnd_is_num(a.lo) && bnd_is_num(b.lo) {
        if b.lo.num < a.lo.num {
            lo = bnd_num(b.lo.num)
        } else {
            lo = bnd_num(a.lo.num)
        }
    }
    let mut hi: Bnd = bnd_none()
    if bnd_is_num(a.hi) && bnd_is_num(b.hi) {
        if b.hi.num > a.hi.num {
            hi = bnd_num(b.hi.num)
        } else {
            hi = bnd_num(a.hi.num)
        }
    }
    return Iv {
        lo: lo, hi: hi
    }
}

# pv_iv_contains — boot's _iv_contains: a contains b (symbolic: false).
fn pv_iv_contains(a: Iv, b: Iv) -> bool {
    if a.lo.sym || a.hi.sym || b.lo.sym || b.hi.sym {
        return false
    }
    let lo_ok: bool = a.lo.inf || (bnd_is_num(b.lo) && a.lo.num <= b.lo.num)
    let hi_ok: bool = a.hi.inf || (bnd_is_num(b.hi) && a.hi.num >= b.hi.num)
    if a.lo.inf {
        if !hi_ok {
            return false
        }
        return true
    }
    return lo_ok && hi_ok
}

# The facts state: boot's facts dict (ints + the NUL-keyed nz set and
# minlen map, re-structured — the data is the same).
struct Facts {
    ints: map[str, Iv],
    nz: list[str],
    minlen: map[str, int]
}

fn facts_new() -> Facts {
    return Facts {
        ints: map_new(), nz: [], minlen: map_new()
    }
}

fn facts_copy(f: Facts) -> Facts {
    let out: Facts = facts_new()
    let ks: list[str] = f.ints.keys()
    let mut i: int = 0
    while i < ks.len() {
        let v: Iv = f.ints.get_or(ks.get(i), pv_iv_top())
        out.ints.set(ks.get(i), Iv {
            lo: v.lo, hi: v.hi
        })
        i = i + 1
    }
    let mut j: int = 0
    while j < f.nz.len() {
        out.nz.push(f.nz.get(j))
        j = j + 1
    }
    let ms: list[str] = f.minlen.keys()
    let mut k: int = 0
    while k < ms.len() {
        out.minlen.set(ms.get(k), f.minlen.get_or(ms.get(k), 0))
        k = k + 1
    }
    return out
}

# facts_replace(dst, src) — dst.clear(); dst.update(src).
fn facts_replace(dst: Facts, src: Facts) -> void {
    dst.ints = map_new()
    dst.nz = []
    dst.minlen = map_new()
    let ks: list[str] = src.ints.keys()
    let mut i: int = 0
    while i < ks.len() {
        let v: Iv = src.ints.get_or(ks.get(i), pv_iv_top())
        dst.ints.set(ks.get(i), Iv {
            lo: v.lo, hi: v.hi
        })
        i = i + 1
    }
    let mut j: int = 0
    while j < src.nz.len() {
        dst.nz.push(src.nz.get(j))
        j = j + 1
    }
    let ms: list[str] = src.minlen.keys()
    let mut k: int = 0
    while k < ms.len() {
        dst.minlen.set(ms.get(k), src.minlen.get_or(ms.get(k), 0))
        k = k + 1
    }
}

# facts_drop_owner(f, tname) — boot's _drop_facts_for_owner: kill
# minlen[tname] and every symbolic bound that pointed at it.
fn facts_drop_owner(f: Facts, tname: str) -> void {
    if f.minlen.has(tname) {
        # rebuild without the key (maps have no delete)
        let fresh: map[str, int] = map_new()
        let ms: list[str] = f.minlen.keys()
        let mut i: int = 0
        while i < ms.len() {
            let mk: str = ms.get(i)
            if mk != tname {
                fresh.set(mk, f.minlen.get_or(mk, 0))
            }
            i = i + 1
        }
        f.minlen = fresh
    }
    let ks: list[str] = f.ints.keys()
    let mut j: int = 0
    while j < ks.len() {
        let key: str = ks.get(j)
        let v: Iv = f.ints.get_or(key, pv_iv_top())
        if v.hi.sym && v.hi.owner == tname {
            f.ints.set(key, Iv {
                lo: v.lo, hi: bnd_none()
            })
        }
        j = j + 1
    }
}

# nz_discard(f, name) — remove name from the nz set.
fn nz_discard(f: Facts, name: str) -> void {
    let fresh: list[str] = []
    let mut i: int = 0
    while i < f.nz.len() {
        if f.nz.get(i) != name {
            fresh.push(f.nz.get(i))
        }
        i = i + 1
    }
    f.nz = fresh
}

# facts_join(a, b) — boot's _join_facts: intervals union; a var missing
# on one side goes TOP; nz intersects; minlen takes the common min.
fn facts_join(a: Facts, b: Facts) -> Facts {
    let out: Facts = facts_new()
    let ka: list[str] = a.ints.keys()
    let kb: list[str] = b.ints.keys()
    let seen: list[str] = []
    let mut i: int = 0
    while i < ka.len() {
        let key: str = ka.get(i)
        if !list_has_str(seen, key) {
            seen.push(key)
        }
        i = i + 1
    }
    let mut j: int = 0
    while j < kb.len() {
        let key: str = kb.get(j)
        if !list_has_str(seen, key) {
            seen.push(key)
        }
        j = j + 1
    }
    let mut k: int = 0
    while k < seen.len() {
        let key: str = seen.get(k)
        let va: Iv = a.ints.get_or(key, pv_iv_top())
        let vb: Iv = b.ints.get_or(key, pv_iv_top())
        out.ints.set(key, iv_join_vals(va, vb))
        k = k + 1
    }
    # nz: the intersection (kept only when non-empty)
    let mut n: int = 0
    while n < a.nz.len() {
        if list_has_str(b.nz, a.nz.get(n)) && !list_has_str(out.nz, a.nz.get(n)) {
            out.nz.push(a.nz.get(n))
        }
        n = n + 1
    }
    # minlen: the common owners, min of the two
    let ma: list[str] = a.minlen.keys()
    let mut m: int = 0
    while m < ma.len() {
        let owner: str = ma.get(m)
        if b.minlen.has(owner) {
            let va2: int = a.minlen.get_or(owner, 0)
            let vb2: int = b.minlen.get_or(owner, 0)
            if va2 < vb2 {
                out.minlen.set(owner, va2)
            } else {
                out.minlen.set(owner, vb2)
            }
        }
        m = m + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# The seeding — boot's _seed_walk over the native contract expressions.
# ----------------------------------------------------------------------------

# is_len_call_e — len(x) call or x.len() method (post-check shapes).
fn is_len_call_e(ctx: Ctx, e: int) -> bool {
    if e < 0 {
        return false
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "call" && n.mkey == "len" && n.muser == false {
        return true
    }
    if n.kind == "method" && n.name == "len" && n.muser == false {
        return true
    }
    return false
}

# len_owner_e — the owner name of a len call ("?" when not an ident).
fn len_owner_e(ctx: Ctx, e: int) -> str {
    if e < 0 {
        return "?"
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "call" && n.mkey == "len" && n.muser == false {
        if n.args.len() == 1 {
            let a: ExprN = ctx.exprs[n.args.get(0)]
            if a.kind == "ident" {
                return a.name
            }
        }
    }
    if n.kind == "method" && n.name == "len" && n.muser == false {
        let t: ExprN = ctx.exprs[n.left]
        if t.kind == "ident" {
            return t.name
        }
    }
    return "?"
}

# int_param_of(f, name) — the name is an int param of f.
fn int_param_of(f: FnInfo, name: str) -> bool {
    let mut i: int = 0
    while i < f.params.len() {
        if f.params.get(i) == name && f.ptypes.get(i) == "int" {
            return true
        }
        i = i + 1
    }
    return false
}

# facts_refine(f, var, lo, hi) — boot's _refine: tighten facts[var] with
# one new bound pair. lo/hi are Bnd (none = no info). The merge laws:
# a no-info side keeps the old bound; a symbolic bound replaces a
# numeric one (boot's elif chain — a symbolic hi beats the numeric
# min); two numerics take max (lo) / min (hi).
fn facts_refine(f: Facts, var: str, lo: Bnd, hi: Bnd) -> void {
    let old: Iv = f.ints.get_or(var, pv_iv_top())
    let mut new_lo: Bnd = old.lo
    if !lo.inf {
        if old.lo.inf || old.lo.sym || lo.sym {
            new_lo = lo
        } else {
            if lo.num > old.lo.num {
                new_lo = lo
            }
        }
    }
    let mut new_hi: Bnd = old.hi
    if !hi.inf {
        if old.hi.inf || old.hi.sym || hi.sym {
            new_hi = hi
        } else {
            if hi.num < old.hi.num {
                new_hi = hi
            }
        }
    }
    f.ints.set(var, Iv {
        lo: new_lo, hi: new_hi
    })
}

# facts_refine_nz — the "excludes zero" path: boot recorded the wider
# fact in the nz set (an interval straddling zero cannot be tightened).
fn facts_refine_nz(f: Facts, var: str) -> void {
    if !list_has_str(f.nz, var) {
        f.nz.push(var)
    }
}

# pv_set_minlen — keep the MAXIMUM when merged.
fn pv_set_minlen(f: Facts, owner: str, k: int) -> void {
    if !f.minlen.has(owner) {
        f.minlen.set(owner, k)
        return
    }
    let cur: int = f.minlen.get_or(owner, 0)
    if k > cur {
        f.minlen.set(owner, k)
    }
}

# seed_bound_var — boot's _bound_var: apply `var OP k` (flipped when the
# var is on the right).
fn seed_bound_var(f: Facts, var: str, op: str, k: int, var_on_left: bool) -> void {
    let mut eff: str = op
    if !var_on_left {
        if op == "<" {
            eff = ">"
        } else if op == "<=" {
            eff = ">="
        } else if op == ">" {
            eff = "<"
        } else if op == ">=" {
            eff = "<="
        }
    }
    if eff == ">=" {
        facts_refine(f, var, bnd_num(k), bnd_none())
        return
    }
    if eff == ">" {
        facts_refine(f, var, bnd_num(k + 1), bnd_none())
        return
    }
    if eff == "<=" {
        facts_refine(f, var, bnd_none(), bnd_num(k))
        return
    }
    if eff == "<" {
        facts_refine(f, var, bnd_none(), bnd_num(k - 1))
        return
    }
    if eff == "==" {
        facts_refine(f, var, bnd_num(k), bnd_num(k))
        return
    }
    if eff == "!=" {
        if k == 0 {
            facts_refine_nz(f, var)
        }
    }
}

# seed_walk — one conjunct of a requires (or refinement pred) tree.
fn seed_walk(ctx: Ctx, e: int, f: FnInfo, facts: Facts) -> void {
    if e < 0 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "bin" && n.op == "&&" {
        seed_walk(ctx, n.left, f, facts)
        seed_walk(ctx, n.right, f, facts)
        return
    }
    if n.kind != "bin" {
        return
    }
    let op: str = n.op
    let l: int = n.left
    let r: int = n.right
    if l < 0 || r < 0 {
        return
    }
    let ln: ExprN = ctx.exprs[l]
    let rn: ExprN = ctx.exprs[r]
    # int-param vs int-literal (both orders)
    let li: bool = ln.kind == "ident" && int_param_of(f, ln.name)
    let ri: bool = rn.kind == "ident" && int_param_of(f, rn.name)
    if li && rn.kind == "int" {
        seed_bound_var(facts, ln.name, op, rn.ival, true)
        return
    }
    if ri && ln.kind == "int" {
        seed_bound_var(facts, rn.name, op, ln.ival, false)
        return
    }
    # var < s.len() / var <= s.len() (and the flipped forms)
    if li && is_len_call_e(ctx, r) {
        if op == "<" {
            facts_refine(facts, ln.name, bnd_none(), bnd_sym(len_owner_e(ctx, r), -1))
        } else if op == "<=" {
            facts_refine(facts, ln.name, bnd_none(), bnd_sym(len_owner_e(ctx, r), 0))
        }
        return
    }
    if ri && is_len_call_e(ctx, l) {
        if op == ">" {
            facts_refine(facts, rn.name, bnd_none(), bnd_sym(len_owner_e(ctx, l), -1))
        } else if op == ">=" {
            facts_refine(facts, rn.name, bnd_none(), bnd_sym(len_owner_e(ctx, l), 0))
        }
        return
    }
    # Minimum-length facts: s.len() >= k (either order)
    if op == ">=" || op == ">" || op == "<=" || op == "<" || op == "==" {
        # len on the left
        if is_len_call_e(ctx, l) && rn.kind == "int" {
            let owner: str = len_owner_e(ctx, l)
            let k: int = rn.ival
            if op == ">=" {
                pv_set_minlen(facts, owner, k)
            } else if op == ">" {
                pv_set_minlen(facts, owner, k + 1)
            } else if op == "==" {
                pv_set_minlen(facts, owner, k)
            }
            return
        }
        # len on the right — flip to len-on-left
        if is_len_call_e(ctx, r) && ln.kind == "int" {
            let owner2: str = len_owner_e(ctx, r)
            let k2: int = ln.ival
            let mut eff: str = op
            if op == "<" {
                eff = ">"
            } else if op == "<=" {
                eff = ">="
            }
            if eff == ">=" {
                pv_set_minlen(facts, owner2, k2)
            } else if eff == ">" {
                pv_set_minlen(facts, owner2, k2 + 1)
            } else if eff == "==" {
                pv_set_minlen(facts, owner2, k2)
            }
            return
        }
    }
}

# seed_pred_for_param — boot's run_proof_pass refinement merge: seed the
# pred with self, then rename the binder (nz self->param, facts self->
# param, other keys copied).
fn seed_pred_for_param(ctx: Ctx, pred_e: int, pname: str, facts: Facts) -> void {
    let pf: Facts = facts_new()
    let self_fn: FnInfo = dummy_fn()
    # a one-param fn named self of type int — the pred's binder
    self_fn.params = ["self"]
    self_fn.ptypes = ["int"]
    seed_walk(ctx, pred_e, self_fn, pf)
    # merge: the nz set (self was the only binder — already the param's
    # name after the rename below), the self interval (renamed to the
    # param), everything else copied verbatim
    let mut s: int = 0
    while s < pf.nz.len() {
        let mut nm: str = pf.nz.get(s)
        if nm == "self" {
            nm = pname
        }
        if !list_has_str(facts.nz, nm) {
            facts.nz.push(nm)
        }
        s = s + 1
    }
    let ks: list[str] = pf.ints.keys()
    let mut i: int = 0
    while i < ks.len() {
        let key: str = ks.get(i)
        let val: Iv = pf.ints.get_or(key, pv_iv_top())
        if key == "self" {
            facts.ints.set(pname, Iv {
                lo: val.lo, hi: val.hi
            })
        } else {
            facts.ints.set(key, Iv {
                lo: val.lo, hi: val.hi
            })
        }
        i = i + 1
    }
    let ms: list[str] = pf.minlen.keys()
    let mut m: int = 0
    while m < ms.len() {
        pv_set_minlen(facts, ms.get(m), pf.minlen.get_or(ms.get(m), 0))
        m = m + 1
    }
}

# ----------------------------------------------------------------------------
# expr_interval — boot's best-effort interval of an int expression.
# ----------------------------------------------------------------------------

fn expr_interval_f(ctx: Ctx, e: int, facts: Facts, depth: int) -> Iv {
    if e < 0 || depth > 24 {
        return pv_iv_top()
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return iv_of(n.ival, n.ival)
    }
    if n.kind == "ident" {
        if facts.ints.has(n.name) {
            return facts.ints.get_or(n.name, pv_iv_top())
        }
        return pv_iv_top()
    }
    if n.kind == "un" && n.op == "-" {
        return pv_iv_neg(expr_interval_f(ctx, n.left, facts, depth + 1))
    }
    if n.kind == "bin" {
        if n.op == "+" {
            return pv_iv_add(expr_interval_f(ctx, n.left, facts, depth + 1),
            expr_interval_f(ctx, n.right, facts, depth + 1))
        }
        if n.op == "-" {
            return pv_iv_sub(expr_interval_f(ctx, n.left, facts, depth + 1),
            expr_interval_f(ctx, n.right, facts, depth + 1))
        }
        if n.op == "*" {
            return pv_iv_mul(expr_interval_f(ctx, n.left, facts, depth + 1),
            expr_interval_f(ctx, n.right, facts, depth + 1))
        }
    }
    return pv_iv_top()
}

# ----------------------------------------------------------------------------
# The loop hook — one snapshot per loop head, keep-first (by stmt index,
# which is the native node identity).
# ----------------------------------------------------------------------------

struct LoopHook {
    seen: list[int], # stmt indices already snapshotted
    kinds: list[str], # "while" | "for" per seen entry
    snaps: list[Facts] # the snapshot per seen entry
}

fn loop_hook_new() -> LoopHook {
    return LoopHook {
        seen: [], kinds: [], snaps: []
    }
}

fn loop_hook_fire(h: LoopHook, stmt: int, kind: str, snap: Facts) -> void {
    let mut i: int = 0
    while i < h.seen.len() {
        if h.seen.get(i) == stmt {
            return
        }
        i = i + 1
    }
    h.seen.push(stmt)
    h.kinds.push(kind)
    h.snaps.push(snap)
}

# ----------------------------------------------------------------------------
# propagate — boot's propagate_stmts, facts side only (the annotation
# side is the in-tree pass's, already run by hl_check).
# ----------------------------------------------------------------------------

# pv_collect_len_mutators — idents whose length a push/pop mutates inside e.
fn pv_collect_len_mutators(ctx: Ctx, e: int, out: list[str], depth: int) -> void {
    if e < 0 || depth > 48 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "method" && (n.name == "pop" || n.name == "push") {
        if n.left >= 0 {
            let t: ExprN = ctx.exprs[n.left]
            if t.kind == "ident" {
                out.push(t.name)
            }
        }
    }
    pv_collect_len_mutators(ctx, n.left, out, depth + 1)
    pv_collect_len_mutators(ctx, n.right, out, depth + 1)
    let mut i: int = 0
    while i < n.args.len() {
        if n.kind != "match" {
            pv_collect_len_mutators(ctx, n.args.get(i), out, depth + 1)
        }
        i = i + 1
    }
    if n.kind == "match" {
        let mut a: int = 0
        while a < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
            pv_collect_len_mutators(ctx, arm.body, out, depth + 1)
            a = a + 1
        }
        pv_collect_len_mutators(ctx, n.left, out, depth + 1)
    }
    if n.kind == "qmark" {
        pv_collect_len_mutators(ctx, n.left, out, depth + 1)
    }
    if n.kind == "structlit" {
        let mut fi: int = 0
        while fi < n.args.len() {
            pv_collect_len_mutators(ctx, n.args.get(fi), out, depth + 1)
            fi = fi + 1
        }
    }
}

# stmt_len_mutators — the mutators of a whole statement's expressions.
fn stmt_len_mutators(ctx: Ctx, s: StmtN, out: list[str]) -> void {
    if s.kind == "let" || s.kind == "assign" || s.kind == "expr" {
        pv_collect_len_mutators(ctx, s.value, out, 0)
        pv_collect_len_mutators(ctx, s.e, out, 0)
    }
    if s.kind == "if" {
        pv_collect_len_mutators(ctx, s.cond, out, 0)
    }
    if s.kind == "while" {
        pv_collect_len_mutators(ctx, s.cond, out, 0)
    }
    if s.kind == "for" {
        pv_collect_len_mutators(ctx, s.iter, out, 0)
    }
    if s.kind == "assign" && s.target >= 0 {
        let tn: ExprN = ctx.exprs[s.target]
        if tn.kind == "index" {
            pv_collect_len_mutators(ctx, tn.right, out, 0)
        }
    }
}

# assigned_int_vars — every int variable assigned anywhere in a tree
# (boot's _assigned_int_vars: let of int type, assign target of any
# type name — sound to overapproximate).
fn assigned_int_vars(ctx: Ctx, stmts: list[int], out: list[str], depth: int) -> void {
    if depth > 64 {
        return
    }
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "let" {
            if s.vtype == "int" && !list_has_str(out, s.name) {
                out.push(s.name)
            }
        }
        if s.kind == "assign" {
            if s.target >= 0 {
                let tn: ExprN = ctx.exprs[s.target]
                if tn.kind == "ident" && !list_has_str(out, tn.name) {
                    out.push(tn.name)
                }
            }
        }
        if s.kind == "if" {
            assigned_int_vars(ctx, s.body, out, depth + 1)
            assigned_int_vars(ctx, s.else_body, out, depth + 1)
        }
        if s.kind == "while" || s.kind == "for" {
            assigned_int_vars(ctx, s.body, out, depth + 1)
        }
        i = i + 1
    }
}

# const_range_of — range(a, b) with two int literals: (a, b) when b > a,
# else (a, a); -1 sentinel pair when not a const range (boot's
# _const_range returned None; the caller seeds TOP).
fn const_range_ok(ctx: Ctx, e: int) -> bool {
    if e < 0 {
        return false
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind != "call" || n.mkey != "range" || n.muser != false {
        return false
    }
    if n.args.len() != 2 {
        return false
    }
    let a: ExprN = ctx.exprs[n.args.get(0)]
    let b: ExprN = ctx.exprs[n.args.get(1)]
    if a.kind != "int" || b.kind != "int" {
        return false
    }
    return true
}

fn pv_const_range_a(ctx: Ctx, e: int) -> int {
    let n: ExprN = ctx.exprs[e]
    let a: ExprN = ctx.exprs[n.args.get(0)]
    return a.ival
}

fn pv_const_range_b(ctx: Ctx, e: int) -> int {
    let n: ExprN = ctx.exprs[e]
    let b: ExprN = ctx.exprs[n.args.get(1)]
    return b.ival
}

# widen_growth — boot's _widen_growth: keep bounds that did not grow.
fn widen_growth(a: Iv, b: Iv) -> Iv {
    let mut lo: Bnd = bnd_none()
    if bnd_is_num(a.lo) && bnd_is_num(b.lo) {
        if b.lo.num >= a.lo.num {
            lo = bnd_num(a.lo.num)
        }
    }
    let mut hi: Bnd = bnd_none()
    if bnd_is_num(a.hi) && bnd_is_num(b.hi) {
        if b.hi.num <= a.hi.num {
            hi = bnd_num(a.hi.num)
        }
    }
    return Iv {
        lo: lo, hi: hi
    }
}

# propagate_stmts_f — the statement walk (facts only, hook fires at
# loop heads with the pre-loop snapshot).
fn propagate_stmts_f(ctx: Ctx, stmts: list[int], facts: Facts, depth: int,
hook: LoopHook) -> void {
    if depth > 32 {
        return
    }
    let mut si: int = 0
    while si < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(si))
        if s.kind == "while" {
            # ---- while: two Kleene rounds + widening + verification ----
            loop_hook_fire(hook, stmts.get(si), "while", facts_copy(facts))
            let w1: Facts = facts_copy(facts)
            propagate_stmts_f(ctx, s.body, w1, depth + 1, hook)
            let f1: Facts = facts_join(facts_copy(facts), w1)
            let w2: Facts = facts_copy(f1)
            propagate_stmts_f(ctx, s.body, w2, depth + 1, hook)
            let f2: Facts = facts_join(f1, w2)
            # widen growth to infinity
            let finv: Facts = facts_new()
            let fks: list[str] = f2.ints.keys()
            let mut wi: int = 0
            while wi < fks.len() {
                let key: str = fks.get(wi)
                let v: Iv = f2.ints.get_or(key, pv_iv_top())
                let v1: Iv = f1.ints.get_or(key, pv_iv_top())
                finv.ints.set(key, widen_growth(v1, v))
                wi = wi + 1
            }
            let mut wj: int = 0
            while wj < f2.nz.len() {
                finv.nz.push(f2.nz.get(wj))
                wj = wj + 1
            }
            let fms: list[str] = f2.minlen.keys()
            let mut wk: int = 0
            while wk < fms.len() {
                finv.minlen.set(fms.get(wk), f2.minlen.get_or(fms.get(wk), 0))
                wk = wk + 1
            }
            # post-fixpoint verification (4 rounds)
            let mut round: int = 0
            while round < 4 {
                let wchk: Facts = facts_copy(finv)
                propagate_stmts_f(ctx, s.body, wchk, depth + 1, hook)
                let grew: list[str] = []
                let cks: list[str] = wchk.ints.keys()
                let mut ci: int = 0
                while ci < cks.len() {
                    let ckey: str = cks.get(ci)
                    let cv: Iv = wchk.ints.get_or(ckey, pv_iv_top())
                    if !finv.ints.has(ckey) {
                        ci = ci + 1
                        continue
                    }
                    let cur: Iv = finv.ints.get_or(ckey, pv_iv_top())
                    if !pv_iv_contains(cur, cv) {
                        grew.push(ckey)
                    }
                    ci = ci + 1
                }
                if grew.len() == 0 {
                    break
                }
                let mut gi: int = 0
                while gi < grew.len() {
                    finv.ints.set(grew.get(gi), pv_iv_top())
                    gi = gi + 1
                }
                round = round + 1
            }
            # final body pass under the invariant
            let wf: Facts = facts_copy(finv)
            propagate_stmts_f(ctx, s.body, wf, depth + 1, hook)
            facts_replace(facts, finv)
            si = si + 1
            continue
        }
        if s.kind == "for" {
            # ---- for: const-range bounds or TOP; post-loop join ----
            loop_hook_fire(hook, stmts.get(si), "for", facts_copy(facts))
            let bf: Facts = facts_copy(facts)
            # soundness: any int var modified in the body is TOP for the
            # body walk (the loop variable gets the range bound)
            let mods: list[str] = []
            assigned_int_vars(ctx, s.body, mods, 0)
            let mut mi: int = 0
            while mi < mods.len() {
                if mods.get(mi) != s.name {
                    bf.ints.set(mods.get(mi), pv_iv_top())
                }
                mi = mi + 1
            }
            if s.name != "" {
                if const_range_ok(ctx, s.iter) {
                    let a: int = pv_const_range_a(ctx, s.iter)
                    let b: int = pv_const_range_b(ctx, s.iter)
                    if b > a {
                        bf.ints.set(s.name, iv_of(a, b - 1))
                    } else {
                        bf.ints.set(s.name, iv_of(a, a))
                    }
                } else {
                    bf.ints.set(s.name, pv_iv_top())
                }
            }
            propagate_stmts_f(ctx, s.body, bf, depth + 1, hook)
            let after: Facts = facts_join(facts_copy(facts), bf)
            after.ints.set(s.name, pv_iv_top())
            # drop the loop variable (out of scope): rebuild without it
            let fresh: map[str, Iv] = map_new()
            let aks: list[str] = after.ints.keys()
            let mut ai: int = 0
            while ai < aks.len() {
                if aks.get(ai) != s.name {
                    fresh.set(aks.get(ai), after.ints.get_or(aks.get(ai), pv_iv_top()))
                }
                ai = ai + 1
            }
            after.ints = fresh
            facts_replace(facts, after)
            si = si + 1
            continue
        }
        # non-loop statement: len mutators first, then the write's
        # invalidation + recompute (boot's deep-scan-10/24 laws)
        let muts: list[str] = []
        stmt_len_mutators(ctx, s, muts)
        let mut ti: int = 0
        while ti < muts.len() {
            facts_drop_owner(facts, muts.get(ti))
            ti = ti + 1
        }
        if s.kind == "let" || s.kind == "assign" {
            # the binding name and its type: a let carries its declared
            # type; an assign reads the lvalue's checked type (the
            # checker annotated the target ident node)
            let mut tname: str = ""
            let mut ty: str = ""
            if s.kind == "let" {
                tname = s.name
                ty = s.vtype
            }
            if s.kind == "assign" {
                if s.target >= 0 {
                    let tn: ExprN = ctx.exprs[s.target]
                    if tn.kind == "ident" {
                        tname = tn.name
                        ty = tn.t
                    }
                }
            }
            if tname != "" && ty == "int" {
                nz_discard(facts, tname)
                facts_drop_owner(facts, tname)
                if s.value >= 0 {
                    facts.ints.set(tname, expr_interval_f(ctx, s.value, facts, 0))
                }
            } else {
                if tname != "" {
                    # non-int (or unknown-type) write: kill the binding's
                    # facts and its value-derived facts
                    if facts.ints.has(tname) {
                        let fresh2: map[str, Iv] = map_new()
                        let fks2: list[str] = facts.ints.keys()
                        let mut fi: int = 0
                        while fi < fks2.len() {
                            if fks2.get(fi) != tname {
                                fresh2.set(fks2.get(fi), facts.ints.get_or(fks2.get(fi), pv_iv_top()))
                            }
                            fi = fi + 1
                        }
                        facts.ints = fresh2
                    }
                    facts_drop_owner(facts, tname)
                }
            }
        }
        if s.kind == "if" {
            let sf: Facts = facts_copy(facts)
            propagate_stmts_f(ctx, s.body, sf, depth + 1, hook)
            let ef: Facts = facts_copy(facts)
            propagate_stmts_f(ctx, s.else_body, ef, depth + 1, hook)
            let joined: Facts = facts_join(sf, ef)
            facts_replace(facts, joined)
        }
        si = si + 1
    }
}

# ============================================================================
# Part 3 — the proof report: the .py's proof_report over the native
# annotations (the checker's own pass, run by hl_check) + the seeded
# facts (the retired engine, Part 2).
# ============================================================================

# count_sums — the per-fn / total annotation counts.
struct Sums {
    ovf: int,
    div: int,
    bnd: int
}

fn sums_zero() -> Sums {
    return Sums {
        ovf: 0, div: 0, bnd: 0
    }
}

# walk_expr_annotations — the .py's walk(): count the verdicts on one
# expression tree, recursing through every child shape.
fn walk_expr_annotations(ctx: Ctx, e: int, sums: Sums, depth: int) -> void {
    if e < 0 || depth > 96 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.ovf_safe {
        sums.ovf = sums.ovf + 1
    }
    if n.div_safe {
        sums.div = sums.div + 1
    }
    if n.bnd_safe {
        sums.bnd = sums.bnd + 1
    }
    # left/right: the bin operands, the un/qmark operand, the method/
    # field target, the index base+idx and the match scrutinee — one
    # native node field where the interp dict had many.
    walk_expr_annotations(ctx, n.left, sums, depth + 1)
    walk_expr_annotations(ctx, n.right, sums, depth + 1)
    if n.kind != "match" {
        let mut i: int = 0
        while i < n.args.len() {
            walk_expr_annotations(ctx, n.args.get(i), sums, depth + 1)
            i = i + 1
        }
    }
    if n.kind == "match" {
        # every arm body (the scrutinee is n.left, walked above)
        let mut a: int = 0
        while a < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
            walk_expr_annotations(ctx, arm.body, sums, depth + 1)
            a = a + 1
        }
    }
}

# walk_stmt_annotations — the .py's walk_stmts.
fn walk_stmt_annotations(ctx: Ctx, stmts: list[int], sums: Sums, depth: int) -> void {
    if depth > 48 {
        return
    }
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        walk_expr_annotations(ctx, s.value, sums, 0)
        walk_expr_annotations(ctx, s.cond, sums, 0)
        walk_expr_annotations(ctx, s.iter, sums, 0)
        walk_expr_annotations(ctx, s.e, sums, 0)
        if s.kind == "assign" && s.target >= 0 {
            let tn: ExprN = ctx.exprs[s.target]
            if tn.kind == "index" {
                walk_expr_annotations(ctx, tn.right, sums, 0)
            }
        }
        walk_stmt_annotations(ctx, s.body, sums, depth + 1)
        walk_stmt_annotations(ctx, s.else_body, sums, depth + 1)
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# Text renderers. expr_to_text is the .py's (contract report / suggest
# while headers); the others belong to their own passes below.
# ----------------------------------------------------------------------------

# expr_to_text — the .py's best-effort contract rendering.
fn expr_to_text(ctx: Ctx, e: int) -> str {
    if e < 0 {
        return "?"
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return n.ival.to_str()
    }
    if n.kind == "float" {
        return n.fval.to_str()
    }
    if n.kind == "bool" {
        if n.bval {
            return "True"
        }
        return "False"
    }
    if n.kind == "str" {
        return "\"" + n.sval + "\""
    }
    if n.kind == "ident" {
        return n.name
    }
    if n.kind == "un" {
        return n.op + "(" + expr_to_text(ctx, n.left) + ")"
    }
    if n.kind == "bin" {
        return "(" + expr_to_text(ctx, n.left) + " " + n.op + " "
        + expr_to_text(ctx, n.right) + ")"
    }
    if n.kind == "call" {
        let args: list[str] = []
        let mut i: int = 0
        while i < n.args.len() {
            args.push(expr_to_text(ctx, n.args.get(i)))
            i = i + 1
        }
        return n.name + "(" + pv_join_str_list(args, ", ") + ")"
    }
    if n.kind == "method" {
        return expr_to_text(ctx, n.left) + "." + n.name + "()"
    }
    return "?"
}

# ----------------------------------------------------------------------------
# proof_report — the default mode's section.
# ----------------------------------------------------------------------------

struct ReportLine {
    key: str,
    d_ovf: int,
    d_div: int,
    d_bnd: int,
    fact_vars: list[str], # sorted var names
    fact_texts: map[str, str], # var -> "[lo, hi]"
    req_text: str
}

# fn_facts_after_pass — the retired engine's per-fn facts at the end of
# its body pass (boot's run_proof_pass): seed from requires, merge the
# param refinements, propagate. Externs carry no facts.
fn fn_facts_after_pass(ctx: Ctx, f: FnInfo) -> Facts {
    let facts: Facts = facts_new()
    if f.is_extern {
        return facts
    }
    if f.requires_e >= 0 {
        seed_walk(ctx, f.requires_e, f, facts)
    }
    # param refinements (boot's run_proof_pass pred merge) — int params
    # only; the pred binds `self` to the parameter
    let pns: list[str] = f.param_preds.keys()
    let mut pi: int = 0
    while pi < pns.len() {
        let pn: str = pns.get(pi)
        let mut pidx: int = -1
        let mut ti: int = 0
        while ti < f.params.len() {
            if f.params.get(ti) == pn {
                pidx = ti
            }
            ti = ti + 1
        }
        if pidx >= 0 && f.ptypes.get(pidx) == "int" {
            let text: str = f.param_preds.get_or(pn, "")
            let pe: int = ctx.rpreds.get_or(text, -1)
            if pe >= 0 {
                seed_pred_for_param(ctx, pe, pn, facts)
            }
        }
        pi = pi + 1
    }
    let hook: LoopHook = loop_hook_new()
    propagate_stmts_f(ctx, f.body, facts, 0, hook)
    return facts
}

# proof_report(ctx) — print the section; returns nothing.
fn proof_report(ctx: Ctx) -> void uses IO {
    let lines: list[ReportLine] = []
    let totals: Sums = sums_zero()
    let keys: list[str] = ctx.fns.keys()
    let mut fi: int = 0
    while fi < keys.len() {
        let key: str = keys.get(fi)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if f.requires_e < 0 {
            fi = fi + 1
            continue
        }
        let before_ovf: int = totals.ovf
        let before_div: int = totals.div
        let before_bnd: int = totals.bnd
        if !f.is_extern {
            walk_stmt_annotations(ctx, f.body, totals, 0)
        }
        let rl: ReportLine = ReportLine {
            key: key,
            d_ovf: totals.ovf - before_ovf,
            d_div: totals.div - before_div,
            d_bnd: totals.bnd - before_bnd,
            fact_vars: [],
            fact_texts: map_new(),
            req_text: expr_to_text(ctx, f.requires_e)
        }
        # the seeded facts: the engine's end-of-body snapshot
        let facts: Facts = fn_facts_after_pass(ctx, f)
        let fvars: list[str] = facts.ints.keys()
        let sorted_vars: list[str] = sort_str_list(fvars)
        let mut si: int = 0
        while si < sorted_vars.len() {
            let var: str = sorted_vars.get(si)
            let iv: Iv = facts.ints.get_or(var, pv_iv_top())
            rl.fact_vars.push(var)
            rl.fact_texts.set(var, iv_text(iv))
            si = si + 1
        }
        lines.push(rl)
        fi = fi + 1
    }
    if lines.len() == 0 {
        println("  No contracted functions (add a `requires` clause to try the prover).")
    }
    let mut li: int = 0
    while li < lines.len() {
        let r: ReportLine = lines.get(li)
        println("  " + r.key + ":")
        if r.req_text == "" {
            println("    requires: (none)")
        } else {
            println("    requires: " + r.req_text)
        }
        if r.fact_vars.len() > 0 {
            let mut vi: int = 0
            while vi < r.fact_vars.len() {
                let var: str = r.fact_vars.get(vi)
                println("    seeded fact: " + var + " in " + r.fact_texts.get_or(var, "?"))
                vi = vi + 1
            }
        }
        println("    PROVEN SAFE: " + r.d_ovf.to_str() + " overflow, " + r.d_div.to_str() + " division, " + r.d_bnd.to_str() + " bounds checks elidable under -O fast")
        li = li + 1
    }
    println("")
    println("  TOTAL: " + totals.ovf.to_str() + " overflow + " + totals.div.to_str() + " division + " + totals.bnd.to_str() + " bounds checks proven dead")
    println("  (only PROVEN checks are elided; everything unknown keeps its runtime panic check)")
}

# ============================================================================
# Part 4 — the SMT-LIB2 bridge (the .py's gen_smt + run_z3/run_cvc5) and
# the binary deciders.
# ============================================================================

# smt_of_expr — render a contract expression; on an unsupported shape it
# raises in the .py — here the caller checks err.text != "" afterwards.
struct SmtErr {
    text: str
}

fn smt_err_new() -> SmtErr {
    return SmtErr {
        text: ""
    }
}

# smt_of_expr(ctx, e, vars_int, vars_str, err) — the SMT term.
fn smt_of_expr(ctx: Ctx, e: int, vars_int: list[str], vars_str: list[str],
err: SmtErr) -> str {
    if e < 0 {
        err.text = "unsupported contract node"
        return ""
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return n.ival.to_str()
    }
    if n.kind == "bool" {
        if n.bval {
            return "true"
        }
        return "false"
    }
    if n.kind == "ident" {
        if n.name == "result" {
            return "result"
        }
        if list_has_str(vars_int, n.name) {
            return n.name
        }
        err.text = "unknown identifier in contract: " + n.name
        return ""
    }
    if n.kind == "un" {
        if n.op == "!" {
            return "(not " + smt_of_expr(ctx, n.left, vars_int, vars_str, err) + ")"
        }
        if n.op == "-" {
            return "(- " + smt_of_expr(ctx, n.left, vars_int, vars_str, err) + ")"
        }
        err.text = "unsupported unary op"
        return ""
    }
    if n.kind == "bin" {
        let op: str = n.op
        let mut mop: str = op
        if op == "/" {
            mop = "cdiv"
        } else if op == "%" {
            mop = "cmod"
        } else if op == "==" {
            mop = "="
        } else if op == "!=" {
            mop = "distinct"
        } else if op == "&&" {
            mop = "and"
        } else if op == "||" {
            mop = "or"
        } else if op != "+" && op != "-" && op != "*"
        && op != "<" && op != "<=" && op != ">" && op != ">=" {
            err.text = "unsupported binary op " + op
            return ""
        }
        return "(" + mop + " " + smt_of_expr(ctx, n.left, vars_int, vars_str, err)
        + " " + smt_of_expr(ctx, n.right, vars_int, vars_str, err) + ")"
    }
    if n.kind == "call" && n.name == "len" {
        if n.args.len() >= 1 {
            let a: ExprN = ctx.exprs[n.args.get(0)]
            if a.kind == "ident" && list_has_str(vars_str, a.name) {
                return a.name + "_len"
            }
        }
        err.text = "len() of a non-parameter"
        return ""
    }
    if n.kind == "method" && n.name == "len" {
        if n.left >= 0 {
            let t: ExprN = ctx.exprs[n.left]
            if t.kind == "ident" && list_has_str(vars_str, t.name) {
                return t.name + "_len"
            }
        }
        err.text = ".len() of a non-parameter"
        return ""
    }
    err.text = "unsupported contract expression kind: " + n.kind
    return ""
}

# smt_prelude — the bridge prelude with the cdiv/cmod helpers.
fn smt_prelude(vars_int: list[str], vars_str: list[str], result_int: int) -> list[str] {
    # result_int: 1 = Int, 0 = Bool, -1 = no declaration
    let lines: list[str] = []
    lines.push("; Halis SMT bridge (integer arithmetic; cdiv/cmod encode the C-truncated / and %)")
    lines.push("(define-fun cdiv ((a Int) (b Int)) Int")
    lines.push("  (ite (= b 0) 0")
    lines.push("       (ite (or (and (>= a 0) (>= b 0)) (and (< a 0) (< b 0)))")
    lines.push("            (div (abs a) (abs b))")
    lines.push("            (- (div (abs a) (abs b))))))")
    lines.push("(define-fun cmod ((a Int) (b Int)) Int")
    lines.push("  (ite (= b 0) 0")
    lines.push("       (ite (>= a 0) (mod a (abs b))")
    lines.push("            (- (mod (abs a) (abs b))))))")
    let mut i: int = 0
    while i < vars_int.len() {
        lines.push("(declare-const " + vars_int.get(i) + " Int)")
        i = i + 1
    }
    if vars_str.len() > 0 {
        lines.push("; strings are abstracted to their lengths (QF_LIA)")
        let mut j: int = 0
        while j < vars_str.len() {
            lines.push("(declare-const " + vars_str.get(j) + "_len Int)")
            j = j + 1
        }
    }
    if result_int == 1 {
        lines.push("(declare-const result Int)")
    } else if result_int == 0 {
        lines.push("(declare-const result Bool)")
    }
    return lines
}

# result_int_of(ret) — True->1 (Int), False->0 (Bool), None->-1.
fn result_int_of(ret: str) -> int {
    if ret == "int" {
        return 1
    }
    if ret == "bool" {
        return 0
    }
    return -1
}

# gen_smt — one .smt2 per contracted fn; returns (key, path) pairs.
fn gen_smt(ctx: Ctx, out_dir: str) -> list[str] uses Fs {
    let results: list[str] = []
    let keys: list[str] = ctx.fns.keys()
    let mut fi: int = 0
    while fi < keys.len() {
        let key: str = keys.get(fi)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if f.requires_e < 0 && f.ensures_e < 0 {
            fi = fi + 1
            continue
        }
        let vars_int: list[str] = []
        let vars_str: list[str] = []
        let mut pi: int = 0
        while pi < f.params.len() {
            if f.ptypes.get(pi) == "int" {
                vars_int.push(f.params.get(pi))
            } else if f.ptypes.get(pi) == "str" {
                vars_str.push(f.params.get(pi))
            }
            pi = pi + 1
        }
        let s_int: list[str] = sort_str_list(vars_int)
        let s_str: list[str] = sort_str_list(vars_str)
        let result_int: int = result_int_of(f.ret)
        let lines: list[str] = smt_prelude(s_int, s_str, result_int)
        let err: SmtErr = smt_err_new()
        let mut failed: bool = false
        if f.requires_e >= 0 {
            let req_smt: str = smt_of_expr(ctx, f.requires_e, s_int, s_str, err)
            if err.text != "" {
                # the .py aborts the whole block at the first raise
                lines.push("; unsupported contract shape for SMT: " + err.text)
                err.text = ""
                failed = true
            }
            if !failed {
                lines.push("; (check-sat) requires satisfiability: unsat => the contract is vacuous")
                lines.push("(assert " + req_smt + ")")
                lines.push("(check-sat)")
                if f.ensures_e >= 0 && result_int != -1 {
                    lines.push("(reset)")
                    let pre2: list[str] = smt_prelude(s_int, s_str, result_int)
                    let mut p2: int = 0
                    while p2 < pre2.len() {
                        lines.push(pre2.get(p2))
                        p2 = p2 + 1
                    }
                }
            }
        }
        if !failed && f.ensures_e >= 0 {
            if result_int != -1 {
                let ens_smt: str = smt_of_expr(ctx, f.ensures_e, s_int, s_str, err)
                if err.text != "" {
                    lines.push("; unsupported contract shape for SMT: " + err.text)
                    err.text = ""
                    failed = true
                }
                if !failed {
                    if f.requires_e >= 0 {
                        let req_smt2: str = smt_of_expr(ctx, f.requires_e, s_int, s_str, err)
                        if err.text != "" {
                            lines.push("; unsupported contract shape for SMT: " + err.text)
                            err.text = ""
                            failed = true
                        }
                        if !failed {
                            lines.push("; (check-sat) requires & !ensures: unsat => ensures is implied by requires")
                            lines.push("(assert " + req_smt2 + ")")
                        }
                    } else {
                        lines.push("; (check-sat) !ensures: unsat => ensures always holds")
                    }
                    if !failed {
                        lines.push("(assert (not " + ens_smt + "))")
                        lines.push("(check-sat)")
                    }
                }
            } else {
                lines.push("; (ensures query skipped: result type " + f.ret + " has no QF_LIA encoding)")
            }
        }
        # the .py's single try/except: a raise aborts the rest of the
        # block; every line appended before the raise stays, and the
        # except appends its comment — mirrored exactly by the failed
        # flag's guards.
        let fname: str = str_replace(key, ".", "_") + ".smt2"
        let mut fpath: str = out_dir
        if out_dir != "." {
            fpath = out_dir + "/" + fname
        } else {
            fpath = fname
        }
        write_file(fpath, join(lines, "\n") + "\n")
        results.push(key)
        results.push(fpath)
        fi = fi + 1
    }
    return results
}

# ----------------------------------------------------------------------------
# The binary deciders. Halis cannot import python modules — the binary
# is the only backend; "neither binary nor module" is "no binary".
# ----------------------------------------------------------------------------

# filter_verdicts(stdout) — the sat/unsat/unknown lines.
fn filter_verdicts(out: str) -> list[str] {
    let verdicts: list[str] = []
    let lines: list[str] = out.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let t: str = lines.get(i).trim()
        if t == "sat" || t == "unsat" || t == "unknown" {
            verdicts.push(t)
        }
        i = i + 1
    }
    return verdicts
}

# join_lines(lines) — the temp file's bytes.
fn join_lines(lines: list[str]) -> str {
    return join(lines, "\n") + "\n"
}

# binary_decide(tool, extra_args, lines) — one obligation through a
# solver BINARY with a temp file. Returns "" when no binary is on PATH
# or the spawn fails ("?" / "timeout"-shaped results otherwise).
fn binary_decide(tool: str, extra_args: list[str], lines: list[str]) -> str uses Fs, Proc, Clock {
    if which_hit(tool) == "" {
        return ""
    }
    let seq: int = tmp_seq_next()
    let tmp: str = tmp_name(seq)
    write_file(tmp, join_lines(lines))
    let argv: list[str] = [tool]
    let mut i: int = 0
    while i < extra_args.len() {
        argv.push(extra_args.get(i))
        i = i + 1
    }
    argv.push(tmp)
    let r: RunRes = run_child(argv)
    rm_file(tmp)
    if !r.spawned {
        return ""
    }
    if r.code != 0 {
        return "?"
    }
    let vs: list[str] = filter_verdicts(r.out)
    if vs.len() == 0 {
        return "?"
    }
    return vs.get(0)
}

# z3_binary_decide(lines) — z3 with the file as argv[1].
fn z3_binary_decide(lines: list[str]) -> str uses Fs, Proc, Clock {
    return binary_decide("z3", [], lines)
}

# cvc5_binary_decide(lines) — cvc5 --lang smt2 -q <file>.
fn cvc5_binary_decide(lines: list[str]) -> str uses Fs, Proc, Clock {
    return binary_decide("cvc5", ["--lang", "smt2", "-q"], lines)
}

# Decider — the .py's decide(lines) -> verdict | None.
struct Decider {
    ok: bool, # false = the .py's None (no backend)
    name: str # "z3" | "cvc5" — the report's solver name
}

# make_z3_decider — probe ["(check-sat)"] through the binary; a present
# binary passes the probe whatever it answers (the .py: rc!=0 -> "?",
# still "not None" — the decider exists).
fn make_z3_decider() -> Decider uses Fs, Proc, Clock {
    let d: Decider = Decider {
        ok: false, name: "z3"
    }
    if which_hit("z3") == "" {
        return d
    }
    let probe: str = z3_binary_decide(["(check-sat)"])
    if probe == "" {
        return d
    }
    d.ok = true
    return d
}

# make_cvc5_decider — the cvc5 mirror.
fn make_cvc5_decider() -> Decider uses Fs, Proc, Clock {
    let d: Decider = Decider {
        ok: false, name: "cvc5"
    }
    if which_hit("cvc5") == "" {
        return d
    }
    let probe: str = cvc5_binary_decide(["(check-sat)"])
    if probe == "" {
        return d
    }
    d.ok = true
    return d
}

# decider_decide(d, lines) — "" when !d.ok (the caller treats it as the
# .py's None and never claims anything).
fn decider_decide(d: Decider, lines: list[str]) -> str uses Fs, Proc, Clock {
    if !d.ok {
        return ""
    }
    if d.name == "cvc5" {
        return cvc5_binary_decide(lines)
    }
    return z3_binary_decide(lines)
}

# run_solver_bridge(files, tool_name) — the .py's run_z3 / run_cvc5 (the
# same reporting contract, interchangeable on the same .smt2).
fn run_solver_bridge(files: list[str], tool_name: str) -> void uses IO, Proc, Clock, Fs {
    let labels: list[str] = ["vacuity", "ensures"]
    let mut fi: int = 0
    while fi < files.len() {
        let key: str = files.get(fi)
        let fpath: str = files.get(fi + 1)
        fi = fi + 2
        if tool_name != "z3" && tool_name != "cvc5" {
            continue
        }
        let argv: list[str] = [tool_name]
        if tool_name == "cvc5" {
            argv.push("--lang")
            argv.push("smt2")
            argv.push("-q")
        }
        argv.push(fpath)
        let r: RunRes = run_child(argv)
        if !r.spawned {
            # no binary on PATH — the honest report (the .py's fallback
            # found no module either, in a Halis world)
            if tool_name == "z3" {
                println("    " + pad_left(key, 28) + " z3: neither the z3 binary nor the z3-solver python package is available (install one, or use --smt and inspect the .smt2 yourself)")
            } else {
                println("    " + pad_left(key, 28) + " cvc5: neither the cvc5 binary nor the cvc5 python package is available (install one, or use --smt and inspect the .smt2 yourself)")
            }
            return
        }
        if r.code != 0 {
            if tool_name == "z3" {
                println("    " + pad_left(key, 28) + " z3: neither the z3 binary nor the z3-solver python package is available (install one, or use --smt and inspect the .smt2 yourself)")
            } else {
                println("    " + pad_left(key, 28) + " cvc5: neither the cvc5 binary nor the cvc5 python package is available (install one, or use --smt and inspect the .smt2 yourself)")
            }
            return
        }
        let vs: list[str] = filter_verdicts(r.out)
        if vs.len() == 0 {
            vs.push("?")
        }
        let disp_parts: list[str] = []
        let mut vi: int = 0
        while vi < vs.len() {
            let mut label: str = ""
            if vi < labels.len() {
                label = labels.get(vi)
            } else {
                label = "q" + vi.to_str()
            }
            disp_parts.push(label + ": " + vs.get(vi))
            vi = vi + 1
        }
        println("    " + pad_left(key, 28) + " " + tool_name + ": " + pv_join_str_list(disp_parts, ", "))
    }
}

# ============================================================================
# Part 5 — Stage 97: the SMT-based loop-invariant inference (boot's
# _BodySummary / _build_summary / _generate_candidates / verify_loop,
# over the native statements).
# ============================================================================

# One affine term of a transition: (name, primed, coeff).
struct Term {
    name: str,
    primed: bool,
    coeff: int
}

# One disjunct: x' = self_c*x + sum(terms) + const.
struct Disj {
    self_c: int,
    terms: list[Term],
    const: int
}

fn disj_identity() -> Disj {
    # x' = x
    return Disj {
        self_c: 1, terms: [], const: 0
    }
}

# ----------------------------------------------------------------------------
# The renderers (boot's _disjunct_text / _disjunct_smt / _expr_text).
# ----------------------------------------------------------------------------

fn disjunct_text(var: str, d: Disj) -> str {
    let parts: list[str] = []
    if d.self_c == 1 {
        parts.push(var)
    } else if d.self_c == -1 {
        parts.push("-" + var)
    } else if d.self_c != 0 {
        parts.push(d.self_c.to_str() + "*" + var)
    }
    let mut i: int = 0
    while i < d.terms.len() {
        let t: Term = d.terms.get(i)
        let mut nm: str = t.name
        if t.primed {
            nm = nm + "'"
        }
        if t.coeff == 1 {
            parts.push(nm)
        } else if t.coeff == -1 {
            parts.push("-" + nm)
        } else {
            parts.push(t.coeff.to_str() + "*" + nm)
        }
        i = i + 1
    }
    if d.const != 0 || parts.len() == 0 {
        parts.push(d.const.to_str())
    }
    let mut out: str = parts.get(0)
    let mut j: int = 1
    while j < parts.len() {
        let p: str = parts.get(j)
        if p.starts_with("-") {
            out = out + " - " + p.slice(1, p.len())
        } else {
            out = out + " + " + p
        }
        j = j + 1
    }
    return out
}

fn disjunct_smt(var: str, d: Disj, prime: bool) -> str {
    let mut v: str = var
    if prime {
        v = var + "_p"
    }
    let parts: list[str] = []
    if d.self_c == 1 {
        parts.push(v)
    } else if d.self_c == -1 {
        parts.push("(- " + v + ")")
    } else if d.self_c != 0 {
        parts.push("(* " + d.self_c.to_str() + " " + v + ")")
    }
    let mut i: int = 0
    while i < d.terms.len() {
        let t: Term = d.terms.get(i)
        let mut nm: str = t.name
        if t.primed {
            nm = nm + "_p"
        }
        if t.coeff == 1 {
            parts.push(nm)
        } else if t.coeff == -1 {
            parts.push("(- " + nm + ")")
        } else {
            parts.push("(* " + t.coeff.to_str() + " " + nm + ")")
        }
        i = i + 1
    }
    if d.const != 0 || parts.len() == 0 {
        parts.push(d.const.to_str())
    }
    if parts.len() == 1 {
        return parts.get(0)
    }
    return "(+ " + pv_join_str_list(parts, " ") + ")"
}

# expr_text_inf — boot's _expr_text (the inference loop headers).
fn expr_text_inf(ctx: Ctx, e: int) -> str {
    if e < 0 {
        return "?"
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return n.ival.to_str()
    }
    if n.kind == "ident" {
        return n.name
    }
    if n.kind == "un" && n.op == "-" {
        let inner: str = expr_text_inf(ctx, n.left)
        if inner.starts_with("-") {
            return inner.slice(1, inner.len())
        }
        return "-" + inner
    }
    if n.kind == "bin" {
        return expr_text_inf(ctx, n.left) + " " + n.op + " " + expr_text_inf(ctx, n.right)
    }
    if n.kind == "call" {
        let args: list[str] = []
        let mut i: int = 0
        while i < n.args.len() {
            args.push(expr_text_inf(ctx, n.args.get(i)))
            i = i + 1
        }
        return n.name + "(" + pv_join_str_list(args, ", ") + ")"
    }
    return "?"
}

# smt_bump — base + delta as an SMT term (base_val is the literal's or
# the variable's textual form).
fn smt_bump(base_kind: str, base_val: str, delta: int) -> str {
    if delta == 0 {
        return base_val
    }
    if base_kind == "lit" {
        let bnum: int = str_to_int_lit(base_val)
        return(bnum + delta).to_str()
    }
    if delta > 0 {
        return "(+ " + base_val + " " + delta.to_str() + ")"
    }
    return "(- " + base_val + " " + (-delta).to_str() + ")"
}

# str_to_int_lit — a decimal literal helper for smt_bump (negative ok).
fn str_to_int_lit(s: str) -> int {
    if s.len() == 0 {
        return 0
    }
    let mut v: int = 0
    let mut i: int = 0
    let mut neg: bool = false
    if s.byte_at(0) == 45 {
        neg = true
        i = 1
    }
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c < 48 || c > 57 {
            return 0
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    if neg {
        return -v
    }
    return v
}

# smt_cmp — the comparison term.
fn smt_cmp(op: str, lhs: str, rhs: str) -> str {
    if op == "!=" {
        return "(distinct " + lhs + " " + rhs + ")"
    }
    let mut sop: str = op
    if op == "==" {
        sop = "="
    }
    return "(" + sop + " " + lhs + " " + rhs + ")"
}

# bump_text — the human form of base + delta.
fn bump_text(name: str, delta: int) -> str {
    if delta == 0 {
        return name
    }
    if delta > 0 {
        return name + " + " + delta.to_str()
    }
    return name + " - " + (-delta).to_str()
}

# ----------------------------------------------------------------------------
# The body summary (boot's _BodySummary + walkers).
# ----------------------------------------------------------------------------

struct BodySummary {
    trans: map[str, list[Disj]],
    unmodeled: map[str, str],
    reads: list[str]
}

fn body_summary_new() -> BodySummary {
    return BodySummary {
        trans: map_new(), unmodeled: map_new(), reads: []
    }
}

# has_escape — return/break/continue anywhere in the tree.
fn has_escape(ctx: Ctx, stmts: list[int], depth: int) -> bool {
    if depth > 32 {
        return true
    }
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "return" || s.kind == "break" || s.kind == "continue" {
            return true
        }
        if s.kind == "if" {
            if has_escape(ctx, s.body, depth + 1) || has_escape(ctx, s.else_body, depth + 1) {
                return true
            }
        }
        if s.kind == "while" || s.kind == "for" {
            if has_escape(ctx, s.body, depth + 1) {
                return true
            }
        }
        i = i + 1
    }
    return false
}

# assigned_names — every name assigned anywhere, first-appearance order.
fn assigned_names(ctx: Ctx, stmts: list[int], acc: list[str], depth: int) -> void {
    if depth > 32 {
        return
    }
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        let mut n: str = ""
        if s.kind == "let" {
            n = s.name
        }
        if s.kind == "assign" {
            if s.target >= 0 {
                let tn: ExprN = ctx.exprs[s.target]
                if tn.kind == "ident" {
                    n = tn.name
                }
            }
        }
        if n != "" && !list_has_str(acc, n) {
            acc.push(n)
        }
        if s.kind == "if" {
            assigned_names(ctx, s.body, acc, depth + 1)
            assigned_names(ctx, s.else_body, acc, depth + 1)
        }
        if s.kind == "while" || s.kind == "for" {
            assigned_names(ctx, s.body, acc, depth + 1)
        }
        i = i + 1
    }
}

# expr_idents — every identifier read inside an expression.
fn expr_idents(ctx: Ctx, e: int, out: list[str], depth: int) -> void {
    if e < 0 || depth > 48 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "ident" {
        if n.name != "" && !list_has_str(out, n.name) {
            out.push(n.name)
        }
    }
    expr_idents(ctx, n.left, out, depth + 1)
    expr_idents(ctx, n.right, out, depth + 1)
    if n.kind != "match" {
        let mut i: int = 0
        while i < n.args.len() {
            expr_idents(ctx, n.args.get(i), out, depth + 1)
            i = i + 1
        }
    }
    if n.kind == "match" {
        let mut a: int = 0
        while a < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
            expr_idents(ctx, arm.body, out, depth + 1)
            a = a + 1
        }
        expr_idents(ctx, n.left, out, depth + 1)
    }
    if n.kind == "structlit" {
        # field values are n.args (names in ffields)
        let mut fi: int = 0
        while fi < n.args.len() {
            expr_idents(ctx, n.args.get(fi), out, depth + 1)
            fi = fi + 1
        }
    }
}

# stmt_idents — the reads of one statement.
fn stmt_idents(ctx: Ctx, s: StmtN, out: list[str]) -> void {
    expr_idents(ctx, s.value, out, 0)
    expr_idents(ctx, s.cond, out, 0)
    expr_idents(ctx, s.iter, out, 0)
    expr_idents(ctx, s.e, out, 0)
    if s.kind == "assign" && s.target >= 0 {
        let tn: ExprN = ctx.exprs[s.target]
        if tn.kind == "index" {
            expr_idents(ctx, tn.right, out, 0)
        }
    }
}

# affine_of — parse e as x' = self*x + sum(±y/±y') + const (at most two
# variable terms), or fail ("").
fn affine_ok(d: Disj) -> bool {
    if d.self_c == -999 {
        return false
    }
    return true
}

fn affine_fail() -> Disj {
    return Disj {
        self_c: -999, terms: [], const: 0
    }
}

fn affine_of(ctx: Ctx, e: int, lhs: str, assigned_before: list[str]) -> Disj {
    if e < 0 {
        return affine_fail()
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return Disj {
            self_c: 0, terms: [], const: n.ival
        }
    }
    if n.kind == "un" && n.op == "-" {
        if n.left >= 0 {
            let inner: ExprN = ctx.exprs[n.left]
            if inner.kind == "int" {
                return Disj {
                    self_c: 0, terms: [], const: -inner.ival
                }
            }
        }
        return affine_fail()
    }
    if n.kind == "ident" {
        if n.name == lhs {
            return Disj {
                self_c: 1, terms: [], const: 0
            }
        }
        let tm: list[Term] = []
        tm.push(Term {
            name: n.name, primed: list_has_str(assigned_before, n.name), coeff: 1
        })
        return Disj {
            self_c: 0, terms: tm, const: 0
        }
    }
    if n.kind == "bin" {
        let op: str = n.op
        if op != "+" && op != "-" && op != "*" {
            return affine_fail()
        }
        if op == "*" {
            # literal * form, either side
            if n.left >= 0 && ctx.exprs[n.left].kind == "int" {
                let f: Disj = affine_of(ctx, n.right, lhs, assigned_before)
                if affine_ok(f) {
                    let kc: int = ctx.exprs[n.left].ival
                    let tm2: list[Term] = []
                    let mut i: int = 0
                    while i < f.terms.len() {
                        let t: Term = f.terms.get(i)
                        tm2.push(Term {
                            name: t.name, primed: t.primed, coeff: t.coeff * kc
                        })
                        i = i + 1
                    }
                    return Disj {
                        self_c: f.self_c * kc, terms: tm2, const: f.const * kc
                    }
                }
                return affine_fail()
            }
            if n.right >= 0 && ctx.exprs[n.right].kind == "int" {
                let f2: Disj = affine_of(ctx, n.left, lhs, assigned_before)
                if affine_ok(f2) {
                    let kc2: int = ctx.exprs[n.right].ival
                    let tm3: list[Term] = []
                    let mut j: int = 0
                    while j < f2.terms.len() {
                        let t2: Term = f2.terms.get(j)
                        tm3.push(Term {
                            name: t2.name, primed: t2.primed, coeff: t2.coeff * kc2
                        })
                        j = j + 1
                    }
                    return Disj {
                        self_c: f2.self_c * kc2, terms: tm3, const: f2.const * kc2
                    }
                }
                return affine_fail()
            }
            return affine_fail()
        }
        let a: Disj = affine_of(ctx, n.left, lhs, assigned_before)
        let b: Disj = affine_of(ctx, n.right, lhs, assigned_before)
        if !affine_ok(a) || !affine_ok(b) {
            return affine_fail()
        }
        let mut bm: Disj = b
        if op == "-" {
            let tm4: list[Term] = []
            let mut k: int = 0
            while k < b.terms.len() {
                let t3: Term = b.terms.get(k)
                tm4.push(Term {
                    name: t3.name, primed: t3.primed, coeff: -t3.coeff
                })
                k = k + 1
            }
            bm = Disj {
                self_c: -b.self_c, terms: tm4, const: -b.const
            }
        }
        # merge terms by (name, primed)
        let self_c: int = a.self_c + bm.self_c
        let names: list[str] = []
        let primeds: list[bool] = []
        let coeffs: list[int] = []
        let mut ai: int = 0
        while ai < a.terms.len() {
            let t4: Term = a.terms.get(ai)
            let mut found: int = -1
            let mut pi: int = 0
            while pi < names.len() {
                if names.get(pi) == t4.name && primeds.get(pi) == t4.primed {
                    found = pi
                }
                pi = pi + 1
            }
            if found >= 0 {
                coeffs.set(found, coeffs.get(found) + t4.coeff)
            } else {
                names.push(t4.name)
                primeds.push(t4.primed)
                coeffs.push(t4.coeff)
            }
            ai = ai + 1
        }
        let mut bi: int = 0
        while bi < bm.terms.len() {
            let t5: Term = bm.terms.get(bi)
            let mut found2: int = -1
            let mut pi2: int = 0
            while pi2 < names.len() {
                if names.get(pi2) == t5.name && primeds.get(pi2) == t5.primed {
                    found2 = pi2
                }
                pi2 = pi2 + 1
            }
            if found2 >= 0 {
                coeffs.set(found2, coeffs.get(found2) + t5.coeff)
            } else {
                names.push(t5.name)
                primeds.push(t5.primed)
                coeffs.push(t5.coeff)
            }
            bi = bi + 1
        }
        let terms: list[Term] = []
        let mut ti: int = 0
        while ti < names.len() {
            if coeffs.get(ti) != 0 {
                terms.push(Term {
                    name: names.get(ti), primed: primeds.get(ti), coeff: coeffs.get(ti)
                })
            }
            ti = ti + 1
        }
        let const_v: int = a.const + bm.const
        let mut nvars: int = 0
        if self_c != 0 {
            nvars = 1
        }
        if nvars + terms.len() > 2 {
            return affine_fail()
        }
        return Disj {
            self_c: self_c, terms: terms, const: const_v
        }
    }
    return affine_fail()
}

# walk_body_stmts — accumulate one block's assignments in order.
fn walk_body_stmts(ctx: Ctx, stmts: list[int], assigned_before: list[str],
summary: BodySummary, depth: int) -> void {
    if depth > 32 {
        return
    }
    let written: list[str] = []
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "let" || s.kind == "assign" {
            let mut name: str = ""
            let mut is_int: bool = false
            if s.kind == "let" {
                name = s.name
                is_int = s.vtype == "int"
            }
            if s.kind == "assign" {
                if s.target >= 0 {
                    let tn: ExprN = ctx.exprs[s.target]
                    if tn.kind == "ident" {
                        name = tn.name
                        is_int = tn.t == "int"
                    }
                }
            }
            stmt_idents(ctx, s, summary.reads)
            if name == "" || !is_int {
                i = i + 1
                continue
            }
            if list_has_str(written, name) || summary.trans.has(name)
            || summary.unmodeled.has(name) {
                summary.unmodeled.set(name, "assigned more than once")
                summary.trans = disj_map_del(summary.trans, name)
                i = i + 1
                continue
            }
            let d: Disj = affine_of(ctx, s.value, name, assigned_before)
            if !affine_ok(d) {
                summary.unmodeled.set(name, "non-affine update")
            } else {
                let one: list[Disj] = [d]
                summary.trans.set(name, one)
            }
            written.push(name)
            if !list_has_str(assigned_before, name) {
                assigned_before.push(name)
            }
        } else if s.kind == "if" {
            stmt_idents(ctx, s, summary.reads)
            walk_if_merge(ctx, s, assigned_before, summary, depth)
        } else if s.kind == "while" || s.kind == "for" {
            stmt_idents(ctx, s, summary.reads)
            let inner: list[str] = []
            assigned_names(ctx, s.body, inner, 0)
            let mut ii: int = 0
            while ii < inner.len() {
                let iname: str = inner.get(ii)
                if !summary.trans.has(iname) && !summary.unmodeled.has(iname) {
                    summary.unmodeled.set(iname, "written inside a nested loop")
                }
                ii = ii + 1
            }
        } else {
            stmt_idents(ctx, s, summary.reads)
        }
        i = i + 1
    }
}

# walk_if_merge — merge the then/els summaries of one if.
fn walk_if_merge(ctx: Ctx, s: StmtN, assigned_before: list[str],
summary: BodySummary, depth: int) -> void {
    let then_sum: BodySummary = body_summary_new()
    then_sum.reads = summary.reads
    let else_sum: BodySummary = body_summary_new()
    else_sum.reads = summary.reads
    let then_ok: bool = s.body.len() > 0
    let else_ok: bool = s.else_body.len() > 0
    if then_ok {
        let ab: list[str] = []
        let mut ci: int = 0
        while ci < assigned_before.len() {
            ab.push(assigned_before.get(ci))
            ci = ci + 1
        }
        walk_body_stmts(ctx, s.body, ab, then_sum, depth + 1)
    }
    if else_ok {
        let ab2: list[str] = []
        let mut ci2: int = 0
        while ci2 < assigned_before.len() {
            ab2.push(assigned_before.get(ci2))
            ci2 = ci2 + 1
        }
        walk_body_stmts(ctx, s.else_body, ab2, else_sum, depth + 1)
    }
    # all_vars = then ∪ else (in that order)
    let all_vars: list[str] = []
    if then_ok {
        let tk: list[str] = then_sum.trans.keys()
        let mut t1: int = 0
        while t1 < tk.len() {
            if !list_has_str(all_vars, tk.get(t1)) {
                all_vars.push(tk.get(t1))
            }
            t1 = t1 + 1
        }
        let uk: list[str] = then_sum.unmodeled.keys()
        let mut u1: int = 0
        while u1 < uk.len() {
            if !list_has_str(all_vars, uk.get(u1)) {
                all_vars.push(uk.get(u1))
            }
            u1 = u1 + 1
        }
    }
    if else_ok {
        let tk2: list[str] = else_sum.trans.keys()
        let mut t2: int = 0
        while t2 < tk2.len() {
            if !list_has_str(all_vars, tk2.get(t2)) {
                all_vars.push(tk2.get(t2))
            }
            t2 = t2 + 1
        }
        let uk2: list[str] = else_sum.unmodeled.keys()
        let mut u2: int = 0
        while u2 < uk2.len() {
            if !list_has_str(all_vars, uk2.get(u2)) {
                all_vars.push(uk2.get(u2))
            }
            u2 = u2 + 1
        }
    }
    let mut vi: int = 0
    while vi < all_vars.len() {
        let v: str = all_vars.get(vi)
        let in_then_unmod: bool = then_ok && then_sum.unmodeled.has(v)
        let in_else_unmod: bool = else_ok && else_sum.unmodeled.has(v)
        if in_then_unmod || in_else_unmod {
            summary.unmodeled.set(v, "assigned under control flow")
            summary.trans = disj_map_del(summary.trans, v)
            vi = vi + 1
            continue
        }
        let disjs: list[Disj] = []
        # (then, else): then contributes its disjuncts
        if then_ok {
            if then_sum.trans.has(v) {
                let td: list[Disj] = then_sum.trans.get_or(v, [])
                let mut di: int = 0
                while di < td.len() {
                    disjs.push(td.get(di))
                    di = di + 1
                }
            } else if else_ok && (else_sum.trans.has(v) || else_sum.unmodeled.has(v)) {
                disjs.push(disj_identity())
            }
        } else {
            if else_ok && (else_sum.trans.has(v) || else_sum.unmodeled.has(v)) {
                disjs.push(disj_identity())
            }
        }
        # (else, then): else contributes its disjuncts
        if else_ok {
            if else_sum.trans.has(v) {
                let ed: list[Disj] = else_sum.trans.get_or(v, [])
                let mut ei: int = 0
                while ei < ed.len() {
                    disjs.push(ed.get(ei))
                    ei = ei + 1
                }
            } else if then_ok && (then_sum.trans.has(v) || then_sum.unmodeled.has(v)) {
                disjs.push(disj_identity())
            }
        } else {
            if then_ok && (then_sum.trans.has(v) || then_sum.unmodeled.has(v)) {
                disjs.push(disj_identity())
            }
        }
        if disjs.len() > 0 {
            summary.trans.set(v, disjs)
        } else {
            summary.unmodeled.set(v, "assigned under control flow")
        }
        vi = vi + 1
    }
    # drop trans entries that became unmodeled
    let trans_keys: list[str] = summary.trans.keys()
    let mut ti: int = 0
    while ti < trans_keys.len() {
        if summary.unmodeled.has(trans_keys.get(ti)) {
            summary.trans = disj_map_del(summary.trans, trans_keys.get(ti))
        }
        ti = ti + 1
    }
    # after the if, merged variables are primed on this path
    let mut ai: int = 0
    while ai < all_vars.len() {
        if !list_has_str(assigned_before, all_vars.get(ai)) {
            assigned_before.push(all_vars.get(ai))
        }
        ai = ai + 1
    }
}

# summarize_body — the transition relation of one loop body.
fn summarize_body(ctx: Ctx, body: list[int]) -> BodySummary {
    let summary: BodySummary = body_summary_new()
    let ab: list[str] = []
    walk_body_stmts(ctx, body, ab, summary, 0)
    return summary
}

# disj_map_del — a fresh copy of the map without `key` (the .py's dict
# pop; Halis maps have no remove — the caller reassigns its field from
# the returned reference, which every alias then sees).
fn disj_map_del(m: map[str, list[Disj]], key: str) -> map[str, list[Disj]] {
    let fresh: map[str, list[Disj]] = map_new()
    let ks: list[str] = m.keys()
    let mut i: int = 0
    while i < ks.len() {
        if ks.get(i) != key {
            fresh.set(ks.get(i), m.get_or(ks.get(i), []))
        }
        i = i + 1
    }
    return fresh
}

# ----------------------------------------------------------------------------
# The loop summary.
# ----------------------------------------------------------------------------

# CondSide — ("lit", v) | ("var", name).
struct CondSide {
    lit: bool,
    ival: int,
    name: str
}

fn cond_side_lit(v: int) -> CondSide {
    return CondSide {
        lit: true, ival: v, name: ""
    }
}

fn cond_side_var(n: str) -> CondSide {
    return CondSide {
        lit: false, ival: 0, name: n
    }
}

# LoopSummary — everything the inference knows about one loop.
struct LoopSummary {
    fn_key: str,
    kind: str, # "while" | "for"
    line: int,
    header: str,
    header_var: str,
    carried: map[str, list[Disj]],
    unmodeled: map[str, str],
    inv_vars: list[str],
    entry_facts: Facts,
    cond_op: str,
    cond_var: str,
    cond_bkind: str, # "lit" | "var" | "" (none)
    cond_bval: int,
    cond_bname: str,
    entry_eq_kind: str, # "lit"|"var"|"" for the for-var start
    entry_eq_val: int,
    entry_eq_name: str,
    runs_guard: bool,
    guard_a: CondSide,
    guard_b: CondSide,
    cands: list[Cand],
    accepted: list[Cand],
    rejected: list[RejectedCand],
    note: str
}

struct RejectedCand {
    cand: Cand,
    why: str
}

# Cand — one candidate invariant.
struct Cand {
    var: str,
    text: str,
    smt: str,
    smt_primed: str,
    tag: str
}

fn loop_summary_new(fn_key: str, kind: str, line: int, header: str) -> LoopSummary {
    return LoopSummary {
        fn_key: fn_key, kind: kind, line: line, header: header,
        header_var: "",
        carried: map_new(), unmodeled: map_new(), inv_vars: [],
        entry_facts: facts_new(),
        cond_op: "", cond_var: "", cond_bkind: "", cond_bval: 0, cond_bname: "",
        entry_eq_kind: "", entry_eq_val: 0, entry_eq_name: "",
        runs_guard: false,
        guard_a: cond_side_lit(0), guard_b: cond_side_lit(0),
        cands: [], accepted: [], rejected: [],
        note: ""
    }
}

# loop_transition_text — the .py's LoopSummary.transition_text.
fn loop_transition_text(loop: LoopSummary, var: str) -> str {
    if loop.unmodeled.has(var) {
        return var + "' = <unmodeled: " + loop.unmodeled.get_or(var, "") + ">"
    }
    if !loop.carried.has(var) {
        return var + "' = <unmodeled: no affine update>"
    }
    let ds: list[Disj] = loop.carried.get_or(var, [])
    if ds.len() == 0 {
        return var + "' = <unmodeled: no affine update>"
    }
    let parts: list[str] = []
    let mut i: int = 0
    while i < ds.len() {
        parts.push(disjunct_text(var, ds.get(i)))
        i = i + 1
    }
    return var + "' = " + pv_join_str_list(parts, " | ")
}

# step_const — the common constant step of pure equal self-steps.
fn step_const(disjs: list[Disj]) -> int {
    # the SENTINEL: -999999 means "not a common const step" (boot's None)
    let mut c0: int = -999999
    let mut i: int = 0
    while i < disjs.len() {
        let d: Disj = disjs.get(i)
        if d.self_c != 1 || d.terms.len() > 0 {
            return -999999
        }
        if c0 != -999999 && d.const != c0 {
            return -999999
        }
        c0 = d.const
        i = i + 1
    }
    if c0 == -999999 {
        return -999999
    }
    return c0
}

# mk_bound_cand — candidate `var op (base + delta)`.
fn mk_bound_cand(var: str, op: str, base_kind: str, base_val: int, base_name: str,
delta: int, tag: str) -> Cand {
    if base_kind == "lit" {
        let bound: int = base_val + delta
        let text: str = var + " " + op + " " + bound.to_str()
        let smt_rhs: str = bound.to_str()
        return Cand {
            var: var, text: text,
            smt: smt_cmp(op, var, smt_rhs),
            smt_primed: smt_cmp(op, var + "_p", smt_rhs),
            tag: tag
        }
    }
    let text2: str = var + " " + op + " " + bump_text(base_name, delta)
    let smt_rhs2: str = smt_bump("var", base_name, delta)
    return Cand {
        var: var, text: text2,
        smt: smt_cmp(op, var, smt_rhs2),
        smt_primed: smt_cmp(op, var + "_p", smt_rhs2),
        tag: tag
    }
}

# ----------------------------------------------------------------------------
# Candidate generation (boot's _generate_candidates).
# ----------------------------------------------------------------------------

# generate_candidates — template instantiation for one loop.
fn generate_candidates(loop: LoopSummary) -> list[Cand] {
    let facts: Facts = loop.entry_facts
    let cands: list[Cand] = []
    let carried_keys: list[str] = loop.carried.keys()
    let mut vi: int = 0
    while vi < carried_keys.len() {
        let var: str = carried_keys.get(vi)
        let disjs: list[Disj] = loop.carried.get_or(var, [])
        let iv: Iv = facts.ints.get_or(var, pv_iv_top())
        let lo: bool = bnd_is_num(iv.lo)
        let hi: bool = bnd_is_num(iv.hi)
        # T1 — entry bounds carried across iterations
        if lo {
            cands.push(mk_bound_cand(var, ">=", "lit", iv.lo.num, "", 0, "entry-bound"))
        }
        if hi {
            cands.push(mk_bound_cand(var, "<=", "lit", iv.hi.num, "", 0, "entry-bound"))
        }
        # T2 — the loop condition, weakened by the step's overshoot
        if loop.cond_op != "" && loop.cond_var == var {
            let bkind: str = loop.cond_bkind
            let bname: str = loop.cond_bname
            let bval: int = loop.cond_bval
            let step: int = step_const(disjs)
            if step != -999999 && step > 0 && bkind != var {
                if loop.cond_op == "<" {
                    cands.push(mk_bound_cand(var, "<=", bkind, bval, bname, step - 1, "cond-bound"))
                } else if loop.cond_op == "<=" {
                    cands.push(mk_bound_cand(var, "<=", bkind, bval, bname, step, "cond-bound"))
                }
            }
            if step != -999999 && step < 0 && bkind != var {
                if loop.cond_op == ">" {
                    cands.push(mk_bound_cand(var, ">=", bkind, bval, bname, step + 1, "cond-bound"))
                } else if loop.cond_op == ">=" {
                    cands.push(mk_bound_cand(var, ">=", bkind, bval, bname, step, "cond-bound"))
                }
            }
        }
        # T4 — congruence: a constant step preserves the residue class
        # of an exactly-known start (the non-interval family the
        # interval engine cannot express). NOT bound to the condition
        # variable — every loop-carried stepper with a const step and a
        # const entry value earns the candidate (mod4: k steps by 1,
        # x by 4 — the congruence is about x).
        let step2: int = step_const(disjs)
        if step2 != -999999 && step2 != 0 && step2 != 1 && step2 != -1
        && iv_is_const(iv) {
            let mut m: int = step2
            if m < 0 {
                m = -m
            }
            let start: int = iv.lo.num
            let text: str = var + " ≡ " + py_mod(start, m).to_str() + " (mod " + m.to_str() + ")"
            let smt: str = "(= (mod " + var + " " + m.to_str() + ") (mod " + start.to_str() + " " + m.to_str() + "))"
            let smt_p: str = "(= (mod " + var + "_p " + m.to_str() + ") (mod " + start.to_str() + " " + m.to_str() + "))"
            cands.push(Cand {
                var: var, text: text, smt: smt, smt_primed: smt_p, tag: "modular"
            })
        }
        vi = vi + 1
    }
    # for-range: the loop variable's start anchors a lower bound
    if loop.kind == "for" && loop.entry_eq_kind != "" {
        let var: str = loop.header_var
        let lo_known: bool = !loop.unmodeled.has(var) && loop.carried.has(var)
        if lo_known {
            if loop.entry_eq_kind == "lit" {
                let tag_txt: str = var + " >= " + loop.entry_eq_val.to_str()
                if !has_entry_bound_with_text(cands, var, tag_txt) {
                    cands.push(mk_bound_cand(var, ">=", "lit", loop.entry_eq_val, "", 0, "range"))
                }
            } else {
                let tag_txt2: str = var + " >= " + loop.entry_eq_name
                if !has_entry_bound_with_text(cands, var, tag_txt2) {
                    cands.push(mk_bound_cand(var, ">=", "var", 0, loop.entry_eq_name, 0, "range"))
                }
            }
        }
    }
    # verification order: candidates on variables that other variables'
    # transitions read go first (the strengthening loop)
    let read_by: list[str] = []
    let read_by_vals: list[list[str]] = []
    let ck: list[str] = loop.carried.keys()
    let mut ri: int = 0
    while ri < ck.len() {
        read_by.push(ck.get(ri))
        read_by_vals.push([])
        ri = ri + 1
    }
    let mut rj: int = 0
    while rj < ck.len() {
        let v: str = ck.get(rj)
        let disjs: list[Disj] = loop.carried.get_or(v, [])
        let mut di: int = 0
        while di < disjs.len() {
            let d: Disj = disjs.get(di)
            let mut ti: int = 0
            while ti < d.terms.len() {
                let tn: str = d.terms.get(ti).name
                let mut tidx: int = -1
                let mut x: int = 0
                while x < read_by.len() {
                    if read_by.get(x) == tn {
                        tidx = x
                    }
                    x = x + 1
                }
                if tidx >= 0 && tn != v {
                    if !list_has_str(read_by_vals.get(tidx), v) {
                        read_by_vals.get(tidx).push(v)
                    }
                }
                ti = ti + 1
            }
            di = di + 1
        }
        rj = rj + 1
    }
    # stable sort by (class, var, tag)
    let mut sorted: list[Cand] = []
    let mut si: int = 0
    while si < cands.len() {
        let c: Cand = cands.get(si)
        let mut cls: int = 1
        let mut cidx: int = -1
        let mut x2: int = 0
        while x2 < read_by.len() {
            if read_by.get(x2) == c.var {
                cidx = x2
            }
            x2 = x2 + 1
        }
        if cidx >= 0 && read_by_vals.get(cidx).len() > 0 {
            cls = 0
        }
        # insert before the first strictly greater (class, var, tag)
        let res: list[Cand] = []
        let mut placed: bool = false
        let mut j: int = 0
        let res_c: list[Cand] = []
        while j < sorted.len() {
            let o: Cand = sorted.get(j)
            if !placed {
                let mut ocls: int = 1
                let mut ocidx: int = -1
                let mut x3: int = 0
                while x3 < read_by.len() {
                    if read_by.get(x3) == o.var {
                        ocidx = x3
                    }
                    x3 = x3 + 1
                }
                if ocidx >= 0 && read_by_vals.get(ocidx).len() > 0 {
                    ocls = 0
                }
                if cls < ocls || (cls == ocls && c.var < o.var)
                || (cls == ocls && c.var == o.var && c.tag < o.tag) {
                    res.push(c)
                    res_c.push(c)
                    res.push(o)
                    res_c.push(o)
                    placed = true
                } else {
                    res.push(o)
                    res_c.push(o)
                }
            } else {
                res.push(o)
                res_c.push(o)
            }
            j = j + 1
        }
        if !placed {
            res.push(c)
            res_c.push(c)
        }
        sorted = res_c
        si = si + 1
    }
    # dedup by (var, text)
    let out: list[Cand] = []
    let seen_var: list[str] = []
    let seen_text: list[str] = []
    let mut oi: int = 0
    while oi < sorted.len() {
        let c2: Cand = sorted.get(oi)
        let mut dup: bool = false
        let mut qi: int = 0
        while qi < seen_var.len() {
            if seen_var.get(qi) == c2.var && seen_text.get(qi) == c2.text {
                dup = true
            }
            qi = qi + 1
        }
        if !dup {
            seen_var.push(c2.var)
            seen_text.push(c2.text)
            out.push(c2)
        }
        oi = oi + 1
    }
    return out
}

# has_entry_bound_with_text — the for-range dedup probe.
fn has_entry_bound_with_text(cands: list[Cand], var: str, text: str) -> bool {
    let mut i: int = 0
    while i < cands.len() {
        let c: Cand = cands.get(i)
        if c.var == var && c.tag == "entry-bound" && c.text == text {
            return true
        }
        i = i + 1
    }
    return false
}

# ----------------------------------------------------------------------------
# build_summary — summarise one loop node.
# ----------------------------------------------------------------------------

# parse_cond_into — the .py's _parse_cond: (op, var, bkind, bval) with
# the variable on the left; false when not recognised.
fn parse_cond_into(ctx: Ctx, e: int, loop: LoopSummary) -> bool {
    if e < 0 {
        return false
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind != "bin" {
        return false
    }
    let op: str = n.op
    if op != "<" && op != "<=" && op != ">" && op != ">=" && op != "!=" && op != "==" {
        return false
    }
    if n.left < 0 || n.right < 0 {
        return false
    }
    let ln: ExprN = ctx.exprs[n.left]
    let rn: ExprN = ctx.exprs[n.right]
    let l_ok: bool = ln.kind == "int" || ln.kind == "ident"
    let r_ok: bool = rn.kind == "int" || rn.kind == "ident"
    if !l_ok && !r_ok {
        return false
    }
    # var on the left
    if ln.kind == "ident" && r_ok {
        loop.cond_op = op
        loop.cond_var = ln.name
        if rn.kind == "int" {
            loop.cond_bkind = "lit"
            loop.cond_bval = rn.ival
            loop.cond_bname = ""
        } else {
            loop.cond_bkind = "var"
            loop.cond_bval = 0
            loop.cond_bname = rn.name
        }
        return true
    }
    # var on the right — flip
    if rn.kind == "ident" && l_ok {
        let mut eff: str = op
        if op == "<" {
            eff = ">"
        } else if op == "<=" {
            eff = ">="
        } else if op == ">" {
            eff = "<"
        } else if op == ">=" {
            eff = "<="
        }
        loop.cond_op = eff
        loop.cond_var = rn.name
        if ln.kind == "int" {
            loop.cond_bkind = "lit"
            loop.cond_bval = ln.ival
            loop.cond_bname = ""
        } else {
            loop.cond_bkind = "var"
            loop.cond_bval = 0
            loop.cond_bname = ln.name
        }
        return true
    }
    return false
}

# parse_range — range(a, b) bounds into the loop's guard/eq fields.
fn parse_range_into(ctx: Ctx, e: int, loop: LoopSummary) -> bool {
    if e < 0 {
        return false
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind != "call" || n.mkey != "range" || n.muser != false {
        return false
    }
    if n.args.len() != 2 {
        return false
    }
    if n.args.get(0) < 0 || n.args.get(1) < 0 {
        return false
    }
    let an: ExprN = ctx.exprs[n.args.get(0)]
    let bn: ExprN = ctx.exprs[n.args.get(1)]
    let a_ok: bool = an.kind == "int" || an.kind == "ident"
    let b_ok: bool = bn.kind == "int" || bn.kind == "ident"
    if !a_ok || !b_ok {
        return false
    }
    if an.kind == "int" {
        loop.guard_a = cond_side_lit(an.ival)
    } else {
        loop.guard_a = cond_side_var(an.name)
    }
    if bn.kind == "int" {
        loop.guard_b = cond_side_lit(bn.ival)
    } else {
        loop.guard_b = cond_side_var(bn.name)
    }
    return true
}

# build_summary — one loop's summary.
fn build_summary(ctx: Ctx, fn_key: str, s: StmtN, kind: str,
entry_facts: Facts) -> LoopSummary {
    let mut var: str = ""
    let mut header: str = ""
    if kind == "for" {
        var = s.name
        header = "for " + var + " in " + expr_text_inf(ctx, s.iter)
    } else {
        header = "while " + expr_text_inf(ctx, s.cond)
    }
    let loop: LoopSummary = loop_summary_new(fn_key, kind, s.line, header)
    loop.header_var = var
    loop.entry_facts = entry_facts
    let body: list[int] = s.body
    let body_assigned: list[str] = []
    assigned_names(ctx, body, body_assigned, 0)
    let carried_names: list[str] = []
    let mut bi: int = 0
    while bi < body_assigned.len() {
        carried_names.push(body_assigned.get(bi))
        bi = bi + 1
    }
    if kind == "for" && var != "" {
        if !list_has_str(carried_names, var) {
            carried_names.push(var)
        }
    }
    if has_escape(ctx, body, 0) {
        let mut ci: int = 0
        while ci < carried_names.len() {
            loop.unmodeled.set(carried_names.get(ci), "body escapes through return/break/continue")
            ci = ci + 1
        }
        loop.note = "body has return/break/continue — every assignment goes unmodeled (sound, less precise)"
    } else {
        let bsum: BodySummary = summarize_body(ctx, body)
        loop.carried = bsum.trans
        loop.unmodeled = bsum.unmodeled
        # inv_vars: reads minus the loop var minus carried/unmodeled
        let reads: list[str] = bsum.reads
        let mut ri: int = 0
        while ri < reads.len() {
            let nm: str = reads.get(ri)
            if nm != var && !loop.carried.has(nm) && !loop.unmodeled.has(nm) {
                if !list_has_str(loop.inv_vars, nm) {
                    loop.inv_vars.push(nm)
                }
            }
            ri = ri + 1
        }
    }
    if kind == "while" {
        if !parse_cond_into(ctx, s.cond, loop) {
            if loop.note == "" {
                loop.note = "condition not in var/literal-or-var form — no condition-derived candidates"
            }
        }
    } else {
        # for: the range grammar
        let parsed: bool = parse_range_into(ctx, s.iter, loop)
        if !parsed {
            if loop.note == "" {
                loop.note = "iterable not a range(literal|var, literal|var) — the loop variable is unmodeled"
            }
            if var != "" && !loop.unmodeled.has(var) {
                loop.unmodeled.set(var, "non-range iterable")
            }
        } else {
            let mut akind: str = ""
            let mut aval: int = 0
            let mut aname: str = ""
            if loop.guard_a.lit {
                akind = "lit"
                aval = loop.guard_a.ival
            } else {
                akind = "var"
                aname = loop.guard_a.name
            }
            let mut bkind2: str = ""
            let mut bval2: int = 0
            let mut bname2: str = ""
            if loop.guard_b.lit {
                bkind2 = "lit"
                bval2 = loop.guard_b.ival
            } else {
                bkind2 = "var"
                bname2 = loop.guard_b.name
            }
            let ok_a: bool = akind == "lit" || (akind == "var" && !list_has_str(carried_names, aname))
            let ok_b: bool = bkind2 == "lit" || (bkind2 == "var" && !list_has_str(carried_names, bname2))
            let var_clean: bool = var != "" && !loop.unmodeled.has(var)
            if ok_a && ok_b && var_clean {
                let one: list[Disj] = [Disj {
                    self_c: 1, terms: [], const: 1
                }]
                loop.carried.set(var, one)
                loop.entry_eq_kind = akind
                loop.entry_eq_val = aval
                loop.entry_eq_name = aname
                loop.cond_op = "<"
                loop.cond_var = var
                loop.cond_bkind = bkind2
                loop.cond_bval = bval2
                loop.cond_bname = bname2
                loop.runs_guard = true
            } else if !var_clean {
                # already unmodeled with its reason
            } else {
                if loop.note == "" {
                    loop.note = "range bounds reference a loop-carried variable — the loop variable is unmodeled"
                }
                loop.unmodeled.set(var, "range bounds not loop-invariant")
            }
        }
        # an unmodeled loop variable must not keep a transition
        if loop.header_var != "" && loop.unmodeled.has(loop.header_var) {
            loop.carried = disj_map_del(loop.carried, loop.header_var)
        }
    }
    loop.cands = generate_candidates(loop)
    return loop
}

# ----------------------------------------------------------------------------
# The obligations (boot's _loop_decl_names / _entry_fact_asserts /
# _transition_conjuncts / _obligation_segments).
# ----------------------------------------------------------------------------

# loop_decl_names — every int variable the obligations mention.
fn loop_decl_names(loop: LoopSummary) -> list[str] {
    let decls: list[str] = []
    let ck: list[str] = loop.carried.keys()
    let mut i: int = 0
    while i < ck.len() {
        if !list_has_str(decls, ck.get(i)) {
            decls.push(ck.get(i))
        }
        i = i + 1
    }
    let uk: list[str] = loop.unmodeled.keys()
    let mut j: int = 0
    while j < uk.len() {
        if !list_has_str(decls, uk.get(j)) {
            decls.push(uk.get(j))
        }
        j = j + 1
    }
    if loop.cond_op != "" {
        if !list_has_str(decls, loop.cond_var) {
            decls.push(loop.cond_var)
        }
        if loop.cond_bkind == "var" {
            if !list_has_str(decls, loop.cond_bname) {
                decls.push(loop.cond_bname)
            }
        }
    }
    if loop.entry_eq_kind != "" && loop.header_var != "" {
        if !list_has_str(decls, loop.header_var) {
            decls.push(loop.header_var)
        }
    }
    if loop.runs_guard {
        if !loop.guard_a.lit {
            if !list_has_str(decls, loop.guard_a.name) {
                decls.push(loop.guard_a.name)
            }
        }
        if !loop.guard_b.lit {
            if !list_has_str(decls, loop.guard_b.name) {
                decls.push(loop.guard_b.name)
            }
        }
    }
    let tk: list[str] = loop.carried.keys()
    let mut k: int = 0
    while k < tk.len() {
        let disjs: list[Disj] = loop.carried.get_or(tk.get(k), [])
        let mut d: int = 0
        while d < disjs.len() {
            let dd: Disj = disjs.get(d)
            let mut t: int = 0
            while t < dd.terms.len() {
                if !list_has_str(decls, dd.terms.get(t).name) {
                    decls.push(dd.terms.get(t).name)
                }
                t = t + 1
            }
            d = d + 1
        }
        k = k + 1
    }
    return decls
}

# entry_fact_asserts — numeric interval facts at the loop head, for
# declared names only; skip_carried drops the carried/unmodeled set.
fn entry_fact_asserts(loop: LoopSummary, decls: list[str],
skip_carried: bool) -> list[str] {
    let out: list[str] = []
    let names: list[str] = loop.entry_facts.ints.keys()
    let mut i: int = 0
    while i < names.len() {
        let name: str = names.get(i)
        let iv: Iv = loop.entry_facts.ints.get_or(name, pv_iv_top())
        if !list_has_str(decls, name) {
            i = i + 1
            continue
        }
        if skip_carried && (loop.carried.has(name) || loop.unmodeled.has(name)) {
            i = i + 1
            continue
        }
        if iv.lo.sym || iv.hi.sym {
            i = i + 1
            continue
        }
        if bnd_is_num(iv.lo) && bnd_is_num(iv.hi) && iv.lo.num == iv.hi.num {
            out.push("(assert (= " + name + " " + iv.lo.num.to_str() + "))")
        } else {
            if bnd_is_num(iv.lo) {
                out.push("(assert (>= " + name + " " + iv.lo.num.to_str() + "))")
            }
            if bnd_is_num(iv.hi) {
                out.push("(assert (<= " + name + " " + iv.hi.num.to_str() + "))")
            }
        }
        i = i + 1
    }
    return out
}

# transition_conjuncts — (= v_p rhs) per modeled carried variable.
fn transition_conjuncts(loop: LoopSummary) -> list[str] {
    let out: list[str] = []
    let ck: list[str] = sort_str_list(loop.carried.keys())
    let mut i: int = 0
    while i < ck.len() {
        let v: str = ck.get(i)
        let disjs: list[Disj] = loop.carried.get_or(v, [])
        let eqs: list[str] = []
        let mut d: int = 0
        while d < disjs.len() {
            eqs.push("(= " + v + "_p " + disjunct_smt(v, disjs.get(d), false) + ")")
            d = d + 1
        }
        if eqs.len() == 1 {
            out.push(eqs.get(0))
        } else if eqs.len() > 1 {
            out.push("(or " + pv_join_str_list(eqs, " ") + ")")
        }
        i = i + 1
    }
    return out
}

# Seg — one obligation segment.
struct Seg {
    lines: list[str]
}

# segment — prelude + comment + asserts + check-sat.
fn segment(prelude_lines: list[str], comment: str, asserts: list[str]) -> list[str] {
    let lines: list[str] = []
    let mut i: int = 0
    while i < prelude_lines.len() {
        lines.push(prelude_lines.get(i))
        i = i + 1
    }
    lines.push(comment)
    let mut j: int = 0
    while j < asserts.len() {
        lines.push(asserts.get(j))
        j = j + 1
    }
    lines.push("(check-sat)")
    return lines
}

# obligation_prelude — the declare-const list (primed optionally).
fn obligation_prelude(decls: list[str], with_primed: bool) -> list[str] {
    let lines: list[str] = []
    let sd: list[str] = sort_str_list(decls)
    let mut i: int = 0
    while i < sd.len() {
        lines.push("(declare-const " + sd.get(i) + " Int)")
        i = i + 1
    }
    if with_primed {
        let mut j: int = 0
        while j < sd.len() {
            lines.push("(declare-const " + sd.get(j) + "_p Int)")
            j = j + 1
        }
    }
    return lines
}

# obligation_segments — the two SMT segments for ONE candidate.
fn obligation_segments(loop: LoopSummary, cand: Cand,
accepted_prefix: list[Cand]) -> list[Seg] {
    let decls: list[str] = loop_decl_names(loop)
    let fact_asserts: list[str] = entry_fact_asserts(loop, decls, false)
    # entry_eq / guard / cond in SMT form
    let mut entry_eq_smt: str = ""
    if loop.entry_eq_kind != "" && loop.header_var != "" {
        if loop.entry_eq_kind == "lit" {
            entry_eq_smt = "(= " + loop.header_var + " " + loop.entry_eq_val.to_str() + ")"
        } else {
            entry_eq_smt = "(= " + loop.header_var + " " + loop.entry_eq_name + ")"
        }
    }
    let mut guard_smt: str = ""
    if loop.runs_guard {
        let mut a_s: str = ""
        if loop.guard_a.lit {
            a_s = loop.guard_a.ival.to_str()
        } else {
            a_s = loop.guard_a.name
        }
        let mut b_s: str = ""
        if loop.guard_b.lit {
            b_s = loop.guard_b.ival.to_str()
        } else {
            b_s = loop.guard_b.name
        }
        guard_smt = "(< " + a_s + " " + b_s + ")"
    }
    let mut cond_smt: str = ""
    if loop.cond_op != "" {
        let mut bs: str = ""
        if loop.cond_bkind == "lit" {
            bs = loop.cond_bval.to_str()
        } else {
            bs = loop.cond_bname
        }
        cond_smt = smt_cmp(loop.cond_op, loop.cond_var, bs)
    }
    # -- initiation
    let init_asserts: list[str] = []
    let mut ia: int = 0
    while ia < fact_asserts.len() {
        init_asserts.push(fact_asserts.get(ia))
        ia = ia + 1
    }
    if entry_eq_smt != "" {
        init_asserts.push("(assert " + entry_eq_smt + ")")
    }
    if guard_smt != "" {
        init_asserts.push("(assert " + guard_smt + ")")
    }
    init_asserts.push("(assert (not " + cand.smt + "))")
    let init_seg: list[str] = segment(obligation_prelude(decls, false),
    "; initiation of [" + cand.text + "] (" + cand.tag + "): unsat => holds on entry",
    init_asserts)
    # -- preservation
    let keep_asserts: list[str] = []
    keep_asserts.push("(assert " + cand.smt + ")")
    let mut ka: int = 0
    while ka < accepted_prefix.len() {
        keep_asserts.push("(assert " + accepted_prefix.get(ka).smt + ")")
        ka = ka + 1
    }
    let env_asserts: list[str] = entry_fact_asserts(loop, decls, true)
    let mut ea: int = 0
    while ea < env_asserts.len() {
        keep_asserts.push(env_asserts.get(ea))
        ea = ea + 1
    }
    if cond_smt != "" {
        keep_asserts.push("(assert " + cond_smt + ")")
    }
    let tcs: list[str] = transition_conjuncts(loop)
    let mut ta: int = 0
    while ta < tcs.len() {
        keep_asserts.push("(assert " + tcs.get(ta) + ")")
        ta = ta + 1
    }
    keep_asserts.push("(assert (not " + cand.smt_primed + "))")
    let hyp_parts: list[str] = []
    hyp_parts.push(cand.text)
    let mut hp: int = 0
    while hp < accepted_prefix.len() {
        hyp_parts.push(accepted_prefix.get(hp).text)
        hp = hp + 1
    }
    let keep_seg: list[str] = segment(obligation_prelude(decls, true),
    "; preservation of [" + cand.text + "] given [" + pv_join_str_list(hyp_parts, ", ") + "]: unsat => inductive",
    keep_asserts)
    let out: list[Seg] = []
    out.push(Seg {
        lines: init_seg
    })
    out.push(Seg {
        lines: keep_seg
    })
    return out
}

# smt_program_text — the .smt2 dump for a set of segments.
fn smt_program_text(header_comment: str, segments: list[Seg]) -> str {
    let lines: list[str] = []
    lines.push(header_comment)
    let mut i: int = 0
    while i < segments.len() {
        let seg: Seg = segments.get(i)
        let mut j: int = 0
        while j < seg.lines.len() {
            lines.push(seg.lines.get(j))
            j = j + 1
        }
        lines.push("(reset)")
        lines.push("")
        i = i + 1
    }
    let joined: str = join(lines, "\n")
    # rstrip the trailing blank/whitespace, then one final newline
    let mut t: str = joined
    while t.len() > 0 {
        let c: int = t.byte_at(t.len() - 1)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            t = t.slice(0, t.len() - 1)
        } else {
            break
        }
    }
    return t + "\n"
}

# verify_loop — greedy strengthening; fills accepted/rejected; returns
# the verified segments for --smt dumps.
fn verify_loop(loop: LoopSummary, d: Decider) -> list[Seg] uses Fs, Proc, Clock {
    loop.accepted = []
    loop.rejected = []
    let segments: list[Seg] = []
    if !d.ok {
        return segments
    }
    let mut i: int = 0
    while i < loop.cands.len() {
        let cand: Cand = loop.cands.get(i)
        let segs: list[Seg] = obligation_segments(loop, cand, loop.accepted)
        let init_v: str = decider_decide(d, segs.get(0).lines)
        if init_v != "unsat" {
            loop.rejected.push(RejectedCand {
                cand: cand, why: "initiation"
            })
            i = i + 1
            continue
        }
        let keep_v: str = decider_decide(d, segs.get(1).lines)
        if keep_v != "unsat" {
            loop.rejected.push(RejectedCand {
                cand: cand, why: "preservation"
            })
            i = i + 1
            continue
        }
        loop.accepted.push(cand)
        segments.push(segs.get(0))
        segments.push(segs.get(1))
        i = i + 1
    }
    return segments
}

# ----------------------------------------------------------------------------
# infer_loops — collect and summarise every loop of every fn.
# ----------------------------------------------------------------------------

fn infer_loops(ctx: Ctx) -> list[LoopSummary] {
    let loops: list[LoopSummary] = []
    let keys: list[str] = ctx.fns.keys()
    let mut fi: int = 0
    while fi < keys.len() {
        let key: str = keys.get(fi)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if f.is_extern {
            fi = fi + 1
            continue
        }
        let facts: Facts = facts_new()
        if f.requires_e >= 0 {
            seed_walk(ctx, f.requires_e, f, facts)
        }
        let hook: LoopHook = loop_hook_new()
        propagate_stmts_f(ctx, f.body, facts, 0, hook)
        # build a summary per first-visit loop, in fire order
        let mut hi: int = 0
        while hi < hook.seen.len() {
            let stmt_idx: int = hook.seen.get(hi)
            let kind: str = hook.kinds.get(hi)
            let snap: Facts = hook.snaps.get(hi)
            let s: StmtN = ctx.stmts.get(stmt_idx)
            loops.push(build_summary(ctx, key, s, kind, snap))
            hi = hi + 1
        }
        fi = fi + 1
    }
    return loops
}

# ----------------------------------------------------------------------------
# The --infer-invariants report (the .py's infer_invariants).
# ----------------------------------------------------------------------------

fn infer_invariants_report(ctx: Ctx, want_smt: bool, out_dir: str,
d: Decider, solver_name: str) -> int uses IO, Fs, Proc, Clock {
    # returns (accepted*1000 + rejected) — two ints in one (Halis fns
    # return one value; the caller unpacks)
    let loops: list[LoopSummary] = infer_loops(ctx)
    let mut accepted: int = 0
    let mut rejected: int = 0
    if loops.len() == 0 {
        println("  No loops found.")
        return 0
    }
    let mut li: int = 0
    while li < loops.len() {
        let loop: LoopSummary = loops.get(li)
        println("  " + loop.fn_key + ":" + loop.line.to_str() + ": " + loop.header)
        let carried: list[str] = []
        let ck: list[str] = sort_str_list(loop.carried.keys())
        let mut ci: int = 0
        while ci < ck.len() {
            carried.push(loop_transition_text(loop, ck.get(ci)))
            ci = ci + 1
        }
        let unmod: list[str] = []
        let uk: list[str] = sort_str_list(loop.unmodeled.keys())
        let mut ui: int = 0
        while ui < uk.len() {
            let v: str = uk.get(ui)
            unmod.push(v + " (" + loop.unmodeled.get_or(v, "") + ")")
            ui = ui + 1
        }
        if carried.len() > 0 {
            println("    loop-carried: " + pv_join_str_list(carried, ", "))
        }
        if unmod.len() > 0 {
            println("    unmodeled: " + pv_join_str_list(unmod, ", "))
        }
        if loop.inv_vars.len() > 0 {
            println("    invariant over: " + pv_join_str_list(sort_str_list(loop.inv_vars), ", "))
        }
        if loop.note != "" {
            println("    note: " + loop.note)
        }
        if loop.cands.len() == 0 {
            println("    no candidates (nothing about this loop can be discharged)")
            if !d.ok {
                # the .py continues with no trailing blank
                li = li + 1
                continue
            }
        }
        if !d.ok {
            let ctexts: list[str] = []
            let mut xi: int = 0
            while xi < loop.cands.len() {
                ctexts.push(loop.cands.get(xi).text)
                xi = xi + 1
            }
            println("    candidates: " + pv_join_str_list(ctexts, ", "))
            if solver_name == "cvc5" {
                println("    (no cvc5 binary and no cvc5 module — candidates are NOT verified, nothing is claimed as inferred; install a cvc5 binary or pip install cvc5)")
            } else {
                println("    (no z3 binary and no z3-solver module — candidates are NOT verified, nothing is claimed as inferred; install z3 or pip install z3-solver)")
            }
            rejected = rejected + loop.cands.len()
            li = li + 1
            continue
        }
        let segs: list[Seg] = verify_loop(loop, d)
        accepted = accepted + loop.accepted.len()
        rejected = rejected + loop.rejected.len()
        if loop.accepted.len() > 0 {
            println("    inferred (" + solver_name + "-verified inductive):")
            let mut ai: int = 0
            while ai < loop.accepted.len() {
                let c: Cand = loop.accepted.get(ai)
                println("      " + c.text + "   (" + c.tag + ")")
                ai = ai + 1
            }
        } else {
            println("    inferred: (none)")
        }
        let mut ri: int = 0
        while ri < loop.rejected.len() {
            let rc: RejectedCand = loop.rejected.get(ri)
            println("    rejected: " + rc.cand.text + " (" + rc.why + " obligation not discharged)")
            ri = ri + 1
        }
        if want_smt && segs.len() > 0 {
            let fname: str = str_replace(loop.fn_key, ".", "_") + "__L" + loop.line.to_str() + ".smt2"
            let mut fpath: str = out_dir
            if out_dir != "." {
                fpath = out_dir + "/" + fname
            } else {
                fpath = fname
            }
            let atexts: list[str] = []
            let mut aj: int = 0
            while aj < loop.accepted.len() {
                atexts.push(loop.accepted.get(aj).text)
                aj = aj + 1
            }
            let mut aset: str = pv_join_str_list(atexts, ", ")
            if aset == "" {
                aset = "(none)"
            }
            write_file(fpath, smt_program_text(
            "; Halis loop-invariant obligations — " + loop.fn_key + ":" + loop.line.to_str() + " " + loop.header + "\n; verified inductive set: " + aset,
            segs))
            println("    obligations -> " + fpath)
        }
        println("")
        li = li + 1
    }
    return accepted * 100000 + rejected
}

# ============================================================================
# Part 6 — Stage 100: the separation-logic fragment (heap shapes).
# ============================================================================

# The wildcard class id.
fn SHAPE_WILD() -> int {
    return -1
}

# AliasState — alias classes over list-typed bindings. The class ids
# are ints, but a v0.3 map only takes str keys, so members/fresh key
# on the id's decimal spelling (cid.to_str() at every door).
struct AliasState {
    owner: map[str, int], # binding -> cid | WILD
    members: map[str, list[str]], # cid (as str) -> bindings
    fresh: map[str, bool],
    next_cid: int
}

fn alias_state_new() -> AliasState {
    return AliasState {
        owner: map_new(), members: map_new(), fresh: map_new(), next_cid: 0
    }
}

fn alias_new_class(st: AliasState, name: str, is_fresh: bool) -> int {
    let cid: int = st.next_cid
    st.next_cid = st.next_cid + 1
    let m: list[str] = [name]
    st.members.set(cid.to_str(), m)
    st.fresh.set(cid.to_str(), is_fresh)
    st.owner.set(name, cid)
    return cid
}

fn alias_join(st: AliasState, name: str, cid: int) -> void {
    if cid == SHAPE_WILD() {
        st.owner.set(name, SHAPE_WILD())
        return
    }
    st.owner.set(name, cid)
    if st.members.has(cid.to_str()) {
        if !list_has_str(st.members.get_or(cid.to_str(), []), name) {
            st.members.get_or(cid.to_str(), []).push(name)
        }
    } else {
        let m2: list[str] = [name]
        st.members.set(cid.to_str(), m2)
    }
}

fn alias_drop(st: AliasState, name: str) -> void {
    if !st.owner.has(name) {
        return
    }
    let cid: int = st.owner.get_or(name, SHAPE_WILD())
    if cid != SHAPE_WILD() && st.members.has(cid.to_str()) {
        if list_has_str(st.members.get_or(cid.to_str(), []), name) {
            let fresh: list[str] = []
            let ms: list[str] = st.members.get_or(cid.to_str(), [])
            let mut i: int = 0
            while i < ms.len() {
                if ms.get(i) != name {
                    fresh.push(ms.get(i))
                }
                i = i + 1
            }
            st.members.set(cid.to_str(), fresh)
        }
    }
    # delete owner[name] (rebuild without the key)
    let fresh_owner: map[str, int] = map_new()
    let oks: list[str] = st.owner.keys()
    let mut j: int = 0
    while j < oks.len() {
        if oks.get(j) != name {
            fresh_owner.set(oks.get(j), st.owner.get_or(oks.get(j), SHAPE_WILD()))
        }
        j = j + 1
    }
    st.owner = fresh_owner
}

fn alias_of(st: AliasState, name: str) -> int {
    if st.owner.has(name) {
        return st.owner.get_or(name, SHAPE_WILD())
    }
    return SHAPE_WILD()
}

fn alias_repr_of(st: AliasState, cid: int) -> str {
    if cid == SHAPE_WILD() {
        return "?"
    }
    if !st.members.has(cid.to_str()) {
        return "?"
    }
    let mem: list[str] = st.members.get_or(cid.to_str(), [])
    if mem.len() == 0 {
        return "?"
    }
    return sort_str_list(mem).get(0)
}

fn alias_snapshot(st: AliasState) -> AliasState {
    let cp: AliasState = alias_state_new()
    let oks: list[str] = st.owner.keys()
    let mut i: int = 0
    while i < oks.len() {
        cp.owner.set(oks.get(i), st.owner.get_or(oks.get(i), SHAPE_WILD()))
        i = i + 1
    }
    let mks: list[str] = st.members.keys()
    let mut j: int = 0
    while j < mks.len() {
        let src: list[str] = st.members.get_or(mks.get(j), [])
        let dst: list[str] = []
        let mut k: int = 0
        while k < src.len() {
            dst.push(src.get(k))
            k = k + 1
        }
        cp.members.set(mks.get(j), dst)
        j = j + 1
    }
    let fks: list[str] = st.fresh.keys()
    let mut m: int = 0
    while m < fks.len() {
        cp.fresh.set(fks.get(m), st.fresh.get_or(fks.get(m), false))
        m = m + 1
    }
    cp.next_cid = st.next_cid
    return cp
}

# is_list_type — "list[...]".
fn is_list_type(t: str) -> bool {
    return t.starts_with("list[")
}

# ident_of_e — the ident name of a node.
fn ident_of_e(ctx: Ctx, e: int) -> str {
    if e < 0 {
        return ""
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "ident" {
        return n.name
    }
    return ""
}

# WriteSite — one heap write.
struct WriteSite {
    binding: str,
    kind: str, # "index" | "set" | "push" | "pop"
    idx: int,
    line: int
}

# ShapeLoop — one loop's shape candidate and verdict.
struct ShapeLoop {
    fn_key: str,
    kind: str,
    line: int,
    header: str,
    stmt_idx: int,
    root: str,
    cursor: str,
    cond_op: str,
    steps: list[int],
    cond_ok: bool,
    cond_reason: str,
    frame_ok: bool,
    frame_reasons: list[str],
    has_range_lo: bool,
    range_lo: CondSide,
    entry_facts: Facts,
    status: str,
    shape_text: str,
    segments: list[Seg],
    access_total: int,
    access_safe: int,
    access_blocked: int,
    minlen: int,
    solver_reason: str
}

fn shape_loop_new(fn_key: str, kind: str, line: int, header: str) -> ShapeLoop {
    return ShapeLoop {
        fn_key: fn_key, kind: kind, line: line, header: header,
        stmt_idx: -1, root: "", cursor: "", cond_op: "",
        steps: [], cond_ok: false, cond_reason: "",
        frame_ok: false, frame_reasons: [],
        has_range_lo: false, range_lo: cond_side_lit(0),
        entry_facts: facts_new(),
        status: "refused", shape_text: "", segments: [],
        access_total: 0, access_safe: 0, access_blocked: 0,
        minlen: -1, solver_reason: ""
    }
}

# shape_of_loop_text — the canonical triple.
fn shape_of_loop_text(ls: ShapeLoop) -> str {
    return "lseg(" + ls.root + ", 0, " + ls.cursor + ") * cell(" + ls.root + ", " + ls.cursor + ") * lseg(" + ls.root + ", " + ls.cursor + " + 1, " + ls.root + ".len())"
}

# FnShapes — one function's heap analysis.
struct FnShapes {
    fn_key: str,
    fn_i: FnInfo,
    classes: AliasState,
    writes: list[ShapeWrite],
    reads: list[int], # cids read
    separation: list[SepPair],
    loops: list[ShapeLoop]
}

struct ShapeWrite {
    cid: int
}

struct SepPair {
    ra: str,
    rb: str,
    ok: bool,
    why: str
}

fn fn_shapes_new(fn_key: str, f: FnInfo) -> FnShapes {
    return FnShapes {
        fn_key: fn_key, fn_i: f,
        classes: alias_state_new(),
        writes: [], reads: [], separation: [], loops: []
    }
}

# shape_expr_text — the header renderer (len() calls included).
fn shape_expr_text(ctx: Ctx, e: int) -> str {
    if e < 0 {
        return "?"
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return n.ival.to_str()
    }
    if n.kind == "ident" {
        return n.name
    }
    if n.kind == "method" {
        let tgt: str = shape_expr_text(ctx, n.left)
        if n.name == "len" && n.args.len() == 0 {
            return tgt + ".len()"
        }
        return tgt + "." + n.name + "(..)"
    }
    if n.kind == "call" {
        let args: list[str] = []
        let mut i: int = 0
        while i < n.args.len() {
            args.push(shape_expr_text(ctx, n.args.get(i)))
            i = i + 1
        }
        return n.name + "(" + pv_join_str_list(args, ", ") + ")"
    }
    if n.kind == "bin" {
        return shape_expr_text(ctx, n.left) + " " + n.op + " " + shape_expr_text(ctx, n.right)
    }
    return "?"
}

# ----------------------------------------------------------------------------
# len_anchor — (root, cursor, op) when the cond is `cursor OP root.len()`.
# ----------------------------------------------------------------------------

fn len_root_of(ctx: Ctx, e: int) -> str {
    if e < 0 {
        return ""
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "method" && n.name == "len" && n.muser == false {
        return ident_of_e(ctx, n.left)
    }
    if n.kind == "call" && n.mkey == "len" && n.muser == false {
        if n.args.len() == 1 {
            return ident_of_e(ctx, n.args.get(0))
        }
    }
    return ""
}

# anchor_parts — the parsed (root, cursor, op) of a while cond, or ok=false.
struct AnchorParts {
    ok: bool,
    root: str,
    cursor: str,
    op: str
}

fn anchor_parts_of(ctx: Ctx, e: int) -> AnchorParts {
    let out: AnchorParts = AnchorParts {
        ok: false, root: "", cursor: "", op: ""
    }
    if e < 0 {
        return out
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind != "bin" {
        return out
    }
    let op: str = n.op
    if op != "<" && op != "<=" && op != ">" && op != ">=" {
        return out
    }
    if n.left < 0 || n.right < 0 {
        return out
    }
    # cursor op root.len()
    let cur: str = ident_of_e(ctx, n.left)
    if cur != "" {
        let root: str = len_root_of(ctx, n.right)
        if root != "" {
            out.ok = true
            out.root = root
            out.cursor = cur
            out.op = op
            return out
        }
    }
    # root.len() op cursor — flip
    let cur2: str = ident_of_e(ctx, n.right)
    if cur2 != "" {
        let root2: str = len_root_of(ctx, n.left)
        if root2 != "" {
            let mut eff: str = op
            if op == "<" {
                eff = ">"
            } else if op == "<=" {
                eff = ">="
            } else if op == ">" {
                eff = "<"
            } else if op == ">=" {
                eff = "<="
            }
            out.ok = true
            out.root = root2
            out.cursor = cur2
            out.op = eff
            return out
        }
    }
    return out
}

# ----------------------------------------------------------------------------
# Writes/reads of expressions and statements.
# ----------------------------------------------------------------------------

# iter_writes_reads — every heap write/read inside one expression tree.
fn iter_writes_reads(ctx: Ctx, e: int, out_w: list[WriteSite], out_r: list[str]) -> void {
    if e < 0 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "method" && n.muser == false {
        # builtin list methods (mop carries the op)
        let root: str = ident_of_e(ctx, n.left)
        if root != "" {
            if n.mop == "list.push" || n.mop == "list.pop" {
                out_w.push(WriteSite {
                    binding: root, kind: n.name, idx: -1, line: n.line
                })
            } else if n.mop == "list.set" {
                let mut idx_e: int = -1
                if n.args.len() == 2 {
                    idx_e = n.args.get(0)
                }
                out_w.push(WriteSite {
                    binding: root, kind: "set", idx: idx_e, line: n.line
                })
            } else if n.mop == "list.get" || n.mop == "list.len" {
                if !list_has_str(out_r, root) {
                    out_r.push(root)
                }
            }
        }
    }
    if n.kind == "index" {
        let root2: str = ident_of_e(ctx, n.left)
        if root2 != "" {
            let tn: ExprN = ctx.exprs[n.left]
            if is_list_type(tn.t) {
                if !list_has_str(out_r, root2) {
                    out_r.push(root2)
                }
            }
        }
    }
    iter_writes_reads(ctx, n.left, out_w, out_r)
    iter_writes_reads(ctx, n.right, out_w, out_r)
    if n.kind != "match" {
        let mut i: int = 0
        while i < n.args.len() {
            iter_writes_reads(ctx, n.args.get(i), out_w, out_r)
            i = i + 1
        }
    }
    if n.kind == "match" {
        let mut a: int = 0
        while a < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
            iter_writes_reads(ctx, arm.body, out_w, out_r)
            a = a + 1
        }
        iter_writes_reads(ctx, n.left, out_w, out_r)
    }
    if n.kind == "qmark" {
        iter_writes_reads(ctx, n.left, out_w, out_r)
    }
    if n.kind == "structlit" {
        let mut fi: int = 0
        while fi < n.args.len() {
            iter_writes_reads(ctx, n.args.get(fi), out_w, out_r)
            fi = fi + 1
        }
    }
}

# stmt_writes_reads — one statement's writes/reads.
fn stmt_writes_reads(ctx: Ctx, s: StmtN, out_w: list[WriteSite], out_r: list[str]) -> void {
    if s.kind == "assign" {
        if s.target >= 0 {
            let t: ExprN = ctx.exprs[s.target]
            if t.kind == "index" {
                let root: str = ident_of_e(ctx, t.left)
                if root != "" {
                    let tn: ExprN = ctx.exprs[t.left]
                    if is_list_type(tn.t) {
                        out_w.push(WriteSite {
                            binding: root, kind: "index", idx: t.right, line: t.line
                        })
                    }
                }
                iter_writes_reads(ctx, t.right, out_w, out_r)
                # the target itself is a read too (the object is loaded)
                let rroot: str = ident_of_e(ctx, t.left)
                if rroot != "" {
                    let tn2: ExprN = ctx.exprs[t.left]
                    if is_list_type(tn2.t) {
                        if !list_has_str(out_r, rroot) {
                            out_r.push(rroot)
                        }
                    }
                }
            }
        }
        iter_writes_reads(ctx, s.value, out_w, out_r)
        return
    }
    if s.kind == "let" {
        iter_writes_reads(ctx, s.value, out_w, out_r)
        return
    }
    iter_writes_reads(ctx, s.value, out_w, out_r)
    iter_writes_reads(ctx, s.cond, out_w, out_r)
    iter_writes_reads(ctx, s.iter, out_w, out_r)
    iter_writes_reads(ctx, s.e, out_w, out_r)
}

# ----------------------------------------------------------------------------
# binding_type — the checked type of a binding name.
# ----------------------------------------------------------------------------

fn binding_type_scan(ctx: Ctx, stmts: list[int], name: str) -> str {
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "let" && s.name == name {
            if s.vtype != "" {
                return s.vtype
            }
        }
        if s.kind == "assign" && s.target >= 0 {
            let tn: ExprN = ctx.exprs[s.target]
            if tn.kind == "ident" && tn.name == name {
                if tn.t != "" {
                    return tn.t
                }
            }
        }
        if s.kind == "if" {
            let r: str = binding_type_scan(ctx, s.body, name)
            if r != "" {
                return r
            }
            let r2: str = binding_type_scan(ctx, s.else_body, name)
            if r2 != "" {
                return r2
            }
        }
        if s.kind == "while" || s.kind == "for" {
            let r3: str = binding_type_scan(ctx, s.body, name)
            if r3 != "" {
                return r3
            }
        }
        i = i + 1
    }
    return ""
}

fn binding_type_of(ctx: Ctx, f: FnInfo, name: str) -> str {
    let mut pi: int = 0
    while pi < f.params.len() {
        if f.params.get(pi) == name {
            return f.ptypes.get(pi)
        }
        pi = pi + 1
    }
    return binding_type_scan(ctx, f.body, name)
}

# ----------------------------------------------------------------------------
# shape_range — range(a, <root>.len()).
# ----------------------------------------------------------------------------

struct ShapeRange {
    ok: bool,
    lo: CondSide,
    root: str
}

fn shape_range_of(ctx: Ctx, e: int) -> ShapeRange {
    let out: ShapeRange = ShapeRange {
        ok: false, lo: cond_side_lit(0), root: ""
    }
    if e < 0 {
        return out
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind != "call" || n.mkey != "range" || n.muser != false {
        return out
    }
    if n.args.len() != 2 {
        return out
    }
    if n.args.get(0) < 0 || n.args.get(1) < 0 {
        return out
    }
    let an: ExprN = ctx.exprs[n.args.get(0)]
    if an.kind == "int" {
        out.lo = cond_side_lit(an.ival)
    } else if an.kind == "ident" {
        out.lo = cond_side_var(an.name)
    } else {
        return out
    }
    let root: str = len_root_of(ctx, n.args.get(1))
    if root == "" {
        return out
    }
    out.ok = true
    out.root = root
    return out
}

# ----------------------------------------------------------------------------
# The frame check helpers.
# ----------------------------------------------------------------------------

# stmt_writes_list — every write site + list-binding rebind in a tree.
fn stmt_writes_list(ctx: Ctx, stmts: list[int], out_sites: list[WriteSite],
out_rebinds: list[str]) -> void {
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "assign" {
            if s.target >= 0 {
                let t: ExprN = ctx.exprs[s.target]
                if t.kind == "index" {
                    let root: str = ident_of_e(ctx, t.left)
                    if root != "" {
                        let tn: ExprN = ctx.exprs[t.left]
                        if is_list_type(tn.t) {
                            out_sites.push(WriteSite {
                                binding: root, kind: "index", idx: t.right, line: s.line
                            })
                        }
                    }
                } else if t.kind == "ident" {
                    if is_list_type(t.t) {
                        out_rebinds.push(t.name)
                    }
                }
            }
            let sink: list[str] = []
            iter_writes_reads(ctx, s.value, out_sites, sink)
        } else if s.kind == "let" {
            if is_list_type(s.vtype) && s.name != "" {
                out_rebinds.push(s.name)
            }
            let sink2: list[str] = []
            iter_writes_reads(ctx, s.value, out_sites, sink2)
        } else if s.kind == "expr" {
            let sink3: list[str] = []
            iter_writes_reads(ctx, s.e, out_sites, sink3)
        } else if s.kind == "return" {
            let sink4: list[str] = []
            if s.value >= 0 {
                iter_writes_reads(ctx, s.value, out_sites, sink4)
            }
        } else if s.kind == "if" {
            let sink5: list[str] = []
            iter_writes_reads(ctx, s.cond, out_sites, sink5)
            stmt_writes_list(ctx, s.body, out_sites, out_rebinds)
            stmt_writes_list(ctx, s.else_body, out_sites, out_rebinds)
        } else if s.kind == "while" || s.kind == "for" {
            let sink6: list[str] = []
            if s.kind == "while" {
                iter_writes_reads(ctx, s.cond, out_sites, sink6)
            } else {
                iter_writes_reads(ctx, s.iter, out_sites, sink6)
            }
            stmt_writes_list(ctx, s.body, out_sites, out_rebinds)
        }
        i = i + 1
    }
}

# rebind_list — (re)bind a list binding per its value's provenance.
fn rebind_list(ctx: Ctx, st: AliasState, name: str, value: int) -> void {
    alias_drop(st, name)
    if value < 0 {
        alias_join(st, name, SHAPE_WILD())
        return
    }
    let v: ExprN = ctx.exprs[value]
    if v.kind == "listlit" {
        alias_new_class(st, name, true)
        return
    }
    if v.kind == "call" && v.muser == false && v.mkey == "clone" {
        alias_new_class(st, name, true)
        return
    }
    if v.kind == "ident" && is_list_type(v.t) {
        alias_join(st, name, alias_of(st, v.name))
        return
    }
    alias_join(st, name, SHAPE_WILD())
}

# ----------------------------------------------------------------------------
# Cursor accesses (the honest bounds census).
# ----------------------------------------------------------------------------

struct Acc4 {
    updated: bool,
    total: int,
    safe: int,
    blocked: int
}

# rhs_accesses — head-state accesses inside an expression tree.
fn rhs_accesses(ctx: Ctx, e: int, root: str, cursor: str, acc: Acc4) -> void {
    if e < 0 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "index" {
        let r: str = ident_of_e(ctx, n.left)
        if r == root && ident_of_e(ctx, n.right) == cursor {
            if acc.updated {
                acc.blocked = acc.blocked + 1
            } else {
                acc.safe = acc.safe + 1
            }
            acc.total = acc.total + 1
        }
    }
    if n.kind == "method" && (n.mop == "list.get" || n.mop == "list.set") {
        let r2: str = ident_of_e(ctx, n.left)
        if r2 == root && n.args.len() >= 1 && ident_of_e(ctx, n.args.get(0)) == cursor {
            if acc.updated {
                acc.blocked = acc.blocked + 1
            } else {
                acc.safe = acc.safe + 1
            }
            acc.total = acc.total + 1
        }
    }
    rhs_accesses(ctx, n.left, root, cursor, acc)
    rhs_accesses(ctx, n.right, root, cursor, acc)
    if n.kind != "match" {
        let mut i: int = 0
        while i < n.args.len() {
            rhs_accesses(ctx, n.args.get(i), root, cursor, acc)
            i = i + 1
        }
    }
    if n.kind == "match" {
        let mut a: int = 0
        while a < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
            rhs_accesses(ctx, arm.body, root, cursor, acc)
            a = a + 1
        }
        rhs_accesses(ctx, n.left, root, cursor, acc)
    }
    if n.kind == "qmark" {
        rhs_accesses(ctx, n.left, root, cursor, acc)
    }
    if n.kind == "structlit" {
        let mut fi: int = 0
        while fi < n.args.len() {
            rhs_accesses(ctx, n.args.get(fi), root, cursor, acc)
            fi = fi + 1
        }
    }
}

# cursor_accesses — the in-order body scan.
fn cursor_accesses(ctx: Ctx, stmts: list[int], root: str, cursor: str, acc: Acc4) -> void {
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "assign" {
            if s.target >= 0 {
                let t: ExprN = ctx.exprs[s.target]
                if t.kind == "index" {
                    let r: str = ident_of_e(ctx, t.left)
                    if r == root && ident_of_e(ctx, t.right) == cursor {
                        acc.total = acc.total + 1
                        if acc.updated {
                            acc.blocked = acc.blocked + 1
                        } else {
                            acc.safe = acc.safe + 1
                        }
                    }
                }
                if t.kind == "ident" && t.name == cursor {
                    acc.updated = true
                    rhs_accesses(ctx, s.value, root, cursor, acc)
                    i = i + 1
                    continue
                }
            }
            rhs_accesses(ctx, s.value, root, cursor, acc)
        } else if s.kind == "let" {
            rhs_accesses(ctx, s.value, root, cursor, acc)
        } else if s.kind == "expr" {
            rhs_accesses(ctx, s.e, root, cursor, acc)
        } else if s.kind == "return" {
            if s.value >= 0 {
                rhs_accesses(ctx, s.value, root, cursor, acc)
            }
        } else if s.kind == "if" {
            rhs_accesses(ctx, s.cond, root, cursor, acc)
            cursor_accesses(ctx, s.body, root, cursor, acc)
            cursor_accesses(ctx, s.else_body, root, cursor, acc)
        } else if s.kind == "while" || s.kind == "for" {
            rhs_accesses(ctx, s.cond, root, cursor, acc)
            rhs_accesses(ctx, s.iter, root, cursor, acc)
            cursor_accesses(ctx, s.body, root, cursor, acc)
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# build_shape_loop — detect and summarise one loop's shape candidate.
# ----------------------------------------------------------------------------

fn build_shape_loop(ctx: Ctx, fs: FnShapes, s: StmtN, kind: str,
classes: AliasState) -> ShapeLoop {
    let line: int = s.line
    let mut header: str = ""
    if kind == "for" {
        header = "for " + s.name + " in " + shape_expr_text(ctx, s.iter)
    } else {
        header = "while " + shape_expr_text(ctx, s.cond)
    }
    let ls: ShapeLoop = shape_loop_new(fs.fn_key, kind, line, header)
    ls.stmt_idx = -1
    let body: list[int] = s.body
    # -- the anchor
    if kind == "while" {
        let ap: AnchorParts = anchor_parts_of(ctx, s.cond)
        if !ap.ok {
            ls.cond_reason = "condition is not <cursor> op <root>.len()> — no heap anchor"
            return ls
        }
        ls.root = ap.root
        ls.cursor = ap.cursor
        ls.cond_op = ap.op
        if ap.op != "<" && ap.op != "<=" {
            ls.cond_reason = "unsupported comparison " + ap.op
            return ls
        }
    } else {
        let rng: ShapeRange = shape_range_of(ctx, s.iter)
        if !rng.ok {
            ls.cond_reason = "iterable is not range(a, <root>.len()>) — no heap anchor"
            return ls
        }
        ls.cursor = s.name
        if ls.cursor == "" {
            ls.cond_reason = "loop variable is not a plain binding"
            return ls
        }
        ls.root = rng.root
        ls.cond_op = "<"
        ls.has_range_lo = true
        ls.range_lo = rng.lo
        if rng.lo.lit && rng.lo.ival < 0 {
            ls.cond_reason = "range start " + rng.lo.ival.to_str() + " is negative — the cursor starts outside the list"
            return ls
        }
    }
    if !is_list_type(binding_type_of(ctx, fs.fn_i, ls.root)) {
        ls.cond_reason = "anchor " + ls.root + " is not a list binding"
        return ls
    }
    # -- the transition
    if has_escape(ctx, body, 0) {
        ls.frame_reasons.push("body escapes through return/break/continue — the shape after the escape is unowned")
        return ls
    }
    let carried: list[str] = []
    assigned_names(ctx, body, carried, 0)
    if !list_has_str(carried, ls.cursor) {
        carried.push(ls.cursor)
    }
    if kind == "while" {
        let sumr: BodySummary = summarize_body(ctx, body)
        if sumr.unmodeled.has(ls.cursor) {
            ls.frame_reasons.push("cursor " + ls.cursor + " is unmodeled: " + sumr.unmodeled.get_or(ls.cursor, ""))
            return ls
        }
        let disjs: list[Disj] = sumr.trans.get_or(ls.cursor, [])
        if disjs.len() == 0 {
            ls.frame_reasons.push("cursor " + ls.cursor + " is never reassigned in the body — not a walk")
            return ls
        }
        let mut di: int = 0
        while di < disjs.len() {
            let d: Disj = disjs.get(di)
            if d.terms.len() > 0 {
                ls.frame_reasons.push("cursor step references other variables — outside the fragment")
                return ls
            }
            if d.self_c != 0 && d.self_c != 1 {
                ls.frame_reasons.push("cursor step is not a self-step")
                return ls
            }
            if d.self_c == 0 && d.const != 0 {
                ls.frame_reasons.push("cursor step rebinds to a constant")
                return ls
            }
            if d.self_c == 1 {
                ls.steps.push(d.const)
            }
            di = di + 1
        }
        if ls.steps.len() == 0 {
            ls.frame_reasons.push("cursor never moves")
            return ls
        }
    } else {
        # for-range: the cursor is fresh-bound per iteration, step +1
        let inner: list[str] = []
        assigned_names(ctx, body, inner, 0)
        let mut ii: int = 0
        while ii < inner.len() {
            if inner.get(ii) == ls.cursor {
                ls.frame_reasons.push("the for-variable " + ls.cursor + " is reassigned in the body")
                return ls
            }
            ii = ii + 1
        }
        ls.steps.push(1)
    }
    # -- the frame
    let w_sites: list[WriteSite] = []
    let w_locals: list[str] = []
    stmt_writes_list(ctx, body, w_sites, w_locals)
    let cid: int = alias_of(classes, ls.root)
    let reasons: list[str] = []
    let mut wi: int = 0
    while wi < w_sites.len() {
        let site: WriteSite = w_sites.get(wi)
        let site_cid: int = alias_of(classes, site.binding)
        if site_cid != cid {
            wi = wi + 1
            continue
        }
        if site.kind == "push" || site.kind == "pop" {
            reasons.push(site.binding + "." + site.kind + "() at line " + site.line.to_str() + " changes len(" + ls.root + ")")
        } else if site.kind == "set" {
            if ident_of_e(ctx, site.idx) != ls.cursor {
                reasons.push(site.binding + ".set(..) at line " + site.line.to_str() + " writes off the cursor cell")
            }
        } else if site.kind == "index" {
            if ident_of_e(ctx, site.idx) != ls.cursor {
                reasons.push(site.binding + "[..] = .. at line " + site.line.to_str() + " writes off the cursor cell")
            }
        }
        wi = wi + 1
    }
    let mut li: int = 0
    while li < w_locals.len() {
        let name: str = w_locals.get(li)
        if name == ls.root || (cid != SHAPE_WILD() && list_has_str(classes.members.get_or(cid.to_str(), []), name)) {
            reasons.push(name + " is rebound inside the loop")
        }
        li = li + 1
    }
    # a wildcard-class write may alias ANY class — including the anchor's
    let mut any_wild: bool = false
    let mut xi: int = 0
    while xi < w_sites.len() {
        if alias_of(classes, w_sites.get(xi).binding) == SHAPE_WILD() {
            any_wild = true
        }
        xi = xi + 1
    }
    if any_wild {
        reasons.push("a write through unknown provenance may reach " + ls.root)
    }
    if reasons.len() > 0 {
        let mut ri: int = 0
        while ri < reasons.len() {
            ls.frame_reasons.push(reasons.get(ri))
            ri = ri + 1
        }
        return ls
    }
    ls.frame_ok = true
    # -- accesses at the cursor cell
    let strict: bool = ls.cond_op == "<" || kind == "for"
    let acc: Acc4 = Acc4 {
        updated: false, total: 0, safe: 0, blocked: 0
    }
    cursor_accesses(ctx, body, ls.root, ls.cursor, acc)
    ls.access_total = acc.total
    if strict {
        ls.access_safe = acc.safe
        ls.access_blocked = acc.blocked
    } else {
        ls.access_blocked = acc.total
        ls.access_safe = 0
    }
    ls.cond_ok = true
    return ls
}

# ----------------------------------------------------------------------------
# The main alias-tracking walk + separation.
# ----------------------------------------------------------------------------

# collect_wr_stmt — writes/reads of one statement through the classes.
fn collect_wr_stmt(ctx: Ctx, fs: FnShapes, s: StmtN) -> void {
    let out_w: list[WriteSite] = []
    let out_r: list[str] = []
    stmt_writes_reads(ctx, s, out_w, out_r)
    let mut i: int = 0
    while i < out_w.len() {
        fs.writes.push(ShapeWrite {
            cid: alias_of(fs.classes, out_w.get(i).binding)
        })
        i = i + 1
    }
    let mut j: int = 0
    while j < out_r.len() {
        let c: int = alias_of(fs.classes, out_r.get(j))
        if !list_has_int(fs.reads, c) {
            fs.reads.push(c)
        }
        j = j + 1
    }
}

# list_has_int — membership for int lists.
fn list_has_int(xs: list[int], v: int) -> bool {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) == v {
            return true
        }
        i = i + 1
    }
    return false
}

# collect_wr — writes/reads inside one expression tree.
fn collect_wr(ctx: Ctx, fs: FnShapes, e: int) -> void {
    if e < 0 {
        return
    }
    let out_w: list[WriteSite] = []
    let out_r: list[str] = []
    iter_writes_reads(ctx, e, out_w, out_r)
    let mut i: int = 0
    while i < out_w.len() {
        fs.writes.push(ShapeWrite {
            cid: alias_of(fs.classes, out_w.get(i).binding)
        })
        i = i + 1
    }
    let mut j: int = 0
    while j < out_r.len() {
        let c: int = alias_of(fs.classes, out_r.get(j))
        if !list_has_int(fs.reads, c) {
            fs.reads.push(c)
        }
        j = j + 1
    }
}

# walk_shape_stmts — the alias-tracking statement walk.
fn walk_shape_stmts(ctx: Ctx, fs: FnShapes, stmts: list[int]) -> void {
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "let" {
            if is_list_type(s.vtype) && s.name != "" {
                rebind_list(ctx, fs.classes, s.name, s.value)
            }
            collect_wr(ctx, fs, s.value)
        } else if s.kind == "assign" {
            if s.target >= 0 {
                let t: ExprN = ctx.exprs[s.target]
                if t.kind == "ident" && is_list_type(t.t) {
                    rebind_list(ctx, fs.classes, t.name, s.value)
                }
            }
            collect_wr_stmt(ctx, fs, s)
        } else if s.kind == "expr" {
            collect_wr(ctx, fs, s.e)
        } else if s.kind == "return" {
            if s.value >= 0 {
                collect_wr(ctx, fs, s.value)
            }
        } else if s.kind == "if" {
            collect_wr(ctx, fs, s.cond)
            walk_shape_stmts(ctx, fs, s.body)
            walk_shape_stmts(ctx, fs, s.else_body)
        } else if s.kind == "while" || s.kind == "for" {
            if s.kind == "while" {
                collect_wr(ctx, fs, s.cond)
            } else {
                collect_wr(ctx, fs, s.iter)
            }
            let ls: ShapeLoop = build_shape_loop(ctx, fs, s, s.kind, alias_snapshot(fs.classes))
            # the loop's own statement index (the entry-facts lookup key)
            ls.stmt_idx = stmts.get(i)
            fs.loops.push(ls)
            walk_shape_stmts(ctx, fs, s.body)
        }
        i = i + 1
    }
}

# decide_separation — the verdicts for every pair of written classes.
fn decide_separation(fs: FnShapes) -> void {
    let written: list[int] = []
    let mut wi: int = 0
    while wi < fs.writes.len() {
        let c: int = fs.writes.get(wi).cid
        if !list_has_int(written, c) {
            written.push(c)
        }
        wi = wi + 1
    }
    if written.len() <= 1 {
        return
    }
    # sort the written cids by their printable representatives
    let reps: list[str] = []
    let cids: list[int] = []
    let mut xi: int = 0
    while xi < written.len() {
        reps.push(alias_repr_of(fs.classes, written.get(xi)))
        cids.push(written.get(xi))
        xi = xi + 1
    }
    # insertion sort by rep
    let mut a: int = 0
    while a < cids.len() {
        let mut b: int = a + 1
        while b < cids.len() {
            if reps.get(b) < reps.get(a) {
                let tr: str = reps.get(a)
                reps.set(a, reps.get(b))
                reps.set(b, tr)
                let tc: int = cids.get(a)
                cids.set(a, cids.get(b))
                cids.set(b, tc)
            }
            b = b + 1
        }
        a = a + 1
    }
    let mut i: int = 0
    while i < cids.len() {
        let mut j: int = i + 1
        while j < cids.len() {
            let aa: int = cids.get(i)
            let bb: int = cids.get(j)
            let ra: str = alias_repr_of(fs.classes, aa)
            let rb: str = alias_repr_of(fs.classes, bb)
            let mut why: str = ""
            if aa == SHAPE_WILD() || bb == SHAPE_WILD() {
                why = "writes through unknown provenance may alias anything"
            } else if fs.classes.fresh.get_or(aa.to_str(), false) || fs.classes.fresh.get_or(bb.to_str(), false) {
                why = "one side is allocated inside the function (literal / clone) — disjoint from every pre-existing object"
            } else {
                why = "both sides are caller-owned; a caller may pass the same list to both (f(xs, xs) aliases the parameters) — no fresh evidence"
            }
            let proven: bool = aa != SHAPE_WILD() && bb != SHAPE_WILD()
            && (fs.classes.fresh.get_or(aa.to_str(), false) || fs.classes.fresh.get_or(bb.to_str(), false))
            fs.separation.push(SepPair {
                ra: ra, rb: rb, ok: proven, why: why
            })
            j = j + 1
        }
        i = i + 1
    }
}

# analyze_heap — one function's full heap analysis.
fn analyze_heap(ctx: Ctx, fn_key: str, f: FnInfo) -> FnShapes {
    let fs: FnShapes = fn_shapes_new(fn_key, f)
    let mut pi: int = 0
    while pi < f.params.len() {
        if is_list_type(f.ptypes.get(pi)) {
            alias_new_class(fs.classes, f.params.get(pi), false)
        }
        pi = pi + 1
    }
    walk_shape_stmts(ctx, fs, f.body)
    decide_separation(fs)
    return fs
}

# ----------------------------------------------------------------------------
# Entry facts per loop (the same hook/keep-first convention).
# ----------------------------------------------------------------------------

fn entry_facts_map(ctx: Ctx, f: FnInfo) -> LoopHook {
    let base: Facts = facts_new()
    if f.requires_e >= 0 {
        seed_walk(ctx, f.requires_e, f, base)
    }
    let hook: LoopHook = loop_hook_new()
    propagate_stmts_f(ctx, f.body, base, 0, hook)
    return hook
}

# collect_shapes — every non-extern fn's heap analysis.
fn collect_shapes(ctx: Ctx) -> list[FnShapes] {
    let out: list[FnShapes] = []
    let keys: list[str] = ctx.fns.keys()
    let mut fi: int = 0
    while fi < keys.len() {
        let key: str = keys.get(fi)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if f.is_extern {
            fi = fi + 1
            continue
        }
        let fs: FnShapes = analyze_heap(ctx, key, f)
        let hook: LoopHook = entry_facts_map(ctx, f)
        # attach the snapshot + minlen to every loop candidate
        let mut li: int = 0
        while li < fs.loops.len() {
            let ls: ShapeLoop = fs.loops.get(li)
            let mut hi: int = 0
            let mut snap: Facts = facts_new()
            let mut found: bool = false
            while hi < hook.seen.len() {
                if hook.seen.get(hi) == ls.stmt_idx {
                    snap = hook.snaps.get(hi)
                    found = true
                }
                hi = hi + 1
            }
            if found {
                ls.entry_facts = snap
                if snap.minlen.has(ls.root) {
                    let v: int = snap.minlen.get_or(ls.root, -1)
                    if v > 0 {
                        ls.minlen = v
                    }
                }
            }
            li = li + 1
        }
        out.push(fs)
        fi = fi + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# The shape obligations + the verifier.
# ----------------------------------------------------------------------------

# shape_segments — the two SMT obligations of one shape candidate.
fn shape_segments(ls: ShapeLoop) -> list[Seg] {
    let xs_len: str = ls.root + "_len"
    let cur: str = ls.cursor
    let decls: list[str] = [cur, xs_len]
    if ls.has_range_lo && !ls.range_lo.lit {
        decls.push(ls.range_lo.name)
    }
    let shape: str = "(and (>= " + cur + " 0) (<= " + cur + " " + xs_len + "))"
    let shape_p: str = "(and (>= " + cur + "_p 0) (<= " + cur + "_p " + xs_len + "))"
    # prelude(primed)
    let head: list[str] = []
    let head_p: list[str] = []
    let mut pi: int = 0
    while pi < decls.len() {
        head.push("(declare-const " + decls.get(pi) + " Int)")
        head_p.push("(declare-const " + decls.get(pi) + " Int)")
        pi = pi + 1
    }
    head_p.push("(declare-const " + cur + "_p Int)")
    # axioms
    let axioms: list[str] = []
    axioms.push("; len(xs) >= 0 — a list's extent is never negative")
    axioms.push("(assert (>= " + xs_len + " 0))")
    if ls.minlen > 0 {
        axioms.push("; entry fact: len(" + ls.root + ") >= " + ls.minlen.to_str() + " (seeded by requires)")
        axioms.push("(assert (>= " + xs_len + " " + ls.minlen.to_str() + "))")
    }
    # -- initiation
    let init: list[str] = []
    let mut ia: int = 0
    while ia < axioms.len() {
        init.push(axioms.get(ia))
        ia = ia + 1
    }
    init.push("; the cursor's interval at the loop head")
    if ls.entry_facts.ints.has(cur) {
        let iv: Iv = ls.entry_facts.ints.get_or(cur, pv_iv_top())
        if bnd_is_num(iv.lo) {
            init.push("(assert (>= " + cur + " " + iv.lo.num.to_str() + "))")
        }
        if bnd_is_num(iv.hi) {
            init.push("(assert (<= " + cur + " " + iv.hi.num.to_str() + "))")
        }
    }
    if ls.has_range_lo {
        let mut a_s: str = ""
        if ls.range_lo.lit {
            a_s = ls.range_lo.ival.to_str()
        } else {
            a_s = ls.range_lo.name
        }
        init.push("; the runs-guard: the loop body runs only when a < len(" + ls.root + ")")
        init.push("(assert (< " + a_s + " " + xs_len + "))")
        init.push("(assert (= " + cur + " " + a_s + "))")
        if !ls.range_lo.lit {
            let aname: str = ls.range_lo.name
            if ls.entry_facts.ints.has(aname) {
                let av: Iv = ls.entry_facts.ints.get_or(aname, pv_iv_top())
                if bnd_is_num(av.lo) {
                    init.push("(assert (>= " + aname + " " + av.lo.num.to_str() + "))")
                }
                if bnd_is_num(av.hi) {
                    init.push("(assert (<= " + aname + " " + av.hi.num.to_str() + "))")
                }
            }
        }
    }
    init.push("; initiation: unsat => the shape holds at entry")
    init.push("(assert (not " + shape + "))")
    # _segment(head, comment, init[len(head):]) — asserts are init
    # AFTER the prelude; build the segment body accordingly
    let init_seg: list[str] = []
    let mut h1: int = 0
    while h1 < head.len() {
        init_seg.push(head.get(h1))
        h1 = h1 + 1
    }
    let init_rest: list[str] = []
    let mut ir: int = 0
    while ir < init.len() {
        init_rest.push(init.get(ir))
        ir = ir + 1
    }
    let init_seg_full: list[str] = segment(head,
    "; shape initiation of [" + shape_of_loop_text(ls) + "]: unsat => holds on entry",
    init_rest)
    # -- preservation
    let keep: list[str] = []
    let mut ka: int = 0
    while ka < axioms.len() {
        keep.push(axioms.get(ka))
        ka = ka + 1
    }
    keep.push("(assert " + shape + ")")
    if !ls.has_range_lo {
        keep.push("; the loop condition")
        keep.push("(assert (" + ls.cond_op + " " + cur + " " + xs_len + "))")
    } else {
        let mut a_s2: str = ""
        if ls.range_lo.lit {
            a_s2 = ls.range_lo.ival.to_str()
        } else {
            a_s2 = ls.range_lo.name
        }
        keep.push("(assert (< " + a_s2 + " " + xs_len + "))")
    }
    keep.push("; the cursor's transition: i' = i + c (per disjunct)")
    let eqs: list[str] = []
    let mut si: int = 0
    while si < ls.steps.len() {
        eqs.push("(= " + cur + "_p (+ " + cur + " " + ls.steps.get(si).to_str() + "))")
        si = si + 1
    }
    if eqs.len() == 1 {
        keep.push("(assert " + eqs.get(0) + ")")
    } else {
        keep.push("(assert (or " + pv_join_str_list(eqs, " ") + "))")
    }
    keep.push("; the condition at the NEXT head (the loop did not exit)")
    if !ls.has_range_lo {
        keep.push("(assert (" + ls.cond_op + " " + cur + "_p " + xs_len + "))")
    } else {
        keep.push("(assert (< " + cur + "_p " + xs_len + "))")
    }
    keep.push("; preservation: unsat => the shape is inductive")
    keep.push("(assert (not " + shape_p + "))")
    let keep_rest: list[str] = []
    let mut kr: int = 0
    while kr < keep.len() {
        keep_rest.push(keep.get(kr))
        kr = kr + 1
    }
    let keep_seg_full: list[str] = segment(head_p,
    "; shape preservation of [" + shape_of_loop_text(ls) + "]: unsat => inductive",
    keep_rest)
    let out: list[Seg] = []
    out.push(Seg {
        lines: init_seg_full
    })
    out.push(Seg {
        lines: keep_seg_full
    })
    return out
}

# verify_shapes — decide every frame-clean candidate.
fn verify_shapes(fs_list: list[FnShapes], d: Decider) -> void uses Fs, Proc, Clock {
    let mut fi: int = 0
    while fi < fs_list.len() {
        let fs: FnShapes = fs_list.get(fi)
        let mut li: int = 0
        while li < fs.loops.len() {
            let ls: ShapeLoop = fs.loops.get(li)
            if !ls.frame_ok || !ls.cond_ok {
                ls.status = "refused"
                li = li + 1
                continue
            }
            if !d.ok {
                ls.status = "unverified"
                li = li + 1
                continue
            }
            let segs: list[Seg] = shape_segments(ls)
            let init_v: str = decider_decide(d, segs.get(0).lines)
            if init_v != "unsat" {
                ls.status = "refused"
                ls.solver_reason = "initiation not discharged (" + init_v + ")"
                li = li + 1
                continue
            }
            let keep_v: str = decider_decide(d, segs.get(1).lines)
            if keep_v != "unsat" {
                ls.status = "refused"
                ls.solver_reason = "preservation not discharged (" + keep_v + ")"
                li = li + 1
                continue
            }
            ls.status = "proven"
            ls.shape_text = shape_of_loop_text(ls)
            ls.segments = segs
            li = li + 1
        }
        fi = fi + 1
    }
}

# ----------------------------------------------------------------------------
# The --shapes report (the .py's shapes_report).
# ----------------------------------------------------------------------------

# shapes_report returns the counts packed (proven*100000 + refused*100 +
# unverified is too small — use a struct).
struct ShapeTotals {
    proven: int,
    refused: int,
    unverified: int,
    sep_ok: int,
    sep_no: int
}

fn shapes_report(ctx: Ctx, want_smt: bool, out_dir: str, d: Decider,
solver_name: str) -> ShapeTotals uses IO, Fs, Proc, Clock {
    let fs_list: list[FnShapes] = collect_shapes(ctx)
    verify_shapes(fs_list, d)
    let t: ShapeTotals = ShapeTotals {
        proven: 0, refused: 0, unverified: 0, sep_ok: 0, sep_no: 0
    }
    println("  Heap shapes (the separation-logic fragment):")
    let mut anything: bool = false
    let mut fi: int = 0
    while fi < fs_list.len() {
        let fs: FnShapes = fs_list.get(fi)
        # ---- footprint
        let root_kind: map[str, str] = map_new()
        let mut wi: int = 0
        while wi < fs.writes.len() {
            let rep: str = alias_repr_of(fs.classes, fs.writes.get(wi).cid)
            root_kind.set(rep, "W")
            wi = wi + 1
        }
        let mut ri: int = 0
        while ri < fs.reads.len() {
            let rep2: str = alias_repr_of(fs.classes, fs.reads.get(ri))
            if !root_kind.has(rep2) {
                root_kind.set(rep2, "R")
            }
            ri = ri + 1
        }
        if root_kind.keys().len() == 0 {
            fi = fi + 1
            continue
        }
        anything = true
        println("  " + fs.fn_key + ":")
        let fp_parts: list[str] = []
        let rk: list[str] = sort_str_list(root_kind.keys())
        let mut rki: int = 0
        while rki < rk.len() {
            fp_parts.push(rk.get(rki) + ":" + root_kind.get_or(rk.get(rki), "R"))
            rki = rki + 1
        }
        println("    footprint: " + pv_join_str_list(fp_parts, ", ") + " (over alias classes)")
        # ---- separation
        if fs.separation.len() == 0 {
            println("    separation: single writer — trivially separated")
        } else {
            let mut si: int = 0
            while si < fs.separation.len() {
                let sp: SepPair = fs.separation.get(si)
                if sp.ok {
                    t.sep_ok = t.sep_ok + 1
                } else {
                    t.sep_no = t.sep_no + 1
                }
                let mut verdict: str = "REFUSED"
                if sp.ok {
                    verdict = "PROVEN"
                }
                println("    separation: own(" + sp.ra + ") * own(" + sp.rb + ") " + verdict + " — " + sp.why)
                si = si + 1
            }
        }
        # ---- loop shapes
        let mut li: int = 0
        while li < fs.loops.len() {
            let ls: ShapeLoop = fs.loops.get(li)
            if ls.status == "proven" {
                t.proven = t.proven + 1
            } else if ls.status == "unverified" {
                t.unverified = t.unverified + 1
            } else {
                t.refused = t.refused + 1
            }
            println("    line " + ls.line.to_str() + ": " + ls.header)
            if ls.root == "" {
                println("      no heap anchor: " + ls.cond_reason)
                li = li + 1
                continue
            }
            if ls.frame_reasons.len() > 0 && ls.status != "proven" {
                let mut fri: int = 0
                while fri < ls.frame_reasons.len() {
                    println("      frame REFUSED: " + ls.frame_reasons.get(fri))
                    fri = fri + 1
                }
                li = li + 1
                continue
            }
            println("      frame: every write is " + ls.root + "[" + ls.cursor + "]; len(" + ls.root + ") fixed through the body")
            if ls.status == "proven" {
                println("      shape PROVEN (" + solver_name + "): " + ls.shape_text)
                println("      accesses in bounds by shape: " + ls.access_safe.to_str() + " of " + ls.access_total.to_str())
                if ls.access_blocked > 0 {
                    println("      accesses NOT claimed: " + ls.access_blocked.to_str() + " (after the cursor update the cursor may sit at len)")
                }
            } else if ls.status == "unverified" {
                println("      shape CANDIDATE (unverified — no solver installed, nothing claimed): " + shape_of_loop_text(ls))
            } else {
                if ls.solver_reason != "" {
                    println("      shape REFUSED (obligation not discharged): " + ls.solver_reason)
                } else {
                    let mut fri2: int = 0
                    while fri2 < ls.frame_reasons.len() {
                        println("      shape REFUSED: " + ls.frame_reasons.get(fri2))
                        fri2 = fri2 + 1
                    }
                }
                if ls.access_blocked > 0 {
                    println("      accesses NOT claimed: " + ls.access_blocked.to_str() + " of " + ls.access_total.to_str() + " (after the cursor update the cursor may sit at len)")
                } else if ls.access_safe < ls.access_total {
                    println("      accesses NOT claimed: " + (ls.access_total - ls.access_safe).to_str() + " of " + ls.access_total.to_str())
                }
            }
            if want_smt && ls.segments.len() > 0 {
                let fname: str = str_replace(fs.fn_key, ".", "_") + "__L" + ls.line.to_str() + ".shape.smt2"
                let mut fpath: str = out_dir
                if out_dir != "." {
                    fpath = out_dir + "/" + fname
                } else {
                    fpath = fname
                }
                write_file(fpath, smt_program_text(
                "; Halis heap-shape obligations — " + fs.fn_key + ":" + ls.line.to_str() + " " + ls.header + "\n; verified shape: " + ls.shape_text,
                ls.segments))
                println("      obligations -> " + fpath)
            }
            li = li + 1
        }
        fi = fi + 1
    }
    if !anything {
        println("    (no list bindings — nothing for the fragment to say)")
    }
    println("  SHAPES TOTAL: " + t.proven.to_str() + " loops proven, " + t.refused.to_str() + " refused, " + t.unverified.to_str() + " unverified; " + t.sep_ok.to_str() + " separation pairs proven, " + t.sep_no.to_str() + " refused")
    return t
}

# ============================================================================
# Part 7 — Stage 101: the side-channel analysis.
# ============================================================================

# The len() family — public by policy.
fn sc_is_len_method(op: str) -> bool {
    return op == "list.len" || op == "str.len" || op == "map.len" || op == "chan.len"
}

# The address-selecting builtin methods (the hazardous arg positions).
fn sc_address_positions(op: str) -> list[int] {
    if op == "list.get" || op == "list.set" || op == "str.byte_at"
    || op == "map.get" || op == "map.has" {
        return[0]
    }
    if op == "str.slice" {
        return[0, 1]
    }
    if op == "map.get_or" {
        return[0]
    }
    if op == "map.set" {
        return[0]
    }
    return[]
}

# The one-line whys.
fn sc_why(kind: str) -> str {
    if kind == "branch" {
        return "the branch predictor's state follows the secret"
    }
    if kind == "index" {
        return "the fetched cache line follows the secret"
    }
    if kind == "loop-bound" {
        return "the total iteration count follows the secret"
    }
    return "division latency is data-dependent on some cores"
}

# sc_text — the findings' renderer.
fn sc_text(ctx: Ctx, e: int) -> str {
    if e < 0 {
        return "?"
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return n.ival.to_str()
    }
    if n.kind == "float" {
        return n.fval.to_str()
    }
    if n.kind == "bool" {
        if n.bval {
            return "True"
        }
        return "False"
    }
    if n.kind == "str" {
        return "\"...\""
    }
    if n.kind == "ident" {
        return n.name
    }
    if n.kind == "un" {
        return n.op + sc_text(ctx, n.left)
    }
    if n.kind == "bin" {
        return "(" + sc_text(ctx, n.left) + " " + n.op + " " + sc_text(ctx, n.right) + ")"
    }
    if n.kind == "call" {
        let args: list[str] = []
        let mut i: int = 0
        while i < n.args.len() {
            args.push(sc_text(ctx, n.args.get(i)))
            i = i + 1
        }
        return n.name + "(" + pv_join_str_list(args, ", ") + ")"
    }
    if n.kind == "method" {
        let args2: list[str] = []
        let mut j: int = 0
        while j < n.args.len() {
            args2.push(sc_text(ctx, n.args.get(j)))
            j = j + 1
        }
        return sc_text(ctx, n.left) + "." + n.name + "(" + pv_join_str_list(args2, ", ") + ")"
    }
    if n.kind == "index" {
        return sc_text(ctx, n.left) + "[" + sc_text(ctx, n.right) + "]"
    }
    if n.kind == "field" {
        return sc_text(ctx, n.left) + "." + n.name
    }
    if n.kind == "listlit" {
        return "[...]"
    }
    return "?"
}

# root_name — the variable at the base of an lvalue chain.
fn sc_root_name(ctx: Ctx, e: int) -> str {
    let mut cur: int = e
    let mut guard: int = 0
    while guard < 64 {
        if cur < 0 {
            return ""
        }
        let n: ExprN = ctx.exprs[cur]
        if n.kind == "index" || n.kind == "field" {
            cur = n.left
        } else {
            if n.kind == "ident" {
                return n.name
            }
            return ""
        }
        guard = guard + 1
    }
    return ""
}

# ----------------------------------------------------------------------------
# The callee resolution: user / extern / builtin, over the native tags.
# ----------------------------------------------------------------------------

# raw_call_key — the fns key of a user/extern call, "" for builtins.
fn raw_call_key(ctx: Ctx, e: int) -> str {
    if e < 0 {
        return ""
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "call" {
        if n.muser {
            if ctx.fns.has(n.mkey) {
                return n.mkey
            }
            if ctx.fns.has(n.name) {
                return n.name
            }
            return ""
        }
        return ""
    }
    if n.kind == "method" {
        if n.muser {
            if ctx.fns.has(n.mkey) {
                return n.mkey
            }
            if n.inst_key != "" && ctx.fns.has(n.inst_key) {
                return n.inst_key
            }
            return ""
        }
        return ""
    }
    return ""
}

# sc_call_target — the USER callee key (externs return "" here: the
# .py's _sc_call_target accepted only ("user", key)).
fn sc_call_target(ctx: Ctx, e: int) -> str {
    let key: str = raw_call_key(ctx, e)
    if key == "" {
        return ""
    }
    let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
    if f.is_extern {
        return ""
    }
    return key
}

# sc_builtin_method_op — the builtin op of a fieldcall node ("" = user).
fn sc_builtin_method_op(ctx: Ctx, e: int) -> str {
    if e < 0 {
        return ""
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind != "method" {
        return ""
    }
    if n.muser {
        return ""
    }
    return n.mop
}

# ----------------------------------------------------------------------------
# The interprocedural state.
# ----------------------------------------------------------------------------

struct SCState {
    params: map[str, list[str]], # fn -> secret param names
    rets: map[str, bool],
    roots: map[str, list[str]],
    changed: bool,
    always_record: bool
}

fn sc_state_new(ctx: Ctx) -> SCState {
    let st: SCState = SCState {
        params: map_new(), rets: map_new(), roots: map_new(),
        changed: false, always_record: false
    }
    let keys: list[str] = ctx.fns.keys()
    let mut i: int = 0
    while i < keys.len() {
        let key: str = keys.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        let names: list[str] = []
        if f.attr_secrets != "" {
            push_split(names, f.attr_secrets)
        }
        st.roots.set(key, names)
        st.params.set(key, env_copy_str(names))
        st.rets.set(key, false)
        i = i + 1
    }
    return st
}

# env_copy_str — copy a string list.
fn env_copy_str(xs: list[str]) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    while i < xs.len() {
        out.push(xs.get(i))
        i = i + 1
    }
    return out
}

# push_split — split a comma-joined attr onto this list.
fn push_split(xs: list[str], joined: str) -> void {
    if joined == "" {
        return
    }
    let parts: list[str] = joined.split(",")
    let mut i: int = 0
    while i < parts.len() {
        if parts.get(i) != "" {
            xs.push(parts.get(i))
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# One flow-sensitive walker.
# ----------------------------------------------------------------------------

struct Flow {
    callee: str,
    param: str,
    line: int
}

# SCFinding — one sink.
struct SCFinding {
    kind: str,
    line: int,
    text: str
}

# FnSideChannel — the per-fn report.
struct FnSideChannel {
    fn_key: str,
    roots: list[str],
    secret_params: list[str],
    findings: list[SCFinding],
    length_uses: int,
    incoming: list[Flow],
    incoming_callers: list[str],
    returns_secret: bool
}

fn fn_sidechannel_new(fn_key: str) -> FnSideChannel {
    return FnSideChannel {
        fn_key: fn_key, roots: [], secret_params: [], findings: [],
        length_uses: 0, incoming: [], incoming_callers: [], returns_secret: false
    }
}

struct SCWalker {
    fn_key: str,
    state: SCState,
    ctx: Ctx,
    findings: list[SCFinding],
    length_uses: int,
    flows: list[Flow],
    ret_secret: bool
}

fn sc_walker_new(ctx: Ctx, fn_key: str, state: SCState) -> SCWalker {
    return SCWalker {
        fn_key: fn_key, state: state, ctx: ctx,
        findings: [], length_uses: 0, flows: [], ret_secret: false
    }
}

# sc_flow — mark the callee's param + record the edge.
fn sc_flow(w: SCWalker, callee: str, param: str, line: int) -> void {
    let already: bool = list_has_str(w.state.params.get_or(callee, []), param)
    if !already {
        w.state.params.get_or(callee, []).push(param)
        w.state.changed = true
    }
    if already && !w.state.always_record {
        return
    }
    w.flows.push(Flow {
        callee: callee, param: param, line: line
    })
}

# collect_flow — a user-call node: propagate arg secretness.
fn sc_collect_flow(w: SCWalker, e: int, env: map[str, bool]) -> void {
    let ctx: Ctx = w.ctx
    let callee: str = sc_call_target(ctx, e)
    if callee == "" {
        return
    }
    if !w.state.params.has(callee) {
        return
    }
    let cf: FnInfo = ctx.fns.get_or(callee, dummy_fn())
    let n: ExprN = ctx.exprs[e]
    if n.kind == "method" {
        # receiver = param 0
        if cf.params.len() > 0 {
            if sc_secret(w, n.left, env) {
                sc_flow(w, callee, cf.params.get(0), n.line)
            }
        }
        let mut i: int = 0
        while i < n.args.len() {
            if i + 1 < cf.params.len() {
                let pn: str = cf.params.get(i + 1)
                if sc_secret(w, n.args.get(i), env) {
                    sc_flow(w, callee, pn, n.line)
                }
            }
            i = i + 1
        }
    } else {
        let mut j: int = 0
        while j < n.args.len() {
            if j < cf.params.len() {
                if sc_secret(w, n.args.get(j), env) {
                    sc_flow(w, callee, cf.params.get(j), n.line)
                }
            }
            j = j + 1
        }
    }
}

# env_secret — the var predicate.
fn env_secret(env: map[str, bool], name: str) -> bool {
    return env.get_or(name, false)
}

# sc_secret — the secretness predicate.
fn sc_secret(w: SCWalker, e: int, env: map[str, bool]) -> bool {
    let ctx: Ctx = w.ctx
    if e < 0 {
        return false
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" || n.kind == "float" || n.kind == "bool" || n.kind == "str" {
        return false
    }
    if n.kind == "ident" {
        return env_secret(env, n.name)
    }
    if n.kind == "un" {
        return sc_secret(w, n.left, env)
    }
    if n.kind == "bin" {
        return sc_secret(w, n.left, env) || sc_secret(w, n.right, env)
    }
    if n.kind == "index" || n.kind == "field" {
        return sc_secret(w, n.left, env)
    }
    if n.kind == "listlit" {
        let mut i: int = 0
        while i < n.args.len() {
            if sc_secret(w, n.args.get(i), env) {
                return true
            }
            i = i + 1
        }
        return false
    }
    if n.kind == "structlit" {
        let mut j: int = 0
        while j < n.args.len() {
            if sc_secret(w, n.args.get(j), env) {
                return true
            }
            j = j + 1
        }
        return false
    }
    if n.kind == "enumlit" {
        if sc_secret(w, n.left, env) {
            return true
        }
        let mut k: int = 0
        while k < n.args.len() {
            if sc_secret(w, n.args.get(k), env) {
                return true
            }
            k = k + 1
        }
        return false
    }
    if n.kind == "method" {
        let op: str = sc_builtin_method_op(ctx, e)
        if sc_is_len_method(op) {
            return false
        }
        if sc_secret(w, n.left, env) {
            return true
        }
        let mut i: int = 0
        while i < n.args.len() {
            if sc_secret(w, n.args.get(i), env) {
                return true
            }
            i = i + 1
        }
        let key: str = sc_call_target(ctx, e)
        if key != "" {
            return w.state.rets.get_or(key, false)
        }
        return false
    }
    if n.kind == "call" {
        let key: str = sc_call_target(ctx, e)
        if key != "" {
            let mut i: int = 0
            while i < n.args.len() {
                if sc_secret(w, n.args.get(i), env) {
                    return true
                }
                i = i + 1
            }
            return w.state.rets.get_or(key, false)
        }
        if n.name == "range" {
            return false
        }
        let mut j: int = 0
        while j < n.args.len() {
            if sc_secret(w, n.args.get(j), env) {
                return true
            }
            j = j + 1
        }
        return false
    }
    if n.kind == "match" {
        let scrut_secret: bool = sc_secret(w, n.left, env)
        if scrut_secret {
            return true
        }
        let mut a: int = 0
        while a < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
            let aenv: map[str, bool] = env_copy_bool(env)
            let mut b: int = 0
            while b < arm.bindings.len() {
                if arm.bindings.get(b) != "_" {
                    aenv.set(arm.bindings.get(b), false)
                }
                b = b + 1
            }
            if sc_secret(w, arm.body, aenv) {
                return true
            }
            a = a + 1
        }
        return false
    }
    if n.kind == "qmark" {
        return sc_secret(w, n.left, env)
    }
    return false
}

# env_copy_bool — a deep copy of the env map.
fn env_copy_bool(env: map[str, bool]) -> map[str, bool] {
    let out: map[str, bool] = map_new()
    let ks: list[str] = env.keys()
    let mut i: int = 0
    while i < ks.len() {
        out.set(ks.get(i), env.get_or(ks.get(i), false))
        i = i + 1
    }
    return out
}

# sc_finding — record + dedup.
fn sc_finding(w: SCWalker, kind: str, line: int, text: str) -> void {
    let mut i: int = 0
    while i < w.findings.len() {
        let f: SCFinding = w.findings.get(i)
        if f.kind == kind && f.line == line && f.text == text {
            return
        }
        i = i + 1
    }
    w.findings.push(SCFinding {
        kind: kind, line: line, text: text
    })
}

# sc_flag_expr — the sink flagger.
fn sc_flag_expr(w: SCWalker, e: int, env: map[str, bool]) -> void {
    let ctx: Ctx = w.ctx
    if e < 0 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "bin" {
        if n.op == "/" || n.op == "%" {
            if sc_secret(w, n.left, env) || sc_secret(w, n.right, env) {
                sc_finding(w, "division", n.line, sc_text(ctx, e))
            }
        }
        sc_flag_expr(w, n.left, env)
        sc_flag_expr(w, n.right, env)
        return
    }
    if n.kind == "un" {
        sc_flag_expr(w, n.left, env)
        return
    }
    if n.kind == "index" {
        if sc_secret(w, n.right, env) {
            sc_finding(w, "index", n.line, sc_text(ctx, e))
        }
        sc_flag_expr(w, n.left, env)
        sc_flag_expr(w, n.right, env)
        return
    }
    if n.kind == "method" {
        let op: str = sc_builtin_method_op(ctx, e)
        if sc_is_len_method(op) {
            if sc_secret(w, n.left, env) {
                w.length_uses = w.length_uses + 1
            }
        } else if op == "list.get" || op == "list.set" || op == "str.byte_at"
        || op == "str.slice" || op == "map.get" || op == "map.get_or"
        || op == "map.has" || op == "map.set" {
            let positions: list[int] = sc_address_positions(op)
            let mut pi: int = 0
            while pi < positions.len() {
                let pos: int = positions.get(pi)
                if pos < n.args.len() && sc_secret(w, n.args.get(pos), env) {
                    sc_finding(w, "index", n.line, sc_text(ctx, e))
                    pi = pi + 1
                    break
                }
                pi = pi + 1
            }
        } else {
            # user method: the call itself is data flow; a secret
            # argument is a flow into the callee's parameter
            sc_collect_flow(w, e, env)
        }
        sc_flag_expr(w, n.left, env)
        let mut ai: int = 0
        while ai < n.args.len() {
            sc_flag_expr(w, n.args.get(ai), env)
            ai = ai + 1
        }
        return
    }
    if n.kind == "call" {
        if n.name != "range" {
            sc_collect_flow(w, e, env)
        }
        let mut i: int = 0
        while i < n.args.len() {
            sc_flag_expr(w, n.args.get(i), env)
            i = i + 1
        }
        return
    }
    if n.kind == "enumlit" {
        sc_flag_expr(w, n.left, env)
        let mut j: int = 0
        while j < n.args.len() {
            sc_flag_expr(w, n.args.get(j), env)
            j = j + 1
        }
        return
    }
    if n.kind == "listlit" {
        let mut k: int = 0
        while k < n.args.len() {
            sc_flag_expr(w, n.args.get(k), env)
            k = k + 1
        }
        return
    }
    if n.kind == "structlit" {
        let mut l: int = 0
        while l < n.args.len() {
            sc_flag_expr(w, n.args.get(l), env)
            l = l + 1
        }
        return
    }
    if n.kind == "match" {
        # a match in ANY position decides control flow by its scrutinee
        if sc_secret(w, n.left, env) {
            sc_finding(w, "branch", n.line, sc_text(ctx, n.left))
        }
        sc_flag_expr(w, n.left, env)
        let mut a: int = 0
        while a < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
            sc_flag_expr(w, arm.body, env)
            a = a + 1
        }
        return
    }
    if n.kind == "qmark" {
        sc_flag_expr(w, n.left, env)
        return
    }
}

# sc_side_effects — a statement-position method call taints its receiver.
fn sc_side_effects(w: SCWalker, e: int, env: map[str, bool]) -> void {
    let ctx: Ctx = w.ctx
    if e < 0 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "method" {
        let op: str = sc_builtin_method_op(ctx, e)
        if op == "list.push" || op == "list.set" || op == "map.set" {
            let mut i: int = 0
            while i < n.args.len() {
                if sc_secret(w, n.args.get(i), env) {
                    let base: str = sc_root_name(ctx, n.left)
                    if base != "" {
                        env.set(base, true)
                    }
                }
                i = i + 1
            }
        } else if op == "" {
            # user method: conservatively taint the receiver
            let mut j: int = 0
            while j < n.args.len() {
                if sc_secret(w, n.args.get(j), env) {
                    let base: str = sc_root_name(ctx, n.left)
                    if base != "" {
                        env.set(base, true)
                    }
                }
                j = j + 1
            }
            if sc_secret(w, n.left, env) {
                let base2: str = sc_root_name(ctx, n.left)
                if base2 != "" {
                    env.set(base2, true)
                }
            }
        }
        sc_flag_expr(w, n.left, env)
        let mut k: int = 0
        while k < n.args.len() {
            sc_flag_expr(w, n.args.get(k), env)
            k = k + 1
        }
    } else if n.kind == "call" {
        let mut l: int = 0
        while l < n.args.len() {
            sc_flag_expr(w, n.args.get(l), env)
            l = l + 1
        }
    } else if n.kind == "qmark" {
        sc_side_effects(w, n.left, env)
    }
}

# sc_walk_match — the statement-form match walk.
fn sc_walk_match(w: SCWalker, m: int, env: map[str, bool]) -> void {
    let ctx: Ctx = w.ctx
    if m < 0 {
        return
    }
    let n: ExprN = ctx.exprs[m]
    if n.kind != "match" {
        return
    }
    sc_flag_expr(w, n.left, env)
    let scrut_secret: bool = sc_secret(w, n.left, env)
    if scrut_secret {
        sc_finding(w, "branch", n.line, sc_text(ctx, n.left))
    }
    let mut a: int = 0
    while a < n.args.len() {
        let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
        let aenv: map[str, bool] = env_copy_bool(env)
        let mut b: int = 0
        while b < arm.bindings.len() {
            if arm.bindings.get(b) != "_" {
                aenv.set(arm.bindings.get(b), scrut_secret)
            }
            b = b + 1
        }
        sc_flag_expr(w, arm.body, aenv)
        sc_side_effects(w, arm.body, aenv)
        a = a + 1
    }
}

# sc_walk_stmts — the statement walk.
fn sc_walk_stmts(w: SCWalker, stmts: list[int], env: map[str, bool]) -> void {
    let ctx: Ctx = w.ctx
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "let" {
            sc_flag_expr(w, s.value, env)
            env.set(s.name, sc_secret(w, s.value, env))
        } else if s.kind == "assign" {
            if s.target >= 0 {
                let t: ExprN = ctx.exprs[s.target]
                sc_flag_expr(w, s.target, env)
                sc_flag_expr(w, s.value, env)
                if t.kind == "ident" {
                    env.set(t.name, sc_secret(w, s.value, env))
                } else if t.kind == "field" || t.kind == "index" {
                    let base: str = sc_root_name(ctx, s.target)
                    if base != "" && sc_secret(w, s.value, env) {
                        env.set(base, true)
                    }
                }
            }
        } else if s.kind == "expr" {
            if s.e >= 0 && ctx.exprs[s.e].kind == "match" {
                sc_walk_match(w, s.e, env)
            } else {
                sc_flag_expr(w, s.e, env)
                sc_side_effects(w, s.e, env)
            }
        } else if s.kind == "return" {
            if s.value >= 0 {
                sc_flag_expr(w, s.value, env)
                if sc_secret(w, s.value, env) {
                    w.ret_secret = true
                }
            }
        } else if s.kind == "if" {
            sc_flag_expr(w, s.cond, env)
            if sc_secret(w, s.cond, env) {
                sc_finding(w, "branch", s.line, sc_text(ctx, s.cond))
            }
            let then_env: map[str, bool] = env_copy_bool(env)
            sc_walk_stmts(w, s.body, then_env)
            let else_env: map[str, bool] = env_copy_bool(env)
            sc_walk_stmts(w, s.else_body, else_env)
            # join: secret on either path stays secret
            let tks: list[str] = then_env.keys()
            let mut ti: int = 0
            while ti < tks.len() {
                let nm: str = tks.get(ti)
                env.set(nm, env.get_or(nm, false) || then_env.get_or(nm, false))
                ti = ti + 1
            }
            let eks: list[str] = else_env.keys()
            let mut ei: int = 0
            while ei < eks.len() {
                let nm2: str = eks.get(ei)
                env.set(nm2, env.get_or(nm2, false) || else_env.get_or(nm2, false))
                ei = ei + 1
            }
        } else if s.kind == "while" {
            sc_flag_expr(w, s.cond, env)
            if sc_secret(w, s.cond, env) {
                sc_finding(w, "branch", s.line, sc_text(ctx, s.cond))
            }
            # widening: two passes over the body
            sc_walk_stmts(w, s.body, env)
            sc_walk_stmts(w, s.body, env)
        } else if s.kind == "for" {
            sc_flag_expr(w, s.iter, env)
            let iter_is_range: bool = s.iter >= 0 && ctx.exprs[s.iter].kind == "call"
            && ctx.exprs[s.iter].name == "range" && ctx.exprs[s.iter].muser == false
            if iter_is_range {
                let rn: ExprN = ctx.exprs[s.iter]
                let mut any_secret: bool = false
                let mut ai: int = 0
                while ai < rn.args.len() {
                    if sc_secret(w, rn.args.get(ai), env) {
                        any_secret = true
                    }
                    ai = ai + 1
                }
                if any_secret {
                    sc_finding(w, "loop-bound", s.line, sc_text(ctx, s.iter))
                }
                env.set(s.name, any_secret)
            } else {
                env.set(s.name, sc_secret(w, s.iter, env))
            }
            sc_walk_stmts(w, s.body, env)
            sc_walk_stmts(w, s.body, env)
        } else if s.kind == "match" {
            sc_walk_match(w, s.e, env)
        }
        i = i + 1
    }
}

# sc_round — one fixpoint round.
fn sc_round(ctx: Ctx, state: SCState) -> list[SCWalker] {
    let walkers: list[SCWalker] = []
    let keys: list[str] = ctx.fns.keys()
    let mut i: int = 0
    while i < keys.len() {
        let key: str = keys.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        let w: SCWalker = sc_walker_new(ctx, key, state)
        let env: map[str, bool] = map_new()
        let mut pi: int = 0
        while pi < f.params.len() {
            env.set(f.params.get(pi), list_has_str(state.params.get_or(key, []), f.params.get(pi)))
            pi = pi + 1
        }
        sc_walk_stmts(w, f.body, env)
        walkers.push(w)
        if w.ret_secret && !state.rets.get_or(key, false) {
            state.rets.set(key, true)
            state.changed = true
        }
        i = i + 1
    }
    return walkers
}

# analyze_sidechannel — the fixpoint + the report assembly.
fn analyze_sidechannel(ctx: Ctx) -> map[str, FnSideChannel] {
    let state: SCState = sc_state_new(ctx)
    state.changed = false
    let reports: map[str, FnSideChannel] = map_new()
    # the flat flow store: (caller, callee, param, line) rows
    let flow_callers: list[str] = []
    let flow_rows: list[Flow] = []
    let mut round: int = 0
    while round < 64 {
        state.changed = false
        let walkers: list[SCWalker] = sc_round(ctx, state)
        let mut wi: int = 0
        while wi < walkers.len() {
            let w: SCWalker = walkers.get(wi)
            if !reports.has(w.fn_key) {
                reports.set(w.fn_key, fn_sidechannel_new(w.fn_key))
            }
            let rep: FnSideChannel = reports.get_or(w.fn_key, fn_sidechannel_new(w.fn_key))
            rep.findings = env_copy_finding(w.findings)
            rep.length_uses = w.length_uses
            # flows accumulate under the CALLER's key
            let mut fi: int = 0
            while fi < w.flows.len() {
                flow_callers.push(w.fn_key)
                flow_rows.push(w.flows.get(fi))
                fi = fi + 1
            }
            wi = wi + 1
        }
        if !state.changed {
            break
        }
        round = round + 1
    }
    # assemble: incoming flows per callee (dedup per caller+param, first
    # line wins — sorted by (line, caller, param))
    let out: map[str, FnSideChannel] = map_new()
    let keys: list[str] = ctx.fns.keys()
    let mut ki: int = 0
    while ki < keys.len() {
        let key: str = keys.get(ki)
        let rep: FnSideChannel = reports.get_or(key, fn_sidechannel_new(key))
        rep.roots = env_copy_str(state.roots.get_or(key, []))
        rep.secret_params = sort_str_list(state.params.get_or(key, []))
        # incoming: rows where callee == key, sorted by (line, caller, param),
        # dedup per (caller, param)
        let rows: list[Flow] = []
        let row_callers: list[str] = []
        let mut ri: int = 0
        while ri < flow_rows.len() {
            if flow_rows.get(ri).callee == key {
                rows.push(flow_rows.get(ri))
                row_callers.push(flow_callers.get(ri))
            }
            ri = ri + 1
        }
        # sort by (line, caller, param)
        let mut a: int = 0
        while a < rows.len() {
            let mut b: int = a + 1
            while b < rows.len() {
                let fa: Flow = rows.get(a)
                let fb: Flow = rows.get(b)
                let mut swap: bool = false
                if fb.line < fa.line {
                    swap = true
                } else if fb.line == fa.line && row_callers.get(b) < row_callers.get(a) {
                    swap = true
                } else if fb.line == fa.line && row_callers.get(b) == row_callers.get(a) && fb.param < fa.param {
                    swap = true
                }
                if swap {
                    let tf: Flow = rows.get(a)
                    rows.set(a, rows.get(b))
                    rows.set(b, tf)
                    let tc: str = row_callers.get(a)
                    row_callers.set(a, row_callers.get(b))
                    row_callers.set(b, tc)
                }
                b = b + 1
            }
            a = a + 1
        }
        let seen_caller: list[str] = []
        let seen_param: list[str] = []
        let ins: list[Flow] = []
        let ins_callers: list[str] = []
        let mut si: int = 0
        while si < rows.len() {
            let f: Flow = rows.get(si)
            let mut dup: bool = false
            let mut qi: int = 0
            while qi < seen_caller.len() {
                if seen_caller.get(qi) == row_callers.get(si) && seen_param.get(qi) == f.param {
                    dup = true
                }
                qi = qi + 1
            }
            if !dup {
                seen_caller.push(row_callers.get(si))
                seen_param.push(f.param)
                ins.push(f)
                ins_callers.push(row_callers.get(si))
            }
            si = si + 1
        }
        # store incoming as (caller, param, line) rows with their callers
        rep.incoming = []
        let mut ii: int = 0
        while ii < ins.len() {
            rep.incoming.push(ins.get(ii))
            rep.incoming_callers.push(ins_callers.get(ii))
            ii = ii + 1
        }
        rep.returns_secret = state.rets.get_or(key, false)
        if rep.roots.len() > 0 || rep.incoming.len() > 0 || rep.findings.len() > 0 {
            out.set(key, rep)
        }
        ki = ki + 1
    }
    return out
}

# env_copy_finding — copy a findings list.
fn env_copy_finding(xs: list[SCFinding]) -> list[SCFinding] {
    let out: list[SCFinding] = []
    let mut i: int = 0
    while i < xs.len() {
        out.push(xs.get(i))
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# The --sidechannel report (the .py's sidechannel_report).
# ----------------------------------------------------------------------------

# sidechannel_report returns the counts packed in a struct.
struct SCTotals {
    total: int,
    branch: int,
    index: int,
    loop_bound: int,
    division: int
}

fn sidechannel_report(ctx: Ctx) -> SCTotals uses IO {
    let reports: map[str, FnSideChannel] = analyze_sidechannel(ctx)
    # involved: sorted by (not roots, fn_key) — roots-bearing fns first
    let mut involved: list[FnSideChannel] = []
    let rkeys: list[str] = reports.keys()
    let mut ri: int = 0
    while ri < rkeys.len() {
        let rep: FnSideChannel = reports.get_or(rkeys.get(ri), fn_sidechannel_new(""))
        let mut placed: bool = false
        let res: list[FnSideChannel] = []
        let mut si: int = 0
        while si < involved.len() {
            let o: FnSideChannel = involved.get(si)
            if !placed {
                let o_has: bool = o.roots.len() > 0
                let r_has: bool = rep.roots.len() > 0
                if(r_has && !o_has) || (r_has == o_has && rep.fn_key < o.fn_key) {
                    res.push(rep)
                    res.push(o)
                    placed = true
                } else {
                    res.push(o)
                }
            } else {
                res.push(o)
            }
            si = si + 1
        }
        if !placed {
            res.push(rep)
        }
        involved = res
        ri = ri + 1
    }
    if involved.len() == 0 {
        println("    (no #[secrets(...)] annotation — nothing to audit; mark the secret parameters of the crypto code)")
        return SCTotals {
            total: 0, branch: 0, index: 0, loop_bound: 0, division: 0
        }
    }
    let t: SCTotals = SCTotals {
        total: 0, branch: 0, index: 0, loop_bound: 0, division: 0
    }
    let mut leak_fns: int = 0
    let mut ii: int = 0
    while ii < involved.len() {
        let rep: FnSideChannel = involved.get(ii)
        println("  " + rep.fn_key + ":")
        if rep.roots.len() > 0 {
            println("    secret roots: " + pv_join_str_list(rep.roots, ", "))
        }
        let extra: list[str] = []
        let mut pi: int = 0
        while pi < rep.secret_params.len() {
            if !list_has_str(rep.roots, rep.secret_params.get(pi)) {
                extra.push(rep.secret_params.get(pi))
            }
            pi = pi + 1
        }
        if extra.len() > 0 {
            println("    secret by propagation: " + pv_join_str_list(extra, ", "))
        }
        let mut ic: int = 0
        while ic < rep.incoming.len() {
            let f: Flow = rep.incoming.get(ic)
            let caller: str = rep.incoming_callers.get(ic)
            println("    incoming: '" + f.param + "' passes a secret '" + f.param + "' from " + caller + " (line " + f.line.to_str() + ")")
            ic = ic + 1
        }
        let mut fi: int = 0
        while fi < rep.findings.len() {
            let f: SCFinding = rep.findings.get(fi)
            if f.kind == "branch" {
                t.branch = t.branch + 1
            } else if f.kind == "index" {
                t.index = t.index + 1
            } else if f.kind == "loop-bound" {
                t.loop_bound = t.loop_bound + 1
            } else if f.kind == "division" {
                t.division = t.division + 1
            }
            println("    line " + f.line.to_str() + ": " + pv_upper(f.kind) + " — `" + f.text + "`")
            println("      " + sc_why(f.kind))
            fi = fi + 1
        }
        if rep.length_uses > 0 {
            println("    .len() on a secret value: " + rep.length_uses.to_str() + " use(s) — public by policy")
        }
        if rep.findings.len() > 0 {
            leak_fns = leak_fns + 1
        } else {
            println("    CLEAN: no secret-dependent control flow, addressing or division")
        }
        ii = ii + 1
    }
    t.total = t.branch + t.index + t.loop_bound + t.division
    println("  SIDECHANNEL TOTAL: " + t.total.to_str() + " leaks — " + t.branch.to_str() + " branch, " + t.index.to_str() + " index, " + t.loop_bound.to_str() + " loop-bound, " + t.division.to_str() + " division — in " + leak_fns.to_str() + " of " + involved.len().to_str() + " secret-handling fns")
    return t
}

# ============================================================================
# Part 8 — Stage 102: the constant-time verifier.
# ============================================================================

# CtClaim — one #[ct] claim's verdict.
struct CtClaim {
    fn_key: str,
    secrets: list[str],
    verified: bool,
    findings: list[CtFindingRow],
    chains: list[CtChain],
    reach: list[str],
    length_uses: int,
    returns_secret: bool
}

struct CtFindingRow {
    wkey: str,
    finding: SCFinding
}

struct CtChain {
    wkey: str,
    kind: str,
    line: int,
    hops: list[Flow],
    present: bool
}

fn ct_claim_new(fn_key: str) -> CtClaim {
    return CtClaim {
        fn_key: fn_key, secrets: [], verified: false,
        findings: [], chains: [], reach: [],
        length_uses: 0, returns_secret: false
    }
}

# ct_edges — dedup the accumulated rows into per-caller ordered lists.
# Returns parallel lists (callers, rows-per-caller).
struct EdgeSet {
    callers: list[str],
    rows: list[list[Flow]]
}

fn ct_edges(flow_callers: list[str], flow_rows: list[Flow]) -> EdgeSet {
    let es: EdgeSet = EdgeSet {
        callers: [], rows: []
    }
    let mut i: int = 0
    while i < flow_rows.len() {
        let caller: str = flow_callers.get(i)
        let row: Flow = flow_rows.get(i)
        let mut cidx: int = -1
        let mut j: int = 0
        while j < es.callers.len() {
            if es.callers.get(j) == caller {
                cidx = j
            }
            j = j + 1
        }
        if cidx < 0 {
            es.callers.push(caller)
            let rows: list[Flow] = [row]
            es.rows.push(rows)
        } else {
            # dedup by the full triple
            let existing: list[Flow] = es.rows.get(cidx)
            let mut dup: bool = false
            let mut k: int = 0
            while k < existing.len() {
                if existing.get(k).callee == row.callee
                && existing.get(k).param == row.param
                && existing.get(k).line == row.line {
                    dup = true
                }
                k = k + 1
            }
            if !dup {
                existing.push(row)
            }
        }
        i = i + 1
    }
    return es
}

# ct_chain_find — a shortest secret-flow path start -> target (BFS);
# present=false when no path exists.
fn ct_chain_find(start: str, target: str, es: EdgeSet) -> CtChain {
    let out: CtChain = CtChain {
        wkey: target, kind: "", line: 0, hops: [], present: false
    }
    if start == target {
        out.present = true
        out.hops = []
        return out
    }
    # queue of (node, path)
    let q_nodes: list[str] = [start]
    let q_paths: list[list[Flow]] = []
    let p0: list[Flow] = []
    q_paths.push(p0)
    let seen: list[str] = [start]
    let mut head: int = 0
    while head < q_nodes.len() {
        let node: str = q_nodes.get(head)
        let path: list[Flow] = q_paths.get(head)
        head = head + 1
        let mut cidx: int = -1
        let mut ci: int = 0
        while ci < es.callers.len() {
            if es.callers.get(ci) == node {
                cidx = ci
            }
            ci = ci + 1
        }
        if cidx < 0 {
            continue
        }
        let rows: list[Flow] = es.rows.get(cidx)
        let mut ri: int = 0
        while ri < rows.len() {
            let row: Flow = rows.get(ri)
            let npath: list[Flow] = env_copy_flow(path)
            npath.push(row)
            if row.callee == target {
                out.present = true
                out.hops = npath
                return out
            }
            if !list_has_str(seen, row.callee) {
                seen.push(row.callee)
                q_nodes.push(row.callee)
                q_paths.push(npath)
            }
            ri = ri + 1
        }
    }
    return out
}

# env_copy_flow — copy a flow list.
fn env_copy_flow(xs: list[Flow]) -> list[Flow] {
    let out: list[Flow] = []
    let mut i: int = 0
    while i < xs.len() {
        out.push(xs.get(i))
        i = i + 1
    }
    return out
}

# analyze_consttime — one taint universe per #[ct] claim.
fn analyze_consttime(ctx: Ctx) -> list[CtClaim] {
    let claims: list[CtClaim] = []
    let keys: list[str] = ctx.fns.keys()
    let mut ki: int = 0
    while ki < keys.len() {
        let key: str = keys.get(ki)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if !f.attr_ct {
            ki = ki + 1
            continue
        }
        let roots: list[str] = []
        push_split(roots, f.attr_secrets)
        let claim: CtClaim = ct_claim_new(key)
        claim.secrets = env_copy_str(roots)
        let state: SCState = sc_state_new(ctx)
        state.always_record = true
        # the claim's own universe: its params are the ONLY roots
        let pkeys: list[str] = state.params.keys()
        let mut pi: int = 0
        while pi < pkeys.len() {
            if pkeys.get(pi) == key {
                state.params.set(pkeys.get(pi), env_copy_str(roots))
            } else {
                state.params.set(pkeys.get(pi), [])
            }
            pi = pi + 1
        }
        state.changed = false
        let flow_callers: list[str] = []
        let flow_rows: list[Flow] = []
        let seen_finding: list[str] = []
        let findings: list[CtFindingRow] = []
        let mut length_uses: int = 0
        let reach: list[str] = [key]
        let mut round: int = 0
        while round < 64 {
            state.changed = false
            let walkers: list[SCWalker] = sc_round(ctx, state)
            # the len() policy count follows the LAST round's environment
            let mut round_uses: int = 0
            let mut wi: int = 0
            while wi < walkers.len() {
                let w: SCWalker = walkers.get(wi)
                round_uses = round_uses + w.length_uses
                let mut fi: int = 0
                while fi < w.findings.len() {
                    let fnd: SCFinding = w.findings.get(fi)
                    let fk: str = w.fn_key + "|" + fnd.kind + "|" + fnd.line.to_str() + "|" + fnd.text
                    if !list_has_str(seen_finding, fk) {
                        seen_finding.push(fk)
                        findings.push(CtFindingRow {
                            wkey: w.fn_key, finding: fnd
                        })
                    }
                    fi = fi + 1
                }
                let mut xi: int = 0
                while xi < w.flows.len() {
                    flow_callers.push(w.fn_key)
                    flow_rows.push(w.flows.get(xi))
                    xi = xi + 1
                }
                wi = wi + 1
            }
            length_uses = round_uses
            # reach: every fn whose params are non-empty
            let pkeys2: list[str] = state.params.keys()
            let mut pj: int = 0
            while pj < pkeys2.len() {
                if state.params.get_or(pkeys2.get(pj), []).len() > 0 {
                    if !list_has_str(reach, pkeys2.get(pj)) {
                        reach.push(pkeys2.get(pj))
                    }
                }
                pj = pj + 1
            }
            if !state.changed {
                break
            }
            round = round + 1
        }
        # chains from the CONVERGED edge set
        let es: EdgeSet = ct_edges(flow_callers, flow_rows)
        let chained: list[CtFindingRow] = []
        let chains: list[CtChain] = []
        let mut fi2: int = 0
        while fi2 < findings.len() {
            let row: CtFindingRow = findings.get(fi2)
            let ch: CtChain = ct_chain_find(key, row.wkey, es)
            if !ch.present {
                fi2 = fi2 + 1
                continue
            }
            chained.push(row)
            ch.kind = row.finding.kind
            ch.line = row.finding.line
            chains.push(ch)
            fi2 = fi2 + 1
        }
        claim.findings = chained
        claim.chains = chains
        claim.length_uses = length_uses
        claim.returns_secret = state.rets.get_or(key, false)
        # reach = [key] + sorted(reach - {key})
        let rest: list[str] = []
        let mut ri: int = 0
        while ri < reach.len() {
            if reach.get(ri) != key {
                rest.push(reach.get(ri))
            }
            ri = ri + 1
        }
        claim.reach = [key]
        let sorted_rest: list[str] = sort_str_list(rest)
        let mut si: int = 0
        while si < sorted_rest.len() {
            claim.reach.push(sorted_rest.get(si))
            si = si + 1
        }
        claim.verified = chained.len() == 0
        claims.push(claim)
        ki = ki + 1
    }
    return claims
}

# ct_chain_text — the chain as printed.
fn ct_chain_text(claim: CtClaim, ch: CtChain) -> str {
    if !ch.present {
        return ""
    }
    if ch.hops.len() == 0 {
        return claim.fn_key + " (the claim's own body)"
    }
    let hops: list[str] = [claim.fn_key]
    let mut i: int = 0
    while i < ch.hops.len() {
        let hop: Flow = ch.hops.get(i)
        hops.push(hop.callee + " (" + hop.param + ", line " + hop.line.to_str() + ")")
        i = i + 1
    }
    return pv_join_str_list(hops, " -> ")
}

# ----------------------------------------------------------------------------
# The --consttime report (the .py's consttime_report).
# ----------------------------------------------------------------------------

# consttime_report returns the violated count.
fn consttime_report(ctx: Ctx) -> int uses IO {
    let claims: list[CtClaim] = analyze_consttime(ctx)
    if claims.len() == 0 {
        println("    (no #[ct] claims — nothing to verify; mark the fns that must be constant-time with #[ct] and name their secrets with #[secrets(...)])")
        return 0
    }
    let mut verified: int = 0
    let mut violated: int = 0
    let mut ci: int = 0
    while ci < claims.len() {
        let c: CtClaim = claims.get(ci)
        println("  " + c.fn_key + ":")
        println("    claim: ct over secrets " + pv_join_str_list(c.secrets, ", "))
        let mut fnss: str = ""
        if c.reach.len() == 1 {
            fnss = ""
        } else {
            fnss = "s"
        }
        println("    secret reach: " + pv_join_str_list(c.reach, ", ") + " (" + c.reach.len().to_str() + " fn" + fnss + ")")
        if c.length_uses > 0 {
            println("    policy: .len() on a secret value — " + c.length_uses.to_str() + " use(s), public by policy")
        }
        if c.verified {
            verified = verified + 1
            println("    VERIFIED: no secret-derived branch, address, loop bound or division anywhere the secrets reach")
        } else {
            violated = violated + 1
            println("    VIOLATED: " + c.findings.len().to_str() + " sink(s) reachable from the claim's secrets")
            let mut fi: int = 0
            while fi < c.findings.len() {
                let row: CtFindingRow = c.findings.get(fi)
                let mut where_s: str = ""
                if row.wkey != c.fn_key {
                    where_s = " (inside " + row.wkey + ")"
                }
                println("    line " + row.finding.line.to_str() + ": " + pv_upper(row.finding.kind) + " — `" + row.finding.text + "`" + where_s)
                println("      why: " + sc_why(row.finding.kind))
                # the chain for (wkey, kind, line)
                let mut chi: int = 0
                while chi < c.chains.len() {
                    let ch: CtChain = c.chains.get(chi)
                    if ch.wkey == row.wkey && ch.kind == row.finding.kind && ch.line == row.finding.line {
                        println("      chain: " + ct_chain_text(c, ch))
                    }
                    chi = chi + 1
                }
                fi = fi + 1
            }
        }
        ci = ci + 1
    }
    println("  CT TOTAL: " + verified.to_str() + " verified, " + violated.to_str() + " violated of " + claims.len().to_str() + " claims")
    return violated
}

# ============================================================================
# Part 9 — Stage 109: the FFI taint-flow report (the retired interpreter's
# tools/hlinterp/ffi_taint.py, ported over the native pools).
# ----------------------------------------------------------------------------
# One fixpoint over the call graph, then one flow-sensitive walk per fn
# with two environments:
#
#   tainted[var]  -> provenance  the var holds a tainted[T] value
#   escaped[var]  -> provenance  the var holds data that WAS tainted and
#                                was unwrapped (the hatch has been used)
#
# Provenance is a short label naming the origin: "ffi:getenv" for a
# marked extern, "builtin:tainted_args" for argv, "param:p" for a
# parameter the fixpoint marked, "taint_mark" for a literal the author
# marked by hand. A sanitizer call cuts the chain; a .len()-style pure
# query neither propagates nor flows. The report prints, per fn, the
# source sites, the unwrap escapes, the sanitised cuts and the
# sink-reaching flows, with the FFI TAINT TOTAL line the gate pins.
# ============================================================================

# The builtin taint sources (mirrors the checker's source builtins).
fn t_is_source_builtin(name: str) -> bool {
    return name == "tainted_args" || name == "read_file_tainted"
    || name == "read_line"
}

# The std.sanitize helpers — each cuts the taint chain (matched by
# NAME, the .py's law: the imported helpers ARE the sanitizers).
fn t_is_sanitizer(name: str) -> bool {
    return name == "sanitize_html" || name == "sanitize_path"
    || name == "sanitize_sql_identifier" || name == "sanitize_sql_string"
    || name == "sanitize_command" || name == "sanitize_filename"
}

# t_sink_positions(name) — the builtin sinks and the argument positions
# that reject tainted values (a flow to ANY of these positions counts
# as sink-reaching). "" positions = not a sink.
fn t_sink_positions(name: str) -> list[int] {
    if name == "print" || name == "println" || name == "eprint"
    || name == "eprintln" || name == "exit" || name == "read_file"
    || name == "read_file_tainted" || name == "file_exists"
    || name == "fs_read_dir" || name == "fs_size" || name == "fs_is_dir"
    || name == "fs_set_perms" || name == "net_lookup"
    || name == "net_tcp_connect" || name == "net_tcp_listen"
    || name == "proc_exec" || name == "proc_spawn" || name == "env_get"
    || name == "env_has" || name == "env_set" || name == "env_unset"
    || name == "cwd_set" {
        return[0]
    }
    if name == "write_file" {
        return[0, 1]
    }
    if name == "net_udp_send_to" {
        return[1]
    }
    if name == "net_tls_get" {
        return[0, 2]
    }
    return[]
}

# ----------------------------------------------------------------------------
# The data: two environments, the fixpoint state, the findings.
# ----------------------------------------------------------------------------

# TEnv — the two provenance tables ("" = clean). Structs are reference
# types, so a walker mutates its caller's tables through the handle —
# branch walks always start from tenv_copy.
struct TEnv {
    tainted: map[str, str],
    escaped: map[str, str]
}

fn tenv_copy(env: TEnv) -> TEnv {
    let out: TEnv = TEnv {
        tainted: map_new(), escaped: map_new()
    }
    let tk: list[str] = env.tainted.keys()
    let mut i: int = 0
    while i < tk.len() {
        out.tainted.set(tk.get(i), env.tainted.get_or(tk.get(i), ""))
        i = i + 1
    }
    let ek: list[str] = env.escaped.keys()
    let mut j: int = 0
    while j < ek.len() {
        out.escaped.set(ek.get(j), env.escaped.get_or(ek.get(j), ""))
        j = j + 1
    }
    return out
}

# TState — the interprocedural fixpoint state: which fn parameters may
# carry tainted data, and which fns may return it.
struct TState {
    params: map[str, list[str]], # fn -> tainted param names
    rets: map[str, bool],
    changed: bool
}

fn t_state_new(ctx: Ctx) -> TState {
    let st: TState = TState {
        params: map_new(), rets: map_new(), changed: false
    }
    let keys: list[str] = ctx.fns.keys()
    let mut i: int = 0
    while i < keys.len() {
        st.params.set(keys.get(i), [])
        st.rets.set(keys.get(i), false)
        i = i + 1
    }
    return st
}

# TFinding — one reported line inside one fn.
struct TFinding {
    kind: str, # source | unwrap | sink-reach | sanitised
    line: int,
    text: str,
    prov: str
}

# FnFfiTaint — the per-fn report.
struct FnFfiTaint {
    fn_key: str,
    tainted_params: list[str], # sorted, marked by the fixpoint
    findings: list[TFinding], # deduped, insertion order
    incoming: list[Flow], # (callee param, line) rows
    incoming_callers: list[str]
}

fn fn_ffi_taint_new(fn_key: str) -> FnFfiTaint {
    return FnFfiTaint {
        fn_key: fn_key, tainted_params: [], findings: [],
        incoming: [], incoming_callers: []
    }
}

# TWalker — one flow-sensitive pass over one fn body.
struct TWalker {
    ctx: Ctx,
    fn_key: str,
    state: TState,
    findings: list[TFinding],
    flows: list[Flow],
    ret_tainted: bool
}

fn t_walker_new(ctx: Ctx, fn_key: str, state: TState) -> TWalker {
    return TWalker {
        ctx: ctx, fn_key: fn_key, state: state,
        findings: [], flows: [], ret_tainted: false
    }
}

# t_finding — record + dedup on (kind, line, text); the FIRST
# occurrence's provenance wins (the .py's setdefault).
fn t_finding(w: TWalker, kind: str, line: int, text: str, prov: str) -> void {
    let mut i: int = 0
    while i < w.findings.len() {
        let f: TFinding = w.findings.get(i)
        if f.kind == kind && f.line == line && f.text == text {
            return
        }
        i = i + 1
    }
    w.findings.push(TFinding {
        kind: kind, line: line, text: text, prov: prov
    })
}

fn t_copy_findings(xs: list[TFinding]) -> list[TFinding] {
    let out: list[TFinding] = []
    let mut i: int = 0
    while i < xs.len() {
        out.push(xs.get(i))
        i = i + 1
    }
    return out
}

# t_flow — mark the callee's parameter tainted-carrying for the next
# fixpoint round and record the edge for the report (edges accumulate
# across rounds; the incoming assembly dedups per caller+param).
fn t_flow(w: TWalker, callee: str, param: str, line: int) -> void {
    if !w.state.params.has(callee) {
        return
    }
    let ps: list[str] = w.state.params.get_or(callee, [])
    if !list_has_str(ps, param) {
        ps.push(param)
        w.state.changed = true
    }
    w.flows.push(Flow {
        callee: callee, param: param, line: line
    })
}

# ----------------------------------------------------------------------------
# t_text — the .py's _text: the short rendering of an expression for a
# finding line (a str literal is "...", a bin is parenthesised, and an
# unrenderable node is "?" — NOT the side-channel renderer's "[...]").
# ----------------------------------------------------------------------------

fn t_text(ctx: Ctx, e: int) -> str {
    if e < 0 {
        return "?"
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return n.ival.to_str()
    }
    if n.kind == "float" {
        return n.fval.to_str()
    }
    if n.kind == "bool" {
        if n.bval {
            return "True"
        }
        return "False"
    }
    if n.kind == "str" {
        return "\"...\""
    }
    if n.kind == "ident" {
        return n.name
    }
    if n.kind == "un" {
        return n.op + t_text(ctx, n.left)
    }
    if n.kind == "bin" {
        return "(" + t_text(ctx, n.left) + " " + n.op + " "
        + t_text(ctx, n.right) + ")"
    }
    if n.kind == "call" {
        let args: list[str] = []
        let mut i: int = 0
        while i < n.args.len() {
            args.push(t_text(ctx, n.args.get(i)))
            i = i + 1
        }
        return n.name + "(" + pv_join_str_list(args, ", ") + ")"
    }
    if n.kind == "method" {
        let args2: list[str] = []
        let mut j: int = 0
        while j < n.args.len() {
            args2.push(t_text(ctx, n.args.get(j)))
            j = j + 1
        }
        return t_text(ctx, n.left) + "." + n.name + "(" + pv_join_str_list(args2, ", ") + ")"
    }
    if n.kind == "index" {
        return t_text(ctx, n.left) + "[" + t_text(ctx, n.right) + "]"
    }
    if n.kind == "field" {
        return t_text(ctx, n.left) + "." + n.name
    }
    return "?"
}

# ----------------------------------------------------------------------------
# The provenance predicates. t_prop(w, e, env, esc) returns the label
# or "" (clean); esc selects the table ('tainted' when false).
# ----------------------------------------------------------------------------

# t_prop_method — the .py's _prop_of_method: len-style queries are
# clean; everything else derives from the receiver or the args.
fn t_prop_method(w: TWalker, e: int, env: TEnv, esc: bool) -> str {
    let ctx: Ctx = w.ctx
    let n: ExprN = ctx.exprs[e]
    let op: str = sc_builtin_method_op(ctx, e)
    if op == "list.len" || op == "str.len" || op == "map.len"
    || op == "chan.len" || op == "str.starts_with" || op == "str.ends_with"
    || op == "str.contains" || op == "list.has" || op == "map.has" {
        return ""
    }
    let mut prov: str = t_prop(w, n.left, env, esc)
    let mut i: int = 0
    while i < n.args.len() {
        let p: str = t_prop(w, n.args.get(i), env, esc)
        if p != "" && prov == "" {
            prov = p
        }
        i = i + 1
    }
    return prov
}

fn t_prop(w: TWalker, e: int, env: TEnv, esc: bool) -> str {
    let ctx: Ctx = w.ctx
    if e < 0 {
        return ""
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" || n.kind == "float" || n.kind == "bool"
    || n.kind == "str" {
        return ""
    }
    if n.kind == "ident" {
        if esc {
            return env.escaped.get_or(n.name, "")
        }
        return env.tainted.get_or(n.name, "")
    }
    if n.kind == "un" {
        return t_prop(w, n.left, env, esc)
    }
    if n.kind == "bin" {
        let l: str = t_prop(w, n.left, env, esc)
        if l != "" {
            return l
        }
        return t_prop(w, n.right, env, esc)
    }
    if n.kind == "index" || n.kind == "field" {
        return t_prop(w, n.left, env, esc)
    }
    if n.kind == "listlit" {
        let mut prov: str = ""
        let mut i: int = 0
        while i < n.args.len() {
            let p: str = t_prop(w, n.args.get(i), env, esc)
            if p != "" && prov == "" {
                prov = p
            }
            i = i + 1
        }
        return prov
    }
    if n.kind == "enumlit" {
        # the .py's fieldcall/enumlit pair: target + args (the native
        # enumlit carries no target — left stays -1)
        let mut prov2: str = t_prop(w, n.left, env, esc)
        let mut j: int = 0
        while j < n.args.len() {
            let p2: str = t_prop(w, n.args.get(j), env, esc)
            if p2 != "" && prov2 == "" {
                prov2 = p2
            }
            j = j + 1
        }
        return prov2
    }
    if n.kind == "method" {
        return t_prop_method(w, e, env, esc)
    }
    if n.kind == "call" {
        let name: str = n.name
        # The taint builtins decide the environment switch. A TAINTED
        # value never shows up in the escaped env, and an ESCAPED value
        # never shows up in the tainted env — only the unwrap and mark
        # builtins move data between the tables.
        if name == "taint_unwrap" {
            # unwrapping kills the taint: the result is clean-typed,
            # its ESCAPED provenance is the inner value's origin.
            if !esc {
                return ""
            }
            let mut inner: int = -1
            if n.args.len() > 0 {
                inner = n.args.get(0)
            }
            let p1: str = t_prop(w, inner, env, false)
            if p1 != "" {
                return p1
            }
            return t_prop(w, inner, env, true)
        }
        if name == "taint_mark" {
            # marking (re-)taints a value, even one that was escaped.
            if esc {
                return ""
            }
            let mut inner2: int = -1
            if n.args.len() > 0 {
                inner2 = n.args.get(0)
            }
            let q1: str = t_prop(w, inner2, env, true)
            if q1 != "" {
                return q1
            }
            let q2: str = t_prop(w, inner2, env, false)
            if q2 != "" {
                return q2
            }
            return "taint_mark"
        }
        if t_is_sanitizer(name) {
            return "" # the cut point
        }
        if t_is_source_builtin(name) {
            # a builtin source's result is tainted[T] — tainted env only.
            if !esc {
                return "builtin:" + name
            }
            return ""
        }
        let key: str = raw_call_key(ctx, e)
        let is_ext: bool = key != "" && ctx.fns.has(key)
        && ctx.fns.get_or(key, dummy_fn()).is_extern
        if is_ext {
            # An extern's return semantics are the C side's: untrusted
            # ONLY when marked #[taint_source]; argument provenance
            # stops at the boundary.
            let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
            if f.attr_taint_source && !esc {
                return "ffi:" + key
            }
            return ""
        }
        if key != "" {
            # a user callee: tainted iff a param flows in or the callee
            # may return tainted data (the label "param").
            let mut argprov: str = ""
            let mut i: int = 0
            while i < n.args.len() {
                let p: str = t_prop(w, n.args.get(i), env, esc)
                if p != "" && argprov == "" {
                    argprov = p
                }
                i = i + 1
            }
            if argprov != "" {
                return argprov
            }
            if !esc && w.state.rets.get_or(key, false) {
                return "param"
            }
            return ""
        }
        if name == "range" {
            return ""
        }
        # a plain builtin: derived from its arguments only
        let mut argprov2: str = ""
        let mut j: int = 0
        while j < n.args.len() {
            let p2: str = t_prop(w, n.args.get(j), env, esc)
            if p2 != "" && argprov2 == "" {
                argprov2 = p2
            }
            j = j + 1
        }
        return argprov2
    }
    if n.kind == "qmark" {
        return t_prop(w, n.left, env, esc)
    }
    if n.kind == "match" {
        let scrut: str = t_prop(w, n.left, env, esc)
        if scrut != "" {
            return scrut
        }
        let mut a: int = 0
        while a < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
            let aenv: TEnv = tenv_copy(env)
            let mut b: int = 0
            while b < arm.bindings.len() {
                if arm.bindings.get(b) != "_" {
                    # the SELECTED table's binding is clean in the arm
                    if esc {
                        aenv.escaped.set(arm.bindings.get(b), "")
                    } else {
                        aenv.tainted.set(arm.bindings.get(b), "")
                    }
                }
                b = b + 1
            }
            let p: str = t_prop(w, arm.body, aenv, esc)
            if p != "" {
                return p
            }
            a = a + 1
        }
        return ""
    }
    return ""
}

# t_either — provenance under EITHER environment (the general "this
# value derives from untrusted data" predicate).
fn t_either(w: TWalker, e: int, env: TEnv) -> str {
    let p: str = t_prop(w, e, env, false)
    if p != "" {
        return p
    }
    return t_prop(w, e, env, true)
}

# ----------------------------------------------------------------------------
# The source-site flagger.
# ----------------------------------------------------------------------------

# t_extern_of — the extern FnInfo behind a call key, or the dummy when
# the key is not an extern declaration.
fn t_extern_of(ctx: Ctx, key: str) -> FnInfo {
    if key == "" {
        return dummy_fn()
    }
    if !ctx.fns.has(key) {
        return dummy_fn()
    }
    let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
    if !f.is_extern {
        return dummy_fn()
    }
    return f
}

# t_flag_sink_params — escaped data reaching a #[taint_sink(...)]
# parameter is an accepted-risk flow worth naming.
fn t_flag_sink_params(w: TWalker, ctx: Ctx, e: int, key: str, f: FnInfo,
env: TEnv) -> void {
    let n: ExprN = ctx.exprs[e]
    let sinks: list[str] = []
    push_split(sinks, f.attr_taint_sinks)
    let mut i: int = 0
    while i < n.args.len() {
        if i < f.params.len() && list_has_str(sinks, f.params.get(i)) {
            let p: str = t_prop(w, n.args.get(i), env, true)
            if p != "" {
                t_finding(w, "sink-reach", n.line, t_text(ctx, e), p)
            }
        }
        i = i + 1
    }
}

fn t_flag_expr(w: TWalker, e: int, env: TEnv) -> void {
    let ctx: Ctx = w.ctx
    if e < 0 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "call" {
        let name: str = n.name
        let key: str = raw_call_key(ctx, e)
        let fb: FnInfo = t_extern_of(ctx, key)
        let fb_is: bool = fb.is_extern
        if t_is_source_builtin(name) {
            t_finding(w, "source", n.line, name + "()", "builtin:" + name)
        } else if name == "taint_unwrap" && n.args.len() > 0 {
            let prov: str = t_prop(w, n.args.get(0), env, false)
            if prov == "" {
                let prov2: str = t_prop(w, n.args.get(0), env, true)
                if prov2 != "" {
                    t_finding(w, "unwrap", n.line, t_text(ctx, e), prov2)
                }
            } else {
                t_finding(w, "unwrap", n.line, t_text(ctx, e), prov)
            }
        } else if t_is_sanitizer(name) && n.args.len() > 0 {
            let sp: str = t_either(w, n.args.get(0), env)
            if sp != "" {
                t_finding(w, "sanitised", n.line, t_text(ctx, e), sp)
            }
        } else if t_sink_positions(name).len() > 0 {
            let positions: list[int] = t_sink_positions(name)
            let mut pi: int = 0
            while pi < positions.len() {
                let pos: int = positions.get(pi)
                if pos < n.args.len() {
                    let p: str = t_prop(w, n.args.get(pos), env, true)
                    if p != "" {
                        t_finding(w, "sink-reach", n.line, t_text(ctx, e), p)
                    }
                }
                pi = pi + 1
            }
        } else if fb_is && fb.attr_taint_source {
            # the #[taint_source] extern call itself is an entry point
            t_finding(w, "source", n.line, t_text(ctx, e), "ffi:" + key)
            t_flag_sink_params(w, ctx, e, key, fb, env)
        } else if fb_is {
            # an unmarked extern: only its declared sinks are named
            t_flag_sink_params(w, ctx, e, key, fb, env)
        } else if key != "" && ctx.fns.has(key) && !fb_is {
            # a user callee: untrusted arguments flow into parameters
            let cf: FnInfo = ctx.fns.get_or(key, dummy_fn())
            let mut i: int = 0
            while i < n.args.len() {
                if i < cf.params.len() {
                    let p: str = t_either(w, n.args.get(i), env)
                    if p != "" {
                        t_flow(w, key, cf.params.get(i), n.line)
                    }
                }
                i = i + 1
            }
        }
        let mut ai: int = 0
        while ai < n.args.len() {
            t_flag_expr(w, n.args.get(ai), env)
            ai = ai + 1
        }
        return
    }
    if n.kind == "method" {
        let op: str = sc_builtin_method_op(ctx, e)
        if op == "" {
            # a user method: flows like a call (receiver = param 0)
            let key: str = raw_call_key(ctx, e)
            if key != "" && ctx.fns.has(key) {
                let cf: FnInfo = ctx.fns.get_or(key, dummy_fn())
                if cf.params.len() > 0 {
                    let p: str = t_either(w, n.left, env)
                    if p != "" {
                        t_flow(w, key, cf.params.get(0), n.line)
                    }
                }
                let mut i: int = 0
                while i < n.args.len() {
                    if i + 1 < cf.params.len() {
                        let pv: str = t_either(w, n.args.get(i), env)
                        if pv != "" {
                            t_flow(w, key, cf.params.get(i + 1), n.line)
                        }
                    }
                    i = i + 1
                }
            }
        }
        t_flag_expr(w, n.left, env)
        let mut ai: int = 0
        while ai < n.args.len() {
            t_flag_expr(w, n.args.get(ai), env)
            ai = ai + 1
        }
        return
    }
    if n.kind == "bin" {
        t_flag_expr(w, n.left, env)
        t_flag_expr(w, n.right, env)
        return
    }
    if n.kind == "un" {
        t_flag_expr(w, n.left, env)
        return
    }
    if n.kind == "index" {
        t_flag_expr(w, n.left, env)
        t_flag_expr(w, n.right, env)
        return
    }
    if n.kind == "enumlit" {
        t_flag_expr(w, n.left, env)
        let mut j: int = 0
        while j < n.args.len() {
            t_flag_expr(w, n.args.get(j), env)
            j = j + 1
        }
        return
    }
    if n.kind == "listlit" {
        let mut k: int = 0
        while k < n.args.len() {
            t_flag_expr(w, n.args.get(k), env)
            k = k + 1
        }
        return
    }
    if n.kind == "structlit" {
        let mut l: int = 0
        while l < n.args.len() {
            t_flag_expr(w, n.args.get(l), env)
            l = l + 1
        }
        return
    }
    if n.kind == "qmark" {
        t_flag_expr(w, n.left, env)
        return
    }
    if n.kind == "match" {
        t_flag_expr(w, n.left, env)
        let mut a: int = 0
        while a < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
            t_flag_expr(w, arm.body, env)
            a = a + 1
        }
        return
    }
    # field / ident / literals: nothing to flag
}

# ----------------------------------------------------------------------------
# The statement walk.
# ----------------------------------------------------------------------------

# t_side_effects — a statement-position method call can TAINT its
# receiver: `xs.push(untrusted)` makes every later read of xs untrusted.
fn t_side_effects(w: TWalker, e: int, env: TEnv) -> void {
    let ctx: Ctx = w.ctx
    if e < 0 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "method" {
        let op: str = sc_builtin_method_op(ctx, e)
        if op == "list.push" || op == "list.set" || op == "map.set"
        || op == "map.insert" {
            let mut p: str = ""
            let mut i: int = 0
            while i < n.args.len() {
                if p == "" {
                    p = t_either(w, n.args.get(i), env)
                }
                i = i + 1
            }
            if p != "" {
                let base: str = sc_root_name(ctx, n.left)
                if base != "" {
                    let cur: str = env.tainted.get_or(base, "")
                    if cur == "" {
                        env.tainted.set(base, p)
                    }
                }
            }
        }
        t_flag_expr(w, n.left, env)
        let mut j: int = 0
        while j < n.args.len() {
            t_flag_expr(w, n.args.get(j), env)
            j = j + 1
        }
    } else if n.kind == "call" {
        let mut k: int = 0
        while k < n.args.len() {
            t_flag_expr(w, n.args.get(k), env)
            k = k + 1
        }
    } else if n.kind == "qmark" {
        t_side_effects(w, n.left, env)
    }
}

# t_walk_match — the statement-form match: each arm binds the pattern
# names to the scrutinee's provenance, in its own branch env.
fn t_walk_match(w: TWalker, m: int, env: TEnv) -> void {
    let ctx: Ctx = w.ctx
    if m < 0 {
        return
    }
    let n: ExprN = ctx.exprs[m]
    if n.kind != "match" {
        return
    }
    t_flag_expr(w, n.left, env)
    let mut a: int = 0
    while a < n.args.len() {
        let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
        let aenv: TEnv = tenv_copy(env)
        let mut b: int = 0
        while b < arm.bindings.len() {
            if arm.bindings.get(b) != "_" {
                aenv.tainted.set(arm.bindings.get(b), t_prop(w, n.left, env, false))
                aenv.escaped.set(arm.bindings.get(b), t_prop(w, n.left, env, true))
            }
            b = b + 1
        }
        t_flag_expr(w, arm.body, aenv)
        t_side_effects(w, arm.body, aenv)
        a = a + 1
    }
}

# t_join_into — the if-join: a variable untrusted on EITHER path is
# untrusted (union); the first provenance seen wins.
fn t_join_into(env: TEnv, a: TEnv, b: TEnv) -> void {
    let atk: list[str] = a.tainted.keys()
    let mut i: int = 0
    while i < atk.len() {
        let nm: str = atk.get(i)
        let v: str = a.tainted.get_or(nm, "")
        if v != "" && env.tainted.get_or(nm, "") == "" {
            env.tainted.set(nm, v)
        }
        i = i + 1
    }
    let btk: list[str] = b.tainted.keys()
    let mut j: int = 0
    while j < btk.len() {
        let nm2: str = btk.get(j)
        let v2: str = b.tainted.get_or(nm2, "")
        if v2 != "" && env.tainted.get_or(nm2, "") == "" {
            env.tainted.set(nm2, v2)
        }
        j = j + 1
    }
    let aek: list[str] = a.escaped.keys()
    let mut k: int = 0
    while k < aek.len() {
        let nm3: str = aek.get(k)
        let v3: str = a.escaped.get_or(nm3, "")
        if v3 != "" && env.escaped.get_or(nm3, "") == "" {
            env.escaped.set(nm3, v3)
        }
        k = k + 1
    }
    let bek: list[str] = b.escaped.keys()
    let mut l: int = 0
    while l < bek.len() {
        let nm4: str = bek.get(l)
        let v4: str = b.escaped.get_or(nm4, "")
        if v4 != "" && env.escaped.get_or(nm4, "") == "" {
            env.escaped.set(nm4, v4)
        }
        l = l + 1
    }
}

fn t_walk_stmts(w: TWalker, stmts: list[int], env: TEnv) -> void {
    let ctx: Ctx = w.ctx
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "let" {
            t_flag_expr(w, s.value, env)
            env.tainted.set(s.name, t_prop(w, s.value, env, false))
            env.escaped.set(s.name, t_prop(w, s.value, env, true))
        } else if s.kind == "assign" {
            if s.target >= 0 {
                let t: ExprN = ctx.exprs[s.target]
                t_flag_expr(w, s.target, env)
                t_flag_expr(w, s.value, env)
                if t.kind == "ident" {
                    env.tainted.set(t.name, t_prop(w, s.value, env, false))
                    env.escaped.set(t.name, t_prop(w, s.value, env, true))
                } else if t.kind == "field" || t.kind == "index" {
                    let base: str = sc_root_name(ctx, s.target)
                    if base != "" {
                        let p: str = t_either(w, s.value, env)
                        if p != "" {
                            # pushing untrusted data into a container
                            # taints the container
                            let cur: str = env.tainted.get_or(base, "")
                            if cur == "" {
                                env.tainted.set(base, p)
                            }
                        }
                    }
                }
            }
        } else if s.kind == "expr" {
            if s.e >= 0 && ctx.exprs[s.e].kind == "match" {
                t_walk_match(w, s.e, env)
            } else {
                t_flag_expr(w, s.e, env)
                t_side_effects(w, s.e, env)
            }
        } else if s.kind == "return" {
            if s.value >= 0 {
                t_flag_expr(w, s.value, env)
                if t_prop(w, s.value, env, false) != "" {
                    w.ret_tainted = true
                }
            }
        } else if s.kind == "if" {
            t_flag_expr(w, s.cond, env)
            let then_env: TEnv = tenv_copy(env)
            t_walk_stmts(w, s.body, then_env)
            let else_env: TEnv = tenv_copy(env)
            t_walk_stmts(w, s.else_body, else_env)
            t_join_into(env, then_env, else_env)
        } else if s.kind == "while" {
            t_flag_expr(w, s.cond, env)
            # widening: two passes over the body
            t_walk_stmts(w, s.body, env)
            t_walk_stmts(w, s.body, env)
        } else if s.kind == "for" {
            t_flag_expr(w, s.iter, env)
            let is_range: bool = s.iter >= 0
            && ctx.exprs[s.iter].kind == "call"
            && ctx.exprs[s.iter].name == "range"
            && !ctx.exprs[s.iter].muser
            if is_range {
                env.tainted.set(s.name, "")
                env.escaped.set(s.name, "")
            } else {
                env.tainted.set(s.name, t_prop(w, s.iter, env, false))
                env.escaped.set(s.name, t_prop(w, s.iter, env, true))
            }
            t_walk_stmts(w, s.body, env)
            t_walk_stmts(w, s.body, env)
        } else if s.kind == "match" {
            t_walk_match(w, s.e, env)
        } else if s.kind == "break" || s.kind == "continue" || s.kind == "asm" {
            # nothing to walk
        } else {
            t_flag_expr(w, s.value, env)
            t_flag_expr(w, s.cond, env)
            t_flag_expr(w, s.iter, env)
            t_flag_expr(w, s.e, env)
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# The fixpoint.
# ----------------------------------------------------------------------------

# t_round — one fixpoint round: walk every fn with the current state.
# The walkers report findings with the CURRENT state and grow it with
# the flows they observe (monotone, so it terminates).
fn t_round(ctx: Ctx, state: TState) -> list[TWalker] {
    let walkers: list[TWalker] = []
    let keys: list[str] = ctx.fns.keys()
    let mut i: int = 0
    while i < keys.len() {
        let key: str = keys.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        let w: TWalker = t_walker_new(ctx, key, state)
        let env: TEnv = TEnv {
            tainted: map_new(), escaped: map_new()
        }
        let mut pi: int = 0
        while pi < f.params.len() {
            let pn: str = f.params.get(pi)
            if list_has_str(state.params.get_or(key, []), pn) {
                env.tainted.set(pn, "param:" + pn)
            } else {
                env.tainted.set(pn, "")
            }
            env.escaped.set(pn, "")
            pi = pi + 1
        }
        t_walk_stmts(w, f.body, env)
        walkers.push(w)
        if w.ret_tainted && !state.rets.get_or(key, false) {
            state.rets.set(key, true)
            state.changed = true
        }
        i = i + 1
    }
    return walkers
}

# analyze_ffi_taint — the fixpoint + the report assembly. Returns the
# per-fn reports keyed by fn (only fns with something to say appear).
fn analyze_ffi_taint(ctx: Ctx) -> map[str, FnFfiTaint] {
    let state: TState = t_state_new(ctx)
    let reports: map[str, FnFfiTaint] = map_new()
    # the flat flow store: (caller, callee, param, line) rows,
    # accumulating across rounds exactly as the .py's flows dict did
    let flow_callers: list[str] = []
    let flow_rows: list[Flow] = []
    let mut round: int = 0
    while round < 64 {
        state.changed = false
        let walkers: list[TWalker] = t_round(ctx, state)
        let mut wi: int = 0
        while wi < walkers.len() {
            let w: TWalker = walkers.get(wi)
            if !reports.has(w.fn_key) {
                reports.set(w.fn_key, fn_ffi_taint_new(w.fn_key))
            }
            let rep: FnFfiTaint = reports.get_or(w.fn_key, fn_ffi_taint_new(w.fn_key))
            rep.findings = t_copy_findings(w.findings)
            let mut fi: int = 0
            while fi < w.flows.len() {
                flow_callers.push(w.fn_key)
                flow_rows.push(w.flows.get(fi))
                fi = fi + 1
            }
            wi = wi + 1
        }
        if !state.changed {
            break
        }
        round = round + 1
    }
    # assembly: incoming flows per callee, sorted by (line, caller,
    # param), deduped per (caller, param) — the first line wins
    let out: map[str, FnFfiTaint] = map_new()
    let keys: list[str] = ctx.fns.keys()
    let mut ki: int = 0
    while ki < keys.len() {
        let key: str = keys.get(ki)
        let rep: FnFfiTaint = reports.get_or(key, fn_ffi_taint_new(key))
        rep.tainted_params = sort_str_list(state.params.get_or(key, []))
        let rows: list[Flow] = []
        let row_callers: list[str] = []
        let mut ri: int = 0
        while ri < flow_rows.len() {
            if flow_rows.get(ri).callee == key {
                rows.push(flow_rows.get(ri))
                row_callers.push(flow_callers.get(ri))
            }
            ri = ri + 1
        }
        let mut a: int = 0
        while a < rows.len() {
            let mut b: int = a + 1
            while b < rows.len() {
                let fa: Flow = rows.get(a)
                let fb: Flow = rows.get(b)
                let mut swap: bool = false
                if fb.line < fa.line {
                    swap = true
                } else if fb.line == fa.line && row_callers.get(b) < row_callers.get(a) {
                    swap = true
                } else if fb.line == fa.line && row_callers.get(b) == row_callers.get(a)
                && fb.param < fa.param {
                    swap = true
                }
                if swap {
                    let tf: Flow = rows.get(a)
                    rows.set(a, rows.get(b))
                    rows.set(b, tf)
                    let tc: str = row_callers.get(a)
                    row_callers.set(a, row_callers.get(b))
                    row_callers.set(b, tc)
                }
                b = b + 1
            }
            a = a + 1
        }
        let seen_caller: list[str] = []
        let seen_param: list[str] = []
        rep.incoming = []
        rep.incoming_callers = []
        let mut si: int = 0
        while si < rows.len() {
            let f: Flow = rows.get(si)
            let mut dup: bool = false
            let mut qi: int = 0
            while qi < seen_caller.len() {
                if seen_caller.get(qi) == row_callers.get(si)
                && seen_param.get(qi) == f.param {
                    dup = true
                }
                qi = qi + 1
            }
            if !dup {
                seen_caller.push(row_callers.get(si))
                seen_param.push(f.param)
                rep.incoming.push(f)
                rep.incoming_callers.push(row_callers.get(si))
            }
            si = si + 1
        }
        if rep.tainted_params.len() > 0 || rep.incoming.len() > 0
        || rep.findings.len() > 0 {
            out.set(key, rep)
        }
        ki = ki + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# The --taint report (the .py's ffi_taint_report, bytes for bytes).
# ----------------------------------------------------------------------------

fn ffi_taint_report(ctx: Ctx) -> void uses IO {
    let reports: map[str, FnFfiTaint] = analyze_ffi_taint(ctx)
    # ---- the census ----
    # every extern declaration, in declaration order
    let boundaries: list[str] = []
    let mut bi: int = 0
    while bi < ctx.fn_order.len() {
        let k: str = ctx.fn_order.get(bi)
        if ctx.fns.has(k) && ctx.fns.get_or(k, dummy_fn()).is_extern {
            boundaries.push(k)
        }
        bi = bi + 1
    }
    if boundaries.len() == 0 {
        println("    (no extern declarations — no FFI boundary to audit)")
    } else {
        let mut i: int = 0
        while i < boundaries.len() {
            let f: FnInfo = ctx.fns.get_or(boundaries.get(i), dummy_fn())
            let pps: list[str] = []
            let mut pi: int = 0
            while pi < f.params.len() {
                pps.push(f.params.get(pi) + ": " + f.ptypes.get(pi))
                pi = pi + 1
            }
            let sig: str = f.name + "(" + pv_join_str_list(pps, ", ") + ") -> " + f.ret
            if f.attr_taint_source {
                println("    " + sig + "  [SOURCE #[taint_source] — every call result is tainted[" + f.ret + "]]")
            } else if f.attr_taint_sinks != "" {
                let sinks: list[str] = []
                push_split(sinks, f.attr_taint_sinks)
                println("    " + sig + "  [SINK #[taint_sink(" + pv_join_str_list(sinks, ", ") + ")]]")
            } else {
                println("    " + sig + "  [unmarked — returns TRUSTED by the taint lattice]")
            }
            i = i + 1
        }
    }
    let mut c_src: int = 0
    let mut c_sink: int = 0
    let mut c_unm: int = 0
    let mut ci: int = 0
    while ci < boundaries.len() {
        let f2: FnInfo = ctx.fns.get_or(boundaries.get(ci), dummy_fn())
        if f2.attr_taint_source {
            c_src = c_src + 1
        } else if f2.attr_taint_sinks != "" {
            c_sink = c_sink + 1
        } else {
            c_unm = c_unm + 1
        }
        ci = ci + 1
    }
    println("    boundary census: " + c_src.to_str() + " source(s), " + c_sink.to_str() + " sink(s), " + c_unm.to_str() + " unmarked")
    # ---- the flows ----
    # involved: sorted by fn_key
    let mut involved: list[FnFfiTaint] = []
    let rkeys: list[str] = reports.keys()
    let mut rk: int = 0
    while rk < rkeys.len() {
        let rep: FnFfiTaint = reports.get_or(rkeys.get(rk), fn_ffi_taint_new(""))
        let mut placed: bool = false
        let res: list[FnFfiTaint] = []
        let mut si: int = 0
        while si < involved.len() {
            let o: FnFfiTaint = involved.get(si)
            if !placed && rep.fn_key < o.fn_key {
                res.push(rep)
                res.push(o)
                placed = true
            } else {
                res.push(o)
            }
            si = si + 1
        }
        if !placed {
            res.push(rep)
        }
        involved = res
        rk = rk + 1
    }
    let mut n_src: int = 0
    let mut n_unwrap: int = 0
    let mut n_sink: int = 0
    let mut n_san: int = 0
    let mut ii: int = 0
    while ii < involved.len() {
        let rep2: FnFfiTaint = involved.get(ii)
        println("  " + rep2.fn_key + ":")
        if rep2.tainted_params.len() > 0 {
            println("    untrusted params (by propagation): " + pv_join_str_list(rep2.tainted_params, ", "))
        }
        let mut ic: int = 0
        while ic < rep2.incoming.len() {
            let f3: Flow = rep2.incoming.get(ic)
            let caller: str = rep2.incoming_callers.get(ic)
            println("    incoming: '" + f3.param + "' passes untrusted data as '" + f3.param + "' from " + caller + " (line " + f3.line.to_str() + ")")
            ic = ic + 1
        }
        let mut fi: int = 0
        while fi < rep2.findings.len() {
            let f4: TFinding = rep2.findings.get(fi)
            if f4.kind == "source" {
                n_src = n_src + 1
            } else if f4.kind == "unwrap" {
                n_unwrap = n_unwrap + 1
            } else if f4.kind == "sink-reach" {
                n_sink = n_sink + 1
            } else if f4.kind == "sanitised" {
                n_san = n_san + 1
            }
            println("    line " + f4.line.to_str() + ": " + pv_upper(f4.kind) + " — `" + f4.text + "` (from " + f4.prov + ")")
            fi = fi + 1
        }
        if rep2.findings.len() == 0 && rep2.tainted_params.len() == 0 {
            println("    CLEAN: no untrusted data enters or escapes here")
        }
        ii = ii + 1
    }
    println("  FFI TAINT TOTAL: " + n_src.to_str() + " source sites, " + n_unwrap.to_str() + " unwrap escapes, " + n_sink.to_str() + " sink-reaching flows, " + n_san.to_str() + " sanitised cuts")
}

# ============================================================================
# Part 10 — the --suggest-invariants scanner (the .py's
# suggest_invariants): const-bound for loops get exact bounds, while
# loops get their condition as a candidate invariant text, both list
# the variables mutated in the body. AST only — no solver.
# ============================================================================

# si_scan_stmts — walk one statement list, printing a suggestion per
# loop; returns the number of loops found (the .py's nonlocal `found`).
fn si_scan_stmts(ctx: Ctx, stmts: list[int], fn_key: str) -> int uses IO {
    let mut found: int = 0
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "for" {
            let it: int = s.iter
            let is_range: bool = it >= 0 && ctx.exprs[it].kind == "call"
            && ctx.exprs[it].name == "range" && !ctx.exprs[it].muser
            if is_range {
                let itn: ExprN = ctx.exprs[it]
                if itn.args.len() == 2 {
                    let a0: int = itn.args.get(0)
                    let a1: int = itn.args.get(1)
                    if a0 >= 0 && a1 >= 0 && ctx.exprs[a0].kind == "int"
                    && ctx.exprs[a1].kind == "int" {
                        let lo: int = ctx.exprs[a0].ival
                        let hi: int = ctx.exprs[a1].ival
                        println("    " + fn_key + ": for " + s.name + " in range(" + lo.to_str() + ", " + hi.to_str() + ")")
                        println("        suggest: " + lo.to_str() + " <= " + s.name + " < " + hi.to_str() + " (loop variable is monotonic)")
                        found = found + 1
                        found = found + si_scan_stmts(ctx, s.body, fn_key)
                        i = i + 1
                        continue
                    }
                }
            }
            println("    " + fn_key + ": for " + s.name + " in <non-const iterable>")
            println("        suggest: 0 <= " + s.name + " < len(iterable_at_entry)")
            found = found + 1
        } else if s.kind == "while" {
            let cond_txt: str = expr_to_text(ctx, s.cond)
            println("    " + fn_key + ": while " + cond_txt)
            println("        suggest: the condition itself holds at the top of every iteration")
            found = found + 1
        }
        found = found + si_scan_stmts(ctx, s.body, fn_key)
        found = found + si_scan_stmts(ctx, s.else_body, fn_key)
        i = i + 1
    }
    return found
}

fn suggest_invariants(ctx: Ctx) -> void uses IO {
    println("  Loop invariant suggestions:")
    let mut found: int = 0
    let keys: list[str] = ctx.fns.keys()
    let mut ki: int = 0
    while ki < keys.len() {
        let key: str = keys.get(ki)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        found = found + si_scan_stmts(ctx, f.body, key)
        ki = ki + 1
    }
    if found == 0 {
        println("    (no loops found)")
    }
}

# ============================================================================
# Part 11 — the CLI dispatch (the .py's main), with the probe-child
# load discipline: hl_check panics on a program that does not check and
# Halis has no exceptions, so the front-end rides in a child re-exec'd
# as `hlprove --probe-load <path>`; the parent maps a dead child to the
# .py's clean "compile error:" refusal, and only then loads in process
# (deterministic on the same bytes — the hllint fixer's net).
# ============================================================================

# pv_args_has(argv, flag) — membership in argv[1..] (the .py's
# sys.argv[1:] membership tests).
fn pv_args_has(argv: list[str], flag: str) -> bool {
    let mut i: int = 1
    while i < argv.len() {
        if argv.get(i) == flag {
            return true
        }
        i = i + 1
    }
    return false
}

fn main() -> int uses IO, Fs, Proc, Args, Clock {
    let argv: list[str] = args()
    # The probe child re-exec: --probe-load <path> is the real load +
    # check, panics allowed (the parent maps a non-zero exit to the
    # clean refusal).
    if argv.len() > 1 && argv.get(1) == "--probe-load" {
        if argv.len() < 3 {
            eprintln("hlprove: --probe-load needs a path")
            return 2
        }
        let cctx: Ctx = hl_load_crate(argv.get(2))
        hl_check(cctx)
        return 0
    }
    # Stage 99: one backend decides per run. A run asking for BOTH is a
    # caller error — silently picking one would make the report's
    # solver column a coin flip.
    let want_cvc5: bool = pv_args_has(argv, "--cvc5")
    let want_z3: bool = pv_args_has(argv, "--z3")
    if want_cvc5 && want_z3 {
        eprintln("hlprove: --z3 and --cvc5 name different backends — pick one")
        return 2
    }
    # --z3 / --cvc5 imply --smt (deep-scan-10: --z3 without --smt
    # silently did nothing).
    let want_smt: bool = pv_args_has(argv, "--smt") || want_z3 || want_cvc5
    let want_inv: bool = pv_args_has(argv, "--suggest-invariants")
    let want_infer: bool = pv_args_has(argv, "--infer-invariants")
    let want_shapes: bool = pv_args_has(argv, "--shapes")
    let want_side: bool = pv_args_has(argv, "--sidechannel")
    let want_ct: bool = pv_args_has(argv, "--consttime")
    let want_taint: bool = pv_args_has(argv, "--taint")
    # the path: the first non-flag argument (--fast and friends are
    # consumed as non-path args, exactly as the .py filtered them)
    let mut path: str = ""
    let mut pi: int = 1
    while pi < argv.len() {
        let a: str = argv.get(pi)
        if !a.starts_with("--") {
            path = a
            break
        }
        pi = pi + 1
    }
    if path == "" {
        eprint(usage_doc())
        return 2
    }
    # the load, behind the probe child (the .py's try/except HLError)
    let selfp: str = self_path()
    let probe: RunRes = run_child([selfp, "--probe-load", path])
    if !probe.spawned || probe.code != 0 {
        eprintln("compile error: " + first_err_line(probe.err))
        return 1
    }
    # the probe proved the bytes check — safe to load in process
    let ctx: Ctx = hl_load_crate(path)
    hl_check(ctx)

    println("hlprove — Halis proof report for " + path)
    println("")
    proof_report(ctx)

    if want_smt {
        let out_dir: str = pv_out_dir(path)
        let mut solver_label: str = "z3"
        if want_cvc5 {
            solver_label = "cvc5"
        }
        println("")
        println("  SMT-LIB2 bridge (" + solver_label + "-ready, QF_LIA; str lengths abstracted to Int):")
        let files: list[str] = gen_smt(ctx, out_dir)
        let mut fi: int = 0
        while fi < files.len() {
            println("    " + pad_left(files.get(fi), 28) + " -> " + files.get(fi + 1))
            fi = fi + 2
        }
        if want_z3 {
            println("")
            run_solver_bridge(files, "z3")
        } else if want_cvc5 {
            println("")
            run_solver_bridge(files, "cvc5")
        }
    }

    if want_inv {
        println("")
        suggest_invariants(ctx)
    }

    if want_infer {
        println("")
        let mut solver_name: str = "z3"
        let mut d: Decider = make_z3_decider()
        if want_cvc5 {
            solver_name = "cvc5"
            d = make_cvc5_decider()
        }
        println("  SMT-based loop-invariant inference (Stage 97; entry facts + transition relation + template candidates, " + solver_name + "-checked):")
        let out_dir2: str = pv_out_dir(path)
        let packed: int = infer_invariants_report(ctx, want_smt, out_dir2, d, solver_name)
        let accepted: int = packed / 100000
        let rejected: int = packed % 100000
        println("  INFERENCE TOTAL: " + accepted.to_str() + " invariants verified, " + rejected.to_str() + " candidates rejected")
    }

    if want_side {
        println("")
        println("  Side-channel audit (Stage 101 — the #[secrets(...)] parameters are the roots):")
        sidechannel_report(ctx)
    }

    let mut ct_violated: int = 0
    if want_ct {
        println("")
        println("  Constant-time verification (Stage 102 — the #[ct] claims are proven, not trusted):")
        ct_violated = consttime_report(ctx)
    }

    if want_taint {
        println("")
        println("  FFI taint-flow report (Stage 109 — #[taint_source] externs and #[taint_sink(...)] parameters, plus the escape-hatch audit):")
        ffi_taint_report(ctx)
    }

    if want_shapes {
        println("")
        let mut solver_name2: str = "z3"
        let mut d2: Decider = make_z3_decider()
        if want_cvc5 {
            solver_name2 = "cvc5"
            d2 = make_cvc5_decider()
        }
        if !d2.ok {
            println("  (Stage 100 — no " + solver_name2 + " backend: loop shapes are reported as candidates, never proofs)")
        } else {
            println("  (Stage 100 — cursor-loop obligations decided by " + solver_name2 + ")")
        }
        let out_dir3: str = pv_out_dir(path)
        shapes_report(ctx, want_smt, out_dir3, d2, solver_name2)
    }
    # Stage 102: a violated claim is a failed verification — the run
    # exits 1 after the full report is on the screen (the analysis
    # modes stay exit-0 either way; that difference is the point).
    if ct_violated > 0 {
        return 1
    }
    return 0
}
