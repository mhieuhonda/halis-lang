fn rv_f_duplicated() -> str {
    return "duplicated-site"
}

# The algebraic identity certificates the replay accepts for
# `safe_overflow` annotations (on top of an interval proof). Adding
# zero / multiplying by zero or one cannot overflow REGARDLESS of the
# operand's bounds — the result is the other operand, already a legal
# int64. Pinned by name; any annotation outside (interval proof | this
# whitelist) is FORGED.
fn rv_alg_identities() -> list[str] {
    let out: list[str] = []
    out.push("alg:add-zero-right")
    out.push("alg:add-zero-left")
    out.push("alg:sub-zero-right")
    out.push("alg:mul-zero-right")
    out.push("alg:mul-zero-left")
    out.push("alg:mul-one-right")
    out.push("alg:mul-one-left")
    return out
}

fn rv_max_rounds() -> int {
    return 32
}

# ============================================================================
# The JDoc family — hls-sign's byte-precise JSON model (canonical
# dumps: sorted keys, no whitespace, ensure_ascii escaping).
# ============================================================================

struct JDoc {
    kind: str, # "null" | "bool" | "int" | "str" | "arr" | "obj"
    sval: str,
    ival: int,
    bval: bool,
    arr: list[JDoc],
    keys: list[str],
    vals: list[JDoc]
}

fn jd_null() -> JDoc {
    return JDoc {
        kind: "null", sval: "", ival: 0, bval: false, arr: [],
        keys: [], vals: []
    }
}

fn jd_bool(v: bool) -> JDoc {
    return JDoc {
        kind: "bool", sval: "", ival: 0, bval: v, arr: [],
        keys: [], vals: []
    }
}

fn jd_int(v: int) -> JDoc {
    return JDoc {
        kind: "int", sval: "", ival: v, bval: false, arr: [],
        keys: [], vals: []
    }
}

fn jd_str(v: str) -> JDoc {
    return JDoc {
        kind: "str", sval: v, ival: 0, bval: false, arr: [],
        keys: [], vals: []
    }
}

fn jd_arr(items: list[JDoc]) -> JDoc {
    return JDoc {
        kind: "arr", sval: "", ival: 0, bval: false, arr: items,
        keys: [], vals: []
    }
}

fn jd_obj() -> JDoc {
    return JDoc {
        kind: "obj", sval: "", ival: 0, bval: false, arr: [],
        keys: [], vals: []
    }
}

# obj_set(doc, key, val) — set/replace one key in an object doc.
fn obj_set(doc: JDoc, key: str, val: JDoc) -> void {
    let mut i: int = 0
    while i < doc.keys.len() {
        if doc.keys.get(i) == key {
            doc.vals.set(i, val)
            return
        }
        i = i + 1
    }
    doc.keys.push(key)
    doc.vals.push(val)
}

fn obj_get(doc: JDoc, key: str) -> JDoc {
    let mut i: int = 0
    while i < doc.keys.len() {
        if doc.keys.get(i) == key {
            return doc.vals.get(i)
        }
        i = i + 1
    }
    return jd_null()
}

fn obj_get_str(doc: JDoc, key: str) -> str {
    let v: JDoc = obj_get(doc, key)
    if v.kind == "str" {
        return v.sval
    }
    return ""
}

fn obj_get_int(doc: JDoc, key: str) -> int {
    let v: JDoc = obj_get(doc, key)
    if v.kind == "int" {
        return v.ival
    }
    return 0
}

fn obj_get_bool(doc: JDoc, key: str) -> bool {
    let v: JDoc = obj_get(doc, key)
    if v.kind == "bool" {
        return v.bval
    }
    return false
}

# rv_hex4(c) — four lowercase hex digits.
fn rv_hex4(c: int) -> str {
    let digits: str = "0123456789abcdef"
    let mut v: int = c
    let mut i: int = 0
    let parts: list[str] = []
    parts.push("")
    parts.push("")
    parts.push("")
    parts.push("")
    while i < 4 {
        let d: int = v % 16
        parts.set(3 - i, digits.slice(d, d + 1))
        v = v / 16
        i = i + 1
    }
    return parts.get(0) + parts.get(1) + parts.get(2) + parts.get(3)
}

# rv_utf8_at(s, i) — the codepoint at i (len 1..4); [-1, -1] on invalid.
fn rv_utf8_at(s: str, i: int) -> list[int] {
    let n: int = s.len()
    let b0: int = s.byte_at(i)
    if b0 < 128 {
        return[b0, 1]
    }
    if b0 >= 192 && b0 < 224 && i + 1 < n {
        let b1: int = s.byte_at(i + 1)
        if b1 >= 128 && b1 < 192 {
            return[(b0 - 192) * 64 + (b1 - 128), 2]
        }
        return[-1, -1]
    }
    if b0 >= 224 && b0 < 240 && i + 2 < n {
        let b1: int = s.byte_at(i + 1)
        let b2: int = s.byte_at(i + 2)
        if b1 >= 128 && b1 < 192 && b2 >= 128 && b2 < 192 {
            return[(b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128), 3]
        }
        return[-1, -1]
    }
    if b0 >= 240 && b0 < 248 && i + 3 < n {
        let b1: int = s.byte_at(i + 1)
        let b2: int = s.byte_at(i + 2)
        let b3: int = s.byte_at(i + 3)
        if b1 >= 128 && b1 < 192 && b2 >= 128 && b2 < 192
        && b3 >= 128 && b3 < 192 {
            return[(b0 - 240) * 262144 + (b1 - 128) * 4096
            + (b2 - 128) * 64 + (b3 - 128), 4]
        }
        return[-1, -1]
    }
    return[-1, -1]
}

# rv_py_json_escape(s) — Python's ensure_ascii string body.
fn rv_py_json_escape(s: str) -> str {
    let mut out: str = ""
    let n: int = s.len()
    let mut i: int = 0
    while i < n {
        let c: int = s.byte_at(i)
        if c == 34 {
            out = out + "\\\""
            i = i + 1
            continue
        }
        if c == 92 {
            out = out + "\\\\"
            i = i + 1
            continue
        }
        if c == 8 {
            out = out + "\\b"
            i = i + 1
            continue
        }
        if c == 9 {
            out = out + "\\t"
            i = i + 1
            continue
        }
        if c == 10 {
            out = out + "\\n"
            i = i + 1
            continue
        }
        if c == 12 {
            out = out + "\\f"
            i = i + 1
            continue
        }
        if c == 13 {
            out = out + "\\r"
            i = i + 1
            continue
        }
        if c < 32 {
            out = out + "\\u" + rv_hex4(c)
            i = i + 1
            continue
        }
        if c < 127 {
            out = out + s.slice(i, i + 1)
            i = i + 1
            continue
        }
        let cp: list[int] = rv_utf8_at(s, i)
        if cp.get(0) < 0 {
            out = out + s.slice(i, i + 1)
            i = i + 1
            continue
        }
        if cp.get(0) < 65536 {
            out = out + "\\u" + rv_hex4(cp.get(0))
        } else {
            let v: int = cp.get(0) - 65536
            let hi: int = 55296 + v / 1024
            let lo: int = 56320 + v % 1024
            out = out + "\\u" + rv_hex4(hi) + "\\u" + rv_hex4(lo)
        }
        i = i + cp.get(1)
    }
    return out
}

fn rv_jd_scalar_text(d: JDoc) -> str {
    if d.kind == "null" {
        return "null"
    }
    if d.kind == "bool" {
        if d.bval {
            return "true"
        }
        return "false"
    }
    if d.kind == "int" {
        return d.ival.to_str()
    }
    return "\"" + rv_py_json_escape(d.sval) + "\""
}

# rv_jd_sorted_order(d) — the key indices in sorted-key order.
fn rv_jd_sorted_order(d: JDoc) -> list[int] {
    let order: list[int] = []
    let mut i: int = 0
    while i < d.keys.len() {
        order.push(i)
        i = i + 1
    }
    let mut a: int = 0
    while a < order.len() {
        let mut b: int = a + 1
        while b < order.len() {
            if d.keys.get(order.get(b)) < d.keys.get(order.get(a)) {
                let t: int = order.get(a)
                order.set(a, order.get(b))
                order.set(b, t)
            }
            b = b + 1
        }
        a = a + 1
    }
    return order
}

# rv_py_json_dump_at(d, indent, pretty) — the recursive serializer.
# pretty is unused here (the tool only needs the canonical form), but
# the shape stays the hls-sign family's.
fn rv_py_json_dump_at(d: JDoc, indent: int, pretty: bool) -> str {
    if d.kind == "arr" {
        if d.arr.len() == 0 {
            return "[]"
        }
        let mut out2: str = "["
        let mut j: int = 0
        while j < d.arr.len() {
            out2 = out2 + rv_py_json_dump_at(d.arr.get(j), indent, false)
            if j + 1 < d.arr.len() {
                out2 = out2 + ","
            }
            j = j + 1
        }
        return out2 + "]"
    }
    if d.kind == "obj" {
        if d.keys.len() == 0 {
            return "{}"
        }
        let order: list[int] = rv_jd_sorted_order(d)
        let mut out2: str = "{"
        let mut j2: int = 0
        while j2 < order.len() {
            let idx2: int = order.get(j2)
            out2 = out2 + "\"" + rv_py_json_escape(d.keys.get(idx2))
            + "\":" + rv_py_json_dump_at(d.vals.get(idx2), indent, false)
            if j2 + 1 < order.len() {
                out2 = out2 + ","
            }
            j2 = j2 + 1
        }
        return out2 + "}"
    }
    return rv_jd_scalar_text(d)
}

# rv_canonical_json(d) — json.dumps(sort_keys=True, separators=(",", ":")).
fn rv_canonical_json(d: JDoc) -> str {
    return rv_py_json_dump_at(d, 0, false)
}

# ============================================================================
# Small shared helpers.
# ============================================================================

# rv_sort_strs(xs) — a stable-enough selection sort of strings.
fn rv_sort_strs(xs: list[str]) -> list[str] {
    let out: list[str] = []
    let mut n: int = 0
    while n < xs.len() {
        out.push(xs.get(n))
        n = n + 1
    }
    let mut i: int = 0
    while i < out.len() {
        let mut min: int = i
        let mut j: int = i + 1
        while j < out.len() {
            if out.get(j) < out.get(min) {
                min = j
            }
            j = j + 1
        }
        if min != i {
            let tmp: str = out.get(i)
            out.set(i, out.get(min))
            out.set(min, tmp)
        }
        i = i + 1
    }
    return out
}

# rv_has(xs, x) — list membership.
fn rv_has(xs: list[str], x: str) -> bool {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) == x {
            return true
        }
        i = i + 1
    }
    return false
}

# rv_str_int(s) — decimal parse (non-negative; -1 on anything else),
# proof.hls's str_to_int_simple law.
fn rv_str_int(s: str) -> int {
    if s.len() == 0 {
        return -1
    }
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c < 48 || c > 57 {
            return -1
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

# ============================================================================
# The HLIR layer — the retired tools/ir/__init__.py, ported off the
# dict-AST onto structured instructions (the same block shapes, temp
# naming (t1..), binding naming (v_<name>), operand tags and ty/safe_
# overflow stamps the Python years carried; hlemit's --emit ir printer
# prints this exact shape).
# ============================================================================

# One operand: tag "lit" (a literal, lty int/bool/str/float/null) |
# "var" (sval = SSA name) | "name" | "op" | "label" | "fname" | "type".
struct RVArg {
    tag: str,
    lty: str,
    sval: str,
    ival: int,
    bval: bool,
    fval: float
}

fn rv_arg_var(name: str) -> RVArg {
    return RVArg {
        tag: "var", lty: "", sval: name, ival: 0, bval: false, fval: 0.0
    }
}

fn rv_arg_lit_int(v: int) -> RVArg {
    return RVArg {
        tag: "lit", lty: "int", sval: "", ival: v, bval: false, fval: 0.0
    }
}

fn rv_arg_lit_bool(v: bool) -> RVArg {
    return RVArg {
        tag: "lit", lty: "bool", sval: "", ival: 0, bval: v, fval: 0.0
    }
}

fn rv_arg_lit_str(v: str) -> RVArg {
    return RVArg {
        tag: "lit", lty: "str", sval: v, ival: 0, bval: false, fval: 0.0
    }
}

fn rv_arg_lit_float(v: float) -> RVArg {
    return RVArg {
        tag: "lit", lty: "float", sval: "", ival: 0, bval: false, fval: v
    }
}

fn rv_arg_lit_null() -> RVArg {
    return RVArg {
        tag: "lit", lty: "null", sval: "", ival: 0, bval: false, fval: 0.0
    }
}

fn rv_arg_op(op: str) -> RVArg {
    return RVArg {
        tag: "op", lty: "", sval: op, ival: 0, bval: false, fval: 0.0
    }
}

fn rv_arg_name(name: str) -> RVArg {
    return RVArg {
        tag: "name", lty: "", sval: name, ival: 0, bval: false, fval: 0.0
    }
}

fn rv_arg_label(name: str) -> RVArg {
    return RVArg {
        tag: "label", lty: "", sval: name, ival: 0, bval: false, fval: 0.0
    }
}

fn rv_arg_fname(name: str) -> RVArg {
    return RVArg {
        tag: "fname", lty: "", sval: name, ival: 0, bval: false, fval: 0.0
    }
}

fn rv_arg_type(name: str) -> RVArg {
    return RVArg {
        tag: "type", lty: "", sval: name, ival: 0, bval: false, fval: 0.0
    }
}

fn rv_arg_text(text: str) -> RVArg {
    return RVArg {
        tag: "text", lty: "", sval: text, ival: 0, bval: false, fval: 0.0
    }
}

# One instruction. dest "" = no SSA dest. ty = the checker-annotated
# result type stamp (attrs["ty"]); safe_overflow = the -O fast
# annotation the optimiser grants.
struct RVIns {
    dest: str,
    op: str,
    args: list[RVArg],
    line: int,
    ty: str,
    safe_overflow: bool,
    rpred: str
}

fn rv_ins(dest: str, op: str, args: list[RVArg], line: int, ty: str) -> RVIns {
    return RVIns {
        dest: dest, op: op, args: args, line: line, ty: ty,
        safe_overflow: false, rpred: ""
    }
}

# rv_ins_r — a load/store carrying a Stage 98 refinement guard (the
# pred TEXT, resolved through ctx.rpreds at analysis time — the same
# text->expr map the checker's own param_preds use). The guard is a
# runtime fact boundary: uses must read through it, so copy
# propagation never rewrites past a refined load.
fn rv_ins_r(dest: str, op: str, args: list[RVArg], line: int, ty: str,
rpred: str) -> RVIns {
    return RVIns {
        dest: dest, op: op, args: args, line: line, ty: ty,
        safe_overflow: false, rpred: rpred
    }
}

# A block: instructions + a terminator (has_term false = none — an
# integrity finding, never built by the lowering).
struct RVBlock {
    name: str,
    instrs: list[RVIns],
    term: RVIns,
    has_term: bool
}

fn rv_block(name: str) -> RVBlock {
    let none_ins: RVIns = rv_ins("", "", [], 0, "")
    return RVBlock {
        name: name, instrs: [], term: none_ins, has_term: false
    }
}

struct RVFn {
    name: str,
    params: list[str], # param names (the SSA spelling is v_<name>)
    ret: str,
    effects: list[str],
    blocks: list[RVBlock]
}

fn rv_fn(name: str, params: list[str], ret: str, effects: list[str]) -> RVFn {
    return RVFn {
        name: name, params: params, ret: ret, effects: effects, blocks: []
    }
}

struct RVMod {
    order: list[str], # fn definition order (deterministic iteration)
    fns: map[str, RVFn]
}

fn rv_mod() -> RVMod {
    let m: map[str, RVFn] = map_new()
    return RVMod {
        order: [], fns: m
    }
}

fn rv_dummy_fn_ir() -> RVFn {
    return rv_fn("", [], "void", [])
}

# ----------------------------------------------------------------------------
# The builder: checked Ctx -> HLIR (the retired IRBuilder, verbatim
# laws — deep-scan-5's unreachable-statement skip, deep-scan-24's
# for_inc continue target, BUG-SC-IR-1's unprefixed store target).
# Refusals set b.err instead of panicking: a construct the layer cannot
# represent is a clean compile error, never a crash.
# ----------------------------------------------------------------------------

struct RVBuild {
    ctx: Ctx,
    mod: RVMod,
    tmp: int,
    block_counter: int,
    loop_cont: list[str],
    loop_brk: list[str],
    cur: int, # open block index in the current fn
    cur_key: str,
    err: str
}

fn rv_builder(ctx: Ctx) -> RVBuild {
    let m: RVMod = rv_mod()
    return RVBuild {
        ctx: ctx, mod: m, tmp: 0, block_counter: 0, loop_cont: [],
        loop_brk: [], cur: -1, cur_key: "", err: ""
    }
}

fn rv_fresh(b: RVBuild) -> str {
    b.tmp = b.tmp + 1
    return "t" + b.tmp.to_str()
}

# rv_create(b, prefix) — create the next block WITHOUT opening it.
fn rv_create(b: RVBuild, prefix: str) -> str {
    b.block_counter = b.block_counter + 1
    let name: str = prefix + b.block_counter.to_str()
    let f: RVFn = b.mod.fns.get_or(b.cur_key, rv_dummy_fn_ir())
    f.blocks.push(rv_block(name))
    return name
}

# rv_open(b, name) — (re)open a block by name.
fn rv_open(b: RVBuild, name: str) -> void {
    let f: RVFn = b.mod.fns.get_or(b.cur_key, rv_dummy_fn_ir())
    let mut i: int = 0
    while i < f.blocks.len() {
        if f.blocks.get(i).name == name {
            b.cur = i
            return
        }
        i = i + 1
    }
}

# rv_emit(b, dest, op, args, line, ty) — one instruction into the
# current block; fresh temp when dest is "".
fn rv_emit(b: RVBuild, dest: str, op: str, args: list[RVArg], line: int,
ty: str) -> str {
    let mut d: str = rv_fresh(b)
    if dest != "" {
        d = dest
    }
    let f: RVFn = b.mod.fns.get_or(b.cur_key, rv_dummy_fn_ir())
    f.blocks.get(b.cur).instrs.push(rv_ins(d, op, args, line, ty))
    return d
}

# rv_emit_r — rv_emit with a refinement-guard stamp (Stage 98 lets /
# assigns read by the replay through the one-definition refine
# machinery — the .py-era IR had no refinements to carry).
fn rv_emit_r(b: RVBuild, dest: str, op: str, args: list[RVArg], line: int,
ty: str, rpred: str) -> str {
    let mut d: str = rv_fresh(b)
    if dest != "" {
        d = dest
    }
    let f: RVFn = b.mod.fns.get_or(b.cur_key, rv_dummy_fn_ir())
    f.blocks.get(b.cur).instrs.push(rv_ins_r(d, op, args, line, ty, rpred))
    return d
}

# rv_term(b, op, args, line) — terminate the current block.
fn rv_term(b: RVBuild, op: str, args: list[RVArg], line: int) -> void {
    let f: RVFn = b.mod.fns.get_or(b.cur_key, rv_dummy_fn_ir())
    let blk: RVBlock = f.blocks.get(b.cur)
    blk.term = rv_ins("", op, args, line, "")
    blk.has_term = true
}

# rv_terminated(b) — the current block already has a terminator.
fn rv_terminated(b: RVBuild) -> bool {
    let f: RVFn = b.mod.fns.get_or(b.cur_key, rv_dummy_fn_ir())
    if b.cur < 0 || b.cur >= f.blocks.len() {
        return false
    }
    return f.blocks.get(b.cur).has_term
}

# rv_build_fn(b, key, f) — one function: entry block, the body, the
# implicit terminator law (void returns, non-void panics).
fn rv_build_fn(b: RVBuild, key: str, f: FnInfo) -> void {
    let params: list[str] = []
    let mut p: int = 0
    while p < f.params.len() {
        params.push(f.params.get(p))
        p = p + 1
    }
    let irf: RVFn = rv_fn(key, params, f.ret, f.effects)
    irf.blocks.push(rv_block("entry"))
    b.mod.fns.set(key, irf)
    b.mod.order.push(key)
    b.cur_key = key
    b.cur = 0
    b.loop_cont = []
    b.loop_brk = []
    b.tmp = 0
    b.block_counter = 0
    let mut i: int = 0
    while i < f.body.len() {
        rv_stmt(b, f.body.get(i))
        if b.err != "" {
            return
        }
        i = i + 1
    }
    if !rv_terminated(b) {
        if f.ret == "void" {
            rv_term(b, "return", [], 0)
        } else {
            rv_term(b, "panic", [rv_arg_lit_str("missing return")], 0)
        }
    }
}

# rv_stmt(b, si) — the statement lowering (the .py's _lower_stmt).
fn rv_stmt(b: RVBuild, si: int) -> void {
    let ctx: Ctx = b.ctx
    let s: StmtN = ctx.stmts.get(si)
    # statements after return/break/continue are unreachable — skip
    if rv_terminated(b) {
        return
    }
    let k: str = s.kind
    if k == "let" {
        let val: str = rv_expr(b, s.value)
        if b.err != "" {
            return
        }
        if s.rpred != "" {
            rv_emit_r(b, "v_" + s.name, "load", [rv_arg_var(val)], s.line,
            s.vtype, s.rpred)
        } else {
            rv_emit(b, "v_" + s.name, "load", [rv_arg_var(val)], s.line,
            s.vtype)
        }
        return
    }
    if k == "assign" {
        let tk: str = ctx.exprs[s.target].kind
        let val: str = rv_expr(b, s.value)
        if b.err != "" {
            return
        }
        if tk == "ident" {
            # the binding's static type (the target node's t, else the
            # statement's recorded type)
            let tgt: ExprN = ctx.exprs[s.target]
            let mut bty: str = tgt.t
            if bty == "" {
                bty = s.vtype
            }
            if s.rpred != "" {
                rv_emit_r(b, "v_" + tgt.name, "store",
                [rv_arg_var(val), rv_arg_name(tgt.name)], s.line, bty,
                s.rpred)
            } else {
                rv_emit(b, "v_" + tgt.name, "store",
                [rv_arg_var(val), rv_arg_name(tgt.name)], s.line, bty)
            }
        } else if tk == "field" {
            let recv: str = rv_expr(b, ctx.exprs[s.target].left)
            if b.err != "" {
                return
            }
            rv_emit(b, "", "struct_set",
            [rv_arg_var(recv), rv_arg_name(ctx.exprs[s.target].name),
            rv_arg_var(val)], s.line, "")
        } else if tk == "index" {
            let lst: str = rv_expr(b, ctx.exprs[s.target].left)
            if b.err != "" {
                return
            }
            let idx: str = rv_expr(b, ctx.exprs[s.target].right)
            if b.err != "" {
                return
            }
            rv_emit(b, "", "list_set",
            [rv_arg_var(lst), rv_arg_var(idx), rv_arg_var(val)], s.line, "")
        }
        return
    }
    if k == "return" {
        if s.value < 0 {
            rv_term(b, "return", [], s.line)
        } else {
            let val2: str = rv_expr(b, s.value)
            if b.err != "" {
                return
            }
            rv_term(b, "return", [rv_arg_var(val2)], s.line)
        }
        return
    }
    if k == "if" {
        let cond: str = rv_expr(b, s.cond)
        if b.err != "" {
            return
        }
        let then_b: str = rv_create(b, "then")
        let else_b: str = rv_create(b, "else")
        let end_b: str = rv_create(b, "endif")
        rv_term(b, "branch",
        [rv_arg_var(cond), rv_arg_label(then_b), rv_arg_label(else_b)],
        s.line)
        rv_open(b, then_b)
        let mut i: int = 0
        while i < s.body.len() {
            rv_stmt(b, s.body.get(i))
            if b.err != "" {
                return
            }
            i = i + 1
        }
        if !rv_terminated(b) {
            rv_term(b, "jump", [rv_arg_label(end_b)], 0)
        }
        rv_open(b, else_b)
        let mut j: int = 0
        while j < s.else_body.len() {
            rv_stmt(b, s.else_body.get(j))
            if b.err != "" {
                return
            }
            j = j + 1
        }
        if !rv_terminated(b) {
            rv_term(b, "jump", [rv_arg_label(end_b)], 0)
        }
        rv_open(b, end_b)
        return
    }
    if k == "while" {
        let cond_b: str = rv_create(b, "while_cond")
        let body_b: str = rv_create(b, "while_body")
        let end_b: str = rv_create(b, "while_end")
        rv_term(b, "jump", [rv_arg_label(cond_b)], 0)
        rv_open(b, cond_b)
        let cond2: str = rv_expr(b, s.cond)
        if b.err != "" {
            return
        }
        rv_term(b, "branch",
        [rv_arg_var(cond2), rv_arg_label(body_b), rv_arg_label(end_b)],
        s.line)
        rv_open(b, body_b)
        b.loop_cont.push(cond_b)
        b.loop_brk.push(end_b)
        let mut i: int = 0
        while i < s.body.len() {
            rv_stmt(b, s.body.get(i))
            if b.err != "" {
                return
            }
            i = i + 1
        }
        b.loop_cont.pop()
        b.loop_brk.pop()
        if !rv_terminated(b) {
            rv_term(b, "jump", [rv_arg_label(cond_b)], 0)
        }
        rv_open(b, end_b)
        return
    }
    if k == "for" {
        # for v: T in iter { body } lowers to the re-checking loop:
        #   v_iter = <iter>; v_i = 0
        #   for_cond:  while v_i < list_len(v_iter)
        #   for_body:  v = list_get(v_iter, v_i); body
        #   for_inc:   v_i = v_i + 1  (the continue target)
        #   for_end:
        let iter_name: str = rv_expr(b, s.iter)
        if b.err != "" {
            return
        }
        rv_emit(b, "v_" + s.name + "__i", "const", [rv_arg_lit_int(0)],
        s.line, "int")
        let cond_b: str = rv_create(b, "for_cond")
        let body_b: str = rv_create(b, "for_body")
        let inc_b: str = rv_create(b, "for_inc")
        let end_b: str = rv_create(b, "for_end")
        rv_term(b, "jump", [rv_arg_label(cond_b)], 0)
        rv_open(b, cond_b)
        let cur_len: str = rv_emit(b, "", "list_len", [rv_arg_var(iter_name)],
        s.line, "int")
        let cond_tmp: str = rv_emit(b, "", "binop",
        [rv_arg_op("<"), rv_arg_var("v_" + s.name + "__i"),
        rv_arg_var(cur_len)], s.line, "bool")
        rv_term(b, "branch",
        [rv_arg_var(cond_tmp), rv_arg_label(body_b), rv_arg_label(end_b)],
        s.line)
        rv_open(b, body_b)
        rv_emit(b, "v_" + s.name, "list_get",
        [rv_arg_var(iter_name), rv_arg_var("v_" + s.name + "__i")], s.line,
        s.vtype)
        b.loop_cont.push(inc_b)
        b.loop_brk.push(end_b)
        let mut i: int = 0
        while i < s.body.len() {
            rv_stmt(b, s.body.get(i))
            if b.err != "" {
                return
            }
            i = i + 1
        }
        b.loop_cont.pop()
        b.loop_brk.pop()
        if !rv_terminated(b) {
            rv_term(b, "jump", [rv_arg_label(inc_b)], 0)
        }
        rv_open(b, inc_b)
        let inc: str = rv_emit(b, "", "binop",
        [rv_arg_op("+"), rv_arg_var("v_" + s.name + "__i"), rv_arg_lit_int(1)],
        s.line, "int")
        # BUG-SC-IR-1: the store target is the binding name WITHOUT the
        # v_ prefix (the store handler prepends it).
        rv_emit(b, "v_" + s.name + "__i", "store",
        [rv_arg_var(inc), rv_arg_name(s.name + "__i")], s.line, "int")
        rv_term(b, "jump", [rv_arg_label(cond_b)], 0)
        rv_open(b, end_b)
        return
    }
    if k == "break" {
        if b.loop_brk.len() > 0 {
            rv_term(b, "jump",
            [rv_arg_label(b.loop_brk.get(b.loop_brk.len() - 1))], s.line)
        }
        return
    }
    if k == "continue" {
        if b.loop_cont.len() > 0 {
            rv_term(b, "jump",
            [rv_arg_label(b.loop_cont.get(b.loop_cont.len() - 1))], s.line)
        }
        return
    }
    if k == "expr" {
        rv_expr(b, s.e)
        return
    }
    # Unknown statement kind — the comment marker the .py left for the
    # optimiser to drop after DCE (asm statements land here today).
    rv_emit(b, "", "comment", [rv_arg_text(k)], s.line, "")
}

# rv_expr(b, e) — lower one expression, return its SSA name. The
# refusal set is the retired layer's exactly — match and enum literals
# are construct refusals, not silent zeros.
fn rv_expr(b: RVBuild, e: int) -> str {
    let ctx: Ctx = b.ctx
    if e < 0 {
        return "v_?"
    }
    let k: str = ctx.exprs[e].kind
    if k == "int" {
        return rv_emit(b, "", "const", [rv_arg_lit_int(ctx.exprs[e].ival)],
        ctx.exprs[e].line, "int")
    }
    if k == "float" {
        return rv_emit(b, "", "const", [rv_arg_lit_float(ctx.exprs[e].fval)],
        ctx.exprs[e].line, "float")
    }
    if k == "bool" {
        return rv_emit(b, "", "const", [rv_arg_lit_bool(ctx.exprs[e].bval)],
        ctx.exprs[e].line, "bool")
    }
    if k == "str" {
        return rv_emit(b, "", "const", [rv_arg_lit_str(ctx.exprs[e].sval)],
        ctx.exprs[e].line, "str")
    }
    if k == "ident" {
        return "v_" + ctx.exprs[e].name
    }
    if k == "bin" {
        let a: str = rv_expr(b, ctx.exprs[e].left)
        if b.err != "" {
            return ""
        }
        let c: str = rv_expr(b, ctx.exprs[e].right)
        if b.err != "" {
            return ""
        }
        return rv_emit(b, "", "binop",
        [rv_arg_op(ctx.exprs[e].op), rv_arg_var(a), rv_arg_var(c)],
        ctx.exprs[e].line, ctx.exprs[e].t)
    }
    if k == "un" {
        let a: str = rv_expr(b, ctx.exprs[e].left)
        if b.err != "" {
            return ""
        }
        return rv_emit(b, "", "unop",
        [rv_arg_op(ctx.exprs[e].op), rv_arg_var(a)], ctx.exprs[e].line,
        ctx.exprs[e].t)
    }
    if k == "call" {
        let cargs: list[RVArg] = [rv_arg_fname(ctx.exprs[e].name)]
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            let a: str = rv_expr(b, ctx.exprs[e].args.get(i))
            if b.err != "" {
                return ""
            }
            cargs.push(rv_arg_var(a))
            i = i + 1
        }
        return rv_emit(b, "", "call", cargs, ctx.exprs[e].line, ctx.exprs[e].t)
    }
    if k == "method" || k == "fieldcall" {
        let recv: str = rv_expr(b, ctx.exprs[e].left)
        if b.err != "" {
            return ""
        }
        let margs: list[RVArg] = [rv_arg_name(ctx.exprs[e].name),
        rv_arg_var(recv)]
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            let a: str = rv_expr(b, ctx.exprs[e].args.get(i))
            if b.err != "" {
                return ""
            }
            margs.push(rv_arg_var(a))
            i = i + 1
        }
        return rv_emit(b, "", "method", margs, ctx.exprs[e].line,
        ctx.exprs[e].t)
    }
    if k == "field" {
        let recv: str = rv_expr(b, ctx.exprs[e].left)
        if b.err != "" {
            return ""
        }
        return rv_emit(b, "", "struct_get",
        [rv_arg_var(recv), rv_arg_name(ctx.exprs[e].name)], ctx.exprs[e].line,
        ctx.exprs[e].t)
    }
    if k == "index" {
        let lst: str = rv_expr(b, ctx.exprs[e].left)
        if b.err != "" {
            return ""
        }
        let idx: str = rv_expr(b, ctx.exprs[e].right)
        if b.err != "" {
            return ""
        }
        return rv_emit(b, "", "list_get", [rv_arg_var(lst), rv_arg_var(idx)],
        ctx.exprs[e].line, ctx.exprs[e].t)
    }
    if k == "qmark" {
        let v: str = rv_expr(b, ctx.exprs[e].left)
        if b.err != "" {
            return ""
        }
        return rv_emit(b, "", "qmark", [rv_arg_var(v)], ctx.exprs[e].line,
        ctx.exprs[e].t)
    }
    if k == "listlit" {
        let largs: list[RVArg] = []
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            let a: str = rv_expr(b, ctx.exprs[e].args.get(i))
            if b.err != "" {
                return ""
            }
            largs.push(rv_arg_var(a))
            i = i + 1
        }
        return rv_emit(b, "", "list_new", largs, ctx.exprs[e].line, "")
    }
    if k == "structlit" {
        let sargs: list[RVArg] = [rv_arg_type(ctx.exprs[e].name)]
        let mut i: int = 0
        while i < ctx.exprs[e].ffields.len() {
            sargs.push(rv_arg_name(ctx.exprs[e].ffields.get(i)))
            i = i + 1
        }
        let mut j: int = 0
        while j < ctx.exprs[e].args.len() {
            let a: str = rv_expr(b, ctx.exprs[e].args.get(j))
            if b.err != "" {
                return ""
            }
            sargs.push(rv_arg_var(a))
            j = j + 1
        }
        return rv_emit(b, "", "struct_new", sargs, ctx.exprs[e].line, "")
    }
    if k == "match" {
        b.err = "--emit ir / --opt-stats: `match` expressions are not "
        + "supported by the HLIR builder yet (arm bodies would be "
        + "dropped) (line " + ctx.exprs[e].line.to_str() + ")"
        return ""
    }
    if k == "enumlit" {
        b.err = "enum literal (" + ctx.exprs[e].enum_name + "."
        + ctx.exprs[e].variant + ") is not yet supported by --emit ir "
        + "(Stage 11 IR subset) (line " + ctx.exprs[e].line.to_str() + ")"
        return ""
    }
    b.err = "expression kind '" + k + "' is not yet supported by --emit ir "
    + "(Stage 11 IR subset) (line " + ctx.exprs[e].line.to_str() + ")"
    return ""
}

# ----------------------------------------------------------------------------
# The concurrency gate — the HLIR does not model Chan/Task/spawn (the
# retired ir/__init__.py's _reject_concurrency, the same refusal; the
# walk is hlemit's port of it).
# ----------------------------------------------------------------------------

fn rv_type_uses_concurrency(t: str) -> bool {
    if t.starts_with("Chan[") || t.starts_with("Task[") {
        return true
    }
    if t.starts_with("list[") || t.starts_with("tainted[") {
        return rv_type_uses_concurrency(t.slice(t.find("[") + 1, t.len() - 1))
    }
    if t.starts_with("map[str, ") {
        return rv_type_uses_concurrency(t.slice(9, t.len() - 1))
    }
    return false
}

fn rv_expr_uses_concurrency(ctx: Ctx, e: int) -> bool {
    if e < 0 {
        return false
    }
    let k: str = ctx.exprs[e].kind
    if k == "call" {
        let nm: str = ctx.exprs[e].name
        if nm == "chan_new" || nm == "spawn" || nm == "select" {
            return true
        }
    }
    if k == "method" || k == "fieldcall" {
        let rm: str = ctx.exprs[e].mop
        if rm.starts_with("chan.") || rm == "task.join" {
            return true
        }
    }
    if rv_expr_uses_concurrency(ctx, ctx.exprs[e].left)
    || rv_expr_uses_concurrency(ctx, ctx.exprs[e].right) {
        return true
    }
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        if rv_expr_uses_concurrency(ctx, ctx.exprs[e].args.get(i)) {
            return true
        }
        i = i + 1
    }
    if k == "match" {
        let mut a: int = 0
        while a < ctx.exprs[e].args.len() {
            let arm: MatchArm = ctx.match_arms.get(ctx.exprs[e].args.get(a))
            if rv_expr_uses_concurrency(ctx, arm.body) {
                return true
            }
            a = a + 1
        }
    }
    return false
}

fn rv_stmt_uses_concurrency(ctx: Ctx, si: int) -> bool {
    let s: StmtN = ctx.stmts.get(si)
    if rv_expr_uses_concurrency(ctx, s.value)
    || rv_expr_uses_concurrency(ctx, s.e)
    || rv_expr_uses_concurrency(ctx, s.cond)
    || rv_expr_uses_concurrency(ctx, s.iter)
    || rv_expr_uses_concurrency(ctx, s.target) {
        return true
    }
    let mut i: int = 0
    while i < s.body.len() {
        if rv_stmt_uses_concurrency(ctx, s.body.get(i)) {
            return true
        }
        i = i + 1
    }
    let mut j: int = 0
    while j < s.else_body.len() {
        if rv_stmt_uses_concurrency(ctx, s.else_body.get(j)) {
            return true
        }
        j = j + 1
    }
    return false
}

fn rv_uses_concurrency(ctx: Ctx) -> bool {
    let skeys: list[str] = ctx.structs.keys()
    let mut si: int = 0
    while si < skeys.len() {
        let st: StructInfo = ctx.structs.get_or(skeys.get(si), dummy_struct())
        let mut f: int = 0
        while f < st.fields.len() {
            if rv_type_uses_concurrency(st.ftypes.get(f)) {
                return true
            }
            if rv_expr_uses_concurrency(ctx, st.fdefaults.get(f)) {
                return true
            }
            f = f + 1
        }
        si = si + 1
    }
    let ekeys: list[str] = ctx.enums.keys()
    let mut ei: int = 0
    while ei < ekeys.len() {
        let en: EnumInfo = ctx.enums.get_or(ekeys.get(ei), dummy_enum())
        let mut v: int = 0
        while v < en.variants.len() {
            let payloads: list[str] = en.payloads.get(v)
            let mut p: int = 0
            while p < payloads.len() {
                if rv_type_uses_concurrency(payloads.get(p)) {
                    return true
                }
                p = p + 1
            }
            v = v + 1
        }
        ei = ei + 1
    }
    let fkeys: list[str] = ctx.fns.keys()
    let mut fi: int = 0
    while fi < fkeys.len() {
        let f: FnInfo = ctx.fns.get_or(fkeys.get(fi), dummy_fn())
        let mut p: int = 0
        while p < f.ptypes.len() {
            if rv_type_uses_concurrency(f.ptypes.get(p)) {
                return true
            }
            p = p + 1
        }
        if rv_type_uses_concurrency(f.ret) {
            return true
        }
        let mut bi: int = 0
        while bi < f.body.len() {
            if rv_stmt_uses_concurrency(ctx, f.body.get(bi)) {
                return true
            }
            bi = bi + 1
        }
        fi = fi + 1
    }
    return false
}

# rv_build_module(ctx) — the whole program, "" or the refusal text.
fn rv_build_module(ctx: Ctx) -> str {
    if rv_uses_concurrency(ctx) {
        return "concurrency (Chan[T] / Task[R] / spawn / chan_new / "
        + "select) is not yet supported by the --emit ir path — Stage 16 "
        + "ships in the C backend and the interpreter only"
    }
    let b: RVBuild = rv_builder(ctx)
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if !f.is_extern {
            rv_build_fn(b, key, f)
            if b.err != "" {
                return b.err
            }
        }
        i = i + 1
    }
    return ""
}

# ============================================================================
# The optimiser — the retired tools/ir/optimize.py, pass for pass:
#   constant_fold -> copy_propagate -> dead_code_elim -> inline_small
#   -> (fold, copyprop, dce again) -> licm -> dce -> annotate_safe.
# ============================================================================

fn rv_inline_max_instrs() -> int {
    return 12
}

fn rv_lto_inline_max_instrs() -> int {
    return 60
}

# ----------------------------------------------------------------------------
# Pass 1: constant folding. RVVal is the Python literal value (lty
# "none" = unknown / the dead marker).
# ----------------------------------------------------------------------------

struct RVVal {
    lty: str, # "int" | "bool" | "str" | "float" | "none"
    ival: int,
    bval: bool,
    sval: str,
    fval: float
}

fn rv_val_none() -> RVVal {
    return RVVal {
        lty: "none", ival: 0, bval: false, sval: "", fval: 0.0
    }
}

fn rv_val_int(v: int) -> RVVal {
    return RVVal {
        lty: "int", ival: v, bval: false, sval: "", fval: 0.0
    }
}

fn rv_val_bool(v: bool) -> RVVal {
    return RVVal {
        lty: "bool", ival: 0, bval: v, sval: "", fval: 0.0
    }
}

fn rv_val_str(v: str) -> RVVal {
    return RVVal {
        lty: "str", ival: 0, bval: false, sval: v, fval: 0.0
    }
}

fn rv_val_float(v: float) -> RVVal {
    return RVVal {
        lty: "float", ival: 0, bval: false, sval: "", fval: v
    }
}

# rv_lit_val(a) — the literal value of a lit operand, none when absent.
fn rv_lit_val(a: RVArg) -> RVVal {
    if a.tag != "lit" {
        return rv_val_none()
    }
    if a.lty == "int" {
        return rv_val_int(a.ival)
    }
    if a.lty == "bool" {
        return rv_val_bool(a.bval)
    }
    if a.lty == "str" {
        return rv_val_str(a.sval)
    }
    if a.lty == "float" {
        return rv_val_float(a.fval)
    }
    return rv_val_none()
}

fn rv_val_lit_arg(v: RVVal) -> RVArg {
    if v.lty == "int" {
        return rv_arg_lit_int(v.ival)
    }
    if v.lty == "bool" {
        return rv_arg_lit_bool(v.bval)
    }
    if v.lty == "str" {
        return rv_arg_lit_str(v.sval)
    }
    if v.lty == "float" {
        return rv_arg_lit_float(v.fval)
    }
    return rv_arg_lit_null()
}

# rv_consts_known(consts, name) — a KNOWN constant (not absent, not the
# dead marker).
fn rv_consts_known(consts: map[str, RVVal], name: str) -> bool {
    if !consts.has(name) {
        return false
    }
    return consts.get_or(name, rv_val_none()).lty != "none"
}

# rv_same_hls_type(a, b) — both values of the SAME HLS type (bool and
# int are distinct — the deep-scan-12 rule).
fn rv_same_hls_type(a: RVVal, b: RVVal) -> bool {
    if a.lty == "bool" || b.lty == "bool" {
        return a.lty == "bool" && b.lty == "bool"
    }
    if a.lty == "int" || b.lty == "int" {
        return a.lty == "int" && b.lty == "int"
    }
    if a.lty == "float" || b.lty == "float" {
        return a.lty == "float" && b.lty == "float"
    }
    if a.lty == "str" || b.lty == "str" {
        return a.lty == "str" && b.lty == "str"
    }
    return false
}

# rv_add_ok / rv_sub_ok — int64 pre-checks for the folder (Halis int
# arithmetic panics on overflow; the Python folded arbitrary precision
# and kept only in-range results — the pre-check keeps exactly those).
fn rv_add_ok(a: int, b: int) -> bool {
    if b > 0 && a > INF_HI() - b {
        return false
    }
    if b < 0 && a < INF_LO() - b {
        return false
    }
    return true
}

fn rv_sub_ok(a: int, b: int) -> bool {
    if b < 0 && a > INF_HI() + b {
        return false
    }
    if b > 0 && a < INF_LO() + b {
        return false
    }
    return true
}

# rv_fold_binop(op, a, b) — fold two literal values; ok=false when the
# op cannot fold (wrong types, would panic — INT64_MIN / -1 keeps its
# runtime panic, BUG-DS4-13).
fn rv_fold_binop(op: str, a: RVVal, b: RVVal) -> RVVal {
    if op == "+" {
        if a.lty == "int" && b.lty == "int" {
            if rv_add_ok(a.ival, b.ival) {
                return rv_val_int(a.ival + b.ival)
            }
            return rv_val_none()
        }
        if a.lty == "str" && b.lty == "str" {
            return rv_val_str(a.sval + b.sval)
        }
        return rv_val_none()
    }
    if op == "-" {
        if a.lty == "int" && b.lty == "int" {
            if rv_sub_ok(a.ival, b.ival) {
                return rv_val_int(a.ival - b.ival)
            }
            return rv_val_none()
        }
        return rv_val_none()
    }
    if op == "*" {
        if a.lty == "int" && b.lty == "int" {
            if iv_mul_ok(a.ival, b.ival) {
                return rv_val_int(a.ival * b.ival)
            }
            return rv_val_none()
        }
        return rv_val_none()
    }
    if op == "/" {
        if a.lty == "int" && b.lty == "int" && b.ival != 0 {
            if a.ival == INF_LO() && b.ival == -1 {
                return rv_val_none()
            }
            return rv_val_int(a.ival / b.ival)
        }
        return rv_val_none()
    }
    if op == "%" {
        if a.lty == "int" && b.lty == "int" && b.ival != 0 {
            if a.ival == INF_LO() && b.ival == -1 {
                return rv_val_none()
            }
            return rv_val_int(a.ival % b.ival)
        }
        return rv_val_none()
    }
    if op == "==" {
        if rv_same_hls_type(a, b) {
            return rv_val_bool(rv_val_eq(a, b))
        }
        return rv_val_none()
    }
    if op == "!=" {
        if rv_same_hls_type(a, b) {
            return rv_val_bool(!rv_val_eq(a, b))
        }
        return rv_val_none()
    }
    if op == "<" {
        if rv_same_hls_type(a, b) {
            return rv_val_bool(rv_val_lt(a, b))
        }
        return rv_val_none()
    }
    if op == "<=" {
        if rv_same_hls_type(a, b) {
            return rv_val_bool(rv_val_lt(a, b) || rv_val_eq(a, b))
        }
        return rv_val_none()
    }
    if op == ">" {
        if rv_same_hls_type(a, b) {
            return rv_val_bool(rv_val_lt(b, a))
        }
        return rv_val_none()
    }
    if op == ">=" {
        if rv_same_hls_type(a, b) {
            return rv_val_bool(rv_val_lt(b, a) || rv_val_eq(a, b))
        }
        return rv_val_none()
    }
    if op == "&&" {
        if a.lty == "bool" && b.lty == "bool" {
            return rv_val_bool(a.bval && b.bval)
        }
        return rv_val_none()
    }
    if op == "||" {
        if a.lty == "bool" && b.lty == "bool" {
            return rv_val_bool(a.bval || b.bval)
        }
        return rv_val_none()
    }
    return rv_val_none()
}

fn rv_val_eq(a: RVVal, b: RVVal) -> bool {
    if a.lty == "int" {
        return a.ival == b.ival
    }
    if a.lty == "bool" {
        return a.bval == b.bval
    }
    if a.lty == "str" {
        return a.sval == b.sval
    }
    if a.lty == "float" {
        return a.fval == b.fval
    }
    return false
}

fn rv_val_lt(a: RVVal, b: RVVal) -> bool {
    if a.lty == "int" {
        return a.ival < b.ival
    }
    if a.lty == "str" {
        return a.sval < b.sval
    }
    if a.lty == "float" {
        return a.fval < b.fval
    }
    return false
}

# rv_resolve_const(arg, consts) — an instruction operand's literal
# value, when known.
fn rv_resolve_const(arg: RVArg, consts: map[str, RVVal]) -> RVVal {
    if arg.tag == "lit" {
        return rv_lit_val(arg)
    }
    if arg.tag == "var" {
        return consts.get_or(arg.sval, rv_val_none())
    }
    return rv_val_none()
}

# rv_constant_fold(irf) — replace literal binops with const instrs,
# tracking constants propagated through load/store (the .py's pass 1).
fn rv_constant_fold(irf: RVFn) -> void {
    let mut bi: int = 0
    while bi < irf.blocks.len() {
        let blk: RVBlock = irf.blocks.get(bi)
        let consts: map[str, RVVal] = map_new()
        let new_instrs: list[RVIns] = []
        let mut ii: int = 0
        while ii < blk.instrs.len() {
            let ins: RVIns = blk.instrs.get(ii)
            if ins.op == "const" && ins.args.len() > 0
            && ins.args.get(0).tag == "lit" {
                let v: RVVal = rv_lit_val(ins.args.get(0))
                if v.lty != "none" {
                    consts.set(ins.dest, v)
                } else {
                    consts.set(ins.dest, rv_val_none())
                }
                new_instrs.push(ins)
                ii = ii + 1
                continue
            }
            if ins.op == "load" && ins.args.len() == 1
            && ins.args.get(0).tag == "var" {
                let src: str = ins.args.get(0).sval
                consts.set(ins.dest, consts.get_or(src, rv_val_none()))
                new_instrs.push(ins)
                ii = ii + 1
                continue
            }
            if ins.op == "store" && ins.args.len() >= 2
            && ins.args.get(1).tag == "name" {
                let src_arg: RVArg = ins.args.get(0)
                let binding: str = "v_" + ins.args.get(1).sval
                if src_arg.tag == "var" {
                    consts.set(binding,
                    consts.get_or(src_arg.sval, rv_val_none()))
                } else if src_arg.tag == "lit" {
                    consts.set(binding, rv_lit_val(src_arg))
                } else {
                    consts.set(binding, rv_val_none())
                }
                new_instrs.push(ins)
                ii = ii + 1
                continue
            }
            if ins.op == "binop" && ins.args.len() >= 3 {
                let op_arg: RVArg = ins.args.get(0)
                if op_arg.tag == "op" {
                    let a_val: RVVal = rv_resolve_const(ins.args.get(1),
                    consts)
                    let b_val: RVVal = rv_resolve_const(ins.args.get(2),
                    consts)
                    if a_val.lty != "none" && b_val.lty != "none" {
                        let folded: RVVal = rv_fold_binop(op_arg.sval, a_val,
                        b_val)
                        if folded.lty != "none" {
                            let new_ins: RVIns = rv_ins(ins.dest, "const",
                            [rv_val_lit_arg(folded)], ins.line, "")
                            new_instrs.push(new_ins)
                            consts.set(ins.dest, folded)
                            ii = ii + 1
                            continue
                        }
                    }
                }
                new_instrs.push(ins)
                ii = ii + 1
                continue
            }
            if ins.op == "unop" && ins.args.len() >= 2 {
                let op_arg: RVArg = ins.args.get(0)
                if op_arg.tag == "op" && op_arg.sval == "-" {
                    let a_val: RVVal = rv_resolve_const(ins.args.get(1),
                    consts)
                    if a_val.lty == "int" && a_val.ival != INF_LO() {
                        let new_ins: RVIns = rv_ins(ins.dest, "const",
                        [rv_arg_lit_int(-a_val.ival)], ins.line, "")
                        new_instrs.push(new_ins)
                        consts.set(ins.dest, rv_val_int(-a_val.ival))
                        ii = ii + 1
                        continue
                    }
                }
                if op_arg.tag == "op" && op_arg.sval == "!" {
                    let a_val: RVVal = rv_resolve_const(ins.args.get(1),
                    consts)
                    if a_val.lty == "bool" {
                        let new_ins: RVIns = rv_ins(ins.dest, "const",
                        [rv_arg_lit_bool(!a_val.bval)], ins.line, "")
                        new_instrs.push(new_ins)
                        consts.set(ins.dest, rv_val_bool(!a_val.bval))
                        ii = ii + 1
                        continue
                    }
                }
                new_instrs.push(ins)
                ii = ii + 1
                continue
            }
            new_instrs.push(ins)
            ii = ii + 1
        }
        blk.instrs = new_instrs
        bi = bi + 1
    }
}

# ----------------------------------------------------------------------------
# Pass 2: copy propagation (v_x = t_k copies; store invalidates).
# ----------------------------------------------------------------------------

fn rv_rewrite_arg(arg: RVArg, canon: map[str, str]) -> RVArg {
    if arg.tag == "var" && canon.has(arg.sval) {
        let to: str = canon.get_or(arg.sval, "")
        if to != "" {
            return rv_arg_var(to)
        }
    }
    return arg
}

fn rv_copy_propagate(irf: RVFn) -> void {
    let mut bi: int = 0
    while bi < irf.blocks.len() {
        let blk: RVBlock = irf.blocks.get(bi)
        let canon: map[str, str] = map_new()
        let mut ii: int = 0
        while ii < blk.instrs.len() {
            let ins: RVIns = blk.instrs.get(ii)
            let new_args: list[RVArg] = []
            let mut ai: int = 0
            while ai < ins.args.len() {
                new_args.push(rv_rewrite_arg(ins.args.get(ai), canon))
                ai = ai + 1
            }
            ins.args = new_args
            if ins.op == "store" && ins.args.len() >= 2
            && ins.args.get(1).tag == "name" {
                canon.set("v_" + ins.args.get(1).sval, "")
                ii = ii + 1
                continue
            }
            if ins.op == "load" && ins.args.len() == 1
            && ins.args.get(0).tag == "var" {
                let src: str = ins.args.get(0).sval
                if ins.dest != "" && src.len() > 0 && src.byte_at(0) == 116
                && ins.rpred == "" {
                    # a plain copy: uses may read through to the source.
                    # A REFINED load is a guard boundary (the pred's
                    # facts attach to the dest) — never rewrite past it.
                    canon.set(ins.dest, src)
                } else if ins.dest != "" && ins.rpred != "" {
                    canon.set(ins.dest, "")
                }
            }
            ii = ii + 1
        }
        if blk.has_term {
            let new_targs: list[RVArg] = []
            let mut ti: int = 0
            while ti < blk.term.args.len() {
                new_targs.push(rv_rewrite_arg(blk.term.args.get(ti), canon))
                ti = ti + 1
            }
            blk.term.args = new_targs
        }
        bi = bi + 1
    }
}

# ----------------------------------------------------------------------------
# Pass 3: dead code elimination (function-wide `used` — BUG-SC-IR-2).
# ----------------------------------------------------------------------------

fn rv_has_side_effects(ins: RVIns) -> bool {
    if ins.op == "unop" {
        if ins.args.len() > 0 && ins.args.get(0).tag == "op"
        && ins.args.get(0).sval == "!" {
            return false
        }
        return true
    }
    if ins.op == "const" || ins.op == "load" || ins.op == "list_new"
    || ins.op == "struct_new" || ins.op == "struct_get"
    || ins.op == "map_get" || ins.op == "list_len" {
        return false
    }
    # binop, list_get, unop-, store, call, method, builtin, panic,
    # qmark, branch, jump, return, comment, anything unknown: impure
    # (checked arithmetic panics; DCE never erases a required panic).
    return true
}

fn rv_dead_code_elim(irf: RVFn) -> void {
    let used: map[str, bool] = map_new()
    let mut bi: int = 0
    while bi < irf.blocks.len() {
        let blk: RVBlock = irf.blocks.get(bi)
        let mut ii: int = 0
        while ii < blk.instrs.len() {
            let ins: RVIns = blk.instrs.get(ii)
            let mut ai: int = 0
            while ai < ins.args.len() {
                if ins.args.get(ai).tag == "var" {
                    used.set(ins.args.get(ai).sval, true)
                }
                ai = ai + 1
            }
            ii = ii + 1
        }
        if blk.has_term {
            let mut ti: int = 0
            while ti < blk.term.args.len() {
                if blk.term.args.get(ti).tag == "var" {
                    used.set(blk.term.args.get(ti).sval, true)
                }
                ti = ti + 1
            }
        }
        bi = bi + 1
    }
    bi = 0
    while bi < irf.blocks.len() {
        let blk: RVBlock = irf.blocks.get(bi)
        let new_instrs: list[RVIns] = []
        let mut ii: int = 0
        while ii < blk.instrs.len() {
            let ins: RVIns = blk.instrs.get(ii)
            if rv_has_side_effects(ins) {
                new_instrs.push(ins)
            } else if ins.dest != "" && used.has(ins.dest) {
                new_instrs.push(ins)
            }
            ii = ii + 1
        }
        blk.instrs = new_instrs
        bi = bi + 1
    }
}

# ----------------------------------------------------------------------------
# Pass 4: inline small pure functions (single block, no store, no
# self-call, at most threshold instructions; --lto raises the
# threshold).
# ----------------------------------------------------------------------------

# rv_is_temp_name(dest) — "t" followed by digits.
fn rv_is_temp_name(dest: str) -> bool {
    if dest.len() < 2 {
        return false
    }
    if dest.byte_at(0) != 116 {
        return false
    }
    let mut i: int = 1
    while i < dest.len() {
        let c: int = dest.byte_at(i)
        if c < 48 || c > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

fn rv_inline_small(mod: RVMod, threshold: int) -> void {
    # Step 1: identify inlinable functions.
    let inlinable: map[str, bool] = map_new()
    let mut fi: int = 0
    while fi < mod.order.len() {
        let key: str = mod.order.get(fi)
        let irf: RVFn = mod.fns.get_or(key, rv_dummy_fn_ir())
        if irf.effects.len() > 0 {
            fi = fi + 1
            continue
        }
        if irf.blocks.len() != 1 {
            fi = fi + 1
            continue
        }
        let blk: RVBlock = irf.blocks.get(0)
        if blk.instrs.len() > threshold {
            fi = fi + 1
            continue
        }
        if !blk.has_term || blk.term.op != "return" {
            fi = fi + 1
            continue
        }
        let mut bad: bool = false
        let mut ii: int = 0
        while ii < blk.instrs.len() {
            let ins: RVIns = blk.instrs.get(ii)
            if ins.op == "store" {
                bad = true
                break
            }
            if ins.op == "call" && ins.args.len() > 0
            && ins.args.get(0).tag == "fname"
            && ins.args.get(0).sval == key {
                bad = true
                break
            }
            ii = ii + 1
        }
        if !bad {
            inlinable.set(key, true)
        }
        fi = fi + 1
    }
    if inlinable.len() == 0 {
        return
    }
    # Step 2: rewrite call sites (fresh temps above the caller's
    # highest t-id; callee params map to the call's arguments).
    let mut ci: int = 0
    while ci < mod.order.len() {
        let caller: RVFn = mod.fns.get_or(mod.order.get(ci), rv_dummy_fn_ir())
        let mut max_t: int = 0
        let mut bi: int = 0
        while bi < caller.blocks.len() {
            let blk2: RVBlock = caller.blocks.get(bi)
            let mut ii: int = 0
            while ii < blk2.instrs.len() {
                let d: str = blk2.instrs.get(ii).dest
                if rv_is_temp_name(d) {
                    let v: int = rv_str_int(d.slice(1, d.len()))
                    if v > max_t {
                        max_t = v
                    }
                }
                ii = ii + 1
            }
            bi = bi + 1
        }
        let counter: list[int] = []
        counter.push(max_t + 1)
        bi = 0
        while bi < caller.blocks.len() {
            let blk3: RVBlock = caller.blocks.get(bi)
            let new_instrs: list[RVIns] = []
            let mut ii: int = 0
            while ii < blk3.instrs.len() {
                let ins: RVIns = blk3.instrs.get(ii)
                if ins.op != "call" || ins.args.len() == 0
                || ins.args.get(0).tag != "fname" {
                    new_instrs.push(ins)
                    ii = ii + 1
                    continue
                }
                let target: str = ins.args.get(0).sval
                if !inlinable.has(target) {
                    new_instrs.push(ins)
                    ii = ii + 1
                    continue
                }
                let callee: RVFn = mod.fns.get_or(target, rv_dummy_fn_ir())
                if callee.blocks.len() != 1 {
                    new_instrs.push(ins)
                    ii = ii + 1
                    continue
                }
                let cblk: RVBlock = callee.blocks.get(0)
                # rename: callee param v_<name> -> the caller's arg
                let rename: map[str, RVArg] = map_new()
                let call_args: int = ins.args.len() - 1
                let mut mismatch: bool = false
                let mut pi: int = 0
                while pi < callee.params.len() {
                    if pi >= call_args {
                        mismatch = true
                        break
                    }
                    rename.set("v_" + callee.params.get(pi),
                    ins.args.get(pi + 1))
                    pi = pi + 1
                }
                if mismatch {
                    new_instrs.push(ins)
                    ii = ii + 1
                    continue
                }
                let mut xi: int = 0
                while xi < cblk.instrs.len() {
                    let cin: RVIns = cblk.instrs.get(xi)
                    let mut new_dest: str = ""
                    if cin.dest != "" {
                        counter.set(0, counter.get(0) + 1)
                        new_dest = "t" + counter.get(0).to_str()
                        rename.set(cin.dest, rv_arg_var(new_dest))
                    }
                    let new_args: list[RVArg] = []
                    let mut ai: int = 0
                    while ai < cin.args.len() {
                        let a: RVArg = cin.args.get(ai)
                        if a.tag == "var" && rename.has(a.sval) {
                            new_args.push(rename.get_or(a.sval,
                            rv_arg_var("")))
                        } else {
                            new_args.push(a)
                        }
                        ai = ai + 1
                    }
                    let pasted: RVIns = RVIns {
                        dest: new_dest, op: cin.op, args: new_args,
                        line: cin.line, ty: cin.ty,
                        safe_overflow: cin.safe_overflow,
                        rpred: cin.rpred
                    }
                    new_instrs.push(pasted)
                    xi = xi + 1
                }
                # the callee's return value feeds the call's dest
                # (deep-scan-12: var -> load, literal -> const, void ->
                # const null, DCE'd when the dest is unused).
                if cblk.has_term && cblk.term.args.len() > 0 {
                    let ret_val: RVArg = cblk.term.args.get(0)
                    if ret_val.tag == "var" {
                        let mut resolved: RVArg = ret_val
                        if rename.has(ret_val.sval) {
                            resolved = rename.get_or(ret_val.sval,
                            rv_arg_var(""))
                        }
                        if resolved.tag == "var" {
                            new_instrs.push(rv_ins(ins.dest, "load",
                            [resolved], ins.line, ""))
                        } else {
                            new_instrs.push(rv_ins(ins.dest, "const",
                            [resolved], ins.line, ""))
                        }
                    } else {
                        new_instrs.push(rv_ins(ins.dest, "const", [ret_val],
                        ins.line, ""))
                    }
                } else {
                    new_instrs.push(rv_ins(ins.dest, "const",
                    [rv_arg_lit_null()], ins.line, ""))
                }
                ii = ii + 1
            }
            blk3.instrs = new_instrs
            bi = bi + 1
        }
        ci = ci + 1
    }
}


# ----------------------------------------------------------------------------
# Pass 5: loop-invariant code motion — the natural-loop algorithm with
# real dominators (deep-scan-24/25's law): back edges t -> h where h
# dominates t, the natural loop is {h} plus everything reaching a
# back-edge source without passing h, hoisting only const/load from
# the fall-through body block into the UNIQUE loop-external preheader.
# ----------------------------------------------------------------------------

# rv_cond_name(name) — while_condN / for_condN (the numbered form the
# builder emits; deep-scan-20's exact match).
fn rv_cond_name(name: str) -> bool {
    let mut rest: str = ""
    if name.starts_with("while_cond") {
        rest = name.slice(10, name.len())
    } else if name.starts_with("for_cond") {
        rest = name.slice(8, name.len())
    } else {
        return false
    }
    if rest.len() == 0 {
        return false
    }
    let mut i: int = 0
    while i < rest.len() {
        let c: int = rest.byte_at(i)
        if c < 48 || c > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

# rv_term_labels(blk) — the branch/jump targets that resolve.
fn rv_term_labels(blk: RVBlock, name_set: map[str, bool]) -> list[str] {
    let out: list[str] = []
    if !blk.has_term {
        return out
    }
    if blk.term.op == "jump" || blk.term.op == "branch" {
        let mut i: int = 0
        while i < blk.term.args.len() {
            let a: RVArg = blk.term.args.get(i)
            if a.tag == "label" && name_set.has(a.sval) {
                out.push(a.sval)
            }
            i = i + 1
        }
    }
    return out
}

fn rv_block_index(irf: RVFn, name: str) -> int {
    let mut i: int = 0
    while i < irf.blocks.len() {
        if irf.blocks.get(i).name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

# rv_is_hoistable(ins, loop_defined) — pure (const/load only — the
# deep-scan-20 soundness cut) with every var operand defined outside
# the loop.
fn rv_is_hoistable(ins: RVIns, loop_defined: map[str, bool]) -> bool {
    if ins.op != "const" && ins.op != "load" {
        return false
    }
    let mut i: int = 0
    while i < ins.args.len() {
        let a: RVArg = ins.args.get(i)
        if a.tag == "var" && loop_defined.has(a.sval) {
            return false
        }
        i = i + 1
    }
    return true
}

fn rv_licm(irf: RVFn) -> void {
    let blocks: list[RVBlock] = irf.blocks
    if blocks.len() == 0 {
        return
    }
    let names: list[str] = []
    let name_set: map[str, bool] = map_new()
    let mut bi0: int = 0
    while bi0 < blocks.len() {
        names.push(blocks.get(bi0).name)
        name_set.set(blocks.get(bi0).name, true)
        bi0 = bi0 + 1
    }
    let entry: str = names.get(0)
    # preds over resolving labels
    let preds: map[str, list[str]] = map_new()
    let mut bi: int = 0
    while bi < blocks.len() {
        let blk: RVBlock = blocks.get(bi)
        let labels: list[str] = rv_term_labels(blk, name_set)
        let mut li: int = 0
        while li < labels.len() {
            let lbl: str = labels.get(li)
            if !preds.has(lbl) {
                let empty: list[str] = []
                preds.set(lbl, empty)
            }
            preds.get_or(lbl, []).push(blk.name)
            li = li + 1
        }
        bi = bi + 1
    }
    # iterative dominators: dom(entry) = {entry};
    # dom(n) = {n} ∪ ∩ dom(p) over predecessors p.
    let dom: map[str, map[str, bool]] = map_new()
    let mut ni: int = 0
    while ni < names.len() {
        let full: map[str, bool] = map_new()
        let mut nj: int = 0
        while nj < names.len() {
            full.set(names.get(nj), true)
            nj = nj + 1
        }
        dom.set(names.get(ni), full)
        ni = ni + 1
    }
    let entry_dom: map[str, bool] = map_new()
    let mut ezi: int = 0
    while ezi < names.len() {
        entry_dom.set(names.get(ezi), names.get(ezi) == entry)
        ezi = ezi + 1
    }
    dom.set(entry, entry_dom)
    let mut changed: bool = true
    while changed {
        changed = false
        let mut nk: int = 0
        while nk < names.len() {
            let n: str = names.get(nk)
            if n == entry {
                nk = nk + 1
                continue
            }
            let ps: list[str] = preds.get_or(n, [])
            if ps.len() > 0 {
                let new_set: map[str, bool] = map_new()
                let mut nj2: int = 0
                while nj2 < names.len() {
                    new_set.set(names.get(nj2), true)
                    nj2 = nj2 + 1
                }
                let mut pk: int = 0
                while pk < ps.len() {
                    let dp: map[str, bool] = dom.get_or(ps.get(pk),
                    map_new())
                    let keys: list[str] = dp.keys()
                    let mut ki: int = 0
                    while ki < keys.len() {
                        if !dp.get_or(keys.get(ki), false) {
                            new_set.set(keys.get(ki), false)
                        }
                        ki = ki + 1
                    }
                    pk = pk + 1
                }
                new_set.set(n, true)
                let cur: map[str, bool] = dom.get_or(n, map_new())
                if !rv_boolmap_eq(new_set, cur) {
                    dom.set(n, new_set)
                    changed = true
                }
            }
            nk = nk + 1
        }
    }
    # the loop nest walk
    let mut hb: int = 0
    while hb < blocks.len() {
        let hblk: RVBlock = blocks.get(hb)
        if !rv_cond_name(hblk.name) {
            hb = hb + 1
            continue
        }
        let h: str = hblk.name
        let h_preds: list[str] = preds.get_or(h, [])
        if h_preds.len() == 0 {
            hb = hb + 1
            continue
        }
        # back edges: t -> h where h dominates t
        let back_edges: list[str] = []
        let mut pi: int = 0
        while pi < h_preds.len() {
            let t: str = h_preds.get(pi)
            if dom.get_or(t, map_new()).get_or(h, false) {
                back_edges.push(t)
            }
            pi = pi + 1
        }
        if back_edges.len() == 0 {
            hb = hb + 1
            continue
        }
        # the natural loop: {h} plus everything reaching a back-edge
        # source without passing through h
        let loop_blocks: map[str, bool] = map_new()
        loop_blocks.set(h, true)
        let work: list[str] = []
        let mut wi: int = 0
        while wi < back_edges.len() {
            work.push(back_edges.get(wi))
            wi = wi + 1
        }
        let mut wci: int = 0
        while wci < work.len() {
            let nm: str = work.get(wci)
            wci = wci + 1
            if loop_blocks.has(nm) {
                continue
            }
            loop_blocks.set(nm, true)
            let wps: list[str] = preds.get_or(nm, [])
            let mut wp: int = 0
            while wp < wps.len() {
                work.push(wps.get(wp))
                wp = wp + 1
            }
        }
        # the structural preheader: the UNIQUE loop-external predecessor
        let external: list[str] = []
        let mut pi2: int = 0
        while pi2 < h_preds.len() {
            if !loop_blocks.has(h_preds.get(pi2)) {
                external.push(h_preds.get(pi2))
            }
            pi2 = pi2 + 1
        }
        if external.len() != 1 {
            hb = hb + 1
            continue
        }
        let preheader: RVBlock = blocks.get(rv_block_index(irf,
        external.get(0)))
        # names defined INSIDE the loop
        let loop_defined: map[str, bool] = map_new()
        let mut lb: int = 0
        while lb < blocks.len() {
            if loop_blocks.has(blocks.get(lb).name) {
                let mut ii: int = 0
                while ii < blocks.get(lb).instrs.len() {
                    let d: str = blocks.get(lb).instrs.get(ii).dest
                    if d != "" {
                        loop_defined.set(d, true)
                    }
                    ii = ii + 1
                }
            }
            lb = lb + 1
        }
        # the fall-through body block: the max-index back-edge source
        let mut body_name: str = back_edges.get(0)
        if back_edges.len() > 1 {
            let mut best: int = rv_block_index(irf, back_edges.get(0))
            let mut bk: int = 1
            while bk < back_edges.len() {
                let idx: int = rv_block_index(irf, back_edges.get(bk))
                if idx > best {
                    best = idx
                }
                bk = bk + 1
            }
            body_name = irf.blocks.get(best).name
        }
        let body: RVBlock = blocks.get(rv_block_index(irf, body_name))
        let hoisted: list[RVIns] = []
        let remaining: list[RVIns] = []
        let mut ii: int = 0
        while ii < body.instrs.len() {
            let ins: RVIns = body.instrs.get(ii)
            if rv_is_hoistable(ins, loop_defined) {
                hoisted.push(ins)
            } else {
                remaining.push(ins)
            }
            ii = ii + 1
        }
        if hoisted.len() > 0 {
            let mut hi: int = 0
            while hi < hoisted.len() {
                preheader.instrs.push(hoisted.get(hi))
                hi = hi + 1
            }
            body.instrs = remaining
        }
        hb = hb + 1
    }
}

# rv_boolmap_eq(a, b) — same keys, same true/false values.
fn rv_boolmap_eq(a: map[str, bool], b: map[str, bool]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let keys: list[str] = a.keys()
    let mut i: int = 0
    while i < keys.len() {
        if a.get_or(keys.get(i), false) != b.get_or(keys.get(i), false) {
            return false
        }
        i = i + 1
    }
    return true
}

# ----------------------------------------------------------------------------
# The -O fast annotations: mark provably-safe binops (the identity
# shapes — x+0, x-0, x*0, x*1; 0-x is NOT safe, BUG-DS4-14).
# ----------------------------------------------------------------------------

# rv_lit_is(a, v) — a literal operand numerically equal to v (the
# Python's `a_arg[1] == 0/1` — bools and floats compare equal to the
# int as Python's == does).
fn rv_lit_is(a: RVArg, v: int) -> bool {
    if a.tag != "lit" {
        return false
    }
    if a.lty == "int" {
        return a.ival == v
    }
    if a.lty == "float" {
        if v == 0 {
            return a.fval == 0.0
        }
        if v == 1 {
            return a.fval == 1.0
        }
        return false
    }
    if a.lty == "bool" {
        if v == 0 {
            return a.bval == false
        }
        if v == 1 {
            return a.bval == true
        }
        return false
    }
    return false
}

fn rv_annotate_safe(irf: RVFn) -> void {
    let mut bi: int = 0
    while bi < irf.blocks.len() {
        let blk: RVBlock = irf.blocks.get(bi)
        let mut ii: int = 0
        while ii < blk.instrs.len() {
            let ins: RVIns = blk.instrs.get(ii)
            if ins.op != "binop" || ins.args.len() < 3 {
                ii = ii + 1
                continue
            }
            let op_arg: RVArg = ins.args.get(0)
            if op_arg.tag != "op" {
                ii = ii + 1
                continue
            }
            let op: str = op_arg.sval
            let a_arg: RVArg = ins.args.get(1)
            let b_arg: RVArg = ins.args.get(2)
            let a_zero: bool = rv_lit_is(a_arg, 0)
            let b_zero: bool = rv_lit_is(b_arg, 0)
            if op == "+" && (a_zero || b_zero) {
                ins.safe_overflow = true
            } else if op == "-" && b_zero {
                ins.safe_overflow = true
            } else if op == "*" {
                let a_one: bool = rv_lit_is(a_arg, 1)
                let b_one: bool = rv_lit_is(b_arg, 1)
                if a_zero || b_zero || a_one || b_one {
                    ins.safe_overflow = true
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

# ----------------------------------------------------------------------------
# The pipeline driver (optimize()'s own order).
# ----------------------------------------------------------------------------

fn rv_optimize_each(mod: RVMod, pass: int) -> void {
    let mut i: int = 0
    while i < mod.order.len() {
        let irf: RVFn = mod.fns.get_or(mod.order.get(i), rv_dummy_fn_ir())
        if pass == 0 {
            rv_constant_fold(irf)
        } else if pass == 1 {
            rv_copy_propagate(irf)
        } else if pass == 2 {
            rv_dead_code_elim(irf)
        } else if pass == 3 {
            rv_licm(irf)
        } else {
            rv_annotate_safe(irf)
        }
        i = i + 1
    }
}

fn rv_optimize(mod: RVMod, fast: bool, lto: bool) -> void {
    # Pass 1-3: fold, copy propagate, DCE.
    rv_optimize_each(mod, 0)
    rv_optimize_each(mod, 1)
    rv_optimize_each(mod, 2)
    # Pass 4: inline small pure functions (the threshold rides --lto),
    # then the newly-created fold opportunities run again.
    let mut threshold: int = rv_inline_max_instrs()
    if lto {
        threshold = rv_lto_inline_max_instrs()
    }
    rv_inline_small(mod, threshold)
    rv_optimize_each(mod, 0)
    rv_optimize_each(mod, 1)
    rv_optimize_each(mod, 2)
    # Pass 5: LICM, then the final DCE cleanup.
    rv_optimize_each(mod, 3)
    rv_optimize_each(mod, 2)
    # -O fast annotations on what survived.
    if fast {
        rv_optimize_each(mod, 4)
    }
}

# ============================================================================
# The site harvests — hlrev_collect.py's own.
# ============================================================================

# rv_binop_site(ins) — ovf/div classification (ty stamp + int ops).
fn rv_binop_site(ins: RVIns) -> str {
    if ins.ty != "int" {
        return ""
    }
    if ins.args.len() == 0 || ins.args.get(0).tag != "op" {
        return ""
    }
    let op: str = ins.args.get(0).sval
    if op == "+" || op == "-" || op == "*" {
        return rv_kind_ovf()
    }
    if op == "/" || op == "%" {
        return rv_kind_div()
    }
    return ""
}

# rv_method_site(ins) — byte_at/slice are bounds sites; get/set are the
# always-checked advisory spellings.
fn rv_method_site(ins: RVIns) -> str {
    if ins.args.len() == 0 || ins.args.get(0).tag != "name" {
        return ""
    }
    let name: str = ins.args.get(0).sval
    if name == "byte_at" || name == "slice" {
        return rv_kind_bnd()
    }
    if name == "get" || name == "set" {
        return rv_kind_set()
    }
    return ""
}

# rv_is_generated_for(ins) — the for-loop lowering's element read:
# `v_X = list_get <iter>, v_X__i`. Not a user site.
fn rv_is_generated_for(ins: RVIns) -> bool {
    if ins.op != "list_get" || ins.dest == "" {
        return false
    }
    if ins.args.len() < 2 {
        return false
    }
    let idx: RVArg = ins.args.get(1)
    return idx.tag == "var" && idx.sval == ins.dest + "__i"
}

# rv_site_kind(ins) — the check-site kind of an instruction ("" = not
# a site).
fn rv_site_kind(ins: RVIns) -> str {
    if ins.op == "binop" {
        return rv_binop_site(ins)
    }
    if ins.op == "list_get" {
        if rv_is_generated_for(ins) {
            return ""
        }
        return rv_kind_bnd()
    }
    if ins.op == "list_set" {
        return rv_kind_set()
    }
    if ins.op == "method" {
        return rv_method_site(ins)
    }
    return ""
}

# One harvested site row: (kind, line, dest) for the IR harvest;
# (kind, line, proven) for the baseline (dest "" there).
struct RVSite {
    kind: str,
    line: int,
    dest: str,
    proven: bool
}

# rv_harvest_ir_sites(mod) — every check-site instruction in REACHABLE
# blocks, in block/instruction order. Unreachable blocks (the lowering's
# inherited endif shells) hold code nothing executes — excluded here
# AND in the reconcile's unreachable class.
fn rv_harvest_ir_sites(mod: RVMod) -> map[str, list[RVSite]] {
    let out: map[str, list[RVSite]] = map_new()
    let mut fi: int = 0
    while fi < mod.order.len() {
        let fname: str = mod.order.get(fi)
        let irf: RVFn = mod.fns.get_or(fname, rv_dummy_fn_ir())
        if irf.blocks.len() == 0 {
            fi = fi + 1
            continue
        }
        let name_set: map[str, bool] = map_new()
        let mut bi: int = 0
        while bi < irf.blocks.len() {
            name_set.set(irf.blocks.get(bi).name, true)
            bi = bi + 1
        }
        # reachability from the entry block
        let succs: map[str, list[str]] = map_new()
        bi = 0
        while bi < irf.blocks.len() {
            let blk: RVBlock = irf.blocks.get(bi)
            succs.set(blk.name, rv_term_labels(blk, name_set))
            bi = bi + 1
        }
        let reach: map[str, bool] = map_new()
        let work: list[str] = []
        work.push(irf.blocks.get(0).name)
        let mut wi: int = 0
        while wi < work.len() {
            let n: str = work.get(wi)
            wi = wi + 1
            if reach.has(n) {
                continue
            }
            reach.set(n, true)
            let ss: list[str] = succs.get_or(n, [])
            let mut si: int = 0
            while si < ss.len() {
                work.push(ss.get(si))
                si = si + 1
            }
        }
        let sites: list[RVSite] = []
        bi = 0
        while bi < irf.blocks.len() {
            let blk: RVBlock = irf.blocks.get(bi)
            if !reach.has(blk.name) {
                bi = bi + 1
                continue
            }
            let mut ii: int = 0
            while ii < blk.instrs.len() {
                let ins: RVIns = blk.instrs.get(ii)
                let kind: str = rv_site_kind(ins)
                if kind != "" {
                    sites.push(RVSite {
                        kind: kind, line: ins.line, dest: ins.dest,
                        proven: false
                    })
                }
                ii = ii + 1
            }
            bi = bi + 1
        }
        if sites.len() > 0 {
            out.set(fname, sites)
        }
        fi = fi + 1
    }
    return out
}

# ============================================================================
# The baseline harvest — hlrev_collect.harvest_baseline over the native
# AST: every check site the checker's own proof pass ANNOTATED, with
# its verdict. Only functions the proof pass RAN on contribute (the
# run_proof_pass_hlc gate: requires, signature refinements, or body
# refinements — never externs); within them, only the node shapes
# annotate_exprs touches carry a verdict.
# ============================================================================

# rv_proof_ran(ctx, f) — the proof pass's own entry gate.
fn rv_proof_ran(ctx: Ctx, f: FnInfo) -> bool {
    if f.is_extern {
        return false
    }
    if f.requires_e >= 0 {
        return true
    }
    if f.has_refinements {
        return true
    }
    if has_body_refinements(ctx, f.body, 0) {
        return true
    }
    return false
}

# rv_walk_baseline_expr(ctx, e, out) — collect (kind, line, proven)
# for every ANNOTATED check site in an expression tree. Only the node
# shapes annotate_exprs touches carry a verdict (int binops,
# ident-target indexes, ident-receiver byte_at/slice with the right
# arity) — the harvest never invents one.
fn rv_walk_baseline_expr(ctx: Ctx, e: int, out: list[RVSite]) -> void {
    if e < 0 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "bin" && n.t == "int" {
        if n.op == "+" || n.op == "-" || n.op == "*" {
            out.push(RVSite {
                kind: rv_kind_ovf(), line: n.line, dest: "",
                proven: n.ovf_safe
            })
        } else if n.op == "/" || n.op == "%" {
            out.push(RVSite {
                kind: rv_kind_div(), line: n.line, dest: "",
                proven: n.div_safe
            })
        }
    }
    if n.kind == "index" {
        let tn: ExprN = ctx.exprs[n.left]
        if tn.kind == "ident" {
            out.push(RVSite {
                kind: rv_kind_bnd(), line: n.line, dest: "",
                proven: n.bnd_safe
            })
        }
    }
    if n.kind == "method" && (n.mop == "str.byte_at"
    || n.mop == "str.slice") {
        let tn2: ExprN = ctx.exprs[n.left]
        if tn2.kind == "ident" {
            if (n.mop == "str.byte_at" && n.args.len() == 1)
            || (n.mop == "str.slice" && n.args.len() == 2) {
                out.push(RVSite {
                    kind: rv_kind_bnd(), line: n.line, dest: "",
                    proven: n.bnd_safe
                })
            }
        }
    }
    # recurse (annotate_exprs's own walk: left/right, args except
    # match, match arms through the MatchArm table)
    rv_walk_baseline_expr(ctx, n.left, out)
    rv_walk_baseline_expr(ctx, n.right, out)
    if n.kind != "match" {
        let mut i: int = 0
        while i < n.args.len() {
            rv_walk_baseline_expr(ctx, n.args.get(i), out)
            i = i + 1
        }
    }
    if n.kind == "match" {
        let mut a2: int = 0
        while a2 < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a2))
            rv_walk_baseline_expr(ctx, arm.body, out)
            a2 = a2 + 1
        }
    }
}

# rv_walk_baseline_stmts(ctx, stmts, out) — the statement positions the
# prover walks (value / cond / iter / e, an index target's index expr,
# nested bodies).
fn rv_walk_baseline_stmts(ctx: Ctx, stmts: list[int],
out: list[RVSite]) -> void {
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        rv_walk_baseline_expr(ctx, s.value, out)
        rv_walk_baseline_expr(ctx, s.cond, out)
        rv_walk_baseline_expr(ctx, s.iter, out)
        rv_walk_baseline_expr(ctx, s.e, out)
        if s.target >= 0 {
            # assignment-target indexes are ALWAYS checked in every
            # backend — the walk reaches the index EXPRESSION only
            let tgt: ExprN = ctx.exprs[s.target]
            if tgt.kind == "index" {
                rv_walk_baseline_expr(ctx, tgt.right, out)
            }
        }
        rv_walk_baseline_stmts(ctx, s.body, out)
        rv_walk_baseline_stmts(ctx, s.else_body, out)
        i = i + 1
    }
}

# rv_harvest_baseline(ctx) — {fn: [(kind, line, proven)]} in source
# order: the memory-safety evidence the check+proof pass produced.
fn rv_harvest_baseline(ctx: Ctx) -> map[str, list[RVSite]] {
    let out: map[str, list[RVSite]] = map_new()
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if !rv_proof_ran(ctx, f) {
            i = i + 1
            continue
        }
        let sites: list[RVSite] = []
        rv_walk_baseline_stmts(ctx, f.body, sites)
        if sites.len() > 0 {
            out.set(key, sites)
        }
        i = i + 1
    }
    return out
}

# ============================================================================
# The replay — hlrev_ircheck.py's abstract interpreter, restated on the
# native proof module's own fact discipline. The state is a 4-part
# abstract environment over SSA names:
#   ints  — name -> IVal            (int values; INF sentinels = unknown)
#   lenhi — name -> owner           (symbolic i < s.len() bounds; the
#                                    "~"-suffixed form is the slice-END
#                                    bound) plus "~ml~<owner>" minlen keys
#   elems — name -> IVal            (range container element intervals)
#   nz    — name -> bool            (provably != 0)
# The interval arithmetic, the join, the widening and the seeding are
# the proof module's own functions — ONE definition, never forked.
# ============================================================================

struct RState {
    ints: map[str, IVal],
    lenhi: map[str, str],
    elems: map[str, IVal],
    nz: map[str, bool]
}

fn rv_state_new() -> RState {
    let ints: map[str, IVal] = map_new()
    let lenhi: map[str, str] = map_new()
    let elems: map[str, IVal] = map_new()
    let nz: map[str, bool] = map_new()
    return RState {
        ints: ints, lenhi: lenhi, elems: elems, nz: nz
    }
}

fn rv_state_copy(st: RState) -> RState {
    let out: RState = rv_state_new()
    let ik: list[str] = st.ints.keys()
    let mut i: int = 0
    while i < ik.len() {
        let v: IVal = st.ints.get_or(ik.get(i), iv_top())
        out.ints.set(ik.get(i), IVal { lo: v.lo, hi: v.hi })
        i = i + 1
    }
    let lk: list[str] = st.lenhi.keys()
    i = 0
    while i < lk.len() {
        out.lenhi.set(lk.get(i), st.lenhi.get_or(lk.get(i), ""))
        i = i + 1
    }
    let ek: list[str] = st.elems.keys()
    i = 0
    while i < ek.len() {
        let v2: IVal = st.elems.get_or(ek.get(i), iv_top())
        out.elems.set(ek.get(i), IVal { lo: v2.lo, hi: v2.hi })
        i = i + 1
    }
    let nk: list[str] = st.nz.keys()
    i = 0
    while i < nk.len() {
        out.nz.set(nk.get(i), st.nz.get_or(nk.get(i), false))
        i = i + 1
    }
    return out
}

# rv_state_equiv — the fixpoint's stability test (same keys, same
# facts; the dead markers compare as facts).
fn rv_state_equiv(a: RState, b: RState) -> bool {
    if a.nz.len() != b.nz.len() {
        return false
    }
    let nks: list[str] = a.nz.keys()
    let mut i: int = 0
    while i < nks.len() {
        if a.nz.get_or(nks.get(i), false)
        != b.nz.get_or(nks.get(i), false) {
            return false
        }
        i = i + 1
    }
    if a.lenhi.len() != b.lenhi.len() {
        return false
    }
    let lks: list[str] = a.lenhi.keys()
    i = 0
    while i < lks.len() {
        if a.lenhi.get_or(lks.get(i), "")
        != b.lenhi.get_or(lks.get(i), "") {
            return false
        }
        i = i + 1
    }
    if a.elems.len() != b.elems.len() {
        return false
    }
    let eks: list[str] = a.elems.keys()
    i = 0
    while i < eks.len() {
        let va: IVal = a.elems.get_or(eks.get(i), iv_top())
        let vb: IVal = b.elems.get_or(eks.get(i), iv_top())
        if va.lo != vb.lo || va.hi != vb.hi {
            return false
        }
        i = i + 1
    }
    if a.ints.len() != b.ints.len() {
        return false
    }
    let iks: list[str] = a.ints.keys()
    i = 0
    while i < iks.len() {
        let va2: IVal = a.ints.get_or(iks.get(i), iv_top())
        let vb2: IVal = b.ints.get_or(iks.get(i), iv_top())
        if va2.lo != vb2.lo || va2.hi != vb2.hi {
            return false
        }
        i = i + 1
    }
    return true
}

# rv_is_minlen_key — the "~ml~" prefix cannot appear in identifiers.
fn rv_is_minlen_key(k: str) -> bool {
    return k.len() >= 4 && k.slice(0, 4) == "~ml~"
}

# rv_join_states — the join at merge points: intervals take the union
# (iv_join IS the interval join), minlen keeps the weakest lower bound,
# symbolic bounds survive only when both sides agree (the prover's own
# join_lenhi law), elems survive when equal, nz intersects.
fn rv_join_states(a: RState, b: RState) -> RState {
    let out: RState = rv_state_new()
    let ik: list[str] = a.ints.keys()
    let mut i: int = 0
    while i < ik.len() {
        let k: str = ik.get(i)
        if b.ints.has(k) {
            out.ints.set(k, iv_join(a.ints.get_or(k, iv_top()),
            b.ints.get_or(k, iv_top())))
        }
        i = i + 1
    }
    let lk: list[str] = a.lenhi.keys()
    i = 0
    while i < lk.len() {
        let k2: str = lk.get(i)
        if b.lenhi.has(k2) {
            if rv_is_minlen_key(k2) {
                let na: int = rv_str_int(a.lenhi.get_or(k2, "0"))
                let nb: int = rv_str_int(b.lenhi.get_or(k2, "0"))
                if na <= nb {
                    out.lenhi.set(k2, a.lenhi.get_or(k2, "0"))
                } else {
                    out.lenhi.set(k2, b.lenhi.get_or(k2, "0"))
                }
            } else {
                let va: str = a.lenhi.get_or(k2, "")
                let vb: str = b.lenhi.get_or(k2, "")
                if va == vb && va != "" {
                    out.lenhi.set(k2, va)
                }
            }
        }
        i = i + 1
    }
    let ek: list[str] = a.elems.keys()
    i = 0
    while i < ek.len() {
        let k3: str = ek.get(i)
        if b.elems.has(k3) {
            let va2: IVal = a.elems.get_or(k3, iv_top())
            let vb2: IVal = b.elems.get_or(k3, iv_top())
            if va2.lo == vb2.lo && va2.hi == vb2.hi {
                out.elems.set(k3, IVal { lo: va2.lo, hi: va2.hi })
            }
        }
        i = i + 1
    }
    let nk: list[str] = a.nz.keys()
    i = 0
    while i < nk.len() {
        let k4: str = nk.get(i)
        if b.nz.has(k4) {
            out.nz.set(k4, a.nz.get_or(k4, false)
            && b.nz.get_or(k4, false))
        }
        i = i + 1
    }
    return out
}

# rv_widen_state — the widening at a loop head: interval bounds that
# GREW escape to infinity (widen_growth_iv), minlen keeps its lower
# bound while it did not shrink, symbolic bounds survive when both
# sides agree, elems are loop-invariant, nz intersects.
fn rv_widen_state(prev: RState, inp: RState) -> RState {
    let out: RState = rv_state_new()
    let ik: list[str] = prev.ints.keys()
    let mut i: int = 0
    while i < ik.len() {
        let k: str = ik.get(i)
        out.ints.set(k, widen_growth_iv(prev.ints.get_or(k, iv_top()),
        inp.ints.get_or(k, iv_top())))
        i = i + 1
    }
    let ik2: list[str] = inp.ints.keys()
    i = 0
    while i < ik2.len() {
        let k2: str = ik2.get(i)
        if !out.ints.has(k2) {
            out.ints.set(k2, widen_growth_iv(prev.ints.get_or(k2, iv_top()),
            inp.ints.get_or(k2, iv_top())))
        }
        i = i + 1
    }
    let lk: list[str] = prev.lenhi.keys()
    i = 0
    while i < lk.len() {
        let k3: str = lk.get(i)
        if inp.lenhi.has(k3) {
            if rv_is_minlen_key(k3) {
                let pv: int = rv_str_int(prev.lenhi.get_or(k3, "0"))
                let iv: int = rv_str_int(inp.lenhi.get_or(k3, "0"))
                if iv >= pv {
                    out.lenhi.set(k3, prev.lenhi.get_or(k3, "0"))
                } else {
                    out.lenhi.set(k3, "0")
                }
            } else {
                let pv2: str = prev.lenhi.get_or(k3, "")
                let iv2: str = inp.lenhi.get_or(k3, "")
                if pv2 == iv2 && pv2 != "" {
                    out.lenhi.set(k3, pv2)
                }
            }
        }
        i = i + 1
    }
    let ek: list[str] = prev.elems.keys()
    i = 0
    while i < ek.len() {
        let k4: str = ek.get(i)
        if inp.elems.has(k4) {
            let va: IVal = prev.elems.get_or(k4, iv_top())
            let vb: IVal = inp.elems.get_or(k4, iv_top())
            if va.lo == vb.lo && va.hi == vb.hi {
                out.elems.set(k4, IVal { lo: va.lo, hi: va.hi })
            }
        }
        i = i + 1
    }
    let nk: list[str] = prev.nz.keys()
    i = 0
    while i < nk.len() {
        let k5: str = nk.get(i)
        if inp.nz.has(k5) {
            out.nz.set(k5, prev.nz.get_or(k5, false)
            && inp.nz.get_or(k5, false))
        }
        i = i + 1
    }
    return out
}

# rv_invalidate_value_facts — reassigning a binding kills every fact
# derived from its value (the prover's own invalidate_value_facts: the
# nz entry, the minlen, every symbolic bound pointing at it).
fn rv_invalidate_value_facts(st: RState, tname: str) -> void {
    st.nz.set(tname, false)
    let mlkey: str = "~ml~" + tname
    if st.lenhi.has(mlkey) {
        st.lenhi.set(mlkey, "0")
    }
    let keys: list[str] = st.lenhi.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        if !rv_is_minlen_key(k) {
            let owner: str = st.lenhi.get_or(k, "")
            if owner == tname || owner == tname + "~" {
                st.lenhi.set(k, "")
            }
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# Seeding — seed_function's mirror: requires + parameter refinements
# through the proof module's own seed_from_requires / seed_from_pred,
# source names mapped to IR value names (v_<name>).
# ----------------------------------------------------------------------------

struct RVSeed {
    st: RState,
    has: bool
}

fn rv_seed_function(ctx: Ctx, f: FnInfo) -> RVSeed {
    let none: RVSeed = RVSeed {
        st: rv_state_new(), has: false
    }
    if (f.requires_e < 0 && f.param_preds.len() == 0) || f.is_extern {
        return none
    }
    let facts: map[str, IVal] = map_new()
    let facts_lenhi: map[str, str] = map_new()
    let nz: map[str, bool] = map_new()
    if f.requires_e >= 0 {
        seed_from_requires(ctx, f.requires_e, f, facts, facts_lenhi, nz)
    }
    # parameter refinements (`d: int where self != 0`) — each pred
    # talks about its own binder, seeded under the parameter's name
    let mut pi: int = 0
    while pi < f.params.len() {
        let pn: str = f.params.get(pi)
        if f.param_preds.has(pn) {
            let text: str = f.param_preds.get_or(pn, "")
            let pe: int = ctx.rpreds.get_or(text, -1)
            if pe >= 0 && f.ptypes.get(pi) == "int" {
                seed_from_pred(ctx, pe, pn, facts, nz)
            }
        }
        pi = pi + 1
    }
    # map the facts onto IR value names
    let st: RState = rv_state_new()
    let fk: list[str] = facts.keys()
    let mut i: int = 0
    while i < fk.len() {
        st.ints.set("v_" + fk.get(i), facts.get_or(fk.get(i), iv_top()))
        i = i + 1
    }
    let lhk: list[str] = facts_lenhi.keys()
    i = 0
    while i < lhk.len() {
        let k: str = lhk.get(i)
        let v: str = facts_lenhi.get_or(k, "")
        if rv_is_minlen_key(k) {
            # k = "~ml~<owner>" — the owner rides under v_<owner>
            let owner: str = k.slice(4, k.len())
            st.lenhi.set("~ml~v_" + owner, v)
        } else {
            # strict bound: "v_<owner>"; slice-END bound: "v_<owner>~"
            st.lenhi.set("v_" + k, "v_" + v)
        }
        i = i + 1
    }
    let nzk: list[str] = nz.keys()
    i = 0
    while i < nzk.len() {
        if nz.get_or(nzk.get(i), false) {
            st.nz.set("v_" + nzk.get(i), true)
        }
        i = i + 1
    }
    return RVSeed {
        st: st, has: true
    }
}

# ----------------------------------------------------------------------------
# The per-function replay result.
# ----------------------------------------------------------------------------

struct RVVerdict {
    kind: str,
    line: int,
    dest: str,
    proven: bool,
    cert: str
}

struct RVAnnot {
    line: int,
    dest: str,
    certified: bool,
    cert: str
}

struct RVInteg {
    iclass: str,
    text: str
}

struct RVRes {
    verdicts: list[RVVerdict],
    annotations: list[RVAnnot],
    integrity: list[RVInteg],
    blocks: int,
    widened_loops: int,
    iterations: int
}

fn rv_res_new() -> RVRes {
    return RVRes {
        verdicts: [], annotations: [], integrity: [],
        blocks: 0, widened_loops: 0, iterations: 0
    }
}

# ----------------------------------------------------------------------------
# The transfer function's helpers.
# ----------------------------------------------------------------------------

# rv_iv_of(st, arg) — the interval of an operand.
fn rv_iv_of(st: RState, arg: RVArg) -> IVal {
    if arg.tag == "lit" {
        if arg.lty == "int" {
            return IVal { lo: arg.ival, hi: arg.ival }
        }
        return iv_top()
    }
    if arg.tag == "var" {
        return st.ints.get_or(arg.sval, iv_top())
    }
    return iv_top()
}

# rv_identity_cert(op, a_arg, b_arg, st) — the pinned algebraic
# identity certificate for a binop, "" when none. A literal operand
# may arrive as a lit or as a var whose interval is the constant
# (const-folded temps keep their var spelling).
fn rv_cert_is_lit(st: RState, arg: RVArg, v: int) -> bool {
    if arg.tag == "lit" {
        if arg.lty == "int" {
            return arg.ival == v
        }
        return false
    }
    if arg.tag == "var" {
        let iv: IVal = st.ints.get_or(arg.sval, iv_top())
        return iv.lo == v && iv.hi == v
    }
    return false
}

fn rv_identity_cert(op: str, a_arg: RVArg, b_arg: RVArg,
st: RState) -> str {
    if op == "+" {
        if rv_cert_is_lit(st, b_arg, 0) {
            return "alg:add-zero-right"
        }
        if rv_cert_is_lit(st, a_arg, 0) {
            return "alg:add-zero-left"
        }
    } else if op == "-" {
        if rv_cert_is_lit(st, b_arg, 0) {
            return "alg:sub-zero-right"
        }
    } else if op == "*" {
        if rv_cert_is_lit(st, b_arg, 0) {
            return "alg:mul-zero-right"
        }
        if rv_cert_is_lit(st, a_arg, 0) {
            return "alg:mul-zero-left"
        }
        if rv_cert_is_lit(st, b_arg, 1) {
            return "alg:mul-one-right"
        }
        if rv_cert_is_lit(st, a_arg, 1) {
            return "alg:mul-one-left"
        }
    }
    return ""
}

# rv_arg_var_name(arg) — the var name, "" otherwise.
fn rv_arg_var_name(arg: RVArg) -> str {
    if arg.tag == "var" {
        return arg.sval
    }
    return ""
}

# rv_get_minlen(st, owner) — the container's known minimum length
# (0 = none).
fn rv_get_minlen(st: RState, owner: str) -> int {
    let key: str = "~ml~" + owner
    if !st.lenhi.has(key) {
        return 0
    }
    let v: int = rv_str_int(st.lenhi.get_or(key, "0"))
    if v < 0 {
        return 0
    }
    return v
}

# rv_bounds_proven(st, ins, owner_pos, idx_pos) — the two bounds
# routes (check_index_safe / check_byte_at_safe's mirror): index lo
# >= 0 AND (symbolic: the index var carries a STRICT len bound
# pointing at this container) OR (numeric: index hi below the
# container's known minimum length).
fn rv_bounds_proven(st: RState, ins: RVIns, owner_pos: int,
idx_pos: int) -> bool {
    let mut ii: IVal = iv_top()
    if ins.args.len() > idx_pos {
        ii = rv_iv_of(st, ins.args.get(idx_pos))
    }
    if ii.lo == INF_LO() || ii.lo < 0 {
        return false
    }
    let mut o: RVArg = rv_arg_lit_null()
    if ins.args.len() > owner_pos {
        o = ins.args.get(owner_pos)
    }
    let owner: str = rv_arg_var_name(o)
    if owner == "" {
        return false
    }
    # symbolic route: idx var's strict bound points at this container
    let mut idx_name: str = ""
    if ins.args.len() > idx_pos {
        idx_name = rv_arg_var_name(ins.args.get(idx_pos))
    }
    if idx_name != "" {
        let bound: str = st.lenhi.get_or(idx_name, "")
        if bound == owner {
            return true
        }
    }
    # numeric route: index hi < minlen[container]
    let ml: int = rv_get_minlen(st, owner)
    if ml > 0 && ii.hi != INF_HI() && ii.hi < ml {
        return true
    }
    return false
}

# rv_slice_proven(st, ins) — check_slice_safe's mirror: 0 <= a,
# a <= b PROVEN, and b's end bound valid (the strict or the "~"-
# suffixed symbolic bound, or numeric below the minlen).
fn rv_slice_proven(st: RState, ins: RVIns) -> bool {
    let mut ai: IVal = iv_top()
    let mut bi: IVal = iv_top()
    if ins.args.len() > 2 {
        ai = rv_iv_of(st, ins.args.get(2))
    }
    if ins.args.len() > 3 {
        bi = rv_iv_of(st, ins.args.get(3))
    }
    if ai.lo == INF_LO() || ai.lo < 0 {
        return false
    }
    if !(ai.hi != INF_HI() && bi.lo != INF_LO() && ai.hi <= bi.lo) {
        return false
    }
    let mut o: RVArg = rv_arg_lit_null()
    if ins.args.len() > 1 {
        o = ins.args.get(1)
    }
    let owner: str = rv_arg_var_name(o)
    if owner == "" {
        return false
    }
    # b's end: symbolic (strict or slice-END bound) or numeric
    let mut b_name: str = ""
    if ins.args.len() > 3 {
        b_name = rv_arg_var_name(ins.args.get(3))
    }
    if b_name != "" {
        let bound: str = st.lenhi.get_or(b_name, "")
        if bound == owner || bound == owner + "~" {
            return true
        }
    }
    let ml: int = rv_get_minlen(st, owner)
    if ml > 0 && bi.hi != INF_HI() && bi.hi < ml {
        return true
    }
    return false
}

# ----------------------------------------------------------------------------
# The transfer proper — one instruction against the state; when
# `verdicts`, record the check-site verdict and the fast-annotation
# audit. Mirrors the proof module's precision EXACTLY: an interval
# result is tracked only where expr_interval computes one.
# ----------------------------------------------------------------------------

fn rv_transfer_instr(ctx: Ctx, ins: RVIns, st: RState, res: RVRes,
verdicts: bool) -> void {
    let op: str = ins.op
    let dest: str = ins.dest

    if op == "const" {
        if ins.args.len() > 0 && ins.args.get(0).tag == "lit" {
            let a: RVArg = ins.args.get(0)
            if a.lty == "int" {
                st.ints.set(dest, IVal { lo: a.ival, hi: a.ival })
            }
        }
        return
    }

    if op == "load" {
        let mut src: RVArg = rv_arg_var("?")
        if ins.args.len() > 0 {
            src = ins.args.get(0)
        }
        let src_name: str = rv_arg_var_name(src)
        if src_name != "" {
            if st.ints.has(src_name) {
                st.ints.set(dest, st.ints.get_or(src_name, iv_top()))
            } else {
                st.ints.set(dest, iv_top())
            }
            if st.nz.get_or(src_name, false) {
                st.nz.set(dest, true)
            }
            let mlkey: str = "~ml~" + src_name
            if st.lenhi.has(mlkey) {
                st.lenhi.set("~ml~" + dest,
                st.lenhi.get_or(mlkey, "0"))
            }
            if st.elems.has(src_name) {
                st.elems.set(dest, st.elems.get_or(src_name, iv_top()))
            }
            # a symbolic len bound rides the value: the alias carries it
            if !rv_is_minlen_key(src_name) {
                let bound: str = st.lenhi.get_or(src_name, "")
                if bound != "" {
                    st.lenhi.set(dest, bound)
                } else {
                    st.lenhi.set(dest, "")
                }
            }
        }
        # Stage 98 refinement guard: the post-guard facts are the
        # pred's interval over the value's interval plus the pred's
        # non-zero conjuncts — run_proof_pass_hlc's own law, through
        # the ONE definition (refine_pred_interval / seed_refine_nz).
        if ins.rpred != "" && ins.ty == "int" {
            let pe: int = ctx.rpreds.get_or(ins.rpred, -1)
            if pe >= 0 {
                let base_iv: IVal = st.ints.get_or(dest, iv_top())
                st.ints.set(dest, refine_pred_interval(ctx, pe, base_iv))
                seed_refine_nz(ctx, pe, dest, st.nz)
            }
        }
        return
    }

    if op == "store" {
        let mut src: RVArg = rv_arg_var("?")
        if ins.args.len() > 0 {
            src = ins.args.get(0)
        }
        let mut binding: str = dest
        if ins.args.len() > 1 && ins.args.get(1).tag == "name" {
            binding = "v_" + ins.args.get(1).sval
        }
        # value-derived facts about the reassigned binding die
        rv_invalidate_value_facts(st, binding)
        st.elems.set(binding, iv_top())
        let src_name: str = rv_arg_var_name(src)
        if src_name != "" {
            if st.ints.has(src_name) {
                st.ints.set(binding, st.ints.get_or(src_name, iv_top()))
            } else {
                st.ints.set(binding, iv_top())
            }
            if st.nz.get_or(src_name, false) {
                st.nz.set(binding, true)
            }
            let mlkey: str = "~ml~" + src_name
            if st.lenhi.has(mlkey) {
                st.lenhi.set("~ml~" + binding,
                st.lenhi.get_or(mlkey, "0"))
            }
            if st.elems.has(src_name) {
                st.elems.set(binding, st.elems.get_or(src_name, iv_top()))
            }
            if !rv_is_minlen_key(src_name) {
                let bound: str = st.lenhi.get_or(src_name, "")
                if bound != "" {
                    st.lenhi.set(binding, bound)
                }
            }
        } else if src.tag == "lit" {
            if src.lty == "int" {
                st.ints.set(binding, IVal { lo: src.ival, hi: src.ival })
            } else {
                st.ints.set(binding, iv_top())
            }
        }
        # Stage 98 refinement guard on the reassigned binding — the
        # same post-guard facts as a refined let
        if ins.rpred != "" && ins.ty == "int" {
            let pe: int = ctx.rpreds.get_or(ins.rpred, -1)
            if pe >= 0 {
                let base_iv: IVal = st.ints.get_or(binding, iv_top())
                st.ints.set(binding, refine_pred_interval(ctx, pe, base_iv))
                seed_refine_nz(ctx, pe, binding, st.nz)
            }
        }
        return
    }

    if op == "binop" {
        let kind: str = rv_binop_site(ins)
        let mut proven: bool = false
        let mut cert: str = ""
        if ins.args.len() >= 3 && ins.args.get(0).tag == "op" {
            let opname: str = ins.args.get(0).sval
            let a_arg: RVArg = ins.args.get(1)
            let b_arg: RVArg = ins.args.get(2)
            let ai: IVal = rv_iv_of(st, a_arg)
            let bi: IVal = rv_iv_of(st, b_arg)
            if kind == rv_kind_ovf() {
                let mut iv: IVal = iv_top()
                if opname == "+" {
                    proven = iv_fits(iv_add(ai, bi))
                    iv = iv_add(ai, bi)
                } else if opname == "-" {
                    proven = iv_fits(iv_sub(ai, bi))
                    iv = iv_sub(ai, bi)
                } else {
                    proven = iv_fits(iv_mul(ai, bi))
                    iv = iv_mul(ai, bi)
                }
                cert = rv_identity_cert(opname, a_arg, b_arg, st)
                if (iv.lo != INF_LO() || iv.hi != INF_HI()) && dest != "" {
                    st.ints.set(dest, iv)
                }
            } else if kind == rv_kind_div() {
                let mut nz: bool = iv_excl_zero(bi)
                if !nz {
                    let bn: str = rv_arg_var_name(b_arg)
                    if bn != "" && st.nz.get_or(bn, false) {
                        nz = true
                    }
                }
                if nz {
                    # the INT64_MIN / -1 corner: the dividend may be
                    # INT64_MIN and the divisor interval includes -1
                    let can_be_min: bool = ai.lo == INF_LO()
                    if can_be_min {
                        let lo_incl: bool = bi.lo == INF_LO()
                        || bi.lo <= -1
                        let hi_incl: bool = bi.hi == INF_HI()
                        || bi.hi >= -1
                        if lo_incl && hi_incl {
                            nz = false
                        }
                    }
                }
                proven = nz
            }
            if verdicts && kind != "" {
                res.verdicts.push(RVVerdict {
                    kind: kind, line: ins.line, dest: dest,
                    proven: proven, cert: cert
                })
                if ins.safe_overflow {
                    # the fast-annotation audit: certified by an
                    # interval proof at THIS program point, or by a
                    # pinned identity
                    let certified: bool = proven || cert != ""
                    let mut crec: str = cert
                    if crec == "" && proven {
                        crec = "interval"
                    }
                    res.annotations.push(RVAnnot {
                        line: ins.line, dest: dest, certified: certified,
                        cert: crec
                    })
                }
            }
        }
        return
    }

    if op == "unop" {
        if ins.args.len() >= 2 && ins.args.get(0).tag == "op"
        && ins.args.get(0).sval == "-" && dest != "" {
            let iv: IVal = iv_neg(rv_iv_of(st, ins.args.get(1)))
            if iv.lo != INF_LO() || iv.hi != INF_HI() {
                st.ints.set(dest, iv)
            }
        }
        return
    }

    if op == "list_new" {
        st.lenhi.set("~ml~" + dest, ins.args.len().to_str())
        return
    }

    if op == "list_len" {
        let mut src: RVArg = rv_arg_var("?")
        if ins.args.len() > 0 {
            src = ins.args.get(0)
        }
        let src_name: str = rv_arg_var_name(src)
        if src_name != "" && dest != "" {
            let ml: int = rv_get_minlen(st, src_name)
            if ml > 0 {
                st.ints.set(dest, IVal { lo: ml, hi: INF_HI() })
            }
        }
        return
    }

    if op == "call" {
        # `range(a, b)` with constant bounds: the container's length is
        # b-a and its elements are a..b-1 (the IR lowering treats range
        # as a list-like container; the prover's const-range seeding
        # knows exactly these numbers).
        if ins.args.len() == 3 && ins.args.get(0).tag == "fname"
        && ins.args.get(0).sval == "range" && dest != "" {
            let a_iv: IVal = rv_iv_of(st, ins.args.get(1))
            let b_iv: IVal = rv_iv_of(st, ins.args.get(2))
            if a_iv.lo == a_iv.hi && b_iv.lo == b_iv.hi {
                let a_v: int = a_iv.lo
                let b_v: int = b_iv.lo
                # span = max(0, b-a) with the int64 overflow guarded
                if b_v > a_v {
                    let mut span: int = 0
                    if a_v >= 0 {
                        span = b_v - a_v
                    } else if b_v <= INF_HI() + a_v {
                        span = b_v - a_v
                    } else {
                        span = INF_HI()
                    }
                    st.lenhi.set("~ml~" + dest, span.to_str())
                    st.elems.set(dest, IVal { lo: a_v, hi: b_v - 1 })
                } else {
                    st.lenhi.set("~ml~" + dest, "0")
                }
            }
        }
        # every other call: results unknown (TOP)
        return
    }

    if op == "list_get" {
        let mut src: RVArg = rv_arg_var("?")
        if ins.args.len() > 0 {
            src = ins.args.get(0)
        }
        let generated: bool = rv_is_generated_for(ins)
        if !generated {
            let proven2: bool = rv_bounds_proven(st, ins, 0, 1)
            if verdicts {
                res.verdicts.push(RVVerdict {
                    kind: rv_kind_bnd(), line: ins.line, dest: dest,
                    proven: proven2, cert: ""
                })
            }
        }
        # the loop variable read out of a range container carries the
        # container's element interval; out of a list it is TOP
        let src_name: str = rv_arg_var_name(src)
        if src_name != "" && st.elems.has(src_name) && dest != "" {
            st.ints.set(dest, st.elems.get_or(src_name, iv_top()))
        }
        return
    }

    if op == "list_set" {
        if verdicts {
            let proven3: bool = rv_bounds_proven(st, ins, 0, 1)
            res.verdicts.push(RVVerdict {
                kind: rv_kind_set(), line: ins.line, dest: dest,
                proven: proven3, cert: ""
            })
        }
        return
    }

    if op == "method" {
        let kind: str = rv_method_site(ins)
        let mut name: str = ""
        if ins.args.len() > 0 && ins.args.get(0).tag == "name" {
            name = ins.args.get(0).sval
        }
        if kind == rv_kind_bnd() {
            let mut proven4: bool = false
            if name == "byte_at" {
                proven4 = rv_bounds_proven(st, ins, 1, 2)
            } else {
                proven4 = rv_slice_proven(st, ins)
            }
            if verdicts {
                res.verdicts.push(RVVerdict {
                    kind: kind, line: ins.line, dest: dest,
                    proven: proven4, cert: ""
                })
            }
        } else if name == "len" && ins.args.len() > 1 {
            let recv: RVArg = ins.args.get(1)
            let recv_name: str = rv_arg_var_name(recv)
            if recv_name != "" && dest != "" {
                let ml: int = rv_get_minlen(st, recv_name)
                if ml > 0 {
                    st.ints.set(dest, IVal { lo: ml, hi: INF_HI() })
                }
            }
        } else if (name == "push" || name == "pop")
        && ins.args.len() > 1 {
            let recv2: RVArg = ins.args.get(1)
            let recv2_name: str = rv_arg_var_name(recv2)
            if recv2_name != "" {
                # the receiver's length facts die (push/pop mutate it)
                rv_invalidate_value_facts(st, recv2_name)
            }
        }
        return
    }

    # qmark / struct_* / map_* / panic / comment: results unknown —
    # the IR is post-check; nothing tracked mutates here.
    if op == "qmark" && dest != "" {
        let mut src: RVArg = rv_arg_var("?")
        if ins.args.len() > 0 {
            src = ins.args.get(0)
        }
        let src_name: str = rv_arg_var_name(src)
        if src_name != "" && st.ints.has(src_name) {
            st.ints.set(dest, st.ints.get_or(src_name, iv_top()))
        }
    }
}

# ----------------------------------------------------------------------------
# The analysis — analyze_function's own: CFG + structural integrity,
# dominators, loop headers, reverse postorder, the dataflow fixpoint
# with widening, the post-fixpoint containment verification, and the
# final verdict pass in layout order.
# ----------------------------------------------------------------------------

struct RVBox {
    st: RState,
    has: bool
}

struct RVFix {
    ctx: Ctx,
    irf: RVFn,
    entry_st: RState,
    names: list[str],
    succs: map[str, list[str]],
    preds: map[str, list[str]],
    headers: map[str, bool],
    rpo: list[str],
    state_in: map[str, RState],
    state_in_has: map[str, bool],
    state_out: map[str, RState],
    state_out_has: map[str, bool],
    prev_in: map[str, RState],
    prev_in_has: map[str, bool]
}

# rv_block_input(fx, n) — the entry state copy for the entry block, the
# join of the predecessors' outs otherwise.
fn rv_block_input(fx: RVFix, n: str) -> RVBox {
    if n == fx.irf.blocks.get(0).name {
        return RVBox {
            st: rv_state_copy(fx.entry_st), has: true
        }
    }
    let acc: RVBox = RVBox {
        st: rv_state_new(), has: false
    }
    let ps: list[str] = fx.preds.get_or(n, [])
    let mut i: int = 0
    while i < ps.len() {
        let p: str = ps.get(i)
        if fx.state_out_has.get_or(p, false) {
            let so: RState = fx.state_out.get_or(p, rv_state_new())
            if !acc.has {
                acc.st = rv_state_copy(so)
                acc.has = true
            } else {
                acc.st = rv_join_states(acc.st, so)
            }
        }
        i = i + 1
    }
    return acc
}

# rv_transfer_block(blk, st) — one block's transfer function (no
# verdict recording — the final pass re-walks).
fn rv_transfer_block(ctx: Ctx, blk: RVBlock, st: RState) -> RState {
    let out: RState = rv_state_copy(st)
    let scratch: RVRes = rv_res_new()
    let mut i: int = 0
    while i < blk.instrs.len() {
        rv_transfer_instr(ctx, blk.instrs.get(i), out, scratch, false)
        i = i + 1
    }
    return out
}

# rv_run_fixpoint(fx, res) — the worklist walk in reverse postorder,
# widening at loop headers, bounded by MAX_ROUNDS visits per block.
fn rv_run_fixpoint(fx: RVFix, res: RVRes) -> void {
    let seen_rounds: map[str, int] = map_new()
    let names: list[str] = fx.names
    let mut ni: int = 0
    while ni < names.len() {
        seen_rounds.set(names.get(ni), 0)
        ni = ni + 1
    }
    let queue: list[str] = []
    let mut ri: int = 0
    while ri < fx.rpo.len() {
        queue.push(fx.rpo.get(ri))
        ri = ri + 1
    }
    let mut qi: int = 0
    while qi < queue.len() {
        let n: str = queue.get(qi)
        qi = qi + 1
        seen_rounds.set(n, seen_rounds.get_or(n, 0) + 1)
        res.iterations = res.iterations + 1
        if seen_rounds.get_or(n, 0) > rv_max_rounds() {
            continue
        }
        let inp: RVBox = rv_block_input(fx, n)
        if !inp.has {
            continue
        }
        let mut st: RState = inp.st
        if fx.headers.has(n) && fx.prev_in_has.get_or(n, false) {
            st = rv_widen_state(fx.prev_in.get_or(n, rv_state_new()),
            inp.st)
        }
        if fx.state_in_has.get_or(n, false)
        && rv_state_equiv(fx.state_in.get_or(n, rv_state_new()), st) {
            continue
        }
        fx.prev_in.set(n, rv_state_copy(st))
        fx.prev_in_has.set(n, true)
        fx.state_in.set(n, st)
        fx.state_in_has.set(n, true)
        let blk: RVBlock = fx.irf.blocks.get(rv_block_index(fx.irf, n))
        fx.state_out.set(n, rv_transfer_block(fx.ctx, blk, st))
        fx.state_out_has.set(n, true)
        let ss: list[str] = fx.succs.get_or(n, [])
        let mut si: int = 0
        while si < ss.len() {
            let s: str = ss.get(si)
            if seen_rounds.get_or(s, 0) <= rv_max_rounds() {
                queue.push(s)
            }
            si = si + 1
        }
    }
}

# rv_verify_pass(fx, res) — the post-fixpoint containment verification
# (the mirror of the AST engine's soundness pass): re-run every block
# from its stabilised input; anything that still grows escapes the
# invariant and goes TOP; then the fixpoint re-runs once more. Bounded.
fn rv_verify_pass(fx: RVFix, res: RVRes) -> void {
    let mut round: int = 0
    while round < 4 {
        let mut grew_any: bool = false
        let mut ri: int = 0
        while ri < fx.rpo.len() {
            let n: str = fx.rpo.get(ri)
            ri = ri + 1
            if !fx.state_in_has.get_or(n, false) {
                continue
            }
            let blk: RVBlock = fx.irf.blocks.get(rv_block_index(fx.irf, n))
            let out: RState = rv_transfer_block(fx.ctx, blk,
            fx.state_in.get_or(n, rv_state_new()))
            if !fx.state_out_has.get_or(n, false) {
                fx.state_out.set(n, out)
                fx.state_out_has.set(n, true)
                continue
            }
            let cur: RState = fx.state_out.get_or(n, rv_state_new())
            # ints: an outcome the stabilised output cannot contain
            # sends the variable TOP
            let ik: list[str] = out.ints.keys()
            let mut i: int = 0
            while i < ik.len() {
                let k: str = ik.get(i)
                if cur.ints.has(k) {
                    let v: IVal = out.ints.get_or(k, iv_top())
                    let cv: IVal = cur.ints.get_or(k, iv_top())
                    if !iv_contains(cv, v) {
                        cur.ints.set(k, iv_top())
                        grew_any = true
                    }
                }
                i = i + 1
            }
            # minlen: an outcome that lost or shrank the lower bound
            # kills the fact
            let lk: list[str] = out.lenhi.keys()
            i = 0
            while i < lk.len() {
                let k2: str = lk.get(i)
                if rv_is_minlen_key(k2) && cur.lenhi.has(k2) {
                    let ov: int = rv_str_int(out.lenhi.get_or(k2, "0"))
                    let cv2: int = rv_str_int(cur.lenhi.get_or(k2, "0"))
                    if ov < cv2 {
                        cur.lenhi.set(k2, "0")
                        grew_any = true
                    }
                }
                i = i + 1
            }
        }
        if !grew_any {
            break
        }
        rv_run_fixpoint(fx, res)
        round = round + 1
    }
}

# rv_check_integrity(ins, blkname, defined, res, where_fn) —
# referential integrity of one instruction against the defs seen so
# far (layout order + position = a valid topological order for these
# reducible CFGs).
fn rv_check_integrity(ins: RVIns, blkname: str, defined: map[str, bool],
res: RVRes, where_fn: str) -> void {
    let where_txt: str = where_fn + ": " + ins.op + " in block " + blkname
    + " (line " + ins.line.to_str() + ")"
    let mut i: int = 0
    while i < ins.args.len() {
        let a: RVArg = ins.args.get(i)
        if a.tag == "var" && !defined.has(a.sval) {
            res.integrity.push(RVInteg {
                iclass: "dangling-var",
                text: where_txt + " reads undefined value " + a.sval
            })
        }
        i = i + 1
    }
}

# rv_analyze_function(ctx, irf, seed) — the dataflow fixpoint + the
# final verdict pass. The seed may be absent (no contract): the analysis
# still runs — integrity and the annotation audit cover EVERY function;
# replayed ELISION claims only exist where the prover's seeds do. The
# ctx resolves refinement-guard texts (ctx.rpreds) — a synthetic IR
# with an empty ctx simply carries no guards.
fn rv_analyze_function(ctx: Ctx, irf: RVFn, seed: RVSeed) -> RVRes {
    let res: RVRes = rv_res_new()
    if irf.blocks.len() == 0 {
        return res
    }
    res.blocks = irf.blocks.len()
    let fx: RVFix = RVFix {
        ctx: ctx,
        irf: irf,
        entry_st: rv_state_new(),
        names: [],
        succs: map_new(),
        preds: map_new(),
        headers: map_new(),
        rpo: [],
        state_in: map_new(),
        state_in_has: map_new(),
        state_out: map_new(),
        state_out_has: map_new(),
        prev_in: map_new(),
        prev_in_has: map_new()
    }
    if seed.has {
        fx.entry_st = seed.st
    }
    let where_fn: str = "function " + irf.name

    # ---- CFG + the structural integrity that needs no dataflow ----
    let names: list[str] = []
    let name_set: map[str, bool] = map_new()
    let mut bi: int = 0
    while bi < irf.blocks.len() {
        names.push(irf.blocks.get(bi).name)
        name_set.set(irf.blocks.get(bi).name, true)
        bi = bi + 1
    }
    fx.names = names
    let entry: str = names.get(0)
    bi = 0
    while bi < irf.blocks.len() {
        let blk: RVBlock = irf.blocks.get(bi)
        if !blk.has_term {
            res.integrity.push(RVInteg {
                iclass: "block-terminator",
                text: where_fn + ": block " + blk.name
                + " has no terminator"
            })
            fx.succs.set(blk.name, [])
        } else if blk.term.op == "branch" || blk.term.op == "jump" {
            let ss: list[str] = []
            let mut ai: int = 0
            while ai < blk.term.args.len() {
                let a: RVArg = blk.term.args.get(ai)
                if a.tag == "label" {
                    if name_set.has(a.sval) {
                        ss.push(a.sval)
                    } else {
                        res.integrity.push(RVInteg {
                            iclass: "dangling-label",
                            text: where_fn + ": branch in " + blk.name
                            + " targets unknown block " + a.sval
                        })
                    }
                }
                ai = ai + 1
            }
            if blk.term.op == "branch"
            && (blk.term.args.len() == 0
            || blk.term.args.get(0).tag != "var") {
                res.integrity.push(RVInteg {
                    iclass: "branch-shape",
                    text: where_fn + ": branch in " + blk.name
                    + " lacks a condition value"
                })
            }
            fx.succs.set(blk.name, ss)
        } else {
            fx.succs.set(blk.name, [])
        }
        bi = bi + 1
    }
    # preds
    bi = 0
    while bi < irf.blocks.len() {
        let blk2: RVBlock = irf.blocks.get(bi)
        if !fx.preds.has(blk2.name) {
            let empty: list[str] = []
            fx.preds.set(blk2.name, empty)
        }
        bi = bi + 1
    }
    bi = 0
    while bi < irf.blocks.len() {
        let blk3: RVBlock = irf.blocks.get(bi)
        let ss2: list[str] = fx.succs.get_or(blk3.name, [])
        let mut si: int = 0
        while si < ss2.len() {
            fx.preds.get_or(ss2.get(si), []).push(blk3.name)
            si = si + 1
        }
        bi = bi + 1
    }
    # reachability
    let reach: map[str, bool] = map_new()
    let work: list[str] = []
    work.push(entry)
    let mut wi: int = 0
    while wi < work.len() {
        let n: str = work.get(wi)
        wi = wi + 1
        if reach.has(n) {
            continue
        }
        reach.set(n, true)
        let ss3: list[str] = fx.succs.get_or(n, [])
        let mut si2: int = 0
        while si2 < ss3.len() {
            work.push(ss3.get(si2))
            si2 = si2 + 1
        }
    }
    let mut ni: int = 0
    while ni < names.len() {
        if !reach.has(names.get(ni)) {
            # A NOTE, not a failure: the LOWERING legitimately emits
            # unreachable blocks (an `if` whose both branches return
            # leaves its endif without predecessors). The optimiser
            # never removes an edge, so unreachable blocks here are
            # inherited, not created — and their sites are excluded
            # from the harvest (nothing unreachable ever executes).
            res.integrity.push(RVInteg {
                iclass: "unreachable-block-note",
                text: where_fn + ": block " + names.get(ni)
                + " is unreachable (inherited from the lowering)"
            })
        }
        ni = ni + 1
    }

    # ---- dominators (iterative, textbook) ----
    let dom: map[str, map[str, bool]] = map_new()
    ni = 0
    while ni < names.len() {
        let full: map[str, bool] = map_new()
        let mut nj: int = 0
        while nj < names.len() {
            full.set(names.get(nj), true)
            nj = nj + 1
        }
        dom.set(names.get(ni), full)
        ni = ni + 1
    }
    let entry_dom: map[str, bool] = map_new()
    let mut ezi: int = 0
    while ezi < names.len() {
        entry_dom.set(names.get(ezi), names.get(ezi) == entry)
        ezi = ezi + 1
    }
    dom.set(entry, entry_dom)
    let mut changed: bool = true
    while changed {
        changed = false
        let mut nk: int = 0
        while nk < names.len() {
            let n2: str = names.get(nk)
            if n2 == entry {
                nk = nk + 1
                continue
            }
            let ps: list[str] = fx.preds.get_or(n2, [])
            if ps.len() > 0 {
                let new_set: map[str, bool] = map_new()
                let mut nj2: int = 0
                while nj2 < names.len() {
                    new_set.set(names.get(nj2), true)
                    nj2 = nj2 + 1
                }
                let mut pk: int = 0
                while pk < ps.len() {
                    let dp: map[str, bool] = dom.get_or(ps.get(pk),
                    map_new())
                    let keys: list[str] = dp.keys()
                    let mut ki: int = 0
                    while ki < keys.len() {
                        if !dp.get_or(keys.get(ki), false) {
                            new_set.set(keys.get(ki), false)
                        }
                        ki = ki + 1
                    }
                    pk = pk + 1
                }
                new_set.set(n2, true)
                if !rv_boolmap_eq(new_set, dom.get_or(n2, map_new())) {
                    dom.set(n2, new_set)
                    changed = true
                }
            }
            nk = nk + 1
        }
    }
    # ---- loop headers: targets of back edges (h dominates t) ----
    let mut ti: int = 0
    while ti < names.len() {
        let t: str = names.get(ti)
        let ss4: list[str] = fx.succs.get_or(t, [])
        let mut si3: int = 0
        while si3 < ss4.len() {
            let h: str = ss4.get(si3)
            if dom.get_or(t, map_new()).get_or(h, false) {
                fx.headers.set(h, true)
            }
            si3 = si3 + 1
        }
        ti = ti + 1
    }
    res.widened_loops = fx.headers.len()

    # ---- reverse postorder ----
    let order: list[str] = []
    let visited: map[str, bool] = map_new()
    let stack_n: list[str] = []
    let stack_d: list[bool] = []
    stack_n.push(entry)
    stack_d.push(false)
    while stack_n.len() > 0 {
        let n3: str = stack_n.get(stack_n.len() - 1)
        let done: bool = stack_d.get(stack_d.len() - 1)
        stack_n.pop()
        stack_d.pop()
        if done {
            order.push(n3)
            continue
        }
        if visited.has(n3) {
            continue
        }
        visited.set(n3, true)
        stack_n.push(n3)
        stack_d.push(true)
        let ss5: list[str] = fx.succs.get_or(n3, [])
        let mut si4: int = 0
        while si4 < ss5.len() {
            if !visited.has(ss5.get(si4)) {
                stack_n.push(ss5.get(si4))
                stack_d.push(false)
            }
            si4 = si4 + 1
        }
    }
    let mut rpi: int = order.len() - 1
    while rpi >= 0 {
        fx.rpo.push(order.get(rpi))
        rpi = rpi - 1
    }

    # ---- the fixpoint, the verification, the final verdict pass ----
    rv_run_fixpoint(fx, res)
    rv_verify_pass(fx, res)

    let defined: map[str, bool] = map_new()
    let mut pi: int = 0
    while pi < irf.params.len() {
        defined.set("v_" + irf.params.get(pi), true)
        pi = pi + 1
    }
    bi = 0
    while bi < irf.blocks.len() {
        let blk4: RVBlock = irf.blocks.get(bi)
        if !fx.state_in_has.get_or(blk4.name, false) {
            # unreachable: nothing here executes, no verdict to record
            bi = bi + 1
            continue
        }
        let st: RState = rv_state_copy(
        fx.state_in.get_or(blk4.name, rv_state_new()))
        let mut ii: int = 0
        while ii < blk4.instrs.len() {
            let ins: RVIns = blk4.instrs.get(ii)
            rv_check_integrity(ins, blk4.name, defined, res, where_fn)
            rv_transfer_instr(ctx, ins, st, res, true)
            if ins.dest != "" {
                defined.set(ins.dest, true)
            }
            ii = ii + 1
        }
        if blk4.has_term {
            let mut ai2: int = 0
            while ai2 < blk4.term.args.len() {
                let a2: RVArg = blk4.term.args.get(ai2)
                if a2.tag == "var" && !defined.has(a2.sval) {
                    res.integrity.push(RVInteg {
                        iclass: "dangling-var",
                        text: where_fn + ": terminator of " + blk4.name
                        + " reads undefined value " + a2.sval
                    })
                }
                ai2 = ai2 + 1
            }
        }
        bi = bi + 1
    }
    return res
}

# ============================================================================
# The replay law — hlrev_replay.py's reconcile, fail-closed:
#   a memory-safety CLAIM (a baseline-proven check site) is DISCHARGED
#   when its site re-proves, or was eliminated (folded / dead — no
#   runtime operation remains), or was never lowered (unreachable
#   code). A claim whose site SURVIVES but no longer re-proves is a
#   LOST-PROOF: the verdict fails. Counted conservatively:
#       lost = max(0, P - R - eliminated)
#   with inline-derived copies (callee bodies pasted into callers)
#   reconciled under the callee's own function via the global shrink
#   map. Any safe_overflow annotation without a certificate is FORGED;
#   any dangling operand/label is BROKEN-IR; an IR0 site with no
#   baseline counterpart the shrink map cannot explain is
#   DUPLICATED-SITE.
# ============================================================================

# rv_site_key(kind, line) — the multiset key.
fn rv_site_key(kind: str, line: int) -> str {
    return kind + "@" + line.to_str()
}

# rv_multiset(rows) — {key: count} over site rows.
fn rv_multiset(rows: list[RVSite]) -> map[str, int] {
    let out: map[str, int] = map_new()
    let mut i: int = 0
    while i < rows.len() {
        let k: str = rv_site_key(rows.get(i).kind, rows.get(i).line)
        if out.has(k) {
            out.set(k, out.get_or(k, 0) + 1)
        } else {
            out.set(k, 1)
        }
        i = i + 1
    }
    return out
}

# rv_sorted_keys(kind_line_pairs) — sort by (kind, line int), the
# Python's tuple sort.
struct RVKeyRow {
    kind: str,
    line: int
}

fn rv_sorted_key_rows(rows: list[RVKeyRow]) -> list[RVKeyRow] {
    let out: list[RVKeyRow] = []
    let mut i: int = 0
    while i < rows.len() {
        out.push(rows.get(i))
        i = i + 1
    }
    let mut a: int = 0
    while a < out.len() {
        let mut b: int = a + 1
        while b < out.len() {
            let ra: RVKeyRow = out.get(a)
            let rb: RVKeyRow = out.get(b)
            let mut swap: bool = false
            if rb.kind < ra.kind {
                swap = true
            } else if rb.kind == ra.kind && rb.line < ra.line {
                swap = true
            }
            if swap {
                let t: RVKeyRow = out.get(a)
                out.set(a, out.get(b))
                out.set(b, t)
            }
            b = b + 1
        }
        a = a + 1
    }
    return out
}

# rv_reconcile(entry, lto, baseline, mod0, mod1, analyses) — the law
# over all functions; returns the report (schema
# hls-reverify-report/v1) as a JDoc.
fn rv_reconcile(entry: str, lto: bool, baseline: map[str, list[RVSite]],
mod0: RVMod, mod1: RVMod, analyses: map[str, RVRes]) -> JDoc {
    let report: JDoc = jd_obj()
    obj_set(report, "schema", jd_str(rv_report_schema()))
    obj_set(report, "tool", jd_str("hls-reverify"))
    obj_set(report, "tool_version", jd_str(rv_version()))
    obj_set(report, "entry", jd_str(entry))
    obj_set(report, "lto", jd_bool(lto))
    obj_set(report, "verdict", jd_null())

    let baseline_obj: JDoc = jd_obj()
    obj_set(baseline_obj, "sites", jd_int(0))
    obj_set(baseline_obj, "proven", jd_int(0))
    obj_set(baseline_obj, "checked", jd_int(0))
    obj_set(report, "baseline", baseline_obj)
    let replay_obj: JDoc = jd_obj()
    obj_set(replay_obj, "sites", jd_int(0))
    obj_set(replay_obj, "proven", jd_int(0))
    obj_set(replay_obj, "functions", jd_int(0))
    obj_set(replay_obj, "blocks", jd_int(0))
    obj_set(replay_obj, "widened_loops", jd_int(0))
    obj_set(report, "replay", replay_obj)
    obj_set(report, "counts", jd_obj())
    obj_set(report, "findings", jd_arr([]))
    obj_set(report, "failures", jd_arr([]))
    obj_set(report, "functions", jd_obj())

    let counts: map[str, int] = map_new()
    let failures: map[str, bool] = map_new()
    let findings: list[JDoc] = []

    let ir0: map[str, list[RVSite]] = rv_harvest_ir_sites(mod0)
    let ir1: map[str, list[RVSite]] = rv_harvest_ir_sites(mod1)

    # ---- global (kind, line) shrink map — attributes inline-derived
    # copies: a callee's site lines appearing in a caller beyond the
    # caller's own IR0 multiset ----
    let shrink: map[str, int] = map_new()
    let fn_union: list[str] = []
    let mut ui: int = 0
    while ui < mod0.order.len() {
        if !rv_has(fn_union, mod0.order.get(ui)) {
            fn_union.push(mod0.order.get(ui))
        }
        ui = ui + 1
    }
    ui = 0
    while ui < mod1.order.len() {
        if !rv_has(fn_union, mod1.order.get(ui)) {
            fn_union.push(mod1.order.get(ui))
        }
        ui = ui + 1
    }
    let bkeys: list[str] = baseline.keys()
    ui = 0
    while ui < bkeys.len() {
        if !rv_has(fn_union, bkeys.get(ui)) {
            fn_union.push(bkeys.get(ui))
        }
        ui = ui + 1
    }
    let akeys: list[str] = analyses.keys()
    ui = 0
    while ui < akeys.len() {
        if !rv_has(fn_union, akeys.get(ui)) {
            fn_union.push(akeys.get(ui))
        }
        ui = ui + 1
    }
    let fn_names: list[str] = rv_sort_strs(fn_union)

    let mut fi: int = 0
    while fi < fn_names.len() {
        let fname: str = fn_names.get(fi)
        let m0: map[str, int] = rv_multiset(ir0.get_or(fname, []))
        let m1: map[str, int] = rv_multiset(ir1.get_or(fname, []))
        let m1keys: list[str] = m1.keys()
        let mut ki: int = 0
        while ki < m1keys.len() {
            let key: str = m1keys.get(ki)
            let c1: int = m1.get_or(key, 0)
            let c0: int = m0.get_or(key, 0)
            if c1 < c0 {
                shrink.set(key, shrink.get_or(key, 0) + c0 - c1)
            }
            ki = ki + 1
        }
        fi = fi + 1
    }

    # ---- per-function rows ----
    let functions_obj: JDoc = obj_get(report, "functions")
    fi = 0
    while fi < fn_names.len() {
        let fname2: str = fn_names.get(fi)
        let b_sites: list[RVSite] = baseline.get_or(fname2, [])
        # baseline proven/total per key
        let b_prov: map[str, int] = map_new()
        let b_total: map[str, int] = map_new()
        let mut bsi: int = 0
        while bsi < b_sites.len() {
            let k: str = rv_site_key(b_sites.get(bsi).kind,
            b_sites.get(bsi).line)
            b_total.set(k, b_total.get_or(k, 0) + 1)
            if b_sites.get(bsi).proven {
                b_prov.set(k, b_prov.get_or(k, 0) + 1)
            }
            bsi = bsi + 1
        }
        let m0f: map[str, int] = rv_multiset(ir0.get_or(fname2, []))
        let m1f: map[str, int] = rv_multiset(ir1.get_or(fname2, []))
        # the replay verdicts per key, in recording order
        let verdicts: map[str, list[bool]] = map_new()
        let ana: RVRes = analyses.get_or(fname2, rv_res_new())
        let mut vi: int = 0
        while vi < ana.verdicts.len() {
            let v: RVVerdict = ana.verdicts.get(vi)
            let vk: str = rv_site_key(v.kind, v.line)
            if !verdicts.has(vk) {
                let empty: list[bool] = []
                verdicts.set(vk, empty)
            }
            verdicts.get_or(vk, []).push(v.proven)
            vi = vi + 1
        }
        # the key set: baseline + IR0 + IR1, sorted by (kind, line)
        let key_rows: list[RVKeyRow] = []
        let btot_keys: list[str] = b_total.keys()
        let mut kri: int = 0
        while kri < btot_keys.len() {
            let at: int = btot_keys.get(kri).find("@")
            key_rows.push(RVKeyRow {
                kind: btot_keys.get(kri).slice(0, at),
                line: rv_str_int(btot_keys.get(kri).slice(at + 1,
                btot_keys.get(kri).len()))
            })
            kri = kri + 1
        }
        let m0keys: list[str] = m0f.keys()
        kri = 0
        while kri < m0keys.len() {
            let kk: str = m0keys.get(kri)
            let at2: int = kk.find("@")
            let row: RVKeyRow = RVKeyRow {
                kind: kk.slice(0, at2),
                line: rv_str_int(kk.slice(at2 + 1, kk.len()))
            }
            let mut dup: bool = false
            let mut dj: int = 0
            while dj < key_rows.len() {
                if key_rows.get(dj).kind == row.kind
                && key_rows.get(dj).line == row.line {
                    dup = true
                    break
                }
                dj = dj + 1
            }
            if !dup {
                key_rows.push(row)
            }
            kri = kri + 1
        }
        let m1keys: list[str] = m1f.keys()
        kri = 0
        while kri < m1keys.len() {
            let kk2: str = m1keys.get(kri)
            let at3: int = kk2.find("@")
            let row2: RVKeyRow = RVKeyRow {
                kind: kk2.slice(0, at3),
                line: rv_str_int(kk2.slice(at3 + 1, kk2.len()))
            }
            let mut dup2: bool = false
            let mut dj2: int = 0
            while dj2 < key_rows.len() {
                if key_rows.get(dj2).kind == row2.kind
                && key_rows.get(dj2).line == row2.line {
                    dup2 = true
                    break
                }
                dj2 = dj2 + 1
            }
            if !dup2 {
                key_rows.push(row2)
            }
            kri = kri + 1
        }
        let sorted_rows: list[RVKeyRow] = rv_sorted_key_rows(key_rows)
        let fn_report: JDoc = jd_obj()
        let mut ri: int = 0
        while ri < sorted_rows.len() {
            let kind: str = sorted_rows.get(ri).kind
            let line: int = sorted_rows.get(ri).line
            let key2: str = rv_site_key(kind, line)
            let adv: bool = kind == rv_kind_set()
            let P: int = b_prov.get_or(key2, 0)
            let C: int = b_total.get_or(key2, 0) - P
            let n0: int = m0f.get_or(key2, 0)
            let n1: int = m1f.get_or(key2, 0)
            # inline-derived copies live in THIS function but were born
            # in a callee that shrank at the same (kind, line)
            let mut inline_derived: int = 0
            if n1 > n0 && !adv {
                let extra: int = n1 - n0
                let avail: int = shrink.get_or(key2, 0)
                inline_derived = extra
                if avail < inline_derived {
                    inline_derived = avail
                }
            }
            let n1_self: int = n1 - inline_derived
            let mut eliminated: int = n0 - n1_self
            if eliminated < 0 {
                eliminated = 0
            }
            # the first n1_self recorded verdicts are this function's
            # own sites
            let rv_rows: list[bool] = verdicts.get_or(key2, [])
            let mut R: int = 0
            let mut cnt: int = 0
            while cnt < rv_rows.len() && cnt < n1_self {
                if rv_rows.get(cnt) {
                    R = R + 1
                }
                cnt = cnt + 1
            }
            let mut F: int = 0
            if n1_self < rv_rows.len() {
                F = n1_self - R
            } else {
                F = rv_rows.len() - R
            }

            let mut cls: str = ""
            let mut ok: bool = true
            if adv || b_total.get_or(key2, 0) == 0 {
                # no baseline claim: advisory sites, non-contracted
                # functions, inlined copies — nothing to discharge
                cls = rv_c_no_claim()
                ok = true
            } else if n0 == 0 {
                # never lowered: unreachable code (after return/break)
                cls = rv_c_unreachable()
                ok = true
            } else if n0 > b_total.get_or(key2, 0) {
                # the lowering holds MORE sites than the AST had
                cls = rv_c_lost_proof()
                ok = false
                failures.set(rv_f_duplicated(), true)
            } else {
                # THE LAW: proven claims discharge on re-proof, on
                # elimination, or fail
                let mut lost: int = P - R - eliminated
                if lost < 0 {
                    lost = 0
                }
                if lost > 0 {
                    cls = rv_c_lost_proof()
                    ok = false
                    failures.set(rv_f_lost_proof(), true)
                } else if n1_self == 0 {
                    cls = rv_c_eliminated()
                    ok = true
                } else if R > P {
                    cls = rv_c_new_proof()
                    ok = true
                } else if R == P && P > 0 {
                    cls = rv_c_replayed()
                    ok = true
                } else {
                    # every unproven survivor is covered by a checked
                    # baseline claim — the checks are all still in
                    cls = rv_c_replayed_checked()
                    ok = true
                }
            }
            counts.set(cls, counts.get_or(cls, 0) + 1)
            let row_obj: JDoc = jd_obj()
            obj_set(row_obj, "kind", jd_str(kind))
            obj_set(row_obj, "line", jd_int(line))
            let bl: JDoc = jd_obj()
            obj_set(bl, "proven", jd_int(P))
            obj_set(bl, "checked", jd_int(C))
            obj_set(row_obj, "baseline", bl)
            obj_set(row_obj, "ir0", jd_int(n0))
            obj_set(row_obj, "ir1", jd_int(n1))
            obj_set(row_obj, "inline_derived", jd_int(inline_derived))
            obj_set(row_obj, "eliminated", jd_int(eliminated))
            let rp: JDoc = jd_obj()
            obj_set(rp, "proven", jd_int(R))
            obj_set(rp, "failed", jd_int(F))
            obj_set(row_obj, "replay", rp)
            obj_set(row_obj, "class", jd_str(cls))
            obj_set(row_obj, "ok", jd_bool(ok))
            obj_set(fn_report, key2, row_obj)
            ri = ri + 1
        }
        let ana2: RVRes = analyses.get_or(fname2, rv_res_new())
        let has_rows: bool = b_sites.len() > 0
        || m0f.len() > 0 || m1f.len() > 0
        || ana2.verdicts.len() > 0 || ana2.integrity.len() > 0
        if has_rows {
            obj_set(functions_obj, fname2, fn_report)
        }
        fi = fi + 1
    }

    # ---- the annotation audit + integrity, per function ----
    fi = 0
    while fi < fn_names.len() {
        let fname3: str = fn_names.get(fi)
        let ana3: RVRes = analyses.get_or(fname3, rv_res_new())
        let mut ai: int = 0
        while ai < ana3.annotations.len() {
            let a: RVAnnot = ana3.annotations.get(ai)
            if !a.certified {
                failures.set(rv_f_forged(), true)
                let f_obj: JDoc = jd_obj()
                obj_set(f_obj, "class", jd_str(rv_f_forged()))
                obj_set(f_obj, "text", jd_str("function " + fname3
                + ": safe_overflow on " + a.dest + " at line "
                + a.line.to_str() + " carries no certificate (no "
                + "interval proof, no pinned identity) — forged "
                + "elision"))
                findings.push(f_obj)
            }
            counts.set("annotations", counts.get_or("annotations", 0) + 1)
            ai = ai + 1
        }
        let mut ii: int = 0
        while ii < ana3.integrity.len() {
            let itg: RVInteg = ana3.integrity.get(ii)
            if itg.iclass == "unreachable-block-note" {
                # inherited from the lowering, executes nothing — a
                # named note, never a failure
                counts.set("unreachable-notes",
                counts.get_or("unreachable-notes", 0) + 1)
                let f_obj2: JDoc = jd_obj()
                obj_set(f_obj2, "class", jd_str("note"))
                obj_set(f_obj2, "text", jd_str(itg.text))
                findings.push(f_obj2)
                ii = ii + 1
                continue
            }
            failures.set(rv_f_broken_ir(), true)
            let f_obj3: JDoc = jd_obj()
            obj_set(f_obj3, "class", jd_str(rv_f_broken_ir()))
            obj_set(f_obj3, "text", jd_str(itg.iclass + ": " + itg.text))
            findings.push(f_obj3)
            ii = ii + 1
        }
        fi = fi + 1
    }

    # ---- the LOST-PROOF findings, named per site (sorted fn, sorted
    # (kind, line) — the insertion orders above) ----
    let fkeys: list[str] = functions_obj.keys
    let mut fki: int = 0
    while fki < fkeys.len() {
        let fname4: str = fkeys.get(fki)
        let fn_rep: JDoc = obj_get(functions_obj, fname4)
        let rowks: list[str] = fn_rep.keys
        let mut rki: int = 0
        while rki < rowks.len() {
            let rowk: str = rowks.get(rki)
            let row: JDoc = obj_get(fn_rep, rowk)
            let cls2: str = obj_get_str(row, "class")
            if cls2 == rv_c_lost_proof() {
                let kind2: str = obj_get_str(row, "kind")
                let line2: int = obj_get_int(row, "line")
                let bl2: JDoc = obj_get(row, "baseline")
                let rp2: JDoc = obj_get(row, "replay")
                let f_obj4: JDoc = jd_obj()
                obj_set(f_obj4, "class", jd_str(rv_f_lost_proof()))
                obj_set(f_obj4, "text", jd_str("function " + fname4 + ": "
                + kind2 + " at line " + line2.to_str() + " — "
                + obj_get_int(bl2, "proven").to_str() + " proven claim(s)"
                + " the transformed program cannot re-prove (survivors "
                + obj_get_int(row, "ir1").to_str() + ", replayed "
                + obj_get_int(rp2, "proven").to_str() + ", eliminated "
                + obj_get_int(row, "eliminated").to_str() + ")"))
                findings.push(f_obj4)
            } else if cls2 == rv_f_duplicated() {
                let kind3: str = obj_get_str(row, "kind")
                let line3: int = obj_get_int(row, "line")
                let f_obj5: JDoc = jd_obj()
                obj_set(f_obj5, "class", jd_str(rv_f_duplicated()))
                obj_set(f_obj5, "text", jd_str("function " + fname4 + ": "
                + kind3 + " at line " + line3.to_str() + " — the IR "
                + "holds more sites than the lowering can account for"))
                findings.push(f_obj5)
            }
            rki = rki + 1
        }
        fki = fki + 1
    }

    # ---- headline numbers ----
    let mut b_sites_total: int = 0
    let mut b_proven_total: int = 0
    let bk: list[str] = baseline.keys()
    let mut bki: int = 0
    while bki < bk.len() {
        let rows: list[RVSite] = baseline.get_or(bk.get(bki), [])
        let mut rj: int = 0
        while rj < rows.len() {
            b_sites_total = b_sites_total + 1
            if rows.get(rj).proven {
                b_proven_total = b_proven_total + 1
            }
            rj = rj + 1
        }
        bki = bki + 1
    }
    let blh: JDoc = obj_get(report, "baseline")
    obj_set(blh, "sites", jd_int(b_sites_total))
    obj_set(blh, "proven", jd_int(b_proven_total))
    obj_set(blh, "checked", jd_int(b_sites_total - b_proven_total))
    let mut n_replay_sites: int = 0
    let mut n_replay_proven: int = 0
    let mut n_blocks: int = 0
    fi = 0
    while fi < fn_names.len() {
        let ana4: RVRes = analyses.get_or(fn_names.get(fi), rv_res_new())
        n_blocks = n_blocks + ana4.blocks
        let mut vj: int = 0
        while vj < ana4.verdicts.len() {
            if ana4.verdicts.get(vj).kind != rv_kind_set() {
                n_replay_sites = n_replay_sites + 1
                if ana4.verdicts.get(vj).proven {
                    n_replay_proven = n_replay_proven + 1
                }
            }
            vj = vj + 1
        }
        fi = fi + 1
    }
    let rph: JDoc = obj_get(report, "replay")
    obj_set(rph, "sites", jd_int(n_replay_sites))
    obj_set(rph, "proven", jd_int(n_replay_proven))
    obj_set(rph, "functions", jd_int(analyses.len()))
    obj_set(rph, "blocks", jd_int(n_blocks))

    # counts sorted, failures sorted, the verdict
    let counts_obj: JDoc = obj_get(report, "counts")
    let cks: list[str] = rv_sort_strs(counts.keys())
    let mut cki: int = 0
    while cki < cks.len() {
        obj_set(counts_obj, cks.get(cki),
        jd_int(counts.get_or(cks.get(cki), 0)))
        cki = cki + 1
    }
    obj_set(report, "findings", jd_arr(findings))
    let fail_list: list[JDoc] = []
    let fks: list[str] = rv_sort_strs(failures.keys())
    let mut fsi: int = 0
    while fsi < fks.len() {
        fail_list.push(jd_str(fks.get(fsi)))
        fsi = fsi + 1
    }
    obj_set(report, "failures", jd_arr(fail_list))
    if failures.len() > 0 {
        obj_set(report, "verdict", jd_str("REPLAY-FAILED"))
    } else {
        obj_set(report, "verdict", jd_str("REPLAY-OK"))
    }
    return report
}

# ============================================================================
# The text report — format_text's own voice.
# ============================================================================

fn rv_format_text(report: JDoc) -> str {
    let mut out: str = ""
    out = out + "hls-reverify " + rv_version()
    + " — memory-safety proof replay\n"
    let mut lto_suffix: str = ""
    if obj_get_bool(report, "lto") {
        lto_suffix = "  (--lto)"
    }
    out = out + "  entry: " + obj_get_str(report, "entry") + lto_suffix
    + "\n"
    let bl: JDoc = obj_get(report, "baseline")
    out = out + "  baseline: " + obj_get_int(bl, "sites").to_str()
    + " check site(s) — " + obj_get_int(bl, "proven").to_str()
    + " proven (elidable), " + obj_get_int(bl, "checked").to_str()
    + " runtime-checked\n"
    let rp: JDoc = obj_get(report, "replay")
    out = out + "  replay: " + obj_get_int(rp, "sites").to_str()
    + " site(s) re-derived over " + obj_get_int(rp, "functions").to_str()
    + " function(s), " + obj_get_int(rp, "blocks").to_str()
    + " block(s) — " + obj_get_int(rp, "proven").to_str()
    + " provable after the optimiser\n"
    let counts: JDoc = obj_get(report, "counts")
    if counts.keys.len() > 0 {
        let cks: list[str] = rv_sort_strs(counts.keys)
        let mut line: str = "  classes: "
        let mut i: int = 0
        while i < cks.len() {
            if i > 0 {
                line = line + ", "
            }
            line = line + cks.get(i) + "="
            + obj_get_int(counts, cks.get(i)).to_str()
            i = i + 1
        }
        out = out + line + "\n"
    }
    let findings: JDoc = obj_get(report, "findings")
    let mut fi: int = 0
    while fi < findings.arr.len() {
        let f: JDoc = findings.arr.get(fi)
        out = out + "  FINDING [" + obj_get_str(f, "class") + "] "
        + obj_get_str(f, "text") + "\n"
        fi = fi + 1
    }
    out = out + "  verdict: " + obj_get_str(report, "verdict")
    return out
}

# ============================================================================
# The selftest — hlrev_selftest.py's 40 vectors, restated natively:
# the one-definition seed identity, the interval corners, the division
# corners, the identity certificates, the for-get discriminator, the
# bounds routes, the widening convergence, the integrity audits, the
# forged-annotation audit, the replay-law classification table, the
# report determinism, the seed mapping.
# ============================================================================

struct RVVec {
    passed: int,
    failed: int
}

fn rv_vec_check(v: RVVec, name: str, cond: bool, detail: str) -> void
uses IO {
    if cond {
        v.passed = v.passed + 1
        println("  [PASS] " + name)
    } else {
        v.failed = v.failed + 1
        if detail == "" {
            println("  [FAIL] " + name)
        } else {
            println("  [FAIL] " + name + " — " + detail)
        }
    }
}

# rv_mk_fn(name, params, blocks) — a synthetic IR function.
fn rv_mk_fn(name: str, params: list[str], blocks: list[RVBlock]) -> RVFn {
    let irf: RVFn = rv_fn(name, params, "int", [])
    let mut i: int = 0
    while i < blocks.len() {
        irf.blocks.push(blocks.get(i))
        i = i + 1
    }
    return irf
}

# rv_entry(instrs) — the canonical entry block ending in `return`.
fn rv_entry(instrs: list[RVIns]) -> RVBlock {
    let b: RVBlock = rv_block("entry")
    let mut i: int = 0
    while i < instrs.len() {
        b.instrs.push(instrs.get(i))
        i = i + 1
    }
    b.term = rv_ins("", "return", [], 0, "")
    b.has_term = true
    return b
}

# rv_verdicts_of(res, kind) — the verdict rows of one kind.
fn rv_verdicts_of(res: RVRes, kind: str) -> list[RVVerdict] {
    let out: list[RVVerdict] = []
    let mut i: int = 0
    while i < res.verdicts.len() {
        if res.verdicts.get(i).kind == kind {
            out.push(res.verdicts.get(i))
        }
        i = i + 1
    }
    return out
}

# rv_integrity_has(res, iclass) — an integrity row of that class.
fn rv_integrity_has(res: RVRes, iclass: str) -> bool {
    let mut i: int = 0
    while i < res.integrity.len() {
        if res.integrity.get(i).iclass == iclass {
            return true
        }
        i = i + 1
    }
    return false
}

# rv_failure_has(report, name) — a failure class in the report.
fn rv_failure_has(report: JDoc, name: str) -> bool {
    let fl: JDoc = obj_get(report, "failures")
    let mut i: int = 0
    while i < fl.arr.len() {
        if fl.arr.get(i).kind == "str" && fl.arr.get(i).sval == name {
            return true
        }
        i = i + 1
    }
    return false
}

# rv_seed_of(st) — wrap a state as a present seed.
fn rv_seed_of(st: RState) -> RVSeed {
    return RVSeed {
        st: st, has: true
    }
}

# rv_selftest() — the 40 vectors; 0 when all pass.
fn rv_selftest() -> int uses IO {
    let v: RVVec = RVVec {
        passed: 0, failed: 0
    }
    println("hls-reverify selftest — " + rv_version())

    # ---- 1. the ONE DEFINITION: the replay's seeds ARE the proof
    # module's own seeding — build the canonical requires clause
    # (`i >= 0 && i < xs.len()`) as an ExprN tree, seed it directly
    # with seed_from_requires, and compare with the replay's
    # rv_seed_function mapping onto v_-names ----
    let ctx: Ctx = new_ctx("")
    let li: int = nx_expr(ctx, "ident", 1)
    ctx.exprs[li].name = "i"
    let z: int = nx_expr(ctx, "int", 1)
    ctx.exprs[z].ival = 0
    let ge: int = nx_expr(ctx, "bin", 1)
    ctx.exprs[ge].op = ">="
    ctx.exprs[ge].left = li
    ctx.exprs[ge].right = z
    let li2: int = nx_expr(ctx, "ident", 1)
    ctx.exprs[li2].name = "i"
    let xs: int = nx_expr(ctx, "ident", 1)
    ctx.exprs[xs].name = "xs"
    let ln: int = nx_expr(ctx, "method", 1)
    ctx.exprs[ln].name = "len"
    ctx.exprs[ln].mop = "list.len"
    ctx.exprs[ln].left = xs
    let lt: int = nx_expr(ctx, "bin", 1)
    ctx.exprs[lt].op = "<"
    ctx.exprs[lt].left = li2
    ctx.exprs[lt].right = ln
    let req: int = nx_expr(ctx, "bin", 1)
    ctx.exprs[req].op = "&&"
    ctx.exprs[req].left = ge
    ctx.exprs[req].right = lt
    let f: FnInfo = dummy_fn()
    f.name = "seeded"
    f.params = ["i", "xs"]
    f.ptypes = ["int", "list[int]"]
    f.requires_e = req
    let facts: map[str, IVal] = map_new()
    let facts_lenhi: map[str, str] = map_new()
    let nz: map[str, bool] = map_new()
    seed_from_requires(ctx, req, f, facts, facts_lenhi, nz)
    let seed: RVSeed = rv_seed_function(ctx, f)
    let seed_ok: bool = seed.has
    && seed.st.ints.get_or("v_i", iv_top()).lo
    == facts.get_or("i", iv_top()).lo
    && seed.st.ints.get_or("v_i", iv_top()).hi
    == facts.get_or("i", iv_top()).hi
    && seed.st.lenhi.get_or("v_i", "")
    == "v_" + facts_lenhi.get_or("i", "")
    rv_vec_check(v, "one-definition: the replay seeds ARE the proof "
    + "module's (seed_from_requires, one call site)", seed_ok,
    "seed mapping diverged")

    # ---- 2. interval corner vectors (the Stage 17 soundness pins).
    # one restatement: the retired engine's `add_fits([0, max-1], [1,1])`
    # returned True (python None sentinels); the ONE native definition
    # uses INT64_MAX as the +inf sentinel and deep-scan-10's law treats
    # a bound EQUAL to a sentinel as unknown — the sum lands hi exactly
    # on max, so the native engine refuses it. The vector pins the
    # native truth. ----
    rv_vec_check(v, "iv: TOP never fits", !iv_fits(iv_top()), "")
    rv_vec_check(v, "iv: [max-1, max] + [1, 1] does not fit",
    !iv_fits(iv_add(IVal { lo: INF_HI() - 1, hi: INF_HI() },
    IVal { lo: 1, hi: 1 })), "")
    rv_vec_check(v, "iv: [0, max-1] + [1, 1] hits the max sentinel "
    + "— refused at the sentinel, fits below it (the native law)",
    !iv_fits(iv_add(IVal { lo: 0, hi: INF_HI() - 1 },
    IVal { lo: 1, hi: 1 }))
    && iv_fits(iv_add(IVal { lo: 0, hi: INF_HI() - 2 },
    IVal { lo: 1, hi: 1 })), "")
    rv_vec_check(v, "iv: 0 - INT64_MIN corner does not fit",
    !iv_fits(iv_sub(IVal { lo: 0, hi: 0 },
    IVal { lo: INF_LO(), hi: INF_LO() })), "")
    rv_vec_check(v, "iv: excludes_zero above zero",
    iv_excl_zero(IVal { lo: 1, hi: 10 }), "")
    rv_vec_check(v, "iv: excludes_zero straddles zero",
    !iv_excl_zero(IVal { lo: -1, hi: 1 }), "")

    # ---- 3. the INT64_MIN / -1 division corner ----
    let st1: RState = rv_state_new()
    st1.ints.set("v_b", IVal { lo: -5, hi: -1 })
    st1.ints.set("v_a", iv_top())
    let blk1: RVBlock = rv_entry([rv_ins("t1", "binop",
    [rv_arg_op("/"), rv_arg_var("v_a"), rv_arg_var("v_b")], 1, "int")])
    let res1: RVRes = rv_analyze_function(ctx, rv_mk_fn("divcorner",
    ["a", "b"], [blk1]), rv_seed_of(st1))
    let div_v1: list[RVVerdict] = rv_verdicts_of(res1, rv_kind_div())
    rv_vec_check(v, "div: INT64_MIN / negative divisor is NOT proven",
    div_v1.len() == 1 && div_v1.get(0).proven == false,
    "n=" + div_v1.len().to_str())
    let st2: RState = rv_state_new()
    st2.ints.set("v_b", IVal { lo: -5, hi: -1 })
    st2.ints.set("v_a", IVal { lo: -100, hi: 100 })
    let blk2: RVBlock = rv_entry([rv_ins("t1", "binop",
    [rv_arg_op("/"), rv_arg_var("v_a"), rv_arg_var("v_b")], 1, "int")])
    let res2: RVRes = rv_analyze_function(ctx, rv_mk_fn("divcorner2",
    ["a", "b"], [blk2]), rv_seed_of(st2))
    let div_v2: list[RVVerdict] = rv_verdicts_of(res2, rv_kind_div())
    rv_vec_check(v, "div: bounded dividend / negative divisor IS proven",
    div_v2.len() == 1 && div_v2.get(0).proven == true,
    "n=" + div_v2.len().to_str())

    # ---- 4. the nz set route ----
    let st3: RState = rv_state_new()
    st3.nz.set("v_b", true)
    st3.ints.set("v_a", IVal { lo: -100, hi: 100 })
    let blk3: RVBlock = rv_entry([rv_ins("t1", "binop",
    [rv_arg_op("%"), rv_arg_var("v_a"), rv_arg_var("v_b")], 1, "int")])
    let res3: RVRes = rv_analyze_function(ctx, rv_mk_fn("nzroute",
    ["a", "b"], [blk3]), rv_seed_of(st3))
    let div_v3: list[RVVerdict] = rv_verdicts_of(res3, rv_kind_div())
    rv_vec_check(v, "div: the nz set proves a non-zero divisor "
    + "(bounded dividend)",
    div_v3.len() == 1 && div_v3.get(0).proven == true, "")
    let st3b: RState = rv_state_new()
    st3b.nz.set("v_b", true)
    let blk3b: RVBlock = rv_entry([rv_ins("t1", "binop",
    [rv_arg_op("%"), rv_arg_var("v_a"), rv_arg_var("v_b")], 1, "int")])
    let res3b: RVRes = rv_analyze_function(ctx, rv_mk_fn("nzroute2",
    ["a", "b"], [blk3b]), rv_seed_of(st3b))
    let div_v3b: list[RVVerdict] = rv_verdicts_of(res3b, rv_kind_div())
    rv_vec_check(v, "div: nz alone never elides an unbounded dividend",
    div_v3b.len() == 1 && div_v3b.get(0).proven == false, "")

    # ---- 5. the identity certificates: pinned shapes ----
    let stc: RState = rv_state_new()
    rv_vec_check(v, "cert: x + 0 -> add-zero-right",
    rv_identity_cert("+", rv_arg_var("t"), rv_arg_lit_int(0), stc)
    == "alg:add-zero-right", "")
    rv_vec_check(v, "cert: 0 + x -> add-zero-left",
    rv_identity_cert("+", rv_arg_lit_int(0), rv_arg_var("t"), stc)
    == "alg:add-zero-left", "")
    rv_vec_check(v, "cert: x - 0 -> sub-zero-right",
    rv_identity_cert("-", rv_arg_var("t"), rv_arg_lit_int(0), stc)
    == "alg:sub-zero-right", "")
    rv_vec_check(v, "cert: x * 0 -> mul-zero-right",
    rv_identity_cert("*", rv_arg_var("t"), rv_arg_lit_int(0), stc)
    == "alg:mul-zero-right", "")
    rv_vec_check(v, "cert: 1 * x -> mul-one-left",
    rv_identity_cert("*", rv_arg_lit_int(1), rv_arg_var("t"), stc)
    == "alg:mul-one-left", "")
    rv_vec_check(v, "cert: x * 2 -> NO certificate",
    rv_identity_cert("*", rv_arg_var("t"), rv_arg_lit_int(2), stc) == "",
    "")
    rv_vec_check(v, "cert: 0 - x -> NO certificate (0 - INT64_MIN "
    + "overflows)",
    rv_identity_cert("-", rv_arg_lit_int(0), rv_arg_var("t"), stc) == "",
    "")

    # ---- 6. the generated for-get discriminator ----
    let gen: RVIns = rv_ins("v_x", "list_get",
    [rv_arg_var("v_xs"), rv_arg_var("v_x__i")], 3, "")
    let user: RVIns = rv_ins("t1", "list_get",
    [rv_arg_var("v_xs"), rv_arg_var("v_i")], 3, "")
    let other: RVIns = rv_ins("v_x", "list_get",
    [rv_arg_var("v_xs"), rv_arg_var("v_y")], 3, "")
    rv_vec_check(v, "generated: the for pattern is excluded",
    rv_is_generated_for(gen), "")
    rv_vec_check(v, "generated: a user index is a site",
    !rv_is_generated_for(user), "")
    rv_vec_check(v, "generated: same dest, other index, is a site",
    !rv_is_generated_for(other), "")

    # ---- 7. bounds routes: symbolic (i < xs.len()) and numeric ----
    let st4: RState = rv_state_new()
    st4.ints.set("v_i", IVal { lo: 0, hi: INF_HI() })
    st4.lenhi.set("v_i", "v_xs")
    let blk4: RVBlock = rv_entry([rv_ins("t1", "list_get",
    [rv_arg_var("v_xs"), rv_arg_var("v_i")], 2, "int")])
    let res4: RVRes = rv_analyze_function(ctx, rv_mk_fn("symroute",
    ["xs", "i"], [blk4]), rv_seed_of(st4))
    let bnd4: list[RVVerdict] = rv_verdicts_of(res4, rv_kind_bnd())
    rv_vec_check(v, "bnd: the symbolic i < xs.len() seed re-proves",
    bnd4.len() == 1 && bnd4.get(0).proven == true, "")
    # deep-scan-10: delta 0 is NOT a valid index bound
    let st5: RState = rv_state_new()
    st5.ints.set("v_i", IVal { lo: 0, hi: INF_HI() })
    st5.lenhi.set("v_i", "v_xs~")
    let blk5: RVBlock = rv_entry([rv_ins("t1", "list_get",
    [rv_arg_var("v_xs"), rv_arg_var("v_i")], 2, "int")])
    let res5: RVRes = rv_analyze_function(ctx, rv_mk_fn("symroute0",
    ["xs", "i"], [blk5]), rv_seed_of(st5))
    let bnd5: list[RVVerdict] = rv_verdicts_of(res5, rv_kind_bnd())
    rv_vec_check(v, "bnd: i <= xs.len() (delta 0) is NOT proven",
    bnd5.len() == 1 && bnd5.get(0).proven == false, "")
    # numeric minlen route
    let st6: RState = rv_state_new()
    st6.ints.set("v_i", IVal { lo: 0, hi: 7 })
    st6.lenhi.set("~ml~v_s", "8")
    let blk6: RVBlock = rv_entry([rv_ins("t1", "method",
    [rv_arg_name("byte_at"), rv_arg_var("v_s"), rv_arg_var("v_i")],
    2, "int")])
    let res6: RVRes = rv_analyze_function(ctx, rv_mk_fn("minlenroute",
    ["s", "i"], [blk6]), rv_seed_of(st6))
    let bnd6: list[RVVerdict] = rv_verdicts_of(res6, rv_kind_bnd())
    rv_vec_check(v, "bnd: byte_at below the seeded minlen re-proves",
    bnd6.len() == 1 && bnd6.get(0).proven == true, "")

    # ---- 8. widening convergence: a growing counter stays bounded in
    # round count and the analysis completes clean ----
    let entry_b: RVBlock = rv_block("entry")
    entry_b.instrs.push(rv_ins("v_i", "const", [rv_arg_lit_int(0)], 1,
    "int"))
    entry_b.term = rv_ins("", "jump", [rv_arg_label("cond")], 0, "")
    entry_b.has_term = true
    let cond_b: RVBlock = rv_block("cond")
    cond_b.instrs.push(rv_ins("t1", "const", [rv_arg_lit_int(16)], 2,
    "int"))
    cond_b.instrs.push(rv_ins("t2", "binop",
    [rv_arg_op("<"), rv_arg_var("v_i"), rv_arg_var("t1")], 2, "bool"))
    cond_b.term = rv_ins("", "branch",
    [rv_arg_var("t2"), rv_arg_label("body"), rv_arg_label("end")], 2, "")
    cond_b.has_term = true
    let body_b: RVBlock = rv_block("body")
    body_b.instrs.push(rv_ins("t3", "const", [rv_arg_lit_int(1)], 3,
    "int"))
    body_b.instrs.push(rv_ins("t4", "binop",
    [rv_arg_op("+"), rv_arg_var("v_i"), rv_arg_var("t3")], 3, "int"))
    body_b.instrs.push(rv_ins("v_i", "store",
    [rv_arg_var("t4"), rv_arg_name("i")], 3, "int"))
    body_b.term = rv_ins("", "jump", [rv_arg_label("cond")], 3, "")
    body_b.has_term = true
    let end_b: RVBlock = rv_block("end")
    end_b.term = rv_ins("", "return", [], 4, "")
    end_b.has_term = true
    let res7: RVRes = rv_analyze_function(ctx, rv_mk_fn("widens", [],
    [entry_b, cond_b, body_b, end_b]),
    RVSeed { st: rv_state_new(), has: false })
    rv_vec_check(v, "widening: the loop converges within the round cap",
    res7.iterations > 0 && res7.widened_loops == 1,
    "iterations=" + res7.iterations.to_str() + " widened="
    + res7.widened_loops.to_str())
    rv_vec_check(v, "widening: analysis completes with no integrity "
    + "findings", res7.integrity.len() == 0,
    "n=" + res7.integrity.len().to_str())

    # ---- 9. integrity: a dangling operand is caught ----
    let bad_blk: RVBlock = rv_entry([rv_ins("t1", "binop",
    [rv_arg_op("+"), rv_arg_var("v_ghost"), rv_arg_lit_int(1)], 1,
    "int")])
    let res8: RVRes = rv_analyze_function(ctx, rv_mk_fn("dangling", [],
    [bad_blk]), RVSeed { st: rv_state_new(), has: false })
    rv_vec_check(v, "integrity: a dangling var operand fails",
    rv_integrity_has(res8, "dangling-var"), "")

    # ---- 10. integrity: a dangling label is caught ----
    let bad_lab: RVBlock = rv_block("entry")
    bad_lab.term = rv_ins("", "jump", [rv_arg_label("nowhere")], 1, "")
    bad_lab.has_term = true
    let res9: RVRes = rv_analyze_function(ctx, rv_mk_fn("badlabel", [],
    [bad_lab]), RVSeed { st: rv_state_new(), has: false })
    rv_vec_check(v, "integrity: a dangling label fails",
    rv_integrity_has(res9, "dangling-label"), "")

    # ---- 11. the forged-annotation audit: x * 2 annotated -> fail ----
    let forge_blk: RVBlock = rv_entry([])
    forge_blk.instrs.push(rv_ins("t1", "const", [rv_arg_lit_int(2)], 1,
    "int"))
    let forged_ins: RVIns = rv_ins("t2", "binop",
    [rv_arg_op("*"), rv_arg_var("v_x"), rv_arg_var("t1")], 1, "int")
    forged_ins.safe_overflow = true
    forge_blk.instrs.push(forged_ins)
    let res10: RVRes = rv_analyze_function(ctx, rv_mk_fn("forged", ["x"],
    [forge_blk]), RVSeed { st: rv_state_new(), has: false })
    rv_vec_check(v, "audit: safe_overflow on x*2 is forged",
    res10.annotations.len() == 1
    && res10.annotations.get(0).certified == false,
    "n=" + res10.annotations.len().to_str())

    # ---- 12. the audit accepts a PINNED identity ----
    let id_blk: RVBlock = rv_entry([])
    id_blk.instrs.push(rv_ins("t1", "const", [rv_arg_lit_int(0)], 1,
    "int"))
    let id_ins: RVIns = rv_ins("t2", "binop",
    [rv_arg_op("+"), rv_arg_var("v_x"), rv_arg_var("t1")], 1, "int")
    id_ins.safe_overflow = true
    id_blk.instrs.push(id_ins)
    let res11: RVRes = rv_analyze_function(ctx, rv_mk_fn("identity", ["x"],
    [id_blk]), RVSeed { st: rv_state_new(), has: false })
    rv_vec_check(v, "audit: safe_overflow on x+0 certifies (identity)",
    res11.annotations.len() == 1
    && res11.annotations.get(0).certified == true, "")

    # ---- 13. the replay-law classification table (synthetic IR) ----
    # mod0/mod1 sharing the ONE site; the baseline verdict is a free
    # variable of the table.
    let plus_ins: RVIns = rv_ins("t1", "binop",
    [rv_arg_op("+"), rv_arg_var("v_a"), rv_arg_var("v_b")], 5, "int")

    # 13a. proven claim, bounded seeds -> re-proves -> REPLAYED
    let sd_a: RState = rv_state_new()
    sd_a.ints.set("v_a", IVal { lo: 0, hi: 100 })
    sd_a.ints.set("v_b", IVal { lo: 0, hi: 100 })
    let rep_a: JDoc = rv_law_pair(plus_ins, sd_a, true, false)
    rv_vec_check(v, "law: proven + re-provable -> replayed",
    obj_get_str(obj_get(obj_get(obj_get(rep_a, "functions"), "f"),
    "ovf@5"), "class") == rv_c_replayed()
    && obj_get_str(rep_a, "verdict") == "REPLAY-OK", "")

    # 13b. proven claim, UNBOUNDED seeds -> LOST-PROOF (the forged
    # elision the tool exists to catch)
    let sd_b: RState = rv_state_new()
    let rep_b: JDoc = rv_law_pair(plus_ins, sd_b, true, false)
    rv_vec_check(v, "law: proven + not re-provable -> lost-proof (fail)",
    obj_get_str(obj_get(obj_get(obj_get(rep_b, "functions"), "f"),
    "ovf@5"), "class") == rv_c_lost_proof()
    && obj_get_str(rep_b, "verdict") == "REPLAY-FAILED"
    && rv_failure_has(rep_b, rv_f_lost_proof()), "")

    # 13c. checked claim, unbounded seeds -> replayed-checked
    let sd_c: RState = rv_state_new()
    let rep_c: JDoc = rv_law_pair(plus_ins, sd_c, false, false)
    rv_vec_check(v, "law: checked + checked -> replayed-checked",
    obj_get_str(obj_get(obj_get(obj_get(rep_c, "functions"), "f"),
    "ovf@5"), "class") == rv_c_replayed_checked()
    && obj_get_str(rep_c, "verdict") == "REPLAY-OK", "")

    # 13d. checked claim, bounded seeds -> new-proof (informational)
    let sd_d: RState = rv_state_new()
    sd_d.ints.set("v_a", IVal { lo: 0, hi: 100 })
    sd_d.ints.set("v_b", IVal { lo: 0, hi: 100 })
    let rep_d: JDoc = rv_law_pair(plus_ins, sd_d, false, false)
    rv_vec_check(v, "law: checked + now provable -> new-proof (named, "
    + "not fail)",
    obj_get_str(obj_get(obj_get(obj_get(rep_d, "functions"), "f"),
    "ovf@5"), "class") == rv_c_new_proof()
    && obj_get_str(rep_d, "verdict") == "REPLAY-OK", "")

    # 13e. the site eliminated (folded) between IR0 and IR1 -> the
    # claim discharges vacuously
    let sd_e: RState = rv_state_new()
    let rep_e: JDoc = rv_law_pair(plus_ins, sd_e, true, true)
    rv_vec_check(v, "law: eliminated site -> vacuous discharge",
    obj_get_str(obj_get(obj_get(obj_get(rep_e, "functions"), "f"),
    "ovf@5"), "class") == rv_c_eliminated()
    && obj_get_str(rep_e, "verdict") == "REPLAY-OK", "")

    # 13f. an unprovable claim whose site was eliminated -> still OK
    # (the claim is gone WITH the site)
    let sd_f: RState = rv_state_new()
    let rep_f: JDoc = rv_law_pair(plus_ins, sd_f, true, true)
    rv_vec_check(v, "law: proven claim + eliminated site -> eliminated, "
    + "not lost",
    obj_get_str(obj_get(obj_get(obj_get(rep_f, "functions"), "f"),
    "ovf@5"), "class") == rv_c_eliminated()
    && obj_get_str(rep_f, "verdict") == "REPLAY-OK", "")

    # ---- 14. the report is deterministic and canonically serialised ----
    let sd_g: RState = rv_state_new()
    sd_g.ints.set("v_a", IVal { lo: 0, hi: 100 })
    sd_g.ints.set("v_b", IVal { lo: 0, hi: 100 })
    let rep_g1: JDoc = rv_law_pair(plus_ins, sd_g, true, false)
    let rep_g2: JDoc = rv_law_pair(plus_ins, sd_g, true, false)
    rv_vec_check(v, "report: byte-identical over unchanged inputs",
    rv_canonical_json(rep_g1) == rv_canonical_json(rep_g2), "")
    rv_vec_check(v, "report: schema pinned",
    obj_get_str(rep_g1, "schema") == rv_report_schema()
    && obj_get_str(rep_g1, "tool") == "hls-reverify"
    && obj_get_str(rep_g1, "tool_version") == rv_version(), "")

    # ---- 15. the seed mapping: requires -> v_ names ----
    rv_vec_check(v, "seeds: the interval lands on v_i",
    seed.has && seed.st.ints.get_or("v_i", iv_top()).lo == 0, "")
    rv_vec_check(v, "seeds: the symbolic len bound rides the lenhi map",
    seed.st.lenhi.get_or("v_i", "") == "v_xs", "")

    println("hls-reverify selftest: " + v.passed.to_str() + " passed / "
    + v.failed.to_str() + " failed")
    if v.failed > 0 {
        return 1
    }
    return 0
}

# rv_selftest_mode(mode) — the battery's old python-driver reaches,
# restated as selftest submodes (same key=value protocol, same
# assertions): the pinned identity whitelist, the for-get
# discriminator, the forged-annotation audit and the dangling-operand
# integrity vector, each over the same synthetic IR the selftest
# vectors build. Unknown modes are usage errors.
fn rv_selftest_mode(mode: str) -> int uses IO {
    if mode == "identities" {
        # the pinned ALGEBRAIC_IDENTITIES whitelist, in order
        let names: list[str] = rv_alg_identities()
        let mut i: int = 0
        while i < names.len() {
            println(names.get(i))
            i = i + 1
        }
        return 0
    }
    if mode == "forget" {
        # the for-loop element-read discriminator: the generated
        # `v_X = list_get <iter>, v_X__i` is not a user site
        let gen: RVIns = rv_ins("v_x", "list_get",
        [rv_arg_var("v_xs"), rv_arg_var("v_x__i")], 1, "")
        let user: RVIns = rv_ins("t1", "list_get",
        [rv_arg_var("v_xs"), rv_arg_var("v_i")], 1, "")
        let other: RVIns = rv_ins("v_x", "list_get",
        [rv_arg_var("v_xs"), rv_arg_var("v_y")], 1, "")
        if rv_is_generated_for(gen) && !rv_is_generated_for(user)
        && !rv_is_generated_for(other) {
            println("forget=1")
        } else {
            println("forget=0")
        }
        return 0
    }
    if mode == "forge" {
        # a hand-built IR with x*2 annotated safe_overflow — the audit
        # must refuse to certify it
        let blk: RVBlock = rv_entry([])
        blk.instrs.push(rv_ins("t1", "const", [rv_arg_lit_int(2)], 1,
        "int"))
        let forged_ins: RVIns = rv_ins("t2", "binop",
        [rv_arg_op("*"), rv_arg_var("v_x"), rv_arg_var("t1")], 1, "int")
        forged_ins.safe_overflow = true
        blk.instrs.push(forged_ins)
        let res: RVRes = rv_analyze_function(new_ctx(""),
        rv_mk_fn("forged", ["x"], [blk]),
        RVSeed { st: rv_state_new(), has: false })
        let mut certified: int = 0
        if res.annotations.len() > 0
        && res.annotations.get(0).certified {
            certified = 1
        }
        println("n=" + res.annotations.len().to_str())
        println("certified=" + certified.to_str())
        return 0
    }
    if mode == "dangle" {
        # a hand-built IR reading an undefined operand — the integrity
        # audit must catch it
        let blk: RVBlock = rv_entry([rv_ins("t1", "binop",
        [rv_arg_op("+"), rv_arg_var("v_ghost"), rv_arg_lit_int(1)], 1,
        "int")])
        let res: RVRes = rv_analyze_function(new_ctx(""),
        rv_mk_fn("dangling", [], [blk]),
        RVSeed { st: rv_state_new(), has: false })
        if rv_integrity_has(res, "dangling-var") {
            println("dangling=1")
        } else {
            println("dangling=0")
        }
        return 0
    }
    eprint(rv_usage_text())
    return 2
}

# rv_law_pair(site, seeds, proven_seed, eliminated) — the law-table
# vector helper: mod0/mod1 sharing the ONE site (IR1 drops it when
# `eliminated`), the baseline claim is (ovf, 5, proven_seed), the
# analysis runs over mod1 with `seeds`.
fn rv_law_pair(site: RVIns, seeds: RState, proven_seed: bool,
eliminated: bool) -> JDoc {
    let mod0: RVMod = rv_mod()
    let f0: RVFn = rv_mk_fn("f", ["a", "b"], [rv_entry([site])])
    mod0.fns.set("f", f0)
    mod0.order.push("f")
    let mod1: RVMod = rv_mod()
    let ir1_instrs: list[RVIns] = []
    if !eliminated {
        ir1_instrs.push(site)
    }
    let f1: RVFn = rv_mk_fn("f", ["a", "b"], [rv_entry(ir1_instrs)])
    mod1.fns.set("f", f1)
    mod1.order.push("f")
    let baseline: map[str, list[RVSite]] = map_new()
    let rows: list[RVSite] = []
    rows.push(RVSite {
        kind: rv_kind_ovf(), line: 5, dest: "", proven: proven_seed
    })
    baseline.set("f", rows)
    let analyses: map[str, RVRes] = map_new()
    analyses.set("f", rv_analyze_function(new_ctx(""), f1, rv_seed_of(seeds)))
    return rv_reconcile("selftest", false, baseline, mod0, mod1, analyses)
}

# ============================================================================
# The CLI — the .py's own surface: FILE [--lto] [--json] [--out DIR],
# `selftest`, -h/--help, exit 0/1/2. The front-end runs in a probe
# child (--probe-check) so a broken tree is a clean refusal, never a
# crash — the hls-audit pattern.
# ============================================================================

struct RunCap {
    code: int,
    out: str,
    err: str
}

fn rv_spawn_cap(program: str, argv: list[str]) -> RunCap uses Proc {
    let r: RunCap = RunCap {
        code: -1, out: "", err: ""
    }
    let pid: int = proc_spawn(program, argv, 2, 1, 1)
    if pid < 1 {
        return r
    }
    let mut out: str = ""
    let mut chunk: str = proc_child_read(pid, 1, 65536)
    while chunk != "" {
        out = out + chunk
        chunk = proc_child_read(pid, 1, 65536)
    }
    let mut err: str = ""
    let mut chunk2: str = proc_child_read(pid, 2, 65536)
    while chunk2 != "" {
        err = err + chunk2
        chunk2 = proc_child_read(pid, 2, 65536)
    }
    r.code = proc_wait(pid)
    proc_child_close(pid, 1)
    proc_child_close(pid, 2)
    r.out = out
    r.err = err
    return r
}

fn rv_self_path() -> str uses Args {
    let argv: list[str] = args()
    if argv.len() > 0 {
        return argv.get(0)
    }
    return ""
}

# rv_probe_check_child(path) — load the crate + check it (the merged
# fixpoint). Panics on anything that does not check.
fn rv_probe_check_child(path: str) -> int uses IO, Proc, Fs, Exit {
    let ctx: Ctx = hl_load_crate(path)
    hl_check(ctx)
    return 0
}

# rv_probe_fail_text(flag, path) — the parent side: spawn the child,
# map the outcome. Returns the failure text ("" when ok).
fn rv_probe_fail_text(flag: str, path: str) -> str uses Proc, Args {
    let selfp: str = rv_self_path()
    if selfp == "" {
        return "cannot re-exec the tool for the probe"
    }
    let argv: list[str] = [flag, path]
    let r: RunCap = rv_spawn_cap(selfp, argv)
    if r.code == 0 {
        return ""
    }
    let mut why: str = r.err.trim()
    if why.starts_with("panic: ") {
        why = why.slice(7, why.len())
    }
    let nl: int = why.find("\n")
    if nl > 0 {
        why = why.slice(0, nl)
    }
    return why
}

# rv_shell_quote(s) — single quotes, doubled interior quotes.
fn rv_shell_quote(s: str) -> str {
    let mut out: str = "'"
    let mut i: int = 0
    while i < s.len() {
        if s.byte_at(i) == 39 {
            out = out + "'\\''"
        } else {
            out = out + s.slice(i, i + 1)
        }
        i = i + 1
    }
    return out + "'"
}

# rv_path_stem(path) — the basename without its extension.
fn rv_path_stem(path: str) -> str {
    let mut base: str = path
    let mut k: int = path.len() - 1
    while k >= 0 {
        if path.byte_at(k) == 47 {
            base = path.slice(k + 1, path.len())
            break
        }
        k = k - 1
    }
    let dot: int = base.find(".")
    if dot > 0 {
        return base.slice(0, dot)
    }
    return base
}

# rv_usage_text() — the .py's own no-file usage (stderr, exit 2).
fn rv_usage_text() -> str {
    return "usage: hls-reverify FILE [--lto] [--json] [--out DIR]\n"
    + "       hls-reverify selftest\n"
}

# rv_help_text() — argparse's print_help (stdout, exit 0).
fn rv_help_text() -> str {
    return "usage: hls-reverify [--lto] [--json] [--out DIR] [-h] [file]\n"
    + "\n"
    + "memory-safety re-verification under -O fast (proof replay)\n"
    + "\n"
    + "positional arguments:\n"
    + "  file        the entry .hls file\n"
    + "\n"
    + "options:\n"
    + "  --lto       raise the cross-crate inline threshold (the --lto "
    + "build)\n"
    + "  --json      print the machine report\n"
    + "  --out DIR   also write hls-reverify-<entry>.report.json into "
    + "DIR\n"
    + "  -h, --help\n"
}

# rv_arg_error(flag) — argparse's unrecognized-arguments error.
fn rv_arg_error(flag: str) -> str {
    return rv_help_text() + "hls-reverify: error: unrecognized "
    + "arguments: " + flag + "\n"
}

struct RVCli {
    code: int,
    err: str
}

# rv_run_reverify(path, lto, json_out, out_dir) — the whole pipeline:
# probe-check, load+check in process, baseline, IR0/IR1 + the fast
# optimiser, the replay, the law, the outputs.
fn rv_run_reverify(path: str, lto: bool, json_out: bool, out_dir: str)
    -> RVCli uses IO, Fs, Proc, Args {
    if !file_exists(path) {
        return RVCli {
            code: 1, err: "error: cannot open file " + path
        }
    }
    let bad: str = rv_probe_fail_text("--probe-check", path)
    if bad != "" {
        return RVCli {
            code: 1, err: "compile error: " + bad
        }
    }
    let ctx: Ctx = hl_load_crate(path)
    hl_check(ctx)

    let baseline: map[str, list[RVSite]] = rv_harvest_baseline(ctx)

    let mod0: RVMod = rv_mod()
    let mod1: RVMod = rv_mod()
    let build_err: str = rv_build_module(ctx)
    if build_err != "" {
        return RVCli {
            code: 1,
            err: "compile error: the HLIR layer cannot represent this "
            + "program: " + build_err
        }
    }
    # IR0 (pre-optimisation) and IR1 (optimised, fast=True)
    let build1: RVBuild = rv_builder(ctx)
    let berr1: str = rv_build_into(build1)
    if berr1 != "" {
        return RVCli {
            code: 1,
            err: "compile error: the HLIR layer cannot represent this "
            + "program: " + berr1
        }
    }
    mod0.fns = build1.mod.fns
    mod0.order = build1.mod.order
    let build2: RVBuild = rv_builder(ctx)
    let berr2: str = rv_build_into(build2)
    if berr2 != "" {
        return RVCli {
            code: 1,
            err: "compile error: the HLIR layer cannot represent this "
            + "program: " + berr2
        }
    }
    mod1.fns = build2.mod.fns
    mod1.order = build2.mod.order
    rv_optimize(mod1, true, lto)

    # the replay over every function of the transformed IR
    let analyses: map[str, RVRes] = map_new()
    let mut fi: int = 0
    while fi < mod1.order.len() {
        let fname: str = mod1.order.get(fi)
        let irf: RVFn = mod1.fns.get_or(fname, rv_dummy_fn_ir())
        let mut seed: RVSeed = RVSeed {
            st: rv_state_new(), has: false
        }
        if ctx.fns.has(fname) {
            let ast_fn: FnInfo = ctx.fns.get_or(fname, dummy_fn())
            seed = rv_seed_function(ctx, ast_fn)
        }
        analyses.set(fname, rv_analyze_function(ctx, irf, seed))
        fi = fi + 1
    }

    let report: JDoc = rv_reconcile(path, lto, baseline, mod0, mod1,
    analyses)

    if json_out {
        println(rv_canonical_json(report))
    } else if out_dir == "" {
        println(rv_format_text(report))
    }
    if out_dir != "" {
        proc_exec("mkdir -p " + rv_shell_quote(out_dir))
        let dest: str = out_dir + "/hls-reverify-"
        + rv_path_stem(path) + ".report.json"
        let tmp: str = dest + ".tmp"
        write_file(tmp, rv_canonical_json(report) + "\n")
        proc_exec("mv " + rv_shell_quote(tmp) + " "
        + rv_shell_quote(dest))
        if !json_out {
            println("report: " + dest)
            println(rv_format_text(report))
        }
    }
    if obj_get_str(report, "verdict") == "REPLAY-OK" {
        return RVCli {
            code: 0, err: ""
        }
    }
    return RVCli {
        code: 1, err: ""
    }
}

# rv_build_into(b) — the builder driver over fn_order (externs skipped),
# "" or the refusal text.
fn rv_build_into(b: RVBuild) -> str {
    let ctx: Ctx = b.ctx
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if !f.is_extern {
            rv_build_fn(b, key, f)
            if b.err != "" {
                return b.err
            }
        }
        i = i + 1
    }
    return ""
}

# rv_main() — the CLI entry.
fn rv_main() -> int uses IO, Fs, Proc, Args, Exit {
    let argv: list[str] = args()
    # the probe children first (re-exec'd by the parent side)
    if argv.len() > 2 && argv.get(1) == "--probe-check" {
        return rv_probe_check_child(argv.get(2))
    }
    if argv.len() > 1 && argv.get(1) == "selftest" {
        if argv.len() > 2 {
            return rv_selftest_mode(argv.get(2))
        }
        return rv_selftest()
    }
    # the argparse surface: FILE [--lto] [--json] [--out DIR]
    # [-h/--help], --flag value and --flag=value forms.
    let mut file: str = ""
    let mut lto: bool = false
    let mut json_out: bool = false
    let mut out_dir: str = ""
    let mut want_help: bool = false
    let mut bad_flag: str = ""
    let mut i: int = 1
    while i < argv.len() {
        let a: str = argv.get(i)
        if a == "-h" || a == "--help" {
            want_help = true
            i = i + 1
            continue
        }
        if a == "--lto" {
            lto = true
            i = i + 1
            continue
        }
        if a == "--json" {
            json_out = true
            i = i + 1
            continue
        }
        if a == "--out" || a.starts_with("--out=") {
            if a.starts_with("--out=") {
                out_dir = a.slice(6, a.len())
                i = i + 1
                continue
            }
            if i + 1 >= argv.len() {
                eprint(rv_help_text())
                eprint("hls-reverify: error: argument --out: expected "
                + "one argument\n")
                return 2
            }
            out_dir = argv.get(i + 1)
            i = i + 2
            continue
        }
        if a.starts_with("--") && a.len() > 2 {
            bad_flag = a
            i = i + 1
            continue
        }
        if file == "" {
            file = a
        } else {
            bad_flag = a
        }
        i = i + 1
    }
    if want_help {
        print(rv_help_text())
        return 0
    }
    if bad_flag != "" {
        eprint(rv_arg_error(bad_flag))
        return 2
    }
    if file == "" {
        eprint(rv_usage_text())
        return 2
    }
    let r: RVCli = rv_run_reverify(file, lto, json_out, out_dir)
    if r.err != "" {
        eprint(r.err + "\n")
        return 1
    }
    return r.code
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    return rv_main()
}
