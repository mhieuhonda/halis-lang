    return "ovf"
}

fn rv_kind_div() -> str {
    return "div"
}

fn rv_kind_bnd() -> str {
    return "bnd"
}

# list_set / get — advisory only (always checked in every backend).
fn rv_kind_set() -> str {
    return "set"
}

# The replay-law verdicts (per baseline claim class).
fn rv_c_replayed() -> str {
    return "replayed"
}

fn rv_c_replayed_checked() -> str {
    return "replayed-checked"
}

fn rv_c_lost_proof() -> str {
    return "lost-proof"
}

fn rv_c_eliminated() -> str {
    return "eliminated"
}

fn rv_c_inline_derived() -> str {
    return "inline-derived"
}

fn rv_c_new_proof() -> str {
    return "new-proof"
}

fn rv_c_unreachable() -> str {
    return "unreachable"
}

fn rv_c_no_claim() -> str {
    return "no-claim"
}

# Failure classes (any one flips the verdict to REPLAY-FAILED).
fn rv_f_lost_proof() -> str {
    return "lost-proof"
}

fn rv_f_forged() -> str {
    return "forged-annotation"
}

fn rv_f_broken_ir() -> str {
    return "broken-ir"
