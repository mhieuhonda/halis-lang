# ---- the scaffold templates (the .py's TEMPLATE_*, one flat
# substitution each; the build line points at the native twin) -----

fn hwp_template_main(name: str, stem: str, fname: str) -> str {
    return "# " + name + " — Halis web library (hls-wasm-pack Stage 76)\n"
    + "#\n"
    + "# Build a publish-ready npm package with:\n"
    + "#   bin/hlwasm-pack build " + stem + ".hls --out pkg --target bundler\n"
    + "#\n"
    + "# NOTE ON THE SUBSET: the freestanding wasm emitter lowers let /\n"
    + "# if / while / for-range / calls / literals — struct literals,\n"
    + "# match, and method calls land with the HLIR emitter, so this\n"
    + "# template stays inside the supported subset.\n"
    + "\n"
    + "import \"std.jsffi\"\n"
    + "\n"
    + "fn " + fname + "_add(a: int, b: int) -> int {\n"
    + "    return a + b\n"
    + "}\n"
    + "\n"
    + "fn " + fname + "_greet(name: str) -> str {\n"
    + "    return \"Hello, \" + name + \"!\"\n"
    + "}\n"
    + "\n"
    + "fn jsffi_on_callback(cb_id: int, arg: str) -> str uses IO {\n"
    + "    if cb_id == 1 {\n"
    + "        return " + fname + "_greet(arg)\n"
    + "    }\n"
    + "    return \"\"\n"
    + "}\n"
    + "\n"
    + "fn main() -> int uses IO {\n"
    + "    println(\"" + name + " ready (\" + " + fname
    + "_add(40, 2).to_str() + \")\")\n"
    + "    js_console_log(" + fname + "_greet(\"wasm-pack\"))\n"
    + "    return 0\n"
    + "}\n"
}

fn hwp_template_toml(name: str) -> str {
    return "# hls.pack.toml — hls-wasm-pack project config (Stage 76).\n"
    + "# CLI flags always override these values.\n"
    + "[package]\n"
    + "name = \"" + name + "\"\n"
    + "version = \"0.1.0\"\n"
    + "description = \"" + name + " — a Halis WebAssembly library\"\n"
    + "license = \"MIT\"\n"
    + "target = \"bundler\"\n"
    + "out = \"pkg\"\n"
    + "wasm_opt = \"auto\"\n"
    + "opt_level = \"O3\"\n"
}

# hwp_slug — strip, lower, spaces and underscores to dashes.
fn hwp_slug(name: str) -> str {
    let lowered: str = str_to_lower_ascii(name.trim())
    let dashed: str = str_replace(lowered, " ", "-")
    return str_replace(dashed, "_", "-")
}

# hwp_fname — non-alnum chars to underscores (the template's fn
# prefix).
fn hwp_fname(stem: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < stem.len() {
        let b: int = stem.byte_at(i)
        if hwp_is_lower_alnum(b) || (b >= 65 && b <= 90) {
            out = out + stem.slice(i, i + 1)
        } else {
            out = out + "_"
        }
        i = i + 1
    }
    return out
}

# hwp_last_seg — the part after the final "/" (rsplit("/", 1)[-1]).
fn hwp_last_seg(name: str) -> str {
    let slash: int = name.find("/")
    if slash < 0 {
        return name
    }
    let mut last: int = -1
    let mut i: int = 0
    while i < name.len() {
        if name.byte_at(i) == 47 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return name
    }
    return name.slice(last + 1, name.len())
}

# ---- the subcommand runners ----------------------------------------------

# hwp_cmd_new — scaffold a new project; return the exit code.
fn hwp_cmd_new(log: HwpLog, cli: HwpCli) -> int
uses IO, Fs, Proc, Clock {
    let mut full: str = cli.new_name
    let mut scope: str = cli.new_scope
    if scope != "" {
        if !scope.starts_with("@") {
            scope = "@" + scope
        }
        full = scope + "/" + cli.new_name
    }
    if !hwp_is_valid_name(full) {
        hwp_log_error(log, "invalid package name '" + full + "'")
        return 2
    }
    let mut dest: str = cli.new_dir
    if dest == "" {
        dest = hwp_slug(hwp_last_seg(cli.new_name))
    }
    if dest == "" || file_exists(dest) {
        hwp_log_error(log, "destination already exists: '" + dest + "'")
        return 1
    }
    proc_exec("mkdir -p '" + hwp_shell_quote(dest) + "'")
    let stem: str = hwp_slug(hwp_last_seg(cli.new_name))
    let mut fname: str = hwp_fname(stem)
    if fname == "" {
        fname = "app"
    }
    write_file(hwp_join_path(dest, stem + ".hls"),
    hwp_template_main(full, stem, fname))
    write_file(hwp_join_path(dest, "hls.pack.toml"),
    hwp_template_toml(full))
    write_file(hwp_join_path(dest, "README.md"),
    "# " + full + "\n\nA Halis WebAssembly library. "
    + "See `hls.pack.toml` for pack settings.\n")
    hwp_log_info(log, "created " + dest + "/ (" + stem
    + ".hls + hls.pack.toml + README.md)")
    return 0
}

# hwp_resolve_cfg — load the config file, overlay the CLI flags
# (CLI wins), fuse scope + name (the .py's _resolve_opts).
fn hwp_resolve_cfg(cli: HwpCli) -> HwpCfg uses Fs {
    let mut cfg: HwpCfg = hwp_load_config(cli.config)
    if cli.name != "" {
        cfg.name = cli.name
    }
    if cli.version != "" {
        cfg.version = cli.version
    }
    if cli.description != "" {
        cfg.description = cli.description
    }
    if cli.scope != "" {
        cfg.scope = cli.scope
    }
    if cli.target != "" {
        cfg.target = cli.target
    }
    if cli.out != "" {
        cfg.out = cli.out
    }
    if cli.license != "" {
        cfg.license = cli.license
    }
    if cli.repository != "" {
        cfg.repository = cli.repository
    }
    if cli.authors.len() > 0 {
        cfg.authors = cli.authors
    }
    if cli.keywords.len() > 0 {
        cfg.keywords = cli.keywords
    }
    if cli.wasm_opt != "" {
        cfg.wasm_opt = cli.wasm_opt
    }
    if cli.opt_level != "" {
        cfg.opt_level = cli.opt_level
    }
    if cli.registry != "" {
        cfg.registry = cli.registry
    }
    if cli.access != "" {
        cfg.access = cli.access
    }
    if cli.tag != "" {
        cfg.tag = cli.tag
    }
    if cfg.scope != "" && cfg.name != "" && !cfg.name.contains("/") {
        let mut s: str = cfg.scope
        if !s.starts_with("@") {
            s = "@" + s
        }
        cfg.name = s + "/" + cfg.name
    }
    return cfg
}

# hwp_cmd_build — compile INPUT.hls -> publish-ready pkg/ dir.
fn hwp_cmd_build(log: HwpLog, cli: HwpCli) -> int
uses IO, Fs, Proc, Clock {
    let mut cfg: HwpCfg = hwp_resolve_cfg(cli)
    if cfg.name == "" && cli.input != "" {
        let base: str = hwp_basename(cli.input)
        let dot: int = base.find(".")
        let mut stem: str = base
        if dot >= 0 {
            stem = base.slice(0, dot)
        }
        let slug: str = hwp_slug(stem)
        if slug != "" {
            cfg.name = slug
        } else {
            cfg.name = "halis-app"
        }
    }
    let out_dir: str = hwp_cfg_out(cfg)
    let built: Result[JsonValue, str] = hwp_build(log, cli.input,
    out_dir, cfg)
    if result_is_err(built) {
        hwp_log_error(log, hwp_unwrap_err(built))
        return 1
    }
    return 0
}

# hwp_cmd_pack — tar a built pkg/ into <stem>-<version>.tgz.
fn hwp_cmd_pack(log: HwpLog, cli: HwpCli) -> int
uses IO, Fs, Proc, Clock {
    let mut pkg_dir: str = cli.pkg
    if pkg_dir == "" {
        pkg_dir = hwp_default_out_dir()
    }
    let packed: Result[str, str] = hwp_pack(log, pkg_dir, cli.tgz)
    if result_is_err(packed) {
        hwp_log_error(log, hwp_unwrap_err(packed))
        return 1
    }
    return 0
}

# hwp_cmd_publish — dry-run (default) or real `npm publish`.
fn hwp_cmd_publish(log: HwpLog, cli: HwpCli) -> int
uses IO, Fs, Proc, Clock {
    let mut access: str = cli.access
    if access == "" {
        access = "public"
    }
    let mut tag: str = cli.tag
    if tag == "" {
        tag = "latest"
    }
    let res: Result[HwpPublishResult, str] = hwp_publish(log,
    cli.tarball, cli.registry, access, tag, !cli.no_dry_run)
    if result_is_err(res) {
        hwp_log_error(log, hwp_unwrap_err(res))
        return 1
    }
    let out: HwpPublishResult = result_unwrap(res)
    if out.published {
        return 0
    }
    if out.dry_run {
        return 0
    }
    return 1
}

# hwp_cmd_check — validate a built pkg/ dir (no execution).
fn hwp_cmd_check(cli: HwpCli) -> int uses IO, Fs {
    let res: HwpCheckResult = hwp_check(cli.check_pkg)
    hwp_print_check(res, cli.check_pkg)
    if res.ok {
        return 0
    }
    return 1
}

# hwp_cmd_test — node smoke-run a built pkg/ dir.
fn hwp_cmd_test(cli: HwpCli) -> int uses IO, Fs, Proc {
    let res: list[str] = hwp_test_pkg(cli.check_pkg)
    let status: str = str_to_upper_ascii(res.get(0))
    println("TEST " + status + ": " + cli.check_pkg + " ("
    + res.get(1) + ")")
    if res.get(0) == "ok" || res.get(0) == "skip" {
        return 0
    }
    return 1
}

# ============================================================================
# The unit surface — the gates' shim questions, answered by the
# binary (the .py era's importlib driver: surface, validate, scan,
# ts, unpack, evil, publish_command). Every mode prints exactly
# what the python driver printed; the comparisons stay in the gate.
# ============================================================================

# hwp_unit_surface — the import surface: the facade's main + the
# ten part modules, each present as a section of this one file.
fn hwp_unit_surface() -> int uses IO {
    println("has_main=1")
    let mods: list[str] = ["hwp_common", "hwp_manifest", "hwp_scan",
    "hwp_types", "hwp_glue", "hwp_build", "hwp_pack",
    "hwp_publish", "hwp_validate", "hwp_cli"]
    let mut i: int = 0
    while i < mods.len() {
        println(mods.get(i) + "=1")
        i = i + 1
    }
    return 0
}

# hwp_unit_validate — npm name/version rules over the battery's
# vectors (fed on stdin as JSON), one verdict line each.
fn hwp_unit_validate() -> int uses IO, Fs {
    let parsed: Result[JsonValue, str] = json_parse_result(
    read_file("/dev/stdin"))
    if result_is_err(parsed) {
        eprint("error: bad JSON on stdin: " + hwp_unwrap_err(parsed)
        + "\n")
        return 1
    }
    let d: JsonValue = result_unwrap(parsed)
    let groups: list[str] = ["good_names", "bad_names",
    "good_versions", "bad_versions"]
    let prefixes: list[str] = ["gname", "bname", "gver", "bver"]
    let mut g: int = 0
    while g < groups.len() {
        let arr: JsonValue = json_object_get(d, groups.get(g))
        if json_is_array(arr) {
            let mut i: int = 0
            while i < arr.arr.len() {
                let item: JsonValue = arr.arr.get(i)
                let mut val: str = ""
                if json_is_str(item) {
                    val = json_str_value(item)
                }
                let mut verdict: int = 0
                if g < 2 {
                    if hwp_is_valid_name(val) {
                        verdict = 1
                    }
                } else {
                    if hwp_is_valid_version(val) {
                        verdict = 1
                    }
                }
                println(prefixes.get(g) + " " + i.to_str() + "="
                + verdict.to_str())
                i = i + 1
            }
        }
        g = g + 1
    }
    return 0
}

# hwp_unit_scan — the demo's publish surface: fns, structs, enums,
# the std/jsffi.hls extern imports, and the exported set.
fn hwp_unit_scan() -> int uses IO, Fs {
    let surface: HwpSurface = hwp_scan_file(
    "examples/wasm_pack_demo.hls")
    let mut i: int = 0
    while i < surface.functions.len() {
        let f: HwpFn = surface.functions.get(i)
        println("fn " + f.name + " params=" + f.params.len().to_str()
        + " returns=" + f.returns)
        i = i + 1
    }
    let mut si: int = 0
    while si < surface.structs.len() {
        let st: HwpStruct = surface.structs.get(si)
        println("struct " + st.name + " fields="
        + st.fields.len().to_str())
        si = si + 1
    }
    let mut ei: int = 0
    while ei < surface.enums.len() {
        let en: HwpEnum = surface.enums.get(ei)
        println("enum " + en.name + " variants="
        + en.variants.len().to_str())
        ei = ei + 1
    }
    let jsffi: HwpSurface = hwp_scan_file("std/jsffi.hls")
    println("js_imports=" + jsffi.js_imports.len().to_str())
    let exps: list[HwpFn] = hwp_exported_functions(surface)
    let mut xi: int = 0
    while xi < exps.len() {
        println("exp " + exps.get(xi).name)
        xi = xi + 1
    }
    return 0
}

# hwp_unit_ts — the TypeScript mapping vectors (stdin JSON) + the
# rendered d.ts for the demo package.
fn hwp_unit_ts() -> int uses IO, Fs {
    let parsed: Result[JsonValue, str] = json_parse_result(
    read_file("/dev/stdin"))
    if result_is_err(parsed) {
        eprint("error: bad JSON on stdin: " + hwp_unwrap_err(parsed)
        + "\n")
        return 1
    }
    let d: JsonValue = result_unwrap(parsed)
    let types: JsonValue = json_object_get(d, "types")
    if json_is_array(types) {
        let mut i: int = 0
        while i < types.arr.len() {
            let item: JsonValue = types.arr.get(i)
            if json_is_str(item) {
                println("ts " + json_str_value(item) + " => "
                + hwp_halis_to_ts(json_str_value(item)))
            }
            i = i + 1
        }
    }
    let surface: HwpSurface = hwp_scan_file(
    "examples/wasm_pack_demo.hls")
    let dts: str = hwp_render_dts(surface, "wasm-pack-demo")
    println("dts-begin")
    println(dts)
    println("dts-end")
    return 0
}

# hwp_unit_unpack — the tarball round-trip probe.
fn hwp_unit_unpack(tgz: str, dest: str) -> int uses IO, Fs, Proc {
    let res: Result[list[str], str] = hwp_unpack(tgz, dest)
    if result_is_err(res) {
        eprint("error: " + hwp_unwrap_err(res) + "\n")
        return 1
    }
    println("extracted=" + result_unwrap(res).len().to_str())
    return 0
}

# hwp_unit_evil — build the hostile tarball, then unpack it
# expecting the refusal ("raised=1") with nothing written.
fn hwp_unit_evil(evil: str, dest: str) -> int uses IO, Fs, Proc {
    hwp_make_evil_tar(evil)
    let res: Result[list[str], str] = hwp_unpack(evil, dest)
    if result_is_err(res) {
        println("raised=1")
        return 0
    }
    println("raised=0")
    return 0
}

# hwp_unit_publish_command — the dry-run command shape, one argv
# element per line.
fn hwp_unit_publish_command(tgz: str) -> int uses IO {
    let res: Result[list[str], str] = hwp_publish_command(tgz,
    "https://r.example.com/npm/", "restricted", "beta")
    if result_is_err(res) {
        eprint("error: " + hwp_unwrap_err(res) + "\n")
        return 1
    }
    let cmd: list[str] = result_unwrap(res)
    let mut i: int = 0
    while i < cmd.len() {
        println(cmd.get(i))
        i = i + 1
    }
    return 0
}

# ============================================================================
# main — the dispatch (global flags, subcommands, unit modes).
# ============================================================================

fn main() -> int uses IO, Fs, Proc, Args, Exit, Clock {
    let argv: list[str] = args()
    let unit_modes: list[str] = ["--unit-surface", "--unit-validate",
    "--unit-scan", "--unit-ts", "--unit-unpack", "--unit-evil",
    "--unit-publish-command"]
    if argv.len() > 1 {
        let a1: str = argv.get(1)
        let mut u: int = 0
        while u < unit_modes.len() {
            if a1 == unit_modes.get(u) {
                if a1 == "--unit-surface" {
                    return hwp_unit_surface()
                }
                if a1 == "--unit-validate" {
                    return hwp_unit_validate()
                }
                if a1 == "--unit-scan" {
                    return hwp_unit_scan()
                }
                if a1 == "--unit-ts" {
                    return hwp_unit_ts()
                }
                if a1 == "--unit-unpack" {
                    if argv.len() < 4 {
                        eprintln("usage: hlwasm-pack --unit-unpack TGZ DEST")
                        return 2
                    }
                    return hwp_unit_unpack(argv.get(2), argv.get(3))
                }
                if a1 == "--unit-evil" {
                    if argv.len() < 4 {
                        eprintln("usage: hlwasm-pack --unit-evil EVIL DEST")
                        return 2
                    }
                    return hwp_unit_evil(argv.get(2), argv.get(3))
                }
                if a1 == "--unit-publish-command" {
                    if argv.len() < 3 {
                        eprintln("usage: hlwasm-pack --unit-publish-command TGZ")
                        return 2
                    }
                    return hwp_unit_publish_command(argv.get(2))
                }
            }
            u = u + 1
        }
    }

    let cli: HwpCli = hwp_parse_cli(argv)
    let log: HwpLog = hwp_log_new()
    if cli.color == 1 {
        log.auto = 1
        log.color = true
    }
    if cli.color == 0 {
        log.auto = 1
        log.color = false
    }
    if cli.err != "" {
        eprintln(hwp_help_text())
        eprintln("hlwasm-pack: error: " + cli.err)
        return 2
    }
    if cli.version_flag && cli.cmd == "" {
        println(hwp_banner())
        return 0
    }
    if cli.help_flag && cli.cmd == "" {
        println(hwp_help_text())
        return 0
    }
    if cli.cmd == "" {
        println(hwp_help_text())
        return 2
    }
    if cli.help_flag {
        if cli.cmd == "new" {
            println(hwp_help_new())
        } else if cli.cmd == "build" {
            println(hwp_help_build())
        } else if cli.cmd == "pack" {
            println(hwp_help_pack())
        } else if cli.cmd == "publish" {
            println(hwp_help_publish())
        } else if cli.cmd == "check" {
            println(hwp_help_check())
        } else {
            println(hwp_help_test())
        }
        return 0
    }
    if cli.cmd == "new" {
        return hwp_cmd_new(log, cli)
    }
    if cli.cmd == "build" {
        return hwp_cmd_build(log, cli)
    }
    if cli.cmd == "pack" {
        return hwp_cmd_pack(log, cli)
    }
    if cli.cmd == "publish" {
        return hwp_cmd_publish(log, cli)
    }
    if cli.cmd == "check" {
        return hwp_cmd_check(cli)
    }
    return hwp_cmd_test(cli)
}
