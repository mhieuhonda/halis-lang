# ============================================================================
# tools/hls-lsp.hls — the language server, in Halis.
# ----------------------------------------------------------------------------
# The native twin of the Python hls-lsp.py that retired with the lab
# interpreter: same CLI (the one-shot --check, the stdio JSON-RPC
# server), same wire, same exits. Stages 113/114/115 live on —
# go-to-definition across packages, inlay hints, the refactor actions —
# with the exact needles the acceptance batteries pinned against the
# .py years, because the batteries are the spec.
#
# Built on the compiler's own front-end (tools/hlfront.hls links the
# real lexer, parser and checker), so a symbol table can never drift
# from what bin/hlc believes about a program. The checker and the
# loader panic on bad input (the language has no exceptions), so every
# risky pass runs in a probe child — the tool re-execs itself with a
# private flag and the parent reads the outcome:
#   --probe-file PATH   one file: parse + symbol table + the check
#                       verdict, as machine-readable lines
#   --check FILE.hls    the one-shot diagnostics print (the editorless
#                       world's lsp-check)
#   --smoke             the protocol-resilience self-conversation (the
#                       twin of the retired lsp_smoke.py)
#   (no args)           the server, JSON-RPC over stdio
#
# The token index is the coordinate system: hint positions, rename
# edits and refactor plans are computed on a byte-offset token stream
# (ls_lex) whose boundaries are the lexer's own laws, and positions on
# the wire are UTF-16 code units, converted per line.
#
# Usage:
#   hls-lsp                      # the stdio server
#   hls-lsp --check FILE.hls     # one-shot diagnostics, exit 1 on error
#
# Exit codes: server — 0 after shutdown+exit (1 on exit without
# shutdown), 0 on stdin EOF; --check — 0 clean, 1 not clean, 2 usage.
# ============================================================================

import "./hlfront.hls"
import "std.str"
import "std.json"
import "std.result"

# ----------------------------------------------------------------------------
# Constants — the .py era's tables, verbatim.
# ----------------------------------------------------------------------------

fn ls_version() -> str {
    return "0.134.0-alpha"
}

fn ls_keywords() -> list[str] {
    return ["fn", "let", "mut", "return", "if", "else", "while", "for",
    "in", "break", "continue", "struct", "impl", "import", "uses",
    "true", "false", "enum", "match", "pure", "extern"]
}

fn ls_builtins() -> list[str] {
    return ["println", "print", "len", "str", "int", "panic", "clock_ms",
    "args", "exit", "chr", "range", "map_new", "drop", "clone", "take",
    "file_exists", "read_file", "write_file", "tainted_args",
    "taint_mark", "taint_unwrap", "read_file_tainted", "net_lookup",
    "rand_int", "rand_float", "rand_seed", "proc_exec", "read_line",
    "result_unwrap", "result_is_ok", "result_is_err", "option_unwrap",
    "option_is_some", "option_is_none", "map_get", "map_get_or",
    "map_set", "map_keys", "map_values", "map_contains", "map_size",
    "list_push", "list_pop", "list_get", "list_set", "list_size",
    "list_contains", "list_index_of", "str_to_float", "str_to_int",
    "str_slice", "str_concat", "str_contains", "str_starts_with",
    "str_ends_with", "str_split", "str_find", "str_replace", "str_upper",
    "str_lower", "str_trim", "str_bytes", "str_repeat", "int_to_str",
    "int_to_float", "float_to_int", "float_to_str", "bool_to_str"]
}

fn ls_effects() -> list[str] {
    return ["IO", "Fs", "Clock", "Args", "Exit", "Net", "Rand", "Proc"]
}

# ls_builtin_params — the curated SPEC-§8 spellings (param name lists,
# receiver excluded for methods). A name the spec does not pin, or a
# name carried by more than one receiver family, is absent: a call to
# it gets no hints, never a wrong one.
fn ls_builtin_params(name: str) -> list[str] {
    if name == "print" { return ["s"] }
    if name == "println" { return ["s"] }
    if name == "panic" { return ["msg"] }
    if name == "exit" { return ["code"] }
    if name == "str" { return ["value"] }
    if name == "int" { return ["s"] }
    if name == "len" { return ["value"] }
    if name == "range" { return ["a", "b"] }
    if name == "read_file" { return ["path"] }
    if name == "read_file_tainted" { return ["path"] }
    if name == "write_file" { return ["path", "content"] }
    if name == "file_exists" { return ["path"] }
    if name == "chr" { return ["i"] }
    if name == "rand_int" { return ["max"] }
    if name == "rand_seed" { return ["s"] }
    if name == "proc_exec" { return ["cmd"] }
    if name == "net_lookup" { return ["host"] }
    if name == "join" { return ["parts", "sep"] }
    if name == "has_feature" { return ["name"] }
    if name == "simd_cpu_supports" { return ["name"] }
    if name == "taint_mark" { return ["value"] }
    if name == "taint_unwrap" { return ["value"] }
    if name == "drop" { return ["value"] }
    if name == "clone" { return ["value"] }
    if name == "take" { return ["value"] }
    return []
}

# ls_builtin_method_params — method parameter names, receiver excluded.
# "" means deliberately ambiguous (list.set vs map.set): no hints.
fn ls_builtin_method_params(name: str) -> list[str] {
    if name == "byte_at" { return ["i"] }
    if name == "slice" { return ["a", "b"] }
    if name == "find" { return ["sub"] }
    if name == "contains" { return ["sub"] }
    if name == "starts_with" { return ["p"] }
    if name == "ends_with" { return ["p"] }
    if name == "split" { return ["sep"] }
    if name == "push" { return ["value"] }
    if name == "get" { return ["index"] }
    if name == "get_or" { return ["key", "default"] }
    if name == "has" { return ["key"] }
    if name == "send" { return ["value"] }
    if name == "try_send" { return ["value"] }
    if name == "recv_or" { return ["default"] }
    return []
}

# The external (on-disk, unopened) document LRU cap and the dependency
# walk cap — the .py era's exact budget discipline.
fn ls_external_doc_cap() -> int {
    return 48
}

fn ls_dep_file_cap() -> int {
    return 128
}

# ----------------------------------------------------------------------------
# Small text helpers (self-contained; the front-end's own helpers are
# reused only where their laws are the point — is_keyword etc.).
# ----------------------------------------------------------------------------

# ls_in — membership in a string list.
fn ls_in(s: str, hay: list[str]) -> bool {
    let mut i: int = 0
    while i < hay.len() {
        if hay.get(i) == s {
            return true
        }
        i = i + 1
    }
    return false
}

# ls_starts / ls_ends — the byte truth of prefix/suffix.
fn ls_starts(s: str, p: str) -> bool {
    if p.len() > s.len() {
        return false
    }
    return s.slice(0, p.len()) == p
}

fn ls_ends(s: str, p: str) -> bool {
    if p.len() > s.len() {
        return false
    }
    return s.slice(s.len() - p.len(), s.len()) == p
}

# ls_split1 — s around the first occurrence of sep ("" when absent:
# before = s, after = "").
fn ls_split1(s: str, sep: str) -> list[str] {
    let i: int = s.find(sep)
    if i < 0 {
        return [s, ""]
    }
    return [s.slice(0, i), s.slice(i + sep.len(), s.len())]
}

# ls_after_last_sep — everything after the last sep (the short method
# name of "Struct.method"; the whole string when bare).
fn ls_after_last_sep(s: str, sep: str) -> str {
    let mut i: int = s.len() - 1
    while i >= 0 {
        if s.slice(i, i + sep.len()) == sep {
            return s.slice(i + sep.len(), s.len())
        }
        i = i - 1
    }
    return s
}

# ls_uri_to_path — "file:///abs/path" -> "/abs/path" (the gates' URIs
# are always this shape; anything else stays as-is, the .py's law).
fn ls_uri_to_path(uri: str) -> str {
    if ls_starts(uri, "file://") {
        return uri.slice("file://".len(), uri.len())
    }
    return uri
}

fn ls_path_to_uri(path: str) -> str {
    return "file://" + path
}

# ----------------------------------------------------------------------------
# The offset lexer — the byte-span token stream every position-aware
# feature rides. Same token boundaries lexer.hls draws (the compiler's
# own is_keyword / is_ident_start / is_ident_char), numbers / strings /
# comments skipped by the same laws; every span round-trips against
# the bytes.
# ----------------------------------------------------------------------------

struct LTok {
    kind: str, # kw | ident | sym | int | float | str
    value: str,
    off: int, # byte offset of the first byte
    len: int, # byte length
    line: int # 1-based line of the first byte
}

# ls_lex(src) — the token stream with byte spans. Never fails: a
# malformed file lexes to fewer tokens, the callers degrade.
fn ls_lex(src: str) -> list[LTok] {
    let toks: list[LTok] = []
    let n: int = src.len()
    let mut i: int = 0
    let mut line: int = 1
    while i < n {
        let c: int = src.byte_at(i)
        if c == 32 || c == 9 {
            i = i + 1
        } else if c == 13 {
            if i + 1 < n && src.byte_at(i + 1) == 10 {
                i = i + 1
            } else {
                line = line + 1
                i = i + 1
            }
        } else if c == 10 {
            line = line + 1
            i = i + 1
        } else if c == 35 {
            # `#[` attribute sigil, `#![`, or a comment.
            if i + 1 < n && src.byte_at(i + 1) == 91 {
                toks.push(LTok {
                    kind: "sym", value: "#", off: i, len: 1, line: line
                })
                i = i + 1
            } else if i + 2 < n && src.byte_at(i + 1) == 33
            && src.byte_at(i + 2) == 91 {
                toks.push(LTok {
                    kind: "sym", value: "#", off: i, len: 1, line: line
                })
                toks.push(LTok {
                    kind: "sym", value: "!", off: i + 1, len: 1,
                    line: line
                })
                i = i + 2
            } else {
                while i < n && src.byte_at(i) != 10
                && src.byte_at(i) != 13 {
                    i = i + 1
                }
            }
        } else if is_ident_start(c) {
            let mut j: int = i
            while j < n && is_ident_char(src.byte_at(j)) {
                j = j + 1
            }
            let word: str = src.slice(i, j)
            if is_keyword(word) {
                toks.push(LTok {
                    kind: "kw", value: word, off: i, len: j - i,
                    line: line
                })
            } else {
                toks.push(LTok {
                    kind: "ident", value: word, off: i, len: j - i,
                    line: line
                })
            }
            i = j
        } else if c >= 48 && c <= 57 {
            # A number: digits, then an optional fraction (a second dot
            # never joins — the lexer's own law).
            let mut j: int = i
            let mut is_float: bool = false
            while j < n {
                let d: int = src.byte_at(j)
                if d >= 48 && d <= 57 {
                    j = j + 1
                } else if d == 46 && !is_float && j + 1 < n
                && src.byte_at(j + 1) >= 48
                && src.byte_at(j + 1) <= 57 {
                    is_float = true
                    j = j + 1
                } else {
                    # stop AT the first non-digit byte — j must stay
                    # the token's END, not jump to EOF (the slice
                    # below would swallow the whole rest of the file).
                    break
                }
            }
            if is_float {
                toks.push(LTok {
                    kind: "float", value: src.slice(i, j), off: i,
                    len: j - i, line: line
                })
            } else {
                toks.push(LTok {
                    kind: "int", value: src.slice(i, j), off: i,
                    len: j - i, line: line
                })
            }
            i = j
        } else if c == 34 {
            # A string literal: the bytes between the quotes, escapes
            # skipped (a backslash hides the next byte, quotes included).
            let mut j: int = i + 1
            let mut closed: bool = false
            while j < n {
                let b: int = src.byte_at(j)
                if b == 92 {
                    j = j + 2
                } else if b == 34 {
                    # The closing quote — j now sits PAST it, and the
                    # break keeps it there: the token's true end. The
                    # old exit set j to EOF, so every closed string's
                    # VALUE ran to the end of the file and swallowed
                    # every token after it — harmless while strings sat
                    # behind their call sites (hints position off the
                    # open quote), fatal the day a string preceded one
                    # (the emoji fixture lost every site under it).
                    j = j + 1
                    closed = true
                    break
                } else if b == 10 || b == 13 {
                    # An unterminated string ends at its newline — the
                    # token is just that line's garbage, not the rest
                    # of the file.
                    break
                } else {
                    j = j + 1
                }
            }
            toks.push(LTok {
                kind: "str", value: src.slice(i, j), off: i,
                len: j - i, line: line
            })
            i = j
        } else {
            # A symbol: the two-byte forms first, then one byte.
            let mut took_two: bool = false
            if i + 1 < n {
                let two: str = src.slice(i, i + 2)
                if two == "==" || two == "!=" || two == "<="
                || two == ">=" || two == "&&" || two == "||"
                || two == "->" || two == "=>" || two == "+="
                || two == "-=" || two == ".." {
                    toks.push(LTok {
                        kind: "sym", value: two, off: i, len: 2,
                        line: line
                    })
                    i = i + 2
                    took_two = true
                }
            }
            if !took_two {
                toks.push(LTok {
                    kind: "sym", value: src.slice(i, i + 1), off: i,
                    len: 1, line: line
                })
                i = i + 1
            }
        }
    }
    return toks
}

# ls_tok_at — the token covering byte offset off (line 1-based, col
# 1-based byte), or -1. The .py's _token_at law: the caller converts
# the wire position to a byte offset first.
fn ls_tok_at(toks: list[LTok], off: int) -> int {
    let mut i: int = 0
    while i < toks.len() {
        let t: LTok = toks.get(i)
        if off >= t.off && off < t.off + t.len {
            return i
        }
        i = i + 1
    }
    return -1
}

# ----------------------------------------------------------------------------
# Line/column arithmetic — byte offsets <-> (line, byte col), and the
# UTF-16 conversions the wire demands (a 4-byte UTF-8 sequence is a
# surrogate pair: 2 units, never 4 bytes, never 1).
# ----------------------------------------------------------------------------

# ls_line_offsets(src) — the byte offset of every line start.
fn ls_line_offsets(src: str) -> list[int] {
    let offs: list[int] = [0]
    let mut i: int = 0
    while i < src.len() {
        let c: int = src.byte_at(i)
        if c == 10 {
            offs.push(i + 1)
        }
        i = i + 1
    }
    return offs
}

# ls_off_to_linecol(offs, off) — [line0, bytecol0] of a byte offset.
fn ls_off_to_linecol(offs: list[int], off: int) -> list[int] {
    let mut lo: int = 0
    let mut hi: int = offs.len() - 1
    while lo < hi {
        let mid: int = (lo + hi + 1) / 2
        if offs.get(mid) <= off {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    return [lo, off - offs.get(lo)]
}

# ls_linecol_to_off(offs, line0, col0) — the byte offset; clamped.
fn ls_linecol_to_off(offs: list[int], line0: int, col0: int) -> int {
    let mut li: int = line0
    if li < 0 {
        li = 0
    }
    if li >= offs.len() {
        li = offs.len() - 1
    }
    let base: int = offs.get(li)
    let linelen: int = src_line_len(offs, li)
    let mut col: int = col0
    if col > linelen {
        col = linelen
    }
    if col < 0 {
        col = 0
    }
    return base + col
}

# src_line_len — the byte length of line0 (to the newline, exclusive).
fn src_line_len(offs: list[int], line0: int) -> int {
    if line0 + 1 < offs.len() {
        let end: int = offs.get(line0 + 1)
        let l: int = end - offs.get(line0) - 1
        if l < 0 {
            return 0
        }
        return l
    }
    return 1000000000
}

# ls_utf16_of_byte_col(src, line0, bytecol) — the UTF-16 character of
# a byte column on one line. Walks the line's bytes: 1-byte = 1 unit,
# 2/3-byte = 1 unit, 4-byte = 2 units.
fn ls_utf16_of_byte_col(src: str, offs: list[int], line0: int,
bytecol: int) -> int {
    if line0 < 0 || line0 >= offs.len() {
        return bytecol
    }
    let start: int = offs.get(line0)
    let mut endb: int = src.len()
    if line0 + 1 < offs.len() {
        endb = offs.get(line0 + 1) - 1
    }
    let mut u: int = 0
    let mut b: int = 0
    while b < bytecol && start + b < endb {
        let c: int = src.byte_at(start + b)
        if c < 128 {
            b = b + 1
            u = u + 1
        } else if c >= 248 {
            b = b + 1
        } else if c >= 240 {
            b = b + 4
            u = u + 2
        } else if c >= 224 {
            b = b + 3
            u = u + 1
        } else if c >= 192 {
            b = b + 2
            u = u + 1
        } else {
            b = b + 1
        }
    }
    return u
}

# ls_byte_of_utf16_col(src, line0, char16) — the inverse: the byte
# column a UTF-16 character lands on.
fn ls_byte_of_utf16_col(src: str, offs: list[int], line0: int,
char16: int) -> int {
    if line0 < 0 || line0 >= offs.len() {
        return char16
    }
    let start: int = offs.get(line0)
    let mut endb: int = src.len()
    if line0 + 1 < offs.len() {
        endb = offs.get(line0 + 1) - 1
    }
    let mut u: int = 0
    let mut b: int = 0
    while u < char16 && start + b < endb {
        let c: int = src.byte_at(start + b)
        if c < 128 {
            b = b + 1
            u = u + 1
        } else if c >= 248 {
            b = b + 1
        } else if c >= 240 {
            b = b + 4
            u = u + 2
        } else if c >= 224 {
            b = b + 3
            u = u + 1
        } else if c >= 192 {
            b = b + 2
            u = u + 1
        } else {
            b = b + 1
        }
    }
    return b
}

# ls_line_of(src, offs, off) — 0-based line of a byte offset.
fn ls_line_of(offs: list[int], off: int) -> int {
    let r: list[int] = ls_off_to_linecol(offs, off)
    return r.get(0)
}

# ----------------------------------------------------------------------------
# JSON-RPC over stdio — Content-Length framing, the wire the .py spoke.
# ----------------------------------------------------------------------------


# ls_lower_ascii — the ASCII lowercase of s (header names).
fn ls_lower_ascii(s: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c >= 65 && c <= 90 {
            out = out + chr(c + 32)
        } else {
            out = out + chr(c)
        }
        i = i + 1
    }
    return out
}

# ls_read_message(pend) — one frame from stdin: ["ok", body, rest]
# | ["eof", "", rest] | ["err", detail, rest]. The only stdin
# primitive is the whole line, so a pending buffer carries the bytes
# past a frame's end (a body is NOT newline-terminated — the next
# frame's header follows immediately, and read_line would glue them).
fn ls_read_message(pend_in: str) -> list[str] uses IO {
    let mut pend: str = pend_in
    let mut clen: int = -1
    let mut err: str = ""
    let mut saw_any: bool = false
    # header lines until the blank separator
    while true {
        let mut line: str = ""
        let mut got: bool = false
        if pend.contains("\n") {
            let nl: int = pend.find("\n")
            line = pend.slice(0, nl)
            if ls_ends(line, chr(13)) {
                line = line.slice(0, line.len() - 1)
            }
            pend = pend.slice(nl + 1, pend.len())
            got = true
        } else {
            let raw: str = taint_unwrap(read_line())
            if raw != "" {
                line = raw
                pend = pend + raw + "\n"
                # re-slice from pend so the bytes stay accounted
                let nl2: int = pend.find("\n")
                pend = pend.slice(nl2 + 1, pend.len())
                got = true
            } else {
                # "" is both a blank line and EOF at this primitive —
                # two in a row are EOF (read_line answers "" forever
                # past the end); one is the header separator.
                let raw2: str = taint_unwrap(read_line())
                if raw2 == "" {
                    return ["eof", "", pend]
                }
                pend = pend + raw2 + "\n"
                break
            }
        }
        if !got {
            return ["eof", "", pend]
        }
        if line == "" {
            if !saw_any {
                return ["eof", "", pend]
            }
            break
        }
        saw_any = true
        let parts: list[str] = ls_split1(line, ":")
        if ls_lower_ascii(parts.get(0)) == "content-length" {
            let v: str = parts.get(1).trim()
            if is_int_str(v) {
                let mut vnum: int = 0
                let mut k: int = 0
                while k < v.len() {
                    vnum = vnum * 10 + (v.byte_at(k) - 48)
                    k = k + 1
                }
                clen = vnum
            } else {
                err = "invalid Content-Length: " + v
            }
        }
        if clen < -1 || clen > 268435456 {
            return ["err", "unreasonable Content-Length: "
            + clen.to_str(), pend]
        }
    }
    if err != "" {
        return ["err", err, pend]
    }
    if clen < 0 {
        return ["err", "missing Content-Length", pend]
    }
    if clen == 0 {
        return ["err", "invalid JSON body: empty", pend]
    }
    # the body: exactly clen bytes out of the pending buffer, fed by
    # whole stdin lines (each stripped newline re-added).
    while pend.len() < clen {
        let raw2: str = taint_unwrap(read_line())
        if raw2 == "" && pend == "" {
            return ["err", "short read: wanted " + clen.to_str()
            + " bytes, got " + pend.len().to_str(), pend]
        }
        pend = pend + raw2 + "\n"
    }
    let body: str = pend.slice(0, clen)
    let rest: str = pend.slice(clen, pend.len())
    return ["ok", body, rest]
}

# is_int_str — every byte a digit.
fn is_int_str(s: str) -> bool {
    if s.len() == 0 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c < 48 || c > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

# ls_write_message — one frame to stdout, flushed per message.
fn ls_write_message(body: str) -> void uses IO {
    let crlf2: str = chr(13) + "\n"
    print("Content-Length: " + body.len().to_str() + crlf2 + crlf2 + body)
}

# ----------------------------------------------------------------------------
# The probe runner — spawn a child, drain both pipes, wait. The .py's
# try/except HLError, in a world whose only failure mode is a panic.
# ----------------------------------------------------------------------------

struct RunRes {
    code: int, # -1: the spawn itself failed
    out: str,
    err: str,
    spawned: bool
}

# ls_run_child(argv) — spawn with stdout+stderr piped, stdin null.
fn ls_run_child(argv: list[str]) -> RunRes uses Proc {
    let r: RunRes = RunRes {
        code: -1, out: "", err: "", spawned: false
    }
    let pid: int = proc_spawn(argv.get(0), argv, 2, 1, 1)
    if pid < 1 {
        return r
    }
    r.spawned = true
    let mut out: str = ""
    let mut chunk: str = proc_child_read(pid, 1, 65536)
    while chunk != "" {
        out = out + chunk
        chunk = proc_child_read(pid, 1, 65536)
    }
    let mut err: str = ""
    let mut chunk2: str = proc_child_read(pid, 2, 65536)
    while chunk2 != "" {
        err = err + chunk2
        chunk2 = proc_child_read(pid, 2, 65536)
    }
    r.code = proc_wait(pid)
    proc_child_close(pid, 1)
    proc_child_close(pid, 2)
    r.out = out
    r.err = err
    return r
}

# ls_self — the running binary's own path (for probe children).
fn ls_self() -> str uses Args {
    let a: list[str] = args()
    if a.len() == 0 {
        return "./bin/hls-lsp"
    }
    return a.get(0)
}

# ----------------------------------------------------------------------------
# The symbol table — one file's declarations, the machine-readable
# form the probe prints and every name-aware feature consumes.
# ----------------------------------------------------------------------------

struct SymFn {
    key: str, # "name" or "Struct.method"
    line: int, # 1-based declaration line
    params: list[str],
    ptypes: list[str],
    ret: str,
    is_method: bool
}

struct SymStruct {
    name: str,
    line: int,
    fields: list[str],
    ftypes: list[str]
}

struct SymEnum {
    name: str,
    line: int,
    variants: list[str],
    payloads: list[list[str]]
}

struct Syms {
    fns: list[SymFn],
    structs: list[SymStruct],
    enums: list[SymEnum],
    imports: list[str]
}

fn ls_syms_empty() -> Syms {
    return Syms {
        fns: [], structs: [], enums: [], imports: []
    }
}

# ls_sym_fn(syms, key) — the fn entry, or -1.
fn ls_sym_fn(syms: Syms, key: str) -> int {
    let mut i: int = 0
    while i < syms.fns.len() {
        if syms.fns.get(i).key == key {
            return i
        }
        i = i + 1
    }
    return -1
}

# ls_sym_struct — the struct index by name, or -1.
fn ls_sym_struct(syms: Syms, name: str) -> int {
    let mut i: int = 0
    while i < syms.structs.len() {
        if syms.structs.get(i).name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

# ls_sym_enum — the enum index by name, or -1.
fn ls_sym_enum(syms: Syms, name: str) -> int {
    let mut i: int = 0
    while i < syms.enums.len() {
        if syms.enums.get(i).name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

# ----------------------------------------------------------------------------
# The Stage 114 walk — the probe's source-order inventory of call sites
# and match arms for the inlay-hint engine. The .py's _walk_program /
# _walk_stmt / _walk_expr, ported onto the real AST: children walk in
# field order around each yield, top-level items are line-sorted (fns
# by their keyword line, struct field defaults are expressions too) so
# the server's per-family token cursors stay monotonic. Every call and
# fieldcall yields one CALL line; every match yields its arms as ARM
# lines at the match itself (the .py emitted every arm's binding hints
# at the match node, before the scrutinee and arm bodies recursed).
# ----------------------------------------------------------------------------

# pw_expr(ctx, ei, out) — one expression subtree.
fn pw_expr(ctx: Ctx, ei: int, out: list[str]) -> void {
    if ei < 0 || ei >= ctx.exprs.len() {
        return
    }
    let e: ExprN = ctx.exprs.get(ei)
    if e.kind == "call" {
        out.push("CALL " + e.line.to_str() + " 0 " + e.name)
        let mut i: int = 0
        while i < e.args.len() {
            pw_expr(ctx, e.args.get(i), out)
            i = i + 1
        }
        return
    }
    if e.kind == "fieldcall" {
        # the receiver's tokens precede the `.name(`: target first,
        # then the yield, then the arguments.
        pw_expr(ctx, e.left, out)
        out.push("CALL " + e.line.to_str() + " 1 " + e.name)
        let mut j: int = 0
        while j < e.args.len() {
            pw_expr(ctx, e.args.get(j), out)
            j = j + 1
        }
        return
    }
    if e.kind == "match" {
        # the arms yield with the match; then the scrutinee; then the
        # arm bodies (a body's call sites sit after the arm patterns).
        let mut a: int = 0
        while a < e.args.len() {
            let arm: MatchArm = ctx.match_arms.get(e.args.get(a))
            out.push("ARM " + e.args.get(a).to_str() + " "
            + arm.line.to_str() + " " + arm.enum_name + " "
            + arm.variant + " " + ls_bool_int(arm.has_paren).to_str()
            + " " + str_join(arm.bindings, "|"))
            a = a + 1
        }
        pw_expr(ctx, e.left, out)
        a = 0
        while a < e.args.len() {
            let arm2: MatchArm = ctx.match_arms.get(e.args.get(a))
            pw_expr(ctx, arm2.body, out)
            a = a + 1
        }
        return
    }
    if e.kind == "field" || e.kind == "qmark" || e.kind == "un" {
        pw_expr(ctx, e.left, out)
        return
    }
    if e.kind == "index" || e.kind == "bin" {
        pw_expr(ctx, e.left, out)
        pw_expr(ctx, e.right, out)
        return
    }
    if e.kind == "listlit" || e.kind == "structlit" {
        let mut k: int = 0
        while k < e.args.len() {
            pw_expr(ctx, e.args.get(k), out)
            k = k + 1
        }
        return
    }
    # ident / int / float / bool / str: leaves.
}

# pw_stmt(ctx, si, out) — one statement subtree.
fn pw_stmt(ctx: Ctx, si: int, out: list[str]) -> void {
    if si < 0 || si >= ctx.stmts.len() {
        return
    }
    let s: StmtN = ctx.stmts.get(si)
    if s.kind == "let" || s.kind == "return" {
        pw_expr(ctx, s.value, out)
    } else if s.kind == "assign" {
        pw_expr(ctx, s.target, out)
        pw_expr(ctx, s.value, out)
    } else if s.kind == "expr" {
        pw_expr(ctx, s.e, out)
    } else if s.kind == "if" {
        pw_expr(ctx, s.cond, out)
        let mut i: int = 0
        while i < s.body.len() {
            pw_stmt(ctx, s.body.get(i), out)
            i = i + 1
        }
        i = 0
        while i < s.else_body.len() {
            pw_stmt(ctx, s.else_body.get(i), out)
            i = i + 1
        }
    } else if s.kind == "while" {
        pw_expr(ctx, s.cond, out)
        let mut j: int = 0
        while j < s.body.len() {
            pw_stmt(ctx, s.body.get(j), out)
            j = j + 1
        }
    } else if s.kind == "for" {
        pw_expr(ctx, s.iter, out)
        let mut k: int = 0
        while k < s.body.len() {
            pw_stmt(ctx, s.body.get(k), out)
            k = k + 1
        }
    } else if s.kind == "asm" {
        # operands are (constraint, expr) pairs; the constraint side is
        # a plain string and walks as a no-op.
        let mut m: int = 0
        while m < s.asm_operands.len() {
            pw_expr(ctx, s.asm_operands.get(m).expr_idx, out)
            m = m + 1
        }
    }
    # break / continue: no expressions.
}

# WalkItem — one line-sorted top-level payload.
struct WalkItem {
    line: int,
    kind: int, # 0: fn body, 1: struct field defaults
    name: str
}

# pw_program(ctx, out) — the whole file, items line-sorted (the .py's
# items.sort(key=line); the insertion sort is stable, and only pointer
# slots move — no field writes, no aliasing hazard).
fn pw_program(ctx: Ctx, out: list[str]) -> void {
    let items: list[WalkItem] = []
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let key: str = ctx.fn_order.get(i)
        let fi: FnInfo = ctx.fns.get_or(key, dummy_fn())
        items.push(WalkItem { line: fi.line, kind: 0, name: key })
        i = i + 1
    }
    let skeys: list[str] = ctx.structs.keys()
    let mut si: int = 0
    while si < skeys.len() {
        let st: StructInfo = ctx.structs.get_or(skeys.get(si),
        dummy_struct())
        let mut has_dflt: bool = false
        let mut di2: int = 0
        while di2 < st.fdefaults.len() {
            if st.fdefaults.get(di2) >= 0 {
                has_dflt = true
            }
            di2 = di2 + 1
        }
        if has_dflt {
            items.push(WalkItem { line: st.line, kind: 1, name: st.name })
        }
        si = si + 1
    }
    let mut a: int = 1
    while a < items.len() {
        let it: WalkItem = items.get(a)
        let mut b: int = a - 1
        while b >= 0 && items.get(b).line > it.line {
            items.set(b + 1, items.get(b))
            b = b - 1
        }
        items.set(b + 1, it)
        a = a + 1
    }
    let mut w: int = 0
    while w < items.len() {
        let it2: WalkItem = items.get(w)
        if it2.kind == 0 {
            let fi2: FnInfo = ctx.fns.get_or(it2.name, dummy_fn())
            let mut bi: int = 0
            while bi < fi2.body.len() {
                pw_stmt(ctx, fi2.body.get(bi), out)
                bi = bi + 1
            }
        } else {
            let st2: StructInfo = ctx.structs.get_or(it2.name,
            dummy_struct())
            let mut di3: int = 0
            while di3 < st2.fdefaults.len() {
                pw_expr(ctx, st2.fdefaults.get(di3), out)
                di3 = di3 + 1
            }
        }
        w = w + 1
    }
}

# ----------------------------------------------------------------------------
# The probe child — one file, parse + symbol table + check verdict.
#
#   --probe-file PATH
#
# stdout (machine lines, printed BEFORE the check so a check panic
# cannot eat them):
#   FN <key> <line> <params |> <ptypes |> <ret> <is_method>
#   STRUCT <name> <line> <fields |> <ftypes |>
#   ENUM <name> <line> <variants ,> <payloads ;>
#   IMP <import>
#   CALL <line> <is_method 0/1> <name>      (the Stage 114 walk)
#   ARM <seq> <line> <enum> <variant> <has_paren> <bindings |>
# A CLEAN check then adds (a check panic skips them — the server falls
# back to the raw enum payloads for those arms):
#   ARMB <seq> <name:type>|<name:type>|...  (the checker's
#        instantiated binding types, "|" so payload types keep their
#        spaces)
# and finally CHECK OK.
# A parse panic dies before any line (exit 101, the syntax error on
# stderr); a check panic dies after the pre-check block (exit 101, the
# type error on stderr). The parent reads the same outcome the .py's
# try/except HLError produced.
# ----------------------------------------------------------------------------

# ls_rf_one_stmt — parse ONE statement from ctx.pos, the consumed
# token count (0 = refused: eof or a top-level declaration keyword —
# the walker stops). Runs inside the --rf-slice child; a parse panic
# kills the child and the parent reads the refusal.
fn ls_rf_one_stmt(ctx: Ctx, pos: int) -> int uses Args {
    if pos >= ctx.toks.len() - 1 {
        return 0
    }
    let t: Tok = ctx.toks.get(pos)
    if t.kind == "kw" && (t.value == "fn" || t.value == "struct"
    || t.value == "enum" || t.value == "impl" || t.value == "import"
    || t.value == "extern") {
        return 0
    }
    ctx.pos = pos
    let _s: int = parse_stmt(ctx)
    let consumed: int = ctx.pos - pos
    if consumed <= 0 {
        return 0
    }
    return consumed
}

# ls_probe_file(path) — the child side. Panics propagate (that IS the
# verdict); the parent catches the exit code + stderr.
fn ls_probe_file(path: str) -> int uses IO, Args, Fs {    let ctx: Ctx = hl_parse_file(path)
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let key: str = ctx.fn_order.get(i)
        let fi: FnInfo = ctx.fns.get_or(key, dummy_fn())
        println("FN " + key + " " + fi.line.to_str() + " "
        + str_join(fi.params, "|") + " " + str_join(fi.ptypes, "|")
        + " " + fi.ret + " " + ls_bool_int(fi.is_method).to_str())
        i = i + 1
    }
    let skeys: list[str] = ctx.structs.keys()
    let mut si: int = 0
    while si < skeys.len() {
        let st: StructInfo = ctx.structs.get_or(skeys.get(si),
        dummy_struct())
        println("STRUCT " + st.name + " " + st.line.to_str() + " "
        + str_join(st.fields, "|") + " " + str_join(st.ftypes, "|"))
        si = si + 1
    }
    let ekeys: list[str] = ctx.enums.keys()
    let mut ei: int = 0
    while ei < ekeys.len() {
        let en: EnumInfo = ctx.enums.get_or(ekeys.get(ei),
        dummy_enum())
        let mut payloads: str = ""
        let mut vi: int = 0
        while vi < en.payloads.len() {
            if vi > 0 {
                payloads = payloads + ";"
            }
            payloads = payloads + str_join(en.payloads.get(vi), ",")
            vi = vi + 1
        }
        println("ENUM " + en.name + " " + en.line.to_str() + " "
        + str_join(en.variants, ",") + " " + payloads)
        ei = ei + 1
    }
    let mut ii: int = 0
    while ii < ctx.imports.len() {
        println("IMP " + ctx.imports.get(ii))
        ii = ii + 1
    }
    # the Stage 114 walk — pre-check, so a type-error document still
    # carries its call sites and arm shapes (the guards' fallback).
    let walk: list[str] = []
    pw_program(ctx, walk)
    let mut wi: int = 0
    while wi < walk.len() {
        println(walk.get(wi))
        wi = wi + 1
    }
    hl_check(ctx)
    # ARMB — the checker's instantiated binding types, only reached on
    # a clean check (a panic skips these lines and the server falls
    # back to the raw enum payloads).
    let mut ai: int = 0
    while ai < ctx.match_arms.len() {
        let arm: MatchArm = ctx.match_arms.get(ai)
        if arm.bind_ts.len() > 0 {
            let mut s: str = "ARMB " + ai.to_str() + " "
            let mut bi: int = 0
            while bi < arm.bindings.len() {
                if bi > 0 {
                    s = s + "|"
                }
                s = s + arm.bindings.get(bi) + ":"
                + arm.bind_ts.get(bi)
                bi = bi + 1
            }
            println(s)
        }
        ai = ai + 1
    }
    println("CHECK OK")
    return 0
}

# ls_bool_int — 1/0 (the machine lines carry ints only).
fn ls_bool_int(b: bool) -> int {
    if b {
        return 1
    }
    return 0
}

# ----------------------------------------------------------------------------
# The probe parent — run the child, classify the outcome.
# ----------------------------------------------------------------------------

struct ProbeOut {
    parse_err: bool, # true: the file does not parse
    check_err: bool, # true: parses, the checker rejects it
    err_line: int, # 1-based (0 when unknown)
    err_col: int, # 1-based (0 when unknown)
    err_msg: str, # the RAW message (no classifier, no position suffix)
    err_text: str, # the full panic text (classifier + suffix)
    syms: Syms,
    calls: list[WalkCall], # the Stage 114 walk (empty on parse error)
    arms: list[WalkArm]
}

# WalkCall — one call-site yield: the callee's line, whether the site
# is a `.name(` method call, and the callee's source name.
struct WalkCall {
    line: int,
    is_method: bool,
    name: str
}

# WalkArm — one match-arm yield. bind_ts carries the checker's
# instantiated binding types (name-index-aligned) when the check ran
# clean; a check-broken document leaves it empty and the engine falls
# back to the enum's raw variant payloads.
struct WalkArm {
    seq: int, # the probe's arm index (ARMB's key)
    line: int,
    enum_name: str,
    variant: str,
    has_paren: bool,
    bindings: list[str],
    bind_ts: list[str]
}

# ls_probe_parse_err(err) — classify a child's stderr: ["kind", line,
# col, raw_msg, full_text]. kind: "" (no panic), "parse", "check".
fn ls_probe_parse_err(err: str) -> list[str] {
    let lines: list[str] = err.split("\n")
    let mut t: str = ""
    let mut i: int = 0
    while i < lines.len() {
        let c: str = lines.get(i).trim()
        if c != "" {
            t = c
            i = lines.len()
        }
        i = i + 1
    }
    if !ls_starts(t, "panic: ") {
        return ["", "0", "0", "", ""]
    }
    let body: str = t.slice("panic: ".len(), t.len())
    let mut kind: str = ""
    let mut msg: str = body
    if ls_starts(body, "syntax error: ") {
        kind = "parse"
        msg = body.slice("syntax error: ".len(), body.len())
    } else if ls_starts(body, "lex error: ") {
        kind = "parse"
        msg = body.slice("lex error: ".len(), body.len())
    } else if ls_starts(body, "type error: ") {
        kind = "check"
        msg = body.slice("type error: ".len(), body.len())
    } else {
        return ["check", "0", "0", body, body]
    }
    # The position suffix: " (line L:C)" or " (line L)".
    let mut line: int = 0
    let mut col: int = 0
    let open: int = ls_rfind_sub(msg, " (line ")
    if open >= 0 {
        let tail: str = msg.slice(open, msg.len())
        let colon: int = tail.find(":")
        let close: int = ls_rfind_sub(tail, ")")
        if close == tail.len() - 1 {
            if colon >= 0 {
                let ltxt: str = tail.slice(7, colon)
                let ctxt: str = tail.slice(colon + 1, tail.len() - 1)
                if is_int_str(ltxt.trim()) && is_int_str(ctxt.trim()) {
                    line = ls_atoi(ltxt.trim())
                    col = ls_atoi(ctxt.trim())
                    msg = msg.slice(0, open)
                }
            } else {
                let ltxt2: str = tail.slice(7, tail.len() - 1)
                if is_int_str(ltxt2.trim()) {
                    line = ls_atoi(ltxt2.trim())
                    msg = msg.slice(0, open)
                }
            }
        }
    }
    return [kind, line.to_str(), col.to_str(), msg, body]
}


# ls_rfind_sub — the offset of the LAST occurrence of sub in s (-1).
fn ls_rfind_sub(s: str, sub: str) -> int {
    let mut found: int = -1
    let mut i: int = 0
    while i + sub.len() <= s.len() {
        if s.slice(i, i + sub.len()) == sub {
            found = i
        }
        i = i + 1
    }
    return found
}

# ls_atoi — the decimal value of a digit string (0 on anything else).
fn ls_atoi(s: str) -> int {
    # println-terminated machine lines ("RFEXPR 1\n") must trim before
    # the digit scan — is_int_str on "1\n" is false and every
    # sub-child count read back as 0 (the whole refactor engine
    # answered [] on it).
    let t: str = s.trim()
    if !is_int_str(t) {
        return 0
    }
    let mut v: int = 0
    let mut i: int = 0
    while i < t.len() {
        v = v * 10 + (t.byte_at(i) - 48)
        i = i + 1
    }
    return v
}

# ls_probe_run(path) — probe one file (on-disk or the shared temp).
fn ls_probe_run(path: str) -> ProbeOut uses Proc, Args {
    let r: RunRes = ls_run_child([ls_self(), "--probe-file", path])
    return ls_probe_result(r)
}

# ls_probe_result — classify a probe child's captured outcome.
fn ls_probe_result(r: RunRes) -> ProbeOut {
    let out: ProbeOut = ProbeOut {
        parse_err: false, check_err: false, err_line: 0, err_col: 0,
        err_msg: "", err_text: "", syms: ls_syms_empty(),
        calls: [], arms: []
    }
    let cls: list[str] = ls_probe_parse_err(r.err)
    let kind: str = cls.get(0)
    if kind == "parse" {
        out.parse_err = true
        out.err_line = ls_atoi(cls.get(1))
        out.err_col = ls_atoi(cls.get(2))
        out.err_msg = cls.get(3)
        # The .py's syntax-error diagnostic text: the full message
        # WITH its position suffix.
        if out.err_col > 0 {
            out.err_text = cls.get(3) + " (line " + cls.get(1) + ":"
            + cls.get(2) + ")"
        } else {
            out.err_text = cls.get(3) + " (line " + cls.get(1) + ")"
        }
        return out
    }
    # The symbol table and the Stage 114 walk ride stdout whatever the
    # check said.
    ls_parse_walk_lines(r.out, out)
    out.syms = ls_parse_sym_lines(r.out)
    if kind == "check" {
        out.check_err = true
        out.err_line = ls_atoi(cls.get(1))
        out.err_col = ls_atoi(cls.get(2))
        out.err_msg = cls.get(3)
        out.err_text = cls.get(4)
    }
    return out
}

# ls_parse_walk_lines — the CALL/ARM/ARMB lines of the probe's stdout
# into out.calls / out.arms (ARMB fills the arm's bind_ts by seq).
fn ls_parse_walk_lines(out_text: str, out: ProbeOut) -> void {
    let lines: list[str] = out_text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if ls_starts(line, "CALL ") {
            let parts: list[str] = line.split(" ")
            if parts.len() >= 4 {
                out.calls.push(WalkCall {
                    line: ls_atoi(parts.get(1)),
                    is_method: parts.get(2) == "1",
                    name: parts.get(3)
                })
            }
        } else if ls_starts(line, "ARM ") {
            let parts: list[str] = line.split(" ")
            if parts.len() >= 7 {
                out.arms.push(WalkArm {
                    seq: ls_atoi(parts.get(1)),
                    line: ls_atoi(parts.get(2)),
                    enum_name: parts.get(3),
                    variant: parts.get(4),
                    has_paren: parts.get(5) == "1",
                    bindings: ls_split_list(parts.get(6), "|"),
                    bind_ts: []
                })
            }
        } else if ls_starts(line, "ARMB ") {
            # "ARMB <seq> <name:type>|..." — the pairs ride the REST of
            # the line verbatim: payload types keep their spaces
            # ("map[str, int]"), so a split(" ") would shred them.
            let rest: str = line.slice("ARMB ".len(), line.len())
            let sp: int = rest.find(" ")
            if sp > 0 {
                let seq: int = ls_atoi(rest.slice(0, sp))
                let pairs: list[str] = ls_split_list(
                rest.slice(sp + 1, rest.len()), "|")
                let mut ai: int = 0
                while ai < out.arms.len() {
                    if out.arms.get(ai).seq == seq {
                        let mut pi: int = 0
                        while pi < pairs.len() {
                            let colon: int = pairs.get(pi).find(":")
                            if colon > 0 {
                                out.arms.get(ai).bind_ts.push(
                                pairs.get(pi).slice(colon + 1,
                                pairs.get(pi).len()))
                            } else {
                                out.arms.get(ai).bind_ts.push("")
                            }
                            pi = pi + 1
                        }
                        break
                    }
                    ai = ai + 1
                }
            }
        }
        i = i + 1
    }
}

# ls_parse_sym_lines — the probe's stdout into a Syms.
fn ls_parse_sym_lines(out: str) -> Syms {
    let syms: Syms = ls_syms_empty()
    let lines: list[str] = out.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if ls_starts(line, "FN ") {
            let parts: list[str] = line.split(" ")
            if parts.len() >= 7 {
                let params: list[str] = ls_split_list(parts.get(3), "|")
                let ptypes: list[str] = ls_split_list(parts.get(4), "|")
                syms.fns.push(SymFn {
                    key: parts.get(1),
                    line: ls_atoi(parts.get(2)), params: params,
                    ptypes: ptypes, ret: parts.get(5),
                    is_method: ls_atoi(parts.get(6)) == 1
                })
            }
        } else if ls_starts(line, "STRUCT ") {
            let parts: list[str] = line.split(" ")
            if parts.len() >= 6 {
                syms.structs.push(SymStruct {
                    name: parts.get(1), line: ls_atoi(parts.get(2)),
                    fields: ls_split_list(parts.get(3), "|"),
                    ftypes: ls_split_list(parts.get(4), "|")
                })
            }
        } else if ls_starts(line, "ENUM ") {
            let parts: list[str] = line.split(" ")
            if parts.len() >= 5 {
                let variants: list[str] = ls_split_list(parts.get(3), ",")
                let payloads: list[list[str]] = []
                let groups: list[str] = ls_split_list(parts.get(4), ";")
                let mut g: int = 0
                while g < groups.len() {
                    payloads.push(ls_split_list(groups.get(g), ","))
                    g = g + 1
                }
                syms.enums.push(SymEnum {
                    name: parts.get(1), line: ls_atoi(parts.get(2)),
                    variants: variants, payloads: payloads
                })
            }
        } else if ls_starts(line, "IMP ") {
            syms.imports.push(line.slice("IMP ".len(), line.len()))
        }
        i = i + 1
    }
    return syms
}

# ls_split_list — s around sep, "" -> [] (the empty-list law the
# machine lines need: a zero-param fn prints "|").
fn ls_split_list(s: str, sep: str) -> list[str] {
    if s == "" {
        return []
    }
    return s.split(sep)
}

# ----------------------------------------------------------------------------
# The document store — open buffers with their symbol tables.
# ----------------------------------------------------------------------------

struct DocRec {
    uri: str,
    path: str,
    version: int, # -1: unknown
    text: str,
    toks: list[LTok],
    offs: list[int],
    syms: Syms,
    parse_err: bool,
    err_line: int,
    err_col: int,
    err_msg: str, # raw (checker) or full-with-suffix (parse)
    dead: bool, # the program is unusable (the .py's program=None)
    calls: list[WalkCall], # the Stage 114 walk ([] on parse error)
    arms: list[WalkArm]
}

# ls_doc_new(uri, version, text) — store + probe one buffer. The
# single-file view never resolves imports, so the scratch path's
# directory is irrelevant to the verdict.
fn ls_doc_new(uri: str, version: int, text: str) -> DocRec uses Proc,
Fs, IO {
    let d: DocRec = DocRec {
        uri: uri, path: ls_uri_to_path(uri), version: version,
        text: text, toks: ls_lex(text), offs: ls_line_offsets(text),
        syms: ls_syms_empty(), parse_err: false, err_line: 0,
        err_col: 0, err_msg: "", dead: false, calls: [], arms: []
    }
    ls_scratch_write(text)
    let p: ProbeOut = ls_probe_run(ls_scratch_path())
    d.syms = p.syms
    d.calls = p.calls
    d.arms = p.arms
    if p.parse_err {
        d.parse_err = true
        d.dead = true
        d.err_line = p.err_line
        d.err_col = p.err_col
        d.err_msg = p.err_text
    } else if p.check_err {
        d.err_line = p.err_line
        d.err_col = p.err_col
        d.err_msg = p.err_msg
    }
    return d
}

# The scratch file every open-buffer probe runs through (one name,
# one server, one probe at a time — the server is single-threaded).
fn ls_scratch_path() -> str {
    return ".hls-lsp-probe.hls"
}

fn ls_scratch_write(text: str) -> void uses Fs {
    write_file(ls_scratch_path(), text)
}

# ----------------------------------------------------------------------------
# The server state — docs, the external LRU, the workspace cache.
# ----------------------------------------------------------------------------

struct ExtRec {
    path: str,
    syms: Syms,
    toks: list[LTok],
    offs: list[int],
    text: str,
    size: int, # the freshness stamp (fs_size at load)
    ok: bool # false: never cache failures
}

struct LsState {
    docs: list[DocRec],
    ext_paths: list[str], # LRU order: oldest first
    ext: list[ExtRec],
    ws_dirs: list[str], # package-root cache: dir keys
    ws_roots: list[str],
    shutdown: bool
}

fn ls_state_new() -> LsState {
    return LsState {
        docs: [], ext_paths: [], ext: [], ws_dirs: [], ws_roots: [],
        shutdown: false
    }
}

# ls_find_doc — the doc index by uri, or -1.
fn ls_find_doc(st: LsState, uri: str) -> int {
    let mut i: int = 0
    while i < st.docs.len() {
        if st.docs.get(i).uri == uri {
            return i
        }
        i = i + 1
    }
    return -1
}

# ls_store_doc — the didOpen/didChange store law: version
# monotonicity, then parse + check + symbol table.
fn ls_store_doc(st: LsState, uri: str, version: int, text: str)
-> void uses Proc, Fs, IO {
    let cur: int = ls_find_doc(st, uri)
    if cur >= 0 && version >= 0 {
        let d: DocRec = st.docs.get(cur)
        if d.version >= 0 && version <= d.version {
            return
        }
    }
    let fresh: DocRec = ls_doc_new(uri, version, text)
    if cur >= 0 {
        st.docs.set(cur, fresh)
    } else {
        st.docs.push(fresh)
    }
    ls_ext_remove(st, ls_uri_to_path(uri))
}

# ls_ext_remove — an open buffer supersedes its external copy.
fn ls_ext_remove(st: LsState, path: str) -> void {
    let mut i: int = 0
    while i < st.ext_paths.len() {
        if st.ext_paths.get(i) == path {
            let mut j: int = i
            while j + 1 < st.ext.len() {
                st.ext.set(j, st.ext.get(j + 1))
                j = j + 1
            }
            let _d: ExtRec = st.ext.pop()
            let _dp: str = st.ext_paths.pop()
            i = i - 1
        }
        i = i + 1
    }
}

# ls_ext_load — the external (on-disk, unopened) document: probe,
# cache, LRU-evict. Failures are never cached and answer nothing.
fn ls_ext_load(st: LsState, path: str) -> int uses Proc, Fs, Args {
    let mut i: int = 0
    while i < st.ext_paths.len() {
        if st.ext_paths.get(i) == path {
            return i
        }
        i = i + 1
    }
    if !file_exists(path) {
        return -1
    }
    let p: ProbeOut = ls_probe_run(path)
    if p.parse_err {
        return -1
    }
    let text: str = read_file(path)
    let rec: ExtRec = ExtRec {
        path: path, syms: p.syms, toks: ls_lex(text),
        offs: ls_line_offsets(text), text: text,
        size: fs_size(path), ok: true
    }
    st.ext.push(rec)
    st.ext_paths.push(path)
    # The cap: evict the OLDEST external (open docs are never here).
    while st.ext_paths.len() > ls_external_doc_cap() {
        let mut j: int = 0
        while j + 1 < st.ext.len() {
            st.ext.set(j, st.ext.get(j + 1))
            j = j + 1
        }
        let _d: ExtRec = st.ext.pop()
        let _dp: str = st.ext_paths.pop()
    }
    return st.ext.len() - 1
}

# ls_ext_fresh — the external index, re-read when the file changed
# on disk (size stamp), or -1.
fn ls_ext_fresh(st: LsState, path: str) -> int uses Proc, Fs, Args {
    let mut i: int = 0
    while i < st.ext_paths.len() {
        if st.ext_paths.get(i) == path {
            if file_exists(path) && fs_size(path)
            != st.ext.get(i).size {
                ls_ext_remove(st, path)
                i = st.ext.len()
            } else {
                return i
            }
        }
        i = i + 1
    }
    return ls_ext_load(st, path)
}

# ----------------------------------------------------------------------------
# Import resolution — the .py's layer law, verbatim: walk up from the
# importing file, then the package root, then the toolchain's own
# tree; relative imports against the importing file's dir, then the
# dependency dirs. Guards: empty / absolute / ".." module names.
# ----------------------------------------------------------------------------

# ls_toolchain_root — the repo root the server binary lives in.
fn ls_toolchain_root() -> str uses Args {
    let selfp: str = ls_self()
    if !selfp.contains("/") {
        return "."
    }
    let one: str = dir_of(selfp)
    let two: str = parent_dir(one)
    return two
}

# ls_resolve_import(imp, importer_dir, importer_path, st) — the
# resolved absolute path, or "".
fn ls_resolve_import(imp: str, importer_dir: str, importer_path: str,
st: LsState) -> str uses Proc, Fs, Args {
    if ls_starts(imp, "std.") || ls_starts(imp, "core.") {
        let mut subdir: str = "std"
        let mut cut: int = 4
        if ls_starts(imp, "core.") {
            subdir = "core"
            cut = 5
        }
        let module_name: str = imp.slice(cut, imp.len())
        if module_name.len() == 0 {
            return ""
        }
        if module_name.byte_at(0) == 47
        || module_name.byte_at(0) == 92 {
            return ""
        }
        if ls_has_dotdot(module_name) {
            return ""
        }
        let rel: str = subdir + "/" + module_name + ".hls"
        # (a) walk up from the importing file (depths 0..4).
        let mut d: str = importer_dir
        let mut tries: int = 0
        while tries < 5 {
            let cand: str = join_path(d, rel)
            if file_exists(cand) {
                return cand
            }
            let parent: str = parent_dir(d)
            if parent == d {
                tries = 5
            } else {
                d = parent
            }
            tries = tries + 1
        }
        # (b) the package root.
        let pkg_root: str = ls_package_root(st, importer_path)
        if pkg_root != "" {
            let pr_cand: str = join_path(pkg_root, rel)
            if file_exists(pr_cand) {
                return pr_cand
            }
        }
        # (c) the toolchain's own tree.
        let root_cand: str = join_path(ls_toolchain_root(), rel)
        if file_exists(root_cand) {
            return root_cand
        }
        # (d) the cwd anchor.
        let cwd: str = cwd_get()
        if cwd != "" {
            let cwd_cand: str = join_path(cwd, rel)
            if file_exists(cwd_cand) {
                return cwd_cand
            }
        }
        return ""
    }
    # relative import
    if imp.len() == 0 || imp.byte_at(0) == 47
    || imp.byte_at(0) == 92 {
        return ""
    }
    if ls_has_dotdot(imp) {
        return ""
    }
    let direct: str = join_path(importer_dir, imp)
    if file_exists(direct) {
        return direct
    }
    # dependency dirs: <dep>/<path> and <dep>/<basename>.
    let deps: list[str] = ls_dep_dirs(st, importer_path)
    let mut i: int = 0
    while i < deps.len() {
        let d1: str = join_path(deps.get(i), imp)
        if file_exists(d1) {
            return d1
        }
        let base: str = ls_basename_of(imp)
        let d2: str = join_path(deps.get(i), base)
        if file_exists(d2) {
            return d2
        }
        i = i + 1
    }
    return ""
}

fn ls_has_dotdot(p: str) -> bool {
    let parts: list[str] = p.split("/")
    let mut i: int = 0
    while i < parts.len() {
        if parts.get(i) == ".." {
            return true
        }
        i = i + 1
    }
    return false
}

fn ls_basename_of(p: str) -> str {
    let mut i: int = p.len() - 1
    while i >= 0 {
        if p.byte_at(i) == 47 {
            return p.slice(i + 1, p.len())
        }
        i = i - 1
    }
    return p
}

# ----------------------------------------------------------------------------
# The package machinery — hls-pkg.toml roots, hls-pkg.lock deps, the
# .hls-pkg-deps farm, the HLS_PKG_DEPS override.
# ----------------------------------------------------------------------------

# ls_package_root(st, path) — the nearest ancestor holding
# hls-pkg.toml ("" when none, ≤32 levels up, cached per dir).
fn ls_package_root(st: LsState, path: str) -> str uses Proc, Fs {
    let dir: str = dir_of(path)
    let mut ci: int = 0
    while ci < st.ws_dirs.len() {
        if st.ws_dirs.get(ci) == dir {
            return st.ws_roots.get(ci)
        }
        ci = ci + 1
    }
    let mut d: str = dir
    let mut root: str = ""
    let mut levels: int = 0
    while levels < 32 {
        if file_exists(join_path(d, "hls-pkg.toml")) {
            root = d
            levels = 32
        } else {
            let parent: str = parent_dir(d)
            if parent == d {
                levels = 32
            } else {
                d = parent
                levels = levels + 1
            }
        }
    }
    st.ws_dirs.push(dir)
    st.ws_roots.push(root)
    return root
}

# ls_dep_dirs(st, doc_path) — the dependency source dirs, in the
# .py's order: lockfile resolved_paths, then the .hls-pkg-deps farm
# along the ancestor chain, then HLS_PKG_DEPS. Deduped, stable.
fn ls_dep_dirs(st: LsState, doc_path: str) -> list[str] uses Proc, Fs {
    let out: list[str] = []
    # 1. the lockfile.
    let pkg_root: str = ls_package_root(st, doc_path)
    if pkg_root != "" {
        let lock: str = join_path(pkg_root, "hls-pkg.lock")
        if file_exists(lock) {
            let raw: str = read_file(lock)
            let rr: Result[JsonValue, str] = json_parse_result(raw)
            if result_is_ok(rr) {
                let doc: JsonValue = result_unwrap(rr)
                let pkgs: JsonValue = json_object_get(doc, "packages")
                if json_is_array(pkgs) {
                    let mut i: int = 0
                    while i < pkgs.arr.len() {
                        let p: JsonValue = pkgs.arr.get(i)
                        let rp: JsonValue = json_object_get(p,
                        "resolved_path")
                        if json_is_str(rp) {
                            let rpath: str = json_str_value(rp)
                            let mut abs: str = rpath
                            if !ls_starts(rpath, "/") {
                                abs = join_path(pkg_root, rpath)
                            }
                            if file_exists(abs) {
                                let mut dirp: str = abs
                                if !fs_is_dir(abs) {
                                    dirp = dir_of(abs)
                                }
                                if !ls_in(dirp, out) {
                                    out.push(dirp)
                                }
                            }
                        }
                        i = i + 1
                    }
                }
            }
        }
    }
    # 2. the .hls-pkg-deps farm along the ancestor chain (+ root).
    let mut d: str = dir_of(doc_path)
    let mut tries: int = 0
    while tries < 6 {
        let farm: str = join_path(d, ".hls-pkg-deps")
        if fs_is_dir(farm) && !ls_in(farm, out) {
            out.push(farm)
        }
        let parent: str = parent_dir(d)
        if parent == d {
            tries = 6
        } else {
            d = parent
        }
        tries = tries + 1
    }
    if pkg_root != "" {
        let root_farm: str = join_path(pkg_root, ".hls-pkg-deps")
        if fs_is_dir(root_farm) && !ls_in(root_farm, out) {
            out.push(root_farm)
        }
    }
    # 3. HLS_PKG_DEPS.
    if env_has("HLS_PKG_DEPS") {
        let ev: str = env_get("HLS_PKG_DEPS")
        if ev != "" && fs_is_dir(ev) && !ls_in(ev, out) {
            out.push(ev)
        }
    }
    return out
}

# ls_dep_files(st, doc_path) — the dependency walk: 6 levels deep,
# dot-dirs and __pycache__ skipped, sorted, capped at 128.
fn ls_dep_files(st: LsState, doc_path: str) -> list[str] uses Proc, Fs {
    let dirs: list[str] = ls_dep_dirs(st, doc_path)
    let out: list[str] = []
    let mut di: int = 0
    while di < dirs.len() {
        ls_walk_dir(dirs.get(di), 0, out)
        di = di + 1
    }
    let sorted: list[str] = ls_str_sorted(out)
    let capped: list[str] = []
    let mut i: int = 0
    while i < sorted.len() && i < ls_dep_file_cap() {
        capped.push(sorted.get(i))
        i = i + 1
    }
    return capped
}

fn ls_walk_dir(dir: str, depth: int, out: list[str]) -> void uses Fs {
    if depth > 6 {
        return
    }
    if !fs_is_dir(dir) {
        return
    }
    let entries: list[str] = fs_read_dir(dir)
    let mut i: int = 0
    while i < entries.len() {
        let name: str = entries.get(i)
        i = i + 1
        if ls_starts(name, ".") {
            continue
        }
        if name == "__pycache__" {
            continue
        }
        let full: str = join_path(dir, name)
        if fs_is_dir(full) {
            ls_walk_dir(full, depth + 1, out)
        } else if ls_ends(name, ".hls") {
            if !ls_in(full, out) {
                out.push(full)
            }
        }
    }
}

# ls_str_sorted — a bytewise-ascending copy.
fn ls_str_sorted(src: list[str]) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    while i < src.len() {
        out.push(src.get(i))
        i = i + 1
    }
    let mut a: int = 1
    while a < out.len() {
        let v: str = out.get(a)
        let mut b: int = a - 1
        while b >= 0 && out.get(b) > v {
            out.set(b + 1, out.get(b))
            b = b - 1
        }
        out.set(b + 1, v)
        a = a + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# JSON helpers over JsonValue (params reading, message shaping).
# ----------------------------------------------------------------------------

# ls_jstr(obj, key) — the string field, "" when absent.
fn ls_jstr(obj: JsonValue, key: str) -> str {
    if !json_is_object(obj) {
        return ""
    }
    let v: JsonValue = json_object_get(obj, key)
    if json_is_str(v) {
        return json_str_value(v)
    }
    return ""
}

# ls_jint(obj, key) — the integer field, 0 when absent.
fn ls_jint(obj: JsonValue, key: str) -> int {
    if !json_is_object(obj) {
        return 0
    }
    let v: JsonValue = json_object_get(obj, key)
    if json_is_int(v) {
        return json_int_value(v)
    }
    return 0
}

# ls_jget(obj, key) — the field, null when absent.
fn ls_jget(obj: JsonValue, key: str) -> JsonValue {
    if !json_is_object(obj) {
        return json_null()
    }
    return json_object_get(obj, key)
}

# ----------------------------------------------------------------------------
# The wire writers — responses, notifications, the exact shapes.
# ----------------------------------------------------------------------------

# ls_send_result(id, result) — a plain success reply.
fn ls_send_result(id: JsonValue, result: JsonValue) -> void uses IO {
    let keys: list[str] = ["jsonrpc", "id", "result"]
    let vals: list[JsonValue] = [json_str("2.0"), id, result]
    ls_write_message(json_stringify(json_object(keys, vals)))
}

# ls_send_error(id, code, message) — an error reply (id null for
# parse errors, per JSON-RPC).
fn ls_send_error(id: JsonValue, code: int, message: str) -> void
uses IO {
    let ekeys: list[str] = ["code", "message"]
    let evals: list[JsonValue] = [json_int(code), json_str(message)]
    let keys: list[str] = ["jsonrpc", "id", "error"]
    let vals: list[JsonValue] = [json_str("2.0"), id,
    json_object(ekeys, evals)]
    ls_write_message(json_stringify(json_object(keys, vals)))
}

# ls_send_notification(method, params) — a notification.
fn ls_send_notification(method: str, params: JsonValue) -> void
uses IO {
    let keys: list[str] = ["jsonrpc", "method", "params"]
    let vals: list[JsonValue] = [json_str("2.0"), json_str(method),
    params]
    ls_write_message(json_stringify(json_object(keys, vals)))
}

# ls_pos_json(line0, char16) — the LSP position object.
fn ls_pos_json(line0: int, char16: int) -> JsonValue {
    let ks: list[str] = ["line", "character"]
    let vs: list[JsonValue] = [json_int(line0), json_int(char16)]
    return json_object(ks, vs)
}

# ls_range_json(sl, sc, el, ec) — the LSP range object.
fn ls_range_json(sl: int, sc: int, el: int, ec: int) -> JsonValue {
    let ks: list[str] = ["start", "end"]
    let vs: list[JsonValue] = [ls_pos_json(sl, sc), ls_pos_json(el, ec)]
    return json_object(ks, vs)
}

# ls_location_json(uri, line0) — the .py's definition location: a
# 1-char span at column 0 of the declaration line.
fn ls_location_json(uri: str, line0: int) -> JsonValue {
    let ks: list[str] = ["uri", "range"]
    let vs: list[JsonValue] = [json_str(uri),
    ls_range_json(line0, 0, line0, 1)]
    return json_object(ks, vs)
}

# ----------------------------------------------------------------------------
# Diagnostics — publish on open/change/close, exactly the .py's law.
# ----------------------------------------------------------------------------

# ls_publish_diagnostics(st, di) — one doc's verdict on the wire. At
# most one diagnostic; a 1-char span at the error position; an empty
# list clears (close, dead program, clean file alike).
fn ls_publish_diagnostics(st: LsState, di: int) -> void uses IO {
    let d: DocRec = st.docs.get(di)
    let dkeys: list[str] = []
    let dvals: list[JsonValue] = []
    if d.parse_err || d.dead {
        # the marker case: the full syntax-error text, anchored at
        # the lexer's position when present
        let el: int = d.err_line
        let ec: int = d.err_col
        let mut eline: int = 0
        if el > 1 {
            eline = el - 1
        }
        let mut echar: int = 0
        if ec > 1 {
            echar = ls_utf16_of_byte_col(d.text, d.offs, eline,
            ec - 1)
        }
        dkeys.push("range")
        dvals.push(ls_range_json(eline, echar, eline, echar + 1))
        dkeys.push("severity")
        dvals.push(json_int(1))
        dkeys.push("source")
        dvals.push(json_str("hls-checker"))
        dkeys.push("message")
        dvals.push(json_str(d.err_msg))
    } else if d.err_msg != "" {
        # the checker case: the raw message, the line the checker
        # named (its columns are absent natively — column 0)
        let mut cline: int = 0
        if d.err_line > 1 {
            cline = d.err_line - 1
        }
        dkeys.push("range")
        dvals.push(ls_range_json(cline, 0, cline, 1))
        dkeys.push("severity")
        dvals.push(json_int(1))
        dkeys.push("source")
        dvals.push(json_str("hls-checker"))
        dkeys.push("message")
        dvals.push(json_str(d.err_msg))
    }
    let pkeys: list[str] = ["uri", "diagnostics"]
    let pvals: list[JsonValue] = [json_str(d.uri),
    json_array([json_object(dkeys, dvals)])]
    ls_send_notification("textDocument/publishDiagnostics",
    json_object(pkeys, pvals))
}

# ----------------------------------------------------------------------------
# Definition — the resolution law, in the .py's order.
# ----------------------------------------------------------------------------

# ls_find_in_syms(syms, name) — the declaration line of name in one
# symbol table, or 0. Order: exact fn key, structs, enums, method
# short names, enum variants.
fn ls_find_in_syms(syms: Syms, name: str) -> int {
    let fi: int = ls_sym_fn(syms, name)
    if fi >= 0 {
        return syms.fns.get(fi).line
    }
    let si: int = ls_sym_struct(syms, name)
    if si >= 0 {
        return syms.structs.get(si).line
    }
    let ei: int = ls_sym_enum(syms, name)
    if ei >= 0 {
        return syms.enums.get(ei).line
    }
    # method short names ("Struct.method" keys)
    let mut i: int = 0
    while i < syms.fns.len() {
        let f: SymFn = syms.fns.get(i)
        if ls_after_last_sep(f.key, ".") == name {
            return f.line
        }
        i = i + 1
    }
    # enum variants: "Enum.Variant"
    let mut j: int = 0
    while j < syms.enums.len() {
        let en: SymEnum = syms.enums.get(j)
        if ls_in(name, en.variants) {
            return en.line
        }
        j = j + 1
    }
    return 0
}

# ls_import_paths(st, di) — the doc's imports resolved to paths
# ("" entries skipped).
fn ls_import_paths(st: LsState, di: int) -> list[str] uses Proc,
Fs, Args {
    let d: DocRec = st.docs.get(di)
    let out: list[str] = []
    let dir: str = dir_of(d.path)
    let mut i: int = 0
    while i < d.syms.imports.len() {
        let imp: str = d.syms.imports.get(i)
        let resolved: str = ls_resolve_import(imp, dir, d.path, st)
        if resolved != "" {
            out.push(resolved)
        }
        i = i + 1
    }
    return out
}

# ls_find_def_in_path(st, path, name) — the declaration line of name
# in the file at path (an open buffer's live table when open, else
# the external load), or 0.
fn ls_find_def_in_path(st: LsState, path: str, name: str) -> int
uses Proc, Fs, Args {
    let mut i: int = 0
    while i < st.docs.len() {
        if st.docs.get(i).path == path {
            return ls_find_in_syms(st.docs.get(i).syms, name)
        }
        i = i + 1
    }
    let ei: int = ls_ext_fresh(st, path)
    if ei < 0 {
        return 0
    }
    return ls_find_in_syms(st.ext.get(ei).syms, name)
}

# ls_handle_definition(st, params) — the single Location or null.
fn ls_handle_definition(st: LsState, params: JsonValue) -> JsonValue
uses Proc, Fs, Args, IO {
    let td: JsonValue = ls_jget(params, "textDocument")
    let uri: str = ls_jstr(td, "uri")
    let pos: JsonValue = ls_jget(params, "position")
    let line0: int = ls_jint(pos, "line")
    let char16: int = ls_jint(pos, "character")
    let mut di: int = ls_find_doc(st, uri)
    if di < 0 && st.docs.len() > 0 {
        di = 0
    }
    if di < 0 {
        return json_null()
    }
    let d: DocRec = st.docs.get(di)
    if d.parse_err || d.dead {
        return json_null()
    }
    let bytecol: int = ls_byte_of_utf16_col(d.text, d.offs, line0,
    char16)
    let off: int = ls_linecol_to_off(d.offs, line0, bytecol)
    let ti: int = ls_tok_at(d.toks, off)
    if ti < 0 {
        return json_null()
    }
    let t: LTok = d.toks.get(ti)
    # 1. the import path literal — a str token right after `import`.
    if t.kind == "str" && ti > 0
    && d.toks.get(ti - 1).kind == "kw"
    && d.toks.get(ti - 1).value == "import" {
        let quoted: str = t.value
        let mut imp: str = quoted
        if quoted.len() >= 2 {
            imp = quoted.slice(1, quoted.len() - 1)
        }
        let dir: str = dir_of(d.path)
        let resolved: str = ls_resolve_import(imp, dir, d.path, st)
        if resolved == "" {
            return json_null()
        }
        ls_ext_fresh(st, resolved)
        return ls_location_json(ls_path_to_uri(resolved), 0)
    }
    if t.kind != "ident" {
        return json_null()
    }
    let name: str = t.value
    # 2. the current document.
    let here: int = ls_find_in_syms(d.syms, name)
    if here > 0 {
        return ls_location_json(d.uri, here - 1)
    }
    # 3. the imports (open buffers beat disk — ls_find_def_in_path
    # answers the open table when the path is an open doc's).
    let imps: list[str] = ls_import_paths(st, di)
    let mut i: int = 0
    while i < imps.len() {
        let line: int = ls_find_def_in_path(st, imps.get(i), name)
        if line > 0 {
            return ls_location_json(
            ls_path_to_uri(imps.get(i)), line - 1)
        }
        i = i + 1
    }
    # 4. the dependency sources.
    let deps: list[str] = ls_dep_files(st, d.path)
    let mut j: int = 0
    while j < deps.len() {
        let line2: int = ls_find_def_in_path(st, deps.get(j), name)
        if line2 > 0 {
            return ls_location_json(
            ls_path_to_uri(deps.get(j)), line2 - 1)
        }
        j = j + 1
    }
    # 5. the last-resort net over the other open documents.
    let mut k: int = 0
    while k < st.docs.len() {
        if k != di {
            let line3: int = ls_find_in_syms(
            st.docs.get(k).syms, name)
            if line3 > 0 {
                return ls_location_json(st.docs.get(k).uri,
                line3 - 1)
            }
        }
        k = k + 1
    }
    return json_null()
}

# ----------------------------------------------------------------------------
# References — every occurrence of the name, open docs + imports +
# dependencies (read-only).
# ----------------------------------------------------------------------------

fn ls_handle_references(st: LsState, params: JsonValue) -> JsonValue
uses Proc, Fs, Args, IO {
    let td: JsonValue = ls_jget(params, "textDocument")
    let uri: str = ls_jstr(td, "uri")
    let pos: JsonValue = ls_jget(params, "position")
    let line0: int = ls_jint(pos, "line")
    let char16: int = ls_jint(pos, "character")
    let out: list[JsonValue] = []
    let mut di: int = ls_find_doc(st, uri)
    if di < 0 && st.docs.len() > 0 {
        di = 0
    }
    if di < 0 {
        return json_array(out)
    }
    let d: DocRec = st.docs.get(di)
    let bytecol: int = ls_byte_of_utf16_col(d.text, d.offs, line0,
    char16)
    let off: int = ls_linecol_to_off(d.offs, line0, bytecol)
    let ti: int = ls_tok_at(d.toks, off)
    if ti < 0 || d.toks.get(ti).kind != "ident" {
        return json_array(out)
    }
    let name: str = d.toks.get(ti).value
    # every open document's occurrences
    let mut i: int = 0
    while i < st.docs.len() {
        ls_refs_in_text(out, st.docs.get(i).uri,
        st.docs.get(i).text, st.docs.get(i).offs,
        st.docs.get(i).toks, name)
        i = i + 1
    }
    # the imports + dependencies (on disk)
    let imps: list[str] = ls_import_paths(st, di)
    let mut j: int = 0
    while j < imps.len() {
        ls_refs_in_file(st, out, imps.get(j), name)
        j = j + 1
    }
    let deps: list[str] = ls_dep_files(st, d.path)
    let mut k: int = 0
    while k < deps.len() {
        if !ls_in(deps.get(k), imps) {
            ls_refs_in_file(st, out, deps.get(k), name)
        }
        k = k + 1
    }
    return json_array(out)
}

# ls_refs_in_text — every ident occurrence's Location.
fn ls_refs_in_text(out: list[JsonValue], uri: str, text: str,
offs: list[int], toks: list[LTok], name: str) -> void {
    let mut i: int = 0
    while i < toks.len() {
        let t: LTok = toks.get(i)
        if t.kind == "ident" && t.value == name {
            let line0: int = ls_line_of(offs, t.off)
            let char16: int = ls_utf16_of_byte_col(text, offs, line0,
            t.off - offs.get(line0))
            out.push(ls_location_json(uri, line0))
        }
        i = i + 1
    }
}

# ls_refs_in_file — the on-disk file's occurrences (fresh external).
fn ls_refs_in_file(st: LsState, out: list[JsonValue], path: str,
name: str) -> void uses Proc, Fs, Args {
    let mut di: int = 0
    while di < st.docs.len() {
        if st.docs.get(di).path == path {
            ls_refs_in_text(out, st.docs.get(di).uri,
            st.docs.get(di).text, st.docs.get(di).offs,
            st.docs.get(di).toks, name)
            return
        }
        di = di + 1
    }
    let ei: int = ls_ext_fresh(st, path)
    if ei < 0 {
        return
    }
    let rec: ExtRec = st.ext.get(ei)
    ls_refs_in_text(out, ls_path_to_uri(path), rec.text, rec.offs,
    rec.toks, name)
}

# ----------------------------------------------------------------------------
# Completion — the plain array, the .py's source order.
# ----------------------------------------------------------------------------

fn ls_handle_completion(st: LsState, params: JsonValue) -> JsonValue
uses Proc, Fs, Args, IO {
    let td: JsonValue = ls_jget(params, "textDocument")
    let uri: str = ls_jstr(td, "uri")
    let mut di: int = ls_find_doc(st, uri)
    if di < 0 && st.docs.len() > 0 {
        di = 0
    }
    let out: list[JsonValue] = []
    # 1-3. keywords, builtins, effects.
    let kws: list[str] = ls_keywords()
    let mut i: int = 0
    while i < kws.len() {
        out.push(ls_completion_item(kws.get(i), 14))
        i = i + 1
    }
    let blts: list[str] = ls_builtins()
    let mut b: int = 0
    while b < blts.len() {
        out.push(ls_completion_item(blts.get(b), 3))
        b = b + 1
    }
    let fxs: list[str] = ls_effects()
    let mut f: int = 0
    while f < fxs.len() {
        out.push(ls_completion_item(fxs.get(f), 13))
        f = f + 1
    }
    if di < 0 {
        return json_array(out)
    }
    let d: DocRec = st.docs.get(di)
    # 4. the document's own fns/structs/enums.
    ls_push_syms_completions(out, d.syms)
    # 5. the imports' fns/structs/enums.
    let imps: list[str] = ls_import_paths(st, di)
    let mut j: int = 0
    while j < imps.len() {
        let mut seen: int = 0
        while seen < st.docs.len() {
            if st.docs.get(seen).path == imps.get(j) {
                ls_push_syms_completions(out,
                st.docs.get(seen).syms)
                seen = st.docs.len() + 1
            } else {
                seen = seen + 1
            }
        }
        if seen == st.docs.len() {
            let ei: int = ls_ext_fresh(st, imps.get(j))
            if ei >= 0 {
                ls_push_syms_completions(out,
                st.ext.get(ei).syms)
            }
        }
        j = j + 1
    }
    return json_array(out)
}

fn ls_completion_item(label: str, kind: int) -> JsonValue {
    let ks: list[str] = ["label", "kind"]
    let vs: list[JsonValue] = [json_str(label), json_int(kind)]
    return json_object(ks, vs)
}

fn ls_push_syms_completions(out: list[JsonValue], syms: Syms)
-> void {
    let mut i: int = 0
    while i < syms.fns.len() {
        out.push(ls_completion_item(syms.fns.get(i).key, 3))
        i = i + 1
    }
    let mut s: int = 0
    while s < syms.structs.len() {
        out.push(ls_completion_item(syms.structs.get(s).name, 7))
        s = s + 1
    }
    let mut e: int = 0
    while e < syms.enums.len() {
        out.push(ls_completion_item(syms.enums.get(e).name, 13))
        e = e + 1
    }
}

# ----------------------------------------------------------------------------
# Hover — the markdown value, the .py's type-lookup priority.
# ----------------------------------------------------------------------------

fn ls_handle_hover(st: LsState, params: JsonValue) -> JsonValue
uses IO {
    let td: JsonValue = ls_jget(params, "textDocument")
    let uri: str = ls_jstr(td, "uri")
    let pos: JsonValue = ls_jget(params, "position")
    let line0: int = ls_jint(pos, "line")
    let char16: int = ls_jint(pos, "character")
    let mut di: int = ls_find_doc(st, uri)
    if di < 0 && st.docs.len() > 0 {
        di = 0
    }
    if di < 0 {
        return json_null()
    }
    let d: DocRec = st.docs.get(di)
    if d.parse_err || d.dead {
        return json_null()
    }
    let bytecol: int = ls_byte_of_utf16_col(d.text, d.offs, line0,
    char16)
    let off: int = ls_linecol_to_off(d.offs, line0, bytecol)
    let ti: int = ls_tok_at(d.toks, off)
    if ti < 0 || d.toks.get(ti).kind != "ident" {
        return json_null()
    }
    let name: str = d.toks.get(ti).value
    let tinfo: str = ls_lookup_type(d, ti, name)
    let mut value: str = "**" + name + "**"
    if tinfo != "" {
        value = value + "\n\n```\n" + name + ": " + tinfo + "\n```"
    }
    let ks: list[str] = ["kind", "value"]
    let vs: list[JsonValue] = [json_str("markdown"),
    json_str(value)]
    let cks: list[str] = ["contents"]
    let cvs: list[JsonValue] = [json_object(ks, vs)]
    return json_object(cks, cvs)
}

# ls_lookup_type — the .py's _lookup_type priority: the enclosing
# fn's params, the fn signature, the struct field (unique), any fn's
# param, the struct/enum name.
fn ls_lookup_type(d: DocRec, ti: int, name: str) -> str {
    let mut fi: int = ti - 1
    while fi >= 0 {
        if d.toks.get(fi).kind == "kw"
        && d.toks.get(fi).value == "fn" {
            if fi + 1 < d.toks.len()
            && d.toks.get(fi + 1).kind == "ident" {
                return ls_type_in_fn(d, d.toks.get(fi + 1).value,
                name)
            }
        }
        fi = fi - 1
    }
    return ls_type_any_fn(d, name)
}

fn ls_type_in_fn(d: DocRec, fname: str, name: str) -> str {
    let mut i: int = 0
    while i < d.syms.fns.len() {
        let f: SymFn = d.syms.fns.get(i)
        if f.key == fname
        || ls_after_last_sep(f.key, ".") == fname {
            let mut p: int = 0
            while p < f.params.len() {
                if f.params.get(p) == name {
                    return f.ptypes.get(p)
                }
                p = p + 1
            }
        }
        i = i + 1
    }
    return ls_type_any_fn(d, name)
}

fn ls_type_any_fn(d: DocRec, name: str) -> str {
    # a fn of that name: the signature.
    let fi: int = ls_sym_fn(d.syms, name)
    if fi >= 0 {
        let f: SymFn = d.syms.fns.get(fi)
        let mut sig: str = f.key + "("
        let mut i: int = 0
        while i < f.params.len() {
            if i > 0 {
                sig = sig + ", "
            }
            sig = sig + f.params.get(i) + ": " + f.ptypes.get(i)
            i = i + 1
        }
        sig = sig + ") -> " + f.ret
        return sig
    }
    # a struct field: unique struct only, ambiguous = the " | " join.
    let mut found: list[str] = []
    let mut s: int = 0
    while s < d.syms.structs.len() {
        let st: SymStruct = d.syms.structs.get(s)
        let mut fi2: int = 0
        while fi2 < st.fields.len() {
            if st.fields.get(fi2) == name {
                found.push(st.name + "." + name + ": "
                + st.ftypes.get(fi2))
            }
            fi2 = fi2 + 1
        }
        s = s + 1
    }
    if found.len() == 1 {
        return found.get(0)
    }
    if found.len() > 1 {
        return str_join(found, " | ")
    }
    # any fn's param of that name.
    let mut i2: int = 0
    while i2 < d.syms.fns.len() {
        let f2: SymFn = d.syms.fns.get(i2)
        let mut p2: int = 0
        while p2 < f2.params.len() {
            if f2.params.get(p2) == name {
                return "param of " + f2.key
            }
            p2 = p2 + 1
        }
        i2 = i2 + 1
    }
    # the struct / enum name.
    let si: int = ls_sym_struct(d.syms, name)
    if si >= 0 {
        return "struct " + name
    }
    let ei: int = ls_sym_enum(d.syms, name)
    if ei >= 0 {
        return "enum " + name
    }
    return ""
}

# ----------------------------------------------------------------------------
# documentSymbol — fns / structs / enums, sorted by declaration line.
# ----------------------------------------------------------------------------

fn ls_handle_document_symbol(st: LsState, params: JsonValue)
-> JsonValue uses IO {
    let td: JsonValue = ls_jget(params, "textDocument")
    let uri: str = ls_jstr(td, "uri")
    let mut di: int = ls_find_doc(st, uri)
    if di < 0 && st.docs.len() > 0 {
        di = 0
    }
    if di < 0 {
        return json_array([])
    }
    let d: DocRec = st.docs.get(di)
    let rows: list[list[str]] = []
    let mut i: int = 0
    while i < d.syms.fns.len() {
        let f: SymFn = d.syms.fns.get(i)
        let mut nm: str = f.key
        if f.is_method {
            nm = ls_after_last_sep(f.key, ".")
        }
        let mut sig: str = nm + "("
        let mut p: int = 0
        while p < f.params.len() {
            if p > 0 {
                sig = sig + ", "
            }
            sig = sig + f.params.get(p) + ": " + f.ptypes.get(p)
            p = p + 1
        }
        sig = sig + ") -> " + f.ret
        rows.push([f.line.to_str(), sig, "12"])
        i = i + 1
    }
    let mut s: int = 0
    while s < d.syms.structs.len() {
        let st2: SymStruct = d.syms.structs.get(s)
        rows.push([st2.line.to_str(), "struct " + st2.name, "23"])
        s = s + 1
    }
    let mut e: int = 0
    while e < d.syms.enums.len() {
        let en: SymEnum = d.syms.enums.get(e)
        rows.push([en.line.to_str(), "enum " + en.name, "10"])
        e = e + 1
    }
    # sort by line (insertion sort, the rows are few).
    let mut a: int = 1
    while a < rows.len() {
        let v: list[str] = rows.get(a)
        let mut b: int = a - 1
        while b >= 0 && ls_atoi(rows.get(b).get(0))
        > ls_atoi(v.get(0)) {
            rows.set(b + 1, rows.get(b))
            b = b - 1
        }
        rows.set(b + 1, v)
        a = a + 1
    }
    let out: list[JsonValue] = []
    let mut r: int = 0
    while r < rows.len() {
        let line0: int = ls_atoi(rows.get(r).get(0)) - 1
        let ks: list[str] = ["name", "kind", "range",
        "selectionRange"]
        let vs: list[JsonValue] = [json_str(rows.get(r).get(1)),
        json_int(ls_atoi(rows.get(r).get(2))),
        ls_range_json(line0, 0, line0, 1),
        ls_range_json(line0, 0, line0, 1)]
        out.push(json_object(ks, vs))
        r = r + 1
    }
    return json_array(out)
}

# ----------------------------------------------------------------------------
# Inlay hints (Stage 114) — the .py engine, ported whole. The AST
# records no columns, so hint POSITIONS come from the token stream:
# the probe's walk (CALL/ARM lines, source order) drives two
# monotonic cursors — one per hint family — that re-locate each site.
# A site that cannot be re-located is skipped, never guessed at.
# Resolution mirrors the checker: builtins first, then local fns,
# then the files the document imports; a hint is emitted only when
# the argument count exactly matches the parameter count. Failures
# degrade to fewer hints, never to a wrong one.
# ----------------------------------------------------------------------------

# ParamRes — a resolution's verdict (ok=false means "no hints here",
# never an error; names empty with ok=true is a real zero-param hit).
struct ParamRes {
    ok: bool,
    names: list[str]
}

# ls_builtin_method_exists — a KEY-EXISTS check (the ambiguous "set"
# has a table entry with no names; it still silences user methods and
# yields nothing itself).
fn ls_builtin_method_exists(name: str) -> bool {
    return ls_builtin_method_params(name).len() > 0 || name == "set"
}

# ls_str_list_eq — element-wise equality.
fn ls_str_list_eq(a: list[str], b: list[str]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let mut i: int = 0
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

# ls_push_unique — append unless present (the .py's set add).
fn ls_push_unique(lst: list[str], s: str) -> void {
    let mut i: int = 0
    while i < lst.len() {
        if lst.get(i) == s {
            return
        }
        i = i + 1
    }
    lst.push(s)
}

# ls_syms_for_path — an open buffer's live table when the path is
# open (the layer law's "open beats disk"), else the external load.
fn ls_syms_for_path(st: LsState, path: str) -> Syms uses Proc, Fs,
Args {
    let mut i: int = 0
    while i < st.docs.len() {
        if st.docs.get(i).path == path {
            return st.docs.get(i).syms
        }
        i = i + 1
    }
    let ei: int = ls_ext_fresh(st, path)
    if ei < 0 {
        return ls_syms_empty()
    }
    return st.ext.get(ei).syms
}

# ls_resolve_fn_params — the .py's _resolve_fn_params: builtins beat
# user fns (a user fn cannot shadow one), then the local program,
# then the imports — two imports disagreeing on the signature is
# ambiguous and answers nothing.
fn ls_resolve_fn_params(st: LsState, di: int, name: str) -> ParamRes
uses Proc, Fs, Args {
    let bp: list[str] = ls_builtin_params(name)
    if bp.len() > 0 {
        return ParamRes { ok: true, names: bp }
    }
    let d: DocRec = st.docs.get(di)
    let li: int = ls_sym_fn(d.syms, name)
    if li >= 0 {
        return ParamRes { ok: true, names: d.syms.fns.get(li).params }
    }
    let paths: list[str] = ls_import_paths(st, di)
    let mut found_p: list[str] = []
    let mut found_t: list[str] = []
    let mut have: bool = false
    let mut ambig: bool = false
    let mut i: int = 0
    while i < paths.len() {
        let syms: Syms = ls_syms_for_path(st, paths.get(i))
        let fi: int = ls_sym_fn(syms, name)
        if fi >= 0 {
            let cand: SymFn = syms.fns.get(fi)
            if !have {
                found_p = cand.params
                found_t = cand.ptypes
                have = true
            } else {
                if !ls_str_list_eq(found_p, cand.params)
                || !ls_str_list_eq(found_t, cand.ptypes) {
                    ambig = true
                }
            }
        }
        i = i + 1
    }
    if have && !ambig {
        return ParamRes { ok: true, names: found_p }
    }
    return ParamRes { ok: false, names: [] }
}

# ls_method_cands — every fn key "Owner.name" of that method name in
# the symbol table (unique keys, local and imports merged).
fn ls_method_cands(syms: Syms, name: str, cands: list[str]) -> void {
    let mut i: int = 0
    while i < syms.fns.len() {
        let k: str = syms.fns.get(i).key
        if ls_ends(k, "." + name) {
            ls_push_unique(cands, k)
        }
        i = i + 1
    }
}

# ls_params_tail — params[1:] (the receiver is not an argument).
fn ls_params_tail(f: SymFn) -> list[str] {
    let out: list[str] = []
    let mut i: int = 1
    while i < f.params.len() {
        out.push(f.params.get(i))
        i = i + 1
    }
    return out
}

# ls_resolve_method_params — the .py's _resolve_method_params: an
# `Enum.Variant(...)` constructor names nothing; a user method hints
# only as the UNIQUE candidate and never when a builtin method of the
# same name exists (the receiver could be either); builtin methods
# hint from the table ("set" exists but yields nothing).
fn ls_resolve_method_params(st: LsState, di: int, paren: int,
name: str) -> ParamRes uses Proc, Fs, Args {
    let d: DocRec = st.docs.get(di)
    let toks: list[LTok] = d.toks
    # Enum-variant constructor: the token three back from the paren
    # (the head of `Head.name(`) names a local enum whose variant the
    # method is.
    if paren >= 3 {
        let head: LTok = toks.get(paren - 3)
        if head.kind == "ident" {
            let ei: int = ls_sym_enum(d.syms, head.value)
            if ei >= 0 {
                let en: SymEnum = d.syms.enums.get(ei)
                let mut vi: int = 0
                while vi < en.variants.len() {
                    if en.variants.get(vi) == name {
                        return ParamRes { ok: false, names: [] }
                    }
                    vi = vi + 1
                }
            }
        }
    }
    # User methods — unique candidate only.
    let cands: list[str] = []
    ls_method_cands(d.syms, name, cands)
    let paths: list[str] = ls_import_paths(st, di)
    let mut pi: int = 0
    while pi < paths.len() {
        ls_method_cands(ls_syms_for_path(st, paths.get(pi)), name,
        cands)
        pi = pi + 1
    }
    if cands.len() > 0 {
        if cands.len() != 1 || ls_builtin_method_exists(name) {
            return ParamRes { ok: false, names: [] }
        }
        let key: str = cands.get(0)
        let li: int = ls_sym_fn(d.syms, key)
        if li >= 0 {
            return ParamRes { ok: true,
            names: ls_params_tail(d.syms.fns.get(li)) }
        }
        pi = 0
        while pi < paths.len() {
            let syms: Syms = ls_syms_for_path(st, paths.get(pi))
            let fi2: int = ls_sym_fn(syms, key)
            if fi2 >= 0 {
                return ParamRes { ok: true,
                names: ls_params_tail(syms.fns.get(fi2)) }
            }
            pi = pi + 1
        }
        return ParamRes { ok: false, names: [] }
    }
    # Builtin methods (the ambiguous "set" exists but yields none).
    let mp: list[str] = ls_builtin_method_params(name)
    if mp.len() == 0 {
        return ParamRes { ok: false, names: [] }
    }
    return ParamRes { ok: true, names: mp }
}

# ls_scan_call_site — the open-paren token of the call site for
# `name` at/after `start`, preferring the node's own line (the AST
# line is the callee-name token's line); a later line is the
# multi-line-spelling fallback; an earlier line is stale, skipped.
fn ls_scan_call_site(toks: list[LTok], start: int, name: str,
node_line: int, want_method: bool) -> int {
    let n: int = toks.len()
    let mut fallback: int = -1
    let mut i: int = start
    while i < n {
        let t: LTok = toks.get(i)
        if want_method {
            if t.kind == "sym" && t.value == "." && i + 2 < n
            && toks.get(i + 1).kind == "ident"
            && toks.get(i + 1).value == name
            && toks.get(i + 2).kind == "sym"
            && toks.get(i + 2).value == "(" {
                let ln: int = toks.get(i + 1).line
                if ln == node_line {
                    return i + 2
                }
                if fallback < 0 && ln > node_line {
                    fallback = i + 2
                }
                i = i + 3
                continue
            }
        } else {
            if t.kind == "ident" && t.value == name && i + 1 < n
            && toks.get(i + 1).kind == "sym"
            && toks.get(i + 1).value == "(" {
                let ln: int = t.line
                if ln == node_line {
                    return i + 1
                }
                if fallback < 0 && ln > node_line {
                    fallback = i + 1
                }
                i = i + 2
                continue
            }
        }
        i = i + 1
    }
    return fallback
}

# ls_arg_spans — the top-level argument token spans [start, end) of
# the call whose open paren sits at `paren`. A group that never
# closes answers the failure marker [[-1, -1]] (the .py's None);
# nesting counts brackets of every shape, and strings are single
# tokens so they cannot tilt the depth counter.
fn ls_arg_spans(toks: list[LTok], paren: int) -> list[list[int]] {
    let n: int = toks.len()
    let spans: list[list[int]] = []
    let mut depth: int = 1
    let mut j: int = paren + 1
    let mut expect_arg: bool = true
    let mut start: int = -1
    while j < n {
        let t: LTok = toks.get(j)
        if depth == 1 && expect_arg {
            start = j
            expect_arg = false
        }
        if t.kind == "sym" {
            let v: str = t.value
            if v == "(" || v == "[" || v == "{" {
                depth = depth + 1
            } else if v == ")" || v == "]" || v == "}" {
                depth = depth - 1
                if depth == 0 {
                    if start >= 0 {
                        spans.push([start, j])
                    }
                    return spans
                }
            } else if v == "," && depth == 1 {
                if start >= 0 {
                    spans.push([start, j])
                }
                expect_arg = true
            }
        }
        j = j + 1
    }
    return [[-1, -1]]
}

# ls_pattern_bindings_before — the binding identifier tokens inside
# the `(...)` group that closes immediately before `arrow`, in source
# order. A backward scan cannot be confused by braces in the
# scrutinee or in an earlier arm's body. [] when the arrow has no
# balanced paren group before it (a wildcard arm, a bare pattern, or
# anything this scan refuses to guess about).
fn ls_pattern_bindings_before(toks: list[LTok], arrow: int)
-> list[int] {
    let n: int = toks.len()
    let mut j: int = arrow - 1
    if j < 0 || toks.get(j).kind != "sym"
    || toks.get(j).value != ")" {
        return []
    }
    let mut depth: int = 1
    let rev: list[int] = []
    j = j - 1
    while j >= 0 && depth > 0 {
        let t: LTok = toks.get(j)
        if t.kind == "sym" {
            if t.value == ")" || t.value == "]" || t.value == "}" {
                depth = depth + 1
            } else if t.value == "(" || t.value == "["
            || t.value == "{" {
                depth = depth - 1
                if depth == 0 {
                    break
                }
            }
        } else if t.kind == "ident" && depth == 1 && t.value != "_" {
            rev.push(j)
        }
        j = j - 1
    }
    let out: list[int] = []
    let mut k: int = rev.len() - 1
    while k >= 0 {
        out.push(rev.get(k))
        k = k - 1
    }
    return out
}

# ls_emit_binding_hint — one `: T` hint just past the binding name.
fn ls_emit_binding_hint(d: DocRec, t: LTok, btype: str, lo: int,
hi: int, hints: list[JsonValue]) -> void {
    if btype == "" {
        return
    }
    let line0: int = t.line - 1
    if line0 < lo || line0 > hi {
        return
    }
    let col_byte: int = t.off - d.offs.get(line0)
    let char16: int = ls_utf16_of_byte_col(d.text, d.offs, line0,
    col_byte + t.len)
    hints.push(json_object(
    ["position", "label", "kind", "paddingLeft", "paddingRight",
    "tooltip"],
    [ls_pos_json(line0, char16), json_str(": " + btype), json_int(1),
    json_bool(false), json_bool(false),
    json_str("inferred match binding type")]))
}

# ls_inlay_arm — one match arm's binding hints. The arm's arrow is
# the first at/after the cursor (arms walk in source order, so the
# cursor stays monotonic); an arm that cannot be located ends the
# family's hinting. Types prefer the checker's instantiation (ARMB),
# falling back to the raw variant payloads of a qualified pattern —
# a check-broken document still types its bindings.
fn ls_inlay_arm(d: DocRec, wa: WalkArm, cursor: int, lo: int, hi: int,
hints: list[JsonValue]) -> int {
    let toks: list[LTok] = d.toks
    let n: int = toks.len()
    let mut i: int = cursor
    let mut arrow: int = -1
    while i < n {
        let t: LTok = toks.get(i)
        if t.kind == "sym" && t.value == "=>" {
            arrow = i
            break
        }
        i = i + 1
    }
    if arrow < 0 {
        return i
    }
    if wa.has_paren {
        let idents: list[int] = ls_pattern_bindings_before(toks, arrow)
        let checked: bool = wa.bind_ts.len() == wa.bindings.len()
        && wa.bindings.len() > 0
        let mut ti: int = 0
        while ti < idents.len() {
            let t2: LTok = toks.get(idents.get(ti))
            let mut btype: str = ""
            if checked {
                # the checker's instantiation, by name
                let mut bi: int = 0
                while bi < wa.bindings.len() {
                    if wa.bindings.get(bi) == t2.value {
                        btype = wa.bind_ts.get(bi)
                        break
                    }
                    bi = bi + 1
                }
            } else if wa.enum_name != "" {
                # the raw variant payloads, zipped by position
                let ei: int = ls_sym_enum(d.syms, wa.enum_name)
                if ei >= 0 {
                    let en: SymEnum = d.syms.enums.get(ei)
                    let mut vidx: int = -1
                    let mut vi: int = 0
                    while vi < en.variants.len() {
                        if en.variants.get(vi) == wa.variant {
                            vidx = vi
                        }
                        vi = vi + 1
                    }
                    if vidx >= 0 {
                        let pls: list[str] = en.payloads.get(vidx)
                        if pls.len() == idents.len() {
                            btype = pls.get(ti)
                        }
                    }
                }
            }
            ls_emit_binding_hint(d, t2, btype, lo, hi, hints)
            ti = ti + 1
        }
    }
    return arrow + 1
}

# ls_inlay_call — one call site's parameter hints. Every guard
# degrades to "no hints for this site": unresolved callee, arity
# mismatch, unlocatable site, enum-variant constructor.
fn ls_inlay_call(st: LsState, di: int, wc: WalkCall, cursor: int,
lo: int, hi: int, hints: list[JsonValue]) -> int uses IO, Proc, Fs,
Args {
    let d: DocRec = st.docs.get(di)
    if wc.name == "" {
        return cursor
    }
    let paren: int = ls_scan_call_site(d.toks, cursor, wc.name,
    wc.line, wc.is_method)
    if paren < 0 {
        return cursor
    }
    let mut pr: ParamRes = ParamRes { ok: false, names: [] }
    if wc.is_method {
        pr = ls_resolve_method_params(st, di, paren, wc.name)
    } else {
        pr = ls_resolve_fn_params(st, di, wc.name)
    }
    if !pr.ok {
        return paren + 1
    }
    let spans: list[list[int]] = ls_arg_spans(d.toks, paren)
    if spans.len() > 0 && spans.get(0).get(0) == -1 {
        return paren + 1
    }
    if spans.len() != pr.names.len() {
        return paren + 1
    }
    let mut callee: str = wc.name
    if wc.is_method {
        callee = "." + wc.name
    }
    let mut i: int = 0
    while i < spans.len() {
        let sp: list[int] = spans.get(i)
        let pname: str = pr.names.get(i)
        let first: LTok = d.toks.get(sp.get(0))
        # Redundancy rule: `f(x: x)` — a single bare identifier
        # argument spelled exactly like its parameter says nothing
        # the source does not already say.
        if sp.get(1) - sp.get(0) == 1 && first.kind == "ident"
        && first.value == pname {
            i = i + 1
            continue
        }
        let line0: int = first.line - 1
        if line0 < lo || line0 > hi {
            i = i + 1
            continue
        }
        let col_byte: int = first.off - d.offs.get(line0)
        let char16: int = ls_utf16_of_byte_col(d.text, d.offs, line0,
        col_byte)
        hints.push(json_object(
        ["position", "label", "kind", "paddingLeft", "paddingRight",
        "tooltip"],
        [ls_pos_json(line0, char16), json_str(pname + ":"),
        json_int(2), json_bool(false), json_bool(true),
        json_str("parameter '" + pname + "' of '" + callee + "'")]))
        i = i + 1
    }
    return paren + 1
}

# ls_hint_line / ls_hint_char — a hint's sort keys.
fn ls_hint_line(h: JsonValue) -> int {
    return ls_jint(ls_jget(h, "position"), "line")
}

fn ls_hint_char(h: JsonValue) -> int {
    return ls_jint(ls_jget(h, "position"), "character")
}

# ls_handle_inlay_hint — the request: two family walks over the
# probe's site inventory, then the protocol's sorted-output law. A
# syntax-error document answers [] (never an error).
fn ls_handle_inlay_hint(st: LsState, params: JsonValue) -> JsonValue
uses IO, Proc, Fs, Args {
    let td: JsonValue = ls_jget(params, "textDocument")
    let uri: str = ls_jstr(td, "uri")
    let di: int = ls_find_doc(st, uri)
    if di < 0 {
        return json_array([])
    }
    let d: DocRec = st.docs.get(di)
    if d.parse_err || d.dead {
        return json_array([])
    }
    # the range filter; a missing range answers the whole document
    let mut lo: int = 0
    let mut hi: int = 1000000000
    let rng: JsonValue = ls_jget(params, "range")
    if json_is_object(rng) {
        let s0: int = ls_jint(ls_jget(rng, "start"), "line")
        let e0: int = ls_jint(ls_jget(rng, "end"), "line")
        if s0 >= 0 {
            lo = s0
        }
        if e0 >= 0 {
            hi = e0
        }
    }
    let hints: list[JsonValue] = []
    let mut cur: int = 0
    let mut ci: int = 0
    while ci < d.calls.len() {
        cur = ls_inlay_call(st, di, d.calls.get(ci), cur, lo, hi,
        hints)
        ci = ci + 1
    }
    let mut acur: int = 0
    let mut ai: int = 0
    while ai < d.arms.len() {
        acur = ls_inlay_arm(d, d.arms.get(ai), acur, lo, hi, hints)
        ai = ai + 1
    }
    # sorted by (line, character) — editors depend on it. Only
    # pointer slots move; no field writes, no aliasing hazard.
    let mut a: int = 1
    while a < hints.len() {
        let it: JsonValue = hints.get(a)
        let al: int = ls_hint_line(it)
        let ac: int = ls_hint_char(it)
        let mut b: int = a - 1
        let mut pos: int = a
        while b >= 0 {
            let bt: JsonValue = hints.get(b)
            let bl: int = ls_hint_line(bt)
            let bc: int = ls_hint_char(bt)
            if bl > al || (bl == al && bc > ac) {
                hints.set(b + 1, bt)
                pos = b
                b = b - 1
            } else {
                break
            }
        }
        hints.set(pos, it)
        a = a + 1
    }
    return json_array(hints)
}

# ----------------------------------------------------------------------------
# Rename + codeAction (Stage 115) — the refactor engines, ported whole
# from the .py twin. The token index is the coordinate system; the
# parser rides sub-children (a panic IS the refusal), the checker the
# probe. Byte offsets throughout — the lexer's columns are bytes.
# ----------------------------------------------------------------------------

# ---- the bracket machinery (the .py's _brace_matches / _tok_depths) ----

fn ls_is_open_sym(v: str) -> bool {
    return v == "(" || v == "[" || v == "{"
}

fn ls_is_close_sym(v: str) -> bool {
    return v == ")" || v == "]" || v == "}"
}

# BraceMap — the open->close pairs as parallel lists (map keys must
# be str in this language; token indices are ints).
struct BraceMap {
    opens: list[int],
    closes: list[int]
}

fn ls_brace_empty() -> BraceMap {
    return BraceMap { opens: [], closes: [] }
}

# ls_brace_get — the close index of an open, or -1.
fn ls_brace_get(bm: BraceMap, open: int) -> int {
    let mut i: int = 0
    while i < bm.opens.len() {
        if bm.opens.get(i) == open {
            return bm.closes.get(i)
        }
        i = i + 1
    }
    return -1
}

# ls_brace_has — is this open in the map?
fn ls_brace_has(bm: BraceMap, open: int) -> bool {
    return ls_brace_get(bm, open) >= 0
}

# ls_brace_matches — open-index -> close-index for ( [ {. A malformed
# file leaves unclosed opens out; callers treat a miss as unknown.
fn ls_brace_matches(toks: list[LTok]) -> BraceMap {
    let out: BraceMap = ls_brace_empty()
    let stack: list[int] = []
    let mut i: int = 0
    while i < toks.len() {
        let t: LTok = toks.get(i)
        if t.kind == "sym" {
            if ls_is_open_sym(t.value) {
                stack.push(i)
            } else if ls_is_close_sym(t.value) && stack.len() > 0 {
                let o: int = stack.pop()
                # the pair must match (( with ) etc.) — anything else
                # leaves the open unmatched.
                if ls_pair_of(toks.get(o).value) == t.value {
                    out.opens.push(o)
                    out.closes.push(i)
                }
            }
        }
        i = i + 1
    }
    return out
}

fn ls_pair_of(open: str) -> str {
    if open == "(" {
        return ")"
    }
    if open == "[" {
        return "]"
    }
    return "}"
}

# ls_tok_depths — the bracket depth BEFORE each token (0 at file top).
fn ls_tok_depths(toks: list[LTok]) -> list[int] {
    let depths: list[int] = []
    let mut d: int = 0
    let mut i: int = 0
    while i < toks.len() {
        depths.push(d)
        let t: LTok = toks.get(i)
        if t.kind == "sym" {
            if ls_is_open_sym(t.value) {
                d = d + 1
            } else if ls_is_close_sym(t.value) && d > 0 {
                d = d - 1
            }
        }
        i = i + 1
    }
    return depths
}

# ls_tok_covers — does token t cover byte offset off?
fn ls_tok_covers(t: LTok, off: int) -> bool {
    return t.off <= off && off < t.off + t.len
}

# ls_token_index_at — the index of the token covering the byte offset
# (converted from the wire position), or -1.
fn ls_token_index_at(toks: list[LTok], off: int) -> int {
    let mut i: int = 0
    while i < toks.len() {
        if ls_tok_covers(toks.get(i), off) {
            return i
        }
        i = i + 1
    }
    return -1
}

# ls_fn_spans — [start, end) token spans of every fn body (top-level
# fns and impl methods alike): the fn keyword through its body's close
# brace. An `extern fn` has no body and earns no span; header keywords
# (uses/pure/extern) never end the scan, only a declaration keyword can.
fn ls_fn_spans(toks: list[LTok], braces: BraceMap) -> list[list[int]] {
    let spans: list[list[int]] = []
    let n: int = toks.len()
    let mut i: int = 0
    while i < n {
        let t: LTok = toks.get(i)
        if t.kind != "kw" || t.value != "fn" {
            i = i + 1
            continue
        }
        let mut j: int = i + 1
        let mut body: int = -1
        while j < n {
            let tj: LTok = toks.get(j)
            if tj.kind == "sym" && tj.value == "{" {
                if ls_brace_has(braces, j) {
                    body = ls_brace_get(braces, j)
                }
                break
            }
            if tj.kind == "kw" && tj.value != "uses" && tj.value != "pure"
            && tj.value != "extern" {
                break
            }
            j = j + 1
        }
        if body >= 0 {
            spans.push([i, body + 1])
        }
        i = i + 1
    }
    return spans
}

# ls_decl_regions — [start, end) spans of every `kw ... { ... }` region
# (struct and impl bodies, per the kw asked for).
fn ls_decl_regions(toks: list[LTok], braces: BraceMap, kw: str)
-> list[list[int]] {
    let regions: list[list[int]] = []
    let n: int = toks.len()
    let mut i: int = 0
    while i < n {
        let t: LTok = toks.get(i)
        if t.kind != "kw" || t.value != kw {
            i = i + 1
            continue
        }
        let mut j: int = i + 1
        while j < n {
            let tj: LTok = toks.get(j)
            if tj.kind == "sym" && tj.value == "{" {
                if ls_brace_has(braces, j) {
                    regions.push([i, ls_brace_get(braces, j) + 1])
                }
                break
            }
            if tj.kind == "kw" {
                break
            }
            j = j + 1
        }
        i = i + 1
    }
    return regions
}

# ls_enclosing_span — the first span containing idx, or -1 (the span
# index; spans live in a list, list.get is the read).
fn ls_enclosing_span(spans: list[list[int]], idx: int) -> int {
    let mut i: int = 0
    while i < spans.len() {
        if spans.get(i).get(0) <= idx && idx < spans.get(i).get(1) {
            return i
        }
        i = i + 1
    }
    return -1
}

# ---- the parser sub-children (a panic IS the refusal) ----

# rf_parse_stmts — token indices [start, end) re-lexed from text and
# parsed statement by statement; the consumed count of each statement
# is returned (one entry per statement; [] = the first parse failed —
# caller refuses). The child is this very binary with --rf-slice.
fn rf_parse_stmts(text: str) -> list[int] uses Proc, Args, Fs {
    ls_scratch_write(text)
    let r: RunRes = ls_run_child([ls_self(), "--rf-slice",
    ls_scratch_path()])
    if r.code != 0 {
        return []
    }
    let out: list[int] = []
    let lines: list[str] = r.out.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        if ls_starts(lines.get(i), "RFSTMT ") {
            out.push(ls_atoi(lines.get(i).slice(7,
            lines.get(i).len())))
        }
        i = i + 1
    }
    return out
}

# rf_expr_extends — the number of tokens parse_expr consumes from the
# re-lexed text, 0 when it fails or leaves tokens behind (the eof
# marker counts; exactly one expression, all of it).
fn rf_expr_extends(text: str) -> int uses IO, Proc, Args, Fs {
    ls_scratch_write(text)
    let r: RunRes = ls_run_child([ls_self(), "--rf-expr",
    ls_scratch_path()])
    if r.code != 0 {
        return 0
    }
    if !ls_starts(r.out, "RFEXPR ") {
        return 0
    }
    return ls_atoi(r.out.slice(7, r.out.len()))
}

# rf_stmt_extends — same, for one statement.
fn rf_stmt_extends(text: str) -> int uses Proc, Args, Fs {
    ls_scratch_write(text)
    let r: RunRes = ls_run_child([ls_self(), "--rf-stmt",
    ls_scratch_path()])
    if r.code != 0 {
        return 0
    }
    if !ls_starts(r.out, "RFSTMT ") {
        return 0
    }
    return ls_atoi(r.out.slice(7, r.out.len()))
}

# rf_text_checks — parse + check a whole document (the probe).
fn rf_text_checks(text: str) -> bool uses Proc, Args, Fs {
    ls_scratch_write(text)
    let r: RunRes = ls_run_child([ls_self(), "--probe-file",
    ls_scratch_path()])
    return r.code == 0
}

# ---- byte edits (the .py's edit plumbing, byte-true) ----

# ByteEdit — [a, b) bytes replaced by new_text; non-overlapping by
# construction, applied bottom-up.
struct ByteEdit {
    a: int,
    b: int,
    new_text: str
}

# rf_apply_edits — apply byte edits bottom-up (reverse-sorted by a).
fn rf_apply_edits(text: str, edits: list[ByteEdit]) -> str {
    # insertion sort by a, descending — only pointer slots move.
    let mut i: int = 1
    while i < edits.len() {
        let it: ByteEdit = edits.get(i)
        let mut j: int = i - 1
        let mut pos: int = i
        while j >= 0 && edits.get(j).a < it.a {
            edits.set(j + 1, edits.get(j))
            pos = j
            j = j - 1
        }
        edits.set(pos, it)
        i = i + 1
    }
    let mut out: str = text
    # sorted descending, so apply from index 0 (the LARGEST a) down —
    # bottom-up: an edit at a larger offset never shifts one below it.
    # (the loop used to run from the tail, applying the SMALLEST a
    # first, and every later edit landed shifted by the splice before
    # it — an inline's use-site replacements landed mid-identifier.)
    let mut k: int = 0
    while k < edits.len() {
        let e: ByteEdit = edits.get(k)
        out = out.slice(0, e.a) + e.new_text + out.slice(e.b, out.len())
        k = k + 1
    }
    return out
}

# rf_edits_to_lsp — byte triples -> LSP TextEdits (line + utf-16 col).
fn rf_edits_to_lsp(d: DocRec, edits: list[ByteEdit]) -> list[JsonValue] {
    let out: list[JsonValue] = []
    let mut i: int = 0
    while i < edits.len() {
        let e: ByteEdit = edits.get(i)
        let l0: int = ls_line_of(d.offs, e.a)
        let c0: int = ls_utf16_of_byte_col(d.text, d.offs, l0,
        e.a - d.offs.get(l0))
        let l1: int = ls_line_of(d.offs, e.b)
        let c1: int = ls_utf16_of_byte_col(d.text, d.offs, l1,
        e.b - d.offs.get(l1))
        out.push(json_object(["range", "newText"],
        [ls_range_json(l0, c0, l1, c1), json_str(e.new_text)]))
        i = i + 1
    }
    return out
}

# ---- the local declaration engine (the .py's _collect_local_decls) ----

# LocalDecl — one local binding with the exact token window the name
# stays bound in.
struct LocalDecl {
    name: str,
    kind: str, # let | for | param | bind
    tok: int,
    start: int,
    end: int
}

# ls_arm_bindings — [(name_tok, bind_start, bind_end)] for every match
# pattern binding: the paren group walked BACKWARD from each `=>`; the
# binding holds from the arrow to the next `,` or `}` at its own depth.
fn ls_arm_bindings(toks: list[LTok], depths: list[int])
-> list[list[int]] {
    let out: list[list[int]] = []
    let n: int = toks.len()
    let mut i: int = 0
    while i < n {
        let t: LTok = toks.get(i)
        if t.kind != "sym" || t.value != "=>" {
            i = i + 1
            continue
        }
        if i == 0 || toks.get(i - 1).value != ")" {
            i = i + 1
            continue
        }
        let binds: list[int] = []
        let mut j: int = i - 1
        let mut depth: int = 0
        while j >= 0 {
            let tj: LTok = toks.get(j)
            if tj.kind == "sym" {
                if ls_is_close_sym(tj.value) {
                    depth = depth + 1
                } else if ls_is_open_sym(tj.value) {
                    depth = depth - 1
                    if depth == 0 {
                        break
                    }
                }
            } else if tj.kind == "ident" && depth == 1
            && tj.value != "_" {
                binds.push(j)
            }
            j = j - 1
        }
        let d0: int = depths.get(i)
        let mut end: int = n
        let mut k: int = i + 1
        while k < n {
            let dk: int = depths.get(k)
            let tk: LTok = toks.get(k)
            if dk < d0 {
                end = k
                break
            }
            if dk == d0 && tk.kind == "sym"
            && (tk.value == "," || tk.value == "}") {
                end = k
                break
            }
            k = k + 1
        }
        let mut b: int = 0
        while b < binds.len() {
            out.push([binds.get(b), i + 1, end])
            b = b + 1
        }
        i = i + 1
    }
    return out
}

# ls_collect_local_decls — every local binding inside the fn window
# [lo, hi): lets, params, for vars, match-arm payload bindings. Each
# carries its exact token window, so resolution is scope-precise.
fn ls_collect_local_decls(toks: list[LTok], lo: int, hi: int,
braces: BraceMap, depths: list[int]) -> list[LocalDecl] {
    let decls: list[LocalDecl] = []
    # Match-arm payload bindings first — exact ranges, no scan needed.
    let arms: list[list[int]] = ls_arm_bindings(toks, depths)
    let mut ai: int = 0
    while ai < arms.len() {
        let a: list[int] = arms.get(ai)
        if lo <= a.get(0) && a.get(0) < hi {
            decls.push(LocalDecl {
                name: toks.get(a.get(0)).value, kind: "bind",
                tok: a.get(0), start: a.get(0), end: a.get(2)
            })
        }
        ai = ai + 1
    }
    let scope: list[int] = []
    let mut pending_names: list[str] = []
    let mut pending_toks: list[int] = []
    let mut pending_kinds: list[str] = []
    let mut i: int = lo
    while i < hi {
        let t: LTok = toks.get(i)
        let k: str = t.kind
        let v: str = t.value
        if k == "sym" && v == "{" {
            scope.push(i)
            if ls_brace_has(braces, i) {
                let close: int = ls_brace_get(braces, i)
                let mut p: int = 0
                while p < pending_names.len() {
                    decls.push(LocalDecl {
                        name: pending_names.get(p),
                        kind: pending_kinds.get(p),
                        tok: pending_toks.get(p),
                        start: pending_toks.get(p),
                        end: close + 1
                    })
                    p = p + 1
                }
                pending_names = []
                pending_toks = []
                pending_kinds = []
            }
        } else if k == "sym" && v == "}" {
            if scope.len() > 0 {
                let _d: int = scope.pop()
            }
        } else if k == "kw" && v == "let" {
            let mut j: int = i + 1
            if j < hi && toks.get(j).kind == "kw"
            && toks.get(j).value == "mut" {
                j = j + 1
            }
            if j < hi && toks.get(j).kind == "ident" {
                let mut end: int = hi
                if scope.len() > 0 {
                    let c: int = ls_brace_get(braces, scope.get(scope.len() - 1))
                    if c >= 0 {
                        end = c + 1
                    }
                }
                decls.push(LocalDecl {
                    name: toks.get(j).value, kind: "let", tok: j,
                    start: j, end: end
                })
                i = j
            }
        } else if k == "kw" && v == "for" {
            let j2: int = i + 1
            if j2 < hi && toks.get(j2).kind == "ident" {
                pending_names.push(toks.get(j2).value)
                pending_toks.push(j2)
                pending_kinds.push("for")
                i = j2
            }
        } else if k == "kw" && v == "fn" && i == lo {
            # the window's own fn — its parameters bind in the body
            let mut j3: int = i + 1
            if j3 < hi && toks.get(j3).kind == "ident" {
                j3 = j3 + 1
            }
            if j3 < hi && toks.get(j3).kind == "sym"
            && toks.get(j3).value == "(" {
                let mut pd: int = 0
                while j3 < hi {
                    let tj: LTok = toks.get(j3)
                    if tj.kind == "sym" {
                        if ls_is_open_sym(tj.value) {
                            pd = pd + 1
                        } else if ls_is_close_sym(tj.value) {
                            pd = pd - 1
                            if pd == 0 {
                                break
                            }
                        }
                    } else if tj.kind == "ident" && pd == 1
                    && j3 + 1 < hi && toks.get(j3 + 1).kind == "sym"
                    && toks.get(j3 + 1).value == ":" {
                        pending_names.push(tj.value)
                        pending_toks.push(j3)
                        pending_kinds.push("param")
                    }
                    j3 = j3 + 1
                }
            }
        }
        i = i + 1
    }
    return decls
}

# ls_resolve_local — the innermost declaration of `name` covering idx.
fn ls_resolve_local(decls: list[LocalDecl], idx: int, name: str)
-> int {
    let mut best: int = -1
    let mut i: int = 0
    while i < decls.len() {
        let d: LocalDecl = decls.get(i)
        if d.name == name && d.start <= idx && idx < d.end {
            if best < 0 || d.start > decls.get(best).start {
                best = i
            }
        }
        i = i + 1
    }
    return best
}

# ls_scope_taken_names — names a new local binding must avoid.
fn ls_scope_taken_names(d: DocRec, lo: int, hi: int) -> list[str] {
    let taken: list[str] = []
    let mut i: int = 0
    while i < ls_keywords().len() {
        ls_push_unique(taken, ls_keywords().get(i))
        i = i + 1
    }
    i = 0
    while i < ls_builtins().len() {
        ls_push_unique(taken, ls_builtins().get(i))
        i = i + 1
    }
    i = 0
    while i < ls_effects().len() {
        ls_push_unique(taken, ls_effects().get(i))
        i = i + 1
    }
    # the program's top-level symbols (methods by short name)
    let mut fi: int = 0
    while fi < d.syms.fns.len() {
        let key: str = d.syms.fns.get(fi).key
        ls_push_unique(taken, key)
        if key.contains(".") {
            ls_push_unique(taken, ls_after_last_sep(key, "."))
        }
        fi = fi + 1
    }
    let mut si: int = 0
    while si < d.syms.structs.len() {
        ls_push_unique(taken, d.syms.structs.get(si).name)
        si = si + 1
    }
    let mut ei: int = 0
    while ei < d.syms.enums.len() {
        ls_push_unique(taken, d.syms.enums.get(ei).name)
        ei = ei + 1
    }
    # every identifier in the window
    let mut j: int = lo
    while j < hi && j < d.toks.len() {
        if d.toks.get(j).kind == "ident" {
            ls_push_unique(taken, d.toks.get(j).value)
        }
        j = j + 1
    }
    return taken
}

# ls_taken_has — membership (list, not set — the tool has no set).
fn ls_taken_has(taken: list[str], s: str) -> bool {
    let mut i: int = 0
    while i < taken.len() {
        if taken.get(i) == s {
            return true
        }
        i = i + 1
    }
    return false
}

# ls_fresh_name — base, or base2, base3... — the first free one.
fn ls_fresh_name(base: str, taken: list[str]) -> str {
    if !ls_taken_has(taken, base) {
        return base
    }
    let mut n: int = 2
    while ls_taken_has(taken, base + n.to_str()) {
        n = n + 1
    }
    return base + n.to_str()
}

# ---- the rename classifier ----

# ls_classify_dot_name — "" | "field" | "method" | "variant" for a
# name reachable through a dot: the cursor sits on a `.name` access or
# a field declaration inside a struct body. A name that is BOTH a
# field and a method (or also a variant) classifies "" — a wrong
# rewrite is worse than a refused one.
fn ls_classify_dot_name(d: DocRec, idx: int, name: str,
docs: list[DocRec]) -> str {
    let toks: list[LTok] = d.toks
    let on_site: bool = idx > 0 && toks.get(idx - 1).kind == "sym"
    && toks.get(idx - 1).value == "."
    let mut on_decl: bool = false
    if !on_site {
        let braces: BraceMap = ls_brace_matches(toks)
        let regions: list[list[int]] = ls_decl_regions(toks, braces,
        "struct")
        let mut ri: int = 0
        while ri < regions.len() {
            let r: list[int] = regions.get(ri)
            if r.get(0) < idx && idx < r.get(1) && idx + 1 < toks.len() {
                if toks.get(idx + 1).kind == "sym"
                && toks.get(idx + 1).value == ":" {
                    on_decl = true
                }
            }
            ri = ri + 1
        }
    }
    if !on_site && !on_decl {
        return ""
    }
    let mut is_field: bool = false
    let mut is_method: bool = false
    let mut is_variant: bool = false
    let mut di: int = 0
    while di < docs.len() {
        let syms: Syms = docs.get(di).syms
        let mut si: int = 0
        while si < syms.structs.len() {
            let mut fi: int = 0
            while fi < syms.structs.get(si).fields.len() {
                if syms.structs.get(si).fields.get(fi) == name {
                    is_field = true
                }
                fi = fi + 1
            }
            si = si + 1
        }
        let mut ei: int = 0
        while ei < syms.enums.len() {
            let mut vi: int = 0
            while vi < syms.enums.get(ei).variants.len() {
                if syms.enums.get(ei).variants.get(vi) == name {
                    is_variant = true
                }
                vi = vi + 1
            }
            ei = ei + 1
        }
        let mut fj: int = 0
        while fj < syms.fns.len() {
            if ls_ends(syms.fns.get(fj).key, "." + name) {
                is_method = true
            }
            fj = fj + 1
        }
        di = di + 1
    }
    let mut count: int = 0
    if is_field {
        count = count + 1
    }
    if is_method {
        count = count + 1
    }
    if is_variant {
        count = count + 1
    }
    if count > 1 {
        return ""
    }
    if is_field {
        return "field"
    }
    if is_method {
        return "method"
    }
    return ""
}

# ls_structlit_key_at — token i is a struct-literal KEY: an identifier
# followed by `:` at the first field depth of a `{...}` group whose
# opener is preceded by the struct's name. Match arms use `=>`, map
# keys are strings — neither can masquerade here.
fn ls_structlit_key_at(toks: list[LTok], depths: list[int], i: int)
-> bool {
    if i + 1 >= toks.len() || toks.get(i).kind != "ident" {
        return false
    }
    let nxt: LTok = toks.get(i + 1)
    if nxt.kind != "sym" || nxt.value != ":" {
        return false
    }
    let d: int = depths.get(i)
    let mut j: int = i
    while j >= 0 {
        let tj: LTok = toks.get(j)
        if tj.kind == "sym" && tj.value == "{" && depths.get(j) == d - 1 {
            return j > 0 && toks.get(j - 1).kind == "ident"
        }
        j = j - 1
    }
    return false
}

# ---- rename: the three engines ----

# ls_handle_rename — scope-aware rename. LOCAL renames exactly the
# occurrences the declaration binds; FIELD/METHOD renames the
# declaration plus `.name` sites across open documents; everything
# else keeps the Stage 14 textual contract. Returns the WorkspaceEdit
# result, or json_null() AFTER sending its own error reply (the
# dispatch must not double-send — a null return means "already
# answered").
fn ls_handle_rename(st: LsState, params: JsonValue, idv: JsonValue)
-> JsonValue uses IO, Proc, Fs, Args {
    let td: JsonValue = ls_jget(params, "textDocument")
    let uri: str = ls_jstr(td, "uri")
    let pos: JsonValue = ls_jget(params, "position")
    let new_name: str = ls_jstr(params, "newName")
    # Validate the new name — a legal identifier, never a keyword.
    if new_name == "" {
        ls_send_error(idv, -32602,
        "invalid newName: must start with a letter or _")
        return json_null()
    }
    let c0: int = new_name.byte_at(0)
    if !((c0 >= 97 && c0 <= 122) || (c0 >= 65 && c0 <= 90)
    || c0 == 95) {
        ls_send_error(idv, -32602,
        "invalid newName: must start with a letter or _")
        return json_null()
    }
    let mut ci: int = 0
    while ci < new_name.len() {
        let c: int = new_name.byte_at(ci)
        if !((c >= 97 && c <= 122) || (c >= 65 && c <= 90)
        || (c >= 48 && c <= 57) || c == 95) {
            ls_send_error(idv, -32602,
            "invalid newName: only [A-Za-z0-9_] allowed")
            return json_null()
        }
        ci = ci + 1
    }
    if ls_taken_has(ls_keywords(), new_name) {
        ls_send_error(idv, -32602,
        "invalid newName: " + new_name + " is a keyword")
        return json_null()
    }
    let di: int = ls_find_doc(st, uri)
    if di < 0 {
        return json_object(["changes"], [json_object([], [])])
    }
    let d: DocRec = st.docs.get(di)
    if d.parse_err || d.dead {
        return json_object(["changes"], [json_object([], [])])
    }
    let line0: int = ls_jint(pos, "line")
    let char16: int = ls_jint(pos, "character")
    let col_byte: int = ls_byte_of_utf16_col(d.text, d.offs, line0,
    char16)
    let off: int = ls_linecol_to_off(d.offs, line0, col_byte)
    let idx: int = ls_token_index_at(d.toks, off)
    if idx < 0 {
        return json_object(["changes"], [json_object([], [])])
    }
    let tok: LTok = d.toks.get(idx)
    if tok.kind != "ident" && tok.kind != "kw" {
        return json_object(["changes"], [json_object([], [])])
    }
    let name: str = tok.value
    if ls_taken_has(ls_keywords(), name)
    || ls_taken_has(ls_builtins(), name)
    || ls_taken_has(ls_effects(), name) {
        ls_send_error(idv, -32602,
        "cannot rename keyword/builtin/effect: " + name)
        return json_null()
    }
    # 1. LOCAL — the scope engine.
    let braces: BraceMap = ls_brace_matches(d.toks)
    let depths: list[int] = ls_tok_depths(d.toks)
    let spans: list[list[int]] = ls_fn_spans(d.toks, braces)
    let span_i: int = ls_enclosing_span(spans, idx)
    if span_i >= 0 {
        let span: list[int] = spans.get(span_i)
        let lo: int = span.get(0)
        let hi: int = span.get(1)
        let decls: list[LocalDecl] = ls_collect_local_decls(d.toks,
        lo, hi, braces, depths)
        let decl_i: int = ls_resolve_local(decls, idx, name)
        if decl_i >= 0 {
            return rf_rename_local(st, idv, di, decls, decl_i,
            new_name, lo, hi)
        }
        # 2. FIELD / METHOD — reachable only through a dot.
        let docs: list[DocRec] = []
        let mut dj: int = 0
        while dj < st.docs.len() {
            if !st.docs.get(dj).dead {
                docs.push(st.docs.get(dj))
            }
            dj = dj + 1
        }
        let mode: str = ls_classify_dot_name(d, idx, name, docs)
        if mode == "field" || mode == "method" {
            return rf_rename_dotted(st, idv, name, new_name, mode)
        }
    }
    # 3. GLOBAL — the Stage 14 textual contract.
    let changes_keys: list[str] = []
    let changes_vals: list[JsonValue] = []
    let mut ui: int = 0
    while ui < st.docs.len() {
        let u: DocRec = st.docs.get(ui)
        if u.dead {
            ui = ui + 1
            continue
        }
        let locs: list[JsonValue] = []
        ls_refs_in_text(locs, u.uri, u.text, u.offs, u.toks, name)
        if locs.len() > 0 {
            let edits: list[JsonValue] = []
            let mut li: int = 0
            while li < locs.len() {
                edits.push(json_object(["range", "newText"],
                [json_object_get(locs.get(li), "range"),
                json_str(new_name)]))
                li = li + 1
            }
            changes_keys.push(u.uri)
            changes_vals.push(json_array(edits))
        }
        ui = ui + 1
    }
    return json_object(["changes"],
    [json_object(changes_keys, changes_vals)])
}

# rf_rename_local — rename one local binding precisely: every token
# the declaration binds, nothing else. The new name must be free in
# scope, and the finished file must still check when the original did.
fn rf_rename_local(st: LsState, idv: JsonValue, di: int,
decls: list[LocalDecl], decl_i: int, new_name: str, lo: int, hi: int)
-> JsonValue uses IO, Proc, Args {
    let d: DocRec = st.docs.get(di)
    let decl: LocalDecl = decls.get(decl_i)
    let taken: list[str] = ls_scope_taken_names(d, lo, hi)
    if ls_taken_has(taken, new_name) {
        ls_send_error(idv, -32602,
        "name already in use in this scope: " + new_name)
        return json_null()
    }
    let edits: list[ByteEdit] = []
    let mut i: int = lo
    while i < hi && i < d.toks.len() {
        let t: LTok = d.toks.get(i)
        if t.kind != "ident" || t.value != decl.name {
            i = i + 1
            continue
        }
        if i + 1 < d.toks.len() && d.toks.get(i + 1).kind == "sym"
        && d.toks.get(i + 1).value == "(" {
            i = i + 1
            continue
        }
        if ls_resolve_local(decls, i, decl.name) != decl_i {
            i = i + 1
            continue
        }
        edits.push(ByteEdit { a: t.off, b: t.off + t.len,
        new_text: new_name })
        i = i + 1
    }
    if edits.len() == 0 {
        return json_object(["changes"], [json_object([], [])])
    }
    # Re-check: only when the original file was clean.
    if rf_text_checks(d.text) {
        if !rf_text_checks(rf_apply_edits(d.text, edits)) {
            ls_send_error(idv, -32602,
            "rename refused: the result does not check")
            return json_null()
        }
    }
    return json_object(["changes"], [json_object([d.uri],
    [json_array(rf_edits_to_lsp(d, edits))])])
}

# rf_rename_dotted — field / method rename across open documents.
fn rf_rename_dotted(st: LsState, idv: JsonValue, name: str,
new_name: str, mode: str) -> JsonValue uses IO, Proc, Args {
    # Collision law: a field may not rename into a sibling field of a
    # struct that already has both; a method likewise per impl.
    let mut di: int = 0
    while di < st.docs.len() {
        let u: DocRec = st.docs.get(di)
        if u.dead {
            di = di + 1
            continue
        }
        if mode == "field" {
            let mut si: int = 0
            while si < u.syms.structs.len() {
                let st2: SymStruct = u.syms.structs.get(si)
                let has_old: bool = ls_taken_has(st2.fields, name)
                let has_new: bool = ls_taken_has(st2.fields, new_name)
                if has_old && has_new {
                    ls_send_error(idv, -32602,
                    "field " + new_name + " already exists in struct "
                    + st2.name)
                    return json_null()
                }
                si = si + 1
            }
        } else {
            let mut fi: int = 0
            while fi < u.syms.fns.len() {
                let key: str = u.syms.fns.get(fi).key
                if ls_ends(key, "." + name) {
                    let owner: str = key.slice(0,
                    key.len() - name.len() - 1)
                    let cand: str = owner + "." + new_name
                    let mut fj: int = 0
                    while fj < u.syms.fns.len() {
                        if u.syms.fns.get(fj).key == cand {
                            ls_send_error(idv, -32602,
                            "method " + new_name
                            + " already exists in impl " + owner)
                            return json_null()
                        }
                        fj = fj + 1
                    }
                }
                fi = fi + 1
            }
        }
        di = di + 1
    }
    let changes_keys: list[str] = []
    let changes_vals: list[JsonValue] = []
    di = 0
    while di < st.docs.len() {
        let u: DocRec = st.docs.get(di)
        if u.dead {
            di = di + 1
            continue
        }
        let braces: BraceMap = ls_brace_matches(u.toks)
        let depths: list[int] = ls_tok_depths(u.toks)
        let sregions: list[list[int]] = ls_decl_regions(u.toks, braces,
        "struct")
        let iregions: list[list[int]] = ls_decl_regions(u.toks, braces,
        "impl")
        let edits: list[ByteEdit] = []
        let mut i: int = 0
        while i < u.toks.len() {
            let t: LTok = u.toks.get(i)
            if t.kind != "ident" || t.value != name {
                i = i + 1
                continue
            }
            let mut hit: bool = false
            if mode == "field" {
                if i > 0 && u.toks.get(i - 1).kind == "sym"
                && u.toks.get(i - 1).value == "." {
                    hit = true
                }
                if !hit && i + 1 < u.toks.len()
                && u.toks.get(i + 1).kind == "sym"
                && u.toks.get(i + 1).value == ":" {
                    let mut ri: int = 0
                    while ri < sregions.len() {
                        let r: list[int] = sregions.get(ri)
                        if r.get(0) < i && i < r.get(1) {
                            hit = true
                        }
                        ri = ri + 1
                    }
                    if !hit {
                        hit = ls_structlit_key_at(u.toks, depths, i)
                    }
                }
            } else {
                if i > 0 && u.toks.get(i - 1).kind == "sym"
                && u.toks.get(i - 1).value == "." {
                    hit = true
                }
                if !hit && i > 0 && u.toks.get(i - 1).kind == "kw"
                && u.toks.get(i - 1).value == "fn" {
                    let mut ri2: int = 0
                    while ri2 < iregions.len() {
                        let r2: list[int] = iregions.get(ri2)
                        if r2.get(0) < i && i < r2.get(1) {
                            hit = true
                        }
                        ri2 = ri2 + 1
                    }
                }
            }
            if hit {
                edits.push(ByteEdit { a: t.off, b: t.off + t.len,
                new_text: new_name })
            }
            i = i + 1
        }
        if edits.len() > 0 {
            changes_keys.push(u.uri)
            changes_vals.push(json_array(rf_edits_to_lsp(u, edits)))
        }
        di = di + 1
    }
    return json_object(["changes"],
    [json_object(changes_keys, changes_vals)])
}

# ---- codeAction: the extract / inline planners ----

# ls_selection_window — the selection as a token window [i0, i1]
# (inclusive), or -1s when it does not resolve. A collapsed cursor on
# an identifier extends to the whole call when `(` follows — `f(a, b)`
# extracts whole, because that is what "extract this" means at a call.
fn ls_selection_window(d: DocRec, braces: BraceMap, rng: JsonValue)
-> list[int] {
    let offs: list[int] = d.offs
    let start: JsonValue = ls_jget(rng, "start")
    let end: JsonValue = ls_jget(rng, "end")
    let sl: int = ls_jint(start, "line")
    let el: int = ls_jint(end, "line")
    let sc: int = ls_jint(start, "character")
    let ec: int = ls_jint(end, "character")
    if sl > el || (sl == el && sc > ec) {
        return [-1, -1]
    }
    let a: int = ls_linecol_to_off(offs, sl,
    ls_byte_of_utf16_col(d.text, offs, sl, sc))
    let b: int = ls_linecol_to_off(offs, el,
    ls_byte_of_utf16_col(d.text, offs, el, ec))
    let mut i0: int = -1
    let mut i1: int = -1
    let mut i: int = 0
    while i < d.toks.len() {
        let t: LTok = d.toks.get(i)
        if i0 < 0 && t.off + t.len > a {
            i0 = i
        }
        if t.off < b || (t.off == b && b == a) {
            i1 = i
        }
        i = i + 1
    }
    if i0 < 0 || i1 < 0 || i1 < i0 {
        return [-1, -1]
    }
    # a collapsed cursor on an identifier followed by `(` — the whole
    # call
    if i0 == i1 && d.toks.get(i0).kind == "ident" && i0 + 1 < d.toks.len()
    && d.toks.get(i0 + 1).kind == "sym"
    && d.toks.get(i0 + 1).value == "(" {
        let close: int = ls_brace_get(braces, i0 + 1)
        if close > i0 {
            i1 = close
        }
    }
    return [i0, i1]
}

# ls_stmt_spans — every statement span inside the fn body [lo, hi),
# innermost included. The body's statement list is walked with the
# parser sub-child (one statement at a time — its consumption is the
# statement's true extent), and every nested `{...}` group of a block
# statement is walked in turn. Braces the grammar does not make
# statements of — match arms, struct-literal field lists — fail the
# parse and are skipped: exactly the places a `let` cannot go anyway.
fn ls_stmt_spans(d: DocRec, braces: BraceMap, lo: int, hi: int)
-> list[list[int]] uses Proc, Args, Fs {
    # the body's open brace: the one whose close is hi - 1
    let mut body_open: int = -1
    let mut i: int = 0
    while i < braces.opens.len() {
        if braces.closes.get(i) == hi - 1 && braces.opens.get(i) >= lo {
            body_open = braces.opens.get(i)
        }
        i = i + 1
    }
    if body_open < 0 {
        return []
    }
    let out: list[list[int]] = []
    ls_walk_stmts(d, braces, body_open + 1, hi - 1, out)
    return out
}

# ls_walk_stmts — the recursive walk: parse one statement at a time
# from pos (one parser sub-child per statement text); a failed parse
# stops the walk (the caller's spans end there — exactly the .py's
# "return" on the first exception).
fn ls_walk_stmts(d: DocRec, braces: BraceMap, start: int, end: int,
out: list[list[int]]) -> void uses Proc, Args, Fs {
    let mut pos: int = start
    let mut guard: int = 0
    while pos < end && guard < 100000 {
        guard = guard + 1
        # the statement's token text, parsed by the sub-child
        let text: str = ls_slice_text(d.text, d.toks, pos, end)
        let consumed: int = rf_stmt_extends(text)
        if consumed <= 0 {
            return
        }
        out.push([pos, pos + consumed])
        # recurse into the statement's nested brace groups
        let mut k: int = pos
        while k < pos + consumed {
            if d.toks.get(k).kind == "sym" && d.toks.get(k).value == "{" {
                let c: int = ls_brace_get(braces, k)
                if c > k {
                    ls_walk_stmts(d, braces, k + 1, c, out)
                    k = c + 1
                } else {
                    k = k + 1
                }
            } else {
                k = k + 1
            }
        }
        pos = pos + consumed
    }
}

# ls_slice_text — the source bytes of tokens [a, b) (b exclusive, an
# eof-safe cap at end).
fn ls_slice_text(text: str, toks: list[LTok], a: int, b: int) -> str {
    if a >= b || a >= toks.len() {
        return ""
    }
    let start: int = toks.get(a).off
    let mut last: int = b - 1
    if last >= toks.len() {
        last = toks.len() - 1
    }
    let endb: int = toks.get(last).off + toks.get(last).len
    return text.slice(start, endb)
}

# ls_assign_target_toks — token indices that are part of an assignment
# TARGET somewhere in [lo, hi): for every statement span, the `=` at
# the statement's own depth is the assignment's operator, and
# everything between the statement's start and that `=` is the target
# chain. A let's `=` introduces its initializer, not a target.
fn ls_assign_target_toks(d: DocRec, braces: BraceMap,
depths: list[int], spans: list[list[int]], lo: int, hi: int)
-> list[int] {
    let out: list[int] = []
    let mut si: int = 0
    while si < spans.len() {
        let s: list[int] = spans.get(si)
        let s0: int = s.get(0)
        let e0: int = s.get(1)
        if d.toks.get(s0).kind == "kw" {
            si = si + 1
            continue
        }
        let base_d: int = depths.get(s0)
        let mut j: int = s0
        let mut q: int = -1
        while j < e0 {
            if depths.get(j) < base_d {
                break
            }
            if depths.get(j) == base_d && d.toks.get(j).kind == "sym"
            && d.toks.get(j).value == "=" {
                q = j
                break
            }
            j = j + 1
        }
        if q >= 0 {
            let mut kk: int = s0
            while kk < q {
                out.push(kk)
                kk = kk + 1
            }
        }
        si = si + 1
    }
    return out
}

# ls_targets_has — membership.
fn ls_targets_has(targets: list[int], j: int) -> bool {
    let mut i: int = 0
    while i < targets.len() {
        if targets.get(i) == j {
            return true
        }
        i = i + 1
    }
    return false
}

# ls_extract_candidates — the type candidates a probe may try,
# cheapest first: primitives, the document's own struct/enum names,
# the builtin generic wrappers over primitives, then arity-1 generics
# of the document's own types over primitives. Capped at 64.
fn ls_extract_candidates(d: DocRec) -> list[str] {
    let cands: list[str] = ["int", "float", "bool", "str"]
    let own: list[str] = []
    let mut si: int = 0
    while si < d.syms.structs.len() {
        ls_push_unique(own, d.syms.structs.get(si).name)
        si = si + 1
    }
    let mut ei: int = 0
    while ei < d.syms.enums.len() {
        ls_push_unique(own, d.syms.enums.get(ei).name)
        ei = ei + 1
    }
    let mut oi: int = 0
    while oi < own.len() {
        ls_push_unique(cands, own.get(oi))
        oi = oi + 1
    }
    let atoms: list[str] = ["int", "float", "bool", "str"]
    let mut ai: int = 0
    while ai < atoms.len() {
        let a: str = atoms.get(ai)
        ls_push_unique(cands, "list[" + a + "]")
        ls_push_unique(cands, "map[str, " + a + "]")
        ls_push_unique(cands, "Chan[" + a + "]")
        ls_push_unique(cands, "tainted[" + a + "]")
        ai = ai + 1
    }
    # arity-1 generics of the document's own types (the probe carries
    # no typeparam counts — a 1-arity guess that fails the check is
    # exactly the refusal the probe needs)
    oi = 0
    while oi < own.len() {
        ai = 0
        while ai < atoms.len() {
            ls_push_unique(cands, own.get(oi) + "[" + atoms.get(ai) + "]")
            ai = ai + 1
        }
        oi = oi + 1
    }
    if cands.len() > 64 {
        let cut: list[str] = []
        let mut ci: int = 0
        while ci < 64 {
            cut.push(cands.get(ci))
            ci = ci + 1
        }
        return cut
    }
    return cands
}

# PlanRes — a planner's verdict: ok with the edits + the name, or the
# refusal (ok=false).
struct PlanRes {
    ok: bool,
    edits: list[ByteEdit],
    name: str
}

# rf_plan_inline — the inline-variable plan. The cursor may sit on the
# binding's name, on the `let` keyword, or on any use the declaration
# binds. Guards: a reassigned binding, an assignment through a use, an
# initializer naming a reassigned local, a call-bearing initializer
# with two or more uses. The finished text is re-checked.
fn rf_plan_inline(d: DocRec, braces: BraceMap, depths: list[int],
spans: list[list[int]], idx: int) -> PlanRes uses IO, Proc, Args, Fs {
    let fail: PlanRes = PlanRes { ok: false, edits: [], name: "" }
    if idx < 0 {
        return fail
    }
    let mut tok: LTok = d.toks.get(idx)
    let mut idx2: int = idx
    # cursor on the `let` keyword — hop to the binding name
    if tok.kind == "kw" && tok.value == "let" {
        let mut j: int = idx2 + 1
        if j < d.toks.len() && d.toks.get(j).kind == "kw"
        && d.toks.get(j).value == "mut" {
            j = j + 1
        }
        if j < d.toks.len() && d.toks.get(j).kind == "ident" {
            idx2 = j
            tok = d.toks.get(j)
        } else {
            return fail
        }
    }
    if tok.kind != "ident" {
        return fail
    }
    let span_i: int = ls_enclosing_span(spans, idx2)
    if span_i < 0 {
        return fail
    }
    let lo: int = spans.get(span_i).get(0)
    let hi: int = spans.get(span_i).get(1)
    let decls: list[LocalDecl] = ls_collect_local_decls(d.toks, lo, hi,
    braces, depths)
    let decl_i: int = ls_resolve_local(decls, idx2, tok.value)
    if decl_i < 0 || decls.get(decl_i).kind != "let" {
        return fail
    }
    let decl: LocalDecl = decls.get(decl_i)
    # the let's own tokens: `let [mut]? name : type = init`
    let mut start_idx: int = decl.tok - 1
    if start_idx >= lo && d.toks.get(start_idx).kind == "kw"
    && d.toks.get(start_idx).value == "mut" {
        start_idx = start_idx - 1
    }
    if start_idx < lo || d.toks.get(start_idx).kind != "kw"
    || d.toks.get(start_idx).value != "let" {
        return fail
    }
    # a `#[stack]` / `#[boxed]` list in front of the let belongs to it
    let mut guard: int = 0
    while start_idx - 1 >= lo && d.toks.get(start_idx - 1).kind == "sym"
    && d.toks.get(start_idx - 1).value == "]" && guard < 100 {
        guard = guard + 1
        let mut k: int = start_idx - 1
        let mut dd: int = 0
        while k >= lo {
            let tk: LTok = d.toks.get(k)
            if tk.kind == "sym" {
                if ls_is_close_sym(tk.value) {
                    dd = dd + 1
                } else if ls_is_open_sym(tk.value) {
                    dd = dd - 1
                    if dd == 0 {
                        break
                    }
                }
            }
            k = k - 1
        }
        if k > lo && d.toks.get(k).kind == "sym"
        && d.toks.get(k).value == "[" && k - 1 >= lo
        && d.toks.get(k - 1).kind == "sym"
        && d.toks.get(k - 1).value == "#" {
            start_idx = k - 1
        } else {
            break
        }
    }
    # the initializer: from the `=`, the parser sub-child consumes
    # exactly the expression
    let mut eq: int = -1
    let mut dd2: int = 0
    let mut j2: int = decl.tok + 1
    while j2 < hi {
        let tj: LTok = d.toks.get(j2)
        if tj.kind == "sym" {
            if ls_is_open_sym(tj.value) {
                dd2 = dd2 + 1
            } else if ls_is_close_sym(tj.value) {
                if dd2 == 0 {
                    return fail
                }
                dd2 = dd2 - 1
            } else if tj.value == "=" && dd2 == 0 {
                eq = j2
                break
            }
        }
        j2 = j2 + 1
    }
    let init_text: str = ls_slice_text(d.text, d.toks, eq + 1, hi)
    let consumed: int = rf_expr_extends(init_text)
    if consumed <= 0 {
        return fail
    }
    let init_end: int = eq + consumed
    let init_src: str = ls_slice_text(d.text, d.toks, eq + 1,
    init_end + 1)
    # use sites: every token the declaration binds, minus itself
    let use_sites: list[int] = []
    let mut i: int = lo
    while i < hi && i < d.toks.len() {
        let t: LTok = d.toks.get(i)
        if t.kind != "ident" || t.value != decl.name || i == decl.tok {
            i = i + 1
            continue
        }
        if i + 1 < d.toks.len() && d.toks.get(i + 1).kind == "sym"
        && d.toks.get(i + 1).value == "(" {
            i = i + 1
            continue
        }
        if ls_resolve_local(decls, i, decl.name) == decl_i {
            use_sites.push(i)
        }
        i = i + 1
    }
    # guard: reassigned (the `name =` shapes the declaration binds)
    i = lo
    while i < hi && i < d.toks.len() {
        if d.toks.get(i).kind == "ident" && d.toks.get(i).value == decl.name
        && i + 1 < d.toks.len() && d.toks.get(i + 1).kind == "sym"
        && d.toks.get(i + 1).value == "="
        && ls_resolve_local(decls, i, decl.name) == decl_i {
            return fail
        }
        i = i + 1
    }
    # guard: assignment through a use
    let stmts: list[list[int]] = ls_stmt_spans(d, braces, lo, hi)
    let targets: list[int] = ls_assign_target_toks(d, braces, depths,
    stmts, lo, hi)
    let mut ui: int = 0
    while ui < use_sites.len() {
        if ls_targets_has(targets, use_sites.get(ui)) {
            return fail
        }
        ui = ui + 1
    }
    # guard: the initializer names a local that is reassigned
    let assigned: list[str] = []
    let mut ti: int = 0
    while ti < targets.len() {
        let tt: LTok = d.toks.get(targets.get(ti))
        if tt.kind == "ident" {
            ls_push_unique(assigned, tt.value)
        }
        ti = ti + 1
    }
    let mut ji: int = eq + 1
    while ji <= init_end && ji < d.toks.len() {
        let tj2: LTok = d.toks.get(ji)
        if tj2.kind == "ident" && ls_taken_has(assigned, tj2.value) {
            return fail
        }
        ji = ji + 1
    }
    # guard: a call-bearing initializer used more than once
    let mut has_call: bool = false
    ji = eq + 1
    while ji <= init_end && ji + 1 < d.toks.len() {
        if d.toks.get(ji).kind == "ident" && d.toks.get(ji + 1).kind == "sym"
        && d.toks.get(ji + 1).value == "(" {
            has_call = true
        }
        ji = ji + 1
    }
    if use_sites.len() >= 2 && has_call {
        return fail
    }
    # paren discipline: a single token — or an initializer already
    # wrapped in one matching paren group — splices bare
    let mut repl: str = init_src
    if !(init_end - eq == 1 || (d.toks.get(eq + 1).kind == "sym"
    && d.toks.get(eq + 1).value == "("
    && ls_brace_get(braces, eq + 1) == init_end)) {
        repl = "(" + init_src + ")"
    }
    # the deletion: the let's own tokens, extended to whole lines when
    # the lines carry nothing else
    let del_a: int = d.toks.get(start_idx).off
    let del_b: int = d.toks.get(init_end).off + d.toks.get(init_end).len
    let line_a: int = d.toks.get(start_idx).line
    let line_b: int = d.toks.get(init_end).line
    let mut pre_clean: bool = true
    let seg: str = d.text.slice(d.offs.get(line_a - 1), del_a)
    if seg.trim() != "" {
        pre_clean = false
    }
    let mut post_clean: bool = true
    let mut j3: int = init_end + 1
    while j3 < d.toks.len() && j3 < hi {
        if d.toks.get(j3).line <= line_b {
            post_clean = false
            break
        }
        if d.toks.get(j3).line > line_b {
            break
        }
        j3 = j3 + 1
    }
    let edits: list[ByteEdit] = []
    if pre_clean && post_clean && line_b < d.offs.len() {
        edits.push(ByteEdit { a: d.offs.get(line_a - 1),
        b: d.offs.get(line_b), new_text: "" })
    } else {
        edits.push(ByteEdit { a: del_a, b: del_b, new_text: "" })
    }
    ui = 0
    while ui < use_sites.len() {
        let u: LTok = d.toks.get(use_sites.get(ui))
        edits.push(ByteEdit { a: u.off, b: u.off + u.len, new_text: repl })
        ui = ui + 1
    }
    # final gate: the original must check, and so must the result
    if rf_text_checks(d.text) {
        if !rf_text_checks(rf_apply_edits(d.text, edits)) {
            return fail
        }
    }
    return PlanRes { ok: true, edits: edits, name: decl.name }
}

# rf_plan_extract — the extract-variable plan. The pipeline, each step
# a refusal: the selection resolves inside ONE fn; the statement is
# found (an `=>` before the selection = a match arm — no statement to
# anchor a `let`); the selection is not inside an assignment TARGET;
# the selection parses as exactly one expression; the probe keeps
# EXACTLY ONE candidate type.
fn rf_plan_extract(d: DocRec, braces: BraceMap, depths: list[int],
spans: list[list[int]], rng: JsonValue) -> PlanRes uses IO, Proc, Args,
Fs {
    let fail: PlanRes = PlanRes { ok: false, edits: [], name: "" }
    let win: list[int] = ls_selection_window(d, braces, rng)
    let i0: int = win.get(0)
    let i1: int = win.get(1)
    if i0 < 0 {
        return fail
    }
    let span_i: int = ls_enclosing_span(spans, i0)
    if span_i < 0 {
        return fail
    }
    let span: list[int] = spans.get(span_i)
    if !(span.get(0) <= i1 && i1 < span.get(1)) {
        return fail
    }
    let lo: int = span.get(0)
    let hi: int = span.get(1)
    # the statement containing the selection
    let stmts: list[list[int]] = ls_stmt_spans(d, braces, lo, hi)
    let mut inner: int = -1
    let mut si: int = 0
    while si < stmts.len() {
        let s: list[int] = stmts.get(si)
        if s.get(0) <= i0 && i0 < s.get(1) {
            if inner < 0 || s.get(0) > stmts.get(inner).get(0) {
                inner = si
            }
        }
        si = si + 1
    }
    if inner < 0 {
        return fail
    }
    let s: int = stmts.get(inner).get(0)
    # a `=>` before the selection = a match arm body
    let mut j: int = s
    while j < i0 {
        if d.toks.get(j).kind == "sym" && d.toks.get(j).value == "=>" {
            return fail
        }
        j = j + 1
    }
    # the assignment-target guard
    let targets: list[int] = ls_assign_target_toks(d, braces, depths,
    stmts, lo, hi)
    let mut j2: int = i0
    while j2 <= i1 {
        if ls_targets_has(targets, j2) {
            return fail
        }
        j2 = j2 + 1
    }
    # the selection parses as one expression, all of it
    let sel_text: str = ls_slice_text(d.text, d.toks, i0, i1 + 1)
    let consumed: int = rf_expr_extends(sel_text)
    if consumed != i1 - i0 + 1 {
        return fail
    }
    # names: the new binding must be free, the probe's even fresher
    let taken: list[str] = ls_scope_taken_names(d, lo, hi)
    let real_name: str = ls_fresh_name("extracted", taken)
    ls_push_unique(taken, real_name)
    let probe_name: str = ls_fresh_name("__hls_probe", taken)
    # the statement's leading whitespace (the let rides the same line)
    let stmt_off: int = d.toks.get(s).off
    let mut ws: int = stmt_off - 1
    while ws >= 0 {
        let c: int = d.text.byte_at(ws)
        if c == 32 || c == 9 {
            ws = ws - 1
        } else {
            break
        }
    }
    let wss: str = d.text.slice(ws + 1, stmt_off)
    # the probe — one checker run per candidate type
    let sel_a: int = d.toks.get(i0).off
    let sel_b: int = d.toks.get(i1).off + d.toks.get(i1).len
    let cands: list[str] = ls_extract_candidates(d)
    let mut passing: str = ""
    let mut n_pass: int = 0
    let mut ci: int = 0
    while ci < cands.len() {
        let cand: str = cands.get(ci)
        let mut probe: str = ""
        if s == i0 {
            probe = d.text.slice(0, sel_a) + "let " + probe_name + ": "
            + cand + " = " + sel_text + "\n" + wss + probe_name
            + d.text.slice(sel_b, d.text.len())
        } else {
            probe = d.text.slice(0, stmt_off) + "let " + probe_name
            + ": " + cand + " = " + sel_text + "\n" + wss
            + d.text.slice(stmt_off, sel_a) + probe_name
            + d.text.slice(sel_b, d.text.len())
        }
        if rf_text_checks(probe) {
            passing = cand
            n_pass = n_pass + 1
            if n_pass > 1 {
                return fail
            }
        }
        ci = ci + 1
    }
    if n_pass != 1 {
        return fail
    }
    # the real edits — the shapes the probe validated, re-checked
    let edits: list[ByteEdit] = []
    if s == i0 {
        edits.push(ByteEdit { a: sel_a, b: sel_b, new_text: "let "
        + real_name + ": " + passing + " = " + sel_text + "\n" + wss
        + real_name })
    } else {
        edits.push(ByteEdit { a: stmt_off, b: stmt_off, new_text: "let "
        + real_name + ": " + passing + " = " + sel_text + "\n" + wss })
        edits.push(ByteEdit { a: sel_a, b: sel_b, new_text: real_name })
    }
    if !rf_text_checks(rf_apply_edits(d.text, edits)) {
        return fail
    }
    return PlanRes { ok: true, edits: edits, name: real_name }
}

# ls_handle_code_action — the two refactor generators; each ships a
# WorkspaceEdit the client can apply as-is, and each refuses before
# it rewrites.
fn ls_handle_code_action(st: LsState, params: JsonValue) -> JsonValue
uses IO, Proc, Fs, Args {
    let td: JsonValue = ls_jget(params, "textDocument")
    let uri: str = ls_jstr(td, "uri")
    let di: int = ls_find_doc(st, uri)
    if di < 0 {
        return json_array([])
    }
    let d: DocRec = st.docs.get(di)
    if d.parse_err || d.dead {
        return json_array([])
    }
    let rng: JsonValue = ls_jget(params, "range")
    if !json_is_object(rng) {
        return json_array([])
    }
    let braces: BraceMap = ls_brace_matches(d.toks)
    let depths: list[int] = ls_tok_depths(d.toks)
    let spans: list[list[int]] = ls_fn_spans(d.toks, braces)
    # the cursor's token (the inline plan anchors on it)
    let start: JsonValue = ls_jget(rng, "start")
    let sl: int = ls_jint(start, "line")
    let sc: int = ls_jint(start, "character")
    let off: int = ls_linecol_to_off(d.offs, sl,
    ls_byte_of_utf16_col(d.text, d.offs, sl, sc))
    let idx: int = ls_token_index_at(d.toks, off)
    let actions: list[JsonValue] = []
    let inline: PlanRes = rf_plan_inline(d, braces, depths, spans, idx)
    if inline.ok {
        actions.push(json_object(
        ["title", "kind", "isPreferred", "edit"],
        [json_str("Inline variable"), json_str("refactor.inline"),
        json_bool(true),
        json_object(["changes"], [json_object([uri],
        [json_array(rf_edits_to_lsp(d, inline.edits))])])]))
    }
    let extract: PlanRes = rf_plan_extract(d, braces, depths, spans,
    rng)
    if extract.ok {
        actions.push(json_object(
        ["title", "kind", "isPreferred", "edit"],
        [json_str("Extract variable"), json_str("refactor.extract"),
        json_bool(false),
        json_object(["changes"], [json_object([uri],
        [json_array(rf_edits_to_lsp(d, extract.edits))])])]))
    }
    return json_array(actions)
}

# ----------------------------------------------------------------------------
# The initialize answer — the .py's exact capabilities.
# ----------------------------------------------------------------------------

fn ls_initialize_result() -> JsonValue {
    let ckeys: list[str] = ["textDocumentSync", "hoverProvider",
    "definitionProvider", "referencesProvider", "renameProvider",
    "documentSymbolProvider", "completionProvider",
    "inlayHintProvider", "codeActionProvider"]
    let cvals: list[JsonValue] = [json_int(1), json_bool(true),
    json_bool(true), json_bool(true), json_bool(true),
    json_bool(true),
    json_object(["triggerCharacters"],
    [json_array([json_str("."), json_str(":")])]),
    json_bool(true),
    json_object(["codeActionKinds"],
    [json_array([json_str("refactor.extract"),
    json_str("refactor.inline")])])]
    let skeys: list[str] = ["name", "version"]
    let svals: list[JsonValue] = [json_str("hls-lsp"),
    json_str(ls_version())]
    let keys: list[str] = ["capabilities", "serverInfo"]
    let vals: list[JsonValue] = [json_object(ckeys, cvals),
    json_object(skeys, svals)]
    return json_object(keys, vals)
}

# ----------------------------------------------------------------------------
# The dispatch — one message, the .py's handle() law.
# ----------------------------------------------------------------------------

# ls_handle_message(st, msg) — one parsed JSON-RPC message. Returns
# false when the server must exit (the exit notification).
fn ls_handle_message(st: LsState, msg: JsonValue) -> bool uses IO,
Proc, Fs, Args {
    let method: str = ls_jstr(msg, "method")
    let idv: JsonValue = ls_jget(msg, "id")
    let has_id: bool = !json_is_null(idv)
    let params: JsonValue = ls_jget(msg, "params")
    # after shutdown: only exit is served.
    if st.shutdown {
        if method == "exit" {
            return false
        }
        if has_id {
            ls_send_error(idv, -32600, "server is shutting down")
        }
        return true
    }
    if method == "initialize" {
        if has_id {
            ls_send_result(idv, ls_initialize_result())
        }
        return true
    }
    if method == "initialized" {
        return true
    }
    if method == "shutdown" {
        st.shutdown = true
        if has_id {
            let keys: list[str] = ["jsonrpc", "id", "result"]
            let vals: list[JsonValue] = [json_str("2.0"), idv,
            json_null()]
            ls_write_message(json_stringify(
            json_object(keys, vals)))
        }
        return true
    }
    if method == "exit" {
        return false
    }
    if method == "textDocument/didOpen" {
        let td: JsonValue = ls_jget(params, "textDocument")
        let uri: str = ls_jstr(td, "uri")
        let text: str = ls_jstr(td, "text")
        let ver: int = ls_jint(td, "version")
        ls_store_doc(st, uri, ver, text)
        let di: int = ls_find_doc(st, uri)
        if di >= 0 {
            ls_publish_diagnostics(st, di)
        }
        return true
    }
    if method == "textDocument/didChange" {
        # full sync: contentChanges[0].text is the whole new text.
        let td: JsonValue = ls_jget(params, "textDocument")
        let uri: str = ls_jstr(td, "uri")
        let ver: int = ls_jint(td, "version")
        let changes: JsonValue = ls_jget(params, "contentChanges")
        if json_is_array(changes) && changes.arr.len() > 0 {
            let text: str = ls_jstr(changes.arr.get(0), "text")
            ls_store_doc(st, uri, ver, text)
            let di: int = ls_find_doc(st, uri)
            if di >= 0 {
                ls_publish_diagnostics(st, di)
            }
        }
        return true
    }
    if method == "textDocument/didClose" {
        let td: JsonValue = ls_jget(params, "textDocument")
        let uri: str = ls_jstr(td, "uri")
        let di: int = ls_find_doc(st, uri)
        if di >= 0 {
            let mut j: int = di
            while j + 1 < st.docs.len() {
                st.docs.set(j, st.docs.get(j + 1))
                j = j + 1
            }
            let _d: DocRec = st.docs.pop()
        }
        # closing clears the markers (BUG-DS4-18).
        let pkeys: list[str] = ["uri", "diagnostics"]
        let pvals: list[JsonValue] = [json_str(uri), json_array([])]
        ls_send_notification("textDocument/publishDiagnostics",
        json_object(pkeys, pvals))
        return true
    }
    # the feature requests.
    if !has_id {
        return true
    }
    if method == "textDocument/hover" {
        ls_send_result(idv, ls_handle_hover(st, params))
        return true
    }
    if method == "textDocument/definition" {
        ls_send_result(idv, ls_handle_definition(st, params))
        return true
    }
    if method == "textDocument/references" {
        ls_send_result(idv, ls_handle_references(st, params))
        return true
    }
    if method == "textDocument/rename" {
        let r: JsonValue = ls_handle_rename(st, params, idv)
        if !json_is_null(r) {
            ls_send_result(idv, r)
        }
        return true
    }
    if method == "textDocument/documentSymbol" {
        ls_send_result(idv, ls_handle_document_symbol(st, params))
        return true
    }
    if method == "textDocument/completion" {
        ls_send_result(idv, ls_handle_completion(st, params))
        return true
    }
    if method == "textDocument/inlayHint" {
        ls_send_result(idv, ls_handle_inlay_hint(st, params))
        return true
    }
    if method == "textDocument/codeAction" {
        ls_send_result(idv, ls_handle_code_action(st, params))
        return true
    }
    ls_send_error(idv, -32601, "method not found: " + method)
    return true
}

# ----------------------------------------------------------------------------
# The server loop.
# ----------------------------------------------------------------------------

fn ls_serve() -> int uses IO, Proc, Fs, Args, Exit {
    let st: LsState = ls_state_new()
    let mut shutdown_seen: bool = false
    let mut pend: str = ""
    while true {
        let frame: list[str] = ls_read_message(pend)
        pend = frame.get(2)
        if frame.get(0) == "eof" {
            break
        }
        if frame.get(0) == "err" {
            ls_send_error(json_null(), -32700,
            "Parse error: " + frame.get(1))
            continue
        }
        let rr: Result[JsonValue, str] = json_parse_result(
        frame.get(1))
        if result_is_err(rr) {
            ls_send_error(json_null(), -32700, "Parse error: "
            + result_err_or(rr, ""))
            continue
        }
        let msg: JsonValue = result_unwrap(rr)
        if !ls_handle_message(st, msg) {
            shutdown_seen = st.shutdown
            break
        }
    }
    if shutdown_seen {
        exit(0)
    }
    exit(1)
}

# ----------------------------------------------------------------------------
# --check — the one-shot diagnostics print: "<path>:<line>:<col>:
# error: <msg>" (the interpreter years' 1-indexed byte coordinates),
# "<path>: OK (types and effects valid)" when clean.
# ----------------------------------------------------------------------------

fn ls_one_shot_check(path: str) -> int uses IO, Proc, Fs, Args {
    if !file_exists(path) {
        eprint("error: file not found: " + path + "\n")
        return 1
    }
    let p: ProbeOut = ls_probe_run(path)
    if p.parse_err {
        let mut col: int = p.err_col
        if col < 1 {
            col = 1
        }
        println(path + ":" + p.err_line.to_str() + ":"
        + col.to_str() + ": error: " + p.err_msg)
        return 1
    }
    if p.check_err {
        println(path + ":" + p.err_line.to_str() + ":1: error: "
        + p.err_msg)
        return 1
    }
    println(path + ": OK (types and effects valid)")
    return 0
}

# ----------------------------------------------------------------------------
# main — the CLI dispatch.
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Args, Exit, Proc, Fs {
    let argv: list[str] = args()
    let mut i: int = 0
    while i < argv.len() {
        if argv.get(i) == "--check" && i + 1 < argv.len() {
            return ls_one_shot_check(argv.get(i + 1))
        }
        if argv.get(i) == "--probe-file" && i + 1 < argv.len() {
            return ls_probe_file(argv.get(i + 1))
        }
        if argv.get(i) == "--rf-slice" && i + 1 < argv.len() {
            # The refactor engine's statement walker: LEX only (a
            # fragment is not a program — hl_parse_file would reject
            # it at the top level), then parse one statement at a
            # time. One RFSTMT line per statement, its consumed token
            # count; a panic anywhere dies and the parent refuses.
            let src: str = read_file(argv.get(i + 1))
            let ctx: Ctx = new_ctx(src)
            lex(ctx)
            let mut pos: int = 0
            let mut guard: int = 0
            while pos < ctx.toks.len() - 1 {
                let consumed: int = ls_rf_one_stmt(ctx, pos)
                if consumed <= 0 {
                    break
                }
                println("RFSTMT " + consumed.to_str())
                pos = pos + consumed
                guard = guard + 1
                if guard > 100000 {
                    break
                }
            }
            return 0
        }
        if argv.get(i) == "--rf-expr" && i + 1 < argv.len() {
            # One expression, all of it: LEX, then parse_expr from the
            # top — the consumed token count (a panic dies exit 101;
            # tokens left behind still print the count, and the
            # caller's tail check refuses).
            let src: str = read_file(argv.get(i + 1))
            let ctx: Ctx = new_ctx(src)
            lex(ctx)
            let start: int = ctx.pos
            let _e: int = parse_expr(ctx, true)
            println("RFEXPR " + (ctx.pos - start).to_str())
            return 0
        }
        if argv.get(i) == "--rf-stmt" && i + 1 < argv.len() {
            # One statement, its consumed token count.
            let src: str = read_file(argv.get(i + 1))
            let ctx: Ctx = new_ctx(src)
            lex(ctx)
            let start: int = ctx.pos
            let _s: int = parse_stmt(ctx)
            println("RFSTMT " + (ctx.pos - start).to_str())
            return 0
        }
        if argv.get(i) == "--debug-walk" && i + 1 < argv.len() {
            let p: ProbeOut = ls_probe_run(argv.get(i + 1))
            println("parse_err=" + ls_bool_int(p.parse_err).to_str()
            + " check_err=" + ls_bool_int(p.check_err).to_str()
            + " calls=" + p.calls.len().to_str()
            + " arms=" + p.arms.len().to_str())
            let mut ci: int = 0
            while ci < p.calls.len() {
                println("  CALL line=" + p.calls.get(ci).line.to_str()
                + " method=" + ls_bool_int(p.calls.get(ci).is_method).to_str()
                + " name=" + p.calls.get(ci).name)
                ci = ci + 1
            }
            let mut ai: int = 0
            while ai < p.arms.len() {
                let wa: WalkArm = p.arms.get(ai)
                println("  ARM seq=" + wa.seq.to_str() + " line="
                + wa.line.to_str() + " enum=" + wa.enum_name
                + " variant=" + wa.variant + " paren="
                + ls_bool_int(wa.has_paren).to_str() + " binds="
                + str_join(wa.bindings, ",") + " bind_ts.len="
                + wa.bind_ts.len().to_str())
                ai = ai + 1
            }
            return 0
        }
        i = i + 1
    }
    ls_serve()
    return 0
}
