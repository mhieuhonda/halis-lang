# ============================================================================
# tools/hls-ctime.hls — the Stage 138 per-commit compile-time regression
# dashboard, in Halis (the native twin of the Python hls-ctime.py that
# retired; same CLI, same wire, same exits).
# ----------------------------------------------------------------------------
# The instrument is the compiler itself, and Halis ships two of them, so
# they are two INSTRUMENTS, never compared:
#
#   stage0  bin/hlboot src/hlc.hls <workload> <out.c>
#          (the bootstrap chain — the front door every contributor's
#          `make` walks through)
#   native  bin/hlc <workload> <out.c>
#          (the self-hosted compiler — the artifact users run)
#
# Both time the SAME quantity — one full HLS-to-C compile of one tracked
# workload, wall time, milliseconds — but through different machines, so
# a record names its instrument and the gate refuses to compare across
# them. Every record also pins the compiler's OWN identity (the sha256
# over src/hlc.hls + src/hlc/*.hls and the sha256 of the binary actually
# timed), and the STALE-BINARY LAW bites at record time: a native record
# whose compiler digest was already filed against a DIFFERENT source
# digest is refused — bin/hlc was not rebuilt for the commit it claims
# to measure ("run make bootstrap first").
#
#   record    compile every workload of the tracked suite (the tracked
#             default is benchmarks/ctime_watch/) through the instrument,
#             --samples timed compiles each after --warmup untimed ones,
#             and append one entry pinned to `git rev-parse HEAD`
#             (refused on a dirty tree; --from-report imports a machine
#             report instead)
#   sanction  a written excuse for one workload (reason mandatory)
#   gate      classify the newest record against the prior record of the
#             same instrument (Welch p, the seeded bootstrap CI against
#             the --threshold noise band, default 10% — honest about wall
#             time on a shared machine); exit 1 on any unsanctioned
#             regressed or vanished workload
#   dashboard the deterministic COMPILETIME.md render (sha256 ledger
#             digest embedded; two renders of one ledger are
#             byte-identical)
#   history   read the ledger back
#
# The ledger is JSONL (default .hlctime/history.jsonl), append-only, one
# object per line. The statistics are hls-bench's law, restated natively
# (one implementation of Welch's test and the bootstrap, so the runner's
# numbers and every ledger's verdicts can never drift apart).
#
# Exit codes: 0 verified / 1 named violation / 2 usage or IO error.
# ============================================================================

import "std.str"
import "std.json"
import "std.result"
import "std.option"
import "std.fmt"
import "std.sha256"

