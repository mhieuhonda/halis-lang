# ============================================================================
# tools/hls-mem.hls — the Stage 137 memory regression dashboard (RSS over
# time), in Halis (the native twin of the Python hls-mem.py that retired;
# same CLI, same wire, same exits).
# ----------------------------------------------------------------------------
# hls-rss (Stage 125) measures; hls-mem remembers and judges:
#   record    run the REAL hls-rss over every workload of the tracked
#             suite --samples times each and append one entry pinned to
#             `git rev-parse HEAD` (refused on a dirty tree; --from-bundle
#             imports a machine bundle instead). The floor law bites at
#             record time: every run must certify STABLE
#   sanction  a written excuse for one workload (reason mandatory)
#   gate      the page law: classify the newest record against the prior
#             record of the same instrument (byte-identical suite digest
#             AND same page size); significance is the seeded bootstrap
#             CI of the median marker-RSS change excluding zero, the
#             noise band floored in pages; exit 1 on any unsanctioned
#             regressed or vanished workload
#   dashboard the deterministic MEMORY.md render (sha256 ledger digest
#             embedded; two renders of one ledger are byte-identical)
#   history   read the ledger back
#
# The ledger is JSONL (default .hlmem/history.jsonl), append-only, one
# object per line. A page is a unit: the gate never compares across page
# sizes or across suite digests.
#
# Exit codes: 0 verified / 1 named violation / 2 usage or IO error.
# ============================================================================

import "std.str"
import "std.json"
import "std.result"
import "std.option"
import "std.fmt"
import "std.sha256"

# ----------------------------------------------------------------------------
# Constants (the .py's).
# ----------------------------------------------------------------------------

fn tool_name() -> str {
    return "hls-mem"
}

fn tool_version() -> str {
    return "0.155.0"
}

fn history_default() -> str {
    return ".hlmem/history.jsonl"
}

fn default_suite() -> str {
    return "benchmarks/rss_watch"
}

fn default_samples() -> int {
    return 5
}

fn default_cycles() -> int {
    return 200
}

fn default_interval() -> float {
    return 10.0
}

fn default_noise_pct() -> float {
    return 5.0
}

fn default_floor_pages() -> float {
    return 16.0
}

fn default_dash_limit() -> int {
    return 12
}

fn min_samples() -> int {
    return 2
}

fn bootstrap_b() -> int {
    return 2000
}

fn bundle_tool() -> str {
    return "hls-mem-bundle"
}

# hls-rss's own leak threshold (pages/cycle), restated for the dashboard's
# slope watch table — the instrument's law, not a new one.
fn leak_slope_threshold() -> float {
    return 0.25
}

fn page_size_default() -> int {
    return 4096
}

# The 8-band sparkline alphabet and the mid band a constant series
# renders (raw UTF-8 bytes; each block is 3 bytes).
fn spark_bands() -> str {
    return "▁▂▃▄▅▆▇█"
}

fn spark_mid() -> str {
    return "▄"
}

# ----------------------------------------------------------------------------
# The named refusal (the .py's HlMemError: a message + its exit code).
# ----------------------------------------------------------------------------

struct Err {
    msg: str,
    code: int
}

fn err1(msg: str) -> Err {
    return Err {
        msg: msg, code: 1
    }
}

fn err2(msg: str) -> Err {
    return Err {
        msg: msg, code: 2
    }
}

# ----------------------------------------------------------------------------
# Byte / string helpers.
# ----------------------------------------------------------------------------

fn is_digit_b(b: int) -> bool {
    return b >= 48 && b <= 57
}

fn is_hex_b(b: int) -> bool {
    if is_digit_b(b) {
        return true
    }
    return(b >= 97 && b <= 102) || (b >= 65 && b <= 70)
}

fn strip_ws(s: str) -> str {
    return s.trim()
}

fn take_s(s: str, n: int) -> str {
    if s.len() <= n {
        return s
    }
    return s.slice(0, n)
}

fn repeat_str(s: str, n: int) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

fn pad_right(s: str, width: int) -> str {
    if s.len() >= width {
        return s
    }
    return s + repeat_str(" ", width - s.len())
}

fn pad_left_num(v: int, width: int) -> str {
    let s: str = v.to_str()
    if s.len() >= width {
        return s
    }
    return repeat_str(" ", width - s.len()) + s
}

# hex_to_int(s) — a non-negative hex string as int (0 on garbage).
fn hex_to_int(s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if !is_hex_b(b) {
            return 0
        }
        if is_digit_b(b) {
            v = v * 16 + (b - 48)
        } else if b >= 97 {
            v = v * 16 + (b - 87)
        } else {
            v = v * 16 + (b - 55)
        }
        i = i + 1
    }
    return v
}

fn parse_int_opt(s: str) -> Option[int] {
    let t: str = strip_ws(s)
    if t.len() == 0 {
        return Option.None
    }
    let mut i: int = 0
    let mut neg: bool = false
    if t.byte_at(0) == 43 || t.byte_at(0) == 45 {
        neg = t.byte_at(0) == 45
        i = 1
    }
    if i >= t.len() {
        return Option.None
    }
    let mut v: int = 0
    while i < t.len() {
        if !is_digit_b(t.byte_at(i)) {
            return Option.None
        }
        v = v * 10 + (t.byte_at(i) - 48)
        i = i + 1
    }
    if neg {
        return Option.Some(0 - v)
    }
    return Option.Some(v)
}

fn parse_float_opt(s: str) -> Option[float] {
    let t: str = strip_ws(s)
    let n: int = t.len()
    if n == 0 {
        return Option.None
    }
    let mut i: int = 0
    if t.byte_at(0) == 43 || t.byte_at(0) == 45 {
        i = 1
    }
    let int_start: int = i
    while i < n && is_digit_b(t.byte_at(i)) {
        i = i + 1
    }
    let saw_digits: bool = i > int_start
    if i < n && t.byte_at(i) == 46 {
        i = i + 1
        let frac_start: int = i
        while i < n && is_digit_b(t.byte_at(i)) {
            i = i + 1
        }
        if i == frac_start && !saw_digits {
            return Option.None
        }
    }
    if !saw_digits && !(i > int_start && t.byte_at(i - 1) == 46) {
        return Option.None
    }
    if i < n && (t.byte_at(i) == 101 || t.byte_at(i) == 69) {
        i = i + 1
        if i < n && (t.byte_at(i) == 43 || t.byte_at(i) == 45) {
            i = i + 1
        }
        let exp_start: int = i
        while i < n && is_digit_b(t.byte_at(i)) {
            i = i + 1
        }
        if i == exp_start {
            return Option.None
        }
    }
    if i != n {
        return Option.None
    }
    return Option.Some(t.to_float())
}

# ----------------------------------------------------------------------------
# Path helpers (the harness path grammar, inlined).
# ----------------------------------------------------------------------------

fn path_basename(p: str) -> str {
    let mut i: int = p.len() - 1
    while i >= 0 {
        if p.byte_at(i) == 47 {
            return p.slice(i + 1, p.len())
        }
        i = i - 1
    }
    return p
}

fn path_dirname(p: str) -> str {
    let mut i: int = p.len() - 1
    while i >= 0 {
        if p.byte_at(i) == 47 {
            if i == 0 {
                return "/"
            }
            return p.slice(0, i)
        }
        i = i - 1
    }
    return "."
}

fn path_join2(base: str, rel: str) -> str {
    if base == "" {
        return rel
    }
    if base.byte_at(base.len() - 1) == 47 {
        return base + rel
    }
    return base + "/" + rel
}

fn path_is_absolute(p: str) -> bool {
    return p.len() > 0 && p.byte_at(0) == 47
}

fn path_abs(p: str, cwd: str) -> str {
    if path_is_absolute(p) {
        return p
    }
    return path_join2(cwd, p)
}

# ----------------------------------------------------------------------------
# Number formatting — the Python laws the report and the ledger pin.
# fmt_fixed(x, p) is %.<p>f; py_float_repr(x) is Python's repr (shortest
# round-trip, ".0" forced for integral values); fmt_g4 is %.4g.
# ----------------------------------------------------------------------------

fn fmt_fixed(x: float, p: int) -> str {
    return fmt_float_with_precision(x, p)
}

fn py_float_repr(x: float) -> str {
    if x < 0.0 {
        return "-" + py_float_repr(0.0 - x)
    }
    let mut p: int = 0
    while p <= 17 {
        let s: str = fmt_float_with_precision(x, p)
        if s.to_float() == x {
            if !s.contains(".") && !s.contains("e") {
                return s + ".0"
            }
            return s
        }
        p = p + 1
    }
    return x.to_str()
}

# fmt_g4(x) — Python's "%.4g" (4 significant digits, trailing zeros

# fmt_time(ns) — hls-bench's own time formatter: the largest unit that

# fmt_pct(x) — hls-bench's signed percent, two decimals.
fn fmt_pct(x: float) -> str {
    let mut sign: str = ""
    if x >= 0.0 {
        sign = "+"
    }
    return sign + fmt_fixed(x, 2) + "%"
}

# py_repr_str(s) — Python's repr of a str (single quotes, escapes).
fn py_repr_str(s: str) -> str {
    let mut out: str = "'"
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b == 39 {
            out = out + "\\'"
        } else if b == 92 {
            out = out + "\\\\"
        } else {
            out = out + s.slice(i, i + 1)
        }
        i = i + 1
    }
    return out + "'"
}

# ----------------------------------------------------------------------------
# Sorting (bottom-up merge for floats, insertion for strings).
# ----------------------------------------------------------------------------

fn sort_floats(xs: list[float]) -> list[float] {
    let n: int = xs.len()
    let mut cur: list[float] = []
    let mut i: int = 0
    while i < n {
        cur.push(xs.get(i))
        i = i + 1
    }
    let mut w: int = 1
    while w < n {
        let dst: list[float] = []
        let mut lo: int = 0
        while lo < n {
            let mut mid: int = lo + w
            let mut hi2: int = lo + w + w
            if mid > n {
                mid = n
            }
            if hi2 > n {
                hi2 = n
            }
            let mut i1: int = lo
            let mut i2: int = mid
            while i1 < mid || i2 < hi2 {
                if i1 < mid && (i2 >= hi2 || cur.get(i1) <= cur.get(i2)) {
                    dst.push(cur.get(i1))
                    i1 = i1 + 1
                } else {
                    dst.push(cur.get(i2))
                    i2 = i2 + 1
                }
            }
            lo = lo + w + w
        }
        cur = dst
        w = w * 2
    }
    return cur
}

fn sort_strs(xs: list[str]) -> list[str] {
    let n: int = xs.len()
    let mut out: list[str] = []
    let mut i: int = 0
    while i < n {
        out.push(xs.get(i))
        i = i + 1
    }
    let mut b: int = 1
    while b < n {
        let k: str = out.get(b)
        let mut j: int = b - 1
        while j >= 0 && out.get(j) > k {
            out.set(j + 1, out.get(j))
            j = j - 1
        }
        out.set(j + 1, k)
        b = b + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# JSON emission — Python json.dumps laws: compact lines with ", " / ": "
# separators and sorted keys; pretty documents with indent=1. Floats ride
# py_float_repr so 10.0 stays 10.0.
# ----------------------------------------------------------------------------

fn jesc(s: str) -> str {
    let mut out: str = "\""
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b == 34 {
            out = out + "\\\""
        } else if b == 92 {
            out = out + "\\\\"
        } else if b == 10 {
            out = out + "\\n"
        } else if b == 9 {
            out = out + "\\t"
        } else if b == 13 {
            out = out + "\\r"
        } else if b == 8 {
            out = out + "\\b"
        } else if b == 12 {
            out = out + "\\f"
        } else if b < 32 {
            let h: str = "0123456789abcdef"
            let hi: int = b / 16
            let lo: int = b - hi * 16
            out = out + "\\u00" + h.slice(hi, hi + 1) + h.slice(lo, lo + 1)
        } else {
            out = out + s.slice(i, i + 1)
        }
        i = i + 1
    }
    return out + "\""
}

fn jv_num(x: float) -> str {
    return py_float_repr(x)
}

struct KeyVals {
    keys: list[str],
    vals: list[JsonValue]
}

fn obj_sorted(v: JsonValue) -> KeyVals {
    let keys: list[str] = []
    let mut i: int = 0
    while i < v.obj_keys.len() {
        keys.push(v.obj_keys.get(i))
        i = i + 1
    }
    let sorted: list[str] = sort_strs(keys)
    let vals: list[JsonValue] = []
    let mut j: int = 0
    while j < sorted.len() {
        let kk: str = sorted.get(j)
        let mut got: JsonValue = json_null()
        let mut k: int = 0
        while k < v.obj_keys.len() {
            if v.obj_keys.get(k) == kk {
                got = v.obj_vals.get(k)
            }
            k = k + 1
        }
        vals.push(got)
        j = j + 1
    }
    return KeyVals {
        keys: sorted, vals: vals
    }
}

fn compact_json(v: JsonValue) -> str {
    if v.kind == "null" {
        return "null"
    }
    if v.kind == "bool" {
        if v.bval {
            return "true"
        }
        return "false"
    }
    if v.kind == "int" {
        return v.ival.to_str()
    }
    if v.kind == "float" {
        return jv_num(v.fval)
    }
    if v.kind == "str" {
        return jesc(v.sval)
    }
    if v.kind == "array" {
        let parts: list[str] = []
        let mut i: int = 0
        while i < v.arr.len() {
            parts.push(compact_json(v.arr.get(i)))
            i = i + 1
        }
        return "[" + str_join(parts, ", ") + "]"
    }
    let kv: KeyVals = obj_sorted(v)
    let parts: list[str] = []
    let mut i2: int = 0
    while i2 < kv.keys.len() {
        parts.push(jesc(kv.keys.get(i2)) + ": " + compact_json(kv.vals.get(i2)))
        i2 = i2 + 1
    }
    return "{" + str_join(parts, ", ") + "}"
}

fn pretty_json_at(v: JsonValue, depth: int) -> str {
    let pad: str = repeat_str(" ", depth)
    let pad2: str = repeat_str(" ", depth + 1)
    if v.kind == "array" {
        if v.arr.len() == 0 {
            return "[]"
        }
        let parts: list[str] = []
        let mut i: int = 0
        while i < v.arr.len() {
            parts.push(pad2 + pretty_json_at(v.arr.get(i), depth + 1))
            i = i + 1
        }
        return "[\n" + str_join(parts, ",\n") + "\n" + pad + "]"
    }
    if v.kind == "object" {
        if v.obj_keys.len() == 0 {
            return "{}"
        }
        let kv: KeyVals = obj_sorted(v)
        let parts: list[str] = []
        let mut i2: int = 0
        while i2 < kv.keys.len() {
            parts.push(pad2 + jesc(kv.keys.get(i2)) + ": "
            + pretty_json_at(kv.vals.get(i2), depth + 1))
            i2 = i2 + 1
        }
        return "{\n" + str_join(parts, ",\n") + "\n" + pad + "}"
    }
    return compact_json(v)
}

fn pretty_json(v: JsonValue) -> str {
    return pretty_json_at(v, 0) + "\n"
}

# ----------------------------------------------------------------------------
# JSON tree builders + typed readers.
# ----------------------------------------------------------------------------

fn jobject(keys: list[str], vals: list[JsonValue]) -> JsonValue {
    return JsonValue {
        kind: "object", bval: false, ival: 0, fval: 0.0, sval: "",
        arr: [], obj_keys: keys, obj_vals: vals
    }
}

fn jarr(items: list[JsonValue]) -> JsonValue {
    return JsonValue {
        kind: "array", bval: false, ival: 0, fval: 0.0, sval: "",
        arr: items, obj_keys: [], obj_vals: []
    }
}

fn jget(v: JsonValue, key: str) -> JsonValue {
    return json_object_get(v, key)
}

fn jstr_of(v: JsonValue, key: str) -> str {
    let x: JsonValue = jget(v, key)
    if json_is_str(x) {
        return json_str_value(x)
    }
    return ""
}

# ----------------------------------------------------------------------------
# The statistics — linear-interpolation quantiles (hls-rss's own
# estimator, the same law hls-bench uses) and the seeded bootstrap.
# ----------------------------------------------------------------------------

fn quantile_of(sorted_xs: list[float], q: float) -> float {
    let n: int = sorted_xs.len()
    if n == 0 {
        panic("quantile of empty data")
    }
    if n == 1 {
        return sorted_xs.get(0)
    }
    let pos: float = q * (n - 1).to_float()
    let lo: int = pos.to_int()
    let mut hi: int = lo + 1
    if hi > n - 1 {
        hi = n - 1
    }
    let frac: float = pos - lo.to_float()
    return sorted_xs.get(lo) * (1.0 - frac) + sorted_xs.get(hi) * frac
}

fn median_of(xs: list[float]) -> float {
    return quantile_of(sort_floats(xs), 0.5)
}

# The continued fraction for the incomplete beta (Lentz's method, the

# The seeded PRNG — the .py seeded random.Random(bench_key); the law that
# matters is DETERMINISM (the same pair of sample sets always classifies
# the same way), pinned here by a sha256-derived xorshift state.
fn rng_seed_of(key: str) -> int {
    let digest: str = sha256_hex(key)
    let v: int = hex_to_int(take_s(digest, 15))
    if v == 0 {
        return 1
    }
    return v
}

fn xs_next(st: int) -> int {
    let a: int = int_xor(st, int_shr(st, 12))
    let b: int = int_xor(a, int_shl(a, 25))
    return int_xor(b, int_shr(b, 27))
}

fn xs_pick(st: int, n: int) -> int {
    let nonneg: int = int_and(st, 9223372036854775807)
    return nonneg % n
}

# ----------------------------------------------------------------------------
# The spawn/capture idiom (the harness's run_capture).
# ----------------------------------------------------------------------------

struct HlRun {
    code: int,
    out: str,
    err: str,
    spawned: bool
}

fn hl_spawn(prog: str, cargs: list[str]) -> HlRun uses Proc {
    let r: HlRun = HlRun {
        code: -1, out: "", err: "", spawned: false
    }
    let pid: int = proc_spawn(prog, cargs, 2, 1, 1)
    if pid < 1 {
        return r
    }
    r.spawned = true
    let mut out: str = ""
    let mut chunk: str = proc_child_read(pid, 1, 65536)
    while chunk != "" {
        out = out + chunk
        chunk = proc_child_read(pid, 1, 65536)
    }
    let mut err: str = ""
    let mut chunk2: str = proc_child_read(pid, 2, 65536)
    while chunk2 != "" {
        err = err + chunk2
        chunk2 = proc_child_read(pid, 2, 65536)
    }
    r.code = proc_wait(pid)
    proc_child_close(pid, 1)
    proc_child_close(pid, 2)
    r.out = out
    r.err = err
    return r
}

# ----------------------------------------------------------------------------
# The git surface (None when git is absent or the tree is not a work
# tree — callers decide whether that is fatal).
# ----------------------------------------------------------------------------

fn git_out(gargs: list[str], root: str) -> str uses Proc {
    let argv: list[str] = ["-C", root]
    let mut i: int = 0
    while i < gargs.len() {
        argv.push(gargs.get(i))
        i = i + 1
    }
    let r: HlRun = hl_spawn("git", argv)
    if !r.spawned || r.code != 0 {
        return ""
    }
    return r.out.trim()
}

fn git_head(root: str) -> str uses Proc {
    return git_out(["rev-parse", "HEAD"], root)
}

fn git_user(root: str) -> str uses Proc {
    let name: str = git_out(["config", "user.name"], root)
    if name != "" {
        return name
    }
    return "unknown"
}

fn git_dirty(root: str) -> bool uses Proc {
    return git_out(["status", "--porcelain", "-uno"], root) != ""
}

# ----------------------------------------------------------------------------
# The digests and env fingerprint.
# ----------------------------------------------------------------------------

fn is_sha1(s: str) -> bool {
    if s.len() != 40 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        if !is_hex_b(s.byte_at(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn is_sha256(s: str) -> bool {
    if s.len() != 64 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        if !is_hex_b(s.byte_at(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

# cpus_of() — os.cpu_count() (the /proc law; 1 when /proc is silent).
fn cpus_of() -> int uses Fs {
    if !file_exists("/proc/cpuinfo") {
        return 1
    }
    let text: str = read_file("/proc/cpuinfo")
    let lines: list[str] = text.split("\n")
    let mut n: int = 0
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).starts_with("processor") {
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 {
        return 1
    }
    return n
}

# python_of() — the interpreter version the bench runner rides (the .py
# wrote sys.version_info; the instrument chain still runs it).
fn python_of() -> str uses Proc {
    let r: HlRun = hl_spawn("python3", ["-c",
    "import sys; print('%d.%d.%d' % sys.version_info[:3])"])
    if r.code != 0 {
        return "0.0.0"
    }
    let t: str = r.out.trim()
    if t == "" {
        return "0.0.0"
    }
    return t
}

fn cc_line() -> str uses Proc {
    let cc: str = "gcc"
    if env_has("CC") {
        let v: str = env_get("CC")
        if v != "" {
            let r: HlRun = hl_spawn(v, ["--version"])
            if r.code == 0 && r.out != "" {
                return first_line_of(r.out)
            }
            return v
        }
    }
    let r: HlRun = hl_spawn(cc, ["--version"])
    if r.code == 0 && r.out != "" {
        return first_line_of(r.out)
    }
    return cc
}

fn first_line_of(text: str) -> str {
    let lines: list[str] = text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let t: str = lines.get(i).trim()
        if t != "" {
            return t
        }
        i = i + 1
    }
    return ""
}

fn last_line_of(text: str) -> str {
    let t: str = text.trim()
    if t == "" {
        return ""
    }
    let lines: list[str] = t.split("\n")
    return lines.get(lines.len() - 1)
}

fn utc_now() -> str uses Clock {
    return rfc3339_from_epoch_ms(system_time_now_ms())
}

fn floor_div(a: int, b: int) -> int {
    let q: int = a / b
    if(a % b != 0) && ((a < 0) != (b < 0)) {
        return q - 1
    }
    return q
}

fn z2(n: int) -> str {
    if n < 10 {
        return "0" + n.to_str()
    }
    return n.to_str()
}

fn civil_from_days(z: int) -> list[int] {
    let zz: int = z + 719468
    let era: int = floor_div(zz, 146097)
    let doe: int = zz - era * 146097
    let yoe: int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let yy: int = yoe + era * 400
    let doy: int = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp: int = (5 * doy + 2) / 153
    let dd: int = doy - (153 * mp + 2) / 5 + 1
    let mut mm: int = mp + 3
    if mm > 12 {
        mm = mm - 12
    }
    let mut y2: int = yy
    if mm <= 2 {
        y2 = yy + 1
    }
    let out: list[int] = [y2, mm, dd]
    return out
}

fn rfc3339_from_epoch_ms(ms: int) -> str {
    let days: int = floor_div(ms, 86400000)
    let rem: int = ms - days * 86400000
    let ymd: list[int] = civil_from_days(days)
    return ymd.get(0).to_str() + "-" + z2(ymd.get(1)) + "-"
    + z2(ymd.get(2)) + "T" + z2(rem / 3600000) + ":"
    + z2((rem / 60000) % 60) + ":" + z2((rem / 1000) % 60) + "Z"
}

# ----------------------------------------------------------------------------
# The repo root (argv[0]'s grandparent when it looks like the repo).
# ----------------------------------------------------------------------------

fn looks_like_repo(p: str) -> bool uses Fs {
    if !file_exists(path_join2(p, "bin")) {
        return false
    }
    if !file_exists(path_join2(p, "src/hlc.hls")) {
        return false
    }
    return true
}

fn repo_root(argv0: str) -> str uses Fs, Proc {
    let cwd: str = cwd_get()
    let a0: str = path_abs(argv0, cwd)
    let p1: str = path_dirname(path_dirname(a0))
    if looks_like_repo(p1) {
        return p1
    }
    if looks_like_repo(cwd) {
        return cwd
    }
    return p1
}

# ----------------------------------------------------------------------------
# The suite — the tracked workload directory and its digest (names AND
# bytes, so a rename re-baselines).
# ----------------------------------------------------------------------------

struct Member {
    name: str,
    path: str
}

fn suite_members(root: str, suite: str) -> Result[list[Member], Err]
uses Fs {
    let d: str = path_join2(root, suite)
    if !fs_is_dir(d) {
        return Result.Err(err2("the suite directory " + suite
        + " does not exist"))
    }
    let names: list[str] = fs_read_dir(d)
    let out: list[Member] = []
    let mut i: int = 0
    while i < names.len() {
        let n: str = names.get(i)
        if n.len() > 4 && n.slice(n.len() - 4, n.len()) == ".hls" {
            out.push(Member {
                name: n.slice(0, n.len() - 4),
                path: path_join2(d, n)
            })
        }
        i = i + 1
    }
    if out.len() == 0 {
        return Result.Err(err2("the suite directory " + suite
        + " carries no .hls workloads"))
    }
    return Result.Ok(out)
}

fn members_digest(members: list[Member]) -> Result[str, Err] uses Fs {
    let mut body: str = ""
    let mut i: int = 0
    while i < members.len() {
        let m: Member = members.get(i)
        if !file_exists(m.path) {
            return Result.Err(err2("cannot read the workload " + m.path
            + ": [Errno 2] No such file or directory: '" + m.path
            + "'"))
        }
        body = body + m.name + chr(0) + read_file(m.path) + chr(0)
        i = i + 1
    }
    return Result.Ok(sha256_hex(body))
}

# ----------------------------------------------------------------------------
# The instrument — the REAL hls-rss over one workload, --json into a temp
# file, under setarch -R when the platform provides it (the address-space
# layout pinned; the env fingerprint records which mode ran).
# ----------------------------------------------------------------------------

fn which_cmd(name: str) -> bool uses Proc {
    return proc_exec("command -v '" + name + "' >/dev/null 2>&1") == 0
}

fn tmp_path(stem: str, n: int, suffix: str) -> str uses Fs, Proc {
    let mut base: str = "/tmp"
    if env_has("TMPDIR") {
        let t: str = env_get("TMPDIR")
        if t != "" {
            base = t
        }
    }
    return path_join2(base, "." + stem + "-" + n.to_str() + suffix)
}

fn run_hls_rss(root: str, workload_path: str, cycles: int, warmup: int,
interval: float, counter: int) -> Result[JsonValue, Err]
uses Fs, Proc {
    let tmp: str = tmp_path("hlmem-report", counter, ".json")
    let argv: list[str] = [path_abs(workload_path, cwd_get()), "--json",
    tmp, "--cycles", cycles.to_str(), "--warmup", warmup.to_str(),
    "--interval", py_float_repr(interval)]
    let prog: str = path_join2(root, "bin/hls-rss")
    let mut r: HlRun = HlRun {
        code: -1, out: "", err: "", spawned: false
    }
    if which_cmd("setarch") {
        let full: list[str] = ["-R", prog]
        let mut i: int = 0
        while i < argv.len() {
            full.push(argv.get(i))
            i = i + 1
        }
        r = hl_spawn("setarch", full)
    } else {
        r = hl_spawn(prog, argv)
    }
    if r.code != 0 {
        let mut detail: str = last_line_of(r.err)
        if detail == "" {
            detail = last_line_of(r.out)
        }
        if detail == "" {
            detail = "(no output)"
        }
        if r.code == 2 {
            return Result.Err(err2("the instrument refused to run "
            + path_basename(workload_path) + ": " + detail))
        }
        return Result.Err(err1("the workload "
        + path_basename(workload_path) + " did not certify STABLE "
        + "(hls-rss exit " + r.code.to_str() + "): " + detail
        + " — file a bug, not a record"))
    }
    if !file_exists(tmp) {
        return Result.Err(err2("the instrument refused to run "
        + path_basename(workload_path) + ": (no report)"))
    }
    let rr: Result[JsonValue, str] = json_parse_result(read_file(tmp))
    proc_exec("rm -f '" + tmp + "'")
    if result_is_err(rr) {
        return Result.Err(err2("the instrument report is not valid JSON: "
        + result_err_or(rr, "parse error")))
    }
    return Result.Ok(result_unwrap(rr))
}

# ----------------------------------------------------------------------------
# The readings — the MARKER MEDIAN and its companions from one hls-rss
# report. The floor law bites here: a report whose verdict is not stable
# never becomes readings.
# ----------------------------------------------------------------------------

struct Readings {
    marker_rss: int,
    end_rss: int,
    warmup_end_rss: int,
    slope: float,
    slope_lo: float,
    slope_hi: float
}

fn is_pos_int_v(x: JsonValue) -> bool {
    return json_is_int(x) && json_int_value(x) > 0
}

fn is_num_v(x: JsonValue) -> bool {
    return json_is_int(x) || json_is_float(x)
}

fn report_readings(report: JsonValue, place: str)
-> Result[Readings, Err] {
    if !json_is_object(report) || jstr_of(report, "tool") != "hls-rss" {
        let mut toolv: str = "None"
        if json_is_object(report) {
            let t: JsonValue = jget(report, "tool")
            if json_is_str(t) {
                toolv = py_repr_str(json_str_value(t))
            }
        }
        return Result.Err(err2(place + ": not an hls-rss report (tool="
        + toolv + ")"))
    }
    if jstr_of(report, "verdict") != "stable" {
        return Result.Err(err1(place + ": the run certified "
        + py_repr_str(jstr_of(report, "verdict")) + ", not stable — "
        + "the floor law refuses it (file a bug, not a record)"))
    }
    let run_a: JsonValue = jget(report, "run_a")
    if !json_is_object(run_a) {
        return Result.Err(err2(place + ": the report carries no run"))
    }
    let timeline: JsonValue = jget(run_a, "timeline")
    let cps: JsonValue = jget(run_a, "cycle_points")
    if !json_is_array(timeline) || !json_is_array(cps) {
        return Result.Err(err2(place + ": the report's traces are "
        + "malformed"))
    }
    let mut i: int = 0
    while i < timeline.arr.len() {
        let pt: JsonValue = timeline.arr.get(i)
        if !json_is_array(pt) || pt.arr.len() != 2
        || !is_pos_int_v(pt.arr.get(1)) {
            return Result.Err(err2(place + ": a timeline point is "
            + "malformed"))
        }
        i = i + 1
    }
    i = 0
    while i < cps.arr.len() {
        let pt: JsonValue = cps.arr.get(i)
        if !json_is_array(pt) || pt.arr.len() != 3
        || !is_pos_int_v(pt.arr.get(2)) {
            return Result.Err(err2(place + ": a cycle point is "
            + "malformed"))
        }
        i = i + 1
    }
    let warmup_v: JsonValue = jget(jget(report, "config"), "warmup")
    if !is_pos_int_v(warmup_v) {
        return Result.Err(err2(place + ": the report carries no warmup "
        + "plan"))
    }
    let warmup: int = json_int_value(warmup_v)
    if cps.arr.len() == 0 && timeline.arr.len() == 0 {
        return Result.Err(err2(place + ": the report carries no RSS "
        + "readings"))
    }
    # the marker median: cycle-aligned pages over the MEASURED phase
    let marker_pages: list[float] = []
    if cps.arr.len() > 0 {
        let mut ci: int = 0
        while ci < cps.arr.len() {
            let pt: JsonValue = cps.arr.get(ci)
            if json_int_value(pt.arr.get(0)) >= warmup {
                marker_pages.push(json_int_value(pt.arr.get(2)).to_float())
            }
            ci = ci + 1
        }
        if marker_pages.len() == 0 {
            let mut ci2: int = 0
            while ci2 < cps.arr.len() {
                let pt: JsonValue = cps.arr.get(ci2)
                marker_pages.push(json_int_value(pt.arr.get(2)).to_float())
                ci2 = ci2 + 1
            }
        }
    } else {
        let mut ti: int = 0
        while ti < timeline.arr.len() {
            let pt: JsonValue = timeline.arr.get(ti)
            marker_pages.push(json_int_value(pt.arr.get(1)).to_float())
            ti = ti + 1
        }
    }
    let marker_rss: int = median_of(marker_pages).to_int()
    if marker_rss <= 0 {
        return Result.Err(err2(place + ": the marker median is not "
        + "positive"))
    }
    let mut warmup_end: int = marker_rss
    let mut warm_pts: list[int] = []
    if cps.arr.len() > 0 {
        let mut wi: int = 0
        while wi < cps.arr.len() {
            let pt: JsonValue = cps.arr.get(wi)
            if json_int_value(pt.arr.get(0)) < warmup {
                warm_pts.push(json_int_value(pt.arr.get(2)))
            }
            wi = wi + 1
        }
    }
    if warm_pts.len() > 0 {
        warmup_end = warm_pts.get(warm_pts.len() - 1)
    } else if timeline.arr.len() > 0 {
        warmup_end = json_int_value(timeline.arr.get(0).arr.get(1))
    }
    let mut end_rss: int = marker_rss
    if cps.arr.len() > 0 {
        end_rss = json_int_value(
        cps.arr.get(cps.arr.len() - 1).arr.get(2))
    } else if timeline.arr.len() > 0 {
        end_rss = json_int_value(
        timeline.arr.get(timeline.arr.len() - 1).arr.get(1))
    }
    let slope_blk: JsonValue = jget(report, "slope")
    let slope_v: JsonValue = jget(slope_blk, "slope")
    let ci_v: JsonValue = jget(slope_blk, "ci")
    if !is_num_v(slope_v) || !json_is_array(ci_v) || ci_v.arr.len() != 2
    || !is_num_v(ci_v.arr.get(0)) || !is_num_v(ci_v.arr.get(1)) {
        return Result.Err(err2(place + ": a stable report without its "
        + "slope is not a reading"))
    }
    return Result.Ok(Readings {
        marker_rss: marker_rss,
        end_rss: end_rss,
        warmup_end_rss: warmup_end,
        slope: num_or(slope_v, 0.0),
        slope_lo: num_or(ci_v.arr.get(0), 0.0),
        slope_hi: num_or(ci_v.arr.get(1), 0.0)
    })
}

# ----------------------------------------------------------------------------
# obj_with / num_or / replace_all — the small tree helpers.
# ----------------------------------------------------------------------------

fn obj_with(v: JsonValue, key: str, val: JsonValue) -> JsonValue {
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    let mut replaced: bool = false
    while i < v.obj_keys.len() {
        if v.obj_keys.get(i) == key {
            keys.push(key)
            vals.push(val)
            replaced = true
        } else {
            keys.push(v.obj_keys.get(i))
            vals.push(v.obj_vals.get(i))
        }
        i = i + 1
    }
    if !replaced {
        keys.push(key)
        vals.push(val)
    }
    return jobject(keys, vals)
}

fn num_or(v: JsonValue, dflt: float) -> float {
    if json_is_int(v) {
        return json_int_value(v).to_float()
    }
    if json_is_float(v) {
        return json_float_value(v)
    }
    return dflt
}

fn replace_all(s: str, from: str, to: str) -> str {
    if from == "" || !s.contains(from) {
        return s
    }
    let mut out: str = ""
    let mut i: int = 0
    let flen: int = from.len()
    while i < s.len() {
        if i + flen <= s.len() && s.slice(i, i + flen) == from {
            out = out + to
            i = i + flen
        } else {
            out = out + s.slice(i, i + 1)
            i = i + 1
        }
    }
    return out
}

# ----------------------------------------------------------------------------
# The ledger — one JSON object per line, append-only.
# ----------------------------------------------------------------------------

struct Entry {
    line: int,
    v: JsonValue
}

fn load_history(path: str) -> Result[list[Entry], Err] uses Fs {
    if !file_exists(path) {
        return Result.Err(err2("the history ledger " + path
        + " does not exist yet (record something first)"))
    }
    let entries: list[Entry] = []
    let lines: list[str] = read_file(path).split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let lineno: int = i + 1
        let line: str = lines.get(i).trim()
        if line != "" {
            let rr: Result[JsonValue, str] = json_parse_result(line)
            if result_is_err(rr) {
                return Result.Err(err1("history line " + lineno.to_str()
                + " is corrupt (" + result_err_or(rr, "parse error")
                + ") — the ledger is append-only; fix or remove the "
                + "line by hand"))
            }
            let obj: JsonValue = result_unwrap(rr)
            if !json_is_object(obj) || !json_object_has(obj, "type") {
                return Result.Err(err1("history line " + lineno.to_str()
                + " carries no type"))
            }
            let typ: str = jstr_of(obj, "type")
            if typ == "record" {
                let vr: Result[bool, Err] = validate_record(obj,
                "history line " + lineno.to_str())
                if result_is_err(vr) {
                    return Result.Err(result_err_or(vr, err1("")))
                }
            } else if typ == "sanction" {
                let vs: Result[bool, Err] = validate_sanction(obj,
                "history line " + lineno.to_str())
                if result_is_err(vs) {
                    return Result.Err(result_err_or(vs, err1("")))
                }
            } else {
                return Result.Err(err1("history line " + lineno.to_str()
                + " has unknown type " + py_repr_str(typ)))
            }
            entries.push(Entry {
                line: lineno, v: obj
            })
        }
        i = i + 1
    }
    return Result.Ok(entries)
}

fn workload_names_sorted(rec: JsonValue) -> list[str] {
    let wls: JsonValue = jget(rec, "workloads")
    let names: list[str] = []
    if json_is_object(wls) {
        let mut i: int = 0
        while i < wls.obj_keys.len() {
            names.push(wls.obj_keys.get(i))
            i = i + 1
        }
    }
    return sort_strs(names)
}

fn marker_pages_of(rec: JsonValue, name: str) -> list[float] {
    let out: list[float] = []
    let wls: JsonValue = jget(rec, "workloads")
    if !json_is_object(wls) {
        return out
    }
    let w: JsonValue = json_object_get(wls, name)
    if !json_is_object(w) {
        return out
    }
    let mr: JsonValue = jget(w, "marker_rss_pages")
    if !json_is_array(mr) {
        return out
    }
    let mut i: int = 0
    while i < mr.arr.len() {
        let x: JsonValue = mr.arr.get(i)
        if json_is_int(x) {
            out.push(json_int_value(x).to_float())
        } else if json_is_float(x) {
            out.push(json_float_value(x))
        }
        i = i + 1
    }
    return out
}

fn validate_record(rec: JsonValue, place: str) -> Result[bool, Err] {
    let commit: str = jstr_of(rec, "commit")
    if commit == "" || !is_sha1(commit) {
        return Result.Err(err1(place + ": a record without a 40-hex "
        + "commit pin is not a per-commit record"))
    }
    if jstr_of(rec, "suite") == "" {
        return Result.Err(err1(place + ": a record without its suite path "
        + "cannot be re-baselined honestly"))
    }
    let sd: str = jstr_of(rec, "suite_digest")
    if sd == "" || !is_sha256(sd) {
        return Result.Err(err1(place + ": a record without a suite "
        + "digest cannot be compared"))
    }
    let plan: JsonValue = jget(rec, "plan")
    if !json_is_object(plan) || !json_object_has(plan, "cycles")
    || !json_object_has(plan, "warmup")
    || !json_object_has(plan, "interval")
    || !json_object_has(plan, "samples") {
        return Result.Err(err1(place + ": a record without its pinned "
        + "measurement plan cannot be judged"))
    }
    let envo: JsonValue = jget(rec, "env")
    let psz: JsonValue = jget(envo, "page_size")
    if !json_is_object(envo) || !is_pos_int_v(psz) {
        return Result.Err(err1(place + ": a record without its page size "
        + "is a record without its unit"))
    }
    let noise_v: JsonValue = jget(rec, "noise_pct")
    let floor_v: JsonValue = jget(rec, "floor_pages")
    if !is_num_v(noise_v) || !is_num_v(floor_v)
    || num_or(floor_v, 0.0) < 0.0 {
        return Result.Err(err1(place + ": a record without its noise band "
        + "(percent and page floor) cannot classify anything"))
    }
    let wls: JsonValue = jget(rec, "workloads")
    if !json_is_object(wls) || wls.obj_keys.len() == 0 {
        return Result.Err(err1(place + ": a record with no workloads "
        + "measured nothing"))
    }
    let names: list[str] = workload_names_sorted(rec)
    let mut i: int = 0
    while i < names.len() {
        let name: str = names.get(i)
        let w: JsonValue = json_object_get(wls, name)
        let mr: JsonValue = jget(w, "marker_rss_pages")
        if !json_is_array(mr) || mr.arr.len() < min_samples() {
            return Result.Err(err1(place + ": workload " + name
            + " carries fewer than " + min_samples().to_str()
            + " samples — a median no sample supports is not a "
            + "measurement"))
        }
        let mut j: int = 0
        while j < mr.arr.len() {
            if !is_pos_int_v(mr.arr.get(j)) {
                return Result.Err(err1(place + ": workload " + name
                + " has a non-positive marker reading"))
            }
            j = j + 1
        }
        # end / warmup-end readings must match the marker sample count
        let pair_keys: list[str] = ["end_rss_pages", "warmup_end_rss_pages"]
        let mut pk: int = 0
        while pk < pair_keys.len() {
            let key: str = pair_keys.get(pk)
            let xs: JsonValue = jget(w, key)
            let mut ok: bool = json_is_array(xs)
            && xs.arr.len() == mr.arr.len()
            if ok {
                let mut xi: int = 0
                while xi < xs.arr.len() {
                    if !is_pos_int_v(xs.arr.get(xi)) {
                        ok = false
                    }
                    xi = xi + 1
                }
            }
            if !ok {
                let label: str = key.slice(0, key.len() - 6)
                return Result.Err(err1(place + ": workload " + name
                + " carries " + label + " readings that do not match "
                + "its " + mr.arr.len().to_str() + " marker samples"))
            }
            pk = pk + 1
        }
        let slopes: JsonValue = jget(w, "slope_pages_per_cycle")
        let slopes_ok: bool = json_is_array(slopes)
        && slopes.arr.len() == mr.arr.len()
        if !slopes_ok {
            return Result.Err(err1(place + ": workload " + name
            + " carries slopes that do not match its samples"))
        }
        let mut si: int = 0
        while si < slopes.arr.len() {
            if !is_num_v(slopes.arr.get(si)) {
                return Result.Err(err1(place + ": workload " + name
                + " carries slopes that do not match its samples"))
            }
            si = si + 1
        }
        let cis: JsonValue = jget(w, "slope_ci_pages")
        let cis_ok: bool = json_is_array(cis)
        && cis.arr.len() == mr.arr.len()
        if !cis_ok {
            return Result.Err(err1(place + ": workload " + name
            + " carries slope intervals that do not match its "
            + "samples"))
        }
        let mut ci: int = 0
        while ci < cis.arr.len() {
            let c: JsonValue = cis.arr.get(ci)
            let c_ok: bool = json_is_array(c) && c.arr.len() == 2
            && is_num_v(c.arr.get(0)) && is_num_v(c.arr.get(1))
            && num_or(c.arr.get(0), 0.0) <= num_or(c.arr.get(1), 0.0)
            if !c_ok {
                return Result.Err(err1(place + ": workload " + name
                + " carries slope intervals that do not match its "
                + "samples"))
            }
            ci = ci + 1
        }
        if jstr_of(w, "hls_rss_verdict") != "stable" {
            return Result.Err(err1(place + ": workload " + name
            + " did not certify stable under hls-rss — the floor law "
            + "refuses it (file a bug, not a record)"))
        }
        i = i + 1
    }
    return Result.Ok(true)
}

fn validate_sanction(s: JsonValue, place: str) -> Result[bool, Err] {
    if jstr_of(s, "workload") == "" {
        return Result.Err(err1(place + ": a sanction without a workload"))
    }
    if jstr_of(s, "reason") == "" {
        return Result.Err(err1(place + ": a sanction without a written "
        + "reason is not a sanction"))
    }
    return Result.Ok(true)
}

fn append_entry(path: str, entry: JsonValue) -> Result[bool, Err]
uses Fs, Proc {
    let ap: str = path_abs(path, cwd_get())
    let d: str = path_dirname(ap)
    if d != "" && d != "." && !fs_is_dir(d) {
        let rc: int = proc_exec("mkdir -p '" + d + "'")
        if rc != 0 {
            return Result.Err(err2("cannot create the ledger directory "
            + d))
        }
    }
    let line: str = compact_json(entry) + "\n"
    let mut body: str = ""
    if file_exists(ap) {
        body = read_file(ap)
    }
    write_file(ap, body + line)
    return Result.Ok(true)
}

fn records_of(entries: list[Entry]) -> list[Entry] {
    let out: list[Entry] = []
    let mut i: int = 0
    while i < entries.len() {
        if jstr_of(entries.get(i).v, "type") == "record" {
            out.push(entries.get(i))
        }
        i = i + 1
    }
    return out
}

fn sanctions_of(entries: list[Entry]) -> list[Entry] {
    let out: list[Entry] = []
    let mut i: int = 0
    while i < entries.len() {
        if jstr_of(entries.get(i).v, "type") == "sanction" {
            out.push(entries.get(i))
        }
        i = i + 1
    }
    return out
}

fn page_size_of(rec: JsonValue) -> int {
    let psz: JsonValue = jget(jget(rec, "env"), "page_size")
    if json_is_int(psz) {
        return json_int_value(psz)
    }
    return 0
}

# ----------------------------------------------------------------------------
# The classification law — the page law: the seeded bootstrap CI of the
# median marker-RSS change against the floored band; significance is the
# CI itself excluding zero (no Welch — RSS is integer pages, often with
# zero variance, and a t-test would call deterministic growth no-change).
# ----------------------------------------------------------------------------

struct ClassOut {
    class: str,
    point_pages: float,
    point_pct: float,
    ci_lo: float,
    ci_hi: float,
    band: float,
    cur_med: float,
    base_med: float
}

fn classify(cur_est: list[float], base_est: list[float],
workload_key: str, noise_pct: float, floor_pages: float)
-> Result[ClassOut, Err] {
    if cur_est.len() < min_samples() || base_est.len() < min_samples() {
        return Result.Err(err1("classification needs >= "
        + min_samples().to_str() + " samples per side (workload "
        + workload_key + ")"))
    }
    let cur_med: float = median_of(cur_est)
    let base_med: float = median_of(base_est)
    if base_med <= 0.0 {
        return Result.Err(err1("baseline median is not positive "
        + "(workload " + workload_key + ")"))
    }
    let mut band: float = floor_pages
    let pct_band: float = base_med * noise_pct / 100.0
    if pct_band > band {
        band = pct_band
    }
    let point_pages: float = cur_med - base_med
    let point_pct: float = point_pages / base_med * 100.0
    let mut st: int = rng_seed_of(workload_key)
    let nb: int = base_est.len()
    let diffs: list[float] = []
    let mut bi: int = 0
    while bi < bootstrap_b() {
        let cs: list[float] = []
        let mut ci: int = 0
        while ci < cur_est.len() {
            st = xs_next(st)
            cs.push(cur_est.get(xs_pick(st, cur_est.len())))
            ci = ci + 1
        }
        let bs: list[float] = []
        let mut di: int = 0
        while di < nb {
            st = xs_next(st)
            bs.push(base_est.get(xs_pick(st, nb)))
            di = di + 1
        }
        diffs.push(median_of(cs) - median_of(bs))
        bi = bi + 1
    }
    let sorted: list[float] = sort_floats(diffs)
    let lo: float = quantile_of(sorted, 0.025)
    let hi: float = quantile_of(sorted, 0.975)
    let significant: bool = lo > 0.0 || hi < 0.0
    let mut klass: str = "within-noise"
    if !significant {
        klass = "no-change"
    } else if lo > band {
        klass = "regressed"
    } else if hi < 0.0 - band {
        klass = "improved"
    }
    return Result.Ok(ClassOut {
        class: klass, point_pages: point_pages, point_pct: point_pct,
        ci_lo: lo, ci_hi: hi, band: band,
        cur_med: cur_med, base_med: base_med
    })
}

# ----------------------------------------------------------------------------
# pick_baseline + verdict_of — the unit law (suite digest AND page size)
# and the full machine verdict.
# ----------------------------------------------------------------------------

fn pick_baseline(new_rec: Entry, entries: list[Entry], want: str)
-> Result[Entry, Err] {
    let recs: list[Entry] = records_of(entries)
    let mut idx: int = 0
    let mut i: int = 0
    while i < recs.len() {
        if recs.get(i).line == new_rec.line {
            idx = i
        }
        i = i + 1
    }
    if want != "" {
        let cands: list[Entry] = []
        i = 0
        while i < recs.len() {
            if jstr_of(recs.get(i).v, "commit").starts_with(want) {
                cands.push(recs.get(i))
            }
            i = i + 1
        }
        if cands.len() == 0 {
            return Result.Err(err2("no record carries commit prefix "
            + py_repr_str(want)))
        }
        if cands.len() > 1 {
            return Result.Err(err2("commit prefix " + py_repr_str(want)
            + " is ambiguous (" + cands.len().to_str() + " records)"))
        }
        let base0: Entry = cands.get(0)
        if base0.line == new_rec.line {
            return Result.Err(err2("the baseline is the record itself "
            + "— a record does not regress against itself"))
        }
        return check_baseline(base0, new_rec)
    }
    let earlier: list[Entry] = []
    i = 0
    while i < idx {
        let r: Entry = recs.get(i)
        if jstr_of(r.v, "suite_digest") == jstr_of(new_rec.v, "suite_digest")
        && page_size_of(r.v) == page_size_of(new_rec.v) {
            earlier.push(r)
        }
        i = i + 1
    }
    if earlier.len() == 0 {
        return Result.Err(err2("no earlier record of the same instrument "
        + "to compare against (suite_digest="
        + take_s(jstr_of(new_rec.v, "suite_digest"), 12)
        + ", page_size=" + page_size_of(new_rec.v).to_str()
        + ") — record one first"))
    }
    return check_baseline(earlier.get(earlier.len() - 1), new_rec)
}

# check_baseline(base, new_rec) — the unit law, for BOTH paths.
fn check_baseline(base: Entry, new_rec: Entry) -> Result[Entry, Err] {
    if jstr_of(base.v, "suite_digest") != jstr_of(new_rec.v, "suite_digest") {
        return Result.Err(err1("the suite changed since the baseline "
        + "(digest " + take_s(jstr_of(base.v, "suite_digest"), 12)
        + " vs " + take_s(jstr_of(new_rec.v, "suite_digest"), 12)
        + ") — re-baseline, do not compare"))
    }
    let bps: int = page_size_of(base.v)
    let nps: int = page_size_of(new_rec.v)
    if bps != nps {
        return Result.Err(err1("different units: the baseline's page is "
        + bps.to_str() + " bytes, the record's is " + nps.to_str()
        + " — a page is the unit RSS moves in; re-baseline on this "
        + "machine"))
    }
    return Result.Ok(base)
}

fn active_sanction(entries: list[Entry], name: str) -> Option[Entry] {
    let sancs: list[Entry] = sanctions_of(entries)
    let mut i: int = 0
    while i < sancs.len() {
        if jstr_of(sancs.get(i).v, "workload") == name {
            return Option.Some(sancs.get(i))
        }
        i = i + 1
    }
    return Option.None
}

fn verdict_of(entries: list[Entry], baseline: str, noise_pct: float,
floor_pages: float) -> Result[JsonValue, Err] {
    let recs: list[Entry] = records_of(entries)
    if recs.len() == 0 {
        return Result.Err(err2("the ledger carries no records — nothing "
        + "to gate"))
    }
    let new_rec: Entry = recs.get(recs.len() - 1)
    let base_r: Result[Entry, Err] = pick_baseline(new_rec, entries,
    baseline)
    if result_is_err(base_r) {
        return Result.Err(result_err_or(base_r, err1("")))
    }
    let base_rec: Entry = result_unwrap(base_r)

    let new_names: list[str] = workload_names_sorted(new_rec.v)
    let base_names: list[str] = workload_names_sorted(base_rec.v)
    let all_names: list[str] = []
    let mut i: int = 0
    while i < new_names.len() {
        all_names.push(new_names.get(i))
        i = i + 1
    }
    i = 0
    while i < base_names.len() {
        let n: str = base_names.get(i)
        let mut found: bool = false
        let mut j: int = 0
        while j < all_names.len() {
            if all_names.get(j) == n {
                found = true
            }
            j = j + 1
        }
        if !found {
            all_names.push(n)
        }
        i = i + 1
    }
    let names: list[str] = sort_strs(all_names)

    let rows: list[JsonValue] = []
    let mut ri: int = 0
    while ri < names.len() {
        let name: str = names.get(ri)
        let in_new: bool = json_object_has(jget(new_rec.v, "workloads"),
        name)
        let in_base: bool = json_object_has(jget(base_rec.v, "workloads"),
        name)
        let mut row: JsonValue = json_null()
        if in_new && in_base {
            let cr: Result[ClassOut, Err] = classify(
            marker_pages_of(new_rec.v, name),
            marker_pages_of(base_rec.v, name), name, noise_pct,
            floor_pages)
            if result_is_err(cr) {
                return Result.Err(result_err_or(cr, err1("")))
            }
            let c: ClassOut = result_unwrap(cr)
            let samples_count: JsonValue = jget(json_object_get(
            jget(new_rec.v, "workloads"), name), "samples")
            row = jobject(["workload", "class", "point_pages",
            "point_pct", "ci_pages", "band_pages",
            "cur_median_pages", "base_median_pages", "samples"],
            [json_str(name), json_str(c.class),
            json_float(c.point_pages), json_float(c.point_pct),
            jarr([json_float(c.ci_lo), json_float(c.ci_hi)]),
            json_float(c.band),
            json_float(c.cur_med), json_float(c.base_med),
            samples_count])
        } else if in_new {
            let med: float = median_of(marker_pages_of(new_rec.v, name))
            row = jobject(["workload", "class", "cur_median_pages"],
            [json_str(name), json_str("new"), json_float(med)])
        } else {
            row = jobject(["workload", "class"],
            [json_str(name), json_str("vanished")])
        }
        let klass: str = jstr_of(row, "class")
        if klass == "regressed" || klass == "vanished" {
            let s: Option[Entry] = active_sanction(entries, name)
            if option_is_some(s) {
                let sv: JsonValue = option_unwrap(s).v
                let sanc: JsonValue = jobject(["reason", "author",
                "commit"],
                [jget(sv, "reason"), jget(sv, "author"),
                jget(sv, "commit")])
                row = obj_with(row, "sanction", sanc)
            }
        }
        rows.push(row)
        ri = ri + 1
    }

    let sanctioned: list[str] = []
    let unsanctioned: list[str] = []
    let mut si: int = 0
    while si < rows.len() {
        let r: JsonValue = rows.get(si)
        let klass: str = jstr_of(r, "class")
        if klass == "regressed" || klass == "vanished" {
            if json_is_object(jget(r, "sanction")) {
                sanctioned.push(jstr_of(r, "workload"))
            } else {
                unsanctioned.push(jstr_of(r, "workload"))
            }
        }
        si = si + 1
    }
    let mut verdict: str = "fail"
    if unsanctioned.len() == 0 {
        verdict = "pass"
    }
    let san_sorted: list[str] = sort_strs(sanctioned)
    let uns_sorted: list[str] = sort_strs(unsanctioned)
    let san_vals: list[JsonValue] = []
    let mut si2: int = 0
    while si2 < san_sorted.len() {
        san_vals.push(json_str(san_sorted.get(si2)))
        si2 = si2 + 1
    }
    let uns_vals: list[JsonValue] = []
    let mut ui: int = 0
    while ui < uns_sorted.len() {
        uns_vals.push(json_str(uns_sorted.get(ui)))
        ui = ui + 1
    }
    return Result.Ok(jobject(["tool", "version", "verdict", "record",
    "baseline", "suite", "page_size", "noise_pct", "floor_pages",
    "workloads", "sanctioned", "unsanctioned"],
    [json_str(tool_name()), json_str(tool_version()),
    json_str(verdict), json_str(jstr_of(new_rec.v, "commit")),
    json_str(jstr_of(base_rec.v, "commit")),
    json_str(jstr_of(new_rec.v, "suite")),
    json_int(page_size_of(new_rec.v)),
    json_float(noise_pct), json_float(floor_pages), jarr(rows),
    jarr(san_vals), jarr(uns_vals)]))
}

# ----------------------------------------------------------------------------
# The dashboard — the deterministic render of the ledger (MEMORY.md).
# ----------------------------------------------------------------------------

fn fmt_pg(n: float) -> str {
    return n.to_int().to_str() + " pg"
}

fn fmt_signed_f1(x: float) -> str {
    let mut sign: str = ""
    if x >= 0.0 {
        sign = "+"
    }
    return sign + fmt_fixed(x, 1)
}

fn fmt_change(point_pages: float, point_pct: float) -> str {
    let mut sign: str = ""
    if point_pages >= 0.0 {
        sign = "+"
    }
    return sign + point_pages.to_int().to_str() + " pg ("
    + fmt_pct(point_pct) + ")"
}

fn fmt_slope_kc(v: float) -> str {
    let s: str = fmt_fixed(v * 1000.0, 1)
    if v > 0.0 {
        return "+" + s
    }
    return s
}

fn sparkline(medians: list[float]) -> str {
    if medians.len() == 0 {
        return ""
    }
    let mut lo: float = medians.get(0)
    let mut hi: float = medians.get(0)
    let mut i: int = 0
    while i < medians.len() {
        if medians.get(i) < lo {
            lo = medians.get(i)
        }
        if medians.get(i) > hi {
            hi = medians.get(i)
        }
        i = i + 1
    }
    if hi <= lo {
        return repeat_str(spark_mid(), medians.len())
    }
    let span: float = hi - lo
    let mut out: str = ""
    i = 0
    while i < medians.len() {
        let v: float = medians.get(i)
        let t: float = ((v - lo) * 14.0 + span) / (2.0 * span)
        let band: int = (t - (t % 1.0)).to_int()
        out = out + spark_bands().slice(band * 3, band * 3 + 3)
        i = i + 1
    }
    return out
}

fn render_dashboard(entries: list[Entry], history_path: str, limit: int,
stamp: str) -> Result[str, Err] uses Fs {
    let recs: list[Entry] = records_of(entries)
    if recs.len() == 0 {
        return Result.Err(err2("the ledger carries no records — nothing "
        + "to render"))
    }
    if !file_exists(history_path) {
        return Result.Err(err2("cannot read the ledger: "
        + history_path))
    }
    let digest: str = sha256_hex(read_file(history_path))
    let new_rec: Entry = recs.get(recs.len() - 1)
    let vr: Result[JsonValue, Err] = verdict_of(entries, "",
    default_noise_pct(), default_floor_pages())
    let has_verdict: bool = result_is_ok(vr)
    let mut verdict: JsonValue = json_null()
    let mut base: Entry = new_rec
    if has_verdict {
        verdict = result_unwrap(vr)
        base = result_unwrap(pick_baseline(new_rec, entries, ""))
    }

    let workload_names: list[str] = workload_names_sorted(new_rec.v)
    let mut shown: list[Entry] = recs
    if limit > 0 && recs.len() > limit {
        shown = []
        let mut i: int = recs.len() - limit
        while i < recs.len() {
            shown.push(recs.get(i))
            i = i + 1
        }
    }

    let lines: list[str] = []
    lines.push("# HLS memory dashboard")
    lines.push("")
    lines.push("- Tool: " + tool_name() + " " + tool_version())
    lines.push("- Ledger: `" + history_path + "` (sha256 `" + digest
    + "`)")
    lines.push("- Records: " + recs.len().to_str() + " (showing "
    + shown.len().to_str() + ")")
    lines.push("- Newest record: `" + jstr_of(new_rec.v, "commit") + "` ("
    + workload_names.len().to_str() + " workloads)")
    if has_verdict {
        lines.push("- Baseline: `" + jstr_of(base.v, "commit") + "`")
    } else {
        lines.push("- Baseline: none (no earlier record of this "
        + "instrument)")
    }
    if has_verdict {
        lines.push("- Gate verdict: **" + jstr_of(verdict, "verdict")
        + "**")
        let uns: list[str] = []
        let uns_arr: JsonValue = jget(verdict, "unsanctioned")
        if json_is_array(uns_arr) {
            let mut i: int = 0
            while i < uns_arr.arr.len() {
                uns.push(json_str_value(uns_arr.arr.get(i)))
                i = i + 1
            }
        }
        if uns.len() > 0 {
            lines.push("- Unsanctioned: " + str_join(uns, ", "))
        }
    } else {
        lines.push("- Gate verdict: n/a (no earlier record of this "
        + "instrument to compare against)")
    }
    if stamp != "" {
        lines.push("- Generated: " + stamp)
    }
    lines.push("")
    lines.push("## Verdicts (newest record vs baseline)")
    lines.push("")
    if !has_verdict {
        lines.push("No comparison yet: the newest record is the first of "
        + "its instrument. Record twice and the verdict table fills.")
    } else {
        lines.push("| workload | base | now | change | band | 95% CI | "
        + "class |")
        lines.push("|---|---|---|---|---|---|---|")
        let rows: JsonValue = jget(verdict, "workloads")
        let mut i: int = 0
        while i < rows.arr.len() {
            let r: JsonValue = rows.arr.get(i)
            let klass: str = jstr_of(r, "class")
            let mut sanc_note: str = ""
            if json_is_object(jget(r, "sanction")) {
                sanc_note = " (sanctioned)"
            }
            if klass == "no-change" || klass == "within-noise"
            || klass == "improved" || klass == "regressed" {
                let ci: JsonValue = jget(r, "ci_pages")
                let mut lo: float = 0.0
                let mut hi: float = 0.0
                if json_is_array(ci) && ci.arr.len() == 2 {
                    lo = json_float_value(ci.arr.get(0))
                    hi = json_float_value(ci.arr.get(1))
                }
                lines.push("| " + jstr_of(r, "workload") + " | "
                + fmt_pg(num_or(jget(r, "base_median_pages"), 0.0))
                + " | "
                + fmt_pg(num_or(jget(r, "cur_median_pages"), 0.0))
                + " | "
                + fmt_change(num_or(jget(r, "point_pages"), 0.0),
                num_or(jget(r, "point_pct"), 0.0))
                + " | "
                + fmt_fixed(num_or(jget(r, "band_pages"), 0.0), 1)
                + " pg | [" + fmt_signed_f1(lo) + " "
                + fmt_signed_f1(hi) + "] pg | " + klass + sanc_note
                + " |")
            } else if klass == "new" {
                lines.push("| " + jstr_of(r, "workload") + " | — | "
                + fmt_pg(num_or(jget(r, "cur_median_pages"), 0.0))
                + " | — | — | — | new |")
            } else {
                lines.push("| " + jstr_of(r, "workload")
                + " | (gone) | — | — | — | — | vanished |")
            }
            i = i + 1
        }
    }
    lines.push("")
    lines.push("## Trends — resident set at markers (pages, oldest to "
    + "newest)")
    lines.push("")
    let head_cells: list[str] = []
    let mut i2: int = 0
    while i2 < shown.len() {
        head_cells.push(take_s(jstr_of(shown.get(i2).v, "commit"), 7))
        i2 = i2 + 1
    }
    lines.push("| workload | trend | " + str_join(head_cells, " | ")
    + " |")
    lines.push("|---|---|" + repeat_str("---|", shown.len()))
    let mut ni: int = 0
    while ni < workload_names.len() {
        let name: str = workload_names.get(ni)
        let series: list[float] = []
        let known_flags: list[bool] = []
        let mut i: int = 0
        while i < shown.len() {
            let w: JsonValue = json_object_get(
            jget(shown.get(i).v, "workloads"), name)
            if json_is_object(w) {
                let mr: JsonValue = jget(w, "marker_rss_pages")
                if json_is_array(mr) && mr.arr.len() > 0 {
                    known_flags.push(true)
                    series.push(median_of(marker_pages_of(
                    shown.get(i).v, name)))
                } else {
                    known_flags.push(false)
                    series.push(0.0)
                }
            } else {
                known_flags.push(false)
                series.push(0.0)
            }
            i = i + 1
        }
        let known: list[float] = []
        let mut ki: int = 0
        while ki < series.len() {
            if known_flags.get(ki) {
                known.push(series.get(ki))
            }
            ki = ki + 1
        }
        let mut spark: str = "-"
        if known.len() > 0 {
            spark = sparkline(known)
        }
        let cells: list[str] = []
        let mut ci: int = 0
        while ci < series.len() {
            if known_flags.get(ci) {
                cells.push(fmt_pg(series.get(ci)))
            } else {
                cells.push("—")
            }
            ci = ci + 1
        }
        lines.push("| " + name + " | " + spark + " | "
        + str_join(cells, " | ") + " |")
        ni = ni + 1
    }
    lines.push("")
    lines.push("## Slope watch (newest record — pages per 1000 cycles, "
    + "leak threshold "
    + fmt_fixed(leak_slope_threshold() * 1000.0, 1) + ")")
    lines.push("")
    lines.push("| workload | slope | 95% CI |")
    lines.push("|---|---|---|")
    let mut swi: int = 0
    while swi < workload_names.len() {
        let name: str = workload_names.get(swi)
        let w: JsonValue = json_object_get(jget(new_rec.v, "workloads"),
        name)
        let slopes: JsonValue = jget(w, "slope_pages_per_cycle")
        let cis: JsonValue = jget(w, "slope_ci_pages")
        let mut lo: float = 0.0
        let mut hi: float = 0.0
        if json_is_array(cis) && cis.arr.len() > 0 {
            lo = num_or(cis.arr.get(0).arr.get(0), 0.0)
            hi = num_or(cis.arr.get(0).arr.get(1), 0.0)
            let mut xi: int = 0
            while xi < cis.arr.len() {
                let c: JsonValue = cis.arr.get(xi)
                let clo: float = num_or(c.arr.get(0), 0.0)
                let chi: float = num_or(c.arr.get(1), 0.0)
                if clo < lo {
                    lo = clo
                }
                if chi > hi {
                    hi = chi
                }
                xi = xi + 1
            }
        }
        let slope_list: list[float] = []
        if json_is_array(slopes) {
            let mut xi: int = 0
            while xi < slopes.arr.len() {
                slope_list.push(num_or(slopes.arr.get(xi), 0.0))
                xi = xi + 1
            }
        }
        lines.push("| " + name + " | " + fmt_slope_kc(median_of(slope_list))
        + " | [" + fmt_slope_kc(lo) + " " + fmt_slope_kc(hi) + "] |")
        swi = swi + 1
    }
    lines.push("")
    lines.push("## Sanctions")
    lines.push("")
    let sancs: list[Entry] = sanctions_of(entries)
    if sancs.len() == 0 {
        lines.push("None. Every regression the ledger has seen was "
        + "answered, not excused.")
    } else {
        lines.push("| workload | author | commit | reason |")
        lines.push("|---|---|---|---|")
        let seen_keys: list[str] = []
        let mut si: int = 0
        while si < sancs.len() {
            let sv: JsonValue = sancs.get(si).v
            let key: str = jstr_of(sv, "workload") + "\n"
            + jstr_of(sv, "reason")
            let mut dup: bool = false
            let mut di: int = 0
            while di < seen_keys.len() {
                if seen_keys.get(di) == key {
                    dup = true
                }
                di = di + 1
            }
            if !dup {
                seen_keys.push(key)
                let mut author: str = jstr_of(sv, "author")
                if author == "" {
                    author = "unknown"
                }
                let mut commit_cell: str = "—"
                let cv: JsonValue = jget(sv, "commit")
                if json_is_str(cv) && json_str_value(cv) != "" {
                    commit_cell = "`" + take_s(json_str_value(cv), 10)
                    + "`"
                }
                let reason: str = replace_all(jstr_of(sv, "reason"), "|",
                "\\|")
                lines.push("| " + jstr_of(sv, "workload") + " | " + author
                + " | " + commit_cell + " | " + reason + " |")
            }
            si = si + 1
        }
    }
    lines.push("")
    lines.push("## Reading this dashboard")
    lines.push("")
    lines.push("- A record is one hls-rss measurement of the tracked "
    + "suite pinned to one clean commit; every workload must certify "
    + "STABLE before it can be filed (the floor law — a canary that "
    + "leaks is a bug, not a record), and the ledger is append-only. "
    + "This document is a pure render of it (the sha256 above pins "
    + "the bytes).")
    lines.push("- The metric is the marker median — the resident set at "
    + "the cycle markers, the steady level the workload stands on "
    + "(the tracked suite holds its peak live at its markers, so "
    + "this IS the footprint; a sampled maximum would be a lottery "
    + "over transient spikes that recede). Classes follow the page "
    + "law: significance is the seeded bootstrap CI of the median "
    + "change excluding zero (RSS is integer pages, often with zero "
    + "variance — a t-test would call a deterministic growth "
    + "no-change), and the noise band is floored at 16 pages because "
    + "a percent of a small footprint is a fraction of the page RSS "
    + "moves in.")
    lines.push("- The instrument runs under setarch -R when the "
    + "platform provides it (address-space randomization off — the "
    + "env fingerprint records the mode): the resident set reflects "
    + "the code, not the loader's dice.")
    lines.push("- regressed or vanished workloads fail the gate unless "
    + "a sanction names them. A sanction is a written excuse with "
    + "an author — the register above is the audit trail.")
    lines.push("- The unit law: the ledger never compares across page "
    + "sizes or across suite digests — a page is a unit, and a "
    + "changed suite is re-baselined, not compared.")
    lines.push("- The slope watch restates each workload's hls-rss "
    + "timeline slope (pages per 1000 cycles) against the "
    + "instrument's own 0.25 page/cycle leak threshold — the floor "
    + "law's other half, trended so a slow creep cannot hide behind "
    + "a green gate.")
    lines.push("")
    return Result.Ok(str_join(lines, "\n"))
}

# ----------------------------------------------------------------------------
# The CLI — the .py's argparse surface (usage errors exit 2).
# ----------------------------------------------------------------------------

struct Cli {
    cmd: str,
    root: str,
    suite: str,
    samples: int,
    cycles: int,
    warmup: int,
    has_warmup: bool,
    interval: float,
    from_bundle: str,
    commit: str,
    note: str,
    allow_dirty: bool,
    stamp: bool,
    history: str,
    json_out: str,
    workload: str,
    reason: str,
    author: str,
    baseline: str,
    threshold: float,
    floor: float,
    quiet: bool,
    out: str,
    limit: int,
    workload_filter: str,
    json_flag: bool
}

fn usage_error() -> int uses IO {
    eprintln("usage: hls-mem {record|sanction|gate|dashboard|history} "
    + "[options]")
    return 2
}

fn need_int(val: str, flag: str) -> Result[int, Err] {
    let v: Option[int] = parse_int_opt(val)
    if option_is_none(v) {
        return Result.Err(err2("invalid int value: '" + val + "' ("
        + flag + ")"))
    }
    return Result.Ok(option_unwrap(v))
}

fn need_float(val: str, flag: str) -> Result[float, Err] {
    let v: Option[float] = parse_float_opt(val)
    if option_is_none(v) {
        return Result.Err(err2("invalid float value: '" + val + "' ("
        + flag + ")"))
    }
    return Result.Ok(option_unwrap(v))
}

fn parse_cli(argv: list[str]) -> Result[Cli, Err] {
    if argv.len() < 2 {
        return Result.Err(err2("usage"))
    }
    let c: Cli = Cli {
        cmd: argv.get(1),
        root: "",
        suite: default_suite(),
        samples: default_samples(),
        cycles: default_cycles(),
        warmup: 0,
        has_warmup: false,
        interval: default_interval(),
        from_bundle: "",
        commit: "",
        note: "",
        allow_dirty: false,
        stamp: false,
        history: "",
        json_out: "",
        workload: "",
        reason: "",
        author: "",
        baseline: "",
        threshold: default_noise_pct(),
        floor: default_floor_pages(),
        quiet: false,
        out: "",
        limit: default_dash_limit(),
        workload_filter: "",
        json_flag: false
    }
    let known: list[str] = ["record", "sanction", "gate", "dashboard",
    "history"]
    let mut is_known: bool = false
    let mut k: int = 0
    while k < known.len() {
        if known.get(k) == c.cmd {
            is_known = true
        }
        k = k + 1
    }
    if !is_known {
        return Result.Err(err2("usage"))
    }
    let mut i: int = 2
    while i < argv.len() {
        let a: str = argv.get(i)
        if a == "--json" {
            # history's --json is a flag; every other subcommand's is a
            # path (the .py's argparse shapes).
            if c.cmd == "history" {
                c.json_flag = true
                i = i + 1
            } else {
                if i + 1 >= argv.len() {
                    return Result.Err(err2("usage: --json expects a value"))
                }
                c.json_out = argv.get(i + 1)
                i = i + 2
            }
        } else if a == "--root" || a == "--suite" || a == "--note"
        || a == "--from-bundle" || a == "--commit"
        || a == "--history" || a == "--reason" || a == "--author"
        || a == "--baseline" || a == "--threshold" || a == "--floor"
        || a == "--out" || a == "--limit" || a == "--workload"
        || a == "--samples" || a == "--cycles" || a == "--warmup"
        || a == "--interval" {
            if i + 1 >= argv.len() {
                return Result.Err(err2("usage: " + a + " expects a value"))
            }
            let val: str = argv.get(i + 1)
            if a == "--root" {
                c.root = val
            } else if a == "--suite" {
                c.suite = val
            } else if a == "--note" {
                c.note = val
            } else if a == "--from-bundle" {
                c.from_bundle = val
            } else if a == "--commit" {
                c.commit = val
            } else if a == "--history" {
                c.history = val
            } else if a == "--reason" {
                c.reason = val
            } else if a == "--author" {
                c.author = val
            } else if a == "--baseline" {
                c.baseline = val
            } else if a == "--threshold" {
                let fv: Result[float, Err] = need_float(val, a)
                if result_is_err(fv) {
                    return Result.Err(result_err_or(fv, err2("")))
                }
                c.threshold = result_unwrap(fv)
            } else if a == "--floor" {
                let fv: Result[float, Err] = need_float(val, a)
                if result_is_err(fv) {
                    return Result.Err(result_err_or(fv, err2("")))
                }
                c.floor = result_unwrap(fv)
            } else if a == "--out" {
                c.out = val
            } else if a == "--limit" {
                let iv: Result[int, Err] = need_int(val, a)
                if result_is_err(iv) {
                    return Result.Err(result_err_or(iv, err2("")))
                }
                c.limit = result_unwrap(iv)
            } else if a == "--workload" {
                c.workload_filter = val
            } else if a == "--samples" {
                let iv: Result[int, Err] = need_int(val, a)
                if result_is_err(iv) {
                    return Result.Err(result_err_or(iv, err2("")))
                }
                c.samples = result_unwrap(iv)
            } else if a == "--cycles" {
                let iv: Result[int, Err] = need_int(val, a)
                if result_is_err(iv) {
                    return Result.Err(result_err_or(iv, err2("")))
                }
                c.cycles = result_unwrap(iv)
            } else if a == "--warmup" {
                let iv: Result[int, Err] = need_int(val, a)
                if result_is_err(iv) {
                    return Result.Err(result_err_or(iv, err2("")))
                }
                c.warmup = result_unwrap(iv)
                c.has_warmup = true
            } else if a == "--interval" {
                let fv: Result[float, Err] = need_float(val, a)
                if result_is_err(fv) {
                    return Result.Err(result_err_or(fv, err2("")))
                }
                c.interval = result_unwrap(fv)
            }
            i = i + 2
        } else if a == "--allow-dirty" {
            c.allow_dirty = true
            i = i + 1
        } else if a == "--stamp" {
            c.stamp = true
            i = i + 1
        } else if a == "--quiet" {
            c.quiet = true
            i = i + 1
        } else {
            # a positional (the sanction workload)
            if c.cmd == "sanction" && c.workload == "" && a.len() > 0
            && a.byte_at(0) != 45 {
                c.workload = a
                i = i + 1
            } else {
                return Result.Err(err2("usage: unknown argument " + a))
            }
        }
    }
    return Result.Ok(c)
}

# ----------------------------------------------------------------------------
# The env fingerprint — the measuring machine's word (page size is the
# unit; the aslr mode records which way the instrument ran).
# ----------------------------------------------------------------------------

fn page_size_of_machine() -> int uses Proc {
    let r: HlRun = hl_spawn("getconf", ["PAGESIZE"])
    if r.code == 0 {
        let v: Option[int] = parse_int_opt(r.out.trim())
        if option_is_some(v) && option_unwrap(v) > 0 {
            return option_unwrap(v)
        }
    }
    return page_size_default()
}

fn kernel_of() -> str uses Fs {
    if !file_exists("/proc/sys/kernel/osrelease") {
        return ""
    }
    return read_file("/proc/sys/kernel/osrelease").trim()
}

fn env_fingerprint() -> JsonValue uses Fs, Proc {
    let mut aslr: str = "random"
    if which_cmd("setarch") {
        aslr = "fixed"
    }
    let mut kernel: JsonValue = json_null()
    let kv: str = kernel_of()
    if kv != "" {
        kernel = json_str(kv)
    }
    let keys: list[str] = ["aslr", "cc", "cpus", "kernel", "page_size",
    "python"]
    let vals: list[JsonValue] = [json_str(aslr), json_str(cc_line()),
    json_int(cpus_of()), kernel,
    json_int(page_size_of_machine()), json_str(python_of())]
    return jobject(keys, vals)
}

# merge_env(local, bundle_env) — the bundle may carry the measuring
# machine's env fingerprint; when it does it wins.
fn merge_env(local: JsonValue, bundle_env: JsonValue, place: str)
-> Result[JsonValue, Err] {
    if json_is_null(bundle_env) {
        return Result.Ok(local)
    }
    if !json_is_object(bundle_env) {
        return Result.Err(err2(place + ": the bundle env is not an "
        + "object"))
    }
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    while i < local.obj_keys.len() {
        keys.push(local.obj_keys.get(i))
        vals.push(local.obj_vals.get(i))
        i = i + 1
    }
    i = 0
    while i < bundle_env.obj_keys.len() {
        let bk: str = bundle_env.obj_keys.get(i)
        let mut replaced: bool = false
        let mut j: int = 0
        while j < keys.len() {
            if keys.get(j) == bk {
                vals.set(j, bundle_env.obj_vals.get(i))
                replaced = true
            }
            j = j + 1
        }
        if !replaced {
            keys.push(bk)
            vals.push(bundle_env.obj_vals.get(i))
        }
        i = i + 1
    }
    let merged: JsonValue = jobject(keys, vals)
    let psz: JsonValue = jget(merged, "page_size")
    if !is_pos_int_v(psz) {
        return Result.Err(err2(place + ": the bundle env carries no "
        + "positive page_size — a record without its unit is not a "
        + "record"))
    }
    return Result.Ok(merged)
}

# ----------------------------------------------------------------------------
# record — measure now, or import a bundle, and pin it to a commit.
# ----------------------------------------------------------------------------

# readings_json(reports, place) — one workload's readings arrays.
struct ReadingsArrays {
    marker: list[JsonValue],
    end: list[JsonValue],
    warmup_end: list[JsonValue],
    slopes: list[JsonValue],
    cis: list[JsonValue]
}

fn readings_of_reports(reports: JsonValue, name: str, place: str)
-> Result[ReadingsArrays, Err] {
    let marker: list[JsonValue] = []
    let end: list[JsonValue] = []
    let warmup_end: list[JsonValue] = []
    let slopes: list[JsonValue] = []
    let cis: list[JsonValue] = []
    if !json_is_array(reports) || reports.arr.len() == 0 {
        return Result.Err(err2("workload " + name + " carries no runs in "
        + "the bundle"))
    }
    if reports.arr.len() < min_samples() {
        return Result.Err(err1("workload " + name + " carries fewer than "
        + min_samples().to_str() + " samples — a median no sample "
        + "supports is not a measurement"))
    }
    let mut i: int = 0
    while i < reports.arr.len() {
        let rr: Result[Readings, Err] = report_readings(reports.arr.get(i),
        "workload " + name + " run " + (i + 1).to_str())
        if result_is_err(rr) {
            return Result.Err(result_err_or(rr, err1("")))
        }
        let rd: Readings = result_unwrap(rr)
        marker.push(json_int(rd.marker_rss))
        end.push(json_int(rd.end_rss))
        warmup_end.push(json_int(rd.warmup_end_rss))
        slopes.push(json_float(rd.slope))
        cis.push(jarr([json_float(rd.slope_lo), json_float(rd.slope_hi)]))
        i = i + 1
    }
    return Result.Ok(ReadingsArrays {
        marker: marker, end: end, warmup_end: warmup_end,
        slopes: slopes, cis: cis
    })
}

fn cmd_record(c: Cli, root: str) -> Result[int, Err]
uses IO, Fs, Proc, Clock {
    let mut history: str = c.history
    if history == "" {
        history = history_default()
    }
    let mut commit: str = ""
    if c.commit != "" {
        commit = str_to_lower_ascii(strip_ws(c.commit))
        if !is_sha1(commit) {
            return Result.Err(err2("--commit must be a 40-hex sha (got "
            + py_repr_str(c.commit) + ")"))
        }
    } else {
        commit = git_head(root)
        if commit == "" {
            return Result.Err(err2(root + " is not a git work tree — "
            + "pass --commit to pin the record explicitly"))
        }
        if git_dirty(root) && !c.allow_dirty {
            return Result.Err(err1("the work tree carries tracked "
            + "modifications — a per-commit record pins a clean "
            + "commit (--allow-dirty to record anyway)"))
        }
    }

    if c.samples < min_samples() {
        return Result.Err(err2("--samples must be at least "
        + min_samples().to_str() + " — a median no sample supports "
        + "is not a measurement"))
    }
    if c.cycles < 3 {
        return Result.Err(err2("--cycles must be at least 3 (a slope "
        + "needs points)"))
    }
    let mut warmup: int = c.warmup
    if !c.has_warmup {
        warmup = c.cycles / 4
        if warmup < 1 {
            warmup = 1
        }
    }
    if warmup < 1 {
        return Result.Err(err2("--warmup must be at least 1"))
    }
    if c.interval < 1.0 {
        return Result.Err(err2("--interval must be >= 1 ms"))
    }

    let members_r: Result[list[Member], Err] = suite_members(root, c.suite)
    if result_is_err(members_r) {
        return Result.Err(result_err_or(members_r, err1("")))
    }
    let members: list[Member] = result_unwrap(members_r)
    let digest_r: Result[str, Err] = members_digest(members)
    if result_is_err(digest_r) {
        return Result.Err(result_err_or(digest_r, err1("")))
    }
    let digest: str = result_unwrap(digest_r)

    let mut bundle: JsonValue = json_null()
    let mut bundle_env: JsonValue = json_null()
    let mut source: str = ""
    if c.from_bundle != "" {
        if !file_exists(c.from_bundle) {
            return Result.Err(err2("cannot read the bundle: [Errno 2] "
            + "No such file or directory: '" + c.from_bundle + "'"))
        }
        let rr: Result[JsonValue, str] = json_parse_result(
        read_file(c.from_bundle))
        if result_is_err(rr) {
            return Result.Err(err2("the bundle is not valid JSON: "
            + result_err_or(rr, "parse error")))
        }
        bundle = result_unwrap(rr)
        if !json_is_object(bundle) || jstr_of(bundle, "tool") != bundle_tool() {
            let mut toolv: str = "None"
            if json_is_object(bundle) {
                let t: JsonValue = jget(bundle, "tool")
                if json_is_str(t) {
                    toolv = py_repr_str(json_str_value(t))
                }
            }
            return Result.Err(err2("the bundle is not an " + bundle_tool()
            + " bundle (tool=" + toolv + ")"))
        }
        let bw: JsonValue = jget(bundle, "workloads")
        if !json_is_object(bw) || bw.obj_keys.len() == 0 {
            return Result.Err(err2("the bundle carries no workloads"))
        }
        bundle_env = jget(bundle, "env")
        source = "bundle " + c.from_bundle
    } else {
        # the real measurement: hls-rss over every workload, --samples
        # times each, with live feedback per workload.
        let bw_keys: list[str] = []
        let bw_vals: list[JsonValue] = []
        let mut counter: int = 0
        let mut mi: int = 0
        while mi < members.len() {
            let m: Member = members.get(mi)
            let reports: list[JsonValue] = []
            let mut si: int = 0
            while si < c.samples {
                counter = counter + 1
                let rr: Result[JsonValue, Err] = run_hls_rss(root, m.path,
                c.cycles, warmup, c.interval, counter)
                if result_is_err(rr) {
                    return Result.Err(result_err_or(rr, err1("")))
                }
                reports.push(result_unwrap(rr))
                si = si + 1
            }
            # live feedback — the line mirrors the dashboard's own units.
            let mut marker_med: list[float] = []
            let mut slope_med: list[float] = []
            let mut ri: int = 0
            while ri < reports.len() {
                let rd_r: Result[Readings, Err] = report_readings(
                reports.get(ri), "workload " + m.name + " run "
                + (ri + 1).to_str())
                if result_is_err(rd_r) {
                    return Result.Err(result_err_or(rd_r, err1("")))
                }
                let rd: Readings = result_unwrap(rd_r)
                marker_med.push(rd.marker_rss.to_float())
                slope_med.push(rd.slope)
                ri = ri + 1
            }
            println("  measured " + pad_right(m.name, 16)
            + " marker-rss " + fmt_pg(median_of(marker_med))
            + "  slope " + fmt_slope_kc(median_of(slope_med))
            + " pg/kc  (" + c.samples.to_str() + " samples)")
            bw_keys.push(m.name)
            bw_vals.push(jarr(reports))
            mi = mi + 1
        }
        bundle = jobject(["tool", "version", "workloads", "env"],
        [json_str(bundle_tool()), json_str(tool_version()),
        jobject(bw_keys, bw_vals), json_null()])
        bundle_env = json_null()
        source = "hls-rss"
    }

    # the ledger's workloads, sorted by name, from the bundle's reports
    let bw: JsonValue = jget(bundle, "workloads")
    let wnames: list[str] = []
    let mut wi: int = 0
    while wi < bw.obj_keys.len() {
        wnames.push(bw.obj_keys.get(wi))
        wi = wi + 1
    }
    let sorted_names: list[str] = sort_strs(wnames)
    let wkeys: list[str] = []
    let wvals: list[JsonValue] = []
    let mut si: int = 0
    while si < sorted_names.len() {
        let name: str = sorted_names.get(si)
        let reports: JsonValue = json_object_get(bw, name)
        let ra: Result[ReadingsArrays, Err] = readings_of_reports(reports,
        name, "")
        if result_is_err(ra) {
            return Result.Err(result_err_or(ra, err1("")))
        }
        let arrs: ReadingsArrays = result_unwrap(ra)
        # the tracked file and its digest, when the workload is one of
        # the suite's members.
        let mut wfile: str = name
        let mut wdigest: JsonValue = json_null()
        let mut mi: int = 0
        while mi < members.len() {
            if members.get(mi).name == name {
                wfile = c.suite + "/" + name + ".hls"
                if file_exists(members.get(mi).path) {
                    wdigest = json_str(sha256_hex(
                    read_file(members.get(mi).path)))
                }
            }
            mi = mi + 1
        }
        wkeys.push(name)
        wvals.push(jobject(["file", "digest", "samples",
        "marker_rss_pages", "end_rss_pages", "warmup_end_rss_pages",
        "slope_pages_per_cycle", "slope_ci_pages",
        "hls_rss_verdict"],
        [json_str(wfile), wdigest, json_int(arrs.marker.len()),
        jarr(arrs.marker), jarr(arrs.end), jarr(arrs.warmup_end),
        jarr(arrs.slopes), jarr(arrs.cis),
        json_str("stable")]))
        si = si + 1
    }

    let local_env: JsonValue = env_fingerprint()
    let env_r: Result[JsonValue, Err] = merge_env(local_env, bundle_env,
    "the bundle env")
    if result_is_err(env_r) {
        return Result.Err(result_err_or(env_r, err1("")))
    }
    let envo: JsonValue = result_unwrap(env_r)

    let mut stamp_val: JsonValue = json_null()
    if c.stamp {
        stamp_val = json_str(utc_now())
    }
    let mut note_val: JsonValue = json_null()
    if c.note != "" {
        note_val = json_str(c.note)
    }
    let entry: JsonValue = jobject(["type", "tool", "version", "commit",
    "suite", "suite_digest", "plan", "noise_pct", "floor_pages",
    "env", "workloads", "note", "stamp"],
    [json_str("record"), json_str(tool_name()),
    json_str(tool_version()), json_str(commit), json_str(c.suite),
    json_str(digest),
    jobject(["cycles", "warmup", "interval", "samples"],
    [json_int(c.cycles), json_int(warmup),
    json_float(c.interval), json_int(c.samples)]),
    json_float(default_noise_pct()),
    json_float(default_floor_pages()), envo,
    jobject(wkeys, wvals), note_val, stamp_val])
    let vr: Result[bool, Err] = validate_record(entry, "the new record")
    if result_is_err(vr) {
        return Result.Err(result_err_or(vr, err1("")))
    }
    let ar: Result[bool, Err] = append_entry(history, entry)
    if result_is_err(ar) {
        return Result.Err(result_err_or(ar, err1("")))
    }
    if c.json_out != "" {
        write_file(c.json_out, pretty_json(bundle))
    }
    println("recorded " + take_s(commit, 10) + " (" + commit + ") suite="
    + c.suite + " workloads=" + wkeys.len().to_str() + " source="
    + source)
    return Result.Ok(0)
}

# ----------------------------------------------------------------------------
# sanction — a written excuse, one workload at a time.
# ----------------------------------------------------------------------------

fn cmd_sanction(c: Cli, root: str) -> Result[int, Err]
uses IO, Fs, Proc, Clock {
    let mut history: str = c.history
    if history == "" {
        history = history_default()
    }
    let lr: Result[list[Entry], Err] = load_history(history)
    if result_is_err(lr) {
        return Result.Err(result_err_or(lr, err1("")))
    }
    let entries: list[Entry] = result_unwrap(lr)
    if c.workload == "" {
        return Result.Err(err2("usage: sanction WORKLOAD --reason TEXT"))
    }
    let known: list[str] = []
    let recs: list[Entry] = records_of(entries)
    let mut ri: int = 0
    while ri < recs.len() {
        let names: list[str] = workload_names_sorted(recs.get(ri).v)
        let mut ni: int = 0
        while ni < names.len() {
            let n: str = names.get(ni)
            let mut found: bool = false
            let mut j: int = 0
            while j < known.len() {
                if known.get(j) == n {
                    found = true
                }
                j = j + 1
            }
            if !found {
                known.push(n)
            }
            ni = ni + 1
        }
        ri = ri + 1
    }
    let sorted_known: list[str] = sort_strs(known)
    let mut has: bool = false
    let mut ki: int = 0
    while ki < sorted_known.len() {
        if sorted_known.get(ki) == c.workload {
            has = true
        }
        ki = ki + 1
    }
    if !has {
        let mut list_str: str = "(none)"
        if sorted_known.len() > 0 {
            list_str = str_join(sorted_known, ", ")
        }
        return Result.Err(err2("unknown workload "
        + py_repr_str(c.workload) + " — the ledger knows: "
        + list_str))
    }
    if c.reason == "" {
        return Result.Err(err2("a sanction without a written reason is "
        + "not a sanction (--reason TEXT)"))
    }
    let mut author: str = c.author
    if author == "" {
        author = git_user(root)
    }
    let mut stamp_val: JsonValue = json_null()
    if c.stamp {
        stamp_val = json_str(utc_now())
    }
    let mut commit_val: JsonValue = json_null()
    if c.commit != "" {
        commit_val = json_str(c.commit)
    }
    let entry: JsonValue = jobject(["type", "tool", "version", "workload",
    "reason", "commit", "author", "stamp"],
    [json_str("sanction"), json_str(tool_name()),
    json_str(tool_version()), json_str(c.workload),
    json_str(c.reason), commit_val, json_str(author), stamp_val])
    let ar: Result[bool, Err] = append_entry(history, entry)
    if result_is_err(ar) {
        return Result.Err(result_err_or(ar, err1("")))
    }
    println("sanctioned " + c.workload + " (" + author + ")")
    return Result.Ok(0)
}

# ----------------------------------------------------------------------------
# gate — the law: one unsanctioned regression fails.
# ----------------------------------------------------------------------------

fn cmd_gate(c: Cli) -> Result[int, Err] uses IO, Fs {
    let mut history: str = c.history
    if history == "" {
        history = history_default()
    }
    let lr: Result[list[Entry], Err] = load_history(history)
    if result_is_err(lr) {
        return Result.Err(result_err_or(lr, err1("")))
    }
    let entries: list[Entry] = result_unwrap(lr)
    let vr: Result[JsonValue, Err] = verdict_of(entries, c.baseline,
    c.threshold, c.floor)
    if result_is_err(vr) {
        return Result.Err(result_err_or(vr, err1("")))
    }
    let v: JsonValue = result_unwrap(vr)
    if !c.quiet {
        println("gate " + str_to_upper_ascii(jstr_of(v, "verdict"))
        + ": record " + take_s(jstr_of(v, "record"), 10)
        + " vs baseline " + take_s(jstr_of(v, "baseline"), 10)
        + " (suite " + jstr_of(v, "suite") + ", threshold "
        + fmt_fixed(num_or(jget(v, "noise_pct"), 0.0), 1) + "%, floor "
        + py_float_repr(num_or(jget(v, "floor_pages"), 0.0)) + " pg)")
        let rows: JsonValue = jget(v, "workloads")
        let mut i: int = 0
        while i < rows.arr.len() {
            let r: JsonValue = rows.arr.get(i)
            let klass: str = jstr_of(r, "class")
            let mut line: str = "  "
            + pad_right(jstr_of(r, "workload"), 24)
            if klass == "no-change" || klass == "within-noise"
            || klass == "improved" || klass == "regressed" {
                let ci: JsonValue = jget(r, "ci_pages")
                let mut lo: float = 0.0
                let mut hi: float = 0.0
                if json_is_array(ci) && ci.arr.len() == 2 {
                    lo = json_float_value(ci.arr.get(0))
                    hi = json_float_value(ci.arr.get(1))
                }
                line = line + " " + pad_right(klass, 12) + " "
                + fmt_change(num_or(jget(r, "point_pages"), 0.0),
                num_or(jget(r, "point_pct"), 0.0))
                + "  [" + fmt_signed_f1(lo) + " " + fmt_signed_f1(hi)
                + "] pg  band "
                + fmt_fixed(num_or(jget(r, "band_pages"), 0.0), 1)
                + " pg"
            } else {
                line = line + " " + klass
                if klass == "new" {
                    line = line + " ("
                    + fmt_pg(num_or(jget(r, "cur_median_pages"), 0.0))
                    + ")"
                }
            }
            if json_is_object(jget(r, "sanction")) {
                let s: JsonValue = jget(r, "sanction")
                line = line + "  sanctioned: " + jstr_of(s, "reason")
                + " (" + jstr_of(s, "author") + ")"
            }
            println(line)
            i = i + 1
        }
    }
    let uns_arr: JsonValue = jget(v, "unsanctioned")
    let uns: list[str] = []
    if json_is_array(uns_arr) {
        let mut i2: int = 0
        while i2 < uns_arr.arr.len() {
            uns.push(json_str_value(uns_arr.arr.get(i2)))
            i2 = i2 + 1
        }
    }
    let rows: JsonValue = jget(v, "workloads")
    if uns.len() > 0 {
        println("GATE FAIL: " + uns.len().to_str()
        + " regressed without a sanction: " + str_join(uns, ", "))
    } else if !c.quiet {
        println("GATE PASS: no unsanctioned regression across "
        + rows.arr.len().to_str() + " workloads")
    }
    if c.json_out != "" {
        write_file(c.json_out, pretty_json(v))
    }
    if uns.len() > 0 {
        return Result.Ok(1)
    }
    return Result.Ok(0)
}

# ----------------------------------------------------------------------------
# dashboard — the deterministic render of the ledger.
# ----------------------------------------------------------------------------

fn cmd_dashboard(c: Cli) -> Result[int, Err] uses IO, Fs, Clock {
    if c.out == "" {
        return Result.Err(err2("usage: dashboard --out FILE.md"))
    }
    let mut history: str = c.history
    if history == "" {
        history = history_default()
    }
    let lr: Result[list[Entry], Err] = load_history(history)
    if result_is_err(lr) {
        return Result.Err(result_err_or(lr, err1("")))
    }
    let entries: list[Entry] = result_unwrap(lr)
    let mut stamp: str = ""
    if c.stamp {
        stamp = utc_now()
    }
    let dr: Result[str, Err] = render_dashboard(entries, history, c.limit,
    stamp)
    if result_is_err(dr) {
        return Result.Err(result_err_or(dr, err1("")))
    }
    write_file(c.out, result_unwrap(dr))
    if c.json_out != "" {
        let vr: Result[JsonValue, Err] = verdict_of(entries, "",
        default_noise_pct(), default_floor_pages())
        if result_is_err(vr) {
            return Result.Err(result_err_or(vr, err1("")))
        }
        write_file(c.json_out, pretty_json(result_unwrap(vr)))
    }
    println("dashboard written to " + c.out)
    return Result.Ok(0)
}

# ----------------------------------------------------------------------------
# history — read the ledger back.
# ----------------------------------------------------------------------------

fn cmd_history(c: Cli) -> Result[int, Err] uses IO, Fs {
    let mut history: str = c.history
    if history == "" {
        history = history_default()
    }
    let lr: Result[list[Entry], Err] = load_history(history)
    if result_is_err(lr) {
        return Result.Err(result_err_or(lr, err1("")))
    }
    let entries: list[Entry] = result_unwrap(lr)
    let mut shown: list[Entry] = entries
    if c.workload_filter != "" {
        shown = []
        let mut i: int = 0
        while i < entries.len() {
            let e: Entry = entries.get(i)
            let typ: str = jstr_of(e.v, "type")
            let keep: bool = (typ == "record"
            && json_object_has(jget(e.v, "workloads"),
            c.workload_filter))
            || (typ == "sanction"
            && jstr_of(e.v, "workload") == c.workload_filter)
            if keep {
                shown.push(e)
            }
            i = i + 1
        }
    }
    if c.json_flag {
        let vals: list[JsonValue] = []
        let mut i2: int = 0
        while i2 < shown.len() {
            vals.push(shown.get(i2).v)
            i2 = i2 + 1
        }
        print(pretty_json(jarr(vals)))
        return Result.Ok(0)
    }
    let mut i3: int = 0
    while i3 < shown.len() {
        let e: Entry = shown.get(i3)
        if jstr_of(e.v, "type") == "record" {
            let n_wls: int = workload_names_sorted(e.v).len()
            println("line " + pad_left_num(e.line, 4) + " record  "
            + jstr_of(e.v, "commit") + "  suite="
            + path_basename(strip_trailing_slash(
            jstr_of(e.v, "suite")))
            + " workloads=" + n_wls.to_str())
        } else {
            println("line " + pad_left_num(e.line, 4) + " sanction "
            + jstr_of(e.v, "workload") + "  "
            + jstr_of(e.v, "reason"))
        }
        i3 = i3 + 1
    }
    println(shown.len().to_str() + " entries")
    return Result.Ok(0)
}

fn strip_trailing_slash(s: str) -> str {
    if s.len() > 1 && s.byte_at(s.len() - 1) == 47 {
        return s.slice(0, s.len() - 1)
    }
    return s
}

# ----------------------------------------------------------------------------
# main
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Fs, Proc, Clock, Args, Exit {
    let argv: list[str] = args()
    let pr: Result[Cli, Err] = parse_cli(argv)
    if result_is_err(pr) {
        return usage_error()
    }
    let c: Cli = result_unwrap(pr)
    let root: str = repo_root(argv.get(0))
    let mut rc: Result[int, Err] = Result.Ok(0)
    if c.cmd == "record" {
        let mut r: str = c.root
        if r == "" {
            r = root
        }
        rc = cmd_record(c, r)
    } else if c.cmd == "sanction" {
        let mut r: str = c.root
        if r == "" {
            r = root
        }
        rc = cmd_sanction(c, r)
    } else if c.cmd == "gate" {
        rc = cmd_gate(c)
    } else if c.cmd == "dashboard" {
        rc = cmd_dashboard(c)
    } else {
        rc = cmd_history(c)
    }
    if result_is_err(rc) {
        let e: Err = result_err_or(rc, err1(""))
        eprintln(tool_name() + ": " + e.msg)
        return e.code
    }
    return result_unwrap(rc)
}
