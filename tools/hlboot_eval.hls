    }
    if name == "math_signbit" {
        return r_ok(v_bool(math_signbit(args.get(0).f)))
    }
    if name == "math_copysign" {
        return r_ok(v_float(math_copysign(args.get(0).f, args.get(1).f)))
    }
    if name == "chan_new" {
        return r_ok(v_chan(chan_new()))
    }
    if name == "chan_new_bounded" {
        if args.get(0).i < 1 {
            return r_panic("chan_new_bounded() capacity must be >= 1", line)
        }
        return r_ok(v_chan(chan_new_bounded(args.get(0).i)))
    }
    if name == "select" || name == "future_select" {
        let lv: V = args.get(0)
        if lv.k != VK_LIST() {
            return r_panic("select() expects a list of channels", line)
        }
        let chans: list[Chan[V]] = []
        let mut i: int = 0
        while i < lv.vals.len() {
            let c: V = lv.vals.get(i)
            if c.k != VK_CHAN() {
                return r_panic("select() expects a list of channels", line)
            }
            chans.push(vch(c))
            i = i + 1
        }
        return r_ok(v_int(select(chans)))
    }
    if name == "await" {
        let fut: V = args.get(0)
        if fut.k != VK_CHAN() {
            return r_panic("await() expects a Future", line)
        }
        return r_ok(vch(fut).recv())
    }
    if name == "future_ready" {
        let mut v: V = args.get(0)
        let node: ExprN = boot.ctx.exprs.get(arg_nodes.get(0))
        if is_owned_v(v) && !(node.kind == "call" && node.mkey == "clone") {
            v = deep_clone(v)
        }
        let ch: Chan[V] = chan_new_bounded(1)
        ch.send(clone(v))
        return r_ok(v_chan(ch))
    }
    if name == "future_poll" {
        let fut: V = args.get(0)
        if fut.k != VK_CHAN() {
            return r_panic("future_poll() expects a Future", line)
        }
        if vch(fut).len() > 0 {
            let inner: list[V] = [vch(fut).recv()]
            return r_ok(v_enum("Option", "Some", inner))
        }
        return r_ok(v_enum("Option", "None", []))
    }
    if name == "stream_new" {
        if args.get(0).i < 1 {
            return r_panic("chan_new_bounded() capacity must be >= 1", line)
        }
        return r_ok(v_chan(chan_new_bounded(args.get(0).i)))
    }
    if name == "stream_send" {
        let s: V = args.get(0)
        if s.k != VK_CHAN() {
            return r_panic("stream_send() expects a Stream", line)
        }
        let mut v: V = args.get(1)
        let node: ExprN = boot.ctx.exprs.get(arg_nodes.get(1))
        if is_owned_v(v) && !(node.kind == "call" && node.mkey == "clone") {
            v = deep_clone(v)
        }
        vch(s).send(clone(v))
        return r_unit()
    }
    if name == "stream_recv" {
        let s: V = args.get(0)
        if s.k != VK_CHAN() {
            return r_panic("stream_recv() expects a Stream", line)
        }
        return r_ok(vch(s).recv())
    }
    if name == "stream_try_recv" {
        let s: V = args.get(0)
        if s.k != VK_CHAN() {
            return r_panic("stream_try_recv() expects a Stream", line)
        }
        return r_ok(vch(s).recv_or(args.get(1)))
    }
    if name == "stream_len" {
        let s: V = args.get(0)
        if s.k != VK_CHAN() {
            return r_panic("stream_len() expects a Stream", line)
        }
        return r_ok(v_int(vch(s).len()))
    }
    if name == "stream_close" {
        let s: V = args.get(0)
        if s.k != VK_CHAN() {
            return r_panic("stream_close() expects a Stream", line)
        }
        vch(s).send(v_int(HL_INT64_MIN()))
        return r_unit()
    }
    if name == "stream_take_int" {
        let s: V = args.get(0)
        if s.k != VK_CHAN() {
            return r_panic("stream_take_int() expects a Stream", line)
        }
        let out_stream: Chan[V] = chan_new_bounded(16)
        spawn(hl_task_take_entry, clone(boot_core_of(boot)), clone(vch(s)), args.get(1).i, clone(out_stream))
        return r_ok(v_chan(out_stream))
    }
    if name == "stream_merge_int" {
        let a: V = args.get(0)
        let b: V = args.get(1)
        if a.k != VK_CHAN() || b.k != VK_CHAN() {
            return r_panic("stream_merge_int() expects two Streams", line)
        }
        let out_stream: Chan[V] = chan_new_bounded(16)
        spawn(hl_task_merge_entry, clone(boot_core_of(boot)), clone(vch(a)), clone(vch(b)), clone(out_stream))
        return r_ok(v_chan(out_stream))
    }
    return r_panic("unknown builtin function: " + name, line)
}

# parse_int_v(dm, s, line) -> R — the C-semantics int() (rt_num.py /
# hl_str_to_int: unsigned accumulation, 2^63 accepted only negated).
fn parse_int_v(s: str, line: int) -> R uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let n: int = s.len()
    let mut i: int = 0
    let mut neg: bool = false
    if n > 0 && s.byte_at(0) == 45 {
        neg = true
        i = 1
    }
    if i >= n {
        return r_panic("cannot convert string to int", line)
    }
    let mut v: int = 0
    let mut hit_2p63: bool = false
    while i < n {
        let c: int = s.byte_at(i)
        if c < 48 || c > 57 {
            return r_panic("cannot convert string to int", line)
        }
        let d: int = c - 48
        if hit_2p63 {
            return r_panic("integer too large when converting string", line)
        }
        if v > 922337203685477580 || (v == 922337203685477580 && d == 9) {
            return r_panic("integer too large when converting string", line)
        }
        if v == 922337203685477580 && d == 8 {
            # exactly 2^63: representable only negated (INT64_MIN's
            # bit pattern); a further digit dies above.
            v = HL_INT64_MIN()
            hit_2p63 = true
        } else {
            v = v * 10 + d
        }
        i = i + 1
    }
    if neg {
        if hit_2p63 {
            return r_ok(v_int(HL_INT64_MIN()))
        }
        return r_ok(v_int(-v))
    }
    if hit_2p63 || v > HL_INT64_MAX() {
        return r_panic("integer too large when converting string", line)
    }
    return r_ok(v_int(v))
}

# ----------------------------------------------------------------------------
# The builtin method table (builtin_method.py, verbatim laws).
# ----------------------------------------------------------------------------
fn builtin_method(boot: Boot, op: str, t: V, args: list[V], arg_nodes: list[int], line: int) -> R uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    if op == "str.byte_at" {
        if args.get(0).i < 0 || args.get(0).i >= t.s.len() {
            return r_panic("string access out of bounds", line)
        }
        return r_ok(v_int(t.s.byte_at(args.get(0).i)))
    }
    if op == "list.get" {
        if args.get(0).i < 0 || args.get(0).i >= t.vals.len() {
            return r_panic("array access out of bounds", line)
        }
        return r_ok(t.vals.get(args.get(0).i))
    }
    if op == "list.len" {
        return r_ok(v_int(t.vals.len()))
    }
    if op == "list.push" {
        t.vals.push(args.get(0))
        return r_unit()
    }
    if op == "str.slice" {
        let a: int = args.get(0).i
        let b: int = args.get(1).i
        if a < 0 || b < a || b > t.s.len() {
            return r_panic("invalid string slice", line)
        }
        return r_ok(v_str(t.s.slice(a, b)))
    }
    if op == "str.len" {
        return r_ok(v_int(t.s.len()))
    }
    if op == "map.get_or" {
        let idx: int = map_key_index(t.keys, args.get(0).s)
        if idx < 0 {
            return r_ok(args.get(1))
        }
        return r_ok(t.vals.get(idx))
    }
    if op == "str.starts_with" {
        return r_ok(v_bool(t.s.starts_with(args.get(0).s)))
    }
    if op == "map.has" {
        return r_ok(v_bool(map_key_index(t.keys, args.get(0).s) >= 0))
    }
    if op == "int.to_str" {
        return r_ok(v_str(t.i.to_str()))
    }
    if op == "map.set" {
        let idx: int = map_key_index(t.keys, args.get(0).s)
        if idx < 0 {
            t.keys.push(args.get(0).s)
            t.vals.push(args.get(1))
        } else {
            t.vals.set(idx, args.get(1))
        }
        return r_unit()
    }
    if op == "str.to_int" {
        return parse_int_v(t.s, line)
    }
    if op == "str.split" {
        if args.get(0).s.len() == 0 {
            return r_panic("empty separator not allowed", line)
        }
        let parts: list[str] = t.s.split(args.get(0).s)
        let out: list[V] = []
        let mut i: int = 0
        while i < parts.len() {
            out.push(v_str(parts.get(i)))
            i = i + 1
        }
        return r_ok(v_list(out))
    }
    if op == "map.keys" {
        let out: list[V] = []
        let mut i: int = 0
        while i < t.keys.len() {
            out.push(v_str(t.keys.get(i)))
            i = i + 1
        }
        return r_ok(v_list(out))
    }
    if op == "list.pop" {
        if t.vals.len() == 0 {
            return r_panic("pop from empty list", line)
        }
        return r_ok(t.vals.pop())
    }
    if op == "str.find" {
        return r_ok(v_int(t.s.find(args.get(0).s)))
    }
    if op == "str.contains" {
        return r_ok(v_bool(t.s.find(args.get(0).s) >= 0))
    }
    if op == "str.ends_with" {
        return r_ok(v_bool(t.s.ends_with(args.get(0).s)))
    }
    if op == "str.trim" {
        return r_ok(v_str(t.s.trim()))
    }
    if op == "str.to_str" {
        return r_ok(t)
    }
    if op == "int.to_float" {
        return r_ok(v_float(t.i.to_float()))
    }
    if op == "int.abs" {
        if t.i < 0 {
            return i64_neg(t.i, line)
        }
        return r_ok(v_int(t.i))
    }
    if op == "list.set" {
        if args.get(0).i < 0 || args.get(0).i >= t.vals.len() {
            return r_panic("array access out of bounds", line)
        }
        t.vals.set(args.get(0).i, args.get(1))
        return r_unit()
    }
    if op == "map.len" {
        return r_ok(v_int(t.keys.len()))
    }
    if op == "str.to_float" {
        return str_to_float(t.s, line)
    }
    if op == "float.to_str" {
        return r_ok(v_str(fmt_float_py(t.f)))
    }
    if op == "float.to_int" {
        if t.f != t.f || t.f == 1.0 / 0.0 || t.f == -1.0 / 0.0 {
            return r_panic("float.to_int out of int64 range", line)
        }
        let r: int = t.f.to_int()
        if r < HL_INT64_MIN() || r > HL_INT64_MAX() {
            return r_panic("float.to_int out of int64 range", line)
        }
        return r_ok(v_int(r))
    }
    if op == "float.abs" {
        if t.f == 0.0 {
            return r_ok(v_float(0.0))
        }
        if t.f < 0.0 {
            return r_ok(v_float(-t.f))
        }
        return r_ok(v_float(t.f))
    }
    if op == "bool.to_str" {
        if t.i != 0 {
            return r_ok(v_str("true"))
        }
        return r_ok(v_str("false"))
    }
    if op == "chan.send" || op == "chan.try_send" {
        let mut v: V = args.get(0)
        let node: ExprN = boot.ctx.exprs.get(arg_nodes.get(0))
        if is_owned_v(v) && !(node.kind == "call" && node.mkey == "clone") {
            v = deep_clone(v)
        }
        if t.k != VK_CHAN() {
            return r_panic("chan operation on non-channel", line)
        }
        if op == "chan.send" {
            vch(t).send(clone(v))
            return r_unit()
        }
        return r_ok(v_bool(vch(t).try_send(clone(v))))
    }
    if op == "chan.recv" {
        if t.k != VK_CHAN() {
            return r_panic("chan operation on non-channel", line)
        }
        return r_ok(vch(t).recv())
    }
    if op == "chan.recv_or" {
        if t.k != VK_CHAN() {
            return r_panic("chan operation on non-channel", line)
        }
        return r_ok(vch(t).recv_or(args.get(0)))
    }
    if op == "chan.len" {
        if t.k != VK_CHAN() {
            return r_panic("chan operation on non-channel", line)
        }
        return r_ok(v_int(vch(t).len()))
    }
    if op == "task.join" {
        if t.k != VK_TASK() {
            return r_panic("join on non-task", line)
        }
        if t.i < 0 || t.i >= boot.tasks.len() {
            return r_panic("join on unknown task", line)
        }
        return r_ok(boot.tasks.get(t.i).join())
    }
    return r_panic("unknown builtin method: " + op, line)
}

# str_to_float(dm, s, line) -> R — the strict float grammar (the C
# strtod subset the interpreter admits): optional sign, digits, one
# dot, optional exponent with sign.
fn str_to_float(t: str, line: int) -> R uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let tl: int = t.len()
    let mut i: int = 0
    if t.slice(0, 1) == "-" {
        i = 1
    } else if t.slice(0, 1) == "+" {
        i = 1
    }
    if i >= tl {
        return r_panic("cannot convert string to float", line)
    }
    let mut dots: int = 0
    let mut digits: int = 0
    let mut saw_exp: bool = false
    let mut exp_digits: int = 0
    while i < tl {
        let c: int = t.byte_at(i)
        if c == 46 {
            if saw_exp {
                return r_panic("cannot convert string to float", line)
            }
            dots = dots + 1
        } else if c >= 48 && c <= 57 {
            if saw_exp {
                exp_digits = exp_digits + 1
            }
            digits = digits + 1
        } else if c == 101 || c == 69 {
            if saw_exp || digits == 0 {
                return r_panic("cannot convert string to float", line)
            }
            saw_exp = true
            if i + 1 < tl && (t.byte_at(i + 1) == 43 || t.byte_at(i + 1) == 45) {
                i = i + 1
            }
            exp_digits = 0
        } else {
            return r_panic("cannot convert string to float", line)
        }
        i = i + 1
    }
    if dots > 1 || digits == 0 {
        return r_panic("cannot convert string to float", line)
    }
    if saw_exp && exp_digits == 0 {
        return r_panic("cannot convert string to float", line)
    }
    return r_ok(v_float(t.to_float()))
}

# ----------------------------------------------------------------------------
# The take/merge stream workers (the last two spawn family members).
# ----------------------------------------------------------------------------

# hl_task_take_entry(boot, in_ch, n, out_s) — forward the first n
# values, then the sentinel.
fn hl_task_take_entry(core: BootCore, in_ch: Chan[V], n: int, out_s: Chan[V]) -> V uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let boot: Boot = boot_of_core(core)
    let mut count: int = 0
    let mut go: bool = true
    while go {
        if count >= n {
            go = false
        } else {
            let v: V = in_ch.recv()
            if v.k == VK_INT() && v.i == HL_INT64_MIN() {
                go = false
            } else {
                out_s.send(clone(v))
                count = count + 1
            }
        }
    }
    out_s.send(v_int(HL_INT64_MIN()))
    return v_unit()
}

# hl_task_merge_entry(boot, a, b, out_s) — interleave two streams
# until both end, then the sentinel.
fn hl_task_merge_entry(core: BootCore, a: Chan[V], b: Chan[V], out_s: Chan[V]) -> V uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let boot: Boot = boot_of_core(core)
    let mut a_done: bool = false
    let mut b_done: bool = false
    while !a_done || !b_done {
        if !a_done {
            let v: V = a.recv()
            if v.k == VK_INT() && v.i == HL_INT64_MIN() {
                a_done = true
            } else {
                out_s.send(clone(v))
            }
        }
        if !b_done {
            let v2: V = b.recv()
            if v2.k == VK_INT() && v2.i == HL_INT64_MIN() {
                b_done = true
            } else {
                out_s.send(clone(v2))
            }
        }
    }
    out_s.send(v_int(HL_INT64_MIN()))
    return v_unit()
}

# ----------------------------------------------------------------------------
# The --audit renderer — hlc's own print_audit, verbatim (the gates
# compare the two front-ends' audits line for line; same ctx, same
# renderer, zero drift).
# ----------------------------------------------------------------------------
fn print_audit(ctx: Ctx) -> void uses IO {
    let keys: list[str] = ctx.fn_order
    let mut i: int = 0
    println("==============================================================================")
    println("  function                       declared                       computed")
    println("==============================================================================")
    while i < keys.len() {
        let key: str = keys.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        let declared: list[str] = f.effects
        let computed: list[str] = ctx.computed_effects.get_or(key, [])
        let mut decl_disp: str = ""
        if f.is_pure {
            decl_disp = "pure"
        }
        let mut j: int = 0
        while j < declared.len() {
            if decl_disp != "" {
                decl_disp = decl_disp + ", "
            }
            decl_disp = decl_disp + declared.get(j)
            j = j + 1
        }
        if decl_disp == "" {
            decl_disp = "(none - pure)"
        }
        let mut comp_disp: str = ""
        let mut k: int = 0
        while k < computed.len() {
            if comp_disp != "" {
                comp_disp = comp_disp + ", "
            }
            comp_disp = comp_disp + computed.get(k)
            k = k + 1
        }
        if comp_disp == "" {
            comp_disp = "(none)"
        }
        # Pad the function name to 30 chars for alignment.
        let padded: str = pad_right(key, 30)
        let padded_decl: str = pad_right(decl_disp, 30)
        println("  " + padded + "  " + padded_decl + "  " + comp_disp)
        i = i + 1
    }
    println("==============================================================================")
    # Stage 84 (v0.103.0-alpha): custom sections + the linker script that
    # places them. check_link_script proved every named section is covered
    # (or that no script was declared) before we get here.
    # Stage 77: the crate mode. For the OS-dev track this is the single
    # most important line `--audit` prints, and boot.py has always said
    # so — the self-hosted front-end did not, which made the two audits
    # disagree on the one fact that decides which entry point exists.
    if ctx.crate_freestanding {
        println("  Crate mode: #![freestanding] (no libc, no OS calls, std disabled, entry _start)")
    } else if ctx.crate_no_std {
        println("  Crate mode: #![no_std] (std disabled, hosted libc kept)")
    } else {
        println("  Crate mode: std (default hosted crate)")
    }
    # Stages 93-95: the bare-metal target, when one was named. Same
    # words as boot.py's --audit (the gates compare the two).
    if ctx.target_triple != "" {
        println("  Target: " + ctx.target_triple + " (bare-metal, integer-only)")
    }
    # Stage 82: the deterministic stack budget. boot.py's --audit prints
    # this too; the same flag on the two front-ends must say the same
    # things.
    if ctx.crate_stack_size >= 0 {
        println("  Stack budget: #![stack_size(" + ctx.crate_stack_size.to_str() + ")] — worst chain " + ctx.stack_budget_worst.to_str() + " bytes (" + ctx.stack_budget_path + ")")
    }
    # Stage 85: the boot-protocol header this crate emits.
    if ctx.crate_boot_header != "" {
        println("  Boot header: " + ctx.crate_boot_header + " (emitted into " + boot_header_section(ctx.crate_boot_header) + ")")
    }
    # Stage 91 (v0.110.0-alpha): the interrupt-safety proof. One line
    # per #[irq_handler], word-for-word what boot.py --audit prints
    # (the gate compares the two).
    if ctx.irq_proof_lines.len() > 0 {
        println("  Interrupt safety (Stage 91): every #[irq_handler] is proved to reach no allocation:")
        let mut irq_i: int = 0
        while irq_i < ctx.irq_proof_lines.len() {
            println("    " + ctx.irq_proof_lines.get(irq_i))
            irq_i = irq_i + 1
        }
    }
    # Stage 101 (v0.120.0-alpha): the #[secrets(...)] annotations the
    # side-channel analysis pass consumes. Word-for-word what boot.py
    # --audit prints (the gate compares the two).
    let mut secret_rows: list[str] = []
    let mut sec_i: int = 0
    while sec_i < ctx.fn_order.len() {
        let skey: str = ctx.fn_order.get(sec_i)
        let sf: FnInfo = ctx.fns.get_or(skey, dummy_fn())
        if sf.attr_secrets != "" {
            let parts: list[str] = sf.attr_secrets.split(",")
            let mut joined: str = ""
            let mut pj: int = 0
            while pj < parts.len() {
                if pj == 0 {
                    joined = parts.get(pj)
                } else {
                    joined = joined + ", " + parts.get(pj)
                }
                pj = pj + 1
            }
            secret_rows.push("    " + skey + ": " + joined)
        }
        sec_i = sec_i + 1
    }
    if secret_rows.len() > 0 {
        println("  #[secrets(...)] annotations: " + secret_rows.len().to_str())
        let mut sec_j: int = 0
        while sec_j < secret_rows.len() {
            println(secret_rows.get(sec_j))
            sec_j = sec_j + 1
        }
    }
    # Stage 102 (v0.121.0-alpha): the #[ct] claims the constant-time
    # verifier (hlprove --consttime) proves. Word-for-word what boot.py
    # --audit prints (the gate compares the two).
    let mut ct_rows: list[str] = []
    let mut cti: int = 0
    while cti < ctx.fn_order.len() {
        let ckey: str = ctx.fn_order.get(cti)
        let cf: FnInfo = ctx.fns.get_or(ckey, dummy_fn())
        if cf.attr_ct && cf.attr_secrets != "" {
            let cparts: list[str] = cf.attr_secrets.split(",")
            let mut cjoined: str = ""
            let mut cj: int = 0
            while cj < cparts.len() {
                if cj == 0 {
                    cjoined = cparts.get(cj)
                } else {
                    cjoined = cjoined + ", " + cparts.get(cj)
                }
                cj = cj + 1
            }
            ct_rows.push("    " + ckey + ": ct over " + cjoined)
        }
        cti = cti + 1
    }
    if ct_rows.len() > 0 {
        println("  #[ct] claims: " + ct_rows.len().to_str())
        let mut ctj: int = 0
        while ctj < ct_rows.len() {
            println(ct_rows.get(ctj))
            ctj = ctj + 1
        }
    }
    if ctx.crate_link_script == "" {
        println("  Linker script: none declared (#![link_script] absent) — custom sections use the default linker layout")
    } else {
        let mut named: int = 0
        let mut aligned: int = 0
        let mut si: int = 0
        while si < ctx.fn_order.len() {
            let sf: FnInfo = ctx.fns.get_or(ctx.fn_order.get(si), dummy_fn())
            if sf.attr_section != "" {
                named = named + 1
            }
            if sf.attr_align >= 0 {
                aligned = aligned + 1
            }
            si = si + 1
        }
        println("  Linker script: " + link_script_path(ctx) + " — " + named.to_str() + " section(s) named, " + ctx.link_script_patterns.len().to_str() + " pattern(s) placed")
        if aligned > 0 {
            println("  #[align(N)] annotations: " + aligned.to_str())
        }
    }
    # Stage 111 (v0.130.0-alpha): capability tokens — every function
    # whose authority comes from a Cap[E] parameter or a cap_take call
    # rather than (only) a `uses` clause. Word-for-word what boot.py
    # --audit prints (the gates compare the two).
    let mut cap_rows: list[str] = []
    let mut capi: int = 0
    while capi < ctx.fn_order.len() {
        let capkey: str = ctx.fn_order.get(capi)
        let cgrants: list[str] = cap_grants(ctx, capkey)
        if cgrants.len() > 0 {
            cap_rows.push("    " + capkey + ": " + join(cgrants, ", "))
        }
        capi = capi + 1
    }
    if cap_rows.len() > 0 {
        println("  Capability tokens (Cap[E] parameters / cap_take calls):")
        let mut capj: int = 0
        while capj < cap_rows.len() {
            println(cap_rows.get(capj))
            capj = capj + 1
        }
    }
    println("  Active effects:    IO, Fs, Clock, Args, Exit, Net, Rand, Proc")
    println("  `uses IO` expands to: {IO, Fs, Clock, Args, Exit}")
    println("  Net, Rand, Proc are independent effects (not part of the IO")
    println("  family) — declare them explicitly to use net_lookup /")
    println("  rand_int / rand_float / rand_seed / proc_exec builtins.")
    println("  No reserved effects (Stage 9 release).")
    println("")
    # Stage 10-beta: taint-flow audit extension. Scan the call graph for:
    #   - functions calling taint sources (tainted_args, read_file_tainted, read_line)
    #   - functions calling each taint sink
    println("  Taint sources (builtins):  tainted_args, read_file_tainted,")
    println("                              read_line")
    println("  Taint sinks (builtins):    print, println, read_file,")
    println("                            write_file, file_exists, exit,")
    println("                            net_lookup, proc_exec")
    println("  Explicit untaint:         taint_unwrap, std.sanitize.*")
    println("")
    # Find functions calling each taint source.
    let mut targs_users: list[str] = []
    let mut rft_users: list[str] = []
    let mut rl_users: list[str] = []
    let mut si: int = 0
    while si < keys.len() {
        let skey: str = keys.get(si)
        let callees: list[str] = ctx.edges.get_or(skey, [])
        let mut cj: int = 0
        while cj < callees.len() {
            let ce: str = callees.get(cj)
            if ce == "b:tainted_args" {
                if !list_has(targs_users, skey) {
                    targs_users.push(skey)
                }
            }
            if ce == "b:read_file_tainted" {
                if !list_has(rft_users, skey) {
                    rft_users.push(skey)
                }
            }
            if ce == "b:read_line" {
                if !list_has(rl_users, skey) {
                    rl_users.push(skey)
                }
            }
            cj = cj + 1
        }
        si = si + 1
    }
    if targs_users.len() > 0 {
        println("  Functions calling tainted_args():")
        let mut ti: int = 0
        while ti < targs_users.len() {
            println("    - " + targs_users.get(ti))
            ti = ti + 1
        }
    } else {
        println("  No function calls tainted_args() (no argv-taint sources in this program).")
    }
    if rft_users.len() > 0 {
        println("  Functions calling read_file_tainted():")
        let mut ri: int = 0
        while ri < rft_users.len() {
            println("    - " + rft_users.get(ri))
            ri = ri + 1
        }
    } else {
        println("  No function calls read_file_tainted().")
    }
    if rl_users.len() > 0 {
        println("  Functions calling read_line():")
        let mut li: int = 0
        while li < rl_users.len() {
            println("    - " + rl_users.get(li))
            li = li + 1
        }
    } else {
        println("  No function calls read_line().")
    }
    # Stage 109 (v0.128.0-alpha): the FFI taint marking — the census of
    # every extern boundary. #[taint_source] externs return untrusted
    # data (every call result is typed tainted[ret]); #[taint_sink(...)]
    # externs declare the parameters that are sinks; every other extern
    # is listed as returning data the taint lattice TRUSTS — the
    # auditor's reminder that an unmarked boundary is a decision, not
    # an absence. Word-for-word what boot.py --audit prints (the gate
    # compares the two).
    let mut ffi_src_rows: list[str] = []
    let mut ffi_sink_rows: list[str] = []
    let mut ffi_plain_rows: list[str] = []
    let mut fi: int = 0
    while fi < keys.len() {
        let fkey: str = keys.get(fi)
        let ff: FnInfo = ctx.fns.get_or(fkey, dummy_fn())
        if ff.is_extern {
            if ff.attr_taint_source {
                ffi_src_rows.push("    - " + fkey + ": -> " + ff.ret)
            }
            if ff.attr_taint_sinks != "" {
                ffi_sink_rows.push("    - " + fkey + ": " + ff.attr_taint_sinks)
            }
            if !ff.attr_taint_source && ff.attr_taint_sinks == "" {
                ffi_plain_rows.push("    - " + fkey + ": -> " + ff.ret)
            }
        }
        fi = fi + 1
    }
    if ffi_src_rows.len() + ffi_sink_rows.len() + ffi_plain_rows.len() == 0 {
        println("  FFI taint marking (Stage 109): no extern declarations.")
    } else {
        println("  FFI taint marking (Stage 109):")
        println("    #[taint_source] externs (returns untrusted, typed tainted[ret]): " + ffi_src_rows.len().to_str())
        let mut fsj: int = 0
        while fsj < ffi_src_rows.len() {
            println(ffi_src_rows.get(fsj))
            fsj = fsj + 1
        }
        println("    #[taint_sink(...)] externs (declared sinks): " + ffi_sink_rows.len().to_str())
        let mut fkj: int = 0
        while fkj < ffi_sink_rows.len() {
            println(ffi_sink_rows.get(fkj))
            fkj = fkj + 1
        }
        println("    Unmarked externs (returns TRUSTED by the taint lattice): " + ffi_plain_rows.len().to_str())
        let mut fpj: int = 0
        while fpj < ffi_plain_rows.len() {
            println(ffi_plain_rows.get(fpj))
            fpj = fpj + 1
        }
    }
}

# Right-pad a string with spaces to width `n`. Truncates if longer than n.
fn pad_right(s: str, n: int) -> str pure {
    let sl: int = s.len()
    if sl >= n {
        return s.slice(0, n)
    }
    let mut out: str = s
    let mut i: int = 0
    while i < n - sl {
        out = out + " "
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# The driver — boot.py's CLI law: flags only before the entry file,
# program args after it (verbatim pass-through, they may look like
# flags), the probe-child discipline for --check and --batch, and the
# det re-exec (the scheduler is read at process start, so --det arms
# the env and runs the tool again through the shell).
# ----------------------------------------------------------------------------

# shell_quote(s) — single-quote for the re-exec command line.
fn hb_shell_quote(s: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < s.len() {
        if s.byte_at(i) == 39 {
            out = out + "'\\''"
        } else {
            out = out + s.slice(i, i + 1)
        }
        i = i + 1
    }
    return "'" + out + "'"
}

# hb_usage() — the refusal print (exit 2 caller prints).
fn hb_usage() -> str {
    return "usage: hlboot [--check | --audit | --emit ir | --emit llvm | --emit lto] <file.hls> [program args...]\n"
    + "               [--sandbox DIR] [--det] [--contracts] [--fast] [--target <triple>]\n"
    + "  --check        type-check + effects-check only, no execution.\n"
    + "  --audit        print the capability / effect tree of every function.\n"
    + "  --emit ir      print the HLIR (Stage 11) of every function.\n"
    + "  --emit llvm    print the LLVM IR (Stage 12) of the program.\n"
    + "  --emit lto     print the whole-program LTO'd LLVM IR (Stage 20).\n"
    + "  --sandbox DIR  restrict filesystem builtins to DIR.\n"
    + "  --det          arm the deterministic scheduler (SPEC section 67).\n"
    + "  --contracts    runtime requires/ensures assertions.\n"
}

# hb_load_ctx(path, triple) -> Ctx — the emission trio's loader: the
# same law hb_load_checked applies (load through hlfront, the triple's
# freestanding implication, the checker) minus the Boot the evaluator
# needs — the printers only read the checked program.
fn hb_load_ctx(path: str, target_triple: str) -> Ctx uses IO, Fs, Proc {
    let ctx: Ctx = hl_load_crate(path)
    ctx.target_triple = target_triple
    if target_triple != "" && !ctx.crate_freestanding {
        ctx.crate_freestanding = true
        ctx.crate_no_std = true
    }
    hl_check(ctx)
    return ctx
}

# hb_load_checked(path) -> Boot — load + check through the compiler's
# own front-end (hlfront); the marker line tells the batch parent the
# compile half succeeded (the host panic path below never reaches the
# return).
fn hb_load_checked(path: str, prog_args: list[str], contracts: bool, target_feature: str, sandbox: str, target_triple: str) -> Boot uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let ctx: Ctx = hl_load_crate(path)
    # Stages 93-95: the bare-metal triple rides with the check (the
    # freestanding implication and the integer-only rule are check-time
    # properties, exactly the law hlc --target applies).
    ctx.target_triple = target_triple
    if target_triple != "" && !ctx.crate_freestanding {
        ctx.crate_freestanding = true
        ctx.crate_no_std = true
    }
    hl_check(ctx)
    let argv_vals: list[V] = []
    let mut i: int = 0
    while i < prog_args.len() {
        argv_vals.push(v_str(prog_args.get(i)))
        i = i + 1
    }
    let boot: Boot = Boot {
        ctx: ctx,
        tasks: [],
        rng: 1,
        argv: v_list(argv_vals),
        det: env_get("HL_DET_SCHED") != "",
        trace: env_get("HL_DET_TRACE") != "",
        contracts: contracts,
        target_feature: target_feature,
        sandbox: sandbox,
        cov_on: env_get("HLBOOT_COV") != "",
        cov_hits: map_new()
    }
    return boot
}

# hb_sandbox_ok(path, root) — the lexical containment check (the
# Python years resolved symlinks first; the port contains the path
# lexically, which stops every ../ walk the gate drives).
fn hb_sandbox_ok(path: str, root: str) -> bool uses Proc {
    if root == "" {
        return true
    }
    let mut p: str = path
    if p.len() > 0 && p.byte_at(0) != 47 {
        p = cwd_get() + "/" + p
    }
    # collapse lexically
    let parts: list[str] = p.split("/")
    let stack: list[str] = []
    let mut i: int = 0
    while i < parts.len() {
        let seg: str = parts.get(i)
        if seg == "" || seg == "." {
            # skip
        } else if seg == ".." {
            if stack.len() > 0 {
                stack.pop()
            }
        } else {
            stack.push(seg)
        }
        i = i + 1
    }
    let mut abs: str = ""
    let mut j: int = 0
    while j < stack.len() {
        abs = abs + "/" + stack.get(j)
        j = j + 1
    }
    if abs == "" {
        abs = "/"
    }
    if abs == root {
        return true
    }
    return abs.starts_with(root + "/")
}

# hb_run_program(boot) -> int — the run protocol: panic handler
# first, then the exit code (masked).
fn hb_run_program(boot: Boot) -> int uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let r: R = call_fn(boot, "main", [])
    if r.flow == FL_PANIC() {
        # The program's panic handler first (if declared), behind the
        # reentrancy guard; a nested panic inside it falls through to
        # the default report.
        let h: FnInfo = boot.ctx.fns.get_or("panic_handler", dummy_fn())
        if h.name == "panic_handler" && h.attr_panic_handler {
            let pr: R = call_fn(boot, "panic_handler", [v_str(r.msg)])
            if pr.flow == FL_PANIC() || pr.flow == FL_EXIT() {
                # a handler that panics again falls through to the
                # default report; an exit() inside it propagates
                if pr.flow == FL_EXIT() {
                    return pr.code
                }
            }
        }
        eprint("panic: " + r.msg + " (at line " + r.line.to_str() + ")\n")
        return 101
    }
    if r.flow == FL_EXIT() {
        return r.code
    }
    # call_fn's contract: FL_OK carries the fn's return value (the
    # interpreter's run(): None -> 0, int -> the masked exit code).
    if r.v.k == VK_INT() {
        return int_and(r.v.i, 255)
    }
    return 0
}

# hb_sandbox_gate(ctx, dir) — the sandbox laws, the .py's own order:
# extern blocks refuse (they call libc directly), then every fn whose
# computed effects reach Proc (proc_exec runs arbitrary shell outside
# the sandbox), then the dir itself must exist. 0 = the gate opens.
fn hb_sandbox_gate(ctx: Ctx, dir: str) -> int uses IO, Fs {
    let keys: list[str] = ctx.fns.keys()
    let mut ki: int = 0
    while ki < keys.len() {
        let fk: str = keys.get(ki)
        let f: FnInfo = ctx.fns.get_or(fk, dummy_fn())
        if f.is_extern {
            eprint("error: --sandbox is incompatible with `extern \"C\"` blocks (extern can call libc directly, bypassing the sandbox)\n")
            return 1
        }
        let effs: list[str] = ctx.computed_effects.get_or(fk, [])
        let mut ei: int = 0
        while ei < effs.len() {
            if effs.get(ei) == "Proc" {
                eprint("error: --sandbox is incompatible with the Proc effect (function '" + f.name + "' can reach proc_exec, which runs arbitrary shell commands outside the sandbox)\n")
                return 1
            }
            ei = ei + 1
        }
        ki = ki + 1
    }
    if !fs_is_dir(dir) {
        eprint("error: --sandbox: not a directory: " + dir + "\n")
        return 2
    }
    return 0
}

# ----------------------------------------------------------------------------
# The Stage 17 model checker — hlmodel's whole flow, riding the
# evaluator that executes it (the .py drove a monkey-instance of the
# Python interpreter; the port IS the interpreter). The wire is the
# .py's: same header, same table, same BFS report, same exits.
# ----------------------------------------------------------------------------

# hb_param_base(t) — the type before any "[" (the enum name a param
# must be).
fn hb_param_base(t: str) -> str {
    let cut: int = t.find("[")
    if cut < 0 {
        return t
    }
    return t.slice(0, cut)
}

# hb_model(path, fn_name, inv_name, init_variant) -> int — exhaustive
# finite-state model check: every (state, event) pair EXECUTED with
# contracts armed (deep-scan-10: an always-false requires used to pass
# silently), then the BFS reachability + invariant walk (deep-scan-12:
# a FIFO frontier, and contract-violation panics reported separately
# from dead transitions).
fn hb_model(path: str, fn_name: str, inv_name: str, init_variant: str) -> int uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let boot: Boot = hb_load_checked(path, ["hlmodel"], true, "", "", "")
    eprint("__HLBOOT_COMPILED__\n")
    let ctx: Ctx = boot.ctx
    if !ctx.fns.has(fn_name) {
        eprint("hlmodel: function not found: " + fn_name + "\n")
        return 1
    }
    let f: FnInfo = ctx.fns.get_or(fn_name, dummy_fn())
    if f.params.len() != 2 {
        eprint("hlmodel: transition fn must take exactly two enum parameters (state, event)\n")
        return 1
    }
    # the two enum domains (payload-less only)
    let s_enum: str = hb_param_base(f.ptypes.get(0))
    let e_enum: str = hb_param_base(f.ptypes.get(1))
    if !ctx.enums.has(s_enum) {
        eprint("hlmodel: parameter '" + f.params.get(0) + "' of the transition must be a payload-less enum, got " + f.ptypes.get(0) + "\n")
        return 1
    }
    if !ctx.enums.has(e_enum) {
        eprint("hlmodel: parameter '" + f.params.get(1) + "' of the transition must be a payload-less enum, got " + f.ptypes.get(1) + "\n")
        return 1
    }
    let sen: EnumInfo = ctx.enums.get_or(s_enum, dummy_enum())
    let een: EnumInfo = ctx.enums.get_or(e_enum, dummy_enum())
    let s_variants: list[str] = []
    let mut si: int = 0
    while si < sen.variants.len() {
        if sen.payloads.get(si).len() > 0 {
            eprint("hlmodel: enum " + s_enum + " has payload variant " + sen.variants.get(si) + " — model checking is defined for payload-less state enums only\n")
            return 1
        }
        s_variants.push(sen.variants.get(si))
        si = si + 1
    }
    let e_variants: list[str] = []
    let mut ei: int = 0
    while ei < een.variants.len() {
        if een.payloads.get(ei).len() > 0 {
            eprint("hlmodel: enum " + e_enum + " has payload variant " + een.variants.get(ei) + " — model checking is defined for payload-less state enums only\n")
            return 1
        }
        e_variants.push(een.variants.get(ei))
        ei = ei + 1
    }
    println("hlmodel — exhaustive model check of '" + fn_name + "'")
    println("  states:  " + s_enum + " = {" + join(s_variants, ", ") + "}")
    println("  events:  " + e_enum + " = {" + join(e_variants, ", ") + "}")
    println("  domain:  " + s_variants.len().to_str() + " x " + e_variants.len().to_str() + " = " + (s_variants.len() * e_variants.len()).to_str() + " transitions")
    println("")
    # ---- the exhaustive table ----
    let mut violations: int = 0
    let mut a: int = 0
    while a < s_variants.len() {
        let sv: str = s_variants.get(a)
        let mut b: int = 0
        while b < e_variants.len() {
            let ev: str = e_variants.get(b)
            let r: R = call_fn(boot, fn_name,
            [v_enum(s_enum, sv, []), v_enum(e_enum, ev, [])])
            let mut status: str = ""
            if r.flow == FL_PANIC() {
                violations = violations + 1
                status = "PANIC: " + r.msg
            } else {
                status = "-> " + r.v.var
            }
            println("    " + s_enum + "." + sv + " + " + e_enum + "." + ev + "  " + status)
            b = b + 1
        }
        a = a + 1
    }
    println("")
    if violations > 0 {
        println("  VIOLATIONS: " + violations.to_str() + " transitions panicked (see above)")
    } else {
        println("  All " + (s_variants.len() * e_variants.len()).to_str() + " transitions terminate without panic.")
    }
    # ---- reachability + invariant (BFS) ----
    if inv_name != "" {
        if !ctx.fns.has(inv_name) {
            eprint("hlmodel: invariant fn not found: " + inv_name + "\n")
            return 1
        }
        let mut init_v: str = init_variant
        if init_v == "" {
            init_v = s_variants.get(0)
        }
        if !list_has(s_variants, init_v) {
            eprint("hlmodel: --init must be a variant of " + s_enum + "\n")
            return 1
        }
        println("")
        println("  Reachability (BFS from " + s_enum + "." + init_v + ") + invariant '" + inv_name + "':")
        # the invariant on the initial state
        let bad_states: list[str] = []
        let r0: R = call_fn(boot, inv_name, [v_enum(s_enum, init_v, [])])
        if r0.flow == FL_PANIC() {
            bad_states.push(init_v + " (panic: " + r0.msg + ")")
        } else {
            if r0.v.k != VK_BOOL() || r0.v.i == 0 {
                bad_states.push(init_v)
            }
        }
        let seen: list[str] = [init_v]
        # FIFO frontier (deep-scan-12: pop(0), not pop())
        let frontier: list[V] = [v_enum(s_enum, init_v, [])]
        let mut head: int = 0
        let contract_violations: list[str] = []
        let mut edges: int = 0
        while head < frontier.len() {
            let cur: V = frontier.get(head)
            head = head + 1
            let mut b2: int = 0
            while b2 < e_variants.len() {
                let ev2: str = e_variants.get(b2)
                let r: R = call_fn(boot, fn_name,
                [cur, v_enum(e_enum, ev2, [])])
                if r.flow == FL_PANIC() {
                    # contract-violation panics are REPORTED; other
                    # panics are dead transitions (deep-scan-12)
                    if r.msg.contains("contract violation") {
                        contract_violations.push(cur.var + " + " + ev2 + ": " + r.msg)
                    }
                    b2 = b2 + 1
                    continue
                }
                let nvar: str = r.v.var
                edges = edges + 1
                if !list_has(seen, nvar) {
                    seen.push(nvar)
                    let ri: R = call_fn(boot, inv_name, [r.v])
                    if ri.flow == FL_PANIC() {
                        bad_states.push(nvar + " (panic: " + ri.msg + ")")
                    } else {
                        if ri.v.k != VK_BOOL() || ri.v.i == 0 {
                            bad_states.push(nvar)
                        }
                    }
                    frontier.push(r.v)
                }
                b2 = b2 + 1
            }
        }
        let dead: list[str] = []
        let mut d: int = 0
        while d < s_variants.len() {
            if !list_has(seen, s_variants.get(d)) {
                dead.push(s_variants.get(d))
            }
            d = d + 1
        }
        println("    reachable states: " + seen.len().to_str() + " / " + s_variants.len().to_str() + " (" + edges.to_str() + " edges explored)")
        if contract_violations.len() > 0 {
            println("    CONTRACT VIOLATIONS (" + contract_violations.len().to_str() + "):")
            let mut c: int = 0
            while c < contract_violations.len() {
                println("      " + contract_violations.get(c))
                c = c + 1
            }
        }
        if dead.len() > 0 {
            println("    DEAD states (unreachable from " + s_enum + "." + init_v + "): " + join(dead, ", "))
        } else {
            println("    no dead states — the machine is fully reachable")
        }
        if bad_states.len() > 0 {
            println("    INVARIANT VIOLATED in: " + join(bad_states, ", "))
            return 1
        }
        println("    invariant '" + inv_name + "' holds on every reachable state ✓")
    }
    if violations > 0 {
        return 1
    }
    return 0
}

# hb_read_all_stdout(ch) / hb_read_all_stderr(ch) — drain a child's
# pipe to EOF.
fn hb_drain(ch: Child, fd: int) -> str uses Proc {
    let mut out: str = ""
    let mut go: bool = true
    while go {
        let mut chunk: str = ""
        if fd == 1 {
            chunk = child_read_stdout(ch, 65536)
        } else {
            chunk = child_read_stderr(ch, 65536)
        }
        if chunk.len() == 0 {
            go = false
        } else {
            out = out + chunk
        }
    }
    return out
}

# hb_spawn_child(path, args) — spawn this tool as a child with piped
# stdio; returns the captured (code, out, err).
struct CapRes {
    code: int,
    out: str,
    err: str
}

fn hb_spawn_child(prog: str, cargs: list[str]) -> CapRes uses Proc {
    let mut c: Command = command_new(prog)
    let mut i: int = 0
    while i < cargs.len() {
        c = command_arg(c, cargs.get(i))
        i = i + 1
    }
    c = command_stdout(c, stdio_pipe())
    c = command_stderr(c, stdio_pipe())
    let ch: Child = command_spawn(c)
    # Alternate reads so a child flooding one pipe while blocked on
    # the other cannot deadlock (64 KB pipe buffers).
    let mut out: str = ""
    let mut err: str = ""
    let mut out_open: bool = ch.stdout_open
    let mut err_open: bool = ch.stderr_open
    while out_open || err_open {
        if out_open {
            let mut chunk: str = child_read_stdout(ch, 65536)
            if chunk.len() == 0 {
                out_open = false
                child_close_stdout(ch)
            } else {
                out = out + chunk
            }
        }
        if err_open {
            let mut chunk2: str = child_read_stderr(ch, 65536)
            if chunk2.len() == 0 {
                err_open = false
                child_close_stderr(ch)
            } else {
                err = err + chunk2
            }
        }
    }
    let code: int = child_wait(ch)
    return CapRes {
        code: code, out: out, err: err
    }
}

# stdio_pipe() — the Stdio pipe selector for std.process.
fn stdio_pipe() -> Stdio {
    return stdio_from_int(1)
}

# hb_strip_marker(err) — drop the compile-succeeded marker line.
fn hb_strip_marker(err: str) -> str {
    let marker: str = "__HLBOOT_COMPILED__\n"
    let pos: int = err.find(marker)
    if pos < 0 {
        return err
    }
    return err.slice(0, pos) + err.slice(pos + marker.len(), err.len())
}

# hb_first_real_line(s) — the first line that is not the compiled
# marker (the probe children stamp __HLBOOT_COMPILED__ on stderr before
# the mode output; a refusal that follows it is the message to relay).
fn hb_first_real_line(s: str) -> str {
    let mut rest: str = s
    while rest != "" {
        let l: str = hb_first_line(rest)
        if l != "__HLBOOT_COMPILED__" {
            return l
        }
        let cut: int = rest.find("\n")
        if cut < 0 {
            return ""
        }
        rest = rest.slice(cut + 1, rest.len())
    }
    return ""
}

# hb_first_line(s) — up to the first newline.
fn hb_first_line(s: str) -> str {
    let pos: int = s.find("\n")
    if pos < 0 {
        return s
    }
    return s.slice(0, pos)
}

# hb_batch(list_path, log_path, check_only) -> int — one child per
# file, fd-level capture over pipes, one TSV record per file in list
# order (the wire suite_01 reads).
fn hb_batch(list_path: str, log_path: str, check_only: bool, self_path: str) -> int uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    if !file_exists(list_path) {
        eprint("error: cannot open batch list " + list_path + "\n")
        return 2
    }
    let raw: str = read_file(list_path)
    let lines: list[str] = raw.split("\n")
    let files: list[str] = []
    let mut i: int = 0
    while i < lines.len() {
        let ln: str = lines.get(i).trim()
        if ln != "" && !ln.starts_with("#") {
            files.push(ln)
        }
        i = i + 1
    }
    let mut log: str = ""
    let mut fi: int = 0
    while fi < files.len() {
        let path: str = files.get(fi)
        let cargs: list[str] = []
        if check_only {
            cargs.push("--probe-check")
        } else {
            cargs.push("--probe-run")
        }
        cargs.push(path)
        let res: CapRes = hb_spawn_child(self_path, cargs)
        let mut rc: int = res.code
        let out: str = res.out
        let mut err: str = hb_strip_marker(res.err)
        if rc != 0 && res.err.find("__HLBOOT_COMPILED__") < 0 {
            # The compile half died (load/check panic): the record the
            # single-file invocation would have made — rc 1, the
            # compile error line on stderr.
            let mut msg: str = hb_first_line(res.err)
            if msg.starts_with("panic: ") {
                msg = msg.slice(7, msg.len())
            }
            err = "compile error: " + msg + "\n"
            rc = 1
        }
        log = log + rc.to_str() + "\t" + base64_encode(path) + "\t"
        + base64_encode(out) + "\t" + base64_encode(err) + "\n"
        fi = fi + 1
    }
    write_file(log_path, log)
    return 0
}

# ----------------------------------------------------------------------------
# The hltest execution family (Stage 18, the runner's native port): the
# evaluator IS the test engine -- one fresh Boot per test, exactly the
# .py years' fresh-Interp law, with the process boundary for the
# isolation and the pipes for the stdout capture the snapshot records
# ride on.
# ----------------------------------------------------------------------------

# hb_value_kind(v) -> str — the .py's _value_kind: a human name for a
# runtime value, for table-shape diagnostics. Structs describe their
# field names (the runtime value carries no type name); a struct whose
# fields are exactly {name, row} is a TestCase value.
fn hb_value_kind(v: V) -> str {
    if v.k == VK_STR() {
        return "a str"
    }
    if v.k == VK_BOOL() {
        return "a bool"
    }
    if v.k == VK_INT() {
        return "an int"
    }
    if v.k == VK_FLOAT() {
        return "a float"
    }
    if v.k == VK_LIST() {
        return "a list"
    }
    if v.k == VK_ENUM() {
        return "a " + v.s + "." + v.var + " enum value"
    }
    if v.k == VK_STRUCT() || v.k == VK_MAP() {
        if v.k == VK_STRUCT() && v.keys.len() == 2
        && v.keys.get(0) == "name" && v.keys.get(1) == "row" {
            return "a TestCase value"
        }
        let mut ks: str = ""
        let mut i: int = 0
        while i < v.keys.len() && i < 4 {
            if i > 0 {
                ks = ks + ", "
            }
            ks = ks + v.keys.get(i)
            i = i + 1
        }
        return "a struct value {" + ks + "}"
    }
    if v.k == VK_UNIT() {
        return "void"
    }
    if v.k == VK_TAINTED() {
        return "a tainted value"
    }
    return "a value"
}

# hb_case_name_ok(s) -> bool — the case-name charset: 1..96 bytes of
# [A-Za-z0-9_.:-] (the same law as snapshot names; a row's report line
# is also its store key).
fn hb_case_name_ok(s: str) -> bool {
    if s.len() < 1 || s.len() > 96 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        let ok: bool = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
        || (b >= 48 && b <= 57) || b == 95 || b == 46 || b == 58 || b == 45
        if !ok {
            return false
        }
        i = i + 1
    }
    return true
}

# hb_struct_field(v, key) -> V — a struct field by name (unit when the
# key is absent; callers validate the shape first).
fn hb_struct_field(v: V, key: str) -> V {
    let mut i: int = 0
    while i < v.keys.len() {
        if v.keys.get(i) == key {
            return v.vals.get(i)
        }
        i = i + 1
    }
    return v_unit()
}

# hb_is_testcase(v) -> bool — a TestCase { name, row } struct value,
# exactly (the .py's set(keys) == {"name", "row"}).
fn hb_is_testcase(v: V) -> bool {
    if v.k != VK_STRUCT() {
        return false
    }
    if v.keys.len() != 2 {
        return false
    }
    let mut has_name: bool = false
    let mut has_row: bool = false
    let mut i: int = 0
    while i < v.keys.len() {
        if v.keys.get(i) == "name" {
            has_name = true
        }
        if v.keys.get(i) == "row" {
            has_row = true
        }
        i = i + 1
    }
    return has_name && has_row
}

# hb_run_table_probe(path, cases_fn) -> int — the table half of a
# parameterised test, as one child: execute the case table in a fresh
# evaluator, validate every row's shape and name, print the row
# universe as TSV (index <TAB> name). A panic or a malformed table is
# the __HLTEST_TABLE__ marker on stderr + exit 1 (the parent relays
# the text under the test's base name); exit 0 is the universe.
fn hb_run_table_probe(path: str, cases_fn: str) -> int uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let boot2: Boot = hb_load_checked(path, [path], false, "", "", "")
    let t: R = call_fn(boot2, cases_fn, [])
    if t.flow == FL_PANIC() {
        eprint("__HLTEST_TABLE__:case table '" + cases_fn + "' panicked: " + t.msg + "\n")
        return 1
    }
    if t.flow == FL_EXIT() {
        eprint("__HLTEST_TABLE__:case table '" + cases_fn + "' called exit(" + t.code.to_str() + ")\n")
        return 1
    }
    if t.v.k != VK_LIST() {
        eprint("__HLTEST_TABLE__:case table '" + cases_fn + "' returned " + hb_value_kind(t.v) + ", expected a list[std.test.TestCase[...]]\n")
        return 1
    }
    let rows: list[V] = t.v.vals
    let mut seen: list[str] = []
    let mut idx: int = 0
    let mut tsv: str = ""
    while idx < rows.len() {
        let item: V = rows.get(idx)
        if !hb_is_testcase(item) {
            eprint("__HLTEST_TABLE__:row " + idx.to_str() + " of case table '" + cases_fn + "' is not a TestCase { name, row } value (got " + hb_value_kind(item) + ")\n")
            return 1
        }
        let nv: V = hb_struct_field(item, "name")
        if nv.k != VK_STR() {
            eprint("__HLTEST_TABLE__:row " + idx.to_str() + " of case table '" + cases_fn + "' has a non-str name (got " + hb_value_kind(nv) + ")\n")
            return 1
        }
        let nm: str = nv.s
        if !hb_case_name_ok(nm) {
            eprint("__HLTEST_TABLE__:invalid case name '" + nm + "' in '" + cases_fn + "' - case names are 1..96 bytes of [A-Za-z0-9_.:-] (the same charset as snapshot names: a row's report line is also its snapshot-store test key)\n")
            return 1
        }
        let mut dup: bool = false
        let mut si: int = 0
        while si < seen.len() {
            if seen.get(si) == nm {
                dup = true
            }
            si = si + 1
        }
        if dup {
            eprint("__HLTEST_TABLE__:duplicate case name '" + nm + "' in '" + cases_fn + "' - two rows would race for one report line and one snapshot-store slot\n")
            return 1
        }
        seen.push(nm)
        tsv = tsv + idx.to_str() + "\t" + nm + "\n"
        idx = idx + 1
    }
    print(tsv)
    return 0
}

# hb_run_test_fn(path, tname, table_fn, row_index) -> int — ONE test in
# ONE fresh evaluator: the .py's _invoke. A plain test runs with no
# arguments; a table row re-executes the case table INSIDE the same
# evaluator (the row value is born in the state that consumes it) and
# hands the row to the test fn. Exit protocol: 0 pass, 3 skip (the
# __HLTEST_SKIP__ panic), 1 fail (the __HLTEST_PANIC__ detail on
# stderr), 4 exit(n) inside the test; the test's own stdout passes
# through for the parent's snapshot-record parser.
fn hb_run_test_fn(path: str, tname: str, table_fn: str, row_index: int) -> int uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let boot2: Boot = hb_load_checked(path, [path], false, "", "", "")
    let targs: list[V] = []
    if table_fn != "" {
        let t: R = call_fn(boot2, table_fn, [])
        let mut bad: str = ""
        if t.flow == FL_PANIC() {
            bad = "case table '" + table_fn + "' panicked: " + t.msg
        } else if t.v.k != VK_LIST() || row_index >= t.v.vals.len()
        || !hb_is_testcase(t.v.vals.get(row_index)) {
            bad = "case table '" + table_fn + "' did not yield row " + row_index.to_str() + " on re-run - a case table must be deterministic"
        }
        if bad != "" {
            eprint("__HLTEST_PANIC__:" + bad + "\n")
            return 1
        }
        targs.push(hb_struct_field(t.v.vals.get(row_index), "row"))
    }
    let r: R = call_fn(boot2, tname, targs)
    if r.flow == FL_PANIC() {
        if r.msg.starts_with("__HLTEST_SKIP__:") {
            eprint(r.msg + "\n")
            return 3
        }
        eprint("__HLTEST_PANIC__:" + r.msg + "\n")
        return 1
    }
    if r.flow == FL_EXIT() {
        if r.code == 0 {
            return 0
        }
        eprint("__HLTEST_EXIT__:" + r.code.to_str() + "\n")
        return 4
    }
    return 0
}

# hb_main_inner(argv) -> int — the CLI law (flags before the file,
# program args after).
fn hb_main_inner(argv: list[str]) -> int uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let n: int = argv.len()
    let mut i: int = 1
    let mut check_only: bool = false
    let mut audit_only: bool = false
    let mut det_mode: bool = false
    let mut contracts: bool = false
    let mut fast_mode: bool = false
    let mut sandbox_dir: str = ""
    let mut target_feature: str = ""
    let mut target_triple: str = ""
    let mut emit_mode: str = ""
    let mut cov_out: str = ""
    let mut model_mode: bool = false
    let mut batch_list: str = ""
    let mut batch_log: str = ""
    let mut batch: bool = false
    # Leading flags end at the first non-flag argument (the entry
    # file); everything after it belongs to the program.
    while i < n {
        let a: str = argv.get(i)
        if a == "--batch" {
            if i + 2 >= n {
                eprint("error: --batch needs a list file and a log file\n")
                return 2
            }
            batch = true
            batch_list = argv.get(i + 1)
            batch_log = argv.get(i + 2)
            i = i + 3
            continue
        }
        if a == "--model" {
            # the Stage 17 model checker rides the evaluator (the file
            # and its --fn/--invariant/--init flags follow, the .py's
            # own order)
            model_mode = true
            i = i + 1
            continue
        }
        if a == "--cov-run" {
            # private-ish flag (the coverage tool drives it): arm the
            # fn-call counter, run the program, write the hits TSV on
            # the way out — panic or not, the counts survive.
            if i + 1 >= n {
                eprint("error: --cov-run expects a tsv path\n")
                return 2
            }
            cov_out = argv.get(i + 1)
            env_set("HLBOOT_COV", "1")
            i = i + 2
            continue
        }
        if a == "--probe-table" {
            # private flag (the hltest runner re-invokes the tool): the
            # case-table half of a parameterised test, validated, as TSV.
            if i + 2 >= n {
                eprint("error: --probe-table needs a table fn and a file\n")
                return 2
            }
            return hb_run_table_probe(argv.get(i + 2), argv.get(i + 1))
        }
        if a == "--test-fn" {
            # private flag (the hltest runner re-invokes the tool): one
            # test in one fresh evaluator; --table/--row-index turn it
            # into one ROW of a parameterised test (the table re-runs
            # inside the same evaluator, the .py's same-state law).
            if i + 1 >= n {
                eprint("error: --test-fn needs a name\n")
                return 2
            }
            let tname2: str = argv.get(i + 1)
            let mut j2: int = i + 2
            let mut table_fn2: str = ""
            let mut row_index2: int = -1
            while j2 < n {
                let fa: str = argv.get(j2)
                if fa == "--table" && j2 + 1 < n {
                    table_fn2 = argv.get(j2 + 1)
                    j2 = j2 + 2
                continue
                }
                if fa == "--row-index" && j2 + 1 < n {
                    row_index2 = argv.get(j2 + 1).to_int()
                    j2 = j2 + 2
                    continue
                }
                break
            }
            if j2 >= n {
                eprint("error: --test-fn needs a file\n")
                return 2
            }
            return hb_run_test_fn(argv.get(j2), tname2, table_fn2, row_index2)
        }
        if a == "--emit" {
            if i + 1 >= n {
                eprint("error: --emit expects 'ir', 'llvm' or 'lto'\n")
                return 2
            }
            let mode: str = argv.get(i + 1)
            if mode != "ir" && mode != "llvm" && mode != "lto" {
                eprint("error: --emit expects 'ir', 'llvm' or 'lto'\n")
                return 2
            }
            emit_mode = mode
            i = i + 2
            continue
        }
        if a == "--probe-emit" {
            # private flag (the emit parent re-invokes the tool): load,
            # check, print the emission on stdout — the lto report goes
            # to stderr, the .py's own law.
            if i + 2 >= n {
                eprint("error: --probe-emit needs a mode and a file\n")
                return 2
            }
            let pmode: str = argv.get(i + 1)
            let ppath: str = argv.get(i + 2)
            let tt: str = env_get("HLBOOT_TARGET_TRIPLE")
            let tf: str = env_get("HLBOOT_TARGET_FEATURE")
            let ctx: Ctx = hb_load_ctx(ppath, tt)
            if pmode == "ir" {
                print(hlemit_ir(ctx))
                return 0
            }
            if pmode == "llvm" {
                print(hlemit_llvm(ctx, tt, tf))
                return 0
            }
            let lto: TyVal2 = hlemit_lto(ctx, tt, tf)
            eprint(lto.report + "\n")
            print(lto.text)
            return 0
        }
        if a == "--probe-model" {
            # private flag (the model parent re-invokes the tool): the
            # file, then the .py's own flag order
            if i + 1 >= n {
                eprint("error: --probe-model needs a file\n")
                return 2
            }
            let mpath: str = argv.get(i + 1)
            let mut mfn: str = ""
            let mut minv: str = ""
            let mut minit: str = ""
            let mut j: int = i + 2
            while j < n {
                let fa: str = argv.get(j)
                if fa == "--fn" && j + 1 < n {
                    mfn = argv.get(j + 1)
                    j = j + 2
                } else if fa == "--invariant" && j + 1 < n {
                    minv = argv.get(j + 1)
                    j = j + 2
                } else if fa == "--init" && j + 1 < n {
                    minit = argv.get(j + 1)
                    j = j + 2
                } else {
                    j = j + 1
                }
            }
            return hb_model(mpath, mfn, minv, minit)
        }
        if a == "--probe-audit" {
            if i + 1 >= n {
                eprint("error: --probe-audit needs a file\n")
                return 2
            }
            let path3: str = argv.get(i + 1)
            let sb3: str = env_get("HLS_SANDBOX_ROOT")
            let tt3: str = env_get("HLBOOT_TARGET_TRIPLE")
            let boot3: Boot = hb_load_checked(path3, [path3], false, "", sb3, tt3)
            eprint("__HLBOOT_COMPILED__\n")
            print_audit(boot3.ctx)
            return 0
        }
        if a == "--probe-run" || a == "--probe-check" {
            # private flags (the batch children re-invoke the tool; the
            # plain-run relay does too, carrying the program's own args
            # and the contracts / target-feature modes through the env)
            if i + 1 >= n {
                eprint("error: " + a + " needs a file\n")
                return 2
            }
            let path: str = argv.get(i + 1)
            let sb: str = env_get("HLS_SANDBOX_ROOT")
            let tt: str = env_get("HLBOOT_TARGET_TRIPLE")
            let tf: str = env_get("HLBOOT_TARGET_FEATURE")
            let ct: bool = env_get("HLBOOT_CONTRACTS") != ""
            let prog_args: list[str] = [path]
            let mut pai: int = i + 2
            while pai < n {
                prog_args.push(argv.get(pai))
                pai = pai + 1
            }
            let boot2: Boot = hb_load_checked(path, prog_args, ct, tf, sb, tt)
            eprint("__HLBOOT_COMPILED__\n")
            if a == "--probe-check" {
                # The sandbox gate rides the check too (boot.py's law:
                # extern blocks and Proc-reaching programs are refused
                # at COMPILE time under --sandbox, not only at run
                # time — the gate is what keeps the promise sound).
                if sb != "" {
                    let r2: int = hb_sandbox_gate(boot2.ctx, sb)
                    if r2 != 0 {
                        return 1
                    }
                }
                print("OK: types and effects valid\n")
                return 0
            }
            return hb_run_program(boot2)
        }
        if a == "--check" {
            check_only = true
            i = i + 1
            continue
        }
        if a == "--audit" {
            audit_only = true
            i = i + 1
            continue
        }
        if a == "--det" {
            det_mode = true
            i = i + 1
            continue
        }
        if a == "--contracts" {
            contracts = true
            i = i + 1
            continue
        }
        if a == "--fast" {
            fast_mode = true
            i = i + 1
            continue
        }
        if a == "-O" {
            fast_mode = true
            i = i + 2
            continue
        }
        if a == "--sandbox" {
            if i + 1 >= n {
                eprint("error: --sandbox expects a directory\n")
                return 2
            }
            sandbox_dir = argv.get(i + 1)
            i = i + 2
            continue
        }
        if a == "--target-feature" {
            if i + 1 >= n {
                eprint("error: --target-feature expects a name (sse4.2 | avx2 | neon | rvv | native)\n")
                return 2
            }
            target_feature = argv.get(i + 1)
            if target_feature == "native" {
                target_feature = ""
                if simd_cpu_supports("avx2") {
                    target_feature = "avx2"
                } else if simd_cpu_supports("sse4.2") {
                    target_feature = "sse4.2"
                } else if simd_cpu_supports("neon") {
                    target_feature = "neon"
                } else if simd_cpu_supports("rvv") {
                    target_feature = "rvv"
                }
            }
            if target_feature != "" && target_feature != "sse4.2"
            && target_feature != "avx2" && target_feature != "neon"
            && target_feature != "rvv" {
                eprint("error: unknown target feature '" + target_feature + "' (expected sse4.2 | avx2 | neon | rvv | native)\n")
                return 2
            }
            i = i + 2
            continue
        }
        # Silently accepted native-only flags (the same command line
        # works for both paths in differential testing).
        if a == "--lto" || a == "--lto-stats" {
            i = i + 1
            continue
        }
        if a == "--target" {
            if i + 1 >= n {
                eprint("error: --target expects a triple\n")
                return 2
            }
            target_triple = argv.get(i + 1)
            # Without an emission mode --target is the bare-metal
            # selector; behind --emit llvm/lto it keeps its Stage 12
            # LLVM cross-compilation meaning (any triple).
            if target_triple != "x86_64-unknown-none"
            && target_triple != "aarch64-unknown-none"
            && target_triple != "riscv64-unknown-none"
            && emit_mode != "llvm" && emit_mode != "lto" {
                eprint("error: unknown bare-metal target '" + target_triple + "' (expected x86_64-unknown-none | aarch64-unknown-none | riscv64-unknown-none)\n")
                return 2
            }
            i = i + 2
            continue
        }
        if a == "--lto-threshold" {
            i = i + 2
            continue
        }
        break
    }
    if target_triple != "" && target_feature != "" {
        eprint("error: --target-feature is not available on target " + target_triple + " (bare-metal targets are integer-only: SIMD intrinsics use floating-point registers)\n")
        return 2
    }
    if check_only && audit_only {
        eprint("error: --check / --audit are mutually exclusive\n")
        return 2
    }
    # BUG-025's law, the emit trio included: one mode at a time.
    let mut mode_count: int = 0
    if check_only {
        mode_count = mode_count + 1
    }
    if audit_only {
        mode_count = mode_count + 1
    }
    if emit_mode != "" {
        mode_count = mode_count + 1
    }
    if mode_count > 1 {
        eprint("error: --check / --audit / --emit ir / --emit llvm / --emit lto are mutually exclusive\n")
        return 2
    }
    if batch {
        if audit_only || emit_mode != "" {
            eprint("error: --batch is incompatible with mode flags other than --check\n")
            return 2
        }
        return hb_batch(batch_list, batch_log, check_only, argv.get(0))
    }
    # --det: arm the scheduler env and re-exec (the mode is read at
    # process start, the same way the native runtime reads it).
    if det_mode {
        env_set("HL_DET_SCHED", "1")
        let mut cmd: str = hb_shell_quote(argv.get(0))
        let mut j: int = 1
        let mut skipped: bool = false
        while j < n {
            let a2: str = argv.get(j)
            if !skipped && a2 == "--det" {
                skipped = true
                j = j + 1
                continue
            }
            cmd = cmd + " " + hb_shell_quote(a2)
            j = j + 1
        }
        return proc_exec(cmd)
    }
    if i >= n {
        eprint(hb_usage())
        return 2
    }
    let path: str = argv.get(i)
    if !file_exists(path) {
        eprint("error: cannot open file " + path + "\n")
        return 2
    }
    let prog_args: list[str] = []
    let mut k: int = i
    while k < n {
        prog_args.push(argv.get(k))
        k = k + 1
    }
    if model_mode {
        # the .py's wire: the file first, then --fn / --invariant /
        # --init in any order
        let mut mfn: str = ""
        let mut minv: str = ""
        let mut minit: str = ""
        let mut j: int = i + 1
        while j < n {
            let fa: str = argv.get(j)
            if fa == "--fn" && j + 1 < n {
                mfn = argv.get(j + 1)
                j = j + 2
            } else if fa == "--invariant" && j + 1 < n {
                minv = argv.get(j + 1)
                j = j + 2
            } else if fa == "--init" && j + 1 < n {
                minit = argv.get(j + 1)
                j = j + 2
            } else {
                j = j + 1
            }
        }
        if mfn == "" {
            eprint("hlmodel: --fn <transition> is required\n")
            return 2
        }
        let cargs5: list[str] = ["--probe-model", path, "--fn", mfn]
        if minv != "" {
            cargs5.push("--invariant")
            cargs5.push(minv)
        }
        if minit != "" {
            cargs5.push("--init")
            cargs5.push(minit)
        }
        let res5: CapRes = hb_spawn_child(argv.get(0), cargs5)
        if res5.code < 0 {
            eprint("hlmodel: the evaluator failed to spawn\n")
            return 1
        }
        if res5.code != 0 && !res5.err.contains("__HLBOOT_COMPILED__") {
            # the load itself died: the clean compile error
            let mut msg5: str = hb_first_real_line(res5.err)
            if msg5.starts_with("panic: ") {
                msg5 = msg5.slice(7, msg5.len())
            }
            eprint("compile error: " + msg5 + "\n")
            return 1
        }
        print(res5.out)
        return res5.code
    }
    if audit_only {
        # The probe-child discipline (the same law as --check); the
        # triple rides through the env the same way.
        env_set("HLBOOT_TARGET_TRIPLE", target_triple)
        let cargs3: list[str] = ["--probe-audit", path]
        let res3: CapRes = hb_spawn_child(argv.get(0), cargs3)
        if res3.code != 0 {
            let mut msg3: str = hb_first_line(res3.err)
            if msg3.starts_with("panic: ") {
                msg3 = msg3.slice(7, msg3.len())
            }
            eprint("compile error: " + msg3 + "\n")
            return 1
        }
        print(res3.out)
        return 0
    }
    if emit_mode != "" {
        # The emission trio rides the same probe-child law: the child
        # loads + checks + prints (a construct the alpha LLVM subset
        # refuses dies as a panic, the parent reports it as a compile
        # error — exactly the .py's HLError handling).
        env_set("HLBOOT_TARGET_TRIPLE", target_triple)
        env_set("HLBOOT_TARGET_FEATURE", target_feature)
        let cargs4: list[str] = ["--probe-emit", emit_mode, path]
        let res4: CapRes = hb_spawn_child(argv.get(0), cargs4)
        if res4.code != 0 {
            let mut msg4: str = hb_first_line(res4.err)
            if msg4.starts_with("panic: ") {
                msg4 = msg4.slice(7, msg4.len())
            }
            eprint("compile error: " + msg4 + "\n")
            return 1
        }
        if emit_mode == "lto" {
            # the lto report line rides stderr (the .py wrote it there)
            let rep: str = hb_first_line(res4.err)
            if rep != "" {
                eprint(rep + "\n")
            }
        }
        print(res4.out)
        return 0
    }
    if check_only {
        # The probe-child discipline: the checker panics on a bad
        # program, and the parent turns the child's death into the
        # clean compile-error report. The triple rides through the env
        # (the child re-reads it before loading); so does the sandbox
        # root — the gate is a compile-time refusal in --check too.
        env_set("HLBOOT_TARGET_TRIPLE", target_triple)
        if sandbox_dir != "" {
            env_set("HLS_SANDBOX_ROOT", sandbox_dir)
        }
        let cargs: list[str] = ["--probe-check", path]
        let res: CapRes = hb_spawn_child(argv.get(0), cargs)
        if res.code != 0 {
            let mut msg: str = hb_first_real_line(res.err)
            if msg.starts_with("panic: ") {
                msg = msg.slice(7, msg.len())
            }
            eprint("compile error: " + msg + "\n")
            return 1
        }
        print(res.out)
        return 0
    }
    if sandbox_dir != "" {
        if !fs_is_dir(sandbox_dir) {
            eprint("error: --sandbox: not a directory: " + sandbox_dir + "\n")
            return 2
        }
        env_set("HLS_SANDBOX_ROOT", sandbox_dir)
    }
    if cov_out == "" {
        # The plain run rides the probe-child discipline (the same law
        # as --check / --batch): the child loads + checks + runs, and a
        # program that does not compile dies in the CHILD — the parent
        # turns that death into the clean compile-error report and
        # exit 1, the wire law the header documents. The contracts and
        # target-feature modes, the sandbox root and the det scheduler
        # all ride the environment the child inherits.
        env_set("HLBOOT_TARGET_TRIPLE", target_triple)
        env_set("HLBOOT_TARGET_FEATURE", target_feature)
        if contracts {
            env_set("HLBOOT_CONTRACTS", "1")
        } else {
            env_unset("HLBOOT_CONTRACTS")
        }
        let cargs6: list[str] = ["--probe-run", path]
        let mut pgi: int = 1
        while pgi < prog_args.len() {
            cargs6.push(prog_args.get(pgi))
            pgi = pgi + 1
        }
        let res6: CapRes = hb_spawn_child(argv.get(0), cargs6)
        if res6.code < 0 {
            eprint("hlboot: the evaluator failed to spawn\n")
            return 1
        }
        if res6.code != 0 && !res6.err.contains("__HLBOOT_COMPILED__") {
            # the load itself died: the clean compile error
            let mut msg6: str = hb_first_real_line(res6.err)
            if msg6.starts_with("panic: ") {
                msg6 = msg6.slice(7, msg6.len())
            }
            eprint("compile error: " + msg6 + "\n")
            return 1
        }
        # the run's own stderr rides along (a runtime panic's message,
        # the det trace — everything but the compile marker)
        let run_err6: str = hb_strip_marker(res6.err)
        if run_err6 != "" {
            eprint(run_err6)
        }
        if res6.out != "" {
            print(res6.out)
        }
        return res6.code
    }
    let boot: Boot = hb_load_checked(path, prog_args, contracts, target_feature, sandbox_dir, target_triple)
    if sandbox_dir != "" {
        let rgate: int = hb_sandbox_gate(boot.ctx, sandbox_dir)
        if rgate != 0 {
            return rgate
        }
    }
    let run_code: int = hb_run_program(boot)
    if cov_out != "" {
        # the coverage harvest: every hit fn in declaration order, one
        # "key<TAB>count" record per line (the tool joins it against the
        # static block counts)
        let mut lines: list[str] = []
        let mut fi: int = 0
        let order: list[str] = boot.ctx.fn_order
        while fi < order.len() {
            let key: str = order.get(fi)
            if boot.cov_hits.has(key) {
                lines.push(key + "\t" + boot.cov_hits.get_or(key, 0).to_str())
            }
            fi = fi + 1
        }
        let mut out: str = ""
        let mut li: int = 0
        while li < lines.len() {
            out = out + lines.get(li) + "\n"
            li = li + 1
        }
        write_file(cov_out, out)
    }
    return run_code
}

