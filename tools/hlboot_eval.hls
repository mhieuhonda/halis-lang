    if name == "math_atan2" {
        return r_ok(v_float(math_atan2(args.get(0).f, args.get(1).f)))
    }
    if name == "math_sinh" {
        return r_ok(v_float(math_sinh(args.get(0).f)))
    }
    if name == "math_cosh" {
        return r_ok(v_float(math_cosh(args.get(0).f)))
    }
