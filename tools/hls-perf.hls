# ============================================================================
# tools/hls-perf.hls — the Stage 136 per-commit performance regression
# dashboard, in Halis (the native twin of the Python hls-perf.py that
# retired; same CLI, same wire, same exits).
# ----------------------------------------------------------------------------
# hls-bench (Stage 124) measures; hls-perf remembers and judges:
#   record    run the REAL bench runner over the tracked suite and append
#             one entry pinned to `git rev-parse HEAD` (refused on a dirty
#             tree; --from-report imports a machine report instead)
#   sanction  a written excuse for one bench (reason mandatory)
#   gate      classify the newest record against the prior record of the
#             SAME instrument (Welch p, the seeded bootstrap CI against
#             the noise band); exit 1 on any unsanctioned regressed or
#             vanished bench
#   dashboard the deterministic PERFORMANCE.md render (sha256 ledger
#             digest embedded; two renders of one ledger are byte-identical)
#   history   read the ledger back
#
# The statistics are hls-bench's statistics, restated here natively (one
# law: Welch p < 0.05 for significance, the seeded bootstrap CI of the
# median change against the --threshold noise band). The ledger is JSONL
# (default .hlperf/history.jsonl), append-only, one object per line.
#
# Exit codes: 0 verified / 1 named violation / 2 usage or IO error.
# ============================================================================

import "std.str"
import "std.json"
import "std.result"
import "std.option"
import "std.fmt"
import "std.sha256"
import "./hlfront.hls"

# ----------------------------------------------------------------------------
# Constants (the .py's).
# ----------------------------------------------------------------------------

fn tool_name() -> str {
    return "hls-perf"
}

fn tool_version() -> str {
    return "0.154.0"
}

fn history_default() -> str {
    return ".hlperf/history.jsonl"
}

fn default_suite() -> str {
    return "benchmarks/regression_watch.hls"
}

fn default_samples() -> int {
    return 10
}

fn default_fixed_iters() -> int {
    return 400
}

fn default_noise_pct() -> float {
    return 5.0
}

fn default_dash_limit() -> int {
    return 12
}

fn min_samples() -> int {
    return 2
}

fn bootstrap_b() -> int {
    return 2000
}

fn alpha() -> float {
    return 0.05
}

# The 8-band sparkline alphabet and the mid band a constant series
# renders (raw UTF-8 bytes; each block is 3 bytes).
fn spark_bands() -> str {
    return "▁▂▃▄▅▆▇█"
}

fn spark_mid() -> str {
    return "▄"
}

# ----------------------------------------------------------------------------
# The named refusal (the .py's HlPerfError: a message + its exit code).
# ----------------------------------------------------------------------------

struct Err {
    msg: str,
    code: int
}

fn err1(msg: str) -> Err {
    return Err {
        msg: msg, code: 1
    }
}

fn err2(msg: str) -> Err {
    return Err {
        msg: msg, code: 2
    }
}

# ----------------------------------------------------------------------------
# Byte / string helpers.
# ----------------------------------------------------------------------------

fn is_digit_b(b: int) -> bool {
    return b >= 48 && b <= 57
}

fn is_hex_b(b: int) -> bool {
    if is_digit_b(b) {
        return true
    }
    return(b >= 97 && b <= 102) || (b >= 65 && b <= 70)
}

fn strip_ws(s: str) -> str {
    return s.trim()
}

fn take_s(s: str, n: int) -> str {
    if s.len() <= n {
        return s
    }
    return s.slice(0, n)
}

fn repeat_str(s: str, n: int) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

fn pad_right(s: str, width: int) -> str {
    if s.len() >= width {
        return s
    }
    return s + repeat_str(" ", width - s.len())
}

fn pad_left_num(v: int, width: int) -> str {
    let s: str = v.to_str()
    if s.len() >= width {
        return s
    }
    return repeat_str(" ", width - s.len()) + s
}

# hex_to_int(s) — a non-negative hex string as int (0 on garbage).
fn hex_to_int(s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if !is_hex_b(b) {
            return 0
        }
        if is_digit_b(b) {
            v = v * 16 + (b - 48)
        } else if b >= 97 {
            v = v * 16 + (b - 87)
        } else {
            v = v * 16 + (b - 55)
        }
        i = i + 1
    }
    return v
}

fn parse_int_opt(s: str) -> Option[int] {
    let t: str = strip_ws(s)
    if t.len() == 0 {
        return Option.None
    }
    let mut i: int = 0
    let mut neg: bool = false
    if t.byte_at(0) == 43 || t.byte_at(0) == 45 {
        neg = t.byte_at(0) == 45
        i = 1
    }
    if i >= t.len() {
        return Option.None
    }
    let mut v: int = 0
    while i < t.len() {
        if !is_digit_b(t.byte_at(i)) {
            return Option.None
        }
        v = v * 10 + (t.byte_at(i) - 48)
        i = i + 1
    }
    if neg {
        return Option.Some(0 - v)
    }
    return Option.Some(v)
}

fn parse_float_opt(s: str) -> Option[float] {
    let t: str = strip_ws(s)
    let n: int = t.len()
    if n == 0 {
        return Option.None
    }
    let mut i: int = 0
    if t.byte_at(0) == 43 || t.byte_at(0) == 45 {
        i = 1
    }
    let int_start: int = i
    while i < n && is_digit_b(t.byte_at(i)) {
        i = i + 1
    }
    let saw_digits: bool = i > int_start
    if i < n && t.byte_at(i) == 46 {
        i = i + 1
        let frac_start: int = i
        while i < n && is_digit_b(t.byte_at(i)) {
            i = i + 1
        }
        if i == frac_start && !saw_digits {
            return Option.None
        }
    }
    if !saw_digits && !(i > int_start && t.byte_at(i - 1) == 46) {
        return Option.None
    }
    if i < n && (t.byte_at(i) == 101 || t.byte_at(i) == 69) {
        i = i + 1
        if i < n && (t.byte_at(i) == 43 || t.byte_at(i) == 45) {
            i = i + 1
        }
        let exp_start: int = i
        while i < n && is_digit_b(t.byte_at(i)) {
            i = i + 1
        }
        if i == exp_start {
            return Option.None
        }
    }
    if i != n {
        return Option.None
    }
    return Option.Some(t.to_float())
}

# ----------------------------------------------------------------------------
# Path helpers (the harness path grammar, inlined).
# ----------------------------------------------------------------------------

fn path_basename(p: str) -> str {
    let mut i: int = p.len() - 1
    while i >= 0 {
        if p.byte_at(i) == 47 {
            return p.slice(i + 1, p.len())
        }
        i = i - 1
    }
    return p
}

fn path_dirname(p: str) -> str {
    let mut i: int = p.len() - 1
    while i >= 0 {
        if p.byte_at(i) == 47 {
            if i == 0 {
                return "/"
            }
            return p.slice(0, i)
        }
        i = i - 1
    }
    return "."
}

fn path_join2(base: str, rel: str) -> str {
    if base == "" {
        return rel
    }
    if base.byte_at(base.len() - 1) == 47 {
        return base + rel
    }
    return base + "/" + rel
}

fn path_is_absolute(p: str) -> bool {
    return p.len() > 0 && p.byte_at(0) == 47
}

fn path_abs(p: str, cwd: str) -> str {
    if path_is_absolute(p) {
        return p
    }
    return path_join2(cwd, p)
}

# ----------------------------------------------------------------------------
# Number formatting — the Python laws the report and the ledger pin.
# fmt_fixed(x, p) is %.<p>f; py_float_repr(x) is Python's repr (shortest
# round-trip, ".0" forced for integral values); fmt_g4 is %.4g.
# ----------------------------------------------------------------------------

fn fmt_fixed(x: float, p: int) -> str {
    return fmt_float_with_precision(x, p)
}

fn py_float_repr(x: float) -> str {
    if x < 0.0 {
        return "-" + py_float_repr(0.0 - x)
    }
    let mut p: int = 0
    while p <= 17 {
        let s: str = fmt_float_with_precision(x, p)
        if s.to_float() == x {
            if !s.contains(".") && !s.contains("e") {
                return s + ".0"
            }
            return s
        }
        p = p + 1
    }
    return x.to_str()
}

fn strip_trailing_zeros(s: str) -> str {
    if !s.contains(".") {
        return s
    }
    let mut t: str = s
    while t.len() > 0 && t.byte_at(t.len() - 1) == 48 {
        t = t.slice(0, t.len() - 1)
    }
    if t.len() > 0 && t.byte_at(t.len() - 1) == 46 {
        t = t.slice(0, t.len() - 1)
    }
    if t == "" || t == "-" {
        return "0"
    }
    return t
}

# fmt_g4(x) — Python's "%.4g" (4 significant digits, trailing zeros
# stripped, exponent form when exp < -4 or exp >= 4).
fn fmt_g4(x: float) -> str {
    if x < 0.0 {
        return "-" + fmt_g4(0.0 - x)
    }
    if x == 0.0 {
        return "0"
    }
    let mut m: float = x
    let mut e: int = 0
    while m >= 10.0 {
        m = m / 10.0
        e = e + 1
    }
    while m < 1.0 {
        m = m * 10.0
        e = e - 1
    }
    let mut ms: str = fmt_fixed(m, 3)
    if ms == "10.000" {
        ms = "1.000"
        e = e + 1
    }
    if e < -4 || e >= 4 {
        let mant: str = strip_trailing_zeros(ms)
        let mut ea: int = e
        if e < 0 {
            ea = 0 - e
        }
        let es: str = ea.to_str()
        if es.len() < 2 {
            if e < 0 {
                return mant + "e-0" + es
            }
            return mant + "e+0" + es
        }
        if e < 0 {
            return mant + "e-" + es
        }
        return mant + "e+" + es
    }
    let dec: int = 3 - e
    if dec <= 0 {
        return strip_trailing_zeros(fmt_fixed(x, 0))
    }
    return strip_trailing_zeros(fmt_fixed(x, dec))
}

# fmt_time(ns) — hls-bench's own time formatter: the largest unit that
# keeps the value >= 1, 4 significant digits ('us' renders as µs).
fn fmt_time(ns: float) -> str {
    if ns >= 1000000000.0 || ns <= -1000000000.0 {
        return fmt_g4(ns / 1000000000.0) + " s"
    }
    if ns >= 1000000.0 || ns <= -1000000.0 {
        return fmt_g4(ns / 1000000.0) + " ms"
    }
    if ns >= 1000.0 || ns <= -1000.0 {
        return fmt_g4(ns / 1000.0) + " µs"
    }
    return fmt_g4(ns) + " ns"
}

# fmt_pct(x) — hls-bench's signed percent, two decimals.
fn fmt_pct(x: float) -> str {
    let mut sign: str = ""
    if x >= 0.0 {
        sign = "+"
    }
    return sign + fmt_fixed(x, 2) + "%"
}

# py_repr_str(s) — Python's repr of a str (single quotes, escapes).
fn py_repr_str(s: str) -> str {
    let mut out: str = "'"
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b == 39 {
            out = out + "\\'"
        } else if b == 92 {
            out = out + "\\\\"
        } else {
            out = out + s.slice(i, i + 1)
        }
        i = i + 1
    }
    return out + "'"
}

# ----------------------------------------------------------------------------
# Sorting (bottom-up merge for floats, insertion for strings).
# ----------------------------------------------------------------------------

fn sort_floats(xs: list[float]) -> list[float] {
    let n: int = xs.len()
    let mut cur: list[float] = []
    let mut i: int = 0
    while i < n {
        cur.push(xs.get(i))
        i = i + 1
    }
    let mut w: int = 1
    while w < n {
        let dst: list[float] = []
        let mut lo: int = 0
        while lo < n {
            let mut mid: int = lo + w
            let mut hi2: int = lo + w + w
            if mid > n {
                mid = n
            }
            if hi2 > n {
                hi2 = n
            }
            let mut i1: int = lo
            let mut i2: int = mid
            while i1 < mid || i2 < hi2 {
                if i1 < mid && (i2 >= hi2 || cur.get(i1) <= cur.get(i2)) {
                    dst.push(cur.get(i1))
                    i1 = i1 + 1
                } else {
                    dst.push(cur.get(i2))
                    i2 = i2 + 1
                }
            }
            lo = lo + w + w
        }
        cur = dst
        w = w * 2
    }
    return cur
}

fn sort_strs(xs: list[str]) -> list[str] {
    let n: int = xs.len()
    let mut out: list[str] = []
    let mut i: int = 0
    while i < n {
        out.push(xs.get(i))
        i = i + 1
    }
    let mut b: int = 1
    while b < n {
        let k: str = out.get(b)
        let mut j: int = b - 1
        while j >= 0 && out.get(j) > k {
            out.set(j + 1, out.get(j))
            j = j - 1
        }
        out.set(j + 1, k)
        b = b + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# JSON emission — Python json.dumps laws: compact lines with ", " / ": "
# separators and sorted keys; pretty documents with indent=1. Floats ride
# py_float_repr so 10.0 stays 10.0.
# ----------------------------------------------------------------------------

fn jesc(s: str) -> str {
    let mut out: str = "\""
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b == 34 {
            out = out + "\\\""
        } else if b == 92 {
            out = out + "\\\\"
        } else if b == 10 {
            out = out + "\\n"
        } else if b == 9 {
            out = out + "\\t"
        } else if b == 13 {
            out = out + "\\r"
        } else if b == 8 {
            out = out + "\\b"
        } else if b == 12 {
            out = out + "\\f"
        } else if b < 32 {
            let h: str = "0123456789abcdef"
            let hi: int = b / 16
            let lo: int = b - hi * 16
            out = out + "\\u00" + h.slice(hi, hi + 1) + h.slice(lo, lo + 1)
        } else {
            out = out + s.slice(i, i + 1)
        }
        i = i + 1
    }
    return out + "\""
}

fn jv_num(x: float) -> str {
    return py_float_repr(x)
}

struct KeyVals {
    keys: list[str],
    vals: list[JsonValue]
}

fn obj_sorted(v: JsonValue) -> KeyVals {
    let keys: list[str] = []
    let mut i: int = 0
    while i < v.obj_keys.len() {
        keys.push(v.obj_keys.get(i))
        i = i + 1
    }
    let sorted: list[str] = sort_strs(keys)
    let vals: list[JsonValue] = []
    let mut j: int = 0
    while j < sorted.len() {
        let kk: str = sorted.get(j)
        let mut got: JsonValue = json_null()
        let mut k: int = 0
        while k < v.obj_keys.len() {
            if v.obj_keys.get(k) == kk {
                got = v.obj_vals.get(k)
            }
            k = k + 1
        }
        vals.push(got)
        j = j + 1
    }
    return KeyVals {
        keys: sorted, vals: vals
    }
}

fn compact_json(v: JsonValue) -> str {
    if v.kind == "null" {
        return "null"
    }
    if v.kind == "bool" {
        if v.bval {
            return "true"
        }
        return "false"
    }
    if v.kind == "int" {
        return v.ival.to_str()
    }
    if v.kind == "float" {
        return jv_num(v.fval)
    }
    if v.kind == "str" {
        return jesc(v.sval)
    }
    if v.kind == "array" {
        let parts: list[str] = []
        let mut i: int = 0
        while i < v.arr.len() {
            parts.push(compact_json(v.arr.get(i)))
            i = i + 1
        }
        return "[" + str_join(parts, ", ") + "]"
    }
    let kv: KeyVals = obj_sorted(v)
    let parts: list[str] = []
    let mut i2: int = 0
    while i2 < kv.keys.len() {
        parts.push(jesc(kv.keys.get(i2)) + ": " + compact_json(kv.vals.get(i2)))
        i2 = i2 + 1
    }
    return "{" + str_join(parts, ", ") + "}"
}

fn pretty_json_at(v: JsonValue, depth: int) -> str {
    let pad: str = repeat_str(" ", depth)
    let pad2: str = repeat_str(" ", depth + 1)
    if v.kind == "array" {
        if v.arr.len() == 0 {
            return "[]"
        }
        let parts: list[str] = []
        let mut i: int = 0
        while i < v.arr.len() {
            parts.push(pad2 + pretty_json_at(v.arr.get(i), depth + 1))
            i = i + 1
        }
        return "[\n" + str_join(parts, ",\n") + "\n" + pad + "]"
    }
    if v.kind == "object" {
        if v.obj_keys.len() == 0 {
            return "{}"
        }
        let kv: KeyVals = obj_sorted(v)
        let parts: list[str] = []
        let mut i2: int = 0
        while i2 < kv.keys.len() {
            parts.push(pad2 + jesc(kv.keys.get(i2)) + ": "
            + pretty_json_at(kv.vals.get(i2), depth + 1))
            i2 = i2 + 1
        }
        return "{\n" + str_join(parts, ",\n") + "\n" + pad + "}"
    }
    return compact_json(v)
}

fn pretty_json(v: JsonValue) -> str {
    return pretty_json_at(v, 0) + "\n"
}

# ----------------------------------------------------------------------------
# JSON tree builders + typed readers.
# ----------------------------------------------------------------------------

fn jobject(keys: list[str], vals: list[JsonValue]) -> JsonValue {
    return JsonValue {
        kind: "object", bval: false, ival: 0, fval: 0.0, sval: "",
        arr: [], obj_keys: keys, obj_vals: vals
    }
}

fn jarr(items: list[JsonValue]) -> JsonValue {
    return JsonValue {
        kind: "array", bval: false, ival: 0, fval: 0.0, sval: "",
        arr: items, obj_keys: [], obj_vals: []
    }
}

fn jget(v: JsonValue, key: str) -> JsonValue {
    return json_object_get(v, key)
}

fn jstr_of(v: JsonValue, key: str) -> str {
    let x: JsonValue = jget(v, key)
    if json_is_str(x) {
        return json_str_value(x)
    }
    return ""
}

# ----------------------------------------------------------------------------
# The statistics — hls-bench's law, restated (Welch p via the regularized
# incomplete beta, linear-interpolation quantiles, the seeded bootstrap).
# ----------------------------------------------------------------------------

fn quantile_of(sorted_xs: list[float], q: float) -> float {
    let n: int = sorted_xs.len()
    if n == 0 {
        panic("quantile of empty data")
    }
    if n == 1 {
        return sorted_xs.get(0)
    }
    let pos: float = q * (n - 1).to_float()
    let lo: int = pos.to_int()
    let mut hi: int = lo + 1
    if hi > n - 1 {
        hi = n - 1
    }
    let frac: float = pos - lo.to_float()
    return sorted_xs.get(lo) * (1.0 - frac) + sorted_xs.get(hi) * frac
}

fn median_of(xs: list[float]) -> float {
    return quantile_of(sort_floats(xs), 0.5)
}

fn mean_of(xs: list[float]) -> float {
    let mut s: float = 0.0
    let mut i: int = 0
    while i < xs.len() {
        s = s + xs.get(i)
        i = i + 1
    }
    if xs.len() == 0 {
        return 0.0
    }
    return s / xs.len().to_float()
}

fn var_sample(xs: list[float]) -> float {
    let n: int = xs.len()
    if n < 2 {
        return 0.0
    }
    let m: float = mean_of(xs)
    let mut s: float = 0.0
    let mut i: int = 0
    while i < n {
        let d: float = xs.get(i) - m
        s = s + d * d
        i = i + 1
    }
    return s / (n - 1).to_float()
}

# The continued fraction for the incomplete beta (Lentz's method, the
# Numerical Recipes betacf).
fn betacf(a: float, b: float, x: float) -> float {
    let maxit: int = 300
    let eps: float = 0.0000000000000003
    let fpmin: float = 1e-300
    let qab: float = a + b
    let qap: float = a + 1.0
    let qam: float = a - 1.0
    let mut c: float = 1.0
    let mut d: float = 1.0 - qab * x / qap
    if d < fpmin && d > 0.0 - fpmin {
        d = fpmin
    }
    d = 1.0 / d
    let mut h: float = d
    let mut m: int = 1
    while m <= maxit {
        let m2: int = 2 * m
        let mf: float = m.to_float()
        let mut aa: float = mf * (b - mf) * x / ((qam + m2.to_float())
        * (a + m2.to_float()))
        d = 1.0 + aa * d
        if d < fpmin && d > 0.0 - fpmin {
            d = fpmin
        }
        c = 1.0 + aa / c
        if c < fpmin && c > 0.0 - fpmin {
            c = fpmin
        }
        d = 1.0 / d
        h = h * d * c
        aa = 0.0 - (a + mf) * (qab + mf) * x / ((a + m2.to_float())
        * (qap + m2.to_float()))
        d = 1.0 + aa * d
        if d < fpmin && d > 0.0 - fpmin {
            d = fpmin
        }
        c = 1.0 + aa / c
        if c < fpmin && c > 0.0 - fpmin {
            c = fpmin
        }
        d = 1.0 / d
        let dele: float = d * c
        h = h * dele
        if dele >= 1.0 - eps && dele <= 1.0 + eps {
            m = maxit + 1
        }
        m = m + 1
    }
    return h
}

fn betainc(a: float, b: float, x: float) -> float {
    if x <= 0.0 {
        return 0.0
    }
    if x >= 1.0 {
        return 1.0
    }
    let ln_bt: float = math_lgamma(a + b) - math_lgamma(a) - math_lgamma(b)
    + a * math_log(x) + b * math_log(1.0 - x)
    let bt: float = math_exp(ln_bt)
    if x < (a + 1.0) / (a + b + 2.0) {
        return bt * betacf(a, b, x) / a
    }
    return 1.0 - bt * betacf(b, a, 1.0 - x) / b
}

# welch_p(a, b) — the two-tailed Welch t-test p-value.
fn welch_p(a: list[float], b: list[float]) -> float {
    let na: int = a.len()
    let nb: int = b.len()
    if na < 2 || nb < 2 {
        return 1.0
    }
    let va: float = var_sample(a)
    let vb: float = var_sample(b)
    let denom: float = va / na.to_float() + vb / nb.to_float()
    if denom <= 0.0 {
        return 1.0
    }
    let t: float = (mean_of(a) - mean_of(b)) / math_sqrt(denom)
    let num: float = denom * denom
    let den: float = (va / na.to_float()) * (va / na.to_float())
    / (na - 1).to_float()
    + (vb / nb.to_float()) * (vb / nb.to_float()) / (nb - 1).to_float()
    if den <= 0.0 {
        return 1.0
    }
    let df: float = num / den
    return betainc(df / 2.0, 0.5, df / (df + t * t))
}

# The seeded PRNG — the .py seeded random.Random(bench_key); the law that
# matters is DETERMINISM (the same pair of sample sets always classifies
# the same way), pinned here by a sha256-derived xorshift state.
fn rng_seed_of(key: str) -> int {
    let digest: str = sha256_hex(key)
    let v: int = hex_to_int(take_s(digest, 15))
    if v == 0 {
        return 1
    }
    return v
}

fn xs_next(st: int) -> int {
    let a: int = int_xor(st, int_shr(st, 12))
    let b: int = int_xor(a, int_shl(a, 25))
    return int_xor(b, int_shr(b, 27))
}

fn xs_pick(st: int, n: int) -> int {
    let nonneg: int = int_and(st, 9223372036854775807)
    return nonneg % n
}

# ----------------------------------------------------------------------------
# The spawn/capture idiom (the harness's run_capture).
# ----------------------------------------------------------------------------

struct HlRun {
    code: int,
    out: str,
    err: str,
    spawned: bool
}

fn hl_spawn(prog: str, cargs: list[str]) -> HlRun uses Proc {
    let r: HlRun = HlRun {
        code: -1, out: "", err: "", spawned: false
    }
    let pid: int = proc_spawn(prog, cargs, 2, 1, 1)
    if pid < 1 {
        return r
    }
    r.spawned = true
    let mut out: str = ""
    let mut chunk: str = proc_child_read(pid, 1, 65536)
    while chunk != "" {
        out = out + chunk
        chunk = proc_child_read(pid, 1, 65536)
    }
    let mut err: str = ""
    let mut chunk2: str = proc_child_read(pid, 2, 65536)
    while chunk2 != "" {
        err = err + chunk2
        chunk2 = proc_child_read(pid, 2, 65536)
    }
    r.code = proc_wait(pid)
    proc_child_close(pid, 1)
    proc_child_close(pid, 2)
    r.out = out
    r.err = err
    return r
}

# ----------------------------------------------------------------------------
# The git surface (None when git is absent or the tree is not a work
# tree — callers decide whether that is fatal).
# ----------------------------------------------------------------------------

fn git_out(gargs: list[str], root: str) -> str uses Proc {
    let argv: list[str] = ["-C", root]
    let mut i: int = 0
    while i < gargs.len() {
        argv.push(gargs.get(i))
        i = i + 1
    }
    let r: HlRun = hl_spawn("git", argv)
    if !r.spawned || r.code != 0 {
        return ""
    }
    return r.out.trim()
}

fn git_head(root: str) -> str uses Proc {
    return git_out(["rev-parse", "HEAD"], root)
}

fn git_user(root: str) -> str uses Proc {
    let name: str = git_out(["config", "user.name"], root)
    if name != "" {
        return name
    }
    return "unknown"
}

fn git_dirty(root: str) -> bool uses Proc {
    return git_out(["status", "--porcelain", "-uno"], root) != ""
}

# ----------------------------------------------------------------------------
# The digests and env fingerprint.
# ----------------------------------------------------------------------------

fn is_sha1(s: str) -> bool {
    if s.len() != 40 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        if !is_hex_b(s.byte_at(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn is_sha256(s: str) -> bool {
    if s.len() != 64 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        if !is_hex_b(s.byte_at(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn suite_digest(root: str, suite: str) -> Result[str, Err] uses Fs {
    let p: str = path_join2(root, suite)
    if !file_exists(p) {
        return Result.Err(err2("cannot read the suite " + p
        + ": [Errno 2] No such file or directory: '" + p + "'"))
    }
    return Result.Ok(sha256_hex(read_file(p)))
}

# cpus_of() — os.cpu_count() (the /proc law; 1 when /proc is silent).
fn cpus_of() -> int uses Fs {
    if !file_exists("/proc/cpuinfo") {
        return 1
    }
    let text: str = read_file("/proc/cpuinfo")
    let lines: list[str] = text.split("\n")
    let mut n: int = 0
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).starts_with("processor") {
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 {
        return 1
    }
    return n
}

# python_of() — the interpreter version the bench runner rides (the .py
# wrote sys.version_info; the instrument chain still runs it).
fn python_of() -> str uses Proc {
    let r: HlRun = hl_spawn("python3", ["-c",
    "import sys; print('%d.%d.%d' % sys.version_info[:3])"])
    if r.code != 0 {
        return "0.0.0"
    }
    let t: str = r.out.trim()
    if t == "" {
        return "0.0.0"
    }
    return t
}

fn cc_line() -> str uses Proc {
    let cc: str = "gcc"
    if env_has("CC") {
        let v: str = env_get("CC")
        if v != "" {
            let r: HlRun = hl_spawn(v, ["--version"])
            if r.code == 0 && r.out != "" {
                return first_line_of(r.out)
            }
            return v
        }
    }
    let r: HlRun = hl_spawn(cc, ["--version"])
    if r.code == 0 && r.out != "" {
        return first_line_of(r.out)
    }
    return cc
}

fn first_line_of(text: str) -> str {
    let lines: list[str] = text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let t: str = lines.get(i).trim()
        if t != "" {
            return t
        }
        i = i + 1
    }
    return ""
}

fn last_line_of(text: str) -> str {
    let t: str = text.trim()
    if t == "" {
        return ""
    }
    let lines: list[str] = t.split("\n")
    return lines.get(lines.len() - 1)
}

fn env_fingerprint() -> JsonValue uses Fs, Proc {
    let keys: list[str] = ["cc", "cpus", "python"]
    let vals: list[JsonValue] = [json_str(cc_line()),
    json_int(cpus_of()), json_str(python_of())]
    return jobject(keys, vals)
}

fn utc_now() -> str uses Clock {
    return rfc3339_from_epoch_ms(system_time_now_ms())
}

fn floor_div(a: int, b: int) -> int {
    let q: int = a / b
    if(a % b != 0) && ((a < 0) != (b < 0)) {
        return q - 1
    }
    return q
}

fn z2(n: int) -> str {
    if n < 10 {
        return "0" + n.to_str()
    }
    return n.to_str()
}

fn civil_from_days(z: int) -> list[int] {
    let zz: int = z + 719468
    let era: int = floor_div(zz, 146097)
    let doe: int = zz - era * 146097
    let yoe: int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let yy: int = yoe + era * 400
    let doy: int = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp: int = (5 * doy + 2) / 153
    let dd: int = doy - (153 * mp + 2) / 5 + 1
    let mut mm: int = mp + 3
    if mm > 12 {
        mm = mm - 12
    }
    let mut y2: int = yy
    if mm <= 2 {
        y2 = yy + 1
    }
    let out: list[int] = [y2, mm, dd]
    return out
}

fn rfc3339_from_epoch_ms(ms: int) -> str {
    let days: int = floor_div(ms, 86400000)
    let rem: int = ms - days * 86400000
    let ymd: list[int] = civil_from_days(days)
    return ymd.get(0).to_str() + "-" + z2(ymd.get(1)) + "-"
    + z2(ymd.get(2)) + "T" + z2(rem / 3600000) + ":"
    + z2((rem / 60000) % 60) + ":" + z2((rem / 1000) % 60) + "Z"
}

# ----------------------------------------------------------------------------
# The repo root (argv[0]'s grandparent when it looks like the repo).
# ----------------------------------------------------------------------------

fn looks_like_repo(p: str) -> bool uses Fs {
    if !file_exists(path_join2(p, "bin")) {
        return false
    }
    if !file_exists(path_join2(p, "src/hlc.hls")) {
        return false
    }
    return true
}

fn repo_root(argv0: str) -> str uses Fs, Proc {
    let cwd: str = cwd_get()
    let a0: str = path_abs(argv0, cwd)
    let p1: str = path_dirname(path_dirname(a0))
    if looks_like_repo(p1) {
        return p1
    }
    if looks_like_repo(cwd) {
        return cwd
    }
    return p1
}

# ----------------------------------------------------------------------------
# The ledger — one JSON object per line, append-only.
# ----------------------------------------------------------------------------

struct Entry {
    line: int,
    v: JsonValue
}

fn load_history(path: str) -> Result[list[Entry], Err] uses Fs {
    if !file_exists(path) {
        return Result.Err(err2("the history ledger " + path
        + " does not exist yet (record something first)"))
    }
    let entries: list[Entry] = []
    let lines: list[str] = read_file(path).split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let lineno: int = i + 1
        let line: str = lines.get(i).trim()
        if line != "" {
            let rr: Result[JsonValue, str] = json_parse_result(line)
            if result_is_err(rr) {
                return Result.Err(err1("history line " + lineno.to_str()
                + " is corrupt (" + result_err_or(rr, "parse error")
                + ") — the ledger is append-only; fix or remove the "
                + "line by hand"))
            }
            let obj: JsonValue = result_unwrap(rr)
            if !json_is_object(obj) || !json_object_has(obj, "type") {
                return Result.Err(err1("history line " + lineno.to_str()
                + " carries no type"))
            }
            let typ: str = jstr_of(obj, "type")
            if typ == "record" {
                let vr: Result[bool, Err] = validate_record(obj,
                "history line " + lineno.to_str())
                if result_is_err(vr) {
                    return Result.Err(result_err_or(vr, err1("")))
                }
            } else if typ == "sanction" {
                let vs: Result[bool, Err] = validate_sanction(obj,
                "history line " + lineno.to_str())
                if result_is_err(vs) {
                    return Result.Err(result_err_or(vs, err1("")))
                }
            } else {
                return Result.Err(err1("history line " + lineno.to_str()
                + " has unknown type " + py_repr_str(typ)))
            }
            entries.push(Entry {
                line: lineno, v: obj
            })
        }
        i = i + 1
    }
    return Result.Ok(entries)
}

fn bench_names_sorted(rec: JsonValue) -> list[str] {
    let benches: JsonValue = jget(rec, "benches")
    let names: list[str] = []
    if json_is_object(benches) {
        let mut i: int = 0
        while i < benches.obj_keys.len() {
            names.push(benches.obj_keys.get(i))
            i = i + 1
        }
    }
    return sort_strs(names)
}

# estimates_of(rec, name) — the bench's estimates_ns as floats.
fn estimates_of(rec: JsonValue, name: str) -> list[float] {
    let out: list[float] = []
    let benches: JsonValue = jget(rec, "benches")
    if !json_is_object(benches) {
        return out
    }
    let b: JsonValue = json_object_get(benches, name)
    if !json_is_object(b) {
        return out
    }
    let est: JsonValue = jget(b, "estimates_ns")
    if !json_is_array(est) {
        return out
    }
    let mut i: int = 0
    while i < est.arr.len() {
        let x: JsonValue = est.arr.get(i)
        if json_is_int(x) {
            out.push(json_int_value(x).to_float())
        } else if json_is_float(x) {
            out.push(json_float_value(x))
        }
        i = i + 1
    }
    return out
}

fn validate_record(rec: JsonValue, place: str) -> Result[bool, Err] {
    let commit: str = jstr_of(rec, "commit")
    if commit == "" || !is_sha1(commit) {
        return Result.Err(err1(place + ": a record without a 40-hex "
        + "commit pin is not a per-commit record"))
    }
    let backend: str = jstr_of(rec, "backend")
    if backend != "interpreter" && backend != "native" {
        return Result.Err(err1(place + ": backend "
        + py_repr_str(backend)
        + " is not one of ['interpreter', 'native']"))
    }
    let sd: str = jstr_of(rec, "suite_digest")
    if sd == "" || !is_sha256(sd) {
        return Result.Err(err1(place + ": a record without a suite "
        + "digest cannot be compared"))
    }
    let benches: JsonValue = jget(rec, "benches")
    if !json_is_object(benches) || benches.obj_keys.len() == 0 {
        return Result.Err(err1(place + ": a record with no benches "
        + "measured nothing"))
    }
    let names: list[str] = bench_names_sorted(rec)
    let mut i: int = 0
    while i < names.len() {
        let name: str = names.get(i)
        let b: JsonValue = json_object_get(jget(rec, "benches"), name)
        let est2: JsonValue = jget(b, "estimates_ns")
        if !json_is_array(est2) || est2.arr.len() < min_samples() {
            return Result.Err(err1(place + ": bench " + name
            + " carries fewer than " + min_samples().to_str()
            + " samples — a median no sample supports is not a "
            + "measurement"))
        }
        let mut j: int = 0
        while j < est2.arr.len() {
            let x: JsonValue = est2.arr.get(j)
            let ok: bool = (json_is_int(x) && json_int_value(x) > 0)
            || (json_is_float(x) && json_float_value(x) > 0.0)
            if !ok {
                return Result.Err(err1(place + ": bench " + name
                + " has non-positive estimates"))
            }
            j = j + 1
        }
        i = i + 1
    }
    return Result.Ok(true)
}

fn validate_sanction(s: JsonValue, place: str) -> Result[bool, Err] {
    if jstr_of(s, "bench") == "" {
        return Result.Err(err1(place + ": a sanction without a bench"))
    }
    if jstr_of(s, "reason") == "" {
        return Result.Err(err1(place + ": a sanction without a written "
        + "reason is not a sanction"))
    }
    return Result.Ok(true)
}

fn append_entry(path: str, entry: JsonValue) -> Result[bool, Err]
uses Fs, Proc {
    let ap: str = path_abs(path, cwd_get())
    let d: str = path_dirname(ap)
    if d != "" && d != "." && !fs_is_dir(d) {
        let rc: int = proc_exec("mkdir -p '" + d + "'")
        if rc != 0 {
            return Result.Err(err2("cannot create the ledger directory "
            + d))
        }
    }
    let line: str = compact_json(entry) + "\n"
    let mut body: str = ""
    if file_exists(ap) {
        body = read_file(ap)
    }
    write_file(ap, body + line)
    return Result.Ok(true)
}

fn records_of(entries: list[Entry]) -> list[Entry] {
    let out: list[Entry] = []
    let mut i: int = 0
    while i < entries.len() {
        if jstr_of(entries.get(i).v, "type") == "record" {
            out.push(entries.get(i))
        }
        i = i + 1
    }
    return out
}

fn sanctions_of(entries: list[Entry]) -> list[Entry] {
    let out: list[Entry] = []
    let mut i: int = 0
    while i < entries.len() {
        if jstr_of(entries.get(i).v, "type") == "sanction" {
            out.push(entries.get(i))
        }
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# The instrument — the REAL bench run over the suite. bin/hls-bench is
# spawned when it is built (the native twin of the runner); otherwise the
# tool runs the runner's own law itself: synthesize the Stage-124 driver
# per bench, run it on the Stage-0 evaluator (bin/hlboot) or, with
# --native, through bin/hlc + cc, and parse the __HLBENCH__ protocol.
# ----------------------------------------------------------------------------

fn tmp_path(stem: str, n: int, suffix: str) -> str uses Fs, Proc {
    let base: str = "/tmp"
    if env_has("TMPDIR") {
        let t: str = env_get("TMPDIR")
        if t != "" {
            let r: HlRun = hl_spawn("sh", ["-c", "test -w '" + t + "'"])
            if r.code == 0 {
                return path_join2(t, "." + stem + "-" + n.to_str()
                + suffix)
            }
        }
    }
    return path_join2(base, "." + stem + "-" + n.to_str() + suffix)
}

# The probe main's effect universe (the .py's _PROBE_EFFECTS) — declaring
# wider effects than computed is legal, and exactly the point here.
fn probe_effects_clause() -> str {
    return "IO, Fs, Clock, Args, Exit, Net, Rand, Proc, Conc"
}

# bench_probe_src(suite_basename) — the probe driver the .py synthesized:
# import the suite, declare the full effect universe on an empty main. Its
# ONLY job is to give the real checker a program to accept (a suite has no
# main — the checker refuses a module), so the effects the driver clauses
# need can be read from the checker instead of re-implemented.
fn bench_probe_src(suite_basename: str) -> str {
    return "# generated by hls-perf (the hls-bench probe law, Stage 124)\n"
    + "# probe: " + suite_basename + "\n"
    + "import \"" + suite_basename + "\"\n"
    + "\n"
    + "fn main() uses " + probe_effects_clause() + " {\n"
    + "}\n"
}

# bench_probe_leg(probe_path) — the private child leg: load + check +
# print the per-fn table (name, ret, params, extern, computed effects)
# as TSV. A suite that does not check dies HERE, in the child, and the
# parent reports the compile error instead of crashing.
fn bench_probe_leg(path: str) -> int uses IO, Fs, Proc {
    let ctx: Ctx = hl_load_crate(path)
    hl_check(ctx)
    let mut out: str = ""
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        let effs: list[str] = ctx.computed_effects.get_or(key, [])
        let mut ext: str = "0"
        if f.is_extern {
            ext = "1"
        }
        out = out + key + "\t" + f.ret + "\t"
        + f.params.len().to_str() + "\t" + ext + "\t"
        + str_join(effs, ",") + "\n"
        i = i + 1
    }
    print(out)
    return 0
}

# The discovered bench table (one row per suite fn the probe reported).
struct SuiteFn {
    name: str,
    ret: str,
    nparams: int,
    is_extern: bool,
    effects: list[str]
}

# parse_probe_table(text) — the child's TSV back into rows. Lines that do
# not carry five fields are skipped (the child is the tool itself; a
# malformed row means the child crashed mid-write, which the exit code
# catches). The effects column arrives comma-joined; the driver clauses
# want the individual names.
fn parse_probe_table(text: str) -> list[SuiteFn] {
    let rows: list[SuiteFn] = []
    let lines: list[str] = text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let ln: str = lines.get(i)
        if ln != "" {
            let parts: list[str] = ln.split("\t")
            if parts.len() == 5 {
                let np: int = parts.get(2).to_int()
                let mut ext: bool = false
                if parts.get(3) == "1" {
                    ext = true
                }
                rows.push(SuiteFn {
                    name: parts.get(0), ret: parts.get(1), nparams: np,
                    is_extern: ext, effects: split_effects(parts.get(4))
                })
            }
        }
        i = i + 1
    }
    return rows
}

# split_effects(joined) — the comma split, empty-aware.
fn split_effects(joined: str) -> list[str] {
    let out: list[str] = []
    if joined == "" {
        return out
    }
    let parts: list[str] = joined.split(",")
    let mut i: int = 0
    while i < parts.len() {
        if parts.get(i) != "" {
            out.push(parts.get(i))
        }
        i = i + 1
    }
    return out
}

# eff_clause(effects) — the .py's _eff_clause: the sorted deduped set,
# prefixed with " uses ", or "" for the empty set.
fn eff_clause(effects: list[str]) -> str {
    let uniq: list[str] = []
    let mut i: int = 0
    while i < effects.len() {
        let e: str = effects.get(i)
        let mut found: bool = false
        let mut j: int = 0
        while j < uniq.len() {
            if uniq.get(j) == e {
                found = true
            }
            j = j + 1
        }
        if !found {
            uniq.push(e)
        }
        i = i + 1
    }
    let sorted: list[str] = sort_strs(uniq)
    if sorted.len() == 0 {
        return ""
    }
    return " uses " + str_join(sorted, ", ")
}

# sink_escape() — int64 min / 2, unreachable by the sink accumulator.
fn sink_escape() -> int {
    return -4611686018427387904
}

# call_and_sink(bench, ret) — the .py's two statement lines: call the
# bench inside the measured loop and keep its work observable through a
# type-shaped sink that escapes through an unreachable branch.
fn call_and_sink(bench: str, ret: str) -> str {
    if ret == "" || ret == "void" {
        return "        " + bench + "()\n"
        + "        sink = sink + 1\n"
    }
    if ret == "int" {
        return "        let v: int = " + bench + "()\n"
        + "        sink = sink + (v - (v / 100) * 100)\n"
    }
    if ret == "bool" {
        return "        let v: bool = " + bench + "()\n"
        + "        if v { sink = sink + 1 }\n"
    }
    if ret == "str" {
        return "        let v: str = " + bench + "()\n"
        + "        sink = sink + v.len()\n"
    }
    if ret == "float" {
        return "        let v: float = " + bench + "()\n"
        + "        if v > 0.0 { sink = sink + 1 }\n"
    }
    return "        let v: " + ret + " = " + bench + "()\n"
    + "        sink = sink + 1\n"
}

# bench_driver_src(bench, suite_basename, samples, iters, bench_effs,
# units_name, units_effs, ret) — the .py's synthesize_driver, fixed plan
# only (the ledger always records under --fixed-iters). The wire records
# are ordinary println output so the protocol rides the standing stdout
# parity between the two backends.
fn bench_driver_src(bench: str, suite_basename: str, samples: int,
iters: int, bench_effs: list[str], units_name: str,
units_effs: list[str], ret: str) -> str {
    let mut run_effs: list[str] = []
    let mut i: int = 0
    while i < bench_effs.len() {
        run_effs.push(bench_effs.get(i))
        i = i + 1
    }
    run_effs.push("IO")
    let mut main_effs: list[str] = []
    i = 0
    while i < bench_effs.len() {
        main_effs.push(bench_effs.get(i))
        i = i + 1
    }
    i = 0
    while i < units_effs.len() {
        main_effs.push(units_effs.get(i))
        i = i + 1
    }
    main_effs.push("IO")
    main_effs.push("Clock")
    let mut s: str = ""
    s = s + "# generated by hls-perf (the hls-bench driver law, "
    + "Stage 124)\n"
    s = s + "# suite: " + suite_basename + "\n"
    s = s + "# bench: " + bench + "\n"
    s = s + "import \"" + suite_basename + "\"\n"
    s = s + "\n"
    s = s + "fn __hlb_run(n: int)" + eff_clause(run_effs) + " {\n"
    s = s + "    let mut sink: int = 0\n"
    s = s + "    let mut i: int = 0\n"
    s = s + "    while i < n {\n"
    s = s + call_and_sink(bench, ret)
    s = s + "        i = i + 1\n"
    s = s + "    }\n"
    s = s + "    if sink < " + sink_escape().to_str() + " {\n"
    s = s + "        println(\"__HLBENCH_SINK__\")\n"
    s = s + "    }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + "fn __hlb_harness(n: int) {\n"
    s = s + "    let mut i: int = 0\n"
    s = s + "    while i < n {\n"
    s = s + "        i = i + 1\n"
    s = s + "    }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + "fn main()" + eff_clause(main_effs) + " {\n"
    if units_name != "" {
        s = s + "    let u: int = " + units_name + "()\n"
        s = s + "    println(\"__HLBENCH_UNITS__ " + bench
        + " \" + u.to_str())\n"
    }
    s = s + "    let iters: int = " + iters.to_str() + "\n"
    s = s + "    let mut s2: int = 0\n"
    s = s + "    while s2 < " + samples.to_str() + " {\n"
    s = s + "        let t0: int = instant_now_ns()\n"
    s = s + "        __hlb_run(iters)\n"
    s = s + "        let d: int = instant_now_ns() - t0\n"
    s = s + "        println(\"__HLBENCH__ " + bench
    + " \" + iters.to_str() + \" \" + d.to_str())\n"
    s = s + "        s2 = s2 + 1\n"
    s = s + "    }\n"
    s = s + "    let th: int = instant_now_ns()\n"
    s = s + "    __hlb_harness(iters)\n"
    s = s + "    let dh: int = instant_now_ns() - th\n"
    s = s + "    println(\"__HLBENCH_HARNESS__ \" + iters.to_str()"
    + " + \" \" + dh.to_str())\n"
    s = s + "}\n"
    return s
}

# is_uint_str(s) — a decimal unsigned int, no sign, no leading zeros.
fn is_uint_str(s: str) -> bool {
    if s == "" {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b < 48 || b > 57 {
            return false
        }
        i = i + 1
    }
    if s.len() > 1 && s.byte_at(0) == 48 {
        return false
    }
    return true
}

# The protocol parse of one driver run.
struct ProtoPair {
    a: int,
    b: int
}

struct ProtoOut {
    units: int,
    units_found: bool,
    samples: list[ProtoPair],
    harness: ProtoPair,
    harness_found: bool,
    err: str
}

# parse_bench_protocol(out) — the .py's parse_protocol: line-wise, the
# reserved-prefix discipline. A line starting with a record prefix must
# parse EXACTLY; a line carrying the reserved stem that is not a record
# is a protocol error; every other line is skipped.
fn parse_bench_protocol(out: str) -> ProtoOut {
    let r: ProtoOut = ProtoOut {
        units: 0, units_found: false, samples: [],
        harness: ProtoPair {
            a: 0, b: 0
        }, harness_found: false, err: ""
    }
    let lines: list[str] = out.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let ln: str = lines.get(i)
        if ln != "" {
            if ln.starts_with("__HLBENCH_UNITS__ ") {
                let rest: str = ln.slice(19, ln.len())
                let parts: list[str] = rest.split(" ")
                if parts.len() != 2 || !is_uint_str(parts.get(1)) {
                    r.err = "protocol error: a malformed units record"
                    return r
                }
                r.units = parts.get(1).to_int()
                r.units_found = true
            } else if ln.starts_with("__HLBENCH_HARNESS__ ") {
                let rest: str = ln.slice(20, ln.len())
                let parts: list[str] = rest.split(" ")
                if parts.len() != 2 || !is_uint_str(parts.get(0))
                || !is_uint_str(parts.get(1)) {
                    r.err = "protocol error: a malformed harness record"
                    return r
                }
                r.harness = ProtoPair {
                    a: parts.get(0).to_int(), b: parts.get(1).to_int()
                }
                r.harness_found = true
            } else if ln.starts_with("__HLBENCH__ ") {
                let rest: str = ln.slice(12, ln.len())
                let parts: list[str] = rest.split(" ")
                if parts.len() != 3 || !is_uint_str(parts.get(1))
                || !is_uint_str(parts.get(2)) {
                    r.err = "protocol error: a malformed sample record"
                    return r
                }
                r.samples.push(ProtoPair {
                    a: parts.get(1).to_int(), b: parts.get(2).to_int()
                })
            } else if ln.contains("__HLBENCH_") {
                r.err = "protocol error: output contains the reserved "
                + "prefix '__HLBENCH_' outside a record"
                return r
            }
        }
        i = i + 1
    }
    return r
}

# bench_skip_reason(err_text) — the panic-carried skip marker, or "".
fn bench_skip_reason(text: str) -> str {
    let idx: int = text.find("__HLBENCH_SKIP__:")
    if idx < 0 {
        return ""
    }
    let rest: str = text.slice(idx + 17, text.len())
    let cut: int = rest.find(" (at line ")
    if cut >= 0 {
        return rest.slice(0, cut).trim()
    }
    return rest.trim()
}

# run_driver_interpreter(root, driver_path) — the Stage-0 evaluator as
# the interpreter backend (the .py ran the driver in-process on the lab
# interpreter; the native tree's evaluator is bin/hlboot).
fn run_driver_interpreter(root: str, driver_path: str) -> HlRun uses Proc {
    return hl_spawn(path_join2(root, "bin/hlboot"), [driver_path])
}

# run_driver_native(root, driver_path, counter) — the native backend:
# bin/hlc + cc, built in a private temp tree, run once. hlc runs with
# cwd = root so a suite outside the repo tree resolves std./core.
# imports exactly where the interpreter backend resolves them.
fn run_driver_native(root: str, driver_path: str, counter: int)
-> HlRun uses Fs, Proc {
    let c_path: str = tmp_path("hlperf-drv", counter, ".c")
    let bin_path: str = tmp_path("hlperf-drv", counter, ".bin")
    let hlc: str = path_join2(root, "bin/hlc")
    let mut cc: str = "gcc"
    if env_has("CC") {
        let v: str = env_get("CC")
        if v != "" {
            cc = v
        }
    }
    let compile_cmd: str = "cd '" + shell_q(root) + "' && '"
    + shell_q(hlc) + "' '" + shell_q(driver_path) + "' '"
    + shell_q(c_path) + "'"
    let rc0: HlRun = hl_spawn("sh", ["-c", compile_cmd])
    if rc0.code != 0 {
        return rc0
    }
    let rc1: HlRun = hl_spawn(cc, ["-O2", "-o", bin_path, c_path,
    "-lm", "-pthread"])
    if rc1.code != 0 {
        return rc1
    }
    let rc2: HlRun = hl_spawn(bin_path, [])
    proc_exec("rm -f '" + shell_q(bin_path) + "' '" + shell_q(c_path)
    + "'")
    return rc2
}

# shell_q(s) — single-quote neutraliser for the one-liners above.
fn shell_q(s: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c == 39 {
            out = out + "'\\''"
        } else {
            out = out + s.slice(i, i + 1)
        }
        i = i + 1
    }
    return out
}

# native_bench_run(self_path, root, suite, samples, iters, native,
# grep, counter) — the whole hls-bench law, run natively: probe the
# suite's functions and effects through the linked front-end (in a probe
# child), synthesize one driver per bench, run it on the chosen backend,
# parse the protocol and assemble the hls-bench report schema.
fn native_bench_run(self_path: str, root: str, suite: str, samples: int,
iters: int, native: bool, grep: str, counter: int)
-> Result[JsonValue, Err] uses Fs, Proc {
    let mut suite_abs: str = suite
    if !path_is_absolute(suite_abs) {
        suite_abs = path_join2(root, suite)
    }
    if !file_exists(suite_abs) {
        return Result.Err(err2("cannot read the suite " + suite_abs
        + " — no such file"))
    }
    let suite_base: str = path_basename(suite_abs)
    let suite_dir: str = path_dirname(suite_abs)

    # ---- the probe child: discovery + the real checker's effects.
    let probe_path: str = path_join2(suite_dir, ".hlperf-probe-"
    + counter.to_str() + ".hls")
    write_file(probe_path, bench_probe_src(suite_base))
    let pr: HlRun = hl_spawn(self_path, ["--probe-bench", probe_path])
    proc_exec("rm -f '" + shell_q(probe_path) + "'")
    if !pr.spawned || pr.code != 0 {
        let mut msg: str = first_line_of(pr.err)
        if msg == "" {
            msg = first_line_of(pr.out)
        }
        if msg == "" {
            msg = "(no output)"
        }
        return Result.Err(err1("the bench run failed (1): " + msg))
    }
    let fns: list[SuiteFn] = parse_probe_table(pr.out)

    # ---- the suite convention (the .py's static checks).
    let mut benches: list[SuiteFn] = []
    let mut i: int = 0
    while i < fns.len() {
        if fns.get(i).name.starts_with("bench_") {
            benches.push(fns.get(i))
        }
        i = i + 1
    }
    if grep != "" {
        let kept: list[SuiteFn] = []
        i = 0
        while i < benches.len() {
            if benches.get(i).name.contains(grep) {
                kept.push(benches.get(i))
            }
            i = i + 1
        }
        benches = kept
    }

    # ---- per-bench measurement: one driver, one run, one protocol.
    let bench_vals: list[JsonValue] = []
    let mut bi: int = 0
    while bi < benches.len() {
        let b: SuiteFn = benches.get(bi)
        bi = bi + 1
        if b.nparams > 0 {
            bench_vals.push(jobject(["name", "status", "detail"],
            [json_str(b.name), json_str("fail"),
            json_str("benchmark '" + b.name + "' takes "
            + b.nparams.to_str() + " parameter(s) - benchmarks "
            + "take none (the runner calls them with no "
            + "arguments)")]))
            continue
        }
        if b.is_extern {
            bench_vals.push(jobject(["name", "status", "detail"],
            [json_str(b.name), json_str("fail"),
            json_str("benchmark '" + b.name + "' is extern - "
            + "benchmarks are HLS code the runner measures, "
            + "not a declaration")]))
            continue
        }
        # the companion units fn, when present, must be callable as is
        let mut units_name: str = ""
        let mut units_effs: list[str] = []
        let mut units_bad: str = ""
        let mut fi: int = 0
        while fi < fns.len() {
            let f: SuiteFn = fns.get(fi)
            if f.name == "units_" + b.name.slice(6, b.name.len()) {
                units_name = f.name
                units_effs = f.effects
                if f.nparams > 0 {
                    units_bad = "units fn '" + f.name
                    + "' must take no parameters (the runner calls "
                    + "it with none), got " + f.nparams.to_str()
                } else if f.is_extern {
                    units_bad = "units fn '" + f.name
                    + "' is extern - the units count is HLS code the "
                    + "runner executes, not a declaration"
                } else if f.ret != "int" {
                    units_bad = "units fn '" + f.name
                    + "' must return int (the work units of ONE "
                    + "iteration), declares '" + f.ret + "'"
                }
            }
            fi = fi + 1
        }
        if units_bad != "" {
            bench_vals.push(jobject(["name", "status", "detail"],
            [json_str(b.name), json_str("fail"),
            json_str(units_bad)]))
            continue
        }

        let driver_path: str = path_join2(suite_dir, ".hlperf-driver-"
        + counter.to_str() + "-" + b.name + ".hls")
        write_file(driver_path, bench_driver_src(b.name, suite_base,
        samples, iters, b.effects, units_name, units_effs, b.ret))
        let mut rr: HlRun = HlRun {
            code: -1, out: "", err: "", spawned: false
        }
        if native {
            rr = run_driver_native(root, driver_path, counter)
        } else {
            rr = run_driver_interpreter(root, driver_path)
        }
        proc_exec("rm -f '" + shell_q(driver_path) + "'")
        if !rr.spawned || rr.code != 0 {
            let skip: str = bench_skip_reason(rr.err)
            if skip != "" {
                bench_vals.push(jobject(["name", "status", "detail"],
                [json_str(b.name), json_str("skip"),
                json_str(skip)]))
                continue
            }
            let mut detail: str = last_line_of(rr.err)
            if detail == "" {
                detail = last_line_of(rr.out)
            }
            if detail == "" {
                detail = "(no output)"
            }
            bench_vals.push(jobject(["name", "status", "detail"],
            [json_str(b.name), json_str("fail"),
            json_str("driver exited " + rr.code.to_str() + ": "
            + detail)]))
            continue
        }

        let proto: ProtoOut = parse_bench_protocol(rr.out)
        if proto.err != "" {
            bench_vals.push(jobject(["name", "status", "detail"],
            [json_str(b.name), json_str("fail"),
            json_str(proto.err)]))
            continue
        }
        if proto.samples.len() != samples {
            bench_vals.push(jobject(["name", "status", "detail"],
            [json_str(b.name), json_str("fail"),
            json_str("protocol error: expected " + samples.to_str()
            + " sample record(s), got "
            + proto.samples.len().to_str()
            + " - the driver's plan and the parser must "
            + "agree")]))
            continue
        }
        if !proto.harness_found {
            bench_vals.push(jobject(["name", "status", "detail"],
            [json_str(b.name), json_str("fail"),
            json_str("protocol error: no __HLBENCH_HARNESS__ record "
            + "(the driver always emits exactly one)")]))
            continue
        }
        let mut positive: bool = true
        let mut si: int = 0
        while si < proto.samples.len() {
            if proto.samples.get(si).a <= 0
            || proto.samples.get(si).b <= 0 {
                positive = false
            }
            si = si + 1
        }
        if !positive {
            bench_vals.push(jobject(["name", "status", "detail"],
            [json_str(b.name), json_str("fail"),
            json_str("protocol error: a sample reports elapsed <= 0 "
            + "ns - the monotonic clock must advance across a "
            + "measured batch")]))
            continue
        }
        let mut units_val: JsonValue = json_null()
        if units_name != "" {
            if !proto.units_found {
                bench_vals.push(jobject(["name", "status", "detail"],
                [json_str(b.name), json_str("fail"),
                json_str("protocol error: no __HLBENCH_UNITS__ "
                + "record (the driver emits it before "
                + "sampling)")]))
                continue
            }
            if proto.units <= 0 {
                bench_vals.push(jobject(["name", "status", "detail"],
                [json_str(b.name), json_str("fail"),
                json_str("units fn '" + units_name + "' returned "
                + proto.units.to_str()
                + " - declare at least 1 unit per "
                + "iteration")]))
                continue
            }
            units_val = json_int(proto.units)
        }

        # ---- the statistics (median/mean/stddev/mad/slope; the CIs and
        # the Welch test live in the gate, where the ledger reads them).
        let est: list[float] = []
        let raw_pairs: list[JsonValue] = []
        let mut it_total: int = 0
        let mut el_total: int = 0
        si = 0
        while si < proto.samples.len() {
            let p: ProtoPair = proto.samples.get(si)
            est.push(p.b.to_float() / p.a.to_float())
            raw_pairs.push(jarr([json_int(p.a), json_int(p.b)]))
            it_total = it_total + p.a
            el_total = el_total + p.b
            si = si + 1
        }
        let med: float = median_of(est)
        let mean: float = mean_of(est)
        let mut varsum: float = 0.0
        si = 0
        while si < est.len() {
            let d: float = est.get(si) - mean
            varsum = varsum + d * d
            si = si + 1
        }
        let mut stddev: float = 0.0
        if est.len() > 1 {
            stddev = math_sqrt(varsum / (est.len() - 1).to_float())
        }
        let devs: list[float] = []
        si = 0
        while si < est.len() {
            let d2: float = est.get(si) - med
            if d2 < 0.0 {
                devs.push(0.0 - d2)
            } else {
                devs.push(d2)
            }
            si = si + 1
        }
        let mad: float = median_of(devs)
        let slope: float = el_total.to_float() / it_total.to_float()
        bench_vals.push(jobject(["name", "status", "units",
        "samples", "samples_count", "estimates_ns_per_iter"],
        [json_str(b.name), json_str("ok"), units_val,
        jarr(raw_pairs), json_int(est.len()),
        jobject(["median", "mean", "stddev", "mad", "slope"],
        [json_float(med), json_float(mean), json_float(stddev),
        json_float(mad), json_float(slope)])]))
    }

    # ---- the report, in the hls-bench schema the import floor eats.
    let mut backend: str = "interpreter"
    if native {
        backend = "native"
    }
    let report: JsonValue = jobject(
    ["tool", "version", "backend", "plan", "noise_pct", "files"],
    [json_str("hls-bench"), json_str("0.142.0"), json_str(backend),
    jobject(["mode", "samples", "iters"],
    [json_str("fixed"), json_int(samples), json_int(iters)]),
    json_float(default_noise_pct()),
    jarr([jobject(["file", "benches"],
    [json_str(suite), jarr(bench_vals)])])])
    return Result.Ok(report)
}

# run_hls_bench(self_path, root, suite, ...) — the instrument: the
# REAL bin/hls-bench when it is built, else the tool's own native run of
# the runner's law (the driver synthesis + protocol above).
fn run_hls_bench(self_path: str, root: str, suite: str, samples: int,
iters: int, native: bool, grep: str, counter: int)
-> Result[JsonValue, Err] uses Fs, Proc {
    let prog: str = path_join2(root, "bin/hls-bench")
    if !file_exists(prog) {
        return native_bench_run(self_path, root, suite, samples, iters,
        native, grep, counter)
    }
    let tmp: str = tmp_path("hlperf-report", counter, ".json")
    let argv: list[str] = [suite, "--json", tmp, "--samples",
    samples.to_str(), "--fixed-iters", iters.to_str()]
    if native {
        argv.push("--native")
    }
    if grep != "" {
        argv.push("--grep")
        argv.push(grep)
    }
    let r: HlRun = hl_spawn(prog, argv)
    if r.code != 0 {
        let mut detail: str = last_line_of(r.err)
        if detail == "" {
            detail = last_line_of(r.out)
        }
        if detail == "" {
            detail = "(no output)"
        }
        return Result.Err(err1("the bench run failed ("
        + r.code.to_str() + "): " + detail))
    }
    if !file_exists(tmp) {
        return Result.Err(err1("the bench run failed ("
        + r.code.to_str() + "): (no report)"))
    }
    let rr: Result[JsonValue, str] = json_parse_result(read_file(tmp))
    proc_exec("rm -f '" + tmp + "'")
    if result_is_err(rr) {
        return Result.Err(err2("the report is not valid JSON: "
        + result_err_or(rr, "parse error")))
    }
    return Result.Ok(result_unwrap(rr))
}

# ----------------------------------------------------------------------------
# The report import — the ledger's bench map from an hls-bench report.
# ----------------------------------------------------------------------------

struct ReportOut {
    backend: str,
    benches: JsonValue,
    skipped: list[str]
}

fn report_to_benches(report: JsonValue) -> Result[ReportOut, Err] {
    if !json_is_object(report) || jstr_of(report, "tool") != "hls-bench" {
        let mut toolv: str = "None"
        if json_is_object(report) {
            let t: JsonValue = jget(report, "tool")
            if json_is_str(t) {
                toolv = py_repr_str(json_str_value(t))
            }
        }
        return Result.Err(err2("the report is not an hls-bench report "
        + "(tool=" + toolv + ")"))
    }
    let backend: str = jstr_of(report, "backend")
    if backend != "interpreter" && backend != "native" {
        return Result.Err(err2("report backend " + py_repr_str(backend)
        + " is not one of ['interpreter', 'native']"))
    }
    let bkeys: list[str] = []
    let bvals: list[JsonValue] = []
    let skipped: list[str] = []
    let failed: list[str] = []
    let files: JsonValue = jget(report, "files")
    if json_is_array(files) {
        let mut fi: int = 0
        while fi < files.arr.len() {
            let f: JsonValue = files.arr.get(fi)
            let benches: JsonValue = jget(f, "benches")
            if json_is_array(benches) {
                let mut bi: int = 0
                while bi < benches.arr.len() {
                    let b: JsonValue = benches.arr.get(bi)
                    let mut name: str = jstr_of(b, "name")
                    if name == "" {
                        name = "?"
                    }
                    let status: str = jstr_of(b, "status")
                    if status == "ok" {
                        # raw (iters, elapsed) pairs -> per-iter estimates
                        let est: list[float] = []
                        let raw: JsonValue = jget(b, "samples")
                        if json_is_array(raw) {
                            let mut si: int = 0
                            while si < raw.arr.len() {
                                let pair: JsonValue = raw.arr.get(si)
                                if json_is_array(pair) && pair.arr.len() == 2 {
                                    let it: JsonValue = pair.arr.get(0)
                                    let el: JsonValue = pair.arr.get(1)
                                    let mut itv: float = 0.0
                                    if json_is_int(it) {
                                        itv = json_int_value(it).to_float()
                                    } else if json_is_float(it) {
                                        itv = json_float_value(it)
                                    }
                                    if itv != 0.0 {
                                        if json_is_int(el) {
                                            est.push(json_int_value(el)
                                            .to_float() / itv)
                                        } else if json_is_float(el) {
                                            est.push(json_float_value(el)
                                            / itv)
                                        }
                                    }
                                }
                                si = si + 1
                            }
                        }
                        let med: JsonValue = jget(jget(b,
                        "estimates_ns_per_iter"), "median")
                        let mut has_med: bool = false
                        if json_is_int(med) || json_is_float(med) {
                            has_med = true
                        }
                        if est.len() == 0 && has_med {
                            let mut mv: float = 0.0
                            if json_is_int(med) {
                                mv = json_int_value(med).to_float()
                            } else {
                                mv = json_float_value(med)
                            }
                            est.push(mv)
                        }
                        let est_vals: list[JsonValue] = []
                        let mut ei: int = 0
                        while ei < est.len() {
                            est_vals.push(json_float(est.get(ei)))
                            ei = ei + 1
                        }
                        let mut med_out: JsonValue = json_null()
                        if has_med {
                            med_out = med
                        }
                        let units: JsonValue = jget(b, "units")
                        let bench_obj: JsonValue = jobject(
                        ["estimates_ns", "median_ns", "samples_count",
                        "units"],
                        [jarr(est_vals), med_out,
                        json_int(est.len()), units])
                        # insert or replace by name (sorted later)
                        let mut at: int = 0
                        let mut found: bool = false
                        while at < bkeys.len() {
                            if bkeys.get(at) == name {
                                found = true
                            }
                            at = at + 1
                        }
                        if !found {
                            bkeys.push(name)
                            bvals.push(bench_obj)
                        } else {
                            let mut ri: int = 0
                            while ri < bkeys.len() {
                                if bkeys.get(ri) == name {
                                    bvals.set(ri, bench_obj)
                                }
                                ri = ri + 1
                            }
                        }
                    } else if status == "skip" {
                        let mut found: bool = false
                        let mut sk: int = 0
                        while sk < skipped.len() {
                            if skipped.get(sk) == name {
                                found = true
                            }
                            sk = sk + 1
                        }
                        if !found {
                            skipped.push(name)
                        }
                    } else {
                        let detail: str = jstr_of(b, "detail")
                        let dl: str = first_line_of(detail)
                        failed.push(name + " ([" + dl + "])")
                    }
                    bi = bi + 1
                }
            }
            fi = fi + 1
        }
    }
    if failed.len() > 0 {
        return Result.Err(err1("the bench run carries failed benches: "
        + str_join(failed, ", ")))
    }
    if bkeys.len() == 0 {
        return Result.Err(err2("the report carries no measured benches"))
    }
    return Result.Ok(ReportOut {
        backend: backend,
        benches: jobject(bkeys, bvals),
        skipped: sort_strs(skipped)
    })
}

# ----------------------------------------------------------------------------
# The classification law — Stage 124's, verbatim: Welch p for
# significance, the seeded bootstrap CI of the median change against the
# noise band.
# ----------------------------------------------------------------------------

struct ClassOut {
    class: str,
    p: float,
    point_pct: float,
    ci_lo: float,
    ci_hi: float,
    cur_med: float,
    base_med: float
}

fn classify(cur_est: list[float], base_est: list[float],
bench_key: str, noise_pct: float) -> Result[ClassOut, Err] {
    if cur_est.len() < min_samples() || base_est.len() < min_samples() {
        return Result.Err(err1("classification needs >= "
        + min_samples().to_str() + " samples per side (bench "
        + bench_key + ")"))
    }
    let p: float = welch_p(cur_est, base_est)
    let significant: bool = p < alpha()
    let cur_med: float = median_of(cur_est)
    let base_med: float = median_of(base_est)
    if base_med <= 0.0 {
        return Result.Err(err1("baseline median is not positive (bench "
        + bench_key + ")"))
    }
    let point: float = (cur_med - base_med) / base_med * 100.0
    let mut st: int = rng_seed_of(bench_key)
    let nb: int = base_est.len()
    let diffs: list[float] = []
    let mut bi: int = 0
    while bi < bootstrap_b() {
        # resample both sides with replacement, medians, percent of base
        let cs: list[float] = []
        let mut ci: int = 0
        while ci < cur_est.len() {
            st = xs_next(st)
            cs.push(cur_est.get(xs_pick(st, cur_est.len())))
            ci = ci + 1
        }
        let bs: list[float] = []
        let mut di: int = 0
        while di < nb {
            st = xs_next(st)
            bs.push(base_est.get(xs_pick(st, nb)))
            di = di + 1
        }
        diffs.push((median_of(cs) - median_of(bs)) / base_med * 100.0)
        bi = bi + 1
    }
    let sorted: list[float] = sort_floats(diffs)
    let lo: float = quantile_of(sorted, 0.025)
    let hi: float = quantile_of(sorted, 0.975)
    let mut klass: str = "within-noise"
    if !significant {
        klass = "no-change"
    } else if lo > noise_pct {
        klass = "regressed"
    } else if hi < 0.0 - noise_pct {
        klass = "improved"
    }
    return Result.Ok(ClassOut {
        class: klass, p: p, point_pct: point,
        ci_lo: lo, ci_hi: hi,
        cur_med: cur_med, base_med: base_med
    })
}

# ----------------------------------------------------------------------------
# pick_baseline + verdict_of — the instrument law and the full machine
# verdict.
# ----------------------------------------------------------------------------

fn pick_baseline(new_rec: Entry, entries: list[Entry], want: str)
-> Result[Entry, Err] {
    let recs: list[Entry] = records_of(entries)
    let mut idx: int = 0
    let mut i: int = 0
    while i < recs.len() {
        if recs.get(i).line == new_rec.line {
            idx = i
        }
        i = i + 1
    }
    if want != "" {
        let cands: list[Entry] = []
        i = 0
        while i < recs.len() {
            if jstr_of(recs.get(i).v, "commit").starts_with(want) {
                cands.push(recs.get(i))
            }
            i = i + 1
        }
        if cands.len() == 0 {
            return Result.Err(err2("no record carries commit prefix "
            + py_repr_str(want)))
        }
        if cands.len() > 1 {
            return Result.Err(err2("commit prefix " + py_repr_str(want)
            + " is ambiguous (" + cands.len().to_str() + " records)"))
        }
        let base0: Entry = cands.get(0)
        if base0.line == new_rec.line {
            return Result.Err(err2("the baseline is the record itself "
            + "— a record does not regress against itself"))
        }
        return check_baseline(base0, new_rec)
    }
    let earlier: list[Entry] = []
    i = 0
    while i < idx {
        let r: Entry = recs.get(i)
        if jstr_of(r.v, "backend") == jstr_of(new_rec.v, "backend")
        && jstr_of(r.v, "suite_digest")
        == jstr_of(new_rec.v, "suite_digest") {
            earlier.push(r)
        }
        i = i + 1
    }
    if earlier.len() == 0 {
        return Result.Err(err2("no earlier record of the same instrument "
        + "to compare against (backend=" + jstr_of(new_rec.v, "backend")
        + " suite_digest=" + take_s(jstr_of(new_rec.v, "suite_digest"), 12)
        + ") — record one first"))
    }
    return check_baseline(earlier.get(earlier.len() - 1), new_rec)
}

# check_baseline(base, new_rec) — the instrument law, for BOTH paths.
fn check_baseline(base: Entry, new_rec: Entry) -> Result[Entry, Err] {
    if jstr_of(base.v, "backend") != jstr_of(new_rec.v, "backend") {
        return Result.Err(err1("different instruments: the baseline is "
        + jstr_of(base.v, "backend") + ", the record is "
        + jstr_of(new_rec.v, "backend")
        + " — interpreter and native timings are different "
        + "instruments"))
    }
    if jstr_of(base.v, "suite_digest") != jstr_of(new_rec.v, "suite_digest") {
        return Result.Err(err1("the suite changed since the baseline "
        + "(digest " + take_s(jstr_of(base.v, "suite_digest"), 12)
        + " vs " + take_s(jstr_of(new_rec.v, "suite_digest"), 12)
        + ") — re-baseline, do not compare"))
    }
    return Result.Ok(base)
}

# active_sanction(entries, name) — the FIRST sanction naming the bench.
fn active_sanction(entries: list[Entry], name: str) -> Option[Entry] {
    let sancs: list[Entry] = sanctions_of(entries)
    let mut i: int = 0
    while i < sancs.len() {
        if jstr_of(sancs.get(i).v, "bench") == name {
            return Option.Some(sancs.get(i))
        }
        i = i + 1
    }
    return Option.None
}

# obj_with(v, key, val) — a copy of the object with one key set.
fn obj_with(v: JsonValue, key: str, val: JsonValue) -> JsonValue {
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    let mut replaced: bool = false
    while i < v.obj_keys.len() {
        if v.obj_keys.get(i) == key {
            keys.push(key)
            vals.push(val)
            replaced = true
        } else {
            keys.push(v.obj_keys.get(i))
            vals.push(v.obj_vals.get(i))
        }
        i = i + 1
    }
    if !replaced {
        keys.push(key)
        vals.push(val)
    }
    return jobject(keys, vals)
}

fn verdict_of(entries: list[Entry], baseline: str, noise_pct: float)
-> Result[JsonValue, Err] {
    let recs: list[Entry] = records_of(entries)
    if recs.len() == 0 {
        return Result.Err(err2("the ledger carries no records — nothing "
        + "to gate"))
    }
    let new_rec: Entry = recs.get(recs.len() - 1)
    let base_r: Result[Entry, Err] = pick_baseline(new_rec, entries,
    baseline)
    if result_is_err(base_r) {
        return Result.Err(result_err_or(base_r, err1("")))
    }
    let base_rec: Entry = result_unwrap(base_r)

    let new_names: list[str] = bench_names_sorted(new_rec.v)
    let base_names: list[str] = bench_names_sorted(base_rec.v)
    let all_names: list[str] = []
    let mut i: int = 0
    while i < new_names.len() {
        all_names.push(new_names.get(i))
        i = i + 1
    }
    i = 0
    while i < base_names.len() {
        let n: str = base_names.get(i)
        let mut found: bool = false
        let mut j: int = 0
        while j < all_names.len() {
            if all_names.get(j) == n {
                found = true
            }
            j = j + 1
        }
        if !found {
            all_names.push(n)
        }
        i = i + 1
    }
    let names: list[str] = sort_strs(all_names)

    let rows: list[JsonValue] = []
    let mut ri: int = 0
    while ri < names.len() {
        let name: str = names.get(ri)
        let in_new: bool = json_object_has(jget(new_rec.v, "benches"), name)
        let in_base: bool = json_object_has(jget(base_rec.v, "benches"),
        name)
        let mut row: JsonValue = json_null()
        if in_new && in_base {
            let cr: Result[ClassOut, Err] = classify(
            estimates_of(new_rec.v, name),
            estimates_of(base_rec.v, name), name, noise_pct)
            if result_is_err(cr) {
                return Result.Err(result_err_or(cr, err1("")))
            }
            let c: ClassOut = result_unwrap(cr)
            let samples_count: JsonValue = jget(json_object_get(
            jget(new_rec.v, "benches"), name), "samples_count")
            row = jobject(["bench", "class", "p", "point_pct", "ci_pct",
            "cur_median_ns", "base_median_ns", "samples"],
            [json_str(name), json_str(c.class), json_float(c.p),
            json_float(c.point_pct),
            jarr([json_float(c.ci_lo), json_float(c.ci_hi)]),
            json_float(c.cur_med), json_float(c.base_med),
            samples_count])
        } else if in_new {
            let b: JsonValue = json_object_get(jget(new_rec.v, "benches"),
            name)
            let med: JsonValue = jget(b, "median_ns")
            row = jobject(["bench", "class", "cur_median_ns"],
            [json_str(name), json_str("new"), med])
        } else {
            row = jobject(["bench", "class"],
            [json_str(name), json_str("vanished")])
        }
        let klass: str = jstr_of(row, "class")
        if klass == "regressed" || klass == "vanished" {
            let s: Option[Entry] = active_sanction(entries, name)
            if option_is_some(s) {
                let sv: JsonValue = option_unwrap(s).v
                let sanc: JsonValue = jobject(["reason", "author",
                "commit"],
                [jget(sv, "reason"), jget(sv, "author"),
                jget(sv, "commit")])
                row = obj_with(row, "sanction", sanc)
            }
        }
        rows.push(row)
        ri = ri + 1
    }

    let sanctioned: list[str] = []
    let unsanctioned: list[str] = []
    let mut si: int = 0
    while si < rows.len() {
        let r: JsonValue = rows.get(si)
        let klass: str = jstr_of(r, "class")
        if klass == "regressed" || klass == "vanished" {
            if json_is_object(jget(r, "sanction")) {
                sanctioned.push(jstr_of(r, "bench"))
            } else {
                unsanctioned.push(jstr_of(r, "bench"))
            }
        }
        si = si + 1
    }
    let mut verdict: str = "fail"
    if unsanctioned.len() == 0 {
        verdict = "pass"
    }
    let san_sorted: list[str] = sort_strs(sanctioned)
    let uns_sorted: list[str] = sort_strs(unsanctioned)
    let san_vals: list[JsonValue] = []
    let mut si2: int = 0
    while si2 < san_sorted.len() {
        san_vals.push(json_str(san_sorted.get(si2)))
        si2 = si2 + 1
    }
    let uns_vals: list[JsonValue] = []
    let mut ui: int = 0
    while ui < uns_sorted.len() {
        uns_vals.push(json_str(uns_sorted.get(ui)))
        ui = ui + 1
    }
    return Result.Ok(jobject(["tool", "version", "verdict", "record",
    "baseline", "backend", "suite", "noise_pct", "benches",
    "sanctioned", "unsanctioned"],
    [json_str(tool_name()), json_str(tool_version()),
    json_str(verdict), json_str(jstr_of(new_rec.v, "commit")),
    json_str(jstr_of(base_rec.v, "commit")),
    json_str(jstr_of(new_rec.v, "backend")),
    json_str(jstr_of(new_rec.v, "suite")),
    json_float(noise_pct), jarr(rows), jarr(san_vals),
    jarr(uns_vals)]))
}

# ----------------------------------------------------------------------------
# The dashboard — the deterministic render of the ledger.
# ----------------------------------------------------------------------------

# obj_with now lives beside verdict_of (its first user).

fn num_or(v: JsonValue, dflt: float) -> float {
    if json_is_int(v) {
        return json_int_value(v).to_float()
    }
    if json_is_float(v) {
        return json_float_value(v)
    }
    return dflt
}

fn replace_all(s: str, from: str, to: str) -> str {
    if from == "" || !s.contains(from) {
        return s
    }
    let mut out: str = ""
    let mut i: int = 0
    let flen: int = from.len()
    while i < s.len() {
        if i + flen <= s.len() && s.slice(i, i + flen) == from {
            out = out + to
            i = i + flen
        } else {
            out = out + s.slice(i, i + 1)
            i = i + 1
        }
    }
    return out
}

fn sparkline(medians: list[float]) -> str {
    if medians.len() == 0 {
        return ""
    }
    let mut lo: float = medians.get(0)
    let mut hi: float = medians.get(0)
    let mut i: int = 0
    while i < medians.len() {
        if medians.get(i) < lo {
            lo = medians.get(i)
        }
        if medians.get(i) > hi {
            hi = medians.get(i)
        }
        i = i + 1
    }
    if hi <= lo {
        return repeat_str(spark_mid(), medians.len())
    }
    let span: float = hi - lo
    let mut out: str = ""
    i = 0
    while i < medians.len() {
        let v: float = medians.get(i)
        let t: float = ((v - lo) * 14.0 + span) / (2.0 * span)
        let band: int = (t - (t % 1.0)).to_int()
        out = out + spark_bands().slice(band * 3, band * 3 + 3)
        i = i + 1
    }
    return out
}

fn render_dashboard(entries: list[Entry], history_path: str, limit: int,
stamp: str) -> Result[str, Err] uses Fs {
    let recs: list[Entry] = records_of(entries)
    if recs.len() == 0 {
        return Result.Err(err2("the ledger carries no records — nothing "
        + "to render"))
    }
    if !file_exists(history_path) {
        return Result.Err(err2("cannot read the ledger: "
        + history_path))
    }
    let digest: str = sha256_hex(read_file(history_path))
    let new_rec: Entry = recs.get(recs.len() - 1)
    let vr: Result[JsonValue, Err] = verdict_of(entries, "",
    default_noise_pct())
    let has_verdict: bool = result_is_ok(vr)
    let mut verdict: JsonValue = json_null()
    let mut base: Entry = new_rec
    if has_verdict {
        verdict = result_unwrap(vr)
        base = result_unwrap(pick_baseline(new_rec, entries, ""))
    }

    let bench_names: list[str] = bench_names_sorted(new_rec.v)
    let mut shown: list[Entry] = recs
    if limit > 0 && recs.len() > limit {
        shown = []
        let mut i: int = recs.len() - limit
        while i < recs.len() {
            shown.push(recs.get(i))
            i = i + 1
        }
    }

    let lines: list[str] = []
    lines.push("# HLS performance dashboard")
    lines.push("")
    lines.push("- Tool: " + tool_name() + " " + tool_version())
    lines.push("- Ledger: `" + history_path + "` (sha256 `" + digest
    + "`)")
    lines.push("- Records: " + recs.len().to_str() + " (showing "
    + shown.len().to_str() + ")")
    lines.push("- Newest record: `" + jstr_of(new_rec.v, "commit") + "` ("
    + bench_names.len().to_str() + " benches)")
    if has_verdict {
        lines.push("- Baseline: `" + jstr_of(base.v, "commit") + "`")
    } else {
        lines.push("- Baseline: none (no earlier record of this "
        + "instrument)")
    }
    if has_verdict {
        lines.push("- Gate verdict: **" + jstr_of(verdict, "verdict")
        + "**")
        let uns: list[str] = []
        let uns_arr: JsonValue = jget(verdict, "unsanctioned")
        if json_is_array(uns_arr) {
            let mut i: int = 0
            while i < uns_arr.arr.len() {
                uns.push(json_str_value(uns_arr.arr.get(i)))
                i = i + 1
            }
        }
        if uns.len() > 0 {
            lines.push("- Unsanctioned: " + str_join(uns, ", "))
        }
    } else {
        lines.push("- Gate verdict: n/a (no earlier record of this "
        + "instrument to compare against)")
    }
    if stamp != "" {
        lines.push("- Generated: " + stamp)
    }
    lines.push("")
    lines.push("## Verdicts (newest record vs baseline)")
    lines.push("")
    if !has_verdict {
        lines.push("No comparison yet: the newest record is the first of "
        + "its instrument. Record twice and the verdict table fills.")
    } else {
        lines.push("| bench | base | now | change | 95% CI | p | class |")
        lines.push("|---|---|---|---|---|---|---|")
        let rows: JsonValue = jget(verdict, "benches")
        let mut i: int = 0
        while i < rows.arr.len() {
            let r: JsonValue = rows.arr.get(i)
            let klass: str = jstr_of(r, "class")
            let mut sanc_note: str = ""
            if json_is_object(jget(r, "sanction")) {
                sanc_note = " (sanctioned)"
            }
            if klass == "no-change" || klass == "within-noise"
            || klass == "improved" || klass == "regressed" {
                let ci: JsonValue = jget(r, "ci_pct")
                let mut lo: float = 0.0
                let mut hi: float = 0.0
                if json_is_array(ci) && ci.arr.len() == 2 {
                    lo = json_float_value(ci.arr.get(0))
                    hi = json_float_value(ci.arr.get(1))
                }
                let mut pv: float = 0.0
                if json_is_float(jget(r, "p")) {
                    pv = json_float_value(jget(r, "p"))
                }
                lines.push("| " + jstr_of(r, "bench") + " | "
                + fmt_time(num_or(jget(r, "base_median_ns"), 0.0))
                + " | "
                + fmt_time(num_or(jget(r, "cur_median_ns"), 0.0))
                + " | " + fmt_pct(num_or(jget(r, "point_pct"), 0.0))
                + " | [" + fmt_pct(lo) + " " + fmt_pct(hi) + "] | "
                + fmt_fixed(pv, 4) + " | " + klass + sanc_note + " |")
            } else if klass == "new" {
                lines.push("| " + jstr_of(r, "bench") + " | — | "
                + fmt_time(num_or(jget(r, "cur_median_ns"), 0.0))
                + " | — | — | — | new |")
            } else {
                lines.push("| " + jstr_of(r, "bench") + " | "
                + fmt_time(num_or(jget(r, "base_median_ns"), 0.0))
                + " | — | — | — | — | vanished |")
            }
            i = i + 1
        }
    }
    lines.push("")
    lines.push("## Trends (median ns/iter across records, oldest to "
    + "newest)")
    lines.push("")
    let head_cells: list[str] = []
    let mut i2: int = 0
    while i2 < shown.len() {
        head_cells.push(take_s(jstr_of(shown.get(i2).v, "commit"), 7))
        i2 = i2 + 1
    }

    lines.push("| bench | trend | " + str_join(head_cells, " | ") + " |")
    lines.push("|---|---|" + repeat_str("---|", shown.len()))
    let mut ni: int = 0
    while ni < bench_names.len() {
        let name: str = bench_names.get(ni)
        let series: list[float] = []
        let known_flags: list[bool] = []
        let mut i3: int = 0
        while i3 < shown.len() {
            let b: JsonValue = json_object_get(
            jget(shown.get(i3).v, "benches"), name)
            if json_is_object(b) {
                let m: JsonValue = jget(b, "median_ns")
                if json_is_int(m) || json_is_float(m) {
                    known_flags.push(true)
                    series.push(num_or(m, 0.0))
                } else {
                    known_flags.push(false)
                    series.push(0.0)
                }
            } else {
                known_flags.push(false)
                series.push(0.0)
            }
            i3 = i3 + 1
        }
        let known: list[float] = []
        let mut ki: int = 0
        while ki < series.len() {
            if known_flags.get(ki) {
                known.push(series.get(ki))
            }
            ki = ki + 1
        }
        let mut spark: str = "-"
        if known.len() > 0 {
            spark = sparkline(known)
        }
        let cells: list[str] = []
        let mut ci2: int = 0
        while ci2 < series.len() {
            if known_flags.get(ci2) {
                cells.push(fmt_time(series.get(ci2)))
            } else {
                cells.push("—")
            }
            ci2 = ci2 + 1
        }
        lines.push("| " + name + " | " + spark + " | "
        + str_join(cells, " | ") + " |")
        ni = ni + 1
    }
    lines.push("")
    lines.push("## Sanctions")
    lines.push("")
    let sancs: list[Entry] = sanctions_of(entries)
    if sancs.len() == 0 {
        lines.push("None. Every regression the ledger has seen was "
        + "answered, not excused.")
    } else {
        lines.push("| bench | author | commit | reason |")
        lines.push("|---|---|---|---|")
        let seen_keys: list[str] = []
        let mut si: int = 0
        while si < sancs.len() {
            let sv: JsonValue = sancs.get(si).v
            let key: str = jstr_of(sv, "bench") + "\n"
            + jstr_of(sv, "reason")
            let mut dup: bool = false
            let mut di: int = 0
            while di < seen_keys.len() {
                if seen_keys.get(di) == key {
                    dup = true
                }
                di = di + 1
            }
            if !dup {
                seen_keys.push(key)
                let mut author: str = jstr_of(sv, "author")
                if author == "" {
                    author = "unknown"
                }
                let mut commit_cell: str = "—"
                let cv: JsonValue = jget(sv, "commit")
                if json_is_str(cv) && json_str_value(cv) != "" {
                    commit_cell = "`" + take_s(json_str_value(cv), 10) + "`"
                }
                let reason: str = replace_all(jstr_of(sv, "reason"), "|",
                "\\|")
                lines.push("| " + jstr_of(sv, "bench") + " | " + author
                + " | " + commit_cell + " | " + reason + " |")
            }
            si = si + 1
        }
    }
    lines.push("")
    lines.push("## Reading this dashboard")
    lines.push("")
    lines.push("- A record is one hls-bench measurement pinned to one "
    + "clean commit; the ledger is append-only and this document is "
    + "a pure render of it (the sha256 above pins the bytes).")
    lines.push("- Classes come from Stage 124's law: Welch p < 0.05 for "
    + "significance, the seeded bootstrap CI of the median change "
    + "against the 5% noise band. Non-significant changes are "
    + "no-change; significant changes inside the band are "
    + "within-noise.")
    lines.push("- regressed or vanished benches fail the gate unless a "
    + "sanction names them. A sanction is a written excuse with an "
    + "author — the register above is the audit trail.")
    lines.push("- Interpreter and native timings are different "
    + "instruments; the ledger never compares across backends or "
    + "across suite digests.")
    lines.push("")
    return Result.Ok(str_join(lines, "\n"))
}

# ----------------------------------------------------------------------------
# The CLI — the .py's argparse surface (usage errors exit 2).
# ----------------------------------------------------------------------------

struct Cli {
    cmd: str,
    root: str,
    suite: str,
    native: bool,
    grep: str,
    samples: int,
    fixed_iters: int,
    from_report: str,
    commit: str,
    note: str,
    allow_dirty: bool,
    stamp: bool,
    history: str,
    json_out: str,
    bench: str,
    reason: str,
    author: str,
    baseline: str,
    threshold: float,
    quiet: bool,
    out: str,
    limit: int,
    bench_filter: str,
    json_flag: bool
}

fn usage_error() -> int uses IO {
    eprintln("usage: hls-perf {record|sanction|gate|dashboard|history} "
    + "[options]")
    return 2
}

fn need_int(val: str, flag: str) -> Result[int, Err] {
    let v: Option[int] = parse_int_opt(val)
    if option_is_none(v) {
        return Result.Err(err2("invalid int value: '" + val + "' ("
        + flag + ")"))
    }
    return Result.Ok(option_unwrap(v))
}

fn need_float(val: str, flag: str) -> Result[float, Err] {
    let v: Option[float] = parse_float_opt(val)
    if option_is_none(v) {
        return Result.Err(err2("invalid float value: '" + val + "' ("
        + flag + ")"))
    }
    return Result.Ok(option_unwrap(v))
}

fn parse_cli(argv: list[str]) -> Result[Cli, Err] {
    if argv.len() < 2 {
        return Result.Err(err2("usage"))
    }
    let c: Cli = Cli {
        cmd: argv.get(1),
        root: "",
        suite: default_suite(),
        native: false,
        grep: "",
        samples: default_samples(),
        fixed_iters: default_fixed_iters(),
        from_report: "",
        commit: "",
        note: "",
        allow_dirty: false,
        stamp: false,
        history: "",
        json_out: "",
        bench: "",
        reason: "",
        author: "",
        baseline: "",
        threshold: default_noise_pct(),
        quiet: false,
        out: "",
        limit: default_dash_limit(),
        bench_filter: "",
        json_flag: false
    }
    let known: list[str] = ["record", "sanction", "gate", "dashboard",
    "history"]
    let mut is_known: bool = false
    let mut k: int = 0
    while k < known.len() {
        if known.get(k) == c.cmd {
            is_known = true
        }
        k = k + 1
    }
    if !is_known {
        return Result.Err(err2("usage"))
    }
    let mut i: int = 2
    while i < argv.len() {
        let a: str = argv.get(i)
        if a == "--json" {
            # history's --json is a flag; every other subcommand's is a
            # path (the .py's argparse shapes).
            if c.cmd == "history" {
                c.json_flag = true
                i = i + 1
            } else {
                if i + 1 >= argv.len() {
                    return Result.Err(err2("usage: --json expects a value"))
                }
                c.json_out = argv.get(i + 1)
                i = i + 2
            }
        } else if a == "--root" || a == "--suite" || a == "--grep"
        || a == "--from-report" || a == "--commit" || a == "--note"
        || a == "--history" || a == "--reason"
        || a == "--author" || a == "--baseline"
        || a == "--threshold" || a == "--out" || a == "--limit"
        || a == "--bench" || a == "--samples"
        || a == "--fixed-iters" {
            if i + 1 >= argv.len() {
                return Result.Err(err2("usage: " + a + " expects a value"))
            }
            let val: str = argv.get(i + 1)
            if a == "--root" {
                c.root = val
            } else if a == "--suite" {
                c.suite = val
            } else if a == "--grep" {
                c.grep = val
            } else if a == "--from-report" {
                c.from_report = val
            } else if a == "--commit" {
                c.commit = val
            } else if a == "--note" {
                c.note = val
            } else if a == "--history" {
                c.history = val
            } else if a == "--json" {
                c.json_out = val
            } else if a == "--reason" {
                c.reason = val
            } else if a == "--author" {
                c.author = val
            } else if a == "--baseline" {
                c.baseline = val
            } else if a == "--threshold" {
                let fv: Result[float, Err] = need_float(val, a)
                if result_is_err(fv) {
                    return Result.Err(result_err_or(fv, err2("")))
                }
                c.threshold = result_unwrap(fv)
            } else if a == "--out" {
                c.out = val
            } else if a == "--limit" {
                let iv: Result[int, Err] = need_int(val, a)
                if result_is_err(iv) {
                    return Result.Err(result_err_or(iv, err2("")))
                }
                c.limit = result_unwrap(iv)
            } else if a == "--bench" {
                c.bench_filter = val
            } else if a == "--samples" {
                let iv: Result[int, Err] = need_int(val, a)
                if result_is_err(iv) {
                    return Result.Err(result_err_or(iv, err2("")))
                }
                c.samples = result_unwrap(iv)
            } else if a == "--fixed-iters" {
                let iv: Result[int, Err] = need_int(val, a)
                if result_is_err(iv) {
                    return Result.Err(result_err_or(iv, err2("")))
                }
                c.fixed_iters = result_unwrap(iv)
            }
            i = i + 2
        } else if a == "--native" {
            c.native = true
            i = i + 1
        } else if a == "--allow-dirty" {
            c.allow_dirty = true
            i = i + 1
        } else if a == "--stamp" {
            c.stamp = true
            i = i + 1
        } else if a == "--quiet" {
            c.quiet = true
            i = i + 1
        } else {
            # a positional (the sanction bench)
            if c.cmd == "sanction" && c.bench == "" && a.len() > 0
            && a.byte_at(0) != 45 {
                c.bench = a
                i = i + 1
            } else {
                return Result.Err(err2("usage: unknown argument " + a))
            }
        }
    }
    return Result.Ok(c)
}

# ----------------------------------------------------------------------------
# record — measure now, or import a report, and pin it to a commit.
# ----------------------------------------------------------------------------

fn cmd_record(c: Cli, root: str, self_path: str) -> Result[int, Err]
uses IO, Fs, Proc, Clock {
    let mut history: str = c.history
    if history == "" {
        history = history_default()
    }
    let mut commit: str = ""
    if c.commit != "" {
        commit = str_to_lower_ascii(strip_ws(c.commit))
        if !is_sha1(commit) {
            return Result.Err(err2("--commit must be a 40-hex sha (got "
            + py_repr_str(c.commit) + ")"))
        }
    } else {
        commit = git_head(root)
        if commit == "" {
            return Result.Err(err2(root + " is not a git work tree — "
            + "pass --commit to pin the record explicitly"))
        }
        if git_dirty(root) && !c.allow_dirty {
            return Result.Err(err1("the work tree carries tracked "
            + "modifications — a per-commit record pins a clean "
            + "commit (--allow-dirty to record anyway)"))
        }
    }

    let dr: Result[str, Err] = suite_digest(root, c.suite)
    if result_is_err(dr) {
        return Result.Err(result_err_or(dr, err1("")))
    }
    let digest: str = result_unwrap(dr)

    let mut report: JsonValue = json_null()
    let mut source: str = ""
    if c.from_report != "" {
        if !file_exists(c.from_report) {
            return Result.Err(err2("cannot read the report: [Errno 2] "
            + "No such file or directory: '" + c.from_report + "'"))
        }
        let rr: Result[JsonValue, str] = json_parse_result(
        read_file(c.from_report))
        if result_is_err(rr) {
            return Result.Err(err2("the report is not valid JSON: "
            + result_err_or(rr, "parse error")))
        }
        report = result_unwrap(rr)
        source = "report " + c.from_report
    } else {
        let mr: Result[JsonValue, Err] = run_hls_bench(self_path, root,
        c.suite, c.samples, c.fixed_iters, c.native, c.grep, 1)
        if result_is_err(mr) {
            return Result.Err(result_err_or(mr, err1("")))
        }
        report = result_unwrap(mr)
        source = "hls-bench"
    }

    let br: Result[ReportOut, Err] = report_to_benches(report)
    if result_is_err(br) {
        return Result.Err(result_err_or(br, err1("")))
    }
    let out: ReportOut = result_unwrap(br)

    let mut stamp_val: JsonValue = json_null()
    if c.stamp {
        stamp_val = json_str(utc_now())
    }
    let mut note_val: JsonValue = json_null()
    if c.note != "" {
        note_val = json_str(c.note)
    }
    let skip_vals: list[JsonValue] = []
    let mut si: int = 0
    while si < out.skipped.len() {
        skip_vals.push(json_str(out.skipped.get(si)))
        si = si + 1
    }
    let entry: JsonValue = jobject(["type", "tool", "version", "commit",
    "backend", "suite", "suite_digest", "plan", "noise_pct", "env",
    "benches", "skipped", "note", "stamp"],
    [json_str("record"), json_str(tool_name()),
    json_str(tool_version()), json_str(commit),
    json_str(out.backend), json_str(c.suite), json_str(digest),
    jobject(["mode", "samples", "iters"],
    [json_str("fixed"), json_int(c.samples),
    json_int(c.fixed_iters)]),
    json_float(default_noise_pct()), env_fingerprint(),
    out.benches, jarr(skip_vals), note_val, stamp_val])
    let vr: Result[bool, Err] = validate_record(entry, "the new record")
    if result_is_err(vr) {
        return Result.Err(result_err_or(vr, err1("")))
    }
    let ar: Result[bool, Err] = append_entry(history, entry)
    if result_is_err(ar) {
        return Result.Err(result_err_or(ar, err1("")))
    }
    if c.json_out != "" {
        write_file(c.json_out, pretty_json(report))
    }
    let bench_names: list[str] = bench_names_sorted(entry)
    println("recorded " + take_s(commit, 10) + " (" + commit + ") backend="
    + out.backend + " suite=" + c.suite + " benches="
    + bench_names.len().to_str() + " source=" + source)
    let mut i: int = 0
    while i < bench_names.len() {
        let name: str = bench_names.get(i)
        let b: JsonValue = json_object_get(jget(entry, "benches"), name)
        let med: JsonValue = jget(b, "median_ns")
        let mut count: int = 0
        let sc: JsonValue = jget(b, "samples_count")
        if json_is_int(sc) {
            count = json_int_value(sc)
        }
        println("  " + pad_right(name, 24) + " median "
        + fmt_time(num_or(med, 0.0)) + "  ("
        + count.to_str() + " samples)")
        i = i + 1
    }
    if out.skipped.len() > 0 {
        println("  skipped: " + str_join(out.skipped, ", "))
    }
    return Result.Ok(0)
}

# ----------------------------------------------------------------------------
# sanction — a written excuse, one bench at a time.
# ----------------------------------------------------------------------------

fn cmd_sanction(c: Cli, root: str) -> Result[int, Err]
uses IO, Fs, Proc, Clock {
    let mut history: str = c.history
    if history == "" {
        history = history_default()
    }
    let lr: Result[list[Entry], Err] = load_history(history)
    if result_is_err(lr) {
        return Result.Err(result_err_or(lr, err1("")))
    }
    let entries: list[Entry] = result_unwrap(lr)
    if c.bench == "" {
        return Result.Err(err2("usage: sanction BENCH --reason TEXT"))
    }
    let known: list[str] = []
    let recs: list[Entry] = records_of(entries)
    let mut ri: int = 0
    while ri < recs.len() {
        let names: list[str] = bench_names_sorted(recs.get(ri).v)
        let mut ni: int = 0
        while ni < names.len() {
            let n: str = names.get(ni)
            let mut found: bool = false
            let mut j: int = 0
            while j < known.len() {
                if known.get(j) == n {
                    found = true
                }
                j = j + 1
            }
            if !found {
                known.push(n)
            }
            ni = ni + 1
        }
        ri = ri + 1
    }
    let sorted_known: list[str] = sort_strs(known)
    let mut has: bool = false
    let mut ki: int = 0
    while ki < sorted_known.len() {
        if sorted_known.get(ki) == c.bench {
            has = true
        }
        ki = ki + 1
    }
    if !has {
        let mut list_str: str = "(none)"
        if sorted_known.len() > 0 {
            list_str = str_join(sorted_known, ", ")
        }
        return Result.Err(err2("unknown bench " + py_repr_str(c.bench)
        + " — the ledger knows: " + list_str))
    }
    if c.reason == "" {
        return Result.Err(err2("a sanction without a written reason is "
        + "not a sanction (--reason TEXT)"))
    }
    let mut author: str = c.author
    if author == "" {
        author = git_user(root)
    }
    let mut stamp_val: JsonValue = json_null()
    if c.stamp {
        stamp_val = json_str(utc_now())
    }
    let mut commit_val: JsonValue = json_null()
    if c.commit != "" {
        commit_val = json_str(c.commit)
    }
    let entry: JsonValue = jobject(["type", "tool", "version", "bench",
    "reason", "commit", "author", "stamp"],
    [json_str("sanction"), json_str(tool_name()),
    json_str(tool_version()), json_str(c.bench),
    json_str(c.reason), commit_val, json_str(author), stamp_val])
    let ar: Result[bool, Err] = append_entry(history, entry)
    if result_is_err(ar) {
        return Result.Err(result_err_or(ar, err1("")))
    }
    println("sanctioned " + c.bench + " (" + author + ")")
    return Result.Ok(0)
}

# ----------------------------------------------------------------------------
# gate — the law: one unsanctioned regression fails.
# ----------------------------------------------------------------------------

fn cmd_gate(c: Cli) -> Result[int, Err] uses IO, Fs {
    let mut history: str = c.history
    if history == "" {
        history = history_default()
    }
    let lr: Result[list[Entry], Err] = load_history(history)
    if result_is_err(lr) {
        return Result.Err(result_err_or(lr, err1("")))
    }
    let entries: list[Entry] = result_unwrap(lr)
    let vr: Result[JsonValue, Err] = verdict_of(entries, c.baseline,
    c.threshold)
    if result_is_err(vr) {
        return Result.Err(result_err_or(vr, err1("")))
    }
    let v: JsonValue = result_unwrap(vr)
    if !c.quiet {
        println("gate " + str_to_upper_ascii(jstr_of(v, "verdict"))
        + ": record " + take_s(jstr_of(v, "record"), 10)
        + " vs baseline " + take_s(jstr_of(v, "baseline"), 10)
        + " (backend " + jstr_of(v, "backend") + ", threshold "
        + fmt_fixed(num_or(jget(v, "noise_pct"), 0.0), 1) + "%)")
        let rows: JsonValue = jget(v, "benches")
        let mut i: int = 0
        while i < rows.arr.len() {
            let r: JsonValue = rows.arr.get(i)
            let klass: str = jstr_of(r, "class")
            let mut line: str = "  " + pad_right(jstr_of(r, "bench"), 24)
            if klass == "no-change" || klass == "within-noise"
            || klass == "improved" || klass == "regressed" {
                let ci: JsonValue = jget(r, "ci_pct")
                let mut lo: float = 0.0
                let mut hi: float = 0.0
                if json_is_array(ci) && ci.arr.len() == 2 {
                    lo = json_float_value(ci.arr.get(0))
                    hi = json_float_value(ci.arr.get(1))
                }
                line = line + " " + pad_right(klass, 12) + " "
                + fmt_pct(num_or(jget(r, "point_pct"), 0.0))
                + "  [" + fmt_pct(lo) + " " + fmt_pct(hi) + "]  p="
                + fmt_fixed(num_or(jget(r, "p"), 0.0), 4)
            } else {
                line = line + " " + klass
                if klass == "new" {
                    line = line + " ("
                    + fmt_time(num_or(jget(r, "cur_median_ns"), 0.0))
                    + ")"
                }
            }
            if json_is_object(jget(r, "sanction")) {
                let s: JsonValue = jget(r, "sanction")
                line = line + "  sanctioned: " + jstr_of(s, "reason")
                + " (" + jstr_of(s, "author") + ")"
            }
            println(line)
            i = i + 1
        }
    }
    let uns_arr: JsonValue = jget(v, "unsanctioned")
    let uns: list[str] = []
    if json_is_array(uns_arr) {
        let mut i2: int = 0
        while i2 < uns_arr.arr.len() {
            uns.push(json_str_value(uns_arr.arr.get(i2)))
            i2 = i2 + 1
        }
    }
    let rows: JsonValue = jget(v, "benches")
    if uns.len() > 0 {
        println("GATE FAIL: " + uns.len().to_str()
        + " regressed without a sanction: " + str_join(uns, ", "))
    } else if !c.quiet {
        println("GATE PASS: no unsanctioned regression across "
        + rows.arr.len().to_str() + " benches")
    }
    if c.json_out != "" {
        write_file(c.json_out, pretty_json(v))
    }
    if uns.len() > 0 {
        return Result.Ok(1)
    }
    return Result.Ok(0)
}

# ----------------------------------------------------------------------------
# dashboard — the deterministic render of the ledger.
# ----------------------------------------------------------------------------

fn cmd_dashboard(c: Cli) -> Result[int, Err] uses IO, Fs, Clock {
    if c.out == "" {
        return Result.Err(err2("usage: dashboard --out FILE.md"))
    }
    let mut history: str = c.history
    if history == "" {
        history = history_default()
    }
    let lr: Result[list[Entry], Err] = load_history(history)
    if result_is_err(lr) {
        return Result.Err(result_err_or(lr, err1("")))
    }
    let entries: list[Entry] = result_unwrap(lr)
    let mut stamp: str = ""
    if c.stamp {
        stamp = utc_now()
    }
    let dr: Result[str, Err] = render_dashboard(entries, history, c.limit,
    stamp)
    if result_is_err(dr) {
        return Result.Err(result_err_or(dr, err1("")))
    }
    write_file(c.out, result_unwrap(dr))
    if c.json_out != "" {
        let vr: Result[JsonValue, Err] = verdict_of(entries, "",
        default_noise_pct())
        if result_is_err(vr) {
            return Result.Err(result_err_or(vr, err1("")))
        }
        write_file(c.json_out, pretty_json(result_unwrap(vr)))
    }
    println("dashboard written to " + c.out)
    return Result.Ok(0)
}

# ----------------------------------------------------------------------------
# history — read the ledger back.
# ----------------------------------------------------------------------------

fn cmd_history(c: Cli) -> Result[int, Err] uses IO, Fs {
    let mut history: str = c.history
    if history == "" {
        history = history_default()
    }
    let lr: Result[list[Entry], Err] = load_history(history)
    if result_is_err(lr) {
        return Result.Err(result_err_or(lr, err1("")))
    }
    let entries: list[Entry] = result_unwrap(lr)
    let mut shown: list[Entry] = entries
    if c.bench_filter != "" {
        shown = []
        let mut i: int = 0
        while i < entries.len() {
            let e: Entry = entries.get(i)
            let typ: str = jstr_of(e.v, "type")
            let keep: bool = (typ == "record"
            && json_object_has(jget(e.v, "benches"), c.bench_filter))
            || (typ == "sanction"
            && jstr_of(e.v, "bench") == c.bench_filter)
            if keep {
                shown.push(e)
            }
            i = i + 1
        }
    }
    if c.json_flag {
        let vals: list[JsonValue] = []
        let mut i2: int = 0
        while i2 < shown.len() {
            vals.push(shown.get(i2).v)
            i2 = i2 + 1
        }
        print(pretty_json(jarr(vals)))
        return Result.Ok(0)
    }
    let mut i3: int = 0
    while i3 < shown.len() {
        let e: Entry = shown.get(i3)
        if jstr_of(e.v, "type") == "record" {
            let n_benches: int = bench_names_sorted(e.v).len()
            println("line " + pad_left_num(e.line, 4) + " record  "
            + jstr_of(e.v, "commit") + "  "
            + pad_right(jstr_of(e.v, "backend"), 11) + " suite="
            + path_basename(jstr_of(e.v, "suite")) + " benches="
            + n_benches.to_str())
        } else {
            println("line " + pad_left_num(e.line, 4) + " sanction "
            + jstr_of(e.v, "bench") + "  " + jstr_of(e.v, "reason"))
        }
        i3 = i3 + 1
    }
    println(shown.len().to_str() + " entries")
    return Result.Ok(0)
}

# ----------------------------------------------------------------------------
# main
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Fs, Proc, Clock, Args, Exit {
    let argv: list[str] = args()
    # the private bench-probe leg (the parent re-invokes the tool; a
    # suite that does not check dies in the child, not the tool)
    if argv.len() > 1 && argv.get(1) == "--probe-bench" {
        if argv.len() < 3 {
            eprintln("error: --probe-bench needs a file")
            return 2
        }
        return bench_probe_leg(argv.get(2))
    }
    let pr: Result[Cli, Err] = parse_cli(argv)
    if result_is_err(pr) {
        return usage_error()
    }
    let c: Cli = result_unwrap(pr)
    let root: str = repo_root(argv.get(0))
    let mut rc: Result[int, Err] = Result.Ok(0)
    if c.cmd == "record" {
        let mut r: str = c.root
        if r == "" {
            r = root
        }
        rc = cmd_record(c, r, argv.get(0))
    } else if c.cmd == "sanction" {
        let mut r: str = c.root
        if r == "" {
            r = root
        }
        rc = cmd_sanction(c, r)
    } else if c.cmd == "gate" {
        rc = cmd_gate(c)
    } else if c.cmd == "dashboard" {
        rc = cmd_dashboard(c)
    } else {
        rc = cmd_history(c)
    }
    if result_is_err(rc) {
        let e: Err = result_err_or(rc, err1(""))
        eprintln(tool_name() + ": " + e.msg)
        return e.code
    }
    return result_unwrap(rc)
}
