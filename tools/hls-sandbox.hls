# ============================================================================
# tools/hls-sandbox.hls — Stage 110 sandboxed execution (seccomp-bpf),
# in Halis — the native twin of tools/hls-sandbox.py + tools/sandbox_parts/
# (sbx_policy, sbx_bpf, sbx_cemit, sbx_exec, sbx_release, all folded in
# here, sectioned like the parts). Same CLI, same output bytes, same exit
# codes as the .py that retired.
# ----------------------------------------------------------------------------
# Usage (the .py's own grammar):
#   hls-sandbox profile <entry.hls> [flags]
#   hls-sandbox profile --pkg DIR [flags]
#   hls-sandbox run [--pkg DIR | --effects IO,Fs | <entry.hls>]
#                   [flags] -- CMD [ARGS...]
#   hls-sandbox emit [--pkg DIR | --effects ... | <entry.hls>]
#                   [--arch x86_64|aarch64|riscv64] [--out FILE]
#   hls-sandbox release --pkg DIR [--out DIR]
#   hls-sandbox verify-release --pkg DIR
#   hls-sandbox selftest
#
# The one design change the native era forces, and it is deliberate:
# the .py armed the kernel directly through ctypes (prctl + the seccomp(2)
# syscall + execvp inside a forked child). Halis has no prctl and no
# seccomp builtins — and a tool that arms the kernel SHOULD be auditable
# down to the bytes it hands the kernel. So `run` goes through a compiled
# LAUNCHER child: this tool emits a small C translation unit into a
# scratch dir (the same arming sequence the emitted shim carries —
# PR_SET_NO_NEW_PRIVS, seccomp(2) with the prctl(PR_SET_SECCOMP)
# fallback, then execvp), compiles it with cc, and spawns
# [launcher, <filter hex>, <status file>, cmd...]. The launcher forks,
# arms the CHILD, execs the artifact, waits, and writes the exact wait
# status ("exit N" / "signal N") to the status file so the parent can
# tell an artifact's own exit 159 from a SIGSYS kill (observed 159 =
# 128 + 31) — the distinction the .py's waitpid gave it and a bare exit
# code cannot. No cc on PATH is an honest refusal (exit 2, named
# message), never a panic and never a silently unconfined run.
#
# `emit` stays pure emission (the self-arming C shim; no cc, no kernel).
# `profile` / `release` / `verify-release` / `selftest` never arm.
#
# The derivation rides the REAL front-end (tools/hlfront.hls, linked —
# hl_load_crate + hl_check, one grammar, one checker, zero drift), in a
# probe child that re-execs this binary (--probe-parse / --probe-check,
# the hls-audit / hls-sign pattern) so a tree that does not check is a
# refusal, never a crash. The package gate, the TOML subset, the
# lockfile map and the two ledgers (the transparency log and Stage
# 112's .hls-audit.log, kind op, ops sandbox.run / sandbox.release —
# refusals recorded exactly like successes) are the family's folds of
# the same hpkg parts the other native tools carry.
#
# Exit contract (the .py's, kept): 0 success (for `run`: the artifact's
# own code passes through); 1 policy/audit/release failures and selftest
# failures; 2 usage errors (and, new in the native era, a missing C
# compiler for `run`). The run contract extends the shell's: 125 the
# sandbox could not be armed, 126 cannot execute, 127 not found — and
# SIGSYS (observed as 159 = 128+31) is the kill-mode denial.
# ============================================================================

import "./hlfront.hls"
import "std.str"
import "std.result"
import "std.sha256"
import "std.json"
import "std.hex"
import "std.bits"

# ============================================================================
# Part 0 — the small shared helpers (hls-audit / hls-sign's own folds:
# paths, sorting, spawn capture, clipping, Python repr).
# ============================================================================

struct Fail {
    msg: str
}

fn fail(msg: str) -> Fail {
    return Fail {
        msg: msg
    }
}

fn path_is_abs(p: str) -> bool {
    return p.len() > 0 && p.byte_at(0) == 47
}

fn path_join2(base: str, rel: str) -> str {
    if rel.len() == 0 {
        if base.len() == 0 {
            return ""
        }
        return base
    }
    if path_is_abs(rel) {
        return rel
    }
    if base.len() == 0 {
        return rel
    }
    if base.byte_at(base.len() - 1) == 47 {
        return base + rel
    }
    return base + "/" + rel
}

fn path_dirname(p: str) -> str {
    let n: int = p.len()
    if n == 0 {
        return "."
    }
    let mut k: int = n - 1
    while k > 0 && p.byte_at(k) == 47 {
        k = k - 1
    }
    while k >= 0 {
        if p.byte_at(k) == 47 {
            if k == 0 {
                return "/"
            }
            return p.slice(0, k)
        }
        k = k - 1
    }
    return "."
}

fn path_basename(p: str) -> str {
    let n: int = p.len()
    if n == 0 {
        return ""
    }
    let mut k: int = n - 1
    while k > 0 && p.byte_at(k) == 47 {
        k = k - 1
    }
    let mut j: int = k
    while j >= 0 {
        if p.byte_at(j) == 47 {
            return p.slice(j + 1, k + 1)
        }
        j = j - 1
    }
    return p.slice(0, k + 1)
}

fn split_components(p: str) -> list[str] {
    let out: list[str] = []
    let n: int = p.len()
    let mut i: int = 0
    while i < n {
        let mut j: int = i
        while j < n && p.byte_at(j) != 47 {
            j = j + 1
        }
        out.push(p.slice(i, j))
        i = j + 1
    }
    return out
}

fn norm_path(p: str) -> str {
    if p == "" {
        return "."
    }
    let abs: bool = path_is_abs(p)
    let comps: list[str] = split_components(p)
    let out: list[str] = []
    let mut i: int = 0
    while i < comps.len() {
        let c: str = comps.get(i)
        if c == "" || c == "." {
            i = i + 1
            continue
        }
        if c == ".." {
            if out.len() > 0 && out.get(out.len() - 1) != ".." {
                out.pop()
            } else if !abs {
                out.push("..")
            }
            i = i + 1
            continue
        }
        out.push(c)
        i = i + 1
    }
    if out.len() == 0 {
        if abs {
            return "/"
        }
        return "."
    }
    let mut r: str = ""
    if abs {
        r = "/"
    }
    let mut j: int = 0
    while j < out.len() {
        r = r + out.get(j)
        if j + 1 < out.len() {
            r = r + "/"
        }
        j = j + 1
    }
    return r
}

# realpath_lex(p) — os.path.abspath + the LEXICAL normpath (the native
# family's law: no symlink knowledge).
fn realpath_lex(p: str) -> str uses Proc {
    let mut raw: str = p
    if !path_is_abs(raw) {
        raw = cwd_get() + "/" + raw
    }
    return norm_path(raw)
}

fn which_hit(name: str) -> str uses Fs, Proc {
    if name == "" || name.contains("/") {
        return ""
    }
    let penv: str = env_get("PATH")
    if penv == "" {
        return ""
    }
    let dirs: list[str] = penv.split(":")
    let mut i: int = 0
    while i < dirs.len() {
        let mut cand: str = dirs.get(i)
        if cand == "" {
            cand = "."
        }
        let full: str = cand + "/" + name
        if file_exists(full) {
            return full
        }
        i = i + 1
    }
    return ""
}

fn is_repo_root(p: str) -> bool uses Fs {
    return file_exists(p + "/std/str.hls")
    && file_exists(p + "/core/option.hls")
    && file_exists(p + "/SPEC.md")
}

fn repo_root() -> str uses Fs, Proc, Args {
    let argv: list[str] = args()
    if argv.len() > 0 && argv.get(0) != "" {
        let binp: str = realpath_lex(argv.get(0))
        let root: str = path_dirname(path_dirname(binp))
        if is_repo_root(root) {
            return root
        }
        let hit: str = which_hit(argv.get(0))
        if hit != "" {
            let root2: str = path_dirname(path_dirname(realpath_lex(hit)))
            if is_repo_root(root2) {
                return root2
            }
        }
    }
    let mut d: str = realpath_lex("")
    let mut guard: int = 0
    while guard < 128 {
        if is_repo_root(d) {
            return d
        }
        let parent: str = path_dirname(d)
        if parent == d || parent == "." {
            return realpath_lex("")
        }
        d = parent
        guard = guard + 1
    }
    return realpath_lex("")
}

# sort_strs / merge_strs — Python's sorted() over strings (bytewise <).
fn merge_strs(a: list[str], b: list[str]) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    let mut j: int = 0
    while i < a.len() && j < b.len() {
        if !(b.get(j) < a.get(i)) {
            out.push(a.get(i))
            i = i + 1
        } else {
            out.push(b.get(j))
            j = j + 1
        }
    }
    while i < a.len() {
        out.push(a.get(i))
        i = i + 1
    }
    while j < b.len() {
        out.push(b.get(j))
        j = j + 1
    }
    return out
}

fn sort_strs(xs: list[str]) -> list[str] {
    if xs.len() <= 1 {
        let one: list[str] = []
        let mut i0: int = 0
        while i0 < xs.len() {
            one.push(xs.get(i0))
            i0 = i0 + 1
        }
        return one
    }
    let mid: int = xs.len() / 2
    let left_in: list[str] = []
    let right_in: list[str] = []
    let mut i: int = 0
    while i < mid {
        left_in.push(xs.get(i))
        i = i + 1
    }
    while i < xs.len() {
        right_in.push(xs.get(i))
        i = i + 1
    }
    return merge_strs(sort_strs(left_in), sort_strs(right_in))
}

fn is_file_h(p: str) -> bool uses Fs {
    return file_exists(p) && !fs_is_dir(p)
}

fn is_dir_h(p: str) -> bool uses Fs {
    return fs_is_dir(p)
}

fn read_or(p: str, default_value: str) -> str uses Fs {
    if file_exists(p) {
        return read_file(p)
    }
    return default_value
}

fn sg_has(xs: list[str], x: str) -> bool {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) == x {
            return true
        }
        i = i + 1
    }
    return false
}

# sg_push_unique(xs, x) — set-style insert.
fn sg_push_unique(xs: list[str], x: str) -> void {
    if !sg_has(xs, x) {
        xs.push(x)
    }
}

# sg_sorted_unique(xs) — sorted() of a set, Python semantics.
fn sg_sorted_unique(xs: list[str]) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    while i < xs.len() {
        sg_push_unique(out, xs.get(i))
        i = i + 1
    }
    return sort_strs(out)
}

fn join_strs(parts: list[str], sep: str) -> str {
    return str_join(parts, sep)
}

fn sg_index_of(xs: list[str], x: str) -> int {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) == x {
            return i
        }
        i = i + 1
    }
    return -1
}

struct RunCap {
    code: int,
    out: str,
    err: str
}

# spawn_cap(program, argv) — run a child, drain both pipes, wait.
fn spawn_cap(program: str, argv: list[str]) -> RunCap uses Proc {
    let r: RunCap = RunCap {
        code: -1, out: "", err: ""
    }
    let pid: int = proc_spawn(program, argv, 2, 1, 1)
    if pid < 1 {
        return r
    }
    let mut out: str = ""
    let mut chunk: str = proc_child_read(pid, 1, 65536)
    while chunk != "" {
        out = out + chunk
        chunk = proc_child_read(pid, 1, 65536)
    }
    let mut err: str = ""
    let mut chunk2: str = proc_child_read(pid, 2, 65536)
    while chunk2 != "" {
        err = err + chunk2
        chunk2 = proc_child_read(pid, 2, 65536)
    }
    r.code = proc_wait(pid)
    proc_child_close(pid, 1)
    proc_child_close(pid, 2)
    r.out = out
    r.err = err
    return r
}

fn self_path() -> str uses Args {
    let argv: list[str] = args()
    if argv.len() > 0 {
        return argv.get(0)
    }
    return ""
}

fn find_from(s: str, needle: str, from: int) -> int {
    let n: int = s.len()
    let m: int = needle.len()
    if m == 0 {
        if from <= n {
            return from
        }
        return -1
    }
    let mut i: int = from
    if i < 0 {
        i = 0
    }
    while i + m <= n {
        let mut k: int = 0
        let mut same: bool = true
        while k < m {
            if s.byte_at(i + k) != needle.byte_at(k) {
                same = false
                k = m
            }
            k = k + 1
        }
        if same {
            return i
        }
        i = i + 1
    }
    return -1
}

fn hex_val_b(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return -1
}

fn is_digit_b(c: int) -> bool {
    return c >= 48 && c <= 57
}

fn is_alpha_b(c: int) -> bool {
    return(c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

# clip_str(s, n) — Python's safe byte slice s[:n] (used where the .py
# clipped ASCII-only text).
fn clip_str(s: str, n: int) -> str {
    if s.len() <= n {
        return s
    }
    return s.slice(0, n)
}

# clip_chars(s, n) — Python's CHARACTER slice s[:n]: a UTF-8 continuation
# byte (0x80..0xBF) never counts and never splits, so the em-dashes the
# family's refusal messages carry survive the clip exactly the way
# Python's str slicing kept them.
fn clip_chars(s: str, n: int) -> str {
    let mut count: int = 0
    let mut i: int = 0
    while i < s.len() {
        if bits_and(s.byte_at(i), 192) != 128 {
            count = count + 1
            if count > n {
                return s.slice(0, i)
            }
        }
        i = i + 1
    }
    return s
}

# py_repr_str(s) — Python's repr of a str (the [sandbox] error detail
# lines quote the found value the way %r did).
fn py_repr_str(s: str) -> str {
    let mut out: str = "'"
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c == 39 {
            out = out + "\\'"
        } else if c == 92 {
            out = out + "\\\\"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 9 {
            out = out + "\\t"
        } else if c == 13 {
            out = out + "\\r"
        } else if c < 32 || c >= 127 {
            let h: str = "0123456789abcdef"
            let b1: int = c / 16
            let b2: int = c - (c / 16) * 16
            out = out + "\\x" + h.slice(b1, b1 + 1) + h.slice(b2, b2 + 1)
        } else {
            out = out + s.slice(i, i + 1)
        }
        i = i + 1
    }
    return out + "'"
}

# ============================================================================
# Part 1 — the JSON writers over std.json's JsonValue (hls-tlog's folds):
# the compact canonical form the chains hash, the default-separator line
# the transparency ledger appends, and the indent-2 document the reports
# and the release statement print.
# ============================================================================

# sbx_utf8_at(s, i) — the codepoint at i (len 1..4); [-1, 1] on bad UTF-8.
fn sbx_utf8_at(s: str, i: int) -> list[int] {
    let n: int = s.len()
    let b0: int = s.byte_at(i)
    if b0 < 128 {
        return[b0, 1]
    }
    if b0 >= 192 && b0 < 224 && i + 1 < n {
        return[(b0 - 192) * 64 + (s.byte_at(i + 1) - 128), 2]
    }
    if b0 >= 224 && b0 < 240 && i + 2 < n {
        return[(b0 - 224) * 4096 + (s.byte_at(i + 1) - 128) * 64
        + (s.byte_at(i + 2) - 128), 3]
    }
    if b0 >= 240 && b0 < 248 && i + 3 < n {
        return[(b0 - 240) * 262144 + (s.byte_at(i + 1) - 128) * 4096
        + (s.byte_at(i + 2) - 128) * 64 + (s.byte_at(i + 3) - 128), 4]
    }
    return[-1, 1]
}

fn sbx_hex4(n: int) -> str {
    let digits: str = "0123456789abcdef"
    return digits.slice((n / 4096) % 16, (n / 4096) % 16 + 1)
    + digits.slice((n / 256) % 16, (n / 256) % 16 + 1)
    + digits.slice((n / 16) % 16, (n / 16) % 16 + 1)
    + digits.slice(n % 16, n % 16 + 1)
}

# sbx_json_escape(s) — json.dumps's ensure_ascii=True string body.
fn sbx_json_escape(s: str) -> str {
    let out: list[str] = []
    let n: int = s.len()
    let mut i: int = 0
    while i < n {
        let c: int = s.byte_at(i)
        if c == 34 {
            out.push("\\\"")
            i = i + 1
            continue
        }
        if c == 92 {
            out.push("\\\\")
            i = i + 1
            continue
        }
        if c == 8 {
            out.push("\\b")
            i = i + 1
            continue
        }
        if c == 9 {
            out.push("\\t")
            i = i + 1
            continue
        }
        if c == 10 {
            out.push("\\n")
            i = i + 1
            continue
        }
        if c == 12 {
            out.push("\\f")
            i = i + 1
            continue
        }
        if c == 13 {
            out.push("\\r")
            i = i + 1
            continue
        }
        if c < 32 {
            out.push("\\u" + sbx_hex4(c))
            i = i + 1
            continue
        }
        if c < 127 {
            out.push(s.slice(i, i + 1))
            i = i + 1
            continue
        }
        let cp: list[int] = sbx_utf8_at(s, i)
        if cp.get(0) < 0 {
            out.push(s.slice(i, i + 1))
            i = i + 1
            continue
        }
        if cp.get(0) < 65536 {
            out.push("\\u" + sbx_hex4(cp.get(0)))
        } else {
            let v: int = cp.get(0) - 65536
            let hi: int = 55296 + v / 1024
            let lo: int = 56320 + v % 1024
            out.push("\\u" + sbx_hex4(hi) + "\\u" + sbx_hex4(lo))
        }
        i = i + cp.get(1)
    }
    return str_join(out, "")
}

fn sbx_scalar_text(v: JsonValue) -> str {
    if v.kind == "null" {
        return "null"
    }
    if v.kind == "bool" {
        if v.bval {
            return "true"
        }
        return "false"
    }
    if v.kind == "int" {
        return v.ival.to_str()
    }
    if v.kind == "float" {
        return v.fval.to_str()
    }
    return "\"" + sbx_json_escape(v.sval) + "\""
}

# sbx_sorted_order(keys) — indices sorted by key (insertion sort; the key
# sets here are tiny).
fn sbx_sorted_order(keys: list[str]) -> list[int] {
    let order: list[int] = []
    let mut i: int = 0
    while i < keys.len() {
        order.push(i)
        i = i + 1
    }
    let mut a: int = 1
    while a < order.len() {
        let k: int = order.get(a)
        let kv: str = keys.get(k)
        let mut b: int = a - 1
        while b >= 0 && keys.get(order.get(b)) > kv {
            order.set(b + 1, order.get(b))
            b = b - 1
        }
        order.set(b + 1, k)
        a = a + 1
    }
    return order
}

# sbx_dump_at(v, indent, pretty) — the recursive serializer.
fn sbx_dump_at(v: JsonValue, indent: int, pretty: bool) -> str {
    if v.kind == "array" {
        if v.arr.len() == 0 {
            return "[]"
        }
        let mut pad: str = ""
        let mut k: int = 0
        while k < indent {
            pad = pad + "  "
            k = k + 1
        }
        let in_pad: str = pad + "  "
        if pretty {
            let mut out: str = "[\n"
            let mut i: int = 0
            while i < v.arr.len() {
                out = out + in_pad
                + sbx_dump_at(v.arr.get(i), indent + 1, true)
                if i + 1 < v.arr.len() {
                    out = out + ","
                }
                out = out + "\n"
                i = i + 1
            }
            return out + pad + "]"
        }
        let mut out2: str = "["
        let mut j: int = 0
        while j < v.arr.len() {
            out2 = out2 + sbx_dump_at(v.arr.get(j), indent, false)
            if j + 1 < v.arr.len() {
                out2 = out2 + ","
            }
            j = j + 1
        }
        return out2 + "]"
    }
    if v.kind == "object" {
        if v.obj_keys.len() == 0 {
            return "{}"
        }
        let order: list[int] = sbx_sorted_order(v.obj_keys)
        let mut pad2: str = ""
        let mut k2: int = 0
        while k2 < indent {
            pad2 = pad2 + "  "
            k2 = k2 + 1
        }
        let in_pad2: str = pad2 + "  "
        if pretty {
            let mut out3: str = "{\n"
            let mut j2: int = 0
            while j2 < order.len() {
                let idx: int = order.get(j2)
                out3 = out3 + in_pad2 + "\""
                + sbx_json_escape(v.obj_keys.get(idx)) + "\": "
                + sbx_dump_at(v.obj_vals.get(idx), indent + 1, true)
                if j2 + 1 < order.len() {
                    out3 = out3 + ","
                }
                out3 = out3 + "\n"
                j2 = j2 + 1
            }
            return out3 + pad2 + "}"
        }
        let mut out4: str = "{"
        let mut j3: int = 0
        while j3 < order.len() {
            let idx2: int = order.get(j3)
            out4 = out4 + "\"" + sbx_json_escape(v.obj_keys.get(idx2))
            + "\":" + sbx_dump_at(v.obj_vals.get(idx2), indent, false)
            if j3 + 1 < order.len() {
                out4 = out4 + ","
            }
            j3 = j3 + 1
        }
        return out4 + "}"
    }
    return sbx_scalar_text(v)
}

# sbx_json_dump(v) — json.dumps(v, indent=2, sort_keys=True).
fn sbx_json_dump(v: JsonValue) -> str {
    return sbx_dump_at(v, 0, true)
}

# sbx_json_canon(v) — json.dumps(v, sort_keys=True, separators=(",", ":"))
# — the bytes the chain hashes and the bytes the audit log appends.
fn sbx_json_canon(v: JsonValue) -> str {
    return sbx_dump_at(v, 0, false)
}

# sbx_json_line(v) — json.dumps(v, sort_keys=True) with the default
# ", " / ": " separators — the appended transparency-log line.
fn sbx_json_line(v: JsonValue) -> str {
    if v.kind == "object" && v.obj_keys.len() > 0 {
        let order: list[int] = sbx_sorted_order(v.obj_keys)
        let mut out: str = "{"
        let mut j: int = 0
        while j < order.len() {
            let idx: int = order.get(j)
            out = out + "\"" + sbx_json_escape(v.obj_keys.get(idx))
            + "\": " + sbx_json_line(v.obj_vals.get(idx))
            if j + 1 < order.len() {
                out = out + ", "
            }
            j = j + 1
        }
        return out + "}"
    }
    if v.kind == "array" && v.arr.len() > 0 {
        let mut out2: str = "["
        let mut k: int = 0
        while k < v.arr.len() {
            out2 = out2 + sbx_json_line(v.arr.get(k))
            if k + 1 < v.arr.len() {
                out2 = out2 + ", "
            }
            k = k + 1
        }
        return out2 + "]"
    }
    if v.kind == "array" {
        return "[]"
    }
    if v.kind == "object" {
        return "{}"
    }
    return sbx_scalar_text(v)
}

# sbx_jstrs(v) — a JSON array of strings as a list.
fn sbx_jstrs(v: JsonValue) -> list[str] {
    let out: list[str] = []
    if json_is_array(v) {
        let mut i: int = 0
        while i < v.arr.len() {
            out.push(json_str_value(v.arr.get(i)))
            i = i + 1
        }
    }
    return out
}

# sbx_obj_set(obj, k, v) — one key/value pair (append; the dumpers sort).
fn sbx_obj_set(obj: JsonValue, k: str, v: JsonValue) -> void {
    obj.obj_keys.push(k)
    obj.obj_vals.push(v)
}

# sbx_json_list_str(xs) — the list as a JSON array of strings.
fn sbx_json_list_str(xs: list[str]) -> JsonValue {
    let arr: JsonValue = json_array([])
    let mut i: int = 0
    while i < xs.len() {
        arr.arr.push(json_str(xs.get(i)))
        i = i + 1
    }
    return arr
}

# sbx_jstr_or(v, key, d) — the string value or the default.
fn sbx_jstr_or(v: JsonValue, key: str, d: str) -> str {
    let x: JsonValue = json_object_get(v, key)
    if json_is_str(x) {
        return json_str_value(x)
    }
    return d
}

# ============================================================================
# Part 2 — the two ledgers: Stage 112's audit log (.hls-audit.log, the
# privilege inventory's sandbox.run / sandbox.release entries — refusals
# recorded exactly like successes) and the transparency ledger
# (.hls-pkg-transparency.log, the chained record every claim appends to).
# Both are hls-sign's folds of the family's one chain arithmetic.
# ============================================================================

fn audit_tool_version() -> str {
    return "0.131.0-alpha"
}

fn audit_log_path() -> str uses Fs, Proc, Args {
    let over: str = env_get("HLS_AUDIT_LOG")
    if over != "" || env_has("HLS_AUDIT_LOG") {
        return over
    }
    return repo_root() + "/.hls-audit.log"
}

fn audit_strict() -> bool uses Proc {
    return env_has("HLS_AUDIT_STRICT")
}

# audit_actor() — "user@host" (HLS_AUDIT_ACTOR overrides; the OS says the
# rest — whoami through a child, the hostname builtin).
fn audit_actor() -> str uses Proc {
    let over: str = env_get("HLS_AUDIT_ACTOR")
    if over != "" || env_has("HLS_AUDIT_ACTOR") {
        return over
    }
    let mut user: str = env_get("USER")
    if user == "" {
        let r: RunCap = spawn_cap("whoami", [])
        if r.code == 0 {
            user = r.out.trim()
        }
    }
    if user == "" {
        user = "<unknown-user>"
    }
    let mut host: str = sys_hostname()
    if host == "" {
        host = "<unknown-host>"
    }
    return user + "@" + host
}

# tlog_count_lines(text) — the line count (Python's iteration count).
fn tlog_count_lines(text: str) -> int {
    if text == "" {
        return 0
    }
    let parts: list[str] = text.split("\n")
    let mut n: int = parts.len()
    if parts.get(parts.len() - 1) == "" {
        n = n - 1
    }
    if n < 0 {
        n = 0
    }
    return n
}

# tlog_head_hash(text) — the last non-blank line's chain_hash (genesis
# "0"*64 when empty / corrupt).
fn tlog_head_hash(text: str) -> str {
    let prev: str = str_repeat("0", 64)
    if text == "" {
        return prev
    }
    let lines: list[str] = text.split("\n")
    let mut last: str = ""
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).trim() != "" {
            last = lines.get(i)
        }
        i = i + 1
    }
    if last == "" {
        return prev
    }
    let pr: Result[JsonValue, str] = json_parse_result(last)
    if result_is_ok(pr) {
        let rec: JsonValue = result_unwrap(pr)
        let ch: JsonValue = json_object_get(rec, "chain_hash")
        if json_is_str(ch) {
            return json_str_value(ch)
        }
    }
    return prev
}

# chain_of(prev, record) — sha256(prev + canonical-json(record minus
# chain_hash)) — the family's one definition (hls-tlog's fold).
fn chain_of(prev: str, record: JsonValue) -> str {
    let body: JsonValue = json_object(record.obj_keys, record.obj_vals)
    sbx_obj_del(body, "chain_hash")
    return sha256_hex(prev + sbx_json_canon(body))
}

# sbx_obj_del(obj, key) — remove one key (the chain hash never hashes
# itself).
fn sbx_obj_del(obj: JsonValue, key: str) -> void {
    let mut i: int = 0
    while i < obj.obj_keys.len() {
        if obj.obj_keys.get(i) == key {
            let mut j: int = i
            while j + 1 < obj.obj_keys.len() {
                obj.obj_keys.set(j, obj.obj_keys.get(j + 1))
                obj.obj_vals.set(j, obj.obj_vals.get(j + 1))
                j = j + 1
            }
            obj.obj_keys.pop()
            obj.obj_vals.pop()
            return
        }
        i = i + 1
    }
}

# audit_record(op, outcome, subject, detail) — hal_ops.record: the
# hash-chained entry, fail-open unless HLS_AUDIT_STRICT. Returns Err only
# in strict mode on a failed write.
fn audit_record(op: str, outcome: str, subject: str, detail: JsonValue,
has_subject: bool, has_detail: bool) -> Result[bool, str]
uses Fs, Proc, Clock, Args, IO {
    let entry: JsonValue = json_object([], [])
    sbx_obj_set(entry, "kind", json_str("op"))
    sbx_obj_set(entry, "op", json_str(op))
    sbx_obj_set(entry, "actor", json_str(audit_actor()))
    sbx_obj_set(entry, "outcome", json_str(outcome))
    sbx_obj_set(entry, "tool", json_str("hls-sandbox"))
    sbx_obj_set(entry, "tool_version", json_str(audit_tool_version()))
    if has_subject {
        sbx_obj_set(entry, "subject", json_str(subject))
    }
    if has_detail {
        sbx_obj_set(entry, "detail", detail)
    }
    let path: str = audit_log_path()
    # the write contract: a missing parent directory is the failed write
    let parent: str = path_dirname(path)
    if parent != "" && !is_dir_h(parent) {
        if audit_strict() {
            return Result.Err("the audit entry for " + op
            + " was not written: no such directory: " + parent)
        }
        eprint("hls-auditlog: warning: the audit entry for " + op
        + " was not written (no such directory: " + parent + ")\n")
        return Result.Ok(false)
    }
    let lock_path: str = path + ".lock"
    if !file_exists(lock_path) {
        write_file(lock_path, "")
    }
    let text: str = read_or(path, "")
    let prev_hash: str = tlog_head_hash(text)
    let seq: int = tlog_count_lines(text) + 1
    sbx_obj_set(entry, "seq", json_int(seq))
    sbx_obj_set(entry, "timestamp", json_int(sbx_floor_div(
    system_time_now_ms(), 1000)))
    sbx_obj_set(entry, "prev_hash", json_str(prev_hash))
    sbx_obj_set(entry, "chain_hash", json_str(chain_of(prev_hash, entry)))
    write_file(path, text + sbx_json_canon(entry) + "\n")
    return Result.Ok(true)
}

# audit_record_refused(op, reason) — the refusal shorthand: the same
# hash-chained entry, outcome "refused", the gate's reason in the detail.
fn audit_record_refused(op: str, reason: str) -> Result[bool, str]
uses Fs, Proc, Clock, Args, IO {
    let d: JsonValue = json_object([], [])
    sbx_obj_set(d, "reason", json_str(clip_chars(reason, 400)))
    return audit_record(op, "refused", "", d, false, true)
}

fn sbx_floor_div(a: int, b: int) -> int {
    let q: int = a / b
    if(a % b != 0) && ((a < 0) != (b < 0)) {
        return q - 1
    }
    return q
}

# -- the transparency ledger -------------------------------------------------

fn transparency_log_path() -> str uses Fs, Proc, Args {
    let over: str = env_get("HLS_PKG_TRANSPARENCY_LOG")
    if over != "" || env_has("HLS_PKG_TRANSPARENCY_LOG") {
        return over
    }
    return repo_root() + "/.hls-pkg-transparency.log"
}

struct TlogRec {
    seq: int,
    chain_hash: str
}

# tlog_append(record) — build the chained record, append the line (the
# chain over the canonical bytes, the line in the default-separator
# shape; the .py held an flock on the sidecar — the native family
# creates it, single-writer runs).
fn tlog_append(record: JsonValue) -> Result[TlogRec, str]
uses Fs, Proc, Clock, Args {
    let log_path: str = transparency_log_path()
    let lock_path: str = log_path + ".lock"
    if !file_exists(lock_path) {
        write_file(lock_path, "")
    }
    let text: str = read_or(log_path, "")
    let prev_hash: str = tlog_head_hash(text)
    let seq: int = tlog_count_lines(text) + 1
    let rec: JsonValue = json_object(record.obj_keys, record.obj_vals)
    sbx_obj_set(rec, "seq", json_int(seq))
    sbx_obj_set(rec, "timestamp", json_int(sbx_floor_div(
    system_time_now_ms(), 1000)))
    sbx_obj_set(rec, "prev_hash", json_str(prev_hash))
    let chain: str = chain_of(prev_hash, rec)
    sbx_obj_set(rec, "chain_hash", json_str(chain))
    write_file(log_path, text + sbx_json_line(rec) + "\n")
    return Result.Ok(TlogRec {
        seq: seq, chain_hash: chain
    })
}

# tlog_lookup(name, version) — the latest log entry for name (optionally
# version), walking from the end; null when absent.
fn tlog_lookup(name: str, version: str) -> JsonValue uses Fs, Proc, Args {
    let path: str = transparency_log_path()
    if !file_exists(path) {
        return json_null()
    }
    let lines: list[str] = read_file(path).split("\n")
    let mut i: int = lines.len() - 1
    while i >= 0 {
        let ln: str = lines.get(i).trim()
        if ln != "" {
            let pr: Result[JsonValue, str] = json_parse_result(ln)
            if result_is_ok(pr) {
                let rec: JsonValue = result_unwrap(pr)
                let nm: JsonValue = json_object_get(rec, "name")
                if json_is_str(nm) && json_str_value(nm) == name {
                    if version == "" {
                        return rec
                    }
                    let vv: JsonValue = json_object_get(rec, "version")
                    if json_is_str(vv) && json_str_value(vv) == version {
                        return rec
                    }
                }
            }
        }
        i = i - 1
    }
    return json_null()
}

# ============================================================================
# Part 3 — the seccomp-bpf filter assembler (sbx_bpf's fold): one
# definition of the bytes the kernel is told. A profile compiles to a
# classic-BPF program over struct seccomp_data:
#
#     nr offset 0, arch offset 4, args[0..5] offset 16 (low 32 at +0)
#
# Every jump is forward, every label is resolved before the program is
# handed to anyone, and an out-of-range jump (jt/jf are 8-bit RELATIVE)
# is refused at assembly time — never truncated, never wrapped.
# ============================================================================

fn BPF_LD_W_ABS() -> int {
    return 32 # 0x20 — A = seccomp_data[k]
}

fn BPF_JEQ_K() -> int {
    return 21 # 0x15 — if (A == k) jt else jf
}

fn BPF_JGE_K() -> int {
    return 53 # 0x35 — if (A >= k) jt else jf
}

fn BPF_JSET_K() -> int {
    return 69 # 0x45 — if (A & k) jt else jf
}

fn BPF_RET_K() -> int {
    return 6 # 0x06 — return k
}

fn OFF_NR() -> int {
    return 0
}

fn OFF_ARCH() -> int {
    return 4
}

# off_arg_low(i) — the offset of the LOW 32 bits of args[i]; flags, modes
# and fd arguments live in the low word on every ABI the toolchain ships.
fn off_arg_low(arg_index: int) -> Result[int, str] {
    if arg_index < 0 || arg_index > 5 {
        return Result.Err("arg index out of range: " + arg_index.to_str())
    }
    return Result.Ok(16 + 8 * arg_index)
}

fn SECCOMP_RET_KILL_PROCESS() -> int {
    return 2147483648
}

fn SECCOMP_RET_KILL_THREAD() -> int {
    return 0
}

fn SECCOMP_RET_TRAP() -> int {
    return 196608
}

fn SECCOMP_RET_ERRNO() -> int {
    return 327680
}

fn SECCOMP_RET_LOG() -> int {
    return 2147450880
}

fn SECCOMP_RET_ALLOW() -> int {
    return 2147418112
}

fn EPERM_NR() -> int {
    return 1
}

# ret_errno(err) — SECCOMP_RET_ERRNO | errno: the denied syscall returns
# -1 and errno is set, exactly as if the kernel itself had refused.
fn ret_errno(err: int) -> Result[int, str] {
    if err <= 0 || err > 65535 {
        return Result.Err("errno out of range: " + err.to_str())
    }
    return Result.Ok(bits_or(SECCOMP_RET_ERRNO(), err))
}

fn AUDIT_ARCH_X86_64() -> int {
    return 3221225534 # 0xC000003E — EM_X86_64 | 0xC0000000
}

fn AUDIT_ARCH_AARCH64() -> int {
    return 3221225655 # 0xC00000B7 — EM_AARCH64 | 0xC0000000
}

fn AUDIT_ARCH_RISCV64() -> int {
    return 3221225715 # 0xC00000F3 — EM_RISCV | 0xC0000000
}

fn BPF_MAXINSNS() -> int {
    return 4096
}

# -- one instruction -----------------------------------------------------------

struct Instr {
    code: int,
    jt: int,
    jf: int,
    k: int
}

# mk_instr(code, jt, jf, k) — the u8/u32 range guards the .py carried on
# every struct sock_filter it built.
fn mk_instr(code: int, jt: int, jf: int, k: int) -> Result[Instr, str] {
    if jt < 0 || jt > 255 || jf < 0 || jf > 255 {
        return Result.Err("jt/jf out of u8 range: " + jt.to_str() + " "
        + jf.to_str())
    }
    if k < 0 || k > 4294967295 {
        return Result.Err("k out of u32 range: " + k.to_str())
    }
    return Result.Ok(Instr {
        code: code, jt: jt, jf: jf, k: k
    })
}

# instr_words_hex(ins) — the little-endian 8-byte encoding as hex, exactly
# the bytes the kernel reads out of the sock_fprog array (and the form
# the launcher's argument travels in).
fn instr_words_hex(ins: Instr) -> str {
    let bs: list[str] = []
    bs.push(chr(bits_and(ins.code, 255)))
    bs.push(chr(bits_and(bits_shr(ins.code, 8), 255)))
    bs.push(chr(ins.jt))
    bs.push(chr(ins.jf))
    bs.push(chr(bits_and(ins.k, 255)))
    bs.push(chr(bits_and(bits_shr(ins.k, 8), 255)))
    bs.push(chr(bits_and(bits_shr(ins.k, 16), 255)))
    bs.push(chr(bits_and(bits_shr(ins.k, 24), 255)))
    return hex_encode(str_join(bs, ""))
}

# -- the label assembler -------------------------------------------------------

struct Asm {
    instrs: list[Instr],
    label_names: list[str],
    label_pos: list[int],
    fix_idx: list[int],
    fix_is_jt: list[bool],
    fix_label: list[str]
}

fn asm_new() -> Asm {
    return Asm {
        instrs: [], label_names: [], label_pos: [],
        fix_idx: [], fix_is_jt: [], fix_label: []
    }
}

# asm_label(a, name) — bind a label HERE. A label emitted twice is an
# error, not a silent rebind (checked at finish).
fn asm_label(a: Asm, name: str) -> void {
    a.label_names.push(name)
    a.label_pos.push(a.instrs.len())
}

fn asm_load(a: Asm, offset: int) -> Result[int, str] {
    let ins: Result[Instr, str] = mk_instr(BPF_LD_W_ABS(), 0, 0, offset)
    if result_is_err(ins) {
        return Result.Err(result_err_or(ins, ""))
    }
    a.instrs.push(result_unwrap(ins))
    return Result.Ok(a.instrs.len() - 1)
}

# asm_jeq(a, k, label) — jump-when-equal to a FORWARD label.
fn asm_jeq(a: Asm, k: int, label: str) -> Result[int, str] {
    let mk: Result[Instr, str] = mk_instr(BPF_JEQ_K(), 0, 0, k)
    if result_is_err(mk) {
        return Result.Err(result_err_or(mk, ""))
    }
    let idx: int = a.instrs.len()
    a.instrs.push(result_unwrap(mk))
    a.fix_idx.push(idx)
    a.fix_is_jt.push(true)
    a.fix_label.push(label)
    return Result.Ok(idx)
}

# asm_jset(a, k, label) — jump-when-any-bit to a FORWARD label.
fn asm_jset(a: Asm, k: int, label: str) -> Result[int, str] {
    let mk: Result[Instr, str] = mk_instr(BPF_JSET_K(), 0, 0, k)
    if result_is_err(mk) {
        return Result.Err(result_err_or(mk, ""))
    }
    let idx: int = a.instrs.len()
    a.instrs.push(result_unwrap(mk))
    a.fix_idx.push(idx)
    a.fix_is_jt.push(true)
    a.fix_label.push(label)
    return Result.Ok(idx)
}

fn asm_ret(a: Asm, k: int) -> Result[int, str] {
    let mk: Result[Instr, str] = mk_instr(BPF_RET_K(), 0, 0, k)
    if result_is_err(mk) {
        return Result.Err(result_err_or(mk, ""))
    }
    a.instrs.push(result_unwrap(mk))
    return Result.Ok(a.instrs.len() - 1)
}

# asm_label_pos(a, name) — the bound position, or -1.
fn asm_label_pos(a: Asm, name: str) -> int {
    let mut i: int = 0
    while i < a.label_names.len() {
        if a.label_names.get(i) == name {
            return a.label_pos.get(i)
        }
        i = i + 1
    }
    return -1
}

# asm_finish(a) — resolve labels into relative jt/jf offsets, then
# validate every jump: in range, forward, and inside the program.
fn asm_finish(a: Asm) -> Result[Program, str] {
    # a label emitted twice is an error, not a silent rebind
    let mut li: int = 0
    while li < a.label_names.len() {
        let mut lj: int = li + 1
        while lj < a.label_names.len() {
            if a.label_names.get(li) == a.label_names.get(lj) {
                return Result.Err("label emitted twice: "
                + a.label_names.get(li))
            }
            lj = lj + 1
        }
        li = li + 1
    }
    let mut fi: int = 0
    while fi < a.fix_idx.len() {
        let idx: int = a.fix_idx.get(fi)
        let label: str = a.fix_label.get(fi)
        let target: int = asm_label_pos(a, label)
        if target < 0 {
            return Result.Err("jump to a label that was never emitted: "
            + label)
        }
        let rel: int = target - idx - 1
        if rel < 0 {
            return Result.Err("backward jump to " + label
            + " — classic BPF has no loops; refuse")
        }
        if rel > 255 {
            return Result.Err("jump to " + label + " is "
            + rel.to_str() + " instructions away — the jt/jf fields are "
            + "8-bit; the profile is too large to assemble as one "
            + "dispatch program (split it or trim the allowlist)")
        }
        let old: Instr = a.instrs.get(idx)
        let rebuilt: Result[Instr, str] = mk_instr(old.code,
        old.jt + rel, old.jf, old.k)
        if result_is_err(rebuilt) {
            return Result.Err(result_err_or(rebuilt, ""))
        }
        a.instrs.set(idx, result_unwrap(rebuilt))
        fi = fi + 1
    }
    if a.instrs.len() > BPF_MAXINSNS() {
        return Result.Err("program exceeds BPF_MAXINSNS ("
        + BPF_MAXINSNS().to_str() + ")")
    }
    return Result.Ok(Program {
        instrs: a.instrs
    })
}

# -- the assembled program -----------------------------------------------------

struct Program {
    instrs: list[Instr]
}

fn prog_len(p: Program) -> int {
    return p.instrs.len()
}

# prog_bytes_hex(p) — the whole program as one hex string (16 hex chars
# per instruction), the form the launcher takes its filter in.
fn prog_bytes_hex(p: Program) -> str {
    let out: list[str] = []
    let mut i: int = 0
    while i < p.instrs.len() {
        out.push(instr_words_hex(p.instrs.get(i)))
        i = i + 1
    }
    return str_join(out, "")
}

# hex_of_int(x) — "%x" (lowercase, no padding).
fn hex_of_int(x: int) -> str {
    if x < 0 {
        return "-" + hex_of_int(-x)
    }
    if x < 16 {
        let digits: str = "0123456789abcdef"
        return digits.slice(x, x + 1)
    }
    return hex_of_int(x / 16) + hex_of_int(x % 16)
}

# hex2(x) — "%02x".
fn hex2(x: int) -> str {
    let s: str = hex_of_int(x)
    if s.len() >= 2 {
        return s
    }
    return "0" + s
}

# hex8(x) — "%08x".
fn hex8(x: int) -> str {
    let s: str = hex_of_int(x)
    let mut out: str = s
    while out.len() < 8 {
        out = "0" + out
    }
    return out
}

# prog_c_array(p) — the program as a C struct sock_filter array; the shim
# embeds this verbatim so a binary can arm itself at startup.
fn prog_c_array(p: Program) -> str {
    let lines: list[str] = []
    lines.push("static const struct sock_filter hl_sandbox_filter[] = {")
    let mut i: int = 0
    while i < p.instrs.len() {
        let ins: Instr = p.instrs.get(i)
        lines.push("    {0x" + hex2(ins.code) + ", " + ins.jt.to_str()
        + ", " + ins.jf.to_str() + ", 0x" + hex8(ins.k) + "},")
        i = i + 1
    }
    lines.push("};")
    return str_join(lines, "\n")
}

# -- the disassembler ----------------------------------------------------------

# sbx_mnemonic(code) — the mnemonic or "?0xNN".
fn sbx_mnemonic(code: int) -> str {
    if code == BPF_LD_W_ABS() {
        return "ld"
    }
    if code == BPF_JEQ_K() {
        return "jeq"
    }
    if code == BPF_JSET_K() {
        return "jset"
    }
    if code == BPF_JGE_K() {
        return "jge"
    }
    if code == BPF_RET_K() {
        return "ret"
    }
    return "?0x" + hex2(code)
}

# sbx_fmt_ret(k) — the return action's name.
fn sbx_fmt_ret(k: int) -> str {
    if k == SECCOMP_RET_ALLOW() {
        return "ALLOW"
    }
    if k == SECCOMP_RET_KILL_PROCESS() {
        return "KILL_PROCESS"
    }
    if k == SECCOMP_RET_KILL_THREAD() {
        return "KILL_THREAD"
    }
    if k == SECCOMP_RET_TRAP() {
        return "TRAP"
    }
    if k == SECCOMP_RET_LOG() {
        return "LOG"
    }
    if bits_and(k, SECCOMP_RET_ERRNO()) == SECCOMP_RET_ERRNO() {
        return "ERRNO(" + bits_and(k, 65535).to_str() + ")"
    }
    return "0x" + hex8(k)
}

# sbx_fmt_k(code, k) — the operand text.
fn sbx_fmt_k(code: int, k: int) -> str {
    if code == BPF_RET_K() {
        return sbx_fmt_ret(k)
    }
    if code == BPF_LD_W_ABS() {
        if k == OFF_NR() {
            return "nr"
        }
        if k == OFF_ARCH() {
            return "arch"
        }
        if k >= 16 && (k - 16) % 8 == 0 && (k - 16) / 8 <= 5 {
            return "arg" + ((k - 16) / 8).to_str()
        }
        return "[" + k.to_str() + "]"
    }
    return "0x" + hex_of_int(k)
}

# sbx_names_get(name_nrs, name_names, nr) — the syscall name for a
# dispatch number, "" when the listing was built without names.
fn sbx_names_get(name_nrs: list[int], name_names: list[str], nr: int) -> str {
    let mut i: int = 0
    while i < name_nrs.len() {
        if name_nrs.get(i) == nr {
            return name_names.get(i)
        }
        i = i + 1
    }
    return ""
}

# disassemble_names(prog, name_nrs, name_names) — render a Program back
# to text, one instruction per line, jump targets as absolute line
# numbers; the names annotate the dispatch so the listing reads as
# POLICY, not as numbers (profile --bpf is that listing).
fn disassemble_names(prog: Program, name_nrs: list[int],
name_names: list[str]) -> str {
    let lines: list[str] = []
    let n: int = prog_len(prog)
    let mut i: int = 0
    while i < n {
        let ins: Instr = prog.instrs.get(i)
        let m: str = sbx_mnemonic(ins.code)
        let mut k: str = sbx_fmt_k(ins.code, ins.k)
        if ins.code == BPF_JEQ_K()
        && sbx_names_get(name_nrs, name_names, ins.k) != "" {
            k = str_pad_right(ins.k.to_str(), 5, " ") + " "
            + sbx_names_get(name_nrs, name_names, ins.k)
        }
        if ins.code == BPF_JEQ_K() || ins.code == BPF_JSET_K() {
            let parts: list[str] = []
            if ins.jt != 0 {
                parts.push(str_pad_left((i + 1 + ins.jt).to_str(), 4, "0"))
            } else {
                if ins.code == BPF_JEQ_K() {
                    let note: str = sbx_names_get(name_nrs, name_names,
                    ins.k)
                    if note != "" {
                        parts.push("dispatch " + note)
                    } else {
                        parts.push("fall")
                    }
                } else {
                    parts.push("fall")
                }
            }
            if ins.jf != 0 {
                parts.push("else " + str_pad_left((i + 1 + ins.jf).to_str(),
                4, "0"))
            }
            lines.push(str_pad_left(i.to_str(), 4, " ") + ": "
            + str_pad_right(m, 6, " ") + " "
            + str_pad_right(k, 18, " ") + " " + join_strs(parts, ", "))
        } else {
            lines.push(str_pad_left(i.to_str(), 4, " ") + ": "
            + str_pad_right(m, 6, " ") + " " + k)
        }
        i = i + 1
    }
    return str_join(lines, "\n")
}

# disassemble(prog) — the bare listing (no dispatch names).
fn disassemble(prog: Program) -> str {
    return disassemble_names(prog, [], [])
}

# ============================================================================
# Part 4 — the policy (sbx_policy's fold): the syscall number tables, the
# baselines, the effect layers, the read/write census, the Profile and
# its rules / program / report, the [sandbox] manifest section, and the
# static-ELF probe.
# ============================================================================

# -- the one effect vocabulary (hls-audit's; one set, imported never
# copied — the native era takes it from the same checker table the
# audit reads).

fn all_effects() -> list[str] {
    return["Args", "Clock", "Conc", "Exit", "Fs", "IO", "Net", "Proc",
    "Rand"]
}

# -- the syscall number tables -------------------------------------------------
#
# name: (x86_64, aarch64, riscv64, absent-note or "") — a -1 entry means
# "does not exist on this ABI" and MUST carry the note that names its
# asm-generic replacement. The aarch64 and riscv64 columns share the
# asm-generic numbering — an ABI fact recorded as data: the selftest
# pins aarch64 == riscv64 for EVERY row.

struct SysRow {
    name: str,
    x86: int,
    arm: int,
    riscv: int,
    note: str
}

fn sys_row(name: str, x86: int, arm: int, riscv: int, note: str) -> SysRow {
    return SysRow {
        name: name, x86: x86, arm: arm, riscv: riscv, note: note
    }
}

fn syscall_rows() -> list[SysRow] {
    return[
    # -- process lifecycle (the undeniables) ------------------------------
    sys_row("exit", 60, 93, 93, ""),
    sys_row("exit_group", 231, 94, 94, ""),
    sys_row("brk", 12, 214, 214, ""),
    sys_row("execve", 59, 221, 221, ""),
    # -- memory ------------------------------------------------------------
    sys_row("mmap", 9, 222, 222, ""),
    sys_row("munmap", 11, 215, 215, ""),
    sys_row("mprotect", 10, 226, 226, ""),
    sys_row("mremap", 25, 216, 216, ""),
    sys_row("madvise", 28, 233, 233, ""),
    # -- descriptor I/O (already-open fds) ----------------------------------
    sys_row("read", 0, 63, 63, ""),
    sys_row("write", 1, 64, 64, ""),
    sys_row("readv", 19, 65, 65, ""),
    sys_row("writev", 20, 66, 66, ""),
    sys_row("ioctl", 16, 29, 29, ""),
    sys_row("pread64", 17, 67, 67, ""),
    sys_row("close", 3, 57, 57, ""),
    # -- the open family ----------------------------------------------------
    sys_row("open", 2, -1, -1,
    "x86_64 only; asm-generic opens through openat"),
    sys_row("openat", 257, 56, 56, ""),
    sys_row("stat", 4, -1, -1,
    "x86_64 only; asm-generic answers via newfstatat"),
    sys_row("fstat", 5, 80, 80, ""),
    sys_row("lseek", 8, 62, 62, ""),
    sys_row("newfstatat", 262, 79, 79, ""),
    sys_row("statx", 332, 291, 291, ""),
    sys_row("access", 21, -1, -1,
    "x86_64 only; asm-generic answers via faccessat"),
    sys_row("faccessat", 269, 48, 48, ""),
    sys_row("getdents64", 217, 61, 61, ""),
    sys_row("readlink", 89, -1, -1,
    "x86_64 only; asm-generic answers via readlinkat"),
    sys_row("readlinkat", 267, 78, 78, ""),
    # -- the write-side family (Fs(rw) only) --------------------------------
    sys_row("unlink", 87, -1, -1,
    "x86_64 only; asm-generic answers via unlinkat"),
    sys_row("unlinkat", 263, 35, 35, ""),
    sys_row("rename", 82, -1, -1,
    "x86_64 only; asm-generic answers via renameat"),
    sys_row("renameat", 264, 38, 38, ""),
    sys_row("renameat2", 316, 276, 276, ""),
    sys_row("mkdir", 83, -1, -1,
    "x86_64 only; asm-generic answers via mkdirat"),
    sys_row("mkdirat", 258, 34, 34, ""),
    sys_row("rmdir", 84, -1, -1,
    "x86_64 only; asm-generic answers via unlinkat"),
    sys_row("chmod", 90, -1, -1,
    "x86_64 only; asm-generic answers via fchmodat"),
    sys_row("fchmod", 91, 52, 52, ""),
    sys_row("fchmodat", 268, 53, 53, ""),
    # -- identity / platform -------------------------------------------------
    sys_row("uname", 63, 160, 160, ""),
    sys_row("arch_prctl", 158, -1, -1,
    "x86_64 only (TLS base); asm-generic uses nothing"),
    sys_row("set_tid_address", 218, 96, 96, ""),
    sys_row("set_robust_list", 273, 99, 99, ""),
    sys_row("rseq", 334, 293, 293, ""),
    sys_row("prlimit64", 302, 261, 261, ""),
    sys_row("getrandom", 318, 278, 278, ""),
    sys_row("futex", 202, 98, 98, ""),
    sys_row("sched_yield", 24, 124, 124, ""),
    sys_row("gettid", 186, 178, 178, ""),
    sys_row("tgkill", 234, 131, 131, ""),
    sys_row("getpid", 39, 172, 172, ""),
    sys_row("rt_sigaction", 13, 134, 134, ""),
    sys_row("rt_sigprocmask", 14, 135, 135, ""),
    # -- clocks ---------------------------------------------------------------
    sys_row("clock_gettime", 228, 113, 113, ""),
    sys_row("clock_getres", 229, 114, 114, ""),
    sys_row("clock_nanosleep", 230, 115, 115, ""),
    sys_row("nanosleep", 35, 101, 101, ""),
    sys_row("gettimeofday", 96, 169, 169, ""),
    # -- sockets ---------------------------------------------------------------
    sys_row("socket", 41, 198, 198, ""),
    sys_row("connect", 42, 203, 203, ""),
    sys_row("bind", 49, 200, 200, ""),
    sys_row("listen", 50, 201, 201, ""),
    sys_row("accept", 43, 202, 202, ""),
    sys_row("accept4", 288, 242, 242, ""),
    sys_row("shutdown", 48, 210, 210, ""),
    sys_row("sendto", 44, 206, 206, ""),
    sys_row("recvfrom", 45, 207, 207, ""),
    sys_row("sendmsg", 46, 211, 211, ""),
    sys_row("recvmsg", 47, 212, 212, ""),
    sys_row("getsockname", 51, 204, 204, ""),
    sys_row("getpeername", 52, 205, 205, ""),
    sys_row("setsockopt", 54, 208, 208, ""),
    sys_row("getsockopt", 55, 209, 209, ""),
    # -- process creation / control ---------------------------------------------
    sys_row("clone", 56, 220, 220, ""),
    sys_row("clone3", 435, 435, 435, ""),
    sys_row("fork", 57, -1, -1,
    "x86_64 only; asm-generic forks via clone"),
    sys_row("vfork", 58, -1, -1,
    "x86_64 only; asm-generic vforks via clone"),
    sys_row("wait4", 61, 260, 260, ""),
    sys_row("waitid", 247, 95, 95, ""),
    sys_row("pipe", 22, -1, -1,
    "x86_64 only; asm-generic answers via pipe2"),
    sys_row("pipe2", 293, 59, 59, ""),
    sys_row("dup", 32, 23, 23, ""),
    sys_row("dup2", 33, -1, -1,
    "x86_64 only; asm-generic answers via dup3"),
    sys_row("dup3", 292, 24, 24, ""),
    sys_row("kill", 62, 129, 129, ""),
    sys_row("getcwd", 79, 17, 17, ""),
    sys_row("chdir", 80, 49, 49, ""),
    sys_row("fchdir", 81, 50, 50, ""),
    sys_row("execveat", 322, 281, 281, ""),
    # -- the arm itself ---------------------------------------------------------
    # prctl and seccomp are how a filter gets installed — by the launcher
    # (before the filter exists) or by the shim's constructor (same).
    # Neither needs ALLOWING in any profile: the arm always precedes the
    # thing it arms. The numbers are recorded anyway — the table is the
    # toolchain's syscall encyclopedia for the three triples.
    sys_row("prctl", 157, 167, 167, ""),
    sys_row("seccomp", 317, 277, 277, "")
    ]
}

# syscall_names_sorted() — sorted(_SYSCALLS), the known-names list the
# refusals quote.
fn syscall_names_sorted() -> list[str] {
    let rows: list[SysRow] = syscall_rows()
    let names: list[str] = []
    let mut i: int = 0
    while i < rows.len() {
        names.push(rows.get(i).name)
        i = i + 1
    }
    return sort_strs(names)
}

# sys_row_of(name) — the row, or the unknown-syscall refusal.
fn sys_row_of(name: str) -> Result[SysRow, str] {
    let rows: list[SysRow] = syscall_rows()
    let mut i: int = 0
    while i < rows.len() {
        if rows.get(i).name == name {
            return Result.Ok(rows.get(i))
        }
        i = i + 1
    }
    return Result.Err("unknown syscall: " + name + " (known: "
    + join_strs(syscall_names_sorted(), ", ") + ")")
}

# nr_of(name, arch) — (nr, absent_note); nr is -1 when the syscall does
# not exist there, with the row's note naming what answers the same
# question instead.
struct NrAns {
    nr: int,
    note: str
}

fn arch_index(arch: str) -> Result[int, str] {
    if arch == "x86_64" {
        return Result.Ok(0)
    }
    if arch == "aarch64" {
        return Result.Ok(1)
    }
    if arch == "riscv64" {
        return Result.Ok(2)
    }
    return Result.Err("unknown arch: " + arch)
}

fn nr_of(name: str, arch: str) -> Result[NrAns, str] {
    let row: Result[SysRow, str] = sys_row_of(name)
    if result_is_err(row) {
        return Result.Err(result_err_or(row, ""))
    }
    let r: SysRow = result_unwrap(row)
    let ai: Result[int, str] = arch_index(arch)
    if result_is_err(ai) {
        return Result.Err(result_err_or(ai, ""))
    }
    let idx: int = result_unwrap(ai)
    let mut nr: int = r.x86
    if idx == 1 {
        nr = r.arm
    }
    if idx == 2 {
        nr = r.riscv
    }
    if nr == -1 && r.note == "" {
        return Result.Err("syscall " + name + " has no number on " + arch
        + " and no recorded reason — the table is incomplete")
    }
    return Result.Ok(NrAns {
        nr: nr, note: r.note
    })
}

# audit_arch_of(arch) — the AUDIT_ARCH_* guard constant.
fn audit_arch_of(arch: str) -> Result[int, str] {
    if arch == "x86_64" {
        return Result.Ok(AUDIT_ARCH_X86_64())
    }
    if arch == "aarch64" {
        return Result.Ok(AUDIT_ARCH_AARCH64())
    }
    if arch == "riscv64" {
        return Result.Ok(AUDIT_ARCH_RISCV64())
    }
    return Result.Err("unknown arch: " + arch)
}

# -- the write-intent mask and the flags-argument contract --------------------
#
# O_WRONLY | O_RDWR | O_CREAT | O_TRUNC | O_APPEND | O_TMPFILE — identical
# on x86_64 and asm-generic (one mask, three arches). The flags ARGUMENT
# POSITION differs per syscall and that fact is pinned here, per name:
# open(path, flags, ...) puts them in arg1, openat(dfd, path, flags, ...)
# in arg2 — masking the wrong slot would test a POINTER against the mask
# and deny every open.

fn OPEN_WRITE_MASK() -> int {
    return 4261443 # 0x410643
}

# open_flags_arg(name) — the flags-argument position for an open-family
# syscall.
fn open_flags_arg(name: str) -> Result[int, str] {
    if name == "open" {
        return Result.Ok(1)
    }
    if name == "openat" {
        return Result.Ok(2)
    }
    return Result.Err(name + " is not an open-family syscall with a "
    + "flags-argument contract")
}

# is_open_family(name) — the two masked opens.
fn is_open_family(name: str) -> bool {
    return name == "open" || name == "openat"
}

# -- baselines and layers ------------------------------------------------------

# What every artifact needs merely to BE a process: terminate, grow the
# heap, be exec'd by the launcher (the crossing the filter inherits),
# and run its own PROLOGUE — the static flavor of it.
fn baseline_minimal() -> list[str] {
    return["exit", "exit_group", "brk", "execve", "mmap", "munmap",
    "mprotect", "arch_prctl", "set_tid_address", "set_robust_list",
    "rseq", "prlimit64"]
}

# One layer entry: a syscall name, optionally the read-only-constrained
# form (the argument mask above).
struct LayerEnt {
    name: str,
    ro: bool
}

fn layer_ent(name: str, ro: bool) -> LayerEnt {
    return LayerEnt {
        name: name, ro: ro
    }
}

# layer_entries(eff) — the effect layers. Args / Exit are empty BY DESIGN
# (argv is process memory; exit_group is baseline and undeniable) — the
# layers exist so the report can say so instead of saying nothing.
fn layer_entries(eff: str) -> list[LayerEnt] {
    if eff == "IO" {
        return[layer_ent("read", false), layer_ent("write", false),
        layer_ent("writev", false), layer_ent("ioctl", false)]
    }
    if eff == "Fs" {
        # the read floor
        return[layer_ent("openat", true), layer_ent("close", false),
        layer_ent("stat", false), layer_ent("fstat", false),
        layer_ent("newfstatat", false), layer_ent("statx", false),
        layer_ent("access", false), layer_ent("faccessat", false),
        layer_ent("lseek", false), layer_ent("pread64", false),
        layer_ent("getdents64", false)]
    }
    if eff == "FsWrite" {
        # BOTH opens upgrade: which one glibc's fopen leans on is a
        # per-version detail, and an rw profile that breaks a legitimate
        # write because it upgraded only one of them is a bug, not a
        # policy.
        return[layer_ent("openat", false), layer_ent("open", false),
        layer_ent("unlink", false), layer_ent("unlinkat", false),
        layer_ent("rename", false), layer_ent("renameat", false),
        layer_ent("renameat2", false), layer_ent("mkdir", false),
        layer_ent("mkdirat", false), layer_ent("rmdir", false),
        layer_ent("chmod", false), layer_ent("fchmod", false),
        layer_ent("fchmodat", false)]
    }
    if eff == "Net" {
        # sockets AND the resolver's reads: glibc's getaddrinfo reads
        # /etc/resolv.conf and /etc/hosts and may demand-load NSS modules
        # — a Net-only program with no Fs effect can still resolve names.
        return[layer_ent("socket", false), layer_ent("connect", false),
        layer_ent("bind", false), layer_ent("listen", false),
        layer_ent("accept", false), layer_ent("accept4", false),
        layer_ent("shutdown", false), layer_ent("sendto", false),
        layer_ent("recvfrom", false), layer_ent("sendmsg", false),
        layer_ent("recvmsg", false), layer_ent("getsockname", false),
        layer_ent("getpeername", false), layer_ent("setsockopt", false),
        layer_ent("getsockopt", false), layer_ent("openat", true),
        layer_ent("close", false), layer_ent("read", false),
        layer_ent("stat", false), layer_ent("fstat", false),
        layer_ent("newfstatat", false), layer_ent("statx", false),
        layer_ent("access", false), layer_ent("faccessat", false),
        layer_ent("mmap", false), layer_ent("mprotect", false),
        layer_ent("munmap", false), layer_ent("madvise", false),
        layer_ent("readlink", false), layer_ent("readlinkat", false),
        layer_ent("futex", false)]
    }
    if eff == "Proc" {
        # spawning and process state: clone/execve/wait/pipe/dup, cwd,
        # identity. execve itself is baseline; the layer adds the
        # machinery AROUND it.
        return[layer_ent("clone", false), layer_ent("clone3", false),
        layer_ent("fork", false), layer_ent("vfork", false),
        layer_ent("execve", false), layer_ent("execveat", false),
        layer_ent("wait4", false), layer_ent("waitid", false),
        layer_ent("pipe", false), layer_ent("pipe2", false),
        layer_ent("dup", false), layer_ent("dup2", false),
        layer_ent("dup3", false), layer_ent("kill", false),
        layer_ent("getcwd", false), layer_ent("chdir", false),
        layer_ent("fchdir", false), layer_ent("getpid", false),
        layer_ent("uname", false), layer_ent("gettid", false),
        layer_ent("tgkill", false), layer_ent("rt_sigaction", false),
        layer_ent("rt_sigprocmask", false)]
    }
    if eff == "Conc" {
        # threads: clone (CLONE_VM|CLONE_THREAD), futex, stack mapping.
        # clone3 is included with intent: glibc tries clone3 first and
        # treats EPERM as FATAL (only ENOSYS falls back to clone).
        return[layer_ent("clone", false), layer_ent("clone3", false),
        layer_ent("futex", false), layer_ent("mmap", false),
        layer_ent("munmap", false), layer_ent("mprotect", false),
        layer_ent("mremap", false), layer_ent("madvise", false),
        layer_ent("rseq", false), layer_ent("set_robust_list", false),
        layer_ent("gettid", false), layer_ent("tgkill", false),
        layer_ent("sched_yield", false), layer_ent("rt_sigaction", false),
        layer_ent("rt_sigprocmask", false)]
    }
    if eff == "Clock" {
        return[layer_ent("clock_gettime", false),
        layer_ent("clock_getres", false),
        layer_ent("clock_nanosleep", false),
        layer_ent("nanosleep", false), layer_ent("gettimeofday", false)]
    }
    if eff == "Rand" {
        return[layer_ent("getrandom", false)]
    }
    return[]
}

# layer_display(e) — the report's spelling ("openat (ro)").
fn layer_display(e: LayerEnt) -> str {
    if e.ro {
        return e.name + " (ro)"
    }
    return e.name
}

# -- the Fs read/write census, over the one builtin→effect table --------

fn fs_read_builtins() -> list[str] {
    return["read_file", "read_file_tainted", "file_exists", "fs_read_dir",
    "fs_size", "fs_is_dir"]
}

fn fs_write_builtins() -> list[str] {
    return["write_file", "fs_set_perms"]
}

# -- the default actions -------------------------------------------------------

fn default_action_names() -> list[str] {
    return["errno", "kill", "log", "trap"]
}

fn default_action_text(action: str) -> Result[str, str] {
    if action == "errno" {
        return Result.Ok("the denied syscall returns -1/EPERM — a value "
        + "the program can observe and answer")
    }
    if action == "kill" {
        return Result.Ok("SECCOMP_RET_KILL_PROCESS — the kernel ends the "
        + "process at the denied call (SIGSYS)")
    }
    if action == "trap" {
        return Result.Ok("SIGSYS delivered to the process — a handler (or "
        + "the default corpse) answers the denial")
    }
    if action == "log" {
        return Result.Ok("allowed to run but logged by the kernel — the "
        + "audit posture, not the enforcement posture")
    }
    return Result.Err("unknown default action: " + action)
}

# The syscalls a profile may never deny: termination and the heap. A
# sandbox the program cannot leave is not a sandbox, it is a hang.
fn undeniable_names() -> list[str] {
    return["exit", "exit_group", "brk"]
}

fn SCHEMA_PROFILE() -> str {
    return "hls-sandbox/v1"
}

# -- rules and the profile -----------------------------------------------------

# One dispatch entry: the syscall, and under which conditions it is
# allowed. `constraints` is a set of (arg_index, mask) pairs — the call
# is allowed when (arg & mask) == 0 for at least ONE recorded pair (OR
# of justifications); `uncond` is the explicitly-unconstrained
# justification and absorbs every constrained one (fs=rw's openat
# subsumes every read-only justification for it). The distinction is
# load-bearing: a fresh rule has NEITHER — 'not yet justified' is not
# 'justified unconditional'.
struct Rule {
    name: str,
    nr: int,
    cons_args: list[int],
    cons_masks: list[int],
    origins: list[str],
    uncond: bool
}

fn rule_new(name: str, nr: int) -> Rule {
    return Rule {
        name: name, nr: nr, cons_args: [], cons_masks: [], origins: [],
        uncond: false
    }
}

# rule_has_cons(r, arg, mask) — membership in the constraint set.
fn rule_has_cons(r: Rule, arg: int, mask: int) -> bool {
    let mut i: int = 0
    while i < r.cons_args.len() {
        if r.cons_args.get(i) == arg && r.cons_masks.get(i) == mask {
            return true
        }
        i = i + 1
    }
    return false
}

# rule_merge(r, args, masks, origin) — the .py's merge: an empty
# constraint set is the unconditional justification (and absorbs every
# constrained one); otherwise the pairs union in.
fn rule_merge(r: Rule, args: list[int], masks: list[int],
origin: str) -> void {
    if args.len() == 0 {
        r.uncond = true
        r.cons_args = []
        r.cons_masks = []
    } else {
        if !r.uncond {
            let mut i: int = 0
            while i < args.len() {
                if !rule_has_cons(r, args.get(i), masks.get(i)) {
                    r.cons_args.push(args.get(i))
                    r.cons_masks.push(masks.get(i))
                }
                i = i + 1
            }
        }
    }
    if !sg_has(r.origins, origin) {
        r.origins.push(origin)
    }
}

# rule_sorted_cons(r) — the constraint pairs sorted by (arg, mask).
fn rule_sorted_cons(r: Rule) -> list[int] {
    # returns the args sorted, with masks permuted alongside
    let order: list[int] = []
    let mut i: int = 0
    while i < r.cons_args.len() {
        order.push(i)
        i = i + 1
    }
    let mut a: int = 1
    while a < order.len() {
        let k: int = order.get(a)
        let ka: int = r.cons_args.get(k)
        let km: int = r.cons_masks.get(k)
        let mut b: int = a - 1
        while b >= 0 && (r.cons_args.get(order.get(b)) > ka
        || (r.cons_args.get(order.get(b)) == ka
        && r.cons_masks.get(order.get(b)) > km)) {
            order.set(b + 1, order.get(b))
            b = b - 1
        }
        order.set(b + 1, k)
        a = a + 1
    }
    return order
}

# rule_cons_text(r) — " [argN & 0x.. == 0, ...]" ("" when unconditional).
fn rule_cons_text(r: Rule) -> str {
    if r.uncond || r.cons_args.len() == 0 {
        return ""
    }
    let order: list[int] = rule_sorted_cons(r)
    let parts: list[str] = []
    let mut i: int = 0
    while i < order.len() {
        let idx: int = order.get(i)
        parts.push("arg" + r.cons_args.get(idx).to_str() + " & 0x"
        + hex_of_int(r.cons_masks.get(idx)) + " == 0")
        i = i + 1
    }
    return " [" + join_strs(parts, ", ") + "]"
}

# Profile — a derived, override-adjusted policy: everything needed to
# assemble the filter, render the report, or write the release statement.
# fs_mode "" is the .py's None (no Fs stance at all).
struct Profile {
    effects: list[str],
    fs_mode: str,
    fs_origin: str,
    default_action: str,
    baseline: str,
    extra_allow: list[str],
    deny: list[str],
    notes: list[str]
}

# profile_make — the constructor's validation: an unknown effect, an
# unknown default action, an unknown baseline, an unknown fs mode, a
# deny on an undeniable. All fatal — a sandbox that guesses is not a
# sandbox.
fn profile_make(effects: list[str], fs_mode: str, fs_origin: str,
default_action: str, baseline: str, extra_allow: list[str],
deny: list[str]) -> Result[Profile, str] {
    let effs: list[str] = sg_sorted_unique(effects)
    let mut i: int = 0
    while i < effs.len() {
        if !sg_has(all_effects(), effs.get(i)) {
            return Result.Err("unknown effect: " + effs.get(i)
            + " (the audit's vocabulary: "
            + join_strs(all_effects(), ", ") + ")")
        }
        i = i + 1
    }
    if !sg_has(default_action_names(), default_action) {
        return Result.Err("unknown default action: " + default_action
        + " (known: " + join_strs(sort_strs(default_action_names()), ", ")
        + ")")
    }
    if baseline != "minimal" && baseline != "hosted" {
        return Result.Err("unknown baseline: " + baseline
        + " (known: minimal, hosted)")
    }
    if fs_mode != "" && fs_mode != "ro" && fs_mode != "rw" {
        return Result.Err("unknown fs mode: " + fs_mode + " (known: ro, rw)")
    }
    let mut d: int = 0
    while d < deny.len() {
        if sg_has(undeniable_names(), deny.get(d)) {
            return Result.Err("deny on " + deny.get(d) + " refused — a "
            + "sandbox the program cannot leave is not a sandbox, it is "
            + "a hang")
        }
        d = d + 1
    }
    return Result.Ok(Profile {
        effects: effs, fs_mode: fs_mode, fs_origin: fs_origin,
        default_action: default_action, baseline: baseline,
        extra_allow: extra_allow, deny: deny, notes: []
    })
}

# profile_rules(profile, arch) — the merged allowlist: baseline + layers
# + extras - denies, one Rule per syscall number, sorted by nr. Absent
# baseline syscalls record their note; absent LAYER syscalls are the
# broken-invariant refusal.
fn profile_rules(profile: Profile, arch: str) -> Result[list[Rule], str] {
    let out: list[Rule] = []

    # add — one entry into the allowlist
    let ok_add: bool = true

    # -- the baseline: BOTH opens read-only masked — the loader and libc
    # open READ-ONLY, and a baseline that allowed write-opens would
    # hollow out every fs=ro profile.
    let baseline_list: list[str] = baseline_minimal()
    if profile.baseline == "hosted" {
        baseline_list2(baseline_list)
    }
    let mut bi: int = 0
    while bi < baseline_list.len() {
        let name: str = baseline_list.get(bi)
        let nr_ans: Result[NrAns, str] = nr_of(name, arch)
        if result_is_err(nr_ans) {
            return Result.Err(result_err_or(nr_ans, ""))
        }
        let ans: NrAns = result_unwrap(nr_ans)
        if ans.nr == -1 {
            # the baseline is never strict: absent-with-reason records
            if ans.note != "" && !sg_has(profile.notes, ans.note) {
                profile.notes.push(ans.note)
            }
        } else {
            if !sg_has(profile.deny, name) {
                let cons_a: list[int] = []
                let cons_m: list[int] = []
                if is_open_family(name) {
                    let fa: Result[int, str] = open_flags_arg(name)
                    if result_is_err(fa) {
                        return Result.Err(result_err_or(fa, ""))
                    }
                    cons_a.push(result_unwrap(fa))
                    cons_m.push(OPEN_WRITE_MASK())
                }
                let r: Rule = rules_find_by_nr(out, ans.nr)
                if r.name == "" {
                    let fresh: Rule = rule_new(name, ans.nr)
                    out.push(fresh)
                    rule_merge(fresh, cons_a, cons_m, "baseline("
                    + profile.baseline + ")")
                } else {
                    rule_merge(r, cons_a, cons_m, "baseline("
                    + profile.baseline + ")")
                }
            }
        }
        bi = bi + 1
    }

    # -- the effect layers (strict: a layer entry that does not resolve
    # on the arch is the broken invariant, not a note)
    let mut ei: int = 0
    while ei < profile.effects.len() {
        let eff: str = profile.effects.get(ei)
        let ents: list[LayerEnt] = layer_entries(eff)
        let mut li: int = 0
        while li < ents.len() {
            let ent: LayerEnt = ents.get(li)
            let add_res: Result[bool, str] = rules_add_layer(out, profile,
            arch, ent.name, ent.ro, "layer(" + eff + ")")
            if result_is_err(add_res) {
                return Result.Err(result_err_or(add_res, ""))
            }
            li = li + 1
        }
        if eff == "Fs" && profile.fs_mode == "rw" {
            let fw: list[LayerEnt] = layer_entries("FsWrite")
            let mut fi: int = 0
            while fi < fw.len() {
                let add_res2: Result[bool, str] = rules_add_layer(out,
                profile, arch, fw.get(fi).name, false, "layer(Fs,rw)")
                if result_is_err(add_res2) {
                    return Result.Err(result_err_or(add_res2, ""))
                }
                fi = fi + 1
            }
        }
        ei = ei + 1
    }

    # -- the overrides
    let mut oi: int = 0
    while oi < profile.extra_allow.len() {
        let add_res3: Result[bool, str] = rules_add_layer(out, profile,
        arch, profile.extra_allow.get(oi), false, "override(allow)")
        if result_is_err(add_res3) {
            return Result.Err(result_err_or(add_res3, ""))
        }
        oi = oi + 1
    }

    # sort by nr (insertion; the sets are small)
    let mut a: int = 1
    while a < out.len() {
        let r: Rule = out.get(a)
        let mut b: int = a - 1
        while b >= 0 && out.get(b).nr > r.nr {
            out.set(b + 1, out.get(b))
            b = b - 1
        }
        out.set(b + 1, r)
        a = a + 1
    }
    let _unused_ok: bool = ok_add
    return Result.Ok(out)
}

# baseline_list2(hosted_list) — extend the minimal list with the hosted
# set (the .py's tuple concat).
fn baseline_list2(minimal: list[str]) -> void {
    minimal.push("read")
    minimal.push("write")
    minimal.push("writev")
    minimal.push("ioctl")
    minimal.push("pread64")
    minimal.push("close")
    minimal.push("open")
    minimal.push("openat")
    minimal.push("stat")
    minimal.push("fstat")
    minimal.push("newfstatat")
    minimal.push("statx")
    minimal.push("access")
    minimal.push("faccessat")
    minimal.push("lseek")
    minimal.push("getdents64")
    minimal.push("readlink")
    minimal.push("readlinkat")
    minimal.push("mprotect")
    minimal.push("mremap")
    minimal.push("madvise")
    minimal.push("uname")
    minimal.push("arch_prctl")
    minimal.push("set_tid_address")
    minimal.push("set_robust_list")
    minimal.push("rseq")
    minimal.push("prlimit64")
    minimal.push("getrandom")
    minimal.push("futex")
    minimal.push("sched_yield")
    minimal.push("gettid")
    minimal.push("tgkill")
    minimal.push("getpid")
    minimal.push("rt_sigaction")
    minimal.push("rt_sigprocmask")
}

# rules_find_by_nr(rules, nr) — the rule, or a blank one (name "").
fn rules_find_by_nr(rules: list[Rule], nr: int) -> Rule {
    let mut i: int = 0
    while i < rules.len() {
        if rules.get(i).nr == nr {
            return rules.get(i)
        }
        i = i + 1
    }
    return rule_new("", -1)
}

# rules_add_layer(rules, profile, arch, name, ro, origin) — one layer or
# override entry: strict — the syscall must resolve on the arch.
fn rules_add_layer(rules: list[Rule], profile: Profile, arch: str,
name: str, ro: bool, origin: str) -> Result[bool, str] {
    let nr_ans: Result[NrAns, str] = nr_of(name, arch)
    if result_is_err(nr_ans) {
        return Result.Err(result_err_or(nr_ans, ""))
    }
    let ans: NrAns = result_unwrap(nr_ans)
    if ans.nr == -1 {
        return Result.Err("layer syscall " + name + " does not exist on "
        + arch + " — the layer invariant is broken (" + ans.note + ")")
    }
    if sg_has(profile.deny, name) {
        return Result.Ok(false)
    }
    let cons_a: list[int] = []
    let cons_m: list[int] = []
    if ro {
        let fa: Result[int, str] = open_flags_arg(name)
        if result_is_err(fa) {
            return Result.Err(result_err_or(fa, ""))
        }
        cons_a.push(result_unwrap(fa))
        cons_m.push(OPEN_WRITE_MASK())
    }
    let r: Rule = rules_find_by_nr(rules, ans.nr)
    if r.name == "" {
        let fresh: Rule = rule_new(name, ans.nr)
        rules.push(fresh)
        rule_merge(fresh, cons_a, cons_m, origin)
    } else {
        rule_merge(r, cons_a, cons_m, origin)
    }
    return Result.Ok(true)
}

# profile_default_ret(profile) — the default action's return constant.
fn profile_default_ret(profile: Profile) -> Result[int, str] {
    if profile.default_action == "errno" {
        return ret_errno(EPERM_NR())
    }
    if profile.default_action == "kill" {
        return Result.Ok(SECCOMP_RET_KILL_PROCESS())
    }
    if profile.default_action == "trap" {
        return Result.Ok(SECCOMP_RET_TRAP())
    }
    return Result.Ok(SECCOMP_RET_LOG())
}

# profile_program(profile, arch) — the seccomp-bpf Program. Classic BPF
# jumps FORWARD only, so each constrained block carries its own denial
# return after its allow return — the program stays a straight line, and
# every path is one of exactly two answers.
fn profile_program(profile: Profile, arch: str) -> Result[Program, str] {
    let rules_res: Result[list[Rule], str] = profile_rules(profile, arch)
    if result_is_err(rules_res) {
        return Result.Err(result_err_or(rules_res, ""))
    }
    let rules: list[Rule] = result_unwrap(rules_res)
    let dflt_res: Result[int, str] = profile_default_ret(profile)
    if result_is_err(dflt_res) {
        return Result.Err(result_err_or(dflt_res, ""))
    }
    let dflt: int = result_unwrap(dflt_res)
    let aa_res: Result[int, str] = audit_arch_of(arch)
    if result_is_err(aa_res) {
        return Result.Err(result_err_or(aa_res, ""))
    }
    let audit_arch: int = result_unwrap(aa_res)
    let asmb: Asm = asm_new()

    let l0: Result[int, str] = asm_load(asmb, OFF_ARCH())
    if result_is_err(l0) {
        return Result.Err(result_err_or(l0, ""))
    }
    let j1: Result[int, str] = asm_jeq(asmb, audit_arch, "nr")
    if result_is_err(j1) {
        return Result.Err(result_err_or(j1, ""))
    }
    let r2: Result[int, str] = asm_ret(asmb, dflt)
    if result_is_err(r2) {
        return Result.Err(result_err_or(r2, ""))
    }
    asm_label(asmb, "nr")
    let l3: Result[int, str] = asm_load(asmb, OFF_NR())
    if result_is_err(l3) {
        return Result.Err(result_err_or(l3, ""))
    }
    # the dispatch, ascending nr
    let mut di: int = 0
    while di < rules.len() {
        let dj: Result[int, str] = asm_jeq(asmb, rules.get(di).nr,
        "b" + rules.get(di).nr.to_str())
        if result_is_err(dj) {
            return Result.Err(result_err_or(dj, ""))
        }
        di = di + 1
    }
    asm_label(asmb, "default")
    let r4: Result[int, str] = asm_ret(asmb, dflt)
    if result_is_err(r4) {
        return Result.Err(result_err_or(r4, ""))
    }
    # the blocks
    let mut bi: int = 0
    while bi < rules.len() {
        let rule: Rule = rules.get(bi)
        asm_label(asmb, "b" + rule.nr.to_str())
        if rule.uncond {
            let ra: Result[int, str] = asm_ret(asmb, SECCOMP_RET_ALLOW())
            if result_is_err(ra) {
                return Result.Err(result_err_or(ra, ""))
            }
        } else {
            let order: list[int] = rule_sorted_cons(rule)
            let mut ci: int = 0
            while ci < order.len() {
                let idx: int = order.get(ci)
                let off_res: Result[int, str] = off_arg_low(
                rule.cons_args.get(idx))
                if result_is_err(off_res) {
                    return Result.Err(result_err_or(off_res, ""))
                }
                let lo: Result[int, str] = asm_load(asmb,
                result_unwrap(off_res))
                if result_is_err(lo) {
                    return Result.Err(result_err_or(lo, ""))
                }
                let js: Result[int, str] = asm_jset(asmb,
                rule.cons_masks.get(idx), "d" + rule.nr.to_str())
                if result_is_err(js) {
                    return Result.Err(result_err_or(js, ""))
                }
                ci = ci + 1
            }
            let rb: Result[int, str] = asm_ret(asmb, SECCOMP_RET_ALLOW())
            if result_is_err(rb) {
                return Result.Err(result_err_or(rb, ""))
            }
            asm_label(asmb, "d" + rule.nr.to_str())
            let rd: Result[int, str] = asm_ret(asmb, dflt)
            if result_is_err(rd) {
                return Result.Err(result_err_or(rd, ""))
            }
        }
        bi = bi + 1
    }
    return asm_finish(asmb)
}

# -- the [sandbox] manifest section -------------------------------------------

# SandboxSec — the validated [sandbox] section ("" / false = absent).
struct SandboxSec {
    default: str,
    fs: str,
    allow: list[str],
    deny: list[str]
}

# parse_sandbox_section(manifest) — validate and extract the optional
# [sandbox] section of a hls-pkg.toml manifest. Every mistake is fatal
# with the fix in the message — a sandbox configured by guessing is not
# a sandbox.
fn parse_sandbox_section(manifest: TomlVal) -> Result[SandboxSec, str] {
    let empty: SandboxSec = SandboxSec {
        default: "", fs: "", allow: [], deny: []
    }
    if manifest.kind != "table" {
        return Result.Ok(empty)
    }
    let sec: TomlVal = toml_get(manifest, "sandbox")
    if sec.kind == "none" {
        return Result.Ok(empty)
    }
    if sec.kind != "table" {
        return Result.Err("[sandbox] must be a table (found "
        + sbx_toml_pyname(sec) + ")")
    }
    let out: SandboxSec = SandboxSec {
        default: "", fs: "", allow: [], deny: []
    }
    let d: TomlVal = toml_get(sec, "default")
    if d.kind != "none" {
        if d.kind != "str" || !sg_has(default_action_names(), d.sval) {
            return Result.Err("[sandbox] default must be one of "
            + join_strs(sort_strs(default_action_names()), ", ")
            + " (found " + sbx_toml_repr(d) + ")")
        }
        out.default = d.sval
    }
    let f: TomlVal = toml_get(sec, "fs")
    if f.kind != "none" {
        if f.kind != "str" || (f.sval != "ro" && f.sval != "rw") {
            return Result.Err("[sandbox] fs must be \"ro\" or \"rw\" "
            + "(found " + sbx_toml_repr(f) + ")")
        }
        out.fs = f.sval
    }
    # allow / deny: lists of syscall names, validated against the table
    let mut key_i: int = 0
    let keys: list[str] = ["allow", "deny"]
    while key_i < keys.len() {
        let key: str = keys.get(key_i)
        let raw: TomlVal = toml_get(sec, key)
        if raw.kind != "none" {
            if raw.kind != "list" {
                return Result.Err("[sandbox] " + key + " must be a list "
                + "of syscall names")
            }
            let mut ni: int = 0
            while ni < raw.vals.len() {
                let v: TomlVal = raw.vals.get(ni)
                if v.kind != "str" {
                    return Result.Err("[sandbox] " + key + " must be a "
                    + "list of syscall names")
                }
                let known: Result[SysRow, str] = sys_row_of(v.sval)
                if result_is_err(known) {
                    return Result.Err("[sandbox] " + key + ": unknown "
                    + "syscall " + sbx_toml_repr(v) + " (known: "
                    + join_strs(syscall_names_sorted(), ", ") + ")")
                }
                ni = ni + 1
            }
            let names: list[str] = []
            let mut si: int = 0
            while si < raw.vals.len() {
                sg_push_unique(names, raw.vals.get(si).sval)
                si = si + 1
            }
            if key == "allow" {
                out.allow = sort_strs(names)
            } else {
                out.deny = sort_strs(names)
            }
        }
        key_i = key_i + 1
    }
    let mut dnx: int = 0
    while dnx < out.deny.len() {
        if sg_has(undeniable_names(), out.deny.get(dnx)) {
            return Result.Err("[sandbox] deny on " + out.deny.get(dnx)
            + " refused — a sandbox the program cannot leave is not a "
            + "sandbox, it is a hang")
        }
        dnx = dnx + 1
    }
    return Result.Ok(out)
}

# sbx_toml_pyname(v) — Python's type(...).__name__ for a parsed TOML value.
fn sbx_toml_pyname(v: TomlVal) -> str {
    if v.kind == "str" {
        return "str"
    }
    if v.kind == "int" {
        return "int"
    }
    if v.kind == "bool" {
        return "bool"
    }
    if v.kind == "float" {
        return "float"
    }
    if v.kind == "list" {
        return "list"
    }
    return "dict"
}

# sbx_toml_repr(v) — Python's %r of a parsed TOML value (the found-value
# quotes in the [sandbox] refusals).
fn sbx_toml_repr(v: TomlVal) -> str {
    if v.kind == "str" {
        return py_repr_str(v.sval)
    }
    if v.kind == "int" {
        return v.ival.to_str()
    }
    if v.kind == "bool" {
        if v.bval {
            return "True"
        }
        return "False"
    }
    return "'" + v.kind + "'"
}

# -- the static-vs-hosted detection for --baseline auto -----------------------

# is_static_elf(path) — true when the ELF carries no PT_INTERP (a static
# artifact — no dynamic loader runs before main). Anything unparseable is
# treated as hosted: the SAFE default is the wider baseline, never the
# one that would EPERM the loader mid-flight.
fn is_static_elf(path: str) -> bool uses Fs {
    if !is_file_h(path) {
        return false
    }
    let data: str = read_file(path)
    if data.len() < 64 {
        return false
    }
    # e_ident: \x7fELF
    if data.byte_at(0) != 127 || data.byte_at(1) != 69
    || data.byte_at(2) != 76 || data.byte_at(3) != 70 {
        return false
    }
    # e_phoff (u64 LE at 32)
    let phoff: int = sbx_le_u64(data, 32)
    # e_phentsize / e_phnum (u16 LE at 54 / 56)
    let phentsize: int = sbx_le_u16(data, 54)
    let phnum: int = sbx_le_u16(data, 56)
    if phentsize <= 0 || phnum <= 0 || phnum > 256 {
        return false
    }
    let span: int = phentsize * phnum
    if phoff < 0 || span > data.len() || phoff > data.len() - span {
        return false
    }
    let mut i: int = 0
    while i < phnum {
        let p_type: int = sbx_le_u32(data, phoff + i * phentsize)
        if p_type == 3 {
            return false # PT_INTERP — a dynamic artifact
        }
        i = i + 1
    }
    return true
}

fn sbx_le_u16(s: str, at: int) -> int {
    return s.byte_at(at) + s.byte_at(at + 1) * 256
}

fn sbx_le_u32(s: str, at: int) -> int {
    return s.byte_at(at) + s.byte_at(at + 1) * 256
    + s.byte_at(at + 2) * 65536 + s.byte_at(at + 3) * 16777216
}

fn sbx_le_u64(s: str, at: int) -> int {
    let lo: int = sbx_le_u32(s, at)
    let hi: int = sbx_le_u32(s, at + 4)
    return lo + hi * 4294967296
}

# -- arch resolution ------------------------------------------------------------

# arch_of_host() — the arch we are actually RUNNING on, in the table's
# names, or "" when the machine is none of the three triples (the run
# refuses to install numbers it cannot vouch for; emit --arch still can).
fn arch_of_host() -> str uses Fs, Proc {
    let r: RunCap = spawn_cap("uname", ["-m"])
    if r.code != 0 {
        return ""
    }
    let m: str = r.out.trim()
    if m == "x86_64" || m == "amd64" {
        return "x86_64"
    }
    if m == "aarch64" || m == "arm64" {
        return "aarch64"
    }
    if m == "riscv64" {
        return "riscv64"
    }
    return ""
}

# ============================================================================
# Part 5 — the TOML subset + the package tree + the audit gate (the
# hls-audit / hls-sign folds of the same hpkg parts). The gate is the
# family's order: drift first, then unauditable, then the [effects]
# policy — a tree that fails its own audit does not get armed.
# ============================================================================

struct TomlVal {
    kind: str, # "none"|"str"|"int"|"float"|"bool"|"list"|"table"
    sval: str,
    ival: int,
    bval: bool,
    keys: list[str],
    vals: list[TomlVal]
}

fn toml_none() -> TomlVal {
    return TomlVal {
        kind: "none", sval: "", ival: 0, bval: false,
        keys: [], vals: []
    }
}

fn toml_table() -> TomlVal {
    return TomlVal {
        kind: "table", sval: "", ival: 0, bval: false,
        keys: [], vals: []
    }
}

fn toml_get(doc: TomlVal, key: str) -> TomlVal {
    let mut i: int = 0
    while i < doc.keys.len() {
        if doc.keys.get(i) == key {
            return doc.vals.get(i)
        }
        i = i + 1
    }
    return toml_none()
}

fn toml_set(doc: TomlVal, key: str, val: TomlVal) -> void {
    let mut i: int = 0
    while i < doc.keys.len() {
        if doc.keys.get(i) == key {
            doc.vals.set(i, val)
            return
        }
        i = i + 1
    }
    doc.keys.push(key)
    doc.vals.push(val)
}

# strip_toml_comment(line) — the strict outside-string comment strip.
fn strip_toml_comment(line: str) -> Result[str, str] {
    let mut out: str = ""
    let mut in_str: bool = false
    let n: int = line.len()
    let mut i: int = 0
    while i < n {
        let c: int = line.byte_at(i)
        if in_str {
            if c == 92 && i + 1 < n {
                let esc: int = line.byte_at(i + 1)
                if esc == 98 || esc == 116 || esc == 110 || esc == 102
                || esc == 114 || esc == 34 || esc == 92 || esc == 117
                || esc == 85 {
                    out = out + line.slice(i, i + 2)
                    i = i + 2
                    continue
                }
                return Result.Err("invalid TOML escape sequence: \\"
                + chr(esc) + " (TOML only allows \\b, \\t, \\n, \\f, "
                + "\\r, \\\", \\uXXXX, \\UXXXXXXXX)")
            }
            if c == 34 {
                in_str = false
            }
            out = out + line.slice(i, i + 1)
            i = i + 1
            continue
        }
        if c == 34 {
            in_str = true
            out = out + line.slice(i, i + 1)
            i = i + 1
            continue
        }
        if c == 35 {
            break
        }
        out = out + line.slice(i, i + 1)
        i = i + 1
    }
    return Result.Ok(out)
}

# toml_is_int_token(tok) — Python's int(tok) acceptance.
fn toml_is_int_token(tok: str) -> bool {
    let t: str = tok.trim()
    if t.len() == 0 {
        return false
    }
    let mut i: int = 0
    if t.byte_at(0) == 43 || t.byte_at(0) == 45 {
        i = 1
    }
    if i >= t.len() {
        return false
    }
    let mut prev_us: bool = true
    while i < t.len() {
        let c: int = t.byte_at(i)
        if is_digit_b(c) {
            prev_us = false
        } else if c == 95 {
            if prev_us {
                return false
            }
            prev_us = true
        } else {
            return false
        }
        i = i + 1
    }
    if prev_us {
        return false
    }
    return true
}

fn toml_is_float_token(tok: str) -> bool {
    if tok.len() == 0 {
        return false
    }
    let mut saw_digit: bool = false
    let mut saw_dot_exp: bool = false
    let mut i: int = 0
    if tok.byte_at(0) == 43 || tok.byte_at(0) == 45 {
        i = 1
    }
    while i < tok.len() {
        let c: int = tok.byte_at(i)
        if is_digit_b(c) {
            saw_digit = true
        } else if c == 46 || c == 101 || c == 69 {
            saw_dot_exp = true
        } else if c != 43 && c != 45 && c != 95 {
            return false
        }
        i = i + 1
    }
    return saw_digit && saw_dot_exp
}

# parse_int_clean — the digits of a signed int token.
fn parse_int_clean(tok: str) -> int {
    let mut neg: bool = false
    let mut i: int = 0
    if tok.len() > 0 && (tok.byte_at(0) == 43 || tok.byte_at(0) == 45) {
        neg = tok.byte_at(0) == 45
        i = 1
    }
    let mut v: int = 0
    while i < tok.len() {
        let c: int = tok.byte_at(i)
        if is_digit_b(c) {
            v = v * 10 + (c - 48)
        }
        i = i + 1
    }
    if neg {
        return -v
    }
    return v
}

# hex4_val / hex8_val — \uXXXX / \UXXXXXXXX payloads.
fn hex4_val(s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() && i < 4 {
        v = v * 16 + hex_val_b(s.byte_at(i))
        i = i + 1
    }
    return v
}

fn hex8_val(s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() && i < 8 {
        v = v * 16 + hex_val_b(s.byte_at(i))
        i = i + 1
    }
    return v
}

# utf8_encode(cp) — the codepoint as UTF-8 bytes.
fn utf8_encode(cp: int) -> str {
    if cp < 0 {
        return ""
    }
    if cp < 128 {
        return chr(cp)
    }
    if cp < 2048 {
        return chr(192 + cp / 64) + chr(128 + cp % 64)
    }
    if cp < 65536 {
        return chr(224 + cp / 4096) + chr(128 + (cp / 64) % 64)
        + chr(128 + cp % 64)
    }
    return chr(240 + cp / 262144) + chr(128 + (cp / 4096) % 64)
    + chr(128 + (cp / 64) % 64) + chr(128 + cp % 64)
}

struct TomlPair {
    val: TomlVal,
    next: int
}

# toml_bare_value(tok) — true/false/int/float/bare string.
fn toml_bare_value(tok: str) -> TomlVal {
    if tok == "true" {
        return TomlVal {
            kind: "bool", sval: "", ival: 0, bval: true,
            keys: [], vals: []
        }
    }
    if tok == "false" {
        return TomlVal {
            kind: "bool", sval: "", ival: 0, bval: false,
            keys: [], vals: []
        }
    }
    if toml_is_int_token(tok) {
        return TomlVal {
            kind: "int", sval: "", ival: parse_int_clean(tok), bval: false,
            keys: [], vals: []
        }
    }
    if toml_is_float_token(tok) {
        return TomlVal {
            kind: "float", sval: tok, ival: 0, bval: false,
            keys: [], vals: []
        }
    }
    return TomlVal {
        kind: "str", sval: tok, ival: 0, bval: false,
        keys: [], vals: []
    }
}

# parse_toml_value(src, i) — (value, next index).
fn parse_toml_value(src: str, i: int) -> Result[TomlPair, str] {
    let n: int = src.len()
    let mut j: int = i
    while j < n && (src.byte_at(j) == 32 || src.byte_at(j) == 9
    || src.byte_at(j) == 13 || src.byte_at(j) == 10) {
        j = j + 1
    }
    if j >= n {
        return Result.Ok(TomlPair {
            val: toml_none(), next: j
        })
    }
    let c: int = src.byte_at(j)
    if c == 34 {
        let mut k: int = j + 1
        let mut out: str = ""
        while k < n && src.byte_at(k) != 34 {
            if src.byte_at(k) == 92 && k + 1 < n {
                let nxt: int = src.byte_at(k + 1)
                if nxt == 110 {
                    out = out + "\n"
                    k = k + 2
                    continue
                }
                if nxt == 116 {
                    out = out + "\t"
                    k = k + 2
                    continue
                }
                if nxt == 114 {
                    out = out + chr(13)
                    k = k + 2
                    continue
                }
                if nxt == 98 {
                    out = out + chr(8)
                    k = k + 2
                    continue
                }
                if nxt == 102 {
                    out = out + chr(12)
                    k = k + 2
                    continue
                }
                if nxt == 34 {
                    out = out + "\""
                    k = k + 2
                    continue
                }
                if nxt == 92 {
                    out = out + "\\"
                    k = k + 2
                    continue
                }
                if nxt == 117 && k + 6 <= n {
                    let cp: int = hex4_val(src.slice(k + 2, k + 6))
                    out = out + utf8_encode(cp)
                    k = k + 6
                    continue
                }
                if nxt == 85 && k + 10 <= n {
                    let cp2: int = hex8_val(src.slice(k + 2, k + 10))
                    out = out + utf8_encode(cp2)
                    k = k + 10
                    continue
                }
                out = out + chr(nxt)
                k = k + 2
                continue
            }
            out = out + src.slice(k, k + 1)
            k = k + 1
        }
        if k >= n {
            return Result.Err("unterminated string literal at offset "
            + j.to_str())
        }
        return Result.Ok(TomlPair {
            val: TomlVal {
                kind: "str", sval: out, ival: 0, bval: false,
                keys: [], vals: []
            },
            next: k + 1
        })
    }
    if c == 91 {
        let items: list[TomlVal] = []
        let mut k: int = j + 1
        while k < n && src.byte_at(k) != 93 {
            while k < n && (src.byte_at(k) == 32 || src.byte_at(k) == 9
            || src.byte_at(k) == 13 || src.byte_at(k) == 10
            || src.byte_at(k) == 44) {
                k = k + 1
            }
            if k >= n || src.byte_at(k) == 93 {
                break
            }
            if src.byte_at(k) == 34 {
                let pair: Result[TomlPair, str] = parse_toml_value(src, k)
                if result_is_err(pair) {
                    return Result.Err(result_err_or(pair, ""))
                }
                items.push(result_unwrap(pair).val)
                k = result_unwrap(pair).next
            } else {
                let s0: int = k
                while k < n && src.byte_at(k) != 32 && src.byte_at(k) != 9
                && src.byte_at(k) != 13 && src.byte_at(k) != 10
                && src.byte_at(k) != 44 && src.byte_at(k) != 93 {
                    k = k + 1
                }
                let tok: str = src.slice(s0, k)
                if tok != "" {
                    items.push(toml_bare_value(tok))
                }
            }
        }
        return Result.Ok(TomlPair {
            val: TomlVal {
                kind: "list", sval: "", ival: 0, bval: false,
                keys: [], vals: items
            },
            next: k + 1
        })
    }
    if c == 123 {
        let table: TomlVal = toml_table()
        let mut k: int = j + 1
        while k < n && src.byte_at(k) != 125 {
            while k < n && (src.byte_at(k) == 32 || src.byte_at(k) == 9
            || src.byte_at(k) == 13 || src.byte_at(k) == 10
            || src.byte_at(k) == 44) {
                k = k + 1
            }
            if k >= n || src.byte_at(k) == 125 {
                break
            }
            let eq: int = find_from(src, "=", k)
            if eq < 0 {
                return Result.Err("substring not found")
            }
            let key: str = src.slice(k, eq).trim()
            let pair2: Result[TomlPair, str] = parse_toml_value(src, eq + 1)
            if result_is_err(pair2) {
                return Result.Err(result_err_or(pair2, ""))
            }
            toml_set(table, key, result_unwrap(pair2).val)
            k = result_unwrap(pair2).next
        }
        return Result.Ok(TomlPair {
            val: table, next: k + 1
        })
    }
    let s0: int = j
    while j < n && src.byte_at(j) != 32 && src.byte_at(j) != 9
    && src.byte_at(j) != 13 && src.byte_at(j) != 10
    && src.byte_at(j) != 44 && src.byte_at(j) != 93
    && src.byte_at(j) != 125 && src.byte_at(j) != 61
    && src.byte_at(j) != 35 {
        j = j + 1
    }
    let tok: str = src.slice(s0, j)
    return Result.Ok(TomlPair {
        val: toml_bare_value(tok), next: j
    })
}

# section_cursor(doc, section, creating) — walk to the section table.
fn section_cursor(doc: TomlVal, section: str, creating: bool)
-> Result[TomlVal, str] {
    let parts: list[str] = section.split(".")
    let mut cursor: TomlVal = doc
    let mut i: int = 0
    while i < parts.len() {
        let p: str = parts.get(i)
        if cursor.kind != "table" {
            let mut msg: str = "manifest: section [" + section
            + "] shadows a non-table value"
            if creating {
                msg = msg + " (a key under [" + section
                + "] was already set)"
            }
            return Result.Err(msg)
        }
        let nxt: TomlVal = toml_get(cursor, p)
        if nxt.kind == "none" {
            let fresh: TomlVal = toml_table()
            toml_set(cursor, p, fresh)
            cursor = fresh
        } else {
            cursor = nxt
        }
        i = i + 1
    }
    if cursor.kind != "table" {
        return Result.Err("manifest: cannot set key under non-table "
        + "section [" + section + "]")
    }
    return Result.Ok(cursor)
}

# parse_manifest(path) — the tree of sections and keys.
fn parse_manifest(path: str) -> Result[TomlVal, str] uses Fs {
    if !is_file_h(path) {
        return Result.Err("manifest not found: " + path)
    }
    let raw: str = read_file(path)
    let lines: list[str] = raw.split("\n")
    let mut src: str = ""
    let mut li: int = 0
    while li < lines.len() {
        let sr: Result[str, str] = strip_toml_comment(lines.get(li))
        if result_is_err(sr) {
            return Result.Err("manifest: " + result_err_or(sr, "")
            + " (in line: " + py_repr_str(lines.get(li)) + ")")
        }
        src = src + result_unwrap(sr)
        if li + 1 < lines.len() {
            src = src + "\n"
        }
        li = li + 1
    }
    let result: TomlVal = toml_table()
    let mut current_section: str = ""
    let n: int = src.len()
    let mut i: int = 0
    while i < n {
        while i < n && (src.byte_at(i) == 32 || src.byte_at(i) == 9
        || src.byte_at(i) == 13 || src.byte_at(i) == 10) {
            i = i + 1
        }
        if i >= n {
            break
        }
        if src.byte_at(i) == 91 {
            let j: int = find_from(src, "]", i)
            if j < 0 {
                return Result.Err("substring not found")
            }
            current_section = src.slice(i + 1, j).trim()
            if current_section == "" {
                return Result.Err("manifest: empty section header at "
                + "offset " + i.to_str())
            }
            let cursor: Result[TomlVal, str] = section_cursor(result,
            current_section, true)
            if result_is_err(cursor) {
                return Result.Err(result_err_or(cursor, ""))
            }
            i = j + 1
            continue
        }
        let eq: int = find_from(src, "=", i)
        if eq < 0 {
            return Result.Err("substring not found")
        }
        let key: str = src.slice(i, eq).trim()
        if key == "" {
            return Result.Err("manifest: empty key at offset "
            + i.to_str())
        }
        let pv: Result[TomlPair, str] = parse_toml_value(src, eq + 1)
        if result_is_err(pv) {
            return Result.Err(result_err_or(pv, ""))
        }
        let pair: TomlPair = result_unwrap(pv)
        if current_section == "" {
            toml_set(result, key, pair.val)
        } else {
            let cursor2: Result[TomlVal, str] = section_cursor(result,
            current_section, false)
            if result_is_err(cursor2) {
                return Result.Err(result_err_or(cursor2, ""))
            }
            toml_set(result_unwrap(cursor2), key, pair.val)
        }
        i = pair.next
    }
    return Result.Ok(result)
}

# toml_text_of(v) — Python's str() of a parsed TOML value.
fn toml_text_of(v: TomlVal) -> str {
    if v.kind == "str" {
        return v.sval
    }
    if v.kind == "int" {
        return v.ival.to_str()
    }
    if v.kind == "bool" {
        if v.bval {
            return "True"
        }
        return "False"
    }
    return ""
}

# -- the lockfile's content hash ----------------------------------------------

# sha256_tree(path) — the lockfile's content hash (file sha256, else the
# deterministic directory hash).
fn sha256_tree(path: str) -> str uses Fs {
    if is_file_h(path) {
        return sha256_hex(read_or(path, ""))
    }
    return sha256_hex(dir_hash_text(path, ""))
}

fn dir_hash_text(dir: str, prefix: str) -> str uses Fs {
    if !is_dir_h(dir) {
        return ""
    }
    let names: list[str] = fs_read_dir(dir)
    let files: list[str] = []
    let dirs: list[str] = []
    let mut ni: int = 0
    while ni < names.len() {
        let nm: str = names.get(ni)
        if is_dir_h(path_join2(dir, nm)) {
            dirs.push(nm)
        } else {
            files.push(nm)
        }
        ni = ni + 1
    }
    let mut h: str = ""
    let sfiles: list[str] = sort_strs(files)
    let mut fi: int = 0
    while fi < sfiles.len() {
        h = h + prefix + sfiles.get(fi) + chr(0)
        + read_or(path_join2(dir, sfiles.get(fi)), "") + chr(0)
        fi = fi + 1
    }
    let sdirs: list[str] = sort_strs(dirs)
    let mut di: int = 0
    while di < sdirs.len() {
        h = h + dir_hash_text(path_join2(dir, sdirs.get(di)),
        prefix + sdirs.get(di) + "/")
        di = di + 1
    }
    return h
}

# -- the dependency resolution (hls-pkg's laws) --------------------------------

# valid_dep_name / confined_join — hpkg_util's laws.
fn valid_dep_name(name: str) -> bool {
    if name == "" {
        return false
    }
    let b0: int = name.byte_at(0)
    if b0 == 46 || b0 == 45 {
        return false
    }
    let mut i: int = 0
    while i < name.len() {
        let c: int = name.byte_at(i)
        if !is_alpha_b(c) && !is_digit_b(c) && c != 46 && c != 95
        && c != 45 {
            return false
        }
        i = i + 1
    }
    return true
}

fn confined_join(base: str, rel: str, what: str) -> Result[str, Fail] {
    if path_is_abs(rel) {
        return Result.Err(fail(what + ": absolute paths are not allowed: "
        + rel))
    }
    let parts: list[str] = str_replace(rel, "\\", "/").split("/")
    if sg_has(parts, "..") {
        return Result.Err(fail(what + ": path must not contain '..' "
        + "segments: " + rel))
    }
    let cand: str = norm_path(path_join2(base, rel))
    if cand != base && !cand.starts_with(base + "/") {
        return Result.Err(fail(what + ": path escapes the package "
        + "directory: " + rel))
    }
    return Result.Ok(cand)
}

struct DepOut {
    dir: str,
    content: str
}

fn manifest_name() -> str {
    return "hls-pkg.toml"
}

# pkg_cache_dir() — HLS_PKG_CACHE or <repo>/.hls-pkg-cache.
fn pkg_cache_dir() -> str uses Fs, Proc, Args {
    let over: str = env_get("HLS_PKG_CACHE")
    if over != "" || env_has("HLS_PKG_CACHE") {
        return over
    }
    return repo_root() + "/.hls-pkg-cache"
}

# resolve_dep — one dependency to (package dir, content path): path deps
# package-relative FIRST then repo-root-relative (both confined); git
# deps through hls-pkg's cache and git itself.
fn resolve_dep(dep_name: str, source: TomlVal, declaring_dir: str,
root: str) -> Result[DepOut, Fail] uses Fs, Proc, Args {
    if source.kind != "table" {
        return Result.Err(fail("dependency " + dep_name
        + ": source must be a table"))
    }
    let git_v: TomlVal = toml_get(source, "git")
    if git_v.kind != "none" {
        if git_v.kind != "str" {
            return Result.Err(fail("dependency " + dep_name
            + " git URL must be a string"))
        }
        if !valid_dep_name(dep_name) {
            return Result.Err(fail("invalid dependency name: '"
            + dep_name + "' (allowed: letters, digits, '.', '_', '-'; "
            + "must not start with '.' or '-')"))
        }
        let repo_url: str = git_v.sval
        if repo_url == "" {
            return Result.Err(fail("dependency " + dep_name
            + " git URL must not be empty"))
        }
        if repo_url.byte_at(0) == 45 {
            return Result.Err(fail("dependency " + dep_name
            + " git URL must not start with '-' (git option injection): '"
            + repo_url + "'"))
        }
        let cache: str = pkg_cache_dir()
        proc_exec("mkdir -p '" + cache + "'")
        let repo_hash: str = sha256_hex(repo_url).slice(0, 12)
        let clone_dir: str = path_join2(path_join2(cache, dep_name),
        repo_hash)
        if !is_dir_h(clone_dir) {
            let gc: RunCap = spawn_cap("git", ["clone", "--quiet", "--",
            repo_url, clone_dir])
            if gc.code != 0 {
                return Result.Err(fail("dependency " + dep_name
                + ": failed to clone git repository (exit "
                + gc.code.to_str() + ")"))
            }
        }
        let ref_v: TomlVal = toml_get(source, "tag")
        let mut ref: str = ""
        if ref_v.kind != "none" {
            ref = toml_text_of(ref_v)
        }
        if ref == "" {
            let br_v: TomlVal = toml_get(source, "branch")
            if br_v.kind != "none" {
                ref = toml_text_of(br_v)
            }
        }
        if ref == "" {
            ref = "main"
        }
        let gf: RunCap = spawn_cap("git", ["-C", clone_dir, "fetch",
        "--quiet", "origin", "--", ref])
        if gf.code != 0 {
            return Result.Err(fail("dependency " + dep_name
            + ": failed to fetch/checkout git ref '" + ref + "'"))
        }
        let gk: RunCap = spawn_cap("git", ["-C", clone_dir, "checkout",
        "--quiet", ref])
        if gk.code != 0 {
            return Result.Err(fail("dependency " + dep_name
            + ": failed to fetch/checkout git ref '" + ref + "'"))
        }
        let path_v: TomlVal = toml_get(source, "path")
        let mut full: str = clone_dir
        if path_v.kind != "none" && toml_text_of(path_v) != "" {
            let cr: Result[str, Fail] = confined_join(clone_dir,
            toml_text_of(path_v), "dependency " + dep_name)
            if result_is_err(cr) {
                return Result.Err(result_err_or(cr, fail("")))
            }
            full = result_unwrap(cr)
        }
        if is_file_h(full) {
            return Result.Ok(DepOut {
                dir: path_dirname(full), content: full
            })
        }
        if is_dir_h(full) {
            return Result.Ok(DepOut {
                dir: full, content: full
            })
        }
        return Result.Err(fail("dependency " + dep_name
        + ": path not found in repo: " + full))
    }
    let path_v2: TomlVal = toml_get(source, "path")
    if path_v2.kind != "none" {
        let rel: str = toml_text_of(path_v2)
        let bases: list[str] = [declaring_dir, root]
        let mut bi: int = 0
        while bi < bases.len() {
            let cr: Result[str, Fail] = confined_join(bases.get(bi), rel,
            "dependency " + dep_name)
            if result_is_err(cr) {
                return Result.Err(result_err_or(cr, fail("")))
            }
            let cand: str = result_unwrap(cr)
            if is_dir_h(cand) {
                let rp: str = realpath_lex(cand)
                return Result.Ok(DepOut {
                    dir: rp, content: rp
                })
            }
            if is_file_h(cand) {
                let full: str = realpath_lex(cand)
                return Result.Ok(DepOut {
                    dir: path_dirname(full), content: full
                })
            }
            bi = bi + 1
        }
        return Result.Err(fail("dependency " + dep_name
        + ": path not found: " + rel))
    }
    return Result.Err(fail("dependency " + dep_name
    + " has no git/path source"))
}

# -- the package tree walk ------------------------------------------------------

struct PkgNode {
    dir: str,
    name: str,
    version: str,
    manifest: TomlVal,
    deps: list[PkgNode],
    parent_dir: str,
    depth: int,
    shared: bool,
    src_kind: str,
    content_path: str,
    audited: bool,
    unauditable: bool
}

fn pkg_node_new(dir: str, name: str, version: str,
manifest: TomlVal) -> PkgNode {
    return PkgNode {
        dir: dir, name: name, version: version, manifest: manifest,
        deps: [], parent_dir: "", depth: 0, shared: false,
        src_kind: "root",
        content_path: dir, audited: false, unauditable: false
    }
}

# walk_packages — depth-first over the manifest's sorted [dependencies],
# a directory on the current stack a cycle, the audit cached per dir.
fn walk_packages(pkg_dir: str, root: str, stack_dirs: list[str],
stack_names: list[str], cache: map[str, PkgNode])
-> Result[PkgNode, Fail] uses Fs, Proc, Args {
    let real: str = realpath_lex(pkg_dir)
    let mut si: int = 0
    while si < stack_dirs.len() {
        if stack_dirs.get(si) == real {
            let chain: list[str] = []
            let mut cj: int = si
            while cj < stack_names.len() {
                chain.push(stack_names.get(cj))
                cj = cj + 1
            }
            chain.push(stack_names.get(si))
            return Result.Err(fail("circular package dependency: "
            + join_strs(chain, " -> ")))
        }
        si = si + 1
    }
    let manifest_path: str = path_join2(real, manifest_name())
    if !is_file_h(manifest_path) {
        return Result.Err(fail("no hls-pkg.toml in " + real))
    }
    let mr: Result[TomlVal, str] = parse_manifest(manifest_path)
    if result_is_err(mr) {
        return Result.Err(fail("manifest " + manifest_path + ": "
        + result_err_or(mr, "")))
    }
    let manifest: TomlVal = result_unwrap(mr)
    let pkg_sec: TomlVal = toml_get(manifest, "package")
    if pkg_sec.kind != "table" && pkg_sec.kind != "none" {
        return Result.Err(fail("manifest " + manifest_path
        + ": 'package' section is not a table"))
    }
    let name_v: TomlVal = toml_get(pkg_sec, "name")
    let mut name: str = toml_text_of(name_v)
    if name == "" {
        name = path_basename(real)
    }
    let version_v: TomlVal = toml_get(pkg_sec, "version")
    let mut version: str = toml_text_of(version_v)
    if version == "" {
        version = "0.0.0"
    }
    let node: PkgNode = pkg_node_new(real, name, version, manifest)
    node.depth = stack_dirs.len()
    if cache.has(real) {
        let prior: PkgNode = cache.get_or(real, node)
        node.audited = prior.audited
        node.unauditable = prior.unauditable
        node.shared = true
        return Result.Ok(node)
    }
    stack_dirs.push(real)
    stack_names.push(name)
    let deps_sec: TomlVal = toml_get(manifest, "dependencies")
    if deps_sec.kind != "table" && deps_sec.kind != "none" {
        stack_dirs.pop()
        stack_names.pop()
        return Result.Err(fail("package " + name
        + ": [dependencies] section is corrupt"))
    }
    let dep_names: list[str] = sort_strs(deps_sec.keys)
    let mut di: int = 0
    while di < dep_names.len() {
        let dep_name: str = dep_names.get(di)
        let source: TomlVal = toml_get(deps_sec, dep_name)
        let dr: Result[DepOut, Fail] = resolve_dep(dep_name, source, real,
        root)
        if result_is_err(dr) {
            return Result.Err(result_err_or(dr, fail("")))
        }
        let dep: DepOut = result_unwrap(dr)
        let cr: Result[PkgNode, Fail] = walk_packages(dep.dir, root,
        stack_dirs, stack_names, cache)
        if result_is_err(cr) {
            return Result.Err(result_err_or(cr, fail("")))
        }
        let child: PkgNode = result_unwrap(cr)
        if toml_get(source, "git").kind != "none" {
            child.src_kind = "git"
        } else {
            child.src_kind = "path"
        }
        child.content_path = dep.content
        child.parent_dir = node.dir
        child.depth = node.depth + 1
        node.deps.push(child)
        di = di + 1
    }
    stack_dirs.pop()
    stack_names.pop()
    return Result.Ok(node)
}

fn all_nodes(root: PkgNode) -> list[PkgNode] {
    let out: list[PkgNode] = []
    all_nodes_into(root, out)
    return out
}

fn all_nodes_into(node: PkgNode, out: list[PkgNode]) -> void {
    out.push(node)
    let mut i: int = 0
    while i < node.deps.len() {
        all_nodes_into(node.deps.get(i), out)
        i = i + 1
    }
}

# lock_locked_map(lock_path) — the lockfile's name -> sha256 map.
fn lock_locked_map(lock_path: str) -> Result[map[str, str], Fail] uses Fs {
    let locked: map[str, str] = map_new()
    let text: str = read_or(lock_path, "")
    let pr: Result[JsonValue, str] = json_parse_result(text)
    if result_is_err(pr) {
        return Result.Err(fail("cannot read lockfile: "
        + result_err_or(pr, "")))
    }
    let lock: JsonValue = result_unwrap(pr)
    let pkgs: JsonValue = json_object_get(lock, "packages")
    if json_is_array(pkgs) {
        let mut i: int = 0
        while i < pkgs.arr.len() {
            let p: JsonValue = pkgs.arr.get(i)
            if json_is_object(p) {
                let nm: JsonValue = json_object_get(p, "name")
                let sha: JsonValue = json_object_get(p, "sha256")
                if json_is_str(nm) && json_is_str(sha) {
                    locked.set(json_str_value(nm), json_str_value(sha))
                } else {
                    if json_is_str(nm) {
                        locked.set(json_str_value(nm), "")
                    }
                }
            }
            i = i + 1
        }
    }
    return Result.Ok(locked)
}

# ============================================================================
# Part 6 — the source-mode derivation: the checker IS the oracle (the
# native era's fold of hls-audit's walk). The front-end rides in probe
# children (--probe-parse / --probe-check) that re-exec this binary; the
# parent maps a dead child to a clean refusal.
# ============================================================================

# sbx_dummy_fn() — the empty FnInfo for map.get_or defaults.
fn sbx_dummy_fn() -> FnInfo {
    return FnInfo {
        name: "",
        params: [],
        ptypes: [],
        pmuts: [],
        ret: "",
        effects: [],
        is_pure: false,
        body: [],
        is_method: false,
        struct_of: "",
        typeparams: [],
        line: 0,
        is_extern: false,
        requires_e: -1,
        ensures_e: -1,
        attr_stack_size: -1,
        attr_no_red_zone: false,
        attr_irq_handler: false,
        attr_irq_vector: -1,
        attr_inline: "",
        attr_hot: false,
        attr_cold: false,
        attr_tail_call: false,
        attr_panic_handler: false,
        attr_section: "",
        attr_align: -1,
        src_file: "",
        param_preds: map_new(),
        ret_pred: "",
        has_refinements: false,
        attr_secrets: "",
        attr_ct: false,
        attr_deprecated: false,
        attr_deprecated_msg: "",
        attr_taint_source: false,
        attr_taint_sinks: ""
    }
}

# first_err_line(err) — a probe's panic text: the first non-empty stderr
# line minus the "panic: " prefix (hllint's panic_text law).
fn first_err_line(err: str) -> str {
    let lines: list[str] = err.split("\n")
    let mut t: str = ""
    let mut i: int = 0
    while i < lines.len() {
        let c: str = lines.get(i).trim()
        if c != "" {
            t = c
            break
        }
        i = i + 1
    }
    if t.starts_with("panic: ") {
        t = t.slice(7, t.len())
    }
    return t
}

# sbx_probe_fail_text(flag, path) — the parent side: spawn the probe
# child, map the outcome. Returns the failure text ("" when ok).
fn sbx_probe_fail_text(flag: str, path: str) -> str uses Proc, Args {
    let selfp: str = self_path()
    if selfp == "" {
        return "cannot re-exec the tool for the probe"
    }
    let argv: list[str] = [flag, path]
    let r: RunCap = spawn_cap(selfp, argv)
    if r.code == 0 {
        return ""
    }
    let mut why: str = r.err.trim()
    if why.starts_with("panic: ") {
        why = why.slice(7, why.len())
    }
    let nl: int = why.find("\n")
    if nl > 0 {
        why = why.slice(0, nl)
    }
    return why
}

# sbx_write_wrapper(pkg_dir, entry) — the hls-pkg lock wrapper contract
# for library entries: import the entry, prove the tree checks with a
# synthetic pure main.
fn sbx_write_wrapper(pkg_dir: str, entry: str) -> str uses Fs, Proc {
    let wrapper_path: str = pkg_dir + "/.hls-audit-wrapper-"
    + proc_pid().to_str() + ".hls"
    write_file(wrapper_path, "# auto-generated by hls-sandbox\n"
    + "import \"" + entry + "\"\n"
    + "fn main() -> int pure { return 0 }\n")
    return wrapper_path
}

# Deriv — the derivation's answer.
struct Deriv {
    scope: str,
    effects: list[str],
    builtins: list[str],
    extern_effects: list[str],
    fs_mode: str,
    fs_origin: str
}

fn deriv_none() -> Deriv {
    return Deriv {
        scope: "", effects: [], builtins: [], extern_effects: [],
        fs_mode: "", fs_origin: ""
    }
}

# derive_source(entry_path) — walk an entry file's tree exactly as the
# audit does (the same import resolution, the same merged check through
# the REAL front-end) and derive:
#
#   effects      computed_effects of `main` — the checker's own fixpoint,
#                i.e. precisely what executing the entry can perform (a
#                library with no main falls back to the union over every
#                fn, through the wrapper contract hls-pkg lock uses)
#   builtins     the reachable builtin census (BFS over the call graph
#                from main) — this is what splits Fs(ro) from Fs(rw)
#   extern_fx    every extern block's declared effects — an extern
#                declaring Fs is OPAQUE and forces fs=rw
#
# A tree that cannot be checked is refused ("unauditable: ..."): a tree
# that cannot be checked cannot be sandboxed either.
fn derive_source(entry_path: str) -> Result[Deriv, str]
uses Fs, Proc, Args {
    let entry_abs: str = realpath_lex(entry_path)
    if !is_file_h(entry_abs) {
        return Result.Err("no such file: " + entry_abs)
    }
    # the merged check, behind the probe child
    let bad: str = sbx_probe_fail_text("--probe-check", entry_abs)
    if bad != "" && !bad.contains("missing main function") {
        return Result.Err("unauditable: " + bad)
    }
    let mut library: bool = false
    let mut load_path: str = entry_abs
    if bad != "" {
        # a library entry: the wrapper contract
        library = true
        let wrapper_path: str = sbx_write_wrapper(path_dirname(entry_abs),
        path_basename(entry_abs))
        let wbad: str = sbx_probe_fail_text("--probe-check", wrapper_path)
        if wbad != "" {
            proc_exec("rm -f '" + wrapper_path + "'")
            return Result.Err("unauditable: " + wbad)
        }
        load_path = wrapper_path
    }
    let ctx: Ctx = hl_load_crate(load_path)
    hl_check(ctx)
    if library {
        proc_exec("rm -f '" + load_path + "'")
    }

    # the reachable set + the builtin census, BFS from the roots
    let roots: list[str] = []
    let mut scope: str = "main"
    if !library {
        roots.push("main")
    } else {
        scope = "union (no main — library entry)"
        let mut fi: int = 0
        while fi < ctx.fn_order.len() {
            if ctx.fn_order.get(fi) != "main" {
                roots.push(ctx.fn_order.get(fi))
            }
            fi = fi + 1
        }
    }
    let reach: list[str] = []
    let builtins: list[str] = []
    let stack: list[str] = []
    let mut ri: int = 0
    while ri < roots.len() {
        stack.push(roots.get(ri))
        ri = ri + 1
    }
    while stack.len() > 0 {
        let k: str = stack.pop()
        if sg_has(reach, k) {
            continue
        }
        reach.push(k)
        let callees: list[str] = ctx.edges.get_or(k, [])
        let mut ci: int = 0
        while ci < callees.len() {
            let callee: str = callees.get(ci)
            if callee.starts_with("b:") {
                sg_push_unique(builtins, callee.slice(2, callee.len()))
            } else {
                stack.push(callee)
            }
            ci = ci + 1
        }
    }
    let effects: list[str] = []
    let mut ei: int = 0
    while ei < reach.len() {
        let effs: list[str] = ctx.computed_effects.get_or(reach.get(ei), [])
        let mut xi: int = 0
        while xi < effs.len() {
            sg_push_unique(effects, effs.get(xi))
            xi = xi + 1
        }
        ei = ei + 1
    }

    # the extern census: opaque Fs anywhere in the tree surrenders the
    # read/write split (the wrapper, when present, is the load's first
    # module and never declares externs — skip it).
    let extern_fx: list[str] = []
    let mut mi: int = 0
    if library {
        mi = 1
    }
    while mi < ctx.loaded_files.len() {
        let mctx: Ctx = hl_parse_file(ctx.loaded_files.get(mi))
        let mut fi2: int = 0
        while fi2 < mctx.fn_order.len() {
            let info: FnInfo = mctx.fns.get_or(mctx.fn_order.get(fi2),
            sbx_dummy_fn())
            if info.is_extern {
                let mut xi2: int = 0
                while xi2 < info.effects.len() {
                    sg_push_unique(extern_fx, info.effects.get(xi2))
                    xi2 = xi2 + 1
                }
            }
            fi2 = fi2 + 1
        }
        mi = mi + 1
    }

    # the read/write split
    let mut fs_mode: str = ""
    let mut fs_origin: str = ""
    if !sg_has(effects, "Fs") {
        fs_origin = "no Fs in the execution surface"
    } else {
        if sg_has(extern_fx, "Fs") {
            fs_mode = "rw"
            fs_origin = "derived — an extern block declares Fs and the "
            + "C side is opaque; the split is surrendered"
        } else {
            let writes: list[str] = []
            let mut wi: int = 0
            while wi < builtins.len() {
                if sg_has(fs_write_builtins(), builtins.get(wi)) {
                    writes.push(builtins.get(wi))
                }
                wi = wi + 1
            }
            if writes.len() > 0 {
                fs_mode = "rw"
                fs_origin = "derived — the reachable builtin census "
                + "contains the write side ("
                + join_strs(sort_strs(writes), ", ") + ")"
            } else {
                let reads: list[str] = []
                let mut rj: int = 0
                while rj < builtins.len() {
                    if sg_has(fs_read_builtins(), builtins.get(rj)) {
                        reads.push(builtins.get(rj))
                    }
                    rj = rj + 1
                }
                if reads.len() > 0 {
                    fs_mode = "ro"
                    fs_origin = "derived — the reachable builtin census "
                    + "is read-only (" + join_strs(sort_strs(reads), ", ")
                    + ")"
                } else {
                    fs_mode = "ro"
                    fs_origin = "derived — Fs is in the surface through "
                    + "no reachable fs builtin; the tightest honest "
                    + "floor is read-only"
                }
            }
        }
    }
    return Result.Ok(Deriv {
        scope: scope,
        effects: sort_strs(effects),
        builtins: sort_strs(builtins),
        extern_effects: sort_strs(extern_fx),
        fs_mode: fs_mode,
        fs_origin: fs_origin
    })
}

# ============================================================================
# Part 7 — the audit gate (package mode): the tree must PASS its own
# audit before anyone arms it. Drift first, then unauditable, then the
# [effects] policy — the family's order.
# ============================================================================

struct DriftEnt {
    package: str,
    why: str
}

struct UnaudEnt {
    package: str,
    why: str
}

struct VioEnt {
    effect: str,
    package: str,
    chain: list[str]
}

struct PkgBrief {
    name: str,
    version: str
}

struct GateRep {
    drift: list[DriftEnt],
    unauditable: list[UnaudEnt],
    violations: list[VioEnt],
    lockfile: str,
    manifest_allowed: list[str],
    has_manifest_allowed: bool,
    packages: list[PkgBrief]
}

# sbx_pkg_surface(pkg_dir, entry, wrapper_used) — the in-process read
# (the probe already proved it checks): every fn's computed effects over
# the crate loaded from the entry.
fn sbx_pkg_surface(pkg_dir: str, entry: str, wrapper_used: bool)
-> Result[list[str], str] uses Fs, Proc {
    let entry_path: str = path_join2(pkg_dir, entry)
    let mut load_path: str = entry_path
    if wrapper_used {
        load_path = sbx_write_wrapper(pkg_dir, entry)
    }
    let ctx: Ctx = hl_load_crate(load_path)
    hl_check(ctx)
    if wrapper_used {
        proc_exec("rm -f '" + load_path + "'")
    }
    let surface: list[str] = []
    let mut fi: int = 0
    while fi < ctx.fn_order.len() {
        let effs: list[str] = ctx.computed_effects.get_or(
        ctx.fn_order.get(fi), [])
        let mut ei: int = 0
        while ei < effs.len() {
            sg_push_unique(surface, effs.get(ei))
            ei = ei + 1
        }
        fi = fi + 1
    }
    return Result.Ok(sort_strs(surface))
}

# sbx_check_entry(pkg_dir, entry) — the entry (or its wrapper) through
# the probe child. Returns wrapper_used on success or the failure text.
fn sbx_check_entry(pkg_dir: str, entry: str) -> Result[bool, str]
uses Fs, Proc, Args {
    let entry_path: str = path_join2(pkg_dir, entry)
    if !is_file_h(entry_path) {
        return Result.Err("entry not found: " + entry)
    }
    let bad: str = sbx_probe_fail_text("--probe-check", entry_path)
    if bad == "" {
        return Result.Ok(false)
    }
    if !bad.contains("missing main function") {
        return Result.Err(bad)
    }
    let wrapper_path: str = sbx_write_wrapper(pkg_dir, entry)
    let wbad: str = sbx_probe_fail_text("--probe-check", wrapper_path)
    proc_exec("rm -f '" + wrapper_path + "'")
    if wbad != "" {
        return Result.Err(wbad)
    }
    return Result.Ok(true)
}

# sbx_node_chain(nodes, node) — the package names root..node.
fn sbx_node_chain(nodes: list[PkgNode], node: PkgNode) -> list[str] {
    let rev: list[str] = [node.name]
    let mut cur: PkgNode = node
    let mut guard: int = 0
    while cur.parent_dir != "" && guard < 128 {
        guard = guard + 1
        let mut i: int = 0
        let mut found: bool = false
        while i < nodes.len() {
            if nodes.get(i).dir == cur.parent_dir {
                cur = nodes.get(i)
                rev.push(cur.name)
                found = true
                break
            }
            i = i + 1
        }
        if !found {
            break
        }
    }
    let out: list[str] = []
    let mut r: int = rev.len() - 1
    while r >= 0 {
        out.push(rev.get(r))
        r = r - 1
    }
    return out
}

# sbx_audit_gate(root_dir) — the package audit the .py ran before arming:
# every unique package checked through the real front-end (fail-closed,
# never pure), the lockfile drift, and the violations against the ROOT
# manifest's own [effects].allowed policy.
fn sbx_audit_gate(root_dir: str) -> Result[GateRep, str]
uses Fs, Proc, Args {
    let real: str = realpath_lex(root_dir)
    if !is_dir_h(real) {
        return Result.Err("not a directory: " + root_dir)
    }
    let root: str = repo_root()
    let cache: map[str, PkgNode] = map_new()
    let wr: Result[PkgNode, Fail] = walk_packages(real, root, [], [],
    cache)
    if result_is_err(wr) {
        return Result.Err(result_err_or(wr, fail("?")).msg)
    }
    let root_node: PkgNode = result_unwrap(wr)
    let nodes: list[PkgNode] = all_nodes(root_node)

    let rep: GateRep = GateRep {
        drift: [], unauditable: [], violations: [], lockfile: "absent",
        manifest_allowed: [], has_manifest_allowed: false, packages: []
    }
    let mut ni: int = 0
    while ni < nodes.len() {
        rep.packages.push(PkgBrief {
            name: nodes.get(ni).name, version: nodes.get(ni).version
        })
        ni = ni + 1
    }

    # audit every UNIQUE package dir (fail-closed, never pure)
    let audited_dirs: list[str] = []
    let surfaces: list[list[str]] = []
    let mut ai: int = 0
    while ai < nodes.len() {
        let node: PkgNode = nodes.get(ai)
        if sg_has(audited_dirs, node.dir) {
            ai = ai + 1
            continue
        }
        audited_dirs.push(node.dir)
        let pkg_sec: TomlVal = toml_get(node.manifest, "package")
        let mut entry: str = toml_text_of(toml_get(pkg_sec, "entry"))
        if entry == "" {
            entry = "main.hls"
        }
        let cr: Result[bool, str] = sbx_check_entry(node.dir, entry)
        if result_is_err(cr) {
            rep.unauditable.push(UnaudEnt {
                package: node.name,
                why: "package " + node.name + " unauditable: "
                + result_err_or(cr, "?")
            })
            surfaces.push(all_effects())
        } else {
            let sr: Result[list[str], str] = sbx_pkg_surface(node.dir,
            entry, result_unwrap(cr))
            if result_is_err(sr) {
                rep.unauditable.push(UnaudEnt {
                    package: node.name,
                    why: "package " + node.name + " unauditable: "
                    + result_err_or(sr, "?")
                })
                surfaces.push(all_effects())
            } else {
                surfaces.push(result_unwrap(sr))
            }
        }
        ai = ai + 1
    }

    # the lockfile drift: every top-level dep's sha256 vs the lock
    let lock_path: str = path_join2(real, "hls-pkg.lock")
    if is_file_h(lock_path) {
        rep.lockfile = "present"
        let lr: Result[map[str, str], Fail] = lock_locked_map(lock_path)
        if result_is_err(lr) {
            return Result.Err(result_err_or(lr, fail("?")).msg)
        }
        let locked: map[str, str] = result_unwrap(lr)
        let mut ci: int = 0
        while ci < root_node.deps.len() {
            let child: PkgNode = root_node.deps.get(ci)
            if !locked.has(child.name) {
                rep.drift.push(DriftEnt {
                    package: child.name,
                    why: "in the manifest but not in the lockfile"
                })
            } else {
                let was: str = locked.get_or(child.name, "")
                let now: str = sha256_tree(child.content_path)
                if now != was {
                    let mut was12: str = clip_str(was, 12)
                    if was12 == "" {
                        was12 = "<none>"
                    }
                    rep.drift.push(DriftEnt {
                        package: child.name,
                        why: "locked sha256 " + was12
                        + " but the tree now hashes " + clip_str(now, 12)
                        + " — re-lock"
                    })
                }
            }
            ci = ci + 1
        }
    }

    # the policy: the ROOT manifest's [effects].allowed (the --effects
    # yardstick override is the caller's business, exactly as the .py
    # re-filtered the audit's own violations)
    let eff_sec: TomlVal = toml_get(root_node.manifest, "effects")
    let raw: TomlVal = toml_get(eff_sec, "allowed")
    let allowed: list[str] = []
    if raw.kind == "list" {
        let mut li: int = 0
        while li < raw.vals.len() {
            let v: TomlVal = raw.vals.get(li)
            if v.kind == "str" {
                sg_push_unique(allowed, v.sval)
            }
            li = li + 1
        }
        rep.manifest_allowed = sort_strs(allowed)
        rep.has_manifest_allowed = true
    }

    # violations: every NON-ROOT package surface outside the policy
    if rep.has_manifest_allowed {
        let mut vi: int = 0
        while vi < nodes.len() {
            let node: PkgNode = nodes.get(vi)
            if node.dir != root_node.dir {
                let sidx: int = sg_index_of(audited_dirs, node.dir)
                if sidx >= 0 {
                    let surface: list[str] = surfaces.get(sidx)
                    let mut e: int = 0
                    while e < surface.len() {
                        if !sg_has(allowed, surface.get(e)) {
                            rep.violations.push(VioEnt {
                                effect: surface.get(e),
                                package: node.name,
                                chain: sbx_node_chain(nodes, node)
                            })
                        }
                        e = e + 1
                    }
                }
            }
            vi = vi + 1
        }
    }
    return Result.Ok(rep)
}

# ============================================================================
# Part 8 — the launcher (the native era's arm): a minimal, auditable C
# translation unit emitted into a scratch dir, compiled with cc, and
# spawned as [launcher, filter.hex, status-file, cmd...]. The launcher
# forks; the CHILD arms itself (PR_SET_NO_NEW_PRIVS, seccomp(2) with the
# prctl(PR_SET_SECCOMP) fallback) and execvp's the command — the filter
# is inherited across the exec; the PARENT waits and reports the exact
# wait status through the status file ("exit N" / "signal N") and its
# own exit code. The only process confined is the one that volunteered.
# ============================================================================

# seccomp_nr_of(arch) — the recorded seccomp(2) syscall numbers (used
# when SYS_seccomp is not provided by the target's headers; the same
# table the shim carries).
fn seccomp_nr_of(arch: str) -> Result[int, str] {
    if arch == "x86_64" {
        return Result.Ok(317)
    }
    if arch == "aarch64" || arch == "riscv64" {
        return Result.Ok(277)
    }
    return Result.Err("unknown arch: " + arch)
}

# launcher_source(arch) — the C text. Minimal and auditable on purpose:
# hex decode, the arm, the exec, the wait, the status file. Nothing else.
fn launcher_source(arch: str) -> Result[str, str] {
    let nr_res: Result[int, str] = seccomp_nr_of(arch)
    if result_is_err(nr_res) {
        return Result.Err(result_err_or(nr_res, ""))
    }
    let nr: int = result_unwrap(nr_res)
    let lines: list[str] = []
    lines.push("/* hls-sandbox launcher — generated in a scratch dir by "
    + "tools/hls-sandbox (Stage 110).")
    lines.push(" * argv: launcher <filter.hex> <status-file> <cmd> "
    + "[args...]")
    lines.push(" *")
    lines.push(" * Forks; the CHILD arms itself (PR_SET_NO_NEW_PRIVS, "
    + "then the seccomp(2)")
    lines.push(" * syscall with the prctl(PR_SET_SECCOMP) fallback) and "
    + "execvp's the")
    lines.push(" * command — the filter is inherited across the exec. "
    + "The PARENT waits")
    lines.push(" * and reports the exact wait status through the status "
    + "file and its own")
    lines.push(" * exit code (the artifact's code passes through; "
    + "128+signum when the")
    lines.push(" * kernel ended it; 125 when the arm itself refused). "
    + "The only process")
    lines.push(" * confined is the one that volunteered. */")
    lines.push("#include <sys/prctl.h>")
    lines.push("#include <sys/syscall.h>")
    lines.push("#include <sys/types.h>")
    lines.push("#include <sys/wait.h>")
    lines.push("#include <signal.h>")
    lines.push("#include <unistd.h>")
    lines.push("#include <fcntl.h>")
    lines.push("#include <string.h>")
    lines.push("#include <stdio.h>")
    lines.push("#include <stdlib.h>")
    lines.push("#include <errno.h>")
    lines.push("#include <linux/seccomp.h>")
    lines.push("#include <linux/filter.h>")
    lines.push("")
    lines.push("#ifndef PR_SET_NO_NEW_PRIVS")
    lines.push("#define PR_SET_NO_NEW_PRIVS 38")
    lines.push("#endif")
    lines.push("#ifndef PR_SET_SECCOMP")
    lines.push("#define PR_SET_SECCOMP 22")
    lines.push("#endif")
    lines.push("#ifndef SECCOMP_MODE_FILTER")
    lines.push("#define SECCOMP_MODE_FILTER 2")
    lines.push("#endif")
    lines.push("#ifndef SECCOMP_SET_MODE_FILTER")
    lines.push("#define SECCOMP_SET_MODE_FILTER 1")
    lines.push("#endif")
    lines.push("#ifndef SYS_seccomp")
    lines.push("#define SYS_seccomp " + nr.to_str()
    + "  /* recorded for " + arch + " by hls-sandbox */")
    lines.push("#endif")
    lines.push("")
    lines.push("#define HL_MAX_INSNS 4096")
    lines.push("static struct sock_filter hl_insns[HL_MAX_INSNS];")
    lines.push("")
    lines.push("static int hl_hex(int c) {")
    lines.push("    if (c >= '0' && c <= '9') return c - '0';")
    lines.push("    if (c >= 'a' && c <= 'f') return c - 'a' + 10;")
    lines.push("    if (c >= 'A' && c <= 'F') return c - 'A' + 10;")
    lines.push("    return -1;")
    lines.push("}")
    lines.push("")
    lines.push("static int hl_arm(const char *hex) {")
    lines.push("    size_t n = strlen(hex);")
    lines.push("    size_t i;")
    lines.push("    unsigned code, jt, jf, k;")
    lines.push("    int b;")
    lines.push("    if (n == 0 || (n % 16) != 0 || (n / 16) > HL_MAX_INSNS)"
    + " {")
    lines.push("        fprintf(stderr, \"hls-sandbox: arm failed: the "
    + "filter hex is not a whole number of instructions\\n\");")
    lines.push("        return -1;")
    lines.push("    }")
    lines.push("    for (i = 0; i < n / 16; i++) {")
    lines.push("        /* the hex is the kernel's little-endian sock_filter")
    lines.push("         * memory image: code u16, jt u8, jf u8, k u32. */")
    lines.push("        unsigned char by[8];")
    lines.push("        for (b = 0; b < 8; b++) {")
    lines.push("            int hi = hl_hex(hex[16*i + 2*b]);")
    lines.push("            int lo = hl_hex(hex[16*i + 2*b + 1]);")
    lines.push("            if (hi < 0 || lo < 0) {")
    lines.push("                fprintf(stderr, \"hls-sandbox: arm "
    + "failed: the filter hex has a non-hex character\\n\");")
    lines.push("                return -1;")
    lines.push("            }")
    lines.push("            by[b] = (unsigned char)(hi * 16 + lo);")
    lines.push("        }")
    lines.push("        code = (unsigned)by[0] | ((unsigned)by[1] << 8);")
    lines.push("        jt = by[2];")
    lines.push("        jf = by[3];")
    lines.push("        k = (unsigned)by[4] | ((unsigned)by[5] << 8)")
    lines.push("          | ((unsigned)by[6] << 16) | ((unsigned)by[7] << 24);")
    lines.push("        if (jt > 255 || jf > 255) return -1;")
    lines.push("        hl_insns[i].code = (unsigned short)code;")
    lines.push("        hl_insns[i].jt = (unsigned char)jt;")
    lines.push("        hl_insns[i].jf = (unsigned char)jf;")
    lines.push("        hl_insns[i].k = k;")
    lines.push("    }")
    lines.push("    if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0) {")
    lines.push("        fprintf(stderr, \"hls-sandbox: "
    + "prctl(PR_SET_NO_NEW_PRIVS) failed: errno %d (%s)\\n\",")
    lines.push("                errno, strerror(errno));")
    lines.push("        return -1;")
    lines.push("    }")
    lines.push("    {")
    lines.push("        struct sock_fprog prog;")
    lines.push("        prog.len = (unsigned short)(n / 16);")
    lines.push("        prog.filter = hl_insns;")
    lines.push("        if (syscall(SYS_seccomp, SECCOMP_SET_MODE_FILTER, "
    + "0, &prog) != 0) {")
    lines.push("            int err = errno;")
    lines.push("            if (prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, "
    + "&prog, 0, 0) != 0) {")
    lines.push("                fprintf(stderr, \"hls-sandbox: "
    + "seccomp(SECCOMP_SET_MODE_FILTER) failed: errno %d (%s)\\n\",")
    lines.push("                        err, strerror(err));")
    lines.push("                return -1;")
    lines.push("            }")
    lines.push("        }")
    lines.push("    }")
    lines.push("    return 0;")
    lines.push("}")
    lines.push("")
    lines.push("int main(int argc, char **argv) {")
    lines.push("    pid_t pid;")
    lines.push("    int status = 0;")
    lines.push("    int fd;")
    lines.push("    if (argc < 4) {")
    lines.push("        fprintf(stderr, \"hls-sandbox: launcher usage: "
    + "launcher FILTER_HEX STATUS_FILE CMD [ARGS...]\\n\");")
    lines.push("        return 125;")
    lines.push("    }")
    lines.push("    pid = fork();")
    lines.push("    if (pid < 0) {")
    lines.push("        fprintf(stderr, \"hls-sandbox: fork failed: errno "
    + "%d (%s)\\n\", errno, strerror(errno));")
    lines.push("        return 125;")
    lines.push("    }")
    lines.push("    if (pid == 0) {")
    lines.push("        if (hl_arm(argv[1]) != 0)")
    lines.push("            _exit(125);")
    lines.push("        execvp(argv[3], &argv[3]);")
    lines.push("        if (errno == ENOENT) {")
    lines.push("            fprintf(stderr, \"hls-sandbox: command not "
    + "found: %s\\n\", argv[3]);")
    lines.push("            _exit(127);")
    lines.push("        }")
    lines.push("        if (errno == EACCES) {")
    lines.push("            fprintf(stderr, \"hls-sandbox: cannot execute: "
    + "%s\\n\", argv[3]);")
    lines.push("            _exit(126);")
    lines.push("        }")
    lines.push("        fprintf(stderr, \"hls-sandbox: exec failed: "
    + "%s\\n\", strerror(errno));")
    lines.push("        _exit(126);")
    lines.push("    }")
    lines.push("    if (waitpid(pid, &status, 0) < 0) {")
    lines.push("        fprintf(stderr, \"hls-sandbox: waitpid failed: "
    + "errno %d (%s)\\n\", errno, strerror(errno));")
    lines.push("        return 125;")
    lines.push("    }")
    lines.push("    fd = open(argv[2], O_WRONLY | O_CREAT | O_TRUNC, "
    + "0644);")
    lines.push("    if (WIFEXITED(status)) {")
    lines.push("        int code = WEXITSTATUS(status);")
    lines.push("        if (fd >= 0) { dprintf(fd, \"exit %d\\n\", code); "
    + "close(fd); }")
    lines.push("        return code;")
    lines.push("    }")
    lines.push("    if (WIFSIGNALED(status)) {")
    lines.push("        int sig = WTERMSIG(status);")
    lines.push("        if (fd >= 0) { dprintf(fd, \"signal %d\\n\", sig); "
    + "close(fd); }")
    lines.push("        return 128 + sig;")
    lines.push("    }")
    lines.push("    if (fd >= 0) { dprintf(fd, \"exit 125\\n\"); "
    + "close(fd); }")
    lines.push("    return 125;")
    lines.push("}")
    return Result.Ok(str_join(lines, "\n") + "\n")
}

# RunOutcome — the launcher's answer: the artifact's own exit code and
# the signal that ended it (-1 when it was not a signal death).
struct RunOutcome {
    code: int,
    sig: int
}

# sbx_exec_run(profile, arch, cmd) — build the launcher, arm, cross,
# report. The exit contract mirrors the shell's, extended by one code:
# 125 the sandbox itself could not be armed.
fn sbx_exec_run(profile: Profile, arch: str, cmd: list[str])
-> Result[RunOutcome, str] uses Fs, Proc, Clock {
    if cmd.len() == 0 {
        return Result.Err("nothing to run")
    }
    if sg_has(profile.deny, "execve") {
        return Result.Err("this profile denies execve — the launcher "
        + "installs the filter and then must exec the artifact, so it "
        + "cannot cross. Emit the shim instead (hls-sandbox emit) and "
        + "let the binary arm itself in its constructor")
    }
    let prog_res: Result[Program, str] = profile_program(profile, arch)
    if result_is_err(prog_res) {
        return Result.Err(result_err_or(prog_res, ""))
    }
    let prog: Program = result_unwrap(prog_res)

    # the scratch dir + the launcher source + the compile
    let scratch: str = "/tmp/hls-sandbox-" + proc_pid().to_str()
    proc_exec("mkdir -p '" + scratch + "'")
    let src_res: Result[str, str] = launcher_source(arch)
    if result_is_err(src_res) {
        return Result.Err(result_err_or(src_res, ""))
    }
    let src_path: str = scratch + "/launcher.c"
    write_file(src_path, result_unwrap(src_res))
    let bin_path: str = scratch + "/launcher"
    let mut cc: str = which_hit("cc")
    if cc == "" {
        cc = which_hit("gcc")
    }
    if cc == "" {
        return Result.Err("cannot arm on this host: no C compiler on "
        + "PATH to build the launcher")
    }
    let cr: RunCap = spawn_cap(cc, ["-O2", "-o", bin_path, src_path])
    if cr.code != 0 {
        return Result.Err("cannot arm on this host: the launcher did not "
        + "compile (" + first_err_line(cr.err) + ")")
    }

    # the crossing: the launcher inherits our stdio (the artifact's own
    # output streams straight through, exactly as the .py's forked child
    # did), the filter travels as a hex argument, the exact wait status
    # comes back through the status file.
    let status_path: str = scratch + "/status-" + clock_ms().to_str()
    let rest: list[str] = [prog_bytes_hex(prog), status_path]
    let mut ci: int = 0
    while ci < cmd.len() {
        rest.push(cmd.get(ci))
        ci = ci + 1
    }
    let pid: int = proc_spawn(bin_path, rest, 0, 0, 0)
    if pid < 1 {
        return Result.Err("cannot arm on this host: the launcher could "
        + "not be spawned")
    }
    let code: int = proc_wait(pid)
    proc_child_close(pid, 1)
    proc_child_close(pid, 2)

    # the exact wait status from the launcher's report
    let mut sig: int = -1
    let mut exit_code: int = code
    let status_text: str = read_or(status_path, "")
    let status_line: str = status_text.trim()
    if status_line.starts_with("signal ") {
        let num_text: str = status_line.slice(7, status_line.len())
        if num_text.to_int() >= 0 {
            sig = num_text.to_int()
            exit_code = 128 + sig
        }
    } else {
        if status_line.starts_with("exit ") {
            let num_text2: str = status_line.slice(5, status_line.len())
            if num_text2.to_int() >= 0 {
                exit_code = num_text2.to_int()
            }
        }
    }
    # the scratch (launcher source, binary, status) is single-use: the
    # .py armed in-process and left nothing behind, so neither do we
    proc_exec("rm -rf '" + scratch + "'")
    return Result.Ok(RunOutcome {
        code: exit_code, sig: sig
    })
}

# signal_name(sig) — Python's signal.Signals(sig).name (the Linux x86_64
# set; unknown numbers fall back to the number itself).
fn signal_name(sig: int) -> str {
    let names: list[str] = ["SIGHUP", "SIGINT", "SIGQUIT", "SIGILL",
    "SIGTRAP", "SIGABRT", "SIGBUS", "SIGFPE", "SIGKILL", "SIGUSR1",
    "SIGSEGV", "SIGUSR2", "SIGPIPE", "SIGALRM", "SIGTERM", "SIGSTKFLT",
    "SIGCHLD", "SIGCONT", "SIGSTOP", "SIGTSTP", "SIGTTIN", "SIGTTOU",
    "SIGURG", "SIGXCPU", "SIGXFSZ", "SIGVTALRM", "SIGPROF", "SIGWINCH",
    "SIGIO", "SIGPWR", "SIGSYS"]
    if sig >= 1 && sig <= 31 {
        return names.get(sig - 1)
    }
    return "SIG" + sig.to_str()
}

fn SIGSYS_NR() -> int {
    return 31
}

fn ARM_EXIT() -> int {
    return 125
}

# describe_exit(code, sig) — the human line for `run`'s answer: one
# sentence, no spin.
fn describe_exit(code: int, sig: int) -> str {
    if sig == SIGSYS_NR() {
        return "killed by SIGSYS — a syscall the filter denies (kill "
        + "mode ends the process at the call)"
    }
    if sig >= 0 {
        return "killed by signal " + sig.to_str() + " ("
        + signal_name(sig) + ")"
    }
    if code == ARM_EXIT() {
        return "the sandbox could not be armed (exit 125)"
    }
    if code == 101 {
        return "the artifact panicked (exit 101 — the language's own "
        + "convention; under a sandbox this is usually a denial "
        + "observed as a value)"
    }
    return "exit " + code.to_str()
}

# ============================================================================
# Part 9 — the C shim emitter (sbx_cemit's fold): `emit` writes the other
# half of the story — a standalone C translation unit that arms the
# binary ITSELF, in a constructor that runs before main. Silent on
# success (a printing constructor would break byte-parity with the
# interpreter); the evidence it is armed is behavioral. The header names
# the profile that produced it so the artifact is auditable years later
# without the tree it came from.
# ============================================================================

fn emit_shim(profile: Profile, arch: str, path: str) -> Result[str, str]
uses Fs {
    let prog_res: Result[Program, str] = profile_program(profile, arch)
    if result_is_err(prog_res) {
        return Result.Err(result_err_or(prog_res, ""))
    }
    let prog: Program = result_unwrap(prog_res)
    let rules_res: Result[list[Rule], str] = profile_rules(profile, arch)
    if result_is_err(rules_res) {
        return Result.Err(result_err_or(rules_res, ""))
    }
    let rules: list[Rule] = result_unwrap(rules_res)
    let aa_res: Result[int, str] = audit_arch_of(arch)
    if result_is_err(aa_res) {
        return Result.Err(result_err_or(aa_res, ""))
    }
    let audit_arch: int = result_unwrap(aa_res)
    let nr_res: Result[int, str] = seccomp_nr_of(arch)
    if result_is_err(nr_res) {
        return Result.Err(result_err_or(nr_res, ""))
    }
    let seccomp_nr: int = result_unwrap(nr_res)

    let mut effects_text: str = "(none)"
    if profile.effects.len() > 0 {
        effects_text = join_strs(profile.effects, ", ")
    }
    let mut fs_text: str = profile.fs_mode
    if fs_text == "" {
        fs_text = "(none)"
    }
    let lines: list[str] = []
    lines.push("/* hls-sandbox shim — generated by tools/hls-sandbox.py "
    + "(Stage 110).")
    lines.push(" *")
    lines.push(" * profile:   effects=" + effects_text + " fs=" + fs_text
    + " default=" + profile.default_action)
    lines.push(" *            baseline=" + profile.baseline)
    lines.push(" * arch:      " + arch + " (AUDIT_ARCH 0x"
    + hex_of_int(audit_arch) + ")")
    lines.push(" * program:   " + prog_len(prog).to_str()
    + " instructions, " + rules.len().to_str() + " syscalls allowed")
    lines.push(" *")
    if profile.deny.len() > 0 {
        lines.push(" *            denied: "
        + join_strs(profile.deny, ", "))
        lines.push(" *")
    }
    lines.push(" * Compile into the artifact:")
    lines.push(" *     cc -O2 -o prog prog.c this_file.c")
    lines.push(" *")
    lines.push(" * Arms in a constructor (priority 101, ahead of the "
    + "runtime's own")
    lines.push(" * constructors): NO_NEW_PRIVS, then the filter. Silent "
    + "on success —")
    lines.push(" * the first denied syscall is the evidence (EPERM, or "
    + "SIGSYS under")
    lines.push(" * the kill default).")
    lines.push(" */")
    lines.push("#include <sys/prctl.h>")
    lines.push("#include <linux/seccomp.h>")
    lines.push("#include <linux/filter.h>")
    lines.push("#include <linux/audit.h>")
    lines.push("#include <sys/syscall.h>")
    lines.push("#include <unistd.h>")
    lines.push("#include <stddef.h>")
    lines.push("")
    lines.push("#ifndef SECCOMP_MODE_FILTER")
    lines.push("#define SECCOMP_MODE_FILTER 2")
    lines.push("#endif")
    lines.push("")
    # the filter array, verbatim (one definition of the program, two
    # delivery modes)
    let arr: list[str] = prog_c_array(prog).split("\n")
    let mut ai: int = 0
    while ai < arr.len() {
        lines.push(arr.get(ai))
        ai = ai + 1
    }
    lines.push("")
    lines.push("__attribute__((constructor(101)))")
    lines.push("static void hl_sandbox_arm(void) {")
    lines.push("    unsigned long nr_seccomp =")
    lines.push("#ifdef SYS_seccomp")
    lines.push("        (unsigned long)SYS_seccomp;")
    lines.push("#else")
    lines.push("        " + seccomp_nr.to_str() + "UL;  /* recorded for "
    + arch + " by hls-sandbox */")
    lines.push("#endif")
    lines.push("    struct sock_fprog prog = {")
    lines.push("        .len = (unsigned short)(sizeof(hl_sandbox_filter)")
    lines.push("                                / sizeof(hl_sandbox_filter[0])),")
    lines.push("        .filter = (struct sock_filter *)hl_sandbox_filter,")
    lines.push("    };")
    lines.push("    if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0)")
    lines.push("        return;              /* refused: run unconfined, "
    + "say nothing */")
    lines.push("    (void)syscall(nr_seccomp, SECCOMP_SET_MODE_FILTER, 0, "
    + "&prog);")
    lines.push("}")
    write_file(path, str_join(lines, "\n") + "\n")
    return Result.Ok(path)
}

# ============================================================================
# Part 10 — the release (sbx_release's fold): the sandbox statement and
# its ledger record. The statement claims the POSTURE — which syscall
# allowlist this package version was shipped to run under — and is
# chained into the same transparency ledger lock, publish, the SBOM,
# repro and sign append to.
# ============================================================================

fn STATEMENT_SCHEMA() -> str {
    return "hls-sandbox-statement/v1"
}

fn STATEMENT_SUFFIX() -> str {
    return ".profile.json"
}

# collect_hls_sources(dir, out) — hls-pkg publish's sorted walk (skips
# dot entries).
fn collect_hls_sources(dir: str, out: list[str]) -> void uses Fs {
    if !is_dir_h(dir) {
        return
    }
    let names: list[str] = fs_read_dir(dir)
    let mut i: int = 0
    while i < names.len() {
        let nm: str = names.get(i)
        if nm == "" {
            i = i + 1
            continue
        }
        if nm.byte_at(0) == 46 {
            i = i + 1
            continue
        }
        let full: str = path_join2(dir, nm)
        if is_dir_h(full) {
            collect_hls_sources(full, out)
        } else {
            if nm.ends_with(".hls") {
                out.push(full)
            }
        }
        i = i + 1
    }
}

# content_digest(pkg_dir) — the digest hls-pkg publish computes: the
# SAME sorted walk, one definition of the number across the supply chain.
struct ContentDigest {
    hex: str,
    files: int
}

fn content_digest(pkg_dir: str) -> ContentDigest uses Fs {
    let sources: list[str] = []
    collect_hls_sources(pkg_dir, sources)
    let sorted_sources: list[str] = sort_strs(sources)
    let mut h: str = ""
    let mut i: int = 0
    while i < sorted_sources.len() {
        let s: str = sorted_sources.get(i)
        let mut rel: str = s
        if s.starts_with(pkg_dir + "/") {
            rel = s.slice(pkg_dir.len() + 1, s.len())
        }
        h = h + rel + chr(0) + read_or(s, "") + chr(0)
        i = i + 1
    }
    return ContentDigest {
        hex: sha256_hex(h), files: sorted_sources.len()
    }
}

# sbx_resolve_entry(pkg_dir, manifest) — the package's entry file:
# manifest [package].entry when declared, else main.hls beside the
# manifest (the hls-pkg build convention).
fn sbx_resolve_entry(pkg_dir: str, manifest: TomlVal) -> Result[str, str]
uses Fs {
    let entry: str = toml_text_of(toml_get(toml_get(manifest, "package"),
    "entry"))
    let mut entry_rel: str = entry
    if entry_rel == "" {
        entry_rel = "main.hls"
    }
    let p: str = path_join2(pkg_dir, entry_rel)
    if !is_file_h(p) {
        return Result.Err("no entry file for the profile to be derived "
        + "from: " + p)
    }
    return Result.Ok(p)
}

# build_statement(pkg_dir) — audit the tree (fail-closed), require the
# lockfile, derive the profile (root surface + the [sandbox] section),
# and return the statement as JSON.
fn build_statement(pkg_dir: str) -> Result[JsonValue, str]
uses Fs, Proc, Args {
    let real: str = realpath_lex(pkg_dir)
    let manifest_path: str = path_join2(real, manifest_name())
    if !is_file_h(manifest_path) {
        return Result.Err("no " + manifest_name() + " in " + real
        + " — a release pins a package")
    }
    let mr: Result[TomlVal, str] = parse_manifest(manifest_path)
    if result_is_err(mr) {
        return Result.Err("manifest " + manifest_path + ": "
        + result_err_or(mr, ""))
    }
    let manifest: TomlVal = result_unwrap(mr)

    # -- the fail-closed audit, in the family's order -------------------
    let gr: Result[GateRep, str] = sbx_audit_gate(real)
    if result_is_err(gr) {
        return Result.Err(result_err_or(gr, ""))
    }
    let gate: GateRep = result_unwrap(gr)
    if gate.drift.len() > 0 {
        let names: list[str] = []
        let mut di: int = 0
        while di < gate.drift.len() {
            sg_push_unique(names, gate.drift.get(di).package)
            di = di + 1
        }
        return Result.Err("drift between the lockfile and the tree ("
        + join_strs(sort_strs(names), ", ")
        + ") — re-lock; a sandbox over drifted content is a lie")
    }
    if gate.unauditable.len() > 0 {
        let names2: list[str] = []
        let mut ui: int = 0
        while ui < gate.unauditable.len() {
            sg_push_unique(names2, gate.unauditable.get(ui).package)
            ui = ui + 1
        }
        return Result.Err("unauditable package(s) in the tree ("
        + join_strs(sort_strs(names2), ", ")
        + ") — fail closed; nobody pins a sandbox to a package they "
        + "could not check")
    }
    if gate.violations.len() > 0 {
        let vtexts: list[str] = []
        let mut vi: int = 0
        while vi < gate.violations.len() {
            vtexts.push(gate.violations.get(vi).effect + " via "
            + gate.violations.get(vi).package)
            vi = vi + 1
        }
        return Result.Err("the tree violates its own [effects] policy ("
        + join_strs(vtexts, ", ")
        + ") — the audit gate failed; a sandbox must not paper over it")
    }
    if gate.lockfile != "present" {
        return Result.Err("a release ships pinned content — no lockfile "
        + "next to the manifest; run hls-pkg lock first")
    }

    # -- the profile: root surface + [sandbox] --------------------------
    let sec_res: Result[SandboxSec, str] = parse_sandbox_section(manifest)
    if result_is_err(sec_res) {
        return Result.Err(result_err_or(sec_res, ""))
    }
    let sbx: SandboxSec = result_unwrap(sec_res)
    let entry_res: Result[str, str] = sbx_resolve_entry(real, manifest)
    if result_is_err(entry_res) {
        return Result.Err(result_err_or(entry_res, ""))
    }
    let deriv_res: Result[Deriv, str] = derive_source(result_unwrap(
    entry_res))
    if result_is_err(deriv_res) {
        return Result.Err(result_err_or(deriv_res, ""))
    }
    let deriv: Deriv = result_unwrap(deriv_res)
    let mut fs_mode: str = deriv.fs_mode
    if sbx.fs != "" {
        fs_mode = sbx.fs
    }
    let mut fs_origin: str = deriv.fs_origin
    if sbx.fs != "" && sbx.fs != deriv.fs_mode {
        fs_origin = "manifest [sandbox] fs"
    }
    let mut default_action: str = sbx.default
    if default_action == "" {
        default_action = "errno"
    }
    let profile_res: Result[Profile, str] = profile_make(deriv.effects,
    fs_mode, fs_origin, default_action, "hosted", sbx.allow, sbx.deny)
    if result_is_err(profile_res) {
        return Result.Err(result_err_or(profile_res, ""))
    }
    let profile: Profile = result_unwrap(profile_res)

    let rules_res: Result[list[Rule], str] = profile_rules(profile,
    "x86_64")
    if result_is_err(rules_res) {
        return Result.Err(result_err_or(rules_res, ""))
    }
    let rules: list[Rule] = result_unwrap(rules_res)
    let allowlist: list[str] = []
    let constrained: list[str] = []
    let mut ri: int = 0
    while ri < rules.len() {
        allowlist.push(rules.get(ri).name)
        if !rules.get(ri).uncond {
            constrained.push(rules.get(ri).name)
        }
        ri = ri + 1
    }
    let cd: ContentDigest = content_digest(real)
    let root: PkgBrief = gate.packages.get(0)

    let st: JsonValue = json_object([], [])
    sbx_obj_set(st, "schema", json_str(STATEMENT_SCHEMA()))
    sbx_obj_set(st, "kind", json_str("halis-sandbox-statement"))
    sbx_obj_set(st, "name", json_str(root.name))
    sbx_obj_set(st, "version", json_str(root.version))
    sbx_obj_set(st, "effects", sbx_json_list_str(profile.effects))
    let fs_obj: JsonValue = json_object([], [])
    if profile.fs_mode == "" {
        sbx_obj_set(fs_obj, "mode", json_null())
    } else {
        sbx_obj_set(fs_obj, "mode", json_str(profile.fs_mode))
    }
    sbx_obj_set(fs_obj, "origin", json_str(profile.fs_origin))
    sbx_obj_set(st, "fs", fs_obj)
    sbx_obj_set(st, "default_action", json_str(profile.default_action))
    sbx_obj_set(st, "baseline", json_str(profile.baseline))
    sbx_obj_set(st, "allowlist", sbx_json_list_str(sort_strs(allowlist)))
    sbx_obj_set(st, "constrained", sbx_json_list_str(sort_strs(
    constrained)))
    sbx_obj_set(st, "allow", sbx_json_list_str(profile.extra_allow))
    sbx_obj_set(st, "deny", sbx_json_list_str(profile.deny))
    sbx_obj_set(st, "absent_notes", sbx_json_list_str(sg_sorted_unique(
    profile.notes)))
    sbx_obj_set(st, "entry_surface", sbx_json_list_str(deriv.effects))
    sbx_obj_set(st, "content_sha256", json_str(cd.hex))
    sbx_obj_set(st, "files", json_int(cd.files))
    sbx_obj_set(st, "lockfile_sha256", json_str(sha256_hex(read_or(
    path_join2(real, "hls-pkg.lock"), ""))))
    return Result.Ok(st)
}

# rel_statement_bytes(st) — the exact file bytes: json.dumps(indent=2,
# sort_keys=True) + "\n".
fn rel_statement_bytes(st: JsonValue) -> str {
    return sbx_json_dump(st) + "\n"
}

struct RelOut {
    statement: JsonValue,
    st_path: str,
    rec: TlogRec
}

# release(pkg_dir, out_dir) — write the versioned statement and chain
# ONE record into the transparency log.
fn release(pkg_dir: str, out_dir: str, has_out: bool) -> Result[RelOut, str]
uses Fs, Proc, Clock, Args {
    let st_res: Result[JsonValue, str] = build_statement(pkg_dir)
    if result_is_err(st_res) {
        return Result.Err(result_err_or(st_res, ""))
    }
    let statement: JsonValue = result_unwrap(st_res)
    let real: str = realpath_lex(pkg_dir)
    let mut outd: str = real
    if has_out {
        outd = realpath_lex(out_dir)
    }
    if !is_dir_h(outd) {
        return Result.Err("output directory does not exist: " + outd)
    }
    let base: str = "hls-sandbox-" + sbx_jstr_or(statement, "name", "")
    + "-" + sbx_jstr_or(statement, "version", "")
    let st_path: str = path_join2(outd, base + STATEMENT_SUFFIX())
    let payload: str = rel_statement_bytes(statement)
    write_file(st_path, payload)

    # ONE ledger record, chained
    let rec_doc: JsonValue = json_object([], [])
    sbx_obj_set(rec_doc, "kind", json_str("sandbox"))
    sbx_obj_set(rec_doc, "name", json_str(sbx_jstr_or(statement, "name",
    "")))
    sbx_obj_set(rec_doc, "version", json_str(sbx_jstr_or(statement,
    "version", "")))
    sbx_obj_set(rec_doc, "content_sha256", json_str(sbx_jstr_or(
    statement, "content_sha256", "")))
    let fs_obj: JsonValue = json_object_get(statement, "fs")
    if json_is_object(fs_obj) && json_is_str(json_object_get(fs_obj,
    "mode")) {
        sbx_obj_set(rec_doc, "fs", json_str(json_str_value(
        json_object_get(fs_obj, "mode"))))
    } else {
        sbx_obj_set(rec_doc, "fs", json_null())
    }
    sbx_obj_set(rec_doc, "default_action", json_str(sbx_jstr_or(
    statement, "default_action", "")))
    sbx_obj_set(rec_doc, "allowlist_count", json_int(sbx_jstrs(
    json_object_get(statement, "allowlist")).len()))
    sbx_obj_set(rec_doc, "statement_sha256", json_str(sha256_hex(payload)))
    let tr: Result[TlogRec, str] = tlog_append(rec_doc)
    if result_is_err(tr) {
        return Result.Err(result_err_or(tr, ""))
    }
    return Result.Ok(RelOut {
        statement: statement, st_path: st_path, rec: result_unwrap(tr)
    })
}

# verify_release(pkg_dir) — the counterparty's side: find exactly one
# statement, re-derive the profile from the CURRENT tree, hash-compare
# the allowlist, re-check the ledger record's statement hash, and
# confirm the record is still IN the log. Returns (statement, checks).
struct VerifyOut {
    statement: JsonValue,
    checks: list[str]
}

fn verify_release(pkg_dir: str) -> Result[VerifyOut, str]
uses Fs, Proc, Args {
    let real: str = realpath_lex(pkg_dir)
    let statements: list[str] = []
    let names: list[str] = fs_read_dir(real)
    let mut ni: int = 0
    while ni < names.len() {
        if names.get(ni).ends_with(STATEMENT_SUFFIX()) {
            statements.push(names.get(ni))
        }
        ni = ni + 1
    }
    let sorted_st: list[str] = sort_strs(statements)
    if sorted_st.len() == 0 {
        return Result.Err("no hls-sandbox-<name>-<version>"
        + STATEMENT_SUFFIX() + " in " + real + " — nothing to verify")
    }
    if sorted_st.len() > 1 {
        return Result.Err("several sandbox statements in " + real + " ("
        + join_strs(sorted_st, ", ")
        + ") — verify one directory per release")
    }
    let st_path: str = path_join2(real, sorted_st.get(0))
    let payload: str = read_or(st_path, "")
    let pr: Result[JsonValue, str] = json_parse_result(payload)
    if result_is_err(pr) {
        return Result.Err("the statement is not JSON ("
        + result_err_or(pr, "") + ")")
    }
    let statement: JsonValue = result_unwrap(pr)
    if sbx_jstr_or(statement, "schema", "") != STATEMENT_SCHEMA() {
        return Result.Err("statement schema is "
        + py_repr_str(sbx_jstr_or(statement, "schema", "")) + ", expected "
        + STATEMENT_SCHEMA())
    }

    let checks: list[str] = []

    # 1. the ledger saw exactly these bytes
    let name: str = sbx_jstr_or(statement, "name", "")
    let version: str = sbx_jstr_or(statement, "version", "")
    let rec: JsonValue = tlog_lookup(name, version)
    if json_is_null(rec) {
        return Result.Err("no ledger record for " + name + " " + version
        + " — the statement was never chained")
    }
    if sbx_jstr_or(rec, "kind", "") != "sandbox" {
        return Result.Err("ledger record for " + name + " is kind "
        + py_repr_str(sbx_jstr_or(rec, "kind", "")) + ", not 'sandbox'")
    }
    if sbx_jstr_or(rec, "statement_sha256", "") != sha256_hex(payload) {
        return Result.Err("the ledger recorded a DIFFERENT statement "
        + "hash — this file is not the one that was chained")
    }
    checks.push("ledger: record " + sbx_jstr_or(rec, "seq", "0")
    .to_str() + " matches these bytes")

    # 2. the lockfile bytes
    let lock_path: str = path_join2(real, "hls-pkg.lock")
    if !is_file_h(lock_path) {
        return Result.Err("no lockfile beside the statement")
    }
    let now: str = sha256_hex(read_file(lock_path))
    let pinned: str = sbx_jstr_or(statement, "lockfile_sha256", "")
    if now != pinned {
        let mut pinned12: str = clip_str(pinned, 12)
        if pinned12 == "" {
            pinned12 = "<none>"
        }
        return Result.Err("lockfile bytes drifted since the statement "
        + "(pinned " + pinned12 + ", now " + clip_str(now, 12) + ")")
    }
    checks.push("lockfile: bytes unchanged")

    # 3. the content digest, re-derived from the CURRENT tree
    let cd: ContentDigest = content_digest(real)
    if cd.hex != sbx_jstr_or(statement, "content_sha256", "") {
        let mut pinned2: str = clip_str(sbx_jstr_or(statement,
        "content_sha256", ""), 12)
        if pinned2 == "" {
            pinned2 = "<none>"
        }
        return Result.Err("content digest drifted — the tree is not the "
        + "tree the posture was pinned to (pinned " + pinned2 + ", now "
        + clip_str(cd.hex, 12) + ")")
    }
    checks.push("content: digest matches the current tree")

    # 4. the posture, re-derived from the CURRENT tree
    let now_res: Result[JsonValue, str] = build_statement(real)
    if result_is_err(now_res) {
        return Result.Err(result_err_or(now_res, ""))
    }
    let now_st: JsonValue = result_unwrap(now_res)
    let keys: list[str] = ["effects", "fs", "default_action", "baseline",
    "allowlist", "constrained", "allow", "deny"]
    let mut ki: int = 0
    while ki < keys.len() {
        let key: str = keys.get(ki)
        let want: JsonValue = json_object_get(statement, key)
        let have: JsonValue = json_object_get(now_st, key)
        if sbx_json_line(want) != sbx_json_line(have) {
            return Result.Err("the profile drifted: " + key + " is "
            + sbx_json_line(want) + " in the statement, "
            + sbx_json_line(have) + " in the current tree — the pinned "
            + "posture no longer describes this package")
        }
        ki = ki + 1
    }
    checks.push("profile: the derived posture is unchanged")
    return Result.Ok(VerifyOut {
        statement: statement, checks: checks
    })
}

# ============================================================================
# Part 11 — the report (the .py's render_profile, over the JSON report
# — one source of truth, exactly as the .py rendered its dict).
# ============================================================================

# render_profile(rep, with_bpf, prog, name_nrs, name_names) — the text
# report. Needle for needle the .py's own lines.
fn render_profile(rep: JsonValue, with_bpf: bool, prog: Program,
name_nrs: list[int], name_names: list[str]) -> Result[str, str] {
    let lines: list[str] = []
    lines.push("hls-sandbox — seccomp-bpf profile ("
    + sbx_jstr_or(rep, "mode", "") + " mode)")
    let root_v: JsonValue = json_object_get(rep, "root")
    if json_is_str(root_v) {
        lines.push("root: " + json_str_value(root_v))
    }
    let d: JsonValue = json_object_get(rep, "derivation")
    if json_is_object(d) {
        let scope: str = sbx_jstr_or(d, "scope", "")
        let mut scope_text: str = ", from main"
        if scope != "main" {
            scope_text = " — " + scope
        }
        let effects: list[str] = sbx_jstrs(json_object_get(d, "effects"))
        let mut eff_text: str = "(none)"
        if effects.len() > 0 {
            eff_text = join_strs(effects, ", ")
        }
        lines.push("execution surface (checker" + scope_text + "): "
        + eff_text)
        let builtins: list[str] = sbx_jstrs(json_object_get(d, "builtins"))
        if builtins.len() > 0 {
            lines.push("reachable builtins: " + join_strs(builtins, ", "))
        }
        let extern_fx: list[str] = sbx_jstrs(json_object_get(d,
        "extern_effects"))
        if extern_fx.len() > 0 {
            lines.push("extern-declared effects: "
            + join_strs(extern_fx, ", "))
        }
    }
    let fs: JsonValue = json_object_get(rep, "fs")
    let fs_mode_v: JsonValue = json_object_get(fs, "mode")
    let mut fs_mode: str = "(none)"
    if json_is_str(fs_mode_v) {
        fs_mode = json_str_value(fs_mode_v)
    }
    lines.push("fs mode: " + fs_mode + " (" + sbx_jstr_or(fs, "origin",
    "") + ")")
    let action: str = sbx_jstr_or(rep, "default_action", "")
    let action_res: Result[str, str] = default_action_text(action)
    if result_is_err(action_res) {
        return Result.Err(result_err_or(action_res, ""))
    }
    lines.push("default action: " + action + " — "
    + result_unwrap(action_res))
    lines.push("baseline: " + sbx_jstr_or(rep, "baseline", ""))
    let effects2: list[str] = sbx_jstrs(json_object_get(rep, "effects"))
    let layers: JsonValue = json_object_get(rep, "layers")
    let mut ei: int = 0
    while ei < effects2.len() {
        let eff: str = effects2.get(ei)
        let ents: list[str] = sbx_jstrs(json_object_get(layers, eff))
        let mut body: str = "(empty — " + eff + " carries no syscalls of its "
        + "own)"
        if ents.len() > 0 {
            body = join_strs(ents, ", ")
        }
        lines.push("layer " + eff + ": " + body)
        ei = ei + 1
    }
    let gate: JsonValue = json_object_get(rep, "gate")
    if json_is_object(gate) {
        let drifts: list[JsonValue] = json_object_get(gate, "drift").arr
        let unauds: list[JsonValue] = json_object_get(gate,
        "unauditable").arr
        let vios: list[JsonValue] = json_object_get(gate,
        "violations").arr
        lines.push("gate: " + sbx_jstr_or(gate, "yardstick", "?")
        + " (drift " + drifts.len().to_str() + ", unauditable "
        + unauds.len().to_str() + ", violations " + vios.len().to_str()
        + ")")
    }
    let denied: list[str] = sbx_jstrs(json_object_get(rep, "denied"))
    if denied.len() > 0 {
        lines.push("denied: " + join_strs(denied, ", "))
    }
    let extra: list[str] = sbx_jstrs(json_object_get(rep, "extra_allow"))
    if extra.len() > 0 {
        lines.push("extra allow: " + join_strs(extra, ", "))
    }
    let allow: JsonValue = json_object_get(rep, "allowlist")
    let prog_v: JsonValue = json_object_get(rep, "program")
    lines.push("allowlist (" + sbx_jstr_or(rep, "arch", "") + "): "
    + json_int_value(json_object_get(allow, "count")).to_str()
    + " syscalls, " + json_int_value(json_object_get(prog_v,
    "instructions")).to_str() + " BPF instructions")
    let cons_obj: JsonValue = json_object_get(allow, "constrained")
    let cnames: list[str] = []
    let mut ci: int = 0
    while ci < cons_obj.obj_keys.len() {
        cnames.push(cons_obj.obj_keys.get(ci))
        ci = ci + 1
    }
    let csorted: list[str] = sort_strs(cnames)
    let mut cj: int = 0
    while cj < csorted.len() {
        let nm: str = csorted.get(cj)
        lines.push("constrained: " + nm + json_str_value(
        json_object_get(cons_obj, nm)) + " — the write-intent mask")
        cj = cj + 1
    }
    let notes: list[str] = sbx_jstrs(json_object_get(rep, "absent_notes"))
    let mut nj: int = 0
    while nj < notes.len() {
        lines.push("note: " + notes.get(nj))
        nj = nj + 1
    }
    if with_bpf {
        lines.push("")
        lines.push("filter listing:")
        lines.push(disassemble_names(prog, name_nrs, name_names))
    }
    return Result.Ok(str_join(lines, "\n"))
}

# ============================================================================
# Part 12 — the selftest: the stage's pinned numbers, through the front
# door. 37 vectors, the .py's own labels, the .py's own order.
# ============================================================================

struct SelfAcc {
    passed: int,
    failed: int
}

fn st_check(acc: SelfAcc, cond: bool, msg: str) -> void uses IO {
    acc.passed = acc.passed + 1
    if cond {
        println("  [PASS] " + msg)
    } else {
        acc.failed = acc.failed + 1
        println("  [FAIL] " + msg)
    }
}

fn selftest() -> int uses IO, Fs, Proc, Args {
    let acc: SelfAcc = SelfAcc {
        passed: 0, failed: 0
    }
    println("hls-sandbox selftest — 0.129.0-alpha")

    # 1. the one vocabulary
    st_check(acc, all_effects().len() == 9, "the effect vocabulary is "
    + "hls-audit's (one set)")

    # 2. the fs census: every member of both sides is an Fs builtin in
    #    the one true table (the checker's own builtin_effect)
    let census: list[str] = []
    let fr: list[str] = fs_read_builtins()
    let mut fri: int = 0
    while fri < fr.len() {
        census.push(fr.get(fri))
        fri = fri + 1
    }
    let fw: list[str] = fs_write_builtins()
    let mut fwi: int = 0
    while fwi < fw.len() {
        census.push(fw.get(fwi))
        fwi = fwi + 1
    }
    let mut ci: int = 0
    while ci < census.len() {
        let beffs: list[str] = builtin_effect(census.get(ci))
        st_check(acc, beffs.len() == 1 && beffs.get(0) == "Fs",
        "fs census: " + census.get(ci) + " is an Fs builtin in the one "
        + "true table")
        ci = ci + 1
    }
    let mut overlap: bool = false
    let mut oi: int = 0
    while oi < fr.len() {
        if sg_has(fw, fr.get(oi)) {
            overlap = true
        }
        oi = oi + 1
    }
    st_check(acc, !overlap, "fs census: the read and write sides do not "
    + "overlap")

    # 3. the arch tables
    let rows: list[SysRow] = syscall_rows()
    let mut all_equal: bool = true
    let mut rri: int = 0
    while rri < rows.len() {
        if rows.get(rri).arm != rows.get(rri).riscv {
            all_equal = false
        }
        rri = rri + 1
    }
    st_check(acc, all_equal, "aarch64 and riscv64 share the asm-generic "
    + "numbering (every row)")
    let stat_x: Result[NrAns, str] = nr_of("stat", "x86_64")
    let stat_a: Result[NrAns, str] = nr_of("stat", "aarch64")
    st_check(acc, result_is_ok(stat_x)
    && result_unwrap(stat_x).nr == 4
    && result_is_ok(stat_a)
    && result_unwrap(stat_a).nr == -1,
    "plain stat exists on x86_64 only, with the recorded reason")
    let on_r: Result[NrAns, str] = nr_of("openat", "riscv64")
    st_check(acc, result_is_ok(on_r) && result_unwrap(on_r).nr == 56,
    "openat is 56 on the asm-generic arches")
    let sc_x: Result[NrAns, str] = nr_of("seccomp", "x86_64")
    st_check(acc, result_is_ok(sc_x) && result_unwrap(sc_x).nr == 317,
    "seccomp itself is 317 on x86_64")

    # 4. the layer invariant (strict) — every unmarked name on all arches
    let missing: list[str] = []
    let arches: list[str] = ["x86_64", "aarch64", "riscv64"]
    let effs: list[str] = all_effects()
    let mut ei: int = 0
    while ei < effs.len() {
        let ents: list[LayerEnt] = layer_entries(effs.get(ei))
        let mut li: int = 0
        while li < ents.len() {
            let mut ai2: int = 0
            while ai2 < arches.len() {
                let ans: Result[NrAns, str] = nr_of(ents.get(li).name,
                arches.get(ai2))
                if result_is_err(ans) {
                    missing.push(ents.get(li).name + "@" + arches.get(ai2))
                } else {
                    let a: NrAns = result_unwrap(ans)
                    if a.nr == -1 && a.note == "" {
                        missing.push(ents.get(li).name + "@"
                        + arches.get(ai2))
                    }
                }
                ai2 = ai2 + 1
            }
            li = li + 1
        }
        # the FsWrite layer rides the same invariant
        if effs.get(ei) == "Fs" {
            let fw2: list[LayerEnt] = layer_entries("FsWrite")
            let mut fi2: int = 0
            while fi2 < fw2.len() {
                let mut ai3: int = 0
                while ai3 < arches.len() {
                    let ans2: Result[NrAns, str] = nr_of(
                    fw2.get(fi2).name, arches.get(ai3))
                    if result_is_err(ans2) {
                        missing.push(fw2.get(fi2).name + "@"
                        + arches.get(ai3))
                    } else {
                        let a2: NrAns = result_unwrap(ans2)
                        if a2.nr == -1 && a2.note == "" {
                            missing.push(fw2.get(fi2).name + "@"
                            + arches.get(ai3))
                        }
                    }
                    ai3 = ai3 + 1
                }
                fi2 = fi2 + 1
            }
        }
        ei = ei + 1
    }
    st_check(acc, missing.len() == 0, "every layer syscall resolves (or "
    + "is absent with a reason) on all three arches")

    # 5. the flags-argument contract — the regression the kernel taught
    #    us: open's flags are arg1, openat's are arg2.
    let ofa_o: Result[int, str] = open_flags_arg("open")
    let ofa_t: Result[int, str] = open_flags_arg("openat")
    st_check(acc, result_is_ok(ofa_o) && result_unwrap(ofa_o) == 1
    && result_is_ok(ofa_t) && result_unwrap(ofa_t) == 2,
    "the write-intent mask reads open's arg1 and openat's arg2")
    let ro_res: Result[Profile, str] = profile_make(["Fs"], "ro",
    "selftest", "errno", "minimal", [], [])
    let ro: Profile = result_unwrap_or(ro_res, profile_bogus())
    let ro_rules_res: Result[list[Rule], str] = profile_rules(ro, "x86_64")
    let ro_rules: list[Rule] = result_unwrap_or(ro_rules_res, empty_rule_list())
    let ro_openat: Rule = rules_find_openat(ro_rules)
    st_check(acc, ro_openat.name == "openat"
    && ro_openat.cons_args.len() == 1
    && ro_openat.cons_args.get(0) == 2
    && ro_openat.cons_masks.get(0) == OPEN_WRITE_MASK(),
    "Fs(ro) masks openat's flags (arg2) with the write-intent mask")
    st_check(acc, ro_openat.name == "openat" && !ro_openat.uncond,
    "Fs(ro)'s openat is conditional — the mask is the rule")

    # 6. merge semantics: rw absorbs the ro justification
    let rw_res: Result[Profile, str] = profile_make(["Fs"], "rw",
    "selftest", "errno", "minimal", [], [])
    let rw: Profile = result_unwrap_or(rw_res, profile_bogus())
    let rw_rules_res: Result[list[Rule], str] = profile_rules(rw, "x86_64")
    let rw_rules: list[Rule] = result_unwrap_or(rw_rules_res, empty_rule_list())
    let rw_openat: Rule = rules_find_openat(rw_rules)
    st_check(acc, rw_openat.name == "openat" && rw_openat.uncond
    && rw_openat.cons_args.len() == 0,
    "Fs(rw)'s openat is unconditional (the rw justification absorbs "
    + "every read-only one)")

    # 7. pinned program shapes
    let pure_res: Result[Profile, str] = profile_make([], "",
    "selftest", "errno", "minimal", [], [])
    let pure_prof: Profile = result_unwrap_or(pure_res, profile_bogus())
    let prog_res: Result[Program, str] = profile_program(pure_prof, "x86_64")
    let prog: Program = result_unwrap_or(prog_res, empty_program())
    st_check(acc, prog_len(prog) == 29,
    "the pure minimal program is 29 instructions (pinned)")
    st_check(acc, prog_len(prog) > 3
    && instr_words_hex(prog.instrs.get(0)) == "2000000004000000"
    && instr_words_hex(prog.instrs.get(3)) == "2000000000000000",
    "the program opens arch-load, arch-guard, deny, nr-load")
    st_check(acc, prog_len(prog) > 1
    && prog.instrs.get(1).k == AUDIT_ARCH_X86_64(),
    "the arch guard pins AUDIT_ARCH_X86_64 on x86_64")
    let fhr_res: Result[Profile, str] = profile_make(["IO", "Fs"], "ro",
    "selftest", "errno", "hosted", [], [])
    let fhr: Profile = result_unwrap_or(fhr_res, profile_bogus())
    st_check(acc, result_is_ok(profile_program(fhr, "x86_64"))
    && prog_len(result_unwrap_or(profile_program(fhr, "x86_64"),
    empty_program())) == 93,
    "the IO+Fs(ro) hosted program is 93 instructions (pinned)")
    let fhw_res: Result[Profile, str] = profile_make(["IO", "Fs"], "rw",
    "selftest", "errno", "hosted", [], [])
    let fhw: Profile = result_unwrap_or(fhw_res, profile_bogus())
    st_check(acc, result_is_ok(profile_program(fhw, "x86_64"))
    && prog_len(result_unwrap_or(profile_program(fhw, "x86_64"),
    empty_program())) == 109,
    "the IO+Fs(rw) hosted program is 109 instructions (pinned)")
    let fr_rules_res: Result[list[Rule], str] = profile_rules(fhr,
    "x86_64")
    let fw_rules_res: Result[list[Rule], str] = profile_rules(fhw,
    "x86_64")
    st_check(acc, result_is_ok(fr_rules_res)
    && result_is_ok(fw_rules_res)
    && result_unwrap(fr_rules_res).len() == 41
    && result_unwrap(fw_rules_res).len() == 52,
    "ro allows 41 syscalls, rw 52 (pinned)")

    # 8. determinism
    let p1_res: Result[Program, str] = profile_program(fhr, "x86_64")
    let p2_res: Result[Program, str] = profile_program(fhr, "x86_64")
    let mut det: bool = false
    if result_is_ok(p1_res) && result_is_ok(p2_res) {
        det = prog_bytes_hex(result_unwrap(p1_res))
        == prog_bytes_hex(result_unwrap(p2_res))
    }
    st_check(acc, det, "assembly is deterministic (same rules, same "
    + "bytes)")

    # 9. the disassembler round-trips the arch guard
    let txt: str = disassemble(prog)
    let tlines: list[str] = txt.split("\n")
    st_check(acc, tlines.len() > 1
    && tlines.get(0).contains("ld     arch")
    && tlines.get(1).contains("jeq"),
    "the disassembler renders the fixed shape")

    # 10. refusals
    st_check(acc, result_is_err(profile_make(["Bogus"], "",
    "selftest", "errno", "hosted", [], [])),
    "an unknown effect is refused")
    st_check(acc, result_is_err(profile_make(["IO"], "",
    "selftest", "vaporize", "hosted", [], [])),
    "an unknown default action is refused")
    st_check(acc, result_is_err(profile_make(["IO"], "",
    "selftest", "errno", "hosted", [], ["exit_group"])),
    "deny on exit_group is refused (the hang rule)")
    st_check(acc, result_is_ok(profile_make(["IO"], "",
    "selftest", "errno", "hosted", [], ["execve"])),
    "deny on execve builds (the shim's profile)")

    # 11. the jump-range refusal — the assembler's own guard, driven
    #     directly (a profile that large cannot be built from the
    #     current tables, and the guard is the mechanism, so the vector
    #     goes to the mechanism).
    let big: Asm = asm_new()
    let bl: Result[int, str] = asm_load(big, OFF_NR())
    let mut big_ok: bool = result_is_ok(bl)
    let mut bi2: int = 0
    while bi2 < 300 {
        let bj: Result[int, str] = asm_jeq(big, bi2, "far" + bi2.to_str())
        if result_is_err(bj) {
            big_ok = false
        }
        bi2 = bi2 + 1
    }
    let br: Result[int, str] = asm_ret(big, SECCOMP_RET_ALLOW())
    if result_is_err(br) {
        big_ok = false
    }
    let mut bl2: int = 0
    while bl2 < 300 {
        asm_label(big, "far" + bl2.to_str())
        let br2: Result[int, str] = asm_ret(big, SECCOMP_RET_ALLOW())
        if result_is_err(br2) {
            big_ok = false
        }
        bl2 = bl2 + 1
    }
    let fin: Result[Program, str] = asm_finish(big)
    let mut over_msg: str = ""
    if result_is_err(fin) {
        over_msg = result_err_or(fin, "")
    }
    st_check(acc, big_ok && result_is_err(fin)
    && (over_msg.contains("8-bit") || over_msg.contains("too large")),
    "an over-range jump is refused, not truncated ("
    + clip_chars(over_msg, 40) + ")")
    let okasm: Asm = asm_new()
    let ol: Result[int, str] = asm_load(okasm, OFF_NR())
    let oj: Result[int, str] = asm_jeq(okasm, 1, "one")
    let re: Result[int, str] = ret_errno(1)
    let orr: Result[int, str] = asm_ret(okasm, result_unwrap_or(re, 0))
    asm_label(okasm, "one")
    let orr2: Result[int, str] = asm_ret(okasm, SECCOMP_RET_ALLOW())
    let small_res: Result[Program, str] = asm_finish(okasm)
    let small_ok: bool = result_is_ok(ol) && result_is_ok(oj)
    && result_is_ok(orr) && result_is_ok(orr2)
    && result_is_ok(small_res)
    let mut jt_ok: bool = false
    let mut jf_ok: bool = false
    if small_ok {
        let small: Program = result_unwrap(small_res)
        jt_ok = small.instrs.get(1).jt == 1
        jf_ok = small.instrs.get(1).jf == 0
    }
    st_check(acc, small_ok && jt_ok && jf_ok,
    "a resolved jump is relative to the NEXT instruction (jeq -> +1 "
    + "lands two down)")

    # 12. the manifest section
    let bad1: TomlVal = toml_table()
    let b1sec: TomlVal = toml_table()
    toml_set(b1sec, "default", toml_bare_value("teleport"))
    toml_set(bad1, "sandbox", b1sec)
    st_check(acc, result_is_err(parse_sandbox_section(bad1)),
    "[sandbox] default is validated")
    let bad2: TomlVal = toml_table()
    let b2sec: TomlVal = toml_table()
    let b2list: TomlVal = TomlVal {
        kind: "list", sval: "", ival: 0, bval: false, keys: [],
        vals: [toml_bare_value("not_a_syscall")]
    }
    toml_set(b2sec, "allow", b2list)
    toml_set(bad2, "sandbox", b2sec)
    st_check(acc, result_is_err(parse_sandbox_section(bad2)),
    "[sandbox] allow names are validated")
    let ok_sec_man: TomlVal = toml_table()
    let ok_sec: TomlVal = toml_table()
    toml_set(ok_sec, "fs", toml_bare_value("ro"))
    let ok_list: TomlVal = TomlVal {
        kind: "list", sval: "", ival: 0, bval: false, keys: [],
        vals: [toml_bare_value("kill")]
    }
    toml_set(ok_sec, "deny", ok_list)
    toml_set(ok_sec_man, "sandbox", ok_sec)
    let ok_parsed: Result[SandboxSec, str] = parse_sandbox_section(
    ok_sec_man)
    st_check(acc, result_is_ok(ok_parsed)
    && result_unwrap(ok_parsed).fs == "ro"
    && result_unwrap(ok_parsed).deny.len() == 1,
    "[sandbox] parses the tightening knobs")

    # 13. the ELF static probe
    st_check(acc, !is_static_elf("/bin/sh"),
    "the ELF probe reads /bin/sh as dynamic")

    println("hls-sandbox selftest: " + acc.passed.to_str() + " passed / "
    + acc.failed.to_str() + " failed")
    if acc.failed == 0 {
        return 0
    }
    return 1
}

# profile_bogus() — a syntactically valid Profile for the selftest's
# unwrap_or fallbacks (the branches that use it are FAILING vectors; the
# checks read empty data off it and fail loudly, never panic).
fn profile_bogus() -> Profile {
    return Profile {
        effects: [], fs_mode: "", fs_origin: "", default_action: "errno",
        baseline: "minimal", extra_allow: [], deny: [], notes: []
    }
}

fn empty_program() -> Program {
    return Program {
        instrs: []
    }
}

fn empty_rule_list() -> list[Rule] {
    return[]
}

# rules_find_openat(rules) — the openat rule (blank when absent).
fn rules_find_openat(rules: list[Rule]) -> Rule {
    let mut i: int = 0
    while i < rules.len() {
        if rules.get(i).name == "openat" {
            return rules.get(i)
        }
        i = i + 1
    }
    return rule_new("", -1)
}

# ============================================================================
# Part 13 — the CLI: the .py's argparse grammar, the three profile modes
# (source / package / ad-hoc), and the command dispatch.
# ============================================================================

# usage_doc() — the .py's module docstring, byte for byte (the family
# keeps the .py's own usage text; hlprove's law).
fn usage_doc() -> str {
    return "hls-sandbox — sandboxed execution, seccomp-bpf (Stage 110).\n"
    + "\n"
    + "Usage:\n"
    + "  python3 tools/hls-sandbox.py profile <entry.hls> [flags]\n"
    + "  python3 tools/hls-sandbox.py profile --pkg DIR [flags]\n"
    + "  python3 tools/hls-sandbox.py run [--pkg DIR | --effects IO,Fs "
    + "| <entry.hls>]\n"
    + "                                    [flags] -- CMD [ARGS...]\n"
    + "  python3 tools/hls-sandbox.py emit [--pkg DIR | --effects ... | "
    + "<entry.hls>]\n"
    + "                                    [--arch "
    + "x86_64|aarch64|riscv64] [--out FILE]\n"
    + "  python3 tools/hls-sandbox.py release --pkg DIR [--out DIR]\n"
    + "  python3 tools/hls-sandbox.py verify-release --pkg DIR\n"
    + "  python3 tools/hls-sandbox.py selftest\n"
    + "\n"
    + "The effect system says what a program MAY do; the audit says what\n"
    + "the supply chain DECLARES; this tool makes the kernel hold the\n"
    + "line. A profile is DERIVED (the checker's own computed surface —\n"
    + "source mode; the root package's audited surface — package mode) or\n"
    + "STATED (--effects, the ad-hoc spelling), compiled to a seccomp-bpf\n"
    + "filter, and then either installed by the launcher around a command\n"
    + "(`run`) or emitted as a C shim a binary compiles into itself\n"
    + "(`emit`).\n"
    + "\n"
    + "The Fs read/write split: a tree whose reachable builtin census is\n"
    + "read-only arms `open`/`openat` under a write-intent argument mask —\n"
    + "the kernel refuses to open for writing. One write-side builtin or\n"
    + "one opaque `extern` declaring Fs, and the derived mode is honestly\n"
    + "rw. `--fs ro` tightens; `--fs rw` widens (the report says so).\n"
    + "\n"
    + "Package mode is fail-closed, in the family's order: drift, then\n"
    + "unauditable, then the [effects] policy gate — a tree that fails its\n"
    + "own audit does not get armed (the audit is the gate; the\n"
    + "sandbox is the enforcement). --effects overrides the GATE's\n"
    + "yardstick (the hls-audit --allow spelling); --no-gate skips it\n"
    + "for local triage.\n"
    + "\n"
    + "Flags:\n"
    + "  --fs ro|rw            the fs mode (default: derived)\n"
    + "  --default errno|kill|trap|log   the denial posture (default "
    + "errno)\n"
    + "  --strict              --default kill, spelled the way people say "
    + "it\n"
    + "  --baseline auto|minimal|hosted  minimal = a static artifact's "
    + "set;\n"
    + "                        hosted adds the dynamic loader/libc "
    + "prologue;\n"
    + "                        auto reads the target ELF (run mode)\n"
    + "  --allow-sysc A,B      extra syscalls by name (the CLI spelling "
    + "of\n"
    + "                        [sandbox] allow)\n"
    + "  --deny-sysc A,B       carve-outs by name (exit/exit_group/brk "
    + "are\n"
    + "                        not deniable; execve denial needs the "
    + "shim)\n"
    + "  --json                machine-readable report (profile / run)\n"
    + "  --bpf                 profile: also print the filter listing\n"
    + "  --no-gate             package mode: skip the audit gate\n"
    + "\n"
    + "Exit contract: 0 success (for `run`: the artifact's own code is\n"
    + "passed through); 1 policy/audit/release failures and selftest\n"
    + "failures; 2 usage errors. The run contract extends the shell's:\n"
    + "125 the sandbox could not be armed, 126 cannot execute, 127 not\n"
    + "found — and SIGSYS (observed as 159 = 128+31) is the kill-mode\n"
    + "denial.\n"
}

# Refusal — the .py's exception taxonomy: Usage (exit 2) vs PolicyError /
# ReleaseError / AuditError (exit 1).
struct Refusal {
    msg: str,
    usage: bool
}

fn refuse(msg: str) -> Refusal {
    return Refusal {
        msg: msg, usage: false
    }
}

fn refuse_usage(msg: str) -> Refusal {
    return Refusal {
        msg: msg, usage: true
    }
}

# Cli — the parsed command line.
struct Cli {
    cmd: str,
    entry: str,
    has_entry: bool,
    pkg: str,
    has_pkg: bool,
    effects: str,
    has_effects: bool,
    fs: str,
    has_fs: bool,
    default_action: str,
    has_default: bool,
    strict: bool,
    baseline: str,
    allow_sysc: str,
    has_allow_sysc: bool,
    deny_sysc: str,
    has_deny_sysc: bool,
    no_gate: bool,
    json: bool,
    bpf: bool,
    arch: str,
    has_arch: bool,
    out: str,
    has_out: bool,
    quiet: bool,
    tail: list[str]
}

fn cli_new(cmd: str) -> Cli {
    return Cli {
        cmd: cmd, entry: "", has_entry: false, pkg: "", has_pkg: false,
        effects: "", has_effects: false, fs: "", has_fs: false,
        default_action: "", has_default: false, strict: false,
        baseline: "auto", allow_sysc: "", has_allow_sysc: false,
        deny_sysc: "", has_deny_sysc: false, no_gate: false, json: false,
        bpf: false, arch: "", has_arch: false, out: "", has_out: false,
        quiet: false, tail: []
    }
}

# cli_flag_allowed(cmd, flag) — the per-subcommand flag sets (argparse's
# own grammar: each subparser owns its flags).
fn cli_flag_allowed(cmd: str, flag: str) -> bool {
    # the common set (profile / run / emit)
    let common: list[str] = ["--pkg", "--effects", "--fs", "--default",
    "--strict", "--baseline", "--allow-sysc", "--deny-sysc", "--no-gate",
    "--json"]
    if cmd == "profile" || cmd == "run" || cmd == "emit" {
        if sg_has(common, flag) {
            return true
        }
        if cmd == "profile" {
            return flag == "--bpf" || flag == "--arch"
        }
        if cmd == "run" {
            return flag == "--quiet"
        }
        return flag == "--arch" || flag == "--out"
    }
    if cmd == "release" {
        return flag == "--pkg" || flag == "--out"
    }
    if cmd == "verify-release" {
        return flag == "--pkg"
    }
    return false
}

# parse_effects(raw) — the ad-hoc surface spelling; (list, has) — an
# all-empty spelling is the .py's None.
fn parse_effects(raw: str) -> Result[list[str], str] {
    let out: list[str] = []
    let parts: list[str] = raw.split(",")
    let mut i: int = 0
    while i < parts.len() {
        let x: str = parts.get(i).trim()
        if x == "" {
            i = i + 1
            continue
        }
        if !sg_has(all_effects(), x) {
            return Result.Err("unknown effect: " + x
            + " (the audit's vocabulary: " + join_strs(all_effects(), ", ")
            + ")")
        }
        out.push(x)
        i = i + 1
    }
    return Result.Ok(out)
}

# parse_sysc(raw, what) — the --allow-sysc / --deny-sysc spelling.
fn parse_sysc(raw: str, what: str) -> Result[list[str], str] {
    let out: list[str] = []
    let parts: list[str] = raw.split(",")
    let mut i: int = 0
    while i < parts.len() {
        let x: str = parts.get(i).trim()
        if x == "" {
            i = i + 1
            continue
        }
        let known: Result[SysRow, str] = sys_row_of(x)
        if result_is_err(known) {
            return Result.Err("unknown syscall in --" + what + ": " + x
            + " (known: " + join_strs(syscall_names_sorted(), ", ") + ")")
        }
        out.push(x)
        i = i + 1
    }
    return Result.Ok(out)
}

# parse_cli(argv) — the manual argparse. The "--" split happened in
# main (the .py split the RAW argv at the FIRST -- so the command's own
# flags are never parsed as ours).
fn parse_cli(argv: list[str]) -> Result[Cli, str] {
    if argv.len() < 2 {
        return Result.Err("no command")
    }
    let cmd: str = argv.get(1)
    let known_cmds: list[str] = ["profile", "run", "emit", "release",
    "verify-release", "selftest"]
    if !sg_has(known_cmds, cmd) {
        return Result.Err("unknown command: " + cmd)
    }
    let cli: Cli = cli_new(cmd)
    let takes_entry: bool = cmd == "profile" || cmd == "run"
    || cmd == "emit"
    let value_flags: list[str] = ["--pkg", "--effects", "--fs",
    "--default", "--baseline", "--allow-sysc", "--deny-sysc", "--arch",
    "--out"]
    let bool_flags: list[str] = ["--strict", "--no-gate", "--json",
    "--bpf", "--quiet"]
    let mut i: int = 2
    while i < argv.len() {
        let a: str = argv.get(i)
        if a == "-h" || a == "--help" {
            return Result.Err("HELP")
        }
        if a.starts_with("--") {
            if !cli_flag_allowed(cmd, a) {
                return Result.Err("unrecognized argument: " + a)
            }
            if sg_has(bool_flags, a) {
                if a == "--strict" {
                    cli.strict = true
                }
                if a == "--no-gate" {
                    cli.no_gate = true
                }
                if a == "--json" {
                    cli.json = true
                }
                if a == "--bpf" {
                    cli.bpf = true
                }
                if a == "--quiet" {
                    cli.quiet = true
                }
                i = i + 1
                continue
            }
            if !sg_has(value_flags, a) {
                return Result.Err("unrecognized argument: " + a)
            }
            if i + 1 >= argv.len() {
                return Result.Err("argument " + a + ": expected one "
                + "argument")
            }
            let v: str = argv.get(i + 1)
            if a == "--pkg" {
                cli.pkg = v
                cli.has_pkg = true
            }
            if a == "--effects" {
                cli.effects = v
                cli.has_effects = true
            }
            if a == "--fs" {
                if v != "ro" && v != "rw" {
                    return Result.Err("argument --fs: invalid choice: "
                    + py_repr_str(v) + " (choose from 'ro', 'rw')")
                }
                cli.fs = v
                cli.has_fs = true
            }
            if a == "--default" {
                if !sg_has(default_action_names(), v) {
                    return Result.Err("argument --default: invalid "
                    + "choice: " + py_repr_str(v) + " (choose from "
                    + join_strs(sort_strs(default_action_names()), ", ")
                    + ")")
                }
                cli.default_action = v
                cli.has_default = true
            }
            if a == "--baseline" {
                if v != "auto" && v != "minimal" && v != "hosted" {
                    return Result.Err("argument --baseline: invalid "
                    + "choice: " + py_repr_str(v)
                    + " (choose from 'auto', 'hosted', 'minimal')")
                }
                cli.baseline = v
            }
            if a == "--allow-sysc" {
                cli.allow_sysc = v
                cli.has_allow_sysc = true
            }
            if a == "--deny-sysc" {
                cli.deny_sysc = v
                cli.has_deny_sysc = true
            }
            if a == "--arch" {
                if v != "x86_64" && v != "aarch64" && v != "riscv64" {
                    return Result.Err("argument --arch: invalid choice: "
                    + py_repr_str(v) + " (choose from 'aarch64', "
                    + "'riscv64', 'x86_64')")
                }
                cli.arch = v
                cli.has_arch = true
            }
            if a == "--out" {
                cli.out = v
                cli.has_out = true
            }
            i = i + 2
            continue
        }
        # a positional: the entry file (profile / run / emit only)
        if !takes_entry {
            return Result.Err("unrecognized argument: " + a)
        }
        if cli.has_entry {
            return Result.Err("unrecognized argument: " + a)
        }
        cli.entry = a
        cli.has_entry = true
        i = i + 1
    }
    return Result.Ok(cli)
}

# BuildOut — build_profile's answer.
struct BuildOut {
    profile: Profile,
    mode: str,
    root: str,
    has_root: bool,
    deriv: Deriv,
    has_deriv: bool,
    gate: GateRep,
    yardstick: str,
    has_gate: bool
}

# baseline_choice(requested, target, has_target) — --baseline auto reads
# the target ELF (run mode); anything unparseable gets hosted (the safe
# default is the wider baseline).
fn baseline_choice(requested: str, target: str, has_target: bool) -> str
uses Fs {
    if requested != "auto" {
        return requested
    }
    if has_target && is_file_h(target) {
        if is_static_elf(target) {
            return "minimal"
        }
        return "hosted"
    }
    return "hosted"
}

# build_profile(cli, target, has_target) — resolve the mode, derive or
# state the surface, apply the overrides.
fn build_profile(cli: Cli, target: str, has_target: bool)
-> Result[BuildOut, Refusal] uses Fs, Proc, Args {
    # the default posture
    let mut default_action: str = "errno"
    if cli.strict {
        default_action = "kill"
    } else {
        if cli.has_default {
            default_action = cli.default_action
        }
    }
    # the syscall overrides
    let mut allow: list[str] = []
    if cli.has_allow_sysc {
        let ar: Result[list[str], str] = parse_sysc(cli.allow_sysc,
        "allow-sysc")
        if result_is_err(ar) {
            return Result.Err(refuse(result_err_or(ar, "")))
        }
        allow = result_unwrap(ar)
    }
    let mut deny: list[str] = []
    if cli.has_deny_sysc {
        let dr: Result[list[str], str] = parse_sysc(cli.deny_sysc,
        "deny-sysc")
        if result_is_err(dr) {
            return Result.Err(refuse(result_err_or(dr, "")))
        }
        deny = result_unwrap(dr)
    }
    let baseline: str = baseline_choice(cli.baseline, target, has_target)
    let fs: str = cli.fs

    # -- package mode: gate, then derive the root entry -----------------
    if cli.has_pkg {
        let pkg_dir: str = realpath_lex(cli.pkg)
        let manifest_path: str = path_join2(pkg_dir, manifest_name())
        if !is_file_h(manifest_path) {
            return Result.Err(refuse("no " + manifest_name() + " in "
            + pkg_dir))
        }
        let mr: Result[TomlVal, str] = parse_manifest(manifest_path)
        if result_is_err(mr) {
            return Result.Err(refuse("manifest " + manifest_path + ": "
            + result_err_or(mr, "")))
        }
        let manifest: TomlVal = result_unwrap(mr)
        let sec_res: Result[SandboxSec, str] = parse_sandbox_section(
        manifest)
        if result_is_err(sec_res) {
            return Result.Err(refuse(result_err_or(sec_res, "")))
        }
        let sbx: SandboxSec = result_unwrap(sec_res)

        let out: BuildOut = BuildOut {
            profile: profile_bogus(), mode: "package", root: pkg_dir,
            has_root: true, deriv: deriv_none(), has_deriv: false,
            gate: GateRep {
                drift: [], unauditable: [], violations: [],
                lockfile: "absent", manifest_allowed: [],
                has_manifest_allowed: false, packages: []
            },
            yardstick: "", has_gate: false
        }
        if !cli.no_gate {
            # --effects is the gate's yardstick override
            let mut allow_eff: list[str] = []
            let mut has_allow_eff: bool = false
            if cli.has_effects {
                let er: Result[list[str], str] = parse_effects(
                cli.effects)
                if result_is_err(er) {
                    return Result.Err(refuse(result_err_or(er, "")))
                }
                allow_eff = result_unwrap(er)
                has_allow_eff = allow_eff.len() > 0
            }
            let gr: Result[GateRep, str] = sbx_audit_gate(pkg_dir)
            if result_is_err(gr) {
                return Result.Err(refuse(result_err_or(gr, "")))
            }
            out.gate = result_unwrap(gr)
            out.has_gate = true
            if out.gate.drift.len() > 0 {
                let names: list[str] = []
                let mut di: int = 0
                while di < out.gate.drift.len() {
                    sg_push_unique(names, out.gate.drift.get(di).package)
                    di = di + 1
                }
                return Result.Err(refuse(
                "drift between the lockfile and the tree ("
                + join_strs(sort_strs(names), ", ")
                + ") — re-lock; the sandbox arms named content"))
            }
            if out.gate.unauditable.len() > 0 {
                let names2: list[str] = []
                let mut ui: int = 0
                while ui < out.gate.unauditable.len() {
                    sg_push_unique(names2, out.gate.unauditable.get(ui)
                    .package)
                    ui = ui + 1
                }
                return Result.Err(refuse("unauditable package(s) in the "
                + "tree (" + join_strs(sort_strs(names2), ", ")
                + ") — fail closed"))
            }
            # the yardstick: --effects, else the manifest's own policy
            let mut allowed: list[str] = []
            let mut has_allowed: bool = false
            if has_allow_eff {
                out.yardstick = "--effects"
                allowed = allow_eff
                has_allowed = true
            } else {
                if out.gate.has_manifest_allowed {
                    allowed = out.gate.manifest_allowed
                    has_allowed = true
                    out.yardstick = "manifest [effects].allowed"
                } else {
                    out.yardstick = "(none)"
                }
            }
            if has_allowed {
                let mut bad: list[VioEnt] = []
                let mut vi: int = 0
                while vi < out.gate.violations.len() {
                    if !sg_has(allowed, out.gate.violations.get(vi)
                    .effect) {
                        bad.push(out.gate.violations.get(vi))
                    }
                    vi = vi + 1
                }
                if bad.len() > 0 {
                    let texts: list[str] = []
                    let mut bi: int = 0
                    while bi < bad.len() {
                        texts.push(bad.get(bi).effect + " via "
                        + bad.get(bi).package)
                        bi = bi + 1
                    }
                    return Result.Err(refuse(
                    "the tree violates its own policy: "
                    + join_strs(texts, ", ")
                    + " — the audit gate failed; a sandbox must not "
                    + "paper over it"))
                }
            }
        }
        let entry_res: Result[str, str] = sbx_resolve_entry(pkg_dir,
        manifest)
        if result_is_err(entry_res) {
            return Result.Err(refuse(result_err_or(entry_res, "")))
        }
        let deriv_res: Result[Deriv, str] = derive_source(result_unwrap(
        entry_res))
        if result_is_err(deriv_res) {
            return Result.Err(refuse(result_err_or(deriv_res, "")))
        }
        let deriv: Deriv = result_unwrap(deriv_res)
        out.deriv = deriv
        out.has_deriv = true
        # fs: --fs, else [sandbox] fs, else the derivation
        # (the .py: fs_mode = fs or sbx["fs"] or deriv["fs_mode"])
        let mut fs_mode: str = deriv.fs_mode
        if sbx.fs != "" {
            fs_mode = sbx.fs
        }
        if fs != "" {
            fs_mode = fs
        }
        let mut fs_origin: str = deriv.fs_origin
        if fs != "" {
            fs_origin = "--fs"
        } else {
            if sbx.fs != "" && sbx.fs != deriv.fs_mode {
                let mut derived_name: str = "none"
                if deriv.fs_mode != "" {
                    derived_name = deriv.fs_mode
                }
                fs_origin = "manifest [sandbox] fs (tightens the derived "
                + derived_name + ")"
            }
        }
        let mut da: str = sbx.default
        if da == "" {
            da = default_action
        }
        let mut extra: list[str] = allow
        if extra.len() == 0 {
            extra = sbx.allow
        }
        let mut deny2: list[str] = deny
        if deny2.len() == 0 {
            deny2 = sbx.deny
        }
        let prof_res: Result[Profile, str] = profile_make(deriv.effects,
        fs_mode, fs_origin, da, baseline, extra, deny2)
        if result_is_err(prof_res) {
            return Result.Err(refuse(result_err_or(prof_res, "")))
        }
        out.profile = result_unwrap(prof_res)
        return Result.Ok(out)
    }

    # -- source mode: the checker is the oracle --------------------------
    if cli.has_entry {
        if cli.has_effects {
            return Result.Err(refuse("--effects is the ad-hoc spelling "
            + "— an entry file's surface is its checker's answer, not a "
            + "claim; drop the file or drop the flag"))
        }
        let deriv_res: Result[Deriv, str] = derive_source(cli.entry)
        if result_is_err(deriv_res) {
            return Result.Err(refuse(result_err_or(deriv_res, "")))
        }
        let deriv: Deriv = result_unwrap(deriv_res)
        let mut fs_mode: str = deriv.fs_mode
        if fs != "" {
            fs_mode = fs
        }
        let mut fs_origin: str = deriv.fs_origin
        if fs != "" {
            fs_origin = "--fs"
        }
        let prof_res: Result[Profile, str] = profile_make(deriv.effects,
        fs_mode, fs_origin, default_action, baseline, allow, deny)
        if result_is_err(prof_res) {
            return Result.Err(refuse(result_err_or(prof_res, "")))
        }
        let out2: BuildOut = BuildOut {
            profile: result_unwrap(prof_res), mode: "source",
            root: cli.entry, has_root: true, deriv: deriv,
            has_deriv: true,
            gate: GateRep {
                drift: [], unauditable: [], violations: [],
                lockfile: "absent", manifest_allowed: [],
                has_manifest_allowed: false, packages: []
            },
            yardstick: "", has_gate: false
        }
        return Result.Ok(out2)
    }

    # -- ad-hoc: the operator states the surface -------------------------
    if cli.has_effects {
        let er: Result[list[str], str] = parse_effects(cli.effects)
        if result_is_err(er) {
            return Result.Err(refuse(result_err_or(er, "")))
        }
        let effects: list[str] = result_unwrap(er)
        let mut fs_mode: str = ""
        if fs == "" && sg_has(effects, "Fs") {
            fs_mode = "rw" # no census to lean on — the honest floor
        }
        if fs != "" {
            fs_mode = fs
        }
        let mut fs_origin: str = "no Fs in the stated surface"
        if fs_mode != "" {
            fs_origin = "--fs"
        }
        let prof_res: Result[Profile, str] = profile_make(effects,
        fs_mode, fs_origin, default_action, baseline, allow, deny)
        if result_is_err(prof_res) {
            return Result.Err(refuse(result_err_or(prof_res, "")))
        }
        let out3: BuildOut = BuildOut {
            profile: result_unwrap(prof_res), mode: "adhoc", root: "",
            has_root: false, deriv: deriv_none(), has_deriv: false,
            gate: GateRep {
                drift: [], unauditable: [], violations: [],
                lockfile: "absent", manifest_allowed: [],
                has_manifest_allowed: false, packages: []
            },
            yardstick: "", has_gate: false
        }
        return Result.Ok(out3)
    }

    return Result.Err(refuse_usage("nothing to derive or state: give an "
    + "entry file, --pkg DIR, or --effects E1,E2"))
}

# profile_to_report(profile, arch, mode, root, has_root, deriv, has_deriv,
# gate, yardstick, has_gate) — the JSON report (schema hls-sandbox/v1).
fn profile_to_report(profile: Profile, arch: str, mode: str, root: str,
has_root: bool, deriv: Deriv, has_deriv: bool, gate: GateRep,
yardstick: str, has_gate: bool) -> Result[JsonValue, str] {
    let rules_res: Result[list[Rule], str] = profile_rules(profile, arch)
    if result_is_err(rules_res) {
        return Result.Err(result_err_or(rules_res, ""))
    }
    let rules: list[Rule] = result_unwrap(rules_res)
    let prog_res: Result[Program, str] = profile_program(profile, arch)
    if result_is_err(prog_res) {
        return Result.Err(result_err_or(prog_res, ""))
    }
    let prog: Program = result_unwrap(prog_res)

    let rep: JsonValue = json_object([], [])
    sbx_obj_set(rep, "schema", json_str(SCHEMA_PROFILE()))
    sbx_obj_set(rep, "mode", json_str(mode))
    if has_root {
        sbx_obj_set(rep, "root", json_str(root))
    } else {
        sbx_obj_set(rep, "root", json_null())
    }
    sbx_obj_set(rep, "arch", json_str(arch))
    sbx_obj_set(rep, "effects", sbx_json_list_str(profile.effects))
    let fs_obj: JsonValue = json_object([], [])
    if profile.fs_mode == "" {
        sbx_obj_set(fs_obj, "mode", json_null())
    } else {
        sbx_obj_set(fs_obj, "mode", json_str(profile.fs_mode))
    }
    sbx_obj_set(fs_obj, "origin", json_str(profile.fs_origin))
    sbx_obj_set(rep, "fs", fs_obj)
    sbx_obj_set(rep, "default_action", json_str(profile.default_action))
    sbx_obj_set(rep, "baseline", json_str(profile.baseline))
    # the layers
    let layers: JsonValue = json_object([], [])
    let mut ei: int = 0
    while ei < profile.effects.len() {
        let eff: str = profile.effects.get(ei)
        let ents: list[LayerEnt] = layer_entries(eff)
        let names: list[str] = []
        let mut li: int = 0
        while li < ents.len() {
            names.push(layer_display(ents.get(li)))
            li = li + 1
        }
        sbx_obj_set(layers, eff, sbx_json_list_str(names))
        ei = ei + 1
    }
    sbx_obj_set(rep, "layers", layers)
    # the allowlist
    let allow_names: list[str] = []
    let cons_obj: JsonValue = json_object([], [])
    let mut ri: int = 0
    while ri < rules.len() {
        allow_names.push(rules.get(ri).name)
        let cons: str = rule_cons_text(rules.get(ri))
        if cons != "" {
            sbx_obj_set(cons_obj, rules.get(ri).name, json_str(cons))
        }
        ri = ri + 1
    }
    let allow_obj: JsonValue = json_object([], [])
    sbx_obj_set(allow_obj, "count", json_int(rules.len()))
    sbx_obj_set(allow_obj, "syscalls", sbx_json_list_str(sort_strs(
    allow_names)))
    sbx_obj_set(allow_obj, "constrained", cons_obj)
    sbx_obj_set(rep, "allowlist", allow_obj)
    sbx_obj_set(rep, "denied", sbx_json_list_str(profile.deny))
    sbx_obj_set(rep, "extra_allow", sbx_json_list_str(profile.extra_allow))
    sbx_obj_set(rep, "absent_notes", sbx_json_list_str(sg_sorted_unique(
    profile.notes)))
    let prog_obj: JsonValue = json_object([], [])
    sbx_obj_set(prog_obj, "instructions", json_int(prog_len(prog)))
    sbx_obj_set(rep, "program", prog_obj)
    if has_deriv {
        let d: JsonValue = json_object([], [])
        sbx_obj_set(d, "scope", json_str(deriv.scope))
        sbx_obj_set(d, "effects", sbx_json_list_str(deriv.effects))
        sbx_obj_set(d, "builtins", sbx_json_list_str(deriv.builtins))
        sbx_obj_set(d, "extern_effects", sbx_json_list_str(
        deriv.extern_effects))
        if deriv.fs_mode == "" {
            sbx_obj_set(d, "fs_mode", json_null())
        } else {
            sbx_obj_set(d, "fs_mode", json_str(deriv.fs_mode))
        }
        sbx_obj_set(d, "fs_origin", json_str(deriv.fs_origin))
        sbx_obj_set(rep, "derivation", d)
    }
    if has_gate {
        let g: JsonValue = json_object([], [])
        let drift_arr: JsonValue = json_array([])
        let mut di: int = 0
        while di < gate.drift.len() {
            let dobj: JsonValue = json_object([], [])
            sbx_obj_set(dobj, "package", json_str(gate.drift.get(di)
            .package))
            sbx_obj_set(dobj, "why", json_str(gate.drift.get(di).why))
            drift_arr.arr.push(dobj)
            di = di + 1
        }
        sbx_obj_set(g, "drift", drift_arr)
        sbx_obj_set(g, "lockfile", json_str(gate.lockfile))
        let unaud_arr: JsonValue = json_array([])
        let mut ui: int = 0
        while ui < gate.unauditable.len() {
            let uobj: JsonValue = json_object([], [])
            sbx_obj_set(uobj, "package", json_str(gate.unauditable.get(ui)
            .package))
            sbx_obj_set(uobj, "why", json_str(gate.unauditable.get(ui)
            .why))
            unaud_arr.arr.push(uobj)
            ui = ui + 1
        }
        sbx_obj_set(g, "unauditable", unaud_arr)
        sbx_obj_set(g, "yardstick", json_str(yardstick))
        let vio_arr: JsonValue = json_array([])
        let mut vi: int = 0
        while vi < gate.violations.len() {
            let vobj: JsonValue = json_object([], [])
            sbx_obj_set(vobj, "chain", sbx_json_list_str(
            gate.violations.get(vi).chain))
            sbx_obj_set(vobj, "effect", json_str(gate.violations.get(vi)
            .effect))
            sbx_obj_set(vobj, "package", json_str(gate.violations.get(vi)
            .package))
            vio_arr.arr.push(vobj)
            vi = vi + 1
        }
        sbx_obj_set(g, "violations", vio_arr)
        sbx_obj_set(rep, "gate", g)
    }
    return Result.Ok(rep)
}

# cmd_profile — derive and print the profile.
fn cmd_profile(cli: Cli) -> Result[int, Refusal] uses IO, Fs, Proc, Args {
    let build_res: Result[BuildOut, Refusal] = build_profile(cli, "",
    false)
    if result_is_err(build_res) {
        return Result.Err(result_err_or(build_res, refuse_usage("")))
    }
    let b: BuildOut = result_unwrap(build_res)
    let mut arch: str = cli.arch
    if !cli.has_arch {
        arch = arch_of_host()
    }
    if arch == "" {
        return Result.Err(refuse("this machine is none of x86_64 / "
        + "aarch64 / riscv64 — pass --arch explicitly"))
    }
    let rep_res: Result[JsonValue, str] = profile_to_report(b.profile,
    arch, b.mode, b.root, b.has_root, b.deriv, b.has_deriv, b.gate,
    b.yardstick, b.has_gate)
    if result_is_err(rep_res) {
        return Result.Err(refuse(result_err_or(rep_res, "")))
    }
    let rep: JsonValue = result_unwrap(rep_res)
    if cli.json {
        println(sbx_json_dump(rep))
        return Result.Ok(0)
    }
    let rules_res: Result[list[Rule], str] = profile_rules(b.profile,
    arch)
    if result_is_err(rules_res) {
        return Result.Err(refuse(result_err_or(rules_res, "")))
    }
    let rules: list[Rule] = result_unwrap(rules_res)
    let prog_res: Result[Program, str] = profile_program(b.profile, arch)
    if result_is_err(prog_res) {
        return Result.Err(refuse(result_err_or(prog_res, "")))
    }
    let name_nrs: list[int] = []
    let name_names: list[str] = []
    let mut ri: int = 0
    while ri < rules.len() {
        name_nrs.push(rules.get(ri).nr)
        name_names.push(rules.get(ri).name)
        ri = ri + 1
    }
    let text_res: Result[str, str] = render_profile(rep, cli.bpf,
    result_unwrap(prog_res), name_nrs, name_names)
    if result_is_err(text_res) {
        return Result.Err(refuse(result_err_or(text_res, "")))
    }
    println(result_unwrap(text_res))
    return Result.Ok(0)
}

# cmd_run — run a command under the filter. The launcher's decision is a
# privileged op (Stage 112): it ran real code under a real kernel filter,
# and the log says which posture, which command, and how the artifact
# ended.
fn cmd_run(cli: Cli) -> Result[int, Refusal]
uses IO, Fs, Proc, Args, Clock {
    let cmd: list[str] = []
    let mut i: int = 0
    while i < cli.tail.len() {
        cmd.push(cli.tail.get(i))
        i = i + 1
    }
    if cmd.len() > 0 && cmd.get(0) == "--" {
        cmd.pop()
    }
    if cmd.len() == 0 {
        return Result.Err(refuse_usage("run needs a command after -- "
        + "(hls-sandbox.py run [flags] -- CMD ARGS)"))
    }
    # the baseline's auto-detection needs a real path when it can get
    # one; the PATH search itself happens in the child
    let mut target: str = ""
    let mut has_target: bool = false
    if is_file_h(cmd.get(0)) || cmd.get(0).contains("/") {
        target = cmd.get(0)
        has_target = true
    }
    let build_res: Result[BuildOut, Refusal] = build_profile(cli, target,
    has_target)
    if result_is_err(build_res) {
        return Result.Err(result_err_or(build_res, refuse_usage("")))
    }
    let b: BuildOut = result_unwrap(build_res)
    let arch: str = arch_of_host()
    if arch == "" {
        return Result.Err(refuse("this machine is none of x86_64 / "
        + "aarch64 / riscv64 — the launcher refuses to install numbers "
        + "it cannot vouch for here"))
    }
    # the native era's arm goes through a compiled launcher child; no C
    # compiler is an honest refusal, never a panic and never a silently
    # unconfined run (exit 2 — a usage-shaped refusal of the host)
    let mut cc: str = which_hit("cc")
    if cc == "" {
        cc = which_hit("gcc")
    }
    if cc == "" {
        return Result.Err(refuse_usage("run needs a C compiler to arm "
        + "the kernel: no cc or gcc on PATH — the native launcher is a "
        + "compiled child (the .py armed through ctypes; Halis has no "
        + "prctl/seccomp builtins, and a tool that arms the kernel "
        + "should be auditable down to the bytes)"))
    }
    let run_res: Result[RunOutcome, str] = sbx_exec_run(b.profile, arch,
    cmd)
    if result_is_err(run_res) {
        return Result.Err(refuse(result_err_or(run_res, "")))
    }
    let outcome: RunOutcome = result_unwrap(run_res)

    # the audit record: the launcher's decision is a privileged op
    let detail: JsonValue = json_object([], [])
    sbx_obj_set(detail, "command", sbx_json_list_str(cmd))
    sbx_obj_set(detail, "exit", json_int(outcome.code))
    if outcome.sig >= 0 {
        sbx_obj_set(detail, "signal", json_int(outcome.sig))
    } else {
        sbx_obj_set(detail, "signal", json_null())
    }
    sbx_obj_set(detail, "effects", sbx_json_list_str(b.profile.effects))
    if b.profile.fs_mode == "" {
        sbx_obj_set(detail, "fs", json_null())
    } else {
        sbx_obj_set(detail, "fs", json_str(b.profile.fs_mode))
    }
    sbx_obj_set(detail, "default_action", json_str(
    b.profile.default_action))
    let _rec: Result[bool, str] = audit_record("sandbox.run", "ok",
    cmd.get(0), detail, true, true)

    let rep: JsonValue = json_object([], [])
    sbx_obj_set(rep, "schema", json_str("hls-sandbox-run/v1"))
    sbx_obj_set(rep, "mode", json_str(b.mode))
    sbx_obj_set(rep, "arch", json_str(arch))
    sbx_obj_set(rep, "effects", sbx_json_list_str(b.profile.effects))
    if b.profile.fs_mode == "" {
        sbx_obj_set(rep, "fs", json_null())
    } else {
        sbx_obj_set(rep, "fs", json_str(b.profile.fs_mode))
    }
    sbx_obj_set(rep, "default_action", json_str(b.profile.default_action))
    sbx_obj_set(rep, "baseline", json_str(b.profile.baseline))
    sbx_obj_set(rep, "command", sbx_json_list_str(cmd))
    sbx_obj_set(rep, "exit", json_int(outcome.code))
    if outcome.sig >= 0 {
        sbx_obj_set(rep, "signal", json_int(outcome.sig))
    } else {
        sbx_obj_set(rep, "signal", json_null())
    }
    sbx_obj_set(rep, "verdict", json_str(describe_exit(outcome.code,
    outcome.sig)))
    if cli.json {
        println(sbx_json_dump(rep))
    } else {
        if !cli.quiet {
            eprintln("hls-sandbox: " + describe_exit(outcome.code,
            outcome.sig))
        }
    }
    return Result.Ok(outcome.code)
}

# cmd_emit — emit the self-arming C shim (pure emission: no cc, no
# kernel).
fn cmd_emit(cli: Cli) -> Result[int, Refusal] uses IO, Fs, Proc, Args {
    let build_res: Result[BuildOut, Refusal] = build_profile(cli, "",
    false)
    if result_is_err(build_res) {
        return Result.Err(result_err_or(build_res, refuse_usage("")))
    }
    let b: BuildOut = result_unwrap(build_res)
    if !cli.has_arch {
        return Result.Err(refuse_usage("emit needs --arch (the shim is "
        + "cross-arch by design — name the target)"))
    }
    let arch: str = cli.arch
    let mut out: str = cli.out
    if !cli.has_out {
        let lowered: list[str] = []
        let mut i: int = 0
        while i < b.profile.effects.len() {
            lowered.push(str_to_lower_ascii(b.profile.effects.get(i)))
            i = i + 1
        }
        let mut stem: str = "bare"
        if lowered.len() > 0 {
            stem = join_strs(lowered, "_")
        }
        out = "hls_sandbox_" + stem + ".c"
    }
    let emit_res: Result[str, str] = emit_shim(b.profile, arch, out)
    if result_is_err(emit_res) {
        return Result.Err(refuse(result_err_or(emit_res, "")))
    }
    let rules_res: Result[list[Rule], str] = profile_rules(b.profile,
    arch)
    if result_is_err(rules_res) {
        return Result.Err(refuse(result_err_or(rules_res, "")))
    }
    println("hls-sandbox: " + result_unwrap(emit_res) + " — "
    + result_unwrap(rules_res).len().to_str() + " syscalls, arch " + arch
    + ", default " + b.profile.default_action)
    return Result.Ok(0)
}

# cmd_release — write the statement + chain it (a privileged op: the
# release gate pins a posture and the log says so).
fn cmd_release(cli: Cli) -> Result[int, Refusal]
uses IO, Fs, Proc, Args, Clock {
    if !cli.has_pkg {
        return Result.Err(refuse_usage("release needs --pkg DIR"))
    }
    let rel_res: Result[RelOut, str] = release(cli.pkg, cli.out,
    cli.has_out)
    if result_is_err(rel_res) {
        return Result.Err(refuse(result_err_or(rel_res, "")))
    }
    let r: RelOut = result_unwrap(rel_res)
    let name: str = sbx_jstr_or(r.statement, "name", "")
    let version: str = sbx_jstr_or(r.statement, "version", "")
    let effects: list[str] = sbx_jstrs(json_object_get(r.statement,
    "effects"))
    let mut eff_text: str = "(none)"
    if effects.len() > 0 {
        eff_text = join_strs(effects, ", ")
    }
    let fs: JsonValue = json_object_get(r.statement, "fs")
    let mut fs_mode: str = "None"
    if json_is_str(json_object_get(fs, "mode")) {
        fs_mode = json_str_value(json_object_get(fs, "mode"))
    }
    # the audit record (Stage 112)
    let detail: JsonValue = json_object([], [])
    sbx_obj_set(detail, "effects", sbx_json_list_str(effects))
    if json_is_str(json_object_get(fs, "mode")) {
        sbx_obj_set(detail, "fs", json_str(fs_mode))
    } else {
        sbx_obj_set(detail, "fs", json_null())
    }
    sbx_obj_set(detail, "ledger_seq", json_int(r.rec.seq))
    let _rec: Result[bool, str] = audit_record("sandbox.release", "ok",
    name + "@" + version, detail, true, true)

    println("hls-sandbox: " + r.st_path)
    println("  effects: " + eff_text)
    println("  fs: " + fs_mode + ", default: " + sbx_jstr_or(r.statement,
    "default_action", "") + ", baseline: " + sbx_jstr_or(r.statement,
    "baseline", ""))
    println("  allowlist: " + sbx_jstrs(json_object_get(r.statement,
    "allowlist")).len().to_str() + " syscalls ("
    + sbx_jstrs(json_object_get(r.statement, "constrained")).len()
    .to_str() + " constrained)")
    println("  ledger: seq " + r.rec.seq.to_str() + ", kind sandbox, "
    + "chain " + clip_str(r.rec.chain_hash, 12) + "...")
    return Result.Ok(0)
}

# cmd_verify_release — the counterparty's side.
fn cmd_verify_release(cli: Cli) -> Result[int, Refusal]
uses IO, Fs, Proc, Args {
    if !cli.has_pkg {
        return Result.Err(refuse_usage("verify-release needs --pkg DIR"))
    }
    let vr: Result[VerifyOut, str] = verify_release(cli.pkg)
    if result_is_err(vr) {
        return Result.Err(refuse(result_err_or(vr, "")))
    }
    let v: VerifyOut = result_unwrap(vr)
    println("hls-sandbox: " + sbx_jstr_or(v.statement, "name", "") + " "
    + sbx_jstr_or(v.statement, "version", "") + " — VERIFIED")
    let mut i: int = 0
    while i < v.checks.len() {
        println("  " + v.checks.get(i))
        i = i + 1
    }
    return Result.Ok(0)
}

# ============================================================================
# Part 14 — main: the probe children first, then the dispatch with the
# .py's exit law (2 usage, 1 refusals, the refused privileged ops
# recorded exactly like the completed ones).
# ============================================================================

fn main() -> int uses IO, Fs, Proc, Args, Clock, Exit {
    let argv: list[str] = args()

    # The probe children re-exec: --probe-parse / --probe-check <path>
    # is the real front-end load; a panic (non-zero exit) is the
    # parent's clean refusal, never a crash of the tool.
    if argv.len() > 2 && argv.get(1) == "--probe-parse" {
        let ctx: Ctx = hl_parse_file(argv.get(2))
        if ctx.fn_order.len() < 0 {
            return 1
        }
        return 0
    }
    if argv.len() > 2 && argv.get(1) == "--probe-check" {
        let cctx: Ctx = hl_load_crate(argv.get(2))
        hl_check(cctx)
        return 0
    }

    # `run CMD -- args...`: split at the FIRST `--` so the command's own
    # flags are never parsed as ours.
    let head: list[str] = []
    let tail: list[str] = []
    let mut has_dashdash: bool = false
    let mut i: int = 0
    while i < argv.len() {
        if !has_dashdash && argv.get(i) == "--" {
            has_dashdash = true
            i = i + 1
            continue
        }
        if has_dashdash {
            tail.push(argv.get(i))
        } else {
            head.push(argv.get(i))
        }
        i = i + 1
    }

    if head.len() < 2 {
        # the .py printed argparse's help (stdout) and exited 2; the
        # native family prints the .py's own usage doc
        print(usage_doc())
        return 2
    }

    let cli_res: Result[Cli, str] = parse_cli(head)
    if result_is_err(cli_res) {
        let msg: str = result_err_or(cli_res, "")
        if msg == "HELP" {
            print(usage_doc())
            return 0
        }
        eprintln("hls-sandbox: " + msg)
        return 2
    }
    let cli: Cli = result_unwrap(cli_res)
    cli.tail = tail

    # the command's audit op ("" = read-only, records nothing)
    let mut audit_op: str = ""
    if cli.cmd == "run" {
        audit_op = "sandbox.run"
    }
    if cli.cmd == "release" {
        audit_op = "sandbox.release"
    }

    let mut rc: Result[int, Refusal] = Result.Ok(0)
    if cli.cmd == "profile" {
        rc = cmd_profile(cli)
    }
    if cli.cmd == "run" {
        rc = cmd_run(cli)
    }
    if cli.cmd == "emit" {
        rc = cmd_emit(cli)
    }
    if cli.cmd == "release" {
        rc = cmd_release(cli)
    }
    if cli.cmd == "verify-release" {
        rc = cmd_verify_release(cli)
    }
    if cli.cmd == "selftest" {
        return selftest()
    }

    if result_is_err(rc) {
        let refusal: Refusal = result_err_or(rc, refuse_usage(""))
        eprintln("hls-sandbox: " + refusal.msg)
        if !refusal.usage && audit_op != "" {
            let _a: Result[bool, str] = audit_record_refused(audit_op,
            refusal.msg)
        }
        if refusal.usage {
            return 2
        }
        return 1
    }
    return result_unwrap(rc)
}
