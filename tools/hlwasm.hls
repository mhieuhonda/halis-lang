    hw_b(body, 167)
    hw_b(body, 58)
    hw_b(body, 0)
    hw_sleb_b(body, 0)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_add_code(e.mod, [1], [127], hw_bytes_str(body))
