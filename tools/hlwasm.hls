# ---- hl_str_to_int(s) -> i64 (deep-scan-15/20/30 fixes). ----
fn hw_emit_hl_str_to_int(mut e: HwEmitter) -> void {
    let body: list[int] = []
    # len = i32.load(s)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 40)
    hw_b(body, 2)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 1)
    # i = 0, result = 0, negative = 0, digit = 0
    hw_b(body, 65)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 2)
    hw_b(body, 66)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 3)
    hw_b(body, 65)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 4)
    hw_b(body, 65)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 5)
    # if i < len and s.data[4] == '-': negative = 1; i++
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 72)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 65)
    hw_sleb_b(body, 4)
    hw_b(body, 106)
    hw_b(body, 45)
    hw_b(body, 0)
    hw_sleb_b(body, 0)
    hw_b(body, 65)
    hw_sleb_b(body, 45)
    hw_b(body, 70)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 65)
    hw_sleb_b(body, 1)
    hw_b(body, 33)
    hw_uleb_b(body, 4)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 65)
    hw_sleb_b(body, 1)
    hw_b(body, 106)
    hw_b(body, 33)
    hw_uleb_b(body, 2)
    hw_b(body, 11)
    hw_b(body, 11)
    # loop: while i < len and digit(s.data[4+i]): result*10 + digit
    hw_b(body, 2)
    hw_b(body, 64)
    hw_b(body, 3)
    hw_b(body, 64)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 78)
    hw_b(body, 13)
    hw_uleb_b(body, 1)
    # byte = s.data[4+i] -> local 5 (dedicated digit scratch, deep-scan-15)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 65)
    hw_sleb_b(body, 4)
    hw_b(body, 106)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 106)
    hw_b(body, 45)
    hw_b(body, 0)
    hw_sleb_b(body, 0)
    hw_b(body, 34)
    hw_uleb_b(body, 5)
    # (byte >= '0') and (byte <= '9') else unreachable (deep-scan-30)
    hw_b(body, 65)
    hw_sleb_b(body, 48)
    hw_b(body, 78)
    hw_b(body, 32)
    hw_uleb_b(body, 5)
    hw_b(body, 65)
    hw_sleb_b(body, 57)
    hw_b(body, 76)
    hw_b(body, 113)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 32)
    hw_uleb_b(body, 5)
    hw_b(body, 65)
    hw_sleb_b(body, 48)
    hw_b(body, 107)
    hw_b(body, 172)
    hw_b(body, 32)
    hw_uleb_b(body, 3)
    hw_b(body, 66)
    hw_sleb_b(body, 10)
    hw_b(body, 126)
    hw_b(body, 124)
    hw_b(body, 33)
    hw_uleb_b(body, 3)
    hw_b(body, 5)
    hw_b(body, 0)
    hw_b(body, 11)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 65)
    hw_sleb_b(body, 1)
    hw_b(body, 106)
    hw_b(body, 33)
    hw_uleb_b(body, 2)
    hw_b(body, 12)
    hw_uleb_b(body, 0)
    hw_b(body, 11)
    hw_b(body, 11)
    # if negative: result = -result
    hw_b(body, 32)
    hw_uleb_b(body, 4)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 66)
    hw_sleb_b(body, 0)
    hw_b(body, 32)
    hw_uleb_b(body, 3)
    hw_b(body, 125)
    hw_b(body, 33)
    hw_uleb_b(body, 3)
    hw_b(body, 11)
    hw_b(body, 32)
    hw_uleb_b(body, 3)
    hw_add_code(e.mod, [1, 1, 1, 1, 1], [127, 127, 126, 127, 127],
    hw_bytes_str(body))
}

