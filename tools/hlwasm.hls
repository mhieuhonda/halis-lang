    hw_sleb_b(body, -9223372036854775808)
    hw_b(body, 81)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 0)
    hw_b(body, 11)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 66)
    hw_sleb_b(body, 0)
    hw_b(body, 83)
    hw_b(body, 4)
    hw_b(body, 126)
    hw_b(body, 66)
    hw_sleb_b(body, 0)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 125)
    hw_b(body, 5)
