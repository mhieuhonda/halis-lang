# ============================================================================
# tools/hlwasm.hls — the WebAssembly backend, in Halis (the native twin of
# the Python hlwasm.py that retired; the CLI, the emitter laws and the glue
# bytes are the .py's, re-derived on the real front-end).
# ----------------------------------------------------------------------------
# Usage:
#   bin/hlwasm <input.hls> <output_base>
#              [--target wasm32-unknown-unknown]
#              [--wasm] [--no-wasm] [--no-js] [--no-html] [--run]
#              [--list-targets] [--wasm-opt auto|on|off]
#              [--opt-level O1|O2|O3|Os] [--glue compact|verbose]
#              [--serve PORT]
#
#   bin/hlwasm examples/hello.hls /tmp/hello   # .wasm + .js + .html
#   bin/hlwasm examples/hello.hls /tmp/hello --run   # + run in Node.js
#
# Emits a .wasm binary DIRECTLY from a checked Halis program — no LLVM
# toolchain, no libc, always available (the roadmap's Stage 23 "direct
# emitter for the smallest binaries"). The .py leaned on the retired
# interpreter's dict-AST; this twin leans on the REAL front-end
# (import "./hlfront.hls": hl_load_crate + hl_check), so the emitter can
# never disagree with the compiler about what a program says.
#
# Type mapping (wasm32): int -> i64, float -> f64, bool -> i32,
# str -> i32 (pointer to {i32 len, i8 data[len]} in linear memory).
# list/map/struct/enum literals raise the .py's clean "not yet supported
# by --emit wasm" refusals (the Stage 23-alpha subset: let / assign /
# if / while / for-range / return / break / continue / expr; int, float,
# bool, str, ident, bin, un, call, method expressions; the builtin
# method surface .to_str/.len/.byte_at/.to_int/.to_float/.abs and the
# println/print/panic/exit/chr builtins).
#
# extern "js" blocks (std.jsffi): every declared fn the program ACTUALLY
# calls becomes a wasm import from module "env" (deep-scan-23
# tree-shaking), and the compact JS glue re-injects only the matching
# default stubs. Structs are never lowered as values, but every
# non-generic struct's field layout is exported through
# hl_struct_descriptors() so the glue AUTO-REGISTERS the marshalling
# descriptors (Stage 73); a fn jsffi_on_callback(cb_id: int, arg: str)
# -> str is exported as hl_call_halis (the JS->HLS callback entry).
#
# The whole compile rides in a probe child (--hw-child): a program that
# does not parse/check/lower is reported as the .py's clean
# "compile error: ..." line (exit 1), never a raw panic. --run executes
# the module in Node.js (the .py's runner .cjs, byte for byte); --serve
# hands the bundle to bin/hlserve; --wasm-opt auto/on/off spawns the
# sibling bin/hlwasm-opt (the .py imported the module in-process — a
# tool ships one main, so the twin spawns the binary and keeps the
# "hlwasm_opt not found; skipping optimization" fallback law).
# ============================================================================

import "./hlfront.hls"
import "std.str"

# ----------------------------------------------------------------------------
# Byte helpers (the .py's uleb/sleb + struct.pack; bytes are Halis strings,
# byte_at-addressable, written with write_file byte-transparently).
# ----------------------------------------------------------------------------

# hw_uleb(n) — unsigned LEB128 as a byte string (n >= 0).
fn hw_uleb(n: int) -> str {
    let out: list[int] = []
    let mut v: int = n
    while true {
        let mut b: int = int_and(v, 127)
        v = int_shr(v, 7)
        if v != 0 {
            b = int_or(b, 128)
        }
        out.push(b)
        if v == 0 {
            break
        }
    }
    return hw_bytes_str(out)
}

# hw_sleb(n) — signed LEB128 as a byte string.
fn hw_sleb(n: int) -> str {
    let out: list[int] = []
    let mut v: int = n
    while true {
        let mut b: int = int_and(v, 127)
        v = int_sar(v, 7)
        if (v == 0 && int_and(b, 64) == 0) || (v == -1 && int_and(b, 64) != 0) {
            out.push(b)
            break
        }
        out.push(int_or(b, 128))
    }
    return hw_bytes_str(out)
}

# hw_bytes_str(buf) — byte values -> byte string (one join; the naive
# per-byte concat is quadratic and the webapp module is ~100 KB).
fn hw_bytes_str(buf: list[int]) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < buf.len() {
        parts.push(chr(buf.get(i)))
        i = i + 1
    }
    return join(parts, "")
}

# hw_b(buf, by) — append one byte.
fn hw_b(buf: list[int], by: int) -> void {
    buf.push(int_and(by, 255))
}

# hw_uleb_b / hw_sleb_b — LEB append into a byte buffer.
fn hw_uleb_b(buf: list[int], n: int) -> void {
    let mut v: int = n
    while true {
        let mut b: int = int_and(v, 127)
        v = int_shr(v, 7)
        if v != 0 {
            b = int_or(b, 128)
        }
        buf.push(b)
        if v == 0 {
            break
        }
    }
}

fn hw_sleb_b(buf: list[int], n: int) -> void {
    let mut v: int = n
    while true {
        let mut b: int = int_and(v, 127)
        v = int_sar(v, 7)
        if (v == 0 && int_and(b, 64) == 0) || (v == -1 && int_and(b, 64) != 0) {
            buf.push(b)
            break
        }
        buf.push(int_or(b, 128))
    }
}

# hw_cat_b(buf, s) — append a whole byte string into a byte buffer.
fn hw_cat_b(buf: list[int], s: str) -> void {
    let mut i: int = 0
    while i < s.len() {
        buf.push(s.byte_at(i))
        i = i + 1
    }
}

# hw_double_bits(f) — the IEEE-754 double's 64-bit pattern, computed with
# pure arithmetic (Halis has no reinterpret cast). Exact: the exponent is
# found by power-of-two scaling, the mantissa by exact Sterbenz subtraction
# ((x - 1.0) is exact for x in [1, 2)), and power-of-two multiplies never
# round. Subnormals scale up by 2^1074, inf/nan/0 are special-cased.
fn hw_double_bits(f: float) -> int {
    let neg: bool = math_signbit(f)
    let mut x: float = f
    if x < 0.0 {
        x = 0.0 - x
    }
    let mut sign: int = 0
    if neg {
        sign = -9223372036854775808
    }
    if x == 0.0 {
        return sign
    }
    if math_isnan(x) {
        return int_or(sign, 9221120237041099776)
    }
    if math_isinf(x) {
        return int_or(sign, 9218868437227405312)
    }
    # Find e with x/2^e in [1, 2).
    let mut e: int = 0
    let mut m: float = x
    if m >= 2.0 {
        while m >= 2.0 {
            m = m / 2.0
            e = e + 1
        }
    } else {
        while m < 1.0 {
            m = m * 2.0
            e = e - 1
        }
    }
    if e >= -1022 {
        # Normal: mantissa = (m - 1) * 2^52, exact.
        let frac: float = (m - 1.0) * 4503599627370496.0
        let mant: int = frac.to_int()
        return int_or(sign, int_or(int_shl(e + 1023, 52), mant))
    }
    # Subnormal: value = mant * 2^-1074; mant = x * 2^1074 (exact).
    let mut sub: float = m
    let k: int = e + 1074
    let mut j: int = 0
    while j < k {
        sub = sub * 2.0
        j = j + 1
    }
    let smant: int = sub.to_int()
    return int_or(sign, smant)
}

# hw_f64_b(buf, f) — append the 8 little-endian bytes of a double.
fn hw_f64_b(buf: list[int], f: float) -> void {
    let bits: int = hw_double_bits(f)
    let mut i: int = 0
    while i < 8 {
        buf.push(int_and(int_shr(bits, 8 * i), 255))
        i = i + 1
    }
}

# hw_i32le(n) — 4 little-endian bytes of an i32 (the .py's struct.pack("<i")).
fn hw_i32le(n: int) -> str {
    let buf: list[int] = []
    let mut i: int = 0
    while i < 4 {
        buf.push(int_and(int_shr(n, 8 * i), 255))
        i = i + 1
    }
    return hw_bytes_str(buf)
}

# ----------------------------------------------------------------------------
# WasmModule — accumulates sections, serialises to bytes (the .py's
# WasmModule, parallel lists instead of tuples).
# ----------------------------------------------------------------------------

# Value types: I32=0x7F, I64=0x7E, F32=0x7D, F64=0x7C. Section ids:
# 1 Type, 2 Import, 3 Function, 4 Table, 5 Memory, 6 Global, 7 Export,
# 8 Start, 9 Element, 10 Code, 11 Data, 12 DataCount. Opcodes used by
# the emitter are inlined as decimal literals at each site, named in a
# comment (the .py's OP_* table).

struct HwModule {
    # Type section: parallel param/result lists (deduped by add_type).
    ty_params: list[list[int]],
    ty_results: list[list[int]],
    # Import section: (module, name, kind, type_idx) parallel lists.
    imp_mod: list[str],
    imp_name: list[str],
    imp_kind: list[int],
    imp_ty: list[int],
    # Function section: type indices of defined functions.
    funcs: list[int],
    # Memory section: min pages (limits flag 0, no max — the .py's only use).
    mems: list[int],
    # Export section: (name, kind, index).
    exp_name: list[str],
    exp_kind: list[int],
    exp_idx: list[int],
    # Code section: (locals, body) — locals as parallel (count, valtype)
    # lists, body as a byte string (final_bytes appends OP_END).
    code_lc: list[list[int]],
    code_lt: list[list[int]],
    code_body: list[str],
    # Data section: (offset, bytes).
    data_off: list[int],
    data_bytes: list[str],
    # Start function index (-1 = none).
    start: int
}

fn hw_mod_new() -> HwModule {
    return HwModule {
        ty_params: [], ty_results: [],
        imp_mod: [], imp_name: [], imp_kind: [], imp_ty: [],
        funcs: [],
        mems: [],
        exp_name: [], exp_kind: [], exp_idx: [],
        code_lc: [], code_lt: [], code_body: [],
        data_off: [], data_bytes: [],
        start: -1
    }
}

# hw_types_eq — elementwise (params, results) equality (Halis lists have
# no ==; the .py compared tuples).
fn hw_types_eq(a: list[int], b: list[int]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let mut i: int = 0
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

# hw_add_type — register a signature, dedup, return its index.
fn hw_add_type(mut m: HwModule, params: list[int], results: list[int]) -> int {
    let mut i: int = 0
    while i < m.ty_params.len() {
        if hw_types_eq(m.ty_params.get(i), params)
        && hw_types_eq(m.ty_results.get(i), results) {
            return i
        }
        i = i + 1
    }
    m.ty_params.push(params)
    m.ty_results.push(results)
    return m.ty_params.len() - 1
}

# hw_add_import — declare an import; returns its function index (imports
# occupy the first function indices).
fn hw_add_import(mut m: HwModule, module: str, name: str, kind: int,
type_idx: int) -> int {
    m.imp_mod.push(module)
    m.imp_name.push(name)
    m.imp_kind.push(kind)
    m.imp_ty.push(type_idx)
    return m.imp_name.len() - 1
}

# hw_add_function — declare a defined function; returns its GLOBAL index
# (after imports).
fn hw_add_function(mut m: HwModule, type_idx: int) -> int {
    m.funcs.push(type_idx)
    return m.imp_name.len() + m.funcs.len() - 1
}

fn hw_add_memory(mut m: HwModule, min_pages: int) -> void {
    m.mems.push(min_pages)
}

fn hw_add_export(mut m: HwModule, name: str, kind: int, index: int) -> void {
    m.exp_name.push(name)
    m.exp_kind.push(kind)
    m.exp_idx.push(index)
}

fn hw_add_code(mut m: HwModule, lc: list[int], lt: list[int],
body: str) -> void {
    m.code_lc.push(lc)
    m.code_lt.push(lt)
    m.code_body.push(body)
}

fn hw_add_data(mut m: HwModule, offset: int, data: str) -> void {
    m.data_off.push(offset)
    m.data_bytes.push(data)
}

# hw_section(id, content) — the (id, size, content) framing.
fn hw_section(sec_id: int, content: str) -> str {
    return chr(sec_id) + hw_uleb(content.len()) + content
}

# hw_final_bytes — assemble the binary module (sections in id order,
# DataCount before Code, OP_END appended to every body — the .py's law).
fn hw_final_bytes(m: HwModule) -> str {
    let out: list[int] = []
    hw_cat_b(out, chr(0) + "asm" + chr(1) + chr(0) + chr(0) + chr(0))
    # Section 1: Type.
    if m.ty_params.len() > 0 {
        let body: list[int] = []
        hw_uleb_b(body, m.ty_params.len())
        let mut i: int = 0
        while i < m.ty_params.len() {
            body.push(96)
            let ps: list[int] = m.ty_params.get(i)
            hw_uleb_b(body, ps.len())
            let mut p: int = 0
            while p < ps.len() {
                body.push(ps.get(p))
                p = p + 1
            }
            let rs: list[int] = m.ty_results.get(i)
            hw_uleb_b(body, rs.len())
            let mut r: int = 0
            while r < rs.len() {
                body.push(rs.get(r))
                r = r + 1
            }
            i = i + 1
        }
        hw_cat_b(out, hw_section(1, hw_bytes_str(body)))
    }
    # Section 2: Import.
    if m.imp_name.len() > 0 {
        let body: list[int] = []
        hw_uleb_b(body, m.imp_name.len())
        let mut i: int = 0
        while i < m.imp_name.len() {
            let mb: str = m.imp_mod.get(i)
            hw_uleb_b(body, mb.len())
            hw_cat_b(body, mb)
            let nb: str = m.imp_name.get(i)
            hw_uleb_b(body, nb.len())
            hw_cat_b(body, nb)
            let kind: int = m.imp_kind.get(i)
            body.push(kind)
            if kind == 0 {
                hw_uleb_b(body, m.imp_ty.get(i))
            } else if kind == 2 {
                # memory: limits flag 0 (no max), min pages in the idx slot
                body.push(0)
                hw_uleb_b(body, m.imp_ty.get(i))
            } else if kind == 3 {
                # global: value type, immutable
                body.push(int_and(m.imp_ty.get(i), 255))
                body.push(0)
            }
            i = i + 1
        }
        hw_cat_b(out, hw_section(2, hw_bytes_str(body)))
    }
    # Section 3: Function.
    if m.funcs.len() > 0 {
        let body: list[int] = []
        hw_uleb_b(body, m.funcs.len())
        let mut i: int = 0
        while i < m.funcs.len() {
            hw_uleb_b(body, m.funcs.get(i))
            i = i + 1
        }
        hw_cat_b(out, hw_section(3, hw_bytes_str(body)))
    }
    # Section 5: Memory.
    if m.mems.len() > 0 {
        let body: list[int] = []
        hw_uleb_b(body, m.mems.len())
        let mut i: int = 0
        while i < m.mems.len() {
            body.push(0)
            hw_uleb_b(body, m.mems.get(i))
            i = i + 1
        }
        hw_cat_b(out, hw_section(5, hw_bytes_str(body)))
    }
    # Section 7: Export.
    if m.exp_name.len() > 0 {
        let body: list[int] = []
        hw_uleb_b(body, m.exp_name.len())
        let mut i: int = 0
        while i < m.exp_name.len() {
            let nb: str = m.exp_name.get(i)
            hw_uleb_b(body, nb.len())
            hw_cat_b(body, nb)
            body.push(m.exp_kind.get(i))
            hw_uleb_b(body, m.exp_idx.get(i))
            i = i + 1
        }
        hw_cat_b(out, hw_section(7, hw_bytes_str(body)))
    }
    # Section 8: Start.
    if m.start >= 0 {
        hw_cat_b(out, hw_section(8, hw_uleb(m.start)))
    }
    # Section 12: DataCount (before Code whenever Data is present).
    if m.data_off.len() > 0 {
        hw_cat_b(out, hw_section(12, hw_uleb(m.data_off.len())))
    }
    # Section 10: Code.
    if m.code_body.len() > 0 {
        let body: list[int] = []
        hw_uleb_b(body, m.code_body.len())
        let mut i: int = 0
        while i < m.code_body.len() {
            let fbody: list[int] = []
            let lc: list[int] = m.code_lc.get(i)
            let lt: list[int] = m.code_lt.get(i)
            hw_uleb_b(fbody, lc.len())
            let mut j: int = 0
            while j < lc.len() {
                hw_uleb_b(fbody, lc.get(j))
                fbody.push(lt.get(j))
                j = j + 1
            }
            hw_cat_b(fbody, m.code_body.get(i))
            fbody.push(11)
            hw_uleb_b(body, fbody.len())
            hw_cat_b(body, hw_bytes_str(fbody))
            i = i + 1
        }
        hw_cat_b(out, hw_section(10, hw_bytes_str(body)))
    }
    # Section 11: Data.
    if m.data_off.len() > 0 {
        let body: list[int] = []
        hw_uleb_b(body, m.data_off.len())
        let mut i: int = 0
        while i < m.data_off.len() {
            body.push(0)
            body.push(65)
            hw_sleb_b(body, m.data_off.get(i))
            body.push(11)
            let d: str = m.data_bytes.get(i)
            hw_uleb_b(body, d.len())
            hw_cat_b(body, d)
            i = i + 1
        }
        hw_cat_b(out, hw_section(11, hw_bytes_str(body)))
    }
    return hw_bytes_str(out)
}

# ----------------------------------------------------------------------------
# main — the CLI (argparse surface of the .py, hand-rolled: same flags,
# same --flag value / --flag=value forms, same exits: 0 ok, 1 compile
# error, 2 usage).
# ----------------------------------------------------------------------------

fn hw_usage_text() -> str {
    return "usage: hlwasm [-h] [--target TARGET] [--no-wasm] [--no-js]\n"
    + "              [--no-html] [--run] [--list-targets]\n"
    + "              [--wasm-opt {auto,on,off}] [--opt-level {O1,O2,O3,Os}]\n"
    + "              [--glue {compact,verbose}] [--serve PORT]\n"
    + "              [input] [output_base]\n"
    + "\n"
    + "Stage 24 WebAssembly backend: HLS -> .wasm + wasm-opt + emscripten\n"
    + "bridge."
}

# ----------------------------------------------------------------------------
# The wasm emitter (the .py's WasmEmitterCore + WasmEmitterLower +
# WasmEmitterRuntime, one struct, method-for-method).
# ----------------------------------------------------------------------------

# hw_taint_inner — strip tainted[...].
fn hw_taint_inner(t: str) -> str {
    if t.starts_with("tainted[") && t.ends_with("]") && t.len() > 9 {
        return t.slice(8, t.len() - 1)
    }
    return t
}

# hw_valtype — the .py's hls_to_wasm_valtype (I32=127, I64=126, F64=124).
fn hw_valtype(t: str) -> int {
    let u: str = hw_taint_inner(t)
    if u == "int" {
        return 126
    }
    if u == "float" {
        return 124
    }
    if u == "bool" {
        return 127
    }
    if u == "str" {
        return 127
    }
    if u.starts_with("list[") || u.starts_with("map[") {
        return 127
    }
    if u == "void" {
        panic("void has no value type")
    }
    # struct / enum / generic instantiated -> pointer
    return 127
}

# hw_result_types — the .py's hls_to_wasm_result.
fn hw_result_types(t: str) -> list[int] {
    if t == "void" {
        return []
    }
    let out: list[int] = []
    out.push(hw_valtype(t))
    return out
}

# hw_refuse — the .py's HLError channel: panic with the "(line N)"
# suffix the interpreter's HLError.__str__ appended (col 0 on every
# emitter raise); the parent maps it to "compile error: ...".
fn hw_refuse(msg: str, line: int) -> void {
    panic(msg + " (line " + line.to_str() + ")")
}

# HwEmitter — the emitter state (the .py's self.*).
struct HwEmitter {
    ctx: Ctx,
    mod: HwModule,
    func_index: map[str, int],
    helper_emitted: map[str, bool],
    str_pool: map[str, int],
    str_list: list[str],
    str_offs: list[int],
    str_pool_end: int,
    locals: map[str, int],
    local_count: int,
    cur_ret_type: str,
    loop_break: list[int],
    loop_cont: list[int],
    frames: int,
    js_externs: map[str, bool],
    js_extern_order: list[str],
    # The entry file's own path: hlfront's loaded_files lists the
    # IMPORTS (load_file_into pushes those); the entry itself never
    # joins the list, so the extern scan walks it first, by hand.
    entry_path: str,
    binding_pool: map[str, int]
}

fn hw_emit_new(ctx: Ctx, entry_path: str) -> HwEmitter {
    return HwEmitter {
        ctx: ctx,
        mod: hw_mod_new(),
        func_index: map_new(),
        helper_emitted: map_new(),
        str_pool: map_new(),
        str_list: [],
        str_offs: [],
        str_pool_end: 16,
        locals: map_new(),
        local_count: 0,
        cur_ret_type: "void",
        loop_break: [],
        loop_cont: [],
        frames: 0,
        js_externs: map_new(),
        js_extern_order: [],
        entry_path: entry_path,
        binding_pool: map_new()
    }
}

# hw_intern_str — the string pool: {i32 len, i8 data[len]} records laid
# out contiguously from STR_BASE (16), 4-byte aligned.
fn hw_intern_str(mut e: HwEmitter, s: str) -> int {
    if e.str_pool.has(s) {
        return e.str_pool.get_or(s, 0)
    }
    let offset: int = e.str_pool_end
    let rec_len: int = 4 + s.len()
    let padded: int = int_and(rec_len + 3, -4)
    e.str_pool.set(s, offset)
    e.str_list.push(s)
    e.str_offs.push(offset)
    e.str_pool_end = e.str_pool_end + padded
    return offset
}

# ---------- extern "js" / extern "C" discovery ----------
#
# The native front-end stores extern decls as is_extern fns without the
# ABI, so the emitter re-reads every loaded file's text for the
# `extern "js"` / `extern "C"` blocks (the checker already proved the
# files parse; the scan is a name harvest, not a parse). extern "C" is
# refused with the .py's byte-exact message.

# hw_find_from(s, needle, from) — first index >= from (-1 miss; Halis
# str.find has no start argument).
fn hw_find_from(s: str, needle: str, from: int) -> int {
    let n: int = s.len()
    let m: int = needle.len()
    if m == 0 {
        if from <= n {
            return from
        }
        return -1
    }
    let mut i: int = from
    if i < 0 {
        i = 0
    }
    while i + m <= n {
        let mut k: int = 0
        let mut same: bool = true
        while k < m {
            if s.byte_at(i + k) != needle.byte_at(k) {
                same = false
            }
            k = k + 1
        }
        if same {
            return i
        }
        i = i + 1
    }
    return -1
}

# hw_line_at(src, pos) — 1-based line number of a byte offset.
fn hw_line_at(src: str, pos: int) -> int {
    let mut line: int = 1
    let mut i: int = 0
    while i < pos && i < src.len() {
        if src.byte_at(i) == 10 {
            line = line + 1
        }
        i = i + 1
    }
    return line
}

# hw_ident_at(src, i) — the identifier starting at i ("" when none).
fn hw_ident_at(src: str, i: int) -> str {
    let n: int = src.len()
    if i >= n {
        return ""
    }
    let c: int = src.byte_at(i)
    let is_start: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
    if !is_start {
        return ""
    }
    let mut j: int = i
    while j < n {
        let d: int = src.byte_at(j)
        let ok: bool = (d >= 65 && d <= 90) || (d >= 97 && d <= 122)
        || d == 95 || (d >= 48 && d <= 57)
        if !ok {
            break
        }
        j = j + 1
    }
    return src.slice(i, j)
}

# hw_scan_externs — collect extern "js" fn names (declaration order) and
# refuse extern "C" (the wasm32-unknown-unknown target has no libc).
fn hw_scan_externs(mut e: HwEmitter) -> void uses IO {
    let files: list[str] = []
    if e.entry_path != "" {
        files.push(e.entry_path)
    }
    let mut dfi: int = 0
    while dfi < e.ctx.loaded_files.len() {
        if e.ctx.loaded_files.get(dfi) != e.entry_path {
            files.push(e.ctx.loaded_files.get(dfi))
        }
        dfi = dfi + 1
    }
    let mut fi: int = 0
    while fi < files.len() {
        let path: str = files.get(fi)
        let src: str = read_file(path)
        let mut i: int = 0
        while true {
            let at: int = hw_find_from(src, "extern", i)
            if at < 0 {
                break
            }
            i = at + 6
            # Word boundary: not part of a longer identifier.
            let mut before_ok: bool = at == 0
            if at > 0 {
                let pc: int = src.byte_at(at - 1)
                before_ok = !((pc >= 65 && pc <= 90) || (pc >= 97 && pc <= 122)
                || pc == 95 || (pc >= 48 && pc <= 57))
            }
            let word: str = hw_ident_at(src, at)
            if !before_ok || word != "extern" {
                continue
            }
            # Skip whitespace to the ABI string.
            let mut j: int = at + 6
            while j < src.len() && (src.byte_at(j) == 32
            || src.byte_at(j) == 9 || src.byte_at(j) == 10
            || src.byte_at(j) == 13) {
                j = j + 1
            }
            if j >= src.len() || src.byte_at(j) != 34 {
                continue
            }
            let close: int = hw_find_from(src, "\"", j + 1)
            if close < 0 {
                continue
            }
            let abi: str = src.slice(j + 1, close)
            # Skip whitespace to the block '{'.
            let mut k: int = close + 1
            while k < src.len() && (src.byte_at(k) == 32
            || src.byte_at(k) == 9 || src.byte_at(k) == 10
            || src.byte_at(k) == 13) {
                k = k + 1
            }
            if k >= src.len() || src.byte_at(k) != 123 {
                i = close
                continue
            }
            if abi != "js" && abi != "C" {
                # The parser already rejected other ABIs; unreachable.
                i = close
                continue
            }
            # Scan the block body for `fn NAME(` declarations. Comments
            # ('#' to EOL unless '#[') and attribute brackets are cut.
            let mut p: int = k + 1
            while p < src.len() {
                let ch: int = src.byte_at(p)
                if ch == 125 {
                    break
                }
                if ch == 35 {
                    # '#' attribute or comment: skip to ']' or EOL.
                    if p + 1 < src.len() && src.byte_at(p + 1) == 91 {
                        let ab: int = hw_find_from(src, "]", p)
                        if ab < 0 {
                            break
                        }
                        p = ab + 1
                        continue
                    }
                    let nl: int = hw_find_from(src, "\n", p)
                    if nl < 0 {
                        break
                    }
                    p = nl + 1
                    continue
                }
                if ch == 102 {
                    # candidate 'fn' keyword at a word boundary
                    let w: str = hw_ident_at(src, p)
                    if w == "fn" {
                        let pb: int = p
                        let mut q: int = p + 2
                        while q < src.len() && (src.byte_at(q) == 32
                        || src.byte_at(q) == 9) {
                            q = q + 1
                        }
                        let nm: str = hw_ident_at(src, q)
                        if nm != "" {
                            # must be followed by '('
                            let r: int = q + nm.len()
                            if r < src.len() && src.byte_at(r) == 40 {
                                if abi == "C" {
                                    hw_refuse("extern \"C\" is not supported "
                                    + "on the wasm32-unknown-unknown target "
                                    + "(no libc; use --target x86_64-linux-gnu "
                                    + "for the C backend, or declare the "
                                    + "import as extern \"js\")",
                                    hw_line_at(src, pb))
                                }
                                if !e.js_externs.has(nm) {
                                    e.js_externs.set(nm, true)
                                    e.js_extern_order.push(nm)
                                }
                                p = r
                                continue
                            }
                        }
                    }
                }
                p = p + 1
            }
            i = p
        }
        fi = fi + 1
    }
}

# hw_called_fn_names — every call/method NAME in the program (the .py's
# deep-scan-23 _called_fn_names: an extern "js" import is declared iff
# some emitted call may reference it; sound by construction).
fn hw_walk_expr_names(e: HwEmitter, ei: int, acc: map[str, bool]) -> void {
    if ei < 0 || ei >= e.ctx.exprs.len() {
        return
    }
    let k: str = e.ctx.exprs.get(ei).kind
    if k == "call" || k == "method" {
        let nm: str = e.ctx.exprs.get(ei).name
        if nm != "" {
            acc.set(nm, true)
        }
    }
    if k == "match" {
        # args are match-ARM indices, not expressions.
        hw_walk_expr_names(e, e.ctx.exprs.get(ei).left, acc)
        let mut a: int = 0
        let args: list[int] = e.ctx.exprs.get(ei).args
        while a < args.len() {
            let arm: MatchArm = e.ctx.match_arms.get(args.get(a))
            hw_walk_expr_names(e, arm.body, acc)
            a = a + 1
        }
        return
    }
    hw_walk_expr_names(e, e.ctx.exprs.get(ei).left, acc)
    hw_walk_expr_names(e, e.ctx.exprs.get(ei).right, acc)
    let mut i: int = 0
    let args2: list[int] = e.ctx.exprs.get(ei).args
    while i < args2.len() {
        hw_walk_expr_names(e, args2.get(i), acc)
        i = i + 1
    }
}

fn hw_walk_stmt_names(e: HwEmitter, si: int, acc: map[str, bool]) -> void {
    if si < 0 || si >= e.ctx.stmts.len() {
        return
    }
    let s: StmtN = e.ctx.stmts.get(si)
    hw_walk_expr_names(e, s.value, acc)
    hw_walk_expr_names(e, s.target, acc)
    hw_walk_expr_names(e, s.cond, acc)
    hw_walk_expr_names(e, s.iter, acc)
    hw_walk_expr_names(e, s.e, acc)
    let mut i: int = 0
    while i < s.body.len() {
        hw_walk_stmt_names(e, s.body.get(i), acc)
        i = i + 1
    }
    let mut j: int = 0
    while j < s.else_body.len() {
        hw_walk_stmt_names(e, s.else_body.get(j), acc)
        j = j + 1
    }
}

fn hw_called_fn_names(e: HwEmitter) -> map[str, bool] {
    let acc: map[str, bool] = map_new()
    # Every non-extern fn body...
    let mut fi: int = 0
    while fi < e.ctx.fn_order.len() {
        let key: str = e.ctx.fn_order.get(fi)
        let f: FnInfo = e.ctx.fns.get_or(key, dummy_fn())
        let mut bi: int = 0
        while bi < f.body.len() {
            hw_walk_stmt_names(e, f.body.get(bi), acc)
            bi = bi + 1
        }
        fi = fi + 1
    }
    # ...and every struct default-value expr (the .py walked the whole
    # program dict; the defaults are the other value-holding spot).
    let keys: list[str] = e.ctx.structs.keys()
    let mut ki: int = 0
    while ki < keys.len() {
        let st: StructInfo = e.ctx.structs.get_or(keys.get(ki), dummy_struct())
        let mut di: int = 0
        while di < st.fdefaults.len() {
            if st.fdefaults.get(di) >= 0 {
                hw_walk_expr_names(e, st.fdefaults.get(di), acc)
            }
            di = di + 1
        }
        ki = ki + 1
    }
    return acc
}

# ---------- imports ----------

# hw_declare_js_imports — the standard env imports (always first), then
# the user's extern "js" decls that the program actually calls.
fn hw_declare_js_imports(mut e: HwEmitter) -> void {
    # (str ptr) -> void
    let t_println: int = hw_add_type(e.mod, [127], [])
    let idx1: int = hw_add_import(e.mod, "env", "hl_js_println", 0, t_println)
    e.func_index.set("hl_js_println", idx1)
    let t_print: int = hw_add_type(e.mod, [127], [])
    let idx2: int = hw_add_import(e.mod, "env", "hl_js_print", 0, t_print)
    e.func_index.set("hl_js_print", idx2)
    # (f64) -> str ptr
    let t_f2s: int = hw_add_type(e.mod, [124], [127])
    let idx3: int = hw_add_import(e.mod, "env", "hl_js_f64_to_str", 0, t_f2s)
    e.func_index.set("hl_js_f64_to_str", idx3)
    # User-declared extern "js" functions, declaration order, tree-shaken
    # to the ones the program calls (deep-scan-23).
    let called: map[str, bool] = hw_called_fn_names(e)
    let mut i: int = 0
    while i < e.js_extern_order.len() {
        let nm: str = e.js_extern_order.get(i)
        if called.has(nm) {
            let f: FnInfo = e.ctx.fns.get_or(nm, dummy_fn())
            let pv: list[int] = []
            let mut pi: int = 0
            while pi < f.ptypes.len() {
                pv.push(hw_valtype(f.ptypes.get(pi)))
                pi = pi + 1
            }
            let rv: list[int] = hw_result_types(f.ret)
            let ty: int = hw_add_type(e.mod, pv, rv)
            let idx: int = hw_add_import(e.mod, "env", nm, 0, ty)
            e.func_index.set(nm, idx)
        }
        i = i + 1
    }
}

# ---------- runtime helpers ----------

# hw_add_helper — declare a wasm-defined helper (idempotent).
fn hw_add_helper(mut e: HwEmitter, name: str, params: list[int],
results: list[int]) -> int {
    if e.helper_emitted.has(name) {
        return e.func_index.get_or(name, 0)
    }
    let ty: int = hw_add_type(e.mod, params, results)
    let idx: int = hw_add_function(e.mod, ty)
    e.helper_emitted.set(name, true)
    e.func_index.set(name, idx)
    return idx
}

# hw_call_idx — the func_index of a name (helpers are forward-declared
# before any body runs, so a miss is an internal error).
fn hw_call_idx(e: HwEmitter, name: str, line: int) -> int {
    if !e.func_index.has(name) {
        hw_refuse("internal: helper '" + name + "' not emitted", line)
    }
    return e.func_index.get_or(name, 0)
}

# ---- hl_alloc(n: i32) -> ptr: bump allocator on HEAP_PTR_ADDR (0). ----
fn hw_emit_hl_alloc(mut e: HwEmitter) -> void {
    let body: list[int] = []
    # i32.const 0; i32.load (align 2, off 0)
    hw_b(body, 65)
    hw_sleb_b(body, 0)
    hw_b(body, 40)
    hw_b(body, 2)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 1)
    hw_b(body, 65)
    hw_sleb_b(body, 0)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 106)
    hw_b(body, 54)
    hw_b(body, 2)
    hw_sleb_b(body, 0)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_add_code(e.mod, [1], [127], hw_bytes_str(body))
}

# ---- hl_str_concat(a, b) -> c (memory.copy, bulk-memory 1.0). ----
fn hw_emit_hl_str_concat(mut e: HwEmitter, idx_alloc: int) -> void {
    let body: list[int] = []
    # a_len = i32.load(a); b_len = i32.load(b)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 40)
    hw_b(body, 2)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 2)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 40)
    hw_b(body, 2)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 3)
    # total = a_len + b_len
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 32)
    hw_uleb_b(body, 3)
    hw_b(body, 106)
    hw_b(body, 33)
    hw_uleb_b(body, 4)
    # result_ptr = hl_alloc(4 + total)
    hw_b(body, 65)
    hw_sleb_b(body, 4)
    hw_b(body, 32)
    hw_uleb_b(body, 4)
    hw_b(body, 106)
    hw_b(body, 16)
    hw_uleb_b(body, idx_alloc)
    hw_b(body, 33)
    hw_uleb_b(body, 5)
    # store total at result_ptr[0]
    hw_b(body, 32)
    hw_uleb_b(body, 5)
    hw_b(body, 32)
    hw_uleb_b(body, 4)
    hw_b(body, 54)
    hw_b(body, 2)
    hw_sleb_b(body, 0)
    # memory.copy a.data -> result+4, n = a_len
    hw_b(body, 32)
    hw_uleb_b(body, 5)
    hw_b(body, 65)
    hw_sleb_b(body, 4)
    hw_b(body, 106)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 65)
    hw_sleb_b(body, 4)
    hw_b(body, 106)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 252)
    hw_uleb_b(body, 10)
    hw_b(body, 0)
    hw_b(body, 0)
    # memory.copy b.data -> result+4+a_len, n = b_len
    hw_b(body, 32)
    hw_uleb_b(body, 5)
    hw_b(body, 65)
    hw_sleb_b(body, 4)
    hw_b(body, 106)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 106)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 65)
    hw_sleb_b(body, 4)
    hw_b(body, 106)
    hw_b(body, 32)
    hw_uleb_b(body, 3)
    hw_b(body, 252)
    hw_uleb_b(body, 10)
    hw_b(body, 0)
    hw_b(body, 0)
    # return result_ptr
    hw_b(body, 32)
    hw_uleb_b(body, 5)
    hw_add_code(e.mod, [1, 1, 1, 1], [127, 127, 127, 127],
    hw_bytes_str(body))
}

# ---- hl_int_to_str(n: i64) -> str (unsigned div/rem — deep-scan-15). ----
fn hw_emit_hl_int_to_str(mut e: HwEmitter, idx_alloc: int) -> void {
    let body: list[int] = []
    # buf_ptr = hl_alloc(24)
    hw_b(body, 65)
    hw_sleb_b(body, 24)
    hw_b(body, 16)
    hw_uleb_b(body, idx_alloc)
    hw_b(body, 33)
    hw_uleb_b(body, 1)
    # pos = 24
    hw_b(body, 65)
    hw_sleb_b(body, 24)
    hw_b(body, 33)
    hw_uleb_b(body, 2)
    # negative = (n < 0)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 66)
    hw_sleb_b(body, 0)
    hw_b(body, 83)
    hw_b(body, 33)
    hw_uleb_b(body, 3)
    # if negative: n = 0 - n
    hw_b(body, 32)
    hw_uleb_b(body, 3)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 66)
    hw_sleb_b(body, 0)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 125)
    hw_b(body, 33)
    hw_uleb_b(body, 0)
    hw_b(body, 11)
    # if n == 0: pos = 23; buf[23] = '0'
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 80)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 65)
    hw_sleb_b(body, 23)
    hw_b(body, 33)
    hw_uleb_b(body, 2)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 65)
    hw_sleb_b(body, 23)
    hw_b(body, 106)
    hw_b(body, 65)
    hw_sleb_b(body, 48)
    hw_b(body, 58)
    hw_b(body, 0)
    hw_sleb_b(body, 0)
    hw_b(body, 11)
    # loop: while n != 0: digit extraction (UNSIGNED div/rem)
    hw_b(body, 2)
    hw_b(body, 64)
    hw_b(body, 3)
    hw_b(body, 64)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 80)
    hw_b(body, 13)
    hw_uleb_b(body, 1)
    # tmp = n % 10 (unsigned)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 66)
    hw_sleb_b(body, 10)
    hw_b(body, 130)
    hw_b(body, 33)
    hw_uleb_b(body, 4)
    # n = n / 10 (unsigned)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 66)
    hw_sleb_b(body, 10)
    hw_b(body, 128)
    hw_b(body, 33)
    hw_uleb_b(body, 0)
    # pos--
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 65)
    hw_sleb_b(body, -1)
    hw_b(body, 106)
    hw_b(body, 33)
    hw_uleb_b(body, 2)
    # buf[pos] = digit + '0'
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 106)
    hw_b(body, 32)
    hw_uleb_b(body, 4)
    hw_b(body, 66)
    hw_sleb_b(body, 48)
    hw_b(body, 124)
    hw_b(body, 167)
    hw_b(body, 58)
    hw_b(body, 0)
    hw_sleb_b(body, 0)
    hw_b(body, 12)
    hw_uleb_b(body, 0)
    hw_b(body, 11)
    hw_b(body, 11)
    # if negative: pos--; buf[pos] = '-'
    hw_b(body, 32)
    hw_uleb_b(body, 3)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 65)
    hw_sleb_b(body, -1)
    hw_b(body, 106)
    hw_b(body, 33)
    hw_uleb_b(body, 2)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 106)
    hw_b(body, 65)
    hw_sleb_b(body, 45)
    hw_b(body, 58)
    hw_b(body, 0)
    hw_sleb_b(body, 0)
    hw_b(body, 11)
    # len = 24 - pos
    hw_b(body, 65)
    hw_sleb_b(body, 24)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 107)
    hw_b(body, 33)
    hw_uleb_b(body, 6)
    # result_ptr = hl_alloc(4 + len); store len
    hw_b(body, 65)
    hw_sleb_b(body, 4)
    hw_b(body, 32)
    hw_uleb_b(body, 6)
    hw_b(body, 106)
    hw_b(body, 16)
    hw_uleb_b(body, idx_alloc)
    hw_b(body, 33)
    hw_uleb_b(body, 5)
    hw_b(body, 32)
    hw_uleb_b(body, 5)
    hw_b(body, 32)
    hw_uleb_b(body, 6)
    hw_b(body, 54)
    hw_b(body, 2)
    hw_sleb_b(body, 0)
    # memory.copy buf[pos..pos+len) -> result[4..4+len)
    hw_b(body, 32)
    hw_uleb_b(body, 5)
    hw_b(body, 65)
    hw_sleb_b(body, 4)
    hw_b(body, 106)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 106)
    hw_b(body, 32)
    hw_uleb_b(body, 6)
    hw_b(body, 252)
    hw_uleb_b(body, 10)
    hw_b(body, 0)
    hw_b(body, 0)
    # return result_ptr
    hw_b(body, 32)
    hw_uleb_b(body, 5)
    hw_add_code(e.mod, [1, 1, 1, 1, 1, 1], [127, 127, 127, 126, 127, 127],
    hw_bytes_str(body))
}

# ---- hl_bool_to_str(b) -> "true"/"false" literal pointer. ----
fn hw_emit_hl_bool_to_str(mut e: HwEmitter) -> void {
    let true_off: int = hw_intern_str(e, "true")
    let false_off: int = hw_intern_str(e, "false")
    let body: list[int] = []
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 4)
    hw_b(body, 127)
    hw_b(body, 65)
    hw_sleb_b(body, true_off)
    hw_b(body, 5)
    hw_b(body, 65)
    hw_sleb_b(body, false_off)
    hw_b(body, 11)
    hw_add_code(e.mod, [], [], hw_bytes_str(body))
}

# ---- hl_float_to_str(f) -> str: the JS helper owns the formatting. ----
fn hw_emit_hl_float_to_str(mut e: HwEmitter) -> void {
    let js_idx: int = hw_call_idx(e, "hl_js_f64_to_str", 0)
    let body: list[int] = []
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 16)
    hw_uleb_b(body, js_idx)
    hw_add_code(e.mod, [], [], hw_bytes_str(body))
}

# ---- hl_str_eq(a, b) -> i32 (early-return byte compare). ----
fn hw_emit_hl_str_eq(mut e: HwEmitter) -> void {
    let body: list[int] = []
    # a_len, b_len
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 40)
    hw_b(body, 2)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 2)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 40)
    hw_b(body, 2)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 3)
    # if a_len != b_len: return 0
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 32)
    hw_uleb_b(body, 3)
    hw_b(body, 71)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 65)
    hw_sleb_b(body, 0)
    hw_b(body, 15)
    hw_b(body, 11)
    # i = 0
    hw_b(body, 65)
    hw_sleb_b(body, 0)
    hw_b(body, 33)
    hw_uleb_b(body, 4)
    # loop: if i >= a_len return 1; if a[4+i] != b[4+i] return 0; i++
    hw_b(body, 2)
    hw_b(body, 64)
    hw_b(body, 3)
    hw_b(body, 64)
    hw_b(body, 32)
    hw_uleb_b(body, 4)
    hw_b(body, 32)
    hw_uleb_b(body, 2)
    hw_b(body, 78)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 65)
    hw_sleb_b(body, 1)
    hw_b(body, 15)
    hw_b(body, 11)
    hw_b(body, 32)
    hw_uleb_b(body, 0)
    hw_b(body, 32)
    hw_uleb_b(body, 4)
    hw_b(body, 106)
    hw_b(body, 45)
    hw_b(body, 0)
    hw_sleb_b(body, 4)
    hw_b(body, 32)
    hw_uleb_b(body, 1)
    hw_b(body, 32)
    hw_uleb_b(body, 4)
    hw_b(body, 106)
    hw_b(body, 45)
    hw_b(body, 0)
    hw_sleb_b(body, 4)
    hw_b(body, 71)
    hw_b(body, 4)
    hw_b(body, 64)
    hw_b(body, 65)
    hw_sleb_b(body, 0)
    hw_b(body, 15)
    hw_b(body, 11)
    hw_b(body, 32)
    hw_uleb_b(body, 4)
    hw_b(body, 65)
    hw_sleb_b(body, 1)
    hw_b(body, 106)
    hw_b(body, 33)
    hw_uleb_b(body, 4)
    hw_b(body, 12)
    hw_uleb_b(body, 0)
    hw_b(body, 11)
    hw_b(body, 11)
    # wasm needs a value for the return type (unreachable in practice)
    hw_b(body, 65)
    hw_sleb_b(body, 1)
    hw_add_code(e.mod, [1, 1, 1], [127, 127, 127], hw_bytes_str(body))
}

