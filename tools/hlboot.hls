# ============================================================================
# tools/hlboot.hls — the Stage-0 evaluator's front door (the native twin
# of the Python interpreter under tools/hlinterp/ that retired; same CLI,
# same wire law, same verdicts — driven through bin/hlboot, built by the
# bootstrap's own compiler).
# ----------------------------------------------------------------------------
# Usage (the boot.py surface, verbatim):
#   bin/hlboot [--check | --audit] <file.hls> [program args...]
#   bin/hlboot [--check] --batch <list-file> <log-file>
#   bin/hlboot [--det] <file.hls> [program args...]
#
# The evaluator itself lives in tools/hlboot_eval.hls (everything but
# this entry) so the REPL can link the same tables, the same evaluator,
# the same laws — one definition, two front doors. The file's own
# history and design notes travel with the library.
# ============================================================================

import "./hlboot_eval.hls"

fn main() -> int uses IO, Fs, Proc, Conc, Clock, Args, Exit, Rand, Net {
    let argv: list[str] = args()
    return hb_main_inner(argv)
}
