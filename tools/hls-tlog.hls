# ============================================================================
# tools/hls-tlog.hls — Stage 107 transparency log gossip (multi-source
# verify), the native Halis twin of the retired tools/hls-tlog.py +
# tools/hltlog_parts/ (chain, common, selftest, sources, witness).
#
# Same CLI, same wire, same exits:
#   hls-tlog verify [LOG] [--json]
#   hls-tlog summary [LOG] [--json]
#   hls-tlog gossip SOURCE... [--timeout S] [--max-bytes N]
#                       [--max-lag N] [--require N] [--json]
#   hls-tlog witness [LOG] --sign SECRET [--password-env VAR]
#                       [--out DIR] [--trusted-comment STR] [--force] [--json]
#   hls-tlog witness-verify WITNESS [-p PUB | -P HEX] [--against LOG] [--json]
#   hls-tlog prove NAME [VERSION] [--log LOG] [--seq N] [--out DIR] [--json]
#   hls-tlog prove-verify PROOF [--log LOG] [--json]
#   hls-tlog selftest
#
# The chain arithmetic is ONE definition — sha256(prev_hash +
# canonical-json(record minus chain_hash)), byte-identical to hpkg_log's
# writer since Stage 13 — and the acceptance gate pins hls-tlog verify to
# hls-pkg log --verify on the same file.
#
# The port carries its own crypto stack (the .py leaned on hlsign_parts):
# SHA-512 (RFC 6384 arithmetic on 32-bit half-words), a 16-bit-limb
# bignum, Ed25519 (RFC 8032, extended homogeneous coordinates), ChaCha20
# + Poly1305 (RFC 8439) and PBKDF2-HMAC-SHA256 — the minisign secret-key
# box and the two-signature witness files are byte-compatible with
# tools/hls-sign.py's, pinned by the acceptance gate.
#
# The private probe legs (the house pattern, cf. tools/hltest.hls
# --probe-hltest) expose the old hltlog_parts entry points the gate's
# fixture driver used to reach through a python3 child:
#   --probe-mklog <mode> [args...]   mk / mk_evil_mid / evilapp / consts /
#                                    selftest / onedeff / fetch / view /
#                                    tamper_w / tamper_prec / tamper_ptail
#   --probe-https <url>              tls_get in a child (a panic there is a
#                                    refused source, never a dead gossip)
#   --probe-ed25519                  the RFC 8032 vectors (dev parity leg)
# ============================================================================

import "std.sha256"
import "std.str"
import "std.json"
import "std.base64"
import "std.hex"
import "std.http"

# ----------------------------------------------------------------------------
# Constants (HLS has no globals — every constant is a fn).
# ----------------------------------------------------------------------------

fn tl_tool() -> str {
    return "hls-tlog"
}

fn tl_version() -> str {
    return "0.126.0-alpha"
}

fn tl_view_schema() -> str {
