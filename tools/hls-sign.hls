# ============================================================================
# tools/hls-sign.hls — Stage 106 signed packages (minisign, Ed25519),
# in Halis — the native twin of tools/hls-sign.py + tools/hlsign_parts/
# (hlsign_aead.py, hlsign_ed25519.py, hlsign_format.py,
# hlsign_release.py, all four folded in here, sectioned like the .py).
# ----------------------------------------------------------------------------
# Usage (the .py's own grammar, byte for byte on the wire):
#   hls-sign keygen [-f SECRET] [-p PUBLIC] [-c COMMENT]
#                   [--password-env VAR] [--iterations N] [--force]
#   hls-sign sign [-s SECRET] FILE [--sig-out PATH]
#                 [--trusted-comment STR] [--password-env VAR] [--json]
#   hls-sign verify [-p PUB | -P HEX] FILE [SIG] [--json]
#   hls-sign release DIR [--key SECRET] [--out DIR]
#               [--trusted-comment STR] [--password-env VAR] [--json]
#   hls-sign verify-release DIR [-p PUB | -P HEX] [--json]
#   hls-sign selftest
#
# The crypto is RFC-pinned, not folklore: Ed25519 (RFC 8032) proven
# against section 7.1's exact signature bytes, the secret-key box
# against RFC 8439's ChaCha20-Poly1305 (the sunscreen ciphertext,
# byte for byte), the KDF against PBKDF2-HMAC-SHA256's standard
# vectors. Python's bignums become 16x16-bit-limb arithmetic here
# (the field p = 2^255-19 folds 2^256 -> 38 and 2^255 -> 19; the
# group order L reduces by shift-subtract) — the algorithms are the
# .py's own, the limbs are how int64 carries them.
#
# The release gate audits the package tree through the REAL front-end
# (tools/hlfront.hls, linked): one package entry at a time, in a probe
# child that re-execs this binary with --probe-audit so a program that
# does not check is UNAUDITABLE, never a crash. The ledger is the same
# .hls-pkg-transparency.log every stage appends to (one "sign" record,
# chained); the audit log is Stage 112's .hls-audit.log (sign.keygen /
# sign.sign / sign.release, refusals recorded exactly like successes).
#
# Exit contract: 0 verified/released; 1 on any refusal; 2 usage.
# ============================================================================

import "./hlfront.hls"
import "std.str"
import "std.result"
import "std.sha256"
import "std.base64"
import "std.hex"
import "std.json"
import "std.hash"

