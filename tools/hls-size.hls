fn self_workload() -> str {
    return "hlc_self"
}

fn scratch_dir() -> str {
    return ".hlsize-out"
}

fn compile_recipe() -> str {
    return "gcc -O2 -o out out.c -lm -pthread"
}

fn hlc_source_entry() -> str {
    return "src/hlc.hls"
}

fn hlc_source_dir() -> str {
    return "src/hlc"
