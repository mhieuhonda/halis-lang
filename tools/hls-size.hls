# ============================================================================
# tools/hls-size.hls — the Stage 139 per-commit binary-size regression
# dashboard, in Halis (the native twin of the Python hls-size.py that
# retired; same CLI, same wire, same exits).
# ----------------------------------------------------------------------------
# The instrument is the compiler itself, and the measurement is the BYTES
# of its own output — the shipped girth, program and tool both:
#
#   record    compile every workload of the tracked suite (the tracked
#             default is benchmarks/size_watch/) through one instrument,
#             link each emission with the Makefile's own recipe
#             (cc -O2 -o out out.c -lm -pthread), read the five axes
#             (c_bytes, bin_bytes, text, data, bss through size(1)) and
#             append one entry pinned to `git rev-parse HEAD` (refused
#             on a dirty tree; --from-report imports a machine report
#             instead). The native record alone carries hlc_self — the
#             compiler's own girth.
#   sanction  a written excuse for one workload (reason mandatory)
#   gate      THE BYTE-EXACT LAW: no samples, no statistics, no noise
#             band — the same sources on the same toolchain make the
#             same bytes, so one byte of growth is a regression the
#             gate names. A workload regresses when ANY axis grows; it
#             improves only when every axis shrank-or-held and at least
#             one strictly shrank. exit 1 on any unsanctioned regressed
#             or vanished workload
#   dashboard the deterministic BINARYSIZE.md render (sha256 ledger
#             digest embedded; two renders of one ledger are
#             byte-identical)
#   history   read the ledger back
#
# Every record pins the compiler's identity (the sha256 over
# src/hlc.hls + src/hlc/*.hls and the sha256 of the binary measured
# through) AND the machine fingerprint (cc, arch, recipe) — the gate
# never compares across instruments or across machines, and the
# STALE-BINARY LAW bites at record time: a native record whose compiler
# digest was already filed against a DIFFERENT source digest is refused
# ("run make bootstrap first").
#
# The ledger is JSONL (default .hlsize/history.jsonl), append-only, one
# object per line. Everything lands in the STABLE scratch directory
# (.hlsize-out/) — same tree, same paths, same bytes every time; a
# random temp name would only test the filesystem, never the compiler.
#
# Exit codes: 0 verified / 1 named violation / 2 usage or IO error.
# ============================================================================

import "std.str"
import "std.json"
import "std.result"
import "std.option"
import "std.fmt"
import "std.sha256"

