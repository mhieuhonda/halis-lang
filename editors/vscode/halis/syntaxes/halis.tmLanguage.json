{
    "scopeName": "source.halis",
    "name": "Halis",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.halis",
                    "match": "#.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.halis",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.halis",
                            "match": "\\\\[nrt\"\\\\]"
                        },
                        {
                            "name": "invalid.illegal.escape.halis",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.halis",
                    "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][-+]?[0-9][0-9_]*)?\\b"
                },
                {
                    "name": "constant.numeric.integer.halis",
                    "match": "\\b[0-9][0-9_]*\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.halis",
                    "match": "\\b(if|else|while|for|in|return|break|continue|match)\\b"
                },
                {
                    "name": "keyword.other.halis",
                    "match": "\\b(fn|let|mut|struct|impl|enum|import|uses|pure|extern|requires|ensures)\\b"
                },
                {
                    "name": "constant.language.boolean.halis",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.halis",
                    "match": "\\b(int|float|bool|str|void|list|map|tainted|Chan|Task)\\b"
                },
                {
                    "name": "support.type.effect.halis",
                    "match": "\\b(IO|Fs|Clock|Args|Exit|Net|Rand|Proc|Conc)\\b"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "entity.name.function.halis",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
                },
                {
                    "name": "variable.other.halis",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
            ]
        }
    }
}
