{
    "name": "halis",
    "displayName": "Halis",
    "description": "Halis language support — LSP, formatter, linter, debugger",
    "version": "0.140.0-alpha",
    "publisher": "mhieuhonda",
    "license": "MIT",
    "engines": { "vscode": "^1.70.0" },
    "categories": ["Programming Languages", "Formatters", "Linters", "Debuggers"],
    "keywords": ["halis", "hls", "language-server", "lsp", "debugger", "dap"],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "halis",
                "aliases": ["Halis", "halis", "hls"],
                "extensions": [".hls"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "halis",
                "scopeName": "source.halis",
                "path": "./syntaxes/halis.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "halis.formatFile",
                "title": "Halis: Format File",
                "category": "Halis"
            },
            {
                "command": "halis.lintFile",
                "title": "Halis: Lint File",
                "category": "Halis"
            },
            {
                "command": "halis.restartServer",
                "title": "Halis: Restart Language Server",
                "category": "Halis"
            },
            {
                "command": "halis.startDebugging",
                "title": "Halis: Debug Program",
                "category": "Halis",
                "icon": "$(debug-alt)"
            }
        ],
        "breakpoints": [
            { "language": "halis" }
        ],
        "debuggers": [
            {
                "type": "halis",
                "label": "Halis Debug",
                "languages": ["halis"],
                "configurationAttributes": {
                    "launch": {
                        "required": ["program"],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Path to the .hls entry file (main is called with no CLI flags; program args go in `args`)."
                            },
                            "args": {
                                "type": "array",
                                "items": { "type": "string" },
                                "default": [],
                                "description": "Program arguments (argv[1:] as seen by the program)."
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "default": false,
                                "description": "Break at the first statement of main, before it runs."
                            },
                            "noDebug": {
                                "type": "boolean",
                                "default": false,
                                "description": "Run without stopping (stdout/stderr still reach the debug console)."
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "halis",
                        "request": "launch",
                        "name": "Debug Halis program",
                        "program": "${workspaceFolder}/main.hls"
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Halis: Launch Program",
                        "description": "Launch a Halis program under the Stage-0 debugger (breakpoints, stepping, variables, evaluate, panic stops).",
                        "body": {
                            "type": "halis",
                            "request": "launch",
                            "name": "Launch Program",
                            "program": "^\"\\${workspaceFolder}/main.hls\""
                        }
                    },
                    {
                        "label": "Halis: Launch with stopOnEntry",
                        "description": "Launch and break at the first statement of main.",
                        "body": {
                            "type": "halis",
                            "request": "launch",
                            "name": "Launch and Stop on Entry",
                            "program": "^\"\\${workspaceFolder}/main.hls\"",
                            "stopOnEntry": true
                        }
                    }
                ]
            }
        ],
        "configuration": {
            "title": "Halis",
            "properties": {
                "halis.languageServerPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the hls-lsp Python script. Leave empty to auto-discover via `hls-lsp` on PATH."
                },
                "halis.debugAdapterPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the hls-dap.py debug adapter. Leave empty to auto-discover in <workspace>/tools/ or on PATH."
                },
                "halis.formatOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Run `hlfmt -w` on save."
                },
                "halis.lintOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run `hllint` on save and surface warnings as diagnostics."
                },
                "halis.pythonPath": {
                    "type": "string",
                    "default": "python3",
                    "description": "Python interpreter used to run the LSP server, formatter, linter, and debug adapter."
                }
            }
        }
    },
    "activationEvents": [
        "onLanguage:halis",
        "onCommand:halis.restartServer",
        "onCommand:halis.startDebugging"
    ],
    "scripts": {
        "vscode:prepublish": "echo 'no build step'"
    },
    "devDependencies": {
        "@types/vscode": "^1.70.0",
        "@types/node": "^18.0.0"
    }
}
