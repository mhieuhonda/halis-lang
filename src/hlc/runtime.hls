    r.push("        pthread_cond_wait(&g_rt_cv, &g_rt_mu);")
    r.push("        g_rt_blocked--;")
    r.push("        g_rt_join_waiters--;")
    r.push("    }")
    r.push("    t->joined = true;")
    r.push("    g_rt_done_unjoined--;   // Stage 33: this task is now joined")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
