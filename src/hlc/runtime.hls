    r.push("            while (nslots[idx] != NULL) idx = (idx + 1) & (uint64_t)(ncap - 1);")
    r.push("            nslots[idx] = m->slots[i];")
    r.push("            nvals[idx] = m->vals[i];")
    r.push("        }")
    r.push("    }")
    r.push("    for (int64_t j = 0; j < m->len; j++) norder[j] = m->order[j];")
    r.push("    free(m->slots);")
    r.push("    free(m->vals);")
    r.push("    free(m->order);")
    r.push("    m->slots = nslots;")
    r.push("    m->vals = nvals;")
    r.push("    m->order = norder;")
    r.push("    m->cap = ncap;")
    r.push("}")
    r.push("")
    r.push("// hl_map_set: k and v arrive OWNED (the caller transferred one retain")
    r.push("// of each). On overwrite the incoming key is released and the old")
    r.push("// value is released. Store-then-release keeps self-assignment safe.")
    r.push("static void hl_map_set(hl_map* m, hl_str* k, void* v) {")
    r.push("    if ((m->len + 1) * 10 >= m->cap * 7) {")
    r.push("        hl_map_grow(m, m->cap * 2);")
    r.push("    }")
    r.push("    uint64_t idx = hl_str_hash(k) & (uint64_t)(m->cap - 1);")
    r.push("    while (m->slots[idx] != NULL) {")
    r.push("        if (hl_str_eq(m->slots[idx], k)) {")
    r.push("            void* oldv = m->vals[idx];")
    r.push("            m->vals[idx] = v;")
    r.push("            if (m->val_free) m->val_free(oldv);")
    r.push("            hl_str_release(k);")
    r.push("            return;")
    r.push("        }")
    r.push("        idx = (idx + 1) & (uint64_t)(m->cap - 1);")
    r.push("    }")
    r.push("    m->slots[idx] = k;")
    r.push("    m->vals[idx] = v;")
    r.push("    m->order[m->len] = k;")
    r.push("    m->len++;")
    r.push("}")
    r.push("")
    r.push("// hl_map_borrow: raw lookup — returns the stored slot value (a box for")
    r.push("// primitive-valued maps, the value itself for pointer-valued maps) or")
    r.push("// NULL when the key is missing. The map keeps ownership.")
    r.push("static void* hl_map_borrow(hl_map* m, hl_str* k) {")
    r.push("    uint64_t idx = hl_str_hash(k) & (uint64_t)(m->cap - 1);")
    r.push("    while (m->slots[idx] != NULL) {")
    r.push("        if (hl_str_eq(m->slots[idx], k)) return m->vals[idx];")
    r.push("        idx = (idx + 1) & (uint64_t)(m->cap - 1);")
    r.push("    }")
    r.push("    return NULL;")
    r.push("}")
    r.push("")
    r.push("// Typed getters for primitive-valued maps: the default arrives by")
    r.push("// value — no boxing, no allocation, no refcount traffic.")
    r.push("static int64_t hl_map_get_i64(hl_map* m, hl_str* k, int64_t dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v == NULL) return dflt;")
    r.push("    return hl_unbox_i64(v);")
    r.push("}")
    r.push("static double hl_map_get_f64(hl_map* m, hl_str* k, double dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v == NULL) return dflt;")
    r.push("    return hl_unbox_f64(v);")
    r.push("}")
    r.push("static bool hl_map_get_bool(hl_map* m, hl_str* k, bool dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v == NULL) return dflt;")
    r.push("    return hl_unbox_bool(v);")
    r.push("}")
    r.push("")
    r.push("// hl_map_get_own: for pointer-valued maps. dflt arrives OWNED (+1)")
    r.push("// and the result is returned OWNED (+1).")
    r.push("static void* hl_map_get_own(hl_map* m, hl_str* k, void* dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v != NULL) {")
    r.push("        hl_retain(v);")
    r.push("        if (m->val_free) m->val_free(dflt);")
    r.push("        return v;")
    r.push("    }")
    r.push("    return dflt;")
    r.push("}")
    r.push("")
    r.push("static bool hl_map_has(hl_map* m, hl_str* k) { return hl_map_borrow(m, k) != NULL; }")
    r.push("")
    r.push("static int64_t hl_map_len(hl_map* m) { return m->len; }")
    r.push("")
    r.push("// hl_map_keys: fresh list[str]; each key is retained for the new list.")
    r.push("static hl_list* hl_map_keys(hl_map* m) {")
    r.push("    hl_list* r = hl_list_new(hl_str_release);")
    r.push("    for (int64_t i = 0; i < m->len; i++) hl_list_push(r, hl_retain(m->order[i]));")
    r.push("    return r;")
    r.push("}")
    r.push("")
    r.push("// ---- checked int64 arithmetic ----")
    r.push("static int64_t hl_add_i64(int64_t a, int64_t b) {")
    r.push("    int64_t r;")
    r.push("    if (__builtin_add_overflow(a, b, &r)) hl_die(\"integer overflow\");")
    r.push("    return r;")
    r.push("}")
    r.push("static int64_t hl_sub_i64(int64_t a, int64_t b) {")
    r.push("    int64_t r;")
    r.push("    if (__builtin_sub_overflow(a, b, &r)) hl_die(\"integer overflow\");")
    r.push("    return r;")
    r.push("}")
    r.push("static int64_t hl_mul_i64(int64_t a, int64_t b) {")
    r.push("    int64_t r;")
    r.push("    if (__builtin_mul_overflow(a, b, &r)) hl_die(\"integer overflow\");")
    r.push("    return r;")
    r.push("}")
    r.push("static int64_t hl_neg_i64(int64_t a) {")
    r.push("    if (a == INT64_MIN) hl_die(\"integer overflow\");")
    r.push("    return -a;")
    r.push("}")
    r.push("static int64_t hl_abs_i64(int64_t a) {")
    r.push("    if (a == INT64_MIN) hl_die(\"integer overflow\");")
    r.push("    return a < 0 ? -a : a;")
    r.push("}")
    r.push("static int64_t hl_div_i64(int64_t a, int64_t b) {")
    r.push("    if (b == 0) hl_die(\"division by zero\");")
    r.push("    if (a == INT64_MIN && b == -1) hl_die(\"integer overflow\");")
    r.push("    return a / b;")
    r.push("}")
    r.push("static int64_t hl_mod_i64(int64_t a, int64_t b) {")
    r.push("    if (b == 0) hl_die(\"division by zero\");")
    r.push("    if (a == INT64_MIN && b == -1) hl_die(\"integer overflow\");")
    r.push("    return a % b;")
    r.push("}")
    r.push("")
    r.push("// ---- I/O (print-family builtins CONSUME their str argument) ----")
    r.push("static hl_list* g_hl_args = NULL;")
    r.push("")
    r.push("static void hl_init_args(int argc, char** argv) {")
    r.push("    g_hl_args = hl_list_new(hl_str_release);")
    r.push("    for (int i = 0; i < argc; i++) {")
    r.push("        hl_list_push(g_hl_args, hl_str_from(argv[i], (int64_t)strlen(argv[i])));")
    r.push("    }")
    r.push("}")
    r.push("")
    r.push("static hl_list* hl_args(void) { return g_hl_args; }")
    r.push("")
    r.push("static void hl_print(hl_str* s) {")
    r.push("    fwrite(s->data, 1, (size_t)s->len, stdout);")
    r.push("    hl_str_release(s);")
    r.push("}")
    r.push("")
    r.push("static void hl_println(hl_str* s) {")
    r.push("    fwrite(s->data, 1, (size_t)s->len, stdout);")
    r.push("    fputc('\\n', stdout);")
    r.push("    hl_str_release(s);")
    r.push("}")
    r.push("")
    # ----- Stage 56 (v0.75.0-alpha): stderr + TTY-detection helpers -----
    # hl_eprint / hl_eprintln write to stderr, consuming the str (the
    # same ownership convention as hl_print / hl_println). They
    # fflush(stdout) FIRST: when both streams are redirected into one
    # capture, C stdout is block-buffered while stderr is unbuffered —
    # without the flush every stderr line would land BEFORE every
    # stdout line. With the flush the combined capture preserves the
    # caller's logical order, and the Stage-0 interpreter (which
    # flushes self.out before writing sys.stderr.buffer) produces
    # byte-identical interleaving. This mirrors the deep-scan-22 fix
    # that added fflush(stdout) to proc_exec / proc_spawn.
    r.push("// Stage 56 (v0.75.0-alpha): hl_eprint / hl_eprintln — write to")
    r.push("// stderr, consuming the str argument (same convention as")
    r.push("// hl_print / hl_println). fflush(stdout) first so interleaved")
    r.push("// stdout/stderr output keeps the caller's logical order in a")
    r.push("// combined capture (stdout is block-buffered when redirected).")
    r.push("static void hl_eprint(hl_str* s) {")
    r.push("    fflush(stdout);")
    r.push("    fwrite(s->data, 1, (size_t)s->len, stderr);")
    r.push("    hl_str_release(s);")
    r.push("}")
    r.push("")
    r.push("static void hl_eprintln(hl_str* s) {")
    r.push("    fflush(stdout);")
    r.push("    fwrite(s->data, 1, (size_t)s->len, stderr);")
    r.push("    fputc('\\n', stderr);")
    r.push("    hl_str_release(s);")
    r.push("}")
    r.push("")
    r.push("// Stage 56 (v0.75.0-alpha): hl_isatty — true when fd refers to a")
    r.push("// terminal. isatty() is declared in <unistd.h> (already included).")
    r.push("// Invalid / negative fds simply return false (isatty sets EBADF")
    r.push("// and returns 0 — no panic, no UB), matching os.isatty in the")
    r.push("// Stage-0 interpreter byte-for-byte.")
    r.push("static bool hl_isatty(int64_t fd) {")
    r.push("    return isatty((int)fd);")
    r.push("}")
    r.push("")
    # ----- Stage 57 (v0.76.0-alpha): process-identity runtime helpers -----
    # getpid is declared in <unistd.h> (already included); gethostname
    # likewise (POSIX; exposed by _DEFAULT_SOURCE, which gcc's default
    # gnu17 mode defines). sys_hostname returns a FRESH str; the
    # fallback "localhost" keeps the function total (a failed
    # gethostname — truncated name, ENAMETOOLONG — never panics).
    r.push("// Stage 57 (v0.76.0-alpha): hl_proc_pid — the OS process id")
    r.push("// (the syslog TAG[PID] field). getpid never fails on POSIX.")
    r.push("static int64_t hl_proc_pid(void) {")
    r.push("    return (int64_t)getpid();")
    r.push("}")
    r.push("")
    r.push("// Stage 57 (v0.76.0-alpha): hl_sys_hostname — the host name (the")
    r.push("// syslog HOSTNAME field). Returns a fresh str; \"localhost\" on")
    r.push("// any gethostname failure (kept total — no panic path).")
    r.push("static hl_str* hl_sys_hostname(void) {")
    r.push("    char buf[256];")
    r.push("    if (gethostname(buf, sizeof(buf) - 1) != 0) {")
    r.push("        return hl_str_from(\"localhost\", 9);")
    r.push("    }")
    r.push("    buf[sizeof(buf) - 1] = '\\0';")
    r.push("    size_t n = strlen(buf);")
    r.push("    return hl_str_from(buf, (int64_t)n);")
    r.push("}")
    r.push("")
    r.push("// hl_read_file: consumes the path, returns a fresh str. The temporary")
    r.push("// read buffer is freed before returning (it used to leak under the")
    r.push("// arena model).")
    r.push("static hl_str* hl_read_file(hl_str* path) {")
    r.push("    hl_sandbox_check(path->data);")
    r.push("    FILE* f = fopen(path->data, \"rb\");")
    r.push("    if (!f) hl_die(\"cannot open file\");")
    r.push("    // Virtual files (/proc, /sys) report size 0 via fseek/ftell,")
    r.push("    // so read incrementally until EOF instead of trusting the")
    r.push("    // size (BUG: the interpreter read them fine while the native")
    r.push("    // binary got empty output — a differential divergence).")
    r.push("    size_t cap = 4096, len = 0;")
    r.push("    char* buf = (char*)malloc(cap);")
    r.push("    if (!buf) hl_die(\"out of memory\");")
    r.push("    for (;;) {")
    r.push("        if (len == cap) {")
    r.push("            size_t new_cap = cap * 2;")
    r.push("            // Deep-scan fix (C10): realloc-on-failure leaks the")
    r.push("            // original buffer. Use a temp so the original is")
    r.push("            // still freeable on OOM.")
    r.push("            char* nb = (char*)realloc(buf, new_cap);")
    r.push("            if (!nb) { free(buf); hl_die(\"out of memory\"); }")
    r.push("            buf = nb;")
    r.push("            cap = new_cap;")
    r.push("        }")
    r.push("        size_t n = fread(buf + len, 1, cap - len, f);")
    r.push("        len += n;")
    r.push("        if (n == 0) break;")
    r.push("    }")
    r.push("    fclose(f);")
    r.push("    hl_str* out = hl_str_from(buf, (int64_t)len);")
    r.push("    free(buf);")
    r.push("    hl_str_release(path);")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// Stage 10 release: hl_read_line() — read one line from stdin.")
    r.push("// Strips a trailing newline (and CRLF if present). Returns a fresh")
    r.push("// hl_str* (refcount 1) owned by the caller. At EOF, returns an")
    r.push("// empty string (mirrors fgets semantics). The Stage-0 interpreter")
    r.push("// strips CRLF the same way so differential testing stays green.")
    r.push("static hl_str* hl_read_line(void) {")
    r.push("    size_t cap = 128, len = 0;")
    r.push("    char* buf = (char*)malloc(cap);")
    r.push("    if (!buf) hl_die(\"out of memory\");")
    r.push("    for (;;) {")
    r.push("        int c = getchar();")
    r.push("        if (c == EOF) break;")
    r.push("        if (len + 1 >= cap) {")
    r.push("            cap *= 2;")
    r.push("            char* nb = (char*)realloc(buf, cap);")
    r.push("            if (!nb) { free(buf); hl_die(\"out of memory\"); }")
    r.push("            buf = nb;")
    r.push("        }")
    r.push("        buf[len++] = (char)c;")
    r.push("        if (c == '\\n') break;")
    r.push("    }")
    r.push("    // Strip trailing \\n and \\r\\n.")
    r.push("    if (len > 0 && buf[len - 1] == '\\n') {")
    r.push("        len--;")
    r.push("        if (len > 0 && buf[len - 1] == '\\r') len--;")
    r.push("    }")
    r.push("    hl_str* out = hl_str_from(buf, (int64_t)len);")
    r.push("    free(buf);")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// hl_write_file: consumes the path and the content.")
    r.push("static void hl_write_file(hl_str* path, hl_str* content) {")
    r.push("    hl_sandbox_check(path->data);")
    r.push("    FILE* f = fopen(path->data, \"wb\");")
    r.push("    if (!f) hl_die(\"cannot write file\");")
    r.push("    if (content->len > 0 && fwrite(content->data, 1, (size_t)content->len, f) != (size_t)content->len) {")
    r.push("        hl_die(\"cannot write file\");")
    r.push("    }")
    r.push("    if (fclose(f) != 0) hl_die(\"cannot write file\");")
    r.push("    hl_str_release(content);")
    r.push("    hl_str_release(path);")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_clock_ms(void) {")
    r.push("    struct timespec ts;")
    r.push("    clock_gettime(CLOCK_MONOTONIC, &ts);")
    r.push("    return (int64_t)ts.tv_sec * 1000 + (int64_t)ts.tv_nsec / 1000000;")
    r.push("}")
    r.push("")
    # Stage 46 (v0.65.0-alpha): thread / scheduling runtime helpers.
    # hl_thread_sleep_ms(ms) blocks the calling thread for ms
    # milliseconds via nanosleep. A negative duration is a programming
    # error (the checker rejects literal negatives; dynamic negatives
    # panic here). The sleep is interruptible by signals only in the
    # sense that nanosleep returns the remaining time — we loop to
    # re-sleep the remainder so the full duration always elapses.
    # This matches the interpreter's time.sleep behaviour (which is
    # also uninterruptible from the user's perspective).
    r.push("static void hl_thread_sleep_ms(int64_t ms) {")
    r.push("    if (ms < 0) hl_die(\"thread_sleep_ms: duration must be >= 0\");")
    r.push("    if (ms == 0) {")
    r.push("        // Sleep(0) on POSIX: yield via sched_yield, not nanosleep(0).")
    r.push("        // nanosleep(0) is a no-op (returns immediately) which is")
    r.push("        // correct but less scheduler-friendly than sched_yield.")
    r.push("        sched_yield();")
    r.push("        return;")
    r.push("    }")
    r.push("    struct timespec req;")
    r.push("    req.tv_sec = ms / 1000;")
    r.push("    req.tv_nsec = (ms % 1000) * 1000000L;")
    r.push("    while (nanosleep(&req, &req) == -1 && errno == EINTR) {")
    r.push("        // Re-sleep the remainder after a signal interruption.")
    r.push("    }")
    r.push("}")
    r.push("")
    # hl_thread_yield() — hint the scheduler to switch. Uses
    # sched_yield() on POSIX. The interpreter uses time.sleep(0)
    # which yields the GIL — equivalent semantics.
    r.push("static void hl_thread_yield(void) {")
    r.push("    sched_yield();")
    r.push("}")
    r.push("")
    # hl_thread_current_id() — non-zero thread identifier. Uses
    # pthread_self() cast to int64. The actual value is implementation-
    # defined (may differ between interpreter and native); callers
    # must only rely on "different threads get different IDs".
    r.push("static int64_t hl_thread_current_id(void) {")
    r.push("    return (int64_t)pthread_self();")
    r.push("}")
    r.push("")
    r.push("static void hl_panic(hl_str* msg) {")
    if fs {
        r.push("    (void)msg;")
        r.push("    __builtin_trap();")
        r.push("}")
    } else {
        r.push("    fflush(stdout);")
        r.push("    fprintf(stderr, \"panic: %s\\n\", msg->data);")
        r.push("    exit(101);")
        r.push("}")
    }
    r.push("")
    r.push("static void hl_exit(int64_t code) {")
    r.push("    fflush(stdout);")
    r.push("    exit((int)code);")
    r.push("}")
    r.push("")
    # ---- Stage 9 release (v0.20.0-alpha): Net / Rand / Proc runtime ----
    # HalisRNG — a 64-bit LCG shared with the Stage-0 interpreter.
    # Same constants (Knuth's MMIX), same bit-mask, same float extraction
    # → same sequence for the same seed. This is CRITICAL for
    # differential testing: a test using rand_seed + rand_int/rand_float
    # must produce identical output in both backends, otherwise the
    # test suite would fail.
    # Algorithm:
    #   state = state * 6364136223846793005 + 1442695040888963407   (mod 2^64)
    #   rand_int(max) = state % max   (max > 0)
    #   rand_float()  = (state >> 11) / 2^53   (53 bits of randomness)
    r.push("static uint64_t hl_rng_state = 1;  /* nonzero default */")
    r.push("")
    r.push("static void hl_rand_seed(int64_t s) {")
    r.push("    hl_rng_state = (uint64_t)s;")
    r.push("    if (hl_rng_state == 0) hl_rng_state = 1;  /* avoid degenerate seq */")
    r.push("}")
    r.push("")
    r.push("static uint64_t hl_rng_next(void) {")
    r.push("    hl_rng_state = hl_rng_state * 6364136223846793005ULL + 1442695040888963407ULL;")
    r.push("    return hl_rng_state;")
    r.push("}")
    r.push("")
    # hl_rand_int(max) — uniform random int in [0, max). Panics on max <= 0
    # (matches the interpreter). Modulo bias is bounded by the caller's
    # choice of max; for cryptographically-unbiased randomness, use a
    # rejection-sampling wrapper (deferred to a future stage).
    r.push("static int64_t hl_rand_int(int64_t max) {")
    r.push("    if (max <= 0) hl_die(\"rand_int() requires a positive max\");")
    r.push("    uint64_t r = hl_rng_next();")
    r.push("    return (int64_t)(r % (uint64_t)max);")
    r.push("}")
    r.push("")
    # hl_rand_float() — uniform random float in [0.0, 1.0). 53 bits of
    # randomness — full precision of an IEEE double's significand.
    r.push("static double hl_rand_float(void) {")
    r.push("    uint64_t r = hl_rng_next();")
    r.push("    return (double)(r >> 11) / (double)(1ULL << 53);")
    r.push("}")
    r.push("")
    # hl_net_lookup(host) — DNS A record lookup via getaddrinfo. Returns
    # the first IPv4 address as a fresh str. Panics on failure (DNS
    # error or no A records). Consumes the host argument.
    r.push("static hl_str* hl_net_lookup(hl_str* host) {")
    r.push("    struct addrinfo hints;")
    r.push("    memset(&hints, 0, sizeof(hints));")
    r.push("    hints.ai_family = AF_INET;")
    r.push("    hints.ai_socktype = SOCK_STREAM;")
    r.push("    struct addrinfo* res = NULL;")
    r.push("    int rc = getaddrinfo(host->data, NULL, &hints, &res);")
    r.push("    if (rc != 0 || res == NULL) {")
    r.push("        hl_str_release(host);")
    r.push("        hl_die(\"net_lookup: DNS resolution failed\");")
    r.push("    }")
    r.push("    char addr_buf[INET_ADDRSTRLEN];")
    r.push("    const char* r = inet_ntop(AF_INET,")
    r.push("        &((struct sockaddr_in*)res->ai_addr)->sin_addr,")
    r.push("        addr_buf, sizeof(addr_buf));")
    r.push("    freeaddrinfo(res);")
    r.push("    if (!r) {")
    r.push("        hl_str_release(host);")
    r.push("        hl_die(\"net_lookup: inet_ntop failed\");")
    r.push("    }")
    r.push("    hl_str* out = hl_str_from(addr_buf, (int64_t)strlen(addr_buf));")
    r.push("    hl_str_release(host);")
    r.push("    return out;")
    r.push("}")
    r.push("")
    # hl_proc_exec(cmd) — run a shell command via system(). Returns the
    # exit code (0 on success, 1..255 on failure, 128+signum on signal
    # kill). Consumes the cmd argument. The checker enforces that the
    # command is not tainted (proc_exec is a taint sink).
    #
    # Stage 53 deep-scan-22 fix (MEDIUM): fflush(stdout) before system()
    # so the child's output ordering matches the parent's println output.
    # Without this, block-buffered stdout (when piped to a file or
    # another process) delays the parent's println output until after
    # the child's printf output appears — a differential mismatch with
    # the interpreter (which uses Python's line-buffered sys.stdout).
    r.push("static int64_t hl_proc_exec(hl_str* cmd) {")
    r.push("    fflush(stdout);")
    r.push("    int rc = system(cmd->data);")
    r.push("    hl_str_release(cmd);")
    r.push("    if (rc == -1) {")
    r.push("        hl_die(\"proc_exec: system() failed\");")
    r.push("    }")
    r.push("#ifdef WIFEXITED")
    r.push("    if (WIFEXITED(rc)) return (int64_t)WEXITSTATUS(rc);")
    r.push("    if (WIFSIGNALED(rc)) return (int64_t)(128 + WTERMSIG(rc));")
    r.push("#else")
    r.push("    return (int64_t)(rc & 0xFF);")
    r.push("#endif")
    r.push("    return (int64_t)(rc & 0xFF);")
    r.push("}")
    r.push("")
    # ----- Stage 47 (v0.66.0-alpha): process management runtime -----
    # The C runtime manages child processes in a fixed-size table
    # (hl_proc_children[HL_PROC_MAX_CHILDREN]) indexed by a Halis-level
    # pid (1..HL_PROC_MAX_CHILDREN). This mirrors the interpreter's
    # approach: the OS pid differs between interpreter and native, so
    # we expose our own pid namespace to keep differential testing
    # byte-exact. The table holds: pid (OS), stdin_fd, stdout_fd,
    # stderr_fd (parent ends of the pipes; -1 if not piped), and
    # a state flag (1=alive, 0=exited, -1=slot free).
    r.push("#define HL_PROC_MAX_CHILDREN 64")
    r.push("struct hl_proc_child {")
    r.push("    pid_t os_pid;          /* OS pid, 0 if slot free */")
    r.push("    int   stdin_fd;        /* parent write end; -1 if not piped */")
    r.push("    int   stdout_fd;       /* parent read end; -1 if not piped */")
    r.push("    int   stderr_fd;       /* parent read end; -1 if not piped */")
    r.push("    int   exited;          /* 1=exited (status valid), 0=alive */")
    r.push("    int   exit_status;     /* encoded: 0..255 / 128+signum */")
    r.push("};")
    r.push("static struct hl_proc_child hl_proc_children[HL_PROC_MAX_CHILDREN];")
    r.push("")
    # hl_proc_alloc_slot — find a free slot, returning its index (1-based
    # Halis pid). Returns 0 if the table is full (caller reports -1).
    r.push("static int hl_proc_alloc_slot(void) {")
    r.push("    for (int i = 0; i < HL_PROC_MAX_CHILDREN; i++) {")
    r.push("        if (hl_proc_children[i].os_pid == 0) {")
    r.push("            return i + 1;  /* Halis pid = slot + 1 (>= 1) */")
    r.push("        }")
    r.push("    }")
    r.push("    return 0;  /* table full */")
    r.push("}")
    r.push("")
    # hl_proc_spawn(program, args, stdin_kind, stdout_kind, stderr_kind)
    #   -> int (Halis pid >= 1, or -1 on failure).
    # Forks + execs the program with the given args list (each element
    # becomes argv[1..]). stdio_kind: 0=Inherit, 1=Pipe, 2=Null.
    # Consumes program and args.
    r.push("static int64_t hl_proc_spawn(hl_str* program, hl_list* args,")
    r.push("                            int64_t stdin_kind, int64_t stdout_kind,")
    r.push("                            int64_t stderr_kind) {")
    r.push("    if (stdin_kind < 0 || stdin_kind > 2 ||")
    r.push("        stdout_kind < 0 || stdout_kind > 2 ||")
    r.push("        stderr_kind < 0 || stderr_kind > 2) {")
    r.push("        hl_str_release(program);")
    r.push("        hl_list_release(args);")
    r.push("        hl_die(\"proc_spawn: stdio kind must be 0/1/2\");")
    r.push("    }")
    r.push("    int slot = hl_proc_alloc_slot();")
    r.push("    if (slot == 0) {")
    r.push("        hl_str_release(program);")
    r.push("        hl_list_release(args);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    int in_pipe[2] = {-1, -1};")
    r.push("    int out_pipe[2] = {-1, -1};")
    r.push("    int err_pipe[2] = {-1, -1};")
    r.push("    if (stdin_kind == 1 && pipe(in_pipe) < 0) {")
    r.push("        hl_str_release(program);")
    r.push("        hl_list_release(args);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    if (stdout_kind == 1 && pipe(out_pipe) < 0) {")
    r.push("        if (in_pipe[0] != -1) close(in_pipe[0]);")
    r.push("        if (in_pipe[1] != -1) close(in_pipe[1]);")
    r.push("        hl_str_release(program);")
    r.push("        hl_list_release(args);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    if (stderr_kind == 1 && pipe(err_pipe) < 0) {")
    r.push("        if (in_pipe[0] != -1) close(in_pipe[0]);")
    r.push("        if (in_pipe[1] != -1) close(in_pipe[1]);")
    r.push("        if (out_pipe[0] != -1) close(out_pipe[0]);")
    r.push("        if (out_pipe[1] != -1) close(out_pipe[1]);")
    r.push("        hl_str_release(program);")
    r.push("        hl_list_release(args);")
    r.push("        return -1;")
    r.push("    }")
    # Stage 53 deep-scan-22 fix (MEDIUM): fflush stdout before fork() so
    # the child's output ordering matches the parent's println output
    # (same rationale as hl_proc_exec above). Without this, block-buffered
    # stdout delays the parent's pending println until after the child's
    # output appears — a differential mismatch with the interpreter.
    r.push("    fflush(stdout);")
    r.push("    pid_t pid = fork();")
    r.push("    if (pid < 0) {")
    r.push("        if (in_pipe[0] != -1) close(in_pipe[0]);")
    r.push("        if (in_pipe[1] != -1) close(in_pipe[1]);")
    r.push("        if (out_pipe[0] != -1) close(out_pipe[0]);")
    r.push("        if (out_pipe[1] != -1) close(out_pipe[1]);")
    r.push("        if (err_pipe[0] != -1) close(err_pipe[0]);")
    r.push("        if (err_pipe[1] != -1) close(err_pipe[1]);")
    r.push("        hl_str_release(program);")
    r.push("        hl_list_release(args);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    if (pid == 0) {")
    r.push("        /* Child: dup2 the pipe ends onto the std fds, then exec. */")
    r.push("        if (stdin_kind == 1) {")
    r.push("            dup2(in_pipe[0], 0);")
    r.push("            close(in_pipe[1]);")
    r.push("        } else if (stdin_kind == 2) {")
    r.push("            int devnull = open(\"/dev/null\", O_RDONLY);")
    r.push("            if (devnull >= 0) { dup2(devnull, 0); close(devnull); }")
    r.push("        }")
    r.push("        if (stdout_kind == 1) {")
    r.push("            dup2(out_pipe[1], 1);")
    r.push("            close(out_pipe[0]);")
    r.push("        } else if (stdout_kind == 2) {")
    r.push("            int devnull = open(\"/dev/null\", O_WRONLY);")
    r.push("            if (devnull >= 0) { dup2(devnull, 1); close(devnull); }")
    r.push("        }")
    r.push("        if (stderr_kind == 1) {")
    r.push("            dup2(err_pipe[1], 2);")
    r.push("            close(err_pipe[0]);")
    r.push("        } else if (stderr_kind == 2) {")
    r.push("            int devnull = open(\"/dev/null\", O_WRONLY);")
    r.push("            if (devnull >= 0) { dup2(devnull, 2); close(devnull); }")
    r.push("        }")
    r.push("        /* Close any other pipe fds the child shouldn't have. */")
    r.push("        if (stdin_kind == 1) close(in_pipe[0]);")
    r.push("        if (stdout_kind == 1) close(out_pipe[1]);")
    r.push("        if (stderr_kind == 1) close(err_pipe[1]);")
    r.push("        /* Build argv[] from program + args. */")
    r.push("        int64_t n = hl_list_len(args);")
    r.push("        char** argv = (char**)malloc(sizeof(char*) * (size_t)(n + 2));")
    r.push("        if (!argv) _exit(127);")
    r.push("        argv[0] = program->data;")
    r.push("        for (int64_t i = 0; i < n; i++) {")
    r.push("            hl_str* elem = (hl_str*)hl_list_get(args, i);")
    r.push("            argv[i + 1] = elem ? elem->data : (char*)\"\";")
    r.push("        }")
    r.push("        argv[n + 1] = NULL;")
    r.push("        execvp(program->data, argv);")
    r.push("        /* execvp only returns on failure. */")
    r.push("        _exit(127);")
    r.push("    }")
    r.push("    /* Parent: close the child's ends of the pipes. */")
    r.push("    if (stdin_kind == 1) { close(in_pipe[0]); }")
    r.push("    if (stdout_kind == 1) { close(out_pipe[1]); }")
    r.push("    if (stderr_kind == 1) { close(err_pipe[1]); }")
    r.push("    struct hl_proc_child* c = &hl_proc_children[slot - 1];")
    r.push("    c->os_pid = pid;")
    r.push("    c->stdin_fd = (stdin_kind == 1) ? in_pipe[1] : -1;")
    r.push("    c->stdout_fd = (stdout_kind == 1) ? out_pipe[0] : -1;")
    r.push("    c->stderr_fd = (stderr_kind == 1) ? err_pipe[0] : -1;")
    r.push("    c->exited = 0;")
    r.push("    c->exit_status = 0;")
    r.push("    hl_str_release(program);")
    r.push("    hl_list_release(args);")
    r.push("    return (int64_t)slot;")
    r.push("}")
    r.push("")
    # hl_proc_wait(pid) -> int — block until child exits; return encoded
    # exit status. Returns -1 if the pid is invalid.
    r.push("static int64_t hl_proc_wait(int64_t hl_pid) {")
    r.push("    if (hl_pid < 1 || hl_pid > HL_PROC_MAX_CHILDREN) return -1;")
    r.push("    struct hl_proc_child* c = &hl_proc_children[hl_pid - 1];")
    r.push("    if (c->os_pid == 0) return -1;")
    r.push("    if (c->exited) return (int64_t)c->exit_status;")
    r.push("    /* Close any open write ends so the child sees EOF on stdin. */")
    r.push("    if (c->stdin_fd != -1) { close(c->stdin_fd); c->stdin_fd = -1; }")
    r.push("    int status = 0;")
    r.push("    if (waitpid(c->os_pid, &status, 0) < 0) {")
    r.push("        return -1;")
    r.push("    }")
    r.push("    int encoded;")
    r.push("#ifdef WIFEXITED")
    r.push("    if (WIFEXITED(status)) encoded = WEXITSTATUS(status);")
    r.push("    else if (WIFSIGNALED(status)) encoded = 128 + WTERMSIG(status);")
    r.push("    else encoded = -1;")
    r.push("#else")
    r.push("    encoded = status & 0xFF;")
    r.push("#endif")
    r.push("    c->exited = 1;")
    r.push("    c->exit_status = encoded;")
    r.push("    return (int64_t)encoded;")
    r.push("}")
    r.push("")
    # hl_proc_kill(pid) -> int — send SIGTERM. Returns 0 on success,
    # -1 on error. Idempotent on already-exited children.
    r.push("static int64_t hl_proc_kill(int64_t hl_pid) {")
    r.push("    if (hl_pid < 1 || hl_pid > HL_PROC_MAX_CHILDREN) return -1;")
    r.push("    struct hl_proc_child* c = &hl_proc_children[hl_pid - 1];")
    r.push("    if (c->os_pid == 0) return -1;")
    r.push("    if (c->exited) return 0;")
    r.push("    if (kill(c->os_pid, SIGTERM) < 0) {")
    r.push("        /* ESRCH = child already reaped. Treat as success. */")
    r.push("        if (errno == ESRCH) return 0;")
    r.push("        return -1;")
    r.push("    }")
    r.push("    return 0;")
    r.push("}")
    r.push("")
    # hl_proc_child_write(pid, data) -> int — write to child's stdin.
    r.push("static int64_t hl_proc_child_write(int64_t hl_pid, hl_str* data) {")
    r.push("    if (hl_pid < 1 || hl_pid > HL_PROC_MAX_CHILDREN) {")
    r.push("        hl_str_release(data);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    struct hl_proc_child* c = &hl_proc_children[hl_pid - 1];")
    r.push("    if (c->os_pid == 0 || c->stdin_fd == -1) {")
    r.push("        hl_str_release(data);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    ssize_t n = write(c->stdin_fd, data->data, (size_t)data->len);")
    r.push("    hl_str_release(data);")
    r.push("    if (n < 0) return -1;")
    r.push("    return (int64_t)n;")
    r.push("}")
    r.push("")
    # hl_proc_child_read(pid, fd_kind, n) -> str — read from child's
    # stdout (fd_kind=1) or stderr (fd_kind=2).
    r.push("static hl_str* hl_proc_child_read(int64_t hl_pid, int64_t fd_kind,")
    r.push("                                int64_t n) {")
    r.push("    if (hl_pid < 1 || hl_pid > HL_PROC_MAX_CHILDREN)")
    r.push("        return hl_str_from(\"\", 0);")
    r.push("    struct hl_proc_child* c = &hl_proc_children[hl_pid - 1];")
    r.push("    if (c->os_pid == 0) return hl_str_from(\"\", 0);")
    r.push("    int fd = -1;")
    r.push("    if (fd_kind == 1) fd = c->stdout_fd;")
    r.push("    else if (fd_kind == 2) fd = c->stderr_fd;")
    r.push("    else return hl_str_from(\"\", 0);")
    r.push("    if (fd == -1) return hl_str_from(\"\", 0);")
    r.push("    if (n < 0) n = 0;")
    r.push("    if (n > (64 * 1024 * 1024)) n = 64 * 1024 * 1024;  /* 64 MiB cap */")
    r.push("    char* buf = (char*)malloc((size_t)n + 1);")
    r.push("    if (!buf) return hl_str_from(\"\", 0);")
    r.push("    ssize_t got = read(fd, buf, (size_t)n);")
    r.push("    if (got < 0) got = 0;")
    r.push("    hl_str* out = hl_str_from(buf, (int64_t)got);")
    r.push("    free(buf);")
    r.push("    return out;")
    r.push("}")
    r.push("")
    # hl_proc_child_close(pid, fd_kind) -> int — close the parent end
    # of the child's stdio pipe. Idempotent (closing a closed pipe
    # returns 0).
    r.push("static int64_t hl_proc_child_close(int64_t hl_pid, int64_t fd_kind) {")
    r.push("    if (hl_pid < 1 || hl_pid > HL_PROC_MAX_CHILDREN) return -1;")
    r.push("    struct hl_proc_child* c = &hl_proc_children[hl_pid - 1];")
    r.push("    if (c->os_pid == 0) return -1;")
    r.push("    if (fd_kind < 0 || fd_kind > 2) return -1;")
    r.push("    int* fd_ptr;")
    r.push("    if (fd_kind == 0) fd_ptr = &c->stdin_fd;")
    r.push("    else if (fd_kind == 1) fd_ptr = &c->stdout_fd;")
    r.push("    else fd_ptr = &c->stderr_fd;")
    r.push("    if (*fd_ptr == -1) return 0;  /* idempotent */")
    r.push("    if (close(*fd_ptr) < 0) {")
    r.push("        *fd_ptr = -1;")
    r.push("        return -1;")
    r.push("    }")
    r.push("    *fd_ptr = -1;")
    r.push("    return 0;")
    r.push("}")
    r.push("")
    # ----- Stage 48 (v0.67.0-alpha): environment + cwd runtime helpers -----
    # All helpers consume their str argument(s) (the runtime calls
    # hl_str_release after using the str). The str argument is NUL-
    # terminated (the runtime accesses ->data directly); env vars
    # and cwd paths can contain any byte except NUL (POSIX restriction),
    # so NUL-terminated C strings are the correct representation.
    r.push("// hl_env_get(key) — read an env var. Returns a fresh str (the")
    r.push("// value, or \"\" if not found). Consumes the key.")
    r.push("static hl_str* hl_env_get(hl_str* key) {")
    r.push("    const char* v = getenv(key->data);")
    r.push("    hl_str* out;")
    r.push("    if (v == NULL) {")
    r.push("        out = hl_str_from(\"\", 0);")
    r.push("    } else {")
    r.push("        size_t n = strlen(v);")
    r.push("        out = hl_str_from(v, (int64_t)n);")
    r.push("    }")
    r.push("    hl_str_release(key);")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// hl_env_has(key) — check if an env var exists. Consumes key.")
    r.push("static bool hl_env_has(hl_str* key) {")
    r.push("    bool found = (getenv(key->data) != NULL);")
    r.push("    hl_str_release(key);")
    r.push("    return found;")
    r.push("}")
    r.push("")
    r.push("// hl_env_set(key, value) — set an env var. setenv copies the")
    r.push("// strings; we release the hl_str* args after the call.")
    r.push("static void hl_env_set(hl_str* key, hl_str* value) {")
    r.push("    setenv(key->data, value->data, 1);")
    r.push("    hl_str_release(key);")
    r.push("    hl_str_release(value);")
    r.push("}")
    r.push("")
    r.push("// hl_env_unset(key) — unset an env var. unsetenv is a no-op if")
    r.push("// the var does not exist (no error).")
    r.push("static void hl_env_unset(hl_str* key) {")
    r.push("    unsetenv(key->data);")
    r.push("    hl_str_release(key);")
    r.push("}")
    r.push("")
    r.push("// hl_cwd_get() — read the cwd. Returns a fresh str. The cwd is")
    r.push("// always available on POSIX (no failure case). The buffer")
    r.push("// grows as needed via getcwd(NULL, 0) — a glibc extension that")
    r.push("// allocates the right size automatically. Falls back to a")
    r.push("// fixed-size buffer on systems that don't support this.")
    r.push("static hl_str* hl_cwd_get(void) {")
    r.push("    char* buf = getcwd(NULL, 0);")
    r.push("    if (buf == NULL) {")
    r.push("        return hl_str_from(\"\", 0);")
    r.push("    }")
    r.push("    size_t n = strlen(buf);")
    r.push("    hl_str* out = hl_str_from(buf, (int64_t)n);")
    r.push("    free(buf);")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// hl_cwd_set(path) — change the cwd. Returns 0 on success,")
    r.push("// -1 on error. Consumes the path.")
    r.push("static int64_t hl_cwd_set(hl_str* path) {")
    r.push("    int rc = chdir(path->data);")
    r.push("    hl_str_release(path);")
    r.push("    if (rc < 0) return -1;")
    r.push("    return 0;")
    r.push("}")
    r.push("")
    # ----- Stage 49 (v0.68.0-alpha): high-resolution time runtime helpers -----
    # hl_instant_now_ns returns monotonic nanoseconds via clock_gettime
    # on POSIX (CLOCK_MONOTONIC). The result is an int64; on a 64-bit
    # system, monotonic nanoseconds wrap every ~292 years — far beyond
    # any realistic program lifetime.
    # hl_system_time_now_ms returns wall-clock milliseconds since the
    # Unix epoch via clock_gettime(CLOCK_REALTIME) on POSIX (using
    # gettimeofday on systems without clock_gettime). The wall clock
    # can jump on NTP adjustments / settimeofday — Instant should be
    # used for duration measurements, SystemTime for timestamps.
    r.push("// hl_instant_now_ns() — monotonic nanoseconds (high-resolution).")
    r.push("static int64_t hl_instant_now_ns(void) {")
    r.push("#if defined(CLOCK_MONOTONIC)")
    r.push("    struct timespec ts;")
    r.push("    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {")
    r.push("        return 0;")
    r.push("    }")
    r.push("    return (int64_t)ts.tv_sec * 1000000000LL + (int64_t)ts.tv_nsec;")
    r.push("#else")
    r.push("    /* Fallback: clock_ms * 1000000 — ms resolution. */")
    r.push("    struct timeval tv;")
    r.push("    if (gettimeofday(&tv, NULL) != 0) {")
    r.push("        return 0;")
    r.push("    }")
    r.push("    return (int64_t)tv.tv_sec * 1000000000LL")
    r.push("         + (int64_t)tv.tv_usec * 1000LL;")
    r.push("#endif")
    r.push("}")
    r.push("")
    r.push("// hl_system_time_now_ms() — wall-clock milliseconds since Unix epoch.")
    r.push("static int64_t hl_system_time_now_ms(void) {")
    r.push("#if defined(CLOCK_REALTIME)")
    r.push("    struct timespec ts;")
    r.push("    if (clock_gettime(CLOCK_REALTIME, &ts) != 0) {")
    r.push("        return 0;")
    r.push("    }")
    r.push("    return (int64_t)ts.tv_sec * 1000LL + (int64_t)ts.tv_nsec / 1000000LL;")
    r.push("#else")
    r.push("    struct timeval tv;")
    r.push("    if (gettimeofday(&tv, NULL) != 0) {")
    r.push("        return 0;")
    r.push("    }")
    r.push("    return (int64_t)tv.tv_sec * 1000LL + (int64_t)tv.tv_usec / 1000LL;")
    r.push("#endif")
    r.push("}")
    r.push("")
    # ----- Stage 50 (v0.69.0-alpha): libm-backed math runtime helpers -----
    # All math_* helpers are thin wrappers around libm functions. They
    # exist because the HLS codegen always emits calls as "hl_<name>"
    # (the prefix is the convention that distinguishes runtime helpers
    # from user-defined C functions, which are emitted as "fn_<name>").
    # The wrappers take double and return double (or bool for the
    # predicates). libm functions match this signature exactly.
    #
    # We use static inline so the compiler can inline the wrapper at
    # -O2, eliminating the call overhead. The wrapper is necessary
    # anyway because some libm functions (like lgamma) have global
    # state (signgam) and we want a stable signature.
    r.push("// Stage 50 math_* helpers — thin wrappers around libm.")
    r.push("static inline double hl_math_sin(double x)        { return sin(x); }")
    r.push("static inline double hl_math_cos(double x)        { return cos(x); }")
    r.push("static inline double hl_math_tan(double x)        { return tan(x); }")
    r.push("static inline double hl_math_asin(double x)      { return asin(x); }")
    r.push("static inline double hl_math_acos(double x)      { return acos(x); }")
    r.push("static inline double hl_math_atan(double x)      { return atan(x); }")
    r.push("static inline double hl_math_atan2(double y, double x) { return atan2(y, x); }")
    r.push("static inline double hl_math_sinh(double x)      { return sinh(x); }")
    r.push("static inline double hl_math_cosh(double x)      { return cosh(x); }")
    r.push("static inline double hl_math_tanh(double x)      { return tanh(x); }")
    r.push("static inline double hl_math_exp(double x)       { return exp(x); }")
    r.push("static inline double hl_math_log(double x)       { return log(x); }")
    r.push("static inline double hl_math_log10(double x)     { return log10(x); }")
    r.push("#if defined(HL_HAVE_LOG2)")
    r.push("static inline double hl_math_log2(double x)      { return log2(x); }")
    r.push("#else")
    r.push("static inline double hl_math_log2(double x)      { return log(x) / log(2.0); }")
    r.push("#endif")
    r.push("static inline double hl_math_pow(double b, double e)  { return pow(b, e); }")
    r.push("static inline double hl_math_sqrt(double x)      { return sqrt(x); }")
    r.push("static inline double hl_math_cbrt(double x)      { return cbrt(x); }")
    r.push("static inline double hl_math_hypot(double x, double y) { return hypot(x, y); }")
    r.push("static inline double hl_math_fmod(double x, double y) { return fmod(x, y); }")
    r.push("static inline double hl_math_erf(double x)      { return erf(x); }")
    r.push("static inline double hl_math_erfc(double x)     { return erfc(x); }")
    r.push("static inline double hl_math_tgamma(double x)   { return tgamma(x); }")
    r.push("static inline double hl_math_lgamma(double x)   { return lgamma(x); }")
    r.push("static inline bool   hl_math_isnan(double x)    { return isnan(x); }")
    r.push("static inline bool   hl_math_isinf(double x)    { return isinf(x); }")
    r.push("static inline bool   hl_math_isfinite(double x)  { return isfinite(x); }")
    r.push("static inline bool   hl_math_signbit(double x)  { return signbit(x); }")
    r.push("static inline double hl_math_copysign(double x, double y) { return copysign(x, y); }")
    r.push("")
    # ----- Stage 37 (v0.56.0-alpha): TCP / UDP / TLS runtime helpers -----
    # All socket helpers use the BSD sockets API. The fd values they
    # return are the raw OS fds (>= 0 on success, -1 on failure). The
    # Halis-level net_fds table is NOT used on the C side — the OS fd
    # is the Halis fd (Halis programs treat fds as opaque ints; the
    # 0/1/2 collision with stdin/stdout/stderr is benign because Halis
    # programs never read/write stdin/stdout via net_read/net_write).
    #
    # Connect / listen / accept all set SO_REUSEADDR (so a quick
    # restart of a server doesn't wait for TIME_WAIT to expire) and a
    # 5-second send/recv timeout (so a dead peer doesn't hang the
    # program forever — matches the interpreter).
    r.push("// hl_net_tcp_connect(host, port) — TCP connect to host:port.")
    r.push("// Returns the socket fd (>= 0) or -1 on failure. Consumes host.")
    r.push("static int64_t hl_net_tcp_connect(hl_str* host, int64_t port) {")
    r.push("    struct addrinfo hints;")
    r.push("    memset(&hints, 0, sizeof(hints));")
    r.push("    hints.ai_family = AF_INET;")
    r.push("    hints.ai_socktype = SOCK_STREAM;")
    r.push("    struct addrinfo* res = NULL;")
    r.push("    char port_buf[16];")
    r.push("    snprintf(port_buf, sizeof(port_buf), \"%lld\", (long long)port);")
    r.push("    int rc = getaddrinfo(host->data, port_buf, &hints, &res);")
    r.push("    if (rc != 0 || res == NULL) {")
    r.push("        hl_str_release(host);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    int fd = socket(res->ai_family, res->ai_socktype, res->ai_protocol);")
    r.push("    if (fd < 0) {")
    r.push("        freeaddrinfo(res);")
    r.push("        hl_str_release(host);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    struct timeval tv;")
    r.push("    tv.tv_sec = 5; tv.tv_usec = 0;")
    r.push("    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));")
    r.push("    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));")
    r.push("    if (connect(fd, res->ai_addr, res->ai_addrlen) < 0) {")
    r.push("        close(fd);")
    r.push("        freeaddrinfo(res);")
    r.push("        hl_str_release(host);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    freeaddrinfo(res);")
    r.push("    hl_str_release(host);")
    r.push("    return (int64_t)fd;")
    r.push("}")
    r.push("")
    r.push("// hl_net_tcp_listen(host, port, backlog) — bind + listen. Returns")
    r.push("// the listen fd or -1. SO_REUSEADDR is set so a restart doesn't")
    r.push("// wait for TIME_WAIT. Consumes host.")
    r.push("static int64_t hl_net_tcp_listen(hl_str* host, int64_t port, int64_t backlog) {")
    r.push("    int fd = socket(AF_INET, SOCK_STREAM, 0);")
    r.push("    if (fd < 0) {")
    r.push("        hl_str_release(host);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    int yes = 1;")
    r.push("    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));")
    r.push("    struct sockaddr_in addr;")
    r.push("    memset(&addr, 0, sizeof(addr));")
    r.push("    addr.sin_family = AF_INET;")
    r.push("    addr.sin_port = htons((uint16_t)port);")
    r.push("    if (host->len == 0 || strcmp(host->data, \"0.0.0.0\") == 0) {")
    r.push("        addr.sin_addr.s_addr = htonl(INADDR_ANY);")
    r.push("    } else if (strcmp(host->data, \"127.0.0.1\") == 0 || strcmp(host->data, \"localhost\") == 0) {")
    r.push("        addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);")
    r.push("    } else if (inet_pton(AF_INET, host->data, &addr.sin_addr) != 1) {")
    r.push("        close(fd);")
    r.push("        hl_str_release(host);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    if (bind(fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {")
    r.push("        close(fd);")
    r.push("        hl_str_release(host);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    if (listen(fd, (int)backlog) < 0) {")
    r.push("        close(fd);")
    r.push("        hl_str_release(host);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    hl_str_release(host);")
    r.push("    return (int64_t)fd;")
    r.push("}")
    r.push("")
    r.push("// hl_net_tcp_accept(fd) — accept a connection. Returns the client")
    r.push("// fd or -1 on error. Blocks until a peer connects (the listen")
    r.push("// fd's accept timeout is inherited from the listen socket).")
    r.push("static int64_t hl_net_tcp_accept(int64_t fd) {")
    r.push("    int cfd = accept((int)fd, NULL, NULL);")
    r.push("    if (cfd < 0) return -1;")
    r.push("    struct timeval tv;")
    r.push("    tv.tv_sec = 30; tv.tv_usec = 0;")
    r.push("    setsockopt(cfd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));")
    r.push("    setsockopt(cfd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));")
    r.push("    return (int64_t)cfd;")
    r.push("}")
    r.push("")
    r.push("// hl_net_read(fd, n) — read up to n bytes from the socket.")
    r.push("// Returns a fresh str (refcnt=1). Empty str at EOF or on error.")
    r.push("// n is clamped to a 64 KiB cap to avoid unbounded allocation.")
    r.push("static hl_str* hl_net_read(int64_t fd, int64_t n) {")
    r.push("    if (n <= 0) return hl_str_from(\"\", 0);")
    r.push("    if (n > 65536) n = 65536;")
    r.push("    char buf[65536];")
    r.push("    ssize_t got = recv((int)fd, buf, (size_t)n, 0);")
    r.push("    if (got <= 0) return hl_str_from(\"\", 0);")
    r.push("    return hl_str_from(buf, (int64_t)got);")
    r.push("}")
    r.push("")
    r.push("// hl_net_write(fd, data) — write all bytes. Returns bytes written")
    r.push("// or -1 on error. Consumes data. Uses send() in a loop because")
    r.push("// a single send() may not write all bytes for large payloads.")
    r.push("static int64_t hl_net_write(int64_t fd, hl_str* data) {")
    r.push("    int64_t total = 0;")
    r.push("    while (total < data->len) {")
    r.push("        ssize_t w = send((int)fd, data->data + total,")
    r.push("                         (size_t)(data->len - total), 0);")
    r.push("        if (w <= 0) {")
    r.push("            hl_str_release(data);")
    r.push("            return -1;")
    r.push("        }")
    r.push("        total += w;")
    r.push("    }")
    r.push("    int64_t r = data->len;")
    r.push("    hl_str_release(data);")
    r.push("    return r;")
    r.push("}")
    r.push("")
    r.push("// hl_net_close(fd) — close the socket. Idempotent (a double-close")
    r.push("// is a silent no-op, matching the interpreter).")
    r.push("static void hl_net_close(int64_t fd) {")
    r.push("    if (fd >= 0) close((int)fd);")
    r.push("}")
    r.push("")
    r.push("// hl_net_udp_open() — create a UDP socket. Returns fd or -1.")
    r.push("// A 5-second recv timeout is set so recv_from doesn't hang")
    r.push("// forever on a dead peer (matches the interpreter).")
    r.push("static int64_t hl_net_udp_open() {")
    r.push("    int fd = socket(AF_INET, SOCK_DGRAM, 0);")
    r.push("    if (fd < 0) return -1;")
    r.push("    struct timeval tv;")
    r.push("    tv.tv_sec = 5; tv.tv_usec = 0;")
    r.push("    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));")
    r.push("    return (int64_t)fd;")
    r.push("}")
    r.push("")
    r.push("// hl_net_udp_send_to(fd, host, port, data) — send a UDP datagram.")
    r.push("// Returns bytes sent or -1. Consumes host and data.")
    r.push("static int64_t hl_net_udp_send_to(int64_t fd, hl_str* host,")
    r.push("                                 int64_t port, hl_str* data) {")
    r.push("    struct addrinfo hints;")
    r.push("    memset(&hints, 0, sizeof(hints));")
    r.push("    hints.ai_family = AF_INET;")
    r.push("    hints.ai_socktype = SOCK_DGRAM;")
    r.push("    struct addrinfo* res = NULL;")
    r.push("    char port_buf[16];")
    r.push("    snprintf(port_buf, sizeof(port_buf), \"%lld\", (long long)port);")
    r.push("    int rc = getaddrinfo(host->data, port_buf, &hints, &res);")
    r.push("    hl_str_release(host);")
    r.push("    if (rc != 0 || res == NULL) {")
    r.push("        hl_str_release(data);")
    r.push("        return -1;")
    r.push("    }")
    r.push("    ssize_t n = sendto((int)fd, data->data, (size_t)data->len, 0,")
    r.push("                       res->ai_addr, res->ai_addrlen);")
    r.push("    freeaddrinfo(res);")
    r.push("    int64_t r = (n >= 0) ? (int64_t)n : -1;")
    r.push("    hl_str_release(data);")
    r.push("    return r;")
    r.push("}")
    r.push("")
    r.push("// hl_net_udp_recv_from(fd, n) — receive a UDP datagram. Returns a")
    r.push("// fresh str (refcnt=1). Empty str on error or timeout. The sender's")
    r.push("// address is discarded (callers who need it should use the raw C")
    r.push("// recvfrom directly via FFI — Stage 15).")
    r.push("static hl_str* hl_net_udp_recv_from(int64_t fd, int64_t n) {")
    r.push("    if (n <= 0) return hl_str_from(\"\", 0);")
    r.push("    if (n > 65536) n = 65536;")
    r.push("    char buf[65536];")
    r.push("    ssize_t got = recvfrom((int)fd, buf, (size_t)n, 0, NULL, NULL);")
    r.push("    if (got <= 0) return hl_str_from(\"\", 0);")
    r.push("    return hl_str_from(buf, (int64_t)got);")
    r.push("}")
    r.push("")
    # hl_net_tls_get(host, port, path) — HTTPS GET via libcurl. Returns
    # the response body as a fresh str. Panics on transport/TLS error
    # or HTTP >= 400 (the --fail flag). When libcurl is not available
    # (HL_HAVE_LIBCURL undefined), panics with a clean message.
    r.push("typedef struct { char* data; int64_t len; int64_t cap; } hl_curl_buf;")
    r.push("static size_t hl_curl_write_cb(char* ptr, size_t sz, size_t n, void* ud) {")
    r.push("    hl_curl_buf* b = (hl_curl_buf*)ud;")
    r.push("    size_t total = sz * n;")
    r.push("    if (b->len + (int64_t)total > b->cap) {")
    r.push("        int64_t newcap = b->cap * 2;")
    r.push("        if (newcap < b->len + (int64_t)total) newcap = b->len + (int64_t)total;")
    r.push("        char* nd = (char*)realloc(b->data, (size_t)newcap);")
    r.push("        if (!nd) return 0;")
    r.push("        b->data = nd; b->cap = newcap;")
    r.push("    }")
    r.push("    memcpy(b->data + b->len, ptr, total);")
    r.push("    b->len += (int64_t)total;")
    r.push("    return total;")
    r.push("}")
    r.push("static hl_str* hl_net_tls_get(hl_str* host, int64_t port, hl_str* path) {")
    r.push("    if (path->len == 0 || path->data[0] != '/') {")
    r.push("        char* nb = (char*)malloc((size_t)(path->len + 2));")
    r.push("        if (!nb) { hl_str_release(host); hl_str_release(path); hl_die(\"net_tls_get: oom\"); }")
    r.push("        nb[0] = '/';")
    r.push("        memcpy(nb + 1, path->data, (size_t)path->len);")
    r.push("        nb[path->len + 1] = 0;")
    r.push("        hl_str* np = hl_str_from(nb, path->len + 1);")
    r.push("        free(nb);")
    r.push("        hl_str_release(path);")
    r.push("        path = np;")
    r.push("    }")
    r.push("    char url[4096];")
    r.push("    snprintf(url, sizeof(url), \"https://%s:%lld%s\",")
    r.push("             host->data, (long long)port, path->data);")
    r.push("    (void)url;")
    r.push("#ifdef HL_HAVE_LIBCURL")
    r.push("    CURL* c = curl_easy_init();")
    r.push("    if (!c) {")
    r.push("        hl_str_release(host); hl_str_release(path);")
    r.push("        hl_die(\"net_tls_get: curl_easy_init failed\");")
    r.push("    }")
    r.push("    hl_curl_buf buf;")
    r.push("    buf.data = (char*)malloc(4096);")
    r.push("    buf.len = 0; buf.cap = 4096;")
    r.push("    if (!buf.data) {")
    r.push("        curl_easy_cleanup(c);")
    r.push("        hl_str_release(host); hl_str_release(path);")
    r.push("        hl_die(\"net_tls_get: oom\");")
    r.push("    }")
    r.push("    curl_easy_setopt(c, CURLOPT_URL, url);")
    r.push("    curl_easy_setopt(c, CURLOPT_WRITEFUNCTION, hl_curl_write_cb);")
    r.push("    curl_easy_setopt(c, CURLOPT_WRITEDATA, &buf);")
    r.push("    curl_easy_setopt(c, CURLOPT_FOLLOWLOCATION, 1L);")
    r.push("    curl_easy_setopt(c, CURLOPT_TIMEOUT, 30L);")
    r.push("    curl_easy_setopt(c, CURLOPT_FAILONERROR, 1L);")
    r.push("    CURLcode rc = curl_easy_perform(c);")
    r.push("    long http_code = 0;")
    r.push("    curl_easy_getinfo(c, CURLINFO_RESPONSE_CODE, &http_code);")
    r.push("    curl_easy_cleanup(c);")
    r.push("    hl_str_release(host); hl_str_release(path);")
    r.push("    if (rc != CURLE_OK) {")
    r.push("        free(buf.data);")
    r.push("        hl_die(\"net_tls_get: transport/TLS error\");")
    r.push("    }")
    r.push("    if (http_code >= 400) {")
    r.push("        free(buf.data);")
    r.push("        hl_die(\"net_tls_get: HTTP error\");")
    r.push("    }")
    r.push("    hl_str* out = hl_str_from(buf.data, buf.len);")
    r.push("    free(buf.data);")
    r.push("    return out;")
    r.push("#else")
    r.push("    hl_str_release(host); hl_str_release(path);")
    r.push("    hl_die(\"net_tls_get: built without libcurl (rebuild with -DHAVE_LIBCURL and link -lcurl)\");")
    r.push("#endif")
    r.push("}")
    r.push("")
    r.push("// ---- v0.2 additions: pop, float, chr, fmod ----")
    r.push("// String split helper (placed last because it depends on hl_list)")
    r.push("static hl_list* hl_str_split(hl_str* s, hl_str* sep) {")
    r.push("    if (sep->len == 0) hl_die(\"empty separator not allowed\");")
    r.push("    hl_list* out = hl_list_new(hl_str_release);")
    r.push("    if (s->len == 0) {")
    r.push("        hl_list_push(out, hl_str_from(\"\", 0));")
    r.push("        return out;")
    r.push("    }")
    # Deep-scan-19 fix (LOW, theoretical overflow): rewrite the loop
    # condition as `i <= s->len - sep->len` (after a `s->len < sep->len`
    # early exit) so the addition `i + sep->len` never overflows int64
    # for a ~9-EB string. The previous `i + sep->len <= s->len` could
    # overflow to a negative number, making the comparison true and
    # causing an out-of-bounds memcmp.
    r.push("    if (s->len < sep->len) {")
    r.push("        hl_list_push(out, hl_str_from(s->data, s->len));")
    r.push("        return out;")
    r.push("    }")
    r.push("    int64_t start = 0;")
    r.push("    int64_t i = 0;")
    r.push("    while (i <= s->len - sep->len) {")
    r.push("        if (memcmp(s->data + i, sep->data, (size_t)sep->len) == 0) {")
    r.push("            hl_list_push(out, hl_str_from(s->data + start, i - start));")
    r.push("            i += sep->len;")
    r.push("            start = i;")
    r.push("        } else {")
    r.push("            i++;")
    r.push("        }")
    r.push("    }")
    r.push("    hl_list_push(out, hl_str_from(s->data + start, s->len - start));")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// ---- v0.2 additions: pop, float, chr, fmod ----")
    r.push("// hl_list_pop: ownership of the removed item transfers to the caller.")
    r.push("static void* hl_list_pop(hl_list* l) {")
    # Deep-scan-19 fix (LOW, error-message differential): the interpreter
    # raises "pop from empty list" (boot/interp.py BUG-SC-9); the C
    # runtime said "array access out of bounds", which is misleading
    # (it's a pop, not an index). Aligned so differential tests see
    # the same message.
    r.push("    if (l->len == 0) hl_die(\"pop from empty list\");")
    r.push("    l->len--;")
    r.push("    return l->items[l->len];")
    r.push("}")
    r.push("")
    r.push("// Typed pops for primitive element lists: pop the box, unbox the")
    r.push("// value, free the box. (A plain pop + unbox would leak the box —")
    r.push("// the caller only wanted the primitive.)")
    r.push("static int64_t hl_list_pop_i64(hl_list* l) {")
    r.push("    void* b = hl_list_pop(l);")
    r.push("    int64_t v = hl_unbox_i64(b);")
    r.push("    free(b);")
    r.push("    return v;")
    r.push("}")
    r.push("static double hl_list_pop_f64(hl_list* l) {")
    r.push("    void* b = hl_list_pop(l);")
    r.push("    double v = hl_unbox_f64(b);")
    r.push("    free(b);")
    r.push("    return v;")
    r.push("}")
    r.push("static bool hl_list_pop_bool(hl_list* l) {")
    r.push("    void* b = hl_list_pop(l);")
    r.push("    bool v = hl_unbox_bool(b);")
    r.push("    free(b);")
    r.push("    return v;")
    r.push("}")
    r.push("")
    r.push("static double hl_str_to_double(hl_str* s) {")
    r.push("    int64_t i = 0;")
    r.push("    int64_t dots = 0;")
    r.push("    int64_t digits = 0;")
    r.push("    int saw_exp = 0;")
    r.push("    int exp_digits = 0;")
    r.push("    if (s->len == 0) hl_die(\"cannot convert string to float\");")
    r.push("    if (s->data[0] == '-' || s->data[0] == '+') i = 1;")
    r.push("    if (i >= s->len) hl_die(\"cannot convert string to float\");")
    r.push("    for (; i < s->len; i++) {")
    r.push("        char c = s->data[i];")
    r.push("        if (c == '.') { if (saw_exp) hl_die(\"cannot convert string to float\"); dots++; continue; }")
    r.push("        if (c == 'e' || c == 'E') {")
    r.push("            if (saw_exp || digits == 0) hl_die(\"cannot convert string to float\");")
    r.push("            saw_exp = 1;")
    r.push("            if (i + 1 < s->len && (s->data[i+1] == '+' || s->data[i+1] == '-')) i++;")
    r.push("            exp_digits = 0;")
    r.push("            continue;")
    r.push("        }")
    r.push("        if (c < '0' || c > '9') hl_die(\"cannot convert string to float\");")
    r.push("        if (saw_exp) exp_digits++;")
    r.push("        digits++;")
    r.push("    }")
    r.push("    if (dots > 1 || digits == 0) hl_die(\"cannot convert string to float\");")
    r.push("    if (saw_exp && exp_digits == 0) hl_die(\"cannot convert string to float\");")
    r.push("    return strtod(s->data, NULL);")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_chr(int64_t c) {")
    r.push("    if (c < 0 || c > 255) hl_die(\"chr out of range 0..255\");")
    r.push("    char b = (char)c;")
    r.push("    return hl_str_from(&b, 1);")
    r.push("}")
    r.push("")
    r.push("static double hl_fmod(double a, double b) {")
    r.push("    return fmod(a, b);")
    r.push("}")
    r.push("")
    r.push("// BUG-15 fix: range-checked float -> int64 conversion. C casts")
    r.push("// silently truncate out-of-range floats; we panic instead so the")
    r.push("// error points to the actual source of the bad value.")
    r.push("// Deep-scan-25 fix: the upper bound must be >= 2^63, not > 2^63.")
    r.push("// The old literal 9.2233720368547757e18 rounds to exactly 2^63 as")
    r.push("// a double, so v == 2^63 slipped past the check into (int64_t)v —")
    r.push("// undefined behaviour that produced a garbage value (observed as")
    r.push("// INT64_MAX on x86-64) while the boot interpreter panicked. There")
    r.push("// are no doubles strictly between INT64_MAX and 2^63, so >= 2^63")
    r.push("// rejects exactly the out-of-range positives.")
    r.push("static int64_t hl_float_to_int(double v) {")
    r.push("    // NaN fails BOTH comparisons, so an explicit isnan check is")
    r.push("    // required — otherwise the cast below is undefined behaviour.")
    r.push("    if (isnan(v) || v < -9.2233720368547758e18 || v >= 9.2233720368547758e18)")
    r.push("        hl_die(\"float.to_int out of int64 range\");")
    r.push("    return (int64_t)v;")
    r.push("}")
    r.push("")
    r.push("// hl_file_exists: consumes the path.")
    r.push("static bool hl_file_exists(hl_str* path) {")
    r.push("    hl_sandbox_check(path->data);")
    r.push("    struct stat st;")
    r.push("    bool ok = stat(path->data, &st) == 0 && S_ISREG(st.st_mode);")
    r.push("    hl_str_release(path);")
    r.push("    return ok;")
    r.push("}")
    r.push("")
    # ----- Stage 36 (v0.55.0-alpha): filesystem metadata runtime -----
    # All four helpers consume the path (hl_str_release after use) and
    # route through hl_sandbox_check (so a sandboxed native binary cannot
    # escape). The implementations mirror the Stage-0 interpreter:
    #   fs_read_dir  -> opendir + readdir (sorted by byte-lexicographic
    #                  order to match the interpreter's sorted(os.listdir))
    #   fs_size      -> stat() .st_size
    #   fs_is_dir    -> stat() S_ISDIR
    #   fs_set_perms -> chmod()
    # The list[str] returned by fs_read_dir is constructed with
    # hl_str_release as the elem_free (matching the args() list and the
    # list[str] contract everywhere else in the runtime).
    r.push("// hl_fs_read_dir: consumes the path, returns a fresh list[str]")
    r.push("// of entry NAMES (not full paths). Sorted by byte-lexicographic")
    r.push("// order so the native binary and the interpreter (which uses")
    r.push("// sorted(os.listdir(...))) agree on iteration order. The list")
    r.push("// owns one retain per entry; each entry is a fresh hl_str*.")
    r.push("static hl_list* hl_fs_read_dir(hl_str* path) {")
    r.push("    hl_sandbox_check(path->data);")
    r.push("    DIR* d = opendir(path->data);")
    r.push("    if (!d) {")
    r.push("        hl_str_release(path);")
    r.push("        hl_die(\"fs_read_dir: cannot open directory\");")
    r.push("    }")
    r.push("    hl_list* out = hl_list_new(hl_str_release);")
    r.push("    struct dirent* e;")
    r.push("    while ((e = readdir(d)) != NULL) {")
    r.push("        // Skip \".\" and \"..\" — they are always present and")
    r.push("        // never useful to callers (and they would create")
    r.push("        // infinite loops in path_walk if included).")
    r.push("        if (strcmp(e->d_name, \".\") == 0) continue;")
    r.push("        if (strcmp(e->d_name, \"..\") == 0) continue;")
    r.push("        int64_t n = (int64_t)strlen(e->d_name);")
    r.push("        hl_list_push(out, hl_str_from(e->d_name, n));")
    r.push("    }")
    r.push("    closedir(d);")
    r.push("    hl_str_release(path);")
    r.push("    // Sort the entries by byte-lexicographic order. The list")
    r.push("    // owns one retain per entry; we use a simple insertion sort")
    r.push("    // to avoid pulling in qsort_r (which has portability")
    r.push("    // quirks across glibc / musl / BSD). n is typically small")
    r.push("    // (a single directory's entries), so O(n²) is fine here.")
    r.push("    for (int64_t i = 1; i < out->len; i++) {")
    r.push("        hl_str* v = (hl_str*)out->items[i];")
    r.push("        int64_t j = i;")
    r.push("        while (j > 0) {")
    r.push("            hl_str* prev = (hl_str*)out->items[j - 1];")
    r.push("            if (hl_str_cmp(prev, v) <= 0) break;")
    r.push("            out->items[j] = out->items[j - 1];")
    r.push("            j--;")
    r.push("        }")
    r.push("        out->items[j] = v;")
    r.push("    }")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// hl_fs_size: consumes the path, returns the file size in bytes.")
    r.push("// Panics on stat failure (matches the interpreter).")
    r.push("static int64_t hl_fs_size(hl_str* path) {")
    r.push("    hl_sandbox_check(path->data);")
    r.push("    struct stat st;")
    r.push("    if (stat(path->data, &st) != 0) {")
    r.push("        hl_str_release(path);")
    r.push("        hl_die(\"fs_size: cannot stat\");")
    r.push("    }")
    r.push("    hl_str_release(path);")
    r.push("    return (int64_t)st.st_size;")
    r.push("}")
    r.push("")
    r.push("// hl_fs_is_dir: consumes the path, returns true iff it is a")
    r.push("// directory. Returns false for non-existent paths (matches")
    r.push("// file_exists semantics for files).")
    r.push("static bool hl_fs_is_dir(hl_str* path) {")
    r.push("    hl_sandbox_check(path->data);")
    r.push("    struct stat st;")
    r.push("    bool ok = stat(path->data, &st) == 0 && S_ISDIR(st.st_mode);")
    r.push("    hl_str_release(path);")
    r.push("    return ok;")
    r.push("}")
    r.push("")
    r.push("// hl_fs_set_perms: consumes the path. `mode` is the POSIX")
    r.push("// permission bits (e.g. 0644 = 420 decimal). Panics on chmod")
    r.push("// failure. The path argument is consumed (one retain) — the")
    r.push("// mode is a primitive int that needs no cleanup.")
    r.push("static void hl_fs_set_perms(hl_str* path, int64_t mode) {")
    r.push("    hl_sandbox_check(path->data);")
    r.push("    if (chmod(path->data, (mode_t)mode) != 0) {")
    r.push("        hl_str_release(path);")
    r.push("        hl_die(\"fs_set_perms: cannot chmod\");")
    r.push("    }")
    r.push("    hl_str_release(path);")
    r.push("}")
    r.push("")
    # ----- Stage 8-beta: ownership primitives runtime -----
    # clone(str) is the only fixed clone helper in the runtime. Every other
    # clone() helper is generated per type-instantiation by the codegen
    # (hl_clone_<mangled-type>) because it must know field/elem/value
    # types — including user structs and enums.
    r.push("// clone(str) — strings are immutable, so a shallow copy is a deep copy.")
    r.push("static hl_str* hl_clone_str(hl_str* s) {")
    r.push("    return hl_str_from(s->data, s->len);")
    r.push("}")
    r.push("")
    return r
}

# ----------------------------------------------------------------------------
