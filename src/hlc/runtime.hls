    r.push("// ---- tasks ----")
    r.push("static void hl_task_finish(hl_task* t, hl_task_res res) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    t->res = res;")
    r.push("    t->done = true;")
    r.push("    g_rt_tasks--;")
    r.push("    g_rt_done_unjoined++;   // Stage 33: a join waiter can now proceed")
    r.push("    if (t->refcnt == 0 && !t->freed) { t->freed = true; free(t); }  // abandoned")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
    r.push("")
    r.push("// Typed finish wrappers (called by the generated trampolines).")
    r.push("static void hl_task_finish_i64(hl_task* t, int64_t v) {")
    r.push("    hl_task_res r; r.i = v; hl_task_finish(t, r);")
    r.push("}")
    r.push("static void hl_task_finish_f64(hl_task* t, double v) {")
    r.push("    hl_task_res r; r.f = v; hl_task_finish(t, r);")
    r.push("}")
    r.push("static void hl_task_finish_ptr(hl_task* t, void* v) {")
    r.push("    hl_task_res r; r.p = v; hl_task_finish(t, r);")
    r.push("}")
