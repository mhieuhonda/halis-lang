    r.push("    if (s->len == 0) hl_die(\"cannot convert string to int\");")
    r.push("    if (s->data[0] == '-') { neg = true; i = 1; }")
    r.push("    if (i >= s->len) hl_die(\"cannot convert string to int\");")
    r.push("    for (; i < s->len; i++) {")
    r.push("        char c = s->data[i];")
    r.push("        if (c < '0' || c > '9') hl_die(\"cannot convert string to int\");")
    r.push("        if (uv > (UINT64_C(9223372036854775808) - (uint64_t)(c - '0')) / 10) {")
