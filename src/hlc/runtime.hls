    r.push("    // Deep-scan-20 fix (boot/native parity): the interpreter caps")
    r.push("    // range() at 1,000,000 elements (deep-scan-7, clean panic)")
    r.push("    // but the native runtime happily built the full list —")
    r.push("    // range(0, 1500000) ran natively and exited 101 under boot.")
    r.push("    // Mirror the cap so both backends agree.")
    r.push("    int64_t count = b > a ? b - a : 0;")
    r.push("    if (count > 1000000) {")
    r.push("        char buf[192];")
    r.push("        snprintf(buf, sizeof(buf), \"range(%lld, %lld) would produce %lld elements (limit 1000000) - use an explicit counter loop for large ranges\",")
    r.push("                 (long long)a, (long long)b, (long long)count);")
    r.push("        hl_panic(hl_str_from(buf, (int64_t)strlen(buf)));")
    r.push("    }")
