    # Stage 33 (v0.52.0-alpha): async_spawn runtime helpers.
    # hl_async_spawn: starts a detached thread running a trampoline that
    # takes a single void* argbox (no hl_task* — the async task has no
    # join handle; the caller awaits the Future channel).
    r.push("static void* hl_async_spawn_entry(void* pv) {")
    r.push("    void** box = (void**)pv;")
    r.push("    void (*body)(void*) = (void(*)(void*))box[0];")
    r.push("    void* argbox = box[1];")
    r.push("    free(box);")
    r.push("    body(argbox);")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    g_rt_tasks--;")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return NULL;")
    r.push("}")
    r.push("")
    r.push("static void hl_async_spawn(void (*body)(void*), void* argbox) {")
    r.push("    void** box = (void**)malloc(2 * sizeof(void*));")
    r.push("    if (!box) hl_die(\"out of memory\");")
    r.push("    box[0] = (void*)body;")
    r.push("    box[1] = argbox;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    g_rt_tasks++;")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    pthread_t th;")
    r.push("    if (pthread_create(&th, NULL, hl_async_spawn_entry, box) != 0) {")
    r.push("        pthread_mutex_lock(&g_rt_mu);")
    r.push("        g_rt_tasks--;")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        free(box);")
    r.push("        hl_die(\"async_spawn: cannot create thread\");")
    r.push("    }")
    r.push("    pthread_detach(th);")
    r.push("}")
