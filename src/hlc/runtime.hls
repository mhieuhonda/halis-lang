    r.push("// Task release — called by the spawner's binding cleanup. Under the")
    r.push("// global mutex, so task refcounts need no atomics. If the thread is")
    r.push("// still running when the last reference drops, the task is")
    r.push("// abandoned: hl_task_finish frees it.")
    r.push("static void hl_task_release(void* pv) {")
    r.push("    hl_task* t = (hl_task*)pv;")
    r.push("    if (!t) return;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (--t->refcnt == 0) {")
    r.push("        if (t->done && !t->freed) { t->freed = true; free(t); }")
    r.push("    }")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
    r.push("static void hl_cleanup_task(hl_task** p) { hl_task_release(*p); }")
    r.push("")
    } # Stage 77: end of the hosted-only concurrency region.
    r.push("static hl_str* hl_str_alloc(int64_t len) {")
    r.push("    // Deep-scan fix (C11): reject negative len before the cast to")
    r.push("    // size_t. A negative len would wrap to ~2^64 via the cast,")
    r.push("    // causing malloc to fail (DoS) or — on systems with a")
    r.push("    // permissive overcommit — succeed with a huge buffer.")
    r.push("    if (len < 0) hl_die(\"hl_str_alloc: negative length\");")
    r.push("    hl_str* s = (hl_str*)malloc(sizeof(hl_str));")
    r.push("    if (!s) hl_die(\"out of memory\");")
    r.push("    s->refcnt = 1;")
    r.push("    s->len = len;")
    r.push("    s->data = (char*)malloc((size_t)len + 1);")
