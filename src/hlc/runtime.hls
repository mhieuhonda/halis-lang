        # (same class of bug as hl_str_from_double). The 32-byte buffer
        # is large enough for `%lld` of int64 (max 20 chars + NUL), but
        # defensively cap `n` in case a future format change makes it
        # larger — a `snprintf` overflow here would have the same
        # stack-over-read semantics as the double bug.
        r.push("    char buf[32];")
        r.push("    int n = snprintf(buf, sizeof buf, \"%\" PRId64, v);")
        r.push("    if (n < 0) { return hl_str_from(\"\", 0); }")
        r.push("    if (n > (int)(sizeof buf) - 1) { n = (int)(sizeof buf) - 1; }")
        r.push("    return hl_str_from(buf, (int64_t)n);")
        r.push("}")
        r.push("")
    }
    r.push("static hl_str* hl_str_from_double(double v) {")
    # Stage 42 (v0.61.0-alpha): deep-scan-21 fix (HIGH-severity,
    # stack over-read). The previous `char buf[64]` was too small
    # for very large doubles formatted with `%.6f`:
    # `snprintf` returns the FULL length that *would* have been
    # written (e.g. 307 for 1e300), and `hl_str_from(buf, 307)`
    # then `memcpy`s 307 bytes from a 64-byte stack buffer — a
    # 243-byte stack over-read (info-disclosure + garbage output
    # + potential crash). The Python interpreter doesn't have
    # this bug (Python `"%.6f" % v` produces a fresh string of
    # the right size), so this was a latent differential-parity
    # bug that surfaced when `std.fmt.fmt_display_float` /
    # `fmt_debug_float` started exposing it. The fix: grow the
    # buffer to 512 bytes (covers `%.6f` outputs up to ~1e489,
    # well beyond DBL_MAX ≈ 1.8e308), AND defensively cap `n`
    # at `sizeof(buf) - 1` so a future format change can't
    # reintroduce the bug. As a final safety net, fall back to
    # the truncated buffer if `n` exceeds the cap (the caller
    # gets a short prefix instead of garbage stack memory).
    r.push("    char buf[512];")
    r.push("    int n = snprintf(buf, sizeof buf, \"%.6f\", v);")
    r.push("    if (n < 0) { return hl_str_from(\"\", 0); }")
    r.push("    if (n > (int)(sizeof buf) - 1) { n = (int)(sizeof buf) - 1; }")
    r.push("    return hl_str_from(buf, (int64_t)n);")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_cstr(const char* c) { return hl_str_from(c, (int64_t)strlen(c)); }")
    r.push("static hl_str* hl_str_from_bool(bool v) {")
