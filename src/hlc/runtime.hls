    r.push("static hl_str* hl_str_from_int64(int64_t v) {")
    # Stage 77: freestanding has no snprintf — hand-rolled `%lld`
    # rendering (exact for every int64, INT64_MIN included: the
    # magnitude is built as unsigned via the -(v+1)+1 trick).
    if fs {
        r.push("    char buf[20];")
        r.push("    int n = 0;")
        r.push("    uint64_t uv;")
        r.push("    bool neg = false;")
        r.push("    if (v < 0) { neg = true; uv = (uint64_t)(-(v + 1)) + (uint64_t)1; } else { uv = (uint64_t)v; }")
        r.push("    do { buf[n++] = (char)('0' + (int)(uv % (uint64_t)10)); uv /= (uint64_t)10; } while (uv);")
        r.push("    if (neg) buf[n++] = '-';")
        r.push("    for (int i = 0; i < n / 2; i++) { char t = buf[i]; buf[i] = buf[n - 1 - i]; buf[n - 1 - i] = t; }")
        r.push("    return hl_str_from(buf, (int64_t)n);")
        r.push("}")
        r.push("")
    } else {
