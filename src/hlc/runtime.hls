    r.push("// select(chs) — block until any channel has a pending message;")
    r.push("// return the index (list order) of the first ready one. The list")
    r.push("// holds raw hl_chan* items (pointer element lists are unboxed).")
    r.push("// v0.29.0-alpha: while waiting, the waiter count is bumped on ALL")
    r.push("// listed channels so the deadlock scan sees this thread as a")
    r.push("// potential consumer of any of them.")
    r.push("static int64_t hl_chan_select(hl_list* chs) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (chs->len == 0) {")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        hl_die(\"select() on empty channel list\");")
    r.push("    }")
    r.push("    while (1) {")
    r.push("        for (int64_t i = 0; i < chs->len; i++) {")
    r.push("            hl_chan* c = (hl_chan*)chs->items[i];")
    r.push("            if (c->head) {")
    r.push("                pthread_mutex_unlock(&g_rt_mu);")
    r.push("                return i;")
    r.push("            }")
    r.push("        }")
    r.push("        for (int64_t i = 0; i < chs->len; i++)")
    r.push("            ((hl_chan*)chs->items[i])->waiters++;")
    r.push("        g_rt_blocked++;")
    r.push("        hl_rt_deadlock_check();")
    r.push("        pthread_cond_wait(&g_rt_cv, &g_rt_mu);")
    r.push("        g_rt_blocked--;")
    r.push("        for (int64_t i = 0; i < chs->len; i++)")
    r.push("            ((hl_chan*)chs->items[i])->waiters--;")
    r.push("    }")
    r.push("}")
