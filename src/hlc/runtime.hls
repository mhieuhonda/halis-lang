    r.push("// recv_or — non-blocking recv: the pending message if one exists,")
    r.push("// else the caller's default. For pointer payloads the default is")
    r.push("// an OWNED extra reference (the codegen own-wraps non-fresh")
    r.push("// expressions); when a message IS available the default must be")
    r.push("// released here via elem_release (it owns exactly that type).")
    r.push("static void* hl_chan_recv_or_ptr(hl_chan* c, void* def) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (!c->head) {")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        return def;")
    r.push("    }")
    r.push("    hl_msg* m = hl_chan_dequeue(c);")
    r.push("    void* v = m->v.p;")
    r.push("    free(m);")
    r.push("    if (c->elem_release && def) c->elem_release(def);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return v;")
    r.push("}")
