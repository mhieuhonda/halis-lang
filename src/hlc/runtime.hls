# ============================================================================
# hlc/runtime.hls — part of the hlc compiler (split from the original single-file
# src/hlc.hls). This file is loaded via `import "hlc/runtime.hls"` from src/hlc.hls.
# Embedded C runtime prelude emitted into every generated program (runtime_lines).
# NOTE: content is byte-identical to the original src/hlc.hls line range
#       10070..12651 - module split is purely structural, zero code changes.
# ============================================================================
# freestanding_prelude_lines (Stage 77, v0.96.0-alpha): the C
# prelude emitted INSTEAD of the libc includes for `#![freestanding]`
# crates. Three parts:
#   1. The only three headers a freestanding TU needs
#      (stdint, stdbool, stddef — all freestanding per C11 section 4).
#   2. A static 1 MiB bump arena backing malloc/calloc/realloc
#      (free is a no-op; reclamation is deferred to `core.alloc`,
#      Stage 79) plus hand-rolled memcpy/memset/memcmp/strlen/
#      strcmp/strncmp/strcpy/strchr/strdup. Allocation sizes are
#      tracked in an 8-byte header so realloc can copy the old
#      contents; OOM and size arithmetic overflow trap.
#   3. DECLARATIONS (never definitions) for every other libc symbol
#      the hosted-only runtime functions reference (stdio, sockets,
#      pthreads, libm, ...), with minimal struct layouts where a
#      dead function needs a complete type. This lets the TU compile
#      under `-ffreestanding -nostdlib -c`; the documented link
#      recipe (`-ffunction-sections -Wl,--gc-sections`) drops the
#      dead sections before undefined-symbol resolution, so only the
#      reached (pure) functions must resolve — and they do, via (2).
fn freestanding_prelude_lines() -> list[str] {
    let r: list[str] = []
    r.push("#include <stdint.h>")
    r.push("#include <stdbool.h>")
    r.push("#include <stddef.h>")
    r.push("#define HL_FREESTANDING 1")
    r.push("#define PRId64 \"lld\"")
    r.push("// ---- Stage 77: bump arena (malloc/calloc/realloc/free) ----")
    r.push("#define HL_HEAP_SIZE (1048576)")
    r.push("static union { unsigned long long hl_align; unsigned char hl_buf[HL_HEAP_SIZE]; } hl_heap_u;")
    r.push("static size_t hl_heap_pos = 0;")
    r.push("static void* hl_bump_alloc(size_t n) {")
    r.push("    size_t total = n + (size_t)8;")
    r.push("    size_t a = (total + (size_t)7) & ~(size_t)7;")
    r.push("    if (a < total || hl_heap_pos + a > (size_t)HL_HEAP_SIZE) __builtin_trap();")
    r.push("    unsigned char* base = &hl_heap_u.hl_buf[hl_heap_pos];")
    r.push("    *(size_t*)base = n;")
    r.push("    hl_heap_pos += a;")
    r.push("    return (void*)(base + 8);")
    r.push("}")
    r.push("static void* hl_bump_calloc(size_t n, size_t sz) {")
    r.push("    if (sz != 0 && n > (size_t)-1 / sz) __builtin_trap();")
    r.push("    size_t t = n * sz;")
    r.push("    unsigned char* p = (unsigned char*)hl_bump_alloc(t);")
    r.push("    for (size_t i = 0; i < t; i++) p[i] = 0;")
    r.push("    return (void*)p;")
    r.push("}")
    r.push("static void* hl_bump_realloc(void* old, size_t n) {")
    r.push("    if (!old) return hl_bump_alloc(n);")
    r.push("    size_t oldn = *((size_t*)((unsigned char*)old - 8));")
    r.push("    unsigned char* p = (unsigned char*)hl_bump_alloc(n);")
    r.push("    size_t c = oldn < n ? oldn : n;")
    r.push("    for (size_t i = 0; i < c; i++) p[i] = ((unsigned char*)old)[i];")
    r.push("    return (void*)p;")
    r.push("}")
    r.push("#define malloc hl_bump_alloc")
    r.push("#define calloc hl_bump_calloc")
    r.push("#define realloc hl_bump_realloc")
    r.push("#define free(p) ((void)0)")
    # Deep-scan fix: the common runtime passes `free` as a BARE function
    # designator (hl_range: `hl_list_new(free)` — boxed primitives are
    # freed by libc in hosted mode). A function-like macro does not
    # expand there, and <stdlib.h> is not included in freestanding mode,
    # so the designator was an undeclared identifier (a hard error under
    # GCC 14's C23 default). Provide a real no-op free() for the
    # designator, then restore the call-site macro. The bump arena never
    # reclaims, so a no-op body is exactly the freestanding semantics.
    r.push("#undef free")
    r.push("static void free(void* p) { (void)p; }")
    r.push("#define free(p) ((void)0)")
    r.push("// ---- Stage 77: memory/string primitives ----")
    r.push("static void* hl_memcpy(void* d, const void* s, size_t n) {")
    r.push("    unsigned char* a = (unsigned char*)d;")
    r.push("    const unsigned char* b = (const unsigned char*)s;")
    r.push("    for (size_t i = 0; i < n; i++) a[i] = b[i];")
    r.push("    return d;")
    r.push("}")
    r.push("static void* hl_memset(void* d, int c, size_t n) {")
    r.push("    unsigned char* a = (unsigned char*)d;")
    r.push("    for (size_t i = 0; i < n; i++) a[i] = (unsigned char)c;")
    r.push("    return d;")
    r.push("}")
    r.push("static int hl_memcmp(const void* a, const void* b, size_t n) {")
    r.push("    const unsigned char* x = (const unsigned char*)a;")
    r.push("    const unsigned char* y = (const unsigned char*)b;")
    r.push("    for (size_t i = 0; i < n; i++) {")
    r.push("        if (x[i] != y[i]) return (int)x[i] - (int)y[i];")
    r.push("    }")
    r.push("    return 0;")
    r.push("}")
    r.push("static size_t hl_strlen(const char* s) {")
    r.push("    size_t n = 0;")
    r.push("    while (s[n]) n++;")
    r.push("    return n;")
    r.push("}")
    r.push("static int hl_strcmp(const char* a, const char* b) {")
    r.push("    while (*a && *a == *b) { a++; b++; }")
    r.push("    return (int)(unsigned char)*a - (int)(unsigned char)*b;")
    r.push("}")
    r.push("static int hl_strncmp(const char* a, const char* b, size_t n) {")
    r.push("    for (size_t i = 0; i < n; i++) {")
    r.push("        unsigned char x = (unsigned char)a[i];")
    r.push("        unsigned char y = (unsigned char)b[i];")
    r.push("        if (x != y || x == 0) return (int)x - (int)y;")
    r.push("    }")
    r.push("    return 0;")
    r.push("}")
    r.push("static char* hl_strcpy(char* d, const char* s) {")
    r.push("    char* rr = d;")
    r.push("    while ((*d++ = *s++)) {}")
    r.push("    return rr;")
    r.push("}")
    r.push("static char* hl_strchr(const char* s, int c) {")
    r.push("    while (*s) { if (*s == (char)c) return (char*)s; s++; }")
    r.push("    return (char*)0;")
    r.push("}")
    r.push("static char* hl_strdup(const char* s) {")
    r.push("    size_t n = hl_strlen(s) + 1;")
    r.push("    char* p = (char*)hl_bump_alloc(n);")
    r.push("    hl_memcpy(p, s, n);")
    r.push("    return p;")
    r.push("}")
    r.push("#define memcpy hl_memcpy")
    r.push("#define memset hl_memset")
    r.push("#define memcmp hl_memcmp")
    r.push("#define strlen hl_strlen")
    r.push("#define strcmp hl_strcmp")
    r.push("#define strncmp hl_strncmp")
    r.push("#define strcpy hl_strcpy")
    r.push("#define strchr hl_strchr")
    r.push("#define strdup hl_strdup")
    r.push("// ---- Stage 77: hosted-runtime declarations (dead code only) ----")
    r.push("// Every symbol below is referenced ONLY by hosted-only runtime")
    r.push("// functions (file IO, sockets, threads, libm, ...) that a")
    r.push("// freestanding program cannot reach (the checker rejects the")
    r.push("// effects that lead to them). The declarations let the TU")
    r.push("// compile under -ffreestanding; --gc-sections drops the dead")
    r.push("// sections before undefined-symbol resolution.")
    r.push("typedef struct _HlFsFile FILE;")
    # Deep-scan fix: the common runtime references the std streams by
    # NAME (hl_print: `fwrite(..., stdout)`; hl_eprint: `stderr`). The
    # stdio headers that define them are not included in freestanding
    # mode, so the stream VARIABLES need extern declarations — dead
    # sections referencing them are dropped by -Wl,--gc-sections before
    # undefined-symbol resolution (freestanding crates declare no
    # effects, so hl_print / hl_eprint are never reachable).
    r.push("extern FILE* stdout;")
    r.push("extern FILE* stderr;")
    r.push("typedef struct _HlFsDir DIR;")
    r.push("// Minimal layouts for dead hosted-only functions (complete")
    r.push("// types where a body needs one; never constructed by live code).")
    r.push("struct stat { long st_size; unsigned long st_mode; };")
    r.push("struct dirent { char d_name[256]; };")
    r.push("struct sockaddr { unsigned short sa_family; char sa_data[14]; };")
    r.push("struct in_addr { unsigned int s_addr; };")
    r.push("struct sockaddr_in { short sin_family; unsigned short sin_port; struct in_addr sin_addr; char sin_zero[8]; };")
    r.push("struct addrinfo { int ai_family; int ai_socktype; int ai_protocol; unsigned int ai_addrlen; struct sockaddr* ai_addr; char* ai_canonname; struct addrinfo* ai_next; };")
    r.push("struct timespec { long tv_sec; long tv_nsec; };")
    r.push("struct timeval { long tv_sec; long tv_usec; };")
    r.push("typedef int pid_t;")
    r.push("typedef unsigned int socklen_t;")
    r.push("typedef long ssize_t;")
    r.push("typedef unsigned long mode_t;")
    r.push("#define EOF (-1)")
    r.push("#define EINTR 4")
    r.push("#define ESRCH 3")
    r.push("#define SIGTERM 15")
    r.push("#define O_RDONLY 0")
    r.push("#define O_WRONLY 1")
    r.push("#define AF_INET 2")
    r.push("#define SOCK_STREAM 1")
    r.push("#define SOCK_DGRAM 2")
    r.push("#define SOL_SOCKET 1")
    r.push("#define SO_REUSEADDR 2")
    r.push("#define SO_RCVTIMEO 20")
    r.push("#define SO_SNDTIMEO 21")
    r.push("#define INADDR_ANY ((unsigned int)0)")
    r.push("#define INADDR_LOOPBACK ((unsigned int)0x0100007f)")
    r.push("#define INET_ADDRSTRLEN 16")
    r.push("#define CLOCK_MONOTONIC 1")
    r.push("#define CLOCK_REALTIME 0")
    r.push("#define S_ISDIR(m) (((m) & 0170000) == 0040000)")
    r.push("#define S_ISREG(m) (((m) & 0170000) == 0100000)")
    r.push("#define WEXITSTATUS(s) (((s) >> 8) & 0xff)")
    r.push("#define WIFEXITED(s) (((s) & 0x7f) == 0)")
    r.push("#define WIFSIGNALED(s) ((((s) & 0x7f) != 0) && (((s) & 0x7f) != 0x7f))")
    r.push("#define WTERMSIG(s) ((s) & 0x7f)")
    r.push("static int hl_errno_stub = 0;")
    r.push("#define errno hl_errno_stub")
    r.push("int printf(const char*, ...);")
    r.push("int fprintf(FILE*, const char*, ...);")
    r.push("int snprintf(char*, size_t, const char*, ...);")
    r.push("int fputc(int, FILE*);")
    r.push("char* fgets(char*, int, FILE*);")
    r.push("FILE* fopen(const char*, const char*);")
    r.push("size_t fread(void*, size_t, size_t, FILE*);")
    r.push("size_t fwrite(const void*, size_t, size_t, FILE*);")
    r.push("int fflush(FILE*);")
    r.push("int fclose(FILE*);")
    r.push("int getchar(void);")
    r.push("void exit(int);")
    r.push("void abort(void);")
    r.push("int atexit(void (*)(void));")
    r.push("char* getenv(const char*);")
    r.push("int setenv(const char*, const char*, int);")
    r.push("int unsetenv(const char*);")
    r.push("int system(const char*);")
    r.push("void _exit(int);")
    r.push("int chdir(const char*);")
    r.push("char* getcwd(char*, size_t);")
    r.push("int access(const char*, int);")
    r.push("unsigned int sleep(unsigned int);")
    r.push("int usleep(unsigned int);")
    r.push("int isatty(int);")
    r.push("pid_t getpid(void);")
    r.push("int gethostname(char*, size_t);")
    r.push("int fcntl(int, int, ...);")
    r.push("int open(const char*, int, ...);")
    r.push("int close(int);")
    r.push("ssize_t read(int, void*, size_t);")
    r.push("ssize_t write(int, const void*, size_t);")
    r.push("int pipe(int[2]);")
    r.push("int dup2(int, int);")
    r.push("pid_t fork(void);")
    r.push("int execvp(const char*, char* const[]);")
    r.push("int kill(pid_t, int);")
    r.push("pid_t waitpid(pid_t, int*, int);")
    r.push("double strtod(const char*, char**);")
    r.push("char* strerror(int);")
    r.push("char* realpath(const char*, char*);")
    # Deep-scan fix: hl_sandbox_check calls strncpy while canonicalising
    # a failed realpath resolution. GCC 14 (C23 default) rejects implicit
    # declarations outright, so — like every other hosted-only libc
    # symbol above — strncpy needs an explicit declaration here. The
    # function itself stays unlinked: -Wl,--gc-sections drops the dead
    # sandbox section before undefined-symbol resolution.
    r.push("char* strncpy(char*, const char*, size_t);")
    r.push("int socket(int, int, int);")
    r.push("int bind(int, const struct sockaddr*, socklen_t);")
    r.push("int listen(int, int);")
    r.push("int accept(int, struct sockaddr*, socklen_t*);")
    r.push("int connect(int, const struct sockaddr*, socklen_t);")
    r.push("int getaddrinfo(const char*, const char*, const struct addrinfo*, struct addrinfo**);")
    r.push("void freeaddrinfo(struct addrinfo*);")
    r.push("int setsockopt(int, int, int, const void*, socklen_t);")
    r.push("ssize_t send(int, const void*, size_t, int);")
    r.push("ssize_t recv(int, void*, size_t, int);")
    r.push("ssize_t sendto(int, const void*, size_t, int, const struct sockaddr*, socklen_t);")
    r.push("ssize_t recvfrom(int, void*, size_t, int, struct sockaddr*, socklen_t*);")
    r.push("unsigned int htonl(unsigned int);")
    r.push("unsigned short htons(unsigned short);")
    r.push("const char* inet_ntop(int, const void*, char*, socklen_t);")
    r.push("int inet_pton(int, const char*, void*);")
    r.push("unsigned long pthread_self(void);")
    r.push("int pthread_create(void*, void*, void* (*)(void*), void*);")
    r.push("int pthread_detach(unsigned long);")
    r.push("int pthread_mutex_lock(void*);")
    r.push("int pthread_mutex_unlock(void*);")
    r.push("int pthread_cond_wait(void*, void*);")
    r.push("int pthread_cond_broadcast(void*);")
    r.push("int clock_gettime(int, struct timespec*);")
    r.push("int nanosleep(const struct timespec*, struct timespec*);")
    r.push("int gettimeofday(struct timeval*, void*);")
    r.push("DIR* opendir(const char*);")
    r.push("struct dirent* readdir(DIR*);")
    r.push("int closedir(DIR*);")
    r.push("int stat(const char*, struct stat*);")
    r.push("int chmod(const char*, mode_t);")
    r.push("int sched_yield(void);")
    r.push("double fmod(double, double);")
    r.push("double sin(double);")
    r.push("double cos(double);")
    r.push("double tan(double);")
    r.push("double asin(double);")
    r.push("double acos(double);")
    r.push("double atan(double);")
    r.push("double atan2(double, double);")
    r.push("double sinh(double);")
    r.push("double cosh(double);")
    r.push("double tanh(double);")
    r.push("double exp(double);")
    r.push("double log(double);")
    r.push("double log10(double);")
    r.push("double log2(double);")
    r.push("double pow(double, double);")
    r.push("double sqrt(double);")
    r.push("double cbrt(double);")
    r.push("double hypot(double, double);")
    r.push("double floor(double);")
    r.push("double ceil(double);")
    r.push("double round(double);")
    r.push("double erf(double);")
    r.push("double erfc(double);")
    r.push("double tgamma(double);")
    r.push("double lgamma(double);")
    r.push("double copysign(double, double);")
    r.push("// Stage 77: the four float predicates are EXACT bit tests")
    r.push("// (no libm) — math_isnan/isinf/isfinite/signbit stay available")
    r.push("// in freestanding mode; the other 24 libm builtins do not.")
    r.push("static int hl_fs_isnan(double x) {")
    r.push("    uint64_t u = 0;")
    r.push("    hl_memcpy(&u, &x, 8);")
    r.push("    return ((u >> 52) & 0x7ff) == 0x7ff && (u & 0xfffffffffffffULL) != 0;")
    r.push("}")
    r.push("static int hl_fs_isinf(double x) {")
    r.push("    uint64_t u = 0;")
    r.push("    hl_memcpy(&u, &x, 8);")
    r.push("    return ((u >> 52) & 0x7ff) == 0x7ff && (u & 0xfffffffffffffULL) == 0;")
    r.push("}")
    r.push("static int hl_fs_isfinite(double x) {")
    r.push("    uint64_t u = 0;")
    r.push("    hl_memcpy(&u, &x, 8);")
    r.push("    return ((u >> 52) & 0x7ff) != 0x7ff;")
    r.push("}")
    r.push("static int hl_fs_signbit(double x) {")
    r.push("    uint64_t u = 0;")
    r.push("    hl_memcpy(&u, &x, 8);")
    r.push("    return (u >> 63) != 0;")
    r.push("}")
    r.push("#define isnan hl_fs_isnan")
    r.push("#define isinf hl_fs_isinf")
    r.push("#define isfinite hl_fs_isfinite")
    r.push("#define signbit hl_fs_signbit")
    return r
}

fn runtime_lines(fs: bool) -> list[str] {
    let r: list[str] = []
    # Stage 77 (v0.96.0-alpha): freestanding prelude — no libc, no
    # libm. Only the three freestanding headers the runtime needs
    # (stdint, stdbool, stddef); everything else is provided below.
    if fs {
        concat_lines(r, freestanding_prelude_lines())
        r.push("")
    } else {
        r.push("#include <stdio.h>")
        r.push("#include <stdlib.h>")
        r.push("#include <string.h>")
        r.push("#include <stdint.h>")
        r.push("#include <stdbool.h>")
        r.push("#include <inttypes.h>")
    r.push("#include <time.h>")
    r.push("#include <math.h>")
    r.push("#include <sys/stat.h>")
    # Stage 36 (v0.55.0-alpha): filesystem metadata builtins.
    # fs_read_dir uses opendir/readdir (declared in dirent.h).
    # fs_set_perms uses chmod (declared in sys/stat.h, already included).
    r.push("#include <dirent.h>")
    # Stage 9 release (v0.20.0-alpha): Net / Rand / Proc builtins.
    # net_lookup needs sys/socket.h, netdb.h, netinet/in.h for
    # getaddrinfo. proc_exec uses system() (declared in stdlib.h);
    # WIFEXITED / WEXITSTATUS / WTERMSIG are declared in sys/wait.h
    # (stdlib.h pulls it in indirectly on glibc but NOT on musl/other
    # libcs — explicitly include for portability).
    # rand_* use rand()/srand() (declared in stdlib.h).
    r.push("#include <sys/socket.h>")
    r.push("#include <netdb.h>")
    r.push("#include <netinet/in.h>")
    r.push("#include <arpa/inet.h>")
    r.push("#include <sys/wait.h>")
    r.push("#include <unistd.h>")
    # Stage 37 (v0.56.0-alpha): TCP / UDP / TLS builtins.
    # TCP/UDP use the BSD sockets API (already covered by the includes
    # above). TLS uses libcurl — the include is conditional on
    # HL_HAVE_LIBCURL so a build without libcurl installed still
    # compiles (the net_tls_get helper emits a clean panic instead of
    # a link error). The build system defines HL_HAVE_LIBCURL when
    # `-lcurl` is available (the Makefile's bootstrap target probes
    # for it and adds -DHAVE_LIBCURL to CFLAGS plus -lcurl to LIBS).
    r.push("#ifdef HL_HAVE_LIBCURL")
    r.push("#include <curl/curl.h>")
    r.push("#endif")
    # Stage 16 (v0.27.0-alpha): the concurrency runtime (pthread-based).
    r.push("#include <pthread.h>")
    # Stage 46 (v0.65.0-alpha): thread / scheduling builtins.
    # sched_yield is declared in sched.h. errno / EINTR (used by the
    # nanosleep retry loop in hl_thread_sleep_ms) are in errno.h.
    # Both are tiny system headers; the include cost is negligible.
    r.push("#include <sched.h>")
    r.push("#include <errno.h>")
    # Stage 47 (v0.66.0-alpha): process management builtins.
    # fork / execvp / dup2 / pipe / read / write are declared in
    # unistd.h (already included above). waitpid is declared in
    # sys/wait.h (already included). kill is declared in signal.h.
    # open / O_RDONLY / O_WRONLY are declared in fcntl.h. pid_t
    # is declared in sys/types.h (pulled in by sys/wait.h).
    r.push("#include <signal.h>")
    r.push("#include <fcntl.h>")
    }
    r.push("")
    # ---- Stage 8-beta: the refcounted runtime (END OF ARENA) ----
    # Every heap object starts with an int64_t refcnt as its FIRST field so
    # hl_retain works uniformly on all object types. Releases are
    # type-specific (they must release children). elem_free / val_free ==
    # NULL means "arena mode": the container never releases its items (used
    # by the LLVM backend, which is still arena-based).
    r.push("typedef struct { int64_t refcnt; int64_t len; char* data; } hl_str;")
    r.push("typedef struct { int64_t refcnt; int64_t len; int64_t cap; void** items; void (*elem_free)(void*); } hl_list;")
    r.push("typedef struct { int64_t refcnt; int64_t len; int64_t cap; hl_str** slots; void** vals; hl_str** order; void (*val_free)(void*); } hl_map;")
    r.push("")
    r.push("// ---- Stage 81 (v0.100.0-alpha): panic-handler hook ----")
    r.push("// A program that declares #[panic_handler] fn panic_handler(msg:")
    r.push("// str) -> void gets it wired here: the entry point (_start / main)")
    r.push("// sets hl_panic_hook to the compiled handler, and every panic")
    r.push("// path below invokes it once before the default action. Programs")
    r.push("// without a handler leave the hook NULL: behaviour is unchanged.")
    r.push("// hl_in_panic is the reentrancy guard — a nested panic inside the")
    r.push("// handler (e.g. OOM while wrapping the message) falls straight")
    r.push("// through to the default action instead of recursing.")
    r.push("static void (*hl_panic_hook)(hl_str*) = 0;")
    r.push("static int hl_in_panic = 0;")
    r.push("static hl_str* hl_str_from(const char* c, int64_t len);")
    r.push("// The guard is raised BEFORE the message is wrapped: wrapping")
    r.push("// allocates, and an OOM inside the wrap re-enters hl_die — with")
    r.push("// the guard already up it falls straight through to the default")
    r.push("// action instead of recursing.")
    r.push("// The hook always receives a COPY: the compiled handler takes")
    r.push("// ownership of its parameter (cleanup attribute releases it on")
    r.push("// return), so passing the caller's string would use-after-free")
    r.push("// the default report below. The copy is the handler's to keep")
    r.push("// or release; the original is untouched.")
    r.push("static void hl_call_panic_hook(hl_str* msg) {")
    r.push("    if (hl_panic_hook && !hl_in_panic) {")
    r.push("        hl_in_panic = 1;")
    r.push("        hl_panic_hook(hl_str_from(msg->data, msg->len));")
    r.push("        hl_in_panic = 0;")
    r.push("    }")
    r.push("}")
    r.push("static void hl_call_panic_hook_cstr(const char* msg) {")
    r.push("    if (hl_panic_hook && !hl_in_panic) {")
    r.push("        hl_in_panic = 1;")
    r.push("        hl_str* hm = hl_str_from(msg, (int64_t)strlen(msg));")
    r.push("        hl_panic_hook(hm);")
    r.push("        hl_in_panic = 0;")
    r.push("    }")
    r.push("}")
    r.push("")
    r.push("// Checked byte string — used by the HLS runtime")
    # Stage 77: in freestanding mode there is no stderr and no
    # exit(101) — a panic halts the CPU via a trap. Stage 81 makes
    # this user-overridable: a #[panic_handler] fn runs first (above),
    # then the trap below still fires when the handler returns.
    if fs {
        r.push("static void hl_die(const char* msg) {")
        r.push("    hl_call_panic_hook_cstr(msg);")
        r.push("    __builtin_trap();")
        r.push("}")
    } else {
        r.push("static void hl_die(const char* msg) {")
        r.push("    hl_call_panic_hook_cstr(msg);")
        r.push("    fflush(stdout);")
        r.push("    fprintf(stderr, \"panic: %s\\n\", msg);")
        r.push("    exit(101);")
        r.push("}")
    }
    r.push("")
    # Stage 10 release: the runtime position-aware panic. Used by codegen
    # for panic() calls and arithmetic overflow checks (planned for Stage 11
    # release; currently emitted by gen_call's panic path and gen_bin's
    # overflow helpers when --opt fast is in effect).
    # Stage 81: the handler receives the bare message (uniform across
    # modes, so hosted and freestanding binaries report the same input
    # to the same handler); the source location stays in the default
    # report below.
    r.push("static void hl_die_at(const char* msg, const char* file, int64_t line) {")
    if fs {
        r.push("    hl_call_panic_hook_cstr(msg);")
        r.push("    (void)file; (void)line;")
        r.push("    __builtin_trap();")
        r.push("}")
    } else {
        r.push("    hl_call_panic_hook_cstr(msg);")
        r.push("    fflush(stdout);")
        r.push("    if (file && line > 0) {")
        r.push("        fprintf(stderr, \"panic: %s (at %s:%lld)\\n\", msg, file, (long long)line);")
        r.push("    } else {")
        r.push("        fprintf(stderr, \"panic: %s\\n\", msg);")
        r.push("    }")
        r.push("    exit(101);")
        r.push("}")
    }
    r.push("")
    # Stage 10 release: sandbox root. When non-NULL, every filesystem
    # builtin (hl_read_file, hl_write_file, hl_file_exists) refuses to
    # touch any path that does not resolve INSIDE this directory. The
    # sandbox is set at program startup via hl_set_sandbox_root() —
    # boot.py --sandbox DIR emits the call in main().
    r.push("static char* hl_sandbox_root = NULL;")
    # Stage 21 (v0.37.0-alpha): runtime CPU feature probe. On x86-64 /
    # x86 it uses gcc/clang's __builtin_cpu_supports (CPU + OS support);
    # on aarch64 it reports "neon" when the compiler targets NEON (the
    # SIMD instruction set is baseline there but still gate-able); every
    # other architecture reports false. Used by simd_cpu_supports() —
    # the runtime-dispatch half of cfg(feature).
    r.push("static bool hl_simd_cpu_supports(hl_str* s) {")
    r.push("    if (!s) return false;")
    r.push("#define HL_FEAT_EQ(lit) \\")
    r.push("    (s->len == (int64_t)sizeof(lit) - 1 && memcmp(s->data, lit, sizeof(lit) - 1) == 0)")
    r.push("#if defined(__x86_64__) || defined(__i386__)")
    r.push("    if (HL_FEAT_EQ(\"avx\")) return __builtin_cpu_supports(\"avx\");")
    r.push("    if (HL_FEAT_EQ(\"avx2\")) return __builtin_cpu_supports(\"avx2\");")
    r.push("    if (HL_FEAT_EQ(\"sse3\")) return __builtin_cpu_supports(\"sse3\");")
    r.push("    if (HL_FEAT_EQ(\"sse4.2\")) return __builtin_cpu_supports(\"sse4.2\");")
    r.push("    return false;")
    r.push("#elif defined(__aarch64__)")
    r.push("    if (HL_FEAT_EQ(\"neon\")) return true; /* NEON is baseline on aarch64 */")
    r.push("    return false;")
    r.push("#else")
    r.push("    return false;")
    r.push("#endif")
    r.push("#undef HL_FEAT_EQ")
    r.push("}")
    r.push("")
    r.push("static void hl_set_sandbox_root(const char* dir) {")
    r.push("    if (hl_sandbox_root) { free(hl_sandbox_root); hl_sandbox_root = NULL; }")
    r.push("    if (dir) {")
    r.push("        // Canonicalise via realpath so symlink escapes are caught.")
    r.push("        char buf[4096];")
    r.push("        char* rp = realpath(dir, buf);")
    r.push("        // Deep-scan fix (CC14): check strdup's return. On OOM strdup")
    r.push("        // returns NULL, silently disabling the sandbox. Refuse to")
    r.push("        // proceed if we can't allocate the canonicalised path.")
    r.push("        if (rp) {")
    r.push("            char* dup = strdup(rp);")
    r.push("            if (!dup) hl_die(\"out of memory\");")
    r.push("            hl_sandbox_root = dup;")
    r.push("        }")
    r.push("    }")
    r.push("}")
    r.push("")
    # Stage 10 release: hl_sandbox_check(path) — refuse to touch paths
    # outside the sandbox root. Mirrors the interpreter's _sandbox_check.
    # Resolves symlinks via realpath so ../../etc/passwd attacks fail.
    r.push("static void hl_sandbox_check(const char* path) {")
    r.push("    if (!hl_sandbox_root) return;")
    r.push("    char buf[4096];")
    r.push("    char* rp = realpath(path, buf);")
    r.push("    // If realpath fails, the path doesn't exist yet (e.g. a write_file")
    r.push("    // target). Resolve the parent directory and check it.")
    r.push("    if (!rp) {")
    r.push("        // Find the last path separator and resolve the parent.")
    r.push("        char tmp[4096];")
    r.push("        strncpy(tmp, path, sizeof(tmp) - 1);")
    r.push("        tmp[sizeof(tmp) - 1] = 0;")
    r.push("        size_t L = strlen(tmp);")
    r.push("        while (L > 0 && tmp[L-1] != '/' && tmp[L-1] != '\\\\') {")
    r.push("            tmp[--L] = 0;")
    r.push("        }")
    r.push("        if (L == 0) { strcpy(tmp, \".\"); L = 1; }")
    r.push("        char pbuf[4096];")
    r.push("        char* pp = realpath(tmp, pbuf);")
    r.push("        if (!pp) hl_die(\"sandbox violation: cannot resolve path\");")
    r.push("        // Re-append the basename.")
    r.push("        // Deep-scan-28 fix (off-by-one): when the path has NO")
    r.push("        // separator the strip loop empties tmp and re-appends")
    r.push("        // from path+1, silently DROPPING the first character")
    r.push("        // (\"new.txt\" became pp+\"ew.txt\" -> spurious sandbox")
    r.push("        // violation). The parent is \".\" in that case, so the")
    r.push("        // full path must be re-joined with an explicit '/'.")
    r.push("        if (L == 0 || (L == 1 && tmp[0] == '.')) {")
    r.push("            snprintf(buf, sizeof(buf), \"%s/%s\", pp, path);")
    r.push("        } else {")
    r.push("            snprintf(buf, sizeof(buf), \"%s%s\", pp, path + L);")
    r.push("        }")
    r.push("    }")
    r.push("    // Common-prefix check with a separator after the prefix.")
    r.push("    size_t sb_len = strlen(hl_sandbox_root);")
    r.push("    if (strncmp(buf, hl_sandbox_root, sb_len) != 0)")
    r.push("        hl_die(\"sandbox violation: path resolves outside the sandbox\");")
    r.push("    char next = buf[sb_len];")
    r.push("    // Deep-scan fix (C9): accept both / and \\\\ as path separators")
    r.push("    // so the sandbox works on Windows. Previously only / was")
    r.push("    // accepted, causing every sandboxed file op to panic on Windows")
    r.push("    // (the parent-strip loop at line ~4207 accepts both, so the")
    r.push("    // inconsistency was a latent portability bug).")
    r.push("    if (next != 0 && next != '/' && next != '\\\\')")
    r.push("        hl_die(\"sandbox violation: path resolves outside the sandbox\");")
    r.push("}")
    r.push("")
    r.push("// ---- Stage 8-beta: reference-counting core ----")
    r.push("// refcnt is the first field of every heap object, so retain is")
    r.push("// generic; release is type-specific (it must release children).")
    r.push("static void* hl_retain(void* p) {")
    r.push("    if (p) ((int64_t*)p)[0] += 1;")
    r.push("    return p;")
    r.push("}")
    r.push("")
    # ---- Stage 16 (v0.27.0-alpha): the concurrency runtime ----
    # pthread tasks + channels. Design (mirrored exactly by the Python
    # interpreter's ConcRuntime so differential testing holds):
    #   - one global mutex + condvar guard ALL channel/task state
    #   - channels are MPMC FIFO queues, unbounded by default or BOUNDED
    #     via chan_new_bounded(cap) (Stage-16 perfection, v0.29.0-alpha):
    #     a bounded channel's send blocks while full (backpressure);
    #     recv/select/join (and full-sends) block on the global condvar
    #   - the deadlock detector fires when every thread that could
    #     produce work is blocked AND no channel has a progress
    #     opportunity (a pending message with a recv waiter, or free
    #     capacity with a send waiter) — see hl_rt_deadlock_check
    #   - Chan refcounts are ATOMIC (channels are the one deliberately
    #     shared object); Task refcounts live under the global mutex.
    #     Every other type crosses task boundaries by OWNERSHIP TRANSFER
    #     (spawn/send boundary clones — see gen_spawn_call), so all
    #     other refcount ops stay single-threaded, keeping the Stage 8
    #     non-atomic refcount model sound under concurrency.
    r.push("// ---- Stage 16: the concurrency runtime (tasks + channels) ----")
    # Stage 77: the whole concurrency region (task/channel structs
    # with pthread members, the global mutex/cond, and every
    # chan/task/spawn helper) is hosted-only — a freestanding
    # program cannot reach it (the Conc effect is rejected), and its
    # pthread types have no freestanding declaration. Guarded as one
    # contiguous block (no HLS `let`s inside, so the `if` wrap is safe).
    if !fs {
    r.push("typedef struct hl_msg {")
    r.push("    union { int64_t i; double f; void* p; } v;")
    r.push("    struct hl_msg* next;")
    r.push("} hl_msg;")
    r.push("")
    r.push("typedef struct hl_chan {")
    r.push("    volatile int64_t refcnt;   // ATOMIC — channels are shared across threads")
    r.push("    hl_msg* head;              // FIFO queue (guarded by g_rt_mu)")
    r.push("    hl_msg* tail;")
    r.push("    int64_t cap;               // 0 = unbounded; >= 1 = bounded: send blocks while full")
    r.push("    int64_t count;             // pending messages (guarded by g_rt_mu; O(1) len)")
    r.push("    int64_t waiters;           // threads blocked in recv/select on THIS channel")
    r.push("    int64_t send_waiters;      // threads blocked sending to this full channel")
    r.push("    struct hl_chan *reg_next, *reg_prev;  // live-channel registry (deadlock scan)")
    r.push("    void (*elem_release)(void*);  // pointer-payload release (NULL for primitives)")
    r.push("} hl_chan;")
    r.push("")
    r.push("typedef union { int64_t i; double f; void* p; } hl_task_res;")
    r.push("")
    r.push("typedef struct hl_task {")
    r.push("    int64_t refcnt;            // guarded by g_rt_mu")
    r.push("    pthread_t th;")
    r.push("    bool done;")
    r.push("    bool joined;")
    r.push("    bool freed;")
    r.push("    hl_task_res res;")
    r.push("} hl_task;")
    r.push("")
    r.push("typedef struct { void (*body)(void*, hl_task*); void* argbox; hl_task* task; } hl_spawn_ctx;")
    r.push("")
    r.push("static pthread_mutex_t g_rt_mu = PTHREAD_MUTEX_INITIALIZER;")
    r.push("static pthread_cond_t  g_rt_cv = PTHREAD_COND_INITIALIZER;")
    r.push("static int64_t g_rt_tasks   = 0;   // spawned tasks alive (main excluded)")
    r.push("static int64_t g_rt_blocked = 0;   // threads blocked in recv/select/join/send (main included)")
    r.push("static int64_t g_rt_msgs    = 0;   // pending messages across ALL channels")
    # Stage 33 (v0.52.0-alpha): g_rt_done_unjoined — the number of tasks
    # that have finished (hl_task_finish was called) but have NOT yet been
    # joined. If this is > 0, a join waiter can proceed, so the deadlock
    # check must NOT fire even if g_rt_blocked == alive. This fixes a
    # false-positive deadlock when an async task is blocked in t.join()
    # and the joined task has just finished (race between the join waiter
    # re-checking t->done and another thread's deadlock_check).
    r.push("static int64_t g_rt_done_unjoined = 0;   // tasks done but not yet joined")
    r.push("static int64_t g_rt_join_waiters = 0;   // threads currently blocked in join (deep-scan-20)")
    r.push("static hl_chan* g_rt_chans  = NULL; // live-channel registry (guarded by g_rt_mu)")
    r.push("")
    r.push("// Deadlock check — call with g_rt_mu HELD, before blocking.")
    r.push("// Fires when EVERY thread is blocked (recv/select/join/full-send)")
    r.push("// AND no channel has a progress opportunity: a pending message")
    r.push("// with a recv waiter, or free capacity with a send waiter. A")
    r.push("// woken-but-unscheduled thread is still counted in g_rt_blocked")
    r.push("// (its decrement happens only after cond_wait re-acquires the")
    r.push("// mutex), which is exactly why the waiter counters are needed:")
    r.push("// `blocked == alive` alone can fire while a consumer's message is")
    r.push("// already pending but the consumer has not been scheduled. (A")
    r.push("// thread between two operations holds the mutex and is never")
    r.push("// miscounted, so this cannot fire spuriously. Mirrors the Python")
    r.push("// ConcRuntime.deadlock_check exactly.)")
    r.push("static void hl_rt_deadlock_check(void) {")
    r.push("    int64_t alive = g_rt_tasks + 1;   // +1: the main thread")
    r.push("    if (g_rt_blocked != alive) return;")
    r.push("    // Stage 33: if any task is done but not yet joined, a join")
    r.push("    // waiter can proceed — not a deadlock. Deep-scan-20 fix:")
    r.push("    // only when a thread is ACTUALLY blocked in join(). The old")
    r.push("    // unconditional guard also excused real deadlocks where a")
    r.push("    // finished-but-never-joined task existed and every remaining")
    r.push("    // thread was blocked on an empty channel — the runtime then")
    r.push("    // hung forever instead of reporting the deadlock (boot/native")
    r.push("    // divergence: the interpreter panicked correctly).")
    r.push("    if (g_rt_done_unjoined > 0 && g_rt_join_waiters > 0) return;")
    r.push("    for (hl_chan* c = g_rt_chans; c; c = c->reg_next) {")
    r.push("        if (c->head && c->waiters > 0) return;       // a consumer can proceed")
    r.push("        if (c->send_waiters > 0 && c->count < c->cap) return;  // a woken sender can proceed")
    r.push("    }")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    hl_die(\"deadlock: all tasks are blocked on channel operations (no possible progress)\");")
    r.push("}")
    r.push("")
    r.push("static void hl_chan_register(hl_chan* c) {")
    r.push("    c->reg_next = g_rt_chans;")
    r.push("    c->reg_prev = NULL;")
    r.push("    if (g_rt_chans) g_rt_chans->reg_prev = c;")
    r.push("    g_rt_chans = c;")
    r.push("}")
    r.push("static void hl_chan_unregister(hl_chan* c) {  // g_rt_mu HELD")
    r.push("    if (c->reg_prev) c->reg_prev->reg_next = c->reg_next; else g_rt_chans = c->reg_next;")
    r.push("    if (c->reg_next) c->reg_next->reg_prev = c->reg_prev;")
    r.push("}")
    r.push("")
    r.push("static hl_chan* hl_chan_new_cap(int64_t cap, void (*elem_release)(void*)) {")
    r.push("    hl_chan* c = (hl_chan*)malloc(sizeof(hl_chan));")
    r.push("    if (!c) hl_die(\"out of memory\");")
    r.push("    c->refcnt = 1;")
    r.push("    c->head = NULL;")
    r.push("    c->tail = NULL;")
    r.push("    c->cap = cap;")
    r.push("    c->count = 0;")
    r.push("    c->waiters = 0;")
    r.push("    c->send_waiters = 0;")
    r.push("    c->elem_release = elem_release;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_register(c);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return c;")
    r.push("}")
    r.push("static hl_chan* hl_chan_new(void (*elem_release)(void*)) {")
    r.push("    return hl_chan_new_cap(0, elem_release);")
    r.push("}")
    r.push("// chan_new_bounded(cap) — send blocks while `cap` messages are pending.")
    r.push("// The checker rejects literal capacities < 1; dynamic ones die here.")
    r.push("static hl_chan* hl_chan_new_bounded(int64_t cap, void (*elem_release)(void*)) {")
    r.push("    if (cap < 1) hl_die(\"chan_new_bounded() capacity must be >= 1\");")
    r.push("    return hl_chan_new_cap(cap, elem_release);")
    r.push("}")
    r.push("")
    r.push("// clone() of a channel SHARES it (atomic refcount + 1) — the whole")
    r.push("// point of a channel. This is the ONLY clone in the language that")
    r.push("// does not produce an independent copy.")
    r.push("static hl_chan* hl_chan_clone(hl_chan* c) {")
    r.push("    if (c) __atomic_fetch_add(&c->refcnt, 1, __ATOMIC_ACQ_REL);")
    r.push("    return c;")
    r.push("}")
    r.push("")
    r.push("static void hl_chan_release(void* pv) {")
    r.push("    hl_chan* c = (hl_chan*)pv;")
    r.push("    if (!c) return;")
    r.push("    if (__atomic_fetch_sub(&c->refcnt, 1, __ATOMIC_ACQ_REL) == 1) {")
    r.push("        // Last reference. v0.29.0-alpha: first unlink the channel")
    r.push("        // from the live-channel registry (the deadlock scan must")
    r.push("        // not walk a freed node). No waiter can exist: refcnt==0")
    r.push("        // means no binding holds the channel, and every")
    r.push("        // send/recv requires a live reference — so send_waiters ==")
    r.push("        // waiters == 0 here. The drain then runs WITHOUT the lock;")
    r.push("        // releasing payload channels re-enters safely (no nesting).")
    r.push("        pthread_mutex_lock(&g_rt_mu);")
    r.push("        hl_chan_unregister(c);")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        hl_msg* m = c->head;")
    r.push("        while (m) {")
    r.push("            hl_msg* nx = m->next;")
    r.push("            if (c->elem_release && m->v.p) c->elem_release(m->v.p);")
    r.push("            free(m);")
    r.push("            m = nx;")
    r.push("        }")
    r.push("        free(c);")
    r.push("    }")
    r.push("}")
    r.push("static void hl_cleanup_chan(hl_chan** p) { hl_chan_release(*p); }")
    r.push("")
    r.push("// Blocking enqueue — g_rt_mu HELD. On a bounded channel, waits")
    r.push("// while the queue holds `cap` messages (backpressure); a dequeue")
    r.push("// broadcasts, which is what wakes a sender blocked here. Unbounded")
    r.push("// channels (cap == 0) never block the sender.")
    r.push("static void hl_chan_enqueue(hl_chan* c, hl_msg* m) {  // g_rt_mu HELD")
    r.push("    while (c->cap > 0 && c->count >= c->cap) {")
    r.push("        c->send_waiters++;")
    r.push("        g_rt_blocked++;")
    r.push("        hl_rt_deadlock_check();")
    r.push("        pthread_cond_wait(&g_rt_cv, &g_rt_mu);")
    r.push("        g_rt_blocked--;")
    r.push("        c->send_waiters--;")
    r.push("    }")
    r.push("    if (c->tail) { c->tail->next = m; } else { c->head = m; }")
    r.push("    c->tail = m;")
    r.push("    m->next = NULL;")
    r.push("    c->count++;")
    r.push("    g_rt_msgs++;")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("}")
    r.push("")
    r.push("static hl_msg* hl_chan_dequeue(hl_chan* c) {  // g_rt_mu HELD")
    r.push("    hl_msg* m = c->head;")
    r.push("    c->head = m->next;")
    r.push("    if (!c->head) c->tail = NULL;")
    r.push("    c->count--;")
    r.push("    g_rt_msgs--;")
    r.push("    // Freeing capacity can unblock a bounded-channel sender.")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("    return m;")
    r.push("}")
    r.push("")
    r.push("static void hl_chan_send_ptr(hl_chan* c, void* v) {")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.p = v;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_enqueue(c, m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
    r.push("static void hl_chan_send_i64(hl_chan* c, int64_t v) {")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.i = v;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_enqueue(c, m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
    r.push("static void hl_chan_send_f64(hl_chan* c, double v) {")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.f = v;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_enqueue(c, m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
    r.push("")
    r.push("// try_send — non-blocking variants: false iff a bounded channel")
    r.push("// is full (the value is NOT enqueued). For pointer payloads the")
    r.push("// caller's defensive copy is RELEASED here when the send fails")
    r.push("// (elem_release owns exactly that payload type).")
    r.push("static bool hl_chan_try_send_ptr(hl_chan* c, void* v) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (c->cap > 0 && c->count >= c->cap) {")
    r.push("        if (c->elem_release && v) c->elem_release(v);")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        return false;")
    r.push("    }")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.p = v;")
    r.push("    m->next = NULL;")
    r.push("    if (c->tail) { c->tail->next = m; } else { c->head = m; }")
    r.push("    c->tail = m;")
    r.push("    c->count++;")
    r.push("    g_rt_msgs++;")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return true;")
    r.push("}")
    r.push("static bool hl_chan_try_send_i64(hl_chan* c, int64_t v) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (c->cap > 0 && c->count >= c->cap) {")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        return false;")
    r.push("    }")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.i = v;")
    r.push("    m->next = NULL;")
    r.push("    if (c->tail) { c->tail->next = m; } else { c->head = m; }")
    r.push("    c->tail = m;")
    r.push("    c->count++;")
    r.push("    g_rt_msgs++;")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return true;")
    r.push("}")
    r.push("static bool hl_chan_try_send_f64(hl_chan* c, double v) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (c->cap > 0 && c->count >= c->cap) {")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        return false;")
    r.push("    }")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.f = v;")
    r.push("    m->next = NULL;")
    r.push("    if (c->tail) { c->tail->next = m; } else { c->head = m; }")
    r.push("    c->tail = m;")
    r.push("    c->count++;")
    r.push("    g_rt_msgs++;")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return true;")
    r.push("}")
    r.push("")
    r.push("static void hl_chan_wait(hl_chan* c) {  // g_rt_mu HELD")
    r.push("    while (!c->head) {")
    r.push("        c->waiters++;")
    r.push("        g_rt_blocked++;")
    r.push("        hl_rt_deadlock_check();")
    r.push("        pthread_cond_wait(&g_rt_cv, &g_rt_mu);")
    r.push("        g_rt_blocked--;")
    r.push("        c->waiters--;")
    r.push("    }")
    r.push("}")
    r.push("")
    r.push("static void* hl_chan_recv_ptr(hl_chan* c) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_wait(c);")
    r.push("    hl_msg* m = hl_chan_dequeue(c);")
    r.push("    void* v = m->v.p;")
    r.push("    free(m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return v;")
    r.push("}")
    r.push("static int64_t hl_chan_recv_i64(hl_chan* c) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_wait(c);")
    r.push("    hl_msg* m = hl_chan_dequeue(c);")
    r.push("    int64_t v = m->v.i;")
    r.push("    free(m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return v;")
    r.push("}")
    r.push("static double hl_chan_recv_f64(hl_chan* c) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_wait(c);")
    r.push("    hl_msg* m = hl_chan_dequeue(c);")
    r.push("    double v = m->v.f;")
    r.push("    free(m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return v;")
    r.push("}")
    r.push("")
    r.push("// recv_or — non-blocking recv: the pending message if one exists,")
    r.push("// else the caller's default. For pointer payloads the default is")
    r.push("// an OWNED extra reference (the codegen own-wraps non-fresh")
    r.push("// expressions); when a message IS available the default must be")
    r.push("// released here via elem_release (it owns exactly that type).")
    r.push("static void* hl_chan_recv_or_ptr(hl_chan* c, void* def) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (!c->head) {")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        return def;")
    r.push("    }")
    r.push("    hl_msg* m = hl_chan_dequeue(c);")
    r.push("    void* v = m->v.p;")
    r.push("    free(m);")
    r.push("    if (c->elem_release && def) c->elem_release(def);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return v;")
    r.push("}")
    r.push("static int64_t hl_chan_recv_or_i64(hl_chan* c, int64_t def) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (!c->head) {")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        return def;")
    r.push("    }")
    r.push("    hl_msg* m = hl_chan_dequeue(c);")
    r.push("    void* v = m->v.p;")
    r.push("    free(m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return v;")
    r.push("}")
    r.push("static double hl_chan_recv_or_f64(hl_chan* c, double def) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (!c->head) {")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        return def;")
    r.push("    }")
    r.push("    hl_msg* m = hl_chan_dequeue(c);")
    r.push("    void* v = m->v.p;")
    r.push("    free(m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return v;")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_chan_len(hl_chan* c) { return c->count; }")
    r.push("")
    r.push("// select(chs) — block until any channel has a pending message;")
    r.push("// return the index (list order) of the first ready one. The list")
    r.push("// holds raw hl_chan* items (pointer element lists are unboxed).")
    r.push("// v0.29.0-alpha: while waiting, the waiter count is bumped on ALL")
    r.push("// listed channels so the deadlock scan sees this thread as a")
    r.push("// potential consumer of any of them.")
    r.push("static int64_t hl_chan_select(hl_list* chs) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (chs->len == 0) {")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        hl_die(\"select() on empty channel list\");")
    r.push("    }")
    r.push("    while (1) {")
    r.push("        for (int64_t i = 0; i < chs->len; i++) {")
    r.push("            hl_chan* c = (hl_chan*)chs->items[i];")
    r.push("            if (c->head) {")
    r.push("                pthread_mutex_unlock(&g_rt_mu);")
    r.push("                return i;")
    r.push("            }")
    r.push("        }")
    r.push("        for (int64_t i = 0; i < chs->len; i++)")
    r.push("            ((hl_chan*)chs->items[i])->waiters++;")
    r.push("        g_rt_blocked++;")
    r.push("        hl_rt_deadlock_check();")
    r.push("        pthread_cond_wait(&g_rt_cv, &g_rt_mu);")
    r.push("        g_rt_blocked--;")
    r.push("        for (int64_t i = 0; i < chs->len; i++)")
    r.push("            ((hl_chan*)chs->items[i])->waiters--;")
    r.push("    }")
    r.push("}")
    r.push("")
    r.push("// ---- tasks ----")
    r.push("static void hl_task_finish(hl_task* t, hl_task_res res) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    t->res = res;")
    r.push("    t->done = true;")
    r.push("    g_rt_tasks--;")
    r.push("    g_rt_done_unjoined++;   // Stage 33: a join waiter can now proceed")
    r.push("    if (t->refcnt == 0 && !t->freed) { t->freed = true; free(t); }  // abandoned")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("}")
    r.push("")
    r.push("// Typed finish wrappers (called by the generated trampolines).")
    r.push("static void hl_task_finish_i64(hl_task* t, int64_t v) {")
    r.push("    hl_task_res r; r.i = v; hl_task_finish(t, r);")
    r.push("}")
    r.push("static void hl_task_finish_f64(hl_task* t, double v) {")
    r.push("    hl_task_res r; r.f = v; hl_task_finish(t, r);")
    r.push("}")
    r.push("static void hl_task_finish_ptr(hl_task* t, void* v) {")
    r.push("    hl_task_res r; r.p = v; hl_task_finish(t, r);")
    r.push("}")
    r.push("")
    r.push("static void* hl_spawn_entry(void* pv) {")
    r.push("    hl_spawn_ctx* c = (hl_spawn_ctx*)pv;")
    r.push("    void** box = (void**)pv;")
    r.push("    void (*body)(void*) = (void(*)(void*))box[0];")
    r.push("    void* argbox = box[1];")
    r.push("    free(box);")
    r.push("    body(argbox);")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    g_rt_tasks--;")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return NULL;")
    r.push("}")
    r.push("")
    r.push("static void hl_async_spawn(void (*body)(void*), void* argbox) {")
    r.push("    void** box = (void**)malloc(2 * sizeof(void*));")
    r.push("    if (!box) hl_die(\"out of memory\");")
    r.push("    box[0] = (void*)body;")
    r.push("    box[1] = argbox;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    g_rt_tasks++;")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    pthread_t th;")
    r.push("    if (pthread_create(&th, NULL, hl_async_spawn_entry, box) != 0) {")
    r.push("        pthread_mutex_lock(&g_rt_mu);")
    r.push("        g_rt_tasks--;")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        free(box);")
    r.push("        hl_die(\"async_spawn: cannot create thread\");")
    r.push("    }")
    r.push("    pthread_detach(th);")
    r.push("}")
    r.push("")
