# ============================================================================
# hlc/check_call.hls — part of the hlc compiler (split from the original single-file
# src/hlc.hls). This file is loaded via `import "hlc/check_call.hls"` from src/hlc.hls.
# Section 4d — CHECKER: builtin calls, spawn/async/stream calls, method calls.
# NOTE: content is byte-identical to the original src/hlc.hls line range
#       7695..9619 - module split is purely structural, zero code changes.
# ============================================================================
# is_freestanding_deny_builtin (Stage 77, v0.96.0-alpha): true
# for the 24 libm-backed math_* builtins plus float() — pure builtins
# with no freestanding lowering (mirrors FREESTANDING_DENY_BUILTINS
# in the Stage-0 checker).
fn is_freestanding_deny_builtin(name: str) -> bool {
    if name == "float" {
        return true
    }
    if name == "math_sin" || name == "math_cos" || name == "math_tan"
    || name == "math_asin" || name == "math_acos" || name == "math_atan"
    || name == "math_atan2" || name == "math_sinh" || name == "math_cosh"
    || name == "math_tanh" || name == "math_exp" || name == "math_log"
    || name == "math_log10" || name == "math_log2" || name == "math_pow"
    || name == "math_sqrt" || name == "math_cbrt" || name == "math_hypot"
    || name == "math_fmod" || name == "math_copysign" || name == "math_erf"
    || name == "math_erfc" || name == "math_tgamma" || name == "math_lgamma" {
        return true
    }
    return false
}

fn check_builtin_call(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, name: str, expected: str) -> str {
    let mut line: int = ctx.exprs[e].line
    # Stage 77 (v0.96.0-alpha): freestanding denylist — pure builtins
    # with no freestanding lowering (24 libm-backed math_* + the
    # float() constructor, which needs strtod). math_isnan/isinf/
    # isfinite/signbit stay available (exact bit tests in the
    # freestanding prelude, no libm).
    if ctx.crate_freestanding && is_freestanding_deny_builtin(name) {
        cerr(line, name + "() is not available in #![freestanding] mode (it lowers to a libc/libm call with no freestanding implementation)")
    }
    # Stage 16 (v0.27.0-alpha): spawn(f, a1, ..., aN) — the FIRST argument
    # is a function NAME (identifier), not a value. It must be handled
    # BEFORE the generic argument-evaluation loop below (which would try
    # to resolve it as a variable and fail).
    if name == "spawn" {
        return check_spawn_call(ctx, env, cur, e)
    }
    # Stage 33 (v0.52.0-alpha): async_spawn(f, args...) — like spawn, but
    # returns Future[R] instead of Task[R].
    if name == "async_spawn" {
        return check_async_spawn_call(ctx, env, cur, e)
    }
    # Stage 34 (v0.53.0-alpha): gen_spawn(f, args...) -> Stream[T] —
    # the target takes the Stream as its first param.
    if name == "gen_spawn" {
        return check_gen_spawn_call(ctx, env, cur, e, expected)
    }
    # Stage 34: stream_map_int / stream_filter_int / stream_fold_int /
    # stream_flat_map_int — each takes a Stream + a function name.
    if name == "stream_map_int" || name == "stream_filter_int"
    || name == "stream_fold_int" || name == "stream_flat_map_int" {
        return check_stream_combinator_call(ctx, env, cur, e, name, expected)
    }
    # Stage 21 (v0.37.0-alpha): has_feature("avx2") -> bool — a
    # compile-time constant (const-folded by the codegen from the
    # --target-feature flag), so the argument must be a STRING LITERAL.
    # Pure (no effects). Mirrors cfg(feature) dispatch.
    if name == "has_feature" {
        if ctx.exprs[e].args.len() != 1 {
            cerr(line, "has_feature() expects 1 argument (a feature name)")
        }
        if ctx.exprs[ctx.exprs[e].args.get(0)].kind != "str" {
            cerr(line, "has_feature() expects a string literal (it is a compile-time constant)")
        }
        check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "str")
        return "bool"
    }
    # Stage 21: simd_cpu_supports("avx2") -> bool — a runtime CPU probe
    # (CPUID on x86; NEON compile-time check on aarch64). Pure.
    if name == "simd_cpu_supports" {
        if ctx.exprs[e].args.len() != 1 {
            cerr(line, "simd_cpu_supports() expects 1 argument (a feature name)")
        }
        check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "str")
        return "bool"
    }
    # Stage 19 (v0.35.0-alpha): join(list[str], sep) -> str — pure, O(n).
    # Handled BEFORE the generic argument-evaluation loop so an empty
    # list literal `[]` infers list[str] from the expected type.
    if name == "join" {
        if ctx.exprs[e].args.len() != 2 {
            cerr(line, "join() expects 2 arguments (list[str], str)")
        }
        let at0: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "list[str]")
        if !is_list_t(at0) || list_elem_t(at0) != "str" {
            cerr(line, "join() expects a list[str] as argument 1, got " + at0)
        }
        let at1: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(1), "str")
        if at1 != "str" {
            cerr(line, "join() expects a str separator as argument 2, got " + at1)
        }
        if at0 == "never" || at1 == "never" {
            cerr(line, "never value cannot be used as an argument")
        }
        return "str"
    }
    # Stage 32 (v0.51.0-alpha): native bitwise builtins. Each takes
    # int arguments and returns int; the shift count is masked to 6
    # bits (0..63) at runtime to match C's UB-free behaviour.
    if name == "int_and" || name == "int_or" || name == "int_xor" {
        if ctx.exprs[e].args.len() != 2 {
            cerr(line, name + "() expects 2 int arguments")
        }
        let a0: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "int")
        let a1: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(1), "int")
        if a0 != "int" {
            cerr(line, name + "() expects int as argument 1, got " + a0)
        }
        if a1 != "int" {
            cerr(line, name + "() expects int as argument 2, got " + a1)
        }
        if a0 == "never" || a1 == "never" {
            cerr(line, "never value cannot be used as an argument")
        }
        return "int"
    }
    if name == "int_not" {
        if ctx.exprs[e].args.len() != 1 {
            cerr(line, "int_not() expects 1 int argument")
        }
        let a0n: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "int")
        if a0n != "int" {
            cerr(line, "int_not() expects int, got " + a0n)
        }
        if a0n == "never" {
            cerr(line, "never value cannot be used as an argument")
        }
        return "int"
    }
    if name == "int_shl" || name == "int_shr" || name == "int_sar" {
        if ctx.exprs[e].args.len() != 2 {
            cerr(line, name + "() expects 2 int arguments (value, shift)")
        }
        let a0s: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "int")
        let a1s: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(1), "int")
        if a0s != "int" {
            cerr(line, name + "() expects int value as argument 1, got " + a0s)
        }
        if a1s != "int" {
            cerr(line, name + "() expects int shift count as argument 2, got " + a1s)
        }
        if a0s == "never" || a1s == "never" {
            cerr(line, "never value cannot be used as an argument")
        }
        return "int"
    }
    if name == "int_popcount" || name == "int_clz" || name == "int_ctz" {
        if ctx.exprs[e].args.len() != 1 {
            cerr(line, name + "() expects 1 int argument")
        }
        let a0p: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "int")
        if a0p != "int" {
            cerr(line, name + "() expects int, got " + a0p)
        }
        if a0p == "never" {
            cerr(line, "never value cannot be used as an argument")
        }
        return "int"
    }
    let nargs: int = ctx.exprs[e].args.len()
    let argt: list[str] = []
    let mut i: int = 0
    while i < nargs {
        argt.push(check_expr(ctx, env, cur, ctx.exprs[e].args.get(i), ""))
        i = i + 1
    }
    let mut j: int = 0
    while j < nargs {
        if argt.get(j) == "never" {
            cerr(line, "never value cannot be used as an argument")
        }
        j = j + 1
    }
    # Stage 10-alpha: taint-sink enforcement.
    # Reject tainted[T] at sink argument positions; user must explicitly
    # untaint via taint_unwrap or a sanitizer (sanitize_html etc.).
    # Stage 56 (v0.75.0-alpha): eprint / eprintln are sinks for the
    # same reason print / println are — a tainted message written to
    # the terminal lets an attacker inject ANSI escape sequences
    # (terminal spoofing / title reprogramming / clipboard theft on
    # some terminals). isatty takes an int fd (not a sink — the fd is
    # a program-controlled constant, never attacker data; passing a
    # tainted int would leak nothing anyway since the result only
    # reveals whether the program's OWN descriptor is a terminal).
    if name == "print" || name == "println" || name == "eprint" || name == "eprintln" {
        # Deep-scan fix: check argument count BEFORE the taint check so
        # `print()` (zero args) gives a clean error message instead of
        # crashing on argt.get(0) out-of-bounds.
        if nargs != 1 {
            cerr(line, name + " expects 1 str argument")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: " + name + " argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink — use sanitize_html / sanitize_path / sanitize_sql_identifier / sanitize_sql_string / sanitize_command / sanitize_filename from std.sanitize, or taint_unwrap() if you accept the risk)")
        }
    }
    if name == "exit" {
        if nargs != 1 {
            cerr(line, "exit expects 1 int argument")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: exit argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink)")
        }
    }
    if name == "read_file" || name == "file_exists" || name == "read_file_tainted" {
        if nargs != 1 {
            cerr(line, name + "() expects 1 str argument")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: " + name + " argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink — use sanitize_path from std.sanitize, or taint_unwrap() if you accept the risk)")
        }
    }
    # Stage 36 (v0.55.0-alpha): fs_read_dir / fs_size / fs_is_dir all
    # take a single str path that must not be tainted (path-traversal /
    # information-disclosure sink). fs_set_perms takes a path + a
    # POSIX mode int (the mode is not a sink — only the path is).
    if name == "fs_read_dir" || name == "fs_size" || name == "fs_is_dir" {
        if nargs != 1 {
            cerr(line, name + "() expects 1 str argument")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: " + name + " argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink — use sanitize_path from std.sanitize, or taint_unwrap() if you accept the risk)")
        }
    }
    if name == "fs_set_perms" {
        if nargs != 2 {
            cerr(line, "fs_set_perms() expects 2 arguments: str path, int mode")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: fs_set_perms argument 1 (path) is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink — a tainted path would chmod an attacker-chosen file)")
        }
    }
    if name == "write_file" {
        if nargs != 2 {
            cerr(line, "write_file() expects 2 str arguments")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: write_file argument 1 (path) is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink)")
        }
        if is_taint_t(argt.get(1)) {
            cerr(line, "taint-sink violation: write_file argument 2 (content) is " + argt.get(1) + " (tainted values must be sanitised before reaching a sink)")
        }
    }
    if name == "print" || name == "println" || name == "eprint" || name == "eprintln" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, name + " expects 1 str argument")
        }
        # Edge name reflects the ACTUAL builtin (b:print / b:eprint / ...)
        # so the --audit output lists which stream family was written.
        # builtin_effect resolves all four to ["IO"].
        add_edge(ctx, cur, "b:" + name)
        return "void"
    }
    # Stage 56 (v0.75.0-alpha): isatty(fd: int) -> bool — true when the
    # file descriptor refers to a terminal. Carries IO (a stream-state
    # observation). 0 = stdin, 1 = stdout, 2 = stderr (the POSIX fd
    # convention); other descriptors work too (whatever the process
    # opened). Negative fds are simply not terminals (isatty(2) in C
    # returns 0 for EBADF — no panic, no UB).
    if name == "isatty" {
        if nargs != 1 || argt.get(0) != "int" {
            cerr(line, "isatty expects 1 int argument (the file descriptor: 0 = stdin, 1 = stdout, 2 = stderr)")
        }
        add_edge(ctx, cur, "b:isatty")
        return "bool"
    }
    # Stage 57 (v0.76.0-alpha): process-identity builtins (no args).
    # proc_pid() -> int — the OS process id (syslog TAG[PID]).
    # sys_hostname() -> str — the host name (syslog HOSTNAME).
    if name == "proc_pid" {
        if nargs != 0 {
            cerr(line, "proc_pid() takes no arguments")
        }
        add_edge(ctx, cur, "b:proc_pid")
        return "int"
    }
    if name == "sys_hostname" {
        if nargs != 0 {
            cerr(line, "sys_hostname() takes no arguments")
        }
        add_edge(ctx, cur, "b:sys_hostname")
        return "str"
    }
    if name == "panic" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "panic expects 1 str argument")
        }
        return "never"
    }
    if name == "exit" {
        if nargs != 1 || argt.get(0) != "int" {
            cerr(line, "exit expects 1 int argument")
        }
        add_edge(ctx, cur, "b:exit")
        return "never"
    }
    if name == "str" {
        if nargs != 1 {
            cerr(line, "str() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if a0 != "int" && a0 != "float" && a0 != "bool" && a0 != "str" {
            cerr(line, "str() does not support type " + a0)
        }
        # Stage 77: str(float) needs snprintf %.6f (no freestanding
        # implementation).
        if a0 == "float" && ctx.crate_freestanding {
            cerr(line, "str(float) is not available in #![freestanding] mode (it lowers to a libc/libm call with no freestanding implementation)")
        }
        return "str"
    }
    if name == "int" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "int() expects 1 str argument")
        }
        return "int"
    }
    if name == "len" {
        if nargs != 1 {
            cerr(line, "len() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if a0 != "str" && !is_list_t(a0) && !is_map_t(a0) {
            cerr(line, "len() does not support type " + a0)
        }
        return "int"
    }
    if name == "range" {
        if nargs != 2 || argt.get(0) != "int" || argt.get(1) != "int" {
            cerr(line, "range() expects 2 int arguments")
        }
        return "list[int]"
    }
    if name == "map_new" {
        if nargs != 0 {
            cerr(line, "map_new() takes no arguments")
        }
        if expected == "" || !is_map_t(expected) {
            cerr(line, "map_new() requires a 'map[str, T]' type in the surrounding context")
        }
        return expected
    }
    if name == "read_file" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "read_file() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:read_file")
        return "str"
    }
    # Stage 10-beta: read_file_tainted(path) — same as read_file but the
    # returned str is wrapped as tainted[str]. Second taint source after
    # tainted_args; covers user-controlled content read from a file.
    if name == "read_file_tainted" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "read_file_tainted() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:read_file_tainted")
        return "tainted[str]"
    }
    # Stage 10 release: read_line() -> tainted[str] — third taint source.
    # Reads a single line from stdin (newline stripped); the result is
    # always tainted because stdin is untrusted input. Carries the IO
    # effect (same family as print/println).
    if name == "read_line" {
        if nargs != 0 {
            cerr(line, "read_line() takes no arguments")
        }
        add_edge(ctx, cur, "b:read_line")
        return "tainted[str]"
    }
    if name == "write_file" {
        if nargs != 2 || argt.get(0) != "str" || argt.get(1) != "str" {
            cerr(line, "write_file() expects 2 str arguments")
        }
        add_edge(ctx, cur, "b:write_file")
        return "void"
    }
    if name == "args" {
        if nargs != 0 {
            cerr(line, "args() takes no arguments")
        }
        add_edge(ctx, cur, "b:args")
        return "list[str]"
    }
    # Stage 10-alpha: tainted_args — like args() but each element is
    # wrapped as tainted[str] (defined in std/taint.hls).
    if name == "tainted_args" {
        if nargs != 0 {
            cerr(line, "tainted_args() takes no arguments")
        }
        add_edge(ctx, cur, "b:tainted_args")
        return "list[tainted[str]]"
    }
    # Stage 10-alpha: taint_mark / taint_unwrap — generic wrap / unwrap.
    if name == "taint_mark" {
        if nargs != 1 {
            cerr(line, "taint_mark() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if a0 == "void" {
            cerr(line, "taint_mark() does not support void")
        }
        return "tainted[" + a0 + "]"
    }
    if name == "taint_unwrap" {
        if nargs != 1 {
            cerr(line, "taint_unwrap() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if !is_taint_t(a0) {
            cerr(line, "taint_unwrap() expects a tainted[T] value, got " + a0)
        }
        return taint_inner_t(a0)
    }
    if name == "clock_ms" {
        if nargs != 0 {
            cerr(line, "clock_ms() takes no arguments")
        }
        add_edge(ctx, cur, "b:clock_ms")
        return "int"
    }
    # Stage 46 (v0.65.0-alpha): thread / scheduling builtins.
    # thread_sleep_ms(ms: int) -> void — blocks the calling thread.
    # The ms argument must be a non-negative int (literal negative
    # values are compile errors; dynamic negative values panic at
    # runtime).
    if name == "thread_sleep_ms" {
        if nargs != 1 || argt.get(0) != "int" {
            cerr(line, "thread_sleep_ms() expects 1 int argument (ms)")
        }
        if ctx.exprs[ctx.exprs[e].args.get(0)].kind == "int"
        && ctx.exprs[ctx.exprs[e].args.get(0)].ival < 0 {
            cerr(line, "thread_sleep_ms() duration must be >= 0 (literal negative)")
        }
        add_edge(ctx, cur, "b:thread_sleep_ms")
        return "void"
    }
    # thread_yield() -> void — hint the scheduler to switch.
    if name == "thread_yield" {
        if nargs != 0 {
            cerr(line, "thread_yield() takes no arguments")
        }
        add_edge(ctx, cur, "b:thread_yield")
        return "void"
    }
    # thread_current_id() -> int — non-zero thread identifier.
    if name == "thread_current_id" {
        if nargs != 0 {
            cerr(line, "thread_current_id() takes no arguments")
        }
        add_edge(ctx, cur, "b:thread_current_id")
        return "int"
    }
    if name == "chr" {
        if nargs != 1 || argt.get(0) != "int" {
            cerr(line, "chr() expects 1 int argument")
        }
        return "str"
    }
    if name == "file_exists" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "file_exists() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:file_exists")
        return "bool"
    }
    # ----- Stage 36 (v0.55.0-alpha): filesystem metadata builtins -----
    if name == "fs_read_dir" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "fs_read_dir() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:fs_read_dir")
        return "list[str]"
    }
    if name == "fs_size" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "fs_size() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:fs_size")
        return "int"
    }
    if name == "fs_is_dir" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "fs_is_dir() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:fs_is_dir")
        return "bool"
    }
    if name == "fs_set_perms" {
        if nargs != 2 || argt.get(0) != "str" || argt.get(1) != "int" {
            cerr(line, "fs_set_perms() expects (str path, int mode)")
        }
        add_edge(ctx, cur, "b:fs_set_perms")
        return "void"
    }
    # ----- Stage 8-alpha: ownership primitives (drop / clone / take) -----
    if name == "drop" {
        if nargs != 1 {
            cerr(line, "drop() expects 1 argument")
        }
        if ctx.loop_header > 0 {
            cerr(line, "drop() cannot be used inside a loop condition or iterable (the binding would be moved on every iteration)")
        }
        let at: str = argt.get(0)
        if !is_owned_type(at) {
            cerr(line, "drop() requires an owned (heap) type, got " + at)
        }
        # Argument must be a plain identifier so we can mark its binding.
        let arg_idx: int = ctx.exprs[e].args.get(0)
        if ctx.exprs[arg_idx].kind != "ident" {
            cerr(line, "drop() requires a variable name (not an expression)")
        }
        let arg_name: str = ctx.exprs[arg_idx].name
        if !mark_moved(env, arg_name) {
            cerr(line, "drop() argument is not a binding: " + arg_name)
        }
        return "void"
    }
    if name == "clone" {
        if nargs != 1 {
            cerr(line, "clone() expects 1 argument")
        }
        let at2: str = argt.get(0)
        if !is_owned_type(at2) {
            cerr(line, "clone() requires an owned (heap) type, got " + at2)
        }
        # Stage 16: struct-aware clone support — a Task handle (or any
        # composite containing one) cannot be cloned; a Chan clones by
        # SHARING (atomic refcount + 1).
        if !clone_supported(ctx, at2, []) {
