        if nargs != 5 || argt.get(0) != "str" || argt.get(1) != "list[str]"
        || argt.get(2) != "int" || argt.get(3) != "int"
        || argt.get(4) != "int" {
            cerr(line, "proc_spawn() expects (str program, list[str] args, int stdin_kind, int stdout_kind, int stderr_kind)")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: proc_spawn argument 1 (program) is " + argt.get(0) + " (a tainted program enables command injection — use sanitize_command from std.sanitize, or taint_unwrap() if you accept the risk)")
        }
        # Validate stdio kind literals at compile time (0/1/2).
        let mut k_idx: int = 2
        while k_idx <= 4 {
            let arg_e: int = ctx.exprs[e].args.get(k_idx)
            if ctx.exprs[arg_e].kind == "int"
            && (ctx.exprs[arg_e].ival < 0 || ctx.exprs[arg_e].ival > 2) {
                cerr(line, "proc_spawn() stdio kind (arg " + (k_idx + 1).to_str() + ") must be 0 (Inherit), 1 (Pipe), or 2 (Null), got literal " + ctx.exprs[arg_e].ival.to_str())
            }
            k_idx = k_idx + 1
        }
        add_edge(ctx, cur, "b:proc_spawn")
        return "int"
