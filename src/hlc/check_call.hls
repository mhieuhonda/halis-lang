    # ----- Stage 47 (v0.66.0-alpha): process management builtins -----
    # proc_spawn(program: str, args: list[str], stdin_kind: int,
    #            stdout_kind: int, stderr_kind: int) -> int.
    # Returns the child pid (>= 1) or -1 on failure. The program
    # argument is a taint sink (command injection — same threat as
    # proc_exec). The args list elements are NOT sink-checked (they
    # are passed as argv[1..] without shell interpretation). The
    # stdio kinds are 0=Inherit, 1=Pipe, 2=Null.
