        let at3: str = argt.get(0)
        if !is_owned_type(at3) {
            cerr(line, "take() requires an owned (heap) type, got " + at3)
        }
        # Stage 8-beta: a move inside a while/for condition or iterable
        # would re-execute on every iteration (the binding is nulled in
        # generated code after the first pass) — reject it up front.
        if ctx.loop_header > 0 {
            cerr(line, "take() cannot be used inside a loop condition or iterable (the binding would be moved on every iteration)")
        }
        let arg_idx3: int = ctx.exprs[e].args.get(0)
        if ctx.exprs[arg_idx3].kind != "ident" {
            cerr(line, "take() requires a variable name (not an expression)")
        }
        let arg_name3: str = ctx.exprs[arg_idx3].name
        if !mark_moved(env, arg_name3) {
            cerr(line, "take() argument is not a binding: " + arg_name3)
        }
        return at3
    }
    # ----- Stage 9 release (v0.20.0-alpha): Net / Rand / Proc builtins -----
