    }
    # future_poll(fut: Future[T]) -> Option[T]
    if name == "future_poll" {
        if nargs != 1 {
            cerr(line, "future_poll() expects 1 Future[T] argument")
        }
        let a0: str = argt.get(0)
        if !is_future_t(a0) {
            cerr(line, "future_poll() expects a Future[T], got " + a0)
        }
        # Deep-scan-25 fix (parity with the boot checker): the runtime
        # hard-codes the built-in Option shape (Some/None), so a
        # user-defined enum Option with a different shape would check
        # clean and then never match at runtime. Validate the shape
        # whenever an Option enum exists.
        if ctx.enums.has("Option") {
            let odef: EnumInfo = ctx.enums.get_or("Option", dummy_enum())
            let mut has_some: bool = false
            let mut has_none: bool = false
            let mut vi: int = 0
            while vi < odef.variants.len() {
                let vn: str = odef.variants.get(vi)
                let pl: list[str] = odef.payloads.get(vi)
                if vn == "Some" && pl.len() == 1 {
                    has_some = true
                }
                if vn == "None" && pl.len() == 0 {
                    has_none = true
                }
                vi = vi + 1
            }
            if !(has_some && has_none) || odef.variants.len() != 2 {
                cerr(line, "future_poll() requires the built-in Option shape 'enum Option[T] { None, Some(T) }' — the program's Option enum does not match it")
            }
        }
        add_edge(ctx, cur, "b:future_poll")
        return "Option[" + future_inner_t(a0) + "]"
    }
    # future_select(futs: list[Future[T]]) -> int
    if name == "future_select" {
        if nargs != 1 {
            cerr(line, "future_select() expects 1 list[Future[T]] argument")
        }
        let a0: str = argt.get(0)
        if !is_list_t(a0) || !is_future_t(list_elem_t(a0)) {
            cerr(line, "future_select() expects a list[Future[T]], got " + a0)
        }
        add_edge(ctx, cur, "b:future_select")
        return "int"
    }
    # ----- Stage 34 (v0.53.0-alpha): async stream builtins -----
    # stream_new(cap: int) -> Stream[T] — contextual typing.
    if name == "stream_new" {
        if nargs != 1 {
            cerr(line, "stream_new() expects 1 int argument")
        }
        let a0: str = argt.get(0)
        if a0 != "never" && a0 != "int" {
            cerr(line, "stream_new() capacity expects int, got " + a0)
        }
        if expected == "" || !is_stream_t(expected) {
            cerr(line, "stream_new() requires a 'Stream[T]' type in the surrounding context")
        }
        if !type_is_send(ctx, stream_inner_t(expected), []) {
            cerr(line, "stream_new() element type " + stream_inner_t(expected) + " is not Send")
        }
        add_edge(ctx, cur, "b:stream_new")
        return expected
    }
    # stream_send(s: Stream[T], v: T) -> void
    if name == "stream_send" {
        if nargs != 2 {
            cerr(line, "stream_send() expects 2 arguments")
        }
        let a0: str = argt.get(0)
        if !is_stream_t(a0) {
            cerr(line, "stream_send() argument 1 expects Stream[T], got " + a0)
        }
        let et: str = stream_inner_t(a0)
        let a1: str = argt.get(1)
        if a1 != "never" && a1 != et {
            cerr(line, "stream_send() argument 2 expects " + et + ", got " + a1)
        }
        if !type_is_send(ctx, et, []) {
            cerr(line, "type " + et + " is not Send: stream values cross a task boundary")
        }
        # Deep-scan-25 fix (parity with the boot checker): reject bare
        # ident/field/index reads of owned element types — the same
        # channel-send data-race rule chan.send enforces (the runtime
        # deep-copies borrowed composites, but the syntactic rule gives
        # the user a compile-time guarantee instead of a silent copy).
        let vidx: int = ctx.exprs[e].args.get(1)
        let vkind: str = ctx.exprs[vidx].kind
        if is_owned_type(et) && (vkind == "ident" || vkind == "field" || vkind == "index") {
            let mut what: str = "a borrowed value"
            if vkind == "ident" {
                what = "variable '" + ctx.exprs[vidx].name + "'"
            }
            cerr(line, "cannot share " + what + " across tasks: stream_send() reads it directly — pass clone(x) or take(x)")
        }
        add_edge(ctx, cur, "b:stream_send")
        return "void"
    }
    # stream_recv(s: Stream[T]) -> T
    if name == "stream_recv" {
        if nargs != 1 {
            cerr(line, "stream_recv() expects 1 Stream[T] argument")
        }
        let a0: str = argt.get(0)
        if !is_stream_t(a0) {
            cerr(line, "stream_recv() expects Stream[T], got " + a0)
        }
        add_edge(ctx, cur, "b:stream_recv")
        return stream_inner_t(a0)
    }
    # stream_try_recv(s: Stream[T], default: T) -> T
    if name == "stream_try_recv" {
        if nargs != 2 {
            cerr(line, "stream_try_recv() expects 2 arguments")
        }
        let a0: str = argt.get(0)
        if !is_stream_t(a0) {
            cerr(line, "stream_try_recv() argument 1 expects Stream[T], got " + a0)
        }
        let et: str = stream_inner_t(a0)
        let a1: str = argt.get(1)
        if a1 != "never" && a1 != et {
            cerr(line, "stream_try_recv() argument 2 expects " + et + ", got " + a1)
        }
        add_edge(ctx, cur, "b:stream_try_recv")
        return et
    }
    # stream_len(s: Stream[T]) -> int
    if name == "stream_len" {
        if nargs != 1 {
            cerr(line, "stream_len() expects 1 Stream[T] argument")
        }
        let a0: str = argt.get(0)
        if !is_stream_t(a0) {
            cerr(line, "stream_len() expects Stream[T], got " + a0)
        }
        add_edge(ctx, cur, "b:stream_len")
        return "int"
    }
    # stream_close(s: Stream[T]) -> void
    if name == "stream_close" {
        if nargs != 1 {
            cerr(line, "stream_close() expects 1 Stream[T] argument")
        }
        let a0: str = argt.get(0)
        if !is_stream_t(a0) {
            cerr(line, "stream_close() expects Stream[T], got " + a0)
        }
        # Deep-scan-25 fix (parity with the boot checker): the builtin
        # sends the INT64_MIN sentinel in BOTH backends, so non-int
        # streams would type-confuse on recv. Non-int producers send
        # their own sentinel via stream_send.
        if is_stream_t(a0) && stream_inner_t(a0) != "int" {
            cerr(line, "stream_close() only supports Stream[int] (it sends the INT64_MIN sentinel); for Stream[" + stream_inner_t(a0) + "] send your own end-of-stream value via stream_send instead")
        }
        add_edge(ctx, cur, "b:stream_close")
        return "void"
    }
    # stream_take_int(in_s: Stream[int], n: int) -> Stream[int]
    if name == "stream_take_int" {
        if nargs != 2 {
            cerr(line, "stream_take_int() expects 2 arguments")
        }
        let a0: str = argt.get(0)
        if !is_stream_t(a0) || stream_inner_t(a0) != "int" {
            cerr(line, "stream_take_int() argument 1 expects Stream[int], got " + a0)
        }
        let a1: str = argt.get(1)
        if a1 != "never" && a1 != "int" {
            cerr(line, "stream_take_int() argument 2 expects int, got " + a1)
        }
        if expected == "" || !is_stream_t(expected) || stream_inner_t(expected) != "int" {
            cerr(line, "stream_take_int() requires a 'Stream[int]' type in the surrounding context")
        }
        add_edge(ctx, cur, "b:stream_take_int")
        return expected
    }
    # stream_merge_int(a, b) -> Stream[int]
    if name == "stream_merge_int" {
        if nargs != 2 {
            cerr(line, "stream_merge_int() expects 2 arguments")
        }
        let a0: str = argt.get(0)
        let a1: str = argt.get(1)
        if !is_stream_t(a0) || stream_inner_t(a0) != "int" {
            cerr(line, "stream_merge_int() argument 1 expects Stream[int], got " + a0)
        }
        if !is_stream_t(a1) || stream_inner_t(a1) != "int" {
            cerr(line, "stream_merge_int() argument 2 expects Stream[int], got " + a1)
        }
        if expected == "" || !is_stream_t(expected) || stream_inner_t(expected) != "int" {
            cerr(line, "stream_merge_int() requires a 'Stream[int]' type in the surrounding context")
        }
        add_edge(ctx, cur, "b:stream_merge_int")
        return expected
    }
    cerr(line, "unknown builtin function: " + name)
    return ""
}

# Stage 33 (v0.52.0-alpha): check_async_spawn_call — mirrors
# check_spawn_call but returns Future[R] instead of Task[R]. The target
# function must NOT return void (a future carries a value).
fn check_async_spawn_call(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int) -> str {
    let mut line: int = ctx.exprs[e].line
    let nargs: int = ctx.exprs[e].args.len()
    if nargs < 1 {
        cerr(line, "async_spawn() expects a function name followed by its arguments")
    }
    let fn_arg: int = ctx.exprs[e].args.get(0)
    if ctx.exprs[fn_arg].kind != "ident" {
        cerr(line, "async_spawn() argument 1 must be a function name (an identifier)")
    }
    let fname: str = ctx.exprs[fn_arg].name
    if is_builtin_fn(fname) {
        cerr(line, "async_spawn() target cannot be a builtin function: " + fname)
    }
    if !ctx.fns.has(fname) {
        cerr(line, "async_spawn() target function does not exist: " + fname)
    }
    let tf: FnInfo = ctx.fns.get_or(fname, dummy_fn())
    if tf.is_method {
        cerr(line, "async_spawn() target cannot be a method: " + fname)
    }
    if tf.typeparams.len() > 0 {
        cerr(line, "async_spawn() of generic functions is not supported yet: " + fname)
    }
    if tf.is_extern {
        cerr(line, "async_spawn() of extern (FFI) functions is not supported")
    }
    if tf.ret == "void" {
        cerr(line, "async_spawn() target " + fname + " returns void — a Future must carry a value (use plain spawn() for void tasks)")
    }
    let vargs: list[int] = []
    let mut si: int = 1
    while si < ctx.exprs[e].args.len() {
        vargs.push(ctx.exprs[e].args.get(si))
        si = si + 1
    }
    if vargs.len() != tf.params.len() {
        cerr(line, "async_spawn() target " + fname + " expects " + tf.params.len().to_str() + " arguments, got " + vargs.len().to_str())
    }
    let mut i: int = 0
    while i < vargs.len() {
        let aidx: int = vargs.get(i)
        let pt: str = tf.ptypes.get(i)
        let at: str = check_expr(ctx, env, cur, aidx, pt)
        if at != "never" && at != pt {
            cerr(line, "async_spawn() argument '" + tf.params.get(i) + "' of " + fname + " expects " + pt + ", got " + at)
        }
        if !type_is_send(ctx, pt, []) {
            cerr(line, "type " + pt + " is not Send: values of this type cannot cross a task boundary (async_spawn)")
        }
        if is_owned_type(pt) {
            let akind: str = ctx.exprs[aidx].kind
            if akind == "ident" || akind == "field" || akind == "index" {
                let mut what: str = "a borrowed value"
                if akind == "ident" {
                    what = "variable '" + ctx.exprs[aidx].name + "'"
                }
                cerr(line, "cannot share " + what + " across tasks: async_spawn() argument " + (i + 2).to_str() + " reads it directly — pass clone(x) or take(x)")
            }
        }
        i = i + 1
    }
    add_edge(ctx, cur, "b:async_spawn")
    # Deep-scan-20 soundness fix: same rule as spawn — the future's
    # result value crosses the task boundary at await(), so the return
    # type must be Send. Mirror of the boot/checker.py fix.
    if !type_is_send(ctx, tf.ret, []) {
        cerr(line, "async_spawn() target " + fname + " returns " + tf.ret + ", which is not Send: the result crosses the task boundary at await()")
    }
    add_edge(ctx, cur, fname)
    ctx.exprs[e].args = vargs
    ctx.exprs[e].mkey = "async_spawn"
    ctx.exprs[e].mop = fname
    return "Future[" + tf.ret + "]"
}

# Stage 34 (v0.53.0-alpha): check_gen_spawn_call — gen_spawn(f, args...)
# -> Stream[T]. The target function must take Stream[T] as its FIRST
# parameter (the generator writes into this stream).
fn check_gen_spawn_call(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let mut line: int = ctx.exprs[e].line
    let nargs: int = ctx.exprs[e].args.len()
    if nargs < 1 {
        cerr(line, "gen_spawn() expects a function name followed by its arguments")
    }
    let fn_arg: int = ctx.exprs[e].args.get(0)
    if ctx.exprs[fn_arg].kind != "ident" {
        cerr(line, "gen_spawn() argument 1 must be a function name (an identifier)")
    }
    let fname: str = ctx.exprs[fn_arg].name
    if is_builtin_fn(fname) {
        cerr(line, "gen_spawn() target cannot be a builtin function: " + fname)
    }
    if !ctx.fns.has(fname) {
        cerr(line, "gen_spawn() target function does not exist: " + fname)
    }
    let tf: FnInfo = ctx.fns.get_or(fname, dummy_fn())
    if tf.is_method || tf.typeparams.len() > 0 || tf.is_extern {
        cerr(line, "gen_spawn() target must be a non-generic, non-extern free function: " + fname)
    }
    if expected == "" || !is_stream_t(expected) {
        cerr(line, "gen_spawn() requires a 'Stream[T]' type in the surrounding context")
    }
    let stream_t: str = expected
    if tf.params.len() < 1 || tf.ptypes.get(0) != stream_t {
        cerr(line, "gen_spawn() target " + fname + " must take " + stream_t + " as its first parameter (the generator writes into this stream)")
    }
    let vargs: list[int] = []
    let mut si: int = 1
    while si < ctx.exprs[e].args.len() {
        vargs.push(ctx.exprs[e].args.get(si))
        si = si + 1
    }
    if vargs.len() != tf.params.len() - 1 {
        cerr(line, "gen_spawn() target " + fname + " expects " + (tf.params.len() - 1).to_str() + " arguments after the stream, got " + vargs.len().to_str())
    }
    let mut i: int = 0
    while i < vargs.len() {
        let aidx: int = vargs.get(i)
        let pt: str = tf.ptypes.get(i + 1)
        let at: str = check_expr(ctx, env, cur, aidx, pt)
        if at != "never" && at != pt {
            cerr(line, "gen_spawn() argument '" + tf.params.get(i + 1) + "' of " + fname + " expects " + pt + ", got " + at)
        }
        if !type_is_send(ctx, pt, []) {
            cerr(line, "type " + pt + " is not Send: gen_spawn() arguments cross a task boundary")
        }
        if is_owned_type(pt) {
            let akind: str = ctx.exprs[aidx].kind
            if akind == "ident" || akind == "field" || akind == "index" {
                let mut what: str = "a borrowed value"
                if akind == "ident" {
                    what = "variable '" + ctx.exprs[aidx].name + "'"
                }
                cerr(line, "cannot share " + what + " across tasks: gen_spawn() argument " + (i + 2).to_str() + " reads it directly — pass clone(x) or take(x)")
            }
        }
        i = i + 1
    }
    add_edge(ctx, cur, "b:gen_spawn")
    add_edge(ctx, cur, fname)
    ctx.exprs[e].args = vargs
    ctx.exprs[e].mkey = "gen_spawn"
    ctx.exprs[e].mop = fname
    return expected
}

# Stage 34: check_stream_combinator_call — stream_map_int /
# stream_filter_int / stream_fold_int / stream_flat_map_int.
# Each takes a Stream[int] and a function name (the fn-name is
# recorded in mop via the rewrite; the args list keeps only the
# stream arg, plus the init value for fold).
fn check_stream_combinator_call(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, name: str, expected: str) -> str {
    let mut line: int = ctx.exprs[e].line
    let nargs: int = ctx.exprs[e].args.len()
    # Determine argument layout: map/filter/flat_map take (stream, fn_name);
    # fold takes (stream, init, fn_name).
    let fold_p: bool = name == "stream_fold_int"
    if fold_p {
        if nargs != 3 {
            cerr(line, name + "() expects 3 arguments (stream, init, fn_name)")
        }
    } else {
        if nargs != 2 {
            cerr(line, name + "() expects 2 arguments (stream, fn_name)")
        }
    }
    # Check the stream argument.
    let stream_arg: int = ctx.exprs[e].args.get(0)
    let st: str = check_expr(ctx, env, cur, stream_arg, "")
    if !is_stream_t(st) || stream_inner_t(st) != "int" {
        cerr(line, name + "() argument 1 expects Stream[int], got " + st)
    }
    # For fold, check the init argument.
    let mut init_arg: int = -1
    if fold_p {
        init_arg = ctx.exprs[e].args.get(1)
        let it: str = check_expr(ctx, env, cur, init_arg, "int")
        if it != "never" && it != "int" {
            cerr(line, "stream_fold_int() argument 2 expects int, got " + it)
        }
    }
    # Check the function-name argument (index 1 for map/filter/flat_map,
    # index 2 for fold).
    let mut fn_arg_idx: int = 1
    if fold_p {
        fn_arg_idx = 2
    }
    let fn_arg: int = ctx.exprs[e].args.get(fn_arg_idx)
    if ctx.exprs[fn_arg].kind != "ident" {
        cerr(line, name + "() argument " + (fn_arg_idx + 1).to_str() + " must be a function name (an identifier)")
    }
    let fname: str = ctx.exprs[fn_arg].name
    if is_builtin_fn(fname) {
        cerr(line, name + "() target cannot be a builtin function: " + fname)
    }
    if !ctx.fns.has(fname) {
        cerr(line, name + "() target function does not exist: " + fname)
    }
    let tf: FnInfo = ctx.fns.get_or(fname, dummy_fn())
    if tf.is_method || tf.typeparams.len() > 0 || tf.is_extern {
        cerr(line, name + "() target must be a non-generic, non-extern free function: " + fname)
    }
    # Validate the target's signature.
    if name == "stream_map_int" || name == "stream_filter_int" {
        if tf.params.len() != 1 || tf.ptypes.get(0) != "int" || tf.ret != "int" {
            cerr(line, name + "() target " + fname + " must have signature fn(int) -> int")
        }
    } else if name == "stream_fold_int" {
        if tf.params.len() != 2 || tf.ptypes.get(0) != "int" || tf.ptypes.get(1) != "int" || tf.ret != "int" {
            cerr(line, "stream_fold_int() target " + fname + " must have signature fn(int, int) -> int")
        }
    } else if name == "stream_flat_map_int" {
        if tf.params.len() != 1 || tf.ptypes.get(0) != "int" || tf.ret != "Stream[int]" {
            cerr(line, "stream_flat_map_int() target " + fname + " must have signature fn(int) -> Stream[int]")
        }
    }
    # For non-fold combinators, validate the expected return type.
    if !fold_p {
        if expected == "" || !is_stream_t(expected) || stream_inner_t(expected) != "int" {
            cerr(line, name + "() requires a 'Stream[int]' type in the surrounding context")
        }
    }
    add_edge(ctx, cur, "b:" + name)
    add_edge(ctx, cur, fname)
    # Rewrite: drop the fn-name argument, record the target.
    let new_args: list[int] = [stream_arg]
    if fold_p {
        new_args.push(init_arg)
    }
    ctx.exprs[e].args = new_args
    ctx.exprs[e].mkey = name
    ctx.exprs[e].mop = fname
    if fold_p {
        return "int"
    }
    return expected
}

fn check_method(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int) -> str {
    let name: str = ctx.exprs[e].name
    let mut line: int = ctx.exprs[e].line
    let tt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
    # Stage 27 perfection (v0.50.3-alpha) deep-scan-18: BUG-06 fix.
    # Propagate `never` instead of erroring (bottom-type rule). A
    # method call on a never-typed receiver is dead code (the receiver
    # diverged) — the call result is also never.
    if tt == "never" {
        ctx.exprs[e].t = "never"
        return "never"
    }
    let nargs: int = ctx.exprs[e].args.len()
    # User-defined struct method (resolve via base name).
    let st: StructInfo = resolve_struct(ctx, tt)
    if st.name != "" {
        let tt_base: str = type_base(tt)
        if ctx.methods_of.has(tt_base) {
            let cands: list[str] = ctx.methods_of.get_or(tt_base, [])
            let mut key: str = ""
            let mut i: int = 0
            while i < cands.len() {
                let mut k: str = cands.get(i)
                if ctx.fns.get_or(k, dummy_fn()).name == name {
                    key = k
                }
                i = i + 1
            }
            if key == "" {
                cerr(line, "struct " + tt_base + " has no method " + name)
            }
            ctx.exprs[e].muser = true
            ctx.exprs[e].mkey = key
            add_edge(ctx, cur, key)
            let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
            let np: int = f.params.len() - 1
            if nargs != np {
                cerr(line, tt_base + "." + name + " expects " + np.to_str() + " arguments, got " + nargs.to_str())
            }
            # Build a type_map combining struct's type args + method's type params.
            let type_map_tps: list[str] = []
            let type_map_targs: list[str] = []
            # Add the struct's type params first, bound to the actual type args.
            let mut si: int = 0
            while si < st.typeparams.len() {
                type_map_tps.push(st.typeparams.get(si))
                let targs_of_tt: list[str] = type_args(tt)
                if si < targs_of_tt.len() {
                    type_map_targs.push(targs_of_tt.get(si))
                } else {
                    type_map_targs.push("")
                }
                si = si + 1
            }
            # Then the method's own type params (initially unbound).
            let mut mi: int = 0
            while mi < f.typeparams.len() {
                type_map_tps.push(f.typeparams.get(mi))
                type_map_targs.push("")
                mi = mi + 1
            }
            # Infer method's type params from arguments.
            # BUG-A2 fix: cache first-pass types per argument so we don't
            # re-run check_expr on the same argument in the second pass.
            let first_at: list[str] = []
            let mut fa_i: int = 0
            while fa_i < nargs {
                first_at.push("")
                fa_i = fa_i + 1
            }
            if f.typeparams.len() > 0 {
                let mut ai: int = 0
                while ai < nargs {
                    let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai), "")
                    first_at.set(ai, at)
                    if at != "never" {
                        # pt is f.ptypes.get(ai+1) — instantiate struct type
                        # params first, then unify with method type params.
                        # NOTE (BUG-002 fix): we pass an explicit offset
                        # (st.typeparams.len()) so unify_into_offset writes
                        # directly into the method's portion of type_map_targs.
                        let pt: str = f.ptypes.get(ai + 1)
                        let inst_pt: str = instantiate_type(pt, st.typeparams, type_args(tt))
                        unify_into_offset(ctx, inst_pt, at, f.typeparams, type_map_targs, st.typeparams.len())
                    }
                    ai = ai + 1
                }
                let mut ti: int = st.typeparams.len()
                while ti < type_map_targs.len() {
                    if type_map_targs.get(ti) == "" {
                        cerr(line, "cannot infer type argument '" + f.typeparams.get(ti - st.typeparams.len()) + "' for " + tt_base + "." + name)
                    }
                    ti = ti + 1
                }
            }
            # Type-check arguments against instantiated parameter types.
            let mut ai2: int = 0
            while ai2 < nargs {
                let pt: str = f.ptypes.get(ai2 + 1)
                let inst_pt: str = instantiate_type(pt, type_map_tps, type_map_targs)
                # Reuse the first-pass type — avoids re-running check_expr.
                let mut at: str = first_at.get(ai2)
                if at == "" {
                    at = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai2), inst_pt)
                }
                if at == "never" {
                    ai2 = ai2 + 1
                    continue
                }
                if at != inst_pt {
                    cerr(line, "argument of " + tt_base + "." + name + " expects " + inst_pt + ", got " + at)
                }
                ai2 = ai2 + 1
            }
            # BUG-002 fix: if the method has its own type params (or the
            # struct is generic), record this instantiation for codegen.
            # The mangled name encodes BOTH the struct's type args (resolved
            # from the receiver type) AND the method's inferred type args.
            if f.typeparams.len() > 0 || st.typeparams.len() > 0 {
                let mut all_targs: list[str] = []
                # Struct's type args first.
                let mut si2: int = 0
                let targs_of_tt: list[str] = type_args(tt)
                while si2 < st.typeparams.len() {
                    if si2 < targs_of_tt.len() {
                        all_targs.push(targs_of_tt.get(si2))
                    } else {
                        all_targs.push("")
                    }
                    si2 = si2 + 1
                }
                # Then method's own type args.
                let mut mi2: int = st.typeparams.len()
                while mi2 < type_map_targs.len() {
                    all_targs.push(type_map_targs.get(mi2))
                    mi2 = mi2 + 1
                }
                # Compose a combined typeparams list for the mangling.
                let combined_tps: list[str] = []
                let mut ci: int = 0
                while ci < st.typeparams.len() {
                    combined_tps.push(st.typeparams.get(ci))
                    ci = ci + 1
                }
                let mut cj: int = 0
                while cj < f.typeparams.len() {
                    combined_tps.push(f.typeparams.get(cj))
                    cj = cj + 1
                }
                let inst_str: str = key + "|" + join(all_targs, ",")
                # Deep-scan fix: skip PSEUDO method instantiations — when
                # the call sits inside another generic fn's body the
                # combined type args may still mention the enclosing fn's
                # type parameters (not real types). rebind_call_key
                # records the concrete instantiation at codegen time.
                let mut targs_concrete: bool = true
                let mut tci: int = 0
                while tci < all_targs.len() {
                    if !type_is_concrete(ctx, all_targs.get(tci)) {
                        targs_concrete = false
                    }
                    tci = tci + 1
                }
                if targs_concrete {
                    if !list_has(ctx.fn_insts, inst_str) {
                        ctx.fn_insts.push(inst_str)
                    }
                }
                ctx.exprs[e].inst_targs = all_targs
                ctx.exprs[e].inst_key = key
                ctx.exprs[e].mkey = c_mangled_fn_name(key, combined_tps, all_targs)
            }
            return instantiate_type(f.ret, type_map_tps, type_map_targs)
        }
    }
    # Builtin method: ptypes + ret table by target type
    let ptypes: list[str] = []
    let mut ret: str = ""
    if tt == "str" {
        if name == "len" {
            ret = "int"
        }
        else if name == "byte_at" {
            ptypes.push("int")
            ret = "int"
        }
        else if name == "slice" {
            ptypes.push("int")
            ptypes.push("int")
            ret = "str"
        }
        else if name == "find" {
            ptypes.push("str")
            ret = "int"
        }
        else if name == "contains" {
            ptypes.push("str")
            ret = "bool"
        }
        else if name == "starts_with" {
            ptypes.push("str")
            ret = "bool"
        }
        else if name == "ends_with" {
            ptypes.push("str")
            ret = "bool"
        }
        else if name == "split" {
            ptypes.push("str")
            ret = "list[str]"
        }
        else if name == "trim" {
            ret = "str"
        }
        else if name == "to_int" {
            ret = "int"
        }
        else if name == "to_float" {
            # Stage 77: str.to_float() needs strtod (no freestanding
            # implementation). int.to_float() is a plain cast and
            # stays available.
            if ctx.crate_freestanding {
                cerr(line, "str.to_float() is not available in #![freestanding] mode (it lowers to a libc/libm call with no freestanding implementation)")
            }
            ret = "float"
        }
        else if name == "to_str" {
            ret = "str"
        }
        else {
            cerr(line, "str has no method " + name)
        }
        ctx.exprs[e].mop = "str." + name
    } else if tt == "int" {
        if name == "to_str" {
            ret = "str"
        }
        else if name == "to_float" {
            ret = "float"
        }
        else if name == "abs" {
            ret = "int"
        }
        else {
            cerr(line, "int has no method " + name)
        }
        ctx.exprs[e].mop = "int." + name
    } else if tt == "float" {
        if name == "to_str" {
            # Stage 77: float.to_str() needs snprintf %.6f (no
            # freestanding implementation).
            if ctx.crate_freestanding {
                cerr(line, "float.to_str() is not available in #![freestanding] mode (it lowers to a libc/libm call with no freestanding implementation)")
            }
            ret = "str"
        }
        else if name == "to_int" {
            ret = "int"
        }
        else if name == "abs" {
            ret = "float"
        }
        else {
            cerr(line, "float has no method " + name)
        }
        ctx.exprs[e].mop = "float." + name
    } else if tt == "bool" {
        if name == "to_str" {
            ret = "str"
        }
        else {
            cerr(line, "bool has no method " + name)
        }
        ctx.exprs[e].mop = "bool." + name
    } else if is_list_t(tt) {
        let mut elem: str = list_elem_t(tt)
        if name == "len" {
            ret = "int"
        }
        else if name == "push" {
            ptypes.push(elem)
            ret = "void"
        }
        else if name == "get" {
            ptypes.push("int")
            ret = elem
        }
        else if name == "set" {
            ptypes.push("int")
            ptypes.push(elem)
            ret = "void"
        }
        else if name == "pop" {
            ret = elem
        }
        else {
            cerr(line, "list has no method " + name)
        }
        ctx.exprs[e].mop = "list." + name
    } else if is_map_t(tt) {
        let vt: str = map_val_t(tt)
        if name == "len" {
            ret = "int"
        }
        else if name == "set" {
            ptypes.push("str")
            ptypes.push(vt)
            ret = "void"
        }
        else if name == "get_or" {
            ptypes.push("str")
            ptypes.push(vt)
            ret = vt
        }
        else if name == "has" {
            ptypes.push("str")
            ret = "bool"
        }
        else if name == "keys" {
            ret = "list[str]"
        }
        else {
            cerr(line, "map has no method " + name)
        }
        ctx.exprs[e].mop = "map." + name
    } else if is_chan_t(tt) {
        # Stage 16 (v0.27.0-alpha): Chan[T] methods. Stage-16 perfection
        # (v0.29.0-alpha) adds the non-blocking pair try_send/recv_or.
        let celem: str = chan_inner_t(tt)
        if name == "len" {
            ret = "int"
        }
        else if name == "recv" {
            ret = celem
        }
        else if name == "recv_or" {
            ptypes.push(celem)
            ret = celem
        }
        else if name == "send" {
            ptypes.push(celem)
            ret = "void"
        }
        else if name == "try_send" {
            ptypes.push(celem)
            ret = "bool"
        }
        else {
            cerr(line, "Chan has no method " + name + " (available: send, try_send, recv, recv_or, len)")
        }
        ctx.exprs[e].mop = "chan." + name
    } else if is_task_t(tt) {
        # Stage 16 (v0.27.0-alpha): Task[R].join() -> R.
        if name != "join" {
            cerr(line, "Task has no method " + name + " (available: join)")
        }
        ret = task_inner_t(tt)
        ctx.exprs[e].mop = "task.join"
    } else {
        cerr(line, "cannot call method on type " + tt)
    }
    ctx.exprs[e].muser = false
    # Stage 16: method-level effects + the channel-send data-race rule.
    # These are the first builtin METHODS that carry an effect — the
    # call-graph edge keeps the effects fixpoint sound for them.
    # (v0.29.0-alpha: chan.try_send / chan.recv_or join the family.)
    if ctx.exprs[e].mop == "chan.send" || ctx.exprs[e].mop == "chan.try_send"
    || ctx.exprs[e].mop == "chan.recv" || ctx.exprs[e].mop == "chan.recv_or"
    || ctx.exprs[e].mop == "chan.len" || ctx.exprs[e].mop == "task.join" {
        add_edge(ctx, cur, "b:" + ctx.exprs[e].mop)
    }
    if(ctx.exprs[e].mop == "chan.send" || ctx.exprs[e].mop == "chan.try_send") && nargs >= 1 {
        # Send rule: the message type must be Send (both the blocking
        # send and the non-blocking try_send cross the task boundary)...
        let vt: str = chan_inner_t(tt)
        if !type_is_send(ctx, vt, []) {
            cerr(line, "type " + vt + " is not Send: values of this type cannot cross a task boundary")
        }
    }
    if nargs != ptypes.len() {
        cerr(line, tt + "." + name + " expects " + ptypes.len().to_str() + " arguments, got " + nargs.to_str())
    }
    let mut i: int = 0
    while i < nargs {
        let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(i), ptypes.get(i))
        if at != ptypes.get(i) {
            cerr(line, "argument of " + tt + "." + name + " expects " + ptypes.get(i) + ", got " + at)
        }
        i = i + 1
    }
    # Stage 16 (part 2): the channel-send freshness rule runs AFTER the
    # argument was type-checked — the syntactic form is what matters (a
    # bare ident/field/index read), mirroring the Python checker exactly.
    # (Running it earlier read stale annotation state and produced a
    # divergence between the two checkers.) v0.29.0-alpha: try_send
    # takes the message across the boundary the same way send does.
    if(ctx.exprs[e].mop == "chan.send" || ctx.exprs[e].mop == "chan.try_send") && nargs >= 1 {
        let vt2: str = chan_inner_t(tt)
        let vidx: int = ctx.exprs[e].args.get(0)
        let vkind: str = ctx.exprs[vidx].kind
        if is_owned_type(vt2) && (vkind == "ident" || vkind == "field" || vkind == "index") {
            let mut what: str = "a borrowed value"
            if vkind == "ident" {
                what = "variable '" + ctx.exprs[vidx].name + "'"
            }
            cerr(line, "cannot share " + what + " across tasks: " + ctx.exprs[e].mop + "(...) reads it directly — pass clone(x) (private copy) or take(x) (ownership transfer). Data-race freedom: no owned value may be simultaneously released by two threads.")
        }
    }
    return ret
}

# --- Enum variant literal check (rewrites the node to enumlit) ---

fn check_enum_variant(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str, with_args: bool) -> void {
    let ename: str = ctx.exprs[ctx.exprs[e].left].name
    let vname: str = ctx.exprs[e].name
    let line: int = ctx.exprs[e].line
    if !ctx.enums.has(ename) {
        cerr(line, "enum does not exist: " + ename)
    }
    let en: EnumInfo = ctx.enums.get_or(ename, dummy_enum())
    let mut vidx: int = -1
    let mut i: int = 0
    while i < en.variants.len() {
        if en.variants.get(i) == vname {
            vidx = i
        }
        i = i + 1
    }
    if vidx == -1 {
        cerr(line, "enum " + ename + " has no variant " + vname)
    }
    let payloads: list[str] = en.payloads.get(vidx)
    let mut nargs: int = 0
    if with_args {
        nargs = ctx.exprs[e].args.len()
    }
    if nargs != payloads.len() {
        cerr(line, "variant " + vname + " of enum " + ename + " expects " + payloads.len().to_str() + " payloads, got " + nargs.to_str())
    }
    let typeparams: list[str] = en.typeparams
    let targs: list[str] = []
    let mut ti: int = 0
    while ti < typeparams.len() {
        targs.push("")
        ti = ti + 1
    }
    # First pass: infer from args.
    if typeparams.len() > 0 && with_args {
        let mut ai: int = 0
        while ai < nargs {
            let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai), "")
            if at != "never" {
                unify_into(ctx, payloads.get(ai), at, typeparams, targs)
            }
            ai = ai + 1
        }
    }
    # Second pass: try contextual expected type.
    if typeparams.len() > 0 && expected != "" && type_base(expected) == ename {
        let eargs: list[str] = type_args(expected)
        if eargs.len() == typeparams.len() {
            let mut j: int = 0
            while j < eargs.len() {
                if targs.get(j) == "" {
                    targs.set(j, eargs.get(j))
                }
                j = j + 1
            }
        }
    }
    # If any type param is still unbound, error.
    if typeparams.len() > 0 {
        let mut ti2: int = 0
        while ti2 < typeparams.len() {
            if targs.get(ti2) == "" {
                cerr(line, "cannot infer type argument for " + ename + "; provide a contextual type")
            }
            ti2 = ti2 + 1
        }
    }
    # Type-check payloads against instantiated payload types.
    let inst_payloads: list[str] = []
    let mut pi: int = 0
    while pi < payloads.len() {
        if typeparams.len() > 0 {
            inst_payloads.push(instantiate_type(payloads.get(pi), typeparams, targs))
        } else {
            inst_payloads.push(payloads.get(pi))
        }
        pi = pi + 1
    }
    if with_args {
        let mut ai2: int = 0
        while ai2 < nargs {
            let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai2), inst_payloads.get(ai2))
            if at == "never" {
                ai2 = ai2 + 1
                continue
            }
            if at != inst_payloads.get(ai2) {
                cerr(line, "payload type mismatch: expected " + inst_payloads.get(ai2) + ", got " + at)
            }
            ai2 = ai2 + 1
        }
    }
    # Rewrite the node to enumlit.
    if typeparams.len() > 0 {
        ctx.exprs[e].t = ename + "[" + join(targs, ", ") + "]"
        # Record this enum instantiation for codegen — only if all type args
        # are concrete.
        let inst_t: str = ename + "[" + join(targs, ", ") + "]"
        if type_is_concrete(ctx, inst_t) && !list_has(ctx.enum_insts, inst_t) {
            ctx.enum_insts.push(inst_t)
        }
    } else {
        ctx.exprs[e].t = ename
    }
    ctx.exprs[e].kind = "enumlit"
    ctx.exprs[e].enum_name = ename
    ctx.exprs[e].variant = vname
}

# --- match ---
