# ============================================================================
# hlc/gen_expr.hls — part of the hlc compiler (split from the original single-file
# src/hlc.hls). This file is loaded via `import "hlc/gen_expr.hls"` from src/hlc.hls.
# Section 5e — CODEGEN: expressions, calls, spawn/stream generation.
# NOTE: content is byte-identical to the original src/hlc.hls line range
#       15775..17378 - module split is purely structural, zero code changes.
# ============================================================================
fn gen_expr(ctx: Ctx, e: int) -> str {
    # Stage 8-beta: if this node was hoisted into a temp, use the temp.
    let hk: str = e.to_str()
    if ctx.hoist_map.has(hk) {
        let tname: str = ctx.hoist_map.get_or(hk, "")
        if tname != "" {
            return tname
        }
    }
    let mut k: str = ctx.exprs[e].kind
    if k == "int" {
        if ctx.exprs[e].ival == -9223372036854775808 {
            return "(-9223372036854775807LL - 1)"
        }
        return ctx.exprs[e].ival.to_str()
    }
    if k == "float" {
        # Deep-scan-28: re-emit the ORIGINAL literal text (parser stores it
        # in ftext). The old code used fval.to_str() — the DISPLAY formatter
        # (6 decimal places) — which silently corrupted any literal with
        # more precision (1.5e-10 became 0.000000; 0.123456789012345 became
        # 0.123457) so native binaries computed different values than the
        # interpreter. C strtod is correctly rounded, exactly like Python's
        # float(), so the source text round-trips to the identical double.
        # Defensive fallback: if the node carries no text (should not
        # happen for parser-produced literals), keep the old display form.
        let ftext: str = ctx.exprs[e].ftext
        if ftext != "" {
            return ftext
        }
        return ctx.exprs[e].fval.to_str()
    }
    if k == "bool" {
        if ctx.exprs[e].bval {
            return "true"
        }
        return "false"
    }
    if k == "str" {
        # Stage 19 (v0.35.0-alpha): profile-driven literal hoisting. In
        # a HOT function a string literal becomes a thread-local
        # one-time cache: the conversion (malloc + strlen + memcpy)
        # runs once per thread instead of once per evaluation. The
        # trailing hl_retain supplies the +1 that a fresh literal's
        # inherent refcount provided, so ownership paths are unchanged.
        if pgo_has_profile(ctx) && pgo_fn_is_hot(ctx, ctx.cur_fn) {
            ctx.pgo_slit_n = ctx.pgo_slit_n + 1
            let name: str = "HLC_SL_" + ctx.pgo_slit_n.to_str()
            ctx.pgo_slits.push("static __thread hl_str* " + name + " = NULL;")
            return "hl_retain((" + name + " ? (" + name + ") : (" + name
            + " = " + c_str_lit(ctx.exprs[e].sval) + ")))"
        }
        return c_str_lit(ctx.exprs[e].sval)
    }
    if k == "ident" {
        # Stage 30 (v0.47.0-alpha): defensive invariant — a stack-
        # allocated binding must never reach a VALUE position (the
        # escape analysis proved every use borrow-safe before the
        # layout was chosen). If this fires, the analysis and the
        # codegen disagree — a compiler bug, so fail loudly rather
        # than emit a wrong C reference.
        if is_stack_var(ctx, ctx.exprs[e].name) {
            panic("internal codegen error: stack-allocated list '" + ctx.exprs[e].name + "' used as a value — the escape analysis and the codegen disagree")
        }
        return local_c(ctx, ctx.exprs[e].name)
    }
    if k == "bin" {
        return gen_bin(ctx, e)
    }
    if k == "un" {
        let sub: str = gen_expr(ctx, ctx.exprs[e].left)
        if ctx.exprs[e].op == "!" {
            return "(!" + sub + ")"
        }
        if ctx.exprs[e].t == "int" {
            return "hl_neg_i64(" + sub + ")"
        }
        return "(-" + sub + ")"
    }
    if k == "index" {
        # Stage 30 (v0.47.0-alpha): stack-layout index access —
        # xs[i] lowers to the typed bounds-checked accessor instead of
        # the boxed hl_list_get + unbox pair. The element type is
        # annotated by the checker (exprs[e].t = elem type).
        if ctx.exprs[ctx.exprs[e].left].kind == "ident" && is_stack_var(ctx, ctx.exprs[ctx.exprs[e].left].name) {
            let sarr: str = local_c(ctx, ctx.exprs[ctx.exprs[e].left].name)
            let sidx: str = gen_expr(ctx, ctx.exprs[e].right)
            let scap: int = stack_cap_of(ctx, ctx.exprs[ctx.exprs[e].left].name)
            return "hlc_sg_" + stack_elem_suffix(ctx.exprs[e].t) + "(" + sarr + ", " + sidx + ", " + scap.to_str() + ")"
        }
        let lst: str = gen_expr(ctx, ctx.exprs[e].left)
        let idx: str = gen_expr(ctx, ctx.exprs[e].right)
        # Stage 17: -O fast — a bounds-proven index uses the unchecked
        # getter (the interval prover proved i in [0, len-1)).
        let mut getter: str = "hl_list_get"
        if ctx.fast_mode && ctx.exprs[e].bnd_safe {
            getter = "hl_list_get_unchecked"
        }
        # Deep-scan-24 fix (HIGH): instantiate the element type before
        # the unbox dispatch — inside a generic fn the checker's raw
        # annotation is the TYPE PARAM (e.g. T for `xs: list[T]`), so
        # gen_unbox dispatched to the identity hl_unbox_ptr and the
        # boxed pointer was returned as the value (same class as the
        # list.get fix above).
        return gen_unbox(ctx, inst_t(ctx, ctx.exprs[e].t), getter + "(" + lst + ", " + idx + ")")
    }
    if k == "field" {
        return "(" + gen_expr(ctx, ctx.exprs[e].left) + ")->" + c_field_name(ctx.exprs[e].name)
    }
    if k == "call" {
        return gen_call(ctx, e)
    }
    if k == "method" {
        return gen_method(ctx, e)
    }
    if k == "listlit" {
        return gen_listlit(ctx, e)
    }
    if k == "structlit" {
        return gen_structlit(ctx, e)
    }
    if k == "enumlit" {
        return gen_enumlit(ctx, e)
    }
    if k == "match" {
        # Match in expression position: emit an immediately-invoked lambda
        # equivalent (a block expression). We use a GCC statement expression
        # `({ ... })` for this purpose.
        return gen_match_expr(ctx, e)
    }
    if k == "qmark" {
        # `?` in expression position: similar — emit a statement expression
        # that returns the unwrapped value or returns the error from the
        # enclosing function.
        return gen_qmark_expr(ctx, e)
    }
    if k == "mapnew" {
        return "hl_map_new()"
    }
    panic("internal codegen error: unknown expression " + k)
    return ""
}

fn gen_bin(ctx: Ctx, e: int) -> str {
    let op: str = ctx.exprs[e].op
    # Stage 27 perfection (v0.50.3-alpha) deep-scan-18: BUG-06 fix
    # (codegen). If either operand has type `never` (e.g. `panic("...")`),
    # the binop is dead code — the operand diverges. Emit just the
    # diverging operand (which compiles to `hl_panic(...)` returning
    # void) WITHOUT wrapping it in the binary operation — the C
    # `+1`/`==`/etc on a void value would not compile. The `t` field
    # of the binop expr is `never` (set by check_bin's propagation),
    # so callers of gen_expr that consume this result are also dead
    # code (the parent statement is unreachable).
    let lt_check: str = ctx.exprs[ctx.exprs[e].left].t
    let rt_check: str = ctx.exprs[ctx.exprs[e].right].t
    if lt_check == "never" {
        # The left operand diverges — emit it and stop.
        let a_only: str = gen_expr(ctx, ctx.exprs[e].left)
        return a_only
    }
    if rt_check == "never" {
        # The right operand diverges — but we still need to emit the
        # left operand first (it may have side effects). Use a GCC
        # statement expression: ({ a; b; }) where the result type is
        # `void` (matching the diverging b). The caller treats the
        # binop result as dead code.
        let a_val: str = gen_expr(ctx, ctx.exprs[e].left)
        let b_val: str = gen_expr(ctx, ctx.exprs[e].right)
        return "({ " + a_val + "; " + b_val + "; })"
    }
    let t: str = ctx.exprs[ctx.exprs[e].left].t
    let a: str = gen_expr(ctx, ctx.exprs[e].left)
    if op == "||" || op == "&&" {
        # BUGFIX (v0.36.0-alpha): the right operand is generated LAZILY —
        # see collect_hoist's bin case. Its fresh pointer subexpressions
        # are scoped inside a GCC statement expression placed exactly at
        # the operand position: C's short-circuit skips both their
        # evaluation AND their cleanup when the left operand already
        # decided the result, matching the interpreter exactly.
        let r: int = ctx.exprs[e].right
        collect_hoist(ctx, r)
        let decls: list[str] = []
        hoist_all(ctx, decls, "")
        let bval: str = gen_expr(ctx, r)
        if decls.len() == 0 {
            return "(" + a + " " + op + " " + bval + ")"
        }
        return "(" + a + " " + op + " ({ " + join(decls, " ") + " " + bval + "; }))"
    }
    let b: str = gen_expr(ctx, ctx.exprs[e].right)
    if op == "==" {
        if t == "str" {
            return "hl_str_eq(" + a + ", " + b + ")"
        }
        return "(" + a + " == " + b + ")"
    }
    if op == "!=" {
        if t == "str" {
            return "(!hl_str_eq(" + a + ", " + b + "))"
        }
        return "(" + a + " != " + b + ")"
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if t == "str" {
            return "(hl_str_cmp(" + a + ", " + b + ") " + op + " 0)"
        }
        return "(" + a + " " + op + " " + b + ")"
    }
    if op == "+" {
        if t == "int" {
            # Stage 17: -O fast — an overflow-proven add emits the raw op.
            if ctx.fast_mode && ctx.exprs[e].ovf_safe {
                return "(" + a + " + " + b + ")"
            }
            return "hl_add_i64(" + a + ", " + b + ")"
        }
        if t == "str" {
            return "hl_str_concat(" + a + ", " + b + ")"
        }
        return "(" + a + " + " + b + ")"
    }
    if op == "-" {
        if t == "int" {
            if ctx.fast_mode && ctx.exprs[e].ovf_safe {
                return "(" + a + " - " + b + ")"
            }
            return "hl_sub_i64(" + a + ", " + b + ")"
        }
        return "(" + a + " - " + b + ")"
    }
    if op == "*" {
        if t == "int" {
            if ctx.fast_mode && ctx.exprs[e].ovf_safe {
                return "(" + a + " * " + b + ")"
            }
            return "hl_mul_i64(" + a + ", " + b + ")"
        }
        return "(" + a + " * " + b + ")"
    }
    if op == "/" {
        if t == "int" {
            # Stage 17: -O fast — a divisor-proven-nonzero div/mod skips
            # the zero check (and the INT64_MIN/-1 corner was excluded by
            # the prover).
            if ctx.fast_mode && ctx.exprs[e].div_safe {
                return "(" + a + " / " + b + ")"
            }
            return "hl_div_i64(" + a + ", " + b + ")"
        }
        return "(" + a + " / " + b + ")"
    }
    if op == "%" {
        if t == "int" {
            if ctx.fast_mode && ctx.exprs[e].div_safe {
                return "(" + a + " % " + b + ")"
            }
            return "hl_mod_i64(" + a + ", " + b + ")"
        }
        return "hl_fmod(" + a + ", " + b + ")"
    }
    panic("internal codegen error: unknown operator " + op)
    return ""
}

fn gen_args_c(ctx: Ctx, e: int) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        parts.push(gen_expr(ctx, ctx.exprs[e].args.get(i)))
        i = i + 1
    }
    return join(parts, ", ")
}

fn gen_call(ctx: Ctx, e: int) -> str {
    if ctx.exprs[e].muser {
        # Deep-scan fix: inside a generic instantiation body the callee's
        # recorded type args may still be the enclosing fn's TYPE PARAMS
        # (the checker annotated the generic body once, symbolically).
        # Re-bind them through ctx.cur_typeparams -> ctx.cur_targs so the
        # call targets the correctly mangled concrete instantiation.
        let mut call_key: str = ctx.exprs[e].mkey
        if ctx.cur_typeparams.len() > 0 && ctx.exprs[e].inst_targs.len() > 0 {
            call_key = rebind_call_key(ctx, e)
        }
        # Stage 15-beta: extern fns use the RAW C name (no `usf_` prefix)
        # so the C linker can resolve them from libc. Extern args are
        # borrowed (the C callee knows nothing about refcounts) — fresh
        # pointer args were hoisted into temps by the statement wrapper.
        let cf: FnInfo = ctx.fns.get_or(call_key, dummy_fn())
        if cf.is_extern {
            return call_key + "(" + gen_args_c(ctx, e) + ")"
        }
        # Stage 8-beta: user fn params OWN one retain of each argument —
        # fresh values are passed raw, borrowed values retain-wrapped.
        # Stage 21 (v0.37.0-alpha): --target-feature — std.simd kernel
        # calls redirect to the intrinsic helpers (identical semantics,
        # native vector code; helpers own their args like user fns).
        if ctx.target_feature != "" {
            let redirected: str = simd_try_redirect(ctx, call_key, e)
            if redirected != "" {
                return redirected
            }
        }
        # Stage 20 (v0.36.0-alpha): count the emitted out-of-line call
        # (LTO phase-B DCE drops standalone bodies at 0).
        lto_note_call(ctx, call_key)
        return "usf_" + c_fn_name(call_key) + "(" + gen_own_args_c(ctx, e) + ")"
    }
    let name: str = ctx.exprs[e].mkey
    let args: str = gen_args_c(ctx, e)
    if name == "print" {
        return "hl_print(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "println" {
        return "hl_println(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # ----- Stage 56 (v0.75.0-alpha): stderr + TTY-detection builtins -----
    # eprint / eprintln consume their str argument (gen_own_arg — the
    # same convention as print / println). isatty takes a primitive int
    # (no refcount concern — gen_expr passes it raw).
    if name == "eprint" {
        return "hl_eprint(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "eprintln" {
        return "hl_eprintln(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "isatty" {
        return "hl_isatty(" + gen_expr(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # ----- Stage 57 (v0.76.0-alpha): process-identity builtins -----
    # Both take no args; sys_hostname returns a fresh str.
    if name == "proc_pid" {
        return "hl_proc_pid()"
    }
    if name == "sys_hostname" {
        return "hl_sys_hostname()"
    }
    if name == "panic" {
        return "hl_panic(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "exit" {
        return "hl_exit(" + args + ")"
    }
    if name == "str" {
        let at: str = ctx.exprs[ctx.exprs[e].args.get(0)].t
        if at == "int" {
            return "hl_str_from_int64(" + args + ")"
        }
        if at == "float" {
            return "hl_str_from_double(" + args + ")"
        }
        if at == "bool" {
            return "hl_str_from_bool(" + args + ")"
        }
        return args
    }
    if name == "int" {
        return "hl_str_to_int(" + args + ")"
    }
    if name == "len" {
        let at: str = ctx.exprs[ctx.exprs[e].args.get(0)].t
        if at == "str" {
            return "hl_str_len(" + args + ")"
        }
        if is_list_t(at) {
            return "hl_list_len(" + args + ")"
        }
        return "hl_map_len(" + args + ")"
    }
    if name == "range" {
        return "hl_range(" + args + ")"
    }
    # Stage 19 (v0.35.0-alpha): O(n) join(list[str], sep) -> str. Args
    # are read-only for the callee (borrowed raw pointers, matching the
    # concat convention); the result is a fresh string.
    if name == "join" {
        return "hl_str_join(" + args + ")"
    }
    # Stage 32 (v0.51.0-alpha): native bitwise builtins — each compiles
    # to a single C operation. The shift count is masked to [0, 63] to
    # avoid C undefined behaviour when n >= 64 (the std/bits.hls API
    # documents this as the same behaviour as the previous loop-based
    # implementation: shifts >= 64 yield 0 for shl/shr and the sign
    # value for sar).
    #
    # Deep-scan-19 fix (HIGH, UB): int_shl emits `(int64_t)(a0) << (n & 63)`
    # — the cast to int64_t is REQUIRED because `1 << 63` with `int` (32-bit)
    # is undefined behaviour in C (shift count >= bit width). The same
    # applies to int_or/xor/and/not when the operand is a small literal
    # (e.g. `int_xor(x, -1)` needs `(int64_t)x ^ (int64_t)-1`); we cast
    # both operands defensively.
    if name == "int_and" || name == "int_or" || name == "int_xor"
    || name == "int_shl" || name == "int_shr" || name == "int_sar" {
        let a0c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        let a1c: str = gen_expr(ctx, ctx.exprs[e].args.get(1))
        if name == "int_and" {
            return "((int64_t)(" + a0c + ") & (int64_t)(" + a1c + "))"
        }
        if name == "int_or" {
            return "((int64_t)(" + a0c + ") | (int64_t)(" + a1c + "))"
        }
        if name == "int_xor" {
            return "((int64_t)(" + a0c + ") ^ (int64_t)(" + a1c + "))"
        }
        if name == "int_shl" {
            return "((int64_t)(" + a0c + ") << (" + a1c + " & 63))"
        }
        if name == "int_shr" {
            return "((int64_t)((uint64_t)(int64_t)(" + a0c + ") >> (" + a1c + " & 63)))"
        }
        # int_sar
        return "((int64_t)(" + a0c + ") >> (" + a1c + " & 63))"
    }
    if name == "int_not" || name == "int_popcount"
    || name == "int_clz" || name == "int_ctz" {
        let a0u: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        if name == "int_not" {
            return "(~(int64_t)(" + a0u + "))"
        }
        if name == "int_popcount" {
            return "__builtin_popcountll((uint64_t)(int64_t)(" + a0u + "))"
        }
        if name == "int_clz" {
            return "hl_clz((uint64_t)(int64_t)(" + a0u + "))"
        }
        # int_ctz
        return "hl_ctz((uint64_t)(int64_t)(" + a0u + "))"
    }
    # Stage 21 (v0.37.0-alpha): has_feature — const-folded from the
    # --target-feature flag. Exact-match semantics (asking for "avx2"
    # is true only when avx2 was requested).
    if name == "has_feature" {
        if ctx.target_feature == ctx.exprs[ctx.exprs[e].args.get(0)].sval {
            return "true"
        }
        return "false"
    }
    # Stage 21: simd_cpu_supports — runtime CPU probe.
    if name == "simd_cpu_supports" {
        return "hl_simd_cpu_supports(" + args + ")"
    }
    # (Stage 21 redirect lives in the muser branch above — user fn
    # calls return before reaching the builtin section.)
    if name == "map_new" {
        # Stage 8-beta: the map owns its values — val_free comes from the
        # map's value type (the checker types this call from context).
        let mt: str = inst_t(ctx, ctx.exprs[e].t)
        if is_map_t(mt) {
            return "hl_map_new(" + elem_free_fn(ctx, map_val_t(mt)) + ")"
        }
        return "hl_map_new(NULL)"
    }
    if name == "read_file" {
        return "hl_read_file(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # Stage 10-beta: read_file_tainted — at runtime, returns the same hl_read_file
    # result; taint is a compile-time property only (defense-in-depth is deferred).
    if name == "read_file_tainted" {
        return "hl_read_file(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # Stage 10 release: read_line() — reads one line from stdin (newline
    # stripped). At runtime, identical to hl_read_line(); taint is a
    # compile-time property only (the checker enforces sanitisation
    # before sinks; the runtime wrapper is defence-in-depth, deferred).
    if name == "read_line" {
        return "hl_read_line()"
    }
    if name == "write_file" {
        return "hl_write_file(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ", "
        + gen_own_arg(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    if name == "args" {
        return "hl_args()"
    }
    # Stage 10-alpha: taint primitives — at runtime, taint is a no-op
    # (the check is purely at compile-time). tainted_args() returns the
    # same hl_args() result; taint_mark(x) returns x; taint_unwrap(x)
    # returns x. The C type of tainted[T] is the same as T (see c_type).
    if name == "tainted_args" {
        return "hl_args()"
    }
    if name == "taint_mark" {
        return args
    }
    if name == "taint_unwrap" {
        return args
    }
    if name == "clock_ms" {
        return "hl_clock_ms()"
    }
    # Stage 46 (v0.65.0-alpha): thread / scheduling builtins.
    # Each maps to a single C runtime helper (see emit_thread_runtime
    # below for the helper definitions).
    if name == "thread_sleep_ms" {
        return "hl_thread_sleep_ms(" + args + ")"
    }
    if name == "thread_yield" {
        return "hl_thread_yield()"
    }
    if name == "thread_current_id" {
        return "hl_thread_current_id()"
    }
    if name == "chr" {
        return "hl_chr(" + args + ")"
    }
    if name == "file_exists" {
        return "hl_file_exists(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # ----- Stage 36 (v0.55.0-alpha): filesystem metadata builtins -----
    if name == "fs_read_dir" {
        return "hl_fs_read_dir(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "fs_size" {
        return "hl_fs_size(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "fs_is_dir" {
        return "hl_fs_is_dir(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "fs_set_perms" {
        return "hl_fs_set_perms(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    # ----- Stage 8-beta: ownership primitives -----
    # drop(x): release the value now and null the binding so the
    # scope-exit cleanup is a no-op. The checker guarantees x is an
    # owned binding, so this is always a pointer type.
    if name == "drop" {
        let arg: int = ctx.exprs[e].args.get(0)
        let cn: str = local_c(ctx, ctx.exprs[arg].name)
        let t: str = ctx.exprs[arg].t
        return "((" + release_call(ctx, t, cn) + "), (" + cn + " = NULL, (void)0))"
    }
    # clone(x): dispatch to the per-instantiation helper generated by
    # gen_clone_bodies (str uses the runtime's hl_clone_str). tainted[T]
    # clones as T — the taint is a compile-time property only.
    if name == "clone" {
        let at: str = strip_taint(inst_t(ctx, ctx.exprs[ctx.exprs[e].args.get(0)].t))
        # Stage 16: a channel clones by SHARING (atomic refcount + 1) —
        # no per-instantiation deep-clone helper is registered.
        if is_chan_t(at) {
            return "hl_chan_clone(" + args + ")"
        }
        # Stage 33/34: Future[T] and Stream[T] clone via hl_chan_clone.
        if is_future_t(at) || is_stream_t(at) {
            return "hl_chan_clone(" + args + ")"
        }
        register_clone(ctx, at)
        # Deep-scan fix: primitives have value semantics — clone() is the
        # identity (clone_expr_for already treats them that way for the
        # composite helpers). This path is reachable through GENERIC
        # instantiation only (the checker rejects a direct clone(int)):
        # core/clone.hls's clone_some[T] calls clone(v); instantiated with
        # T=int it must not reference a nonexistent hl_clone_int helper.
        if at == "int" || at == "float" || at == "bool" {
            return args
        }
        if at == "str" {
            return "hl_clone_str(" + args + ")"
        }
        return "hl_clone_" + c_type_name(at) + "(" + args + ")"
    }
    # take(x): a compile-time move — at runtime it is just the value.
    # The binding is nulled at the end of the statement (null_after) so
    # the scope-exit cleanup is a no-op: ownership transfers.
    if name == "take" {
        let arg: int = ctx.exprs[e].args.get(0)
        let cn: str = local_c(ctx, ctx.exprs[arg].name)
        ctx.null_after.push(cn)
        return cn
    }
    # ----- Stage 9 release (v0.20.0-alpha): Net / Rand / Proc builtins -----
    # net_lookup(host: str) -> str — DNS A record lookup. The host
    # argument is an owned str (consumed by the runtime helper).
    if name == "net_lookup" {
        return "hl_net_lookup(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # ----- Stage 37 (v0.56.0-alpha): TCP / UDP / TLS builtins -----
    # Host / path arguments are OWNED str (consumed by the runtime
    # helpers — one retain released inside the helper). Data being
    # sent (net_write / net_udp_send_to) is also an owned str. The
    # fd / port / n / backlog arguments are primitive int (no
    # ownership). net_read / net_udp_recv_from return a fresh str
    # (refcnt=1, ownership transfers to the caller's binding).
    if name == "net_tcp_connect" {
        return "hl_net_tcp_connect(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    if name == "net_tcp_listen" {
        return "hl_net_tcp_listen(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(1))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(2)) + ")"
    }
    if name == "net_tcp_accept" {
        return "hl_net_tcp_accept(" + gen_expr(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "net_read" {
        return "hl_net_read(" + gen_expr(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    if name == "net_write" {
        return "hl_net_write(" + gen_expr(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_own_arg(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    if name == "net_close" {
        return "hl_net_close(" + gen_expr(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "net_udp_open" {
        return "hl_net_udp_open()"
    }
    if name == "net_udp_send_to" {
        return "hl_net_udp_send_to(" + gen_expr(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_own_arg(ctx, ctx.exprs[e].args.get(1))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(2))
        + ", " + gen_own_arg(ctx, ctx.exprs[e].args.get(3)) + ")"
    }
    if name == "net_udp_recv_from" {
        return "hl_net_udp_recv_from(" + gen_expr(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    if name == "net_tls_get" {
        return "hl_net_tls_get(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(1))
        + ", " + gen_own_arg(ctx, ctx.exprs[e].args.get(2)) + ")"
    }
    # rand_int(max: int) -> int — uniform random int in [0, max).
    if name == "rand_int" {
        return "hl_rand_int(" + args + ")"
    }
    # rand_float() -> float — uniform random float in [0.0, 1.0).
    if name == "rand_float" {
        return "hl_rand_float()"
    }
    # rand_seed(s: int) -> void — seed the PRNG.
    if name == "rand_seed" {
        return "hl_rand_seed(" + args + ")"
    }
    # proc_exec(cmd: str) -> int — run a shell command via system().
    # The command is an owned str (consumed by the runtime helper).
    if name == "proc_exec" {
        return "hl_proc_exec(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # ----- Stage 47 (v0.66.0-alpha): process management builtins -----
    # proc_spawn consumes the program (arg 0) and args list (arg 1);
    # the stdio kind ints (args 2/3/4) are primitive (no refcount).
    if name == "proc_spawn" {
        return "hl_proc_spawn(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_own_arg(ctx, ctx.exprs[e].args.get(1))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(2))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(3))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(4)) + ")"
    }
    if name == "proc_wait" {
        return "hl_proc_wait(" + gen_expr(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "proc_kill" {
        return "hl_proc_kill(" + gen_expr(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # proc_child_write consumes the data str (arg 1).
    if name == "proc_child_write" {
        return "hl_proc_child_write(" + gen_expr(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_own_arg(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    if name == "proc_child_read" {
        return "hl_proc_child_read(" + gen_expr(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(1))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(2)) + ")"
    }
    if name == "proc_child_close" {
        return "hl_proc_child_close(" + gen_expr(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_expr(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    # ----- Stage 48 (v0.67.0-alpha): environment + cwd builtins -----
    # env_get consumes its key (arg 0); returns a fresh str.
    if name == "env_get" {
        return "hl_env_get(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # env_has consumes its key (arg 0); returns a bool.
    if name == "env_has" {
        return "hl_env_has(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # env_set consumes both its key (arg 0) and value (arg 1).
    if name == "env_set" {
        return "hl_env_set(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0))
        + ", " + gen_own_arg(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    # env_unset consumes its key (arg 0).
    if name == "env_unset" {
        return "hl_env_unset(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # cwd_get returns a fresh str (no args).
    if name == "cwd_get" {
        return "hl_cwd_get()"
    }
    # cwd_set consumes its path (arg 0).
    if name == "cwd_set" {
        return "hl_cwd_set(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # args_os returns the hl_args() list (same as args() at the
    # C level; the stdlib env_args_os applies taint_mark per element).
    if name == "args_os" {
        return "hl_args()"
    }
    # ----- Stage 49 (v0.68.0-alpha): high-resolution time builtins -----
    # instant_now_ns() and system_time_now_ms() take no args and
    # return an int64. The C runtime helpers hl_instant_now_ns and
    # hl_system_time_now_ms are emitted in the runtime section below.
    if name == "instant_now_ns" {
        return "hl_instant_now_ns()"
    }
    if name == "system_time_now_ms" {
        return "hl_system_time_now_ms()"
    }
    # ----- Stage 50 (v0.69.0-alpha): libm-backed math builtins -----
    # All math_* builtins delegate to the corresponding libm function.
    # The HLS function name maps 1:1 to a static inline C helper named
    # hl_<name>(double) — emitted below in the runtime section. The
    # helper exists because the C codegen for HLS calls uses the
    # "hl_<name>" prefix for every builtin (so the call site reads
    # "hl_math_sin(x)" rather than "sin(x)"). The helper is a single
    # line that just calls the libm function — no extra wrapping is
    # needed (libm functions take double and return double, which
    # matches HLS float).
    #
    # Single-arg float -> float:
    if name == "math_sin" || name == "math_cos" || name == "math_tan"
    || name == "math_asin" || name == "math_acos" || name == "math_atan"
    || name == "math_sinh" || name == "math_cosh" || name == "math_tanh"
    || name == "math_exp" || name == "math_log" || name == "math_log10"
    || name == "math_log2" || name == "math_sqrt" || name == "math_cbrt"
    || name == "math_erf" || name == "math_erfc" || name == "math_tgamma"
    || name == "math_lgamma" {
        let x: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        return "hl_" + name + "(" + x + ")"
    }
    # Two-arg float -> float:
    if name == "math_atan2" || name == "math_pow" || name == "math_hypot"
    || name == "math_fmod" || name == "math_copysign" {
        let a0: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        let a1: str = gen_expr(ctx, ctx.exprs[e].args.get(1))
        return "hl_" + name + "(" + a0 + ", " + a1 + ")"
    }
    # IEEE-754 predicates (float -> bool). The C runtime helpers return
    # bool (C99 <stdbool.h> true/false). The codegen emits them as the
    # call expression; the surrounding expression context will coerce
    # bool to int (HLS bool -> C bool, used as i1 in the LLVM backend).
    if name == "math_isnan" || name == "math_isinf"
    || name == "math_isfinite" || name == "math_signbit" {
        let x: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        return "hl_" + name + "(" + x + ")"
    }
    # ----- Stage 16 (v0.27.0-alpha): concurrency builtins -----
    if name == "chan_new" {
        # The channel owns its pending messages: elem_release knows how to
        # release one pointer payload of T (NULL for primitives — they are
        # stored raw in the message union, not boxed).
        let mt: str = inst_t(ctx, ctx.exprs[e].t)
        let mut elem: str = "int"
        if is_chan_t(mt) {
            elem = strip_taint(chan_inner_t(mt))
        }
        let mut rel: str = "NULL"
        if elem != "int" && elem != "float" && elem != "bool" {
            rel = release_fn_for(ctx, elem)
        }
        return "hl_chan_new(" + rel + ")"
    }
    # chan_new_bounded(cap) — v0.29.0-alpha: same release-fn logic as
    # chan_new, plus the capacity expression (validated at runtime; the
    # checker already rejected literal capacities < 1).
    if name == "chan_new_bounded" {
        let mt2: str = inst_t(ctx, ctx.exprs[e].t)
        let mut elem2: str = "int"
        if is_chan_t(mt2) {
            elem2 = strip_taint(chan_inner_t(mt2))
        }
        let mut rel2: str = "NULL"
        if elem2 != "int" && elem2 != "float" && elem2 != "bool" {
            rel2 = release_fn_for(ctx, elem2)
        }
        let cap: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        return "hl_chan_new_bounded(" + cap + ", " + rel2 + ")"
    }
    if name == "spawn" {
        return gen_spawn_call(ctx, e)
    }
    if name == "async_spawn" {
        return gen_async_spawn_call(ctx, e)
    }
    if name == "gen_spawn" {
        return gen_gen_spawn_call(ctx, e)
    }
    if name == "stream_map_int" || name == "stream_filter_int"
    || name == "stream_fold_int" || name == "stream_flat_map_int" {
        return gen_stream_combinator(ctx, e, name)
    }
    if name == "select" {
        return "hl_chan_select(" + args + ")"
    }
    # ----- Stage 33 (v0.52.0-alpha): async/await builtins -----
    # await(fut) -> T : a future IS a hl_chan* (cap 1); await is chan.recv.
    if name == "await" {
        let fut_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        let inner_t: str = inst_t(ctx, ctx.exprs[e].t)
        if inner_t == "int" {
            return "hl_chan_recv_i64(" + fut_c + ")"
        }
        if inner_t == "float" {
            return "hl_chan_recv_f64(" + fut_c + ")"
        }
        if inner_t == "bool" {
            return "(hl_chan_recv_i64(" + fut_c + ") != 0)"
        }
        return "((" + c_type(ctx, inner_t) + ")hl_chan_recv_ptr(" + fut_c + "))"
    }
    # future_ready(v) -> Future[T]: create a cap-1 chan, send v, return chan.
    if name == "future_ready" {
        let inner_t: str = future_inner_t(inst_t(ctx, ctx.exprs[e].t))
        # Deep-scan-25 fix (HIGH, native codegen): the per-site helper
        # used to reference the argument expression LEXICALLY inside a
        # file-scope static function — any argument naming a function
        # local (e.g. `future_ready(ys)`, lowered to `hl_retain(u_ys)`)
        # produced C that did not compile ("u_ys undeclared"); only
        # primitive literals ever worked. The helper now TAKES THE
        # VALUE AS A PARAMETER: the argument is evaluated at the call
        # site (where the locals live) and passed in, exactly like the
        # inline hl_chan_send path. The value must also be boundary-
        # PRIVATE: apply the chan.send rule (clone(...)/str literals/
        # fresh results pass raw; borrowed composites are deep-copied;
        # channels cross by sharing).
        let vidx: int = ctx.exprs[e].args.get(0)
        let mut v_c: str = gen_expr(ctx, vidx)
        let argkind: str = ctx.exprs[vidx].kind
        let is_clone_call: bool = argkind == "call" && ctx.exprs[vidx].mkey == "clone"
        let mut private_val: bool = is_clone_call || argkind == "str" || expr_fresh(ctx, vidx)
        if is_chan_t(inner_t) {
            private_val = true
        }
        if !private_val && inner_t != "int" && inner_t != "float" && inner_t != "bool" {
            let ct: str = strip_taint(inner_t)
            register_clone(ctx, ct)
            v_c = clone_expr_for(ctx, ct, v_c)
        }
        # Emit: (hl_chan* c = hl_chan_new_bounded(1, rel), hl_chan_send_<s>(c, v), c)
        # But HLS codegen is expression-based, so we use a helper that
        # does all three. We emit an inline-expression helper per call
        # site (a static inline fn) to keep it as a single expression.
        let n: int = ctx.future_ready_n
        ctx.future_ready_n = ctx.future_ready_n + 1
        let nid: str = n.to_str()
        let mut rel: str = "NULL"
        if inner_t != "int" && inner_t != "float" && inner_t != "bool" {
            rel = release_fn_for(ctx, inner_t)
        }
        let mut param_ty: str = "int64_t"
        let mut send_fn: str = "hl_chan_send_i64"
        let mut v_cast: str = "v"
        if inner_t == "float" {
            param_ty = "double"
            send_fn = "hl_chan_send_f64"
            v_cast = "v"
        } else if inner_t == "bool" {
            send_fn = "hl_chan_send_i64"
            v_cast = "(v ? 1 : 0)"
        } else if inner_t != "int" {
            param_ty = "void*"
            send_fn = "hl_chan_send_ptr"
            v_cast = "v"
        }
        let d: list[str] = []
        d.push("static hl_chan* hl_future_ready_" + nid + "(" + param_ty + " v) {")
        d.push("    hl_chan* c = hl_chan_new_bounded(1, " + rel + ");")
        d.push("    " + send_fn + "(c, " + v_cast + ");")
        d.push("    return c;")
        d.push("}")
        d.push("")
        let mut di: int = 0
        while di < d.len() {
            ctx.spawn_decls.push(d.get(di))
            di = di + 1
        }
        return "hl_future_ready_" + nid + "(" + v_c + ")"
    }
    # future_poll(fut) -> Option[T]: non-blocking poll.
    # We emit a per-site helper that returns a heap-allocated Option enum
    # value (Some(v) if ready, None otherwise). The enum value is
    # allocated via the standard enum-construction helper.
    if name == "future_poll" {
        # For simplicity (and because Option[T] enum instantiation is
        # complex to emit inline), we emit a per-site helper that does
        # the poll and constructs the Option. The helper is named
        # hl_future_poll_N.
        # Deep-scan-28 fix: inst_t() was missing here — inside a generic
        # function the symbolic type param T flowed into the emitted
        # helper (Option__T / usf_make_Option__T_Some) and the generated
        # C did not compile. future_ready (below) already does this.
        let inner_t: str = future_inner_t(inst_t(ctx, ctx.exprs[e].t))
        let n: int = ctx.future_poll_n
        ctx.future_poll_n = ctx.future_poll_n + 1
        let nid: str = n.to_str()
        let enum_t: str = "Option[" + inner_t + "]"
        let enum_c: str = c_type_name(enum_t) + "*"
        # Force the Option instantiation (so the Some/None constructors
        # and the release fn are emitted).
        collect_insts(ctx, enum_t)
        # The constructor names follow the existing enum-literal pattern:
        # usf_make_<TypeEnum>_<Variant>.
        let some_fn: str = "usf_make_" + c_type_name(enum_t) + "_Some"
        let none_fn: str = "usf_make_" + c_type_name(enum_t) + "_None"
        # For the recv: we peek via hl_chan_len; if > 0, recv and wrap.
        let mut recv_expr: str = "hl_chan_recv_i64(c)"
        if inner_t == "float" {
            recv_expr = "hl_chan_recv_f64(c)"
        } else if inner_t == "bool" {
            recv_expr = "(hl_chan_recv_i64(c) != 0)"
        } else {
            recv_expr = "((" + c_type(ctx, inner_t) + ")hl_chan_recv_ptr(c))"
        }
        let d: list[str] = []
        d.push("static " + enum_c + " hl_future_poll_" + nid + "(hl_chan* c) {")
        d.push("    if (hl_chan_len(c) > 0) {")
        d.push("        return " + some_fn + "(" + recv_expr + ");")
        d.push("    }")
        d.push("    return " + none_fn + "();")
        d.push("}")
        d.push("")
        let mut di: int = 0
        while di < d.len() {
            ctx.spawn_decls.push(d.get(di))
            di = di + 1
        }
        let fut_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        return "hl_future_poll_" + nid + "(" + fut_c + ")"
    }
    # future_select(futs) -> int: same as select() (futures ARE channels).
    if name == "future_select" {
        return "hl_chan_select(" + args + ")"
    }
    # ----- Stage 34 (v0.53.0-alpha): async stream builtins -----
    # stream_new(cap) -> Stream[T]: bounded chan.
    if name == "stream_new" {
        # Deep-scan-28 fix: inst_t() for generic instantiation parity
        # (same defect as future_poll above).
        let inner_t: str = stream_inner_t(inst_t(ctx, ctx.exprs[e].t))
        let mut rel: str = "NULL"
        if inner_t != "int" && inner_t != "float" && inner_t != "bool" {
            rel = release_fn_for(ctx, inner_t)
        }
        let cap_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        return "hl_chan_new_bounded(" + cap_c + ", " + rel + ")"
    }
    # stream_send(s, v) -> void: same as chan.send.
    if name == "stream_send" {
        let s_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        let st_t: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].args.get(0)].t)
        let et: str = stream_inner_t(st_t)
        # Deep-scan-25 fix (HIGH, soundness): this boundary used to
        # own_wrap the value (an hl_retain for borrowed composites) —
        # a retain does NOT copy, so a method-call result like
        # xs.get(0) (a borrow of the element the list still owns)
        # crossed the task boundary ALIASED: a producer mutation was
        # visible to the consumer (the exact data race the boundary
        # rule exists to prevent; the boot interpreter already
        # deep-copies here). Mirror the chan.send boundary exactly:
        # channels cross by sharing, provably-private values
        # (clone(...), str literals, fresh expression results) pass
        # raw, borrowed composites are deep-copied via hl_clone_<t>.
        let vidx: int = ctx.exprs[e].args.get(1)
        let v_c: str = gen_expr(ctx, vidx)
        let argkind: str = ctx.exprs[vidx].kind
        let is_clone_call: bool = argkind == "call" && ctx.exprs[vidx].mkey == "clone"
        let mut private_ptr: bool = is_clone_call || argkind == "str" || expr_fresh(ctx, vidx)
        if et == "int" {
            return "hl_chan_send_i64(" + s_c + ", " + v_c + ")"
        }
        if et == "float" {
            return "hl_chan_send_f64(" + s_c + ", " + v_c + ")"
        }
        if et == "bool" {
            return "hl_chan_send_i64(" + s_c + ", (" + v_c + " ? 1 : 0))"
        }
        if is_chan_t(et) {
            private_ptr = true
        }
        if private_ptr {
            return "hl_chan_send_ptr(" + s_c + ", (void*)" + v_c + ")"
        }
        let ct: str = strip_taint(et)
        register_clone(ctx, ct)
        return "hl_chan_send_ptr(" + s_c + ", (void*)" + clone_expr_for(ctx, ct, v_c) + ")"
    }
    # stream_recv(s) -> T: same as chan.recv.
    if name == "stream_recv" {
        let s_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        let inner_t: str = inst_t(ctx, ctx.exprs[e].t)
        if inner_t == "int" {
            return "hl_chan_recv_i64(" + s_c + ")"
        }
        if inner_t == "float" {
            return "hl_chan_recv_f64(" + s_c + ")"
        }
        if inner_t == "bool" {
            return "(hl_chan_recv_i64(" + s_c + ") != 0)"
        }
        return "((" + c_type(ctx, inner_t) + ")hl_chan_recv_ptr(" + s_c + "))"
    }
    # stream_try_recv(s, default) -> T: same as chan.recv_or.
    if name == "stream_try_recv" {
        let s_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        let st_t: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].args.get(0)].t)
        let et: str = stream_inner_t(st_t)
        let d_c: str = gen_expr(ctx, ctx.exprs[e].args.get(1))
        if et == "int" {
            return "hl_chan_recv_or_i64(" + s_c + ", " + d_c + ")"
        }
        if et == "float" {
            return "hl_chan_recv_or_f64(" + s_c + ", " + d_c + ")"
        }
        if et == "bool" {
            return "(hl_chan_recv_or_i64(" + s_c + ", (" + d_c + " ? 1 : 0)) != 0)"
        }
        return "((" + c_type(ctx, et) + ")hl_chan_recv_or_ptr(" + s_c + ", (void*)" + d_c + "))"
    }
    # stream_len(s) -> int: same as chan.len.
    if name == "stream_len" {
        let s_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        return "hl_chan_len(" + s_c + ")"
    }
    # stream_close(s) -> void: send the int sentinel (INT64_MIN).
    if name == "stream_close" {
        let s_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        return "hl_chan_send_i64(" + s_c + ", INT64_MIN)"
    }
    # stream_take_int(in_s, n) -> Stream[int]: spawn a worker.
    if name == "stream_take_int" {
        return gen_stream_take_int(ctx, e)
    }
    # stream_merge_int(a, b) -> Stream[int]: spawn a worker.
    if name == "stream_merge_int" {
        return gen_stream_merge_int(ctx, e)
    }
    panic("internal codegen error: unknown builtin function " + name)
    return ""
}

# gen_spawn_call — codegen for spawn(f, a1, ..., aN) after the checker
# rewrite (mkey = "spawn", mop = target fn key, args = value args).
#
# Emits per-site helpers into ctx.spawn_decls (appended to the program):
#   typedef struct { ... } hl_sa_N_t;          — the argument tuple
#   static void* hl_mkargs_N(...)              — heap-allocates + fills it
#   static void hl_tramp_N(void*, hl_task*)    — calls usf_<fn>, stores the
#                                                 result, frees the tuple
# and returns the C expression `hl_spawn(hl_tramp_N, <argbox>)`.
#
# Boundary ownership rule (the data-race-freedom hardening): every OWNED
# argument that is not provably private (a str literal, or syntactically
# clone(...)) is deep-copied at the boundary. A value returned by a user
# function may alias a binding still live in the spawning thread (HLS
# assignment is reference semantics), so the defensive clone guarantees
# no non-atomic refcount is ever touched by two threads. Channels are
# exempt: their refcount is atomic and their state is guarded by the
# runtime mutex. Primitives carry no refcount at all.
fn gen_spawn_call(ctx: Ctx, e: int) -> str {
    let fname: str = ctx.exprs[e].mop
    let tf: FnInfo = ctx.fns.get_or(fname, dummy_fn())
    # Stage 20 (v0.36.0-alpha): the trampoline calls the target
    # out-of-line — count it so LTO DCE keeps the target body.
    lto_note_call(ctx, fname)
    let n: int = ctx.spawn_n
    ctx.spawn_n = ctx.spawn_n + 1
    let nid: str = n.to_str()

    # --- call-site argument expressions (with the boundary rule) ---
    let cargs: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let aidx: int = ctx.exprs[e].args.get(i)
        let pt: str = tf.ptypes.get(i)
        let cex: str = gen_expr(ctx, aidx)
        let argkind: str = ctx.exprs[aidx].kind
        let is_clone_call: bool = argkind == "call" && ctx.exprs[aidx].mkey == "clone"
        let mut bound: str = cex
        if pt == "int" || pt == "float" || pt == "bool" {
            # Copy primitives — no refcount, share freely.
            bound = cex
        } else if is_chan_t(pt) {
            # Channels cross by sharing (atomic refcount).
            bound = cex
        } else if is_clone_call || argkind == "str" || expr_fresh(ctx, aidx) {
            # clone(...) is already a private deep copy; a str literal is
            # a fresh allocation; and any FRESH expression result is
            # provably private (user fns return hl_retain-ed values — the
            # callee's return wrapper adds the retain; concats/to_str/
            # literals allocate). Deep-scan-10 fix: fresh values were
            # previously defensively cloned and the fresh original never
            # released — a leak on every spawn(f, a + b).
            bound = cex
        } else {
            # Borrowed composites (list.get(i) results, ...): defensive
            # deep copy at the boundary — the value may be aliased by
            # the spawner's container.
            bound = clone_expr_for(ctx, pt, cex)
        }
        cargs.push(bound)
        i = i + 1
    }

    # --- emit the top-level helpers ---
    let d: list[str] = []
    let sname: str = "hl_sa_" + nid + "_t"
    let cparams: list[str] = []
    let fields: list[str] = []
    let mut k: int = 0
    while k < tf.ptypes.len() {
        let pct: str = c_type(ctx, tf.ptypes.get(k))
        cparams.push(pct + " a" + k.to_str())
        fields.push("    " + pct + " f" + k.to_str() + ";")
        k = k + 1
    }
    if tf.ptypes.len() > 0 {
        d.push("typedef struct {")
        d.push(join(fields, "\n"))
        d.push("} " + sname + ";")
        d.push("static void* hl_mkargs_" + nid + "(" + join(cparams, ", ") + ") {")
        d.push("    " + sname + "* p = (" + sname + "*)malloc(sizeof(" + sname + "));")
        d.push("    if (!p) hl_die(\"out of memory\");")
        let mut m: int = 0
        while m < tf.ptypes.len() {
            d.push("    p->f" + m.to_str() + " = a" + m.to_str() + ";")
            m = m + 1
        }
        d.push("    return (void*)p;")
        d.push("}")
    }
    # The trampoline: call the target with the struct fields (raw — the
    # checker guaranteed each C value is owned; params own one retain),
    # free the tuple shell, then publish the result.
    d.push("static void hl_tramp_" + nid + "(void* pv, hl_task* t) {")
    let ret: str = tf.ret
    let mut arglist: list[str] = []
    let mut q: int = 0
    while q < tf.ptypes.len() {
        arglist.push("a->f" + q.to_str())
        q = q + 1
    }
    let callname: str = "usf_" + c_fn_name(fname) + "(" + join(arglist, ", ") + ")"
    if tf.ptypes.len() == 0 {
        if ret == "void" {
            d.push("    (void)pv;")
            d.push("    " + callname + ";")
            d.push("    hl_task_finish_ptr(t, NULL);")
        } else if ret == "int" || ret == "bool" {
            d.push("    (void)pv;")
            d.push("    int64_t r = " + callname + ";")
            d.push("    hl_task_finish_i64(t, r);")
        } else if ret == "float" {
            d.push("    (void)pv;")
            d.push("    double r = " + callname + ";")
            d.push("    hl_task_finish_f64(t, r);")
        } else {
            d.push("    (void)pv;")
            d.push("    void* r = (void*)" + callname + ";")
            d.push("    hl_task_finish_ptr(t, r);")
        }
    } else {
        d.push("    " + sname + "* a = (" + sname + "*)pv;")
        if ret == "void" {
            d.push("    " + callname + ";")
            d.push("    free(a);")
            d.push("    hl_task_finish_ptr(t, NULL);")
        } else if ret == "int" || ret == "bool" {
            d.push("    int64_t r = " + callname + ";")
            d.push("    free(a);")
            d.push("    hl_task_finish_i64(t, r);")
        } else if ret == "float" {
            d.push("    double r = " + callname + ";")
            d.push("    free(a);")
            d.push("    hl_task_finish_f64(t, r);")
        } else {
            d.push("    void* r = (void*)" + callname + ";")
            d.push("    free(a);")
            d.push("    hl_task_finish_ptr(t, r);")
        }
    }
    d.push("}")
    d.push("")
    let mut di: int = 0
    while di < d.len() {
        ctx.spawn_decls.push(d.get(di))
        di = di + 1
    }

    # --- the call-site expression ---
    if tf.ptypes.len() == 0 {
        return "hl_spawn(hl_tramp_" + nid + ", NULL)"
    }
    return "hl_spawn(hl_tramp_" + nid + ", hl_mkargs_" + nid + "(" + join(cargs, ", ") + "))"
}

# Stage 33 (v0.52.0-alpha): gen_async_spawn_call — codegen for
# async_spawn(f, args...) -> Future[T]. Mirrors gen_spawn_call but:
#   - the trampoline sends the result on a cap-1 bounded channel instead
#     of calling hl_task_finish;
#   - the call site creates the channel and passes it as an extra arg;
#   - the return value is the channel (typed as Future[T]).
# The trampoline signature is (void* argbox) — no hl_task* parameter,
# because async tasks don't have a join handle (the caller awaits the
# future, not joins a task).
fn gen_async_spawn_call(ctx: Ctx, e: int) -> str {
    let fname: str = ctx.exprs[e].mop
    let tf: FnInfo = ctx.fns.get_or(fname, dummy_fn())
    lto_note_call(ctx, fname)
    let n: int = ctx.spawn_n
    ctx.spawn_n = ctx.spawn_n + 1
    let nid: str = n.to_str()
    # --- call-site argument expressions (with the boundary rule) ---
    let cargs: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let aidx: int = ctx.exprs[e].args.get(i)
        let pt: str = tf.ptypes.get(i)
        let cex: str = gen_expr(ctx, aidx)
        let argkind: str = ctx.exprs[aidx].kind
        let is_clone_call: bool = argkind == "call" && ctx.exprs[aidx].mkey == "clone"
        let mut bound: str = cex
        if pt == "int" || pt == "float" || pt == "bool" {
            bound = cex
        } else if is_chan_t(pt) || is_future_t(pt) || is_stream_t(pt) {
            bound = cex
        } else if is_clone_call || argkind == "str" || expr_fresh(ctx, aidx) {
            bound = cex
        } else {
            bound = clone_expr_for(ctx, pt, cex)
        }
        cargs.push(bound)
        i = i + 1
    }
    # --- emit the top-level helpers ---
    let ret: str = tf.ret
    let mut send_fn: str = "hl_chan_send_i64"
    let mut result_cast: str = ""
    if ret == "int" {
        send_fn = "hl_chan_send_i64"
    } else if ret == "float" {
        send_fn = "hl_chan_send_f64"
    } else if ret == "bool" {
        send_fn = "hl_chan_send_i64"
        result_cast = " ? 1 : 0"
    } else {
        send_fn = "hl_chan_send_ptr"
        result_cast = "(void*)"
    }
    # The argbox struct: the user's args + a hl_chan* (the result channel).
    let d: list[str] = []
    let sname: str = "hl_asa_" + nid + "_t"
    let mk_cparams: list[str] = ["hl_chan* res"]
    let fields: list[str] = ["    hl_chan* res;"]
    let mut k: int = 0
    while k < tf.ptypes.len() {
        let pct: str = c_type(ctx, tf.ptypes.get(k))
        mk_cparams.push(pct + " a" + k.to_str())
        fields.push("    " + pct + " f" + k.to_str() + ";")
        k = k + 1
    }
    d.push("typedef struct {")
    d.push(join(fields, "\n"))
    d.push("} " + sname + ";")
    d.push("static void* hl_mkargs_async_" + nid + "(" + join(mk_cparams, ", ") + ") {")
    d.push("    " + sname + "* p = (" + sname + "*)malloc(sizeof(" + sname + "));")
    d.push("    if (!p) hl_die(\"out of memory\");")
    d.push("    p->res = res;")
    let mut m: int = 0
    while m < tf.ptypes.len() {
        d.push("    p->f" + m.to_str() + " = a" + m.to_str() + ";")
        m = m + 1
    }
    d.push("    return (void*)p;")
    d.push("}")
    # The trampoline: call the target, send result on res channel, free.
    d.push("static void hl_atramp_" + nid + "(void* pv) {")
    d.push("    " + sname + "* a = (" + sname + "*)pv;")
    let arglist: list[str] = []
    let mut q: int = 0
    while q < tf.ptypes.len() {
        arglist.push("a->f" + q.to_str())
        q = q + 1
    }
    let callname: str = "usf_" + c_fn_name(fname) + "(" + join(arglist, ", ") + ")"
    if ret == "void" {
        # Should not happen (checker rejects), but handle defensively.
        d.push("    " + callname + ";")
        d.push("    free(a);")
    } else if ret == "int" {
        d.push("    int64_t r = " + callname + ";")
        d.push("    " + send_fn + "(a->res, r);")
        d.push("    free(a);")
    } else if ret == "float" {
        d.push("    double r = " + callname + ";")
        d.push("    " + send_fn + "(a->res, r);")
        d.push("    free(a);")
    } else if ret == "bool" {
        d.push("    bool r = " + callname + ";")
        d.push("    " + send_fn + "(a->res, r" + result_cast + ");")
        d.push("    free(a);")
    } else {
        d.push("    " + c_type(ctx, ret) + " r = " + callname + ";")
        d.push("    " + send_fn + "(a->res, " + result_cast + "r);")
        d.push("    free(a);")
    }
    d.push("}")
    d.push("")
    let mut di: int = 0
    while di < d.len() {
        ctx.spawn_decls.push(d.get(di))
        di = di + 1
    }
    # --- the call-site expression ---
    # Create the result channel (cap 1, bounded), spawn the trampoline
    # with the channel + user args, return the channel.
    let mut rel: str = "NULL"
    if ret != "int" && ret != "float" && ret != "bool" {
        rel = release_fn_for(ctx, ret)
    }
    # The wrapper takes ONLY the user's args (not res — res is created
    # inside the wrapper). It builds the argbox, spawns the trampoline,
    # and returns res.
    let wrapper: str = "hl_async_spawn_" + nid
    # Wrapper params = user args only.
    let wrap_cparams: list[str] = []
    let mut wi2: int = 0
    while wi2 < tf.ptypes.len() {
        let pct: str = c_type(ctx, tf.ptypes.get(wi2))
        wrap_cparams.push(pct + " a" + wi2.to_str())
        wi2 = wi2 + 1
    }
    let wd: list[str] = []
    wd.push("static hl_chan* " + wrapper + "(" + join(wrap_cparams, ", ") + ") {")
    wd.push("    hl_chan* res = hl_chan_new_bounded(1, " + rel + ");")
    if tf.ptypes.len() == 0 {
        wd.push("    hl_async_spawn(hl_atramp_" + nid + ", NULL);")
    } else {
        # Build the arg list: "res" first, then the user args.
        let call_args: list[str] = ["res"]
        let mut ci: int = 0
        while ci < cargs.len() {
            call_args.push("a" + ci.to_str())
            ci = ci + 1
        }
        wd.push("    hl_async_spawn(hl_atramp_" + nid + ", hl_mkargs_async_" + nid + "(" + join(call_args, ", ") + "));")
    }
    wd.push("    return res;")
    wd.push("}")
    wd.push("")
    let mut wi: int = 0
    while wi < wd.len() {
        ctx.spawn_decls.push(wd.get(wi))
        wi = wi + 1
    }
    if tf.ptypes.len() == 0 {
        return wrapper + "()"
    }
    return wrapper + "(" + join(cargs, ", ") + ")"
}

# Stage 34 (v0.53.0-alpha): gen_gen_spawn_call — codegen for
# gen_spawn(f, args...) -> Stream[T]. The target takes the Stream as
# its first param; the codegen creates the stream, spawns f(stream, args),
# returns the stream.
fn gen_gen_spawn_call(ctx: Ctx, e: int) -> str {
    let fname: str = ctx.exprs[e].mop
    let tf: FnInfo = ctx.fns.get_or(fname, dummy_fn())
    lto_note_call(ctx, fname)
    let n: int = ctx.spawn_n
    ctx.spawn_n = ctx.spawn_n + 1
    let nid: str = n.to_str()
    # The stream's element type comes from the return context's expected
    # type. The checker set ctx.exprs[e].t to the Stream[T] type.
    let stream_t: str = ctx.exprs[e].t
    let elem_t: str = stream_inner_t(stream_t)
    let mut rel: str = "NULL"
    if elem_t != "int" && elem_t != "float" && elem_t != "bool" {
        rel = release_fn_for(ctx, elem_t)
    }
    # --- call-site argument expressions (boundary rule) ---
    # The user's args are tf.params[1:] (params[0] is the stream).
    let cargs: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let aidx: int = ctx.exprs[e].args.get(i)
        let pt: str = tf.ptypes.get(i + 1)
        let cex: str = gen_expr(ctx, aidx)
        let argkind: str = ctx.exprs[aidx].kind
        let is_clone_call: bool = argkind == "call" && ctx.exprs[aidx].mkey == "clone"
        let mut bound: str = cex
        if pt == "int" || pt == "float" || pt == "bool" {
            bound = cex
        } else if is_chan_t(pt) || is_future_t(pt) || is_stream_t(pt) {
            bound = cex
        } else if is_clone_call || argkind == "str" || expr_fresh(ctx, aidx) {
            bound = cex
        } else {
            bound = clone_expr_for(ctx, pt, cex)
        }
        cargs.push(bound)
        i = i + 1
    }
    # Emit a per-site wrapper that creates the stream and spawns the generator.
    let wrapper: str = "hl_gen_spawn_" + nid
    let cparams: list[str] = []
    let mut k: int = 0
    while k < tf.ptypes.len() - 1 {
        let pct: str = c_type(ctx, tf.ptypes.get(k + 1))
        cparams.push(pct + " a" + k.to_str())
        k = k + 1
    }
    let d: list[str] = []
    d.push("static hl_chan* " + wrapper + "(" + join(cparams, ", ") + ") {")
    d.push("    hl_chan* stream = hl_chan_new_bounded(16, " + rel + ");")
    # Build the argbox: stream first, then user args.
    let sname: str = "hl_gsa_" + nid + "_t"
    let fields: list[str] = ["    hl_chan* stream;"]
    let mut m: int = 0
    while m < tf.ptypes.len() - 1 {
        let pct: str = c_type(ctx, tf.ptypes.get(m + 1))
        fields.push("    " + pct + " f" + m.to_str() + ";")
        m = m + 1
    }
    d.push("    " + sname + "* a = (" + sname + "*)malloc(sizeof(" + sname + "));")
    d.push("    if (!a) hl_die(\"out of memory\");")
    d.push("    a->stream = stream;")
    let mut p: int = 0
    while p < cargs.len() {
        d.push("    a->f" + p.to_str() + " = " + cargs.get(p) + ";")
        p = p + 1
    }
    # Emit the arg struct + trampoline.
    ctx.spawn_decls.push("typedef struct {")
    ctx.spawn_decls.push(join(fields, "\n"))
    ctx.spawn_decls.push("} " + sname + ";")
    # Trampoline.
    let arglist: list[str] = ["a->stream"]
    let mut q: int = 0
    while q < tf.ptypes.len() - 1 {
        arglist.push("a->f" + q.to_str())
        q = q + 1
    }
    let callname: str = "usf_" + c_fn_name(fname) + "(" + join(arglist, ", ") + ")"
    ctx.spawn_decls.push("static void hl_gtramp_" + nid + "(void* pv) {")
    ctx.spawn_decls.push("    " + sname + "* a = (" + sname + "*)pv;")
    ctx.spawn_decls.push("    " + callname + ";")
    ctx.spawn_decls.push("    free(a);")
    ctx.spawn_decls.push("}")
    ctx.spawn_decls.push("")
    d.push("    hl_async_spawn(hl_gtramp_" + nid + ", a);")
    d.push("    return stream;")
    d.push("}")
    d.push("")
    let mut di: int = 0
    while di < d.len() {
        ctx.spawn_decls.push(d.get(di))
        di = di + 1
    }
    if cargs.len() == 0 {
        return wrapper + "()"
    }
    return wrapper + "(" + join(cargs, ", ") + ")"
}

# Stage 34: gen_stream_combinator — codegen for stream_map_int /
# stream_filter_int / stream_fold_int / stream_flat_map_int.
# For map/filter/flat_map: creates an output stream, spawns a worker that
#   reads from in_stream, applies fn_name, writes to out_stream.
# For fold: emits an inline loop that drains in_stream and applies fn_name.
fn gen_stream_combinator(ctx: Ctx, e: int, name: str) -> str {
    let fname: str = ctx.exprs[e].mop
    lto_note_call(ctx, fname)
    let in_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
    if name == "stream_fold_int" {
        # Blocking fold: emit an inline block-expression.
        # The fold fn has signature fn(int, int) -> int; we call it as
        # usf_<fname>(acc, v).
        let init_c: str = gen_expr(ctx, ctx.exprs[e].args.get(1))
        # Emit a per-site helper that does the fold loop.
        let n: int = ctx.spawn_n
        ctx.spawn_n = ctx.spawn_n + 1
        let nid: str = n.to_str()
        let helper: str = "hl_stream_fold_" + nid
        let d: list[str] = []
        d.push("static int64_t " + helper + "(hl_chan* in_s, int64_t init) {")
        d.push("    int64_t acc = init;")
        d.push("    while (1) {")
        d.push("        int64_t v = hl_chan_recv_i64(in_s);")
        d.push("        if (v == INT64_MIN) break;")
        d.push("        acc = usf_" + c_fn_name(fname) + "(acc, v);")
        d.push("    }")
        d.push("    return acc;")
        d.push("}")
        d.push("")
        let mut di: int = 0
        while di < d.len() {
            ctx.spawn_decls.push(d.get(di))
            di = di + 1
        }
        return helper + "(" + in_c + ", " + init_c + ")"
    }
    # map / filter / flat_map: create output stream, spawn a worker.
    let n: int = ctx.spawn_n
    ctx.spawn_n = ctx.spawn_n + 1
    let nid: str = n.to_str()
    let worker: str = "hl_stream_worker_" + nid
    let d: list[str] = []
    d.push("static void " + worker + "(hl_chan* in_s, hl_chan* out_s) {")
    if name == "stream_map_int" {
        d.push("    while (1) {")
        d.push("        int64_t v = hl_chan_recv_i64(in_s);")
        d.push("        if (v == INT64_MIN) { hl_chan_send_i64(out_s, INT64_MIN); return; }")
        d.push("        int64_t r = usf_" + c_fn_name(fname) + "(v);")
        d.push("        hl_chan_send_i64(out_s, r);")
        d.push("    }")
    } else if name == "stream_filter_int" {
        d.push("    while (1) {")
        d.push("        int64_t v = hl_chan_recv_i64(in_s);")
        d.push("        if (v == INT64_MIN) { hl_chan_send_i64(out_s, INT64_MIN); return; }")
        d.push("        if (usf_" + c_fn_name(fname) + "(v)) { hl_chan_send_i64(out_s, v); }")
        d.push("    }")
    } else if name == "stream_flat_map_int" {
        d.push("    while (1) {")
        d.push("        int64_t v = hl_chan_recv_i64(in_s);")
        d.push("        if (v == INT64_MIN) { hl_chan_send_i64(out_s, INT64_MIN); return; }")
        d.push("        hl_chan* inner = (hl_chan*)usf_" + c_fn_name(fname) + "(v);")
        d.push("        while (1) {")
        d.push("            int64_t iv = hl_chan_recv_i64(inner);")
        d.push("            if (iv == INT64_MIN) break;")
        d.push("            hl_chan_send_i64(out_s, iv);")
        d.push("        }")
        d.push("    }")
    }
    d.push("}")
    d.push("")
    let mut di: int = 0
    while di < d.len() {
        ctx.spawn_decls.push(d.get(di))
        di = di + 1
    }
    # Emit the call-site wrapper that creates out_s + spawns the worker.
    let wrapper: str = "hl_stream_comb_" + nid
    let wd: list[str] = []
    wd.push("static hl_chan* " + wrapper + "(hl_chan* in_s) {")
    wd.push("    hl_chan* out_s = hl_chan_new_bounded(16, NULL);")
    wd.push("    hl_async_spawn_stream(" + worker + ", in_s, out_s);")
    wd.push("    return out_s;")
    wd.push("}")
    wd.push("")
    let mut wi: int = 0
    while wi < wd.len() {
        ctx.spawn_decls.push(wd.get(wi))
        wi = wi + 1
    }
    return wrapper + "(" + in_c + ")"
}

# Stage 34: gen_stream_take_int — codegen for stream_take_int(in_s, n).
fn gen_stream_take_int(ctx: Ctx, e: int) -> str {
    let in_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
    let n_c: str = gen_expr(ctx, ctx.exprs[e].args.get(1))
    let n: int = ctx.spawn_n
    ctx.spawn_n = ctx.spawn_n + 1
    let nid: str = n.to_str()
    let worker: str = "hl_stream_take_worker_" + nid
    let wrapper: str = "hl_stream_take_" + nid
    let d: list[str] = []
    d.push("static void " + worker + "(hl_chan* in_s, hl_chan* out_s, int64_t n) {")
    d.push("    int64_t count = 0;")
    d.push("    while (count < n) {")
    d.push("        int64_t v = hl_chan_recv_i64(in_s);")
    d.push("        if (v == INT64_MIN) break;")
    d.push("        hl_chan_send_i64(out_s, v);")
    d.push("        count++;")
    d.push("    }")
    d.push("    hl_chan_send_i64(out_s, INT64_MIN);")
    d.push("}")
    d.push("")
    d.push("static hl_chan* " + wrapper + "(hl_chan* in_s, int64_t n) {")
    d.push("    hl_chan* out_s = hl_chan_new_bounded(16, NULL);")
    d.push("    hl_async_spawn_take(" + worker + ", in_s, out_s, n);")
    d.push("    return out_s;")
    d.push("}")
    d.push("")
    let mut di: int = 0
    while di < d.len() {
        ctx.spawn_decls.push(d.get(di))
        di = di + 1
    }
    return wrapper + "(" + in_c + ", " + n_c + ")"
}

# Stage 34: gen_stream_merge_int — codegen for stream_merge_int(a, b).
fn gen_stream_merge_int(ctx: Ctx, e: int) -> str {
    let a_c: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
    let b_c: str = gen_expr(ctx, ctx.exprs[e].args.get(1))
    let n: int = ctx.spawn_n
    ctx.spawn_n = ctx.spawn_n + 1
    let nid: str = n.to_str()
    let worker: str = "hl_stream_merge_worker_" + nid
    let wrapper: str = "hl_stream_merge_" + nid
    let d: list[str] = []
    d.push("static void " + worker + "(hl_chan* a, hl_chan* b, hl_chan* out_s) {")
    d.push("    int a_done = 0, b_done = 0;")
    d.push("    while (!a_done || !b_done) {")
    d.push("        if (!a_done) {")
    d.push("            int64_t v = hl_chan_recv_i64(a);")
    d.push("            if (v == INT64_MIN) a_done = 1;")
    d.push("            else hl_chan_send_i64(out_s, v);")
    d.push("        }")
    d.push("        if (!b_done) {")
    d.push("            int64_t v = hl_chan_recv_i64(b);")
    d.push("            if (v == INT64_MIN) b_done = 1;")
    d.push("            else hl_chan_send_i64(out_s, v);")
    d.push("        }")
    d.push("    }")
    d.push("    hl_chan_send_i64(out_s, INT64_MIN);")
    d.push("}")
    d.push("")
    d.push("static hl_chan* " + wrapper + "(hl_chan* a, hl_chan* b) {")
    d.push("    hl_chan* out_s = hl_chan_new_bounded(16, NULL);")
    d.push("    hl_async_spawn_merge(" + worker + ", a, b, out_s);")
    d.push("    return out_s;")
    d.push("}")
    d.push("")
    let mut di: int = 0
    while di < d.len() {
        ctx.spawn_decls.push(d.get(di))
        di = di + 1
    }
    return wrapper + "(" + a_c + ", " + b_c + ")"
}
