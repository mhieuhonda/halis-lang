# ============================================================================
# hlc/bootheader.hls — part of the hlc compiler.
# Section 5h — the boot-protocol headers a `#![boot_header(...)]` crate
# emits into its image (Stage 85, v0.104.0-alpha).
# ----------------------------------------------------------------------------
# A firmware finds a Halis kernel the same way it finds any other kernel:
# it scans the loaded image for a known byte pattern. Multiboot2 looks
# for the 32-bit magic 0xE85250D6 on an 8-byte boundary; Limine looks for
# a request list delimited by its own two-word end marker. Neither is
# reachable by a call, so both blobs are `used` as well as `const
# volatile` — under --gc-sections, which every freestanding link in this
# repo uses, an un-`used` header is simply gone.
#
# The constants are written out in full rather than computed: a boot
# header is read by a bootloader, not by a program, and a kernel author
# inspecting the image with `objdump` must be able to recognise the
# bytes. `boot_header_multiboot2_lines` documents the checksum the spec
# defines (all four 32-bit header fields sum to zero).
# ============================================================================

# The Multiboot2 header: magic, i386-protected-mode architecture, total
# length, and the negated sum of those three. The length is fixed at 40
# bytes: 16 for the fixed part, 16 for the module tag, 8 for the end tag.
fn mb2_magic_c() -> str {
    return "0xE85250D6u"
}

fn mb2_arch_c() -> str {
    return "0u"
}

fn mb2_len_c() -> str {
    return "40u"
}

fn mb2_csum_c() -> str {
    # 0xE85250D6 (3897708758) + 0 + 40 = 3897708798; negated modulo
    # 2^32 that is 4294967296 - 3897708798 = 397258498.
    return "397258498u"
}

fn boot_header_multiboot2_lines() -> list[str] {
    let r: list[str] = []
    r.push("")
    r.push("// ===== Stage 85: Multiboot2 header =====")
    r.push("// A firmware scans the image for the magic 0xE85250D6 on an")
    r.push("// 8-byte boundary. All four header fields sum to zero: the")
    r.push("// checksum is the negated 32-bit sum of magic + arch + length.")
    r.push("typedef struct { uint32_t magic, arch, len, csum; } hl_mb2_hdr;")
    r.push("typedef struct { uint32_t type, size; } hl_mb2_tag;")
    r.push("__attribute__((section(\".multiboot_header\"), used, aligned(8)))")
    r.push("const volatile hl_mb2_hdr hl_mb2_header = { " + mb2_magic_c() + ", " + mb2_arch_c() + ", " + mb2_len_c() + ", " + mb2_csum_c() + " };")
    r.push("// Tag 3 (module): start == end == 0 means \"the kernel is not")
    r.push("// itself a module\"; a loader that wants the image bounds")
    r.push("// reads them from the ELF program headers instead.")
    r.push("typedef struct { hl_mb2_tag t; uint32_t start, end; } hl_mb2_mod;")
    r.push("__attribute__((section(\".multiboot_header\"), used, aligned(8)))")
    r.push("const volatile hl_mb2_mod hl_mb2_module = { { 3u, 16u }, 0u, 0u };")
    r.push("// The end tag terminates the list. Every loader walks until it")
    r.push("// sees one; a header without it walks off the end of itself.")
    r.push("__attribute__((section(\".multiboot_header\"), used, aligned(8)))")
    r.push("const volatile hl_mb2_tag hl_mb2_end = { 0u, 8u };")
    return r
}

# The Limine request list. Every request ID is four 64-bit words whose
# first two are common to the whole protocol; the last two identify the
# feature. The start and end delimiters bound the search from base
# revision 2 on, so a kernel whose .rodata happens to contain a
# 64-bit constant shaped like an ID cannot confuse a loader.
fn limine_common_c() -> str {
    return "0xc7b1dd30df4c8b88UL, 0x0a82e883a194f07bUL"
}

fn boot_header_limine_lines() -> list[str] {
    let r: list[str] = []
    r.push("")
    r.push("// ===== Stage 85: Limine requests =====")
    r.push("// The bootloader scans the image for these request IDs, between")
    r.push("// the start and end delimiters. `UL` matters: half the IDs are")
    r.push("// above 2^63, and a signed literal would not compare equal.")
    r.push("__attribute__((section(\".limine_requests\"), used, aligned(8)))")
    r.push("const volatile uint64_t hl_limine_reqs[] = {")
    r.push("    /* start delimiter */")
    r.push("    0xf6b8f4b39de7d1aeUL, 0xfab91a6940fcb9cfUL,")
    r.push("    0x785c6ed015d3e316UL, 0x181e920a7852b9d9UL,")
    r.push("    /* base revision 3: request delimiters are honoured, and the")
    r.push("       HHDM maps only the compliant region types */")
    r.push("    0xf9562b2d5c95a6c8UL, 0x6a7b384944536bdcUL, 3,")
    r.push("    /* memory map */")
    r.push("    " + limine_common_c() + ", 0x67cf3d9d378a806fUL, 0xe304acdfc50c3c62UL,")
    r.push("    /* framebuffer */")
    r.push("    " + limine_common_c() + ", 0x9d5827dcd881dd75UL, 0xa3148604f6fab11bUL,")
    r.push("    /* RSDP (ACPI root pointer) */")
    r.push("    " + limine_common_c() + ", 0xc5e77b6b397e7b43UL, 0x27637845accdcf3cUL,")
    r.push("    /* HHDM (higher-half direct map offset) */")
    r.push("    " + limine_common_c() + ", 0x48dcf1cb8ad2b852UL, 0x63984e959a98244bUL,")
    r.push("    /* stack size */")
    r.push("    " + limine_common_c() + ", 0x224ef0460a8e8926UL, 0xe1cb0fc25f46ea3dUL,")
    r.push("    /* end delimiter */")
    r.push("    0xadc0e0531bb10d03UL, 0x9572709f31764c62UL,")
    r.push("};")
    return r
}

# ============================================================================
# Section 5h — the interrupt-binding table a `#[irq_handler(N)]` crate
# gets (Stage 86, v0.105.0-alpha).
# ----------------------------------------------------------------------------
# A CPU enters a handler through an IDT gate, and a gate holds a 32-bit
# offset. A gate therefore CANNOT be a static initialiser: the handler's
# address is not a constant expression, which is why every kernel in
# every language fills its IDT at runtime.
#
# What the compiler CAN do — and what `#[irq_handler(N)]` makes it do —
# is publish the BINDINGS: which Halis function services which vector,
# with which IST. `hl_idt_bindings` is that table, and
# `hl_idt_install` turns it into gates and loads the IDTR. The kernel
# calls one function at boot and never writes a descriptor by hand.
#
# `used` matters as much here as on a boot header: nothing calls the
# table, and `--gc-sections` would drop exactly the rows a kernel needs.
# ============================================================================

# irq_table_lines: the binding table plus the installer, emitted only
# when the program actually declares a vector.
fn irq_table_lines(ctx: Ctx) -> list[str] {
    let r: list[str] = []
    r.push("")
    r.push("// ===== Stage 86: interrupt bindings (#[irq_handler(N)]) =====")
    r.push("// A gate holds a 32-bit offset, so an IDT cannot be a static")
    r.push("// initialiser — the handler's address is not a constant")
    r.push("// expression. What CAN be static is the BINDING, so the")
    r.push("// kernel calls hl_idt_install() once and never writes a")
    r.push("// descriptor by hand.")
    r.push("typedef void (*hl_irq_fn)(void *frame);")
    r.push("struct hl_irq_binding { uint32_t vector; uint32_t ist; hl_irq_fn handler; };")
    r.push("")
    r.push("static struct hl_idt_desc { uint16_t off_lo, sel; uint8_t ist, type_attr; uint16_t off_mid; uint32_t off_hi, zero; } hl_idt[256];")
    r.push("static struct hl_idt_ptr { uint16_t limit; uint64_t base; } __attribute__((packed)) hl_idtr;")
    r.push("")
    r.push("// hl_idt_install: build the gates for every binding and load")
    r.push("// the IDTR. `cs` is the kernel's code selector; pass the one")
    r.push("// from the GDT the kernel installed (the 8259-era 0x08 is")
    r.push("// right only if the GDT says so). An interrupt gate (0x8E)")
    r.push("// CLEARS IF on entry, so a fault inside a handler faults;")
    r.push("// pass 0x8F for a trap gate when a handler must stay")
    r.push("// maskable. A row with a NULL handler is skipped, so a")
    r.push("// reserved vector stays reserved.")
    r.push("void hl_idt_install(const struct hl_irq_binding *b, uint32_t n, uint16_t cs) {")
    r.push("    for (uint32_t i = 0; i < n; i++) {")
    r.push("        if (b[i].handler == NULL) continue;")
    r.push("        uint64_t a = (uint64_t)(void *)b[i].handler;")
    r.push("        hl_idt[b[i].vector].off_lo    = (uint16_t)(a & 0xffff);")
    r.push("        hl_idt[b[i].vector].sel       = cs;")
    r.push("        hl_idt[b[i].vector].ist       = (uint8_t)(b[i].ist & 7);")
    r.push("        hl_idt[b[i].vector].type_attr = (uint8_t)(0x8E | ((b[i].ist & 7) << 0) | (uint16_t)0);")
    r.push("        hl_idt[b[i].vector].off_mid   = (uint16_t)((a >> 16) & 0xffff);")
    r.push("        hl_idt[b[i].vector].off_hi    = (uint32_t)((a >> 32) & 0xffffffff);")
    r.push("        hl_idt[b[i].vector].zero      = 0;")
    r.push("    }")
    r.push("    hl_idtr.limit = sizeof(hl_idt) - 1;")
    r.push("    hl_idtr.base  = (uint64_t)(void *)hl_idt;")
    r.push("    __asm__ volatile (\"lidt %0\" :: \"m\"(hl_idtr));")
    r.push("}")
    r.push("")
    r.push("// The stub per vector. gcc's `interrupt` attribute cannot be")
    r.push("// used on a Halis function: a compiler-generated body uses")
    r.push("// SSE (the frame is passed in a vector register, cleanup code")
    r.push("// spills with movaps), and gcc REJECTS SSE inside an")
    r.push("// interrupt service routine. So the save/restore lives here,")
    r.push("// in asm, where it belongs, and the Halis function is an")
    r.push("// ordinary C function the stub CALLS.")
    r.push("//")
    r.push("// The push order is the reverse of the pop the runtime does,")
    r.push("// so `add $88, %rsp` + iretq is correct: RSP on entry points")
    r.push("// at the saved RIP, and iretq consumes RIP/CS/RFLAGS from")
    r.push("// there. Callee-saved registers (rbx, rbp, r12-r15) are")
    r.push("// deliberately NOT touched: the callee preserves them.")
    let mut si: int = 0
    while si < ctx.fn_order.len() {
        let skey: str = ctx.fn_order.get(si)
        let sf: FnInfo = ctx.fns.get_or(skey, dummy_fn())
        if sf.attr_irq_vector >= 0 {
            let cname: str = "usf_" + c_fn_name(skey)
            let stub: str = "hl_irq_stub_" + sf.attr_irq_vector.to_str()
            let with_err: bool = sf.attr_irq_vector == 8 || sf.attr_irq_vector == 10
                || sf.attr_irq_vector == 11 || sf.attr_irq_vector == 12
                || sf.attr_irq_vector == 13 || sf.attr_irq_vector == 14
                || sf.attr_irq_vector == 17 || sf.attr_irq_vector == 21
            # The dummy parameter is never read (the stub sets %rdi
            # itself, from %rsp); it is there so the stub's type
            # matches the binding table's function-pointer type, which
            # gcc would otherwise warn about.
            r.push("__attribute__((naked, used))")
            r.push("void " + stub + "(void *unused) {")
            r.push("    __asm__ volatile (")
            r.push("        \"pushq %rax\\n\" \"pushq %rbx\\n\" \"pushq %rcx\\n\" \"pushq %rdx\\n\"")
            r.push("        \"pushq %rsi\\n\" \"pushq %rdi\\n\" \"pushq %rbp\\n\" \"pushq %r8\\n\"")
            r.push("        \"pushq %r9\\n\" \"pushq %r10\\n\" \"pushq %r11\\n\"")
            if with_err {
                r.push("        \"movl $" + sf.attr_irq_vector.to_str() + ", %eax\\n\"")
            }
            r.push("        \"movq %rsp, %rdi\\n\"")
            r.push("        \"call " + cname + "\\n\"")
            r.push("        \"addq $88, %rsp\\n\"")
            r.push("        \"iretq\\n\");")
            r.push("}")
        }
        si = si + 1
    }
    r.push("")
    r.push("__attribute__((used))")
    r.push("const struct hl_irq_binding hl_idt_bindings[] = {")
    let mut i: int = 0
    let mut first: bool = true
    while i < ctx.fn_order.len() {
        let key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if f.attr_irq_vector >= 0 {
            # The C function name for a method keeps the mangling the
            # rest of the backend uses; an `#[irq_handler]` is always a
            # top-level fn (the checker rejects a method), so this is
            # just the plain prefix.
            let cname: str = "usf_" + c_fn_name(key)
            if !first {
                r.push(",")
            }
            first = false
            # The gate points at the STUB, not at the Halis function:
            # the stub is what returns with IRETQ.
            r.push("    { " + f.attr_irq_vector.to_str() + "u, 0u, hl_irq_stub_"
                + f.attr_irq_vector.to_str() + " }")
        }
        i = i + 1
    }
    r.push(",")
    r.push("    { 0u, 0u, NULL }   // terminator")
    r.push("};")
    return r
}

# irq_count: how many functions in the program declared a vector. The
# codegen emits the table only when this is non-zero.
fn irq_count(ctx: Ctx) -> int {
    let mut n: int = 0
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let f: FnInfo = ctx.fns.get_or(ctx.fn_order.get(i), dummy_fn())
        if f.attr_irq_vector >= 0 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}
