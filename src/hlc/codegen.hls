# ============================================================================
# hlc/codegen.hls — part of the hlc compiler (split from the original single-file
# src/hlc.hls). This file is loaded via `import "hlc/codegen.hls"` from src/hlc.hls.
# Section 5a — CODEGEN: C types, name mangling, literals, stack layout, hoisting, ownership args.
# NOTE: content is byte-identical to the original src/hlc.hls line range
#       12652..13687 - module split is purely structural, zero code changes.
# ============================================================================
# 5. CODEGEN — HLS -> C
# ----------------------------------------------------------------------------

fn c_type(ctx: Ctx, t_in: str) -> str {
    # Substitute type params from current instantiation context.
    let mut t: str = t_in
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        t = instantiate_type(t, ctx.cur_typeparams, ctx.cur_targs)
    }
    if t == "int" {
        return "int64_t"
    }
    if t == "float" {
        return "double"
    }
    if t == "bool" {
        return "bool"
    }
    if t == "str" {
        return "hl_str*"
    }
    if t == "void" {
        return "void"
    }
    if is_list_t(t) {
        return "hl_list*"
    }
    if is_map_t(t) {
        return "hl_map*"
    }
    if is_taint_t(t) {
        # Stage 10-alpha: at the C level, a tainted[T] is represented the
        # same as T — the taint is a compile-time property only, enforced
        # by the checker's taint-sink rule. Runtime distinction (e.g. a
        # taint flag carried at runtime) is deferred to Stage 10-beta.
        return c_type(ctx, taint_inner_t(t))
    }
    # Stage 16 (v0.27.0-alpha): concurrency wrappers.
    if is_chan_t(t) {
        return "hl_chan*"
    }
    if is_task_t(t) {
        return "hl_task*"
    }
    # Stage 33 (v0.52.0-alpha): Future[T] — runtime is a hl_chan* (cap 1).
    # Stage 34 (v0.53.0-alpha): Stream[T] — runtime is a hl_chan* (cap N).
    if is_future_t(t) || is_stream_t(t) {
        return "hl_chan*"
    }
    return c_type_name(t) + "*"
}

fn is_ptr_type(t: str) -> bool {
    if t == "int" || t == "float" || t == "bool" || t == "void" {
        return false
    }
    if is_taint_t(t) {
        # tainted[T] is a pointer iff T is.
        return is_ptr_type(taint_inner_t(t))
    }
    if is_chan_t(t) || is_task_t(t) {
        # Stage 16: channels and task handles are heap objects.
        return true
    }
    # Stage 33/34: Future[T] and Stream[T] are heap objects (channels).
    if is_future_t(t) || is_stream_t(t) {
        return true
    }
    return true
}

fn box_fn_for(t: str) -> str {
    # Stage 27 perfection (v0.50.3-alpha) deep-scan-18: BUG-01 fix.
    # Strip the tainted[...] wrapper before dispatching. A tainted[int]
    # is represented at the C level as int64_t (c_type unwraps taint),
    # so its box/unbox helpers are the int helpers — NOT hl_box_ptr.
    # Without this fix, list[tainted[int]].get(i) / chan[tainted[int]].send(v)
    # / map[str, tainted[int]].get_or(...) emit hl_box_ptr / hl_unbox_ptr
    # on a value that is semantically an int64_t — undefined behaviour
    # (type punning through the wrong box field) and wrong values on any
    # platform where the box layout differs between int and pointer slots.
    let inner: str = strip_taint(t)
    if inner == "int" {
        return "hl_box_i64"
    }
    if inner == "float" {
        return "hl_box_f64"
    }
    if inner == "bool" {
        return "hl_box_bool"
    }
    return "hl_box_ptr"
}

fn gen_unbox(ctx: Ctx, t: str, cexpr: str) -> str {
    # Stage 27 perfection (v0.50.3-alpha) deep-scan-18: BUG-01 fix.
    # Mirror of box_fn_for — strip taint before dispatching.
    let inner: str = strip_taint(t)
    if inner == "int" {
        return "hl_unbox_i64(" + cexpr + ")"
    }
    if inner == "float" {
        return "hl_unbox_f64(" + cexpr + ")"
    }
    if inner == "bool" {
        return "hl_unbox_bool(" + cexpr + ")"
    }
    return "(" + c_type(ctx, t) + ")hl_unbox_ptr(" + cexpr + ")"
}

fn box_val(t: str, cexpr: str) -> str {
    return box_fn_for(t) + "(" + cexpr + ")"
}

# c_type_name(t) — mangle a HLS type name into a valid C identifier.
# Used for both user types and their generic instantiations.
# Examples:
#   "Point"            -> "Point"
#   "Box[int]"         -> "Box__int"
#   "Pair[int, str]"   -> "Pair__int__str"
#   "Option[list[int]]" -> "Option__list_int_"
#   "Foo[A, B, C]"     -> "Foo__A__B__C"  (only when A, B, C are already-bound type args)
fn c_type_name(t: str) -> str {
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    if args.len() == 0 {
        return base
    }
    let mut out: str = base + "__"
    let mut i: int = 0
    while i < args.len() {
        if i > 0 {
            out = out + "__"
        }
        out = out + c_type_name(args.get(i))
        i = i + 1
    }
    return out
}

# c_fn_name(key) — mangle a HLS function key into a C identifier.
# "foo" -> "foo"; "Point.dist" -> "Point_dist"
fn c_fn_name(key: str) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < key.len() {
        if key.byte_at(i) == 46 {
            parts.push("_")
        } else {
            parts.push(key.slice(i, i + 1))
        }
        i = i + 1
    }
    return join(parts, "")
}

# c_mangled_fn_name(key, targs) — mangle a generic function call's
# instantiation: identity[int] -> "identity__int"
fn c_mangled_fn_name(key: str, tps: list[str], targs: list[str]) -> str {
    if tps.len() == 0 {
        return c_fn_name(key)
    }
    let mut out: str = c_fn_name(key) + "__"
    let mut i: int = 0
    while i < targs.len() {
        if i > 0 {
            out = out + "__"
        }
        out = out + c_type_name(targs.get(i))
        i = i + 1
    }
    return out
}

fn c_str_lit(s: str) -> str {
    let mut out: str = "hl_cstr(\""
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b == 34 {
            out = out + "\\\""
        } else if b == 92 {
            out = out + "\\\\"
        } else if b == 10 {
            out = out + "\\n"
        } else if b == 9 {
            out = out + "\\t"
        } else if b >= 32 && b <= 126 {
            out = out + s.slice(i, i + 1)
        } else {
            let o: int = b
            let d1: int = o / 64
            let d2: int = (o / 8) % 8
            let d3: int = o % 8
            out = out + "\\" + chr(48 + d1) + chr(48 + d2) + chr(48 + d3)
        }
        i = i + 1
    }
    return out + "\")"
}

fn fresh_local(ctx: Ctx, name: str) -> str {
    if !ctx.gen_counts.has(name) {
        ctx.gen_counts.set(name, 1)
        ctx.gen_locals.set(name, "u_" + name)
        return "u_" + name
    }
    let n: int = ctx.gen_counts.get_or(name, 1)
    ctx.gen_counts.set(name, n + 1)
    let cname: str = "u_" + name + "_" + (n + 1).to_str()
    ctx.gen_locals.set(name, cname)
    return cname
}

fn fresh_tmp(ctx: Ctx, base: str) -> str {
    ctx.tmp = ctx.tmp + 1
    return base + "_" + ctx.tmp.to_str()
}

fn local_c(ctx: Ctx, name: str) -> str {
    let cn: str = ctx.gen_locals.get_or(name, "")
    if cn == "" {
        panic("internal codegen error: variable not found " + name)
    }
    return cn
}

# c_field_name(name) — mangle a HLS struct field name into a valid C
# identifier. HLS allows field names that collide with C reserved
# words (long, short, int, char, double, float, default, void,
# unsigned, signed, register, volatile, const, static, extern, auto,
# break, case, continue, do, else, for, goto, if, return, sizeof,
# struct, switch, typedef, union, while, inline, restrict, _Bool,
# _Complex, _Imaginary). The C codegen would fail to compile if
# these were emitted verbatim as field names. We prefix ALL field
# names with "f_" uniformly — every field declaration, field access,
# field assignment, constructor parameter, release call, and clone
# call uses c_field_name — so the mangling is invisible to the HLS
# source (the HLS code still writes `obj.long`, the C code uses
# `obj->f_long`).
#
# This fixes a HIGH-severity soundness bug discovered during the
# Stage 53 deep scan: a struct field named `long` or `short` (which
# are perfectly valid HLS identifiers) produced C code that failed
# to compile with errors like "expected identifier or '(' before
# 'long'". The fix is uniform mangling — no field name can collide
# with a C keyword, ever.
#
# Stage 53 deep-scan fix (HIGH severity).
fn c_field_name(name: str) -> str {
    return "f_" + name
}

# ============================================================================
# STAGE 30 (v0.47.0-alpha): stack-layout codegen helpers
# ============================================================================
# The escape analysis (escape_check_fn, run during checking) recorded its
# decisions in ctx.layout_map keyed "<fn key>::<binding>". The codegen
# consults them at five sites: the let statement (emit the typed array),
# the builtin list methods (.get/.set/.len), the index expression
# (xs[i] read), the for-in loop, and the index assignment (xs[i] = v).

# is_stack_var: is `name` a stack-allocated binding of the CURRENT
# function? Suppressed inside LTO inline clones: layout keys are per
# SOURCE function, and an inlined callee body generated under the
# caller's cur_fn would resolve the caller's same-named binding — the
# wrong key. Inlined bodies always use the (sound) heap layout.
fn is_stack_var(ctx: Ctx, name: str) -> bool {
    if ctx.in_inline_clone > 0 {
        return false
    }
    if ctx.cur_fn == "" {
        return false
    }
    return ctx.layout_map.get_or(ctx.cur_fn + "::" + name, "") == "stack"
}

# stack_cap_of: the fixed capacity of the current function's stack
# binding `name` (the literal length recorded by the analysis).
fn stack_cap_of(ctx: Ctx, name: str) -> int {
    return ctx.layout_cap.get_or(ctx.cur_fn + "::" + name, 0)
}

# stack_elem_suffix: the C accessor suffix for an element type —
# hlc_sg_i64 / hlc_ss_f64 / hlc_sg_bool etc.
fn stack_elem_suffix(elem: str) -> str {
    if elem == "int" {
        return "i64"
    }
    if elem == "float" {
        return "f64"
    }
    return "bool"
}

# stack_layout_helper_lines: the per-program C accessors for
# stack-allocated lists. Bounds-checked with the SAME panic message as
# hl_list_get / hl_list_set ("array access out of bounds") so a
# stack-layout program is observably identical to the boxed one. The
# helpers are `static inline` (gcc does not warn about unused static
# inline functions) and are emitted only when at least one binding is
# stack-allocated (ctx.layout_stack_n > 0).
fn stack_layout_helper_lines() -> list[str] {
    let r: list[str] = []
    r.push("// ---- Stage 30 (v0.47.0-alpha): stack-layout accessors ----")
    r.push("// Bounds-checked typed accessors for stack-allocated lists. The")
    r.push("// panic message matches hl_list_get/hl_list_set exactly, so the")
    r.push("// stack layout is observably identical to the boxed layout.")
    r.push("static inline int64_t hlc_sg_i64(const int64_t* a, int64_t i, int64_t n) {")
    r.push("    if (i < 0 || i >= n) hl_die(\"array access out of bounds\");")
    r.push("    return a[i];")
    r.push("}")
    r.push("static inline void hlc_ss_i64(int64_t* a, int64_t i, int64_t n, int64_t v) {")
    r.push("    if (i < 0 || i >= n) hl_die(\"array access out of bounds\");")
    r.push("    a[i] = v;")
    r.push("}")
    r.push("static inline double hlc_sg_f64(const double* a, int64_t i, int64_t n) {")
    r.push("    if (i < 0 || i >= n) hl_die(\"array access out of bounds\");")
    r.push("    return a[i];")
    r.push("}")
    r.push("static inline void hlc_ss_f64(double* a, int64_t i, int64_t n, double v) {")
    r.push("    if (i < 0 || i >= n) hl_die(\"array access out of bounds\");")
    r.push("    a[i] = v;")
    r.push("}")
    r.push("static inline bool hlc_sg_bool(const bool* a, int64_t i, int64_t n) {")
    r.push("    if (i < 0 || i >= n) hl_die(\"array access out of bounds\");")
    r.push("    return a[i];")
    r.push("}")
    r.push("static inline void hlc_ss_bool(bool* a, int64_t i, int64_t n, bool v) {")
    r.push("    if (i < 0 || i >= n) hl_die(\"array access out of bounds\");")
    r.push("    a[i] = v;")
    r.push("}")
    r.push("")
    return r
}

fn concat_lines(dst: list[str], src: list[str]) -> void {
    let mut i: int = 0
    while i < src.len() {
        dst.push(src.get(i))
        i = i + 1
    }
}

# ============================================================================
# 4c. STAGE 8-BETA OWNERSHIP CODEGEN HELPERS
# ----------------------------------------------------------------------------
# The ownership discipline (see SPEC.md section 16):
#   * Every heap value is reference-counted (refcnt is the first field).
#   * "Fresh" expressions (literals, concat, clone, call results, pop,
#     map.keys, list/struct/enum literals) carry one retain nobody owns —
#     the consumer takes it over.
#   * "Borrow" expressions (idents, field/index access) point at a retain
#     owned elsewhere; a consumer that keeps the value adds its own retain.
#   * Bindings own one retain, released by a C cleanup attribute at block
#     exit (this covers break/continue/return automatically).
#   * Function parameters own one retain of each argument (call sites
#     own-wrap fresh values raw and borrowed values with hl_retain).
#   * take(x) transfers the binding's retain: the C variable is nulled
#     after the statement. drop(x) releases it immediately.
#   * Fresh pointer-typed subexpressions consumed in a borrowed position
#     are hoisted into temps with cleanups so nothing leaks.
# ============================================================================

# inst_t: substitute type params from the current instantiation context.
fn inst_t(ctx: Ctx, t: str) -> str {
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        return instantiate_type(t, ctx.cur_typeparams, ctx.cur_targs)
    }
    return t
}

# is_ptr_t: True when values of this (instantiated) type are refcounted
# pointers. tainted[T] is a pointer iff T is.
fn is_ptr_t(ctx: Ctx, t_in: str) -> bool {
    let t: str = inst_t(ctx, t_in)
    if t == "int" || t == "float" || t == "bool" || t == "void" || t == "never" {
        return false
    }
    if is_taint_t(t) {
        return is_ptr_t(ctx, taint_inner_t(t))
    }
    return true
}

# strip_taint: unwrap tainted[...] chains for release/clone dispatch.
fn strip_taint(t: str) -> str {
    let mut out: str = t
    let mut guard: int = 0
    while is_taint_t(out) && guard < 8 {
        out = taint_inner_t(out)
        guard = guard + 1
    }
    return out
}

# release_fn_for: the type-specific release function name.
fn release_fn_for(ctx: Ctx, t_in: str) -> str {
    let t: str = strip_taint(inst_t(ctx, t_in))
    if t == "str" {
        return "hl_str_release"
    }
    if is_list_t(t) {
        return "hl_list_release"
    }
    if is_map_t(t) {
        return "hl_map_release"
    }
    # Stage 16: channel / task release fns (their refcounts are atomic /
    # mutex-guarded — see the concurrency runtime).
    if is_chan_t(t) {
        return "hl_chan_release"
    }
    if is_task_t(t) {
        return "hl_task_release"
    }
    # Stage 33/34: Future[T] and Stream[T] are channels under the hood —
    # their release fn is the same as a channel's.
    if is_future_t(t) || is_stream_t(t) {
        return "hl_chan_release"
    }
    return "hl_release_" + c_type_name(t)
}

# cleanup_fn_for: the block-exit cleanup function (takes T**).
fn cleanup_fn_for(ctx: Ctx, t_in: str) -> str {
    let t: str = strip_taint(inst_t(ctx, t_in))
    if t == "str" {
        return "hl_cleanup_str"
    }
    if is_list_t(t) {
        return "hl_cleanup_list"
    }
    if is_map_t(t) {
        return "hl_cleanup_map"
    }
    # Stage 16: channel / task cleanups.
    if is_chan_t(t) {
        return "hl_cleanup_chan"
    }
    if is_task_t(t) {
        return "hl_cleanup_task"
    }
    # Stage 33/34: Future[T] and Stream[T] use the channel cleanup.
    if is_future_t(t) || is_stream_t(t) {
        return "hl_cleanup_chan"
    }
    return "hl_cleanup_" + c_type_name(t)
}

# elem_free_fn: the function pointer passed to hl_list_new / hl_map_new
# describing how to release one element / value. `free` for primitive
# boxes (they are single-owner allocations, not refcounted).
fn elem_free_fn(ctx: Ctx, t_in: str) -> str {
    let t: str = strip_taint(inst_t(ctx, t_in))
    if t == "int" || t == "float" || t == "bool" {
        return "free"
    }
    return release_fn_for(ctx, t)
}

# release_call: a full C statement expression releasing cexpr of type t.
fn release_call(ctx: Ctx, t: str, cexpr: str) -> str {
    if !is_ptr_t(ctx, t) {
        return "((void)0)"
    }
    return release_fn_for(ctx, t) + "(" + cexpr + ")"
}

# own_wrap: wrap a generated expression so it arrives OWNED (+1 retain)
# at its consumer. Primitives pass through; fresh pointer values pass
# through raw (their inherent retain is the one transferred); borrowed
# pointer values get an explicit hl_retain.
fn own_wrap(ctx: Ctx, t: str, cexpr: str, fresh: bool) -> str {
    if !is_ptr_t(ctx, t) {
        return cexpr
    }
    if fresh {
        return cexpr
    }
    return "hl_retain(" + cexpr + ")"
}

# gen_store_val: wrap a value being stored into a container
# (list.push/set, map.set). Primitive boxes pass through box_val;
# pointer values are own-wrapped so the container owns one retain.
fn gen_store_val(ctx: Ctx, t: str, cexpr: str, fresh: bool) -> str {
    if !is_ptr_t(ctx, t) {
        return box_val(inst_t(ctx, t), cexpr)
    }
    return own_wrap(ctx, t, cexpr, fresh)
}

# expr_fresh: classify an expression by ownership. True = the value it
# produces is "fresh" (one unowned retain the consumer takes over).
fn expr_fresh(ctx: Ctx, e: int) -> bool {
    let k: str = ctx.exprs[e].kind
    if k == "str" {
        return true
    }
    if k == "int" || k == "float" || k == "bool" || k == "ident" {
        return false
    }
    if k == "bin" {
        # Only pointer-typed binops exist for `+` on str (concat) — the
        # result is fresh. Comparisons/arithmetic on primitives are not
        # pointer values, so their class is irrelevant.
        return is_ptr_t(ctx, ctx.exprs[e].t)
    }
    if k == "un" {
        return false
    }
    if k == "index" {
        return false
    }
    if k == "field" {
        return false
    }
    if k == "listlit" || k == "structlit" || k == "enumlit" || k == "mapnew" {
        return true
    }
    if k == "match" {
        # Match arms own-wrap their results, so the match always yields
        # an owned value.
        return true
    }
    if k == "qmark" {
        return true
    }
    if k == "call" {
        return call_result_fresh(ctx, e)
    }
    if k == "method" {
        return method_result_fresh(ctx, e)
    }
    return false
}

# call_result_fresh: freshness table for builtin/user calls.
fn call_result_fresh(ctx: Ctx, e: int) -> bool {
    if ctx.exprs[e].muser {
        let cf: FnInfo = ctx.fns.get_or(ctx.exprs[e].mkey, dummy_fn())
        if cf.is_extern {
            # Extern C functions return raw values; the codegen does not
            # refcount them (extern signatures returning pointers are
            # handled as borrows).
            return false
        }
        return true
    }
    let name: str = ctx.exprs[e].mkey
    if name == "read_file" || name == "read_file_tainted" {
        return true
    }
    # Stage 9 release (v0.20.0-alpha): net_lookup returns a fresh str
    # (the host is consumed; a new str is allocated for the IP address).
    # Without this, the binding `let ip: str = net_lookup(host)` would
    # get an extra hl_retain wrap (because expr_fresh returns false), and
    # the binding's cleanup would only release the extra retain — leaking
    # the underlying str (the original refcnt=1 from hl_net_lookup).
    if name == "net_lookup" {
        return true
    }
    # Stage 37 (v0.56.0-alpha): net_read / net_udp_recv_from return a
    # fresh str (refcnt=1, allocated by the C runtime). net_tls_get
    # likewise returns a fresh str (the response body). The int-returning
    # builtins (net_tcp_connect / net_tcp_listen / net_tcp_accept /
    # net_write / net_udp_open / net_udp_send_to) are primitive — their
    # result class is irrelevant. net_close returns void.
    if name == "net_read" || name == "net_udp_recv_from"
    || name == "net_tls_get" {
        return true
    }
    if name == "range" || name == "chr" {
        return true
    }
    if name == "map_new" {
        return true
    }
    if name == "clone" || name == "take" {
        return true
    }
    # Stage 16 (v0.27.0-alpha): spawn returns a fresh Task handle;
    # chan_new returns a fresh channel (refcnt 1, owned by the spawner).
    # v0.29.0-alpha: chan_new_bounded likewise.
    if name == "spawn" || name == "chan_new" || name == "chan_new_bounded" {
        return true
    }
    # select returns an int (primitive — class irrelevant).
    if name == "str" {
        # str(x) is the identity for str arguments — the result's class
        # follows the argument's. For int/float/bool the codegen calls
        # hl_str_from_int64 / hl_str_from_double / hl_str_from_bool, all
        # of which return a FRESH str (refcnt=1, unowned) — so the result
        # is fresh, matching the method forms int.to_str() / float.to_str()
        # / bool.to_str() (see method_result_fresh). BUG (deep-scan-5):
        # previously this returned `false` for the primitive cases, so
        # `let s: str = str(5)` was emitted as
        # `hl_retain(hl_str_from_int64(5))` — the retain was never
        # released (the binding's cleanup decremented only the extra
        # one), leaking one hl_str per call site on every iteration.
        let at: str = ctx.exprs[ctx.exprs[e].args.get(0)].t
        if at == "str" {
            return expr_fresh(ctx, ctx.exprs[e].args.get(0))
        }
        # int / float / bool -> str produces a fresh str.
        return true
    }
    if name == "taint_mark" || name == "taint_unwrap" {
        return expr_fresh(ctx, ctx.exprs[e].args.get(0))
    }
    # args()/tainted_args() return the process-lifetime global list.
    # print/println/panic/exit/write_file/len/int/float/clock_ms/
    # file_exists/drop return void or primitives.
    return false
}

# method_result_fresh: freshness table for builtin methods.
fn method_result_fresh(ctx: Ctx, e: int) -> bool {
    if ctx.exprs[e].muser {
        return true
    }
    let op: str = ctx.exprs[e].mop
    if op == "str.slice" || op == "str.split" || op == "str.trim" {
        return true
    }
    if op == "str.to_str" {
        # Identity on the receiver — the result's class follows it.
        return expr_fresh(ctx, ctx.exprs[e].left)
    }
    if op == "int.to_str" || op == "float.to_str" || op == "bool.to_str" {
        return true
    }
    if op == "list.pop" {
        # Ownership of the removed element transfers out of the list.
        return true
    }
    # Stage 16 (v0.27.0-alpha): recv transfers message ownership to the
    # receiver; join transfers the task result to the joiner.
    # v0.29.0-alpha: recv_or is fresh the same way — the message's
    # retain transfers, or the own-wrapped default does.
    if op == "chan.recv" || op == "chan.recv_or" || op == "task.join" {
        return true
    }
    if op == "map.keys" {
        return true
    }
    if op == "map.get_or" {
        # Pointer-valued maps return an owned retain (hl_map_get_own).
        # Primitive-valued maps return unboxed primitives.
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        if is_map_t(mt) {
            return is_ptr_t(ctx, map_val_t(mt))
        }
        return false
    }
    return false
}

# flush_null_after: emit `x = NULL;` for every binding moved out by
# take() during the current statement, then clear the list. Nulling
# makes the scope-exit cleanup a no-op (ownership was transferred).
fn flush_null_after(ctx: Ctx, ind: str) -> void {
    let mut i: int = 0
    while i < ctx.null_after.len() {
        ctx.out.push(ind + ctx.null_after.get(i) + " = NULL;")
        i = i + 1
    }
    ctx.null_after = []
}

# collect_hoist: walk the expression tree and record every fresh
# pointer-typed node consumed in a BORROWED position (a position whose
# consumer does not own the value). Those nodes are hoisted into temps
# with cleanup attributes by hoist_all before the statement is emitted.
#
# Position table:
#   bin/un operands, index/field receivers+indices      -> borrowed
#   user fn call args, method receivers (user), container
#   stores (push/set/map.set), struct/enum literal fields,
#   list literal elements, consume-builtin args          -> transferred
#   builtin borrow-fn args (clone, len, str-methods)     -> borrowed
#   match scrutinee, qmark inner                         -> internal
fn collect_hoist(ctx: Ctx, e: int) -> void {
    let k: str = ctx.exprs[e].kind
    if k == "int" || k == "float" || k == "bool" || k == "str" || k == "ident" {
        return
    }
    if k == "un" || k == "index" || k == "field" {
        hoist_child(ctx, ctx.exprs[e].left)
        if k == "index" {
            hoist_child(ctx, ctx.exprs[e].right)
        }
        return
    }
    if k == "bin" {
        # BUGFIX (v0.36.0-alpha, found via the Stage 20 LTO work): the
        # RIGHT operand of &&/|| must NOT be hoisted to statement level.
        # HLS evaluates &&/|| lazily (the interpreter short-circuits);
        # hoisting fresh subexpressions out of the right operand makes
        # the native build evaluate them EAGERLY — a slice or call that
        # the interpreter never runs can panic in the native binary
        # (observed: `k.len() >= 2 && k.slice(0, 2) == "b:"` panicking
        # "invalid string slice" on 1-char keys). gen_bin now scopes the
        # right operand's fresh subexpressions inside a GCC statement
        # expression at the operand position itself, preserving both
        # the laziness and the cleanup discipline.
        if ctx.exprs[e].op == "&&" || ctx.exprs[e].op == "||" {
            hoist_child(ctx, ctx.exprs[e].left)
            return
        }
        hoist_child(ctx, ctx.exprs[e].left)
        hoist_child(ctx, ctx.exprs[e].right)
        return
    }
    if k == "listlit" || k == "structlit" || k == "enumlit" {
        # Elements/fields are transferred into the container — recurse
        # into their subexpressions only.
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            collect_hoist(ctx, ctx.exprs[e].args.get(i))
            i = i + 1
        }
        return
    }
    if k == "mapnew" || k == "match" || k == "qmark" {
        # match/qmark manage their scrutinee/inner ownership internally;
        # still recurse so fresh-borrowed subexpressions get hoisted.
        # NOTE: arm BODIES are NOT walked here — they may reference the
        # match's pattern bindings, which only exist inside the statement
        # expression. gen_match_expr performs arm-local hoisting instead.
        if k == "match" {
            collect_hoist(ctx, ctx.exprs[e].left)
        } else {
            collect_hoist(ctx, ctx.exprs[e].left)
        }
        return
    }
    if k == "call" {
        if ctx.exprs[e].muser {
            let cf: FnInfo = ctx.fns.get_or(ctx.exprs[e].mkey, dummy_fn())
            let mut i: int = 0
            while i < ctx.exprs[e].args.len() {
                if cf.is_extern {
                    # Extern args are borrowed (the C callee knows
                    # nothing about refcounts).
                    hoist_child(ctx, ctx.exprs[e].args.get(i))
                } else {
                    collect_hoist(ctx, ctx.exprs[e].args.get(i))
                }
                i = i + 1
            }
            return
        }
        let name: str = ctx.exprs[e].mkey
        let mut j: int = 0
        while j < ctx.exprs[e].args.len() {
            let aidx: int = ctx.exprs[e].args.get(j)
            if builtin_arg_borrowed(name) {
                hoist_child(ctx, aidx)
            } else {
                collect_hoist(ctx, aidx)
            }
            j = j + 1
        }
        return
    }
    if k == "method" {
        # Builtin method receivers are borrowed (even push/set: the
        # receiver list is mutated, not stored into). User method
        # receivers are transferred (the self param owns one retain).
        if ctx.exprs[e].muser {
            collect_hoist(ctx, ctx.exprs[e].left)
        } else {
            hoist_child(ctx, ctx.exprs[e].left)
        }
        let op: str = ctx.exprs[e].mop
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            let aidx: int = ctx.exprs[e].args.get(i)
            # Stage 35 (v0.54.0-alpha): user method args are TRANSFERRED
            # (the callee's parameter binding owns one retain and its
            # cleanup releases it). Hoisting a fresh pointer arg (e.g. a
            # string literal) into a temp WITH a cleanup attribute caused
            # a double-release: the temp's cleanup ran at end of the
            # caller's scope AND the callee's param cleanup ran at end of
            # the callee. For a struct that stored the arg into a
            # list[str] field with hl_str_release as elem_free, this was
            # a heap-use-after-free. The pre-existing bug was masked
            # because most call sites used `let x = "lit"; m(x)` (the
            # let-binding was consumed by transfer semantics) or passed
            # struct literals inline. Calling `b.set("literal")`
            # directly triggered it.
            if ctx.exprs[e].muser {
                collect_hoist(ctx, aidx)
            } else if method_arg_borrowed(op, i) {
                hoist_child(ctx, aidx)
            } else {
                collect_hoist(ctx, aidx)
            }
            i = i + 1
        }
        return
    }
}

# hoist_child: hoist child `c` if it is a fresh pointer value, otherwise
# recurse into it. When hoisting, the node's OWN fresh children (in
# borrowed positions) must be reserved FIRST — they are declared as
# temps before the parent's temp, because the parent's initializer
# expression references them. (HLS maps preserve insertion order, so the
# reservation order in hoist_map is the declaration order.)
fn hoist_child(ctx: Ctx, c: int) -> void {
    if c < 0 {
        return
    }
    let ck: str = c.to_str()
    if is_ptr_t(ctx, ctx.exprs[c].t) && expr_fresh(ctx, c) && !ctx.hoist_map.has(ck) {
        # Reserve the node's children first (declaration order).
        collect_hoist(ctx, c)
        ctx.hoist_map.set(ck, "")
        # Reserved with an empty temp name; hoist_all fills it in.
        return
    }
    collect_hoist(ctx, c)
}

# builtin_arg_borrowed: True when a builtin consumes its argument as a
# borrow (no ownership transfer). Consume builtins (print family, I/O)
# and identity builtins (str, taint_mark) transfer or pass through.
# Stage 9 release (v0.20.0-alpha): net_lookup and proc_exec ALSO consume
# their argument (they call hl_str_release on the host/cmd at the end).
# If this returns true for them, the codegen hoists a fresh-expression
# argument (e.g. `cmd + " " + ip`) into a temporary with cleanup, passes
# the temporary directly to the builtin, and the cleanup releases it
# AGAIN after the builtin has already released it → double-free.
fn builtin_arg_borrowed(name: str) -> bool {
    if name == "println" || name == "print" || name == "panic" || name == "exit" {
        return false
    }
    # Stage 56 (v0.75.0-alpha): eprint / eprintln consume their str
    # argument (the C runtime calls hl_str_release after the stderr
    # fwrite — the same ownership convention as print / println).
    # Without this, `eprint(prefix + msg)` would double-free the
    # concat result (same bug pattern as proc_exec's `cmd + " " + ip`
    # before the Stage 9 release fix).
    if name == "eprint" || name == "eprintln" {
        return false
    }
    if name == "write_file" || name == "read_file" || name == "read_file_tainted" {
        return false
    }
    if name == "file_exists" {
        return false
    }
    # Stage 36 (v0.55.0-alpha): filesystem metadata builtins all
    # consume the path argument (the C runtime calls hl_str_release
    # on the path after using it, mirroring read_file). fs_set_perms
    # also takes a mode int (a primitive — not a refcount concern),
    # so only the path argument matters here.
    if name == "fs_read_dir" || name == "fs_size" || name == "fs_is_dir"
    || name == "fs_set_perms" {
        return false
    }
    if name == "str" || name == "taint_mark" || name == "taint_unwrap" {
        return false
    }
    # Stage 9 release: net_lookup and proc_exec consume their argument
    # (the C runtime releases the host/cmd after using it). Without this,
    # `proc_exec(cmd + " " + ip)` would crash with "malloc(): unaligned
    # tcache chunk detected" (double-free of the concat result).
    if name == "net_lookup" || name == "proc_exec" {
        return false
    }
    # Stage 47 (v0.66.0-alpha): proc_spawn's program (arg 0) is
    # owned by the runtime helper (it's released after fork+exec).
    # The args list (arg 1) is also consumed (the runtime copies the
    # elements into a C argv[] array, then releases the list and
    # each element). proc_child_write's data arg is similarly
    # consumed. Without this, `proc_spawn("echo " + user_input, ...)`
    # would double-free the concat result (same bug pattern as
    # `proc_exec(cmd + " " + ip)` above).
    if name == "proc_spawn" || name == "proc_child_write" {
        return false
    }
    # Stage 48 (v0.67.0-alpha): env_set's key (arg 0) and value (arg 1)
    # are owned by the runtime (the runtime calls setenv, which copies
    # the strings, then releases the hl_str* args). env_get / env_has /
    # env_unset / cwd_set similarly consume their key / path argument.
    # Without this, `env_set(k, v1 + v2)` would double-free the concat.
    if name == "env_get" || name == "env_has" || name == "env_set"
    || name == "env_unset" || name == "cwd_set" {
        return false
    }
    # Stage 37 (v0.56.0-alpha): TCP / UDP / TLS builtins. The host
    # (str) and path (str) and data (str) arguments are OWNED by the
    # runtime helpers — each is hl_str_release'd after use. The fd /
    # port / n / backlog arguments are primitive int (no refcount).
    # Without this, `net_write(fd, body + "\n")` would double-free
    # the concat result (same bug pattern as proc_exec above).
    if name == "net_tcp_connect" || name == "net_tcp_listen"
    || name == "net_tls_get" {
        return false
    }
    if name == "net_write" || name == "net_udp_send_to" {
        return false
    }
    # net_tcp_accept / net_read / net_udp_recv_from only take int
    # arguments — they have no str to consume, so the question is moot.
    # Return false (no str borrowing) for completeness.
    if name == "net_tcp_accept" || name == "net_read"
    || name == "net_close" || name == "net_udp_open"
    || name == "net_udp_recv_from" {
        return false
    }
    # Stage 16 (v0.27.0-alpha): spawn TRANSFERS each argument into the
    # task's argbox (ownership crosses the thread boundary). Without
    # this, a fresh argument like clone(ch) was hoisted into a temp WITH
    # a cleanup attribute — the temp's scope-exit release then fought
    # the task's own release of the same retain (double-free /
    # use-after-free on the channel).
    if name == "spawn" {
        return false
    }
    # clone, len, int, float, and the rest borrow their arguments.
    return true
}

# method_arg_borrowed: True when a builtin method consumes argument `i`
# as a borrow. Values stored into containers (push/set/map.set) and
# pointer-valued get_or defaults are transferred.
fn method_arg_borrowed(op: str, i: int) -> bool {
    if op == "list.push" || op == "list.set" {
        return false
    }
    if op == "map.set" {
        return false
    }
    if op == "map.get_or" {
        # The KEY is borrowed; the DEFAULT is transferred (owned) for
        # pointer-valued maps — but primitive defaults pass by value.
        return i == 0
    }
    # Stage 16: ch.send(v) TRANSFERS the message into the channel's
    # queue (the channel owns it). Hoisting a fresh v into a temp with
    # a cleanup would release it again after the transfer. The same
    # holds for try_send (v0.29.0-alpha): on success the queue owns the
    # copy; on failure the runtime releases it.
    if op == "chan.send" || op == "chan.try_send" {
        return false
    }
    # v0.29.0-alpha: ch.recv_or(default) — the runtime consumes the
    # default either way: it is returned owned to the caller, or it is
    # released via elem_release when a message was available. Hoisting
    # it into a temp WITH a cleanup attribute double-releases it.
    if op == "chan.recv_or" {
        return false
    }
    return true
}

# hoist_all: materialise every node reserved by collect_hoist into a
# temp declaration with a cleanup attribute, registered in hoist_map.
# The declarations are appended to `dst` at the given indentation —
# ctx.out for statement-level hoists, or a match arm's local block
# for arm-local hoists (pattern bindings only exist there).
fn hoist_all(ctx: Ctx, dst: list[str], ind: str) -> void {
    let keys: list[str] = ctx.hoist_map.keys()
    let mut i: int = 0
    while i < keys.len() {
        let key: str = keys.get(i)
        if ctx.hoist_map.get_or(key, "") != "" {
            # Already materialised (nested collect pass) — skip.
            i = i + 1
            continue
        }
        let e: int = key.to_int()
        let tmp: str = fresh_tmp(ctx, "hlc_h")
        let t: str = inst_t(ctx, ctx.exprs[e].t)
        let v: str = gen_expr(ctx, e)
        dst.push(ind + c_type(ctx, t) + " " + tmp
        + " __attribute__((cleanup(" + cleanup_fn_for(ctx, t) + "))) = " + v + ";")
        ctx.hoist_map.set(key, tmp)
        i = i + 1
    }
}

# clear_hoists: drop hoist registrations at the end of a statement (the
# temps have been declared; the expression tree is not revisited).
fn clear_hoists(ctx: Ctx) -> void {
    ctx.hoist_map = map_new()
}

# gen_own_arg: generate one argument, own-wrapped for pointer types —
# used at user fn / user method / consume-builtin call sites.
fn gen_own_arg(ctx: Ctx, aidx: int) -> str {
    let t: str = ctx.exprs[aidx].t
    let fresh: bool = expr_fresh(ctx, aidx)
    let c: str = gen_expr(ctx, aidx)
    return own_wrap(ctx, t, c, fresh)
}

# gen_own_args_c: own-wrap every argument of a call.
fn gen_own_args_c(ctx: Ctx, e: int) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        parts.push(gen_own_arg(ctx, ctx.exprs[e].args.get(i)))
        i = i + 1
    }
    return join(parts, ", ")
}

# --- C expression generation ---

# ============================================================================
# STAGE 19 (v0.35.0-alpha): PROFILE-GUIDED OPTIMISATION helpers
# ----------------------------------------------------------------------------
# Two codegen modes:
#   --pgo-generate   every fn entry / branch / loop back-edge gets a counter
#                    increment; counters are dumped to a .hlcprof file at
#                    process exit (registered via atexit in main()).
#   --pgo-use=F      the profile F (produced above) steers codegen:
#                      * __builtin_expect hints on biased branches/loops
#                      * __attribute__((hot))/((cold)) on function signatures
#                      * `static inline` on hot, small functions
#                    Site ids are deterministic (same source => same ids in
#                    both modes), so a profile from build A trains build B.
# ============================================================================

# pgo_site: assign (or reuse) the counter index for a profile site id.
# The id is appended to ctx.pgo_site_ids on FIRST assignment; the index
# is its position. Ids must be assigned in IDENTICAL order in
# --pgo-generate and --pgo-use builds (they are: the codegen walk is
# deterministic). When NO PGO mode is active the call is a no-op —
# plain builds pay zero instrumentation cost.
