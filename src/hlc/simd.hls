# ============================================================================
# hlc/simd.hls — part of the hlc compiler (split from the original single-file
# src/hlc.hls). This file is loaded via `import "hlc/simd.hls"` from src/hlc.hls.
# Section 5c — SIMD intrinsic emitters (SSE4.2/AVX2/NEON/RVV).
# NOTE: content is byte-identical to the original src/hlc.hls line range
#       13998..15124 - module split is purely structural, zero code changes.
# ============================================================================
fn simd_redirectable(ctx: Ctx, name: str, e: int) -> bool {
    if name == "simd_i32x4_add" || name == "simd_i32x4_sub" || name == "simd_i32x4_mul"
    || name == "simd_i32x4_min" || name == "simd_i32x4_max" {
        return ctx.exprs[e].args.len() == 2
        && ctx.exprs[ctx.exprs[e].args.get(0)].t == "I32x4"
        && ctx.exprs[ctx.exprs[e].args.get(1)].t == "I32x4"
    }
    if name == "simd_f64x2_add" || name == "simd_f64x2_sub" || name == "simd_f64x2_mul" {
        return ctx.exprs[e].args.len() == 2
        && ctx.exprs[ctx.exprs[e].args.get(0)].t == "F64x2"
        && ctx.exprs[ctx.exprs[e].args.get(1)].t == "F64x2"
    }
    if name == "simd_i32x4_gather" {
        return ctx.exprs[e].args.len() == 2
        && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[int]"
        && ctx.exprs[ctx.exprs[e].args.get(1)].t == "int"
    }
    if name == "simd_f64x2_gather" {
        return ctx.exprs[e].args.len() == 2
        && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[float]"
        && ctx.exprs[ctx.exprs[e].args.get(1)].t == "int"
    }
    if name == "simd_correlate8_sum_i32x4" {
        return ctx.exprs[e].args.len() == 9
        && ctx.exprs[e].t == "int"
        && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[int]"
    }
    if name == "simd_transform_sum_i32x4" {
        return ctx.exprs[e].args.len() == 4
        && ctx.exprs[e].t == "int"
        && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[int]"
        && ctx.exprs[ctx.exprs[e].args.get(1)].t == "list[int]"
        && ctx.exprs[ctx.exprs[e].args.get(2)].t == "int"
        && ctx.exprs[ctx.exprs[e].args.get(3)].t == "int"
    }
    if name == "simd_i32x4_scatter" {
        return ctx.exprs[e].args.len() == 3
        && ctx.exprs[e].t == "void"
        && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[int]"
        && ctx.exprs[ctx.exprs[e].args.get(1)].t == "int"
        && ctx.exprs[ctx.exprs[e].args.get(2)].t == "I32x4"
    }
    if name == "simd_f64x2_scatter" {
        return ctx.exprs[e].args.len() == 3
        && ctx.exprs[e].t == "void"
        && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[float]"
        && ctx.exprs[ctx.exprs[e].args.get(1)].t == "int"
        && ctx.exprs[ctx.exprs[e].args.get(2)].t == "F64x2"
    }
    return false
}

# simd_try_redirect: if the call matches a kernel, register (once) the
# intrinsic helper and return the C call expression ("" = no redirect).
fn simd_try_redirect(ctx: Ctx, name: str, e: int) -> str {
    if !simd_redirectable(ctx, name, e) {
        return ""
    }
    let helper: str = "hl_" + name
    if !list_has(ctx.simd_helper_names, helper) {
        ctx.simd_helper_names.push(helper)
        simd_emit_helper(ctx, name)
    }
    return helper + "(" + gen_own_args_c(ctx, e) + ")"
}

# simd_emit_i32x4_ew: one elementwise i32x4 kernel — intrinsic body into
# simd_helpers_main, scalar body into simd_helpers_alt.
fn simd_emit_i32x4_ew(ctx: Ctx, name: str, intrinsic: str) -> void {
    let m: list[str] = ctx.simd_helpers_main
    let a: list[str] = ctx.simd_helpers_alt
    m.push("/* " + name + " */")
    m.push("__attribute__((target(\"" + ctx.target_feature + "\"))) static I32x4* hl_" + name + "(I32x4* x_p, I32x4* y_p) {")
    m.push("    I32x4* x = x_p;")
    m.push("    I32x4* y = y_p;")
    m.push("    I32x4* r = usf_new_I32x4(0, 0);")
    m.push("    __m128i va = _mm_set_epi64x(x->f_b, x->f_a);")
    m.push("    __m128i vb = _mm_set_epi64x(y->f_b, y->f_a);")
    m.push("    __m128i c = " + intrinsic + "(va, vb);")
    m.push("    r->f_a = _mm_cvtsi128_si64(c);")
    m.push("    r->f_b = _mm_cvtsi128_si64(_mm_unpackhi_epi64(c, c));")
    m.push("    hl_release_I32x4(x);")
    m.push("    hl_release_I32x4(y);")
    m.push("    return r;")
    m.push("}")
    a.push("/* " + name + " (scalar fallback) */")
    a.push("static I32x4* hl_" + name + "(I32x4* x_p, I32x4* y_p) {")
    a.push("    I32x4* x = x_p; I32x4* y = y_p;")
    a.push("    I32x4* r = usf_new_I32x4(0, 0);")
    a.push("    int32_t la[4] = { (int32_t)(uint32_t)x->f_a, (int32_t)(uint32_t)(x->f_a >> 32),")
    a.push("                       (int32_t)(uint32_t)x->f_b, (int32_t)(uint32_t)(x->f_b >> 32) };")
    a.push("    int32_t lb[4] = { (int32_t)(uint32_t)y->f_a, (int32_t)(uint32_t)(y->f_a >> 32),")
    a.push("                       (int32_t)(uint32_t)y->f_b, (int32_t)(uint32_t)(y->f_b >> 32) };")
    if name == "simd_i32x4_min" {
        a.push("    int32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = la[k] < lb[k] ? la[k] : lb[k];")
    } else if name == "simd_i32x4_max" {
        a.push("    int32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = la[k] > lb[k] ? la[k] : lb[k];")
    } else {
        let mut c_op: str = "+"
        if name == "simd_i32x4_sub" {
            c_op = "-"
        } else if name == "simd_i32x4_mul" {
            c_op = "*"
        }
        a.push("    uint32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = (uint32_t)((uint64_t)(uint32_t)la[k] " + c_op + " (uint64_t)(uint32_t)lb[k]);")
    }
    a.push("    r->f_a = (int64_t)((uint64_t)(uint32_t)lr[0] | ((uint64_t)(uint32_t)lr[1] << 32));")
    a.push("    r->f_b = (int64_t)((uint64_t)(uint32_t)lr[2] | ((uint64_t)(uint32_t)lr[3] << 32));")
    a.push("    hl_release_I32x4(x); hl_release_I32x4(y);")
    a.push("    return r;")
    a.push("}")
}

# simd_emit_f64x2_ew: one elementwise f64x2 kernel.
fn simd_emit_f64x2_ew(ctx: Ctx, name: str, intrinsic: str) -> void {
    let m: list[str] = ctx.simd_helpers_main
    let a: list[str] = ctx.simd_helpers_alt
    let mut c_op: str = "+"
    if name == "simd_f64x2_sub" {
        c_op = "-"
    } else if name == "simd_f64x2_mul" {
        c_op = "*"
    }
    m.push("/* " + name + " */")
    m.push("__attribute__((target(\"" + ctx.target_feature + "\"))) static F64x2* hl_" + name + "(F64x2* x_p, F64x2* y_p) {")
    m.push("    F64x2* x = x_p; F64x2* y = y_p;")
    m.push("    F64x2* r = usf_new_F64x2(0.0, 0.0);")
    m.push("    __m128d va = _mm_loadu_pd(&x->f_a);")
    m.push("    __m128d vb = _mm_loadu_pd(&y->f_a);")
    m.push("    __m128d c = " + intrinsic + "(va, vb);")
    m.push("    _mm_storeu_pd(&r->f_a, c);")
    m.push("    hl_release_F64x2(x); hl_release_F64x2(y);")
    m.push("    return r;")
    m.push("}")
    a.push("/* " + name + " (scalar fallback) */")
    a.push("static F64x2* hl_" + name + "(F64x2* x_p, F64x2* y_p) {")
    a.push("    F64x2* x = x_p; F64x2* y = y_p;")
    a.push("    F64x2* r = usf_new_F64x2(0.0, 0.0);")
    a.push("    r->f_a = x->f_a " + c_op + " y->f_a;")
    a.push("    r->f_b = x->f_b " + c_op + " y->f_b;")
    a.push("    hl_release_F64x2(x); hl_release_F64x2(y);")
    a.push("    return r;")
    a.push("}")
}

# ============================================================================
# STAGE 25 (v0.44.0-alpha): AArch64 NEON INTRINSIC FAST PATHS
# ----------------------------------------------------------------------------
# Mirror of the x86 SSE emitter above, but using <arm_neon.h> intrinsics.
# Emitted into simd_helpers_neon; assembled by simd_helper_lines into the
# #elif defined(__aarch64__) || defined(__ARM_NEON__) branch. The same
# scalar fallback (simd_helpers_alt) is used for non-NEON hosts.
#
# NEON intrinsic reference (ARMv8-A):
#   i32x4 add/sub/mul/min/max: vaddq_s32 / vsubq_s32 / vmulq_s32 /
#                              vminq_s32 / vmaxq_s32
#   f64x2 add/sub/mul:         vaddq_f64 / vsubq_f64 / vmulq_f64
#
# The NEON intrinsics take int32x4_t / float64x2_t arguments directly
# (not pointers); we load from the HLS struct's two i64 / f64 fields via
# vld1q_s64 / vld1q_f64 and store back via vst1q_s64 / vst1q_f64. The
# I32x4 struct stores {int64_t a, int64_t b} — a 128-bit value that
# maps directly to a NEON int32x4_t register.
# ============================================================================

# simd_emit_neon_i32x4_ew: one elementwise i32x4 kernel using NEON
# intrinsics. The intrinsic name (e.g. "vaddq_s32") is passed in;
# the body loads x and y from their {i64 a, i64 b} layout into
# int32x4_t registers, applies the intrinsic, and stores the result
# back into a fresh I32x4 struct.
fn simd_emit_neon_i32x4_ew(ctx: Ctx, name: str, intrinsic: str) -> void {
    let m: list[str] = ctx.simd_helpers_neon
    let a: list[str] = ctx.simd_helpers_alt
    m.push("/* " + name + " (NEON) */")
    m.push("static I32x4* hl_" + name + "(I32x4* x_p, I32x4* y_p) {")
    m.push("    I32x4* x = x_p; I32x4* y = y_p;")
    m.push("    I32x4* r = usf_new_I32x4(0, 0);")
    # Load {i64 a, i64 b} into a 128-bit NEON register. The layout is
    # little-endian: lane 0 = low 32 bits of a, lane 1 = high 32 bits
    # of a, lane 2 = low 32 bits of b, lane 3 = high 32 bits of b.
    # vreinterpretq_s32_s64 reinterprets the int64x2_t as int32x4_t.
    m.push("    int64x2_t va = vld1q_s64((const int64_t*)&x->f_a);")
    m.push("    int64x2_t vb = vld1q_s64((const int64_t*)&y->f_a);")
    m.push("    int32x4_t va32 = vreinterpretq_s32_s64(va);")
    m.push("    int32x4_t vb32 = vreinterpretq_s32_s64(vb);")
    m.push("    int32x4_t c = " + intrinsic + "(va32, vb32);")
    m.push("    int64x2_t c64 = vreinterpretq_s64_s32(c);")
    m.push("    vst1q_s64((int64_t*)&r->f_a, c64);")
    m.push("    hl_release_I32x4(x); hl_release_I32x4(y);")
    m.push("    return r;")
    m.push("}")
    a.push("/* " + name + " (scalar fallback) */")
    a.push("static I32x4* hl_" + name + "(I32x4* x_p, I32x4* y_p) {")
    a.push("    I32x4* x = x_p; I32x4* y = y_p;")
    a.push("    I32x4* r = usf_new_I32x4(0, 0);")
    a.push("    int32_t la[4] = { (int32_t)(uint32_t)x->f_a, (int32_t)(uint32_t)(x->f_a >> 32),")
    a.push("                       (int32_t)(uint32_t)x->f_b, (int32_t)(uint32_t)(x->f_b >> 32) };")
    a.push("    int32_t lb[4] = { (int32_t)(uint32_t)y->f_a, (int32_t)(uint32_t)(y->f_a >> 32),")
    a.push("                       (int32_t)(uint32_t)y->f_b, (int32_t)(uint32_t)(y->f_b >> 32) };")
    if name == "simd_i32x4_min" {
        a.push("    int32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = la[k] < lb[k] ? la[k] : lb[k];")
    } else if name == "simd_i32x4_max" {
        a.push("    int32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = la[k] > lb[k] ? la[k] : lb[k];")
    } else {
        let mut c_op: str = "+"
        if name == "simd_i32x4_sub" {
            c_op = "-"
        } else if name == "simd_i32x4_mul" {
            c_op = "*"
        }
        a.push("    uint32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = (uint32_t)((uint64_t)(uint32_t)la[k] " + c_op + " (uint64_t)(uint32_t)lb[k]);")
    }
    a.push("    r->f_a = (int64_t)((uint64_t)(uint32_t)lr[0] | ((uint64_t)(uint32_t)lr[1] << 32));")
    a.push("    r->f_b = (int64_t)((uint64_t)(uint32_t)lr[2] | ((uint64_t)(uint32_t)lr[3] << 32));")
    a.push("    hl_release_I32x4(x); hl_release_I32x4(y);")
    a.push("    return r;")
    a.push("}")
}

# simd_emit_neon_f64x2_ew: one elementwise f64x2 kernel using NEON.
fn simd_emit_neon_f64x2_ew(ctx: Ctx, name: str, intrinsic: str) -> void {
    let m: list[str] = ctx.simd_helpers_neon
    let a: list[str] = ctx.simd_helpers_alt
    let mut c_op: str = "+"
    if name == "simd_f64x2_sub" {
        c_op = "-"
    } else if name == "simd_f64x2_mul" {
        c_op = "*"
    }
    m.push("/* " + name + " (NEON) */")
    m.push("static F64x2* hl_" + name + "(F64x2* x_p, F64x2* y_p) {")
    m.push("    F64x2* x = x_p; F64x2* y = y_p;")
    m.push("    F64x2* r = usf_new_F64x2(0.0, 0.0);")
    m.push("    float64x2_t va = vld1q_f64((const double*)&x->f_a);")
    m.push("    float64x2_t vb = vld1q_f64((const double*)&y->f_a);")
    m.push("    float64x2_t c = " + intrinsic + "(va, vb);")
    m.push("    vst1q_f64((double*)&r->f_a, c);")
    m.push("    hl_release_F64x2(x); hl_release_F64x2(y);")
    m.push("    return r;")
    m.push("}")
    a.push("/* " + name + " (scalar fallback) */")
    a.push("static F64x2* hl_" + name + "(F64x2* x_p, F64x2* y_p) {")
    a.push("    F64x2* x = x_p; F64x2* y = y_p;")
    a.push("    F64x2* r = usf_new_F64x2(0.0, 0.0);")
    a.push("    r->f_a = x->f_a " + c_op + " y->f_a;")
    a.push("    r->f_b = x->f_b " + c_op + " y->f_b;")
    a.push("    hl_release_F64x2(x); hl_release_F64x2(y);")
    a.push("    return r;")
    a.push("}")
}

# ============================================================================
# Stage 26 (v0.49.0-alpha): RISC-V Vector (RVV) intrinsic emission.
# ----------------------------------------------------------------------------
# When --target-feature rvv is passed, simd_emit_helper dispatches the
# elementwise kernels (add/sub/mul/min/max for i32x4, add/sub/mul for
# f64x2) to simd_emit_rvv_*_ew, which pushes the RVV intrinsic body
# into simd_helpers_rvv and the same scalar fallback (simd_helpers_alt)
# into the #else branch. The RVV bodies are emitted in the
# #elif defined(__riscv) && defined(__riscv_v) branch by
# simd_helper_lines.
#
# RVV intrinsic reference (RVV 1.0 spec,
# github.com/riscv-non-isa/rvv-intrinsic-doc):
#   i32x4 add/sub/mul/min/max (LMUL=1, vl=4):
#     __riscv_vadd_vv_i32m1 / __riscv_vsub_vv_i32m1 / __riscv_vmul_vv_i32m1 /
#     __riscv_vmin_vv_i32m1 / __riscv_vmax_vv_i32m1
#   f64x2 add/sub/mul (LMUL=1, vl=2):
#     __riscv_vadd_vv_f64m1 / __riscv_vsub_vv_f64m1 / __riscv_vmul_vv_f64m1
#   load/store:
#     __riscv_vle32_v_i32m1 / __riscv_vse32_v_i32m1 (i32 elements)
#     __riscv_vle64_v_f64m1 / __riscv_vse64_v_f64m1 (f64 elements)
#
# The "vl=4" / "vl=2" parameter is the vector length (number of elements
# processed). At VLEN=128 (the baseline), an i32m1 register holds 4 i32
# lanes (VLEN/SEW = 128/32 = 4) and an f64m1 register holds 2 f64 lanes
# (128/64 = 2). At higher VLEN (256, 512), the same LMUL=1 register holds
# more lanes — but we explicitly request vl=4 / vl=2 so the behavior is
# identical across VLEN: only the first 4 / 2 lanes are processed. This
# matches the HLS I32x4 / F64x2 type semantics (fixed-size vectors).
# ============================================================================

# simd_emit_rvv_i32x4_ew: one elementwise i32x4 kernel using RVV
# intrinsics. The intrinsic name (e.g. "__riscv_vadd_vv_i32m1") is
# passed in; the body loads x and y from their {i64 a, i64 b} layout
# into vint32m1_t registers, applies the intrinsic, and stores the
# result back into a fresh I32x4 struct.
fn simd_emit_rvv_i32x4_ew(ctx: Ctx, name: str, intrinsic: str) -> void {
    let m: list[str] = ctx.simd_helpers_rvv
    let a: list[str] = ctx.simd_helpers_alt
    m.push("/* " + name + " (RVV) */")
    m.push("static I32x4* hl_" + name + "(I32x4* x_p, I32x4* y_p) {")
    m.push("    I32x4* x = x_p; I32x4* y = y_p;")
    m.push("    I32x4* r = usf_new_I32x4(0, 0);")
    m.push("    /* RVV 1.0: vl=4 (4 i32 lanes at LMUL=1, VLEN>=128). */")
    m.push("    vint32m1_t va = __riscv_vle32_v_i32m1((const int32_t*)&x->f_a, 4);")
    m.push("    vint32m1_t vb = __riscv_vle32_v_i32m1((const int32_t*)&y->f_a, 4);")
    m.push("    vint32m1_t c = " + intrinsic + "(va, vb, 4);")
    m.push("    __riscv_vse32_v_i32m1((int32_t*)&r->f_a, c, 4);")
    m.push("    hl_release_I32x4(x); hl_release_I32x4(y);")
    m.push("    return r;")
    m.push("}")
    a.push("/* " + name + " (scalar fallback) */")
    a.push("static I32x4* hl_" + name + "(I32x4* x_p, I32x4* y_p) {")
    a.push("    I32x4* x = x_p; I32x4* y = y_p;")
    a.push("    I32x4* r = usf_new_I32x4(0, 0);")
    a.push("    int32_t la[4] = { (int32_t)(uint32_t)x->f_a, (int32_t)(uint32_t)(x->f_a >> 32),")
    a.push("                       (int32_t)(uint32_t)x->f_b, (int32_t)(uint32_t)(x->f_b >> 32) };")
    a.push("    int32_t lb[4] = { (int32_t)(uint32_t)y->f_a, (int32_t)(uint32_t)(y->f_a >> 32),")
    a.push("                       (int32_t)(uint32_t)y->f_b, (int32_t)(uint32_t)(y->f_b >> 32) };")
    if name == "simd_i32x4_min" {
        a.push("    int32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = la[k] < lb[k] ? la[k] : lb[k];")
    } else if name == "simd_i32x4_max" {
        a.push("    int32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = la[k] > lb[k] ? la[k] : lb[k];")
    } else {
        let mut c_op: str = "+"
        if name == "simd_i32x4_sub" {
            c_op = "-"
        } else if name == "simd_i32x4_mul" {
            c_op = "*"
        }
        a.push("    uint32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = (uint32_t)((uint64_t)(uint32_t)la[k] " + c_op + " (uint64_t)(uint32_t)lb[k]);")
    }
    a.push("    r->f_a = (int64_t)((uint64_t)(uint32_t)lr[0] | ((uint64_t)(uint32_t)lr[1] << 32));")
    a.push("    r->f_b = (int64_t)((uint64_t)(uint32_t)lr[2] | ((uint64_t)(uint32_t)lr[3] << 32));")
    a.push("    hl_release_I32x4(x); hl_release_I32x4(y);")
    a.push("    return r;")
    a.push("}")
}

# simd_emit_rvv_f64x2_ew: one elementwise f64x2 kernel using RVV.
fn simd_emit_rvv_f64x2_ew(ctx: Ctx, name: str, intrinsic: str) -> void {
    let m: list[str] = ctx.simd_helpers_rvv
    let a: list[str] = ctx.simd_helpers_alt
    let mut c_op: str = "+"
    if name == "simd_f64x2_sub" {
        c_op = "-"
    } else if name == "simd_f64x2_mul" {
        c_op = "*"
    }
    m.push("/* " + name + " (RVV) */")
    m.push("static F64x2* hl_" + name + "(F64x2* x_p, F64x2* y_p) {")
    m.push("    F64x2* x = x_p; F64x2* y = y_p;")
    m.push("    F64x2* r = usf_new_F64x2(0.0, 0.0);")
    m.push("    /* RVV 1.0: vl=2 (2 f64 lanes at LMUL=1, VLEN>=128). */")
    m.push("    vfloat64m1_t va = __riscv_vle64_v_f64m1((const double*)&x->f_a, 2);")
    m.push("    vfloat64m1_t vb = __riscv_vle64_v_f64m1((const double*)&y->f_a, 2);")
    m.push("    vfloat64m1_t c = " + intrinsic + "(va, vb, 2);")
    m.push("    __riscv_vse64_v_f64m1((double*)&r->f_a, c, 2);")
    m.push("    hl_release_F64x2(x); hl_release_F64x2(y);")
    m.push("    return r;")
    m.push("}")
    a.push("/* " + name + " (scalar fallback) */")
    a.push("static F64x2* hl_" + name + "(F64x2* x_p, F64x2* y_p) {")
    a.push("    F64x2* x = x_p; F64x2* y = y_p;")
    a.push("    F64x2* r = usf_new_F64x2(0.0, 0.0);")
    a.push("    r->f_a = x->f_a " + c_op + " y->f_a;")
    a.push("    r->f_b = x->f_b " + c_op + " y->f_b;")
    a.push("    hl_release_F64x2(x); hl_release_F64x2(y);")
    a.push("    return r;")
    a.push("}")
}

# ============================================================================
# Stage 31 perfection (v0.48.1-alpha): fused-kernel NEON emission + the
# cache-blocked two-pass x86 kernels + one harmonised semantics.
#
# The two fused whole-loop kernels (simd_correlate8_sum_i32x4,
# simd_transform_sum_i32x4) previously pushed only into
# simd_helpers_main. Under --target-feature neon, simd_helper_lines
# emits simd_helpers_neon + simd_helpers_plain in the
# #if __aarch64__ branch and simd_helpers_alt + simd_helpers_plain in
# the #else branch — simd_helpers_main is NEVER included — so a real
# AArch64 host had NO definition for the two fused helpers while the
# call sites still referenced them: a latent LINK FAILURE (the test
# suite only cross-compiles the NEON build, it never links it on ARM
# hardware). Each fused kernel now has a real NEON implementation
# (simd_helpers_neon), an x86 intrinsic implementation (main,
# cache-blocked two-pass) and ONE shared portable fallback (alt).
#
# All three implementations are semantically identical on EVERY input,
# including the panic set and the panic order:
#   * the argument checks first (weights / k / sub / length), then
#   * an upfront fail-fast int32 range check of EVERY element
#     (ascending: xs fully, then ys for the transform kernel) — the
#     vector boundary rule applied to the whole list, not
#     window-by-window (the old implementations disagreed on exactly
#     which tail-region elements got checked),
#   * the documented per-window / per-element mod-2^32 lane wrap,
#     applied uniformly to the BODY and the TAIL alike (the old
#     portable tails used exact int64 arithmetic while the C
#     fallbacks wrapped — they disagreed on inputs whose per-window
#     results exceed int32),
#   * exact CHECKED int64 accumulation (hl_add_i64) of the
#     sign-extended lane values.
# ============================================================================

# simd_cvt_lo: sign-extend the LOW half of a vector accumulator to
# (W/2) int64 lanes. 128-bit: cvtepi32_epi64 of the whole register
# (2 int64 lanes). 256-bit: the low 128 bits.
fn simd_cvt_lo(ctx: Ctx, var: str) -> str {
    if ctx.target_feature == "avx2" {
        return "_mm256_cvtepi32_epi64(_mm256_castsi256_si128(" + var + "))"
    }
    return "_mm_cvtepi32_epi64(" + var + ")"
}

# simd_cvt_hi: sign-extend the HIGH half of a vector accumulator.
# 128-bit: lanes 2,3 shuffled down then cvtepi32_epi64. 256-bit: the
# high 128 bits.
fn simd_cvt_hi(ctx: Ctx, var: str) -> str {
    if ctx.target_feature == "avx2" {
        return "_mm256_cvtepi32_epi64(_mm256_extracti128_si256(" + var + ", 1))"
    }
    return "_mm_cvtepi32_epi64(_mm_shuffle_epi32(" + var + ", _MM_SHUFFLE(0,0,3,2)))"
}

# simd_store_vec: store a vector accumulator to an int64 array.
fn simd_store_vec(ctx: Ctx, arr: str, acc: str) -> str {
    if ctx.target_feature == "avx2" {
        return "_mm256_storeu_si256((__m256i*)" + arr + ", " + acc + ")"
    }
    return "_mm_storeu_si128((__m128i*)" + arr + ", " + acc + ")"
}

# simd_final_lanes: the checked int64 combine of the lo/hi lane
# accumulators (4 lanes under 128-bit vectors, 8 under 256-bit).
fn simd_final_lanes(ctx: Ctx) -> str {
    if ctx.target_feature == "avx2" {
        return "hl_add_i64(hl_add_i64(hl_add_i64(lo[0], lo[1]), hl_add_i64(lo[2], lo[3])), hl_add_i64(hl_add_i64(hi[0], hi[1]), hl_add_i64(hi[2], hi[3])))"
    }
    return "hl_add_i64(hl_add_i64(lo[0], lo[1]), hl_add_i64(hi[0], hi[1]))"
}

# simd_emit_x86_correlate8: the x86 intrinsic 8-tap FIR kernel. Cache-
# blocked two-pass design: pass 1 unboxes + range-checks BLOCK list
# elements into a contiguous int32 frame scratch array (each element
# is touched exactly ONCE — the old kernel re-unboxed every element
# once per window, 8x the pointer-chasing on the boxed list layout,
# which made the whole kernel memory-bound and the 2x acceptance gate
# flaky on small-cache CI runners); pass 2 runs the FIR over the
# contiguous block with W-wide loads (W = 8 under avx2, 4 under
# sse4.2). Per-window wrap mod 2^32, sign-extended, exact checked
# int64 accumulation.
fn simd_emit_x86_correlate8(ctx: Ctx) -> void {
    let m: list[str] = ctx.simd_helpers_main
    let wide: bool = ctx.target_feature == "avx2"
    let mut vt: str = "__m128i"
    let mut set1: str = "_mm_set1_epi32"
    let mut zero: str = "_mm_setzero_si128"
    let mut adde: str = "_mm_add_epi32"
    let mut mullo: str = "_mm_mullo_epi32"
    let mut add64: str = "_mm_add_epi64"
    let mut loadu: str = "_mm_loadu_si128((const __m128i*)"
    let mut wstr: str = "4"
    let mut wm1: str = "3"
    if wide {
        vt = "__m256i"
        set1 = "_mm256_set1_epi32"
        zero = "_mm256_setzero_si256"
        adde = "_mm256_add_epi32"
        mullo = "_mm256_mullo_epi32"
        add64 = "_mm256_add_epi64"
        loadu = "_mm256_loadu_si256((const __m256i*)"
        wstr = "8"
        wm1 = "7"
    }
    m.push("/* simd_correlate8_sum_i32x4 - 8-tap correlation (canonical FIR")
    m.push("   vectorisation). Cache-blocked two-pass kernel: pass 1 unboxes +")
    m.push("   range-checks BLOCK elements into a contiguous int32 scratch array")
    m.push("   (each element touched ONCE; the previous kernel re-unboxed every")
    m.push("   element once per window - 8x the pointer-chasing on the boxed")
    m.push("   list layout, which made the kernel memory-bound and the 2x")
    m.push("   acceptance gate flaky on small-cache hosts); pass 2 runs the FIR")
    m.push("   over the contiguous block. Semantics identical to the portable")
    m.push("   path: upfront fail-fast int32 check of every element, per-window")
    m.push("   wrap mod 2^32, sign-extended, exact checked int64 accumulation. */")
    m.push("__attribute__((target(\"" + ctx.target_feature + "\"))) static int64_t hl_simd_correlate8_sum_i32x4(hl_list* xs_p, int64_t w0, int64_t w1, int64_t w2, int64_t w3, int64_t w4, int64_t w5, int64_t w6, int64_t w7) {")
    m.push("    hl_list* xs = xs_p;")
    m.push("    int64_t ws[8] = { w0, w1, w2, w3, w4, w5, w6, w7 };")
    m.push("    for (int q = 0; q < 8; q++)")
    m.push("        if (ws[q] < INT32_MIN || ws[q] > INT32_MAX)")
    m.push("            hl_die(\"simd_correlate8_sum_i32x4: weight out of int32 range\");")
    m.push("    const int64_t n = xs->len;")
    m.push("    int64_t total = 0;")
    m.push("    if (n >= 8) {")
    m.push("        const int64_t last = n - 8;")
    m.push("        const int64_t BLOCK = 4096;")
    m.push("        int32_t buf[4104];")
    m.push("        " + vt + " vw[8];")
    m.push("        for (int t = 0; t < 8; t++) vw[t] = " + set1 + "((int32_t)ws[t]);")
    m.push("        " + vt + " acc0 = " + zero + "();")
    m.push("        " + vt + " acc1 = " + zero + "();")
    m.push("        int64_t base = 0;")
    m.push("        while (base <= last) {")
    m.push("            int64_t take = n - base;")
    m.push("            if (take > BLOCK + 7) take = BLOCK + 7;")
    m.push("            /* BLOCK window STARTS per block: the block loads")
    m.push("               elements [base, base+take) WITH the 7-element")
    m.push("               window overlap, processes window starts")
    m.push("               [base, base+take-8], then advances to the next")
    m.push("               unprocessed start - no window is skipped at a")
    m.push("               block boundary. */")
    m.push("            for (int64_t j = 0; j < take; j++) {")
    m.push("                int64_t v = hl_unbox_i64(xs->items[base + j]);")
    m.push("                if (v < INT32_MIN || v > INT32_MAX)")
    m.push("                    hl_die(\"simd i32x4 lane out of range\");")
    m.push("                buf[j] = (int32_t)v;")
    m.push("            }")
    m.push("            const int64_t stop = base + take - 8;")
    m.push("            int64_t i = base;")
    m.push("            for (; i + " + wm1 + " <= stop; i += " + wstr + ") {")
    m.push("                " + vt + " vac = " + zero + "();")
    m.push("                for (int t = 0; t < 8; t++)")
    m.push("                    vac = " + adde + "(vac, " + mullo + "(")
    m.push("                        " + loadu + "(buf + (i - base) + t)), vw[t]));")
    m.push("                acc0 = " + add64 + "(acc0, " + simd_cvt_lo(ctx, "vac") + ");")
    m.push("                acc1 = " + add64 + "(acc1, " + simd_cvt_hi(ctx, "vac") + ");")
    m.push("            }")
    m.push("            for (; i <= stop; i++) {")
    m.push("                uint64_t s = 0;")
    m.push("                for (int t = 0; t < 8; t++)")
    m.push("                    s += (uint64_t)(uint32_t)buf[i - base + t] * (uint64_t)(uint32_t)ws[t];")
    m.push("                total = hl_add_i64(total, (int64_t)(int32_t)(uint32_t)s);")
    m.push("            }")
    m.push("            base += take - 7; /* next unprocessed window start */")
    m.push("        }")
    m.push("        int64_t lo[4], hi[4];")
    m.push("        " + simd_store_vec(ctx, "lo", "acc0") + ";")
    m.push("        " + simd_store_vec(ctx, "hi", "acc1") + ";")
    m.push("        total = hl_add_i64(total, " + simd_final_lanes(ctx) + ");")
    m.push("    }")
    m.push("    hl_list_release(xs);")
    m.push("    return total;")
    m.push("}")
}

# simd_emit_x86_transform_sum: the x86 intrinsic fused transform kernel
# (sum of xs[i] + ys[i]*k - sub). Same cache-blocked two-pass design:
# pass 1 unboxes + range-checks xs then ys into two contiguous int32
# scratch arrays; pass 2 computes the transform W lanes at a time.
# Per-element wrap mod 2^32, exact checked int64 accumulation.
fn simd_emit_x86_transform_sum(ctx: Ctx) -> void {
    let m: list[str] = ctx.simd_helpers_main
    let wide: bool = ctx.target_feature == "avx2"
    let mut vt: str = "__m128i"
    let mut set1: str = "_mm_set1_epi32"
    let mut zero: str = "_mm_setzero_si128"
    let mut adde: str = "_mm_add_epi32"
    let mut sube: str = "_mm_sub_epi32"
    let mut mullo: str = "_mm_mullo_epi32"
    let mut add64: str = "_mm_add_epi64"
    let mut loadu: str = "_mm_loadu_si128((const __m128i*)"
    let mut wstr: str = "4"
    let mut wm1: str = "3"
    if wide {
        vt = "__m256i"
        set1 = "_mm256_set1_epi32"
        zero = "_mm256_setzero_si256"
        adde = "_mm256_add_epi32"
        sube = "_mm256_sub_epi32"
        mullo = "_mm256_mullo_epi32"
        add64 = "_mm256_add_epi64"
        loadu = "_mm256_loadu_si256((const __m256i*)"
        wstr = "8"
        wm1 = "7"
    }
    m.push("/* simd_transform_sum_i32x4 - the fused whole-loop kernel (Stage 21")
    m.push("   acceptance). Cache-blocked two-pass: pass 1 unboxes + range-checks")
    m.push("   xs then ys into contiguous int32 scratch arrays (each element")
    m.push("   touched once); pass 2 computes a + b*k - sub W lanes at a time.")
    m.push("   Semantics identical to the portable path: upfront fail-fast int32")
    m.push("   check of every element (xs ascending, then ys ascending),")
    m.push("   per-element wrap mod 2^32, exact checked int64 accumulation. */")
    m.push("__attribute__((target(\"" + ctx.target_feature + "\"))) static int64_t hl_simd_transform_sum_i32x4(hl_list* xs_p, hl_list* ys_p, int64_t k, int64_t sub) {")
    m.push("    hl_list* xs = xs_p; hl_list* ys = ys_p;")
    m.push("    if (xs->len != ys->len) hl_die(\"simd_transform_sum_i32x4: length mismatch\");")
    m.push("    if (k < INT32_MIN || k > INT32_MAX) hl_die(\"simd_transform_sum_i32x4: k out of int32 range\");")
    m.push("    if (sub < INT32_MIN || sub > INT32_MAX) hl_die(\"simd_transform_sum_i32x4: sub out of int32 range\");")
    m.push("    const int64_t n = xs->len;")
    m.push("    int64_t total = 0;")
    m.push("    if (n > 0) {")
    m.push("        const int64_t BLOCK = 4096;")
    m.push("        int32_t abuf[4096], bbuf[4096];")
    m.push("        " + vt + " vk = " + set1 + "((int32_t)k);")
    m.push("        " + vt + " vs = " + set1 + "((int32_t)sub);")
    m.push("        " + vt + " acc0 = " + zero + "();")
    m.push("        " + vt + " acc1 = " + zero + "();")
    m.push("        int64_t base = 0;")
    m.push("        while (base < n) {")
    m.push("            int64_t take = n - base;")
    m.push("            if (take > BLOCK) take = BLOCK;")
    m.push("            for (int64_t j = 0; j < take; j++) {")
    m.push("                int64_t a = hl_unbox_i64(xs->items[base + j]);")
    m.push("                if (a < INT32_MIN || a > INT32_MAX)")
    m.push("                    hl_die(\"simd i32x4 lane out of range\");")
    m.push("                abuf[j] = (int32_t)a;")
    m.push("            }")
    m.push("            for (int64_t j = 0; j < take; j++) {")
    m.push("                int64_t b = hl_unbox_i64(ys->items[base + j]);")
    m.push("                if (b < INT32_MIN || b > INT32_MAX)")
    m.push("                    hl_die(\"simd i32x4 lane out of range\");")
    m.push("                bbuf[j] = (int32_t)b;")
    m.push("            }")
    m.push("            int64_t i = base;")
    m.push("            for (; i + " + wm1 + " < base + take; i += " + wstr + ") {")
    m.push("                " + vt + " va = " + loadu + "(abuf + (i - base)));")
    m.push("                " + vt + " vb = " + loadu + "(bbuf + (i - base)));")
    m.push("                " + vt + " vtv = " + adde + "(va, " + sube + "(" + mullo + "(vb, vk), vs));")
    m.push("                acc0 = " + add64 + "(acc0, " + simd_cvt_lo(ctx, "vtv") + ");")
    m.push("                acc1 = " + add64 + "(acc1, " + simd_cvt_hi(ctx, "vtv") + ");")
    m.push("            }")
    m.push("            for (; i < base + take; i++) {")
    m.push("                int64_t a = abuf[i - base];")
    m.push("                int64_t b = bbuf[i - base];")
    m.push("                total = hl_add_i64(total, (int64_t)(int32_t)(uint32_t)(a + b * k - sub));")
    m.push("            }")
    m.push("            base += take;")
    m.push("        }")
    m.push("        int64_t lo[4], hi[4];")
    m.push("        " + simd_store_vec(ctx, "lo", "acc0") + ";")
    m.push("        " + simd_store_vec(ctx, "hi", "acc1") + ";")
    m.push("        total = hl_add_i64(total, " + simd_final_lanes(ctx) + ");")
    m.push("    }")
    m.push("    hl_list_release(xs); hl_list_release(ys);")
    m.push("    return total;")
    m.push("}")
}

# simd_emit_neon_correlate8: the NEON fused 8-tap FIR kernel (Stage 31
# perfection, v0.48.1-alpha). Same cache-blocked two-pass design as the
# x86 kernel; 4-wide (int32x4_t) contiguous loads via vld1q_s32 +
# vmulq_s32 + vaddq_s32 (both wrap per lane — the documented SIMD
# contract), sign-extension via vmovl_s32, exact checked int64
# accumulation.
fn simd_emit_neon_correlate8(ctx: Ctx) -> void {
    let m: list[str] = ctx.simd_helpers_neon
    m.push("/* simd_correlate8_sum_i32x4 (NEON, cache-blocked two-pass). */")
    m.push("static int64_t hl_simd_correlate8_sum_i32x4(hl_list* xs_p, int64_t w0, int64_t w1, int64_t w2, int64_t w3, int64_t w4, int64_t w5, int64_t w6, int64_t w7) {")
    m.push("    hl_list* xs = xs_p;")
    m.push("    int64_t ws[8] = { w0, w1, w2, w3, w4, w5, w6, w7 };")
    m.push("    for (int q = 0; q < 8; q++)")
    m.push("        if (ws[q] < INT32_MIN || ws[q] > INT32_MAX)")
    m.push("            hl_die(\"simd_correlate8_sum_i32x4: weight out of int32 range\");")
    m.push("    const int64_t n = xs->len;")
    m.push("    int64_t total = 0;")
    m.push("    if (n >= 8) {")
    m.push("        const int64_t last = n - 8;")
    m.push("        const int64_t BLOCK = 4096;")
    m.push("        int32_t buf[4104];")
    m.push("        int32x4_t vw[8];")
    m.push("        for (int t = 0; t < 8; t++) vw[t] = vdupq_n_s32((int32_t)ws[t]);")
    m.push("        int64x2_t acc0 = vdupq_n_s64(0);")
    m.push("        int64x2_t acc1 = vdupq_n_s64(0);")
    m.push("        int64_t base = 0;")
    m.push("        while (base <= last) {")
    m.push("            int64_t take = n - base;")
    m.push("            if (take > BLOCK + 7) take = BLOCK + 7;")
    m.push("            /* BLOCK window STARTS per block: the block loads")
    m.push("               elements [base, base+take) WITH the 7-element")
    m.push("               window overlap, processes window starts")
    m.push("               [base, base+take-8], then advances to the next")
    m.push("               unprocessed start - no window is skipped at a")
    m.push("               block boundary. */")
    m.push("            for (int64_t j = 0; j < take; j++) {")
    m.push("                int64_t v = hl_unbox_i64(xs->items[base + j]);")
    m.push("                if (v < INT32_MIN || v > INT32_MAX)")
    m.push("                    hl_die(\"simd i32x4 lane out of range\");")
    m.push("                buf[j] = (int32_t)v;")
    m.push("            }")
    m.push("            const int64_t stop = base + take - 8;")
    m.push("            int64_t i = base;")
    m.push("            for (; i + 3 <= stop; i += 4) {")
    m.push("                int32x4_t vac = vdupq_n_s32(0);")
    m.push("                for (int t = 0; t < 8; t++)")
    m.push("                    vac = vaddq_s32(vac, vmulq_s32(")
    m.push("                        vld1q_s32(buf + (i - base) + t), vw[t]));")
    m.push("                acc0 = vaddq_s64(acc0, vmovl_s32(vget_low_s32(vac)));")
    m.push("                acc1 = vaddq_s64(acc1, vmovl_s32(vget_high_s32(vac)));")
    m.push("            }")
    m.push("            for (; i <= stop; i++) {")
    m.push("                uint64_t s = 0;")
    m.push("                for (int t = 0; t < 8; t++)")
    m.push("                    s += (uint64_t)(uint32_t)buf[i - base + t] * (uint64_t)(uint32_t)ws[t];")
    m.push("                total = hl_add_i64(total, (int64_t)(int32_t)(uint32_t)s);")
    m.push("            }")
    m.push("            base += take - 7; /* next unprocessed window start */")
    m.push("        }")
    m.push("        int64_t f0 = vgetq_lane_s64(acc0, 0);")
    m.push("        int64_t f1 = vgetq_lane_s64(acc0, 1);")
    m.push("        int64_t f2 = vgetq_lane_s64(acc1, 0);")
    m.push("        int64_t f3 = vgetq_lane_s64(acc1, 1);")
    m.push("        total = hl_add_i64(total, hl_add_i64(hl_add_i64(f0, f1), hl_add_i64(f2, f3)));")
    m.push("    }")
    m.push("    hl_list_release(xs);")
    m.push("    return total;")
    m.push("}")
}

# simd_emit_neon_transform_sum: the NEON fused transform kernel.
fn simd_emit_neon_transform_sum(ctx: Ctx) -> void {
    let m: list[str] = ctx.simd_helpers_neon
    m.push("/* simd_transform_sum_i32x4 (NEON, cache-blocked two-pass). */")
    m.push("static int64_t hl_simd_transform_sum_i32x4(hl_list* xs_p, hl_list* ys_p, int64_t k, int64_t sub) {")
    m.push("    hl_list* xs = xs_p; hl_list* ys = ys_p;")
    m.push("    if (xs->len != ys->len) hl_die(\"simd_transform_sum_i32x4: length mismatch\");")
    m.push("    if (k < INT32_MIN || k > INT32_MAX) hl_die(\"simd_transform_sum_i32x4: k out of int32 range\");")
    m.push("    if (sub < INT32_MIN || sub > INT32_MAX) hl_die(\"simd_transform_sum_i32x4: sub out of int32 range\");")
    m.push("    const int64_t n = xs->len;")
    m.push("    int64_t total = 0;")
    m.push("    if (n > 0) {")
    m.push("        const int64_t BLOCK = 4096;")
    m.push("        int32_t abuf[4096], bbuf[4096];")
    m.push("        int32x4_t vk = vdupq_n_s32((int32_t)k);")
    m.push("        int32x4_t vs = vdupq_n_s32((int32_t)sub);")
    m.push("        int64x2_t acc0 = vdupq_n_s64(0);")
    m.push("        int64x2_t acc1 = vdupq_n_s64(0);")
    m.push("        int64_t base = 0;")
    m.push("        while (base < n) {")
    m.push("            int64_t take = n - base;")
    m.push("            if (take > BLOCK) take = BLOCK;")
    m.push("            for (int64_t j = 0; j < take; j++) {")
    m.push("                int64_t a = hl_unbox_i64(xs->items[base + j]);")
    m.push("                if (a < INT32_MIN || a > INT32_MAX)")
    m.push("                    hl_die(\"simd i32x4 lane out of range\");")
    m.push("                abuf[j] = (int32_t)a;")
    m.push("            }")
    m.push("            for (int64_t j = 0; j < take; j++) {")
    m.push("                int64_t b = hl_unbox_i64(ys->items[base + j]);")
    m.push("                if (b < INT32_MIN || b > INT32_MAX)")
    m.push("                    hl_die(\"simd i32x4 lane out of range\");")
    m.push("                bbuf[j] = (int32_t)b;")
    m.push("            }")
    m.push("            int64_t i = base;")
    m.push("            for (; i + 3 < base + take; i += 4) {")
    m.push("                int32x4_t va = vld1q_s32(abuf + (i - base));")
    m.push("                int32x4_t vb = vld1q_s32(bbuf + (i - base));")
    m.push("                int32x4_t vtv = vaddq_s32(va, vsubq_s32(vmulq_s32(vb, vk), vs));")
    m.push("                acc0 = vaddq_s64(acc0, vmovl_s32(vget_low_s32(vtv)));")
    m.push("                acc1 = vaddq_s64(acc1, vmovl_s32(vget_high_s32(vtv)));")
    m.push("            }")
    m.push("            for (; i < base + take; i++) {")
    m.push("                int64_t a = abuf[i - base];")
    m.push("                int64_t b = bbuf[i - base];")
    m.push("                total = hl_add_i64(total, (int64_t)(int32_t)(uint32_t)(a + b * k - sub));")
    m.push("            }")
    m.push("            base += take;")
    m.push("        }")
    m.push("        int64_t f0 = vgetq_lane_s64(acc0, 0);")
    m.push("        int64_t f1 = vgetq_lane_s64(acc0, 1);")
    m.push("        int64_t f2 = vgetq_lane_s64(acc1, 0);")
    m.push("        int64_t f3 = vgetq_lane_s64(acc1, 1);")
    m.push("        total = hl_add_i64(total, hl_add_i64(hl_add_i64(f0, f1), hl_add_i64(f2, f3)));")
    m.push("    }")
    m.push("    hl_list_release(xs); hl_list_release(ys);")
    m.push("    return total;")
    m.push("}")
}

# simd_emit_alt_correlate8: the portable scalar fallback shared by the
# x86 (#else) and NEON (#else) branches. Semantics identical to the
# intrinsic kernels above: upfront fail-fast int32 check (ascending),
# per-window wrap mod 2^32, exact checked int64 accumulation. The old
# fallback wrapped the tail differently from the intrinsic paths and
# checked only body-region elements — it now matches the portable
# std/simd.hls definition exactly (all implementations agree on every
# input, including the panic set).
fn simd_emit_alt_correlate8(ctx: Ctx) -> void {
    let a: list[str] = ctx.simd_helpers_alt
    a.push("/* simd_correlate8_sum_i32x4 (portable scalar fallback). */")
    a.push("static int64_t hl_simd_correlate8_sum_i32x4(hl_list* xs_p, int64_t w0, int64_t w1, int64_t w2, int64_t w3, int64_t w4, int64_t w5, int64_t w6, int64_t w7) {")
    a.push("    hl_list* xs = xs_p;")
    a.push("    int64_t ws[8] = { w0, w1, w2, w3, w4, w5, w6, w7 };")
    a.push("    for (int q = 0; q < 8; q++)")
    a.push("        if (ws[q] < INT32_MIN || ws[q] > INT32_MAX)")
    a.push("            hl_die(\"simd_correlate8_sum_i32x4: weight out of int32 range\");")
    a.push("    const int64_t n = xs->len;")
    a.push("    for (int64_t q = 0; q < n; q++) {")
    a.push("        int64_t v = hl_unbox_i64(xs->items[q]);")
    a.push("        if (v < INT32_MIN || v > INT32_MAX)")
    a.push("            hl_die(\"simd i32x4 lane out of range\");")
    a.push("    }")
    a.push("    int64_t total = 0;")
    a.push("    for (int64_t i = 0; i + 8 <= n; i++) {")
    a.push("        uint64_t s = 0;")
    a.push("        for (int t = 0; t < 8; t++)")
    a.push("            s += (uint64_t)(uint32_t)hl_unbox_i64(xs->items[i + t]) * (uint64_t)(uint32_t)ws[t];")
    a.push("        total = hl_add_i64(total, (int64_t)(int32_t)(uint32_t)s);")
    a.push("    }")
    a.push("    hl_list_release(xs);")
    a.push("    return total;")
    a.push("}")
}

# simd_emit_alt_transform_sum: the portable scalar fallback for the
# transform kernel (same harmonised semantics).
fn simd_emit_alt_transform_sum(ctx: Ctx) -> void {
    let p: list[str] = ctx.simd_helpers_alt
    p.push("/* simd_transform_sum_i32x4 (portable scalar fallback). */")
    p.push("static int64_t hl_simd_transform_sum_i32x4(hl_list* xs_p, hl_list* ys_p, int64_t k, int64_t sub) {")
    p.push("    hl_list* xs = xs_p; hl_list* ys = ys_p;")
    p.push("    if (xs->len != ys->len) hl_die(\"simd_transform_sum_i32x4: length mismatch\");")
    p.push("    if (k < INT32_MIN || k > INT32_MAX) hl_die(\"simd_transform_sum_i32x4: k out of int32 range\");")
    p.push("    if (sub < INT32_MIN || sub > INT32_MAX) hl_die(\"simd_transform_sum_i32x4: sub out of int32 range\");")
    p.push("    const int64_t n = xs->len;")
    p.push("    for (int64_t q = 0; q < n; q++) {")
    p.push("        int64_t v = hl_unbox_i64(xs->items[q]);")
    p.push("        if (v < INT32_MIN || v > INT32_MAX) hl_die(\"simd i32x4 lane out of range\");")
    p.push("    }")
    p.push("    for (int64_t q = 0; q < n; q++) {")
    p.push("        int64_t v = hl_unbox_i64(ys->items[q]);")
    p.push("        if (v < INT32_MIN || v > INT32_MAX) hl_die(\"simd i32x4 lane out of range\");")
    p.push("    }")
    p.push("    int64_t total = 0;")
    p.push("    for (int64_t i = 0; i < n; i++) {")
    p.push("        int64_t a = hl_unbox_i64(xs->items[i]);")
    p.push("        int64_t b = hl_unbox_i64(ys->items[i]);")
    p.push("        total = hl_add_i64(total, (int64_t)(int32_t)(uint32_t)(a + b * k - sub));")
    p.push("    }")
    p.push("    hl_list_release(xs); hl_list_release(ys);")
    p.push("    return total;")
    p.push("}")
}

# simd_emit_helper: dispatch one kernel into the main/alt lists. The
# gather/scatter kernels are arch-independent (plain C field work — the
# win is eliminating the per-element runtime calls), so they go into
# BOTH lists (guarded only by the #if/#else split for tidiness).
fn simd_emit_helper(ctx: Ctx, name: str) -> void {
    # Stage 25 (v0.44.0-alpha): when --target-feature neon is given,
    # dispatch to the NEON emitter (which pushes into simd_helpers_neon
    # + simd_helpers_alt). Otherwise dispatch to the x86 emitter (which
    # pushes into simd_helpers_main + simd_helpers_alt).
    # Stage 26 (v0.49.0-alpha): when --target-feature rvv is given,
    # dispatch to the RVV emitter (which pushes into simd_helpers_rvv
    # + simd_helpers_alt).
    let use_neon: bool = ctx.target_feature == "neon"
    let use_rvv: bool = ctx.target_feature == "rvv"
    if name == "simd_i32x4_add" {
        if use_neon {
            simd_emit_neon_i32x4_ew(ctx, name, "vaddq_s32")
        } else if use_rvv {
            simd_emit_rvv_i32x4_ew(ctx, name, "__riscv_vadd_vv_i32m1")
        } else {
            simd_emit_i32x4_ew(ctx, name, "_mm_add_epi32")
        }
        return
    }
    if name == "simd_i32x4_sub" {
        if use_neon {
            simd_emit_neon_i32x4_ew(ctx, name, "vsubq_s32")
        } else if use_rvv {
            simd_emit_rvv_i32x4_ew(ctx, name, "__riscv_vsub_vv_i32m1")
        } else {
            simd_emit_i32x4_ew(ctx, name, "_mm_sub_epi32")
        }
        return
    }
    if name == "simd_i32x4_mul" {
        if use_neon {
            simd_emit_neon_i32x4_ew(ctx, name, "vmulq_s32")
        } else if use_rvv {
            simd_emit_rvv_i32x4_ew(ctx, name, "__riscv_vmul_vv_i32m1")
        } else {
            simd_emit_i32x4_ew(ctx, name, "_mm_mullo_epi32")
        }
        return
    }
    if name == "simd_i32x4_min" {
        if use_neon {
            simd_emit_neon_i32x4_ew(ctx, name, "vminq_s32")
        } else if use_rvv {
            simd_emit_rvv_i32x4_ew(ctx, name, "__riscv_vmin_vv_i32m1")
        } else {
            simd_emit_i32x4_ew(ctx, name, "_mm_min_epi32")
        }
        return
    }
    if name == "simd_i32x4_max" {
        if use_neon {
            simd_emit_neon_i32x4_ew(ctx, name, "vmaxq_s32")
        } else if use_rvv {
            simd_emit_rvv_i32x4_ew(ctx, name, "__riscv_vmax_vv_i32m1")
        } else {
            simd_emit_i32x4_ew(ctx, name, "_mm_max_epi32")
        }
        return
    }
    if name == "simd_f64x2_add" {
        if use_neon {
            simd_emit_neon_f64x2_ew(ctx, name, "vaddq_f64")
        } else if use_rvv {
            simd_emit_rvv_f64x2_ew(ctx, name, "__riscv_vadd_vv_f64m1")
        } else {
            simd_emit_f64x2_ew(ctx, name, "_mm_add_pd")
        }
        return
    }
    if name == "simd_f64x2_sub" {
        if use_neon {
            simd_emit_neon_f64x2_ew(ctx, name, "vsubq_f64")
        } else if use_rvv {
            simd_emit_rvv_f64x2_ew(ctx, name, "__riscv_vsub_vv_f64m1")
        } else {
            simd_emit_f64x2_ew(ctx, name, "_mm_sub_pd")
        }
        return
    }
    if name == "simd_f64x2_mul" {
        if use_neon {
            simd_emit_neon_f64x2_ew(ctx, name, "vmulq_f64")
        } else if use_rvv {
            simd_emit_rvv_f64x2_ew(ctx, name, "__riscv_vmul_vv_f64m1")
        } else {
            simd_emit_f64x2_ew(ctx, name, "_mm_mul_pd")
        }
        return
    }
    if name == "simd_i32x4_gather" {
        let b: list[str] = ctx.simd_helpers_plain
        b.push("/* " + name + " */")
        b.push("static I32x4* hl_" + name + "(hl_list* xs_p, int64_t i) {")
        b.push("    hl_list* xs = xs_p;")
        b.push("    if (i < 0 || i + 4 > xs->len) hl_die(\"simd gather out of bounds\");")
        b.push("    int64_t v[4];")
        b.push("    for (int k = 0; k < 4; k++) {")
        b.push("        v[k] = hl_unbox_i64(xs->items[i + k]);")
        b.push("        if (v[k] < INT32_MIN || v[k] > INT32_MAX)")
        b.push("            hl_die(\"simd i32x4 lane out of range\");")
        b.push("    }")
        b.push("    I32x4* r = usf_new_I32x4(0, 0);")
        b.push("    r->f_a = (int64_t)((uint32_t)v[0] | ((uint64_t)(uint32_t)v[1] << 32));")
        b.push("    r->f_b = (int64_t)((uint32_t)v[2] | ((uint64_t)(uint32_t)v[3] << 32));")
        b.push("    hl_list_release(xs);")
        b.push("    return r;")
        b.push("}")
        return
    }
    if name == "simd_f64x2_gather" {
        let b: list[str] = ctx.simd_helpers_plain
        b.push("/* " + name + " */")
        b.push("static F64x2* hl_" + name + "(hl_list* xs_p, int64_t i) {")
        b.push("    hl_list* xs = xs_p;")
        b.push("    if (i < 0 || i + 2 > xs->len) hl_die(\"simd gather out of bounds\");")
        b.push("    F64x2* r = usf_new_F64x2(hl_unbox_f64(xs->items[i]), hl_unbox_f64(xs->items[i + 1]));")
        b.push("    hl_list_release(xs);")
        b.push("    return r;")
        b.push("}")
        return
    }
    if name == "simd_correlate8_sum_i32x4" {
        # Stage 31 perfection (v0.48.1-alpha): dispatch by target — NEON
        # hosts now get a real fused kernel (the old code pushed the
        # x86 intrinsic version into simd_helpers_main for EVERY
        # target; under --target-feature neon that list is never
        # emitted, leaving real AArch64 hardware with an undefined
        # symbol). All targets share one portable fallback.
        if ctx.target_feature == "neon" {
            simd_emit_neon_correlate8(ctx)
        } else {
            simd_emit_x86_correlate8(ctx)
        }
        simd_emit_alt_correlate8(ctx)
        return
    }
    if name == "simd_transform_sum_i32x4" {
        if ctx.target_feature == "neon" {
            simd_emit_neon_transform_sum(ctx)
        } else {
            simd_emit_x86_transform_sum(ctx)
        }
        simd_emit_alt_transform_sum(ctx)
        return
    }
    if name == "simd_i32x4_scatter" {
        let b: list[str] = ctx.simd_helpers_plain
        b.push("/* " + name + " */")
        b.push("static void hl_" + name + "(hl_list* xs_p, int64_t i, I32x4* v_p) {")
        b.push("    hl_list* xs = xs_p;")
        b.push("    I32x4* v = v_p;")
        b.push("    if (i < 0 || i + 4 > xs->len) hl_die(\"simd scatter out of bounds\");")
        b.push("    int64_t lane[4] = { (int64_t)(int32_t)(uint32_t)v->f_a, (int64_t)(int32_t)(uint32_t)(v->f_a >> 32),")
        b.push("                       (int64_t)(int32_t)(uint32_t)v->f_b, (int64_t)(int32_t)(uint32_t)(v->f_b >> 32) };")
        b.push("    for (int k = 0; k < 4; k++) {")
        b.push("        if (xs->elem_free) xs->elem_free(xs->items[i + k]);")
        b.push("        xs->items[i + k] = hl_box_i64(lane[k]);")
        b.push("    }")
        b.push("    hl_release_I32x4(v);")
        b.push("    hl_list_release(xs);")
        b.push("}")
        return
    }
    if name == "simd_f64x2_scatter" {
        let b: list[str] = ctx.simd_helpers_plain
        b.push("/* " + name + " */")
        b.push("static void hl_" + name + "(hl_list* xs_p, int64_t i, F64x2* v_p) {")
        b.push("    hl_list* xs = xs_p;")
        b.push("    F64x2* v = v_p;")
        b.push("    if (i < 0 || i + 2 > xs->len) hl_die(\"simd scatter out of bounds\");")
        b.push("    if (xs->elem_free) xs->elem_free(xs->items[i]);")
        b.push("    xs->items[i] = hl_box_f64(v->f_a);")
        b.push("    if (xs->elem_free) xs->elem_free(xs->items[i + 1]);")
        b.push("    xs->items[i + 1] = hl_box_f64(v->f_b);")
        b.push("    hl_release_F64x2(v);")
        b.push("    hl_list_release(xs);")
        b.push("}")
        return
    }
}

# Stage 21 perfection (v0.40.0-alpha): simd_detect_native_feature —
# auto-detect the host CPU's best SIMD feature. Called from main()
# when the user passes `--target-feature native`. The probe uses the
# existing simd_cpu_supports() builtin (a runtime CPU probe via
# __builtin_cpu_supports on x86 / NEON baseline on aarch64). The
# result is one of "avx2", "sse4.2", "neon", "rvv", or "" (no fast path).
#
# Preference order (x86): avx2 (the strongest feature the std.simd
# intrinsic fast paths support today; AVX-512 tuning is post-1.0)
# > sse4.2 > "" (portable). On aarch64: neon (baseline) > "". On
# RISC-V 64 (Stage 26): rvv when the V extension is available > "".
# On other architectures: "" (portable path — no intrinsic fast paths
# emitted, the std.simd kernels run their pure-HLS implementation).
fn simd_detect_native_feature() -> str {
    if simd_cpu_supports("avx2") {
        return "avx2"
    }
    if simd_cpu_supports("sse4.2") {
        return "sse4.2"
    }
    if simd_cpu_supports("neon") {
        return "neon"
    }
    # Stage 26 (v0.49.0-alpha): RISC-V Vector extension. The probe
    # uses simd_cpu_supports("rvv") which checks for the __riscv_v
    # macro (defined by gcc/clang when -march includes the V extension).
    if simd_cpu_supports("rvv") {
        return "rvv"
    }
    return ""
}

# simd_helper_lines: assemble the final C block (prologue + main + alt
# with the arch #if/#else/#endif split, or scalar-only for neon).
fn simd_helper_lines(ctx: Ctx) -> list[str] {
    let out: list[str] = []
    if ctx.simd_helper_names.len() == 0 {
        return out
    }
    let x86: bool = ctx.target_feature == "sse4.2" || ctx.target_feature == "avx2"
    out.push("// ===== Stage 21 (v0.37.0-alpha): std.simd intrinsic fast paths =====")
    out.push("//      --target-feature " + ctx.target_feature
    + " — semantics identical to the portable std/simd.hls path.")
    if x86 {
        out.push("#if defined(__x86_64__) || defined(__i386__)")
        out.push("#include <immintrin.h>")
        concat_lines(out, ctx.simd_helpers_main)
        concat_lines(out, ctx.simd_helpers_plain)
        # Stage 25 (v0.44.0-alpha): if --target-feature neon was given,
        # the NEON emitters populated simd_helpers_neon too — emit them
        # in the #elif __aarch64__ branch so the same C source compiles
        # on both x86 (uses SSE/AVX) and aarch64 (uses NEON).
        if ctx.simd_helpers_neon.len() > 0 {
            out.push("#elif defined(__aarch64__) || defined(__ARM_NEON__)")
            out.push("#include <arm_neon.h>")
            concat_lines(out, ctx.simd_helpers_neon)
            concat_lines(out, ctx.simd_helpers_plain)
        }
        out.push("#else")
        out.push("// non-x86/non-NEON host: portable scalar fallback.")
        concat_lines(out, ctx.simd_helpers_alt)
        concat_lines(out, ctx.simd_helpers_plain)
        out.push("#endif")
    } else if ctx.target_feature == "neon" {
        # Stage 25: --target-feature neon — emit the NEON intrinsics in
        # the #if __aarch64__ branch, with the scalar fallback in #else.
        out.push("#if defined(__aarch64__) || defined(__ARM_NEON__)")
        out.push("#include <arm_neon.h>")
        concat_lines(out, ctx.simd_helpers_neon)
        concat_lines(out, ctx.simd_helpers_plain)
        out.push("#else")
        out.push("// non-NEON host: portable scalar fallback.")
        concat_lines(out, ctx.simd_helpers_alt)
        concat_lines(out, ctx.simd_helpers_plain)
        out.push("#endif")
    } else if ctx.target_feature == "rvv" {
        # Stage 26 (v0.49.0-alpha): --target-feature rvv — emit the RVV
        # intrinsics in the #if __riscv && __riscv_v branch, with the
        # scalar fallback in #else. The __riscv_v macro is defined by
        # the C compiler when -march=rv64gcv (or any arch with the V
        # extension) is in effect; __riscv is the baseline RISC-V macro.
        out.push("#if defined(__riscv) && defined(__riscv_v)")
        out.push("#include <riscv_vector.h>")
        concat_lines(out, ctx.simd_helpers_rvv)
        concat_lines(out, ctx.simd_helpers_plain)
        out.push("#else")
        out.push("// non-RISC-V host: portable scalar fallback.")
        concat_lines(out, ctx.simd_helpers_alt)
        concat_lines(out, ctx.simd_helpers_plain)
        out.push("#endif")
    } else {
        out.push("// NEON intrinsic tuning is Stage 25 (AArch64 backend); the")
        out.push("// RVV intrinsic tuning is Stage 26 (RISC-V backend); the")
        out.push("// arch-independent fast paths below eliminate the per-element")
        out.push("// runtime calls on every host.")
        concat_lines(out, ctx.simd_helpers_alt)
        concat_lines(out, ctx.simd_helpers_plain)
    }
    out.push("")
    return out
}

# pgo_dump_lines: the C lines for the --pgo-generate profile dumper —
# the site-id table + __hlc_pgo_dump(). Emitted after all function
# bodies (so the site list is complete) and before main (which
# registers the dumper via atexit). The dump is BEST-EFFORT: a profile
# file that cannot be opened is silently skipped — instrumentation must
# never change program behaviour, including its exit code.
