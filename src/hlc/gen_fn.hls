# ============================================================================
# hlc/gen_fn.hls — part of the hlc compiler (split from the original single-file
# src/hlc.hls). This file is loaded via `import "hlc/gen_fn.hls"` from src/hlc.hls.
# Section 5g — CODEGEN: function bodies, struct/enum emission, clone generation, gen_program driver.
# NOTE: content is byte-identical to the original src/hlc.hls line range
#       19261..20521 - module split is purely structural, zero code changes.
# ============================================================================
fn gen_fn_body(ctx: Ctx, key: str) -> void {
    let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
    # Stage 15-beta: extern fns are forward declarations for C functions.
    # Emit just the prototype (no body) using the RAW C name (no `usf_`
    # prefix) so the C linker can resolve them from libc.
    if f.is_extern {
        gen_reset_fn(ctx)
        let ptypes_c: list[str] = []
        let mut i: int = 0
        while i < f.params.len() {
            ptypes_c.push(c_type(ctx, f.ptypes.get(i)))
            i = i + 1
        }
        let mut sig: str = c_type(ctx, f.ret) + " " + f.name + "("
        if ptypes_c.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(ptypes_c, ", ") + ")"
        }
        ctx.out.push(sig + ";")
        ctx.out.push("")
        return
    }
    gen_reset_fn(ctx)
    # v0.30.0-alpha: record the fn key for the return handler's ensures
    # checks (gen_reset_fn just cleared it).
    ctx.cur_fn = key
    let ptypes_c: list[str] = []
    let inst_ptypes: list[str] = []
    let mut i: int = 0
    while i < f.params.len() {
        inst_ptypes.push(f.ptypes.get(i))
        ptypes_c.push(c_type(ctx, f.ptypes.get(i)))
        i = i + 1
    }
    # Stage 8-beta: parameters own one retain of each argument. The
    # signature carries `<name>_p` params; the body starts with owned
    # local copies (see gen_param_locals / emit_param_local_decls).
    let param_local_names: list[str] = []
    let sig_params: list[str] = []
    gen_param_locals(ctx, f, ptypes_c, param_local_names, sig_params)
    # For generic functions, we emit a specialization. The "key" passed in is
    # the original key; we generate a specialization with a mangled name when
    # the function has type params. The specialization instantiation is
    # handled in gen_program by enumerating instantiations.
    let mut fname: str = "usf_" + c_fn_name(key)
    # BUG-010 fix: removed dead branch that built a mangled name from the
    # type-parameter NAMES (e.g. "T") instead of the type ARGS (e.g. "int").
    # That branch was unreachable because gen_program never routes generic
    # functions through gen_fn_body — they go through gen_fn_inst_lines.
    let mut sig: str = c_type(ctx, f.ret) + " " + fname + "("
    if sig_params.len() == 0 {
        sig = sig + "void)"
    } else {
        sig = sig + join(sig_params, ", ") + ")"
    }
    # Stage 19 (v0.35.0-alpha): --pgo-use — annotate the function
    # signature hot/cold from the loaded profile (entry counts).
    # Stage 20: record the body's start index for LTO phase-B splicing.
    # Stage 28+29 (v0.45.0-alpha): the signature prefix now also
    # carries the user attributes (#[inline(always)], #[hot], #[cold],
    # #[no_red_zone], #[irq_handler]). When a Stage 29 attribute is
    # set, it OVERRIDES the PGO hint (the user's explicit decision
    # wins). When no Stage 29 attribute is set, the PGO profile is
    # consulted as before.
    let sig_start: int = ctx.out.len()
    ctx.lto_fn_start.set(key, sig_start)
    ctx.out.push(fn_attr_prefix(ctx, f, key) + sig + " {")
    emit_param_local_decls(ctx, f, inst_ptypes, param_local_names)
    # Stage 19: PGO — function-entry counter site (e:<fnkey>), emitted
    # under --pgo-generate as the first statement of the body.
    let entry_idx: int = pgo_site(ctx, "e:" + key)
    if ctx.pgo_gen {
        if entry_idx >= PGO_MAX_SITES() {
            panic("pgo: too many profile sites (limit 65536)")
        }
        ctx.out.push("    __hlc_pgo_counts[" + entry_idx.to_str() + "]++;")
    }
    # Stage 17 (v0.28.0-alpha): --contracts — emit the runtime `requires`
    # assertion at the function entry. The requires expression was checked
    # in the params-only scope, so every ident resolves to a param local.
    # SOUNDNESS: under -O fast the assertion is ALSO emitted when the fn
    # body contains proof-elided operations — an elided check is only
    # sound when the precondition that proved it is enforced.
    let mut want_req_check: bool = false
    if ctx.contracts_mode && f.requires_e >= 0 {
        want_req_check = true
    }
    if ctx.fast_mode && f.requires_e >= 0 && fn_has_elisions(ctx, f.body) {
        want_req_check = true
    }
    if want_req_check {
        let rc: str = gen_expr(ctx, f.requires_e)
        ctx.out.push("    if (!(" + rc + ")) hl_die(\"contract violation: requires of '"
        + f.name + "' (function precondition failed at runtime)\");")
    }
    # Stage 31 (v0.48.0-alpha): #[tail_call] — the loop entry. The
    # verifier proved the body flows only int / float / bool values
    # (plus consume-builtin string literals), so nothing between this
    # label and any goto below carries a cleanup attribute. A verified
    # tail self-call rebinds the parameter locals and jumps here:
    # a jmp, not a call — stack usage is constant at any recursion
    # depth. The label sits AFTER the param locals / PGO entry counter
    # / requires check so those run once per REAL entry, not per loop
    # iteration (the PGO entry counter keeps counting function
    # entries, which is exactly what a profile should count).
    if f.attr_tail_call {
        ctx.tail_label = "hl_tail_restart"
        ctx.tail_params = param_local_names
        ctx.out.push("hl_tail_restart:;")
    } else {
        ctx.tail_label = ""
        ctx.tail_params = []
    }
    gen_stmts(ctx, f.body, "    ")
    ctx.out.push("}")
    ctx.out.push("")
    # Stage 19: record the emitted body size; under --pgo-use, hot small
    # functions get a `static inline` hint retroactively patched onto the
    # already-pushed signature line (the prototype emitted later consults
    # the same map, so both stay consistent).
    # Stage 28+29 (v0.45.0-alpha): the retro-patch is ONLY for the PGO
    # path. When an explicit #[inline(always)] / #[inline(never)] /
    # #[hot] / #[cold] attribute is set, the prefix is already correct
    # on the signature line (the user attribute is emitted by
    # fn_attr_prefix above); no retro-patch is needed (and would be a
    # no-op: fn_inline_attr returns the same string on both calls).
    ctx.pgo_fn_sizes.set(key, ctx.out.len() - sig_start)
    if f.attr_inline == "" && pgo_fn_inline(ctx, key) {
        ctx.out.set(sig_start, "static inline " + ctx.out.get(sig_start))
    }
}

fn gen_struct_lines(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let names: list[str] = ctx.structs.keys()
    let mut i: int = 0
    while i < names.len() {
        let st: StructInfo = ctx.structs.get_or(names.get(i), dummy_struct())
        # For non-generic structs, emit a typedef and constructor.
        # For generic structs, the instantiations are emitted separately
        # (driven by gen_program which tracks all instantiations used).
        if st.typeparams.len() == 0 {
            let empty_targs: list[str] = []
            concat_lines(out, gen_one_struct_full(ctx, st.name, st, empty_targs))
        }
        i = i + 1
    }
    return out
}

# gen_one_struct_full: typedef (refcnt first) + constructor + release +
# cleanup for one struct definition (targs empty for non-generic).
fn gen_one_struct_full(ctx: Ctx, c_name: str, st: StructInfo, targs: list[str]) -> list[str] {
    let mut out: list[str] = []
    # 1. typedef — refcnt is the FIRST field so hl_retain works uniformly.
    out.push("typedef struct " + c_name + " {")
    out.push("    int64_t refcnt;")
    let mut j: int = 0
    while j < st.fields.len() {
        let ftype: str = st.ftypes.get(j)
        let mut inst_ftype: str = ""
        if st.typeparams.len() > 0 {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        } else {
            inst_ftype = ftype
        }
        out.push("    " + c_type(ctx, inst_ftype) + " " + c_field_name(st.fields.get(j)) + ";")
        j = j + 1
    }
    out.push("} " + c_name + ";")
    out.push("")
    # 2. constructor — stores its params raw: they arrive OWNED (the
    # call site own-wraps each field value). refcnt starts at 1.
    # The constructor takes ALL fields as parameters — gen_structlit
    # passes the provided values plus the default expressions evaluated
    # at the literal site (fresh values whose ownership transfers here).
    let ptypes_c: list[str] = []
    let assigns: list[str] = []
    let mut j2: int = 0
    while j2 < st.fields.len() {
        let ftype: str = st.ftypes.get(j2)
        let mut inst_ftype: str = ""
        if st.typeparams.len() > 0 {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        } else {
            inst_ftype = ftype
        }
        let cfn: str = c_field_name(st.fields.get(j2))
        ptypes_c.push(c_type(ctx, inst_ftype) + " " + cfn)
        assigns.push("    p->" + cfn + " = " + cfn + ";")
        j2 = j2 + 1
    }
    out.push("static " + c_name + "* usf_new_" + c_name + "(" + join(ptypes_c, ", ") + ") {")
    out.push("    " + c_name + "* p = (" + c_name + "*)malloc(sizeof(" + c_name + "));")
    out.push("    if (!p) hl_die(\"out of memory\");")
    out.push("    p->refcnt = 1;")
    let mut k: int = 0
    while k < assigns.len() {
        out.push(assigns.get(k))
        k = k + 1
    }
    out.push("    return p;")
    out.push("}")
    out.push("")
    # 3. release + cleanup (Stage 8-beta).
    concat_lines(out, gen_struct_release_lines(ctx, c_name, st, targs))
    return out
}

# gen_struct_release_lines: the refcounted destructor + cleanup wrapper.
# Only the pointer-typed fields are released; primitives are inline C data.
fn gen_struct_release_lines(ctx: Ctx, c_name: str, st: StructInfo, targs: list[str]) -> list[str] {
    let mut out: list[str] = []
    out.push("static void hl_release_" + c_name + "(void* pv) {")
    out.push("    " + c_name + "* p = (" + c_name + "*)pv;")
    out.push("    if (!p) return;")
    out.push("    if (--p->refcnt == 0) {")
    let mut j: int = 0
    while j < st.fields.len() {
        let ftype: str = st.ftypes.get(j)
        let mut inst_ftype: str = ""
        if st.typeparams.len() > 0 {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        } else {
            inst_ftype = ftype
        }
        if is_ptr_t(ctx, inst_ftype) {
            out.push("        " + release_call(ctx, inst_ftype, "p->" + c_field_name(st.fields.get(j))) + ";")
        }
        j = j + 1
    }
    out.push("        free(p);")
    out.push("    }")
    out.push("}")
    out.push("static void hl_cleanup_" + c_name + "(" + c_name + "** p) { hl_release_" + c_name + "(*p); }")
    out.push("")
    return out
}

# gen_one_enum_full(ctx, c_name, en, targs) emits a complete C enum definition +
# variant constructors + release/cleanup. `c_name` is the mangled C identifier
# (e.g., "Option__int"), `en` is the EnumInfo, `targs` are the concrete type args
# (parallel to en.typeparams, empty for non-generic).
fn gen_one_enum_full(ctx: Ctx, c_name: str, en: EnumInfo, targs: list[str]) -> list[str] {
    let mut out: list[str] = []
    # 1. Tag enum.
    out.push("typedef enum {")
    let mut vi: int = 0
    let mut tag_line: str = "    "
    while vi < en.variants.len() {
        if vi > 0 {
            tag_line = tag_line + ", "
        }
        tag_line = tag_line + en.name + "__TAG_" + en.variants.get(vi) + "_" + c_name
        vi = vi + 1
    }
    out.push(tag_line)
    out.push("} " + c_name + "_Tag;")
    out.push("")
    # 2. Struct with refcnt + tag + union of PER-VARIANT structs (each
    # variant has its own struct containing all its payloads, so payloads
    # don't overlap).
    out.push("typedef struct " + c_name + " {")
    out.push("    int64_t refcnt;")
    out.push("    " + c_name + "_Tag tag;")
    out.push("    union {")
    let mut vi2: int = 0
    while vi2 < en.variants.len() {
        let payloads: list[str] = en.payloads.get(vi2)
        let vname: str = en.variants.get(vi2)
        if payloads.len() > 0 {
            out.push("        struct {")
            let mut pi: int = 0
            while pi < payloads.len() {
                let pt: str = payloads.get(pi)
                let mut inst_pt: str = ""
                if en.typeparams.len() > 0 {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                } else {
                    inst_pt = pt
                }
                out.push("            " + c_type(ctx, inst_pt) + " v" + pi.to_str() + ";")
                pi = pi + 1
            }
            out.push("        } " + vname + ";")
        }
        vi2 = vi2 + 1
    }
    out.push("    } data;")
    out.push("} " + c_name + ";")
    out.push("")
    # 3. Constructor per variant — stores its payloads raw (they arrive
    # OWNED from the call site). refcnt starts at 1.
    let mut vi3: int = 0
    while vi3 < en.variants.len() {
        let vname: str = en.variants.get(vi3)
        let payloads: list[str] = en.payloads.get(vi3)
        let params: list[str] = []
        let mut pi2: int = 0
        while pi2 < payloads.len() {
            let pt: str = payloads.get(pi2)
            let mut inst_pt: str = ""
            if en.typeparams.len() > 0 {
                inst_pt = instantiate_type(pt, en.typeparams, targs)
            } else {
                inst_pt = pt
            }
            params.push(c_type(ctx, inst_pt) + " v" + pi2.to_str())
            pi2 = pi2 + 1
        }
        let mut param_sig: str = "void"
        if params.len() > 0 {
            param_sig = join(params, ", ")
        }
        out.push("static " + c_name + "* usf_make_" + c_name + "_" + vname + "(" + param_sig + ") {")
        out.push("    " + c_name + "* p = (" + c_name + "*)malloc(sizeof(" + c_name + "));")
        out.push("    if (!p) hl_die(\"out of memory\");")
        out.push("    p->refcnt = 1;")
        out.push("    p->tag = " + en.name + "__TAG_" + vname + "_" + c_name + ";")
        let mut pi3: int = 0
        while pi3 < payloads.len() {
            out.push("    p->data." + vname + ".v" + pi3.to_str() + " = v" + pi3.to_str() + ";")
            pi3 = pi3 + 1
        }
        out.push("    return p;")
        out.push("}")
        out.push("")
        vi3 = vi3 + 1
    }
    # 4. release + cleanup (Stage 8-beta). Only the ACTIVE variant's
    # payloads are valid to read — dispatch on the tag.
    out.push("static void hl_release_" + c_name + "(void* pv) {")
    out.push("    " + c_name + "* p = (" + c_name + "*)pv;")
    out.push("    if (!p) return;")
    out.push("    if (--p->refcnt == 0) {")
    out.push("        switch (p->tag) {")
    let mut vi4: int = 0
    while vi4 < en.variants.len() {
        let vname: str = en.variants.get(vi4)
        let payloads: list[str] = en.payloads.get(vi4)
        if payloads.len() > 0 {
            out.push("            case " + en.name + "__TAG_" + vname + "_" + c_name + ":")
            let mut pi4: int = 0
            while pi4 < payloads.len() {
                let pt: str = payloads.get(pi4)
                let mut inst_pt: str = ""
                if en.typeparams.len() > 0 {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                } else {
                    inst_pt = pt
                }
                if is_ptr_t(ctx, inst_pt) {
                    out.push("                " + release_call(ctx, inst_pt, "p->data." + vname + ".v" + pi4.to_str()) + ";")
                }
                pi4 = pi4 + 1
            }
            out.push("                break;")
        }
        vi4 = vi4 + 1
    }
    out.push("            default: break;")
    out.push("        }")
    out.push("        free(p);")
    out.push("    }")
    out.push("}")
    out.push("static void hl_cleanup_" + c_name + "(" + c_name + "** p) { hl_release_" + c_name + "(*p); }")
    out.push("")
    return out
}

# gen_struct_instantiation(ctx, t) emits a typedef + constructor for a generic
# struct instantiation. `t` is the full type string like "Box[int]".
fn gen_struct_instantiation(ctx: Ctx, t: str) -> list[str] {
    let base: str = type_base(t)
    let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
    let targs: list[str] = type_args(t)
    let c_name: str = c_type_name(t)
    return gen_one_struct_full(ctx, c_name, st, targs)
}

# --- Function prototype + instantiation generation ---

fn gen_proto_lines(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let mut key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        # Stage 20 (v0.36.0-alpha): under --lto, skip prototypes of
        # functions dropped by phase A (unreachable) or phase B (every
        # call site inlined — lto_calls == 0 and inlined at least once).
        if ctx.lto_mode && key != "main" && !f.is_extern {
            if !ctx.lto_fn_start.has(key) {
                i = i + 1
                continue
            }
            if ctx.lto_calls.get_or(key, 0) == 0
            && list_has(ctx.lto_inlined_report, key) {
                i = i + 1
                continue
            }
        }
        if f.typeparams.len() > 0 {
            # Skip generic functions here — their prototypes are emitted
            # with the instantiations in gen_fn_inst_lines.
            i = i + 1
            continue
        }
        let ptypes_c: list[str] = []
        let mut j: int = 0
        while j < f.params.len() {
            ptypes_c.push(c_type(ctx, f.ptypes.get(j)))
            j = j + 1
        }
        let mut sig: str = c_type(ctx, f.ret) + " usf_" + c_fn_name(key) + "("
        if ptypes_c.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(ptypes_c, ", ") + ")"
        }
        # Stage 19 (v0.35.0-alpha): prototype mirrors the body's PGO
        # annotations (hot/cold attribute + static inline hint).
        # Stage 28+29 (v0.45.0-alpha): prototype mirrors the body's
        # user attributes too (#[inline(always)], #[hot], #[cold],
        # #[no_red_zone], #[irq_handler]) — fn_attr_prefix returns
        # the combined prefix identical to what gen_fn_body emitted.
        out.push(fn_attr_prefix(ctx, f, key) + sig + ";")
        i = i + 1
    }
    # Also emit prototypes for generic function instantiations.
    let mut j2: int = 0
    while j2 < ctx.fn_insts.len() {
        let inst: str = ctx.fn_insts.get(j2)
        let parsed: list[str] = parse_inst_str(inst)
        # parsed[0] = key, parsed[1..n] = type args
        let key: str = parsed.get(0)
        let targs: list[str] = list_slice_from(parsed, 1)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        let ptypes_c: list[str] = []
        let mut k: int = 0
        while k < f.params.len() {
            let inst_pt: str = instantiate_type(f.ptypes.get(k), f.typeparams, targs)
            ptypes_c.push(c_type(ctx, inst_pt))
            k = k + 1
        }
        let mut ret_str: str = instantiate_type(f.ret, f.typeparams, targs)
        let mangled: str = c_mangled_fn_name(key, f.typeparams, targs)
        let mut sig: str = c_type(ctx, ret_str) + " usf_" + mangled + "("
        if ptypes_c.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(ptypes_c, ", ") + ")"
        }
        # Stage 19: mirror the instantiation body's PGO annotations.
        # Stage 28+29: mirror the user attributes too. The mangled
        # key is used for PGO lookups (same as gen_fn_inst_lines).
        out.push(fn_attr_prefix(ctx, f, mangled) + sig + ";")
        j2 = j2 + 1
    }
    out.push("")
    return out
}

# parse_inst_str(s) parses "key|arg1,arg2,..." into [key, arg1, arg2, ...].
fn parse_inst_str(s: str) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    let mut key: str = ""
    while i < s.len() {
        if s.byte_at(i) == 124 {
            key = s.slice(0, i)
            break
        }
        i = i + 1
    }
    if key == "" {
        out.push(s)
        return out
    }
    out.push(key)
    let args_str: str = s.slice(i + 1, s.len())
    if args_str == "" {
        return out
    }
    let args: list[str] = split_args_str(args_str)
    let mut j: int = 0
    while j < args.len() {
        out.push(args.get(j))
        j = j + 1
    }
    return out
}

# gen_fn_inst_lines(ctx) emits the body for each generic function
# instantiation recorded in ctx.fn_insts.
fn gen_fn_inst_lines(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let mut i: int = 0
    while i < ctx.fn_insts.len() {
        let inst: str = ctx.fn_insts.get(i)
        let parsed: list[str] = parse_inst_str(inst)
        let key: str = parsed.get(0)
        let targs: list[str] = list_slice_from(parsed, 1)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        gen_reset_fn(ctx)
        # BUG-002 fix: for generic methods on generic structs, we need to
        # combine the struct's type params with the method's. The targs list
        # carries BOTH (struct's args first, then method's args) — see how
        # check_method composes `all_targs`. We mirror that here to build
        # the combined typeparams list and pass the right targs slice.
        let mut combined_tps: list[str] = []
        let mut struct_tps_count: int = 0
        if f.is_method && f.struct_of != "" {
            let st: StructInfo = ctx.structs.get_or(f.struct_of, dummy_struct())
            let mut si: int = 0
            while si < st.typeparams.len() {
                combined_tps.push(st.typeparams.get(si))
                si = si + 1
            }
            struct_tps_count = st.typeparams.len()
        }
        let mut mi: int = 0
        while mi < f.typeparams.len() {
            combined_tps.push(f.typeparams.get(mi))
            mi = mi + 1
        }
        # The method's own type params are appended to combined_tps above;
        # the body uses ctx.cur_typeparams + ctx.cur_targs for instantiation.
        ctx.cur_typeparams = combined_tps
        ctx.cur_targs = targs
        # Stage 19 (v0.35.0-alpha): PGO — set cur_fn to the MANGLED
        # instantiation name so branch/loop site ids (b:<fn>:<n>) are
        # unique per instantiation. The contracts return-handler looks
        # the key up in ctx.fns and gets dummy_fn (ensures_e = -1), so
        # --contracts behaviour is unchanged.
        ctx.cur_fn = c_mangled_fn_name(key, combined_tps, targs)
        # Build the signature. Stage 8-beta: parameters own one retain of
        # each argument — `<name>_p` in the signature, owned local copies
        # with cleanups at the top of the body.
        let ptypes_c: list[str] = []
        let inst_ptypes: list[str] = []
        let param_local_names: list[str] = []
        let sig_params: list[str] = []
        let mut j: int = 0
        while j < f.params.len() {
            let inst_pt: str = instantiate_type(f.ptypes.get(j), combined_tps, targs)
            inst_ptypes.push(inst_pt)
            ptypes_c.push(c_type(ctx, inst_pt))
            j = j + 1
        }
        gen_param_locals(ctx, f, ptypes_c, param_local_names, sig_params)
        let ret_str: str = instantiate_type(f.ret, combined_tps, targs)
        let mut sig: str = c_type(ctx, ret_str) + " usf_" + c_mangled_fn_name(key, combined_tps, targs) + "("
        if sig_params.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(sig_params, ", ") + ")"
        }
        # Stage 19 (v0.35.0-alpha): PGO — the instantiation's entry site
        # is keyed by the MANGLED name (stable across builds); hot/cold
        # attributes come from the loaded profile like plain functions.
        let mangled: str = c_mangled_fn_name(key, combined_tps, targs)
        let sig_start: int = out.len()
        out.push(fn_attr_prefix(ctx, f, mangled) + sig + " {")
        # Emit statements. The gen_stmt / gen_expr functions need to use
        # inst_t for types. We achieve this by intercepting in c_type via
        # the ctx.cur_typeparams + ctx.cur_targs.
        let saved_out: list[str] = ctx.out
        ctx.out = []
        emit_param_local_decls(ctx, f, inst_ptypes, param_local_names)
        let entry_idx: int = pgo_site(ctx, "e:" + mangled)
        if ctx.pgo_gen {
            if entry_idx >= PGO_MAX_SITES() {
                panic("pgo: too many profile sites (limit 65536)")
            }
            ctx.out.push("    __hlc_pgo_counts[" + entry_idx.to_str() + "]++;")
        }
        gen_stmts(ctx, f.body, "    ")
        let mut k: int = 0
        while k < ctx.out.len() {
            out.push(ctx.out.get(k))
            k = k + 1
        }
        ctx.out = saved_out
        out.push("}")
        out.push("")
        # Stage 19: body size + retroactive `static inline` hint (same
        # predicate the prototype emission consults).
        # Stage 28+29: only retro-patch under PGO; explicit attrs are
        # already on the signature line via fn_attr_prefix.
        ctx.pgo_fn_sizes.set(mangled, out.len() - sig_start)
        if f.attr_inline == "" && pgo_fn_inline(ctx, mangled) {
            out.set(sig_start, "static inline " + out.get(sig_start))
        }
        ctx.cur_typeparams = []
        ctx.cur_targs = []
        i = i + 1
    }
    return out
}

# ============================================================================
# 4d. STAGE 8-BETA: clone() PER-INSTANTIATION HELPERS
# ----------------------------------------------------------------------------
# clone() now supports EVERY owned type (str, list, map, struct, enum,
# tainted[...]) via generated helpers `hl_clone_<mangled-type>`. Each
# helper deep-copies: primitives by value, pointers by recursively
# cloning. Recursion is guarded by registration (clone_insts).
# ============================================================================

# clone_expr_for: the C expression cloning `cexpr` of HLS type t.
fn clone_expr_for(ctx: Ctx, t: str, cexpr: str) -> str {
    let tt: str = strip_taint(inst_t(ctx, t))
    if tt == "int" || tt == "float" || tt == "bool" {
        return cexpr
    }
    if tt == "str" {
        return "hl_clone_str(" + cexpr + ")"
    }
    # Stage 16: a channel inside a composite clones by SHARING (atomic
    # refcount) — the runtime helper, not a per-instantiation generator.
    if is_chan_t(tt) {
        return "hl_chan_clone(" + cexpr + ")"
    }
    # Stage 33/34: Future[T] and Stream[T] are channels under the hood —
    # clone via hl_chan_clone (atomic refcount +1).
    if is_future_t(tt) || is_stream_t(tt) {
        return "hl_chan_clone(" + cexpr + ")"
    }
    return "hl_clone_" + c_type_name(tt) + "(" + cexpr + ")"
}

# register_clone: record that a clone helper is needed for `t` (plus,
# recursively, for every owned child type its body will clone).
fn register_clone(ctx: Ctx, t: str) -> void {
    let tt: str = strip_taint(t)
    if tt == "int" || tt == "float" || tt == "bool" || tt == "str" {
        return
    }
    # Stage 16: channels clone via the runtime helper hl_chan_clone (no
    # per-instantiation generator); Task cannot be cloned at all.
    if is_chan_t(tt) || is_task_t(tt) {
        return
    }
    # Stage 33/34: Future[T] and Stream[T] clone via hl_chan_clone.
    if is_future_t(tt) || is_stream_t(tt) {
        return
    }
    if list_has(ctx.clone_insts, t) {
        return
    }
    ctx.clone_insts.push(t)
    if is_list_t(tt) {
        register_clone(ctx, list_elem_t(tt))
        return
    }
    if is_map_t(tt) {
        register_clone(ctx, map_val_t(tt))
        return
    }
    # User struct: register each pointer field's type.
    let sbase: str = type_base(tt)
    if ctx.structs.has(sbase) {
        let st: StructInfo = ctx.structs.get_or(sbase, dummy_struct())
        let targs: list[str] = type_args(tt)
        let mut j: int = 0
        while j < st.fields.len() {
            let ftype: str = st.ftypes.get(j)
            let mut inst_ftype: str = ftype
            if st.typeparams.len() > 0 && targs.len() == st.typeparams.len() {
                inst_ftype = instantiate_type(ftype, st.typeparams, targs)
            }
            if is_ptr_t(ctx, inst_ftype) {
                register_clone(ctx, inst_ftype)
            }
            j = j + 1
        }
        return
    }
    # User enum: register each pointer payload's type (per variant).
    let ebase: str = type_base(tt)
    if ctx.enums.has(ebase) {
        let en: EnumInfo = ctx.enums.get_or(ebase, dummy_enum())
        let targs: list[str] = type_args(tt)
        let mut vi: int = 0
        while vi < en.variants.len() {
            let payloads: list[str] = en.payloads.get(vi)
            let mut pi: int = 0
            while pi < payloads.len() {
                let pt: str = payloads.get(pi)
                let mut inst_pt: str = pt
                if en.typeparams.len() > 0 && targs.len() == en.typeparams.len() {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                }
                if is_ptr_t(ctx, inst_pt) {
                    register_clone(ctx, inst_pt)
                }
                pi = pi + 1
            }
            vi = vi + 1
        }
        return
    }
}

# clone_fn_proto: the prototype line for the clone helper of type t.
fn clone_fn_proto(ctx: Ctx, t: str) -> str {
    let tt: str = strip_taint(t)
    if is_list_t(tt) {
        return "static hl_list* hl_clone_" + c_type_name(tt) + "(hl_list* l);"
    }
    if is_map_t(tt) {
        return "static hl_map* hl_clone_" + c_type_name(tt) + "(hl_map* m);"
    }
    # c_type() already returns a pointer for user types — use the raw
    # mangled name so the prototype is `static T* hl_clone_T(T* p);`.
    return "static " + c_type_name(tt) + "* hl_clone_" + c_type_name(tt) + "(" + c_type_name(tt) + "* p);"
}

# gen_clone_list_lines: the body for clone(list[E]).
fn gen_clone_list_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let elem: str = list_elem_t(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy with fresh boxes / cloned elements.")
    out.push("static hl_list* hl_clone_" + m + "(hl_list* l) {")
    out.push("    void* memo = hl_clone_memo_get((void*)l);")
    out.push("    if (memo) return (hl_list*)hl_retain(memo);")
    out.push("    hl_clone_enter();")
    out.push("    hl_list* r = hl_list_new(" + elem_free_fn(ctx, elem) + ");")
    out.push("    hl_clone_memo_put((void*)l, (void*)r);")
    out.push("    for (int64_t i = 0; i < l->len; i++) {")
    if elem == "int" {
        out.push("        hl_list_push(r, hl_box_i64(hl_unbox_i64(l->items[i])));")
    } else if elem == "float" {
        out.push("        hl_list_push(r, hl_box_f64(hl_unbox_f64(l->items[i])));")
    } else if elem == "bool" {
        out.push("        hl_list_push(r, hl_box_bool(hl_unbox_bool(l->items[i])));")
    } else {
        out.push("        hl_list_push(r, " + clone_expr_for(ctx, elem, "(" + c_type(ctx, elem) + ")l->items[i]") + ");")
    }
    out.push("    }")
    out.push("    hl_clone_leave();")
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_map_lines: the body for clone(map[str, V]).
fn gen_clone_map_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let vt: str = map_val_t(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy with cloned keys and values.")
    out.push("static hl_map* hl_clone_" + m + "(hl_map* m) {")
    out.push("    void* memo = hl_clone_memo_get((void*)m);")
    out.push("    if (memo) return (hl_map*)hl_retain(memo);")
    out.push("    hl_clone_enter();")
    out.push("    hl_map* r = hl_map_new(" + elem_free_fn(ctx, vt) + ");")
    out.push("    hl_clone_memo_put((void*)m, (void*)r);")
    out.push("    for (int64_t i = 0; i < m->len; i++) {")
    out.push("        hl_str* k = m->order[i];")
    out.push("        void* v = hl_map_borrow(m, k);")
    out.push("        if (v == NULL) continue;")
    if vt == "int" {
        out.push("        hl_map_set(r, hl_clone_str(k), hl_box_i64(hl_unbox_i64(v)));")
    } else if vt == "float" {
        out.push("        hl_map_set(r, hl_clone_str(k), hl_box_f64(hl_unbox_f64(v)));")
    } else if vt == "bool" {
        out.push("        hl_map_set(r, hl_clone_str(k), hl_box_bool(hl_unbox_bool(v)));")
    } else {
        out.push("        hl_map_set(r, hl_clone_str(k), " + clone_expr_for(ctx, vt, "(" + c_type(ctx, vt) + ")v") + ");")
    }
    out.push("    }")
    out.push("    hl_clone_leave();")
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_struct_lines: the body for clone(<struct instantiation>).
fn gen_clone_struct_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let sbase: str = type_base(tt)
    let st: StructInfo = ctx.structs.get_or(sbase, dummy_struct())
    let targs: list[str] = type_args(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy of every field.")
    out.push("static " + m + "* hl_clone_" + m + "(" + m + "* p) {")
    out.push("    void* memo = hl_clone_memo_get((void*)p);")
    out.push("    if (memo) return (" + m + "*)hl_retain(memo);")
    out.push("    hl_clone_enter();")
    out.push("    " + m + "* r = (" + m + "*)malloc(sizeof(" + m + "));")
    out.push("    if (!r) hl_die(\"out of memory\");")
    out.push("    r->refcnt = 1;")
    out.push("    hl_clone_memo_put((void*)p, (void*)r);")
    let mut j: int = 0
    while j < st.fields.len() {
        let ftype: str = st.ftypes.get(j)
        let mut inst_ftype: str = ftype
        if st.typeparams.len() > 0 && targs.len() == st.typeparams.len() {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        }
        let cfn: str = c_field_name(st.fields.get(j))
        out.push("    r->" + cfn + " = " + clone_expr_for(ctx, inst_ftype, "p->" + cfn) + ";")
        j = j + 1
    }
    out.push("    hl_clone_leave();")
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_enum_lines: the body for clone(<enum instantiation>). Only the
# active variant's payloads are copied (reading another variant's union
# arm would be undefined behaviour).
fn gen_clone_enum_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let ebase: str = type_base(tt)
    let en: EnumInfo = ctx.enums.get_or(ebase, dummy_enum())
    let targs: list[str] = type_args(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy of the active variant's payloads.")
    out.push("static " + m + "* hl_clone_" + m + "(" + m + "* p) {")
    out.push("    void* memo = hl_clone_memo_get((void*)p);")
    out.push("    if (memo) return (" + m + "*)hl_retain(memo);")
    out.push("    hl_clone_enter();")
    out.push("    " + m + "* r = (" + m + "*)malloc(sizeof(" + m + "));")
    out.push("    if (!r) hl_die(\"out of memory\");")
    out.push("    r->refcnt = 1;")
    out.push("    hl_clone_memo_put((void*)p, (void*)r);")
    out.push("    r->tag = p->tag;")
    out.push("    switch (p->tag) {")
    let mut vi: int = 0
    while vi < en.variants.len() {
        let vname: str = en.variants.get(vi)
        let payloads: list[str] = en.payloads.get(vi)
        if payloads.len() > 0 {
            out.push("        case " + en.name + "__TAG_" + vname + "_" + m + ": {")
            let mut pi: int = 0
            while pi < payloads.len() {
                let pt: str = payloads.get(pi)
                let mut inst_pt: str = pt
                if en.typeparams.len() > 0 && targs.len() == en.typeparams.len() {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                }
                out.push("            r->data." + vname + ".v" + pi.to_str()
                + " = " + clone_expr_for(ctx, inst_pt, "p->data." + vname + ".v" + pi.to_str()) + ";")
                pi = pi + 1
            }
            out.push("            break;")
            out.push("        }")
        }
        vi = vi + 1
    }
    out.push("        default: break;")
    out.push("    }")
    out.push("    hl_clone_leave();")
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_bodies: bodies for every registered clone instantiation.
#
# deep-scan-23 (this scan): the helpers are wrapped in per-thread cycle
# detection (hl_clone_memo_* below). A user-constructed cyclic value —
# `let mut n = Node{children:[]}; n.children.push(n)` — previously made
# the generated native code recurse without bound (SIGSEGV), while the
# interpreter's deep_clone handled the same value via its `_seen` map
# (see boot/interp.py). The memo restores native/interpreter parity:
# revisiting an in-progress source object returns its partially built
# clone (+1 owned), which both breaks cycles and preserves intra-clone
# aliasing. The table is emptied when the outermost clone finishes, so
# every top-level clone() starts with fresh semantics. `__thread`
# storage keeps spawned threads isolated (no locks; each thread owns
# its own memo + depth).
fn gen_clone_bodies(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    if ctx.clone_insts.len() > 0 {
        out.push("// ---- deep-scan-23: per-thread cycle detection for clone() ----")
        out.push("#define HL_CLONE_MEMO_BUCKETS 1024")
        out.push("typedef struct hl_clone_memo_node {")
        out.push("    void* orig;")
        out.push("    void* copy;")
        out.push("    struct hl_clone_memo_node* next;")
        out.push("} hl_clone_memo_node;")
        out.push("static __thread hl_clone_memo_node* hl_clone_memo[HL_CLONE_MEMO_BUCKETS];")
        out.push("static __thread int hl_clone_depth = 0;")
        out.push("static size_t hl_clone_memo_hash(void* p) {")
        out.push("    uintptr_t v = (uintptr_t)p;")
        out.push("    return (size_t)((v >> 4) * 2654435761u % HL_CLONE_MEMO_BUCKETS);")
        out.push("}")
        out.push("static void* hl_clone_memo_get(void* p) {")
        out.push("    hl_clone_memo_node* n = hl_clone_memo[hl_clone_memo_hash(p)];")
        out.push("    for (; n; n = n->next) { if (n->orig == p) return n->copy; }")
        out.push("    return NULL;")
        out.push("}")
        out.push("static void hl_clone_memo_put(void* o, void* c) {")
        out.push("    hl_clone_memo_node* n = (hl_clone_memo_node*)malloc(sizeof(hl_clone_memo_node));")
        out.push("    if (!n) hl_die(\"out of memory\");")
        out.push("    n->orig = o; n->copy = c;")
        out.push("    size_t h = hl_clone_memo_hash(o);")
        out.push("    n->next = hl_clone_memo[h];")
        out.push("    hl_clone_memo[h] = n;")
        out.push("}")
        out.push("static void hl_clone_memo_clear(void) {")
        out.push("    for (int i = 0; i < HL_CLONE_MEMO_BUCKETS; i++) {")
        out.push("        hl_clone_memo_node* n = hl_clone_memo[i];")
        out.push("        while (n) { hl_clone_memo_node* nx = n->next; free(n); n = nx; }")
        out.push("        hl_clone_memo[i] = NULL;")
        out.push("    }")
        out.push("}")
        out.push("static void hl_clone_enter(void) { hl_clone_depth++; }")
        out.push("static void hl_clone_leave(void) {")
        out.push("    hl_clone_depth--;")
        out.push("    if (hl_clone_depth <= 0) { hl_clone_memo_clear(); hl_clone_depth = 0; }")
        out.push("}")
        out.push("")
    }
    let mut i: int = 0
    while i < ctx.clone_insts.len() {
        let t: str = ctx.clone_insts.get(i)
        let tt: str = strip_taint(t)
        if is_list_t(tt) {
            concat_lines(out, gen_clone_list_lines(ctx, tt))
        } else if is_map_t(tt) {
            concat_lines(out, gen_clone_map_lines(ctx, tt))
        } else if ctx.structs.has(type_base(tt)) {
            concat_lines(out, gen_clone_struct_lines(ctx, tt))
        } else if ctx.enums.has(type_base(tt)) {
            concat_lines(out, gen_clone_enum_lines(ctx, tt))
        }
        i = i + 1
    }
    return out
}

# gen_ownership_protos: forward declarations for every release / cleanup /
# clone helper so struct/enum/clone definitions can reference each other
# regardless of emission order (mutual recursion: a struct containing a
# list of structs, an enum whose payload is the enum itself, ...).
fn gen_ownership_protos(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    out.push("// ---- Stage 8-beta: ownership helper prototypes ----")
    let snames: list[str] = ctx.structs.keys()
    let mut i: int = 0
    while i < snames.len() {
        let st: StructInfo = ctx.structs.get_or(snames.get(i), dummy_struct())
        if st.typeparams.len() == 0 {
            out.push("static void hl_release_" + st.name + "(void* p);")
            out.push("static void hl_cleanup_" + st.name + "(" + st.name + "** p);")
        }
        i = i + 1
    }
    let mut si: int = 0
    while si < ctx.struct_insts.len() {
        let m: str = c_type_name(ctx.struct_insts.get(si))
        out.push("static void hl_release_" + m + "(void* p);")
        out.push("static void hl_cleanup_" + m + "(" + m + "** p);")
        si = si + 1
    }
    let enames: list[str] = ctx.enums.keys()
    let mut ei: int = 0
    while ei < enames.len() {
        let en: EnumInfo = ctx.enums.get_or(enames.get(ei), dummy_enum())
        if en.typeparams.len() == 0 {
            out.push("static void hl_release_" + en.name + "(void* p);")
            out.push("static void hl_cleanup_" + en.name + "(" + en.name + "** p);")
        }
        ei = ei + 1
    }
    let mut eii: int = 0
    while eii < ctx.enum_insts.len() {
        let m: str = c_type_name(ctx.enum_insts.get(eii))
        out.push("static void hl_release_" + m + "(void* p);")
        out.push("static void hl_cleanup_" + m + "(" + m + "** p);")
        eii = eii + 1
    }
    let mut ci: int = 0
    while ci < ctx.clone_insts.len() {
        out.push(clone_fn_proto(ctx, ctx.clone_insts.get(ci)))
        ci = ci + 1
    }
    out.push("")
    return out
}

# --- Top-level program generation ---

fn gen_program(ctx: Ctx) -> list[str] {
    # 1. emit function bodies first (they collect struct/enum/clone
    # instantiations as they are generated).
    # Stage 20 (v0.36.0-alpha) — LTO phase A: under --lto, only
    # REACHABLE functions are generated at all. Reachability runs over
    # the checker's call graph (ctx.edges) rooted at main + the "" top-
    # level exprs (struct defaults). Extern declarations are kept.
    let mut reach: list[str] = []
    if ctx.lto_mode {
        reach = lto_reachable(ctx)
    }
    ctx.out = []
    ctx.clone_insts = []
    ctx.tmp = 0
    ctx.spawn_decls = []
    ctx.spawn_n = 0
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if f.typeparams.len() > 0 {
            # Generic function — skip here; we emit per instantiation later.
            i = i + 1
            continue
        }
        # Stage 20: LTO phase-A DCE — skip unreachable functions (their
        # bodies, prototypes and call sites never exist; every emitted
        # usf_ reference is to a reachable callee by construction).
        if ctx.lto_mode && key != "main" && !f.is_extern && !list_has(reach, key) {
            ctx.lto_dropped = ctx.lto_dropped + 1
            i = i + 1
            continue
        }
        gen_fn_body(ctx, key)
        i = i + 1
    }
    # 1b. emit generic function instantiation bodies.
    let fn_inst_bodies: list[str] = gen_fn_inst_lines(ctx)
    # Stage 20 (v0.36.0-alpha) — LTO phase B: a function whose EVERY
    # emitted call site was inlined has lto_calls == 0. Its standalone
    # body is dead — splice it out of the already-generated lines (and
    # out of the prototypes below). "A pure helper used only inside
    # another crate's fn is inlined and the standalone definition is
    # dropped." Phase A already filtered unreachable functions; here we
    # drop the REACHABLE-but-fully-inlined ones (all their inlined
    # bodies live inside their callers).
    if ctx.lto_mode {
        let keys: list[str] = ctx.lto_fn_start.keys()
        let dead_ranges: list[int] = []
        let mut ki: int = 0
        while ki < keys.len() {
            let k: str = keys.get(ki)
            if k == "main" {
                ki = ki + 1
                continue
            }
            if ctx.lto_calls.get_or(k, 0) != 0 {
                ki = ki + 1
                continue
            }
            # inlined at least once? Only then is 0-calls meaningful
            # (phase A already removed never-reachable fns; a reachable
            # fn with zero emitted calls and zero inlines would mean its
            # only callers are... struct-default "" roots — those calls
            # ARE emitted via constructors, so calls > 0. Guard anyway:
            # only drop fns recorded as inlined.)
            if !list_has(ctx.lto_inlined_report, k) {
                ki = ki + 1
                continue
            }
            let start: int = ctx.lto_fn_start.get_or(k, -1)
            let size: int = ctx.pgo_fn_sizes.get_or(k, 0)
            if start < 0 || size <= 0 {
                ki = ki + 1
                continue
            }
            dead_ranges.push(start)
            dead_ranges.push(start + size)
            ctx.lto_dropped = ctx.lto_dropped + 1
            ki = ki + 1
        }
        if dead_ranges.len() > 0 {
            # rebuild ctx.out skipping the dead ranges (ascending order).
            let filtered: list[str] = []
            let mut oi: int = 0
            let mut ri: int = 0
            while oi < ctx.out.len() {
                let mut in_dead: bool = false
                let mut rj: int = 0
                while rj < dead_ranges.len() {
                    if oi >= dead_ranges.get(rj) && oi < dead_ranges.get(rj + 1) {
                        in_dead = true
                    }
                    rj = rj + 2
                }
                if !in_dead {
                    filtered.push(ctx.out.get(oi))
                }
                oi = oi + 1
            }
            ctx.out = filtered
        }
    }
    let bodies: list[str] = ctx.out
    # 2. concatenate in order: header -> runtime -> forward typedefs ->
    #    ownership protos -> struct/enum defs -> clone bodies -> fn protos
    #    -> bodies -> main
    let final: list[str] = []
    final.push("// =============================================================")
    final.push("// C code generated BY hlc — the Halis compiler (HLS)")
    final.push("// The HLS source is compiled by hlc itself (self-hosted).")
    final.push("// =============================================================")
    final.push("")
    concat_lines(final, runtime_lines())
    # Stage 30 (v0.47.0-alpha): the stack-layout accessors are emitted
    # right after the runtime preamble (they reference hl_die) whenever
    # at least one binding in the program is stack-allocated.
    if ctx.layout_stack_n > 0 {
        concat_lines(final, stack_layout_helper_lines())
    }
    # Stage 19 (v0.35.0-alpha): --pgo-generate — the profile counter
    # array. Sized by the fixed site cap (checked during body emission;
    # programs with more sites are rejected). Zero-initialised (.bss).
    if ctx.pgo_gen {
        final.push("")
        final.push("// ===== Stage 19: PGO instrumentation counters =====")
        final.push("static uint64_t __hlc_pgo_counts[" + PGO_MAX_SITES().to_str() + "];")
    }
    # Stage 19: --pgo-use — the hoisted string-literal caches collected
    # while generating hot function bodies. Each is a thread-local
    # one-time cache (see the "str" literal case in gen_expr).
    if ctx.pgo_slits.len() > 0 {
        final.push("")
        final.push("// ===== Stage 19: PGO-hoisted string-literal caches =====")
        let mut si3: int = 0
        while si3 < ctx.pgo_slits.len() {
            final.push(ctx.pgo_slits.get(si3))
            si3 = si3 + 1
        }
    }
    final.push("")
    # 2a. Forward declarations for ALL structs and enums (recursive types).
    let struct_names: list[str] = ctx.structs.keys()
    let mut sni: int = 0
    while sni < struct_names.len() {
        let st: StructInfo = ctx.structs.get_or(struct_names.get(sni), dummy_struct())
        if st.typeparams.len() == 0 {
            final.push("typedef struct " + st.name + " " + st.name + ";")
        }
        sni = sni + 1
    }
    let mut si2: int = 0
    while si2 < ctx.struct_insts.len() {
        final.push("typedef struct " + c_type_name(ctx.struct_insts.get(si2)) + " " + c_type_name(ctx.struct_insts.get(si2)) + ";")
        si2 = si2 + 1
    }
    let enum_names: list[str] = ctx.enums.keys()
    let mut eni: int = 0
    while eni < enum_names.len() {
        let en: EnumInfo = ctx.enums.get_or(enum_names.get(eni), dummy_enum())
        if en.typeparams.len() == 0 {
            final.push("typedef struct " + en.name + " " + en.name + ";")
        }
        eni = eni + 1
    }
    let mut ei2: int = 0
    while ei2 < ctx.enum_insts.len() {
        final.push("typedef struct " + c_type_name(ctx.enum_insts.get(ei2)) + " " + c_type_name(ctx.enum_insts.get(ei2)) + ";")
        ei2 = ei2 + 1
    }
    final.push("")
    # 2a-bis. Stage 8-beta: ownership helper prototypes (release / cleanup /
    # clone) so the struct/enum/clone definitions below can reference each
    # other in any order.
    concat_lines(final, gen_ownership_protos(ctx))
    concat_lines(final, gen_struct_lines(ctx))
    # 2b. emit generic struct instantiations.
    let mut si: int = 0
    while si < ctx.struct_insts.len() {
        let inst_t: str = ctx.struct_insts.get(si)
        concat_lines(final, gen_struct_instantiation(ctx, inst_t))
        si = si + 1
    }
    # 2c. emit non-generic enums.
    concat_lines(final, gen_enum_lines_simple(ctx))
    # 2d. emit generic enum instantiations.
    let mut ei: int = 0
    while ei < ctx.enum_insts.len() {
        let inst_t: str = ctx.enum_insts.get(ei)
        let base: str = type_base(inst_t)
        let en: EnumInfo = ctx.enums.get_or(base, dummy_enum())
        let targs: list[str] = type_args(inst_t)
        concat_lines(final, gen_one_enum_full(ctx, c_type_name(inst_t), en, targs))
        ei = ei + 1
    }
    # 2e. Stage 8-beta: clone() per-instantiation helper bodies.
    concat_lines(final, gen_clone_bodies(ctx))
    # 2e-bis. Stage 21 (v0.37.0-alpha): std.simd intrinsic fast paths
    # (--target-feature). Emitted after the struct definitions + clone
    # bodies so the helpers can use the struct types, their constructors
    # and their release functions.
    if ctx.simd_helper_names.len() > 0 {
        concat_lines(final, simd_helper_lines(ctx))
    }
    concat_lines(final, gen_proto_lines(ctx))
    # 2e-bis. Stage 16: spawn-site helpers (arg structs + trampolines),
    # collected while the fn bodies above were generated. Emitted AFTER
    # the fn prototypes so the trampolines can call any usf_ function.
    concat_lines(final, ctx.spawn_decls)
    concat_lines(final, bodies)
    concat_lines(final, fn_inst_bodies)
    # Stage 19 (v0.35.0-alpha): --pgo-generate — the profile dumper,
    # emitted AFTER all bodies (it references the site-id table below)
    # and BEFORE main (which registers it via atexit). The site-id table
    # is emitted in ASSIGNMENT order — index i of __hlc_pgo_names
    # corresponds to counter __hlc_pgo_counts[i], exactly matching the
    # increments emitted inside the bodies above.
    if ctx.pgo_gen {
        concat_lines(final, pgo_dump_lines(ctx))
    }
    # 3. main wrapper
    let mf: FnInfo = ctx.fns.get_or("main", dummy_fn())
    final.push("int main(int argc, char** argv) {")
    final.push("    hl_init_args(argc, argv);")
    if ctx.pgo_gen {
        # Register the profile dumper BEFORE any work: atexit handlers
        # run LIFO, so this runs after the user's own atexit handlers
        # (none today) and catches every exit path, including exit().
        # Panics call exit(101) -> the profile is still written.
        final.push("    atexit(__hlc_pgo_dump);")
    }
    # Stage 10 release: auto-initialise the sandbox from the
    # HLS_SANDBOX_ROOT env var if set. This lets the user compile a
    # program once and run it with different sandboxes (no recompile
    # needed). boot.py --sandbox DIR sets the same env var before
    # running the interpreter, so both paths share the same gating.
    final.push("    const char* hl_sb = getenv(\"HLS_SANDBOX_ROOT\");")
    final.push("    if (hl_sb && hl_sb[0]) hl_set_sandbox_root(hl_sb);")
    if mf.ret == "int" {
        final.push("    return (int)(usf_main());")
    } else {
        final.push("    usf_main();")
        final.push("    return 0;")
    }
    final.push("}")
    return final
}

# gen_enum_lines_simple — emit non-generic enum typedefs + variant constructors.
fn gen_enum_lines_simple(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let names: list[str] = ctx.enums.keys()
    let mut i: int = 0
    while i < names.len() {
        let en: EnumInfo = ctx.enums.get_or(names.get(i), dummy_enum())
        if en.typeparams.len() == 0 {
            let empty_targs: list[str] = []
            concat_lines(out, gen_one_enum_full(ctx, en.name, en, empty_targs))
        }
        i = i + 1
    }
    return out
}

