# ============================================================================
# hlc — THE HIEU LOUIS COMPILER (HLS -> C)
# ----------------------------------------------------------------------------
# This compiler is written 100% in Hieu Louis itself.
# This is the self-hosting step of the language: the language's compiler
# is written in that language.
#
# v0.3 (Stage 7) supports:
#   - enum declarations (generic + non-generic)
#   - match expressions (with exhaustiveness checking)
#   - the `?` error-propagation operator
#   - generic functions / structs / enums (monomorphisation)
#   - struct default field values
#
# Bootstrap chain:
#   python3 boot/boot.py src/hlc.hls <input.hls> <output.c>
#   gcc -O2 -o <program> <output.c> -lm
#
# Structure: LEXER -> PARSER -> CHECKER (types + effects) -> CODEGEN (C)
# All state is passed explicitly through Ctx — no global variables.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. DATA STRUCTURES
# ----------------------------------------------------------------------------

struct Tok {
    kind: str,
    value: str,
    line: int,
    col: int
}

struct Binding {
    t: str,
    is_mut: bool,
    moved: bool
}

struct StructInfo {
    name: str,
    fields: list[str],
    ftypes: list[str],
    fdefaults: list[int],   # indices of default-value exprs, -1 if none
    typeparams: list[str],
    line: int
}

struct EnumInfo {
    name: str,
    variants: list[str],            # variant names
    payloads: list[list[str]],      # payload types per variant (parallel to variants)
    typeparams: list[str],
    line: int
}

struct FnInfo {
    name: str,
    params: list[str],
    ptypes: list[str],
    pmuts: list[bool],
    ret: str,
    effects: list[str],   # Stage 9-alpha: declared effects (IO is expanded at parse time to IO+Fs+Clock+Args+Exit)
    is_pure: bool,           # Stage 9-beta: explicit `pure` keyword — function declares no effects AND transitively calls none
    body: list[int],
    is_method: bool,
    struct_of: str,
    typeparams: list[str],
    line: int,
    is_extern: bool        # Stage 15-beta: extern "C" fn — forward declaration, no body
}

struct MatchArm {
    pat_kind: str,           # "wildcard" or "variant"
    enum_name: str,
    variant: str,
    bindings: list[str],
    has_paren: bool,
    body: int,               # body expression index
    body_t: str,             # body type, set during check
    line: int
}

struct ExprN {
    kind: str,
    op: str,
    name: str,
    sval: str,
    ival: int,
    fval: float,
    bval: bool,
    left: int,               # also used as scrutinee index for match
    right: int,
    args: list[int],         # also used as arm indices for match
    ffields: list[str],
    t: str,
    muser: bool,
    mkey: str,               # for user fn call: the (possibly mangled) C name
    mop: str,
    enum_name: str,          # for enumlit (after check)
    variant: str,           # for enumlit / match arm variant
    err_variant: str,       # for qmark
    ok_variant: str,        # for qmark
    inst_targs: list[str],  # for generic call: inferred type args (concrete)
    line: int
}

struct StmtN {
    kind: str,
    name: str,
    vtype: str,
    is_mut: bool,
    value: int,
    target: int,
    cond: int,
    body: list[int],
    else_body: list[int],
    iter: int,
    e: int,
    line: int
}

struct Ctx {
    src: str,
    toks: list[Tok],
    pos: int,
    exprs: list[ExprN],
    stmts: list[StmtN],
    match_arms: list[MatchArm],
    structs: map[str, StructInfo],
    enums: map[str, EnumInfo],
    fns: map[str, FnInfo],
    fn_order: list[str],
    methods_of: map[str, list[str]],
    out: list[str],
    gen_locals: map[str, str],
    gen_counts: map[str, int],
    tmp: int,
    edges: map[str, list[str]],
    imports: list[str],
    loaded_files: list[str],
    entry_dir: str,
    repo_root: str,
    cur_fn_ret: str,
    cur_typeparams: list[str],
    cur_targs: list[str],
    fn_insts: list[str],
    struct_insts: list[str],
    enum_insts: list[str],
    computed_effects: map[str, list[str]],
    # ---- Stage 8-beta: ownership-analysis state ----
    # hoist_map: expr index (as str) -> hoisted temp C name. Fresh
    # pointer-typed subexpressions consumed in a borrowed position are
    # materialised into temps with a cleanup attribute so they are
    # released exactly when the enclosing C block exits.
    hoist_map: map[str, str],
    # null_after: C variable names to null out at the end of the current
    # statement (bindings moved out by take()). Nulling makes the
    # scope-exit cleanup a no-op, implementing ownership transfer.
    null_after: list[str],
    # clone_insts: HLS types that appeared in a clone() call (their
    # hl_clone_<mangled> helpers will be generated).
    clone_insts: list[str],
    # loop_header: > 0 while checking a while/for condition or iterable —
    # take()/drop() are rejected there (a move would re-execute every
    # iteration).
    loop_header: int
}

fn new_ctx(src: str) -> Ctx {
    return Ctx {
        src: src, toks: [], pos: 0,
        exprs: [], stmts: [], match_arms: [],
        structs: map_new(), enums: map_new(), fns: map_new(), fn_order: [],
        methods_of: map_new(),
        out: [],
        gen_locals: map_new(), gen_counts: map_new(), tmp: 0,
        edges: map_new(),
        imports: [], loaded_files: [],
        entry_dir: "", repo_root: "",
        cur_fn_ret: "void", cur_typeparams: [], cur_targs: [],
        fn_insts: [], struct_insts: [], enum_insts: [],
        computed_effects: map_new(),
        hoist_map: map_new(), null_after: [], clone_insts: [], loop_header: 0
    }
}

# --- Common helpers ---

fn join(parts: list[str], sep: str) -> str {
    let mut acc: str = ""
    let mut i: int = 0
    while i < parts.len() {
        if i > 0 {
            acc = acc + sep
        }
        acc = acc + parts.get(i)
        i = i + 1
    }
    return acc
}

fn is_keyword(w: str) -> bool {
    return w == "fn" || w == "let" || w == "mut" || w == "return" || w == "if"
        || w == "else" || w == "while" || w == "for" || w == "in"
        || w == "break" || w == "continue" || w == "struct" || w == "impl"
        || w == "import" || w == "uses" || w == "true" || w == "false"
        || w == "enum" || w == "match" || w == "pure"
        # Stage 15-beta: `extern` keyword for `extern "C" { ... }` blocks.
        # Previously hlc.hls did not recognise `extern` as a keyword, so
        # programs using FFI would fail to parse. This closes the Stage 15
        # remaining-work gap documented in ROADMAP.md.
        || w == "extern"
}

fn is_ident_start(c: int) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_ident_char(c: int) -> bool {
    return is_ident_start(c) || (c >= 48 && c <= 57)
}

fn is_digit(c: int) -> bool {
    return c >= 48 && c <= 57
}

# list_slice_from(list, start) returns a new list with elements from index
# `start` to the end.
fn list_slice_from(xs: list[str], start: int) -> list[str] {
    let out: list[str] = []
    let mut i: int = start
    while i < xs.len() {
        out.push(xs.get(i))
        i = i + 1
    }
    return out
}

# Strip underscores from numbers: "1_000" -> "1000"
fn filter_us(s: str) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < s.len() {
        if s.byte_at(i) != 95 {
            parts.push(s.slice(i, i + 1))
        }
        i = i + 1
    }
    return join(parts, "")
}

# --- Type string helpers (mirrors the checker's helpers) ---

fn is_list_t(t: str) -> bool {
    return t.starts_with("list[")
}

fn list_elem_t(t: str) -> str {
    return t.slice(5, t.len() - 1)
}

fn is_map_t(t: str) -> bool {
    return t.starts_with("map[str, ")
}

fn map_val_t(t: str) -> str {
    return t.slice(9, t.len() - 1)
}

# Stage 10-alpha: built-in taint wrapper `tainted[T]`. Like `list[T]` it
# is a built-in generic type — no struct/enum definition required.
fn is_taint_t(t: str) -> bool {
    return t.starts_with("tainted[")
}

fn taint_inner_t(t: str) -> str {
    return t.slice(8, t.len() - 1)
}

# type_base(t) returns the head identifier (before any `[`).
fn type_base(t: str) -> str {
    let mut i: int = 0
    while i < t.len() {
        if t.byte_at(i) == 91 {
            return t.slice(0, i)
        }
        i = i + 1
    }
    return t
}

# trim_spaces(s) returns s with leading/trailing ASCII spaces removed.
fn trim_spaces(s: str) -> str {
    let mut start: int = 0
    let mut end: int = s.len()
    while start < end && s.byte_at(start) == 32 {
        start = start + 1
    }
    while end > start && s.byte_at(end - 1) == 32 {
        end = end - 1
    }
    return s.slice(start, end)
}

# type_args(t) returns a list of type-arg strings, splitting on commas at depth 0.
fn type_args(t: str) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    let mut base_start: int = -1
    # Find the first '[' that opens the outermost arg list.
    while i < t.len() {
        if t.byte_at(i) == 91 {
            base_start = i + 1
            break
        }
        i = i + 1
    }
    if base_start < 0 {
        return out
    }
    # Now parse args from base_start until the matching ']' (last char).
    let mut depth: int = 0
    let mut start: int = base_start
    let mut j: int = base_start
    while j < t.len() - 1 {
        let c: int = t.byte_at(j)
        if c == 91 {
            depth = depth + 1
        } else if c == 93 {
            depth = depth - 1
        } else if c == 44 && depth == 0 {
            out.push(trim_spaces(t.slice(start, j)))
            start = j + 1
        }
        j = j + 1
    }
    # Last arg (we stop at len - 1 to skip the closing ']').
    if start < t.len() - 1 {
        out.push(trim_spaces(t.slice(start, t.len() - 1)))
    }
    return out
}

# split_args_str(s) splits a comma-separated list of types, respecting nested [ ].
fn split_args_str(s: str) -> list[str] {
    let out: list[str] = []
    if s == "" {
        return out
    }
    let mut depth: int = 0
    let mut start: int = 0
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c == 91 {
            depth = depth + 1
        } else if c == 93 {
            depth = depth - 1
        } else if c == 44 && depth == 0 {
            out.push(trim_spaces(s.slice(start, i)))
            start = i + 1
        }
        i = i + 1
    }
    out.push(trim_spaces(s.slice(start, s.len())))
    return out
}

# BUG-019 fix: removed dead trim_one_space function (was unused, with a
# "currently unused" comment that itself was a maintenance hint — resurrect
# from git history if ever needed).

# instantiate_type(t, typeparams, typeargs) substitutes each type param in `t`
# with the corresponding concrete type from `typeargs`.
# BUG-31 fix: recurse on the substituted value — but cap recursion at 16
# levels to prevent infinite loops when a type arg IS itself a type param
# (which happens when a generic function calls another generic function
# with the same type-param names). The original code returned the first
# lookup result without recursing, which left inner type params
# unbound in some edge cases.
fn instantiate_type(t: str, tps: list[str], targs: list[str]) -> str {
    return instantiate_type_d(t, tps, targs, 0)
}

fn instantiate_type_d(t: str, tps: list[str], targs: list[str], depth: int) -> str {
    if depth > 16 {
        return t
    }
    # First: if t is exactly a type param, substitute.
    let mut i: int = 0
    while i < tps.len() {
        if t == tps.get(i) {
            # Recurse on the substituted value — it may itself contain type
            # params that need to be substituted (e.g. targs[i] = "list[U]"
            # where U is another type param).
            return instantiate_type_d(targs.get(i), tps, targs, depth + 1)
        }
        i = i + 1
    }
    if t == "int" || t == "float" || t == "bool" || t == "str" || t == "void" {
        return t
    }
    if is_list_t(t) {
        let inner: str = list_elem_t(t)
        let new_inner: str = instantiate_type_d(inner, tps, targs, depth + 1)
        return "list[" + new_inner + "]"
    }
    if is_map_t(t) {
        let val: str = map_val_t(t)
        let new_val: str = instantiate_type_d(val, tps, targs, depth + 1)
        return "map[str, " + new_val + "]"
    }
    if is_taint_t(t) {
        let inner: str = taint_inner_t(t)
        let new_inner: str = instantiate_type_d(inner, tps, targs, depth + 1)
        return "tainted[" + new_inner + "]"
    }
    # User-defined type with possible type args
    let base: str = type_base(t)
    if base == t {
        # No type args — could be a non-generic user type or an unsubstituted
        # type param used as a base (rare; we already handled the exact-match
        # case above). Return as-is.
        return t
    }
    let args: list[str] = type_args(t)
    let new_args: list[str] = []
    let mut j: int = 0
    while j < args.len() {
        new_args.push(instantiate_type_d(args.get(j), tps, targs, depth + 1))
        j = j + 1
    }
    return base + "[" + join(new_args, ", ") + "]"
}

# ----------------------------------------------------------------------------
# 2. LEXER
# ----------------------------------------------------------------------------

fn mk_tok(kind: str, value: str, line: int, col: int) -> Tok {
    return Tok { kind: kind, value: value, line: line, col: col }
}

fn lex_err(msg: str, line: int, col: int) -> void {
    panic("lex error: " + msg + " (line " + line.to_str() + ":" + col.to_str() + ")")
}

fn lex(ctx: Ctx) -> void {
    let src: str = ctx.src
    let n: int = src.len()
    let mut i: int = 0
    let mut line: int = 1
    let mut col: int = 1
    while i < n {
        let c: int = src.byte_at(i)
        # whitespace
        if c == 32 || c == 9 || c == 13 {
            col = col + 1
            i = i + 1
        } else if c == 10 {
            line = line + 1
            col = 1
            i = i + 1
        } else if c == 35 {
            # comment: # to end of line
            # BUG-016 fix: track column past the comment, so error messages
            # on a later token on the same line report the right column.
            while i < n && src.byte_at(i) != 10 {
                i = i + 1
                col = col + 1
            }
        } else if is_ident_start(c) {
            let mut j: int = i
            while j < n && is_ident_char(src.byte_at(j)) {
                j = j + 1
            }
            let word: str = src.slice(i, j)
            if is_keyword(word) {
                ctx.toks.push(mk_tok("kw", word, line, col))
            } else {
                ctx.toks.push(mk_tok("ident", word, line, col))
            }
            col = col + (j - i)
            i = j
        } else if is_digit(c) {
            let mut j: int = i
            while j < n && (is_digit(src.byte_at(j)) || src.byte_at(j) == 95) {
                j = j + 1
            }
            let mut is_f: bool = false
            if j < n && src.byte_at(j) == 46 && j + 1 < n && is_digit(src.byte_at(j + 1)) {
                is_f = true
                j = j + 1
                while j < n && (is_digit(src.byte_at(j)) || src.byte_at(j) == 95) {
                    j = j + 1
                }
            }
            let text: str = filter_us(src.slice(i, j))
            if is_f {
                ctx.toks.push(mk_tok("float", text, line, col))
            } else {
                ctx.toks.push(mk_tok("int", text, line, col))
            }
            col = col + (j - i)
            i = j
        } else if c == 34 {
            # string
            let ln: int = line
            let cl: int = col
            i = i + 1
            col = col + 1
            let parts: list[str] = []
            let mut closed: bool = false
            while i < n {
                let ch: int = src.byte_at(i)
                if ch == 34 {
                    i = i + 1
                    col = col + 1
                    closed = true
                    break
                }
                if ch == 92 {
                    if i + 1 >= n {
                        lex_err("unterminated string", ln, cl)
                    }
                    # BUG-020 fix: `e` is never reassigned — remove misleading `mut`.
                    let e: int = src.byte_at(i + 1)
                    if e == 110 {
                        parts.push(chr(10))
                    } else if e == 116 {
                        parts.push(chr(9))
                    } else if e == 92 {
                        parts.push(chr(92))
                    } else if e == 34 {
                        parts.push(chr(34))
                    } else {
                        lex_err("invalid escape sequence", ln, cl)
                    }
                    i = i + 2
                    col = col + 2
                } else {
                    if ch < 32 {
                        lex_err("string contains invalid control character", ln, cl)
                    }
                    parts.push(src.slice(i, i + 1))
                    col = col + 1
                    i = i + 1
                }
            }
            if !closed {
                lex_err("unterminated string", ln, cl)
            }
            ctx.toks.push(mk_tok("str", join(parts, ""), ln, cl))
        } else {
            # operator / symbol — try two-char first
            let mut two: str = ""
            if i + 2 <= n {
                two = src.slice(i, i + 2)
            }
            if two == "->" || two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||" || two == "=>" {
                ctx.toks.push(mk_tok("sym", two, line, col))
                i = i + 2
                col = col + 2
            } else if c == 40 || c == 41 || c == 123 || c == 125 || c == 91 || c == 93 || c == 44 || c == 58 || c == 46 || c == 60 || c == 62 || c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 33 || c == 61 || c == 63 {
                ctx.toks.push(mk_tok("sym", chr(c), line, col))
                i = i + 1
                col = col + 1
            } else {
                lex_err("invalid character", line, col)
            }
        }
    }
    ctx.toks.push(mk_tok("eof", "", line, col))
}

# ----------------------------------------------------------------------------
# 3. PARSER
# ----------------------------------------------------------------------------

fn nx_expr(ctx: Ctx, kind: str, line: int) -> int {
    let mut e: ExprN = ExprN {
        kind: kind, op: "", name: "", sval: "", ival: 0, fval: 0.0,
        bval: false, left: -1, right: -1, args: [], ffields: [], t: "",
        muser: false, mkey: "", mop: "", enum_name: "", variant: "",
        err_variant: "", ok_variant: "", inst_targs: [], line: line
    }
    ctx.exprs.push(e)
    return ctx.exprs.len() - 1
}

fn nx_stmt(ctx: Ctx, kind: str, line: int) -> int {
    let s: StmtN = StmtN {
        kind: kind, name: "", vtype: "", is_mut: false, value: -1,
        target: -1, cond: -1, body: [], else_body: [], iter: -1, e: -1,
        line: line
    }
    ctx.stmts.push(s)
    return ctx.stmts.len() - 1
}

fn nx_match_arm(ctx: Ctx, pat_kind: str, enum_name: str, variant: str,
                bindings: list[str], has_paren: bool, body: int, line: int) -> int {
    let arm: MatchArm = MatchArm {
        pat_kind: pat_kind, enum_name: enum_name, variant: variant,
        bindings: bindings, has_paren: has_paren, body: body, body_t: "",
        line: line
    }
    ctx.match_arms.push(arm)
    return ctx.match_arms.len() - 1
}

fn perr(ctx: Ctx, msg: str) -> void {
    let t: Tok = ctx.toks.get(ctx.pos)
    panic("syntax error: " + msg + " (line " + t.line.to_str() + ":" + t.col.to_str() + ")")
}

fn perr_at(ctx: Ctx, msg: str, t: Tok) -> void {
    panic("syntax error: " + msg + " (line " + t.line.to_str() + ":" + t.col.to_str() + ")")
}

fn tok_desc(ctx: Ctx) -> str {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind == "eof" {
        return "end of file"
    }
    return "'" + t.value + "'"
}

fn at_sym(ctx: Ctx, v: str) -> bool {
    let t: Tok = ctx.toks.get(ctx.pos)
    return t.kind == "sym" && t.value == v
}

fn at_kw(ctx: Ctx, v: str) -> bool {
    let t: Tok = ctx.toks.get(ctx.pos)
    return t.kind == "kw" && t.value == v
}

# at_ident returns true iff the current token is an identifier with the
# given name. Used to disambiguate the `_` wildcard (which the lexer
# tokenizes as an ident because `_` is a valid ident-start character).
fn at_ident(ctx: Ctx, v: str) -> bool {
    let t: Tok = ctx.toks.get(ctx.pos)
    return t.kind == "ident" && t.value == v
}

fn eat_sym(ctx: Ctx, v: str) -> void {
    if !at_sym(ctx, v) {
        perr(ctx, "expected symbol '" + v + "' but got " + tok_desc(ctx))
    }
    ctx.pos = ctx.pos + 1
}

fn eat_kw(ctx: Ctx, v: str) -> void {
    if !at_kw(ctx, v) {
        perr(ctx, "expected keyword '" + v + "' but got " + tok_desc(ctx))
    }
    ctx.pos = ctx.pos + 1
}

fn eat_ident(ctx: Ctx) -> str {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind != "ident" {
        perr(ctx, "expected identifier but got " + tok_desc(ctx))
    }
    # BUG-SC-4 fix: reject reserved identifiers (secure / trait) — they
    # are reserved for future keywords per SPEC section 2.5. boot/parser.py
    # (BUG-29 fix) already rejects these; hlc.hls must match.
    if t.value == "secure" || t.value == "trait" {
        perr_at(ctx, "'" + t.value + "' is a reserved identifier and cannot be used as a name (it will become a keyword in a future stage)", t)
    }
    ctx.pos = ctx.pos + 1
    return t.value
}

fn peek2_is(ctx: Ctx, v: str) -> bool {
    if ctx.pos + 1 >= ctx.toks.len() {
        return false
    }
    let t: Tok = ctx.toks.get(ctx.pos + 1)
    return t.kind == "sym" && t.value == v
}

# --- Type parsing: returns a canonical type string ---

fn parse_type(ctx: Ctx, allow_void: bool) -> str {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind != "ident" {
        perr(ctx, "expected type but got " + tok_desc(ctx))
    }
    let base: str = t.value
    ctx.pos = ctx.pos + 1
    if base == "list" {
        eat_sym(ctx, "[")
        let inner: str = parse_type(ctx, false)
        eat_sym(ctx, "]")
        return "list[" + inner + "]"
    }
    if base == "map" {
        eat_sym(ctx, "[")
        let kt: str = eat_ident(ctx)
        if kt != "str" {
            perr_at(ctx, "map key in v0.3 must be 'str'", t)
        }
        eat_sym(ctx, ",")
        let vt: str = parse_type(ctx, false)
        eat_sym(ctx, "]")
        return "map[str, " + vt + "]"
    }
    # Stage 10-alpha: built-in taint wrapper `tainted[T]`.
    if base == "tainted" {
        eat_sym(ctx, "[")
        let inner: str = parse_type(ctx, false)
        eat_sym(ctx, "]")
        return "tainted[" + inner + "]"
    }
    if base == "int" || base == "float" || base == "bool" || base == "str" {
        return base
    }
    if base == "void" {
        if !allow_void {
            perr_at(ctx, "void can only be used as a return type", t)
        }
        return "void"
    }
    # User-defined type — could be generic instantiation: Name[T1, T2, ...]
    if at_sym(ctx, "[") {
        eat_sym(ctx, "[")
        let args: list[str] = []
        while !at_sym(ctx, "]") {
            args.push(parse_type(ctx, false))
            if at_sym(ctx, ",") {
                ctx.pos = ctx.pos + 1
            } else if !at_sym(ctx, "]") {
                perr(ctx, "expected ',' or ']' in type arguments")
            }
        }
        eat_sym(ctx, "]")
        return base + "[" + join(args, ", ") + "]"
    }
    return base
}

# Parse `[T, U, ...]` after a function/struct/enum name — returns the list of
# type parameter names. If the next token is not `[`, returns an empty list.
fn parse_typeparams(ctx: Ctx) -> list[str] {
    let out: list[str] = []
    if !at_sym(ctx, "[") {
        return out
    }
    eat_sym(ctx, "[")
    while !at_sym(ctx, "]") {
        let t: Tok = ctx.toks.get(ctx.pos)
        if t.kind != "ident" {
            perr(ctx, "expected type parameter name but got " + tok_desc(ctx))
        }
        ctx.pos = ctx.pos + 1
        out.push(t.value)
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, "]") {
            perr(ctx, "expected ',' or ']' in type parameters")
        }
    }
    eat_sym(ctx, "]")
    return out
}

# --- Program parsing ---

fn parse_program(ctx: Ctx) -> void {
    while ctx.toks.get(ctx.pos).kind != "eof" {
        let t: Tok = ctx.toks.get(ctx.pos)
        if t.kind == "kw" && t.value == "struct" {
            let st: StructInfo = parse_struct(ctx)
            if ctx.structs.has(st.name) || ctx.enums.has(st.name) {
                perr_at(ctx, "duplicate type name: " + st.name, t)
            }
            ctx.structs.set(st.name, st)
        } else if t.kind == "kw" && t.value == "enum" {
            let en: EnumInfo = parse_enum(ctx)
            if ctx.enums.has(en.name) || ctx.structs.has(en.name) {
                perr_at(ctx, "duplicate type name: " + en.name, t)
            }
            ctx.enums.set(en.name, en)
        } else if t.kind == "kw" && t.value == "impl" {
            parse_impl(ctx)
        } else if t.kind == "kw" && t.value == "fn" {
            let f: FnInfo = parse_fn(ctx, "")
            if ctx.fns.has(f.name) {
                perr_at(ctx, "duplicate function name: " + f.name, t)
            }
            ctx.fns.set(f.name, f)
            ctx.fn_order.push(f.name)
        } else if t.kind == "kw" && t.value == "import" {
            eat_kw(ctx, "import")
            let pt: Tok = ctx.toks.get(ctx.pos)
            if pt.kind != "str" {
                perr_at(ctx, "import expects a string path", pt)
            }
            ctx.pos = ctx.pos + 1
            ctx.imports.push(pt.value)
        } else if t.kind == "kw" && t.value == "extern" {
            # Stage 15-beta: extern "C" { ... } block.
            parse_extern_block(ctx)
        } else {
            perr_at(ctx, "only struct/enum/impl/fn/import/extern declarations allowed at top level", t)
        }
    }
}

fn parse_struct(ctx: Ctx) -> StructInfo {
    let t0: Tok = ctx.toks.get(ctx.pos)
    eat_kw(ctx, "struct")
    let name: str = eat_ident(ctx)
    let typeparams: list[str] = parse_typeparams(ctx)
    eat_sym(ctx, "{")
    let fields: list[str] = []
    let ftypes: list[str] = []
    let fdefaults: list[int] = []
    let mut seen_default: bool = false
    while !at_sym(ctx, "}") {
        let ft: str = eat_ident(ctx)
        eat_sym(ctx, ":")
        let ty: str = parse_type(ctx, false)
        let mut dflt_idx: int = -1
        if at_sym(ctx, "=") {
            ctx.pos = ctx.pos + 1
            dflt_idx = parse_expr(ctx, true)
            seen_default = true
        } else if seen_default {
            perr_at(ctx, "struct field without default cannot follow a defaulted field: " + ft, t0)
        }
        fields.push(ft)
        ftypes.push(ty)
        fdefaults.push(dflt_idx)
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, "}") {
            perr(ctx, "expected ',' or '}' in struct definition")
        }
    }
    eat_sym(ctx, "}")
    if fields.len() == 0 {
        perr_at(ctx, "struct must have at least one field", t0)
    }
    return StructInfo {
        name: name, fields: fields, ftypes: ftypes, fdefaults: fdefaults,
        typeparams: typeparams, line: t0.line
    }
}

fn parse_enum(ctx: Ctx) -> EnumInfo {
    let t0: Tok = ctx.toks.get(ctx.pos)
    eat_kw(ctx, "enum")
    let name: str = eat_ident(ctx)
    let typeparams: list[str] = parse_typeparams(ctx)
    eat_sym(ctx, "{")
    let variants: list[str] = []
    let payloads: list[list[str]] = []
    let mut seen: map[str, bool] = map_new()
    while !at_sym(ctx, "}") {
        let vt: Tok = ctx.toks.get(ctx.pos)
        if vt.kind != "ident" {
            perr_at(ctx, "expected variant name but got " + tok_desc(ctx), vt)
        }
        ctx.pos = ctx.pos + 1
        let vname: str = vt.value
        if seen.has(vname) {
            perr_at(ctx, "duplicate variant name in enum: " + vname, vt)
        }
        seen.set(vname, true)
        let mut pl: list[str] = []
        if at_sym(ctx, "(") {
            eat_sym(ctx, "(")
            while !at_sym(ctx, ")") {
                pl.push(parse_type(ctx, false))
                if at_sym(ctx, ",") {
                    ctx.pos = ctx.pos + 1
                } else if !at_sym(ctx, ")") {
                    perr(ctx, "expected ',' or ')' in variant payloads")
                }
            }
            eat_sym(ctx, ")")
        }
        variants.push(vname)
        payloads.push(pl)
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, "}") {
            perr(ctx, "expected ',' or '}' in enum definition")
        }
    }
    eat_sym(ctx, "}")
    if variants.len() == 0 {
        perr_at(ctx, "enum must have at least one variant", t0)
    }
    return EnumInfo {
        name: name, variants: variants, payloads: payloads,
        typeparams: typeparams, line: t0.line
    }
}

fn parse_impl(ctx: Ctx) -> void {
    eat_kw(ctx, "impl")
    let sname: str = eat_ident(ctx)
    eat_sym(ctx, "{")
    while !at_sym(ctx, "}") {
        if !at_kw(ctx, "fn") {
            perr(ctx, "only fn definitions allowed inside impl")
        }
        let fn_t0: Tok = ctx.toks.get(ctx.pos)
        let f: FnInfo = parse_fn(ctx, sname)
        let key: str = sname + "." + f.name
        if ctx.fns.has(key) {
            perr_at(ctx, "duplicate method name: " + key, fn_t0)
        }
        ctx.fns.set(key, f)
        ctx.fn_order.push(key)
        if !ctx.methods_of.has(sname) {
            ctx.methods_of.set(sname, [])
        }
        ctx.methods_of.get_or(sname, []).push(key)
    }
    eat_sym(ctx, "}")
}

fn parse_fn(ctx: Ctx, impl_struct: str) -> FnInfo {
    let t0: Tok = ctx.toks.get(ctx.pos)
    eat_kw(ctx, "fn")
    let name: str = eat_ident(ctx)
    let typeparams: list[str] = parse_typeparams(ctx)
    eat_sym(ctx, "(")
    let params: list[str] = []
    let ptypes: list[str] = []
    let pmuts: list[bool] = []
    while !at_sym(ctx, ")") {
        let mut is_mut: bool = false
        if at_kw(ctx, "mut") {
            ctx.pos = ctx.pos + 1
            is_mut = true
        }
        let pn: str = eat_ident(ctx)
        eat_sym(ctx, ":")
        let pt: str = parse_type(ctx, false)
        params.push(pn)
        ptypes.push(pt)
        pmuts.push(is_mut)
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, ")") {
            perr(ctx, "expected ',' or ')' in parameters")
        }
    }
    eat_sym(ctx, ")")
    let mut ret: str = "void"
    if at_sym(ctx, "->") {
        ctx.pos = ctx.pos + 1
        ret = parse_type(ctx, true)
    }
    # Stage 9-beta: explicit `pure` keyword for documentation/linting.
    # `pure` and `uses` are mutually exclusive. The checker enforces that
    # a `pure` function's body transitively calls nothing effectful.
    let mut is_pure: bool = false
    if at_kw(ctx, "pure") {
        ctx.pos = ctx.pos + 1
        is_pure = true
    }
    # Stage 9-alpha: fine-grained effects. `uses IO` is a blanket alias
    # for the entire IO family (expanded at parse time). Other recognized
    # effects: Fs, Clock, Args, Exit. Reserved: Net, Rand, Proc.
    let mut effects: list[str] = []
    if at_kw(ctx, "uses") {
        if is_pure {
            perr(ctx, "'pure' and 'uses' are mutually exclusive (a pure function declares no effects)")
        }
        ctx.pos = ctx.pos + 1
        while true {
            let e: str = eat_ident(ctx)
            if e == "Net" || e == "Rand" || e == "Proc" {
                perr(ctx, "effect '" + e + "' is reserved for a future stage (no builtins implemented yet)")
            }
            if e != "IO" && e != "Fs" && e != "Clock" && e != "Args" && e != "Exit" {
                perr(ctx, "unknown effect '" + e + "'; known effects: IO, Fs, Clock, Args, Exit")
            }
            if !list_has(effects, e) {
                effects.push(e)
            }
            # `IO` is the blanket alias — expand to the full IO family.
            if e == "IO" {
                let mut k: int = 0
                let fam: list[str] = ["IO", "Fs", "Clock", "Args", "Exit"]
                while k < fam.len() {
                    let fe: str = fam.get(k)
                    if !list_has(effects, fe) {
                        effects.push(fe)
                    }
                    k = k + 1
                }
            }
            if at_sym(ctx, ",") {
                ctx.pos = ctx.pos + 1
                continue
            }
            break
        }
    }
    let body: list[int] = parse_block(ctx)
    return FnInfo {
        name: name, params: params, ptypes: ptypes, pmuts: pmuts,
        ret: ret, effects: effects, is_pure: is_pure, body: body,
        is_method: impl_struct != "", struct_of: impl_struct,
        typeparams: typeparams, line: t0.line, is_extern: false
    }
}

# Stage 15-beta: parse `extern "C" { fn ... }` block.
# Each fn declaration has NO body (just a signature). The `uses IO` (or
# `pure`) clause is REQUIRED — FFI is unsafe by default.
fn parse_extern_block(ctx: Ctx) -> void {
    let t0: Tok = ctx.toks.get(ctx.pos)
    eat_kw(ctx, "extern")
    let abi_tok: Tok = ctx.toks.get(ctx.pos)
    if abi_tok.kind != "str" {
        perr_at(ctx, "expected ABI string (e.g. \"C\") after 'extern'", abi_tok)
    }
    ctx.pos = ctx.pos + 1
    let abi: str = abi_tok.value
    if abi != "C" {
        perr_at(ctx, "unsupported ABI '" + abi + "'; only \"C\" is supported today", abi_tok)
    }
    eat_sym(ctx, "{")
    while !at_sym(ctx, "}") {
        if !at_kw(ctx, "fn") {
            perr(ctx, "extern block can only contain fn declarations")
        }
        # Parse the fn signature (no body). We reuse parse_fn but it
        # requires a body — so we parse up to the effects clause, then
        # skip the body parse for extern fns.
        let ft0: Tok = ctx.toks.get(ctx.pos)
        eat_kw(ctx, "fn")
        let name: str = eat_ident(ctx)
        let typeparams: list[str] = parse_typeparams(ctx)
        eat_sym(ctx, "(")
        let params: list[str] = []
        let ptypes: list[str] = []
        let pmuts: list[bool] = []
        while !at_sym(ctx, ")") {
            let mut is_mut: bool = false
            if at_kw(ctx, "mut") {
                ctx.pos = ctx.pos + 1
                is_mut = true
            }
            let pn: str = eat_ident(ctx)
            eat_sym(ctx, ":")
            let pt: str = parse_type(ctx, false)
            params.push(pn)
            ptypes.push(pt)
            pmuts.push(is_mut)
            if at_sym(ctx, ",") {
                ctx.pos = ctx.pos + 1
            } else if !at_sym(ctx, ")") {
                perr(ctx, "expected ',' or ')' in parameters")
            }
        }
        eat_sym(ctx, ")")
        let mut ret: str = "void"
        if at_sym(ctx, "->") {
            ctx.pos = ctx.pos + 1
            ret = parse_type(ctx, true)
        }
        let mut is_pure: bool = false
        if at_kw(ctx, "pure") {
            ctx.pos = ctx.pos + 1
            is_pure = true
        }
        let mut effects: list[str] = []
        if at_kw(ctx, "uses") {
            if is_pure {
                perr(ctx, "'pure' and 'uses' are mutually exclusive (a pure function declares no effects)")
            }
            ctx.pos = ctx.pos + 1
            while true {
                let e: str = eat_ident(ctx)
                if e == "Net" || e == "Rand" || e == "Proc" {
                    perr(ctx, "effect '" + e + "' is reserved for a future stage (no builtins implemented yet)")
                }
                if e != "IO" && e != "Fs" && e != "Clock" && e != "Args" && e != "Exit" {
                    perr(ctx, "unknown effect '" + e + "'; known effects: IO, Fs, Clock, Args, Exit")
                }
                if !list_has(effects, e) {
                    effects.push(e)
                }
                if e == "IO" {
                    let mut k: int = 0
                    let fam: list[str] = ["IO", "Fs", "Clock", "Args", "Exit"]
                    while k < fam.len() {
                        let fe: str = fam.get(k)
                        if !list_has(effects, fe) {
                            effects.push(fe)
                        }
                        k = k + 1
                    }
                }
                if at_sym(ctx, ",") {
                    ctx.pos = ctx.pos + 1
                    continue
                }
                break
            }
        }
        # Extern fns MUST declare `uses IO` (or `pure`) — FFI is unsafe by default.
        if effects.len() == 0 && !is_pure {
            perr_at(ctx, "extern fn '" + name + "' must declare `uses IO` (or `pure`) — FFI is unsafe by default", t0)
        }
        if ctx.fns.has(name) {
            perr_at(ctx, "duplicate function name: " + name, t0)
        }
        let empty_body: list[int] = []
        ctx.fns.set(name, FnInfo {
            name: name, params: params, ptypes: ptypes, pmuts: pmuts,
            ret: ret, effects: effects, is_pure: is_pure, body: empty_body,
            is_method: false, struct_of: "", typeparams: typeparams,
            line: ft0.line, is_extern: true
        })
        ctx.fn_order.push(name)
    }
    eat_sym(ctx, "}")
}

fn parse_block(ctx: Ctx) -> list[int] {
    eat_sym(ctx, "{")
    let mut out: list[int] = []
    while !at_sym(ctx, "}") {
        out.push(parse_stmt(ctx))
    }
    eat_sym(ctx, "}")
    return out
}

# --- Statement parsing ---

fn parse_stmt(ctx: Ctx) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind == "kw" {
        if t.value == "let" {
            return parse_let(ctx)
        }
        if t.value == "return" {
            ctx.pos = ctx.pos + 1
            let idx: int = nx_stmt(ctx, "return", t.line)
            if at_sym(ctx, "}") {
                ctx.stmts[idx].value = -1
            } else {
                ctx.stmts[idx].value = parse_expr(ctx, true)
            }
            return idx
        }
        if t.value == "if" {
            return parse_if(ctx)
        }
        if t.value == "while" {
            ctx.pos = ctx.pos + 1
            let cond: int = parse_expr(ctx, false)
            let body: list[int] = parse_block(ctx)
            let idx: int = nx_stmt(ctx, "while", t.line)
            ctx.stmts[idx].cond = cond
            ctx.stmts[idx].body = body
            return idx
        }
        if t.value == "for" {
            ctx.pos = ctx.pos + 1
            let vn: str = eat_ident(ctx)
            eat_sym(ctx, ":")
            let vt: str = parse_type(ctx, false)
            eat_kw(ctx, "in")
            let it: int = parse_expr(ctx, false)
            let body: list[int] = parse_block(ctx)
            let idx: int = nx_stmt(ctx, "for", t.line)
            ctx.stmts[idx].name = vn
            ctx.stmts[idx].vtype = vt
            ctx.stmts[idx].iter = it
            ctx.stmts[idx].body = body
            return idx
        }
        if t.value == "break" {
            ctx.pos = ctx.pos + 1
            return nx_stmt(ctx, "break", t.line)
        }
        if t.value == "continue" {
            ctx.pos = ctx.pos + 1
            return nx_stmt(ctx, "continue", t.line)
        }
        if t.value == "match" {
            # match as an expression statement
            let e: int = parse_match(ctx)
            let idx: int = nx_stmt(ctx, "expr", t.line)
            ctx.stmts[idx].e = e
            return idx
        }
        if t.value == "struct" || t.value == "impl" || t.value == "enum" || t.value == "fn" {
            perr_at(ctx, "declaration of " + t.value + " only allowed at top level", t)
        }
        perr_at(ctx, "keyword cannot start a statement: " + t.value, t)
    }
    # expression / assignment
    let mut e: int = parse_expr(ctx, true)
    if at_sym(ctx, "=") {
        let eq: Tok = ctx.toks.get(ctx.pos)
        ctx.pos = ctx.pos + 1
        let ek: str = ctx.exprs[e].kind
        if ek != "ident" && ek != "field" && ek != "index" {
            perr_at(ctx, "left side of assignment must be variable/field/index", eq)
        }
        if ek == "field" || ek == "index" {
            require_ident_root(ctx, e)
        }
        let val: int = parse_expr(ctx, true)
        let idx: int = nx_stmt(ctx, "assign", eq.line)
        ctx.stmts[idx].target = e
        ctx.stmts[idx].value = val
        return idx
    }
    let ek2: str = ctx.exprs[e].kind
    if ek2 != "call" && ek2 != "method" && ek2 != "fieldcall" && ek2 != "match" {
        perr(ctx, "expression as statement must be a function/method call")
    }
    let idx: int = nx_stmt(ctx, "expr", ctx.exprs[e].line)
    ctx.stmts[idx].e = e
    return idx
}

fn require_ident_root(ctx: Ctx, e: int) -> void {
    let mut k: str = ctx.exprs[e].kind
    if k == "field" || k == "index" {
        require_ident_root(ctx, ctx.exprs[e].left)
    } else if k != "ident" {
        perr(ctx, "left side of assignment must start from a variable")
    }
}

fn parse_let(ctx: Ctx) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    ctx.pos = ctx.pos + 1
    let mut is_mut: bool = false
    if at_kw(ctx, "mut") {
        ctx.pos = ctx.pos + 1
        is_mut = true
    }
    let name: str = eat_ident(ctx)
    eat_sym(ctx, ":")
    let ty: str = parse_type(ctx, false)
    eat_sym(ctx, "=")
    let val: int = parse_expr(ctx, true)
    let idx: int = nx_stmt(ctx, "let", t.line)
    ctx.stmts[idx].name = name
    ctx.stmts[idx].vtype = ty
    ctx.stmts[idx].is_mut = is_mut
    ctx.stmts[idx].value = val
    return idx
}

fn parse_if(ctx: Ctx) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    ctx.pos = ctx.pos + 1
    let cond: int = parse_expr(ctx, false)
    let then_b: list[int] = parse_block(ctx)
    let mut else_b: list[int] = []
    if at_kw(ctx, "else") {
        ctx.pos = ctx.pos + 1
        if at_kw(ctx, "if") {
            else_b.push(parse_if(ctx))
        } else {
            else_b = parse_block(ctx)
        }
    }
    let idx: int = nx_stmt(ctx, "if", t.line)
    ctx.stmts[idx].cond = cond
    ctx.stmts[idx].body = then_b
    ctx.stmts[idx].else_body = else_b
    return idx
}

# --- Expression parsing ---

fn parse_expr(ctx: Ctx, allow_struct: bool) -> int {
    return parse_bin(ctx, 0, allow_struct)
}

fn op_at_level(level: int, op: str) -> bool {
    if level == 0 {
        return op == "||"
    }
    if level == 1 {
        return op == "&&"
    }
    if level == 2 {
        return op == "==" || op == "!="
    }
    if level == 3 {
        return op == "<" || op == "<=" || op == ">" || op == ">="
    }
    if level == 4 {
        return op == "+" || op == "-"
    }
    return op == "*" || op == "/" || op == "%"
}

fn parse_bin(ctx: Ctx, level: int, allow_struct: bool) -> int {
    if level >= 6 {
        return parse_unary(ctx, allow_struct)
    }
    let mut left: int = parse_bin(ctx, level + 1, allow_struct)
    while true {
        let t: Tok = ctx.toks.get(ctx.pos)
        if t.kind != "sym" {
            break
        }
        if !op_at_level(level, t.value) {
            break
        }
        ctx.pos = ctx.pos + 1
        let right: int = parse_bin(ctx, level + 1, allow_struct)
        let idx: int = nx_expr(ctx, "bin", t.line)
        ctx.exprs[idx].op = t.value
        ctx.exprs[idx].left = left
        ctx.exprs[idx].right = right
        left = idx
    }
    return left
}

fn parse_unary(ctx: Ctx, allow_struct: bool) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind == "sym" && (t.value == "!" || t.value == "-") {
        ctx.pos = ctx.pos + 1
        let mut e: int = parse_unary(ctx, allow_struct)
        if t.value == "-" && ctx.exprs[e].kind == "int" && ctx.exprs[e].op == "big" {
            ctx.exprs[e].op = ""
            return e
        }
        let idx: int = nx_expr(ctx, "un", t.line)
        ctx.exprs[idx].op = t.value
        ctx.exprs[idx].left = e
        return idx
    }
    return parse_postfix(ctx, allow_struct)
}

fn can_index(k: str) -> bool {
    return k == "ident" || k == "field" || k == "index" || k == "call" || k == "method" || k == "fieldcall"
}

fn parse_postfix(ctx: Ctx, allow_struct: bool) -> int {
    let mut e: int = parse_primary(ctx, allow_struct)
    while true {
        let t: Tok = ctx.toks.get(ctx.pos)
        if t.kind != "sym" {
            break
        }
        if t.value == "." {
            ctx.pos = ctx.pos + 1
            let name: str = eat_ident(ctx)
            if at_sym(ctx, "(") {
                let args: list[int] = parse_args(ctx)
                let idx: int = nx_expr(ctx, "fieldcall", t.line)
                ctx.exprs[idx].name = name
                ctx.exprs[idx].left = e
                ctx.exprs[idx].args = args
                e = idx
            } else {
                let idx: int = nx_expr(ctx, "field", t.line)
                ctx.exprs[idx].name = name
                ctx.exprs[idx].left = e
                e = idx
            }
        } else if t.value == "[" && can_index(ctx.exprs[e].kind) {
            ctx.pos = ctx.pos + 1
            let idx_e: int = parse_expr(ctx, true)
            eat_sym(ctx, "]")
            let idx: int = nx_expr(ctx, "index", t.line)
            ctx.exprs[idx].left = e
            ctx.exprs[idx].right = idx_e
            e = idx
        } else if t.value == "(" && ctx.exprs[e].kind == "ident" {
            let args: list[int] = parse_args(ctx)
            let idx: int = nx_expr(ctx, "call", ctx.exprs[e].line)
            ctx.exprs[idx].name = ctx.exprs[e].name
            ctx.exprs[idx].args = args
            e = idx
        } else if t.value == "?" {
            ctx.pos = ctx.pos + 1
            let idx: int = nx_expr(ctx, "qmark", t.line)
            ctx.exprs[idx].left = e
            e = idx
        } else {
            break
        }
    }
    return e
}

fn parse_args(ctx: Ctx) -> list[int] {
    eat_sym(ctx, "(")
    let mut out: list[int] = []
    while !at_sym(ctx, ")") {
        out.push(parse_expr(ctx, true))
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, ")") {
            perr(ctx, "expected ',' or ')' in arguments")
        }
    }
    eat_sym(ctx, ")")
    return out
}

fn parse_match(ctx: Ctx) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    eat_kw(ctx, "match")
    let scrut: int = parse_expr(ctx, false)
    eat_sym(ctx, "{")
    let arm_idxs: list[int] = []
    while !at_sym(ctx, "}") {
        let arm_line_tok: Tok = ctx.toks.get(ctx.pos)
        let mut pat_kind: str = ""
        let mut enum_name: str = ""
        let mut variant: str = ""
        let mut bindings: list[str] = []
        let mut has_paren: bool = false
        # BUG-SC-16 fix: `_` is ALWAYS tokenized as an ident (byte 95 is a
        # valid ident-start char), never as a sym. The `at_sym(ctx, "_")`
        # check is dead code — removed for clarity (same as boot/parser.py
        # BUG-001 fix / BUG-18 cleanup).
        if at_ident(ctx, "_") {
            ctx.pos = ctx.pos + 1
            pat_kind = "wildcard"
        } else {
            pat_kind = "variant"
            enum_name = eat_ident(ctx)
            eat_sym(ctx, ".")
            variant = eat_ident(ctx)
            if at_sym(ctx, "(") {
                has_paren = true
                eat_sym(ctx, "(")
                while !at_sym(ctx, ")") {
                    if at_ident(ctx, "_") {
                        ctx.pos = ctx.pos + 1
                        bindings.push("_")
                    } else {
                        bindings.push(eat_ident(ctx))
                    }
                    if at_sym(ctx, ",") {
                        ctx.pos = ctx.pos + 1
                    } else if !at_sym(ctx, ")") {
                        perr(ctx, "expected ',' or ')' in variant pattern")
                    }
                }
                eat_sym(ctx, ")")
            }
        }
        eat_sym(ctx, "=>")
        let body: int = parse_expr(ctx, true)
        let arm_idx: int = nx_match_arm(ctx, pat_kind, enum_name, variant, bindings,
                                       has_paren, body, arm_line_tok.line)
        arm_idxs.push(arm_idx)
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, "}") {
            perr(ctx, "expected ',' or '}' in match arms")
        }
    }
    eat_sym(ctx, "}")
    let idx: int = nx_expr(ctx, "match", t.line)
    ctx.exprs[idx].left = scrut
    ctx.exprs[idx].args = arm_idxs
    return idx
}

fn parse_primary(ctx: Ctx, allow_struct: bool) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind == "int" {
        ctx.pos = ctx.pos + 1
        let idx: int = nx_expr(ctx, "int", t.line)
        # BUG-015 fix: strip leading zeros before the length check, so that
        # a 20-char literal like "09223372036854775808" (= 2^63 with a leading
        # zero) is treated as 19-char "9223372036854775808" — matching Stage-0's
        # behaviour. Stage-0 uses Python int() which strips leading zeros
        # automatically; the self-hosted uses string comparison so it must do
        # so explicitly.
        let mut v: str = t.value
        let mut stripped: str = v
        while stripped.len() > 1 && stripped.byte_at(0) == 48 {
            stripped = stripped.slice(1, stripped.len())
        }
        v = stripped
        if v.len() > 19 {
            perr_at(ctx, "integer literal too large (exceeds int64)", t)
        } else if v.len() == 19 && v > "9223372036854775808" {
            perr_at(ctx, "integer literal too large (exceeds int64)", t)
        } else if v.len() == 19 && v == "9223372036854775808" {
            ctx.exprs[idx].ival = -9223372036854775808
            ctx.exprs[idx].op = "big"
        } else {
            ctx.exprs[idx].ival = v.to_int()
        }
        return idx
    }
    if t.kind == "float" {
        ctx.pos = ctx.pos + 1
        let idx: int = nx_expr(ctx, "float", t.line)
        ctx.exprs[idx].fval = t.value.to_float()
        return idx
    }
    if t.kind == "str" {
        ctx.pos = ctx.pos + 1
        let idx: int = nx_expr(ctx, "str", t.line)
        ctx.exprs[idx].sval = t.value
        return idx
    }
    if t.kind == "kw" && (t.value == "true" || t.value == "false") {
        ctx.pos = ctx.pos + 1
        let idx: int = nx_expr(ctx, "bool", t.line)
        ctx.exprs[idx].bval = t.value == "true"
        return idx
    }
    if t.kind == "kw" && t.value == "match" {
        return parse_match(ctx)
    }
    if t.kind == "ident" {
        if allow_struct && peek2_is(ctx, "{") {
            return parse_struct_lit(ctx)
        }
        ctx.pos = ctx.pos + 1
        let idx: int = nx_expr(ctx, "ident", t.line)
        ctx.exprs[idx].name = t.value
        return idx
    }
    if t.kind == "sym" && t.value == "(" {
        ctx.pos = ctx.pos + 1
        let mut e: int = parse_expr(ctx, true)
        eat_sym(ctx, ")")
        return e
    }
    if t.kind == "sym" && t.value == "[" {
        ctx.pos = ctx.pos + 1
        let items: list[int] = []
        while !at_sym(ctx, "]") {
            items.push(parse_expr(ctx, true))
            if at_sym(ctx, ",") {
                ctx.pos = ctx.pos + 1
            } else if !at_sym(ctx, "]") {
                perr(ctx, "expected ',' or ']' in list literal")
            }
        }
        eat_sym(ctx, "]")
        let idx: int = nx_expr(ctx, "listlit", t.line)
        ctx.exprs[idx].args = items
        return idx
    }
    perr(ctx, "expected expression but got " + tok_desc(ctx))
    return -1
}

fn parse_struct_lit(ctx: Ctx) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    let name: str = t.value
    ctx.pos = ctx.pos + 1
    eat_sym(ctx, "{")
    let fnames: list[str] = []
    let fexprs: list[int] = []
    while !at_sym(ctx, "}") {
        let fname: str = eat_ident(ctx)
        eat_sym(ctx, ":")
        fnames.push(fname)
        fexprs.push(parse_expr(ctx, true))
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, "}") {
            perr(ctx, "expected ',' or '}' in struct literal")
        }
    }
    eat_sym(ctx, "}")
    let idx: int = nx_expr(ctx, "structlit", t.line)
    ctx.exprs[idx].name = name
    ctx.exprs[idx].ffields = fnames
    ctx.exprs[idx].args = fexprs
    return idx
}

# ----------------------------------------------------------------------------
# 4. CHECKER — type check + effects analysis (the security heart)
# ----------------------------------------------------------------------------

fn cerr(line: int, msg: str) -> void {
    panic("type error: " + msg + " (line " + line.to_str() + ")")
}

fn is_builtin_fn(n: str) -> bool {
    return n == "print" || n == "println" || n == "panic" || n == "exit"
        || n == "str" || n == "int" || n == "len" || n == "range"
        || n == "map_new" || n == "read_file" || n == "write_file"
        || n == "args" || n == "clock_ms" || n == "chr"
        || n == "file_exists"
        # Stage 8-alpha ownership primitives
        || n == "drop" || n == "clone" || n == "take"
        # Stage 10-alpha taint primitives
        || n == "tainted_args" || n == "taint_mark" || n == "taint_unwrap"
        # Stage 10-beta: more taint sources
        || n == "read_file_tainted"
}

fn list_has(list: list[str], x: str) -> bool {
    let mut i: int = 0
    while i < list.len() {
        if list.get(i) == x {
            return true
        }
        i = i + 1
    }
    return false
}

fn type_exists(ctx: Ctx, t: str) -> bool {
    if t == "int" || t == "float" || t == "bool" || t == "str" {
        return true
    }
    if list_has(ctx.cur_typeparams, t) {
        return true
    }
    if is_list_t(t) {
        return type_exists(ctx, list_elem_t(t))
    }
    if is_map_t(t) {
        return type_exists(ctx, map_val_t(t))
    }
    if is_taint_t(t) {
        # Stage 10-alpha: tainted[T] is a built-in generic wrapper; the
        # inner type must exist but `tainted` itself needs no struct/enum.
        return type_exists(ctx, taint_inner_t(t))
    }
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    if ctx.structs.has(base) {
        let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
        if st.typeparams.len() != args.len() {
            return false
        }
        let mut i: int = 0
        while i < args.len() {
            if !type_exists(ctx, args.get(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }
    if ctx.enums.has(base) {
        let en: EnumInfo = ctx.enums.get_or(base, dummy_enum())
        if en.typeparams.len() != args.len() {
            return false
        }
        let mut i: int = 0
        while i < args.len() {
            if !type_exists(ctx, args.get(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }
    return false
}

fn require_type(ctx: Ctx, t: str, line: int, what: str) -> void {
    if t == "void" {
        cerr(line, "cannot use 'void' as " + what)
    }
    if !type_exists(ctx, t) {
        cerr(line, "type does not exist: " + t)
    }
}

# resolve_struct(ctx, t) returns the (StructInfo, type_map) if t is a
# (possibly generic) struct type. Otherwise returns a struct whose name is "".
fn resolve_struct(ctx: Ctx, t: str) -> StructInfo {
    let base: str = type_base(t)
    if !ctx.structs.has(base) {
        return dummy_struct()
    }
    let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
    let args: list[str] = type_args(t)
    if st.typeparams.len() != args.len() {
        return dummy_struct()
    }
    # If non-generic, just return the struct (no type map).
    if st.typeparams.len() == 0 {
        return st
    }
    # For generic struct, return the struct; the caller will need to know
    # the type args (it can extract them from `t`).
    return st
}

# build_type_map(ctx, typeparams, args) — returns a parallel list of typeargs
# corresponding to typeparams (used by callers that need to instantiate).
# (We use lists since HLS has no map of str->str.)

fn dummy_binding() -> Binding {
    return Binding { t: "", is_mut: false, moved: false }
}

fn lookup_binding(env: list[map[str, Binding]], name: str) -> Binding {
    let mut i: int = env.len() - 1
    while i >= 0 {
        if env.get(i).has(name) {
            return env.get(i).get_or(name, dummy_binding())
        }
        i = i - 1
    }
    return dummy_binding()
}

fn lookup_exists(env: list[map[str, Binding]], name: str) -> bool {
    let mut i: int = env.len() - 1
    while i >= 0 {
        if env.get(i).has(name) {
            return true
        }
        i = i - 1
    }
    return false
}

# --- Stage 8-alpha ownership helpers (v0.4.0-alpha) ---
# Bindings carry a `moved` flag (Stage 8-alpha). These helpers mutate the flag
# in place (HLS maps are mutable through .set()).

fn mark_moved(env: list[map[str, Binding]], name: str) -> bool {
    let mut i: int = env.len() - 1
    while i >= 0 {
        if env.get(i).has(name) {
            let b: Binding = env.get(i).get_or(name, dummy_binding())
            env.get(i).set(name, Binding { t: b.t, is_mut: b.is_mut, moved: true })
            return true
        }
        i = i - 1
    }
    return false
}

fn revive_binding(env: list[map[str, Binding]], name: str) -> bool {
    let mut i: int = env.len() - 1
    while i >= 0 {
        if env.get(i).has(name) {
            let b: Binding = env.get(i).get_or(name, dummy_binding())
            env.get(i).set(name, Binding { t: b.t, is_mut: b.is_mut, moved: false })
            return true
        }
        i = i - 1
    }
    return false
}

# BUG-003 fix: snapshot_moved / restore_moved mirror Stage-0's snapshot/
# restore for the `moved` flag. They are used around `if`/`while`/`for`
# bodies so that moves done inside a child scope don't leak out — the
# branch may not execute, so any binding "moved" inside should still be
# considered unmoved after the construct completes.
#
# Snapshot format: a list of (scope_index, name, moved) tuples. We use
# a flat list of strings "i|name|0|1" because HLS maps require str keys.
fn snapshot_moved(env: list[map[str, Binding]]) -> list[str] {
    let snap: list[str] = []
    let mut i: int = 0
    while i < env.len() {
        let scope: map[str, Binding] = env.get(i)
        let names: list[str] = scope.keys()
        let mut j: int = 0
        while j < names.len() {
            let nm: str = names.get(j)
            let b: Binding = scope.get_or(nm, dummy_binding())
            let mut mv: str = "0"
            if b.moved {
                mv = "1"
            }
            snap.push(i.to_str() + "|" + nm + "|" + mv)
            j = j + 1
        }
        i = i + 1
    }
    return snap
}

fn restore_moved(env: list[map[str, Binding]], snap: list[str]) -> void {
    let mut i: int = 0
    while i < snap.len() {
        let entry: str = snap.get(i)
        # Format is "scope_idx|name|0or1". Identifier names never contain '|',
        # so split("|") yields exactly 3 parts. (If a future name contains '|',
        # the snapshot format would need to change — but identifiers can't.)
        let parts: list[str] = entry.split("|")
        if parts.len() < 3 {
            i = i + 1
            continue
        }
        let scope_idx: int = parts.get(0).to_int()
        let nm: str = parts.get(1)
        let mv_str: str = parts.get(2)
        if scope_idx < env.len() {
            let scope: map[str, Binding] = env.get(scope_idx)
            if scope.has(nm) {
                let b: Binding = scope.get_or(nm, dummy_binding())
                let mut mv: bool = false
                if mv_str == "1" {
                    mv = true
                }
                scope.set(nm, Binding { t: b.t, is_mut: b.is_mut, moved: mv })
            }
        }
        i = i + 1
    }
}

# is_owned_type: True if values of this type are heap-owned and subject to
# move tracking. Primitives (int/float/bool) are Copy — passing them is fine.
fn is_owned_type(t: str) -> bool {
    if t == "int" || t == "float" || t == "bool" || t == "void" || t == "never" {
        return false
    }
    return true
}

# is_clone_supported: True if clone() supports this type. Stage 8-beta
# (v0.19.0-alpha) expands clone() to EVERY owned type — str, list, map,
# struct, enum, tainted[...] — via per-instantiation codegen helpers
# (hl_clone_<mangled-type>) and the interpreter's deep_clone.
fn is_clone_supported(t: str) -> bool {
    if t == "str" {
        return true
    }
    if is_list_t(t) {
        return is_clone_supported(list_elem_t(t))
    }
    if is_map_t(t) {
        return is_clone_supported(map_val_t(t))
    }
    if is_taint_t(t) {
        return is_clone_supported(taint_inner_t(t))
    }
    # struct / enum / any other owned type
    return true
}

fn add_edge(ctx: Ctx, cur: str, callee: str) -> void {
    if !ctx.edges.has(cur) {
        ctx.edges.set(cur, [])
    }
    ctx.edges.get_or(cur, []).push(callee)
}

# --- Stage 9-alpha: fine-grained effects helpers (v0.5.0-alpha) ---

# builtin_effect(name) — the BUILTIN_EFFECTS table encoded as a function
# (HLS has no map-of-sets). Returns the list of effects a builtin requires
# (empty for pure builtins). Single-element lists today; future-proof for
# multi-effect builtins.
fn builtin_effect(name: str) -> list[str] {
    if name == "print" || name == "println" {
        return ["IO"]
    }
    if name == "read_file" || name == "write_file" || name == "file_exists" {
        return ["Fs"]
    }
    # Stage 10-beta: read_file_tainted is a taint source with the Fs effect.
    if name == "read_file_tainted" {
        return ["Fs"]
    }
    if name == "clock_ms" {
        return ["Clock"]
    }
    if name == "args" || name == "tainted_args" {
        # Stage 10-alpha: tainted_args carries the same Args effect as args.
        return ["Args"]
    }
    if name == "exit" {
        return ["Exit"]
    }
    # taint_mark / taint_unwrap are pure (no effect; just wrap/unwrap).
    return []   # pure builtin
}

# effects_add(eff, key, e) — set-style insert into eff[key]'s list.
# Returns true if the set grew (used by the fixpoint to detect change).
fn effects_add(eff: map[str, list[str]], key: str, e: str) -> bool {
    if !eff.has(key) {
        eff.set(key, [])
    }
    let lst: list[str] = eff.get_or(key, [])
    if !list_has(lst, e) {
        lst.push(e)
        return true
    }
    return false
}

# fmt_effects(effs) — pretty-print an effect set for error messages.
# Empty set renders as "(none - pure)".
fn fmt_effects(effs: list[str]) -> str {
    if effs.len() == 0 {
        return "(none - pure)"
    }
    return join(effs, ", ")
}

# --- unify: try to match a parameter type `pt` against an argument type `at`,
# binding type params from `tps` to concrete types in `targs_out` (parallel to
# `tps`). Returns true if unification succeeded for any type params.
# targs_out is a parallel list: targs_out[i] is the inferred type for tps[i]
# (or "" if not yet inferred).
# ---

fn unify_into(ctx: Ctx, pt: str, at: str, tps: list[str], targs_out: list[str]) -> void {
    # Exact-match case: pt is a type param.
    let mut i: int = 0
    while i < tps.len() {
        if pt == tps.get(i) {
            # If already bound, prefer the existing binding (the first one wins
            # for simplicity; conflicts will be caught by the arg type check).
            if targs_out.get(i) == "" {
                targs_out.set(i, at)
            }
            return
        }
        i = i + 1
    }
    if is_list_t(pt) && is_list_t(at) {
        unify_into(ctx, list_elem_t(pt), list_elem_t(at), tps, targs_out)
        return
    }
    if is_map_t(pt) && is_map_t(at) {
        unify_into(ctx, map_val_t(pt), map_val_t(at), tps, targs_out)
        return
    }
    if is_taint_t(pt) && is_taint_t(at) {
        unify_into(ctx, taint_inner_t(pt), taint_inner_t(at), tps, targs_out)
        return
    }
    # Same base name — recurse into args.
    let pb: str = type_base(pt)
    let ab: str = type_base(at)
    # Both must have type args (i.e., be generic instantiations), and the
    # base names must match.
    if pb == ab && pt != pb && at != ab {
        # Both are generic instantiations of the same user type.
        let pa: list[str] = type_args(pt)
        let aa: list[str] = type_args(at)
        if pa.len() == aa.len() {
            let mut j: int = 0
            while j < pa.len() {
                unify_into(ctx, pa.get(j), aa.get(j), tps, targs_out)
                j = j + 1
            }
        }
    }
}

# unify_into_offset: like unify_into but writes into a SLICE of targs_out
# starting at `offset`. Used by check_method when inferring a method's own
# type params (which sit AFTER the struct's type params in targs_out).
# This avoids the BUG-002 throwaway-list issue where list_slice_from
# returns a fresh list and unify_into's .set() mutations never propagate.
fn unify_into_offset(ctx: Ctx, pt: str, at: str, tps: list[str], targs_out: list[str], offset: int) -> void {
    # Exact-match case: pt is a type param.
    let mut i: int = 0
    while i < tps.len() {
        if pt == tps.get(i) {
            if targs_out.get(offset + i) == "" {
                targs_out.set(offset + i, at)
            }
            return
        }
        i = i + 1
    }
    if is_list_t(pt) && is_list_t(at) {
        unify_into_offset(ctx, list_elem_t(pt), list_elem_t(at), tps, targs_out, offset)
        return
    }
    if is_map_t(pt) && is_map_t(at) {
        unify_into_offset(ctx, map_val_t(pt), map_val_t(at), tps, targs_out, offset)
        return
    }
    if is_taint_t(pt) && is_taint_t(at) {
        unify_into_offset(ctx, taint_inner_t(pt), taint_inner_t(at), tps, targs_out, offset)
        return
    }
    let pb: str = type_base(pt)
    let ab: str = type_base(at)
    if pb == ab && pt != pb && at != ab {
        let pa: list[str] = type_args(pt)
        let aa: list[str] = type_args(at)
        if pa.len() == aa.len() {
            let mut j: int = 0
            while j < pa.len() {
                unify_into_offset(ctx, pa.get(j), aa.get(j), tps, targs_out, offset)
                j = j + 1
            }
        }
    }
}

# --- Checker lifecycle ---

fn check_program(ctx: Ctx) -> void {
    # 1. struct: field types
    let keys_s: list[str] = ctx.structs.keys()
    let mut si: int = 0
    while si < keys_s.len() {
        let st: StructInfo = ctx.structs.get_or(keys_s.get(si), dummy_struct())
        ctx.cur_typeparams = st.typeparams
        let mut fi: int = 0
        while fi < st.ftypes.len() {
            require_type(ctx, st.ftypes.get(fi), st.line, "struct field type")
            fi = fi + 1
        }
        # Also check default-value expressions (must be of the declared type).
        let mut di: int = 0
        while di < st.fdefaults.len() {
            if st.fdefaults.get(di) != -1 {
                let env: list[map[str, Binding]] = []
                env.push(map_new())
                let vt: str = check_expr(ctx, env, "", st.fdefaults.get(di), st.ftypes.get(di))
                if vt != "never" && vt != st.ftypes.get(di) {
                    cerr(st.line, "default value of field " + st.fields.get(di) + " expects " + st.ftypes.get(di) + ", got " + vt)
                }
            }
            di = di + 1
        }
        ctx.cur_typeparams = []
        si = si + 1
    }
    # 2. enum: variant payload types
    let keys_e: list[str] = ctx.enums.keys()
    let mut ei: int = 0
    while ei < keys_e.len() {
        let en: EnumInfo = ctx.enums.get_or(keys_e.get(ei), dummy_enum())
        ctx.cur_typeparams = en.typeparams
        let mut vi: int = 0
        while vi < en.variants.len() {
            let pl: list[str] = en.payloads.get(vi)
            let mut pi: int = 0
            while pi < pl.len() {
                require_type(ctx, pl.get(pi), en.line, "variant payload type")
                pi = pi + 1
            }
            vi = vi + 1
        }
        ctx.cur_typeparams = []
        ei = ei + 1
    }
    # 3. function declarations
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let mut key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        ctx.cur_typeparams = f.typeparams
        if !f.is_method {
            if is_builtin_fn(f.name) {
                cerr(f.line, "cannot redefine builtin function: " + f.name)
            }
        } else {
            if !ctx.structs.has(f.struct_of) {
                cerr(f.line, "impl for non-existent struct: " + f.struct_of)
            }
            if f.params.len() == 0 {
                cerr(f.line, "method must have 'self' as first parameter")
            }
            if f.params.get(0) != "self" || f.ptypes.get(0) != f.struct_of {
                cerr(f.line, "method must have first parameter 'self: " + f.struct_of + "'")
            }
        }
        let mut j: int = 0
        while j < f.params.len() {
            require_type(ctx, f.ptypes.get(j), f.line, "parameter type")
            j = j + 1
        }
        if f.ret != "void" {
            if !type_exists(ctx, f.ret) {
                cerr(f.line, "return type does not exist: " + f.ret)
            }
        }
        ctx.cur_typeparams = []
        i = i + 1
    }
    # 4. main
    if !ctx.fns.has("main") {
        cerr(1, "missing main function")
    }
    let mf: FnInfo = ctx.fns.get_or("main", dummy_fn())
    if mf.is_method {
        cerr(mf.line, "main cannot be a method")
    }
    if mf.params.len() > 0 {
        cerr(mf.line, "main cannot have parameters")
    }
    if mf.ret != "int" && mf.ret != "void" {
        cerr(mf.line, "main must return 'int' or have no return type")
    }
    # 5. check function bodies
    let mut bi: int = 0
    while bi < ctx.fn_order.len() {
        check_fn_body(ctx, ctx.fn_order.get(bi))
        bi = bi + 1
    }
    # 6. effects analysis
    check_effects(ctx)
    # 7. collect all generic struct/enum instantiations used anywhere in
    # the program (signatures, let bindings, expression types) so the codegen
    # emits the corresponding C types.
    collect_all_insts(ctx)
}

# collect_insts walks a single type string and records any generic struct /
# enum instantiations it finds. Skips types that contain type parameters
# (they're abstract, not instantiated).
fn collect_insts(ctx: Ctx, t: str) -> void {
    if t == "" || t == "int" || t == "float" || t == "bool" || t == "str" || t == "void" || t == "never" {
        return
    }
    if is_list_t(t) {
        collect_insts(ctx, list_elem_t(t))
        return
    }
    if is_map_t(t) {
        collect_insts(ctx, map_val_t(t))
        return
    }
    if is_taint_t(t) {
        collect_insts(ctx, taint_inner_t(t))
        return
    }
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    # Skip if the base isn't a known struct/enum — it's a type param.
    if !ctx.structs.has(base) && !ctx.enums.has(base) {
        return
    }
    # Skip if any arg is not concrete (contains a type param).
    let mut i: int = 0
    while i < args.len() {
        if !type_is_concrete(ctx, args.get(i)) {
            return
        }
        i = i + 1
    }
    if ctx.structs.has(base) {
        let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
        if st.typeparams.len() > 0 && args.len() == st.typeparams.len() {
            if !list_has(ctx.struct_insts, t) {
                ctx.struct_insts.push(t)
            }
        }
    } else if ctx.enums.has(base) {
        let en: EnumInfo = ctx.enums.get_or(base, dummy_enum())
        if en.typeparams.len() > 0 && args.len() == en.typeparams.len() {
            if !list_has(ctx.enum_insts, t) {
                ctx.enum_insts.push(t)
            }
        }
    }
    # Recurse into args.
    let mut j: int = 0
    while j < args.len() {
        collect_insts(ctx, args.get(j))
        j = j + 1
    }
}

# type_is_concrete returns true if `t` doesn't contain any type parameters.
fn type_is_concrete(ctx: Ctx, t: str) -> bool {
    if t == "" {
        return false
    }
    if t == "int" || t == "float" || t == "bool" || t == "str" || t == "void" || t == "never" {
        return true
    }
    if is_list_t(t) {
        return type_is_concrete(ctx, list_elem_t(t))
    }
    if is_map_t(t) {
        return type_is_concrete(ctx, map_val_t(t))
    }
    if is_taint_t(t) {
        return type_is_concrete(ctx, taint_inner_t(t))
    }
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    if !ctx.structs.has(base) && !ctx.enums.has(base) {
        return false
    }
    let mut i: int = 0
    while i < args.len() {
        if !type_is_concrete(ctx, args.get(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn collect_all_insts(ctx: Ctx) -> void {
    # Function signatures.
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let f: FnInfo = ctx.fns.get_or(ctx.fn_order.get(i), dummy_fn())
        let mut j: int = 0
        while j < f.ptypes.len() {
            collect_insts(ctx, f.ptypes.get(j))
            j = j + 1
        }
        collect_insts(ctx, f.ret)
        i = i + 1
    }
    # Struct fields.
    let sk: list[str] = ctx.structs.keys()
    let mut si: int = 0
    while si < sk.len() {
        let st: StructInfo = ctx.structs.get_or(sk.get(si), dummy_struct())
        let mut fi: int = 0
        while fi < st.ftypes.len() {
            collect_insts(ctx, st.ftypes.get(fi))
            fi = fi + 1
        }
        si = si + 1
    }
    # Enum payloads.
    let ek: list[str] = ctx.enums.keys()
    let mut ei: int = 0
    while ei < ek.len() {
        let en: EnumInfo = ctx.enums.get_or(ek.get(ei), dummy_enum())
        let mut vi: int = 0
        while vi < en.variants.len() {
            let pl: list[str] = en.payloads.get(vi)
            let mut pi: int = 0
            while pi < pl.len() {
                collect_insts(ctx, pl.get(pi))
                pi = pi + 1
            }
            vi = vi + 1
        }
        ei = ei + 1
    }
    # All expression types (after check).
    let mut xi: int = 0
    while xi < ctx.exprs.len() {
        if ctx.exprs[xi].t != "" && ctx.exprs[xi].t != "never" {
            collect_insts(ctx, ctx.exprs[xi].t)
        }
        xi = xi + 1
    }
    # All let vtypes + for vtypes.
    let mut ssi: int = 0
    while ssi < ctx.stmts.len() {
        if ctx.stmts[ssi].vtype != "" {
            collect_insts(ctx, ctx.stmts[ssi].vtype)
        }
        ssi = ssi + 1
    }
}

fn dummy_struct() -> StructInfo {
    return StructInfo { name: "", fields: [], ftypes: [], fdefaults: [], typeparams: [], line: 0 }
}

fn dummy_enum() -> EnumInfo {
    return EnumInfo { name: "", variants: [], payloads: [], typeparams: [], line: 0 }
}

fn dummy_fn() -> FnInfo {
    return FnInfo {
        name: "", params: [], ptypes: [], pmuts: [], ret: "void",
        effects: [], is_pure: false, body: [], is_method: false, struct_of: "",
        typeparams: [], line: 0, is_extern: false
    }
}

fn check_fn_body(ctx: Ctx, key: str) -> void {
    let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
    let saved_ret: str = ctx.cur_fn_ret
    let saved_tp: list[str] = ctx.cur_typeparams
    # Stage 15-beta: extern fns have NO body — they are forward declarations
    # for C functions. Skip body checking and the "must return on all paths"
    # check. They still participate in effects analysis (their declared
    # effects propagate to callers).
    if f.is_extern {
        ctx.cur_fn_ret = saved_ret
        ctx.cur_typeparams = saved_tp
        return
    }
    ctx.cur_fn_ret = f.ret
    ctx.cur_typeparams = f.typeparams
    let env: list[map[str, Binding]] = []
    let scope0: map[str, Binding] = map_new()
    if f.is_method {
        scope0.set(f.params.get(0), Binding { t: f.ptypes.get(0), is_mut: f.pmuts.get(0), moved: false })
        let mut i: int = 1
        while i < f.params.len() {
            scope0.set(f.params.get(i), Binding { t: f.ptypes.get(i), is_mut: f.pmuts.get(i), moved: false })
            i = i + 1
        }
    } else {
        let mut i: int = 0
        while i < f.params.len() {
            let pn: str = f.params.get(i)
            if scope0.has(pn) {
                cerr(f.line, "duplicate parameter name: " + pn)
            }
            scope0.set(pn, Binding { t: f.ptypes.get(i), is_mut: f.pmuts.get(i), moved: false })
            i = i + 1
        }
    }
    env.push(scope0)
    check_stmts(ctx, env, key, f, f.body, false)
    if f.ret != "void" {
        if !all_return(ctx, f.body) {
            cerr(f.line, "function '" + f.name + "' does not return on all paths")
        }
    }
    ctx.cur_fn_ret = saved_ret
    ctx.cur_typeparams = saved_tp
}

fn all_return(ctx: Ctx, stmts: list[int]) -> bool {
    if stmts.len() == 0 {
        return false
    }
    let last: int = stmts.get(stmts.len() - 1)
    let mut k: str = ctx.stmts[last].kind
    if k == "return" {
        return true
    }
    if k == "expr" && ctx.exprs[ctx.stmts[last].e].t == "never" {
        return true
    }
    # BUG-SC-5 fix: a `let` or `assign` whose RHS is `never`-typed
    # (e.g. `let x: int = panic("...")`) always diverges, so the
    # function returns on all paths. Previously this was rejected with
    # a spurious "does not return on all paths" error.
    if k == "let" && ctx.exprs[ctx.stmts[last].value].t == "never" {
        return true
    }
    if k == "assign" && ctx.exprs[ctx.stmts[last].value].t == "never" {
        return true
    }
    if k == "if" {
        if ctx.stmts[last].else_body.len() > 0 {
            return all_return(ctx, ctx.stmts[last].body) && all_return(ctx, ctx.stmts[last].else_body)
        }
    }
    if k == "expr" && ctx.exprs[ctx.stmts[last].e].kind == "match" {
        if match_all_return(ctx, ctx.stmts[last].e) {
            return true
        }
    }
    return false
}

fn match_all_return(ctx: Ctx, e: int) -> bool {
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let arm_idx: int = ctx.exprs[e].args.get(i)
        let arm: MatchArm = ctx.match_arms.get(arm_idx)
        # BUG-009 fix: removed dead `let body_k: str = ctx.stmts[0].kind`
        # line — that accessed the FIRST statement in the entire program
        # (not the arm body's statement) and was unused. The actual check
        # below uses arm.body_t which is the arm body's type (set during
        # check_match).
        # arm.body is an expression index; we check if it's a return wrapped
        # in an expression-statement. But arms are expressions — they don't
        # contain return statements directly. So a match can only be a
        # "return on all paths" if all arms are `never`-typed (e.g., all arms
        # are calls to `panic()`). Otherwise we cannot prove it returns.
        # For simplicity, treat all arms that have body_t == "never" as
        # returning.
        if arm.body_t != "never" {
            return false
        }
        i = i + 1
    }
    return ctx.exprs[e].args.len() > 0
}

fn check_stmts(ctx: Ctx, env: list[map[str, Binding]], cur: str, f: FnInfo, stmts: list[int], in_loop: bool) -> void {
    let mut i: int = 0
    while i < stmts.len() {
        check_stmt(ctx, env, cur, f, stmts.get(i), in_loop)
        i = i + 1
    }
}

fn check_stmt(ctx: Ctx, env: list[map[str, Binding]], cur: str, f: FnInfo, sidx: int, in_loop: bool) -> void {
    let s: StmtN = ctx.stmts[sidx]
    if s.kind == "let" {
        require_type(ctx, s.vtype, s.line, "variable type")
        if lookup_exists(env, s.name) {
            cerr(s.line, "shadowing not allowed: " + s.name)
        }
        let vt: str = check_expr(ctx, env, cur, s.value, s.vtype)
        if vt == "never" {
            # `let x: T = panic()` is sound: x is unreachable.
            env.get(env.len() - 1).set(s.name, Binding { t: s.vtype, is_mut: s.is_mut, moved: false })
            return
        }
        if vt != s.vtype {
            cerr(s.line, "type mismatch: declared " + s.vtype + " but got " + vt)
        }
        env.get(env.len() - 1).set(s.name, Binding { t: s.vtype, is_mut: s.is_mut, moved: false })
    } else if s.kind == "assign" {
        check_assign(ctx, env, cur, s)
    } else if s.kind == "if" {
        let ct: str = check_expr(ctx, env, cur, s.cond, "")
        if ct != "bool" {
            cerr(s.line, "if condition must be bool, got " + ct)
        }
        # BUG-003 fix: snapshot moved-status so moves done inside the
        # then/else branches don't leak out (a binding moved inside an
        # if-arm should not be considered moved after the if completes).
        let snap: list[str] = snapshot_moved(env)
        env.push(map_new())
        check_stmts(ctx, env, cur, f, s.body, in_loop)
        env.pop()
        if s.else_body.len() > 0 {
            env.push(map_new())
            check_stmts(ctx, env, cur, f, s.else_body, in_loop)
            env.pop()
        }
        restore_moved(env, snap)
    } else if s.kind == "while" {
        ctx.loop_header = ctx.loop_header + 1
        let ct: str = check_expr(ctx, env, cur, s.cond, "")
        ctx.loop_header = ctx.loop_header - 1
        if ct != "bool" {
            cerr(s.line, "while condition must be bool, got " + ct)
        }
        # BUG-003 fix: moves inside the loop body don't leak out — the loop
        # may execute zero or many times, so any post-loop use must remain valid.
        let snap: list[str] = snapshot_moved(env)
        env.push(map_new())
        check_stmts(ctx, env, cur, f, s.body, true)
        env.pop()
        restore_moved(env, snap)
    } else if s.kind == "for" {
        ctx.loop_header = ctx.loop_header + 1
        let it: str = check_expr(ctx, env, cur, s.iter, "")
        ctx.loop_header = ctx.loop_header - 1
        if !is_list_t(it) {
            cerr(s.line, "for-in expression must be a list, got " + it)
        }
        let mut elem: str = list_elem_t(it)
        if s.vtype != elem {
            cerr(s.line, "variable type " + s.vtype + " does not match element " + elem)
        }
        let snap: list[str] = snapshot_moved(env)
        env.push(map_new())
        env.get(env.len() - 1).set(s.name, Binding { t: elem, is_mut: false, moved: false })
        check_stmts(ctx, env, cur, f, s.body, true)
        env.pop()
        restore_moved(env, snap)
    } else if s.kind == "return" {
        if f.ret == "void" {
            if s.value != -1 {
                cerr(s.line, "void function cannot return a value")
            }
        } else {
            if s.value == -1 {
                cerr(s.line, "function returning " + f.ret + " must return a value")
            }
            let vt: str = check_expr(ctx, env, cur, s.value, f.ret)
            if vt != f.ret && vt != "never" {
                cerr(s.line, "return type mismatch: expected " + f.ret + ", got " + vt)
            }
        }
    } else if s.kind == "break" {
        if !in_loop {
            cerr(s.line, "break only allowed inside a loop")
        }
    } else if s.kind == "continue" {
        if !in_loop {
            cerr(s.line, "continue only allowed inside a loop")
        }
    } else if s.kind == "expr" {
        check_expr(ctx, env, cur, s.e, "")
    } else {
        cerr(s.line, "unknown statement: " + s.kind)
    }
}

fn check_assign(ctx: Ctx, env: list[map[str, Binding]], cur: str, s: StmtN) -> void {
    let tgt: int = s.target
    let mut root: int = tgt
    while ctx.exprs[root].kind == "field" || ctx.exprs[root].kind == "index" {
        root = ctx.exprs[root].left
    }
    let b: Binding = lookup_binding(env, ctx.exprs[root].name)
    if b.t == "" {
        cerr(s.line, "variable does not exist: " + ctx.exprs[root].name)
    }
    # Stage 8-alpha: use-after-move check on the LHS root.
    # Whole-binding assignment (`x = ...`) on a `let mut` binding is allowed
    # and revives the binding; field/index assignment requires the binding
    # to be unmoved (because reading x.field reads x).
    if b.moved {
        if ctx.exprs[tgt].kind == "ident" {
            if !b.is_mut {
                cerr(s.line, "cannot reassign immutable variable: " + ctx.exprs[root].name)
            }
            # otherwise OK — will be revived below
        } else {
            cerr(s.line, "use of moved value: " + ctx.exprs[root].name)
        }
    } else {
        if ctx.exprs[tgt].kind == "ident" && !b.is_mut {
            cerr(s.line, "cannot reassign immutable variable: " + ctx.exprs[root].name)
        }
    }
    let tt: str = check_lvalue(ctx, env, cur, tgt)
    let vt: str = check_expr(ctx, env, cur, s.value, tt)
    if vt == "never" {
        return
    }
    if vt != tt {
        cerr(s.line, "type mismatch on assignment: expected " + tt + ", got " + vt)
    }
    # Stage 8-alpha: revive the binding on whole-binding assignment.
    if ctx.exprs[tgt].kind == "ident" {
        let _ok: bool = revive_binding(env, ctx.exprs[root].name)
    }
}

fn check_lvalue(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int) -> str {
    if ctx.exprs[e].kind == "ident" {
        # Stage 8-beta: annotate the lvalue's type so the codegen can
        # emit release/retain for assignments by static type.
        ctx.exprs[e].t = lookup_binding(env, ctx.exprs[e].name).t
        return ctx.exprs[e].t
    }
    if ctx.exprs[e].kind == "field" {
        let bt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
        let st: StructInfo = resolve_struct(ctx, bt)
        if st.name == "" {
            cerr(ctx.exprs[e].line, "cannot access field on type " + bt)
        }
        let mut i: int = 0
        while i < st.fields.len() {
            if st.fields.get(i) == ctx.exprs[e].name {
                # If the struct is generic, instantiate the field type.
                # Stage 8-beta: annotate the lvalue's type for codegen.
                let mut ft: str = st.ftypes.get(i)
                if st.typeparams.len() > 0 {
                    let targs: list[str] = type_args(bt)
                    ft = instantiate_type(st.ftypes.get(i), st.typeparams, targs)
                }
                ctx.exprs[e].t = ft
                return ft
            }
            i = i + 1
        }
        cerr(ctx.exprs[e].line, "struct " + st.name + " has no field " + ctx.exprs[e].name)
    }
    if ctx.exprs[e].kind == "index" {
        let tt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
        if !is_list_t(tt) {
            cerr(ctx.exprs[e].line, "cannot use index on type " + tt)
        }
        let it: str = check_expr(ctx, env, cur, ctx.exprs[e].right, "")
        if it != "int" {
            cerr(ctx.exprs[e].line, "index must be int, got " + it)
        }
        let et: str = list_elem_t(tt)
        ctx.exprs[e].t = et
        return et
    }
    cerr(ctx.exprs[e].line, "invalid lvalue")
    return ""
}

fn check_expr(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let mut k: str = ctx.exprs[e].kind
    if k == "int" {
        if ctx.exprs[e].op == "big" {
            cerr(ctx.exprs[e].line, "integer literal too large (exceeds int64)")
        }
        ctx.exprs[e].t = "int"
    } else if k == "float" {
        ctx.exprs[e].t = "float"
    } else if k == "bool" {
        ctx.exprs[e].t = "bool"
    } else if k == "str" {
        ctx.exprs[e].t = "str"
    } else if k == "ident" {
        let b: Binding = lookup_binding(env, ctx.exprs[e].name)
        if b.t != "" {
            # Stage 8-alpha: use-after-move check
            if b.moved {
                cerr(ctx.exprs[e].line, "use of moved value: " + ctx.exprs[e].name)
            }
            ctx.exprs[e].t = b.t
        } else if ctx.enums.has(ctx.exprs[e].name) {
            cerr(ctx.exprs[e].line, "enum name '" + ctx.exprs[e].name + "' cannot be used as a value")
        } else if ctx.structs.has(ctx.exprs[e].name) {
            cerr(ctx.exprs[e].line, "struct name '" + ctx.exprs[e].name + "' cannot be used as a value")
        } else {
            cerr(ctx.exprs[e].line, "variable does not exist: " + ctx.exprs[e].name)
        }
    } else if k == "bin" {
        ctx.exprs[e].t = check_bin(ctx, env, cur, e)
    } else if k == "un" {
        let vt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
        if ctx.exprs[e].op == "!" {
            if vt != "bool" {
                cerr(ctx.exprs[e].line, "operator ! expects bool, got " + vt)
            }
            ctx.exprs[e].t = "bool"
        } else {
            if vt != "int" && vt != "float" {
                cerr(ctx.exprs[e].line, "operator - expects int/float, got " + vt)
            }
            ctx.exprs[e].t = vt
        }
    } else if k == "index" {
        let tt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
        if tt == "never" {
            cerr(ctx.exprs[e].line, "never value cannot be used in expression")
        }
        if !is_list_t(tt) {
            cerr(ctx.exprs[e].line, "cannot use index on type " + tt)
        }
        let it: str = check_expr(ctx, env, cur, ctx.exprs[e].right, "")
        if it != "int" {
            cerr(ctx.exprs[e].line, "index must be int, got " + it)
        }
        ctx.exprs[e].t = list_elem_t(tt)
    } else if k == "field" {
        # Disambiguate: if target is `ident` matching an enum name (and no
        # variable with that name), this is an enum variant with no payload.
        if ctx.exprs[ctx.exprs[e].left].kind == "ident" && ctx.enums.has(ctx.exprs[ctx.exprs[e].left].name) && !lookup_exists(env, ctx.exprs[ctx.exprs[e].left].name) {
            check_enum_variant(ctx, env, cur, e, expected, false)
        } else {
            let tt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
            if tt == "never" {
                cerr(ctx.exprs[e].line, "never value cannot be used in expression")
            }
            let st: StructInfo = resolve_struct(ctx, tt)
            if st.name == "" {
                cerr(ctx.exprs[e].line, "cannot access field on type " + tt)
            }
            let mut i: int = 0
            while i < st.fields.len() {
                if st.fields.get(i) == ctx.exprs[e].name {
                    if st.typeparams.len() > 0 {
                        let targs: list[str] = type_args(tt)
                        ctx.exprs[e].t = instantiate_type(st.ftypes.get(i), st.typeparams, targs)
                    } else {
                        ctx.exprs[e].t = st.ftypes.get(i)
                    }
                    break
                }
                i = i + 1
            }
            if ctx.exprs[e].t == "" {
                cerr(ctx.exprs[e].line, "struct " + st.name + " has no field " + ctx.exprs[e].name)
            }
        }
    } else if k == "fieldcall" {
        # Disambiguate: enum variant with payload OR method call.
        if ctx.exprs[ctx.exprs[e].left].kind == "ident" && ctx.enums.has(ctx.exprs[ctx.exprs[e].left].name) && !lookup_exists(env, ctx.exprs[ctx.exprs[e].left].name) {
            check_enum_variant(ctx, env, cur, e, expected, true)
        } else {
            # Rewrite as a method call.
            ctx.exprs[e].kind = "method"
            ctx.exprs[e].t = check_method(ctx, env, cur, e)
        }
    } else if k == "method" {
        ctx.exprs[e].t = check_method(ctx, env, cur, e)
    } else if k == "call" {
        ctx.exprs[e].t = check_call(ctx, env, cur, e, expected)
    } else if k == "listlit" {
        ctx.exprs[e].t = check_listlit(ctx, env, cur, e, expected)
    } else if k == "structlit" {
        ctx.exprs[e].t = check_structlit(ctx, env, cur, e, expected)
    } else if k == "match" {
        ctx.exprs[e].t = check_match(ctx, env, cur, e, expected)
    } else if k == "qmark" {
        ctx.exprs[e].t = check_qmark(ctx, env, cur, e, expected)
    } else if k == "enumlit" {
        # Already rewritten during a previous visit.
        # Re-derive the type from the stored enum_name + variant.
        let en: EnumInfo = ctx.enums.get_or(ctx.exprs[e].enum_name, dummy_enum())
        if en.name == "" {
            cerr(ctx.exprs[e].line, "enum does not exist: " + ctx.exprs[e].enum_name)
        }
        # We need the contextual type to recover the instantiation. Try
        # `expected` first.
        if expected != "" && type_base(expected) == en.name {
            ctx.exprs[e].t = expected
        } else {
            ctx.exprs[e].t = ctx.exprs[e].enum_name
        }
    } else {
        cerr(ctx.exprs[e].line, "unknown expression: " + k)
    }
    return ctx.exprs[e].t
}

fn check_bin(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int) -> str {
    let mut line: int = ctx.exprs[e].line
    let lt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
    let rt: str = check_expr(ctx, env, cur, ctx.exprs[e].right, "")
    if lt == "never" || rt == "never" {
        cerr(line, "never value cannot be used in expression")
    }
    let op: str = ctx.exprs[e].op
    if op == "||" || op == "&&" {
        if lt != "bool" || rt != "bool" {
            cerr(line, "operator " + op + " expects bool, got " + lt + " and " + rt)
        }
        return "bool"
    }
    if op == "==" || op == "!=" {
        if lt != rt || (lt != "int" && lt != "float" && lt != "bool" && lt != "str") {
            cerr(line, "cannot compare == between " + lt + " and " + rt)
        }
        return "bool"
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if lt != rt || (lt != "int" && lt != "float" && lt != "str") {
            cerr(line, "cannot compare ordering between " + lt + " and " + rt)
        }
        return "bool"
    }
    if op == "+" {
        if lt == "int" && rt == "int" {
            return "int"
        }
        if lt == "float" && rt == "float" {
            return "float"
        }
        if lt == "str" && rt == "str" {
            return "str"
        }
        cerr(line, "operator + does not support " + lt + " and " + rt)
    }
    if op == "-" || op == "*" || op == "/" || op == "%" {
        if lt == "int" && rt == "int" {
            return "int"
        }
        if lt == "float" && rt == "float" {
            return "float"
        }
        cerr(line, "operator " + op + " does not support " + lt + " and " + rt)
    }
    cerr(line, "unknown operator: " + op)
    return ""
}

fn check_listlit(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let mut elem: str = ""
    if is_list_t(expected) {
        elem = list_elem_t(expected)
    }
    if elem == "" {
        if ctx.exprs[e].args.len() == 0 {
            cerr(ctx.exprs[e].line, "empty list literal requires a type in the surrounding context")
        }
        elem = check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "")
        if elem == "void" || elem == "never" {
            cerr(ctx.exprs[e].line, "list element cannot have type " + elem)
        }
    }
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let vt: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(i), elem)
        if vt != elem {
            cerr(ctx.exprs[e].line, "list element mismatch: expected " + elem + ", got " + vt)
        }
        i = i + 1
    }
    return "list[" + elem + "]"
}

fn check_structlit(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let name: str = ctx.exprs[e].name
    let mut line: int = ctx.exprs[e].line
    if !ctx.structs.has(name) {
        cerr(line, "struct does not exist: " + name)
    }
    let st: StructInfo = ctx.structs.get_or(name, dummy_struct())
    let typeparams: list[str] = st.typeparams
    # Build the type_map for generic instantiation (if applicable).
    let targs: list[str] = []
    let mut i: int = 0
    while i < typeparams.len() {
        targs.push("")
        i = i + 1
    }
    if typeparams.len() > 0 && expected != "" && type_base(expected) == name {
        let eargs: list[str] = type_args(expected)
        if eargs.len() == typeparams.len() {
            let mut j: int = 0
            while j < eargs.len() {
                targs.set(j, eargs.get(j))
                j = j + 1
            }
        }
    }
    # Validate field names match declared order (and required fields present).
    let provided: list[str] = ctx.exprs[e].ffields
    let declared: list[str] = st.fields
    let mut pi: int = 0
    while pi < provided.len() {
        if pi >= declared.len() || declared.get(pi) != provided.get(pi) {
            let mut want: str = "<end>"
            if pi < declared.len() {
                want = declared.get(pi)
            }
            cerr(line, "struct literal field order mismatch at position " + pi.to_str() + ": expected '" + want + "', got '" + provided.get(pi) + "'")
        }
        pi = pi + 1
    }
    if provided.len() > declared.len() {
        cerr(line, "struct literal " + name + " has too many fields")
    }
    # Required (non-defaulted) fields must be present.
    let mut di: int = 0
    while di < declared.len() {
        let has_default: bool = st.fdefaults.get(di) != -1
        let is_required: bool = !has_default
        let is_provided: bool = di < provided.len()
        if is_required && !is_provided {
            cerr(line, "struct literal missing required field '" + declared.get(di) + "'")
        }
        di = di + 1
    }
    # Type-check each provided field against the instantiated declared type.
    let mut fi: int = 0
    while fi < provided.len() {
        let decl_ftype: str = st.ftypes.get(fi)
        let mut inst_ftype: str = ""
        if typeparams.len() > 0 {
            inst_ftype = instantiate_type(decl_ftype, typeparams, targs)
        } else {
            inst_ftype = decl_ftype
        }
        let vt: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(fi), inst_ftype)
        if vt != inst_ftype {
            cerr(line, "field type " + st.fields.get(fi) + " mismatch: expected " + inst_ftype + ", got " + vt)
        }
        # If generic, try to infer type args from provided field values.
        if typeparams.len() > 0 {
            unify_into(ctx, decl_ftype, vt, typeparams, targs)
        }
        fi = fi + 1
    }
    # If generic and any type arg is still unbound, error.
    if typeparams.len() > 0 {
        let mut ti: int = 0
        while ti < typeparams.len() {
            if targs.get(ti) == "" {
                cerr(line, "cannot infer type argument for struct " + name + "; provide a contextual type")
            }
            ti = ti + 1
        }
        let inst_t: str = name + "[" + join(targs, ", ") + "]"
        # Record this struct instantiation for codegen — only if all type
        # args are concrete (not type params of an enclosing generic).
        if type_is_concrete(ctx, inst_t) && !list_has(ctx.struct_insts, inst_t) {
            ctx.struct_insts.push(inst_t)
        }
        return inst_t
    }
    return name
}

fn check_call(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let name: str = ctx.exprs[e].name
    let mut line: int = ctx.exprs[e].line
    if is_builtin_fn(name) {
        ctx.exprs[e].muser = false
        ctx.exprs[e].mkey = name
        return check_builtin_call(ctx, env, cur, e, name, expected)
    }
    if ctx.fns.has(name) {
        let f: FnInfo = ctx.fns.get_or(name, dummy_fn())
        if f.is_method {
            cerr(line, "method must be called through an object: " + name)
        }
        ctx.exprs[e].muser = true
        ctx.exprs[e].mkey = name
        add_edge(ctx, cur, name)
        if ctx.exprs[e].args.len() != f.params.len() {
            cerr(line, "function " + name + " expects " + f.params.len().to_str() + " arguments, got " + ctx.exprs[e].args.len().to_str())
        }
        # Generic function: infer type args from argument types.
        let typeparams: list[str] = f.typeparams
        let targs: list[str] = []
        let mut ti: int = 0
        while ti < typeparams.len() {
            targs.push("")
            ti = ti + 1
        }
        # BUG-A2 fix: cache first-pass types per argument so we don't re-run
        # check_expr on the same argument in the second pass. Calling
        # check_expr twice would re-execute side effects (drop/take move-
        # marking) and produce a spurious "use of moved value" error.
        let first_at: list[str] = []
        let mut fai: int = 0
        while fai < ctx.exprs[e].args.len() {
            first_at.push("")
            fai = fai + 1
        }
        if typeparams.len() > 0 {
            let mut ai: int = 0
            while ai < ctx.exprs[e].args.len() {
                let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai), "")
                first_at.set(ai, at)
                if at != "never" {
                    unify_into(ctx, f.ptypes.get(ai), at, typeparams, targs)
                }
                ai = ai + 1
            }
            let mut ti2: int = 0
            while ti2 < typeparams.len() {
                if targs.get(ti2) == "" {
                    # BUG-013 fix: name the unbound type-param (e.g. "T") instead
                    # of just the function name — so the user knows WHICH type
                    # param of a multi-param generic is unbound.
                    cerr(line, "cannot infer type argument '" + typeparams.get(ti2) + "' for " + name + "; provide explicit types")
                }
                ti2 = ti2 + 1
            }
            # Record this generic function instantiation for codegen.
            let inst_str: str = name + "|" + join(targs, ",")
            if !list_has(ctx.fn_insts, inst_str) {
                ctx.fn_insts.push(inst_str)
            }
            # Store the inferred concrete type args on the call node so the
            # codegen can use the mangled function name.
            ctx.exprs[e].inst_targs = targs
            # Also set mkey to the mangled name so gen_call uses the right name.
            ctx.exprs[e].mkey = c_mangled_fn_name(name, typeparams, targs)
        } else {
            ctx.exprs[e].mkey = name
        }
        # Type-check arguments against instantiated parameter types.
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            let mut inst_pt: str = ""
            if typeparams.len() > 0 {
                inst_pt = instantiate_type(f.ptypes.get(i), typeparams, targs)
            } else {
                inst_pt = f.ptypes.get(i)
            }
            # Reuse the first-pass type whenever it already matches the
            # instantiated parameter type — avoids re-running check_expr
            # (which would re-execute side effects like drop/take).
            let mut at: str = first_at.get(i)
            if at == "" {
                at = check_expr(ctx, env, cur, ctx.exprs[e].args.get(i), inst_pt)
            }
            if at == "never" {
                i = i + 1
                continue
            }
            if at != inst_pt {
                cerr(line, "argument '" + f.params.get(i) + "' of " + name + " expects " + inst_pt + ", got " + at)
            }
            i = i + 1
        }
        if typeparams.len() > 0 {
            return instantiate_type(f.ret, typeparams, targs)
        }
        return f.ret
    }
    cerr(line, "function does not exist: " + name)
    return ""
}

fn check_builtin_call(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, name: str, expected: str) -> str {
    let mut line: int = ctx.exprs[e].line
    let nargs: int = ctx.exprs[e].args.len()
    let argt: list[str] = []
    let mut i: int = 0
    while i < nargs {
        argt.push(check_expr(ctx, env, cur, ctx.exprs[e].args.get(i), ""))
        i = i + 1
    }
    let mut j: int = 0
    while j < nargs {
        if argt.get(j) == "never" {
            cerr(line, "never value cannot be used as an argument")
        }
        j = j + 1
    }
    # Stage 10-alpha: taint-sink enforcement.
    # Reject tainted[T] at sink argument positions; user must explicitly
    # untaint via taint_unwrap or a sanitizer (sanitize_html etc.).
    if name == "print" || name == "println" {
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: " + name + " argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink — use sanitize_html / sanitize_path / sanitize_sql_identifier / sanitize_sql_string / sanitize_command / sanitize_filename from std.sanitize, or taint_unwrap() if you accept the risk)")
        }
    }
    if name == "exit" {
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: exit argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink)")
        }
    }
    if name == "read_file" || name == "file_exists" || name == "read_file_tainted" {
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: " + name + " argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink — use sanitize_path from std.sanitize, or taint_unwrap() if you accept the risk)")
        }
    }
    if name == "write_file" {
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: write_file argument 1 (path) is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink)")
        }
        if is_taint_t(argt.get(1)) {
            cerr(line, "taint-sink violation: write_file argument 2 (content) is " + argt.get(1) + " (tainted values must be sanitised before reaching a sink)")
        }
    }
    if name == "print" || name == "println" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, name + " expects 1 str argument")
        }
        add_edge(ctx, cur, "b:print")
        return "void"
    }
    if name == "panic" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "panic expects 1 str argument")
        }
        return "never"
    }
    if name == "exit" {
        if nargs != 1 || argt.get(0) != "int" {
            cerr(line, "exit expects 1 int argument")
        }
        add_edge(ctx, cur, "b:exit")
        return "never"
    }
    if name == "str" {
        if nargs != 1 {
            cerr(line, "str() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if a0 != "int" && a0 != "float" && a0 != "bool" && a0 != "str" {
            cerr(line, "str() does not support type " + a0)
        }
        return "str"
    }
    if name == "int" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "int() expects 1 str argument")
        }
        return "int"
    }
    if name == "len" {
        if nargs != 1 {
            cerr(line, "len() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if a0 != "str" && !is_list_t(a0) && !is_map_t(a0) {
            cerr(line, "len() does not support type " + a0)
        }
        return "int"
    }
    if name == "range" {
        if nargs != 2 || argt.get(0) != "int" || argt.get(1) != "int" {
            cerr(line, "range() expects 2 int arguments")
        }
        return "list[int]"
    }
    if name == "map_new" {
        if nargs != 0 {
            cerr(line, "map_new() takes no arguments")
        }
        if expected == "" || !is_map_t(expected) {
            cerr(line, "map_new() requires a 'map[str, T]' type in the surrounding context")
        }
        return expected
    }
    if name == "read_file" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "read_file() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:read_file")
        return "str"
    }
    # Stage 10-beta: read_file_tainted(path) — same as read_file but the
    # returned str is wrapped as tainted[str]. Second taint source after
    # tainted_args; covers user-controlled content read from a file.
    if name == "read_file_tainted" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "read_file_tainted() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:read_file_tainted")
        return "tainted[str]"
    }
    if name == "write_file" {
        if nargs != 2 || argt.get(0) != "str" || argt.get(1) != "str" {
            cerr(line, "write_file() expects 2 str arguments")
        }
        add_edge(ctx, cur, "b:write_file")
        return "void"
    }
    if name == "args" {
        if nargs != 0 {
            cerr(line, "args() takes no arguments")
        }
        add_edge(ctx, cur, "b:args")
        return "list[str]"
    }
    # Stage 10-alpha: tainted_args — like args() but each element is
    # wrapped as tainted[str] (defined in std/taint.hls).
    if name == "tainted_args" {
        if nargs != 0 {
            cerr(line, "tainted_args() takes no arguments")
        }
        add_edge(ctx, cur, "b:tainted_args")
        return "list[tainted[str]]"
    }
    # Stage 10-alpha: taint_mark / taint_unwrap — generic wrap / unwrap.
    if name == "taint_mark" {
        if nargs != 1 {
            cerr(line, "taint_mark() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if a0 == "void" {
            cerr(line, "taint_mark() does not support void")
        }
        return "tainted[" + a0 + "]"
    }
    if name == "taint_unwrap" {
        if nargs != 1 {
            cerr(line, "taint_unwrap() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if !is_taint_t(a0) {
            cerr(line, "taint_unwrap() expects a tainted[T] value, got " + a0)
        }
        return taint_inner_t(a0)
    }
    if name == "clock_ms" {
        if nargs != 0 {
            cerr(line, "clock_ms() takes no arguments")
        }
        add_edge(ctx, cur, "b:clock_ms")
        return "int"
    }
    if name == "chr" {
        if nargs != 1 || argt.get(0) != "int" {
            cerr(line, "chr() expects 1 int argument")
        }
        return "str"
    }
    if name == "file_exists" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "file_exists() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:file_exists")
        return "bool"
    }
    # ----- Stage 8-alpha: ownership primitives (drop / clone / take) -----
    if name == "drop" {
        if nargs != 1 {
            cerr(line, "drop() expects 1 argument")
        }
        if ctx.loop_header > 0 {
            cerr(line, "drop() cannot be used inside a loop condition or iterable (the binding would be moved on every iteration)")
        }
        let at: str = argt.get(0)
        if !is_owned_type(at) {
            cerr(line, "drop() requires an owned (heap) type, got " + at)
        }
        # Argument must be a plain identifier so we can mark its binding.
        let arg_idx: int = ctx.exprs[e].args.get(0)
        if ctx.exprs[arg_idx].kind != "ident" {
            cerr(line, "drop() requires a variable name (not an expression)")
        }
        let arg_name: str = ctx.exprs[arg_idx].name
        if !mark_moved(env, arg_name) {
            cerr(line, "drop() argument is not a binding: " + arg_name)
        }
        return "void"
    }
    if name == "clone" {
        if nargs != 1 {
            cerr(line, "clone() expects 1 argument")
        }
        let at2: str = argt.get(0)
        if !is_owned_type(at2) {
            cerr(line, "clone() requires an owned (heap) type, got " + at2)
        }
        if !is_clone_supported(at2) {
            cerr(line, "clone() on type " + at2 + " is not supported (owned types only)")
        }
        return at2
    }
    if name == "take" {
        if nargs != 1 {
            cerr(line, "take() expects 1 argument")
        }
        let at3: str = argt.get(0)
        if !is_owned_type(at3) {
            cerr(line, "take() requires an owned (heap) type, got " + at3)
        }
        # Stage 8-beta: a move inside a while/for condition or iterable
        # would re-execute on every iteration (the binding is nulled in
        # generated code after the first pass) — reject it up front.
        if ctx.loop_header > 0 {
            cerr(line, "take() cannot be used inside a loop condition or iterable (the binding would be moved on every iteration)")
        }
        let arg_idx3: int = ctx.exprs[e].args.get(0)
        if ctx.exprs[arg_idx3].kind != "ident" {
            cerr(line, "take() requires a variable name (not an expression)")
        }
        let arg_name3: str = ctx.exprs[arg_idx3].name
        if !mark_moved(env, arg_name3) {
            cerr(line, "take() argument is not a binding: " + arg_name3)
        }
        return at3
    }
    cerr(line, "unknown builtin function: " + name)
    return ""
}

fn check_method(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int) -> str {
    let name: str = ctx.exprs[e].name
    let mut line: int = ctx.exprs[e].line
    let tt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
    if tt == "never" {
        cerr(line, "never value cannot be used in expression")
    }
    let nargs: int = ctx.exprs[e].args.len()
    # User-defined struct method (resolve via base name).
    let st: StructInfo = resolve_struct(ctx, tt)
    if st.name != "" {
        let tt_base: str = type_base(tt)
        if ctx.methods_of.has(tt_base) {
            let cands: list[str] = ctx.methods_of.get_or(tt_base, [])
            let mut key: str = ""
            let mut i: int = 0
            while i < cands.len() {
                let mut k: str = cands.get(i)
                if ctx.fns.get_or(k, dummy_fn()).name == name {
                    key = k
                }
                i = i + 1
            }
            if key == "" {
                cerr(line, "struct " + tt_base + " has no method " + name)
            }
            ctx.exprs[e].muser = true
            ctx.exprs[e].mkey = key
            add_edge(ctx, cur, key)
            let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
            let np: int = f.params.len() - 1
            if nargs != np {
                cerr(line, tt_base + "." + name + " expects " + np.to_str() + " arguments, got " + nargs.to_str())
            }
            # Build a type_map combining struct's type args + method's type params.
            let type_map_tps: list[str] = []
            let type_map_targs: list[str] = []
            # Add the struct's type params first, bound to the actual type args.
            let mut si: int = 0
            while si < st.typeparams.len() {
                type_map_tps.push(st.typeparams.get(si))
                let targs_of_tt: list[str] = type_args(tt)
                if si < targs_of_tt.len() {
                    type_map_targs.push(targs_of_tt.get(si))
                } else {
                    type_map_targs.push("")
                }
                si = si + 1
            }
            # Then the method's own type params (initially unbound).
            let mut mi: int = 0
            while mi < f.typeparams.len() {
                type_map_tps.push(f.typeparams.get(mi))
                type_map_targs.push("")
                mi = mi + 1
            }
            # Infer method's type params from arguments.
            # BUG-A2 fix: cache first-pass types per argument so we don't
            # re-run check_expr on the same argument in the second pass.
            let first_at: list[str] = []
            let mut fa_i: int = 0
            while fa_i < nargs {
                first_at.push("")
                fa_i = fa_i + 1
            }
            if f.typeparams.len() > 0 {
                let mut ai: int = 0
                while ai < nargs {
                    let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai), "")
                    first_at.set(ai, at)
                    if at != "never" {
                        # pt is f.ptypes.get(ai+1) — instantiate struct type
                        # params first, then unify with method type params.
                        # NOTE (BUG-002 fix): we pass an explicit offset
                        # (st.typeparams.len()) so unify_into_offset writes
                        # directly into the method's portion of type_map_targs.
                        let pt: str = f.ptypes.get(ai + 1)
                        let inst_pt: str = instantiate_type(pt, st.typeparams, type_args(tt))
                        unify_into_offset(ctx, inst_pt, at, f.typeparams, type_map_targs, st.typeparams.len())
                    }
                    ai = ai + 1
                }
                let mut ti: int = st.typeparams.len()
                while ti < type_map_targs.len() {
                    if type_map_targs.get(ti) == "" {
                        cerr(line, "cannot infer type argument '" + f.typeparams.get(ti - st.typeparams.len()) + "' for " + tt_base + "." + name)
                    }
                    ti = ti + 1
                }
            }
            # Type-check arguments against instantiated parameter types.
            let mut ai2: int = 0
            while ai2 < nargs {
                let pt: str = f.ptypes.get(ai2 + 1)
                let inst_pt: str = instantiate_type(pt, type_map_tps, type_map_targs)
                # Reuse the first-pass type — avoids re-running check_expr.
                let mut at: str = first_at.get(ai2)
                if at == "" {
                    at = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai2), inst_pt)
                }
                if at == "never" {
                    ai2 = ai2 + 1
                    continue
                }
                if at != inst_pt {
                    cerr(line, "argument of " + tt_base + "." + name + " expects " + inst_pt + ", got " + at)
                }
                ai2 = ai2 + 1
            }
            # BUG-002 fix: if the method has its own type params (or the
            # struct is generic), record this instantiation for codegen.
            # The mangled name encodes BOTH the struct's type args (resolved
            # from the receiver type) AND the method's inferred type args.
            if f.typeparams.len() > 0 || st.typeparams.len() > 0 {
                let mut all_targs: list[str] = []
                # Struct's type args first.
                let mut si2: int = 0
                let targs_of_tt: list[str] = type_args(tt)
                while si2 < st.typeparams.len() {
                    if si2 < targs_of_tt.len() {
                        all_targs.push(targs_of_tt.get(si2))
                    } else {
                        all_targs.push("")
                    }
                    si2 = si2 + 1
                }
                # Then method's own type args.
                let mut mi2: int = st.typeparams.len()
                while mi2 < type_map_targs.len() {
                    all_targs.push(type_map_targs.get(mi2))
                    mi2 = mi2 + 1
                }
                # Compose a combined typeparams list for the mangling.
                let combined_tps: list[str] = []
                let mut ci: int = 0
                while ci < st.typeparams.len() {
                    combined_tps.push(st.typeparams.get(ci))
                    ci = ci + 1
                }
                let mut cj: int = 0
                while cj < f.typeparams.len() {
                    combined_tps.push(f.typeparams.get(cj))
                    cj = cj + 1
                }
                let inst_str: str = key + "|" + join(all_targs, ",")
                if !list_has(ctx.fn_insts, inst_str) {
                    ctx.fn_insts.push(inst_str)
                }
                ctx.exprs[e].mkey = c_mangled_fn_name(key, combined_tps, all_targs)
            }
            return instantiate_type(f.ret, type_map_tps, type_map_targs)
        }
    }
    # Builtin method: ptypes + ret table by target type
    let ptypes: list[str] = []
    let mut ret: str = ""
    if tt == "str" {
        if name == "len" { ret = "int" }
        else if name == "byte_at"  {
        ptypes.push("int")
        ret = "int"
    }
        else if name == "slice"  {
        ptypes.push("int")
        ptypes.push("int")
        ret = "str"
    }
        else if name == "find"  {
        ptypes.push("str")
        ret = "int"
    }
        else if name == "contains"  {
        ptypes.push("str")
        ret = "bool"
    }
        else if name == "starts_with"  {
        ptypes.push("str")
        ret = "bool"
    }
        else if name == "ends_with"  {
        ptypes.push("str")
        ret = "bool"
    }
        else if name == "split"  {
        ptypes.push("str")
        ret = "list[str]"
    }
        else if name == "trim" { ret = "str" }
        else if name == "to_int" { ret = "int" }
        else if name == "to_float" { ret = "float" }
        else if name == "to_str" { ret = "str" }
        else { cerr(line, "str has no method " + name) }
        ctx.exprs[e].mop = "str." + name
    } else if tt == "int" {
        if name == "to_str" { ret = "str" }
        else if name == "to_float" { ret = "float" }
        else if name == "abs" { ret = "int" }
        else { cerr(line, "int has no method " + name) }
        ctx.exprs[e].mop = "int." + name
    } else if tt == "float" {
        if name == "to_str" { ret = "str" }
        else if name == "to_int" { ret = "int" }
        else if name == "abs" { ret = "float" }
        else { cerr(line, "float has no method " + name) }
        ctx.exprs[e].mop = "float." + name
    } else if tt == "bool" {
        if name == "to_str" { ret = "str" }
        else { cerr(line, "bool has no method " + name) }
        ctx.exprs[e].mop = "bool." + name
    } else if is_list_t(tt) {
        let mut elem: str = list_elem_t(tt)
        if name == "len" { ret = "int" }
        else if name == "push"  {
        ptypes.push(elem)
        ret = "void"
    }
        else if name == "get"  {
        ptypes.push("int")
        ret = elem
    }
        else if name == "set"  {
        ptypes.push("int")
        ptypes.push(elem)
        ret = "void"
    }
        else if name == "pop" { ret = elem }
        else { cerr(line, "list has no method " + name) }
        ctx.exprs[e].mop = "list." + name
    } else if is_map_t(tt) {
        let vt: str = map_val_t(tt)
        if name == "len" { ret = "int" }
        else if name == "set"  {
        ptypes.push("str")
        ptypes.push(vt)
        ret = "void"
    }
        else if name == "get_or"  {
        ptypes.push("str")
        ptypes.push(vt)
        ret = vt
    }
        else if name == "has"  {
        ptypes.push("str")
        ret = "bool"
    }
        else if name == "keys" { ret = "list[str]" }
        else { cerr(line, "map has no method " + name) }
        ctx.exprs[e].mop = "map." + name
    } else {
        cerr(line, "cannot call method on type " + tt)
    }
    ctx.exprs[e].muser = false
    if nargs != ptypes.len() {
        cerr(line, tt + "." + name + " expects " + ptypes.len().to_str() + " arguments, got " + nargs.to_str())
    }
    let mut i: int = 0
    while i < nargs {
        let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(i), ptypes.get(i))
        if at != ptypes.get(i) {
            cerr(line, "argument of " + tt + "." + name + " expects " + ptypes.get(i) + ", got " + at)
        }
        i = i + 1
    }
    return ret
}

# --- Enum variant literal check (rewrites the node to enumlit) ---

fn check_enum_variant(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str, with_args: bool) -> void {
    let ename: str = ctx.exprs[ctx.exprs[e].left].name
    let vname: str = ctx.exprs[e].name
    let line: int = ctx.exprs[e].line
    if !ctx.enums.has(ename) {
        cerr(line, "enum does not exist: " + ename)
    }
    let en: EnumInfo = ctx.enums.get_or(ename, dummy_enum())
    let mut vidx: int = -1
    let mut i: int = 0
    while i < en.variants.len() {
        if en.variants.get(i) == vname {
            vidx = i
        }
        i = i + 1
    }
    if vidx == -1 {
        cerr(line, "enum " + ename + " has no variant " + vname)
    }
    let payloads: list[str] = en.payloads.get(vidx)
    let mut nargs: int = 0
    if with_args {
        nargs = ctx.exprs[e].args.len()
    }
    if nargs != payloads.len() {
        cerr(line, "variant " + vname + " of enum " + ename + " expects " + payloads.len().to_str() + " payloads, got " + nargs.to_str())
    }
    let typeparams: list[str] = en.typeparams
    let targs: list[str] = []
    let mut ti: int = 0
    while ti < typeparams.len() {
        targs.push("")
        ti = ti + 1
    }
    # First pass: infer from args.
    if typeparams.len() > 0 && with_args {
        let mut ai: int = 0
        while ai < nargs {
            let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai), "")
            if at != "never" {
                unify_into(ctx, payloads.get(ai), at, typeparams, targs)
            }
            ai = ai + 1
        }
    }
    # Second pass: try contextual expected type.
    if typeparams.len() > 0 && expected != "" && type_base(expected) == ename {
        let eargs: list[str] = type_args(expected)
        if eargs.len() == typeparams.len() {
            let mut j: int = 0
            while j < eargs.len() {
                if targs.get(j) == "" {
                    targs.set(j, eargs.get(j))
                }
                j = j + 1
            }
        }
    }
    # If any type param is still unbound, error.
    if typeparams.len() > 0 {
        let mut ti2: int = 0
        while ti2 < typeparams.len() {
            if targs.get(ti2) == "" {
                cerr(line, "cannot infer type argument for " + ename + "; provide a contextual type")
            }
            ti2 = ti2 + 1
        }
    }
    # Type-check payloads against instantiated payload types.
    let inst_payloads: list[str] = []
    let mut pi: int = 0
    while pi < payloads.len() {
        if typeparams.len() > 0 {
            inst_payloads.push(instantiate_type(payloads.get(pi), typeparams, targs))
        } else {
            inst_payloads.push(payloads.get(pi))
        }
        pi = pi + 1
    }
    if with_args {
        let mut ai2: int = 0
        while ai2 < nargs {
            let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai2), inst_payloads.get(ai2))
            if at == "never" {
                ai2 = ai2 + 1
                continue
            }
            if at != inst_payloads.get(ai2) {
                cerr(line, "payload type mismatch: expected " + inst_payloads.get(ai2) + ", got " + at)
            }
            ai2 = ai2 + 1
        }
    }
    # Rewrite the node to enumlit.
    if typeparams.len() > 0 {
        ctx.exprs[e].t = ename + "[" + join(targs, ", ") + "]"
        # Record this enum instantiation for codegen — only if all type args
        # are concrete.
        let inst_t: str = ename + "[" + join(targs, ", ") + "]"
        if type_is_concrete(ctx, inst_t) && !list_has(ctx.enum_insts, inst_t) {
            ctx.enum_insts.push(inst_t)
        }
    } else {
        ctx.exprs[e].t = ename
    }
    ctx.exprs[e].kind = "enumlit"
    ctx.exprs[e].enum_name = ename
    ctx.exprs[e].variant = vname
}

# --- match ---

fn check_match(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let scrut_t: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
    if scrut_t == "never" {
        cerr(ctx.exprs[e].line, "never value cannot be used in match")
    }
    let ename: str = type_base(scrut_t)
    if !ctx.enums.has(ename) {
        cerr(ctx.exprs[e].line, "match scrutinee must be an enum, got " + scrut_t)
    }
    let en: EnumInfo = ctx.enums.get_or(ename, dummy_enum())
    let typeparams: list[str] = en.typeparams
    let targs: list[str] = []
    let mut ti: int = 0
    while ti < typeparams.len() {
        targs.push("")
        ti = ti + 1
    }
    if typeparams.len() > 0 {
        let sargs: list[str] = type_args(scrut_t)
        if sargs.len() == typeparams.len() {
            let mut j: int = 0
            while j < sargs.len() {
                targs.set(j, sargs.get(j))
                j = j + 1
            }
        } else {
            cerr(ctx.exprs[e].line, "invalid enum instantiation: " + scrut_t)
        }
    }
    # Check exhaustiveness and arm types.
    let covered: list[str] = []
    let mut has_wildcard: bool = false
    let arm_types: list[str] = []
    let mut arm_n: int = 0
    while arm_n < ctx.exprs[e].args.len() {
        let arm_idx: int = ctx.exprs[e].args.get(arm_n)
        let arm: MatchArm = ctx.match_arms.get(arm_idx)
        if arm.pat_kind == "wildcard" {
            has_wildcard = true
        } else {
            if arm.enum_name != ename {
                cerr(arm.line, "match arm pattern belongs to enum " + arm.enum_name + ", not " + ename)
            }
            # Find variant index.
            let mut vidx: int = -1
            let mut vi: int = 0
            while vi < en.variants.len() {
                if en.variants.get(vi) == arm.variant {
                    vidx = vi
                }
                vi = vi + 1
            }
            if vidx == -1 {
                cerr(arm.line, "enum " + ename + " has no variant " + arm.variant)
            }
            let payloads: list[str] = en.payloads.get(vidx)
            if arm.has_paren && arm.bindings.len() != payloads.len() {
                cerr(arm.line, "variant " + arm.variant + " has " + payloads.len().to_str() + " payloads, but pattern binds " + arm.bindings.len().to_str())
            }
            if !arm.has_paren && payloads.len() != 0 {
                cerr(arm.line, "variant " + arm.variant + " requires " + payloads.len().to_str() + " payload bindings")
            }
            covered.push(arm.variant)
        }
        # Check arm body in a new scope with the bindings.
        env.push(map_new())
        if arm.pat_kind != "wildcard" {
            # Bind payload values.
            if arm.has_paren {
                let mut vidx2: int = -1
                let mut vi2: int = 0
                while vi2 < en.variants.len() {
                    if en.variants.get(vi2) == arm.variant {
                        vidx2 = vi2
                    }
                    vi2 = vi2 + 1
                }
                let payloads2: list[str] = en.payloads.get(vidx2)
                let mut bi: int = 0
                while bi < payloads2.len() {
                    let pt: str = payloads2.get(bi)
                    let mut inst_pt: str = ""
                    if typeparams.len() > 0 {
                        inst_pt = instantiate_type(pt, typeparams, targs)
                    } else {
                        inst_pt = pt
                    }
                    let bname: str = arm.bindings.get(bi)
                    if bname != "_" {
                        # BUG-SC-2 fix: SPEC.md section 5 states that match-arm
                        # bindings INTRODUCE a new scope and may shadow outer
                        # bindings for the duration of the arm. We now only
                        # reject duplicates WITHIN the same arm (e.g. E.Foo(a, a)),
                        # not shadowing of outer bindings.
                        if env.get(env.len() - 1).has(bname) {
                            cerr(arm.line, "duplicate binding name in match arm: " + bname)
                        }
                        env.get(env.len() - 1).set(bname, Binding { t: inst_pt, is_mut: false, moved: false })
                    }
                    bi = bi + 1
                }
            }
        }
        let body_t: str = check_expr(ctx, env, cur, arm.body, expected)
        let mut arm_m: MatchArm = ctx.match_arms.get(arm_idx)
        arm_m.body_t = body_t
        ctx.match_arms.set(arm_idx, arm_m)
        env.pop()
        if body_t != "never" {
            arm_types.push(body_t)
        }
        arm_n = arm_n + 1
    }
    # Exhaustiveness check.
    if !has_wildcard {
        let mut missing: list[str] = []
        let mut vi3: int = 0
        while vi3 < en.variants.len() {
            let v: str = en.variants.get(vi3)
            let mut found: bool = false
            let mut ci: int = 0
            while ci < covered.len() {
                if covered.get(ci) == v {
                    found = true
                }
                ci = ci + 1
            }
            if !found {
                missing.push(v)
            }
            vi3 = vi3 + 1
        }
        if missing.len() > 0 {
            cerr(ctx.exprs[e].line, "match is not exhaustive; missing: " + join(missing, ", "))
        }
    }
    # All arm types must agree.
    if arm_types.len() == 0 {
        ctx.exprs[e].t = "never"
        return "never"
    }
    let first: str = arm_types.get(0)
    let mut ai: int = 1
    while ai < arm_types.len() {
        if arm_types.get(ai) != first {
            cerr(ctx.exprs[e].line, "match arms have different types: " + first + " and " + arm_types.get(ai))
        }
        ai = ai + 1
    }
    ctx.exprs[e].t = first
    return first
}

# --- `?` operator ---

fn check_qmark(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let inner_t: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
    if inner_t == "never" {
        cerr(ctx.exprs[e].line, "never value cannot be used in expression")
    }
    let ename: str = type_base(inner_t)
    if !ctx.enums.has(ename) {
        cerr(ctx.exprs[e].line, "? operator requires an enum type, got " + inner_t)
    }
    let en: EnumInfo = ctx.enums.get_or(ename, dummy_enum())
    # Find error variant (Err with 1 payload, or None with 0) and ok variant
    # (Ok or Some with 1 payload).
    let mut err_v: str = ""
    let mut ok_v: str = ""
    let mut ok_payload: str = ""
    let mut vi: int = 0
    while vi < en.variants.len() {
        let v: str = en.variants.get(vi)
        let pl: list[str] = en.payloads.get(vi)
        if v == "Err" && pl.len() == 1 {
            err_v = v
        }
        if v == "None" && pl.len() == 0 {
            err_v = v
        }
        if v == "Ok" && pl.len() == 1 {
            ok_v = v
            ok_payload = pl.get(0)
        }
        if v == "Some" && pl.len() == 1 {
            ok_v = v
            ok_payload = pl.get(0)
        }
        vi = vi + 1
    }
    if err_v == "" {
        cerr(ctx.exprs[e].line, "? operator requires enum " + ename + " to have an 'Err' (1 payload) or 'None' variant")
    }
    if ok_v == "" {
        cerr(ctx.exprs[e].line, "? operator requires enum " + ename + " to have an 'Ok' or 'Some' variant (1 payload)")
    }
    # Compute the success value type (instantiated).
    let mut success_t: str = ""
    let mut err_payload_t: str = ""
    if en.typeparams.len() > 0 {
        let sargs: list[str] = type_args(inner_t)
        success_t = instantiate_type(ok_payload, en.typeparams, sargs)
        # BUG-3 fix: compute the error payload type too, so we can verify
        # it matches the enclosing function's error type argument.
        if err_v == "Err" {
            # Find the Err variant's payload type from the enum definition.
            let mut ei: int = 0
            while ei < en.variants.len() {
                if en.variants.get(ei) == "Err" {
                    err_payload_t = instantiate_type(en.payloads.get(ei).get(0), en.typeparams, sargs)
                }
                ei = ei + 1
            }
        }
    } else {
        success_t = ok_payload
        if err_v == "Err" {
            let mut ei: int = 0
            while ei < en.variants.len() {
                if en.variants.get(ei) == "Err" {
                    err_payload_t = en.payloads.get(ei).get(0)
                }
                ei = ei + 1
            }
        }
    }
    # Check that the enclosing function returns an enum of the same base.
    let cur_ret: str = ctx.cur_fn_ret
    if cur_ret == "void" {
        cerr(ctx.exprs[e].line, "? operator cannot be used in a void function")
    }
    let cur_ret_base: str = type_base(cur_ret)
    if cur_ret_base != ename {
        cerr(ctx.exprs[e].line, "? operator: enclosing function returns " + cur_ret + ", cannot propagate " + ename)
    }
    # BUG-3 fix: verify the error payload type matches the enclosing
    # function's error type argument.
    if err_payload_t != "" {
        let cur_ret_args: list[str] = type_args(cur_ret)
        if cur_ret_args.len() > 0 {
            let fn_err_t: str = cur_ret_args.get(cur_ret_args.len() - 1)
            if err_payload_t != fn_err_t {
                cerr(ctx.exprs[e].line, "? operator: error payload type " + err_payload_t + " does not match enclosing function's error type " + fn_err_t + " (in return type " + cur_ret + ")")
            }
        }
    }
    ctx.exprs[e].t = success_t
    ctx.exprs[e].err_variant = err_v
    ctx.exprs[e].ok_variant = ok_v
    return success_t
}

fn check_effects(ctx: Ctx) -> void {
    # Stage 9-alpha: fine-grained effects & capabilities.
    # eff[key] = computed list of effects the body of `key` requires.
    # A function passes iff its declared effects (f.effects) is a superset
    # of the computed effects.
    let eff: map[str, list[str]] = map_new()
    let mut i0: int = 0
    while i0 < ctx.fn_order.len() {
        let key0: str = ctx.fn_order.get(i0)
        eff.set(key0, [])
        i0 = i0 + 1
    }

    # Monotone fixpoint: union in each callee's computed effect set.
    let mut changed: bool = true
    while changed {
        changed = false
        let mut i: int = 0
        while i < ctx.fn_order.len() {
            let key: str = ctx.fn_order.get(i)
            let edges: list[str] = ctx.edges.get_or(key, [])
            let mut j: int = 0
            while j < edges.len() {
                let c: str = edges.get(j)
                let mut new_eff: list[str] = []
                if c.starts_with("b:") {
                    new_eff = builtin_effect(c.slice(2, c.len()))
                } else {
                    new_eff = eff.get_or(c, [])
                }
                let mut k: int = 0
                while k < new_eff.len() {
                    if effects_add(eff, key, new_eff.get(k)) {
                        changed = true
                    }
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
    }

    # Stage 9-beta: publish the computed effect set per function so an
    # external auditor (hlc --audit) can print the capability tree.
    let mut ic: int = 0
    while ic < ctx.fn_order.len() {
        let keyc: str = ctx.fn_order.get(ic)
        ctx.computed_effects.set(keyc, eff.get_or(keyc, []))
        ic = ic + 1
    }

    # Capability check: declared ⊇ computed.
    # Stage 9-beta: also enforce that a function declared `pure` transitively
    # calls nothing effectful (its computed effect set must be empty).
    let mut i2: int = 0
    while i2 < ctx.fn_order.len() {
        let key2: str = ctx.fn_order.get(i2)
        let f: FnInfo = ctx.fns.get_or(key2, dummy_fn())
        let computed: list[str] = eff.get_or(key2, [])
        # Stage 9-beta: `pure` enforcement — a `pure` function must have an
        # empty computed effect set (no transitive effectful callees).
        if f.is_pure && computed.len() > 0 {
            # Find the first edge that contributes any effect.
            let edges: list[str] = ctx.edges.get_or(key2, [])
            let mut j2: int = 0
            let mut found: bool = false
            while j2 < edges.len() && !found {
                let c: str = edges.get(j2)
                let mut c_eff: list[str] = []
                if c.starts_with("b:") {
                    c_eff = builtin_effect(c.slice(2, c.len()))
                } else {
                    c_eff = eff.get_or(c, [])
                }
                if c_eff.len() > 0 {
                    let mut nm: str = c
                    if c.starts_with("b:") {
                        nm = c.slice(2, c.len())
                    }
                    cerr(f.line,
                        "function '" + f.name + "' is declared 'pure' but calls '" +
                        nm + "' which requires effect '" + c_eff.get(0) +
                        "' (declared pure but callee chain is not pure)")
                    found = true
                }
                j2 = j2 + 1
            }
            if !found {
                cerr(f.line,
                    "function '" + f.name + "' is declared 'pure' but transitively " +
                    "uses effects " + fmt_effects(computed) +
                    " (declared pure but callee chain is not pure)")
            }
        }
        # Walk each effect in `computed`; if any is missing from f.effects,
        # find a witness edge and report.
        let mut ci: int = 0
        let mut found_violation: bool = false
        while ci < computed.len() && !found_violation {
            let ce: str = computed.get(ci)
            if !list_has(f.effects, ce) {
                # Find the first edge that contributes this effect.
                let edges: list[str] = ctx.edges.get_or(key2, [])
                let mut j2: int = 0
                while j2 < edges.len() && !found_violation {
                    let c: str = edges.get(j2)
                    let mut c_eff: list[str] = []
                    if c.starts_with("b:") {
                        c_eff = builtin_effect(c.slice(2, c.len()))
                    } else {
                        c_eff = eff.get_or(c, [])
                    }
                    if list_has(c_eff, ce) {
                        let mut nm: str = c
                        if c.starts_with("b:") {
                            nm = c.slice(2, c.len())
                        }
                        cerr(f.line,
                            "function '" + f.name + "' calls '" + nm +
                            "' which requires effect '" + ce +
                            "' not declared (declared: " + fmt_effects(f.effects) +
                            "; missing: " + ce + ")")
                        found_violation = true
                    }
                    j2 = j2 + 1
                }
            }
            ci = ci + 1
        }
        i2 = i2 + 1
    }
}

# ------------------------------------------------------------------------
# 4b. C RUNTIME (embedded directly — generated from the tested runtime)
# ------------------------------------------------------------------------

fn runtime_lines() -> list[str] {
    let r: list[str] = []
    r.push("#include <stdio.h>")
    r.push("#include <stdlib.h>")
    r.push("#include <string.h>")
    r.push("#include <stdint.h>")
    r.push("#include <stdbool.h>")
    r.push("#include <inttypes.h>")
    r.push("#include <time.h>")
    r.push("#include <math.h>")
    r.push("#include <sys/stat.h>")
    r.push("")
    # ---- Stage 8-beta: the refcounted runtime (END OF ARENA) ----
    # Every heap object starts with an int64_t refcnt as its FIRST field so
    # hl_retain works uniformly on all object types. Releases are
    # type-specific (they must release children). elem_free / val_free ==
    # NULL means "arena mode": the container never releases its items (used
    # by the LLVM backend, which is still arena-based).
    r.push("typedef struct { int64_t refcnt; int64_t len; char* data; } hl_str;")
    r.push("typedef struct { int64_t refcnt; int64_t len; int64_t cap; void** items; void (*elem_free)(void*); } hl_list;")
    r.push("typedef struct { int64_t refcnt; int64_t len; int64_t cap; hl_str** slots; void** vals; hl_str** order; void (*val_free)(void*); } hl_map;")
    r.push("")
    r.push("// Checked byte string — used by the HLS runtime")
    r.push("static void hl_die(const char* msg) {")
    r.push("    fflush(stdout);")
    r.push("    fprintf(stderr, \"panic: %s\\n\", msg);")
    r.push("    exit(101);")
    r.push("}")
    r.push("")
    r.push("// ---- Stage 8-beta: reference-counting core ----")
    r.push("// refcnt is the first field of every heap object, so retain is")
    r.push("// generic; release is type-specific (it must release children).")
    r.push("static void* hl_retain(void* p) {")
    r.push("    if (p) ((int64_t*)p)[0] += 1;")
    r.push("    return p;")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_str_alloc(int64_t len) {")
    r.push("    hl_str* s = (hl_str*)malloc(sizeof(hl_str));")
    r.push("    if (!s) hl_die(\"out of memory\");")
    r.push("    s->refcnt = 1;")
    r.push("    s->len = len;")
    r.push("    s->data = (char*)malloc((size_t)len + 1);")
    r.push("    if (!s->data) hl_die(\"out of memory\");")
    r.push("    s->data[len] = 0;")
    r.push("    return s;")
    r.push("}")
    r.push("")
    r.push("static void hl_str_release(void* pv) {")
    r.push("    hl_str* s = (hl_str*)pv;")
    r.push("    if (!s) return;")
    r.push("    if (--s->refcnt == 0) { free(s->data); free(s); }")
    r.push("}")
    r.push("static void hl_cleanup_str(hl_str** p) { hl_str_release(*p); }")
    r.push("")
    r.push("static hl_str* hl_str_from(const char* c, int64_t len) {")
    r.push("    hl_str* s = hl_str_alloc(len);")
    r.push("    if (len > 0) memcpy(s->data, c, (size_t)len);")
    r.push("    return s;")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_str_concat(hl_str* a, hl_str* b) {")
    r.push("    hl_str* s = hl_str_alloc(a->len + b->len);")
    r.push("    if (a->len > 0) memcpy(s->data, a->data, (size_t)a->len);")
    r.push("    if (b->len > 0) memcpy(s->data + a->len, b->data, (size_t)b->len);")
    r.push("    return s;")
    r.push("}")
    r.push("")
    r.push("static bool hl_str_eq(hl_str* a, hl_str* b) {")
    r.push("    return a->len == b->len && (a->len == 0 || memcmp(a->data, b->data, (size_t)a->len) == 0);")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_str_cmp(hl_str* a, hl_str* b) {")
    r.push("    int64_t n = a->len < b->len ? a->len : b->len;")
    r.push("    if (n > 0) {")
    r.push("        int r = memcmp(a->data, b->data, (size_t)n);")
    r.push("        if (r != 0) return r < 0 ? -1 : 1;")
    r.push("    }")
    r.push("    if (a->len == b->len) return 0;")
    r.push("    return a->len < b->len ? -1 : 1;")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_str_len(hl_str* s) { return s->len; }")
    r.push("")
    r.push("static int64_t hl_str_byte_at(hl_str* s, int64_t i) {")
    r.push("    if (i < 0 || i >= s->len) hl_die(\"string access out of bounds\");")
    r.push("    return (unsigned char)s->data[i];")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_str_slice(hl_str* s, int64_t a, int64_t b) {")
    r.push("    if (a < 0 || b < a || b > s->len) hl_die(\"invalid string slice\");")
    r.push("    return hl_str_from(s->data + a, b - a);")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_str_find(hl_str* s, hl_str* sub) {")
    r.push("    if (sub->len == 0) return 0;")
    r.push("    if (sub->len > s->len) return -1;")
    r.push("    for (int64_t i = 0; i + sub->len <= s->len; i++) {")
    r.push("        if (memcmp(s->data + i, sub->data, (size_t)sub->len) == 0) return i;")
    r.push("    }")
    r.push("    return -1;")
    r.push("}")
    r.push("")
    r.push("static bool hl_str_contains(hl_str* s, hl_str* sub) { return hl_str_find(s, sub) >= 0; }")
    r.push("")
    r.push("static bool hl_str_starts_with(hl_str* s, hl_str* p) {")
    r.push("    return s->len >= p->len && (p->len == 0 || memcmp(s->data, p->data, (size_t)p->len) == 0);")
    r.push("}")
    r.push("")
    r.push("static bool hl_str_ends_with(hl_str* s, hl_str* p) {")
    r.push("    return s->len >= p->len && (p->len == 0 || memcmp(s->data + s->len - p->len, p->data, (size_t)p->len) == 0);")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_str_trim(hl_str* s) {")
    r.push("    int64_t a = 0, b = s->len;")
    r.push("    while (a < b && (unsigned char)s->data[a] <= 0x20) a++;")
    r.push("    while (b > a && (unsigned char)s->data[b - 1] <= 0x20) b--;")
    r.push("    return hl_str_from(s->data + a, b - a);")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_str_to_int(hl_str* s) {")
    r.push("    int64_t i = 0;")
    r.push("    uint64_t uv = 0;")
    r.push("    bool neg = false;")
    r.push("    if (s->len == 0) hl_die(\"cannot convert string to int\");")
    r.push("    if (s->data[0] == '-') { neg = true; i = 1; }")
    r.push("    if (i >= s->len) hl_die(\"cannot convert string to int\");")
    r.push("    for (; i < s->len; i++) {")
    r.push("        char c = s->data[i];")
    r.push("        if (c < '0' || c > '9') hl_die(\"cannot convert string to int\");")
    r.push("        if (uv > (UINT64_C(9223372036854775808) - (uint64_t)(c - '0')) / 10) {")
    r.push("            hl_die(\"integer too large when converting string\");")
    r.push("        }")
    r.push("        uv = uv * 10 + (uint64_t)(c - '0');")
    r.push("    }")
    r.push("    if (neg) {")
    r.push("        if (uv > UINT64_C(9223372036854775808)) hl_die(\"integer too large when converting string\");")
    r.push("        return (int64_t)(-(int64_t)(uv - 1) - 1);")
    r.push("    }")
    r.push("    if (uv > (uint64_t)INT64_MAX) hl_die(\"integer too large when converting string\");")
    r.push("    return (int64_t)uv;")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_str_from_int64(int64_t v) {")
    r.push("    char buf[32];")
    r.push("    int n = snprintf(buf, sizeof buf, \"%\" PRId64, v);")
    r.push("    return hl_str_from(buf, (int64_t)n);")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_str_from_double(double v) {")
    r.push("    char buf[64];")
    r.push("    int n = snprintf(buf, sizeof buf, \"%.6f\", v);")
    r.push("    return hl_str_from(buf, (int64_t)n);")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_cstr(const char* c) { return hl_str_from(c, (int64_t)strlen(c)); }")
    r.push("static hl_str* hl_str_from_bool(bool v) {")
    r.push("    return v ? hl_str_from(\"true\", 4) : hl_str_from(\"false\", 5);")
    r.push("}")
    r.push("")
    r.push("// Dynamic list (boxed values), insertion-ordered map[str,T] hash table,")
    r.push("// checked int64 arithmetic, and I/O")
    r.push("static void* hl_box_i64(int64_t v) {")
    r.push("    int64_t* p = (int64_t*)malloc(sizeof(int64_t));")
    r.push("    if (!p) hl_die(\"out of memory\");")
    r.push("    *p = v;")
    r.push("    return p;")
    r.push("}")
    r.push("static int64_t hl_unbox_i64(void* p) { return *(int64_t*)p; }")
    r.push("")
    r.push("static void* hl_box_f64(double v) {")
    r.push("    double* p = (double*)malloc(sizeof(double));")
    r.push("    if (!p) hl_die(\"out of memory\");")
    r.push("    *p = v;")
    r.push("    return p;")
    r.push("}")
    r.push("static double hl_unbox_f64(void* p) { return *(double*)p; }")
    r.push("")
    r.push("static void* hl_box_bool(bool v) {")
    r.push("    bool* p = (bool*)malloc(sizeof(bool));")
    r.push("    if (!p) hl_die(\"out of memory\");")
    r.push("    *p = v;")
    r.push("    return p;")
    r.push("}")
    r.push("static bool hl_unbox_bool(void* p) { return *(bool*)p; }")
    r.push("")
    r.push("static void* hl_box_ptr(void* p) { return p; }")
    r.push("static void* hl_unbox_ptr(void* p) { return p; }")
    r.push("")
    r.push("// hl_list_new: elem_free describes how to release one element.")
    r.push("// free       -> primitive boxes;  hl_str_release -> str;")
    r.push("// hl_list_release / hl_map_release / hl_release_<T> -> containers/user types.")
    r.push("// NULL = arena mode (never release elements — LLVM backend).")
    r.push("static hl_list* hl_list_new(void (*elem_free)(void*)) {")
    r.push("    hl_list* l = (hl_list*)malloc(sizeof(hl_list));")
    r.push("    if (!l) hl_die(\"out of memory\");")
    r.push("    l->refcnt = 1;")
    r.push("    l->len = 0;")
    r.push("    l->cap = 8;")
    r.push("    l->elem_free = elem_free;")
    r.push("    l->items = (void**)malloc((size_t)l->cap * sizeof(void*));")
    r.push("    if (!l->items) hl_die(\"out of memory\");")
    r.push("    return l;")
    r.push("}")
    r.push("")
    r.push("static void hl_list_release(void* pl) {")
    r.push("    hl_list* l = (hl_list*)pl;")
    r.push("    if (!l) return;")
    r.push("    if (--l->refcnt == 0) {")
    r.push("        if (l->elem_free) {")
    r.push("            for (int64_t i = 0; i < l->len; i++) l->elem_free(l->items[i]);")
    r.push("        }")
    r.push("        free(l->items);")
    r.push("        free(l);")
    r.push("    }")
    r.push("}")
    r.push("static void hl_cleanup_list(hl_list** p) { hl_list_release(*p); }")
    r.push("")
    r.push("static void hl_list_push(hl_list* l, void* v) {")
    r.push("    if (l->len == l->cap) {")
    r.push("        l->cap *= 2;")
    r.push("        l->items = (void**)realloc(l->items, (size_t)l->cap * sizeof(void*));")
    r.push("        if (!l->items) hl_die(\"out of memory\");")
    r.push("    }")
    r.push("    l->items[l->len] = v;")
    r.push("    l->len++;")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_list_len(hl_list* l) { return l->len; }")
    r.push("")
    r.push("static void* hl_list_get(hl_list* l, int64_t i) {")
    r.push("    if (i < 0 || i >= l->len) hl_die(\"array access out of bounds\");")
    r.push("    return l->items[i];")
    r.push("}")
    r.push("")
    r.push("// hl_list_set: v arrives OWNED (the caller transferred one retain).")
    r.push("// Store first, then release the old item so self-assignment is safe.")
    r.push("static void hl_list_set(hl_list* l, int64_t i, void* v) {")
    r.push("    if (i < 0 || i >= l->len) hl_die(\"array access out of bounds\");")
    r.push("    void* old = l->items[i];")
    r.push("    l->items[i] = v;")
    r.push("    if (l->elem_free) l->elem_free(old);")
    r.push("}")
    r.push("")
    r.push("static hl_list* hl_range(int64_t a, int64_t b) {")
    r.push("    hl_list* l = hl_list_new(free);")
    r.push("    for (int64_t i = a; i < b; i++) hl_list_push(l, hl_box_i64(i));")
    r.push("    return l;")
    r.push("}")
    r.push("")
    r.push("// ---- map[str, T]: linear-probing hash table + insertion-order array ----")
    r.push("static uint64_t hl_str_hash(hl_str* s) {")
    r.push("    uint64_t h = 1469598103934665603ULL;")
    r.push("    for (int64_t i = 0; i < s->len; i++) {")
    r.push("        h ^= (uint8_t)s->data[i];")
    r.push("        h *= 1099511628211ULL;")
    r.push("    }")
    r.push("    return h;")
    r.push("}")
    r.push("")
    r.push("// hl_map_new: val_free describes how to release one value. The map")
    r.push("// owns one retain per key and one retain (or box) per value.")
    r.push("static hl_map* hl_map_new(void (*val_free)(void*)) {")
    r.push("    hl_map* m = (hl_map*)malloc(sizeof(hl_map));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->refcnt = 1;")
    r.push("    m->len = 0;")
    r.push("    m->cap = 16;")
    r.push("    m->slots = (hl_str**)calloc((size_t)m->cap, sizeof(hl_str*));")
    r.push("    m->vals = (void**)malloc((size_t)m->cap * sizeof(void*));")
    r.push("    m->order = (hl_str**)malloc((size_t)m->cap * sizeof(hl_str*));")
    r.push("    m->val_free = val_free;")
    r.push("    if (!m->slots || !m->vals || !m->order) hl_die(\"out of memory\");")
    r.push("    return m;")
    r.push("}")
    r.push("")
    r.push("static void hl_map_release(void* pm) {")
    r.push("    hl_map* m = (hl_map*)pm;")
    r.push("    if (!m) return;")
    r.push("    if (--m->refcnt == 0) {")
    r.push("        for (int64_t i = 0; i < m->cap; i++) {")
    r.push("            if (m->slots[i] != NULL) {")
    r.push("                if (m->val_free) m->val_free(m->vals[i]);")
    r.push("                hl_str_release(m->slots[i]);")
    r.push("            }")
    r.push("        }")
    r.push("        free(m->slots);")
    r.push("        free(m->vals);")
    r.push("        free(m->order);")
    r.push("        free(m);")
    r.push("    }")
    r.push("}")
    r.push("static void hl_cleanup_map(hl_map** p) { hl_map_release(*p); }")
    r.push("")
    r.push("static void hl_map_grow(hl_map* m, int64_t ncap) {")
    r.push("    hl_str** nslots = (hl_str**)calloc((size_t)ncap, sizeof(hl_str*));")
    r.push("    void** nvals = (void**)malloc((size_t)ncap * sizeof(void*));")
    r.push("    hl_str** norder = (hl_str**)malloc((size_t)ncap * sizeof(hl_str*));")
    r.push("    if (!nslots || !nvals || !norder) hl_die(\"out of memory\");")
    r.push("    for (int64_t i = 0; i < m->cap; i++) {")
    r.push("        if (m->slots[i] != NULL) {")
    r.push("            uint64_t idx = hl_str_hash(m->slots[i]) & (uint64_t)(ncap - 1);")
    r.push("            while (nslots[idx] != NULL) idx = (idx + 1) & (uint64_t)(ncap - 1);")
    r.push("            nslots[idx] = m->slots[i];")
    r.push("            nvals[idx] = m->vals[i];")
    r.push("        }")
    r.push("    }")
    r.push("    for (int64_t j = 0; j < m->len; j++) norder[j] = m->order[j];")
    r.push("    free(m->slots);")
    r.push("    free(m->vals);")
    r.push("    free(m->order);")
    r.push("    m->slots = nslots;")
    r.push("    m->vals = nvals;")
    r.push("    m->order = norder;")
    r.push("    m->cap = ncap;")
    r.push("}")
    r.push("")
    r.push("// hl_map_set: k and v arrive OWNED (the caller transferred one retain")
    r.push("// of each). On overwrite the incoming key is released and the old")
    r.push("// value is released. Store-then-release keeps self-assignment safe.")
    r.push("static void hl_map_set(hl_map* m, hl_str* k, void* v) {")
    r.push("    if ((m->len + 1) * 10 >= m->cap * 7) {")
    r.push("        hl_map_grow(m, m->cap * 2);")
    r.push("    }")
    r.push("    uint64_t idx = hl_str_hash(k) & (uint64_t)(m->cap - 1);")
    r.push("    while (m->slots[idx] != NULL) {")
    r.push("        if (hl_str_eq(m->slots[idx], k)) {")
    r.push("            void* oldv = m->vals[idx];")
    r.push("            m->vals[idx] = v;")
    r.push("            if (m->val_free) m->val_free(oldv);")
    r.push("            hl_str_release(k);")
    r.push("            return;")
    r.push("        }")
    r.push("        idx = (idx + 1) & (uint64_t)(m->cap - 1);")
    r.push("    }")
    r.push("    m->slots[idx] = k;")
    r.push("    m->vals[idx] = v;")
    r.push("    m->order[m->len] = k;")
    r.push("    m->len++;")
    r.push("}")
    r.push("")
    r.push("// hl_map_borrow: raw lookup — returns the stored slot value (a box for")
    r.push("// primitive-valued maps, the value itself for pointer-valued maps) or")
    r.push("// NULL when the key is missing. The map keeps ownership.")
    r.push("static void* hl_map_borrow(hl_map* m, hl_str* k) {")
    r.push("    uint64_t idx = hl_str_hash(k) & (uint64_t)(m->cap - 1);")
    r.push("    while (m->slots[idx] != NULL) {")
    r.push("        if (hl_str_eq(m->slots[idx], k)) return m->vals[idx];")
    r.push("        idx = (idx + 1) & (uint64_t)(m->cap - 1);")
    r.push("    }")
    r.push("    return NULL;")
    r.push("}")
    r.push("")
    r.push("// Typed getters for primitive-valued maps: the default arrives by")
    r.push("// value — no boxing, no allocation, no refcount traffic.")
    r.push("static int64_t hl_map_get_i64(hl_map* m, hl_str* k, int64_t dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v == NULL) return dflt;")
    r.push("    return hl_unbox_i64(v);")
    r.push("}")
    r.push("static double hl_map_get_f64(hl_map* m, hl_str* k, double dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v == NULL) return dflt;")
    r.push("    return hl_unbox_f64(v);")
    r.push("}")
    r.push("static bool hl_map_get_bool(hl_map* m, hl_str* k, bool dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v == NULL) return dflt;")
    r.push("    return hl_unbox_bool(v);")
    r.push("}")
    r.push("")
    r.push("// hl_map_get_own: for pointer-valued maps. dflt arrives OWNED (+1)")
    r.push("// and the result is returned OWNED (+1).")
    r.push("static void* hl_map_get_own(hl_map* m, hl_str* k, void* dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v != NULL) {")
    r.push("        hl_retain(v);")
    r.push("        if (m->val_free) m->val_free(dflt);")
    r.push("        return v;")
    r.push("    }")
    r.push("    return dflt;")
    r.push("}")
    r.push("")
    r.push("static bool hl_map_has(hl_map* m, hl_str* k) { return hl_map_borrow(m, k) != NULL; }")
    r.push("")
    r.push("static int64_t hl_map_len(hl_map* m) { return m->len; }")
    r.push("")
    r.push("// hl_map_keys: fresh list[str]; each key is retained for the new list.")
    r.push("static hl_list* hl_map_keys(hl_map* m) {")
    r.push("    hl_list* r = hl_list_new(hl_str_release);")
    r.push("    for (int64_t i = 0; i < m->len; i++) hl_list_push(r, hl_retain(m->order[i]));")
    r.push("    return r;")
    r.push("}")
    r.push("")
    r.push("// ---- checked int64 arithmetic ----")
    r.push("static int64_t hl_add_i64(int64_t a, int64_t b) {")
    r.push("    int64_t r;")
    r.push("    if (__builtin_add_overflow(a, b, &r)) hl_die(\"integer overflow\");")
    r.push("    return r;")
    r.push("}")
    r.push("static int64_t hl_sub_i64(int64_t a, int64_t b) {")
    r.push("    int64_t r;")
    r.push("    if (__builtin_sub_overflow(a, b, &r)) hl_die(\"integer overflow\");")
    r.push("    return r;")
    r.push("}")
    r.push("static int64_t hl_mul_i64(int64_t a, int64_t b) {")
    r.push("    int64_t r;")
    r.push("    if (__builtin_mul_overflow(a, b, &r)) hl_die(\"integer overflow\");")
    r.push("    return r;")
    r.push("}")
    r.push("static int64_t hl_neg_i64(int64_t a) {")
    r.push("    if (a == INT64_MIN) hl_die(\"integer overflow\");")
    r.push("    return -a;")
    r.push("}")
    r.push("static int64_t hl_abs_i64(int64_t a) {")
    r.push("    if (a == INT64_MIN) hl_die(\"integer overflow\");")
    r.push("    return a < 0 ? -a : a;")
    r.push("}")
    r.push("static int64_t hl_div_i64(int64_t a, int64_t b) {")
    r.push("    if (b == 0) hl_die(\"division by zero\");")
    r.push("    if (a == INT64_MIN && b == -1) hl_die(\"integer overflow\");")
    r.push("    return a / b;")
    r.push("}")
    r.push("static int64_t hl_mod_i64(int64_t a, int64_t b) {")
    r.push("    if (b == 0) hl_die(\"division by zero\");")
    r.push("    if (a == INT64_MIN && b == -1) hl_die(\"integer overflow\");")
    r.push("    return a % b;")
    r.push("}")
    r.push("")
    r.push("// ---- I/O (print-family builtins CONSUME their str argument) ----")
    r.push("static hl_list* g_hl_args = NULL;")
    r.push("")
    r.push("static void hl_init_args(int argc, char** argv) {")
    r.push("    g_hl_args = hl_list_new(hl_str_release);")
    r.push("    for (int i = 0; i < argc; i++) {")
    r.push("        hl_list_push(g_hl_args, hl_str_from(argv[i], (int64_t)strlen(argv[i])));")
    r.push("    }")
    r.push("}")
    r.push("")
    r.push("static hl_list* hl_args(void) { return g_hl_args; }")
    r.push("")
    r.push("static void hl_print(hl_str* s) {")
    r.push("    fwrite(s->data, 1, (size_t)s->len, stdout);")
    r.push("    hl_str_release(s);")
    r.push("}")
    r.push("")
    r.push("static void hl_println(hl_str* s) {")
    r.push("    fwrite(s->data, 1, (size_t)s->len, stdout);")
    r.push("    fputc('\\n', stdout);")
    r.push("    hl_str_release(s);")
    r.push("}")
    r.push("")
    r.push("// hl_read_file: consumes the path, returns a fresh str. The temporary")
    r.push("// read buffer is freed before returning (it used to leak under the")
    r.push("// arena model).")
    r.push("static hl_str* hl_read_file(hl_str* path) {")
    r.push("    FILE* f = fopen(path->data, \"rb\");")
    r.push("    if (!f) hl_die(\"cannot open file\");")
    r.push("    // Virtual files (/proc, /sys) report size 0 via fseek/ftell,")
    r.push("    // so read incrementally until EOF instead of trusting the")
    r.push("    // size (BUG: the interpreter read them fine while the native")
    r.push("    // binary got empty output — a differential divergence).")
    r.push("    size_t cap = 4096, len = 0;")
    r.push("    char* buf = (char*)malloc(cap);")
    r.push("    if (!buf) hl_die(\"out of memory\");")
    r.push("    for (;;) {")
    r.push("        if (len == cap) {")
    r.push("            cap *= 2;")
    r.push("            buf = (char*)realloc(buf, cap);")
    r.push("            if (!buf) hl_die(\"out of memory\");")
    r.push("        }")
    r.push("        size_t n = fread(buf + len, 1, cap - len, f);")
    r.push("        len += n;")
    r.push("        if (n == 0) break;")
    r.push("    }")
    r.push("    fclose(f);")
    r.push("    hl_str* out = hl_str_from(buf, (int64_t)len);")
    r.push("    free(buf);")
    r.push("    hl_str_release(path);")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// hl_write_file: consumes the path and the content.")
    r.push("static void hl_write_file(hl_str* path, hl_str* content) {")
    r.push("    FILE* f = fopen(path->data, \"wb\");")
    r.push("    if (!f) hl_die(\"cannot write file\");")
    r.push("    if (content->len > 0 && fwrite(content->data, 1, (size_t)content->len, f) != (size_t)content->len) {")
    r.push("        hl_die(\"cannot write file\");")
    r.push("    }")
    r.push("    if (fclose(f) != 0) hl_die(\"cannot write file\");")
    r.push("    hl_str_release(content);")
    r.push("    hl_str_release(path);")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_clock_ms(void) {")
    r.push("    struct timespec ts;")
    r.push("    clock_gettime(CLOCK_MONOTONIC, &ts);")
    r.push("    return (int64_t)ts.tv_sec * 1000 + (int64_t)ts.tv_nsec / 1000000;")
    r.push("}")
    r.push("")
    r.push("static void hl_panic(hl_str* msg) {")
    r.push("    fflush(stdout);")
    r.push("    fprintf(stderr, \"panic: %s\\n\", msg->data);")
    r.push("    exit(101);")
    r.push("}")
    r.push("")
    r.push("static void hl_exit(int64_t code) {")
    r.push("    fflush(stdout);")
    r.push("    exit((int)code);")
    r.push("}")
    r.push("")
    r.push("// String split helper (placed last because it depends on hl_list)")
    r.push("static hl_list* hl_str_split(hl_str* s, hl_str* sep) {")
    r.push("    if (sep->len == 0) hl_die(\"empty separator not allowed\");")
    r.push("    hl_list* out = hl_list_new(hl_str_release);")
    r.push("    if (s->len == 0) {")
    r.push("        hl_list_push(out, hl_str_from(\"\", 0));")
    r.push("        return out;")
    r.push("    }")
    r.push("    int64_t start = 0;")
    r.push("    int64_t i = 0;")
    r.push("    while (i + sep->len <= s->len) {")
    r.push("        if (memcmp(s->data + i, sep->data, (size_t)sep->len) == 0) {")
    r.push("            hl_list_push(out, hl_str_from(s->data + start, i - start));")
    r.push("            i += sep->len;")
    r.push("            start = i;")
    r.push("        } else {")
    r.push("            i++;")
    r.push("        }")
    r.push("    }")
    r.push("    hl_list_push(out, hl_str_from(s->data + start, s->len - start));")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// ---- v0.2 additions: pop, float, chr, fmod ----")
    r.push("// hl_list_pop: ownership of the removed item transfers to the caller.")
    r.push("static void* hl_list_pop(hl_list* l) {")
    r.push("    if (l->len == 0) hl_die(\"array access out of bounds\");")
    r.push("    l->len--;")
    r.push("    return l->items[l->len];")
    r.push("}")
    r.push("")
    r.push("// Typed pops for primitive element lists: pop the box, unbox the")
    r.push("// value, free the box. (A plain pop + unbox would leak the box —")
    r.push("// the caller only wanted the primitive.)")
    r.push("static int64_t hl_list_pop_i64(hl_list* l) {")
    r.push("    void* b = hl_list_pop(l);")
    r.push("    int64_t v = hl_unbox_i64(b);")
    r.push("    free(b);")
    r.push("    return v;")
    r.push("}")
    r.push("static double hl_list_pop_f64(hl_list* l) {")
    r.push("    void* b = hl_list_pop(l);")
    r.push("    double v = hl_unbox_f64(b);")
    r.push("    free(b);")
    r.push("    return v;")
    r.push("}")
    r.push("static bool hl_list_pop_bool(hl_list* l) {")
    r.push("    void* b = hl_list_pop(l);")
    r.push("    bool v = hl_unbox_bool(b);")
    r.push("    free(b);")
    r.push("    return v;")
    r.push("}")
    r.push("")
    r.push("static double hl_str_to_double(hl_str* s) {")
    r.push("    int64_t i = 0;")
    r.push("    int64_t dots = 0;")
    r.push("    int64_t digits = 0;")
    r.push("    int saw_exp = 0;")
    r.push("    int exp_digits = 0;")
    r.push("    if (s->len == 0) hl_die(\"cannot convert string to float\");")
    r.push("    if (s->data[0] == '-') i = 1;")
    r.push("    if (i >= s->len) hl_die(\"cannot convert string to float\");")
    r.push("    for (; i < s->len; i++) {")
    r.push("        char c = s->data[i];")
    r.push("        if (c == '.') { if (saw_exp) hl_die(\"cannot convert string to float\"); dots++; continue; }")
    r.push("        if (c == 'e' || c == 'E') {")
    r.push("            if (saw_exp || digits == 0) hl_die(\"cannot convert string to float\");")
    r.push("            saw_exp = 1;")
    r.push("            if (i + 1 < s->len && (s->data[i+1] == '+' || s->data[i+1] == '-')) i++;")
    r.push("            exp_digits = 0;")
    r.push("            continue;")
    r.push("        }")
    r.push("        if (c < '0' || c > '9') hl_die(\"cannot convert string to float\");")
    r.push("        if (saw_exp) exp_digits++;")
    r.push("        digits++;")
    r.push("    }")
    r.push("    if (dots > 1 || digits == 0) hl_die(\"cannot convert string to float\");")
    r.push("    if (saw_exp && exp_digits == 0) hl_die(\"cannot convert string to float\");")
    r.push("    return strtod(s->data, NULL);")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_chr(int64_t c) {")
    r.push("    if (c < 0 || c > 255) hl_die(\"chr out of range 0..255\");")
    r.push("    char b = (char)c;")
    r.push("    return hl_str_from(&b, 1);")
    r.push("}")
    r.push("")
    r.push("static double hl_fmod(double a, double b) {")
    r.push("    return fmod(a, b);")
    r.push("}")
    r.push("")
    r.push("// BUG-15 fix: range-checked float -> int64 conversion. C casts")
    r.push("// silently truncate out-of-range floats; we panic instead so the")
    r.push("// error points to the actual source of the bad value.")
    r.push("static int64_t hl_float_to_int(double v) {")
    r.push("    if (v < -9.2233720368547758e18 || v > 9.2233720368547757e18)")
    r.push("        hl_die(\"float.to_int out of int64 range\");")
    r.push("    return (int64_t)v;")
    r.push("}")
    r.push("")
    r.push("// hl_file_exists: consumes the path.")
    r.push("static bool hl_file_exists(hl_str* path) {")
    r.push("    struct stat st;")
    r.push("    bool ok = stat(path->data, &st) == 0 && S_ISREG(st.st_mode);")
    r.push("    hl_str_release(path);")
    r.push("    return ok;")
    r.push("}")
    r.push("")
    # ----- Stage 8-beta: ownership primitives runtime -----
    # clone(str) is the only fixed clone helper in the runtime. Every other
    # clone() helper is generated per type-instantiation by the codegen
    # (hl_clone_<mangled-type>) because it must know field/elem/value
    # types — including user structs and enums.
    r.push("// clone(str) — strings are immutable, so a shallow copy is a deep copy.")
    r.push("static hl_str* hl_clone_str(hl_str* s) {")
    r.push("    return hl_str_from(s->data, s->len);")
    r.push("}")
    r.push("")
    return r
}

# ----------------------------------------------------------------------------
# 5. CODEGEN — HLS -> C
# ----------------------------------------------------------------------------

fn c_type(ctx: Ctx, t_in: str) -> str {
    # Substitute type params from current instantiation context.
    let mut t: str = t_in
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        t = instantiate_type(t, ctx.cur_typeparams, ctx.cur_targs)
    }
    if t == "int" {
        return "int64_t"
    }
    if t == "float" {
        return "double"
    }
    if t == "bool" {
        return "bool"
    }
    if t == "str" {
        return "hl_str*"
    }
    if t == "void" {
        return "void"
    }
    if is_list_t(t) {
        return "hl_list*"
    }
    if is_map_t(t) {
        return "hl_map*"
    }
    if is_taint_t(t) {
        # Stage 10-alpha: at the C level, a tainted[T] is represented the
        # same as T — the taint is a compile-time property only, enforced
        # by the checker's taint-sink rule. Runtime distinction (e.g. a
        # taint flag carried at runtime) is deferred to Stage 10-beta.
        return c_type(ctx, taint_inner_t(t))
    }
    return c_type_name(t) + "*"
}

fn is_ptr_type(t: str) -> bool {
    if t == "int" || t == "float" || t == "bool" || t == "void" {
        return false
    }
    if is_taint_t(t) {
        # tainted[T] is a pointer iff T is.
        return is_ptr_type(taint_inner_t(t))
    }
    return true
}

fn box_fn_for(t: str) -> str {
    if t == "int" {
        return "hl_box_i64"
    }
    if t == "float" {
        return "hl_box_f64"
    }
    if t == "bool" {
        return "hl_box_bool"
    }
    return "hl_box_ptr"
}

fn gen_unbox(ctx: Ctx, t: str, cexpr: str) -> str {
    if t == "int" {
        return "hl_unbox_i64(" + cexpr + ")"
    }
    if t == "float" {
        return "hl_unbox_f64(" + cexpr + ")"
    }
    if t == "bool" {
        return "hl_unbox_bool(" + cexpr + ")"
    }
    return "(" + c_type(ctx, t) + ")hl_unbox_ptr(" + cexpr + ")"
}

fn box_val(t: str, cexpr: str) -> str {
    return box_fn_for(t) + "(" + cexpr + ")"
}

# c_type_name(t) — mangle a HLS type name into a valid C identifier.
# Used for both user types and their generic instantiations.
# Examples:
#   "Point"            -> "Point"
#   "Box[int]"         -> "Box__int"
#   "Pair[int, str]"   -> "Pair__int__str"
#   "Option[list[int]]" -> "Option__list_int_"
#   "Foo[A, B, C]"     -> "Foo__A__B__C"  (only when A, B, C are already-bound type args)
fn c_type_name(t: str) -> str {
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    if args.len() == 0 {
        return base
    }
    let mut out: str = base + "__"
    let mut i: int = 0
    while i < args.len() {
        if i > 0 {
            out = out + "__"
        }
        out = out + c_type_name(args.get(i))
        i = i + 1
    }
    return out
}

# c_fn_name(key) — mangle a HLS function key into a C identifier.
# "foo" -> "foo"; "Point.dist" -> "Point_dist"
fn c_fn_name(key: str) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < key.len() {
        if key.byte_at(i) == 46 {
            parts.push("_")
        } else {
            parts.push(key.slice(i, i + 1))
        }
        i = i + 1
    }
    return join(parts, "")
}

# c_mangled_fn_name(key, targs) — mangle a generic function call's
# instantiation: identity[int] -> "identity__int"
fn c_mangled_fn_name(key: str, tps: list[str], targs: list[str]) -> str {
    if tps.len() == 0 {
        return c_fn_name(key)
    }
    let mut out: str = c_fn_name(key) + "__"
    let mut i: int = 0
    while i < targs.len() {
        if i > 0 {
            out = out + "__"
        }
        out = out + c_type_name(targs.get(i))
        i = i + 1
    }
    return out
}

fn c_str_lit(s: str) -> str {
    let mut out: str = "hl_cstr(\""
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b == 34 {
            out = out + "\\\""
        } else if b == 92 {
            out = out + "\\\\"
        } else if b == 10 {
            out = out + "\\n"
        } else if b == 9 {
            out = out + "\\t"
        } else if b >= 32 && b <= 126 {
            out = out + s.slice(i, i + 1)
        } else {
            let o: int = b
            let d1: int = o / 64
            let d2: int = (o / 8) % 8
            let d3: int = o % 8
            out = out + "\\" + chr(48 + d1) + chr(48 + d2) + chr(48 + d3)
        }
        i = i + 1
    }
    return out + "\")"
}

fn fresh_local(ctx: Ctx, name: str) -> str {
    if !ctx.gen_counts.has(name) {
        ctx.gen_counts.set(name, 1)
        ctx.gen_locals.set(name, "u_" + name)
        return "u_" + name
    }
    let n: int = ctx.gen_counts.get_or(name, 1)
    ctx.gen_counts.set(name, n + 1)
    let cname: str = "u_" + name + "_" + (n + 1).to_str()
    ctx.gen_locals.set(name, cname)
    return cname
}

fn fresh_tmp(ctx: Ctx, base: str) -> str {
    ctx.tmp = ctx.tmp + 1
    return base + "_" + ctx.tmp.to_str()
}

fn local_c(ctx: Ctx, name: str) -> str {
    let cn: str = ctx.gen_locals.get_or(name, "")
    if cn == "" {
        panic("internal codegen error: variable not found " + name)
    }
    return cn
}

fn concat_lines(dst: list[str], src: list[str]) -> void {
    let mut i: int = 0
    while i < src.len() {
        dst.push(src.get(i))
        i = i + 1
    }
}

# ============================================================================
# 4c. STAGE 8-BETA OWNERSHIP CODEGEN HELPERS
# ----------------------------------------------------------------------------
# The ownership discipline (see SPEC.md section 16):
#   * Every heap value is reference-counted (refcnt is the first field).
#   * "Fresh" expressions (literals, concat, clone, call results, pop,
#     map.keys, list/struct/enum literals) carry one retain nobody owns —
#     the consumer takes it over.
#   * "Borrow" expressions (idents, field/index access) point at a retain
#     owned elsewhere; a consumer that keeps the value adds its own retain.
#   * Bindings own one retain, released by a C cleanup attribute at block
#     exit (this covers break/continue/return automatically).
#   * Function parameters own one retain of each argument (call sites
#     own-wrap fresh values raw and borrowed values with hl_retain).
#   * take(x) transfers the binding's retain: the C variable is nulled
#     after the statement. drop(x) releases it immediately.
#   * Fresh pointer-typed subexpressions consumed in a borrowed position
#     are hoisted into temps with cleanups so nothing leaks.
# ============================================================================

# inst_t: substitute type params from the current instantiation context.
fn inst_t(ctx: Ctx, t: str) -> str {
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        return instantiate_type(t, ctx.cur_typeparams, ctx.cur_targs)
    }
    return t
}

# is_ptr_t: True when values of this (instantiated) type are refcounted
# pointers. tainted[T] is a pointer iff T is.
fn is_ptr_t(ctx: Ctx, t_in: str) -> bool {
    let t: str = inst_t(ctx, t_in)
    if t == "int" || t == "float" || t == "bool" || t == "void" || t == "never" {
        return false
    }
    if is_taint_t(t) {
        return is_ptr_t(ctx, taint_inner_t(t))
    }
    return true
}

# strip_taint: unwrap tainted[...] chains for release/clone dispatch.
fn strip_taint(t: str) -> str {
    let mut out: str = t
    let mut guard: int = 0
    while is_taint_t(out) && guard < 8 {
        out = taint_inner_t(out)
        guard = guard + 1
    }
    return out
}

# release_fn_for: the type-specific release function name.
fn release_fn_for(ctx: Ctx, t_in: str) -> str {
    let t: str = strip_taint(inst_t(ctx, t_in))
    if t == "str" {
        return "hl_str_release"
    }
    if is_list_t(t) {
        return "hl_list_release"
    }
    if is_map_t(t) {
        return "hl_map_release"
    }
    return "hl_release_" + c_type_name(t)
}

# cleanup_fn_for: the block-exit cleanup function (takes T**).
fn cleanup_fn_for(ctx: Ctx, t_in: str) -> str {
    let t: str = strip_taint(inst_t(ctx, t_in))
    if t == "str" {
        return "hl_cleanup_str"
    }
    if is_list_t(t) {
        return "hl_cleanup_list"
    }
    if is_map_t(t) {
        return "hl_cleanup_map"
    }
    return "hl_cleanup_" + c_type_name(t)
}

# elem_free_fn: the function pointer passed to hl_list_new / hl_map_new
# describing how to release one element / value. `free` for primitive
# boxes (they are single-owner allocations, not refcounted).
fn elem_free_fn(ctx: Ctx, t_in: str) -> str {
    let t: str = strip_taint(inst_t(ctx, t_in))
    if t == "int" || t == "float" || t == "bool" {
        return "free"
    }
    return release_fn_for(ctx, t)
}

# release_call: a full C statement expression releasing cexpr of type t.
fn release_call(ctx: Ctx, t: str, cexpr: str) -> str {
    if !is_ptr_t(ctx, t) {
        return "((void)0)"
    }
    return release_fn_for(ctx, t) + "(" + cexpr + ")"
}

# own_wrap: wrap a generated expression so it arrives OWNED (+1 retain)
# at its consumer. Primitives pass through; fresh pointer values pass
# through raw (their inherent retain is the one transferred); borrowed
# pointer values get an explicit hl_retain.
fn own_wrap(ctx: Ctx, t: str, cexpr: str, fresh: bool) -> str {
    if !is_ptr_t(ctx, t) {
        return cexpr
    }
    if fresh {
        return cexpr
    }
    return "hl_retain(" + cexpr + ")"
}

# gen_store_val: wrap a value being stored into a container
# (list.push/set, map.set). Primitive boxes pass through box_val;
# pointer values are own-wrapped so the container owns one retain.
fn gen_store_val(ctx: Ctx, t: str, cexpr: str, fresh: bool) -> str {
    if !is_ptr_t(ctx, t) {
        return box_val(inst_t(ctx, t), cexpr)
    }
    return own_wrap(ctx, t, cexpr, fresh)
}

# expr_fresh: classify an expression by ownership. True = the value it
# produces is "fresh" (one unowned retain the consumer takes over).
fn expr_fresh(ctx: Ctx, e: int) -> bool {
    let k: str = ctx.exprs[e].kind
    if k == "str" {
        return true
    }
    if k == "int" || k == "float" || k == "bool" || k == "ident" {
        return false
    }
    if k == "bin" {
        # Only pointer-typed binops exist for `+` on str (concat) — the
        # result is fresh. Comparisons/arithmetic on primitives are not
        # pointer values, so their class is irrelevant.
        return is_ptr_t(ctx, ctx.exprs[e].t)
    }
    if k == "un" {
        return false
    }
    if k == "index" {
        return false
    }
    if k == "field" {
        return false
    }
    if k == "listlit" || k == "structlit" || k == "enumlit" || k == "mapnew" {
        return true
    }
    if k == "match" {
        # Match arms own-wrap their results, so the match always yields
        # an owned value.
        return true
    }
    if k == "qmark" {
        return true
    }
    if k == "call" {
        return call_result_fresh(ctx, e)
    }
    if k == "method" {
        return method_result_fresh(ctx, e)
    }
    return false
}

# call_result_fresh: freshness table for builtin/user calls.
fn call_result_fresh(ctx: Ctx, e: int) -> bool {
    if ctx.exprs[e].muser {
        let cf: FnInfo = ctx.fns.get_or(ctx.exprs[e].mkey, dummy_fn())
        if cf.is_extern {
            # Extern C functions return raw values; the codegen does not
            # refcount them (extern signatures returning pointers are
            # handled as borrows).
            return false
        }
        return true
    }
    let name: str = ctx.exprs[e].mkey
    if name == "read_file" || name == "read_file_tainted" {
        return true
    }
    if name == "range" || name == "chr" {
        return true
    }
    if name == "map_new" {
        return true
    }
    if name == "clone" || name == "take" {
        return true
    }
    if name == "str" {
        # str(x) is the identity for str arguments — the result's class
        # follows the argument's.
        let at: str = ctx.exprs[ctx.exprs[e].args.get(0)].t
        if at == "str" {
            return expr_fresh(ctx, ctx.exprs[e].args.get(0))
        }
        return false
    }
    if name == "taint_mark" || name == "taint_unwrap" {
        return expr_fresh(ctx, ctx.exprs[e].args.get(0))
    }
    # args()/tainted_args() return the process-lifetime global list.
    # print/println/panic/exit/write_file/len/int/float/clock_ms/
    # file_exists/drop return void or primitives.
    return false
}

# method_result_fresh: freshness table for builtin methods.
fn method_result_fresh(ctx: Ctx, e: int) -> bool {
    if ctx.exprs[e].muser {
        return true
    }
    let op: str = ctx.exprs[e].mop
    if op == "str.slice" || op == "str.split" || op == "str.trim" {
        return true
    }
    if op == "str.to_str" {
        # Identity on the receiver — the result's class follows it.
        return expr_fresh(ctx, ctx.exprs[e].left)
    }
    if op == "int.to_str" || op == "float.to_str" || op == "bool.to_str" {
        return true
    }
    if op == "list.pop" {
        # Ownership of the removed element transfers out of the list.
        return true
    }
    if op == "map.keys" {
        return true
    }
    if op == "map.get_or" {
        # Pointer-valued maps return an owned retain (hl_map_get_own).
        # Primitive-valued maps return unboxed primitives.
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        if is_map_t(mt) {
            return is_ptr_t(ctx, map_val_t(mt))
        }
        return false
    }
    return false
}

# flush_null_after: emit `x = NULL;` for every binding moved out by
# take() during the current statement, then clear the list. Nulling
# makes the scope-exit cleanup a no-op (ownership was transferred).
fn flush_null_after(ctx: Ctx, ind: str) -> void {
    let mut i: int = 0
    while i < ctx.null_after.len() {
        ctx.out.push(ind + ctx.null_after.get(i) + " = NULL;")
        i = i + 1
    }
    ctx.null_after = []
}

# collect_hoist: walk the expression tree and record every fresh
# pointer-typed node consumed in a BORROWED position (a position whose
# consumer does not own the value). Those nodes are hoisted into temps
# with cleanup attributes by hoist_all before the statement is emitted.
#
# Position table:
#   bin/un operands, index/field receivers+indices      -> borrowed
#   user fn call args, method receivers (user), container
#   stores (push/set/map.set), struct/enum literal fields,
#   list literal elements, consume-builtin args          -> transferred
#   builtin borrow-fn args (clone, len, str-methods)     -> borrowed
#   match scrutinee, qmark inner                         -> internal
fn collect_hoist(ctx: Ctx, e: int) -> void {
    let k: str = ctx.exprs[e].kind
    if k == "int" || k == "float" || k == "bool" || k == "str" || k == "ident" {
        return
    }
    if k == "un" || k == "index" || k == "field" {
        hoist_child(ctx, ctx.exprs[e].left)
        if k == "index" {
            hoist_child(ctx, ctx.exprs[e].right)
        }
        return
    }
    if k == "bin" {
        hoist_child(ctx, ctx.exprs[e].left)
        hoist_child(ctx, ctx.exprs[e].right)
        return
    }
    if k == "listlit" || k == "structlit" || k == "enumlit" {
        # Elements/fields are transferred into the container — recurse
        # into their subexpressions only.
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            collect_hoist(ctx, ctx.exprs[e].args.get(i))
            i = i + 1
        }
        return
    }
    if k == "mapnew" || k == "match" || k == "qmark" {
        # match/qmark manage their scrutinee/inner ownership internally;
        # still recurse so fresh-borrowed subexpressions get hoisted.
        # NOTE: arm BODIES are NOT walked here — they may reference the
        # match's pattern bindings, which only exist inside the statement
        # expression. gen_match_expr performs arm-local hoisting instead.
        if k == "match" {
            collect_hoist(ctx, ctx.exprs[e].left)
        } else {
            collect_hoist(ctx, ctx.exprs[e].left)
        }
        return
    }
    if k == "call" {
        if ctx.exprs[e].muser {
            let cf: FnInfo = ctx.fns.get_or(ctx.exprs[e].mkey, dummy_fn())
            let mut i: int = 0
            while i < ctx.exprs[e].args.len() {
                if cf.is_extern {
                    # Extern args are borrowed (the C callee knows
                    # nothing about refcounts).
                    hoist_child(ctx, ctx.exprs[e].args.get(i))
                } else {
                    collect_hoist(ctx, ctx.exprs[e].args.get(i))
                }
                i = i + 1
            }
            return
        }
        let name: str = ctx.exprs[e].mkey
        let mut j: int = 0
        while j < ctx.exprs[e].args.len() {
            let aidx: int = ctx.exprs[e].args.get(j)
            if builtin_arg_borrowed(name) {
                hoist_child(ctx, aidx)
            } else {
                collect_hoist(ctx, aidx)
            }
            j = j + 1
        }
        return
    }
    if k == "method" {
        # Builtin method receivers are borrowed (even push/set: the
        # receiver list is mutated, not stored into). User method
        # receivers are transferred (the self param owns one retain).
        if ctx.exprs[e].muser {
            collect_hoist(ctx, ctx.exprs[e].left)
        } else {
            hoist_child(ctx, ctx.exprs[e].left)
        }
        let op: str = ctx.exprs[e].mop
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            let aidx: int = ctx.exprs[e].args.get(i)
            if method_arg_borrowed(op, i) {
                hoist_child(ctx, aidx)
            } else {
                collect_hoist(ctx, aidx)
            }
            i = i + 1
        }
        return
    }
}

# hoist_child: hoist child `c` if it is a fresh pointer value, otherwise
# recurse into it. When hoisting, the node's OWN fresh children (in
# borrowed positions) must be reserved FIRST — they are declared as
# temps before the parent's temp, because the parent's initializer
# expression references them. (HLS maps preserve insertion order, so the
# reservation order in hoist_map is the declaration order.)
fn hoist_child(ctx: Ctx, c: int) -> void {
    if c < 0 {
        return
    }
    let ck: str = c.to_str()
    if is_ptr_t(ctx, ctx.exprs[c].t) && expr_fresh(ctx, c) && !ctx.hoist_map.has(ck) {
        # Reserve the node's children first (declaration order).
        collect_hoist(ctx, c)
        ctx.hoist_map.set(ck, "")
        # Reserved with an empty temp name; hoist_all fills it in.
        return
    }
    collect_hoist(ctx, c)
}

# builtin_arg_borrowed: True when a builtin consumes its argument as a
# borrow (no ownership transfer). Consume builtins (print family, I/O)
# and identity builtins (str, taint_mark) transfer or pass through.
fn builtin_arg_borrowed(name: str) -> bool {
    if name == "println" || name == "print" || name == "panic" || name == "exit" {
        return false
    }
    if name == "write_file" || name == "read_file" || name == "read_file_tainted" {
        return false
    }
    if name == "file_exists" {
        return false
    }
    if name == "str" || name == "taint_mark" || name == "taint_unwrap" {
        return false
    }
    # clone, len, int, float, and the rest borrow their arguments.
    return true
}

# method_arg_borrowed: True when a builtin method consumes argument `i`
# as a borrow. Values stored into containers (push/set/map.set) and
# pointer-valued get_or defaults are transferred.
fn method_arg_borrowed(op: str, i: int) -> bool {
    if op == "list.push" || op == "list.set" {
        return false
    }
    if op == "map.set" {
        return false
    }
    if op == "map.get_or" {
        # The KEY is borrowed; the DEFAULT is transferred (owned) for
        # pointer-valued maps — but primitive defaults pass by value.
        return i == 0
    }
    return true
}

# hoist_all: materialise every node reserved by collect_hoist into a
# temp declaration with a cleanup attribute, registered in hoist_map.
# The declarations are appended to `dst` at the given indentation —
# ctx.out for statement-level hoists, or a match arm's local block
# for arm-local hoists (pattern bindings only exist there).
fn hoist_all(ctx: Ctx, dst: list[str], ind: str) -> void {
    let keys: list[str] = ctx.hoist_map.keys()
    let mut i: int = 0
    while i < keys.len() {
        let key: str = keys.get(i)
        if ctx.hoist_map.get_or(key, "") != "" {
            # Already materialised (nested collect pass) — skip.
            i = i + 1
            continue
        }
        let e: int = key.to_int()
        let tmp: str = fresh_tmp(ctx, "hlc_h")
        let t: str = inst_t(ctx, ctx.exprs[e].t)
        let v: str = gen_expr(ctx, e)
        dst.push(ind + c_type(ctx, t) + " " + tmp
            + " __attribute__((cleanup(" + cleanup_fn_for(ctx, t) + "))) = " + v + ";")
        ctx.hoist_map.set(key, tmp)
        i = i + 1
    }
}

# clear_hoists: drop hoist registrations at the end of a statement (the
# temps have been declared; the expression tree is not revisited).
fn clear_hoists(ctx: Ctx) -> void {
    ctx.hoist_map = map_new()
}

# gen_own_arg: generate one argument, own-wrapped for pointer types —
# used at user fn / user method / consume-builtin call sites.
fn gen_own_arg(ctx: Ctx, aidx: int) -> str {
    let t: str = ctx.exprs[aidx].t
    let fresh: bool = expr_fresh(ctx, aidx)
    let c: str = gen_expr(ctx, aidx)
    return own_wrap(ctx, t, c, fresh)
}

# gen_own_args_c: own-wrap every argument of a call.
fn gen_own_args_c(ctx: Ctx, e: int) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        parts.push(gen_own_arg(ctx, ctx.exprs[e].args.get(i)))
        i = i + 1
    }
    return join(parts, ", ")
}

# --- C expression generation ---

fn gen_expr(ctx: Ctx, e: int) -> str {
    # Stage 8-beta: if this node was hoisted into a temp, use the temp.
    let hk: str = e.to_str()
    if ctx.hoist_map.has(hk) {
        let tname: str = ctx.hoist_map.get_or(hk, "")
        if tname != "" {
            return tname
        }
    }
    let mut k: str = ctx.exprs[e].kind
    if k == "int" {
        if ctx.exprs[e].ival == -9223372036854775808 {
            return "(-9223372036854775807LL - 1)"
        }
        return ctx.exprs[e].ival.to_str()
    }
    if k == "float" {
        return ctx.exprs[e].fval.to_str()
    }
    if k == "bool" {
        if ctx.exprs[e].bval {
            return "true"
        }
        return "false"
    }
    if k == "str" {
        return c_str_lit(ctx.exprs[e].sval)
    }
    if k == "ident" {
        return local_c(ctx, ctx.exprs[e].name)
    }
    if k == "bin" {
        return gen_bin(ctx, e)
    }
    if k == "un" {
        let sub: str = gen_expr(ctx, ctx.exprs[e].left)
        if ctx.exprs[e].op == "!" {
            return "(!" + sub + ")"
        }
        if ctx.exprs[e].t == "int" {
            return "hl_neg_i64(" + sub + ")"
        }
        return "(-" + sub + ")"
    }
    if k == "index" {
        let lst: str = gen_expr(ctx, ctx.exprs[e].left)
        let idx: str = gen_expr(ctx, ctx.exprs[e].right)
        return gen_unbox(ctx, ctx.exprs[e].t, "hl_list_get(" + lst + ", " + idx + ")")
    }
    if k == "field" {
        return "(" + gen_expr(ctx, ctx.exprs[e].left) + ")->" + ctx.exprs[e].name
    }
    if k == "call" {
        return gen_call(ctx, e)
    }
    if k == "method" {
        return gen_method(ctx, e)
    }
    if k == "listlit" {
        return gen_listlit(ctx, e)
    }
    if k == "structlit" {
        return gen_structlit(ctx, e)
    }
    if k == "enumlit" {
        return gen_enumlit(ctx, e)
    }
    if k == "match" {
        # Match in expression position: emit an immediately-invoked lambda
        # equivalent (a block expression). We use a GCC statement expression
        # `({ ... })` for this purpose.
        return gen_match_expr(ctx, e)
    }
    if k == "qmark" {
        # `?` in expression position: similar — emit a statement expression
        # that returns the unwrapped value or returns the error from the
        # enclosing function.
        return gen_qmark_expr(ctx, e)
    }
    if k == "mapnew" {
        return "hl_map_new()"
    }
    panic("internal codegen error: unknown expression " + k)
    return ""
}

fn gen_bin(ctx: Ctx, e: int) -> str {
    let op: str = ctx.exprs[e].op
    let t: str = ctx.exprs[ctx.exprs[e].left].t
    let a: str = gen_expr(ctx, ctx.exprs[e].left)
    let b: str = gen_expr(ctx, ctx.exprs[e].right)
    if op == "||" || op == "&&" {
        return "(" + a + " " + op + " " + b + ")"
    }
    if op == "==" {
        if t == "str" {
            return "hl_str_eq(" + a + ", " + b + ")"
        }
        return "(" + a + " == " + b + ")"
    }
    if op == "!=" {
        if t == "str" {
            return "(!hl_str_eq(" + a + ", " + b + "))"
        }
        return "(" + a + " != " + b + ")"
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if t == "str" {
            return "(hl_str_cmp(" + a + ", " + b + ") " + op + " 0)"
        }
        return "(" + a + " " + op + " " + b + ")"
    }
    if op == "+" {
        if t == "int" {
            return "hl_add_i64(" + a + ", " + b + ")"
        }
        if t == "str" {
            return "hl_str_concat(" + a + ", " + b + ")"
        }
        return "(" + a + " + " + b + ")"
    }
    if op == "-" {
        if t == "int" {
            return "hl_sub_i64(" + a + ", " + b + ")"
        }
        return "(" + a + " - " + b + ")"
    }
    if op == "*" {
        if t == "int" {
            return "hl_mul_i64(" + a + ", " + b + ")"
        }
        return "(" + a + " * " + b + ")"
    }
    if op == "/" {
        if t == "int" {
            return "hl_div_i64(" + a + ", " + b + ")"
        }
        return "(" + a + " / " + b + ")"
    }
    if op == "%" {
        if t == "int" {
            return "hl_mod_i64(" + a + ", " + b + ")"
        }
        return "hl_fmod(" + a + ", " + b + ")"
    }
    panic("internal codegen error: unknown operator " + op)
    return ""
}

fn gen_args_c(ctx: Ctx, e: int) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        parts.push(gen_expr(ctx, ctx.exprs[e].args.get(i)))
        i = i + 1
    }
    return join(parts, ", ")
}

fn gen_call(ctx: Ctx, e: int) -> str {
    if ctx.exprs[e].muser {
        # Stage 15-beta: extern fns use the RAW C name (no `usf_` prefix)
        # so the C linker can resolve them from libc. Extern args are
        # borrowed (the C callee knows nothing about refcounts) — fresh
        # pointer args were hoisted into temps by the statement wrapper.
        let cf: FnInfo = ctx.fns.get_or(ctx.exprs[e].mkey, dummy_fn())
        if cf.is_extern {
            return ctx.exprs[e].mkey + "(" + gen_args_c(ctx, e) + ")"
        }
        # Stage 8-beta: user fn params OWN one retain of each argument —
        # fresh values are passed raw, borrowed values retain-wrapped.
        return "usf_" + c_fn_name(ctx.exprs[e].mkey) + "(" + gen_own_args_c(ctx, e) + ")"
    }
    let name: str = ctx.exprs[e].mkey
    let args: str = gen_args_c(ctx, e)
    if name == "print" {
        return "hl_print(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "println" {
        return "hl_println(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "panic" {
        return "hl_panic(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "exit" {
        return "hl_exit(" + args + ")"
    }
    if name == "str" {
        let at: str = ctx.exprs[ctx.exprs[e].args.get(0)].t
        if at == "int" {
            return "hl_str_from_int64(" + args + ")"
        }
        if at == "float" {
            return "hl_str_from_double(" + args + ")"
        }
        if at == "bool" {
            return "hl_str_from_bool(" + args + ")"
        }
        return args
    }
    if name == "int" {
        return "hl_str_to_int(" + args + ")"
    }
    if name == "len" {
        let at: str = ctx.exprs[ctx.exprs[e].args.get(0)].t
        if at == "str" {
            return "hl_str_len(" + args + ")"
        }
        if is_list_t(at) {
            return "hl_list_len(" + args + ")"
        }
        return "hl_map_len(" + args + ")"
    }
    if name == "range" {
        return "hl_range(" + args + ")"
    }
    if name == "map_new" {
        # Stage 8-beta: the map owns its values — val_free comes from the
        # map's value type (the checker types this call from context).
        let mt: str = inst_t(ctx, ctx.exprs[e].t)
        if is_map_t(mt) {
            return "hl_map_new(" + elem_free_fn(ctx, map_val_t(mt)) + ")"
        }
        return "hl_map_new(NULL)"
    }
    if name == "read_file" {
        return "hl_read_file(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # Stage 10-beta: read_file_tainted — at runtime, returns the same hl_read_file
    # result; taint is a compile-time property only (defense-in-depth is deferred).
    if name == "read_file_tainted" {
        return "hl_read_file(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "write_file" {
        return "hl_write_file(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ", "
            + gen_own_arg(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    if name == "args" {
        return "hl_args()"
    }
    # Stage 10-alpha: taint primitives — at runtime, taint is a no-op
    # (the check is purely at compile-time). tainted_args() returns the
    # same hl_args() result; taint_mark(x) returns x; taint_unwrap(x)
    # returns x. The C type of tainted[T] is the same as T (see c_type).
    if name == "tainted_args" {
        return "hl_args()"
    }
    if name == "taint_mark" {
        return args
    }
    if name == "taint_unwrap" {
        return args
    }
    if name == "clock_ms" {
        return "hl_clock_ms()"
    }
    if name == "chr" {
        return "hl_chr(" + args + ")"
    }
    if name == "file_exists" {
        return "hl_file_exists(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # ----- Stage 8-beta: ownership primitives -----
    # drop(x): release the value now and null the binding so the
    # scope-exit cleanup is a no-op. The checker guarantees x is an
    # owned binding, so this is always a pointer type.
    if name == "drop" {
        let arg: int = ctx.exprs[e].args.get(0)
        let cn: str = local_c(ctx, ctx.exprs[arg].name)
        let t: str = ctx.exprs[arg].t
        return "((" + release_call(ctx, t, cn) + "), (" + cn + " = NULL, (void)0))"
    }
    # clone(x): dispatch to the per-instantiation helper generated by
    # gen_clone_bodies (str uses the runtime's hl_clone_str). tainted[T]
    # clones as T — the taint is a compile-time property only.
    if name == "clone" {
        let at: str = strip_taint(inst_t(ctx, ctx.exprs[ctx.exprs[e].args.get(0)].t))
        register_clone(ctx, at)
        if at == "str" {
            return "hl_clone_str(" + args + ")"
        }
        return "hl_clone_" + c_type_name(at) + "(" + args + ")"
    }
    # take(x): a compile-time move — at runtime it is just the value.
    # The binding is nulled at the end of the statement (null_after) so
    # the scope-exit cleanup is a no-op: ownership transfers.
    if name == "take" {
        let arg: int = ctx.exprs[e].args.get(0)
        let cn: str = local_c(ctx, ctx.exprs[arg].name)
        ctx.null_after.push(cn)
        return cn
    }
    panic("internal codegen error: unknown builtin function " + name)
    return ""
}

fn gen_method(ctx: Ctx, e: int) -> str {
    if ctx.exprs[e].muser {
        # Stage 8-beta: the self parameter owns one retain of the
        # receiver (the method may mutate through the shared pointer;
        # the retain is released when the method returns).
        let recv_fresh: bool = expr_fresh(ctx, ctx.exprs[e].left)
        let t0: str = gen_expr(ctx, ctx.exprs[e].left)
        let recv: str = own_wrap(ctx, ctx.exprs[ctx.exprs[e].left].t, t0, recv_fresh)
        let rest: str = gen_own_args_c(ctx, e)
        if ctx.exprs[e].args.len() == 0 {
            return "usf_" + c_fn_name(ctx.exprs[e].mkey) + "(" + recv + ")"
        }
        return "usf_" + c_fn_name(ctx.exprs[e].mkey) + "(" + recv + ", " + rest + ")"
    }
    let op: str = ctx.exprs[e].mop
    let t0: str = gen_expr(ctx, ctx.exprs[e].left)
    let args: str = gen_args_c(ctx, e)
    if op == "str.len" {
        return "hl_str_len(" + t0 + ")"
    }
    if op == "str.byte_at" {
        return "hl_str_byte_at(" + t0 + ", " + args + ")"
    }
    if op == "str.slice" {
        return "hl_str_slice(" + t0 + ", " + args + ")"
    }
    if op == "str.find" {
        return "hl_str_find(" + t0 + ", " + args + ")"
    }
    if op == "str.contains" {
        return "hl_str_contains(" + t0 + ", " + args + ")"
    }
    if op == "str.starts_with" {
        return "hl_str_starts_with(" + t0 + ", " + args + ")"
    }
    if op == "str.ends_with" {
        return "hl_str_ends_with(" + t0 + ", " + args + ")"
    }
    if op == "str.split" {
        return "hl_str_split(" + t0 + ", " + args + ")"
    }
    if op == "str.trim" {
        return "hl_str_trim(" + t0 + ")"
    }
    if op == "str.to_int" {
        return "hl_str_to_int(" + t0 + ")"
    }
    if op == "str.to_float" {
        return "hl_str_to_double(" + t0 + ")"
    }
    if op == "str.to_str" {
        return t0
    }
    if op == "int.to_str" {
        return "hl_str_from_int64(" + t0 + ")"
    }
    if op == "int.to_float" {
        return "((double)(" + t0 + "))"
    }
    if op == "int.abs" {
        return "hl_abs_i64(" + t0 + ")"
    }
    if op == "float.to_str" {
        return "hl_str_from_double(" + t0 + ")"
    }
    if op == "float.to_int" {
        return "hl_float_to_int(" + t0 + ")"
    }
    if op == "float.abs" {
        return "(((" + t0 + ") < 0) ? -(" + t0 + ") : (" + t0 + "))"
    }
    if op == "bool.to_str" {
        return "hl_str_from_bool(" + t0 + ")"
    }
    if op == "list.len" {
        return "hl_list_len(" + t0 + ")"
    }
    if op == "list.push" {
        # The value is stored into the container: the list owns one
        # retain (fresh raw / borrowed retain-wrapped / prim boxed).
        let et: str = list_elem_t(inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t))
        let aidx: int = ctx.exprs[e].args.get(0)
        let av: str = gen_expr(ctx, aidx)
        let af: bool = expr_fresh(ctx, aidx)
        return "hl_list_push(" + t0 + ", " + gen_store_val(ctx, et, av, af) + ")"
    }
    if op == "list.get" {
        return gen_unbox(ctx, ctx.exprs[e].t, "hl_list_get(" + t0 + ", " + args + ")")
    }
    if op == "list.set" {
        let et: str = list_elem_t(inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t))
        let ai: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        let aidx: int = ctx.exprs[e].args.get(1)
        let av: str = gen_expr(ctx, aidx)
        let af: bool = expr_fresh(ctx, aidx)
        return "hl_list_set(" + t0 + ", " + ai + ", " + gen_store_val(ctx, et, av, af) + ")"
    }
    if op == "list.pop" {
        # Primitive element lists use the typed pops (the box is freed
        # inside); pointer elements transfer ownership of the element.
        let et: str = list_elem_t(inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t))
        if et == "int" {
            return "hl_list_pop_i64(" + t0 + ")"
        }
        if et == "float" {
            return "hl_list_pop_f64(" + t0 + ")"
        }
        if et == "bool" {
            return "hl_list_pop_bool(" + t0 + ")"
        }
        return gen_unbox(ctx, ctx.exprs[e].t, "hl_list_pop(" + t0 + ")")
    }
    if op == "map.len" {
        return "hl_map_len(" + t0 + ")"
    }
    if op == "map.set" {
        # Key and value are stored into the map: it owns one retain of
        # each (fresh raw / borrowed retain-wrapped / prim boxed).
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        let vt: str = map_val_t(mt)
        let kidx: int = ctx.exprs[e].args.get(0)
        let ak: str = gen_expr(ctx, kidx)
        let kf: bool = expr_fresh(ctx, kidx)
        let vidx: int = ctx.exprs[e].args.get(1)
        let av: str = gen_expr(ctx, vidx)
        let vf: bool = expr_fresh(ctx, vidx)
        let kw: str = own_wrap(ctx, "str", ak, kf)
        return "hl_map_set(" + t0 + ", " + kw + ", " + gen_store_val(ctx, vt, av, vf) + ")"
    }
    if op == "map.get_or" {
        # Primitive-valued maps use the typed getters (the default is
        # passed by value — no boxing, no refcount traffic). Pointer-
        # valued maps use hl_map_get_own: the default arrives owned and
        # the result is returned owned.
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        let vt: str = map_val_t(mt)
        let ak: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        let ad_idx: int = ctx.exprs[e].args.get(1)
        let ad: str = gen_expr(ctx, ad_idx)
        if vt == "int" {
            return "hl_map_get_i64(" + t0 + ", " + ak + ", " + ad + ")"
        }
        if vt == "float" {
            return "hl_map_get_f64(" + t0 + ", " + ak + ", " + ad + ")"
        }
        if vt == "bool" {
            return "hl_map_get_bool(" + t0 + ", " + ak + ", " + ad + ")"
        }
        let adf: bool = expr_fresh(ctx, ad_idx)
        let adw: str = own_wrap(ctx, vt, ad, adf)
        return "((" + c_type(ctx, vt) + ")hl_map_get_own(" + t0 + ", " + ak + ", " + adw + "))"
    }
    if op == "map.has" {
        return "hl_map_has(" + t0 + ", " + args + ")"
    }
    if op == "map.keys" {
        return "hl_map_keys(" + t0 + ")"
    }
    panic("internal codegen error: unknown method " + op)
    return ""
}

fn gen_listlit(ctx: Ctx, e: int) -> str {
    # Stage 8-beta: list literals are emitted INLINE as a GCC statement
    # expression. The old implementation emitted a separate `hl_lit_N`
    # helper function per literal, but the element expressions were
    # generated in the ENCLOSING function's context — any element that
    # referenced a local variable produced a C identifier that does not
    # exist inside the helper (BUG: `[a, b, 30]` with locals a, b failed
    # to compile natively). Inlining also gives the literal a natural
    # ownership story: the fresh list owns one retain of each element
    # (fresh raw / borrowed retain-wrapped / prim boxed).
    let elem: str = list_elem_t(inst_t(ctx, ctx.exprs[e].t))
    let tmp: str = fresh_tmp(ctx, "hlc_ll")
    let block: list[str] = []
    block.push("({")
    block.push("    hl_list* " + tmp + " = hl_list_new(" + elem_free_fn(ctx, elem) + ");")
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let aidx: int = ctx.exprs[e].args.get(i)
        let v: str = gen_expr(ctx, aidx)
        let fresh: bool = expr_fresh(ctx, aidx)
        block.push("    hl_list_push(" + tmp + ", " + gen_store_val(ctx, elem, v, fresh) + ");")
        i = i + 1
    }
    block.push("    " + tmp + ";")
    block.push("})")
    return join(block, "\n")
}

fn gen_structlit(ctx: Ctx, e: int) -> str {
    let st: StructInfo = ctx.structs.get_or(ctx.exprs[e].name, dummy_struct())
    # Substitute type params from current instantiation context.
    let mut t: str = ctx.exprs[e].t
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        t = instantiate_type(ctx.exprs[e].t, ctx.cur_typeparams, ctx.cur_targs)
    }
    # Record the (now concrete) instantiation for codegen.
    if st.typeparams.len() > 0 && type_is_concrete(ctx, t) && !list_has(ctx.struct_insts, t) {
        ctx.struct_insts.push(t)
    }
    # Compute the constructor name (mangled if generic).
    let ctor_name: str = "usf_new_" + c_type_name(t)
    # Collect provided field values. The constructor stores its params
    # raw, so each pointer-typed field value must arrive OWNED
    # (Stage 8-beta): fresh raw, borrowed retain-wrapped.
    let parts: list[str] = []
    let provided: list[str] = ctx.exprs[e].ffields
    let mut fi: int = 0
    while fi < provided.len() {
        let fidx: int = struct_field_index(st, provided.get(fi))
        let ftype: str = instantiate_field_type(st, fidx, t)
        let aidx: int = ctx.exprs[e].args.get(fi)
        let av: str = gen_expr(ctx, aidx)
        let af: bool = expr_fresh(ctx, aidx)
        parts.push(own_wrap(ctx, ftype, av, af))
        fi = fi + 1
    }
    # For each remaining declared field with a default, evaluate the default
    # (in the calling context) and pass it.
    let mut pi: int = provided.len()
    while pi < st.fields.len() {
        let dflt_idx: int = st.fdefaults.get(pi)
        if dflt_idx == -1 {
            panic("internal codegen error: missing required field " + st.fields.get(pi) + " in struct literal")
        }
        parts.push(gen_expr(ctx, dflt_idx))
        pi = pi + 1
    }
    return ctor_name + "(" + join(parts, ", ") + ")"
}

# struct_field_index: find a field's index in a StructInfo (-1 if absent).
fn struct_field_index(st: StructInfo, name: str) -> int {
    let mut i: int = 0
    while i < st.fields.len() {
        if st.fields.get(i) == name {
            return i
        }
        i = i + 1
    }
    return -1
}

# instantiate_field_type: substitute a struct's type params for one field
# using the concrete instantiation `t` (e.g. Box[int] -> field T becomes int).
fn instantiate_field_type(st: StructInfo, fidx: int, t: str) -> str {
    if fidx < 0 || fidx >= st.fields.len() {
        return "int"
    }
    let ftype: str = st.ftypes.get(fidx)
    if st.typeparams.len() == 0 {
        return ftype
    }
    let targs: list[str] = type_args(t)
    if targs.len() != st.typeparams.len() {
        return ftype
    }
    return instantiate_type(ftype, st.typeparams, targs)
}

fn gen_enumlit(ctx: Ctx, e: int) -> str {
    # The enum type is ctx.exprs[e].t (e.g., "Option[int]" or "Color").
    # Substitute type params from current instantiation context.
    let mut t: str = ctx.exprs[e].t
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        t = instantiate_type(ctx.exprs[e].t, ctx.cur_typeparams, ctx.cur_targs)
    }
    # Record the (now concrete) instantiation for codegen.
    let en: EnumInfo = ctx.enums.get_or(ctx.exprs[e].enum_name, dummy_enum())
    if en.typeparams.len() > 0 && type_is_concrete(ctx, t) && !list_has(ctx.enum_insts, t) {
        ctx.enum_insts.push(t)
    }
    # The constructor function name is "usf_make_" + c_type_name(t) + "" + "_" + variant.
    let ctor_name: str = "usf_make_" + c_type_name(t) + "_" + ctx.exprs[e].variant
    # The constructor stores its payloads raw, so each pointer-typed
    # payload must arrive OWNED (Stage 8-beta).
    let parts: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let aidx: int = ctx.exprs[e].args.get(i)
        let av: str = gen_expr(ctx, aidx)
        let af: bool = expr_fresh(ctx, aidx)
        let pt: str = enum_payload_type(en, ctx.exprs[e].variant, i, t)
        parts.push(own_wrap(ctx, pt, av, af))
        i = i + 1
    }
    return ctor_name + "(" + join(parts, ", ") + ")"
}

# enum_payload_type: the instantiated payload type for variant `vname`,
# payload index `pidx`, of the concrete enum instantiation `t`.
fn enum_payload_type(en: EnumInfo, vname: str, pidx: int, t: str) -> str {
    let mut vidx: int = -1
    let mut i: int = 0
    while i < en.variants.len() {
        if en.variants.get(i) == vname {
            vidx = i
        }
        i = i + 1
    }
    if vidx < 0 {
        return "int"
    }
    let payloads: list[str] = en.payloads.get(vidx)
    if pidx < 0 || pidx >= payloads.len() {
        return "int"
    }
    let pt: str = payloads.get(pidx)
    if en.typeparams.len() == 0 {
        return pt
    }
    let targs: list[str] = type_args(t)
    if targs.len() != en.typeparams.len() {
        return pt
    }
    return instantiate_type(pt, en.typeparams, targs)
}

# gen_match_expr — emit a GCC statement expression for a match in expression
# position. Each arm is checked via tag comparison; the matching arm's body
# is the result.
fn gen_match_expr(ctx: Ctx, e: int) -> str {
    # The scrutinee's type (e.g., "Color" or "Option[int]") — use the
    # scrutinee expression's type, not the match's result type.
    # Substitute type params from current instantiation context (for generic
    # function instantiations).
    let raw_scrut_t: str = ctx.exprs[ctx.exprs[e].left].t
    let mut scrut_t: str = raw_scrut_t
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        scrut_t = instantiate_type(raw_scrut_t, ctx.cur_typeparams, ctx.cur_targs)
    }
    let ename: str = type_base(scrut_t)
    let scrut_c: str = gen_expr(ctx, ctx.exprs[e].left)
    # The statement expression uses a tmp variable for the scrutinee.
    # Stage 8-beta: when the scrutinee is a FRESH value (call result,
    # literal, ...), this tmp owns it — a cleanup attribute releases it
    # at the end of the statement expression. When it is borrowed, the
    # binding that owns it stays responsible.
    let scrut_fresh: bool = expr_fresh(ctx, ctx.exprs[e].left)
    let tmp_name: str = fresh_tmp(ctx, "hlc_m")
    let block: list[str] = []
    block.push("({")
    if is_ptr_t(ctx, scrut_t) && scrut_fresh {
        block.push("    " + c_type(ctx, scrut_t) + " " + tmp_name
            + " __attribute__((cleanup(" + cleanup_fn_for(ctx, scrut_t) + "))) = " + scrut_c + ";")
    } else {
        block.push("    " + c_type(ctx, scrut_t) + " " + tmp_name + " = " + scrut_c + ";")
    }
    # BUG-004 fix: if the match result type is `never` (e.g. all arms
    # are panic/exit), we must NOT declare a `hlc_m_r` accumulator —
    # `never` is not a valid C type. Emit the dispatch without an
    # accumulator and without a trailing `hlc_m_r;` value.
    let match_t: str = ctx.exprs[e].t
    let is_never: bool = match_t == "never"
    if !is_never {
        block.push("    " + c_type(ctx, match_t) + " hlc_m_r;")
    }
    block.push("    if (0) {}")
    let mut has_wildcard: bool = false
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let arm_idx: int = ctx.exprs[e].args.get(i)
        let arm: MatchArm = ctx.match_arms.get(arm_idx)
        if arm.pat_kind == "wildcard" {
            has_wildcard = true
            block.push("    else {")
            # Stage 8-beta: arm-local hoisting — fresh pointer values in
            # borrowed positions within the arm body are materialised
            # INSIDE the arm block (they may reference the pattern
            # bindings, which only exist here).
            collect_hoist(ctx, arm.body)
            hoist_all(ctx, block, "        ")
            if arm.body_t != "never" {
                # Stage 8-beta: the arm result is OWNED — own-wrap borrow
                # bodies with a retain so hlc_m_r always owns one retain.
                let bv: str = gen_expr(ctx, arm.body)
                let bf: bool = expr_fresh(ctx, arm.body)
                block.push("        hlc_m_r = " + own_wrap(ctx, arm.body_t, bv, bf) + ";")
            } else {
                block.push("        " + gen_expr(ctx, arm.body) + ";")
            }
            clear_hoists(ctx)
            block.push("    }")
        } else {
            let cond: str = tmp_name + "->tag == " + ename + "__TAG_" + arm.variant + "_" + c_type_name(scrut_t)
            block.push("    else if (" + cond + ") {")
            # Bind payload values.
            let en: EnumInfo = ctx.enums.get_or(ename, dummy_enum())
            let mut vi: int = 0
            let mut vidx: int = -1
            while vi < en.variants.len() {
                if en.variants.get(vi) == arm.variant {
                    vidx = vi
                }
                vi = vi + 1
            }
            let payloads: list[str] = en.payloads.get(vidx)
            # Compute instantiated payload types.
            let typeparams: list[str] = en.typeparams
            let targs: list[str] = type_args(scrut_t)
            let mut bi: int = 0
            while bi < arm.bindings.len() {
                let bname: str = arm.bindings.get(bi)
                if bname != "_" {
                    let pt: str = payloads.get(bi)
                    let mut inst_pt: str = ""
                    if typeparams.len() > 0 {
                        inst_pt = instantiate_type(pt, typeparams, targs)
                    } else {
                        inst_pt = pt
                    }
                    let cn: str = fresh_local(ctx, bname)
                    # Enum payloads are stored DIRECTLY in the C union (not
                    # boxed), so we access them directly without unboxing.
                    # The union has per-variant structs: data.<Variant>.v<i>.
                    block.push("        " + c_type(ctx, inst_pt) + " " + cn + " = " + tmp_name + "->data." + arm.variant + ".v" + bi.to_str() + ";")
                }
                bi = bi + 1
            }
            if arm.body_t != "never" {
                # Stage 8-beta: arm-local hoisting (see wildcard arm), then
                # own-wrap borrow bodies so hlc_m_r always owns one retain.
                collect_hoist(ctx, arm.body)
                hoist_all(ctx, block, "        ")
                let bv: str = gen_expr(ctx, arm.body)
                let bf: bool = expr_fresh(ctx, arm.body)
                block.push("        hlc_m_r = " + own_wrap(ctx, arm.body_t, bv, bf) + ";")
                clear_hoists(ctx)
            } else {
                collect_hoist(ctx, arm.body)
                hoist_all(ctx, block, "        ")
                block.push("        " + gen_expr(ctx, arm.body) + ";")
                clear_hoists(ctx)
            }
            block.push("    }")
        }
        i = i + 1
    }
    # Only emit the fall-through "no arm matched" trap when no wildcard arm
    # is present — a wildcard already catches all unmatched cases.
    if !has_wildcard {
        block.push("    else { hl_die(\"match: no arm matched (internal)\"); }")
    }
    if !is_never {
        block.push("    hlc_m_r;")
    }
    block.push("})")
    # Append the block to the output (as a multi-line statement expression
    # embedded in the surrounding expression). We need to return the joined
    # string for inline use. Statement expressions can span lines.
    return join(block, "\n")
}

# gen_qmark_expr — emit a statement expression for `expr?`.
fn gen_qmark_expr(ctx: Ctx, e: int) -> str {
    let inner_t: str = ctx.exprs[ctx.exprs[e].left].t
    let ename: str = type_base(inner_t)
    let inner_c: str = gen_expr(ctx, ctx.exprs[e].left)
    let ok_v: str = ctx.exprs[e].ok_variant
    let err_v: str = ctx.exprs[e].err_variant
    let success_t: str = ctx.exprs[e].t
    let tmp_name: str = fresh_tmp(ctx, "hlc_q")
    # Stage 8-beta ownership discipline for `?`:
    #   * When the inner value is FRESH, this tmp owns it — a cleanup
    #     attribute releases the Result at the end of the statement
    #     expression (success path) .
    #   * Error path: `return hl_retain(tmp)` — the +1 goes to the caller
    #     and the cleanup (or the owning binding, for borrowed inners)
    #     balances it. This works uniformly for both fresh and borrowed
    #     inner values.
    #   * Success path: the payload is borrowed from the enum, so the
    #     result gets an explicit retain — the enum's own release (via
    #     the cleanup or its binding) cannot free it underneath us.
    let inner_fresh: bool = expr_fresh(ctx, ctx.exprs[e].left)
    let block: list[str] = []
    block.push("({")
    if is_ptr_t(ctx, inner_t) && inner_fresh {
        block.push("    " + c_type(ctx, inner_t) + " " + tmp_name
            + " __attribute__((cleanup(" + cleanup_fn_for(ctx, inner_t) + "))) = " + inner_c + ";")
    } else {
        block.push("    " + c_type(ctx, inner_t) + " " + tmp_name + " = " + inner_c + ";")
    }
    block.push("    if (" + tmp_name + "->tag == " + ename + "__TAG_" + err_v + "_" + c_type_name(inner_t) + ") {")
    block.push("        return hl_retain(" + tmp_name + ");")
    block.push("    }")
    # Success variant's payload is at data.<ok_v>.v0.
    if is_ptr_t(ctx, success_t) {
        block.push("    " + c_type(ctx, success_t) + " hlc_q_r = hl_retain(" + tmp_name + "->data." + ok_v + ".v0);")
    } else {
        block.push("    " + c_type(ctx, success_t) + " hlc_q_r = " + tmp_name + "->data." + ok_v + ".v0;")
    }
    block.push("    hlc_q_r;")
    block.push("})")
    return join(block, "\n")
}

# --- C statement generation ---

fn gen_stmt(ctx: Ctx, sidx: int, ind: str) -> void {
    let s: StmtN = ctx.stmts[sidx]
    if s.kind == "let" {
        # Stage 8-beta: hoist fresh pointer subexpressions consumed in
        # borrowed positions within the RHS, then bind. Pointer-typed
        # bindings get a cleanup attribute — released exactly at C block
        # exit (covers break/continue/return automatically).
        collect_hoist(ctx, s.value)
        hoist_all(ctx, ctx.out, ind)
        let cn: str = fresh_local(ctx, s.name)
        let fresh: bool = expr_fresh(ctx, s.value)
        let v: str = gen_expr(ctx, s.value)
        # BUG-004 fix: if the RHS expression is `never`-typed (panic/exit/
        # all-never match), the C call returns void — we must not bind it
        # to a variable. Emit just the side-effect call.
        if ctx.exprs[s.value].t == "never" {
            ctx.out.push(ind + v + ";")
        } else {
            let wrapped: str = own_wrap(ctx, s.vtype, v, fresh)
            if is_ptr_t(ctx, s.vtype) {
                ctx.out.push(ind + c_type(ctx, s.vtype) + " " + cn
                    + " __attribute__((cleanup(" + cleanup_fn_for(ctx, s.vtype) + "))) = " + wrapped + ";")
            } else {
                ctx.out.push(ind + c_type(ctx, s.vtype) + " " + cn + " = " + wrapped + ";")
            }
        }
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
    } else if s.kind == "assign" {
        gen_assign(ctx, s, ind)
    } else if s.kind == "if" {
        collect_hoist(ctx, s.cond)
        hoist_all(ctx, ctx.out, ind)
        let c: str = gen_expr(ctx, s.cond)
        ctx.out.push(ind + "if (" + c + ") {")
        gen_stmts(ctx, s.body, ind + "    ")
        if s.else_body.len() > 0 {
            ctx.out.push(ind + "} else {")
            gen_stmts(ctx, s.else_body, ind + "    ")
        }
        ctx.out.push(ind + "}")
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
    } else if s.kind == "while" {
        collect_hoist(ctx, s.cond)
        # If the condition contains hoisted temps, the plain `while (c)`
        # form would evaluate them ONCE before the loop — a semantic
        # change (fresh subexpressions must be re-evaluated per
        # iteration). Use the `while (1) { temps; if (!c) break; ... }`
        # transform so the temps (and their releases) are per-iteration.
        if ctx.hoist_map.keys().len() > 0 {
            hoist_all(ctx, ctx.out, ind + "    ")
            let c: str = gen_expr(ctx, s.cond)
            ctx.out.push(ind + "while (1) {")
            ctx.out.push(ind + "    if (!(" + c + ")) break;")
            gen_stmts(ctx, s.body, ind + "    ")
            ctx.out.push(ind + "}")
        } else {
            let c: str = gen_expr(ctx, s.cond)
            ctx.out.push(ind + "while (" + c + ") {")
            gen_stmts(ctx, s.body, ind + "    ")
            ctx.out.push(ind + "}")
        }
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
    } else if s.kind == "for" {
        collect_hoist(ctx, s.iter)
        hoist_all(ctx, ctx.out, ind + "    ")
        let it_c: str = gen_expr(ctx, s.iter)
        let it_fresh: bool = expr_fresh(ctx, s.iter)
        let itn: str = fresh_tmp(ctx, "hlc_it")
        let itn_len: str = fresh_tmp(ctx, "hlc_n")
        let iv: str = fresh_tmp(ctx, "hlc_i")
        ctx.out.push(ind + "{")
        # Stage 8-beta: when the iterable is FRESH (call result, literal),
        # this loop owns it — the itn temp carries a cleanup attribute and
        # is released after the loop (including on break). A borrowed
        # iterable stays owned by its binding.
        if it_fresh {
            ctx.out.push(ind + "    hl_list* " + itn
                + " __attribute__((cleanup(hl_cleanup_list))) = " + it_c + ";")
        } else {
            ctx.out.push(ind + "    hl_list* " + itn + " = " + it_c + ";")
        }
        ctx.out.push(ind + "    int64_t " + itn_len + " = hl_list_len(" + itn + ");")
        ctx.out.push(ind + "    int64_t " + iv + ";")
        ctx.out.push(ind + "    for (" + iv + " = 0; " + iv + " < " + itn_len + "; " + iv + "++) {")
        # BUG-SC-4 fix: if the loop body shrinks the list (e.g. xs.pop()),
        # hl_list_get(itn, iv) would panic with "array access out of bounds".
        # Bounds-check before access and break if the list is now shorter
        # than the snapshotted length (matching the interpreter's behavior).
        ctx.out.push(ind + "        if (" + iv + " >= hl_list_len(" + itn + ")) break;")
        let cn: str = fresh_local(ctx, s.name)
        let mut elem: str = s.vtype
        # Stage 8-beta: a pointer-typed loop variable borrows the element
        # from the list — the binding retains it and a cleanup releases it
        # at the end of each iteration (C re-declares the variable in a
        # fresh block scope per iteration). The list keeps its own retain.
        if is_ptr_t(ctx, elem) {
            ctx.out.push(ind + "        " + c_type(ctx, elem) + " " + cn
                + " __attribute__((cleanup(" + cleanup_fn_for(ctx, elem) + ")))"
                + " = hl_retain(" + gen_unbox(ctx, elem, "hl_list_get(" + itn + ", " + iv + ")") + ");")
        } else {
            ctx.out.push(ind + "        " + c_type(ctx, elem) + " " + cn
                + " = " + gen_unbox(ctx, elem, "hl_list_get(" + itn + ", " + iv + ")") + ";")
        }
        gen_stmts(ctx, s.body, ind + "        ")
        ctx.out.push(ind + "    }")
        ctx.out.push(ind + "}")
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
    } else if s.kind == "return" {
        if s.value == -1 {
            ctx.out.push(ind + "return;")
        } else {
            # BUG-004 fix: if the return value expression is `never`-typed
            # (e.g. `return panic("...")` or `return match_all_never`),
            # emit just the side-effect call without a `return <value>;`
            # wrapper (the value is void and the surrounding code is
            # unreachable anyway — the call itself exits the process).
            let v: str = gen_expr(ctx, s.value)
            if ctx.exprs[s.value].t == "never" {
                ctx.out.push(ind + v + ";")
            } else {
                # Stage 8-beta ownership on return:
                #   * A BORROWED pointer value (an ident) gets one retain —
                #     the caller owns it; the binding's own retain is
                #     released by its cleanup as the scope exits.
                #   * A FRESH value transfers its inherent retain.
                #   * If the value moved bindings out via take(), null
                #     them BEFORE the return (an `x = NULL` after the
                #     return would be unreachable).
                let fresh: bool = expr_fresh(ctx, s.value)
                let rv: str = own_wrap(ctx, ctx.exprs[s.value].t, v, fresh)
                if ctx.null_after.len() > 0 {
                    let rt: str = ctx.exprs[s.value].t
                    let rt_c: str = c_type(ctx, rt)
                    if rt == "void" {
                        ctx.out.push(ind + v + ";")
                    } else {
                        let tmp: str = fresh_tmp(ctx, "hlc_rv")
                        ctx.out.push(ind + "{ " + rt_c + " " + tmp + " = " + rv + ";")
                        flush_null_after(ctx, ind + "    ")
                        ctx.out.push(ind + "    return " + tmp + "; }")
                    }
                } else {
                    ctx.out.push(ind + "return " + rv + ";")
                }
            }
        }
    } else if s.kind == "break" {
        ctx.out.push(ind + "break;")
    } else if s.kind == "continue" {
        ctx.out.push(ind + "continue;")
    } else if s.kind == "expr" {
        collect_hoist(ctx, s.e)
        hoist_all(ctx, ctx.out, ind)
        # Stage 8-beta: a discarded FRESH pointer value (e.g. `make();`
        # or a match used as a statement) still owns one retain — wrap it
        # in a cleanup temp so it is released instead of leaked.
        if is_ptr_t(ctx, ctx.exprs[s.e].t) && expr_fresh(ctx, s.e) {
            let tmp: str = fresh_tmp(ctx, "hlc_ed")
            ctx.out.push(ind + "{ " + c_type(ctx, ctx.exprs[s.e].t) + " " + tmp
                + " __attribute__((cleanup(" + cleanup_fn_for(ctx, ctx.exprs[s.e].t) + "))) = "
                + gen_expr(ctx, s.e) + "; }")
        } else {
            ctx.out.push(ind + gen_expr(ctx, s.e) + ";")
        }
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
    } else {
        panic("internal codegen error: unknown statement " + s.kind)
    }
}

fn gen_stmts(ctx: Ctx, stmts: list[int], ind: str) -> void {
    let mut i: int = 0
    while i < stmts.len() {
        gen_stmt(ctx, stmts.get(i), ind)
        i = i + 1
    }
}

fn gen_assign(ctx: Ctx, s: StmtN, ind: str) -> void {
    let tgt: int = s.target
    collect_hoist(ctx, s.value)
    # Hoist fresh subexpressions of the assignment TARGET too (e.g. a
    # call result whose field is assigned: `f().name = "x"`).
    collect_hoist(ctx, tgt)
    hoist_all(ctx, ctx.out, ind)
    let v: str = gen_expr(ctx, s.value)
    # BUG-004 fix: if the RHS is `never`-typed (e.g. `x = panic("...")`),
    # emit just the side-effect call without the assignment — the assignment
    # target is unreachable code.
    if ctx.exprs[s.value].t == "never" {
        ctx.out.push(ind + v + ";")
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
        return
    }
    let fresh: bool = expr_fresh(ctx, s.value)
    if ctx.exprs[tgt].kind == "ident" {
        let cn: str = local_c(ctx, ctx.exprs[tgt].name)
        let tgt_t: str = ctx.exprs[tgt].t
        if is_ptr_t(ctx, tgt_t) {
            # Stage 8-beta: release the old value AFTER storing the new
            # one (self-assignment safe: the new value is retained or
            # fresh before the old pointer is released).
            let wrapped: str = own_wrap(ctx, tgt_t, v, fresh)
            ctx.out.push(ind + "{ " + c_type(ctx, tgt_t) + " __hl_old = " + cn + "; "
                + cn + " = " + wrapped + "; " + release_call(ctx, tgt_t, "__hl_old") + "; }")
        } else {
            ctx.out.push(ind + cn + " = " + v + ";")
        }
    } else if ctx.exprs[tgt].kind == "field" {
        let base_t: str = ctx.exprs[ctx.exprs[tgt].left].t
        let base: str = gen_expr(ctx, ctx.exprs[tgt].left)
        let ftype: str = ctx.exprs[tgt].t
        let fname: str = ctx.exprs[tgt].name
        if is_ptr_t(ctx, ftype) {
            # Materialise the base once (calling it twice would
            # double-evaluate), then store-then-release.
            let bt: str = fresh_tmp(ctx, "hlc_fb")
            let wrapped: str = own_wrap(ctx, ftype, v, fresh)
            ctx.out.push(ind + "{ " + c_type(ctx, base_t) + " " + bt + " = " + base + ";")
            ctx.out.push(ind + "  " + c_type(ctx, ftype) + " __hl_old = " + bt + "->" + fname + ";")
            ctx.out.push(ind + "  " + bt + "->" + fname + " = " + wrapped + ";")
            ctx.out.push(ind + "  " + release_call(ctx, ftype, "__hl_old") + "; }")
        } else {
            ctx.out.push(ind + "(" + base + ")->" + fname + " = " + v + ";")
        }
    } else {
        let elem_t: str = list_elem_t(ctx.exprs[ctx.exprs[tgt].left].t)
        let lst: str = gen_expr(ctx, ctx.exprs[tgt].left)
        let idx: str = gen_expr(ctx, ctx.exprs[tgt].right)
        # hl_list_set releases the old element itself (store-then-release
        # inside the runtime); the new value arrives owned.
        let wrapped: str = gen_store_val(ctx, elem_t, v, fresh)
        ctx.out.push(ind + "hl_list_set(" + lst + ", " + idx + ", " + wrapped + ");")
    }
    flush_null_after(ctx, ind)
    clear_hoists(ctx)
}


# --- Function generation ---

fn gen_reset_fn(ctx: Ctx) -> void {
    ctx.gen_locals = map_new()
    ctx.gen_counts = map_new()
    ctx.hoist_map = map_new()
    ctx.null_after = []
}

# gen_param_locals: Stage 8-beta — function parameters OWN one retain of
# each argument. C cannot attach a cleanup attribute to a parameter, so
# the signature uses a `<name>_p` parameter and the body starts with a
# local `u_<name>` copy carrying the cleanup attribute. The body's code
# references the local (via gen_locals), never the raw parameter.
fn gen_param_locals(ctx: Ctx, f: FnInfo, ptypes_c: list[str], param_local_names: list[str], sig_params: list[str]) -> void {
    let mut i: int = 0
    while i < f.params.len() {
        let cn: str = fresh_local(ctx, f.params.get(i))
        param_local_names.push(cn)
        sig_params.push(ptypes_c.get(i) + " " + cn + "_p")
        i = i + 1
    }
}

# emit_param_local_decls: emit the `u_x = u_x_p` declarations (with
# cleanups for pointer types) at the top of a function body.
fn emit_param_local_decls(ctx: Ctx, f: FnInfo, inst_ptypes: list[str], param_local_names: list[str]) -> void {
    let mut i: int = 0
    while i < f.params.len() {
        let cn: str = param_local_names.get(i)
        let pt: str = inst_ptypes.get(i)
        if is_ptr_t(ctx, pt) {
            ctx.out.push("    " + c_type(ctx, pt) + " " + cn
                + " __attribute__((cleanup(" + cleanup_fn_for(ctx, pt) + "))) = " + cn + "_p;")
        } else {
            ctx.out.push("    " + c_type(ctx, pt) + " " + cn + " = " + cn + "_p;")
        }
        i = i + 1
    }
}

fn gen_fn_body(ctx: Ctx, key: str) -> void {
    let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
    # Stage 15-beta: extern fns are forward declarations for C functions.
    # Emit just the prototype (no body) using the RAW C name (no `usf_`
    # prefix) so the C linker can resolve them from libc.
    if f.is_extern {
        gen_reset_fn(ctx)
        let ptypes_c: list[str] = []
        let mut i: int = 0
        while i < f.params.len() {
            ptypes_c.push(c_type(ctx, f.ptypes.get(i)))
            i = i + 1
        }
        let mut sig: str = c_type(ctx, f.ret) + " " + f.name + "("
        if ptypes_c.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(ptypes_c, ", ") + ")"
        }
        ctx.out.push(sig + ";")
        ctx.out.push("")
        return
    }
    gen_reset_fn(ctx)
    let ptypes_c: list[str] = []
    let inst_ptypes: list[str] = []
    let mut i: int = 0
    while i < f.params.len() {
        inst_ptypes.push(f.ptypes.get(i))
        ptypes_c.push(c_type(ctx, f.ptypes.get(i)))
        i = i + 1
    }
    # Stage 8-beta: parameters own one retain of each argument. The
    # signature carries `<name>_p` params; the body starts with owned
    # local copies (see gen_param_locals / emit_param_local_decls).
    let param_local_names: list[str] = []
    let sig_params: list[str] = []
    gen_param_locals(ctx, f, ptypes_c, param_local_names, sig_params)
    # For generic functions, we emit a specialization. The "key" passed in is
    # the original key; we generate a specialization with a mangled name when
    # the function has type params. The specialization instantiation is
    # handled in gen_program by enumerating instantiations.
    let mut fname: str = "usf_" + c_fn_name(key)
    # BUG-010 fix: removed dead branch that built a mangled name from the
    # type-parameter NAMES (e.g. "T") instead of the type ARGS (e.g. "int").
    # That branch was unreachable because gen_program never routes generic
    # functions through gen_fn_body — they go through gen_fn_inst_lines.
    let mut sig: str = c_type(ctx, f.ret) + " " + fname + "("
    if sig_params.len() == 0 {
        sig = sig + "void)"
    } else {
        sig = sig + join(sig_params, ", ") + ")"
    }
    ctx.out.push(sig + " {")
    emit_param_local_decls(ctx, f, inst_ptypes, param_local_names)
    gen_stmts(ctx, f.body, "    ")
    ctx.out.push("}")
    ctx.out.push("")
}

fn gen_struct_lines(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let names: list[str] = ctx.structs.keys()
    let mut i: int = 0
    while i < names.len() {
        let st: StructInfo = ctx.structs.get_or(names.get(i), dummy_struct())
        # For non-generic structs, emit a typedef and constructor.
        # For generic structs, the instantiations are emitted separately
        # (driven by gen_program which tracks all instantiations used).
        if st.typeparams.len() == 0 {
            let empty_targs: list[str] = []
            concat_lines(out, gen_one_struct_full(ctx, st.name, st, empty_targs))
        }
        i = i + 1
    }
    return out
}

# gen_one_struct_full: typedef (refcnt first) + constructor + release +
# cleanup for one struct definition (targs empty for non-generic).
fn gen_one_struct_full(ctx: Ctx, c_name: str, st: StructInfo, targs: list[str]) -> list[str] {
    let mut out: list[str] = []
    # 1. typedef — refcnt is the FIRST field so hl_retain works uniformly.
    out.push("typedef struct " + c_name + " {")
    out.push("    int64_t refcnt;")
    let mut j: int = 0
    while j < st.fields.len() {
        let ftype: str = st.ftypes.get(j)
        let mut inst_ftype: str = ""
        if st.typeparams.len() > 0 {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        } else {
            inst_ftype = ftype
        }
        out.push("    " + c_type(ctx, inst_ftype) + " " + st.fields.get(j) + ";")
        j = j + 1
    }
    out.push("} " + c_name + ";")
    out.push("")
    # 2. constructor — stores its params raw: they arrive OWNED (the
    # call site own-wraps each field value). refcnt starts at 1.
    # The constructor takes ALL fields as parameters — gen_structlit
    # passes the provided values plus the default expressions evaluated
    # at the literal site (fresh values whose ownership transfers here).
    let ptypes_c: list[str] = []
    let assigns: list[str] = []
    let mut j2: int = 0
    while j2 < st.fields.len() {
        let ftype: str = st.ftypes.get(j2)
        let mut inst_ftype: str = ""
        if st.typeparams.len() > 0 {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        } else {
            inst_ftype = ftype
        }
        ptypes_c.push(c_type(ctx, inst_ftype) + " " + st.fields.get(j2))
        assigns.push("    p->" + st.fields.get(j2) + " = " + st.fields.get(j2) + ";")
        j2 = j2 + 1
    }
    out.push("static " + c_name + "* usf_new_" + c_name + "(" + join(ptypes_c, ", ") + ") {")
    out.push("    " + c_name + "* p = (" + c_name + "*)malloc(sizeof(" + c_name + "));")
    out.push("    if (!p) hl_die(\"out of memory\");")
    out.push("    p->refcnt = 1;")
    let mut k: int = 0
    while k < assigns.len() {
        out.push(assigns.get(k))
        k = k + 1
    }
    out.push("    return p;")
    out.push("}")
    out.push("")
    # 3. release + cleanup (Stage 8-beta).
    concat_lines(out, gen_struct_release_lines(ctx, c_name, st, targs))
    return out
}

# gen_struct_release_lines: the refcounted destructor + cleanup wrapper.
# Only the pointer-typed fields are released; primitives are inline C data.
fn gen_struct_release_lines(ctx: Ctx, c_name: str, st: StructInfo, targs: list[str]) -> list[str] {
    let mut out: list[str] = []
    out.push("static void hl_release_" + c_name + "(void* pv) {")
    out.push("    " + c_name + "* p = (" + c_name + "*)pv;")
    out.push("    if (!p) return;")
    out.push("    if (--p->refcnt == 0) {")
    let mut j: int = 0
    while j < st.fields.len() {
        let ftype: str = st.ftypes.get(j)
        let mut inst_ftype: str = ""
        if st.typeparams.len() > 0 {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        } else {
            inst_ftype = ftype
        }
        if is_ptr_t(ctx, inst_ftype) {
            out.push("        " + release_call(ctx, inst_ftype, "p->" + st.fields.get(j)) + ";")
        }
        j = j + 1
    }
    out.push("        free(p);")
    out.push("    }")
    out.push("}")
    out.push("static void hl_cleanup_" + c_name + "(" + c_name + "** p) { hl_release_" + c_name + "(*p); }")
    out.push("")
    return out
}

# gen_one_enum_full(ctx, c_name, en, targs) emits a complete C enum definition +
# variant constructors + release/cleanup. `c_name` is the mangled C identifier
# (e.g., "Option__int"), `en` is the EnumInfo, `targs` are the concrete type args
# (parallel to en.typeparams, empty for non-generic).
fn gen_one_enum_full(ctx: Ctx, c_name: str, en: EnumInfo, targs: list[str]) -> list[str] {
    let mut out: list[str] = []
    # 1. Tag enum.
    out.push("typedef enum {")
    let mut vi: int = 0
    let mut tag_line: str = "    "
    while vi < en.variants.len() {
        if vi > 0 {
            tag_line = tag_line + ", "
        }
        tag_line = tag_line + en.name + "__TAG_" + en.variants.get(vi) + "_" + c_name
        vi = vi + 1
    }
    out.push(tag_line)
    out.push("} " + c_name + "_Tag;")
    out.push("")
    # 2. Struct with refcnt + tag + union of PER-VARIANT structs (each
    # variant has its own struct containing all its payloads, so payloads
    # don't overlap).
    out.push("typedef struct " + c_name + " {")
    out.push("    int64_t refcnt;")
    out.push("    " + c_name + "_Tag tag;")
    out.push("    union {")
    let mut vi2: int = 0
    while vi2 < en.variants.len() {
        let payloads: list[str] = en.payloads.get(vi2)
        let vname: str = en.variants.get(vi2)
        if payloads.len() > 0 {
            out.push("        struct {")
            let mut pi: int = 0
            while pi < payloads.len() {
                let pt: str = payloads.get(pi)
                let mut inst_pt: str = ""
                if en.typeparams.len() > 0 {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                } else {
                    inst_pt = pt
                }
                out.push("            " + c_type(ctx, inst_pt) + " v" + pi.to_str() + ";")
                pi = pi + 1
            }
            out.push("        } " + vname + ";")
        }
        vi2 = vi2 + 1
    }
    out.push("    } data;")
    out.push("} " + c_name + ";")
    out.push("")
    # 3. Constructor per variant — stores its payloads raw (they arrive
    # OWNED from the call site). refcnt starts at 1.
    let mut vi3: int = 0
    while vi3 < en.variants.len() {
        let vname: str = en.variants.get(vi3)
        let payloads: list[str] = en.payloads.get(vi3)
        let params: list[str] = []
        let mut pi2: int = 0
        while pi2 < payloads.len() {
            let pt: str = payloads.get(pi2)
            let mut inst_pt: str = ""
            if en.typeparams.len() > 0 {
                inst_pt = instantiate_type(pt, en.typeparams, targs)
            } else {
                inst_pt = pt
            }
            params.push(c_type(ctx, inst_pt) + " v" + pi2.to_str())
            pi2 = pi2 + 1
        }
        let mut param_sig: str = "void"
        if params.len() > 0 {
            param_sig = join(params, ", ")
        }
        out.push("static " + c_name + "* usf_make_" + c_name + "_" + vname + "(" + param_sig + ") {")
        out.push("    " + c_name + "* p = (" + c_name + "*)malloc(sizeof(" + c_name + "));")
        out.push("    if (!p) hl_die(\"out of memory\");")
        out.push("    p->refcnt = 1;")
        out.push("    p->tag = " + en.name + "__TAG_" + vname + "_" + c_name + ";")
        let mut pi3: int = 0
        while pi3 < payloads.len() {
            out.push("    p->data." + vname + ".v" + pi3.to_str() + " = v" + pi3.to_str() + ";")
            pi3 = pi3 + 1
        }
        out.push("    return p;")
        out.push("}")
        out.push("")
        vi3 = vi3 + 1
    }
    # 4. release + cleanup (Stage 8-beta). Only the ACTIVE variant's
    # payloads are valid to read — dispatch on the tag.
    out.push("static void hl_release_" + c_name + "(void* pv) {")
    out.push("    " + c_name + "* p = (" + c_name + "*)pv;")
    out.push("    if (!p) return;")
    out.push("    if (--p->refcnt == 0) {")
    out.push("        switch (p->tag) {")
    let mut vi4: int = 0
    while vi4 < en.variants.len() {
        let vname: str = en.variants.get(vi4)
        let payloads: list[str] = en.payloads.get(vi4)
        if payloads.len() > 0 {
            out.push("            case " + en.name + "__TAG_" + vname + "_" + c_name + ":")
            let mut pi4: int = 0
            while pi4 < payloads.len() {
                let pt: str = payloads.get(pi4)
                let mut inst_pt: str = ""
                if en.typeparams.len() > 0 {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                } else {
                    inst_pt = pt
                }
                if is_ptr_t(ctx, inst_pt) {
                    out.push("                " + release_call(ctx, inst_pt, "p->data." + vname + ".v" + pi4.to_str()) + ";")
                }
                pi4 = pi4 + 1
            }
            out.push("                break;")
        }
        vi4 = vi4 + 1
    }
    out.push("            default: break;")
    out.push("        }")
    out.push("        free(p);")
    out.push("    }")
    out.push("}")
    out.push("static void hl_cleanup_" + c_name + "(" + c_name + "** p) { hl_release_" + c_name + "(*p); }")
    out.push("")
    return out
}

# gen_struct_instantiation(ctx, t) emits a typedef + constructor for a generic
# struct instantiation. `t` is the full type string like "Box[int]".
fn gen_struct_instantiation(ctx: Ctx, t: str) -> list[str] {
    let base: str = type_base(t)
    let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
    let targs: list[str] = type_args(t)
    let c_name: str = c_type_name(t)
    return gen_one_struct_full(ctx, c_name, st, targs)
}


# --- Function prototype + instantiation generation ---

fn gen_proto_lines(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let mut key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if f.typeparams.len() > 0 {
            # Skip generic functions here — their prototypes are emitted
            # with the instantiations in gen_fn_inst_lines.
            i = i + 1
            continue
        }
        let ptypes_c: list[str] = []
        let mut j: int = 0
        while j < f.params.len() {
            ptypes_c.push(c_type(ctx, f.ptypes.get(j)))
            j = j + 1
        }
        let mut sig: str = c_type(ctx, f.ret) + " usf_" + c_fn_name(key) + "("
        if ptypes_c.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(ptypes_c, ", ") + ")"
        }
        out.push(sig + ";")
        i = i + 1
    }
    # Also emit prototypes for generic function instantiations.
    let mut j2: int = 0
    while j2 < ctx.fn_insts.len() {
        let inst: str = ctx.fn_insts.get(j2)
        let parsed: list[str] = parse_inst_str(inst)
        # parsed[0] = key, parsed[1..n] = type args
        let key: str = parsed.get(0)
        let targs: list[str] = list_slice_from(parsed, 1)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        let ptypes_c: list[str] = []
        let mut k: int = 0
        while k < f.params.len() {
            let inst_pt: str = instantiate_type(f.ptypes.get(k), f.typeparams, targs)
            ptypes_c.push(c_type(ctx, inst_pt))
            k = k + 1
        }
        let mut ret_str: str = instantiate_type(f.ret, f.typeparams, targs)
        let mut sig: str = c_type(ctx, ret_str) + " usf_" + c_mangled_fn_name(key, f.typeparams, targs) + "("
        if ptypes_c.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(ptypes_c, ", ") + ")"
        }
        out.push(sig + ";")
        j2 = j2 + 1
    }
    out.push("")
    return out
}

# parse_inst_str(s) parses "key|arg1,arg2,..." into [key, arg1, arg2, ...].
fn parse_inst_str(s: str) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    let mut key: str = ""
    while i < s.len() {
        if s.byte_at(i) == 124 {
            key = s.slice(0, i)
            break
        }
        i = i + 1
    }
    if key == "" {
        out.push(s)
        return out
    }
    out.push(key)
    let args_str: str = s.slice(i + 1, s.len())
    if args_str == "" {
        return out
    }
    let args: list[str] = split_args_str(args_str)
    let mut j: int = 0
    while j < args.len() {
        out.push(args.get(j))
        j = j + 1
    }
    return out
}

# gen_fn_inst_lines(ctx) emits the body for each generic function
# instantiation recorded in ctx.fn_insts.
fn gen_fn_inst_lines(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let mut i: int = 0
    while i < ctx.fn_insts.len() {
        let inst: str = ctx.fn_insts.get(i)
        let parsed: list[str] = parse_inst_str(inst)
        let key: str = parsed.get(0)
        let targs: list[str] = list_slice_from(parsed, 1)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        gen_reset_fn(ctx)
        # BUG-002 fix: for generic methods on generic structs, we need to
        # combine the struct's type params with the method's. The targs list
        # carries BOTH (struct's args first, then method's args) — see how
        # check_method composes `all_targs`. We mirror that here to build
        # the combined typeparams list and pass the right targs slice.
        let mut combined_tps: list[str] = []
        let mut struct_tps_count: int = 0
        if f.is_method && f.struct_of != "" {
            let st: StructInfo = ctx.structs.get_or(f.struct_of, dummy_struct())
            let mut si: int = 0
            while si < st.typeparams.len() {
                combined_tps.push(st.typeparams.get(si))
                si = si + 1
            }
            struct_tps_count = st.typeparams.len()
        }
        let mut mi: int = 0
        while mi < f.typeparams.len() {
            combined_tps.push(f.typeparams.get(mi))
            mi = mi + 1
        }
        # The method's own type params are appended to combined_tps above;
        # the body uses ctx.cur_typeparams + ctx.cur_targs for instantiation.
        ctx.cur_typeparams = combined_tps
        ctx.cur_targs = targs
        # Build the signature. Stage 8-beta: parameters own one retain of
        # each argument — `<name>_p` in the signature, owned local copies
        # with cleanups at the top of the body.
        let ptypes_c: list[str] = []
        let inst_ptypes: list[str] = []
        let param_local_names: list[str] = []
        let sig_params: list[str] = []
        let mut j: int = 0
        while j < f.params.len() {
            let inst_pt: str = instantiate_type(f.ptypes.get(j), combined_tps, targs)
            inst_ptypes.push(inst_pt)
            ptypes_c.push(c_type(ctx, inst_pt))
            j = j + 1
        }
        gen_param_locals(ctx, f, ptypes_c, param_local_names, sig_params)
        let ret_str: str = instantiate_type(f.ret, combined_tps, targs)
        let mut sig: str = c_type(ctx, ret_str) + " usf_" + c_mangled_fn_name(key, combined_tps, targs) + "("
        if sig_params.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(sig_params, ", ") + ")"
        }
        out.push(sig + " {")
        # Emit statements. The gen_stmt / gen_expr functions need to use
        # inst_t for types. We achieve this by intercepting in c_type via
        # the ctx.cur_typeparams + ctx.cur_targs.
        let saved_out: list[str] = ctx.out
        ctx.out = []
        emit_param_local_decls(ctx, f, inst_ptypes, param_local_names)
        gen_stmts(ctx, f.body, "    ")
        let mut k: int = 0
        while k < ctx.out.len() {
            out.push(ctx.out.get(k))
            k = k + 1
        }
        ctx.out = saved_out
        out.push("}")
        out.push("")
        ctx.cur_typeparams = []
        ctx.cur_targs = []
        i = i + 1
    }
    return out
}

# ============================================================================
# 4d. STAGE 8-BETA: clone() PER-INSTANTIATION HELPERS
# ----------------------------------------------------------------------------
# clone() now supports EVERY owned type (str, list, map, struct, enum,
# tainted[...]) via generated helpers `hl_clone_<mangled-type>`. Each
# helper deep-copies: primitives by value, pointers by recursively
# cloning. Recursion is guarded by registration (clone_insts).
# ============================================================================

# clone_expr_for: the C expression cloning `cexpr` of HLS type t.
fn clone_expr_for(ctx: Ctx, t: str, cexpr: str) -> str {
    let tt: str = strip_taint(inst_t(ctx, t))
    if tt == "int" || tt == "float" || tt == "bool" {
        return cexpr
    }
    if tt == "str" {
        return "hl_clone_str(" + cexpr + ")"
    }
    return "hl_clone_" + c_type_name(tt) + "(" + cexpr + ")"
}

# register_clone: record that a clone helper is needed for `t` (plus,
# recursively, for every owned child type its body will clone).
fn register_clone(ctx: Ctx, t: str) -> void {
    let tt: str = strip_taint(t)
    if tt == "int" || tt == "float" || tt == "bool" || tt == "str" {
        return
    }
    if list_has(ctx.clone_insts, t) {
        return
    }
    ctx.clone_insts.push(t)
    if is_list_t(tt) {
        register_clone(ctx, list_elem_t(tt))
        return
    }
    if is_map_t(tt) {
        register_clone(ctx, map_val_t(tt))
        return
    }
    # User struct: register each pointer field's type.
    let sbase: str = type_base(tt)
    if ctx.structs.has(sbase) {
        let st: StructInfo = ctx.structs.get_or(sbase, dummy_struct())
        let targs: list[str] = type_args(tt)
        let mut j: int = 0
        while j < st.fields.len() {
            let ftype: str = st.ftypes.get(j)
            let mut inst_ftype: str = ftype
            if st.typeparams.len() > 0 && targs.len() == st.typeparams.len() {
                inst_ftype = instantiate_type(ftype, st.typeparams, targs)
            }
            if is_ptr_t(ctx, inst_ftype) {
                register_clone(ctx, inst_ftype)
            }
            j = j + 1
        }
        return
    }
    # User enum: register each pointer payload's type (per variant).
    let ebase: str = type_base(tt)
    if ctx.enums.has(ebase) {
        let en: EnumInfo = ctx.enums.get_or(ebase, dummy_enum())
        let targs: list[str] = type_args(tt)
        let mut vi: int = 0
        while vi < en.variants.len() {
            let payloads: list[str] = en.payloads.get(vi)
            let mut pi: int = 0
            while pi < payloads.len() {
                let pt: str = payloads.get(pi)
                let mut inst_pt: str = pt
                if en.typeparams.len() > 0 && targs.len() == en.typeparams.len() {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                }
                if is_ptr_t(ctx, inst_pt) {
                    register_clone(ctx, inst_pt)
                }
                pi = pi + 1
            }
            vi = vi + 1
        }
        return
    }
}

# clone_fn_proto: the prototype line for the clone helper of type t.
fn clone_fn_proto(ctx: Ctx, t: str) -> str {
    let tt: str = strip_taint(t)
    if is_list_t(tt) {
        return "static hl_list* hl_clone_" + c_type_name(tt) + "(hl_list* l);"
    }
    if is_map_t(tt) {
        return "static hl_map* hl_clone_" + c_type_name(tt) + "(hl_map* m);"
    }
    # c_type() already returns a pointer for user types — use the raw
    # mangled name so the prototype is `static T* hl_clone_T(T* p);`.
    return "static " + c_type_name(tt) + "* hl_clone_" + c_type_name(tt) + "(" + c_type_name(tt) + "* p);"
}

# gen_clone_list_lines: the body for clone(list[E]).
fn gen_clone_list_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let elem: str = list_elem_t(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy with fresh boxes / cloned elements.")
    out.push("static hl_list* hl_clone_" + m + "(hl_list* l) {")
    out.push("    hl_list* r = hl_list_new(" + elem_free_fn(ctx, elem) + ");")
    out.push("    for (int64_t i = 0; i < l->len; i++) {")
    if elem == "int" {
        out.push("        hl_list_push(r, hl_box_i64(hl_unbox_i64(l->items[i])));")
    } else if elem == "float" {
        out.push("        hl_list_push(r, hl_box_f64(hl_unbox_f64(l->items[i])));")
    } else if elem == "bool" {
        out.push("        hl_list_push(r, hl_box_bool(hl_unbox_bool(l->items[i])));")
    } else {
        out.push("        hl_list_push(r, " + clone_expr_for(ctx, elem, "(" + c_type(ctx, elem) + ")l->items[i]") + ");")
    }
    out.push("    }")
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_map_lines: the body for clone(map[str, V]).
fn gen_clone_map_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let vt: str = map_val_t(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy with cloned keys and values.")
    out.push("static hl_map* hl_clone_" + m + "(hl_map* m) {")
    out.push("    hl_map* r = hl_map_new(" + elem_free_fn(ctx, vt) + ");")
    out.push("    for (int64_t i = 0; i < m->len; i++) {")
    out.push("        hl_str* k = m->order[i];")
    out.push("        void* v = hl_map_borrow(m, k);")
    out.push("        if (v == NULL) continue;")
    if vt == "int" {
        out.push("        hl_map_set(r, hl_clone_str(k), hl_box_i64(hl_unbox_i64(v)));")
    } else if vt == "float" {
        out.push("        hl_map_set(r, hl_clone_str(k), hl_box_f64(hl_unbox_f64(v)));")
    } else if vt == "bool" {
        out.push("        hl_map_set(r, hl_clone_str(k), hl_box_bool(hl_unbox_bool(v)));")
    } else {
        out.push("        hl_map_set(r, hl_clone_str(k), " + clone_expr_for(ctx, vt, "(" + c_type(ctx, vt) + ")v") + ");")
    }
    out.push("    }")
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_struct_lines: the body for clone(<struct instantiation>).
fn gen_clone_struct_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let sbase: str = type_base(tt)
    let st: StructInfo = ctx.structs.get_or(sbase, dummy_struct())
    let targs: list[str] = type_args(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy of every field.")
    out.push("static " + m + "* hl_clone_" + m + "(" + m + "* p) {")
    out.push("    " + m + "* r = (" + m + "*)malloc(sizeof(" + m + "));")
    out.push("    if (!r) hl_die(\"out of memory\");")
    out.push("    r->refcnt = 1;")
    let mut j: int = 0
    while j < st.fields.len() {
        let ftype: str = st.ftypes.get(j)
        let mut inst_ftype: str = ftype
        if st.typeparams.len() > 0 && targs.len() == st.typeparams.len() {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        }
        out.push("    r->" + st.fields.get(j) + " = " + clone_expr_for(ctx, inst_ftype, "p->" + st.fields.get(j)) + ";")
        j = j + 1
    }
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_enum_lines: the body for clone(<enum instantiation>). Only the
# active variant's payloads are copied (reading another variant's union
# arm would be undefined behaviour).
fn gen_clone_enum_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let ebase: str = type_base(tt)
    let en: EnumInfo = ctx.enums.get_or(ebase, dummy_enum())
    let targs: list[str] = type_args(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy of the active variant's payloads.")
    out.push("static " + m + "* hl_clone_" + m + "(" + m + "* p) {")
    out.push("    " + m + "* r = (" + m + "*)malloc(sizeof(" + m + "));")
    out.push("    if (!r) hl_die(\"out of memory\");")
    out.push("    r->refcnt = 1;")
    out.push("    r->tag = p->tag;")
    out.push("    switch (p->tag) {")
    let mut vi: int = 0
    while vi < en.variants.len() {
        let vname: str = en.variants.get(vi)
        let payloads: list[str] = en.payloads.get(vi)
        if payloads.len() > 0 {
            out.push("        case " + en.name + "__TAG_" + vname + "_" + m + ": {")
            let mut pi: int = 0
            while pi < payloads.len() {
                let pt: str = payloads.get(pi)
                let mut inst_pt: str = pt
                if en.typeparams.len() > 0 && targs.len() == en.typeparams.len() {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                }
                out.push("            r->data." + vname + ".v" + pi.to_str()
                    + " = " + clone_expr_for(ctx, inst_pt, "p->data." + vname + ".v" + pi.to_str()) + ";")
                pi = pi + 1
            }
            out.push("            break;")
            out.push("        }")
        }
        vi = vi + 1
    }
    out.push("        default: break;")
    out.push("    }")
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_bodies: bodies for every registered clone instantiation.
fn gen_clone_bodies(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let mut i: int = 0
    while i < ctx.clone_insts.len() {
        let t: str = ctx.clone_insts.get(i)
        let tt: str = strip_taint(t)
        if is_list_t(tt) {
            concat_lines(out, gen_clone_list_lines(ctx, tt))
        } else if is_map_t(tt) {
            concat_lines(out, gen_clone_map_lines(ctx, tt))
        } else if ctx.structs.has(type_base(tt)) {
            concat_lines(out, gen_clone_struct_lines(ctx, tt))
        } else if ctx.enums.has(type_base(tt)) {
            concat_lines(out, gen_clone_enum_lines(ctx, tt))
        }
        i = i + 1
    }
    return out
}

# gen_ownership_protos: forward declarations for every release / cleanup /
# clone helper so struct/enum/clone definitions can reference each other
# regardless of emission order (mutual recursion: a struct containing a
# list of structs, an enum whose payload is the enum itself, ...).
fn gen_ownership_protos(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    out.push("// ---- Stage 8-beta: ownership helper prototypes ----")
    let snames: list[str] = ctx.structs.keys()
    let mut i: int = 0
    while i < snames.len() {
        let st: StructInfo = ctx.structs.get_or(snames.get(i), dummy_struct())
        if st.typeparams.len() == 0 {
            out.push("static void hl_release_" + st.name + "(void* p);")
            out.push("static void hl_cleanup_" + st.name + "(" + st.name + "** p);")
        }
        i = i + 1
    }
    let mut si: int = 0
    while si < ctx.struct_insts.len() {
        let m: str = c_type_name(ctx.struct_insts.get(si))
        out.push("static void hl_release_" + m + "(void* p);")
        out.push("static void hl_cleanup_" + m + "(" + m + "** p);")
        si = si + 1
    }
    let enames: list[str] = ctx.enums.keys()
    let mut ei: int = 0
    while ei < enames.len() {
        let en: EnumInfo = ctx.enums.get_or(enames.get(ei), dummy_enum())
        if en.typeparams.len() == 0 {
            out.push("static void hl_release_" + en.name + "(void* p);")
            out.push("static void hl_cleanup_" + en.name + "(" + en.name + "** p);")
        }
        ei = ei + 1
    }
    let mut eii: int = 0
    while eii < ctx.enum_insts.len() {
        let m: str = c_type_name(ctx.enum_insts.get(eii))
        out.push("static void hl_release_" + m + "(void* p);")
        out.push("static void hl_cleanup_" + m + "(" + m + "** p);")
        eii = eii + 1
    }
    let mut ci: int = 0
    while ci < ctx.clone_insts.len() {
        out.push(clone_fn_proto(ctx, ctx.clone_insts.get(ci)))
        ci = ci + 1
    }
    out.push("")
    return out
}

# --- Top-level program generation ---

fn gen_program(ctx: Ctx) -> list[str] {
    # 1. emit function bodies first (they collect struct/enum/clone
    # instantiations as they are generated).
    ctx.out = []
    ctx.clone_insts = []
    ctx.tmp = 0
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if f.typeparams.len() > 0 {
            # Generic function — skip here; we emit per instantiation later.
            i = i + 1
            continue
        }
        gen_fn_body(ctx, key)
        i = i + 1
    }
    # 1b. emit generic function instantiation bodies.
    let fn_inst_bodies: list[str] = gen_fn_inst_lines(ctx)
    let bodies: list[str] = ctx.out
    # 2. concatenate in order: header -> runtime -> forward typedefs ->
    #    ownership protos -> struct/enum defs -> clone bodies -> fn protos
    #    -> bodies -> main
    let final: list[str] = []
    final.push("// =============================================================")
    final.push("// C code generated BY hlc — the Hieu Louis compiler (HLS)")
    final.push("// The HLS source is compiled by hlc itself (self-hosted).")
    final.push("// =============================================================")
    final.push("")
    concat_lines(final, runtime_lines())
    final.push("")
    # 2a. Forward declarations for ALL structs and enums (recursive types).
    let struct_names: list[str] = ctx.structs.keys()
    let mut sni: int = 0
    while sni < struct_names.len() {
        let st: StructInfo = ctx.structs.get_or(struct_names.get(sni), dummy_struct())
        if st.typeparams.len() == 0 {
            final.push("typedef struct " + st.name + " " + st.name + ";")
        }
        sni = sni + 1
    }
    let mut si2: int = 0
    while si2 < ctx.struct_insts.len() {
        final.push("typedef struct " + c_type_name(ctx.struct_insts.get(si2)) + " " + c_type_name(ctx.struct_insts.get(si2)) + ";")
        si2 = si2 + 1
    }
    let enum_names: list[str] = ctx.enums.keys()
    let mut eni: int = 0
    while eni < enum_names.len() {
        let en: EnumInfo = ctx.enums.get_or(enum_names.get(eni), dummy_enum())
        if en.typeparams.len() == 0 {
            final.push("typedef struct " + en.name + " " + en.name + ";")
        }
        eni = eni + 1
    }
    let mut ei2: int = 0
    while ei2 < ctx.enum_insts.len() {
        final.push("typedef struct " + c_type_name(ctx.enum_insts.get(ei2)) + " " + c_type_name(ctx.enum_insts.get(ei2)) + ";")
        ei2 = ei2 + 1
    }
    final.push("")
    # 2a-bis. Stage 8-beta: ownership helper prototypes (release / cleanup /
    # clone) so the struct/enum/clone definitions below can reference each
    # other in any order.
    concat_lines(final, gen_ownership_protos(ctx))
    concat_lines(final, gen_struct_lines(ctx))
    # 2b. emit generic struct instantiations.
    let mut si: int = 0
    while si < ctx.struct_insts.len() {
        let inst_t: str = ctx.struct_insts.get(si)
        concat_lines(final, gen_struct_instantiation(ctx, inst_t))
        si = si + 1
    }
    # 2c. emit non-generic enums.
    concat_lines(final, gen_enum_lines_simple(ctx))
    # 2d. emit generic enum instantiations.
    let mut ei: int = 0
    while ei < ctx.enum_insts.len() {
        let inst_t: str = ctx.enum_insts.get(ei)
        let base: str = type_base(inst_t)
        let en: EnumInfo = ctx.enums.get_or(base, dummy_enum())
        let targs: list[str] = type_args(inst_t)
        concat_lines(final, gen_one_enum_full(ctx, c_type_name(inst_t), en, targs))
        ei = ei + 1
    }
    # 2e. Stage 8-beta: clone() per-instantiation helper bodies.
    concat_lines(final, gen_clone_bodies(ctx))
    concat_lines(final, gen_proto_lines(ctx))
    concat_lines(final, bodies)
    concat_lines(final, fn_inst_bodies)
    # 3. main wrapper
    let mf: FnInfo = ctx.fns.get_or("main", dummy_fn())
    final.push("int main(int argc, char** argv) {")
    final.push("    hl_init_args(argc, argv);")
    if mf.ret == "int" {
        final.push("    return (int)(usf_main());")
    } else {
        final.push("    usf_main();")
        final.push("    return 0;")
    }
    final.push("}")
    return final
}

# gen_enum_lines_simple — emit non-generic enum typedefs + variant constructors.
fn gen_enum_lines_simple(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let names: list[str] = ctx.enums.keys()
    let mut i: int = 0
    while i < names.len() {
        let en: EnumInfo = ctx.enums.get_or(names.get(i), dummy_enum())
        if en.typeparams.len() == 0 {
            let empty_targs: list[str] = []
            concat_lines(out, gen_one_enum_full(ctx, en.name, en, empty_targs))
        }
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# ----------------------------------------------------------------------------
# 6. MAIN — full pipeline: LEX -> PARSE -> CHECK -> GEN -> WRITE C
# ----------------------------------------------------------------------------

# dir_of(path) returns the directory component of a path (everything before
# the last '/'), or "." if the path has no slash.
fn dir_of(path: str) -> str {
    let mut i: int = path.len() - 1
    while i >= 0 {
        if path.byte_at(i) == 47 {
            if i == 0 {
                return "/"
            }
            return path.slice(0, i)
        }
        i = i - 1
    }
    return "."
}

# join_path(dir, rel) joins a directory and a relative path with a single
# slash. Does NOT handle ".." — uses string concatenation.
fn join_path(dir: str, rel: str) -> str {
    if dir == "." {
        return rel
    }
    if dir.len() == 0 {
        return rel
    }
    if dir.byte_at(dir.len() - 1) == 47 {
        return dir + rel
    }
    return dir + "/" + rel
}

# parent_dir(dir) returns the parent directory of dir.
fn parent_dir(dir: str) -> str {
    let mut i: int = dir.len() - 1
    while i >= 0 {
        if dir.byte_at(i) == 47 {
            if i == 0 {
                return "/"
            }
            return dir.slice(0, i)
        }
        i = i - 1
    }
    return "."
}

# resolve_import_path(imp, entry_dir, repo_root) returns the resolved file
# path for an import, or "" if not found.
fn resolve_import_path(imp: str, entry_dir: str, repo_root: str) -> str uses IO {
    if imp.starts_with("std.") {
        let module_name: str = imp.slice(4, imp.len())
        let rel: str = "std/" + module_name + ".hls"
        let mut d: str = entry_dir
        let mut tries: int = 0
        while tries < 5 {
            let candidate: str = join_path(d, rel)
            if file_exists(candidate) {
                return candidate
            }
            let parent: str = parent_dir(d)
            if parent == d {
                break
            }
            d = parent
            tries = tries + 1
        }
        let fallback: str = join_path(repo_root, rel)
        if file_exists(fallback) {
            return fallback
        }
        return ""
    }
    let direct: str = join_path(entry_dir, imp)
    if file_exists(direct) {
        return direct
    }
    return ""
}

# already_loaded(ctx, path) returns true if path has already been loaded.
fn already_loaded(ctx: Ctx, path: str) -> bool {
    let mut i: int = 0
    while i < ctx.loaded_files.len() {
        if ctx.loaded_files.get(i) == path {
            return true
        }
        i = i + 1
    }
    return false
}

# load_file_into(ctx, abs_path) reads, lexes and parses abs_path into ctx.
fn load_file_into(ctx: Ctx, abs_path: str) -> void uses IO {
    if already_loaded(ctx, abs_path) {
        return
    }
    ctx.loaded_files.push(abs_path)
    let file_dir: str = dir_of(abs_path)
    let saved_src: str = ctx.src
    let saved_toks: list[Tok] = ctx.toks
    let saved_pos: int = ctx.pos
    let saved_imports: list[str] = ctx.imports
    ctx.src = read_file(abs_path)
    ctx.toks = []
    ctx.pos = 0
    ctx.imports = []
    lex(ctx)
    parse_program(ctx)
    let my_imports: list[str] = ctx.imports
    let mut i: int = 0
    while i < my_imports.len() {
        let imp: str = my_imports.get(i)
        let resolved: str = resolve_import_path(imp, file_dir, ctx.repo_root)
        if resolved == "" {
            panic("module not found: " + imp)
        }
        load_file_into(ctx, resolved)
        i = i + 1
    }
    ctx.src = saved_src
    ctx.toks = saved_toks
    ctx.pos = saved_pos
    ctx.imports = saved_imports
}

fn main() -> int uses IO {
    let a: list[str] = args()
    # Stage 9-beta: `hlc --audit <file.hls>` prints the capability tree.
    if a.len() >= 2 && a.get(1) == "--audit" {
        if a.len() < 3 {
            println("usage: hlc --audit <input.hls>")
            return 1
        }
        let entry_path: str = a.get(2)
        let src: str = read_file(entry_path)
        let ctx: Ctx = new_ctx(src)
        ctx.entry_dir = dir_of(entry_path)
        ctx.repo_root = parent_dir(ctx.entry_dir)
        lex(ctx)
        parse_program(ctx)
        let entry_imports: list[str] = ctx.imports
        let mut i: int = 0
        while i < entry_imports.len() {
            let imp: str = entry_imports.get(i)
            let resolved: str = resolve_import_path(imp, ctx.entry_dir, ctx.repo_root)
            if resolved == "" {
                println("error: module not found: " + imp)
                return 1
            }
            load_file_into(ctx, resolved)
            i = i + 1
        }
        check_program(ctx)
        print_audit(ctx)
        return 0
    }
    if a.len() < 3 {
        println("usage: hlc <input.hls> <output.c|->   |   hlc --audit <input.hls>")
        return 1
    }
    let entry_path: str = a.get(1)
    let src: str = read_file(entry_path)
    let ctx: Ctx = new_ctx(src)
    ctx.entry_dir = dir_of(entry_path)
    ctx.repo_root = parent_dir(ctx.entry_dir)
    # Lex + parse the entry file.
    lex(ctx)
    parse_program(ctx)
    # Process the entry file's imports (recursively loads transitive deps).
    let entry_imports: list[str] = ctx.imports
    let mut i: int = 0
    while i < entry_imports.len() {
        let imp: str = entry_imports.get(i)
        let resolved: str = resolve_import_path(imp, ctx.entry_dir, ctx.repo_root)
        if resolved == "" {
            println("error: module not found: " + imp)
            return 1
        }
        load_file_into(ctx, resolved)
        i = i + 1
    }
    check_program(ctx)
    let lines: list[str] = gen_program(ctx)
    let code: str = join(lines, "\n")
    let out_path: str = a.get(2)
    if out_path == "-" {
        print(code)
        println("")
    } else {
        write_file(out_path, code)
    }
    return 0
}

# Stage 9-beta: print the capability / effect tree of every function.
# Mirrors boot.py's --audit output. Reads ctx.computed_effects (populated
# by check_effects) and the per-function declared effect list.
fn print_audit(ctx: Ctx) -> void uses IO {
    let keys: list[str] = ctx.fn_order
    let mut i: int = 0
    println("==============================================================================")
    println("  function                       declared                       computed")
    println("==============================================================================")
    while i < keys.len() {
        let key: str = keys.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        let declared: list[str] = f.effects
        let computed: list[str] = ctx.computed_effects.get_or(key, [])
        let mut decl_disp: str = ""
        if f.is_pure {
            decl_disp = "pure"
        }
        let mut j: int = 0
        while j < declared.len() {
            if decl_disp != "" {
                decl_disp = decl_disp + ", "
            }
            decl_disp = decl_disp + declared.get(j)
            j = j + 1
        }
        if decl_disp == "" {
            decl_disp = "(none - pure)"
        }
        let mut comp_disp: str = ""
        let mut k: int = 0
        while k < computed.len() {
            if comp_disp != "" {
                comp_disp = comp_disp + ", "
            }
            comp_disp = comp_disp + computed.get(k)
            k = k + 1
        }
        if comp_disp == "" {
            comp_disp = "(none)"
        }
        # Pad the function name to 30 chars for alignment.
        let padded: str = pad_right(key, 30)
        let padded_decl: str = pad_right(decl_disp, 30)
        println("  " + padded + "  " + padded_decl + "  " + comp_disp)
        i = i + 1
    }
    println("==============================================================================")
    println("  Active effects:    IO, Fs, Clock, Args, Exit")
    println("  Reserved effects:  Net, Rand, Proc  (error if used)")
    println("  `uses IO` expands to: {IO, Fs, Clock, Args, Exit}")
    println("")
    # Stage 10-beta: taint-flow audit extension. Scan the call graph for:
    #   - functions calling taint sources (tainted_args, read_file_tainted)
    #   - functions calling each taint sink
    println("  Taint sources (builtins):  tainted_args, read_file_tainted")
    println("  Taint sinks (builtins):    print, println, read_file,")
    println("                            write_file, file_exists, exit")
    println("  Explicit untaint:         taint_unwrap, std.sanitize.*")
    println("")
    # Find functions calling each taint source.
    let mut targs_users: list[str] = []
    let mut rft_users: list[str] = []
    let mut si: int = 0
    while si < keys.len() {
        let skey: str = keys.get(si)
        let callees: list[str] = ctx.edges.get_or(skey, [])
        let mut cj: int = 0
        while cj < callees.len() {
            let ce: str = callees.get(cj)
            if ce == "b:tainted_args" {
                if !list_has(targs_users, skey) {
                    targs_users.push(skey)
                }
            }
            if ce == "b:read_file_tainted" {
                if !list_has(rft_users, skey) {
                    rft_users.push(skey)
                }
            }
            cj = cj + 1
        }
        si = si + 1
    }
    if targs_users.len() > 0 {
        println("  Functions calling tainted_args():")
        let mut ti: int = 0
        while ti < targs_users.len() {
            println("    - " + targs_users.get(ti))
            ti = ti + 1
        }
    } else {
        println("  No function calls tainted_args() (no argv-taint sources in this program).")
    }
    if rft_users.len() > 0 {
        println("  Functions calling read_file_tainted():")
        let mut ri: int = 0
        while ri < rft_users.len() {
            println("    - " + rft_users.get(ri))
            ri = ri + 1
        }
    } else {
        println("  No function calls read_file_tainted().")
    }
}

# Right-pad a string with spaces to width `n`. Truncates if longer than n.
fn pad_right(s: str, n: int) -> str pure {
    let sl: int = s.len()
    if sl >= n {
        return s.slice(0, n)
    }
    let mut out: str = s
    let mut i: int = 0
    while i < n - sl {
        out = out + " "
        i = i + 1
    }
    return out
}

# --- END ---
