# ============================================================================
# hlc — THE HIEU LOUIS COMPILER (HLS -> C)
# ----------------------------------------------------------------------------
# This compiler is written 100% in Halis itself.
# This is the self-hosting step of the language: the language's compiler
# is written in that language.
#
# v0.3 (Stage 7) supports:
#   - enum declarations (generic + non-generic)
#   - match expressions (with exhaustiveness checking)
#   - the `?` error-propagation operator
#   - generic functions / structs / enums (monomorphisation)
#   - struct default field values
#
# Bootstrap chain:
#   python3 boot/boot.py src/hlc.hls <input.hls> <output.c>
#   gcc -O2 -o <program> <output.c> -lm
#
# Structure: LEXER -> PARSER -> CHECKER (types + effects) -> CODEGEN (C)
# All state is passed explicitly through Ctx — no global variables.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. DATA STRUCTURES
# ----------------------------------------------------------------------------

struct Tok {
    kind: str,
    value: str,
    line: int,
    col: int
}

struct Binding {
    t: str,
    is_mut: bool,
    moved: bool
}

struct StructInfo {
    name: str,
    fields: list[str],
    ftypes: list[str],
    fdefaults: list[int],   # indices of default-value exprs, -1 if none
    typeparams: list[str],
    line: int
}

struct EnumInfo {
    name: str,
    variants: list[str],            # variant names
    payloads: list[list[str]],      # payload types per variant (parallel to variants)
    typeparams: list[str],
    line: int
}

struct FnInfo {
    name: str,
    params: list[str],
    ptypes: list[str],
    pmuts: list[bool],
    ret: str,
    effects: list[str],   # Stage 9-alpha: declared effects (IO is expanded at parse time to IO+Fs+Clock+Args+Exit)
    is_pure: bool,           # Stage 9-beta: explicit `pure` keyword — function declares no effects AND transitively calls none
    body: list[int],
    is_method: bool,
    struct_of: str,
    typeparams: list[str],
    line: int,
    is_extern: bool,       # Stage 15-beta: extern "C" fn — forward declaration, no body
    # ---- Stage 17 (v0.28.0-alpha): contracts ----
    requires_e: int,        # expr index of the combined requires clause (-1 = none)
    ensures_e: int,        # expr index of the combined ensures clause (-1 = none)
    # ---- Stage 28 (v0.45.0-alpha): stack-frame layout control ----
    # attr_stack_size: requested maximum stack frame in bytes (-1 = none).
    # The codegen runs a static analysis pass on the fn body to estimate
    # the frame size (param locals + let bindings + per-call overhead);
    # a compile error is raised if the estimate exceeds the bound.
    attr_stack_size: int,
    # attr_no_red_zone: disable the x86-64 red zone (required for
    # interrupt handlers — the CPU may push an exception frame at any
    # point inside the red zone). Emitted as
    # __attribute__((target("no-red-zone"))) on x86-64; ignored elsewhere.
    attr_no_red_zone: bool,
    # attr_irq_handler: emit an IRET-compatible frame. On x86-64 the
    # body is wrapped with __attribute__((interrupt)) which makes gcc
    # save+restore every caller-saved register and return via IRETQ
    # (rather than RET). The fn must have signature
    # `fn(struct_or_ptr_to_frame) -> void` (gcc requires this).
    attr_irq_handler: bool,
    # ---- Stage 29 (v0.46.0-alpha): inline / hot / cold attributes ----
    # attr_inline: "" = auto (the optimiser decides), "always" = force
    # inline at every call site (LTO honours this by bypassing the
    # budget check; the C signature carries
    # __attribute__((always_inline)) inline), "never" = the function
    # is NEVER inlined (the C signature carries
    # __attribute__((noinline))).
    attr_inline: str,
    # attr_hot: mark this function hot — overrides PGO. Emitted as
    # __attribute__((hot)). Implies attr_inline="" (the optimiser still
    # picks; the hot attribute is purely a hint).
    attr_hot: bool,
    # attr_cold: mark this function cold — overrides PGO. Emitted as
    # __attribute__((cold)). Mutually exclusive with attr_hot.
    attr_cold: bool
}

struct MatchArm {
    pat_kind: str,           # "wildcard" or "variant"
    enum_name: str,
    variant: str,
    bindings: list[str],
    has_paren: bool,
    body: int,               # body expression index
    body_t: str,             # body type, set during check
    line: int
}

struct ExprN {
    kind: str,
    op: str,
    name: str,
    sval: str,
    ival: int,
    fval: float,
    bval: bool,
    left: int,               # also used as scrutinee index for match
    right: int,
    args: list[int],         # also used as arm indices for match
    ffields: list[str],
    t: str,
    muser: bool,
    mkey: str,               # for user fn call: the (possibly mangled) C name
    mop: str,
    enum_name: str,          # for enumlit (after check)
    variant: str,           # for enumlit / match arm variant
    err_variant: str,       # for qmark
    ok_variant: str,        # for qmark
    inst_targs: list[str],  # for generic call: inferred type args (concrete)
    line: int,
    # ---- Stage 17 (v0.28.0-alpha): proof annotations ----
    # ovf_safe: the interval prover proved this int + - * cannot
    # overflow (under -O fast the codegen emits the raw C op).
    ovf_safe: bool,
    # div_safe: the divisor is provably non-zero (and not the
    # INT64_MIN / -1 overflow case) — the div/mod checks are elidable.
    div_safe: bool,
    # bnd_safe: the index/byte_at/slice is provably within bounds
    # (symbolic len match) — the bounds checks are elidable.
    bnd_safe: bool
}

struct StmtN {
    kind: str,
    name: str,
    vtype: str,
    is_mut: bool,
    value: int,
    target: int,
    cond: int,
    body: list[int],
    else_body: list[int],
    iter: int,
    e: int,
    line: int
}

struct Ctx {
    src: str,
    toks: list[Tok],
    pos: int,
    exprs: list[ExprN],
    stmts: list[StmtN],
    match_arms: list[MatchArm],
    structs: map[str, StructInfo],
    enums: map[str, EnumInfo],
    fns: map[str, FnInfo],
    fn_order: list[str],
    methods_of: map[str, list[str]],
    out: list[str],
    gen_locals: map[str, str],
    gen_counts: map[str, int],
    tmp: int,
    edges: map[str, list[str]],
    imports: list[str],
    loaded_files: list[str],
    entry_dir: str,
    repo_root: str,
    cur_fn_ret: str,
    # cur_fn: the key of the function being generated (v0.30.0-alpha:
    # needed by the return handler to find the ensures clause for the
    # --contracts postcondition checks).
    cur_fn: str,
    cur_typeparams: list[str],
    cur_targs: list[str],
    fn_insts: list[str],
    struct_insts: list[str],
    enum_insts: list[str],
    computed_effects: map[str, list[str]],
    # ---- Stage 8-beta: ownership-analysis state ----
    # hoist_map: expr index (as str) -> hoisted temp C name. Fresh
    # pointer-typed subexpressions consumed in a borrowed position are
    # materialised into temps with a cleanup attribute so they are
    # released exactly when the enclosing C block exits.
    hoist_map: map[str, str],
    # null_after: C variable names to null out at the end of the current
    # statement (bindings moved out by take()). Nulling makes the
    # scope-exit cleanup a no-op, implementing ownership transfer.
    null_after: list[str],
    # clone_insts: HLS types that appeared in a clone() call (their
    # hl_clone_<mangled> helpers will be generated).
    clone_insts: list[str],
    # loop_header: > 0 while checking a while/for condition or iterable —
    # take()/drop() are rejected there (a move would re-execute every
    # iteration).
    loop_header: int,
    # ---- Stage 16 (v0.27.0-alpha): concurrency codegen state ----
    # spawn_decls: top-level C declarations (arg structs + trampolines)
    # accumulated while generating spawn() call sites, appended to the
    # program before the fn bodies.
    spawn_decls: list[str],
    # spawn_n: monotonically increasing counter for unique spawn helper
    # names (hl_sa_<n>_t / hl_mkargs_<n> / hl_tramp_<n>).
    spawn_n: int,
    # ---- Stage 17 (v0.28.0-alpha): proof / contract codegen modes ----
    # fast_mode: -O fast / --fast — elide the panic checks the interval
    # prover proved dead (overflow, division, bounds).
    fast_mode: bool,
    # contracts_mode: --contracts — emit runtime `requires` assertions at
    # every contracted fn entry.
    contracts_mode: bool,
    # ---- Stage 19 (v0.35.0-alpha): profile-guided optimisation ----
    # pgo_gen: --pgo-generate — instrument every function entry, branch
    # and loop back-edge with a counter write; the counters are dumped to
    # a .hlcprof profile file at process exit (atexit).
    pgo_gen: bool,
    # pgo_counts: --pgo-use=<profile> — the loaded profile (site id ->
    # execution count), consulted while generating branches to emit
    # __builtin_expect hints, hot/cold attributes and inline hints.
    pgo_counts: map[str, int],
    # pgo_total_calls: sum of all function-entry counts in the loaded
    # profile (the denominator for the hot-function threshold).
    pgo_total_calls: int,
    # pgo_site_ids: the profile site ids in ASSIGNMENT order (the order
    # is deterministic — identical between a --pgo-generate build and a
    # --pgo-use build of the same source, so indices are stable).
    pgo_site_ids: list[str],
    # pgo_site_map: site id -> counter index (O(1) lookup; the ids list
    # keeps the assignment order for the C table emission).
    pgo_site_map: map[str, int],
    # pgo_fn_branch_n / pgo_fn_loop_n: per-function branch/loop sequence
    # numbers used to build stable site ids; reset per function.
    pgo_fn_branch_n: int,
    pgo_fn_loop_n: int,
    # pgo_fn_sizes: fn key -> emitted body line count (filled during
    # body generation; consulted when emitting prototypes to decide
    # the `static inline` hint for hot small functions).
    pgo_fn_sizes: map[str, int],
    # pgo_slit_n / pgo_slits (Stage 19): profile-driven string-literal
    # hoisting. A string literal used inside a HOT function is emitted
    # as a thread-local one-time cache instead of a per-evaluation
    # hl_cstr() conversion (malloc + strlen + memcpy + free each time).
    # Mirrors LLVM's ConstantHoisting pass, which also gates on profile
    # hotness. The lazy branch is per-thread (no cross-thread sharing,
    # plain refcounts stay sound); the inline hl_retain gives the use
    # site the same +1 a fresh literal had, so every existing cleanup /
    # own-wrap path stays balanced.
    pgo_slit_n: int,
    pgo_slits: list[str],
    # ---- Stage 20 (v0.36.0-alpha): link-time optimisation across
    # "crates" (imported modules merged into one whole program) ----
    # lto_mode: --lto — enable cross-crate inlining + whole-program
    # dead-code elimination + the instantiation-dedup report.
    lto_mode: bool,
    # lto_calls: fn key -> number of OUT-OF-LINE call sites actually
    # emitted (gen_call / gen_method / spawn trampolines). A function
    # whose every call site was inlined ends at 0 and its standalone
    # body is dropped ("inlined and the standalone definition is
    # dropped" — the roadmap wording).
    lto_calls: map[str, int],
    # lto_fn_start: fn key -> index of its signature line in ctx.out
    # (for splicing fully-inlined bodies back out).
    lto_fn_start: map[str, int],
    # lto_inline_n: total inline expansions (capped; guards bloat).
    lto_inline_n: int,
    # lto_dropped: how many standalone bodies were dropped (stats).
    lto_dropped: int,
    # lto_inlined_report: callee keys inlined at least once (stats).
    lto_inlined_report: list[str],
    # Stage 20 perfection (v0.39.0-alpha): tunable inline threshold.
    # lto_threshold: --lto-threshold=N — overrides LTO_INLINE_MAX_STMTS
    # (the per-callee statement budget). 0 = use the default (30).
    lto_threshold: int,
    # lto_stats: --lto-stats — print a summary of LTO work (inline
    # count, dropped functions, generic instantiation dedup, total
    # functions before/after) to stderr after codegen.
    lto_stats: bool,
    # ---- Stage 21 (v0.37.0-alpha): SIMD vectorisation ----
    # target_feature: --target-feature sse4.2|avx2|neon — enables the
    # std.simd intrinsic fast paths in gen_call and const-folds
    # has_feature() calls.
    target_feature: str,
    # simd_helpers_main / simd_helpers_alt / simd_helpers_plain: the C
    # lines of the emitted SIMD helpers — main = the x86 intrinsic
    # bodies (in the #if x86 branch), alt = the scalar fallbacks (in the
    # #else branch), plain = arch-independent kernels (gather/scatter —
    # emitted in BOTH branches) — assembled by simd_helper_lines and
    # spliced in after the clone bodies.
    simd_helpers_main: list[str],
    simd_helpers_alt: list[str],
    simd_helpers_plain: list[str],
    # Stage 25 (v0.44.0-alpha): simd_helpers_neon = the AArch64 NEON
    # intrinsic bodies (in the #elif __aarch64__ branch). Populated
    # when --target-feature neon is passed; the same scalar fallback
    # (simd_helpers_alt) is used for non-NEON hosts.
    simd_helpers_neon: list[str],
    # simd_helper_names: helper names already emitted (dedup).
    simd_helper_names: list[str],
    # ---- Stage 28+29 (v0.45.0-alpha): attribute parser state ----
    # cur_attrs_*: the parsed attributes for the fn currently being
    # parsed. parse_program / parse_impl calls parse_attributes (when a
    # `#[` is the next token), populates these fields, then calls
    # parse_fn which reads them. parse_fn resets the fields to defaults
    # at the start of its NEXT call (so an un-attributed fn never
    # inherits the previous fn's attrs).
    cur_attrs_stack_size: int,
    cur_attrs_no_red_zone: bool,
    cur_attrs_irq_handler: bool,
    cur_attrs_inline: str,
    cur_attrs_hot: bool,
    cur_attrs_cold: bool
}

fn new_ctx(src: str) -> Ctx {
    return Ctx {
        src: src, toks: [], pos: 0,
        exprs: [], stmts: [], match_arms: [],
        structs: map_new(), enums: map_new(), fns: map_new(), fn_order: [],
        methods_of: map_new(),
        out: [],
        gen_locals: map_new(), gen_counts: map_new(), tmp: 0,
        edges: map_new(),
        imports: [], loaded_files: [],
        entry_dir: "", repo_root: "",
        cur_fn_ret: "void", cur_fn: "", cur_typeparams: [], cur_targs: [],
        fn_insts: [], struct_insts: [], enum_insts: [],
        computed_effects: map_new(),
        hoist_map: map_new(), null_after: [], clone_insts: [], loop_header: 0,
        spawn_decls: [], spawn_n: 0,
        fast_mode: false, contracts_mode: false,
        pgo_gen: false, pgo_counts: map_new(), pgo_total_calls: 0,
        pgo_site_ids: [], pgo_site_map: map_new(),
        pgo_fn_branch_n: 0, pgo_fn_loop_n: 0,
        pgo_fn_sizes: map_new(),
        pgo_slit_n: 0, pgo_slits: [],
        lto_mode: false, lto_calls: map_new(), lto_fn_start: map_new(),
        lto_inline_n: 0, lto_dropped: 0, lto_inlined_report: [],
        lto_threshold: 0, lto_stats: false,
        target_feature: "", simd_helpers_main: [], simd_helpers_alt: [],
        simd_helpers_plain: [], simd_helpers_neon: [], simd_helper_names: [],
        cur_attrs_stack_size: -1, cur_attrs_no_red_zone: false,
        cur_attrs_irq_handler: false, cur_attrs_inline: "",
        cur_attrs_hot: false, cur_attrs_cold: false
    }
}

# --- Common helpers ---

# join(parts, sep) — REMOVED as an HLS-level function in v0.35.0-alpha:
# the accumulating `acc = acc + sep + part` pattern is O(n^2) in total
# bytes copied (hl_str_concat copies both operands on every call), which
# dominated the self-compilation time. join is now a BUILTIN backed by
# the O(n) hl_str_join runtime helper (single allocation, one copy per
# element). All former call sites resolve to the builtin unchanged.

fn is_keyword(w: str) -> bool {
    return w == "fn" || w == "let" || w == "mut" || w == "return" || w == "if"
        || w == "else" || w == "while" || w == "for" || w == "in"
        || w == "break" || w == "continue" || w == "struct" || w == "impl"
        || w == "import" || w == "uses" || w == "true" || w == "false"
        || w == "enum" || w == "match" || w == "pure"
        # Stage 15-beta: `extern` keyword for `extern "C" { ... }` blocks.
        # Previously hlc.hls did not recognise `extern` as a keyword, so
        # programs using FFI would fail to parse. This closes the Stage 15
        # remaining-work gap documented in ROADMAP.md.
        || w == "extern"
        # Stage 17 (v0.28.0-alpha): contract clauses — `requires` /
        # `ensures` on functions. The words only appeared in comments
        # before, so reserving them breaks nothing.
        || w == "requires" || w == "ensures"
}

fn is_ident_start(c: int) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_ident_char(c: int) -> bool {
    return is_ident_start(c) || (c >= 48 && c <= 57)
}

fn is_digit(c: int) -> bool {
    return c >= 48 && c <= 57
}

# list_slice_from(list, start) returns a new list with elements from index
# `start` to the end.
fn list_slice_from(xs: list[str], start: int) -> list[str] {
    let out: list[str] = []
    let mut i: int = start
    while i < xs.len() {
        out.push(xs.get(i))
        i = i + 1
    }
    return out
}

# Strip underscores from numbers: "1_000" -> "1000"
fn filter_us(s: str) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < s.len() {
        if s.byte_at(i) != 95 {
            parts.push(s.slice(i, i + 1))
        }
        i = i + 1
    }
    return join(parts, "")
}

# --- Type string helpers (mirrors the checker's helpers) ---

fn is_list_t(t: str) -> bool {
    return t.starts_with("list[")
}

fn list_elem_t(t: str) -> str {
    return t.slice(5, t.len() - 1)
}

fn is_map_t(t: str) -> bool {
    return t.starts_with("map[str, ")
}

fn map_val_t(t: str) -> str {
    return t.slice(9, t.len() - 1)
}

# Stage 10-alpha: built-in taint wrapper `tainted[T]`. Like `list[T]` it
# is a built-in generic type — no struct/enum definition required.
fn is_taint_t(t: str) -> bool {
    return t.starts_with("tainted[")
}

# Stage 16 (v0.27.0-alpha): built-in concurrency wrappers.
# `Chan[T]` — message-passing channel (MPMC, unbounded, blocking recv).
# `Task[R]` — spawned-task join handle (R = the spawned fn's return type).
fn is_chan_t(t: str) -> bool {
    return t.starts_with("Chan[")
}

fn chan_inner_t(t: str) -> str {
    return t.slice(5, t.len() - 1)
}

fn is_task_t(t: str) -> bool {
    return t.starts_with("Task[")
}

fn task_inner_t(t: str) -> str {
    return t.slice(5, t.len() - 1)
}

fn taint_inner_t(t: str) -> str {
    return t.slice(8, t.len() - 1)
}

# type_base(t) returns the head identifier (before any `[`).
fn type_base(t: str) -> str {
    let mut i: int = 0
    while i < t.len() {
        if t.byte_at(i) == 91 {
            return t.slice(0, i)
        }
        i = i + 1
    }
    return t
}

# trim_spaces(s) returns s with leading/trailing ASCII spaces removed.
fn trim_spaces(s: str) -> str {
    let mut start: int = 0
    let mut end: int = s.len()
    while start < end && s.byte_at(start) == 32 {
        start = start + 1
    }
    while end > start && s.byte_at(end - 1) == 32 {
        end = end - 1
    }
    return s.slice(start, end)
}

# type_args(t) returns a list of type-arg strings, splitting on commas at depth 0.
fn type_args(t: str) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    let mut base_start: int = -1
    # Find the first '[' that opens the outermost arg list.
    while i < t.len() {
        if t.byte_at(i) == 91 {
            base_start = i + 1
            break
        }
        i = i + 1
    }
    if base_start < 0 {
        return out
    }
    # Now parse args from base_start until the matching ']' (last char).
    let mut depth: int = 0
    let mut start: int = base_start
    let mut j: int = base_start
    while j < t.len() - 1 {
        let c: int = t.byte_at(j)
        if c == 91 {
            depth = depth + 1
        } else if c == 93 {
            depth = depth - 1
        } else if c == 44 && depth == 0 {
            out.push(trim_spaces(t.slice(start, j)))
            start = j + 1
        }
        j = j + 1
    }
    # Last arg (we stop at len - 1 to skip the closing ']').
    if start < t.len() - 1 {
        out.push(trim_spaces(t.slice(start, t.len() - 1)))
    }
    return out
}

# split_args_str(s) splits a comma-separated list of types, respecting nested [ ].
fn split_args_str(s: str) -> list[str] {
    let out: list[str] = []
    if s == "" {
        return out
    }
    let mut depth: int = 0
    let mut start: int = 0
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c == 91 {
            depth = depth + 1
        } else if c == 93 {
            depth = depth - 1
        } else if c == 44 && depth == 0 {
            out.push(trim_spaces(s.slice(start, i)))
            start = i + 1
        }
        i = i + 1
    }
    out.push(trim_spaces(s.slice(start, s.len())))
    return out
}

# BUG-019 fix: removed dead trim_one_space function (was unused, with a
# "currently unused" comment that itself was a maintenance hint — resurrect
# from git history if ever needed).

# instantiate_type(t, typeparams, typeargs) substitutes each type param in `t`
# with the corresponding concrete type from `typeargs`.
# BUG-31 fix: recurse on the substituted value — but cap recursion at 16
# levels to prevent infinite loops when a type arg IS itself a type param
# (which happens when a generic function calls another generic function
# with the same type-param names). The original code returned the first
# lookup result without recursing, which left inner type params
# unbound in some edge cases.
fn instantiate_type(t: str, tps: list[str], targs: list[str]) -> str {
    return instantiate_type_d(t, tps, targs, 0)
}

fn instantiate_type_d(t: str, tps: list[str], targs: list[str], depth: int) -> str {
    if depth > 16 {
        return t
    }
    # First: if t is exactly a type param, substitute.
    let mut i: int = 0
    while i < tps.len() {
        if t == tps.get(i) {
            # Recurse on the substituted value — it may itself contain type
            # params that need to be substituted (e.g. targs[i] = "list[U]"
            # where U is another type param).
            return instantiate_type_d(targs.get(i), tps, targs, depth + 1)
        }
        i = i + 1
    }
    if t == "int" || t == "float" || t == "bool" || t == "str" || t == "void" {
        return t
    }
    if is_list_t(t) {
        let inner: str = list_elem_t(t)
        let new_inner: str = instantiate_type_d(inner, tps, targs, depth + 1)
        return "list[" + new_inner + "]"
    }
    if is_map_t(t) {
        let val: str = map_val_t(t)
        let new_val: str = instantiate_type_d(val, tps, targs, depth + 1)
        return "map[str, " + new_val + "]"
    }
    if is_taint_t(t) {
        let inner: str = taint_inner_t(t)
        let new_inner: str = instantiate_type_d(inner, tps, targs, depth + 1)
        return "tainted[" + new_inner + "]"
    }
    # User-defined type with possible type args
    let base: str = type_base(t)
    if base == t {
        # No type args — could be a non-generic user type or an unsubstituted
        # type param used as a base (rare; we already handled the exact-match
        # case above). Return as-is.
        return t
    }
    let args: list[str] = type_args(t)
    let new_args: list[str] = []
    let mut j: int = 0
    while j < args.len() {
        new_args.push(instantiate_type_d(args.get(j), tps, targs, depth + 1))
        j = j + 1
    }
    return base + "[" + join(new_args, ", ") + "]"
}

# ----------------------------------------------------------------------------
# 2. LEXER
# ----------------------------------------------------------------------------

fn mk_tok(kind: str, value: str, line: int, col: int) -> Tok {
    return Tok { kind: kind, value: value, line: line, col: col }
}

fn lex_err(msg: str, line: int, col: int) -> void {
    panic("lex error: " + msg + " (line " + line.to_str() + ":" + col.to_str() + ")")
}

# str_contains_inf: does a float literal text evaluate to infinity?
# (Deep-scan-10: cheap conservative test - an exponent >= 400 or a
# mantissa with > 309 significant digits overflows double range.)
fn str_contains_inf(t: str) -> bool {
    let epos: int = str_find_ch(t, 101)
    let mut p: int = epos
    if p == -1 {
        p = str_find_ch(t, 69)
    }
    if p == -1 {
        return t.len() > 320
    }
    # exponent magnitude
    let mut q: int = p + 1
    let mut neg: bool = false
    if q < t.len() && (t.byte_at(q) == 43 || t.byte_at(q) == 45) {
        if t.byte_at(q) == 45 {
            neg = true
        }
        q = q + 1
    }
    let mut mag: int = 0
    while q < t.len() {
        mag = mag * 10 + (t.byte_at(q) - 48)
        if mag > 100000 {
            mag = 100000
        }
        q = q + 1
    }
    if neg {
        return false
    }
    return mag > 308
}

fn str_find_ch(t: str, ch: int) -> int {
    let mut i: int = 0
    while i < t.len() {
        if t.byte_at(i) == ch {
            return i
        }
        i = i + 1
    }
    return -1
}

# int_lit_over_range: an INT literal string whose value exceeds 2^63
# exactly (the parser folds `-`+2^63 into int64 min; anything larger has
# no int64 representation at all).
fn int_lit_over_range(t: str) -> bool {
    # Compare digit strings against "9223372036854775808" (2^63).
    let lim: str = "9223372036854775808"
    let s: str = t
    let mut si: int = 0
    # strip leading zeros
    while si + 1 < s.len() && s.byte_at(si) == 48 {
        si = si + 1
    }
    let s2: str = s.slice(si, s.len())
    if s2.len() != lim.len() {
        return s2.len() > lim.len()
    }
    return s2 > lim
}

fn lex(ctx: Ctx) -> void {
    let src: str = ctx.src
    let n: int = src.len()
    let mut i: int = 0
    let mut line: int = 1
    let mut col: int = 1
    while i < n {
        let c: int = src.byte_at(i)
        # whitespace. Deep-scan-10: a lone \r (CR-only files) is a LINE
        # TERMINATOR (CRLF: the following \n handles it).
        if c == 32 || c == 9 {
            col = col + 1
            i = i + 1
        } else if c == 13 {
            if i + 1 < n && src.byte_at(i + 1) == 10 {
                col = col + 1
            } else {
                line = line + 1
                col = 1
            }
            i = i + 1
        } else if c == 10 {
            line = line + 1
            col = 1
            i = i + 1
        } else if c == 35 {
            # Stage 28+29 (v0.45.0-alpha): `#[` introduces an attribute
            # list (e.g. `#[inline(always)]`, `#[irq_handler]`). `#`
            # followed by anything else (including end-of-line) is a
            # line comment as before. The `#` is consumed here as a
            # sym token; the `[` is left for the normal symbol path so
            # the parser sees `#` immediately followed by `[`.
            if i + 1 < n && src.byte_at(i + 1) == 91 {
                ctx.toks.push(mk_tok("sym", "#", line, col))
                col = col + 1
                i = i + 1
            } else {
                # comment: # to end of line
                # BUG-016 fix: track column past the comment, so error messages
                # on a later token on the same line report the right column.
                while i < n && src.byte_at(i) != 10 {
                    i = i + 1
                    col = col + 1
                }
            }
        } else if is_ident_start(c) {
            let mut j: int = i
            while j < n && is_ident_char(src.byte_at(j)) {
                j = j + 1
            }
            let word: str = src.slice(i, j)
            if is_keyword(word) {
                ctx.toks.push(mk_tok("kw", word, line, col))
            } else {
                ctx.toks.push(mk_tok("ident", word, line, col))
            }
            col = col + (j - i)
            i = j
        } else if is_digit(c) {
            let mut j: int = i
            while j < n && (is_digit(src.byte_at(j)) || src.byte_at(j) == 95) {
                j = j + 1
            }
            let mut is_f: bool = false
            if j < n && src.byte_at(j) == 46 && j + 1 < n && is_digit(src.byte_at(j + 1)) {
                is_f = true
                j = j + 1
                while j < n && (is_digit(src.byte_at(j)) || src.byte_at(j) == 95) {
                    j = j + 1
                }
            }
            # SCAN-C fix: scientific notation. After the integer or
            # fractional part, accept optional `e`/`E` + optional
            # `+`/`-` + digits. Mirrors the Stage-0 lexer fix in
            # boot/lexer.py.
            if j < n && (src.byte_at(j) == 101 || src.byte_at(j) == 69) {
                let mut k: int = j + 1
                if k < n && (src.byte_at(k) == 43 || src.byte_at(k) == 45) {
                    k = k + 1
                }
                if k < n && is_digit(src.byte_at(k)) {
                    is_f = true
                    j = k
                    while j < n && (is_digit(src.byte_at(j)) || src.byte_at(j) == 95) {
                        j = j + 1
                    }
                }
            }
            # Deep-scan-10: digits immediately followed by identifier
            # characters (0x1F, 123abc) are rejected with a clear error
            # (they used to split into two tokens and confuse the parser).
            if j < n && is_ident_start(src.byte_at(j)) {
                lex_err("invalid numeric literal '" + src.slice(i, j + 1)
                    + "' (digits followed by letters - HLS has no hex/adjoined-letter literals)", line, col)
            }
            let text: str = filter_us(src.slice(i, j))
            if is_f {
                # Deep-scan-10: a float literal that overflows to
                # infinity (1e400) is rejected (mirrors the Stage-0 fix).
                if str_contains_inf(text) {
                    lex_err("float literal overflows to infinity: " + src.slice(i, j), line, col)
                }
                ctx.toks.push(mk_tok("float", text, line, col))
            } else {
                # Deep-scan-10: int literals out of the lexer range are
                # rejected (up to 2^63 exactly is allowed through - the
                # parser folds `-` + 9223372036854775808 into int64 min;
                # a bare 2^63 is rejected by the checker's literal rule).
                if int_lit_over_range(text) {
                    lex_err("integer literal out of int64 range: " + src.slice(i, j), line, col)
                }
                ctx.toks.push(mk_tok("int", text, line, col))
            }
            col = col + (j - i)
            i = j
        } else if c == 34 {
            # string
            let ln: int = line
            let cl: int = col
            i = i + 1
            col = col + 1
            let parts: list[str] = []
            let mut closed: bool = false
            while i < n {
                let ch: int = src.byte_at(i)
                if ch == 34 {
                    i = i + 1
                    col = col + 1
                    closed = true
                    break
                }
                if ch == 92 {
                    if i + 1 >= n {
                        lex_err("unterminated string", ln, cl)
                    }
                    # BUG-020 fix: `e` is never reassigned — remove misleading `mut`.
                    let e: int = src.byte_at(i + 1)
                    if e == 110 {
                        parts.push(chr(10))
                    } else if e == 116 {
                        parts.push(chr(9))
                    } else if e == 92 {
                        parts.push(chr(92))
                    } else if e == 34 {
                        parts.push(chr(34))
                    } else {
                        lex_err("invalid escape sequence", ln, cl)
                    }
                    i = i + 2
                    col = col + 2
                } else {
                    if ch < 32 {
                        lex_err("string contains invalid control character", ln, cl)
                    }
                    parts.push(src.slice(i, i + 1))
                    col = col + 1
                    i = i + 1
                }
            }
            if !closed {
                lex_err("unterminated string", ln, cl)
            }
            ctx.toks.push(mk_tok("str", join(parts, ""), ln, cl))
        } else {
            # operator / symbol — try two-char first
            let mut two: str = ""
            if i + 2 <= n {
                two = src.slice(i, i + 2)
            }
            if two == "->" || two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||" || two == "=>" {
                ctx.toks.push(mk_tok("sym", two, line, col))
                i = i + 2
                col = col + 2
            } else if c == 40 || c == 41 || c == 123 || c == 125 || c == 91 || c == 93 || c == 44 || c == 58 || c == 46 || c == 60 || c == 62 || c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 33 || c == 61 || c == 63 {
                ctx.toks.push(mk_tok("sym", chr(c), line, col))
                i = i + 1
                col = col + 1
            } else {
                lex_err("invalid character", line, col)
            }
        }
    }
    ctx.toks.push(mk_tok("eof", "", line, col))
}

# ----------------------------------------------------------------------------
# 3. PARSER
# ----------------------------------------------------------------------------

fn nx_expr(ctx: Ctx, kind: str, line: int) -> int {
    let mut e: ExprN = ExprN {
        kind: kind, op: "", name: "", sval: "", ival: 0, fval: 0.0,
        bval: false, left: -1, right: -1, args: [], ffields: [], t: "",
        muser: false, mkey: "", mop: "", enum_name: "", variant: "",
        err_variant: "", ok_variant: "", inst_targs: [], line: line,
        ovf_safe: false, div_safe: false, bnd_safe: false
    }
    ctx.exprs.push(e)
    return ctx.exprs.len() - 1
}

fn nx_stmt(ctx: Ctx, kind: str, line: int) -> int {
    let s: StmtN = StmtN {
        kind: kind, name: "", vtype: "", is_mut: false, value: -1,
        target: -1, cond: -1, body: [], else_body: [], iter: -1, e: -1,
        line: line
    }
    ctx.stmts.push(s)
    return ctx.stmts.len() - 1
}

fn nx_match_arm(ctx: Ctx, pat_kind: str, enum_name: str, variant: str,
                bindings: list[str], has_paren: bool, body: int, line: int) -> int {
    let arm: MatchArm = MatchArm {
        pat_kind: pat_kind, enum_name: enum_name, variant: variant,
        bindings: bindings, has_paren: has_paren, body: body, body_t: "",
        line: line
    }
    ctx.match_arms.push(arm)
    return ctx.match_arms.len() - 1
}

fn perr(ctx: Ctx, msg: str) -> void {
    let t: Tok = ctx.toks.get(ctx.pos)
    panic("syntax error: " + msg + " (line " + t.line.to_str() + ":" + t.col.to_str() + ")")
}

fn perr_at(ctx: Ctx, msg: str, t: Tok) -> void {
    panic("syntax error: " + msg + " (line " + t.line.to_str() + ":" + t.col.to_str() + ")")
}

fn tok_desc(ctx: Ctx) -> str {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind == "eof" {
        return "end of file"
    }
    return "'" + t.value + "'"
}

fn at_sym(ctx: Ctx, v: str) -> bool {
    let t: Tok = ctx.toks.get(ctx.pos)
    return t.kind == "sym" && t.value == v
}

fn at_kw(ctx: Ctx, v: str) -> bool {
    let t: Tok = ctx.toks.get(ctx.pos)
    return t.kind == "kw" && t.value == v
}

# at_ident returns true iff the current token is an identifier with the
# given name. Used to disambiguate the `_` wildcard (which the lexer
# tokenizes as an ident because `_` is a valid ident-start character).
fn at_ident(ctx: Ctx, v: str) -> bool {
    let t: Tok = ctx.toks.get(ctx.pos)
    return t.kind == "ident" && t.value == v
}

fn eat_sym(ctx: Ctx, v: str) -> void {
    if !at_sym(ctx, v) {
        perr(ctx, "expected symbol '" + v + "' but got " + tok_desc(ctx))
    }
    ctx.pos = ctx.pos + 1
}

fn eat_kw(ctx: Ctx, v: str) -> void {
    if !at_kw(ctx, v) {
        perr(ctx, "expected keyword '" + v + "' but got " + tok_desc(ctx))
    }
    ctx.pos = ctx.pos + 1
}

fn eat_ident(ctx: Ctx) -> str {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind != "ident" {
        perr(ctx, "expected identifier but got " + tok_desc(ctx))
    }
    # BUG-SC-4 fix: reject reserved identifiers (secure / trait) — they
    # are reserved for future keywords per SPEC section 2.5. boot/parser.py
    # (BUG-29 fix) already rejects these; hlc.hls must match.
    if t.value == "secure" || t.value == "trait" {
        perr_at(ctx, "'" + t.value + "' is a reserved identifier and cannot be used as a name (it will become a keyword in a future stage)", t)
    }
    ctx.pos = ctx.pos + 1
    return t.value
}

fn peek2_is(ctx: Ctx, v: str) -> bool {
    if ctx.pos + 1 >= ctx.toks.len() {
        return false
    }
    let t: Tok = ctx.toks.get(ctx.pos + 1)
    return t.kind == "sym" && t.value == v
}

# --- Type parsing: returns a canonical type string ---

fn parse_type(ctx: Ctx, allow_void: bool) -> str {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind != "ident" {
        perr(ctx, "expected type but got " + tok_desc(ctx))
    }
    let base: str = t.value
    ctx.pos = ctx.pos + 1
    if base == "list" {
        eat_sym(ctx, "[")
        let inner: str = parse_type(ctx, false)
        eat_sym(ctx, "]")
        return "list[" + inner + "]"
    }
    if base == "map" {
        eat_sym(ctx, "[")
        let kt: str = eat_ident(ctx)
        if kt != "str" {
            perr_at(ctx, "map key in v0.3 must be 'str'", t)
        }
        eat_sym(ctx, ",")
        let vt: str = parse_type(ctx, false)
        eat_sym(ctx, "]")
        return "map[str, " + vt + "]"
    }
    # Stage 10-alpha: built-in taint wrapper `tainted[T]`.
    if base == "tainted" {
        eat_sym(ctx, "[")
        let inner: str = parse_type(ctx, false)
        eat_sym(ctx, "]")
        return "tainted[" + inner + "]"
    }
    # Stage 16 (v0.27.0-alpha): built-in concurrency wrappers.
    if base == "Chan" {
        eat_sym(ctx, "[")
        let inner: str = parse_type(ctx, false)
        eat_sym(ctx, "]")
        if inner == "void" {
            perr_at(ctx, "Chan[T] element type cannot be void", t)
        }
        return "Chan[" + inner + "]"
    }
    if base == "Task" {
        eat_sym(ctx, "[")
        let inner: str = parse_type(ctx, true)
        eat_sym(ctx, "]")
        return "Task[" + inner + "]"
    }
    if base == "int" || base == "float" || base == "bool" || base == "str" {
        return base
    }
    if base == "void" {
        if !allow_void {
            perr_at(ctx, "void can only be used as a return type", t)
        }
        return "void"
    }
    # User-defined type — could be generic instantiation: Name[T1, T2, ...]
    if at_sym(ctx, "[") {
        eat_sym(ctx, "[")
        let args: list[str] = []
        while !at_sym(ctx, "]") {
            args.push(parse_type(ctx, false))
            if at_sym(ctx, ",") {
                ctx.pos = ctx.pos + 1
            } else if !at_sym(ctx, "]") {
                perr(ctx, "expected ',' or ']' in type arguments")
            }
        }
        eat_sym(ctx, "]")
        return base + "[" + join(args, ", ") + "]"
    }
    return base
}

# Parse `[T, U, ...]` after a function/struct/enum name — returns the list of
# type parameter names. If the next token is not `[`, returns an empty list.
fn parse_typeparams(ctx: Ctx) -> list[str] {
    let out: list[str] = []
    if !at_sym(ctx, "[") {
        return out
    }
    eat_sym(ctx, "[")
    while !at_sym(ctx, "]") {
        let t: Tok = ctx.toks.get(ctx.pos)
        if t.kind != "ident" {
            perr(ctx, "expected type parameter name but got " + tok_desc(ctx))
        }
        # Deep-scan-10 soundness fix: a type parameter named after a
        # builtin type hijacks instantiation (type_map is consulted
        # before the primitive table), so `fn f[int](x: int)` accepted
        # a str argument. Mirror of the boot/parser.py fix.
        if t.value == "int" || t.value == "float" || t.value == "bool"
            || t.value == "str" || t.value == "void" || t.value == "list"
            || t.value == "map" || t.value == "tainted" || t.value == "Chan"
            || t.value == "Task" || t.value == "Option" || t.value == "Result" {
            perr_at(ctx, "type parameter cannot be named '" + t.value
                + "' (it is a builtin type name and would shadow it)", t)
        }
        ctx.pos = ctx.pos + 1
        out.push(t.value)
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, "]") {
            perr(ctx, "expected ',' or ']' in type parameters")
        }
    }
    eat_sym(ctx, "]")
    return out
}

# --- Program parsing ---

# reset_cur_attrs (Stage 28+29, v0.45.0-alpha): clear the per-fn
# attribute cache to defaults. Called after every top-level declaration
# so the next fn (if un-attributed) doesn't inherit the previous fn's
# attrs. Idempotent — safe to call when the cache is already clear.
fn reset_cur_attrs(ctx: Ctx) -> void {
    ctx.cur_attrs_stack_size = -1
    ctx.cur_attrs_no_red_zone = false
    ctx.cur_attrs_irq_handler = false
    ctx.cur_attrs_inline = ""
    ctx.cur_attrs_hot = false
    ctx.cur_attrs_cold = false
}

# parse_attributes (Stage 28+29, v0.45.0-alpha): parse one or more
# `#[attr1, attr2(arg), ...]` lists and merge them into ctx.cur_attrs_*.
# Each list is `#` `[` attr (`,` attr)* `]` where each `attr` is one of:
#
#   inline(always)   - Stage 29: force inline at every call site
#   inline(never)    - Stage 29: the function is never inlined
#   hot              - Stage 29: mark the function hot (overrides PGO)
#   cold             - Stage 29: mark the function cold (overrides PGO)
#   no_red_zone      - Stage 28: disable the x86-64 red zone
#   irq_handler      - Stage 28: emit an IRET-compatible frame
#   stack_size(N)    - Stage 28: assert the fn's frame is <= N bytes
#
# Multiple `#[...]` lists may precede a single fn (each accumulates).
# Within a single list, a duplicate attribute is a compile error.
# `hot` and `cold` are mutually exclusive (compile error if both set).
# `inline(always)` and `inline(never)` are mutually exclusive.
fn parse_attributes(ctx: Ctx) -> void {
    while at_sym(ctx, "#") {
        let hash_tok: Tok = ctx.toks.get(ctx.pos)
        eat_sym(ctx, "#")
        eat_sym(ctx, "[")
        while !at_sym(ctx, "]") {
            let attr_name: str = eat_ident(ctx)
            if attr_name == "inline" {
                # inline(always) or inline(never)
                eat_sym(ctx, "(")
                let mode: str = eat_ident(ctx)
                eat_sym(ctx, ")")
                if mode != "always" && mode != "never" {
                    perr_at(ctx, "unknown inline mode '" + mode + "' (expected 'always' or 'never')", hash_tok)
                }
                if ctx.cur_attrs_inline != "" && ctx.cur_attrs_inline != mode {
                    perr_at(ctx, "conflicting inline attributes (was '" + ctx.cur_attrs_inline + "', now '" + mode + "')", hash_tok)
                }
                ctx.cur_attrs_inline = mode
            } else if attr_name == "hot" {
                if ctx.cur_attrs_cold {
                    perr_at(ctx, "'hot' and 'cold' are mutually exclusive", hash_tok)
                }
                ctx.cur_attrs_hot = true
            } else if attr_name == "cold" {
                if ctx.cur_attrs_hot {
                    perr_at(ctx, "'hot' and 'cold' are mutually exclusive", hash_tok)
                }
                ctx.cur_attrs_cold = true
            } else if attr_name == "no_red_zone" {
                ctx.cur_attrs_no_red_zone = true
            } else if attr_name == "irq_handler" {
                ctx.cur_attrs_irq_handler = true
            } else if attr_name == "stack_size" {
                eat_sym(ctx, "(")
                let nt: Tok = ctx.toks.get(ctx.pos)
                if nt.kind != "int" {
                    perr_at(ctx, "stack_size expects an integer byte count but got " + tok_desc(ctx), nt)
                }
                ctx.pos = ctx.pos + 1
                let n: int = int(nt.value)
                if n < 0 {
                    perr_at(ctx, "stack_size must be non-negative", nt)
                }
                eat_sym(ctx, ")")
                # If multiple stack_size attrs appear, the LAST wins
                # (the user's intent is to refine; we don't accumulate).
                ctx.cur_attrs_stack_size = n
            } else {
                perr_at(ctx, "unknown attribute '" + attr_name + "' (known: inline(always), inline(never), hot, cold, no_red_zone, irq_handler, stack_size(N))", hash_tok)
            }
            if at_sym(ctx, ",") {
                ctx.pos = ctx.pos + 1
            } else if !at_sym(ctx, "]") {
                perr(ctx, "expected ',' or ']' in attribute list")
            }
        }
        eat_sym(ctx, "]")
    }
}

fn parse_program(ctx: Ctx) -> void {
    while ctx.toks.get(ctx.pos).kind != "eof" {
        let t: Tok = ctx.toks.get(ctx.pos)
        # Stage 28+29 (v0.45.0-alpha): a top-level `#[...]` attribute
        # list applies to the following `fn` (the only declaration
        # that currently accepts attributes). parse_attributes
        # populates ctx.cur_attrs_*; parse_fn reads those fields.
        # reset_cur_attrs is called at the END of every iteration so
        # the NEXT declaration starts with cleared attrs (an
        # un-attributed fn never inherits the previous fn's attrs).
        if t.kind == "sym" && t.value == "#" {
            parse_attributes(ctx)
            continue
        }
        if t.kind == "kw" && t.value == "struct" {
            let st: StructInfo = parse_struct(ctx)
            if ctx.structs.has(st.name) || ctx.enums.has(st.name) {
                perr_at(ctx, "duplicate type name: " + st.name, t)
            }
            ctx.structs.set(st.name, st)
        } else if t.kind == "kw" && t.value == "enum" {
            let en: EnumInfo = parse_enum(ctx)
            if ctx.enums.has(en.name) || ctx.structs.has(en.name) {
                perr_at(ctx, "duplicate type name: " + en.name, t)
            }
            ctx.enums.set(en.name, en)
        } else if t.kind == "kw" && t.value == "impl" {
            parse_impl(ctx)
        } else if t.kind == "kw" && t.value == "fn" {
            let f: FnInfo = parse_fn(ctx, "")
            if ctx.fns.has(f.name) {
                perr_at(ctx, "duplicate function name: " + f.name, t)
            }
            ctx.fns.set(f.name, f)
            ctx.fn_order.push(f.name)
        } else if t.kind == "kw" && t.value == "import" {
            eat_kw(ctx, "import")
            let pt: Tok = ctx.toks.get(ctx.pos)
            if pt.kind != "str" {
                perr_at(ctx, "import expects a string path", pt)
            }
            ctx.pos = ctx.pos + 1
            ctx.imports.push(pt.value)
        } else if t.kind == "kw" && t.value == "extern" {
            # Stage 15-beta: extern "C" { ... } block.
            parse_extern_block(ctx)
        } else {
            perr_at(ctx, "only struct/enum/impl/fn/import/extern declarations allowed at top level", t)
        }
        # Reset the per-fn attribute cache after every iteration so
        # the next fn (if un-attributed) doesn't inherit the previous
        # fn's attributes.
        reset_cur_attrs(ctx)
    }
}

fn parse_struct(ctx: Ctx) -> StructInfo {
    let t0: Tok = ctx.toks.get(ctx.pos)
    eat_kw(ctx, "struct")
    let name: str = eat_ident(ctx)
    let typeparams: list[str] = parse_typeparams(ctx)
    eat_sym(ctx, "{")
    let fields: list[str] = []
    let ftypes: list[str] = []
    let fdefaults: list[int] = []
    let mut seen_default: bool = false
    while !at_sym(ctx, "}") {
        let ft: str = eat_ident(ctx)
        eat_sym(ctx, ":")
        let ty: str = parse_type(ctx, false)
        let mut dflt_idx: int = -1
        if at_sym(ctx, "=") {
            ctx.pos = ctx.pos + 1
            dflt_idx = parse_expr(ctx, true)
            seen_default = true
        } else if seen_default {
            perr_at(ctx, "struct field without default cannot follow a defaulted field: " + ft, t0)
        }
        fields.push(ft)
        ftypes.push(ty)
        fdefaults.push(dflt_idx)
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, "}") {
            perr(ctx, "expected ',' or '}' in struct definition")
        }
    }
    eat_sym(ctx, "}")
    if fields.len() == 0 {
        perr_at(ctx, "struct must have at least one field", t0)
    }
    return StructInfo {
        name: name, fields: fields, ftypes: ftypes, fdefaults: fdefaults,
        typeparams: typeparams, line: t0.line
    }
}

fn parse_enum(ctx: Ctx) -> EnumInfo {
    let t0: Tok = ctx.toks.get(ctx.pos)
    eat_kw(ctx, "enum")
    let name: str = eat_ident(ctx)
    let typeparams: list[str] = parse_typeparams(ctx)
    eat_sym(ctx, "{")
    let variants: list[str] = []
    let payloads: list[list[str]] = []
    let mut seen: map[str, bool] = map_new()
    while !at_sym(ctx, "}") {
        let vt: Tok = ctx.toks.get(ctx.pos)
        if vt.kind != "ident" {
            perr_at(ctx, "expected variant name but got " + tok_desc(ctx), vt)
        }
        ctx.pos = ctx.pos + 1
        let vname: str = vt.value
        if seen.has(vname) {
            perr_at(ctx, "duplicate variant name in enum: " + vname, vt)
        }
        seen.set(vname, true)
        let mut pl: list[str] = []
        if at_sym(ctx, "(") {
            eat_sym(ctx, "(")
            while !at_sym(ctx, ")") {
                pl.push(parse_type(ctx, false))
                if at_sym(ctx, ",") {
                    ctx.pos = ctx.pos + 1
                } else if !at_sym(ctx, ")") {
                    perr(ctx, "expected ',' or ')' in variant payloads")
                }
            }
            eat_sym(ctx, ")")
        }
        variants.push(vname)
        payloads.push(pl)
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, "}") {
            perr(ctx, "expected ',' or '}' in enum definition")
        }
    }
    eat_sym(ctx, "}")
    if variants.len() == 0 {
        perr_at(ctx, "enum must have at least one variant", t0)
    }
    return EnumInfo {
        name: name, variants: variants, payloads: payloads,
        typeparams: typeparams, line: t0.line
    }
}

fn parse_impl(ctx: Ctx) -> void {
    eat_kw(ctx, "impl")
    let sname: str = eat_ident(ctx)
    eat_sym(ctx, "{")
    while !at_sym(ctx, "}") {
        # Stage 28+29: methods may carry a `#[...]` attribute list
        # (applies to the following fn). Mirrors the top-level handling
        # in parse_program.
        if at_sym(ctx, "#") {
            parse_attributes(ctx)
            continue
        }
        if !at_kw(ctx, "fn") {
            perr(ctx, "only fn definitions allowed inside impl")
        }
        let fn_t0: Tok = ctx.toks.get(ctx.pos)
        let f: FnInfo = parse_fn(ctx, sname)
        let key: str = sname + "." + f.name
        if ctx.fns.has(key) {
            perr_at(ctx, "duplicate method name: " + key, fn_t0)
        }
        ctx.fns.set(key, f)
        ctx.fn_order.push(key)
        if !ctx.methods_of.has(sname) {
            ctx.methods_of.set(sname, [])
        }
        ctx.methods_of.get_or(sname, []).push(key)
        reset_cur_attrs(ctx)
    }
    eat_sym(ctx, "}")
}

fn parse_fn(ctx: Ctx, impl_struct: str) -> FnInfo {
    let t0: Tok = ctx.toks.get(ctx.pos)
    eat_kw(ctx, "fn")
    let name: str = eat_ident(ctx)
    let typeparams: list[str] = parse_typeparams(ctx)
    eat_sym(ctx, "(")
    let params: list[str] = []
    let ptypes: list[str] = []
    let pmuts: list[bool] = []
    while !at_sym(ctx, ")") {
        let mut is_mut: bool = false
        if at_kw(ctx, "mut") {
            ctx.pos = ctx.pos + 1
            is_mut = true
        }
        let pn: str = eat_ident(ctx)
        eat_sym(ctx, ":")
        let pt: str = parse_type(ctx, false)
        params.push(pn)
        ptypes.push(pt)
        pmuts.push(is_mut)
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, ")") {
            perr(ctx, "expected ',' or ')' in parameters")
        }
    }
    eat_sym(ctx, ")")
    let mut ret: str = "void"
    if at_sym(ctx, "->") {
        ctx.pos = ctx.pos + 1
        ret = parse_type(ctx, true)
    }
    # Stage 9-beta: explicit `pure` keyword for documentation/linting.
    # `pure` and `uses` are mutually exclusive. The checker enforces that
    # a `pure` function's body transitively calls nothing effectful.
    let mut is_pure: bool = false
    if at_kw(ctx, "pure") {
        ctx.pos = ctx.pos + 1
        is_pure = true
    }
    # Stage 9-alpha: fine-grained effects. `uses IO` is a blanket alias
    # for the entire IO family (expanded at parse time). Other recognized
    # effects: Fs, Clock, Args, Exit. Reserved: Net, Rand, Proc.
    let mut effects: list[str] = []
    if at_kw(ctx, "uses") {
        if is_pure {
            perr(ctx, "'pure' and 'uses' are mutually exclusive (a pure function declares no effects)")
        }
        ctx.pos = ctx.pos + 1
        while true {
            let e: str = eat_ident(ctx)
            # Stage 9 release (v0.20.0-alpha): Net, Rand, Proc are now
            # active effects with builtins (net_lookup, rand_int,
            # rand_float, rand_seed, proc_exec). No reserved effects remain.
            if e != "IO" && e != "Fs" && e != "Clock" && e != "Args" && e != "Exit"
                && e != "Net" && e != "Rand" && e != "Proc" && e != "Conc" {
                perr(ctx, "unknown effect '" + e + "'; known effects: IO, Fs, Clock, Args, Exit, Net, Rand, Proc, Conc")
            }
            if !list_has(effects, e) {
                effects.push(e)
            }
            # `IO` is the blanket alias — expand to the full IO family.
            # Net, Rand, Proc, Conc are NOT part of the IO family — a program
            # must declare them explicitly to use the corresponding builtins.
            if e == "IO" {
                let mut k: int = 0
                let fam: list[str] = ["IO", "Fs", "Clock", "Args", "Exit"]
                while k < fam.len() {
                    let fe: str = fam.get(k)
                    if !list_has(effects, fe) {
                        effects.push(fe)
                    }
                    k = k + 1
                }
            }
            if at_sym(ctx, ",") {
                ctx.pos = ctx.pos + 1
                continue
            }
            break
        }
    }
    # Stage 17 (v0.28.0-alpha): contract clauses come BEFORE the body
    # block — parse them first.
    let contracts: list[int] = parse_contracts(ctx)
    let body: list[int] = parse_block(ctx)
    # Stage 28+29 (v0.45.0-alpha): default-constructed attrs (the
    # parse_fn caller — parse_program / parse_impl — already consumed
    # any leading attribute list via parse_fn_with_attrs).
    return FnInfo {
        name: name, params: params, ptypes: ptypes, pmuts: pmuts,
        ret: ret, effects: effects, is_pure: is_pure, body: body,
        is_method: impl_struct != "", struct_of: impl_struct,
        typeparams: typeparams, line: t0.line, is_extern: false,
        requires_e: contracts.get(0), ensures_e: contracts.get(1),
        attr_stack_size: ctx.cur_attrs_stack_size,
        attr_no_red_zone: ctx.cur_attrs_no_red_zone,
        attr_irq_handler: ctx.cur_attrs_irq_handler,
        attr_inline: ctx.cur_attrs_inline,
        attr_hot: ctx.cur_attrs_hot,
        attr_cold: ctx.cur_attrs_cold
    }
}

# parse_contracts — Stage 17 (v0.28.0-alpha): parse any number of
# `requires <expr>` clauses followed by any number of `ensures <expr>`
# clauses; multiple clauses of one kind are combined with && into a
# single expression index (-1 = none). Parsed with allow_struct=false
# so a struct literal cannot be confused with the fn body's `{`.
fn parse_contracts(ctx: Ctx) -> list[int] {
    let mut req_e: int = -1
    let mut ens_e: int = -1
    let mut seen_ens: bool = false
    while true {
        if at_kw(ctx, "requires") && !seen_ens {
            ctx.pos = ctx.pos + 1
            let x: int = parse_expr(ctx, false)
            if req_e == -1 {
                req_e = x
            } else {
                let combined: int = nx_expr(ctx, "bin", ctx.exprs[x].line)
                ctx.exprs[combined].op = "&&"
                ctx.exprs[combined].left = req_e
                ctx.exprs[combined].right = x
                req_e = combined
            }
        } else if at_kw(ctx, "ensures") {
            ctx.pos = ctx.pos + 1
            seen_ens = true
            let y: int = parse_expr(ctx, false)
            if ens_e == -1 {
                ens_e = y
            } else {
                let combined2: int = nx_expr(ctx, "bin", ctx.exprs[y].line)
                ctx.exprs[combined2].op = "&&"
                ctx.exprs[combined2].left = ens_e
                ctx.exprs[combined2].right = y
                ens_e = combined2
            }
        } else {
            break
        }
    }
    let out: list[int] = []
    out.push(req_e)
    out.push(ens_e)
    return out
}

# Stage 15-beta: parse `extern "C" { fn ... }` block.
# Each fn declaration has NO body (just a signature). The `uses IO` (or
# `pure`) clause is REQUIRED — FFI is unsafe by default.
fn parse_extern_block(ctx: Ctx) -> void {
    let t0: Tok = ctx.toks.get(ctx.pos)
    eat_kw(ctx, "extern")
    let abi_tok: Tok = ctx.toks.get(ctx.pos)
    if abi_tok.kind != "str" {
        perr_at(ctx, "expected ABI string (e.g. \"C\") after 'extern'", abi_tok)
    }
    ctx.pos = ctx.pos + 1
    let abi: str = abi_tok.value
    if abi != "C" {
        perr_at(ctx, "unsupported ABI '" + abi + "'; only \"C\" is supported today", abi_tok)
    }
    eat_sym(ctx, "{")
    while !at_sym(ctx, "}") {
        if !at_kw(ctx, "fn") {
            perr(ctx, "extern block can only contain fn declarations")
        }
        # Parse the fn signature (no body). We reuse parse_fn but it
        # requires a body — so we parse up to the effects clause, then
        # skip the body parse for extern fns.
        let ft0: Tok = ctx.toks.get(ctx.pos)
        eat_kw(ctx, "fn")
        let name: str = eat_ident(ctx)
        let typeparams: list[str] = parse_typeparams(ctx)
        eat_sym(ctx, "(")
        let params: list[str] = []
        let ptypes: list[str] = []
        let pmuts: list[bool] = []
        while !at_sym(ctx, ")") {
            let mut is_mut: bool = false
            if at_kw(ctx, "mut") {
                ctx.pos = ctx.pos + 1
                is_mut = true
            }
            let pn: str = eat_ident(ctx)
            eat_sym(ctx, ":")
            let pt: str = parse_type(ctx, false)
            params.push(pn)
            ptypes.push(pt)
            pmuts.push(is_mut)
            if at_sym(ctx, ",") {
                ctx.pos = ctx.pos + 1
            } else if !at_sym(ctx, ")") {
                perr(ctx, "expected ',' or ')' in parameters")
            }
        }
        eat_sym(ctx, ")")
        let mut ret: str = "void"
        if at_sym(ctx, "->") {
            ctx.pos = ctx.pos + 1
            ret = parse_type(ctx, true)
        }
        let mut is_pure: bool = false
        if at_kw(ctx, "pure") {
            ctx.pos = ctx.pos + 1
            is_pure = true
        }
        let mut effects: list[str] = []
        if at_kw(ctx, "uses") {
            if is_pure {
                perr(ctx, "'pure' and 'uses' are mutually exclusive (a pure function declares no effects)")
            }
            ctx.pos = ctx.pos + 1
            while true {
                let e: str = eat_ident(ctx)
                # Stage 9 release (v0.20.0-alpha): Net, Rand, Proc are
                # active effects. No reserved effects remain.
                if e != "IO" && e != "Fs" && e != "Clock" && e != "Args" && e != "Exit"
                    && e != "Net" && e != "Rand" && e != "Proc" && e != "Conc" {
                        perr(ctx, "unknown effect '" + e + "'; known effects: IO, Fs, Clock, Args, Exit, Net, Rand, Proc, Conc")
                }
                if !list_has(effects, e) {
                    effects.push(e)
                }
                if e == "IO" {
                    let mut k: int = 0
                    let fam: list[str] = ["IO", "Fs", "Clock", "Args", "Exit"]
                    while k < fam.len() {
                        let fe: str = fam.get(k)
                        if !list_has(effects, fe) {
                            effects.push(fe)
                        }
                        k = k + 1
                    }
                }
                if at_sym(ctx, ",") {
                    ctx.pos = ctx.pos + 1
                    continue
                }
                break
            }
        }
        # Extern fns MUST declare `uses IO` (or `pure`) — FFI is unsafe by default.
        if effects.len() == 0 && !is_pure {
            perr_at(ctx, "extern fn '" + name + "' must declare `uses IO` (or `pure`) — FFI is unsafe by default", t0)
        }
        if ctx.fns.has(name) {
            perr_at(ctx, "duplicate function name: " + name, t0)
        }
        # Stage 17: extern fns may carry contracts (a requires on an
        # extern documents the C side's precondition and is checked at
        # call sites with literal arguments).
        let contracts_ext: list[int] = parse_contracts(ctx)
        let empty_body: list[int] = []
        ctx.fns.set(name, FnInfo {
            name: name, params: params, ptypes: ptypes, pmuts: pmuts,
            ret: ret, effects: effects, is_pure: is_pure, body: empty_body,
            is_method: false, struct_of: "", typeparams: typeparams,
            line: ft0.line, is_extern: true,
            requires_e: contracts_ext.get(0), ensures_e: contracts_ext.get(1),
            attr_stack_size: -1, attr_no_red_zone: false, attr_irq_handler: false,
            attr_inline: "", attr_hot: false, attr_cold: false
        })
        ctx.fn_order.push(name)
    }
    eat_sym(ctx, "}")
}

fn parse_block(ctx: Ctx) -> list[int] {
    eat_sym(ctx, "{")
    let mut out: list[int] = []
    while !at_sym(ctx, "}") {
        out.push(parse_stmt(ctx))
    }
    eat_sym(ctx, "}")
    return out
}

# --- Statement parsing ---

fn parse_stmt(ctx: Ctx) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind == "kw" {
        if t.value == "let" {
            return parse_let(ctx)
        }
        if t.value == "return" {
            ctx.pos = ctx.pos + 1
            let idx: int = nx_stmt(ctx, "return", t.line)
            if at_sym(ctx, "}") {
                ctx.stmts[idx].value = -1
            } else {
                ctx.stmts[idx].value = parse_expr(ctx, true)
            }
            return idx
        }
        if t.value == "if" {
            return parse_if(ctx)
        }
        if t.value == "while" {
            ctx.pos = ctx.pos + 1
            let cond: int = parse_expr(ctx, false)
            let body: list[int] = parse_block(ctx)
            let idx: int = nx_stmt(ctx, "while", t.line)
            ctx.stmts[idx].cond = cond
            ctx.stmts[idx].body = body
            return idx
        }
        if t.value == "for" {
            ctx.pos = ctx.pos + 1
            let vn: str = eat_ident(ctx)
            eat_sym(ctx, ":")
            let vt: str = parse_type(ctx, false)
            eat_kw(ctx, "in")
            let it: int = parse_expr(ctx, false)
            let body: list[int] = parse_block(ctx)
            let idx: int = nx_stmt(ctx, "for", t.line)
            ctx.stmts[idx].name = vn
            ctx.stmts[idx].vtype = vt
            ctx.stmts[idx].iter = it
            ctx.stmts[idx].body = body
            return idx
        }
        if t.value == "break" {
            ctx.pos = ctx.pos + 1
            return nx_stmt(ctx, "break", t.line)
        }
        if t.value == "continue" {
            ctx.pos = ctx.pos + 1
            return nx_stmt(ctx, "continue", t.line)
        }
        if t.value == "match" {
            # match as an expression statement
            let e: int = parse_match(ctx)
            let idx: int = nx_stmt(ctx, "expr", t.line)
            ctx.stmts[idx].e = e
            return idx
        }
        if t.value == "struct" || t.value == "impl" || t.value == "enum" || t.value == "fn" {
            perr_at(ctx, "declaration of " + t.value + " only allowed at top level", t)
        }
        perr_at(ctx, "keyword cannot start a statement: " + t.value, t)
    }
    # expression / assignment
    let mut e: int = parse_expr(ctx, true)
    if at_sym(ctx, "=") {
        let eq: Tok = ctx.toks.get(ctx.pos)
        ctx.pos = ctx.pos + 1
        let ek: str = ctx.exprs[e].kind
        if ek != "ident" && ek != "field" && ek != "index" {
            perr_at(ctx, "left side of assignment must be variable/field/index", eq)
        }
        if ek == "field" || ek == "index" {
            require_ident_root(ctx, e)
        }
        let val: int = parse_expr(ctx, true)
        let idx: int = nx_stmt(ctx, "assign", eq.line)
        ctx.stmts[idx].target = e
        ctx.stmts[idx].value = val
        return idx
    }
    let ek2: str = ctx.exprs[e].kind
    # Deep-scan-10: `foo()?` as a statement is the idiomatic error-
    # propagate-and-discard form (mirror of the boot/parser.py fix).
    if ek2 != "call" && ek2 != "method" && ek2 != "fieldcall" && ek2 != "match" && ek2 != "qmark" {
        perr(ctx, "expression as statement must be a function/method call")
    }
    let idx: int = nx_stmt(ctx, "expr", ctx.exprs[e].line)
    ctx.stmts[idx].e = e
    return idx
}

fn require_ident_root(ctx: Ctx, e: int) -> void {
    let mut k: str = ctx.exprs[e].kind
    if k == "field" || k == "index" {
        require_ident_root(ctx, ctx.exprs[e].left)
    } else if k != "ident" {
        perr(ctx, "left side of assignment must start from a variable")
    }
}

fn parse_let(ctx: Ctx) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    ctx.pos = ctx.pos + 1
    let mut is_mut: bool = false
    if at_kw(ctx, "mut") {
        ctx.pos = ctx.pos + 1
        is_mut = true
    }
    let name: str = eat_ident(ctx)
    eat_sym(ctx, ":")
    let ty: str = parse_type(ctx, false)
    eat_sym(ctx, "=")
    let val: int = parse_expr(ctx, true)
    let idx: int = nx_stmt(ctx, "let", t.line)
    ctx.stmts[idx].name = name
    ctx.stmts[idx].vtype = ty
    ctx.stmts[idx].is_mut = is_mut
    ctx.stmts[idx].value = val
    return idx
}

fn parse_if(ctx: Ctx) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    ctx.pos = ctx.pos + 1
    let cond: int = parse_expr(ctx, false)
    let then_b: list[int] = parse_block(ctx)
    let mut else_b: list[int] = []
    if at_kw(ctx, "else") {
        ctx.pos = ctx.pos + 1
        if at_kw(ctx, "if") {
            else_b.push(parse_if(ctx))
        } else {
            else_b = parse_block(ctx)
        }
    }
    let idx: int = nx_stmt(ctx, "if", t.line)
    ctx.stmts[idx].cond = cond
    ctx.stmts[idx].body = then_b
    ctx.stmts[idx].else_body = else_b
    return idx
}

# --- Expression parsing ---

fn parse_expr(ctx: Ctx, allow_struct: bool) -> int {
    return parse_bin(ctx, 0, allow_struct)
}

fn op_at_level(level: int, op: str) -> bool {
    if level == 0 {
        return op == "||"
    }
    if level == 1 {
        return op == "&&"
    }
    if level == 2 {
        return op == "==" || op == "!="
    }
    if level == 3 {
        return op == "<" || op == "<=" || op == ">" || op == ">="
    }
    if level == 4 {
        return op == "+" || op == "-"
    }
    return op == "*" || op == "/" || op == "%"
}

fn parse_bin(ctx: Ctx, level: int, allow_struct: bool) -> int {
    if level >= 6 {
        return parse_unary(ctx, allow_struct)
    }
    let mut left: int = parse_bin(ctx, level + 1, allow_struct)
    while true {
        let t: Tok = ctx.toks.get(ctx.pos)
        if t.kind != "sym" {
            break
        }
        if !op_at_level(level, t.value) {
            break
        }
        ctx.pos = ctx.pos + 1
        let right: int = parse_bin(ctx, level + 1, allow_struct)
        let idx: int = nx_expr(ctx, "bin", t.line)
        ctx.exprs[idx].op = t.value
        ctx.exprs[idx].left = left
        ctx.exprs[idx].right = right
        left = idx
    }
    return left
}

fn parse_unary(ctx: Ctx, allow_struct: bool) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind == "sym" && (t.value == "!" || t.value == "-") {
        ctx.pos = ctx.pos + 1
        let mut e: int = parse_unary(ctx, allow_struct)
        if t.value == "-" && ctx.exprs[e].kind == "int" && ctx.exprs[e].op == "big" {
            ctx.exprs[e].op = ""
            return e
        }
        let idx: int = nx_expr(ctx, "un", t.line)
        ctx.exprs[idx].op = t.value
        ctx.exprs[idx].left = e
        return idx
    }
    return parse_postfix(ctx, allow_struct)
}

fn can_index(k: str) -> bool {
    # Deep-scan-10: qmark results are indexable (g()?[0] used to detach
    # the [0] into a stray statement).
    return k == "ident" || k == "field" || k == "index" || k == "call" || k == "method" || k == "fieldcall" || k == "qmark"
}

fn parse_postfix(ctx: Ctx, allow_struct: bool) -> int {
    let mut e: int = parse_primary(ctx, allow_struct)
    while true {
        let t: Tok = ctx.toks.get(ctx.pos)
        if t.kind != "sym" {
            break
        }
        if t.value == "." {
            ctx.pos = ctx.pos + 1
            let name: str = eat_ident(ctx)
            if at_sym(ctx, "(") {
                let args: list[int] = parse_args(ctx)
                let idx: int = nx_expr(ctx, "fieldcall", t.line)
                ctx.exprs[idx].name = name
                ctx.exprs[idx].left = e
                ctx.exprs[idx].args = args
                e = idx
            } else {
                let idx: int = nx_expr(ctx, "field", t.line)
                ctx.exprs[idx].name = name
                ctx.exprs[idx].left = e
                e = idx
            }
        } else if t.value == "[" && can_index(ctx.exprs[e].kind) {
            ctx.pos = ctx.pos + 1
            let idx_e: int = parse_expr(ctx, true)
            eat_sym(ctx, "]")
            let idx: int = nx_expr(ctx, "index", t.line)
            ctx.exprs[idx].left = e
            ctx.exprs[idx].right = idx_e
            e = idx
        } else if t.value == "(" && ctx.exprs[e].kind == "ident" {
            let args: list[int] = parse_args(ctx)
            let idx: int = nx_expr(ctx, "call", ctx.exprs[e].line)
            ctx.exprs[idx].name = ctx.exprs[e].name
            ctx.exprs[idx].args = args
            e = idx
        } else if t.value == "?" {
            ctx.pos = ctx.pos + 1
            let idx: int = nx_expr(ctx, "qmark", t.line)
            ctx.exprs[idx].left = e
            e = idx
        } else {
            break
        }
    }
    return e
}

fn parse_args(ctx: Ctx) -> list[int] {
    eat_sym(ctx, "(")
    let mut out: list[int] = []
    while !at_sym(ctx, ")") {
        out.push(parse_expr(ctx, true))
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, ")") {
            perr(ctx, "expected ',' or ')' in arguments")
        }
    }
    eat_sym(ctx, ")")
    return out
}

fn parse_match(ctx: Ctx) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    eat_kw(ctx, "match")
    let scrut: int = parse_expr(ctx, false)
    eat_sym(ctx, "{")
    let arm_idxs: list[int] = []
    while !at_sym(ctx, "}") {
        let arm_line_tok: Tok = ctx.toks.get(ctx.pos)
        let mut pat_kind: str = ""
        let mut enum_name: str = ""
        let mut variant: str = ""
        let mut bindings: list[str] = []
        let mut has_paren: bool = false
        # BUG-SC-16 fix: `_` is ALWAYS tokenized as an ident (byte 95 is a
        # valid ident-start char), never as a sym. The `at_sym(ctx, "_")`
        # check is dead code — removed for clarity (same as boot/parser.py
        # BUG-001 fix / BUG-18 cleanup).
        if at_ident(ctx, "_") {
            ctx.pos = ctx.pos + 1
            pat_kind = "wildcard"
        } else {
            pat_kind = "variant"
            # Deep-scan-10: a BARE variant pattern (no `Enum.` prefix) is
            # accepted per the SPEC §5 grammar; the checker resolves the
            # enum from the scrutinee's type (mirror of boot/parser.py).
            enum_name = eat_ident(ctx)
            variant = ""
            if at_sym(ctx, ".") {
                eat_sym(ctx, ".")
                variant = eat_ident(ctx)
            } else {
                variant = enum_name
                enum_name = ""
            }
            if at_sym(ctx, "(") {
                has_paren = true
                eat_sym(ctx, "(")
                while !at_sym(ctx, ")") {
                    if at_ident(ctx, "_") {
                        ctx.pos = ctx.pos + 1
                        bindings.push("_")
                    } else {
                        bindings.push(eat_ident(ctx))
                    }
                    if at_sym(ctx, ",") {
                        ctx.pos = ctx.pos + 1
                    } else if !at_sym(ctx, ")") {
                        perr(ctx, "expected ',' or ')' in variant pattern")
                    }
                }
                eat_sym(ctx, ")")
            }
        }
        eat_sym(ctx, "=>")
        let body: int = parse_expr(ctx, true)
        let arm_idx: int = nx_match_arm(ctx, pat_kind, enum_name, variant, bindings,
                                       has_paren, body, arm_line_tok.line)
        arm_idxs.push(arm_idx)
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, "}") {
            perr(ctx, "expected ',' or '}' in match arms")
        }
    }
    eat_sym(ctx, "}")
    let idx: int = nx_expr(ctx, "match", t.line)
    ctx.exprs[idx].left = scrut
    ctx.exprs[idx].args = arm_idxs
    return idx
}

fn parse_primary(ctx: Ctx, allow_struct: bool) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    if t.kind == "int" {
        ctx.pos = ctx.pos + 1
        let idx: int = nx_expr(ctx, "int", t.line)
        # BUG-015 fix: strip leading zeros before the length check, so that
        # a 20-char literal like "09223372036854775808" (= 2^63 with a leading
        # zero) is treated as 19-char "9223372036854775808" — matching Stage-0's
        # behaviour. Stage-0 uses Python int() which strips leading zeros
        # automatically; the self-hosted uses string comparison so it must do
        # so explicitly.
        let mut v: str = t.value
        let mut stripped: str = v
        while stripped.len() > 1 && stripped.byte_at(0) == 48 {
            stripped = stripped.slice(1, stripped.len())
        }
        v = stripped
        if v.len() > 19 {
            perr_at(ctx, "integer literal too large (exceeds int64)", t)
        } else if v.len() == 19 && v > "9223372036854775808" {
            perr_at(ctx, "integer literal too large (exceeds int64)", t)
        } else if v.len() == 19 && v == "9223372036854775808" {
            ctx.exprs[idx].ival = -9223372036854775808
            ctx.exprs[idx].op = "big"
        } else {
            ctx.exprs[idx].ival = v.to_int()
        }
        return idx
    }
    if t.kind == "float" {
        ctx.pos = ctx.pos + 1
        let idx: int = nx_expr(ctx, "float", t.line)
        ctx.exprs[idx].fval = t.value.to_float()
        return idx
    }
    if t.kind == "str" {
        ctx.pos = ctx.pos + 1
        let idx: int = nx_expr(ctx, "str", t.line)
        ctx.exprs[idx].sval = t.value
        return idx
    }
    if t.kind == "kw" && (t.value == "true" || t.value == "false") {
        ctx.pos = ctx.pos + 1
        let idx: int = nx_expr(ctx, "bool", t.line)
        ctx.exprs[idx].bval = t.value == "true"
        return idx
    }
    if t.kind == "kw" && t.value == "match" {
        return parse_match(ctx)
    }
    if t.kind == "ident" {
        if allow_struct && peek2_is(ctx, "{") {
            return parse_struct_lit(ctx)
        }
        ctx.pos = ctx.pos + 1
        let idx: int = nx_expr(ctx, "ident", t.line)
        ctx.exprs[idx].name = t.value
        return idx
    }
    if t.kind == "sym" && t.value == "(" {
        ctx.pos = ctx.pos + 1
        let mut e: int = parse_expr(ctx, true)
        eat_sym(ctx, ")")
        return e
    }
    if t.kind == "sym" && t.value == "[" {
        ctx.pos = ctx.pos + 1
        let items: list[int] = []
        while !at_sym(ctx, "]") {
            items.push(parse_expr(ctx, true))
            if at_sym(ctx, ",") {
                ctx.pos = ctx.pos + 1
            } else if !at_sym(ctx, "]") {
                perr(ctx, "expected ',' or ']' in list literal")
            }
        }
        eat_sym(ctx, "]")
        let idx: int = nx_expr(ctx, "listlit", t.line)
        ctx.exprs[idx].args = items
        return idx
    }
    perr(ctx, "expected expression but got " + tok_desc(ctx))
    return -1
}

fn parse_struct_lit(ctx: Ctx) -> int {
    let t: Tok = ctx.toks.get(ctx.pos)
    let name: str = t.value
    ctx.pos = ctx.pos + 1
    eat_sym(ctx, "{")
    let fnames: list[str] = []
    let fexprs: list[int] = []
    while !at_sym(ctx, "}") {
        let fname: str = eat_ident(ctx)
        eat_sym(ctx, ":")
        fnames.push(fname)
        fexprs.push(parse_expr(ctx, true))
        if at_sym(ctx, ",") {
            ctx.pos = ctx.pos + 1
        } else if !at_sym(ctx, "}") {
            perr(ctx, "expected ',' or '}' in struct literal")
        }
    }
    eat_sym(ctx, "}")
    let idx: int = nx_expr(ctx, "structlit", t.line)
    ctx.exprs[idx].name = name
    ctx.exprs[idx].ffields = fnames
    ctx.exprs[idx].args = fexprs
    return idx
}

# ----------------------------------------------------------------------------
# 4. CHECKER — type check + effects analysis (the security heart)
# ----------------------------------------------------------------------------

fn cerr(line: int, msg: str) -> void {
    panic("type error: " + msg + " (line " + line.to_str() + ")")
}

fn is_builtin_fn(n: str) -> bool {
    return n == "print" || n == "println" || n == "panic" || n == "exit"
        || n == "str" || n == "int" || n == "len" || n == "range"
        || n == "map_new" || n == "read_file" || n == "write_file"
        || n == "args" || n == "clock_ms" || n == "chr"
        || n == "file_exists"
        # Stage 8-alpha ownership primitives
        || n == "drop" || n == "clone" || n == "take"
        # Stage 10-alpha taint primitives
        || n == "tainted_args" || n == "taint_mark" || n == "taint_unwrap"
        # Stage 10-beta: more taint sources
        || n == "read_file_tainted"
        # Stage 10 release: read_line — third taint source (stdin)
        || n == "read_line"
        # Stage 9 release (v0.20.0-alpha): Net / Rand / Proc builtins
        || n == "net_lookup" || n == "rand_int" || n == "rand_float"
        || n == "rand_seed" || n == "proc_exec"
        # Stage 16 (v0.27.0-alpha): concurrency builtins. Stage-16
        # perfection (v0.29.0-alpha) adds chan_new_bounded.
        || n == "chan_new" || n == "chan_new_bounded" || n == "spawn" || n == "select"
        # Stage 19 (v0.35.0-alpha): O(n) string join — see boot/checker.py.
        # hlc itself joins the whole generated C file through this builtin
        # (the old accumulating HLS-level join was quadratic and dominated
        # the bootstrap's compile time).
        || n == "join"
    # Stage 21 (v0.37.0-alpha): SIMD feature dispatch builtins.
    || n == "has_feature" || n == "simd_cpu_supports"
}

fn list_has(list: list[str], x: str) -> bool {
    let mut i: int = 0
    while i < list.len() {
        if list.get(i) == x {
            return true
        }
        i = i + 1
    }
    return false
}

fn type_exists(ctx: Ctx, t: str) -> bool {
    if t == "int" || t == "float" || t == "bool" || t == "str" {
        return true
    }
    if list_has(ctx.cur_typeparams, t) {
        return true
    }
    if is_list_t(t) {
        return type_exists(ctx, list_elem_t(t))
    }
    if is_map_t(t) {
        return type_exists(ctx, map_val_t(t))
    }
    if is_taint_t(t) {
        # Stage 10-alpha: tainted[T] is a built-in generic wrapper; the
        # inner type must exist but `tainted` itself needs no struct/enum.
        return type_exists(ctx, taint_inner_t(t))
    }
    if is_chan_t(t) {
        # Stage 16: Chan[T] is a built-in generic wrapper.
        return type_exists(ctx, chan_inner_t(t))
    }
    if is_task_t(t) {
        # Stage 16: Task[R] is a built-in generic wrapper (R may be void).
        if task_inner_t(t) == "void" {
            return true
        }
        return type_exists(ctx, task_inner_t(t))
    }
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    if ctx.structs.has(base) {
        let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
        if st.typeparams.len() != args.len() {
            return false
        }
        let mut i: int = 0
        while i < args.len() {
            if !type_exists(ctx, args.get(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }
    if ctx.enums.has(base) {
        let en: EnumInfo = ctx.enums.get_or(base, dummy_enum())
        if en.typeparams.len() != args.len() {
            return false
        }
        let mut i: int = 0
        while i < args.len() {
            if !type_exists(ctx, args.get(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }
    return false
}

fn require_type(ctx: Ctx, t: str, line: int, what: str) -> void {
    if t == "void" {
        cerr(line, "cannot use 'void' as " + what)
    }
    if !type_exists(ctx, t) {
        cerr(line, "type does not exist: " + t)
    }
}

# resolve_struct(ctx, t) returns the (StructInfo, type_map) if t is a
# (possibly generic) struct type. Otherwise returns a struct whose name is "".
fn resolve_struct(ctx: Ctx, t: str) -> StructInfo {
    let base: str = type_base(t)
    if !ctx.structs.has(base) {
        return dummy_struct()
    }
    let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
    let args: list[str] = type_args(t)
    if st.typeparams.len() != args.len() {
        return dummy_struct()
    }
    # If non-generic, just return the struct (no type map).
    if st.typeparams.len() == 0 {
        return st
    }
    # For generic struct, return the struct; the caller will need to know
    # the type args (it can extract them from `t`).
    return st
}

# build_type_map(ctx, typeparams, args) — returns a parallel list of typeargs
# corresponding to typeparams (used by callers that need to instantiate).
# (We use lists since HLS has no map of str->str.)

fn dummy_binding() -> Binding {
    return Binding { t: "", is_mut: false, moved: false }
}

fn lookup_binding(env: list[map[str, Binding]], name: str) -> Binding {
    let mut i: int = env.len() - 1
    while i >= 0 {
        if env.get(i).has(name) {
            return env.get(i).get_or(name, dummy_binding())
        }
        i = i - 1
    }
    return dummy_binding()
}

fn lookup_exists(env: list[map[str, Binding]], name: str) -> bool {
    let mut i: int = env.len() - 1
    while i >= 0 {
        if env.get(i).has(name) {
            return true
        }
        i = i - 1
    }
    return false
}

# --- Stage 8-alpha ownership helpers (v0.4.0-alpha) ---
# Bindings carry a `moved` flag (Stage 8-alpha). These helpers mutate the flag
# in place (HLS maps are mutable through .set()).

fn mark_moved(env: list[map[str, Binding]], name: str) -> bool {
    let mut i: int = env.len() - 1
    while i >= 0 {
        if env.get(i).has(name) {
            let b: Binding = env.get(i).get_or(name, dummy_binding())
            env.get(i).set(name, Binding { t: b.t, is_mut: b.is_mut, moved: true })
            return true
        }
        i = i - 1
    }
    return false
}

fn revive_binding(env: list[map[str, Binding]], name: str) -> bool {
    let mut i: int = env.len() - 1
    while i >= 0 {
        if env.get(i).has(name) {
            let b: Binding = env.get(i).get_or(name, dummy_binding())
            env.get(i).set(name, Binding { t: b.t, is_mut: b.is_mut, moved: false })
            return true
        }
        i = i - 1
    }
    return false
}

# BUG-003 fix: snapshot_moved / restore_moved mirror Stage-0's snapshot/
# restore for the `moved` flag. They are used around `if`/`while`/`for`
# bodies so that moves done inside a child scope don't leak out — the
# branch may not execute, so any binding "moved" inside should still be
# considered unmoved after the construct completes.
#
# Snapshot format: a list of (scope_index, name, moved) tuples. We use
# a flat list of strings "i|name|0|1" because HLS maps require str keys.
fn snapshot_moved(env: list[map[str, Binding]]) -> list[str] {
    let snap: list[str] = []
    let mut i: int = 0
    while i < env.len() {
        let scope: map[str, Binding] = env.get(i)
        let names: list[str] = scope.keys()
        let mut j: int = 0
        while j < names.len() {
            let nm: str = names.get(j)
            let b: Binding = scope.get_or(nm, dummy_binding())
            let mut mv: str = "0"
            if b.moved {
                mv = "1"
            }
            snap.push(i.to_str() + "|" + nm + "|" + mv)
            j = j + 1
        }
        i = i + 1
    }
    return snap
}

fn restore_moved(env: list[map[str, Binding]], snap: list[str]) -> void {
    let mut i: int = 0
    while i < snap.len() {
        let entry: str = snap.get(i)
        # Format is "scope_idx|name|0or1". Identifier names never contain '|',
        # so split("|") yields exactly 3 parts. (If a future name contains '|',
        # the snapshot format would need to change — but identifiers can't.)
        let parts: list[str] = entry.split("|")
        if parts.len() < 3 {
            i = i + 1
            continue
        }
        let scope_idx: int = parts.get(0).to_int()
        let nm: str = parts.get(1)
        let mv_str: str = parts.get(2)
        if scope_idx < env.len() {
            let scope: map[str, Binding] = env.get(scope_idx)
            if scope.has(nm) {
                let b: Binding = scope.get_or(nm, dummy_binding())
                let mut mv: bool = false
                if mv_str == "1" {
                    mv = true
                }
                scope.set(nm, Binding { t: b.t, is_mut: b.is_mut, moved: mv })
            }
        }
        i = i + 1
    }
}

# is_owned_type: True if values of this type are heap-owned and subject to
# move tracking. Primitives (int/float/bool) are Copy — passing them is fine.
fn is_owned_type(t: str) -> bool {
    if t == "int" || t == "float" || t == "bool" || t == "void" || t == "never" {
        return false
    }
    return true
}

# is_clone_supported: True if clone() supports this type. Stage 8-beta
# (v0.19.0-alpha) expands clone() to EVERY owned type — str, list, map,
# struct, enum, tainted[...] — via per-instantiation codegen helpers
# (hl_clone_<mangled-type>) and the interpreter's deep_clone.
fn is_clone_supported(t: str) -> bool {
    if t == "str" {
        return true
    }
    if is_list_t(t) {
        return is_clone_supported(list_elem_t(t))
    }
    if is_map_t(t) {
        return is_clone_supported(map_val_t(t))
    }
    if is_taint_t(t) {
        return is_clone_supported(taint_inner_t(t))
    }
    # struct / enum / any other owned type
    return true
}

fn add_edge(ctx: Ctx, cur: str, callee: str) -> void {
    if !ctx.edges.has(cur) {
        ctx.edges.set(cur, [])
    }
    ctx.edges.get_or(cur, []).push(callee)
}

# --- Stage 9-alpha: fine-grained effects helpers (v0.5.0-alpha) ---

# builtin_effect(name) — the BUILTIN_EFFECTS table encoded as a function
# (HLS has no map-of-sets). Returns the list of effects a builtin requires
# (empty for pure builtins). Single-element lists today; future-proof for
# multi-effect builtins.
fn builtin_effect(name: str) -> list[str] {
    if name == "print" || name == "println" {
        return ["IO"]
    }
    if name == "read_file" || name == "write_file" || name == "file_exists" {
        return ["Fs"]
    }
    # Stage 10-beta: read_file_tainted is a taint source with the Fs effect.
    if name == "read_file_tainted" {
        return ["Fs"]
    }
    # Stage 10 release: read_line is a taint source with the IO effect
    # (reads from stdin; stdin is untrusted input).
    if name == "read_line" {
        return ["IO"]
    }
    if name == "clock_ms" {
        return ["Clock"]
    }
    if name == "args" || name == "tainted_args" {
        # Stage 10-alpha: tainted_args carries the same Args effect as args.
        return ["Args"]
    }
    if name == "exit" {
        return ["Exit"]
    }
    # Stage 9 release (v0.20.0-alpha): Net / Rand / Proc builtins.
    # Net, Rand, Proc are independent effects — NOT part of the IO
    # family. A program must declare them explicitly to use these
    # builtins; the fixpoint in check_effects enforces the subset rule.
    if name == "net_lookup" {
        return ["Net"]
    }
    if name == "rand_int" || name == "rand_float" || name == "rand_seed" {
        return ["Rand"]
    }
    if name == "proc_exec" {
        return ["Proc"]
    }
    # Stage 16 (v0.27.0-alpha): the concurrency effect. Every task /
    # channel operation carries `Conc`; a program must declare
    # `uses Conc` to use them. Builtin METHODS with effects are keyed
    # here by their op names ("chan.send", "chan.try_send",
    # "chan.recv", "chan.recv_or", "chan.len", "task.join") — the
    # fixpoint treats them exactly like builtin fns.
    if name == "chan_new" || name == "chan_new_bounded" || name == "spawn" || name == "select"
        || name == "chan.send" || name == "chan.try_send" || name == "chan.recv"
        || name == "chan.recv_or" || name == "chan.len" || name == "task.join" {
        return ["Conc"]
    }
    # taint_mark / taint_unwrap are pure (no effect; just wrap/unwrap).
    return []   # pure builtin
}

# effects_add(eff, key, e) — set-style insert into eff[key]'s list.
# Returns true if the set grew (used by the fixpoint to detect change).
fn effects_add(eff: map[str, list[str]], key: str, e: str) -> bool {
    if !eff.has(key) {
        eff.set(key, [])
    }
    let lst: list[str] = eff.get_or(key, [])
    if !list_has(lst, e) {
        lst.push(e)
        return true
    }
    return false
}

# fmt_effects(effs) — pretty-print an effect set for error messages.
# Empty set renders as "(none - pure)".
fn fmt_effects(effs: list[str]) -> str {
    if effs.len() == 0 {
        return "(none - pure)"
    }
    return join(effs, ", ")
}

# --- unify: try to match a parameter type `pt` against an argument type `at`,
# binding type params from `tps` to concrete types in `targs_out` (parallel to
# `tps`). Returns true if unification succeeded for any type params.
# targs_out is a parallel list: targs_out[i] is the inferred type for tps[i]
# (or "" if not yet inferred).
# ---

fn unify_into(ctx: Ctx, pt: str, at: str, tps: list[str], targs_out: list[str]) -> void {
    # Exact-match case: pt is a type param.
    let mut i: int = 0
    while i < tps.len() {
        if pt == tps.get(i) {
            # If already bound, prefer the existing binding (the first one wins
            # for simplicity; conflicts will be caught by the arg type check).
            if targs_out.get(i) == "" {
                targs_out.set(i, at)
            }
            return
        }
        i = i + 1
    }
    if is_list_t(pt) && is_list_t(at) {
        unify_into(ctx, list_elem_t(pt), list_elem_t(at), tps, targs_out)
        return
    }
    if is_map_t(pt) && is_map_t(at) {
        unify_into(ctx, map_val_t(pt), map_val_t(at), tps, targs_out)
        return
    }
    if is_taint_t(pt) && is_taint_t(at) {
        unify_into(ctx, taint_inner_t(pt), taint_inner_t(at), tps, targs_out)
        return
    }
    # Same base name — recurse into args.
    let pb: str = type_base(pt)
    let ab: str = type_base(at)
    # Both must have type args (i.e., be generic instantiations), and the
    # base names must match.
    if pb == ab && pt != pb && at != ab {
        # Both are generic instantiations of the same user type.
        let pa: list[str] = type_args(pt)
        let aa: list[str] = type_args(at)
        if pa.len() == aa.len() {
            let mut j: int = 0
            while j < pa.len() {
                unify_into(ctx, pa.get(j), aa.get(j), tps, targs_out)
                j = j + 1
            }
        }
    }
}

# unify_into_offset: like unify_into but writes into a SLICE of targs_out
# starting at `offset`. Used by check_method when inferring a method's own
# type params (which sit AFTER the struct's type params in targs_out).
# This avoids the BUG-002 throwaway-list issue where list_slice_from
# returns a fresh list and unify_into's .set() mutations never propagate.
fn unify_into_offset(ctx: Ctx, pt: str, at: str, tps: list[str], targs_out: list[str], offset: int) -> void {
    # Exact-match case: pt is a type param.
    let mut i: int = 0
    while i < tps.len() {
        if pt == tps.get(i) {
            if targs_out.get(offset + i) == "" {
                targs_out.set(offset + i, at)
            }
            return
        }
        i = i + 1
    }
    if is_list_t(pt) && is_list_t(at) {
        unify_into_offset(ctx, list_elem_t(pt), list_elem_t(at), tps, targs_out, offset)
        return
    }
    if is_map_t(pt) && is_map_t(at) {
        unify_into_offset(ctx, map_val_t(pt), map_val_t(at), tps, targs_out, offset)
        return
    }
    if is_taint_t(pt) && is_taint_t(at) {
        unify_into_offset(ctx, taint_inner_t(pt), taint_inner_t(at), tps, targs_out, offset)
        return
    }
    let pb: str = type_base(pt)
    let ab: str = type_base(at)
    if pb == ab && pt != pb && at != ab {
        let pa: list[str] = type_args(pt)
        let aa: list[str] = type_args(at)
        if pa.len() == aa.len() {
            let mut j: int = 0
            while j < pa.len() {
                unify_into_offset(ctx, pa.get(j), aa.get(j), tps, targs_out, offset)
                j = j + 1
            }
        }
    }
}

# --- Checker lifecycle ---

# estimate_stack_size (Stage 28, v0.45.0-alpha): conservatively
# estimate the function's stack frame size in bytes. Used to validate
# the #[stack_size(N)] attribute — if the estimate exceeds N, the
# checker raises a compile error (the body declares too many locals
# or nests too many call sites for the bound).
#
# The estimate is an UPPER BOUND on the frame gcc will emit for the
# type-correct HLS source:
#
#   - Each `let` binding in the body contributes sizeof(C type) bytes.
#     Every HLS type lowers to a C scalar of 8 bytes (int64_t, double,
#     or pointer). bool lowers to 1 byte but is rounded up to 8 for
#     alignment. void contributes 0 (no slot needed).
#   - Each `for` loop's iteration variable adds 8 bytes (a list element
#     pointer + an index temp; we conservatively count 8 to keep the
#     arithmetic simple — the runtime allocates 2 slots, not 1, but
#     gcc may merge them into one slot).
#   - Each nested call site adds 16 bytes (gcc spills the caller-saved
#     registers + the return-address slot for very-deep call chains;
#     this is the standard "call frame overhead" estimate used by gcc
#     itself in its -Wframe-larger-than check).
#   - Base overhead: 32 bytes (saved RBP, RBX, the frame pointer chain
#     + alignment padding to 16 bytes).
#
# The estimate is intentionally simple: we walk every statement
# (recursively into if/while/for bodies) and count occurrences. We
# don't try to model scope slot-reuse — gcc may overlap two sibling
# `let` slots, but the upper bound is what we want for a sound
# guarantee (the actual frame is always <= the estimate, so
# estimate <= N => frame <= N).
#
# Returns the estimate in bytes.
fn estimate_stack_size(ctx: Ctx, f: FnInfo) -> int {
    let mut bytes: int = 32  # base overhead (saved RBP / RBX / alignment)
    # Each parameter local adds 8 bytes (the body's owned copy of the
    # param; the signature's `<name>_p` is not in the frame, it's the
    # incoming register/stack-slot per the C ABI).
    let mut pi: int = 0
    while pi < f.params.len() {
        bytes = bytes + 8
        pi = pi + 1
    }
    # Walk the body, accumulating locals + call-site overhead.
    bytes = estimate_stack_size_stmts(ctx, f.body, bytes)
    return bytes
}

# estimate_stack_size_stmts walks a statement list, mutates `bytes`
# (passed by reference via the closure over the outer `bytes` —
# HLS doesn't have closures, so we return the accumulated value
# instead). The caller reassigns.
fn estimate_stack_size_stmts(ctx: Ctx, stmts: list[int], mut bytes: int) -> int {
    let mut i: int = 0
    while i < stmts.len() {
        bytes = estimate_stack_size_stmt(ctx, stmts.get(i), bytes)
        i = i + 1
    }
    return bytes
}

fn estimate_stack_size_stmt(ctx: Ctx, sidx: int, mut bytes: int) -> int {
    let s: StmtN = ctx.stmts[sidx]
    if s.kind == "let" {
        # Each let-binding contributes sizeof(C type). All HLS types
        # lower to 8-byte C scalars (int64_t / double / pointer); bool
        # lowers to 1 byte but is rounded up to 8 for alignment. void
        # contributes 0 (an unreachable binding, after a panic).
        if s.vtype == "void" {
            # void bindings are unreachable; no slot needed.
        } else {
            bytes = bytes + 8
        }
    } else if s.kind == "for" {
        # The for-loop adds an iteration variable (8 bytes) plus an
        # index temp (8 bytes) plus the list iterator handle (8 bytes).
        # Conservatively count 16 bytes for the loop's own overhead.
        bytes = bytes + 16
        bytes = estimate_stack_size_stmts(ctx, s.body, bytes)
    } else if s.kind == "while" {
        bytes = estimate_stack_size_stmts(ctx, s.body, bytes)
    } else if s.kind == "if" {
        bytes = estimate_stack_size_stmts(ctx, s.body, bytes)
        if s.else_body.len() > 0 {
            bytes = estimate_stack_size_stmts(ctx, s.else_body, bytes)
        }
    }
    # match is an EXPRESSION (lives in s.e / s.value); its arms are
    # walked by estimate_stack_calls (which recurses through match
    # arms via n.args -> MatchArm.body).
    #
    # Statement-position call sites add 16 bytes each (the call frame
    # overhead — gcc reserves a slot for the return address + the
    # caller-saved register spills for very deep chains). We detect
    # call sites by inspecting the statement's expression for a call
    # node. This is conservative — many expressions are not calls.
    if s.e >= 0 {
        bytes = bytes + estimate_stack_calls(ctx, s.e)
    }
    if s.value >= 0 && s.kind == "let" {
        bytes = bytes + estimate_stack_calls(ctx, s.value)
    }
    if s.cond >= 0 && (s.kind == "if" || s.kind == "while") {
        bytes = bytes + estimate_stack_calls(ctx, s.cond)
    }
    if s.iter >= 0 && s.kind == "for" {
        bytes = bytes + estimate_stack_calls(ctx, s.iter)
    }
    return bytes
}

# estimate_stack_calls: count the number of call sites in an
# expression tree (recursively). Each call site contributes 16 bytes
# to the frame estimate (call frame overhead).
fn estimate_stack_calls(ctx: Ctx, e: int) -> int {
    if e < 0 {
        return 0
    }
    let n: ExprN = ctx.exprs[e]
    let mut calls: int = 0
    if n.kind == "call" {
        calls = calls + 16
    }
    if n.kind == "match" {
        # match arms live in n.args (each is an index into
        # ctx.match_arms). The arm body is an expression; recurse.
        let mut ai: int = 0
        while ai < n.args.len() {
            let arm: MatchArm = ctx.match_arms[n.args.get(ai)]
            calls = calls + estimate_stack_calls(ctx, arm.body)
            ai = ai + 1
        }
    }
    if n.left >= 0 {
        calls = calls + estimate_stack_calls(ctx, n.left)
    }
    if n.right >= 0 {
        calls = calls + estimate_stack_calls(ctx, n.right)
    }
    let mut i: int = 0
    while i < n.args.len() {
        if n.kind != "match" {
            # For non-match, args are child expressions; for match they
            # are arm indices (already handled above).
            calls = calls + estimate_stack_calls(ctx, n.args.get(i))
        }
        i = i + 1
    }
    return calls
}

fn check_program(ctx: Ctx) -> void {
    # 1. struct: field types
    let keys_s: list[str] = ctx.structs.keys()
    let mut si: int = 0
    while si < keys_s.len() {
        let st: StructInfo = ctx.structs.get_or(keys_s.get(si), dummy_struct())
        ctx.cur_typeparams = st.typeparams
        let mut fi: int = 0
        while fi < st.ftypes.len() {
            require_type(ctx, st.ftypes.get(fi), st.line, "struct field type")
            fi = fi + 1
        }
        # Also check default-value expressions (must be of the declared type).
        let mut di: int = 0
        while di < st.fdefaults.len() {
            if st.fdefaults.get(di) != -1 {
                let env: list[map[str, Binding]] = []
                env.push(map_new())
                let vt: str = check_expr(ctx, env, "", st.fdefaults.get(di), st.ftypes.get(di))
                if vt != "never" && vt != st.ftypes.get(di) {
                    cerr(st.line, "default value of field " + st.fields.get(di) + " expects " + st.ftypes.get(di) + ", got " + vt)
                }
            }
            di = di + 1
        }
        ctx.cur_typeparams = []
        si = si + 1
    }
    # 2. enum: variant payload types
    let keys_e: list[str] = ctx.enums.keys()
    let mut ei: int = 0
    while ei < keys_e.len() {
        let en: EnumInfo = ctx.enums.get_or(keys_e.get(ei), dummy_enum())
        ctx.cur_typeparams = en.typeparams
        let mut vi: int = 0
        while vi < en.variants.len() {
            let pl: list[str] = en.payloads.get(vi)
            let mut pi: int = 0
            while pi < pl.len() {
                require_type(ctx, pl.get(pi), en.line, "variant payload type")
                pi = pi + 1
            }
            vi = vi + 1
        }
        ctx.cur_typeparams = []
        ei = ei + 1
    }
    # 3. function declarations
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let mut key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        ctx.cur_typeparams = f.typeparams
        if !f.is_method {
            if is_builtin_fn(f.name) {
                cerr(f.line, "cannot redefine builtin function: " + f.name)
            }
        } else {
            if !ctx.structs.has(f.struct_of) {
                cerr(f.line, "impl for non-existent struct: " + f.struct_of)
            }
            if f.params.len() == 0 {
                cerr(f.line, "method must have 'self' as first parameter")
            }
            if f.params.get(0) != "self" || f.ptypes.get(0) != f.struct_of {
                cerr(f.line, "method must have first parameter 'self: " + f.struct_of + "'")
            }
        }
        let mut j: int = 0
        while j < f.params.len() {
            require_type(ctx, f.ptypes.get(j), f.line, "parameter type")
            j = j + 1
        }
        if f.ret != "void" {
            if !type_exists(ctx, f.ret) {
                cerr(f.line, "return type does not exist: " + f.ret)
            }
        }
        # Stage 28 (v0.45.0-alpha): validate the #[stack_size(N)] bound
        # by statically estimating the function's frame size. The estimate
        # is conservative: count every let-binding / for-loop var in the
        # body (8 bytes each — every HLS type lowers to int64_t / double /
        # pointer, all 8 bytes), add 16 bytes per nested call (gcc spills
        # the caller-saved registers + return address slot), plus 32 bytes
        # base overhead (saved RBP / RBX / frame pointer chain). The
        # estimate is an UPPER BOUND — gcc may reuse slots across sibling
        # scopes, so the actual frame can be smaller, but it can never be
        # larger than this number for the type-correct HLS source. This
        # makes #[stack_size(N)] a sound guarantee: if the estimate <= N
        # then the emitted assembly's frame <= N.
        if f.attr_stack_size >= 0 && !f.is_extern {
            let est: int = estimate_stack_size(ctx, f)
            if est > f.attr_stack_size {
                cerr(f.line, "#[stack_size(" + f.attr_stack_size.to_str()
                    + ")] violated by function '" + f.name + "': estimated frame size is "
                    + est.to_str() + " bytes (the body declares too many locals or nests too many call sites for the bound). Reduce locals or raise the bound.")
            }
        }
        # Stage 28: #[irq_handler] is only valid on fns with signature
        # `fn(<single pointer param>) -> void` (gcc's interrupt attribute
        # requires a single pointer parameter that receives the saved
        # frame, and returns void).
        if f.attr_irq_handler && !f.is_extern {
            if f.ret != "void" {
                cerr(f.line, "#[irq_handler] requires the function to return 'void' (gcc's interrupt attribute); '" + f.name + "' returns '" + f.ret + "'")
            }
            if f.params.len() != 1 {
                cerr(f.line, "#[irq_handler] requires exactly one parameter (the saved-frame pointer); '" + f.name + "' has " + f.params.len().to_str())
            } else {
                # The single param MUST be a C pointer type (any HLS
                # type that lowers to a C pointer: str, list[T], map[...],
                # tainted[T]-of-pointer, Chan[T], Task[T], or any user
                # struct). `int`, `float`, `bool`, `void` lower to scalars
                # and are rejected.
                let pt: str = f.ptypes.get(0)
                if !is_ptr_type(pt) {
                    cerr(f.line, "#[irq_handler] requires its parameter to be a pointer-typed value (str / list[T] / struct / Chan / Task / tainted[T] of pointer); '" + f.name + "' has '" + pt + "' which lowers to a non-pointer C type and gcc's interrupt attribute would reject the signature")
                }
            }
        }
        ctx.cur_typeparams = []
        i = i + 1
    }
    # 4. main
    if !ctx.fns.has("main") {
        cerr(1, "missing main function")
    }
    let mf: FnInfo = ctx.fns.get_or("main", dummy_fn())
    if mf.is_method {
        cerr(mf.line, "main cannot be a method")
    }
    if mf.params.len() > 0 {
        cerr(mf.line, "main cannot have parameters")
    }
    if mf.ret != "int" && mf.ret != "void" {
        cerr(mf.line, "main must return 'int' or have no return type")
    }
    # 5. check function bodies
    let mut bi: int = 0
    while bi < ctx.fn_order.len() {
        check_fn_body(ctx, ctx.fn_order.get(bi))
        bi = bi + 1
    }
    # 6. effects analysis
    check_effects(ctx)
    # 7. collect all generic struct/enum instantiations used anywhere in
    # the program (signatures, let bindings, expression types) so the codegen
    # emits the corresponding C types.
    collect_all_insts(ctx)
}

# collect_insts walks a single type string and records any generic struct /
# enum instantiations it finds. Skips types that contain type parameters
# (they're abstract, not instantiated).
fn collect_insts(ctx: Ctx, t: str) -> void {
    if t == "" || t == "int" || t == "float" || t == "bool" || t == "str" || t == "void" || t == "never" {
        return
    }
    if is_list_t(t) {
        collect_insts(ctx, list_elem_t(t))
        return
    }
    if is_map_t(t) {
        collect_insts(ctx, map_val_t(t))
        return
    }
    if is_taint_t(t) {
        collect_insts(ctx, taint_inner_t(t))
        return
    }
    # Stage 16: recurse into the concurrency wrappers so that e.g. a
    # `Chan[Point]` binding forces the Point instantiation (its release
    # fn is referenced as the channel's elem_release).
    if is_chan_t(t) {
        collect_insts(ctx, chan_inner_t(t))
        return
    }
    if is_task_t(t) {
        collect_insts(ctx, task_inner_t(t))
        return
    }
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    # Skip if the base isn't a known struct/enum — it's a type param.
    if !ctx.structs.has(base) && !ctx.enums.has(base) {
        return
    }
    # Skip if any arg is not concrete (contains a type param).
    let mut i: int = 0
    while i < args.len() {
        if !type_is_concrete(ctx, args.get(i)) {
            return
        }
        i = i + 1
    }
    if ctx.structs.has(base) {
        let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
        if st.typeparams.len() > 0 && args.len() == st.typeparams.len() {
            if !list_has(ctx.struct_insts, t) {
                ctx.struct_insts.push(t)
            }
        }
    } else if ctx.enums.has(base) {
        let en: EnumInfo = ctx.enums.get_or(base, dummy_enum())
        if en.typeparams.len() > 0 && args.len() == en.typeparams.len() {
            if !list_has(ctx.enum_insts, t) {
                ctx.enum_insts.push(t)
            }
        }
    }
    # Recurse into args.
    let mut j: int = 0
    while j < args.len() {
        collect_insts(ctx, args.get(j))
        j = j + 1
    }
}

# type_is_concrete returns true if `t` doesn't contain any type parameters.
fn type_is_concrete(ctx: Ctx, t: str) -> bool {
    if t == "" {
        return false
    }
    if t == "int" || t == "float" || t == "bool" || t == "str" || t == "void" || t == "never" {
        return true
    }
    if is_list_t(t) {
        return type_is_concrete(ctx, list_elem_t(t))
    }
    if is_map_t(t) {
        return type_is_concrete(ctx, map_val_t(t))
    }
    if is_taint_t(t) {
        return type_is_concrete(ctx, taint_inner_t(t))
    }
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    if !ctx.structs.has(base) && !ctx.enums.has(base) {
        return false
    }
    let mut i: int = 0
    while i < args.len() {
        if !type_is_concrete(ctx, args.get(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn collect_all_insts(ctx: Ctx) -> void {
    # Function signatures.
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let f: FnInfo = ctx.fns.get_or(ctx.fn_order.get(i), dummy_fn())
        let mut j: int = 0
        while j < f.ptypes.len() {
            collect_insts(ctx, f.ptypes.get(j))
            j = j + 1
        }
        collect_insts(ctx, f.ret)
        i = i + 1
    }
    # Struct fields.
    let sk: list[str] = ctx.structs.keys()
    let mut si: int = 0
    while si < sk.len() {
        let st: StructInfo = ctx.structs.get_or(sk.get(si), dummy_struct())
        let mut fi: int = 0
        while fi < st.ftypes.len() {
            collect_insts(ctx, st.ftypes.get(fi))
            fi = fi + 1
        }
        si = si + 1
    }
    # Enum payloads.
    let ek: list[str] = ctx.enums.keys()
    let mut ei: int = 0
    while ei < ek.len() {
        let en: EnumInfo = ctx.enums.get_or(ek.get(ei), dummy_enum())
        let mut vi: int = 0
        while vi < en.variants.len() {
            let pl: list[str] = en.payloads.get(vi)
            let mut pi: int = 0
            while pi < pl.len() {
                collect_insts(ctx, pl.get(pi))
                pi = pi + 1
            }
            vi = vi + 1
        }
        ei = ei + 1
    }
    # All expression types (after check).
    let mut xi: int = 0
    while xi < ctx.exprs.len() {
        if ctx.exprs[xi].t != "" && ctx.exprs[xi].t != "never" {
            collect_insts(ctx, ctx.exprs[xi].t)
        }
        xi = xi + 1
    }
    # All let vtypes + for vtypes.
    let mut ssi: int = 0
    while ssi < ctx.stmts.len() {
        if ctx.stmts[ssi].vtype != "" {
            collect_insts(ctx, ctx.stmts[ssi].vtype)
        }
        ssi = ssi + 1
    }
}

fn dummy_struct() -> StructInfo {
    return StructInfo { name: "", fields: [], ftypes: [], fdefaults: [], typeparams: [], line: 0 }
}

fn dummy_enum() -> EnumInfo {
    return EnumInfo { name: "", variants: [], payloads: [], typeparams: [], line: 0 }
}

fn dummy_fn() -> FnInfo {
    return FnInfo {
        name: "", params: [], ptypes: [], pmuts: [], ret: "void",
        effects: [], is_pure: false, body: [], is_method: false, struct_of: "",
        typeparams: [], line: 0, is_extern: false,
        requires_e: -1, ensures_e: -1,
        attr_stack_size: -1, attr_no_red_zone: false, attr_irq_handler: false,
        attr_inline: "", attr_hot: false, attr_cold: false
    }
}

# ============================================================================
# Stage 17 (v0.28.0-alpha): contracts + the interval proof engine (HLS side)
# ============================================================================
# The proof engine mirrors boot/proof.py exactly: seed integer bounds from
# the `requires` conjuncts, propagate them through the body (straight-line
# arithmetic, if/else joins, const-bound for loops, conservative while
# widening), and annotate every provably-safe operation:
#   ovf_safe  — int + - * cannot overflow int64
#   div_safe  — the divisor cannot be 0 (nor the INT64_MIN/-1 overflow)
#   bnd_safe  — the index/byte_at/slice is within [0, len) by symbolic match
# Only PROVEN operations are annotated; everything unknown keeps its
# runtime check (soundness: never elide a check you cannot prove dead).
# Under -O fast the codegen reads these annotations and emits the
# unchecked forms (see gen_bin / gen_method / the index lowering).
# ============================================================================

# Interval bounds: sentinel values for -inf / +inf (HLS has no global
# constants, so they are functions). No practical contract seed produces
# exactly these values, so they are safe sentinels.
fn INF_LO() -> int {
    return -9223372036854775807 - 1
}

fn INF_HI() -> int {
    return 9223372036854775807
}

struct IVal {
    lo: int,
    hi: int
}

fn iv_top() -> IVal {
    return IVal { lo: INF_LO(), hi: INF_HI() }
}

fn iv_add(a: IVal, b: IVal) -> IVal {
    let mut lo: int = INF_LO()
    if a.lo != INF_LO() && b.lo != INF_LO() {
        lo = a.lo + b.lo
    }
    let mut hi: int = INF_HI()
    if a.hi != INF_HI() && b.hi != INF_HI() {
        hi = a.hi + b.hi
    }
    return IVal { lo: lo, hi: hi }
}

fn iv_sub(a: IVal, b: IVal) -> IVal {
    let mut lo: int = INF_LO()
    if a.lo != INF_LO() && b.hi != INF_HI() {
        lo = a.lo - b.hi
    }
    let mut hi: int = INF_HI()
    if a.hi != INF_HI() && b.lo != INF_LO() {
        hi = a.hi - b.lo
    }
    return IVal { lo: lo, hi: hi }
}

fn iv_mul(a: IVal, b: IVal) -> IVal {
    # Conservative: any sentinel bound (or a product corner that itself
    # hits a sentinel) yields TOP.
    if a.lo == INF_LO() || a.hi == INF_HI() || b.lo == INF_LO() || b.hi == INF_HI() {
        return iv_top()
    }
    let c1: int = a.lo * b.lo
    let c2: int = a.lo * b.hi
    let c3: int = a.hi * b.lo
    let c4: int = a.hi * b.hi
    if c1 == INF_LO() || c1 == INF_HI() || c2 == INF_LO() || c2 == INF_HI()
        || c3 == INF_LO() || c3 == INF_HI() || c4 == INF_LO() || c4 == INF_HI() {
        return iv_top()
    }
    let mut lo: int = c1
    if c2 < lo {
        lo = c2
    }
    if c3 < lo {
        lo = c3
    }
    if c4 < lo {
        lo = c4
    }
    let mut hi: int = c1
    if c2 > hi {
        hi = c2
    }
    if c3 > hi {
        hi = c3
    }
    if c4 > hi {
        hi = c4
    }
    return IVal { lo: lo, hi: hi }
}

fn iv_neg(a: IVal) -> IVal {
    let mut lo: int = INF_LO()
    if a.hi != INF_HI() {
        lo = -a.hi
    }
    let mut hi: int = INF_HI()
    if a.lo != INF_LO() {
        hi = -a.lo
    }
    return IVal { lo: lo, hi: hi }
}

# iv_join: the union (wider) of two intervals — used at if/else joins and
# while widenings.
fn iv_join(a: IVal, b: IVal) -> IVal {
    let mut lo: int = a.lo
    if b.lo < lo {
        lo = b.lo
    }
    let mut hi: int = a.hi
    if b.hi > hi {
        hi = b.hi
    }
    return IVal { lo: lo, hi: hi }
}

fn iv_fits(a: IVal) -> bool {
    # Deep-scan-10 CRITICAL soundness fix: an UNKNOWN (sentinel) bound
    # means the value may be anywhere - TOP used to 'fit' int64, so a
    # partially-unknown operand was annotated ovf_safe and -O fast
    # emitted a raw C op that silently wrapped (signed-overflow UB)
    # while the checked builds panicked. Both bounds must be FINITE
    # (a bound that equals a sentinel is treated as unknown - sound).
    if a.lo == INF_LO() {
        return false
    }
    if a.hi == INF_HI() {
        return false
    }
    return true
}

fn iv_contains(a: IVal, b: IVal) -> bool {
    # True if interval a contains interval b. The INF sentinels make
    # plain numeric comparisons do the right thing (INF_LO <= any lo,
    # any hi <= INF_HI).
    return a.lo <= b.lo && b.hi <= a.hi
}

fn iv_excl_zero(a: IVal) -> bool {
    if a.hi < 0 {
        return true
    }
    if a.lo > 0 {
        return true
    }
    return false
}

# seed_from_requires: walk the (already-checked) requires expression,
# extracting (var -> interval) facts from comparison conjuncts.
# facts: map[str, IVal]; facts_lenhi: map[str, str] — var -> the owner
# whose len() bounds it from above (x < s.len() => hi = len(s)-1);
# nz: vars proven != 0.
fn seed_from_requires(ctx: Ctx, e: int, f: FnInfo,
                      facts: map[str, IVal], facts_lenhi: map[str, str],
                      nz: map[str, bool]) -> void {
    if e < 0 {
        return
    }
    let node: ExprN = ctx.exprs[e]
    if node.kind == "bin" && node.op == "&&" {
        seed_from_requires(ctx, node.left, f, facts, facts_lenhi, nz)
        seed_from_requires(ctx, node.right, f, facts, facts_lenhi, nz)
        return
    }
    if node.kind != "bin" {
        return
    }
    let op: str = node.op
    let l: int = node.left
    let r: int = node.right
    let ln: ExprN = ctx.exprs[l]
    let rn: ExprN = ctx.exprs[r]
    # var OP int-literal
    if ln.kind == "ident" && is_int_param(f, ln.name) && rn.kind == "int" {
        seed_bound(facts, ln.name, op, rn.ival, true)
        return
    }
    if rn.kind == "ident" && is_int_param(f, rn.name) && ln.kind == "int" {
        seed_bound(facts, rn.name, op, ln.ival, false)
        return
    }
    # var != 0 with the var an int param (both orders). v0.30.0-alpha:
    # nz is a map so branches can join (AND) and reassignment can kill.
    if op == "!=" && ln.kind == "int" && ln.ival == 0 && rn.kind == "ident" {
        if is_int_param(f, rn.name) {
            nz.set(rn.name, true)
        }
        return
    }
    if op == "!=" && rn.kind == "int" && rn.ival == 0 && ln.kind == "ident" {
        if is_int_param(f, ln.name) {
            nz.set(ln.name, true)
        }
        return
    }
    # var < s.len() / var <= s.len() — symbolic upper bound on the var.
    # Deep-scan-10 soundness fix: ONLY the STRICT `<` (var <= len-1)
    # proves an INDEX; `<=` (var <= len) is valid solely as a slice
    # END bound. The two forms are distinguished by a "~" suffix on the
    # stored owner (identifiers cannot contain ~, so the encodings
    # cannot collide).
    if ln.kind == "ident" && is_int_param(f, ln.name) && is_len_of(ctx, r) {
        if op == "<" {
            facts_lenhi.set(ln.name, len_owner(ctx, r))
        } else if op == "<=" {
            facts_lenhi.set(ln.name, len_owner(ctx, r) + "~")
        }
        return
    }
    # s.len() > var / s.len() >= var
    if rn.kind == "ident" && is_int_param(f, rn.name) && is_len_of(ctx, l) {
        if op == ">" {
            facts_lenhi.set(rn.name, len_owner(ctx, l))
        } else if op == ">=" {
            facts_lenhi.set(rn.name, len_owner(ctx, l) + "~")
        }
        return
    }
    # Minimum-length facts: s.len() >= K (either order) — stored in
    # facts_lenhi under the key "~ml~<owner>" (encoded as a decimal
    # string; the prefix cannot collide with identifiers) so the bounds
    # checks can use the numeric route.
    if op == ">=" || op == ">" || op == "==" {
        if is_len_of(ctx, l) && rn.kind == "int" {
            let owner: str = len_owner(ctx, l)
            let mut k: int = rn.ival
            if op == ">" {
                k = k + 1
            }
            set_minlen(facts_lenhi, owner, k)
            return
        }
        if is_len_of(ctx, r) && ln.kind == "int" {
            let owner2: str = len_owner(ctx, r)
            let mut k2: int = ln.ival
            if op == "<" {
                k2 = k2 + 1
            }
            set_minlen(facts_lenhi, owner2, k2)
            return
        }
    }
}

# set_minlen: record minlen[owner] = k (keep the MAXIMUM when merged).
fn set_minlen(facts_lenhi: map[str, str], owner: str, k: int) -> void {
    # The "~ml~" prefix cannot appear in any HLS identifier, so no
    # variable name can collide with these synthetic keys (deep-scan-10).
    let key: str = "~ml~" + owner
    if !facts_lenhi.has(key) {
        facts_lenhi.set(key, k.to_str())
        return
    }
    let cur: str = facts_lenhi.get_or(key, "0")
    let curv: int = str_to_int_simple(cur)
    if k > curv {
        facts_lenhi.set(key, k.to_str())
    }
}

# get_minlen: read minlen[owner]; -1 when absent.
fn get_minlen(facts_lenhi: map[str, str], owner: str) -> int {
    let key: str = "~ml~" + owner
    if !facts_lenhi.has(key) {
        return -1
    }
    return str_to_int_simple(facts_lenhi.get_or(key, "-1"))
}

# str_to_int_simple: parse a non-negative decimal (no signs).
fn str_to_int_simple(s: str) -> int {
    if s.len() == 0 {
        return -1
    }
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c < 48 || c > 57 {
            return -1
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

# is_int_param: the name is a param of f with type int.
fn is_int_param(f: FnInfo, name: str) -> bool {
    let mut i: int = 0
    while i < f.params.len() {
        if f.params.get(i) == name && f.ptypes.get(i) == "int" {
            return true
        }
        i = i + 1
    }
    return false
}

# is_len_of: the expr is `len(var)` or `var.len()` (checked nodes carry
# mkey / mop annotations).
fn is_len_of(ctx: Ctx, e: int) -> bool {
    let n: ExprN = ctx.exprs[e]
    if n.kind == "call" && n.mkey == "len" {
        return true
    }
    if n.kind == "method" {
        if n.mop == "str.len" || n.mop == "list.len" || n.mop == "map.len" {
            return true
        }
    }
    return false
}

# len_owner: the variable whose length the expr takes.
fn len_owner(ctx: Ctx, e: int) -> str {
    let n: ExprN = ctx.exprs[e]
    if n.kind == "call" && n.mkey == "len" && n.args.len() == 1 {
        let a: ExprN = ctx.exprs[n.args.get(0)]
        if a.kind == "ident" {
            return a.name
        }
    }
    if n.kind == "method" {
        let t: ExprN = ctx.exprs[n.left]
        if t.kind == "ident" {
            return t.name
        }
    }
    return "?"
}

# seed_bound: apply `var OP k` (var on the left) / `k OP var` (flipped).
fn seed_bound(facts: map[str, IVal], var: str, op: str, k: int, var_left: bool) -> void {
    let mut eff: str = op
    if !var_left {
        if op == "<" {
            eff = ">"
        } else if op == "<=" {
            eff = ">="
        } else if op == ">" {
            eff = "<"
        } else if op == ">=" {
            eff = "<="
        }
    }
    let old: IVal = facts.get_or(var, iv_top())
    let lo: int = old.lo
    let hi: int = old.hi
    if eff == ">=" {
        if lo == INF_LO() || k > lo {
            facts.set(var, IVal { lo: k, hi: hi })
        }
        return
    }
    if eff == ">" {
        let nk: int = k + 1
        if lo == INF_LO() || nk > lo {
            facts.set(var, IVal { lo: nk, hi: hi })
        }
        return
    }
    if eff == "<=" {
        if hi == INF_HI() || k < hi {
            facts.set(var, IVal { lo: lo, hi: k })
        }
        return
    }
    if eff == "<" {
        let nk2: int = k - 1
        if hi == INF_HI() || nk2 < hi {
            facts.set(var, IVal { lo: lo, hi: nk2 })
        }
        return
    }
    if eff == "==" {
        facts.set(var, IVal { lo: k, hi: k })
        return
    }
}

# expr_interval: best-effort interval of an int expression under facts.
fn expr_interval(ctx: Ctx, e: int, facts: map[str, IVal], depth: int) -> IVal {
    if e < 0 || depth > 24 {
        return iv_top()
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return IVal { lo: n.ival, hi: n.ival }
    }
    if n.kind == "ident" {
        if facts.has(n.name) {
            return facts.get_or(n.name, iv_top())
        }
        return iv_top()
    }
    if n.kind == "un" && n.op == "-" {
        return iv_neg(expr_interval(ctx, n.left, facts, depth + 1))
    }
    if n.kind == "bin" {
        if n.op == "+" {
            return iv_add(expr_interval(ctx, n.left, facts, depth + 1),
                          expr_interval(ctx, n.right, facts, depth + 1))
        }
        if n.op == "-" {
            return iv_sub(expr_interval(ctx, n.left, facts, depth + 1),
                          expr_interval(ctx, n.right, facts, depth + 1))
        }
        if n.op == "*" {
            return iv_mul(expr_interval(ctx, n.left, facts, depth + 1),
                          expr_interval(ctx, n.right, facts, depth + 1))
        }
    }
    return iv_top()
}

# annotate_exprs: walk one expression tree, setting the safety verdicts.
# v0.30.0-alpha (deep-scan-10): every verdict is RESET on each pass -
# the loop analysis visits expressions in multiple passes (Kleene
# rounds + the final invariant pass) and a stale True from a
# too-precise intermediate pass must never survive. The symbolic len
# lookups now resolve the INDEX VARIABLE (the old code looked up the
# CONTAINER name in a map keyed by index vars - the lookup could never
# match, so the symbolic route was dead code and the engines diverged).
fn annotate_exprs(ctx: Ctx, e: int, facts: map[str, IVal],
                  facts_lenhi: map[str, str], nz: map[str, bool], depth: int) -> void {
    if e < 0 || depth > 64 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    # int + - * / % provability (each verdict is set BOTH ways).
    if n.kind == "bin" && n.t == "int" {
        if n.op == "+" {
            ctx.exprs[e].ovf_safe = iv_fits(iv_add(expr_interval(ctx, n.left, facts, 0),
                                                   expr_interval(ctx, n.right, facts, 0)))
        } else if n.op == "-" {
            ctx.exprs[e].ovf_safe = iv_fits(iv_sub(expr_interval(ctx, n.left, facts, 0),
                                                   expr_interval(ctx, n.right, facts, 0)))
        } else if n.op == "*" {
            ctx.exprs[e].ovf_safe = iv_fits(iv_mul(expr_interval(ctx, n.left, facts, 0),
                                                   expr_interval(ctx, n.right, facts, 0)))
        } else if n.op == "/" || n.op == "%" {
            # Division safety: divisor excludes zero (numeric or the nz
            # map), and not the INT64_MIN / -1 overflow corner (an
            # unbounded-below dividend lo == INF_LO() IS INT64_MIN for
            # the sentinel arithmetic, so the corner fires correctly).
            let ri: IVal = expr_interval(ctx, n.right, facts, 0)
            let mut okz: bool = iv_excl_zero(ri)
            if !okz {
                let rn: ExprN = ctx.exprs[n.right]
                if rn.kind == "ident" && nz.get_or(rn.name, false) {
                    okz = true
                }
            }
            let mut proven: bool = false
            if okz {
                let li: IVal = expr_interval(ctx, n.left, facts, 0)
                let mut corner: bool = false
                if li.lo == INF_LO() {
                    if ri.lo <= -1 && ri.hi >= -1 {
                        corner = true
                    }
                }
                if !corner {
                    proven = true
                }
            }
            ctx.exprs[e].div_safe = proven
        }
    }
    # Index bounds provability: xs[i] with i in [0, len(xs)-1].
    if n.kind == "index" {
        let tn: ExprN = ctx.exprs[n.left]
        if tn.kind == "ident" {
            ctx.exprs[e].bnd_safe = false  # reset each pass
            let ii: IVal = expr_interval(ctx, n.right, facts, 0)
            if ii.lo >= 0 {
                # Symbolic route: the INDEX expression is an ident var
                # carrying a STRICT len bound (x < s.len()) that points
                # at THIS container (a "~"-suffixed <= bound must NOT
                # match - x == len is out of bounds).
                let mut sym_ok: bool = false
                let idxn: ExprN = ctx.exprs[n.right]
                if idxn.kind == "ident" {
                    let owner: str = facts_lenhi.get_or(idxn.name, "")
                    if owner == tn.name {
                        sym_ok = true
                    }
                }
                if sym_ok {
                    ctx.exprs[e].bnd_safe = true
                } else {
                    # Numeric route: i in [lo, hi] with hi < minlen[container].
                    let ml: int = get_minlen(facts_lenhi, tn.name)
                    if ml > 0 && ii.hi != INF_HI() && ii.hi < ml {
                        ctx.exprs[e].bnd_safe = true
                    }
                }
            }
        }
    }
    # s.byte_at(i) / s.slice(a, b) provability.
    if n.kind == "method" && (n.mop == "str.byte_at" || n.mop == "str.slice") {
        let tn2: ExprN = ctx.exprs[n.left]
        if tn2.kind == "ident" {
            ctx.exprs[e].bnd_safe = false  # reset each pass
            if n.mop == "str.byte_at" && n.args.len() == 1 {
                let idxe: int = n.args.get(0)
                let idxn2: ExprN = ctx.exprs[idxe]
                let ii2: IVal = expr_interval(ctx, idxe, facts, 0)
                if ii2.lo >= 0 {
                    # Symbolic: the index ident has a strict len bound on
                    # THIS string.
                    let mut sym_ok2: bool = false
                    if idxn2.kind == "ident" {
                        let owner2: str = facts_lenhi.get_or(idxn2.name, "")
                        if owner2 == tn2.name {
                            sym_ok2 = true
                        }
                    }
                    if sym_ok2 {
                        ctx.exprs[e].bnd_safe = true
                    } else {
                        let ml2: int = get_minlen(facts_lenhi, tn2.name)
                        if ml2 > 0 && ii2.hi != INF_HI() && ii2.hi < ml2 {
                            ctx.exprs[e].bnd_safe = true
                        }
                    }
                }
            }
            if n.mop == "str.slice" && n.args.len() == 2 {
                # slice(a, b): 0 <= a, a <= b PROVEN, and b <= len.
                let ai: IVal = expr_interval(ctx, n.args.get(0), facts, 0)
                let bi: IVal = expr_interval(ctx, n.args.get(1), facts, 0)
                if ai.lo >= 0 {
                    # a <= b must be PROVEN (deep-scan-10: an unknown a
                    # upper bound used to count as proven - slice(5, 2)
                    # was elided and the runtime panicked on a negative
                    # length).
                    let a_le_b: bool = ai.hi != INF_HI() && bi.lo != INF_LO()
                        && ai.hi <= bi.lo
                    if a_le_b {
                        # b <= len: the strict symbolic bound (owner) or
                        # the non-strict one (owner~), or the numeric
                        # minlen route.
                        let bn: ExprN = ctx.exprs[n.args.get(1)]
                        let mut ok_b: bool = false
                        if bn.kind == "ident" {
                            let ownerb: str = facts_lenhi.get_or(bn.name, "")
                            if ownerb == tn2.name || ownerb == tn2.name + "~" {
                                ok_b = true
                            }
                        }
                        let ml3: int = get_minlen(facts_lenhi, tn2.name)
                        if !ok_b && ml3 > 0 && bi.hi != INF_HI() && bi.hi < ml3 {
                            ok_b = true
                        }
                        if ok_b {
                            ctx.exprs[e].bnd_safe = true
                        }
                    }
                }
            }
        }
    }
    # Recurse.
    annotate_exprs(ctx, n.left, facts, facts_lenhi, nz, depth + 1)
    annotate_exprs(ctx, n.right, facts, facts_lenhi, nz, depth + 1)
    let mut i: int = 0
    while i < n.args.len() {
        annotate_exprs(ctx, n.args.get(i), facts, facts_lenhi, nz, depth + 1)
        i = i + 1
    }
    if n.kind == "match" {
        let mut a2: int = 0
        while a2 < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a2))
            annotate_exprs(ctx, arm.body, facts, facts_lenhi, nz, depth + 1)
            a2 = a2 + 1
        }
        annotate_exprs(ctx, n.left, facts, facts_lenhi, nz, depth + 1)
    }
    if n.kind == "qmark" {
        annotate_exprs(ctx, n.left, facts, facts_lenhi, nz, depth + 1)
    }
}

# const_range_count: for `range(a, b)` with int literals, the iteration
# count (b - a if positive, else 0); -1 if not a const range.
fn const_range_count(ctx: Ctx, e: int) -> int {
    if e < 0 {
        return -1
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind != "call" || n.mkey != "range" || n.args.len() != 2 {
        return -1
    }
    let a: ExprN = ctx.exprs[n.args.get(0)]
    let b: ExprN = ctx.exprs[n.args.get(1)]
    if a.kind != "int" || b.kind != "int" {
        return -1
    }
    if b.ival > a.ival {
        return b.ival - a.ival
    }
    return 0
}

# annotate_stmts: walk statements, updating facts for int lets/assigns,
# if/else joins, for-range bounds; annotate every expression.
#
# v0.30.0-alpha (Stage-17 perfection, mirrors boot/proof.py):
#   * while conditions are annotated with the LOOP INVARIANT (entry
#     facts joined over body outcomes, widened) - the old code used the
#     entry facts, but the condition is re-evaluated on EVERY iteration
#     with loop-modified values (false bnd_safe -> native OOB reads);
#   * while loops run two Kleene rounds + the widening operator + a
#     POST-FIXPOINT VERIFICATION pass (vars whose outcome still escapes
#     the invariant go TOP - the verification is what makes a bounded
#     number of rounds sound);
#   * for-range(a, b) seeds the loop var in [a, b-1] (the old code
#     seeded [0, count-1] - wrong on both bounds whenever a != 0);
#     non-const-range loops seed TOP (list elements may be negative);
#   * facts are joined AFTER for/while loops too (stale entry facts for
#     loop-modified vars used to survive - a false div_safe);
#   * let/assign invalidates nz / minlen / symbolic-len facts derived
#     from the reassigned variable's value (deep-scan-10).
fn annotate_stmts(ctx: Ctx, stmts: list[int], facts: map[str, IVal],
                  facts_lenhi: map[str, str], nz: map[str, bool], depth: int) -> void {
    if depth > 32 {
        return
    }
    let mut si: int = 0
    while si < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(si))
        if s.kind == "while" {
            # The condition is annotated with the invariant INSIDE this
            # branch (not with the entry facts below).
            let body: list[int] = s.body
            # Round 1: exact body outcome from the entry facts.
            let w1: map[str, IVal] = copy_facts(facts)
            let lh1: map[str, str] = copy_lenhi(facts_lenhi)
            let nz1: map[str, bool] = copy_nz(nz)
            annotate_stmts(ctx, body, w1, lh1, nz1, depth + 1)
            let f1: map[str, IVal] = copy_facts(facts)
            widen_facts(f1, w1)
            # Round 2: body outcome from the joined facts.
            let w2: map[str, IVal] = copy_facts(f1)
            let lh2: map[str, str] = copy_lenhi(facts_lenhi)
            let nz2: map[str, bool] = copy_nz(nz)
            annotate_stmts(ctx, body, w2, lh2, nz2, depth + 1)
            let f2: map[str, IVal] = copy_facts(f1)
            widen_facts(f2, w2)
            # Widen growth to infinity (the classic widening operator).
            let finv: map[str, IVal] = copy_facts(f2)
            let k2: list[str] = f2.keys()
            let mut k2i: int = 0
            while k2i < k2.len() {
                let key: str = k2.get(k2i)
                if f1.has(key) {
                    let v1: IVal = f1.get_or(key, iv_top())
                    let v2: IVal = f2.get_or(key, iv_top())
                    finv.set(key, widen_growth_iv(v1, v2))
                }
                k2i = k2i + 1
            }
            # POST-FIXPOINT VERIFICATION: run the body once more from the
            # invariant; any var whose outcome escapes goes TOP (the top
            # element cannot grow, so this stabilises).
            let mut round: int = 0
            while round < 4 {
                let wchk: map[str, IVal] = copy_facts(finv)
                let lhc: map[str, str] = copy_lenhi(facts_lenhi)
                let nzc: map[str, bool] = copy_nz(nz)
                annotate_stmts(ctx, body, wchk, lhc, nzc, depth + 1)
                let ck: list[str] = wchk.keys()
                let mut cki: int = 0
                let grew: list[str] = []
                while cki < ck.len() {
                    let ckey: str = ck.get(cki)
                    if finv.has(ckey) {
                        let cur: IVal = finv.get_or(ckey, iv_top())
                        let outv: IVal = wchk.get_or(ckey, iv_top())
                        if !iv_contains(cur, outv) {
                            grew.push(ckey)
                        }
                    }
                    cki = cki + 1
                }
                if grew.len() == 0 {
                    break
                }
                let mut gi: int = 0
                while gi < grew.len() {
                    finv.set(grew.get(gi), iv_top())
                    gi = gi + 1
                }
                round = round + 1
            }
            # Annotate the CONDITION with the invariant (it is evaluated
            # before every iteration, with loop-modified values), then
            # the final body pass under the invariant.
            annotate_exprs(ctx, s.cond, finv, facts_lenhi, nz, 0)
            let wfin: map[str, IVal] = copy_facts(finv)
            let lhfin: map[str, str] = copy_lenhi(facts_lenhi)
            let nzfin: map[str, bool] = copy_nz(nz)
            annotate_stmts(ctx, body, wfin, lhfin, nzfin, depth + 1)
            # Post-loop state: facts := finv (stale keys go TOP - maps
            # cannot delete entries).
            let fk: list[str] = finv.keys()
            let mut fki: int = 0
            while fki < fk.len() {
                facts.set(fk.get(fki), finv.get_or(fk.get(fki), iv_top()))
                fki = fki + 1
            }
            let oldk: list[str] = facts.keys()
            let mut oki: int = 0
            while oki < oldk.len() {
                let ok: str = oldk.get(oki)
                if !finv.has(ok) {
                    facts.set(ok, iv_top())
                }
                oki = oki + 1
            }
            si = si + 1
            continue
        }
        if s.kind == "for" {
            # The iter expression sees the entry facts (it is evaluated
            # once, before the loop).
            annotate_exprs(ctx, s.iter, facts, facts_lenhi, nz, 0)
            let f_body2: map[str, IVal] = copy_facts(facts)
            # SOUNDNESS: int vars assigned inside the loop can change
            # across iterations — their entry facts may not hold at
            # iteration 2+. Widen them to TOP (the loop variable itself
            # is immutable and gets the const-range bound).
            let mods: list[str] = assigned_int_vars_hlc(ctx, s.body)
            let mut mi: int = 0
            while mi < mods.len() {
                if mods.get(mi) != s.name {
                    f_body2.set(mods.get(mi), iv_top())
                }
                mi = mi + 1
            }
            if s.name != "" {
                if is_const_range(ctx, s.iter) {
                    # deep-scan-10: range(a, b) iterates a..b-1 - the old
                    # [0, count-1] was wrong on BOTH bounds when a != 0.
                    f_body2.set(s.name, IVal { lo: const_range_a(ctx, s.iter),
                                               hi: const_range_b(ctx, s.iter) - 1 })
                } else {
                    # deep-scan-10: iterating a list yields arbitrary
                    # element values - TOP, not [0, +inf).
                    f_body2.set(s.name, iv_top())
                }
            }
            annotate_stmts(ctx, s.body, f_body2, facts_lenhi, nz, depth + 1)
            # Post-loop: join the entry facts with the body outcome; the
            # loop var goes TOP (out of scope / stale).
            widen_facts(facts, f_body2)
            facts.set(s.name, iv_top())
            si = si + 1
            continue
        }
        # Annotate the statement's expressions FIRST (pre-state facts).
        annotate_exprs(ctx, s.value, facts, facts_lenhi, nz, 0)
        annotate_exprs(ctx, s.cond, facts, facts_lenhi, nz, 0)
        annotate_exprs(ctx, s.e, facts, facts_lenhi, nz, 0)
        if s.target >= 0 {
            # For `xs[i] = v`, annotate the index subexpression.
            let tgt: ExprN = ctx.exprs[s.target]
            if tgt.kind == "index" {
                annotate_exprs(ctx, tgt.right, facts, facts_lenhi, nz, 0)
            }
        }
        # Update facts from let / assign. Deep-scan-10 (Stage-17
        # perfection): the VALUE-fact invalidation (nz / minlen /
        # symbolic len bounds) runs for EVERY binding write — int or
        # not. Reassigning a LIST invalidates its minimum-length fact
        # (`requires xs.len() >= 3` then `xs = [1]`); the old code only
        # invalidated int targets, so a stale minlen proved an
        # out-of-bounds index (the fast build SIGSEGV'd).
        if s.kind == "let" {
            invalidate_value_facts(nz, facts_lenhi, s.name)
            if s.vtype == "int" {
                facts.set(s.name, expr_interval(ctx, s.value, facts, 0))
            }
        }
        if s.kind == "assign" && s.target >= 0 {
            let tgt2: ExprN = ctx.exprs[s.target]
            if tgt2.kind == "ident" {
                invalidate_value_facts(nz, facts_lenhi, tgt2.name)
                if tgt2.t == "int" {
                    facts.set(tgt2.name, expr_interval(ctx, s.value, facts, 0))
                }
            }
        }
        if s.kind == "if" {
            # Branch-local copies; join (union) afterwards.
            let f_then: map[str, IVal] = copy_facts(facts)
            let f_else: map[str, IVal] = copy_facts(facts)
            let lh_then: map[str, str] = copy_lenhi(facts_lenhi)
            let lh_else: map[str, str] = copy_lenhi(facts_lenhi)
            let nz_then: map[str, bool] = copy_nz(nz)
            let nz_else: map[str, bool] = copy_nz(nz)
            annotate_stmts(ctx, s.body, f_then, lh_then, nz_then, depth + 1)
            annotate_stmts(ctx, s.else_body, f_else, lh_else, nz_else, depth + 1)
            join_facts(facts, f_then, f_else)
            join_lenhi(facts_lenhi, lh_then, lh_else)
            join_nz(nz, nz_then, nz_else)
        }
        si = si + 1
    }
}

# copy_facts: shallow-copy an IVal map.
fn copy_facts(facts: map[str, IVal]) -> map[str, IVal] {
    let out: map[str, IVal] = map_new()
    let keys: list[str] = facts.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        out.set(k, facts.get_or(k, iv_top()))
        i = i + 1
    }
    return out
}

# join_facts: facts := union(f_then, f_else) for every key in either.
fn join_facts(facts: map[str, IVal], f_then: map[str, IVal], f_else: map[str, IVal]) -> void {
    let keys: list[str] = f_then.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        if f_else.has(k) {
            let a: IVal = f_then.get_or(k, iv_top())
            let b: IVal = f_else.get_or(k, iv_top())
            facts.set(k, iv_join(a, b))
        } else {
            # Only one branch redefined it -> the other path keeps the
            # old (possibly wider) value: widen to top.
            facts.set(k, iv_top())
        }
        i = i + 1
    }
    let keys2: list[str] = f_else.keys()
    let mut j: int = 0
    while j < keys2.len() {
        let k2: str = keys2.get(j)
        if !f_then.has(k2) {
            facts.set(k2, iv_top())
        }
        j = j + 1
    }
}

# widen_facts: facts := union(facts, f_body) — a while body may run any
# number of times, so every fact the body may change becomes the union.
fn widen_facts(facts: map[str, IVal], f_body: map[str, IVal]) -> void {
    let keys: list[str] = f_body.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        if facts.has(k) {
            let a: IVal = facts.get_or(k, iv_top())
            let b: IVal = f_body.get_or(k, iv_top())
            facts.set(k, iv_join(a, b))
        }
        i = i + 1
    }
}

# widen_growth_iv: the standard interval WIDENING operator - bounds
# that grew between the two Kleene rounds go to infinity; bounds that
# did not grow are kept (this is what preserves e.g. `i >= 0` across a
# `while i < n { i = i + 1 }` loop). v0.30.0-alpha.
fn widen_growth_iv(a: IVal, b: IVal) -> IVal {
    let mut lo: int = a.lo
    let mut hi: int = a.hi
    if b.lo < lo {
        lo = INF_LO()
    }
    if b.hi > hi {
        hi = INF_HI()
    }
    return IVal { lo: lo, hi: hi }
}

# copy_lenhi / copy_nz: shallow copies of the symbolic-bound and
# non-zero maps (they are now per-branch, like the interval facts -
# v0.30.0-alpha).
fn copy_lenhi(lh: map[str, str]) -> map[str, str] {
    let out: map[str, str] = map_new()
    let keys: list[str] = lh.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        out.set(k, lh.get_or(k, ""))
        i = i + 1
    }
    return out
}

fn copy_nz(nz: map[str, bool]) -> map[str, bool] {
    let out: map[str, bool] = map_new()
    let keys: list[str] = nz.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        out.set(k, nz.get_or(k, false))
        i = i + 1
    }
    return out
}

# join_lenhi: after an if/else, a symbolic len bound survives only if
# BOTH branches still have it (same value); a minlen entry becomes the
# MIN of the two (both branches bound it below). Keys are set to dead
# markers otherwise (maps cannot delete).
fn join_lenhi(facts_lenhi: map[str, str], a: map[str, str], b: map[str, str]) -> void {
    let keys: list[str] = a.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        let va: str = a.get_or(k, "")
        if b.has(k) {
            let vb: str = b.get_or(k, "")
            if is_minlen_key(k) {
                let na: int = str_to_int_simple(va)
                let nb: int = str_to_int_simple(vb)
                if na <= nb {
                    facts_lenhi.set(k, va)
                } else {
                    facts_lenhi.set(k, vb)
                }
            } else {
                if va == vb {
                    facts_lenhi.set(k, va)
                } else {
                    facts_lenhi.set(k, "")
                }
            }
        } else {
            facts_lenhi.set(k, "")
        }
        i = i + 1
    }
}

fn is_minlen_key(k: str) -> bool {
    return k.len() >= 4 && k.slice(0, 4) == "~ml~"
}

# join_nz: a non-zero fact survives an if/else only if BOTH branches
# proved it (AND-join).
fn join_nz(nz: map[str, bool], a: map[str, bool], b: map[str, bool]) -> void {
    let keys: list[str] = a.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        let va: bool = a.get_or(k, false)
        let vb: bool = b.get_or(k, false)
        nz.set(k, va && vb)
        i = i + 1
    }
}

# invalidate_value_facts: reassigning `tname` kills every fact derived
# from its VALUE - the nz entry, the minimum-length fact, and every
# symbolic len bound pointing at it (deep-scan-10: `requires
# xs.len() >= 3` then `xs = [1]` used to keep the stale minlen and
# prove an out-of-bounds index; likewise y != 0 then y = 0 kept
# div_safe).
fn invalidate_value_facts(nz: map[str, bool], facts_lenhi: map[str, str], tname: str) -> void {
    nz.set(tname, false)
    let mlkey: str = "~ml~" + tname
    if facts_lenhi.has(mlkey) {
        facts_lenhi.set(mlkey, "0")
    }
    let keys: list[str] = facts_lenhi.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        if !is_minlen_key(k) {
            let owner: str = facts_lenhi.get_or(k, "")
            if owner == tname || owner == tname + "~" {
                facts_lenhi.set(k, "")
            }
        }
        i = i + 1
    }
}

# is_const_range / const_range_a / const_range_b: `range(a, b)` with
# both bounds int literals. v0.30.0-alpha: the loop variable spans
# [a, b-1] (the old engine seeded [0, count-1]).
fn is_const_range(ctx: Ctx, e: int) -> bool {
    if e < 0 {
        return false
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind != "call" || n.mkey != "range" || n.args.len() != 2 {
        return false
    }
    let a: ExprN = ctx.exprs[n.args.get(0)]
    let b: ExprN = ctx.exprs[n.args.get(1)]
    if a.kind != "int" || b.kind != "int" {
        return false
    }
    return true
}

fn const_range_a(ctx: Ctx, e: int) -> int {
    let n: ExprN = ctx.exprs[e]
    return ctx.exprs[n.args.get(0)].ival
}

fn const_range_b(ctx: Ctx, e: int) -> int {
    let n: ExprN = ctx.exprs[e]
    return ctx.exprs[n.args.get(1)].ival
}


# assigned_int_vars_hlc: every int variable assigned (let/assign target)
# anywhere in the statement tree — the loop-carried-fact soundness set.
fn assigned_int_vars_hlc(ctx: Ctx, stmts: list[int]) -> list[str] {
    let out: list[str] = []
    collect_assigned_int_vars(ctx, stmts, out, 0)
    return out
}

fn collect_assigned_int_vars(ctx: Ctx, stmts: list[int], out: list[str], depth: int) -> void {
    if depth > 64 {
        return
    }
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if s.kind == "let" && s.vtype == "int" {
            if !list_has(out, s.name) {
                out.push(s.name)
            }
        }
        if s.kind == "assign" && s.target >= 0 {
            let tgt: ExprN = ctx.exprs[s.target]
            if tgt.kind == "ident" {
                # Overapproximate: include non-int targets too (they are
                # absent from the int facts map, so this is harmless).
                if !list_has(out, tgt.name) {
                    out.push(tgt.name)
                }
            }
        }
        collect_assigned_int_vars(ctx, s.body, out, depth + 1)
        collect_assigned_int_vars(ctx, s.else_body, out, depth + 1)
        i = i + 1
    }
}

# check_contracts_hlc: validate the contract expressions of one fn (bool
# type, purity, params + result scope), then seed + annotate.
fn check_contracts_hlc(ctx: Ctx, key: str, f: FnInfo) -> void {
    # Contract environment: ONLY the params (+ `result` for ensures).
    let env: list[map[str, Binding]] = []
    let scope: map[str, Binding] = map_new()
    let mut i: int = 0
    while i < f.params.len() {
        scope.set(f.params.get(i), Binding { t: f.ptypes.get(i), is_mut: false, moved: false })
        i = i + 1
    }
    env.push(scope)
    if f.requires_e >= 0 {
        let t: str = check_expr(ctx, env, key, f.requires_e, "")
        if t != "bool" && t != "never" {
            cerr(f.line, "requires clause of '" + f.name + "' must be bool, got " + t)
        }
        check_contract_purity_hlc(ctx, f.requires_e, f.name)
    }
    if f.ensures_e >= 0 {
        if f.ret == "void" {
            cerr(f.line, "ensures clause on void function '" + f.name + "' (there is no result)")
        }
        env[0].set("result", Binding { t: f.ret, is_mut: false, moved: false })
        let t2: str = check_expr(ctx, env, key, f.ensures_e, "")
        if t2 != "bool" && t2 != "never" {
            cerr(f.line, "ensures clause of '" + f.name + "' must be bool, got " + t2)
        }
        check_contract_purity_hlc(ctx, f.ensures_e, f.name)
    }
}

# run_proof_pass_hlc: seed interval facts from the (validated) requires
# clause and annotate the body's provably-safe operations. Runs AFTER
# the body was checked — the annotations read ctx.exprs[e].t.
fn run_proof_pass_hlc(ctx: Ctx, f: FnInfo) -> void {
    if f.requires_e < 0 || f.is_extern {
        return
    }
    let facts: map[str, IVal] = map_new()
    let facts_lenhi: map[str, str] = map_new()
    let nz: map[str, bool] = map_new()
    seed_from_requires(ctx, f.requires_e, f, facts, facts_lenhi, nz)
    annotate_stmts(ctx, f.body, facts, facts_lenhi, nz, 0)
}

# check_contract_purity_hlc: contract expressions may not call anything
# except len() / .len().
fn check_contract_purity_hlc(ctx: Ctx, e: int, fname: str) -> void {
    if e < 0 {
        return
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "call" {
        if n.mkey != "len" {
            cerr(n.line, "contract expression of '" + fname + "' calls '" + n.mkey + "' — contracts must be pure (only literals, parameters, arithmetic, comparisons and len() are allowed)")
        }
    }
    if n.kind == "method" {
        if n.mop != "str.len" && n.mop != "list.len" && n.mop != "map.len" {
            cerr(n.line, "contract expression of '" + fname + "' calls method '" + n.mop + "' — contracts must be pure")
        }
    }
    check_contract_purity_hlc(ctx, n.left, fname)
    check_contract_purity_hlc(ctx, n.right, fname)
    let mut i: int = 0
    while i < n.args.len() {
        check_contract_purity_hlc(ctx, n.args.get(i), fname)
        i = i + 1
    }
}

# const_eval_hlc: evaluate a requires under constant arguments.
# Returns: 0 = false, 1 = true, -1 = unknown.
fn const_eval_hlc(ctx: Ctx, e: int, consts: map[str, int], sconsts: map[str, str]) -> int {
    if e < 0 {
        return -1
    }
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        if n.ival == 0 {
            return 0
        }
        return 1
    }
    if n.kind == "bool" {
        if n.bval {
            return 1
        }
        return 0
    }
    if n.kind == "ident" {
        if consts.has(n.name) {
            if consts.get_or(n.name, 1) == 0 {
                return 0
            }
            return 1
        }
        return -1
    }
    if n.kind == "bin" {
        if n.op == "&&" {
            let l: int = const_eval_hlc(ctx, n.left, consts, sconsts)
            if l == 0 {
                return 0
            }
            let r: int = const_eval_hlc(ctx, n.right, consts, sconsts)
            if r == 0 {
                return 0
            }
            if l == 1 && r == 1 {
                return 1
            }
            return -1
        }
        if n.op == "||" {
            let l2: int = const_eval_hlc(ctx, n.left, consts, sconsts)
            if l2 == 1 {
                return 1
            }
            let r2: int = const_eval_hlc(ctx, n.right, consts, sconsts)
            if r2 == 1 {
                return 1
            }
            if l2 == 0 && r2 == 0 {
                return 0
            }
            return -1
        }
        # Numeric comparisons on int consts.
        if consts_expr(ctx, n.left, consts) && consts_expr(ctx, n.right, consts) {
            let lv: int = expr_const_val(ctx, n.left, consts)
            let rv: int = expr_const_val(ctx, n.right, consts)
            if n.op == "==" {
                if lv == rv { return 1 }
                return 0
            }
            if n.op == "!=" {
                if lv != rv { return 1 }
                return 0
            }
            if n.op == "<" {
                if lv < rv { return 1 }
                return 0
            }
            if n.op == "<=" {
                if lv <= rv { return 1 }
                return 0
            }
            if n.op == ">" {
                if lv > rv { return 1 }
                return 0
            }
            if n.op == ">=" {
                if lv >= rv { return 1 }
                return 0
            }
        }
        return -1
    }
    if n.kind == "call" && n.mkey == "len" {
        if n.args.len() == 1 {
            let a: ExprN = ctx.exprs[n.args.get(0)]
            if a.kind == "ident" && sconsts.has(a.name) {
                let s: str = sconsts.get_or(a.name, "")
                if s.len() == 0 {
                    return 0
                }
                return 1
            }
        }
    }
    return -1
}

# consts_expr: every leaf of the int comparison is a const.
fn consts_expr(ctx: Ctx, e: int, consts: map[str, int]) -> bool {
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return true
    }
    if n.kind == "ident" {
        return consts.has(n.name)
    }
    if n.kind == "bin" && (n.op == "+" || n.op == "-" || n.op == "*" || n.op == "/" || n.op == "%") {
        return consts_expr(ctx, n.left, consts) && consts_expr(ctx, n.right, consts)
    }
    if n.kind == "un" && n.op == "-" {
        return consts_expr(ctx, n.left, consts)
    }
    return false
}

# expr_const_val: the numeric value of a consts_expr tree.
fn expr_const_val(ctx: Ctx, e: int, consts: map[str, int]) -> int {
    let n: ExprN = ctx.exprs[e]
    if n.kind == "int" {
        return n.ival
    }
    if n.kind == "ident" {
        return consts.get_or(n.name, 0)
    }
    if n.kind == "un" && n.op == "-" {
        return -expr_const_val(ctx, n.left, consts)
    }
    if n.kind == "bin" {
        let lv: int = expr_const_val(ctx, n.left, consts)
        let rv: int = expr_const_val(ctx, n.right, consts)
        if n.op == "+" {
            return lv + rv
        }
        if n.op == "-" {
            return lv - rv
        }
        if n.op == "*" {
            return lv * rv
        }
        if n.op == "/" {
            if rv == 0 {
                return 0
            }
            return lv / rv
        }
        if n.op == "%" {
            if rv == 0 {
                return 0
            }
            return lv % rv
        }
    }
    return 0
}

# args_const_hlc: build the consts maps when every argument is a literal
# of matching kind; returns true on success.
fn args_const_hlc(ctx: Ctx, f: FnInfo, e: int, consts: map[str, int], sconsts: map[str, str]) -> bool {
    let n: ExprN = ctx.exprs[e]
    if n.args.len() != f.params.len() {
        return false
    }
    let mut i: int = 0
    while i < n.args.len() {
        let a: ExprN = ctx.exprs[n.args.get(i)]
        let pt: str = f.ptypes.get(i)
        if pt == "int" {
            if a.kind != "int" {
                return false
            }
            consts.set(f.params.get(i), a.ival)
        } else if pt == "str" {
            if a.kind != "str" {
                return false
            }
            sconsts.set(f.params.get(i), a.sval)
        } else if pt == "bool" {
            if a.kind != "bool" {
                return false
            }
            if a.bval {
                consts.set(f.params.get(i), 1)
            } else {
                consts.set(f.params.get(i), 0)
            }
        } else {
            return false
        }
        i = i + 1
    }
    return true
}

fn check_fn_body(ctx: Ctx, key: str) -> void {
    let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
    let saved_ret: str = ctx.cur_fn_ret
    let saved_tp: list[str] = ctx.cur_typeparams
    # Stage 17 (v0.28.0-alpha): validate the contracts (and, for
    # contracted fns, run the interval proof pass over the body).
    check_contracts_hlc(ctx, key, f)
    # Stage 15-beta: extern fns have NO body — they are forward declarations
    # for C functions. Skip body checking and the "must return on all paths"
    # check. They still participate in effects analysis (their declared
    # effects propagate to callers).
    if f.is_extern {
        ctx.cur_fn_ret = saved_ret
        ctx.cur_typeparams = saved_tp
        return
    }
    ctx.cur_fn_ret = f.ret
    ctx.cur_typeparams = f.typeparams
    let env: list[map[str, Binding]] = []
    let scope0: map[str, Binding] = map_new()
    if f.is_method {
        scope0.set(f.params.get(0), Binding { t: f.ptypes.get(0), is_mut: f.pmuts.get(0), moved: false })
        let mut i: int = 1
        while i < f.params.len() {
            scope0.set(f.params.get(i), Binding { t: f.ptypes.get(i), is_mut: f.pmuts.get(i), moved: false })
            i = i + 1
        }
    } else {
        let mut i: int = 0
        while i < f.params.len() {
            let pn: str = f.params.get(i)
            if scope0.has(pn) {
                cerr(f.line, "duplicate parameter name: " + pn)
            }
            scope0.set(pn, Binding { t: f.ptypes.get(i), is_mut: f.pmuts.get(i), moved: false })
            i = i + 1
        }
    }
    env.push(scope0)
    check_stmts(ctx, env, key, f, f.body, false)
    if f.ret != "void" {
        if !all_return(ctx, f.body) {
            cerr(f.line, "function '" + f.name + "' does not return on all paths")
        }
    }
    # Stage 17: the interval proof pass runs AFTER the body was checked
    # (the annotations read ctx.exprs[e].t).
    run_proof_pass_hlc(ctx, f)
    ctx.cur_fn_ret = saved_ret
    ctx.cur_typeparams = saved_tp
}

fn all_return(ctx: Ctx, stmts: list[int]) -> bool {
    if stmts.len() == 0 {
        return false
    }
    let last: int = stmts.get(stmts.len() - 1)
    let mut k: str = ctx.stmts[last].kind
    if k == "return" {
        return true
    }
    if k == "expr" && ctx.exprs[ctx.stmts[last].e].t == "never" {
        return true
    }
    # BUG-SC-5 fix: a `let` or `assign` whose RHS is `never`-typed
    # (e.g. `let x: int = panic("...")`) always diverges, so the
    # function returns on all paths. Previously this was rejected with
    # a spurious "does not return on all paths" error.
    if k == "let" && ctx.exprs[ctx.stmts[last].value].t == "never" {
        return true
    }
    if k == "assign" && ctx.exprs[ctx.stmts[last].value].t == "never" {
        return true
    }
    if k == "if" {
        if ctx.stmts[last].else_body.len() > 0 {
            return all_return(ctx, ctx.stmts[last].body) && all_return(ctx, ctx.stmts[last].else_body)
        }
    }
    if k == "expr" && ctx.exprs[ctx.stmts[last].e].kind == "match" {
        if match_all_return(ctx, ctx.stmts[last].e) {
            return true
        }
    }
    return false
}

fn match_all_return(ctx: Ctx, e: int) -> bool {
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let arm_idx: int = ctx.exprs[e].args.get(i)
        let arm: MatchArm = ctx.match_arms.get(arm_idx)
        # BUG-009 fix: removed dead `let body_k: str = ctx.stmts[0].kind`
        # line — that accessed the FIRST statement in the entire program
        # (not the arm body's statement) and was unused. The actual check
        # below uses arm.body_t which is the arm body's type (set during
        # check_match).
        # arm.body is an expression index; we check if it's a return wrapped
        # in an expression-statement. But arms are expressions — they don't
        # contain return statements directly. So a match can only be a
        # "return on all paths" if all arms are `never`-typed (e.g., all arms
        # are calls to `panic()`). Otherwise we cannot prove it returns.
        # For simplicity, treat all arms that have body_t == "never" as
        # returning.
        if arm.body_t != "never" {
            return false
        }
        i = i + 1
    }
    return ctx.exprs[e].args.len() > 0
}

fn check_stmts(ctx: Ctx, env: list[map[str, Binding]], cur: str, f: FnInfo, stmts: list[int], in_loop: bool) -> void {
    let mut i: int = 0
    while i < stmts.len() {
        check_stmt(ctx, env, cur, f, stmts.get(i), in_loop)
        i = i + 1
    }
}

fn check_stmt(ctx: Ctx, env: list[map[str, Binding]], cur: str, f: FnInfo, sidx: int, in_loop: bool) -> void {
    let s: StmtN = ctx.stmts[sidx]
    if s.kind == "let" {
        require_type(ctx, s.vtype, s.line, "variable type")
        if lookup_exists(env, s.name) {
            cerr(s.line, "shadowing not allowed: " + s.name)
        }
        let vt: str = check_expr(ctx, env, cur, s.value, s.vtype)
        if vt == "never" {
            # `let x: T = panic()` is sound: x is unreachable.
            env.get(env.len() - 1).set(s.name, Binding { t: s.vtype, is_mut: s.is_mut, moved: false })
            return
        }
        if vt != s.vtype {
            cerr(s.line, "type mismatch: declared " + s.vtype + " but got " + vt)
        }
        env.get(env.len() - 1).set(s.name, Binding { t: s.vtype, is_mut: s.is_mut, moved: false })
    } else if s.kind == "assign" {
        check_assign(ctx, env, cur, s)
    } else if s.kind == "if" {
        let ct: str = check_expr(ctx, env, cur, s.cond, "")
        if ct != "bool" {
            cerr(s.line, "if condition must be bool, got " + ct)
        }
        # BUG-003 fix: snapshot moved-status so moves done inside the
        # then/else branches don't leak out (a binding moved inside an
        # if-arm should not be considered moved after the if completes).
        let snap: list[str] = snapshot_moved(env)
        env.push(map_new())
        check_stmts(ctx, env, cur, f, s.body, in_loop)
        env.pop()
        if s.else_body.len() > 0 {
            env.push(map_new())
            check_stmts(ctx, env, cur, f, s.else_body, in_loop)
            env.pop()
        }
        restore_moved(env, snap)
    } else if s.kind == "while" {
        ctx.loop_header = ctx.loop_header + 1
        let ct: str = check_expr(ctx, env, cur, s.cond, "")
        ctx.loop_header = ctx.loop_header - 1
        if ct != "bool" {
            cerr(s.line, "while condition must be bool, got " + ct)
        }
        # BUG-003 fix: moves inside the loop body don't leak out — the loop
        # may execute zero or many times, so any post-loop use must remain valid.
        let snap: list[str] = snapshot_moved(env)
        env.push(map_new())
        check_stmts(ctx, env, cur, f, s.body, true)
        env.pop()
        restore_moved(env, snap)
    } else if s.kind == "for" {
        ctx.loop_header = ctx.loop_header + 1
        let it: str = check_expr(ctx, env, cur, s.iter, "")
        ctx.loop_header = ctx.loop_header - 1
        if !is_list_t(it) {
            cerr(s.line, "for-in expression must be a list, got " + it)
        }
        let mut elem: str = list_elem_t(it)
        if s.vtype != elem {
            cerr(s.line, "variable type " + s.vtype + " does not match element " + elem)
        }
        let snap: list[str] = snapshot_moved(env)
        env.push(map_new())
        # BUG (deep-scan-5): the `let` branch rejects shadowing but the
        # `for` branch never checked — a loop variable could silently
        # shadow an outer binding (SPEC §4: no shadowing).
        if lookup_exists(env, s.name) {
            cerr(s.line, "cannot shadow outer variable with the loop variable: " + s.name)
        }
        env.get(env.len() - 1).set(s.name, Binding { t: elem, is_mut: false, moved: false })
        check_stmts(ctx, env, cur, f, s.body, true)
        env.pop()
        restore_moved(env, snap)
    } else if s.kind == "return" {
        if f.ret == "void" {
            if s.value != -1 {
                cerr(s.line, "void function cannot return a value")
            }
        } else {
            if s.value == -1 {
                cerr(s.line, "function returning " + f.ret + " must return a value")
            }
            let vt: str = check_expr(ctx, env, cur, s.value, f.ret)
            if vt != f.ret && vt != "never" {
                cerr(s.line, "return type mismatch: expected " + f.ret + ", got " + vt)
            }
        }
    } else if s.kind == "break" {
        if !in_loop {
            cerr(s.line, "break only allowed inside a loop")
        }
    } else if s.kind == "continue" {
        if !in_loop {
            cerr(s.line, "continue only allowed inside a loop")
        }
    } else if s.kind == "expr" {
        check_expr(ctx, env, cur, s.e, "")
    } else {
        cerr(s.line, "unknown statement: " + s.kind)
    }
}

fn check_assign(ctx: Ctx, env: list[map[str, Binding]], cur: str, s: StmtN) -> void {
    let tgt: int = s.target
    let mut root: int = tgt
    while ctx.exprs[root].kind == "field" || ctx.exprs[root].kind == "index" {
        root = ctx.exprs[root].left
    }
    let b: Binding = lookup_binding(env, ctx.exprs[root].name)
    if b.t == "" {
        cerr(s.line, "variable does not exist: " + ctx.exprs[root].name)
    }
    # Stage 8-alpha: use-after-move check on the LHS root.
    # Whole-binding assignment (`x = ...`) on a `let mut` binding is allowed
    # and revives the binding; field/index assignment requires the binding
    # to be unmoved (because reading x.field reads x).
    if b.moved {
        if ctx.exprs[tgt].kind == "ident" {
            if !b.is_mut {
                cerr(s.line, "cannot reassign immutable variable: " + ctx.exprs[root].name)
            }
            # otherwise OK — will be revived below
        } else {
            cerr(s.line, "use of moved value: " + ctx.exprs[root].name)
        }
    } else {
        if ctx.exprs[tgt].kind == "ident" && !b.is_mut {
            cerr(s.line, "cannot reassign immutable variable: " + ctx.exprs[root].name)
        }
    }
    let tt: str = check_lvalue(ctx, env, cur, tgt)
    let vt: str = check_expr(ctx, env, cur, s.value, tt)
    if vt == "never" {
        return
    }
    if vt != tt {
        cerr(s.line, "type mismatch on assignment: expected " + tt + ", got " + vt)
    }
    # Stage 8-alpha: revive the binding on whole-binding assignment.
    if ctx.exprs[tgt].kind == "ident" {
        let _ok: bool = revive_binding(env, ctx.exprs[root].name)
    }
}

fn check_lvalue(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int) -> str {
    if ctx.exprs[e].kind == "ident" {
        # Stage 8-beta: annotate the lvalue's type so the codegen can
        # emit release/retain for assignments by static type.
        ctx.exprs[e].t = lookup_binding(env, ctx.exprs[e].name).t
        return ctx.exprs[e].t
    }
    if ctx.exprs[e].kind == "field" {
        let bt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
        let st: StructInfo = resolve_struct(ctx, bt)
        if st.name == "" {
            cerr(ctx.exprs[e].line, "cannot access field on type " + bt)
        }
        let mut i: int = 0
        while i < st.fields.len() {
            if st.fields.get(i) == ctx.exprs[e].name {
                # If the struct is generic, instantiate the field type.
                # Stage 8-beta: annotate the lvalue's type for codegen.
                let mut ft: str = st.ftypes.get(i)
                if st.typeparams.len() > 0 {
                    let targs: list[str] = type_args(bt)
                    ft = instantiate_type(st.ftypes.get(i), st.typeparams, targs)
                }
                ctx.exprs[e].t = ft
                return ft
            }
            i = i + 1
        }
        cerr(ctx.exprs[e].line, "struct " + st.name + " has no field " + ctx.exprs[e].name)
    }
    if ctx.exprs[e].kind == "index" {
        let tt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
        if !is_list_t(tt) {
            cerr(ctx.exprs[e].line, "cannot use index on type " + tt)
        }
        let it: str = check_expr(ctx, env, cur, ctx.exprs[e].right, "")
        if it != "int" {
            cerr(ctx.exprs[e].line, "index must be int, got " + it)
        }
        let et: str = list_elem_t(tt)
        ctx.exprs[e].t = et
        return et
    }
    cerr(ctx.exprs[e].line, "invalid lvalue")
    return ""
}

fn check_expr(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let mut k: str = ctx.exprs[e].kind
    if k == "int" {
        if ctx.exprs[e].op == "big" {
            cerr(ctx.exprs[e].line, "integer literal too large (exceeds int64)")
        }
        ctx.exprs[e].t = "int"
    } else if k == "float" {
        ctx.exprs[e].t = "float"
    } else if k == "bool" {
        ctx.exprs[e].t = "bool"
    } else if k == "str" {
        ctx.exprs[e].t = "str"
    } else if k == "ident" {
        let b: Binding = lookup_binding(env, ctx.exprs[e].name)
        if b.t != "" {
            # Stage 8-alpha: use-after-move check
            if b.moved {
                cerr(ctx.exprs[e].line, "use of moved value: " + ctx.exprs[e].name)
            }
            ctx.exprs[e].t = b.t
        } else if ctx.enums.has(ctx.exprs[e].name) {
            cerr(ctx.exprs[e].line, "enum name '" + ctx.exprs[e].name + "' cannot be used as a value")
        } else if ctx.structs.has(ctx.exprs[e].name) {
            cerr(ctx.exprs[e].line, "struct name '" + ctx.exprs[e].name + "' cannot be used as a value")
        } else {
            cerr(ctx.exprs[e].line, "variable does not exist: " + ctx.exprs[e].name)
        }
    } else if k == "bin" {
        ctx.exprs[e].t = check_bin(ctx, env, cur, e)
    } else if k == "un" {
        let vt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
        if ctx.exprs[e].op == "!" {
            if vt != "bool" {
                cerr(ctx.exprs[e].line, "operator ! expects bool, got " + vt)
            }
            ctx.exprs[e].t = "bool"
        } else {
            if vt != "int" && vt != "float" {
                cerr(ctx.exprs[e].line, "operator - expects int/float, got " + vt)
            }
            ctx.exprs[e].t = vt
        }
    } else if k == "index" {
        let tt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
        if tt == "never" {
            cerr(ctx.exprs[e].line, "never value cannot be used in expression")
        }
        if !is_list_t(tt) {
            cerr(ctx.exprs[e].line, "cannot use index on type " + tt)
        }
        let it: str = check_expr(ctx, env, cur, ctx.exprs[e].right, "")
        if it != "int" {
            cerr(ctx.exprs[e].line, "index must be int, got " + it)
        }
        ctx.exprs[e].t = list_elem_t(tt)
    } else if k == "field" {
        # Disambiguate: if target is `ident` matching an enum name (and no
        # variable with that name), this is an enum variant with no payload.
        if ctx.exprs[ctx.exprs[e].left].kind == "ident" && ctx.enums.has(ctx.exprs[ctx.exprs[e].left].name) && !lookup_exists(env, ctx.exprs[ctx.exprs[e].left].name) {
            check_enum_variant(ctx, env, cur, e, expected, false)
        } else {
            let tt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
            if tt == "never" {
                cerr(ctx.exprs[e].line, "never value cannot be used in expression")
            }
            let st: StructInfo = resolve_struct(ctx, tt)
            if st.name == "" {
                cerr(ctx.exprs[e].line, "cannot access field on type " + tt)
            }
            let mut i: int = 0
            while i < st.fields.len() {
                if st.fields.get(i) == ctx.exprs[e].name {
                    if st.typeparams.len() > 0 {
                        let targs: list[str] = type_args(tt)
                        ctx.exprs[e].t = instantiate_type(st.ftypes.get(i), st.typeparams, targs)
                    } else {
                        ctx.exprs[e].t = st.ftypes.get(i)
                    }
                    break
                }
                i = i + 1
            }
            if ctx.exprs[e].t == "" {
                cerr(ctx.exprs[e].line, "struct " + st.name + " has no field " + ctx.exprs[e].name)
            }
        }
    } else if k == "fieldcall" {
        # Disambiguate: enum variant with payload OR method call.
        if ctx.exprs[ctx.exprs[e].left].kind == "ident" && ctx.enums.has(ctx.exprs[ctx.exprs[e].left].name) && !lookup_exists(env, ctx.exprs[ctx.exprs[e].left].name) {
            check_enum_variant(ctx, env, cur, e, expected, true)
        } else {
            # Rewrite as a method call.
            ctx.exprs[e].kind = "method"
            ctx.exprs[e].t = check_method(ctx, env, cur, e)
        }
    } else if k == "method" {
        ctx.exprs[e].t = check_method(ctx, env, cur, e)
    } else if k == "call" {
        ctx.exprs[e].t = check_call(ctx, env, cur, e, expected)
    } else if k == "listlit" {
        ctx.exprs[e].t = check_listlit(ctx, env, cur, e, expected)
    } else if k == "structlit" {
        ctx.exprs[e].t = check_structlit(ctx, env, cur, e, expected)
    } else if k == "match" {
        ctx.exprs[e].t = check_match(ctx, env, cur, e, expected)
    } else if k == "qmark" {
        ctx.exprs[e].t = check_qmark(ctx, env, cur, e, expected)
    } else if k == "enumlit" {
        # Already rewritten during a previous visit.
        # Re-derive the type from the stored enum_name + variant.
        let en: EnumInfo = ctx.enums.get_or(ctx.exprs[e].enum_name, dummy_enum())
        if en.name == "" {
            cerr(ctx.exprs[e].line, "enum does not exist: " + ctx.exprs[e].enum_name)
        }
        # We need the contextual type to recover the instantiation. Try
        # `expected` first.
        if expected != "" && type_base(expected) == en.name {
            ctx.exprs[e].t = expected
        } else {
            ctx.exprs[e].t = ctx.exprs[e].enum_name
        }
    } else {
        cerr(ctx.exprs[e].line, "unknown expression: " + k)
    }
    return ctx.exprs[e].t
}

fn check_bin(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int) -> str {
    let mut line: int = ctx.exprs[e].line
    let lt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
    let rt: str = check_expr(ctx, env, cur, ctx.exprs[e].right, "")
    if lt == "never" || rt == "never" {
        cerr(line, "never value cannot be used in expression")
    }
    let op: str = ctx.exprs[e].op
    if op == "||" || op == "&&" {
        if lt != "bool" || rt != "bool" {
            cerr(line, "operator " + op + " expects bool, got " + lt + " and " + rt)
        }
        return "bool"
    }
    if op == "==" || op == "!=" {
        if lt != rt || (lt != "int" && lt != "float" && lt != "bool" && lt != "str") {
            cerr(line, "cannot compare == between " + lt + " and " + rt)
        }
        return "bool"
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if lt != rt || (lt != "int" && lt != "float" && lt != "str") {
            cerr(line, "cannot compare ordering between " + lt + " and " + rt)
        }
        return "bool"
    }
    if op == "+" {
        if lt == "int" && rt == "int" {
            return "int"
        }
        if lt == "float" && rt == "float" {
            return "float"
        }
        if lt == "str" && rt == "str" {
            return "str"
        }
        cerr(line, "operator + does not support " + lt + " and " + rt)
    }
    if op == "-" || op == "*" || op == "/" || op == "%" {
        if lt == "int" && rt == "int" {
            return "int"
        }
        if lt == "float" && rt == "float" {
            return "float"
        }
        cerr(line, "operator " + op + " does not support " + lt + " and " + rt)
    }
    cerr(line, "unknown operator: " + op)
    return ""
}

fn check_listlit(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let mut elem: str = ""
    if is_list_t(expected) {
        elem = list_elem_t(expected)
    }
    if elem == "" {
        if ctx.exprs[e].args.len() == 0 {
            cerr(ctx.exprs[e].line, "empty list literal requires a type in the surrounding context")
        }
        elem = check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "")
        if elem == "void" || elem == "never" {
            cerr(ctx.exprs[e].line, "list element cannot have type " + elem)
        }
    }
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let vt: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(i), elem)
        if vt != elem {
            cerr(ctx.exprs[e].line, "list element mismatch: expected " + elem + ", got " + vt)
        }
        i = i + 1
    }
    return "list[" + elem + "]"
}

fn check_structlit(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let name: str = ctx.exprs[e].name
    let mut line: int = ctx.exprs[e].line
    if !ctx.structs.has(name) {
        cerr(line, "struct does not exist: " + name)
    }
    let st: StructInfo = ctx.structs.get_or(name, dummy_struct())
    let typeparams: list[str] = st.typeparams
    # Build the type_map for generic instantiation (if applicable).
    let targs: list[str] = []
    let mut i: int = 0
    while i < typeparams.len() {
        targs.push("")
        i = i + 1
    }
    if typeparams.len() > 0 && expected != "" && type_base(expected) == name {
        let eargs: list[str] = type_args(expected)
        if eargs.len() == typeparams.len() {
            let mut j: int = 0
            while j < eargs.len() {
                targs.set(j, eargs.get(j))
                j = j + 1
            }
        }
    }
    # Validate field names match declared order (and required fields present).
    let provided: list[str] = ctx.exprs[e].ffields
    let declared: list[str] = st.fields
    let mut pi: int = 0
    while pi < provided.len() {
        if pi >= declared.len() || declared.get(pi) != provided.get(pi) {
            let mut want: str = "<end>"
            if pi < declared.len() {
                want = declared.get(pi)
            }
            cerr(line, "struct literal field order mismatch at position " + pi.to_str() + ": expected '" + want + "', got '" + provided.get(pi) + "'")
        }
        pi = pi + 1
    }
    if provided.len() > declared.len() {
        cerr(line, "struct literal " + name + " has too many fields")
    }
    # Required (non-defaulted) fields must be present.
    let mut di: int = 0
    while di < declared.len() {
        let has_default: bool = st.fdefaults.get(di) != -1
        let is_required: bool = !has_default
        let is_provided: bool = di < provided.len()
        if is_required && !is_provided {
            cerr(line, "struct literal missing required field '" + declared.get(di) + "'")
        }
        di = di + 1
    }
    # Type-check each provided field against the instantiated declared type.
    let mut fi: int = 0
    while fi < provided.len() {
        let decl_ftype: str = st.ftypes.get(fi)
        let mut inst_ftype: str = ""
        if typeparams.len() > 0 {
            inst_ftype = instantiate_type(decl_ftype, typeparams, targs)
        } else {
            inst_ftype = decl_ftype
        }
        let vt: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(fi), inst_ftype)
        if vt != inst_ftype {
            cerr(line, "field type " + st.fields.get(fi) + " mismatch: expected " + inst_ftype + ", got " + vt)
        }
        # If generic, try to infer type args from provided field values.
        if typeparams.len() > 0 {
            unify_into(ctx, decl_ftype, vt, typeparams, targs)
        }
        fi = fi + 1
    }
    # If generic and any type arg is still unbound, error.
    if typeparams.len() > 0 {
        let mut ti: int = 0
        while ti < typeparams.len() {
            if targs.get(ti) == "" {
                cerr(line, "cannot infer type argument for struct " + name + "; provide a contextual type")
            }
            ti = ti + 1
        }
        let inst_t: str = name + "[" + join(targs, ", ") + "]"
        # Record this struct instantiation for codegen — only if all type
        # args are concrete (not type params of an enclosing generic).
        if type_is_concrete(ctx, inst_t) && !list_has(ctx.struct_insts, inst_t) {
            ctx.struct_insts.push(inst_t)
        }
        return inst_t
    }
    return name
}

fn check_call(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let name: str = ctx.exprs[e].name
    let mut line: int = ctx.exprs[e].line
    if is_builtin_fn(name) {
        ctx.exprs[e].muser = false
        ctx.exprs[e].mkey = name
        return check_builtin_call(ctx, env, cur, e, name, expected)
    }
    if ctx.fns.has(name) {
        let f: FnInfo = ctx.fns.get_or(name, dummy_fn())
        if f.is_method {
            cerr(line, "method must be called through an object: " + name)
        }
        ctx.exprs[e].muser = true
        ctx.exprs[e].mkey = name
        add_edge(ctx, cur, name)
        if ctx.exprs[e].args.len() != f.params.len() {
            cerr(line, "function " + name + " expects " + f.params.len().to_str() + " arguments, got " + ctx.exprs[e].args.len().to_str())
        }
        # Generic function: infer type args from argument types.
        let typeparams: list[str] = f.typeparams
        let targs: list[str] = []
        let mut ti: int = 0
        while ti < typeparams.len() {
            targs.push("")
            ti = ti + 1
        }
        # BUG-A2 fix: cache first-pass types per argument so we don't re-run
        # check_expr on the same argument in the second pass. Calling
        # check_expr twice would re-execute side effects (drop/take move-
        # marking) and produce a spurious "use of moved value" error.
        let first_at: list[str] = []
        let mut fai: int = 0
        while fai < ctx.exprs[e].args.len() {
            first_at.push("")
            fai = fai + 1
        }
        if typeparams.len() > 0 {
            let mut ai: int = 0
            while ai < ctx.exprs[e].args.len() {
                let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai), "")
                first_at.set(ai, at)
                if at != "never" {
                    unify_into(ctx, f.ptypes.get(ai), at, typeparams, targs)
                }
                ai = ai + 1
            }
            let mut ti2: int = 0
            while ti2 < typeparams.len() {
                if targs.get(ti2) == "" {
                    # BUG-013 fix: name the unbound type-param (e.g. "T") instead
                    # of just the function name — so the user knows WHICH type
                    # param of a multi-param generic is unbound.
                    cerr(line, "cannot infer type argument '" + typeparams.get(ti2) + "' for " + name + "; provide explicit types")
                }
                ti2 = ti2 + 1
            }
            # Record this generic function instantiation for codegen.
            let inst_str: str = name + "|" + join(targs, ",")
            if !list_has(ctx.fn_insts, inst_str) {
                ctx.fn_insts.push(inst_str)
            }
            # Store the inferred concrete type args on the call node so the
            # codegen can use the mangled function name.
            ctx.exprs[e].inst_targs = targs
            # Also set mkey to the mangled name so gen_call uses the right name.
            ctx.exprs[e].mkey = c_mangled_fn_name(name, typeparams, targs)
        } else {
            ctx.exprs[e].mkey = name
        }
        # Type-check arguments against instantiated parameter types.
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            let mut inst_pt: str = ""
            if typeparams.len() > 0 {
                inst_pt = instantiate_type(f.ptypes.get(i), typeparams, targs)
            } else {
                inst_pt = f.ptypes.get(i)
            }
            # Reuse the first-pass type whenever it already matches the
            # instantiated parameter type — avoids re-running check_expr
            # (which would re-execute side effects like drop/take).
            let mut at: str = first_at.get(i)
            if at == "" {
                at = check_expr(ctx, env, cur, ctx.exprs[e].args.get(i), inst_pt)
            }
            if at == "never" {
                i = i + 1
                continue
            }
            if at != inst_pt {
                cerr(line, "argument '" + f.params.get(i) + "' of " + name + " expects " + inst_pt + ", got " + at)
            }
            i = i + 1
        }
        # Stage 17 (v0.28.0-alpha): call-site contract checking — if the
        # callee declares `requires` and every argument is a literal, the
        # precondition is constant-evaluated HERE; a provably-false
        # requires is a compile error at the call site.
        if f.requires_e >= 0 && ctx.exprs[e].args.len() == f.params.len() {
            let consts: map[str, int] = map_new()
            let sconsts: map[str, str] = map_new()
            if args_const_hlc(ctx, f, e, consts, sconsts) {
                let verdict: int = const_eval_hlc(ctx, f.requires_e, consts, sconsts)
                if verdict == 0 {
                    cerr(line, "contract violation at call site: requires of '" + name + "' evaluates to FALSE for these literal arguments")
                }
            }
        }
        if typeparams.len() > 0 {
            return instantiate_type(f.ret, typeparams, targs)
        }
        return f.ret
    }
    cerr(line, "function does not exist: " + name)
    return ""
}

# ============================================================================
# Stage 16 (v0.27.0-alpha): concurrency checker helpers
# ============================================================================

# type_is_send — the Send rule set (the Send/Sync equivalent, layered on
# the Stage 8 ownership system):
#   - primitives and str: Send
#   - Chan[T]: Send iff T is Send (channels are the sharing primitive)
#   - Task[R]: NOT Send (a join handle must stay with its spawner)
#   - list/map/tainted: Send iff the element type is Send
#   - struct/enum: Send iff every field/payload type is Send
# list_append_clone(xs, x) — a NEW list with x appended (keeps the caller's
# list immutable; used for the coinductive cycle detection in
# type_is_send / clone_supported).
fn list_append_clone(xs: list[str], x: str) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    while i < xs.len() {
        out.push(xs.get(i))
        i = i + 1
    }
    out.push(x)
    return out
}

# type_is_send(ctx, t, seen) — returns true iff values of type t may cross
# a task boundary. `seen` carries the types already under inspection
# (coinductive cycle detection for recursive structs).
fn type_is_send(ctx: Ctx, t: str, seen: list[str]) -> bool {
    if list_has(seen, t) {
        return true
    }
    if t == "int" || t == "float" || t == "bool" || t == "str" || t == "void" || t == "never" {
        return true
    }
    if list_has(ctx.cur_typeparams, t) {
        # Deep-scan-10 soundness fix: an unresolved type parameter is NOT
        # provably Send (the generic body is never re-checked at the
        # instantiation; Task is non-Send). Conservative-DENY.
        return false
    }
    let seen2: list[str] = list_append_clone(seen, t)
    if is_chan_t(t) {
        return type_is_send(ctx, chan_inner_t(t), seen2)
    }
    if is_task_t(t) {
        return false
    }
    if is_list_t(t) {
        return type_is_send(ctx, list_elem_t(t), seen2)
    }
    if is_map_t(t) {
        return type_is_send(ctx, map_val_t(t), seen2)
    }
    if is_taint_t(t) {
        return type_is_send(ctx, taint_inner_t(t), seen2)
    }
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    if ctx.structs.has(base) {
        let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
        if st.typeparams.len() != args.len() {
            return false
        }
        let mut i: int = 0
        while i < st.ftypes.len() {
            let ft: str = instantiate_type(st.ftypes.get(i), st.typeparams, args)
            if !type_is_send(ctx, ft, seen2) {
                return false
            }
            i = i + 1
        }
        return true
    }
    if ctx.enums.has(base) {
        let en: EnumInfo = ctx.enums.get_or(base, dummy_enum())
        if en.typeparams.len() != args.len() {
            return false
        }
        let mut v: int = 0
        while v < en.variants.len() {
            let pays: list[str] = en.payloads.get(v)
            let mut p: int = 0
            while p < pays.len() {
                let pt: str = instantiate_type(pays.get(p), en.typeparams, args)
                if !type_is_send(ctx, pt, seen2) {
                    return false
                }
                p = p + 1
            }
            v = v + 1
        }
        return true
    }
    return true
}

# clone_supported — struct-aware clone support (Stage 16). A Chan clones
# by SHARING (atomic refcount + 1 — that is the point of a channel). A
# Task[R] join handle cannot be cloned (single-consumer: join() exactly
# once), and any composite containing a Task is not cloneable either.
# Mirrors boot/checker.py's Checker.clone_supported.
fn clone_supported(ctx: Ctx, t: str, seen: list[str]) -> bool {
    if list_has(seen, t) {
        return true
    }
    if t == "int" || t == "float" || t == "bool" || t == "str" || t == "void" || t == "never" {
        return true
    }
    if is_chan_t(t) {
        return true
    }
    if is_task_t(t) {
        return false
    }
    let seen2: list[str] = list_append_clone(seen, t)
    if is_list_t(t) {
        return clone_supported(ctx, list_elem_t(t), seen2)
    }
    if is_map_t(t) {
        return clone_supported(ctx, map_val_t(t), seen2)
    }
    if is_taint_t(t) {
        return clone_supported(ctx, taint_inner_t(t), seen2)
    }
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    if ctx.structs.has(base) {
        let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
        if st.typeparams.len() != args.len() {
            return false
        }
        let mut i: int = 0
        while i < st.ftypes.len() {
            let ft: str = instantiate_type(st.ftypes.get(i), st.typeparams, args)
            if !clone_supported(ctx, ft, seen2) {
                return false
            }
            i = i + 1
        }
        return true
    }
    if ctx.enums.has(base) {
        let en: EnumInfo = ctx.enums.get_or(base, dummy_enum())
        if en.typeparams.len() != args.len() {
            return false
        }
        let mut v: int = 0
        while v < en.variants.len() {
            let pays: list[str] = en.payloads.get(v)
            let mut p: int = 0
            while p < pays.len() {
                let pt: str = instantiate_type(pays.get(p), en.typeparams, args)
                if !clone_supported(ctx, pt, seen2) {
                    return false
                }
                p = p + 1
            }
            v = v + 1
        }
        return true
    }
    return true
}

# check_spawn_call — validate spawn(f, a1, ..., aN) and rewrite the node.
# Rules enforced here (the Stage 16 acceptance criteria):
#   1. The target f must be a non-generic, non-method, non-extern user fn.
#   2. Every argument type must be Send (Task handles are not Send).
#   3. Every OWNED argument must be a FRESH expression (a literal, call
#      result, clone(x), take(x), composite, ...) — a bare variable /
#      field / index read is a cross-thread sharing error.
# After checking, the node is rewritten: the fn-name argument is removed
# and the target key is recorded in mkey (mirroring the Python checker).
fn check_spawn_call(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int) -> str {
    let mut line: int = ctx.exprs[e].line
    let nargs: int = ctx.exprs[e].args.len()
    if nargs < 1 {
        cerr(line, "spawn() expects a function name followed by its arguments")
    }
    let fn_arg: int = ctx.exprs[e].args.get(0)
    if ctx.exprs[fn_arg].kind != "ident" {
        cerr(line, "spawn() argument 1 must be a function name (an identifier)")
    }
    let fname: str = ctx.exprs[fn_arg].name
    if is_builtin_fn(fname) {
        cerr(line, "spawn() target cannot be a builtin function: " + fname)
    }
    if !ctx.fns.has(fname) {
        cerr(line, "spawn() target function does not exist: " + fname)
    }
    let tf: FnInfo = ctx.fns.get_or(fname, dummy_fn())
    if tf.is_method {
        cerr(line, "spawn() target cannot be a method: " + fname + " (methods need a self receiver — spawn a free function)")
    }
    if tf.typeparams.len() > 0 {
        cerr(line, "spawn() of generic functions is not supported yet: " + fname + " (wrap it in a non-generic fn)")
    }
    if tf.is_extern {
        cerr(line, "spawn() of extern (FFI) functions is not supported")
    }
    let vargs: list[int] = []
    let mut si: int = 1
    while si < ctx.exprs[e].args.len() {
        vargs.push(ctx.exprs[e].args.get(si))
        si = si + 1
    }
    if vargs.len() != tf.params.len() {
        cerr(line, "spawn() target " + fname + " expects " + tf.params.len().to_str() + " arguments, got " + vargs.len().to_str())
    }
    let mut i: int = 0
    while i < vargs.len() {
        let aidx: int = vargs.get(i)
        let pt: str = tf.ptypes.get(i)
        let at: str = check_expr(ctx, env, cur, aidx, pt)
        if at != "never" && at != pt {
            cerr(line, "spawn() argument '" + tf.params.get(i) + "' of " + fname + " expects " + pt + ", got " + at)
        }
        # Send rule: Task handles cannot cross a task boundary.
        if !type_is_send(ctx, pt, []) {
            cerr(line, "type " + pt + " is not Send: values of this type cannot cross a task boundary (a Task join handle must stay with its spawner)")
        }
        # Data-race-freedom rule: a bare binding read (ident / field /
        # index) of an OWNED value is a cross-thread sharing error —
        # reject it. This mirrors the Python checker EXACTLY (same three
        # syntactic forms); every other form is allowed at check time and
        # hardened at runtime by the boundary deep-copy in gen_spawn_call.
        if is_owned_type(pt) {
            let akind: str = ctx.exprs[aidx].kind
            if akind == "ident" || akind == "field" || akind == "index" {
                let mut what: str = "a borrowed value"
                if akind == "ident" {
                    what = "variable '" + ctx.exprs[aidx].name + "'"
                }
                cerr(line, "cannot share " + what + " across tasks: spawn() argument " + (i + 2).to_str() + " reads it directly — pass clone(x) (private copy) or take(x) (ownership transfer). Data-race freedom: no owned value may be simultaneously released by two threads.")
            }
        }
        i = i + 1
    }
    add_edge(ctx, cur, "b:spawn")
    # Deep-scan-10 soundness fix: the spawned function IS a callee — its
    # effects must reach the spawner's computed set (the spawner CAUSES
    # the task's effects; struct defaults already get synthetic edges for
    # exactly this reason). Mirror of the boot/checker.py fix.
    add_edge(ctx, cur, fname)
    # Rewrite the node: drop the fn-name argument; record the target key
    # in mop (mkey stays "spawn" so gen_call dispatches to the spawn
    # codegen path, which reads the target from mop).
    ctx.exprs[e].args = vargs
    ctx.exprs[e].mkey = "spawn"
    ctx.exprs[e].mop = fname
    return "Task[" + tf.ret + "]"
}

fn check_builtin_call(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, name: str, expected: str) -> str {
    let mut line: int = ctx.exprs[e].line
    # Stage 16 (v0.27.0-alpha): spawn(f, a1, ..., aN) — the FIRST argument
    # is a function NAME (identifier), not a value. It must be handled
    # BEFORE the generic argument-evaluation loop below (which would try
    # to resolve it as a variable and fail).
    if name == "spawn" {
        return check_spawn_call(ctx, env, cur, e)
    }
    # Stage 21 (v0.37.0-alpha): has_feature("avx2") -> bool — a
    # compile-time constant (const-folded by the codegen from the
    # --target-feature flag), so the argument must be a STRING LITERAL.
    # Pure (no effects). Mirrors cfg(feature) dispatch.
    if name == "has_feature" {
        if ctx.exprs[e].args.len() != 1 {
            cerr(line, "has_feature() expects 1 argument (a feature name)")
        }
        if ctx.exprs[ctx.exprs[e].args.get(0)].kind != "str" {
            cerr(line, "has_feature() expects a string literal (it is a compile-time constant)")
        }
        check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "str")
        return "bool"
    }
    # Stage 21: simd_cpu_supports("avx2") -> bool — a runtime CPU probe
    # (CPUID on x86; NEON compile-time check on aarch64). Pure.
    if name == "simd_cpu_supports" {
        if ctx.exprs[e].args.len() != 1 {
            cerr(line, "simd_cpu_supports() expects 1 argument (a feature name)")
        }
        check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "str")
        return "bool"
    }
    # Stage 19 (v0.35.0-alpha): join(list[str], sep) -> str — pure, O(n).
    # Handled BEFORE the generic argument-evaluation loop so an empty
    # list literal `[]` infers list[str] from the expected type.
    if name == "join" {
        if ctx.exprs[e].args.len() != 2 {
            cerr(line, "join() expects 2 arguments (list[str], str)")
        }
        let at0: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(0), "list[str]")
        if !is_list_t(at0) || list_elem_t(at0) != "str" {
            cerr(line, "join() expects a list[str] as argument 1, got " + at0)
        }
        let at1: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(1), "str")
        if at1 != "str" {
            cerr(line, "join() expects a str separator as argument 2, got " + at1)
        }
        if at0 == "never" || at1 == "never" {
            cerr(line, "never value cannot be used as an argument")
        }
        return "str"
    }
    let nargs: int = ctx.exprs[e].args.len()
    let argt: list[str] = []
    let mut i: int = 0
    while i < nargs {
        argt.push(check_expr(ctx, env, cur, ctx.exprs[e].args.get(i), ""))
        i = i + 1
    }
    let mut j: int = 0
    while j < nargs {
        if argt.get(j) == "never" {
            cerr(line, "never value cannot be used as an argument")
        }
        j = j + 1
    }
    # Stage 10-alpha: taint-sink enforcement.
    # Reject tainted[T] at sink argument positions; user must explicitly
    # untaint via taint_unwrap or a sanitizer (sanitize_html etc.).
    if name == "print" || name == "println" {
        # Deep-scan fix: check argument count BEFORE the taint check so
        # `print()` (zero args) gives a clean error message instead of
        # crashing on argt.get(0) out-of-bounds.
        if nargs != 1 {
            cerr(line, name + " expects 1 str argument")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: " + name + " argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink — use sanitize_html / sanitize_path / sanitize_sql_identifier / sanitize_sql_string / sanitize_command / sanitize_filename from std.sanitize, or taint_unwrap() if you accept the risk)")
        }
    }
    if name == "exit" {
        if nargs != 1 {
            cerr(line, "exit expects 1 int argument")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: exit argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink)")
        }
    }
    if name == "read_file" || name == "file_exists" || name == "read_file_tainted" {
        if nargs != 1 {
            cerr(line, name + "() expects 1 str argument")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: " + name + " argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink — use sanitize_path from std.sanitize, or taint_unwrap() if you accept the risk)")
        }
    }
    if name == "write_file" {
        if nargs != 2 {
            cerr(line, "write_file() expects 2 str arguments")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: write_file argument 1 (path) is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink)")
        }
        if is_taint_t(argt.get(1)) {
            cerr(line, "taint-sink violation: write_file argument 2 (content) is " + argt.get(1) + " (tainted values must be sanitised before reaching a sink)")
        }
    }
    if name == "print" || name == "println" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, name + " expects 1 str argument")
        }
        add_edge(ctx, cur, "b:print")
        return "void"
    }
    if name == "panic" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "panic expects 1 str argument")
        }
        return "never"
    }
    if name == "exit" {
        if nargs != 1 || argt.get(0) != "int" {
            cerr(line, "exit expects 1 int argument")
        }
        add_edge(ctx, cur, "b:exit")
        return "never"
    }
    if name == "str" {
        if nargs != 1 {
            cerr(line, "str() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if a0 != "int" && a0 != "float" && a0 != "bool" && a0 != "str" {
            cerr(line, "str() does not support type " + a0)
        }
        return "str"
    }
    if name == "int" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "int() expects 1 str argument")
        }
        return "int"
    }
    if name == "len" {
        if nargs != 1 {
            cerr(line, "len() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if a0 != "str" && !is_list_t(a0) && !is_map_t(a0) {
            cerr(line, "len() does not support type " + a0)
        }
        return "int"
    }
    if name == "range" {
        if nargs != 2 || argt.get(0) != "int" || argt.get(1) != "int" {
            cerr(line, "range() expects 2 int arguments")
        }
        return "list[int]"
    }
    if name == "map_new" {
        if nargs != 0 {
            cerr(line, "map_new() takes no arguments")
        }
        if expected == "" || !is_map_t(expected) {
            cerr(line, "map_new() requires a 'map[str, T]' type in the surrounding context")
        }
        return expected
    }
    if name == "read_file" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "read_file() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:read_file")
        return "str"
    }
    # Stage 10-beta: read_file_tainted(path) — same as read_file but the
    # returned str is wrapped as tainted[str]. Second taint source after
    # tainted_args; covers user-controlled content read from a file.
    if name == "read_file_tainted" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "read_file_tainted() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:read_file_tainted")
        return "tainted[str]"
    }
    # Stage 10 release: read_line() -> tainted[str] — third taint source.
    # Reads a single line from stdin (newline stripped); the result is
    # always tainted because stdin is untrusted input. Carries the IO
    # effect (same family as print/println).
    if name == "read_line" {
        if nargs != 0 {
            cerr(line, "read_line() takes no arguments")
        }
        add_edge(ctx, cur, "b:read_line")
        return "tainted[str]"
    }
    if name == "write_file" {
        if nargs != 2 || argt.get(0) != "str" || argt.get(1) != "str" {
            cerr(line, "write_file() expects 2 str arguments")
        }
        add_edge(ctx, cur, "b:write_file")
        return "void"
    }
    if name == "args" {
        if nargs != 0 {
            cerr(line, "args() takes no arguments")
        }
        add_edge(ctx, cur, "b:args")
        return "list[str]"
    }
    # Stage 10-alpha: tainted_args — like args() but each element is
    # wrapped as tainted[str] (defined in std/taint.hls).
    if name == "tainted_args" {
        if nargs != 0 {
            cerr(line, "tainted_args() takes no arguments")
        }
        add_edge(ctx, cur, "b:tainted_args")
        return "list[tainted[str]]"
    }
    # Stage 10-alpha: taint_mark / taint_unwrap — generic wrap / unwrap.
    if name == "taint_mark" {
        if nargs != 1 {
            cerr(line, "taint_mark() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if a0 == "void" {
            cerr(line, "taint_mark() does not support void")
        }
        return "tainted[" + a0 + "]"
    }
    if name == "taint_unwrap" {
        if nargs != 1 {
            cerr(line, "taint_unwrap() expects 1 argument")
        }
        let a0: str = argt.get(0)
        if !is_taint_t(a0) {
            cerr(line, "taint_unwrap() expects a tainted[T] value, got " + a0)
        }
        return taint_inner_t(a0)
    }
    if name == "clock_ms" {
        if nargs != 0 {
            cerr(line, "clock_ms() takes no arguments")
        }
        add_edge(ctx, cur, "b:clock_ms")
        return "int"
    }
    if name == "chr" {
        if nargs != 1 || argt.get(0) != "int" {
            cerr(line, "chr() expects 1 int argument")
        }
        return "str"
    }
    if name == "file_exists" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "file_exists() expects 1 str argument")
        }
        add_edge(ctx, cur, "b:file_exists")
        return "bool"
    }
    # ----- Stage 8-alpha: ownership primitives (drop / clone / take) -----
    if name == "drop" {
        if nargs != 1 {
            cerr(line, "drop() expects 1 argument")
        }
        if ctx.loop_header > 0 {
            cerr(line, "drop() cannot be used inside a loop condition or iterable (the binding would be moved on every iteration)")
        }
        let at: str = argt.get(0)
        if !is_owned_type(at) {
            cerr(line, "drop() requires an owned (heap) type, got " + at)
        }
        # Argument must be a plain identifier so we can mark its binding.
        let arg_idx: int = ctx.exprs[e].args.get(0)
        if ctx.exprs[arg_idx].kind != "ident" {
            cerr(line, "drop() requires a variable name (not an expression)")
        }
        let arg_name: str = ctx.exprs[arg_idx].name
        if !mark_moved(env, arg_name) {
            cerr(line, "drop() argument is not a binding: " + arg_name)
        }
        return "void"
    }
    if name == "clone" {
        if nargs != 1 {
            cerr(line, "clone() expects 1 argument")
        }
        let at2: str = argt.get(0)
        if !is_owned_type(at2) {
            cerr(line, "clone() requires an owned (heap) type, got " + at2)
        }
        # Stage 16: struct-aware clone support — a Task handle (or any
        # composite containing one) cannot be cloned; a Chan clones by
        # SHARING (atomic refcount + 1).
        if !clone_supported(ctx, at2, []) {
            cerr(line, "clone() on type " + at2 + " is not supported (Task join handles and composites containing them cannot be cloned)")
        }
        return at2
    }
    if name == "take" {
        if nargs != 1 {
            cerr(line, "take() expects 1 argument")
        }
        let at3: str = argt.get(0)
        if !is_owned_type(at3) {
            cerr(line, "take() requires an owned (heap) type, got " + at3)
        }
        # Stage 8-beta: a move inside a while/for condition or iterable
        # would re-execute on every iteration (the binding is nulled in
        # generated code after the first pass) — reject it up front.
        if ctx.loop_header > 0 {
            cerr(line, "take() cannot be used inside a loop condition or iterable (the binding would be moved on every iteration)")
        }
        let arg_idx3: int = ctx.exprs[e].args.get(0)
        if ctx.exprs[arg_idx3].kind != "ident" {
            cerr(line, "take() requires a variable name (not an expression)")
        }
        let arg_name3: str = ctx.exprs[arg_idx3].name
        if !mark_moved(env, arg_name3) {
            cerr(line, "take() argument is not a binding: " + arg_name3)
        }
        return at3
    }
    # ----- Stage 9 release (v0.20.0-alpha): Net / Rand / Proc builtins -----
    # net_lookup(host: str) -> str — DNS A record lookup. The host
    # argument is a taint sink (passing a tainted host would be a DNS
    # rebinding vector — reject it like read_file does for paths).
    if name == "net_lookup" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "net_lookup() expects 1 str argument")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: net_lookup argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink — use sanitize_command from std.sanitize, or taint_unwrap() if you accept the risk)")
        }
        add_edge(ctx, cur, "b:net_lookup")
        return "str"
    }
    # rand_int(max: int) -> int — uniform random int in [0, max).
    if name == "rand_int" {
        if nargs != 1 || argt.get(0) != "int" {
            cerr(line, "rand_int() expects 1 int argument")
        }
        add_edge(ctx, cur, "b:rand_int")
        return "int"
    }
    # rand_float() -> float — uniform random float in [0.0, 1.0).
    if name == "rand_float" {
        if nargs != 0 {
            cerr(line, "rand_float() takes no arguments")
        }
        add_edge(ctx, cur, "b:rand_float")
        return "float"
    }
    # rand_seed(s: int) -> void — seed the PRNG.
    if name == "rand_seed" {
        if nargs != 1 || argt.get(0) != "int" {
            cerr(line, "rand_seed() expects 1 int argument")
        }
        add_edge(ctx, cur, "b:rand_seed")
        return "void"
    }
    # proc_exec(cmd: str) -> int — run a shell command via system().
    # The command is a taint sink (passing a tainted cmd is a command-
    # injection vector — reject it like exit does for the exit code).
    if name == "proc_exec" {
        if nargs != 1 || argt.get(0) != "str" {
            cerr(line, "proc_exec() expects 1 str argument")
        }
        if is_taint_t(argt.get(0)) {
            cerr(line, "taint-sink violation: proc_exec argument 1 is " + argt.get(0) + " (tainted values must be sanitised before reaching a sink — use sanitize_command from std.sanitize, or taint_unwrap() if you accept the risk)")
        }
        add_edge(ctx, cur, "b:proc_exec")
        return "int"
    }
    # ----- Stage 16 (v0.27.0-alpha): concurrency builtins -----
    # chan_new() -> Chan[T] — contextual typing (same pattern as map_new).
    if name == "chan_new" {
        if nargs != 0 {
            cerr(line, "chan_new() takes no arguments")
        }
        if expected == "" || !is_chan_t(expected) {
            cerr(line, "chan_new() requires a 'Chan[T]' type in the surrounding context")
        }
        add_edge(ctx, cur, "b:chan_new")
        return expected
    }
    # chan_new_bounded(cap: int) -> Chan[T] — Stage-16 perfection
    # (v0.29.0-alpha): a bounded channel whose send blocks while it
    # holds `cap` messages (backpressure). A literal capacity < 1 is a
    # COMPILE error; dynamic capacities are validated at runtime
    # (clean panic 101).
    if name == "chan_new_bounded" {
        if nargs != 1 {
            cerr(line, "chan_new_bounded() expects 1 int argument (the capacity)")
        }
        let a0: str = argt.get(0)
        if a0 != "int" {
            cerr(line, "chan_new_bounded() capacity expects int, got " + a0)
        }
        let capn: int = ctx.exprs[ctx.exprs[e].args.get(0)].ival
        let capkind: str = ctx.exprs[ctx.exprs[e].args.get(0)].kind
        if capkind == "int" && capn < 1 {
            cerr(line, "chan_new_bounded() capacity must be >= 1, got literal " + capn.to_str())
        }
        if expected == "" || !is_chan_t(expected) {
            cerr(line, "chan_new_bounded() requires a 'Chan[T]' type in the surrounding context")
        }
        add_edge(ctx, cur, "b:chan_new_bounded")
        return expected
    }
    # select(chs: list[Chan[T]]) -> int — index of the first ready channel.
    if name == "select" {
        if nargs != 1 {
            cerr(line, "select() expects 1 list[Chan[T]] argument")
        }
        let a0: str = argt.get(0)
        if !is_list_t(a0) || !is_chan_t(list_elem_t(a0)) {
            cerr(line, "select() expects a list[Chan[T]], got " + a0)
        }
        add_edge(ctx, cur, "b:select")
        return "int"
    }
    cerr(line, "unknown builtin function: " + name)
    return ""
}

fn check_method(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int) -> str {
    let name: str = ctx.exprs[e].name
    let mut line: int = ctx.exprs[e].line
    let tt: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
    if tt == "never" {
        cerr(line, "never value cannot be used in expression")
    }
    let nargs: int = ctx.exprs[e].args.len()
    # User-defined struct method (resolve via base name).
    let st: StructInfo = resolve_struct(ctx, tt)
    if st.name != "" {
        let tt_base: str = type_base(tt)
        if ctx.methods_of.has(tt_base) {
            let cands: list[str] = ctx.methods_of.get_or(tt_base, [])
            let mut key: str = ""
            let mut i: int = 0
            while i < cands.len() {
                let mut k: str = cands.get(i)
                if ctx.fns.get_or(k, dummy_fn()).name == name {
                    key = k
                }
                i = i + 1
            }
            if key == "" {
                cerr(line, "struct " + tt_base + " has no method " + name)
            }
            ctx.exprs[e].muser = true
            ctx.exprs[e].mkey = key
            add_edge(ctx, cur, key)
            let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
            let np: int = f.params.len() - 1
            if nargs != np {
                cerr(line, tt_base + "." + name + " expects " + np.to_str() + " arguments, got " + nargs.to_str())
            }
            # Build a type_map combining struct's type args + method's type params.
            let type_map_tps: list[str] = []
            let type_map_targs: list[str] = []
            # Add the struct's type params first, bound to the actual type args.
            let mut si: int = 0
            while si < st.typeparams.len() {
                type_map_tps.push(st.typeparams.get(si))
                let targs_of_tt: list[str] = type_args(tt)
                if si < targs_of_tt.len() {
                    type_map_targs.push(targs_of_tt.get(si))
                } else {
                    type_map_targs.push("")
                }
                si = si + 1
            }
            # Then the method's own type params (initially unbound).
            let mut mi: int = 0
            while mi < f.typeparams.len() {
                type_map_tps.push(f.typeparams.get(mi))
                type_map_targs.push("")
                mi = mi + 1
            }
            # Infer method's type params from arguments.
            # BUG-A2 fix: cache first-pass types per argument so we don't
            # re-run check_expr on the same argument in the second pass.
            let first_at: list[str] = []
            let mut fa_i: int = 0
            while fa_i < nargs {
                first_at.push("")
                fa_i = fa_i + 1
            }
            if f.typeparams.len() > 0 {
                let mut ai: int = 0
                while ai < nargs {
                    let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai), "")
                    first_at.set(ai, at)
                    if at != "never" {
                        # pt is f.ptypes.get(ai+1) — instantiate struct type
                        # params first, then unify with method type params.
                        # NOTE (BUG-002 fix): we pass an explicit offset
                        # (st.typeparams.len()) so unify_into_offset writes
                        # directly into the method's portion of type_map_targs.
                        let pt: str = f.ptypes.get(ai + 1)
                        let inst_pt: str = instantiate_type(pt, st.typeparams, type_args(tt))
                        unify_into_offset(ctx, inst_pt, at, f.typeparams, type_map_targs, st.typeparams.len())
                    }
                    ai = ai + 1
                }
                let mut ti: int = st.typeparams.len()
                while ti < type_map_targs.len() {
                    if type_map_targs.get(ti) == "" {
                        cerr(line, "cannot infer type argument '" + f.typeparams.get(ti - st.typeparams.len()) + "' for " + tt_base + "." + name)
                    }
                    ti = ti + 1
                }
            }
            # Type-check arguments against instantiated parameter types.
            let mut ai2: int = 0
            while ai2 < nargs {
                let pt: str = f.ptypes.get(ai2 + 1)
                let inst_pt: str = instantiate_type(pt, type_map_tps, type_map_targs)
                # Reuse the first-pass type — avoids re-running check_expr.
                let mut at: str = first_at.get(ai2)
                if at == "" {
                    at = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai2), inst_pt)
                }
                if at == "never" {
                    ai2 = ai2 + 1
                    continue
                }
                if at != inst_pt {
                    cerr(line, "argument of " + tt_base + "." + name + " expects " + inst_pt + ", got " + at)
                }
                ai2 = ai2 + 1
            }
            # BUG-002 fix: if the method has its own type params (or the
            # struct is generic), record this instantiation for codegen.
            # The mangled name encodes BOTH the struct's type args (resolved
            # from the receiver type) AND the method's inferred type args.
            if f.typeparams.len() > 0 || st.typeparams.len() > 0 {
                let mut all_targs: list[str] = []
                # Struct's type args first.
                let mut si2: int = 0
                let targs_of_tt: list[str] = type_args(tt)
                while si2 < st.typeparams.len() {
                    if si2 < targs_of_tt.len() {
                        all_targs.push(targs_of_tt.get(si2))
                    } else {
                        all_targs.push("")
                    }
                    si2 = si2 + 1
                }
                # Then method's own type args.
                let mut mi2: int = st.typeparams.len()
                while mi2 < type_map_targs.len() {
                    all_targs.push(type_map_targs.get(mi2))
                    mi2 = mi2 + 1
                }
                # Compose a combined typeparams list for the mangling.
                let combined_tps: list[str] = []
                let mut ci: int = 0
                while ci < st.typeparams.len() {
                    combined_tps.push(st.typeparams.get(ci))
                    ci = ci + 1
                }
                let mut cj: int = 0
                while cj < f.typeparams.len() {
                    combined_tps.push(f.typeparams.get(cj))
                    cj = cj + 1
                }
                let inst_str: str = key + "|" + join(all_targs, ",")
                if !list_has(ctx.fn_insts, inst_str) {
                    ctx.fn_insts.push(inst_str)
                }
                ctx.exprs[e].mkey = c_mangled_fn_name(key, combined_tps, all_targs)
            }
            return instantiate_type(f.ret, type_map_tps, type_map_targs)
        }
    }
    # Builtin method: ptypes + ret table by target type
    let ptypes: list[str] = []
    let mut ret: str = ""
    if tt == "str" {
        if name == "len" { ret = "int" }
        else if name == "byte_at"  {
        ptypes.push("int")
        ret = "int"
    }
        else if name == "slice"  {
        ptypes.push("int")
        ptypes.push("int")
        ret = "str"
    }
        else if name == "find"  {
        ptypes.push("str")
        ret = "int"
    }
        else if name == "contains"  {
        ptypes.push("str")
        ret = "bool"
    }
        else if name == "starts_with"  {
        ptypes.push("str")
        ret = "bool"
    }
        else if name == "ends_with"  {
        ptypes.push("str")
        ret = "bool"
    }
        else if name == "split"  {
        ptypes.push("str")
        ret = "list[str]"
    }
        else if name == "trim" { ret = "str" }
        else if name == "to_int" { ret = "int" }
        else if name == "to_float" { ret = "float" }
        else if name == "to_str" { ret = "str" }
        else { cerr(line, "str has no method " + name) }
        ctx.exprs[e].mop = "str." + name
    } else if tt == "int" {
        if name == "to_str" { ret = "str" }
        else if name == "to_float" { ret = "float" }
        else if name == "abs" { ret = "int" }
        else { cerr(line, "int has no method " + name) }
        ctx.exprs[e].mop = "int." + name
    } else if tt == "float" {
        if name == "to_str" { ret = "str" }
        else if name == "to_int" { ret = "int" }
        else if name == "abs" { ret = "float" }
        else { cerr(line, "float has no method " + name) }
        ctx.exprs[e].mop = "float." + name
    } else if tt == "bool" {
        if name == "to_str" { ret = "str" }
        else { cerr(line, "bool has no method " + name) }
        ctx.exprs[e].mop = "bool." + name
    } else if is_list_t(tt) {
        let mut elem: str = list_elem_t(tt)
        if name == "len" { ret = "int" }
        else if name == "push"  {
        ptypes.push(elem)
        ret = "void"
    }
        else if name == "get"  {
        ptypes.push("int")
        ret = elem
    }
        else if name == "set"  {
        ptypes.push("int")
        ptypes.push(elem)
        ret = "void"
    }
        else if name == "pop" { ret = elem }
        else { cerr(line, "list has no method " + name) }
        ctx.exprs[e].mop = "list." + name
    } else if is_map_t(tt) {
        let vt: str = map_val_t(tt)
        if name == "len" { ret = "int" }
        else if name == "set"  {
        ptypes.push("str")
        ptypes.push(vt)
        ret = "void"
    }
        else if name == "get_or"  {
        ptypes.push("str")
        ptypes.push(vt)
        ret = vt
    }
        else if name == "has"  {
        ptypes.push("str")
        ret = "bool"
    }
        else if name == "keys" { ret = "list[str]" }
        else { cerr(line, "map has no method " + name) }
        ctx.exprs[e].mop = "map." + name
    } else if is_chan_t(tt) {
        # Stage 16 (v0.27.0-alpha): Chan[T] methods. Stage-16 perfection
        # (v0.29.0-alpha) adds the non-blocking pair try_send/recv_or.
        let celem: str = chan_inner_t(tt)
        if name == "len" { ret = "int" }
        else if name == "recv" { ret = celem }
        else if name == "recv_or" {
        ptypes.push(celem)
        ret = celem
    }
        else if name == "send" {
        ptypes.push(celem)
        ret = "void"
    }
        else if name == "try_send" {
        ptypes.push(celem)
        ret = "bool"
    }
        else { cerr(line, "Chan has no method " + name + " (available: send, try_send, recv, recv_or, len)") }
        ctx.exprs[e].mop = "chan." + name
    } else if is_task_t(tt) {
        # Stage 16 (v0.27.0-alpha): Task[R].join() -> R.
        if name != "join" {
            cerr(line, "Task has no method " + name + " (available: join)")
        }
        ret = task_inner_t(tt)
        ctx.exprs[e].mop = "task.join"
    } else {
        cerr(line, "cannot call method on type " + tt)
    }
    ctx.exprs[e].muser = false
    # Stage 16: method-level effects + the channel-send data-race rule.
    # These are the first builtin METHODS that carry an effect — the
    # call-graph edge keeps the effects fixpoint sound for them.
    # (v0.29.0-alpha: chan.try_send / chan.recv_or join the family.)
    if ctx.exprs[e].mop == "chan.send" || ctx.exprs[e].mop == "chan.try_send"
        || ctx.exprs[e].mop == "chan.recv" || ctx.exprs[e].mop == "chan.recv_or"
        || ctx.exprs[e].mop == "chan.len" || ctx.exprs[e].mop == "task.join" {
        add_edge(ctx, cur, "b:" + ctx.exprs[e].mop)
    }
    if (ctx.exprs[e].mop == "chan.send" || ctx.exprs[e].mop == "chan.try_send") && nargs >= 1 {
        # Send rule: the message type must be Send (both the blocking
        # send and the non-blocking try_send cross the task boundary)...
        let vt: str = chan_inner_t(tt)
        if !type_is_send(ctx, vt, []) {
            cerr(line, "type " + vt + " is not Send: values of this type cannot cross a task boundary")
        }
    }
    if nargs != ptypes.len() {
        cerr(line, tt + "." + name + " expects " + ptypes.len().to_str() + " arguments, got " + nargs.to_str())
    }
    let mut i: int = 0
    while i < nargs {
        let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(i), ptypes.get(i))
        if at != ptypes.get(i) {
            cerr(line, "argument of " + tt + "." + name + " expects " + ptypes.get(i) + ", got " + at)
        }
        i = i + 1
    }
    # Stage 16 (part 2): the channel-send freshness rule runs AFTER the
    # argument was type-checked — the syntactic form is what matters (a
    # bare ident/field/index read), mirroring the Python checker exactly.
    # (Running it earlier read stale annotation state and produced a
    # divergence between the two checkers.) v0.29.0-alpha: try_send
    # takes the message across the boundary the same way send does.
    if (ctx.exprs[e].mop == "chan.send" || ctx.exprs[e].mop == "chan.try_send") && nargs >= 1 {
        let vt2: str = chan_inner_t(tt)
        let vidx: int = ctx.exprs[e].args.get(0)
        let vkind: str = ctx.exprs[vidx].kind
        if is_owned_type(vt2) && (vkind == "ident" || vkind == "field" || vkind == "index") {
            let mut what: str = "a borrowed value"
            if vkind == "ident" {
                what = "variable '" + ctx.exprs[vidx].name + "'"
            }
            cerr(line, "cannot share " + what + " across tasks: " + ctx.exprs[e].mop + "(...) reads it directly — pass clone(x) (private copy) or take(x) (ownership transfer). Data-race freedom: no owned value may be simultaneously released by two threads.")
        }
    }
    return ret
}

# --- Enum variant literal check (rewrites the node to enumlit) ---

fn check_enum_variant(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str, with_args: bool) -> void {
    let ename: str = ctx.exprs[ctx.exprs[e].left].name
    let vname: str = ctx.exprs[e].name
    let line: int = ctx.exprs[e].line
    if !ctx.enums.has(ename) {
        cerr(line, "enum does not exist: " + ename)
    }
    let en: EnumInfo = ctx.enums.get_or(ename, dummy_enum())
    let mut vidx: int = -1
    let mut i: int = 0
    while i < en.variants.len() {
        if en.variants.get(i) == vname {
            vidx = i
        }
        i = i + 1
    }
    if vidx == -1 {
        cerr(line, "enum " + ename + " has no variant " + vname)
    }
    let payloads: list[str] = en.payloads.get(vidx)
    let mut nargs: int = 0
    if with_args {
        nargs = ctx.exprs[e].args.len()
    }
    if nargs != payloads.len() {
        cerr(line, "variant " + vname + " of enum " + ename + " expects " + payloads.len().to_str() + " payloads, got " + nargs.to_str())
    }
    let typeparams: list[str] = en.typeparams
    let targs: list[str] = []
    let mut ti: int = 0
    while ti < typeparams.len() {
        targs.push("")
        ti = ti + 1
    }
    # First pass: infer from args.
    if typeparams.len() > 0 && with_args {
        let mut ai: int = 0
        while ai < nargs {
            let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai), "")
            if at != "never" {
                unify_into(ctx, payloads.get(ai), at, typeparams, targs)
            }
            ai = ai + 1
        }
    }
    # Second pass: try contextual expected type.
    if typeparams.len() > 0 && expected != "" && type_base(expected) == ename {
        let eargs: list[str] = type_args(expected)
        if eargs.len() == typeparams.len() {
            let mut j: int = 0
            while j < eargs.len() {
                if targs.get(j) == "" {
                    targs.set(j, eargs.get(j))
                }
                j = j + 1
            }
        }
    }
    # If any type param is still unbound, error.
    if typeparams.len() > 0 {
        let mut ti2: int = 0
        while ti2 < typeparams.len() {
            if targs.get(ti2) == "" {
                cerr(line, "cannot infer type argument for " + ename + "; provide a contextual type")
            }
            ti2 = ti2 + 1
        }
    }
    # Type-check payloads against instantiated payload types.
    let inst_payloads: list[str] = []
    let mut pi: int = 0
    while pi < payloads.len() {
        if typeparams.len() > 0 {
            inst_payloads.push(instantiate_type(payloads.get(pi), typeparams, targs))
        } else {
            inst_payloads.push(payloads.get(pi))
        }
        pi = pi + 1
    }
    if with_args {
        let mut ai2: int = 0
        while ai2 < nargs {
            let at: str = check_expr(ctx, env, cur, ctx.exprs[e].args.get(ai2), inst_payloads.get(ai2))
            if at == "never" {
                ai2 = ai2 + 1
                continue
            }
            if at != inst_payloads.get(ai2) {
                cerr(line, "payload type mismatch: expected " + inst_payloads.get(ai2) + ", got " + at)
            }
            ai2 = ai2 + 1
        }
    }
    # Rewrite the node to enumlit.
    if typeparams.len() > 0 {
        ctx.exprs[e].t = ename + "[" + join(targs, ", ") + "]"
        # Record this enum instantiation for codegen — only if all type args
        # are concrete.
        let inst_t: str = ename + "[" + join(targs, ", ") + "]"
        if type_is_concrete(ctx, inst_t) && !list_has(ctx.enum_insts, inst_t) {
            ctx.enum_insts.push(inst_t)
        }
    } else {
        ctx.exprs[e].t = ename
    }
    ctx.exprs[e].kind = "enumlit"
    ctx.exprs[e].enum_name = ename
    ctx.exprs[e].variant = vname
}

# --- match ---

fn check_match(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let scrut_t: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
    if scrut_t == "never" {
        cerr(ctx.exprs[e].line, "never value cannot be used in match")
    }
    let ename: str = type_base(scrut_t)
    if !ctx.enums.has(ename) {
        cerr(ctx.exprs[e].line, "match scrutinee must be an enum, got " + scrut_t)
    }
    let en: EnumInfo = ctx.enums.get_or(ename, dummy_enum())
    let typeparams: list[str] = en.typeparams
    let targs: list[str] = []
    let mut ti: int = 0
    while ti < typeparams.len() {
        targs.push("")
        ti = ti + 1
    }
    if typeparams.len() > 0 {
        let sargs: list[str] = type_args(scrut_t)
        if sargs.len() == typeparams.len() {
            let mut j: int = 0
            while j < sargs.len() {
                targs.set(j, sargs.get(j))
                j = j + 1
            }
        } else {
            cerr(ctx.exprs[e].line, "invalid enum instantiation: " + scrut_t)
        }
    }
    # Check exhaustiveness and arm types.
    let covered: list[str] = []
    let mut has_wildcard: bool = false
    let mut wildcard_idx: int = -1  # SCAN-C: track position for non-last check
    let arm_types: list[str] = []
    let mut arm_n: int = 0
    while arm_n < ctx.exprs[e].args.len() {
        let arm_idx: int = ctx.exprs[e].args.get(arm_n)
        let arm: MatchArm = ctx.match_arms.get(arm_idx)
        if arm.pat_kind == "wildcard" {
            has_wildcard = true
            # SCAN-C fix: a wildcard arm not in the LAST position
            # generates invalid C (the codegen emits `if (...) {...}
            # else {...} else if (...) {...}` — the trailing `else if`
            # has no matching `if`). Reject at check time with a clear
            # error rather than letting gcc emit a confusing parse error.
            if arm_n < ctx.exprs[e].args.len() - 1 {
                cerr(arm.line, "wildcard arm must be the last arm in a match (found at position " + arm_n.to_str() + " of " + ctx.exprs[e].args.len().to_str() + ")")
            }
            wildcard_idx = arm_n
        } else {
            # Deep-scan-10: a bare pattern resolves against the
            # scrutinee's enum (arm references the list's struct, so the
            # field write mutates the stored arm).
            if arm.enum_name == "" {
                arm.enum_name = ename
            }
            if arm.enum_name != ename {
                cerr(arm.line, "match arm pattern belongs to enum " + arm.enum_name + ", not " + ename)
            }
            # Find variant index.
            let mut vidx: int = -1
            let mut vi: int = 0
            while vi < en.variants.len() {
                if en.variants.get(vi) == arm.variant {
                    vidx = vi
                }
                vi = vi + 1
            }
            if vidx == -1 {
                cerr(arm.line, "enum " + ename + " has no variant " + arm.variant)
            }
            let payloads: list[str] = en.payloads.get(vidx)
            if arm.has_paren && arm.bindings.len() != payloads.len() {
                cerr(arm.line, "variant " + arm.variant + " has " + payloads.len().to_str() + " payloads, but pattern binds " + arm.bindings.len().to_str())
            }
            if !arm.has_paren && payloads.len() != 0 {
                cerr(arm.line, "variant " + arm.variant + " requires " + payloads.len().to_str() + " payload bindings")
            }
            covered.push(arm.variant)
        }
        # Check arm body in a new scope with the bindings.
        env.push(map_new())
        if arm.pat_kind != "wildcard" {
            # Bind payload values.
            if arm.has_paren {
                let mut vidx2: int = -1
                let mut vi2: int = 0
                while vi2 < en.variants.len() {
                    if en.variants.get(vi2) == arm.variant {
                        vidx2 = vi2
                    }
                    vi2 = vi2 + 1
                }
                let payloads2: list[str] = en.payloads.get(vidx2)
                let mut bi: int = 0
                while bi < payloads2.len() {
                    let pt: str = payloads2.get(bi)
                    let mut inst_pt: str = ""
                    if typeparams.len() > 0 {
                        inst_pt = instantiate_type(pt, typeparams, targs)
                    } else {
                        inst_pt = pt
                    }
                    let bname: str = arm.bindings.get(bi)
                    if bname != "_" {
                        # BUG-SC-2 fix: SPEC.md section 5 states that match-arm
                        # bindings INTRODUCE a new scope and may shadow outer
                        # bindings for the duration of the arm. We now only
                        # reject duplicates WITHIN the same arm (e.g. E.Foo(a, a)),
                        # not shadowing of outer bindings.
                        if env.get(env.len() - 1).has(bname) {
                            cerr(arm.line, "duplicate binding name in match arm: " + bname)
                        }
                        env.get(env.len() - 1).set(bname, Binding { t: inst_pt, is_mut: false, moved: false })
                    }
                    bi = bi + 1
                }
            }
        }
        let body_t: str = check_expr(ctx, env, cur, arm.body, expected)
        let mut arm_m: MatchArm = ctx.match_arms.get(arm_idx)
        arm_m.body_t = body_t
        ctx.match_arms.set(arm_idx, arm_m)
        env.pop()
        if body_t != "never" {
            arm_types.push(body_t)
        }
        arm_n = arm_n + 1
    }
    # Exhaustiveness check.
    if !has_wildcard {
        let mut missing: list[str] = []
        let mut vi3: int = 0
        while vi3 < en.variants.len() {
            let v: str = en.variants.get(vi3)
            let mut found: bool = false
            let mut ci: int = 0
            while ci < covered.len() {
                if covered.get(ci) == v {
                    found = true
                }
                ci = ci + 1
            }
            if !found {
                missing.push(v)
            }
            vi3 = vi3 + 1
        }
        if missing.len() > 0 {
            cerr(ctx.exprs[e].line, "match is not exhaustive; missing: " + join(missing, ", "))
        }
    }
    # All arm types must agree.
    # NOTE (deep-scan-9 / Stage 16): do NOT write ctx.exprs[e].t here —
    # the CALLER (check_expr's match branch) assigns the return value to
    # the same field. Writing it in BOTH places made the generated C
    # release the OLD field value twice (field assignment lowers to
    # `release old, store new`): the inner write freed the node's
    # initial "", then the caller's write released the stale pointer —
    # a heap-use-after-free in the native compiler that only surfaced
    # on match-heavy programs (feat_clone_deep). The interpreter was
    # unaffected (Python rebinds, no refcount dance).
    if arm_types.len() == 0 {
        return "never"
    }
    let first: str = arm_types.get(0)
    let mut ai: int = 1
    while ai < arm_types.len() {
        if arm_types.get(ai) != first {
            cerr(ctx.exprs[e].line, "match arms have different types: " + first + " and " + arm_types.get(ai))
        }
        ai = ai + 1
    }
    return first
}

# --- `?` operator ---

fn check_qmark(ctx: Ctx, env: list[map[str, Binding]], cur: str, e: int, expected: str) -> str {
    let inner_t: str = check_expr(ctx, env, cur, ctx.exprs[e].left, "")
    if inner_t == "never" {
        cerr(ctx.exprs[e].line, "never value cannot be used in expression")
    }
    let ename: str = type_base(inner_t)
    if !ctx.enums.has(ename) {
        cerr(ctx.exprs[e].line, "? operator requires an enum type, got " + inner_t)
    }
    let en: EnumInfo = ctx.enums.get_or(ename, dummy_enum())
    # Find error variant (Err with 1 payload, or None with 0) and ok variant
    # (Ok or Some with 1 payload).
    let mut err_v: str = ""
    let mut ok_v: str = ""
    let mut ok_payload: str = ""
    let mut err_candidates: int = 0
    let mut vi: int = 0
    while vi < en.variants.len() {
        let v: str = en.variants.get(vi)
        let pl: list[str] = en.payloads.get(vi)
        let mut matched: bool = false
        if v == "Err" && pl.len() == 1 {
            err_v = v
            err_candidates = err_candidates + 1
            matched = true
        }
        if v == "None" && pl.len() == 0 {
            err_v = v
            err_candidates = err_candidates + 1
            matched = true
        }
        if v == "Ok" && pl.len() == 1 {
            ok_v = v
            ok_payload = pl.get(0)
            matched = true
        }
        if v == "Some" && pl.len() == 1 {
            ok_v = v
            ok_payload = pl.get(0)
            matched = true
        }
        # BUG (deep-scan-5): a third variant beyond the ok/err pair can
        # match NEITHER arm at runtime — the generated code would read
        # garbage union bytes. Reject at check time.
        if !matched {
            cerr(ctx.exprs[e].line, "? operator requires enum " + ename + " to have exactly the ok variant (Ok/Some) and error variant (Err/None); found extra variant '" + v + "'")
        }
        vi = vi + 1
    }
    # BUG (deep-scan-5): declaring BOTH 'Err' and 'None' is ambiguous —
    # the scan silently keeps only the last one and `?` on the other
    # panics at runtime. Reject the ambiguity.
    if err_candidates > 1 {
        cerr(ctx.exprs[e].line, "? operator requires enum " + ename + " to declare EITHER 'Err' OR 'None' as its error variant, not both")
    }
    if err_v == "" {
        cerr(ctx.exprs[e].line, "? operator requires enum " + ename + " to have an 'Err' (1 payload) or 'None' variant")
    }
    if ok_v == "" {
        cerr(ctx.exprs[e].line, "? operator requires enum " + ename + " to have an 'Ok' or 'Some' variant (1 payload)")
    }
    # Compute the success value type (instantiated).
    let mut success_t: str = ""
    let mut err_payload_t: str = ""
    if en.typeparams.len() > 0 {
        let sargs: list[str] = type_args(inner_t)
        success_t = instantiate_type(ok_payload, en.typeparams, sargs)
        # BUG-3 fix: compute the error payload type too, so we can verify
        # it matches the enclosing function's error type argument.
        if err_v == "Err" {
            # Find the Err variant's payload type from the enum definition.
            let mut ei: int = 0
            while ei < en.variants.len() {
                if en.variants.get(ei) == "Err" {
                    err_payload_t = instantiate_type(en.payloads.get(ei).get(0), en.typeparams, sargs)
                }
                ei = ei + 1
            }
        }
    } else {
        success_t = ok_payload
        if err_v == "Err" {
            let mut ei: int = 0
            while ei < en.variants.len() {
                if en.variants.get(ei) == "Err" {
                    err_payload_t = en.payloads.get(ei).get(0)
                }
                ei = ei + 1
            }
        }
    }
    # Check that the enclosing function returns an enum of the same base.
    let cur_ret: str = ctx.cur_fn_ret
    if cur_ret == "void" {
        cerr(ctx.exprs[e].line, "? operator cannot be used in a void function")
    }
    let cur_ret_base: str = type_base(cur_ret)
    if cur_ret_base != ename {
        cerr(ctx.exprs[e].line, "? operator: enclosing function returns " + cur_ret + ", cannot propagate " + ename)
    }
    # BUG-3 fix: verify the error payload type matches the enclosing
    # function's error type argument.
    if err_payload_t != "" {
        let cur_ret_args: list[str] = type_args(cur_ret)
        if cur_ret_args.len() > 0 {
            let fn_err_t: str = cur_ret_args.get(cur_ret_args.len() - 1)
            if err_payload_t != fn_err_t {
                cerr(ctx.exprs[e].line, "? operator: error payload type " + err_payload_t + " does not match enclosing function's error type " + fn_err_t + " (in return type " + cur_ret + ")")
            }
        }
    }
    # NOTE (deep-scan-9): same as check_match — no internal .t write; the
    # caller (check_expr's qmark branch) owns the field assignment.
    ctx.exprs[e].err_variant = err_v
    ctx.exprs[e].ok_variant = ok_v
    return success_t
}

# callee_effect_list: the effect REQUIREMENT contributed by a callee —
# builtin table for "b:" nodes, the extern's DECLARED effects for extern
# fns (they have no body, so their computed set is always empty — the
# declared set IS the requirement), otherwise the computed fixpoint set.
fn callee_effect_list(ctx: Ctx, c: str, eff: map[str, list[str]]) -> list[str] {
    if c.starts_with("b:") {
        return builtin_effect(c.slice(2, c.len()))
    }
    let cf: FnInfo = ctx.fns.get_or(c, dummy_fn())
    if cf.is_extern {
        return cf.effects
    }
    return eff.get_or(c, [])
}

fn check_effects(ctx: Ctx) -> void {
    # Stage 9-alpha: fine-grained effects & capabilities.
    # eff[key] = computed list of effects the body of `key` requires.
    # A function passes iff its declared effects (f.effects) is a superset
    # of the computed effects.
    let eff: map[str, list[str]] = map_new()
    let mut i0: int = 0
    while i0 < ctx.fn_order.len() {
        let key0: str = ctx.fn_order.get(i0)
        eff.set(key0, [])
        i0 = i0 + 1
    }

    # Monotone fixpoint: union in each callee's computed effect set.
    let mut changed: bool = true
    while changed {
        changed = false
        let mut i: int = 0
        while i < ctx.fn_order.len() {
            let key: str = ctx.fn_order.get(i)
            let edges: list[str] = ctx.edges.get_or(key, [])
            let mut j: int = 0
            while j < edges.len() {
                let c: str = edges.get(j)
                let mut new_eff: list[str] = callee_effect_list(ctx, c, eff)
                let mut k: int = 0
                while k < new_eff.len() {
                    if effects_add(eff, key, new_eff.get(k)) {
                        changed = true
                    }
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
    }

    # Stage 9-beta: publish the computed effect set per function so an
    # external auditor (hlc --audit) can print the capability tree.
    let mut ic: int = 0
    while ic < ctx.fn_order.len() {
        let keyc: str = ctx.fn_order.get(ic)
        ctx.computed_effects.set(keyc, eff.get_or(keyc, []))
        ic = ic + 1
    }

    # Capability check: declared ⊇ computed.
    # Stage 9-beta: also enforce that a function declared `pure` transitively
    # calls nothing effectful (its computed effect set must be empty).
    let mut i2: int = 0
    while i2 < ctx.fn_order.len() {
        let key2: str = ctx.fn_order.get(i2)
        let f: FnInfo = ctx.fns.get_or(key2, dummy_fn())
        let computed: list[str] = eff.get_or(key2, [])
        # Stage 9-beta: `pure` enforcement — a `pure` function must have an
        # empty computed effect set (no transitive effectful callees).
        if f.is_pure && computed.len() > 0 {
            # Find the first edge that contributes any effect.
            let edges: list[str] = ctx.edges.get_or(key2, [])
            let mut j2: int = 0
            let mut found: bool = false
            while j2 < edges.len() && !found {
                let c: str = edges.get(j2)
                let mut c_eff: list[str] = callee_effect_list(ctx, c, eff)
                if c_eff.len() > 0 {
                    let mut nm: str = c
                    if c.starts_with("b:") {
                        nm = c.slice(2, c.len())
                    }
                    cerr(f.line,
                        "function '" + f.name + "' is declared 'pure' but calls '" +
                        nm + "' which requires effect '" + c_eff.get(0) +
                        "' (declared pure but callee chain is not pure)")
                    found = true
                }
                j2 = j2 + 1
            }
            if !found {
                cerr(f.line,
                    "function '" + f.name + "' is declared 'pure' but transitively " +
                    "uses effects " + fmt_effects(computed) +
                    " (declared pure but callee chain is not pure)")
            }
        }
        # Walk each effect in `computed`; if any is missing from f.effects,
        # find a witness edge and report.
        let mut ci: int = 0
        let mut found_violation: bool = false
        while ci < computed.len() && !found_violation {
            let ce: str = computed.get(ci)
            if !list_has(f.effects, ce) {
                # Find the first edge that contributes this effect.
                let edges: list[str] = ctx.edges.get_or(key2, [])
                let mut j2: int = 0
                while j2 < edges.len() && !found_violation {
                    let c: str = edges.get(j2)
                    let mut c_eff: list[str] = callee_effect_list(ctx, c, eff)
                    if list_has(c_eff, ce) {
                        let mut nm: str = c
                        if c.starts_with("b:") {
                            nm = c.slice(2, c.len())
                        }
                        cerr(f.line,
                            "function '" + f.name + "' calls '" + nm +
                            "' which requires effect '" + ce +
                            "' not declared (declared: " + fmt_effects(f.effects) +
                            "; missing: " + ce + ")")
                        found_violation = true
                    }
                    j2 = j2 + 1
                }
            }
            ci = ci + 1
        }
        i2 = i2 + 1
    }
}

# ------------------------------------------------------------------------
# 4b. C RUNTIME (embedded directly — generated from the tested runtime)
# ------------------------------------------------------------------------

fn runtime_lines() -> list[str] {
    let r: list[str] = []
    r.push("#include <stdio.h>")
    r.push("#include <stdlib.h>")
    r.push("#include <string.h>")
    r.push("#include <stdint.h>")
    r.push("#include <stdbool.h>")
    r.push("#include <inttypes.h>")
    r.push("#include <time.h>")
    r.push("#include <math.h>")
    r.push("#include <sys/stat.h>")
    # Stage 9 release (v0.20.0-alpha): Net / Rand / Proc builtins.
    # net_lookup needs sys/socket.h, netdb.h, netinet/in.h for
    # getaddrinfo. proc_exec uses system() (declared in stdlib.h);
    # WIFEXITED / WEXITSTATUS / WTERMSIG are declared in sys/wait.h
    # (stdlib.h pulls it in indirectly on glibc but NOT on musl/other
    # libcs — explicitly include for portability).
    # rand_* use rand()/srand() (declared in stdlib.h).
    r.push("#include <sys/socket.h>")
    r.push("#include <netdb.h>")
    r.push("#include <netinet/in.h>")
    r.push("#include <arpa/inet.h>")
    r.push("#include <sys/wait.h>")
    # Stage 16 (v0.27.0-alpha): the concurrency runtime (pthread-based).
    r.push("#include <pthread.h>")
    r.push("")
    # ---- Stage 8-beta: the refcounted runtime (END OF ARENA) ----
    # Every heap object starts with an int64_t refcnt as its FIRST field so
    # hl_retain works uniformly on all object types. Releases are
    # type-specific (they must release children). elem_free / val_free ==
    # NULL means "arena mode": the container never releases its items (used
    # by the LLVM backend, which is still arena-based).
    r.push("typedef struct { int64_t refcnt; int64_t len; char* data; } hl_str;")
    r.push("typedef struct { int64_t refcnt; int64_t len; int64_t cap; void** items; void (*elem_free)(void*); } hl_list;")
    r.push("typedef struct { int64_t refcnt; int64_t len; int64_t cap; hl_str** slots; void** vals; hl_str** order; void (*val_free)(void*); } hl_map;")
    r.push("")
    r.push("// Checked byte string — used by the HLS runtime")
    r.push("static void hl_die(const char* msg) {")
    r.push("    fflush(stdout);")
    r.push("    fprintf(stderr, \"panic: %s\\n\", msg);")
    r.push("    exit(101);")
    r.push("}")
    r.push("")
    # Stage 10 release: the runtime position-aware panic. Used by codegen
    # for panic() calls and arithmetic overflow checks (planned for Stage 11
    # release; currently emitted by gen_call's panic path and gen_bin's
    # overflow helpers when --opt fast is in effect).
    r.push("static void hl_die_at(const char* msg, const char* file, int64_t line) {")
    r.push("    fflush(stdout);")
    r.push("    if (file && line > 0) {")
    r.push("        fprintf(stderr, \"panic: %s (at %s:%lld)\\n\", msg, file, (long long)line);")
    r.push("    } else {")
    r.push("        fprintf(stderr, \"panic: %s\\n\", msg);")
    r.push("    }")
    r.push("    exit(101);")
    r.push("}")
    r.push("")
    # Stage 10 release: sandbox root. When non-NULL, every filesystem
    # builtin (hl_read_file, hl_write_file, hl_file_exists) refuses to
    # touch any path that does not resolve INSIDE this directory. The
    # sandbox is set at program startup via hl_set_sandbox_root() —
    # boot.py --sandbox DIR emits the call in main().
    r.push("static char* hl_sandbox_root = NULL;")
    # Stage 21 (v0.37.0-alpha): runtime CPU feature probe. On x86-64 /
    # x86 it uses gcc/clang's __builtin_cpu_supports (CPU + OS support);
    # on aarch64 it reports "neon" when the compiler targets NEON (the
    # SIMD instruction set is baseline there but still gate-able); every
    # other architecture reports false. Used by simd_cpu_supports() —
    # the runtime-dispatch half of cfg(feature).
    r.push("static bool hl_simd_cpu_supports(hl_str* s) {")
    r.push("    if (!s) return false;")
    r.push("#define HL_FEAT_EQ(lit) \\")
    r.push("    (s->len == (int64_t)sizeof(lit) - 1 && memcmp(s->data, lit, sizeof(lit) - 1) == 0)")
    r.push("#if defined(__x86_64__) || defined(__i386__)")
    r.push("    if (HL_FEAT_EQ(\"avx\")) return __builtin_cpu_supports(\"avx\");")
    r.push("    if (HL_FEAT_EQ(\"avx2\")) return __builtin_cpu_supports(\"avx2\");")
    r.push("    if (HL_FEAT_EQ(\"sse3\")) return __builtin_cpu_supports(\"sse3\");")
    r.push("    if (HL_FEAT_EQ(\"sse4.2\")) return __builtin_cpu_supports(\"sse4.2\");")
    r.push("    return false;")
    r.push("#elif defined(__aarch64__)")
    r.push("    if (HL_FEAT_EQ(\"neon\")) return true; /* NEON is baseline on aarch64 */")
    r.push("    return false;")
    r.push("#else")
    r.push("    return false;")
    r.push("#endif")
    r.push("#undef HL_FEAT_EQ")
    r.push("}")
    r.push("")
    r.push("static void hl_set_sandbox_root(const char* dir) {")
    r.push("    if (hl_sandbox_root) { free(hl_sandbox_root); hl_sandbox_root = NULL; }")
    r.push("    if (dir) {")
    r.push("        // Canonicalise via realpath so symlink escapes are caught.")
    r.push("        char buf[4096];")
    r.push("        char* rp = realpath(dir, buf);")
    r.push("        // Deep-scan fix (CC14): check strdup's return. On OOM strdup")
    r.push("        // returns NULL, silently disabling the sandbox. Refuse to")
    r.push("        // proceed if we can't allocate the canonicalised path.")
    r.push("        if (rp) {")
    r.push("            char* dup = strdup(rp);")
    r.push("            if (!dup) hl_die(\"out of memory\");")
    r.push("            hl_sandbox_root = dup;")
    r.push("        }")
    r.push("    }")
    r.push("}")
    r.push("")
    # Stage 10 release: hl_sandbox_check(path) — refuse to touch paths
    # outside the sandbox root. Mirrors the interpreter's _sandbox_check.
    # Resolves symlinks via realpath so ../../etc/passwd attacks fail.
    r.push("static void hl_sandbox_check(const char* path) {")
    r.push("    if (!hl_sandbox_root) return;")
    r.push("    char buf[4096];")
    r.push("    char* rp = realpath(path, buf);")
    r.push("    // If realpath fails, the path doesn't exist yet (e.g. a write_file")
    r.push("    // target). Resolve the parent directory and check it.")
    r.push("    if (!rp) {")
    r.push("        // Find the last path separator and resolve the parent.")
    r.push("        char tmp[4096];")
    r.push("        strncpy(tmp, path, sizeof(tmp) - 1);")
    r.push("        tmp[sizeof(tmp) - 1] = 0;")
    r.push("        size_t L = strlen(tmp);")
    r.push("        while (L > 0 && tmp[L-1] != '/' && tmp[L-1] != '\\\\') {")
    r.push("            tmp[--L] = 0;")
    r.push("        }")
    r.push("        if (L == 0) { strcpy(tmp, \".\"); L = 1; }")
    r.push("        char pbuf[4096];")
    r.push("        char* pp = realpath(tmp, pbuf);")
    r.push("        if (!pp) hl_die(\"sandbox violation: cannot resolve path\");")
    r.push("        // Re-append the basename.")
    r.push("        snprintf(buf, sizeof(buf), \"%s%s\", pp, path + L);")
    r.push("    }")
    r.push("    // Common-prefix check with a separator after the prefix.")
    r.push("    size_t sb_len = strlen(hl_sandbox_root);")
    r.push("    if (strncmp(buf, hl_sandbox_root, sb_len) != 0)")
    r.push("        hl_die(\"sandbox violation: path resolves outside the sandbox\");")
    r.push("    char next = buf[sb_len];")
    r.push("    // Deep-scan fix (C9): accept both / and \\\\ as path separators")
    r.push("    // so the sandbox works on Windows. Previously only / was")
    r.push("    // accepted, causing every sandboxed file op to panic on Windows")
    r.push("    // (the parent-strip loop at line ~4207 accepts both, so the")
    r.push("    // inconsistency was a latent portability bug).")
    r.push("    if (next != 0 && next != '/' && next != '\\\\')")
    r.push("        hl_die(\"sandbox violation: path resolves outside the sandbox\");")
    r.push("}")
    r.push("")
    r.push("// ---- Stage 8-beta: reference-counting core ----")
    r.push("// refcnt is the first field of every heap object, so retain is")
    r.push("// generic; release is type-specific (it must release children).")
    r.push("static void* hl_retain(void* p) {")
    r.push("    if (p) ((int64_t*)p)[0] += 1;")
    r.push("    return p;")
    r.push("}")
    r.push("")
    # ---- Stage 16 (v0.27.0-alpha): the concurrency runtime ----
    # pthread tasks + channels. Design (mirrored exactly by the Python
    # interpreter's ConcRuntime so differential testing holds):
    #   - one global mutex + condvar guard ALL channel/task state
    #   - channels are MPMC FIFO queues, unbounded by default or BOUNDED
    #     via chan_new_bounded(cap) (Stage-16 perfection, v0.29.0-alpha):
    #     a bounded channel's send blocks while full (backpressure);
    #     recv/select/join (and full-sends) block on the global condvar
    #   - the deadlock detector fires when every thread that could
    #     produce work is blocked AND no channel has a progress
    #     opportunity (a pending message with a recv waiter, or free
    #     capacity with a send waiter) — see hl_rt_deadlock_check
    #   - Chan refcounts are ATOMIC (channels are the one deliberately
    #     shared object); Task refcounts live under the global mutex.
    #     Every other type crosses task boundaries by OWNERSHIP TRANSFER
    #     (spawn/send boundary clones — see gen_spawn_call), so all
    #     other refcount ops stay single-threaded, keeping the Stage 8
    #     non-atomic refcount model sound under concurrency.
    r.push("// ---- Stage 16: the concurrency runtime (tasks + channels) ----")
    r.push("typedef struct hl_msg {")
    r.push("    union { int64_t i; double f; void* p; } v;")
    r.push("    struct hl_msg* next;")
    r.push("} hl_msg;")
    r.push("")
    r.push("typedef struct hl_chan {")
    r.push("    volatile int64_t refcnt;   // ATOMIC — channels are shared across threads")
    r.push("    hl_msg* head;              // FIFO queue (guarded by g_rt_mu)")
    r.push("    hl_msg* tail;")
    r.push("    int64_t cap;               // 0 = unbounded; >= 1 = bounded: send blocks while full")
    r.push("    int64_t count;             // pending messages (guarded by g_rt_mu; O(1) len)")
    r.push("    int64_t waiters;           // threads blocked in recv/select on THIS channel")
    r.push("    int64_t send_waiters;      // threads blocked sending to this full channel")
    r.push("    struct hl_chan *reg_next, *reg_prev;  // live-channel registry (deadlock scan)")
    r.push("    void (*elem_release)(void*);  // pointer-payload release (NULL for primitives)")
    r.push("} hl_chan;")
    r.push("")
    r.push("typedef union { int64_t i; double f; void* p; } hl_task_res;")
    r.push("")
    r.push("typedef struct hl_task {")
    r.push("    int64_t refcnt;            // guarded by g_rt_mu")
    r.push("    pthread_t th;")
    r.push("    bool done;")
    r.push("    bool joined;")
    r.push("    bool freed;")
    r.push("    hl_task_res res;")
    r.push("} hl_task;")
    r.push("")
    r.push("typedef struct { void (*body)(void*, hl_task*); void* argbox; hl_task* task; } hl_spawn_ctx;")
    r.push("")
    r.push("static pthread_mutex_t g_rt_mu = PTHREAD_MUTEX_INITIALIZER;")
    r.push("static pthread_cond_t  g_rt_cv = PTHREAD_COND_INITIALIZER;")
    r.push("static int64_t g_rt_tasks   = 0;   // spawned tasks alive (main excluded)")
    r.push("static int64_t g_rt_blocked = 0;   // threads blocked in recv/select/join/send (main included)")
    r.push("static int64_t g_rt_msgs    = 0;   // pending messages across ALL channels")
    r.push("static hl_chan* g_rt_chans  = NULL; // live-channel registry (guarded by g_rt_mu)")
    r.push("")
    r.push("// Deadlock check — call with g_rt_mu HELD, before blocking.")
    r.push("// Fires when EVERY thread is blocked (recv/select/join/full-send)")
    r.push("// AND no channel has a progress opportunity: a pending message")
    r.push("// with a recv waiter, or free capacity with a send waiter. A")
    r.push("// woken-but-unscheduled thread is still counted in g_rt_blocked")
    r.push("// (its decrement happens only after cond_wait re-acquires the")
    r.push("// mutex), which is exactly why the waiter counters are needed:")
    r.push("// `blocked == alive` alone can fire while a consumer's message is")
    r.push("// already pending but the consumer has not been scheduled. (A")
    r.push("// thread between two operations holds the mutex and is never")
    r.push("// miscounted, so this cannot fire spuriously. Mirrors the Python")
    r.push("// ConcRuntime.deadlock_check exactly.)")
    r.push("static void hl_rt_deadlock_check(void) {")
    r.push("    int64_t alive = g_rt_tasks + 1;   // +1: the main thread")
    r.push("    if (g_rt_blocked != alive) return;")
    r.push("    for (hl_chan* c = g_rt_chans; c; c = c->reg_next) {")
    r.push("        if (c->head && c->waiters > 0) return;       // a consumer can proceed")
    r.push("        if (c->send_waiters > 0 && c->count < c->cap) return;  // a woken sender can proceed")
    r.push("    }")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    hl_die(\"deadlock: all tasks are blocked on channel operations (no possible progress)\");")
    r.push("}")
    r.push("")
    r.push("static void hl_chan_register(hl_chan* c) {")
    r.push("    c->reg_next = g_rt_chans;")
    r.push("    c->reg_prev = NULL;")
    r.push("    if (g_rt_chans) g_rt_chans->reg_prev = c;")
    r.push("    g_rt_chans = c;")
    r.push("}")
    r.push("static void hl_chan_unregister(hl_chan* c) {  // g_rt_mu HELD")
    r.push("    if (c->reg_prev) c->reg_prev->reg_next = c->reg_next; else g_rt_chans = c->reg_next;")
    r.push("    if (c->reg_next) c->reg_next->reg_prev = c->reg_prev;")
    r.push("}")
    r.push("")
    r.push("static hl_chan* hl_chan_new_cap(int64_t cap, void (*elem_release)(void*)) {")
    r.push("    hl_chan* c = (hl_chan*)malloc(sizeof(hl_chan));")
    r.push("    if (!c) hl_die(\"out of memory\");")
    r.push("    c->refcnt = 1;")
    r.push("    c->head = NULL;")
    r.push("    c->tail = NULL;")
    r.push("    c->cap = cap;")
    r.push("    c->count = 0;")
    r.push("    c->waiters = 0;")
    r.push("    c->send_waiters = 0;")
    r.push("    c->elem_release = elem_release;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_register(c);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return c;")
    r.push("}")
    r.push("static hl_chan* hl_chan_new(void (*elem_release)(void*)) {")
    r.push("    return hl_chan_new_cap(0, elem_release);")
    r.push("}")
    r.push("// chan_new_bounded(cap) — send blocks while `cap` messages are pending.")
    r.push("// The checker rejects literal capacities < 1; dynamic ones die here.")
    r.push("static hl_chan* hl_chan_new_bounded(int64_t cap, void (*elem_release)(void*)) {")
    r.push("    if (cap < 1) hl_die(\"chan_new_bounded() capacity must be >= 1\");")
    r.push("    return hl_chan_new_cap(cap, elem_release);")
    r.push("}")
    r.push("")
    r.push("// clone() of a channel SHARES it (atomic refcount + 1) — the whole")
    r.push("// point of a channel. This is the ONLY clone in the language that")
    r.push("// does not produce an independent copy.")
    r.push("static hl_chan* hl_chan_clone(hl_chan* c) {")
    r.push("    if (c) __atomic_fetch_add(&c->refcnt, 1, __ATOMIC_ACQ_REL);")
    r.push("    return c;")
    r.push("}")
    r.push("")
    r.push("static void hl_chan_release(void* pv) {")
    r.push("    hl_chan* c = (hl_chan*)pv;")
    r.push("    if (!c) return;")
    r.push("    if (__atomic_fetch_sub(&c->refcnt, 1, __ATOMIC_ACQ_REL) == 1) {")
    r.push("        // Last reference. v0.29.0-alpha: first unlink the channel")
    r.push("        // from the live-channel registry (the deadlock scan must")
    r.push("        // not walk a freed node). No waiter can exist: refcnt==0")
    r.push("        // means no binding holds the channel, and every")
    r.push("        // send/recv requires a live reference — so send_waiters ==")
    r.push("        // waiters == 0 here. The drain then runs WITHOUT the lock;")
    r.push("        // releasing payload channels re-enters safely (no nesting).")
    r.push("        pthread_mutex_lock(&g_rt_mu);")
    r.push("        hl_chan_unregister(c);")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        hl_msg* m = c->head;")
    r.push("        while (m) {")
    r.push("            hl_msg* nx = m->next;")
    r.push("            if (c->elem_release && m->v.p) c->elem_release(m->v.p);")
    r.push("            free(m);")
    r.push("            m = nx;")
    r.push("        }")
    r.push("        free(c);")
    r.push("    }")
    r.push("}")
    r.push("static void hl_cleanup_chan(hl_chan** p) { hl_chan_release(*p); }")
    r.push("")
    r.push("// Blocking enqueue — g_rt_mu HELD. On a bounded channel, waits")
    r.push("// while the queue holds `cap` messages (backpressure); a dequeue")
    r.push("// broadcasts, which is what wakes a sender blocked here. Unbounded")
    r.push("// channels (cap == 0) never block the sender.")
    r.push("static void hl_chan_enqueue(hl_chan* c, hl_msg* m) {  // g_rt_mu HELD")
    r.push("    while (c->cap > 0 && c->count >= c->cap) {")
    r.push("        c->send_waiters++;")
    r.push("        g_rt_blocked++;")
    r.push("        hl_rt_deadlock_check();")
    r.push("        pthread_cond_wait(&g_rt_cv, &g_rt_mu);")
    r.push("        g_rt_blocked--;")
    r.push("        c->send_waiters--;")
    r.push("    }")
    r.push("    if (c->tail) { c->tail->next = m; } else { c->head = m; }")
    r.push("    c->tail = m;")
    r.push("    m->next = NULL;")
    r.push("    c->count++;")
    r.push("    g_rt_msgs++;")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("}")
    r.push("")
    r.push("static hl_msg* hl_chan_dequeue(hl_chan* c) {  // g_rt_mu HELD")
    r.push("    hl_msg* m = c->head;")
    r.push("    c->head = m->next;")
    r.push("    if (!c->head) c->tail = NULL;")
    r.push("    c->count--;")
    r.push("    g_rt_msgs--;")
    r.push("    // Freeing capacity can unblock a bounded-channel sender.")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("    return m;")
    r.push("}")
    r.push("")
    r.push("static void hl_chan_send_ptr(hl_chan* c, void* v) {")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.p = v;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_enqueue(c, m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
    r.push("static void hl_chan_send_i64(hl_chan* c, int64_t v) {")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.i = v;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_enqueue(c, m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
    r.push("static void hl_chan_send_f64(hl_chan* c, double v) {")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.f = v;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    hl_chan_enqueue(c, m);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
    r.push("")
    r.push("// try_send — non-blocking variants: false iff a bounded channel")
    r.push("// is full (the value is NOT enqueued). For pointer payloads the")
    r.push("// caller's defensive copy is RELEASED here when the send fails")
    r.push("// (elem_release owns exactly that payload type).")
    r.push("static bool hl_chan_try_send_ptr(hl_chan* c, void* v) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (c->cap > 0 && c->count >= c->cap) {")
    r.push("        if (c->elem_release && v) c->elem_release(v);")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        return false;")
    r.push("    }")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.p = v;")
    r.push("    m->next = NULL;")
    r.push("    if (c->tail) { c->tail->next = m; } else { c->head = m; }")
    r.push("    c->tail = m;")
    r.push("    c->count++;")
    r.push("    g_rt_msgs++;")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    return true;")
    r.push("}")
    r.push("static bool hl_chan_try_send_i64(hl_chan* c, int64_t v) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (c->cap > 0 && c->count >= c->cap) {")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        return false;")
    r.push("    }")
    r.push("    hl_msg* m = (hl_msg*)malloc(sizeof(hl_msg));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->v.i = v;")
