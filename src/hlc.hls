    r.push("static void* hl_spawn_entry(void* pv) {")
    r.push("    hl_spawn_ctx* c = (hl_spawn_ctx*)pv;")
    r.push("    void (*body)(void*, hl_task*) = c->body;")
    r.push("    void* argbox = c->argbox;")
    r.push("    hl_task* t = c->task;")
    r.push("    free(c);")
    r.push("    body(argbox, t);")
    r.push("    return NULL;")
    r.push("}")
    r.push("")
    r.push("static hl_task* hl_spawn(void (*body)(void*, hl_task*), void* argbox) {")
    r.push("    hl_task* t = (hl_task*)malloc(sizeof(hl_task));")
    r.push("    if (!t) hl_die(\"out of memory\");")
    r.push("    t->refcnt = 1;")
    r.push("    t->done = false;")
    r.push("    t->joined = false;")
    r.push("    t->freed = false;")
    r.push("    t->res.p = NULL;")
    r.push("    hl_spawn_ctx* c = (hl_spawn_ctx*)malloc(sizeof(hl_spawn_ctx));")
    r.push("    if (!c) hl_die(\"out of memory\");")
    r.push("    c->body = body;")
    r.push("    c->argbox = argbox;")
    r.push("    c->task = t;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    g_rt_tasks++;   // counted BEFORE the thread starts: no deadlock false-positive window")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("    if (pthread_create(&t->th, NULL, hl_spawn_entry, c) != 0) {")
    r.push("        pthread_mutex_lock(&g_rt_mu);")
    r.push("        g_rt_tasks--;")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        free(c);")
    r.push("        free(t);")
    r.push("        hl_die(\"spawn: cannot create thread\");")
    r.push("    }")
    r.push("    return t;")
    r.push("}")
