    r.push("static void hl_task_join_wait(hl_task* t) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (t->joined) {")
    r.push("        pthread_mutex_unlock(&g_rt_mu);")
    r.push("        hl_die(\"task already joined\");")
    r.push("    }")
    r.push("    while (!t->done) {")
    r.push("        g_rt_blocked++;")
    r.push("        hl_rt_deadlock_check();")
    r.push("        pthread_cond_wait(&g_rt_cv, &g_rt_mu);")
    r.push("        g_rt_blocked--;")
    r.push("    }")
    r.push("    t->joined = true;")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_task_join_i64(hl_task* t) {")
