    r.push("static hl_str* hl_str_from_double(double v) {")
    r.push("    char buf[64];")
    r.push("    int n = snprintf(buf, sizeof buf, \"%.6f\", v);")
    r.push("    return hl_str_from(buf, (int64_t)n);")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_cstr(const char* c) { return hl_str_from(c, (int64_t)strlen(c)); }")
    r.push("static hl_str* hl_str_from_bool(bool v) {")
    r.push("    return v ? hl_str_from(\"true\", 4) : hl_str_from(\"false\", 5);")
    r.push("}")
    r.push("")
    r.push("// Dynamic list (boxed values), insertion-ordered map[str,T] hash table,")
    r.push("// checked int64 arithmetic, and I/O")
    r.push("static void* hl_box_i64(int64_t v) {")
    r.push("    int64_t* p = (int64_t*)malloc(sizeof(int64_t));")
    r.push("    if (!p) hl_die(\"out of memory\");")
    r.push("    *p = v;")
    r.push("    return p;")
    r.push("}")
    r.push("static int64_t hl_unbox_i64(void* p) { return *(int64_t*)p; }")
    r.push("")
    r.push("static void* hl_box_f64(double v) {")
    r.push("    double* p = (double*)malloc(sizeof(double));")
    r.push("    if (!p) hl_die(\"out of memory\");")
    r.push("    *p = v;")
    r.push("    return p;")
    r.push("}")
    r.push("static double hl_unbox_f64(void* p) { return *(double*)p; }")
    r.push("")
    r.push("static void* hl_box_bool(bool v) {")
    r.push("    bool* p = (bool*)malloc(sizeof(bool));")
    r.push("    if (!p) hl_die(\"out of memory\");")
    r.push("    *p = v;")
    r.push("    return p;")
    r.push("}")
    r.push("static bool hl_unbox_bool(void* p) { return *(bool*)p; }")
    r.push("")
    r.push("static void* hl_box_ptr(void* p) { return p; }")
    r.push("static void* hl_unbox_ptr(void* p) { return p; }")
    r.push("")
    r.push("// hl_list_new: elem_free describes how to release one element.")
    r.push("// free       -> primitive boxes;  hl_str_release -> str;")
    r.push("// hl_list_release / hl_map_release / hl_release_<T> -> containers/user types.")
    r.push("// NULL = arena mode (never release elements — LLVM backend).")
    r.push("static hl_list* hl_list_new(void (*elem_free)(void*)) {")
    r.push("    hl_list* l = (hl_list*)malloc(sizeof(hl_list));")
    r.push("    if (!l) hl_die(\"out of memory\");")
    r.push("    l->refcnt = 1;")
    r.push("    l->len = 0;")
    r.push("    l->cap = 8;")
    r.push("    l->elem_free = elem_free;")
    r.push("    l->items = (void**)malloc((size_t)l->cap * sizeof(void*));")
    r.push("    if (!l->items) hl_die(\"out of memory\");")
    r.push("    return l;")
    r.push("}")
    r.push("")
    r.push("static void hl_list_release(void* pl) {")
    r.push("    hl_list* l = (hl_list*)pl;")
    r.push("    if (!l) return;")
    r.push("    if (--l->refcnt == 0) {")
    r.push("        if (l->elem_free) {")
    r.push("            for (int64_t i = 0; i < l->len; i++) l->elem_free(l->items[i]);")
    r.push("        }")
    r.push("        free(l->items);")
    r.push("        free(l);")
    r.push("    }")
    r.push("}")
    r.push("static void hl_cleanup_list(hl_list** p) { hl_list_release(*p); }")
    r.push("")
    r.push("static void hl_list_push(hl_list* l, void* v) {")
    r.push("    if (l->len == l->cap) {")
    r.push("        size_t new_cap = l->cap * 2;")
    r.push("        // Deep-scan fix (CC7): realloc-on-failure leaks the original")
    r.push("        // buffer. Use a temp so the original is still freeable; the")
    r.push("        // old code reassigned l->items to NULL on failure, losing")
    r.push("        // the only reference to the original allocation (the leak")
    r.push("        // was process-terminal because hl_die exits, but ASan /")
    r.push("        // Valgrind would flag it; this fix is correctness hygiene).")
    r.push("        void** nb = (void**)realloc(l->items, new_cap * sizeof(void*));")
    r.push("        if (!nb) hl_die(\"out of memory\");")
    r.push("        l->items = nb;")
    r.push("        l->cap = new_cap;")
    r.push("    }")
    r.push("    l->items[l->len] = v;")
    r.push("    l->len++;")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_list_len(hl_list* l) { return l->len; }")
    r.push("")
    r.push("static void* hl_list_get(hl_list* l, int64_t i) {")
    r.push("    if (i < 0 || i >= l->len) hl_die(\"array access out of bounds\");")
    r.push("    return l->items[i];")
    r.push("}")
    r.push("")
    # Stage 17: the unchecked getter for -O fast bounds-proven accesses.
    r.push("static void* hl_list_get_unchecked(hl_list* l, int64_t i) {")
    r.push("    return l->items[i];")
    r.push("}")
    r.push("")
    r.push("// hl_list_set: v arrives OWNED (the caller transferred one retain).")
    r.push("// Store first, then release the old item so self-assignment is safe.")
    r.push("static void hl_list_set(hl_list* l, int64_t i, void* v) {")
    r.push("    if (i < 0 || i >= l->len) hl_die(\"array access out of bounds\");")
    r.push("    void* old = l->items[i];")
    r.push("    l->items[i] = v;")
    r.push("    if (l->elem_free) l->elem_free(old);")
    r.push("}")
    r.push("")
    r.push("static hl_list* hl_range(int64_t a, int64_t b) {")
    r.push("    hl_list* l = hl_list_new(free);")
    r.push("    for (int64_t i = a; i < b; i++) hl_list_push(l, hl_box_i64(i));")
    r.push("    return l;")
    r.push("}")
    r.push("")
    r.push("// ---- map[str, T]: linear-probing hash table + insertion-order array ----")
    r.push("static uint64_t hl_str_hash(hl_str* s) {")
    r.push("    uint64_t h = 1469598103934665603ULL;")
    r.push("    for (int64_t i = 0; i < s->len; i++) {")
    r.push("        h ^= (uint8_t)s->data[i];")
    r.push("        h *= 1099511628211ULL;")
    r.push("    }")
    r.push("    return h;")
    r.push("}")
    r.push("")
    r.push("// hl_map_new: val_free describes how to release one value. The map")
    r.push("// owns one retain per key and one retain (or box) per value.")
    r.push("static hl_map* hl_map_new(void (*val_free)(void*)) {")
    r.push("    hl_map* m = (hl_map*)malloc(sizeof(hl_map));")
    r.push("    if (!m) hl_die(\"out of memory\");")
    r.push("    m->refcnt = 1;")
    r.push("    m->len = 0;")
    r.push("    m->cap = 16;")
    r.push("    m->slots = (hl_str**)calloc((size_t)m->cap, sizeof(hl_str*));")
    r.push("    m->vals = (void**)malloc((size_t)m->cap * sizeof(void*));")
    r.push("    m->order = (hl_str**)malloc((size_t)m->cap * sizeof(hl_str*));")
    r.push("    m->val_free = val_free;")
    r.push("    if (!m->slots || !m->vals || !m->order) hl_die(\"out of memory\");")
    r.push("    return m;")
    r.push("}")
    r.push("")
    r.push("static void hl_map_release(void* pm) {")
    r.push("    hl_map* m = (hl_map*)pm;")
    r.push("    if (!m) return;")
    r.push("    if (--m->refcnt == 0) {")
    r.push("        for (int64_t i = 0; i < m->cap; i++) {")
    r.push("            if (m->slots[i] != NULL) {")
    r.push("                if (m->val_free) m->val_free(m->vals[i]);")
    r.push("                hl_str_release(m->slots[i]);")
    r.push("            }")
    r.push("        }")
    r.push("        free(m->slots);")
    r.push("        free(m->vals);")
    r.push("        free(m->order);")
    r.push("        free(m);")
    r.push("    }")
    r.push("}")
    r.push("static void hl_cleanup_map(hl_map** p) { hl_map_release(*p); }")
    r.push("")
    r.push("static void hl_map_grow(hl_map* m, int64_t ncap) {")
    r.push("    hl_str** nslots = (hl_str**)calloc((size_t)ncap, sizeof(hl_str*));")
    r.push("    void** nvals = (void**)malloc((size_t)ncap * sizeof(void*));")
    r.push("    hl_str** norder = (hl_str**)malloc((size_t)ncap * sizeof(hl_str*));")
    r.push("    if (!nslots || !nvals || !norder) hl_die(\"out of memory\");")
    r.push("    for (int64_t i = 0; i < m->cap; i++) {")
    r.push("        if (m->slots[i] != NULL) {")
    r.push("            uint64_t idx = hl_str_hash(m->slots[i]) & (uint64_t)(ncap - 1);")
    r.push("            while (nslots[idx] != NULL) idx = (idx + 1) & (uint64_t)(ncap - 1);")
    r.push("            nslots[idx] = m->slots[i];")
    r.push("            nvals[idx] = m->vals[i];")
    r.push("        }")
    r.push("    }")
    r.push("    for (int64_t j = 0; j < m->len; j++) norder[j] = m->order[j];")
    r.push("    free(m->slots);")
    r.push("    free(m->vals);")
    r.push("    free(m->order);")
    r.push("    m->slots = nslots;")
    r.push("    m->vals = nvals;")
    r.push("    m->order = norder;")
    r.push("    m->cap = ncap;")
    r.push("}")
    r.push("")
    r.push("// hl_map_set: k and v arrive OWNED (the caller transferred one retain")
    r.push("// of each). On overwrite the incoming key is released and the old")
    r.push("// value is released. Store-then-release keeps self-assignment safe.")
    r.push("static void hl_map_set(hl_map* m, hl_str* k, void* v) {")
    r.push("    if ((m->len + 1) * 10 >= m->cap * 7) {")
    r.push("        hl_map_grow(m, m->cap * 2);")
    r.push("    }")
    r.push("    uint64_t idx = hl_str_hash(k) & (uint64_t)(m->cap - 1);")
    r.push("    while (m->slots[idx] != NULL) {")
    r.push("        if (hl_str_eq(m->slots[idx], k)) {")
    r.push("            void* oldv = m->vals[idx];")
    r.push("            m->vals[idx] = v;")
    r.push("            if (m->val_free) m->val_free(oldv);")
    r.push("            hl_str_release(k);")
    r.push("            return;")
    r.push("        }")
    r.push("        idx = (idx + 1) & (uint64_t)(m->cap - 1);")
    r.push("    }")
    r.push("    m->slots[idx] = k;")
    r.push("    m->vals[idx] = v;")
    r.push("    m->order[m->len] = k;")
    r.push("    m->len++;")
    r.push("}")
    r.push("")
    r.push("// hl_map_borrow: raw lookup — returns the stored slot value (a box for")
    r.push("// primitive-valued maps, the value itself for pointer-valued maps) or")
    r.push("// NULL when the key is missing. The map keeps ownership.")
    r.push("static void* hl_map_borrow(hl_map* m, hl_str* k) {")
    r.push("    uint64_t idx = hl_str_hash(k) & (uint64_t)(m->cap - 1);")
    r.push("    while (m->slots[idx] != NULL) {")
    r.push("        if (hl_str_eq(m->slots[idx], k)) return m->vals[idx];")
    r.push("        idx = (idx + 1) & (uint64_t)(m->cap - 1);")
    r.push("    }")
    r.push("    return NULL;")
    r.push("}")
    r.push("")
    r.push("// Typed getters for primitive-valued maps: the default arrives by")
    r.push("// value — no boxing, no allocation, no refcount traffic.")
    r.push("static int64_t hl_map_get_i64(hl_map* m, hl_str* k, int64_t dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v == NULL) return dflt;")
    r.push("    return hl_unbox_i64(v);")
    r.push("}")
    r.push("static double hl_map_get_f64(hl_map* m, hl_str* k, double dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v == NULL) return dflt;")
    r.push("    return hl_unbox_f64(v);")
    r.push("}")
    r.push("static bool hl_map_get_bool(hl_map* m, hl_str* k, bool dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v == NULL) return dflt;")
    r.push("    return hl_unbox_bool(v);")
    r.push("}")
    r.push("")
    r.push("// hl_map_get_own: for pointer-valued maps. dflt arrives OWNED (+1)")
    r.push("// and the result is returned OWNED (+1).")
    r.push("static void* hl_map_get_own(hl_map* m, hl_str* k, void* dflt) {")
    r.push("    void* v = hl_map_borrow(m, k);")
    r.push("    if (v != NULL) {")
    r.push("        hl_retain(v);")
    r.push("        if (m->val_free) m->val_free(dflt);")
    r.push("        return v;")
    r.push("    }")
    r.push("    return dflt;")
    r.push("}")
    r.push("")
    r.push("static bool hl_map_has(hl_map* m, hl_str* k) { return hl_map_borrow(m, k) != NULL; }")
    r.push("")
    r.push("static int64_t hl_map_len(hl_map* m) { return m->len; }")
    r.push("")
    r.push("// hl_map_keys: fresh list[str]; each key is retained for the new list.")
    r.push("static hl_list* hl_map_keys(hl_map* m) {")
    r.push("    hl_list* r = hl_list_new(hl_str_release);")
    r.push("    for (int64_t i = 0; i < m->len; i++) hl_list_push(r, hl_retain(m->order[i]));")
    r.push("    return r;")
    r.push("}")
    r.push("")
    r.push("// ---- checked int64 arithmetic ----")
    r.push("static int64_t hl_add_i64(int64_t a, int64_t b) {")
    r.push("    int64_t r;")
    r.push("    if (__builtin_add_overflow(a, b, &r)) hl_die(\"integer overflow\");")
    r.push("    return r;")
    r.push("}")
    r.push("static int64_t hl_sub_i64(int64_t a, int64_t b) {")
    r.push("    int64_t r;")
    r.push("    if (__builtin_sub_overflow(a, b, &r)) hl_die(\"integer overflow\");")
    r.push("    return r;")
    r.push("}")
    r.push("static int64_t hl_mul_i64(int64_t a, int64_t b) {")
    r.push("    int64_t r;")
    r.push("    if (__builtin_mul_overflow(a, b, &r)) hl_die(\"integer overflow\");")
    r.push("    return r;")
    r.push("}")
    r.push("static int64_t hl_neg_i64(int64_t a) {")
    r.push("    if (a == INT64_MIN) hl_die(\"integer overflow\");")
    r.push("    return -a;")
    r.push("}")
    r.push("static int64_t hl_abs_i64(int64_t a) {")
    r.push("    if (a == INT64_MIN) hl_die(\"integer overflow\");")
    r.push("    return a < 0 ? -a : a;")
    r.push("}")
    r.push("static int64_t hl_div_i64(int64_t a, int64_t b) {")
    r.push("    if (b == 0) hl_die(\"division by zero\");")
    r.push("    if (a == INT64_MIN && b == -1) hl_die(\"integer overflow\");")
    r.push("    return a / b;")
    r.push("}")
    r.push("static int64_t hl_mod_i64(int64_t a, int64_t b) {")
    r.push("    if (b == 0) hl_die(\"division by zero\");")
    r.push("    if (a == INT64_MIN && b == -1) hl_die(\"integer overflow\");")
    r.push("    return a % b;")
    r.push("}")
    r.push("")
    r.push("// ---- I/O (print-family builtins CONSUME their str argument) ----")
    r.push("static hl_list* g_hl_args = NULL;")
    r.push("")
    r.push("static void hl_init_args(int argc, char** argv) {")
    r.push("    g_hl_args = hl_list_new(hl_str_release);")
    r.push("    for (int i = 0; i < argc; i++) {")
    r.push("        hl_list_push(g_hl_args, hl_str_from(argv[i], (int64_t)strlen(argv[i])));")
    r.push("    }")
    r.push("}")
    r.push("")
    r.push("static hl_list* hl_args(void) { return g_hl_args; }")
    r.push("")
    r.push("static void hl_print(hl_str* s) {")
    r.push("    fwrite(s->data, 1, (size_t)s->len, stdout);")
    r.push("    hl_str_release(s);")
    r.push("}")
    r.push("")
    r.push("static void hl_println(hl_str* s) {")
    r.push("    fwrite(s->data, 1, (size_t)s->len, stdout);")
    r.push("    fputc('\\n', stdout);")
    r.push("    hl_str_release(s);")
    r.push("}")
    r.push("")
    r.push("// hl_read_file: consumes the path, returns a fresh str. The temporary")
    r.push("// read buffer is freed before returning (it used to leak under the")
    r.push("// arena model).")
    r.push("static hl_str* hl_read_file(hl_str* path) {")
    r.push("    hl_sandbox_check(path->data);")
    r.push("    FILE* f = fopen(path->data, \"rb\");")
    r.push("    if (!f) hl_die(\"cannot open file\");")
    r.push("    // Virtual files (/proc, /sys) report size 0 via fseek/ftell,")
    r.push("    // so read incrementally until EOF instead of trusting the")
    r.push("    // size (BUG: the interpreter read them fine while the native")
    r.push("    // binary got empty output — a differential divergence).")
    r.push("    size_t cap = 4096, len = 0;")
    r.push("    char* buf = (char*)malloc(cap);")
    r.push("    if (!buf) hl_die(\"out of memory\");")
    r.push("    for (;;) {")
    r.push("        if (len == cap) {")
    r.push("            size_t new_cap = cap * 2;")
    r.push("            // Deep-scan fix (C10): realloc-on-failure leaks the")
    r.push("            // original buffer. Use a temp so the original is")
    r.push("            // still freeable on OOM.")
    r.push("            char* nb = (char*)realloc(buf, new_cap);")
    r.push("            if (!nb) { free(buf); hl_die(\"out of memory\"); }")
    r.push("            buf = nb;")
    r.push("            cap = new_cap;")
    r.push("        }")
    r.push("        size_t n = fread(buf + len, 1, cap - len, f);")
    r.push("        len += n;")
    r.push("        if (n == 0) break;")
    r.push("    }")
    r.push("    fclose(f);")
    r.push("    hl_str* out = hl_str_from(buf, (int64_t)len);")
    r.push("    free(buf);")
    r.push("    hl_str_release(path);")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// Stage 10 release: hl_read_line() — read one line from stdin.")
    r.push("// Strips a trailing newline (and CRLF if present). Returns a fresh")
    r.push("// hl_str* (refcount 1) owned by the caller. At EOF, returns an")
    r.push("// empty string (mirrors fgets semantics). The Stage-0 interpreter")
    r.push("// strips CRLF the same way so differential testing stays green.")
    r.push("static hl_str* hl_read_line(void) {")
    r.push("    size_t cap = 128, len = 0;")
    r.push("    char* buf = (char*)malloc(cap);")
    r.push("    if (!buf) hl_die(\"out of memory\");")
    r.push("    for (;;) {")
    r.push("        int c = getchar();")
    r.push("        if (c == EOF) break;")
    r.push("        if (len + 1 >= cap) {")
    r.push("            cap *= 2;")
    r.push("            char* nb = (char*)realloc(buf, cap);")
    r.push("            if (!nb) { free(buf); hl_die(\"out of memory\"); }")
    r.push("            buf = nb;")
    r.push("        }")
    r.push("        buf[len++] = (char)c;")
    r.push("        if (c == '\\n') break;")
    r.push("    }")
    r.push("    // Strip trailing \\n and \\r\\n.")
    r.push("    if (len > 0 && buf[len - 1] == '\\n') {")
    r.push("        len--;")
    r.push("        if (len > 0 && buf[len - 1] == '\\r') len--;")
    r.push("    }")
    r.push("    hl_str* out = hl_str_from(buf, (int64_t)len);")
    r.push("    free(buf);")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// hl_write_file: consumes the path and the content.")
    r.push("static void hl_write_file(hl_str* path, hl_str* content) {")
    r.push("    hl_sandbox_check(path->data);")
    r.push("    FILE* f = fopen(path->data, \"wb\");")
    r.push("    if (!f) hl_die(\"cannot write file\");")
    r.push("    if (content->len > 0 && fwrite(content->data, 1, (size_t)content->len, f) != (size_t)content->len) {")
    r.push("        hl_die(\"cannot write file\");")
    r.push("    }")
    r.push("    if (fclose(f) != 0) hl_die(\"cannot write file\");")
    r.push("    hl_str_release(content);")
    r.push("    hl_str_release(path);")
    r.push("}")
    r.push("")
    r.push("static int64_t hl_clock_ms(void) {")
    r.push("    struct timespec ts;")
    r.push("    clock_gettime(CLOCK_MONOTONIC, &ts);")
    r.push("    return (int64_t)ts.tv_sec * 1000 + (int64_t)ts.tv_nsec / 1000000;")
    r.push("}")
    r.push("")
    r.push("static void hl_panic(hl_str* msg) {")
    r.push("    fflush(stdout);")
    r.push("    fprintf(stderr, \"panic: %s\\n\", msg->data);")
    r.push("    exit(101);")
    r.push("}")
    r.push("")
    r.push("static void hl_exit(int64_t code) {")
    r.push("    fflush(stdout);")
    r.push("    exit((int)code);")
    r.push("}")
    r.push("")
    # ---- Stage 9 release (v0.20.0-alpha): Net / Rand / Proc runtime ----
    # HalisRNG — a 64-bit LCG shared with the Stage-0 interpreter.
    # Same constants (Knuth's MMIX), same bit-mask, same float extraction
    # → same sequence for the same seed. This is CRITICAL for
    # differential testing: a test using rand_seed + rand_int/rand_float
    # must produce identical output in both backends, otherwise the
    # test suite would fail.
    # Algorithm:
    #   state = state * 6364136223846793005 + 1442695040888963407   (mod 2^64)
    #   rand_int(max) = state % max   (max > 0)
    #   rand_float()  = (state >> 11) / 2^53   (53 bits of randomness)
    r.push("static uint64_t hl_rng_state = 1;  /* nonzero default */")
    r.push("")
    r.push("static void hl_rand_seed(int64_t s) {")
    r.push("    hl_rng_state = (uint64_t)s;")
    r.push("    if (hl_rng_state == 0) hl_rng_state = 1;  /* avoid degenerate seq */")
    r.push("}")
    r.push("")
    r.push("static uint64_t hl_rng_next(void) {")
    r.push("    hl_rng_state = hl_rng_state * 6364136223846793005ULL + 1442695040888963407ULL;")
    r.push("    return hl_rng_state;")
    r.push("}")
    r.push("")
    # hl_rand_int(max) — uniform random int in [0, max). Panics on max <= 0
    # (matches the interpreter). Modulo bias is bounded by the caller's
    # choice of max; for cryptographically-unbiased randomness, use a
    # rejection-sampling wrapper (deferred to a future stage).
    r.push("static int64_t hl_rand_int(int64_t max) {")
    r.push("    if (max <= 0) hl_die(\"rand_int() requires a positive max\");")
    r.push("    uint64_t r = hl_rng_next();")
    r.push("    return (int64_t)(r % (uint64_t)max);")
    r.push("}")
    r.push("")
    # hl_rand_float() — uniform random float in [0.0, 1.0). 53 bits of
    # randomness — full precision of an IEEE double's significand.
    r.push("static double hl_rand_float(void) {")
    r.push("    uint64_t r = hl_rng_next();")
    r.push("    return (double)(r >> 11) / (double)(1ULL << 53);")
    r.push("}")
    r.push("")
    # hl_net_lookup(host) — DNS A record lookup via getaddrinfo. Returns
    # the first IPv4 address as a fresh str. Panics on failure (DNS
    # error or no A records). Consumes the host argument.
    r.push("static hl_str* hl_net_lookup(hl_str* host) {")
    r.push("    struct addrinfo hints;")
    r.push("    memset(&hints, 0, sizeof(hints));")
    r.push("    hints.ai_family = AF_INET;")
    r.push("    hints.ai_socktype = SOCK_STREAM;")
    r.push("    struct addrinfo* res = NULL;")
    r.push("    int rc = getaddrinfo(host->data, NULL, &hints, &res);")
    r.push("    if (rc != 0 || res == NULL) {")
    r.push("        hl_str_release(host);")
    r.push("        hl_die(\"net_lookup: DNS resolution failed\");")
    r.push("    }")
    r.push("    char addr_buf[INET_ADDRSTRLEN];")
    r.push("    const char* r = inet_ntop(AF_INET,")
    r.push("        &((struct sockaddr_in*)res->ai_addr)->sin_addr,")
    r.push("        addr_buf, sizeof(addr_buf));")
    r.push("    freeaddrinfo(res);")
    r.push("    if (!r) {")
    r.push("        hl_str_release(host);")
    r.push("        hl_die(\"net_lookup: inet_ntop failed\");")
    r.push("    }")
    r.push("    hl_str* out = hl_str_from(addr_buf, (int64_t)strlen(addr_buf));")
    r.push("    hl_str_release(host);")
    r.push("    return out;")
    r.push("}")
    r.push("")
    # hl_proc_exec(cmd) — run a shell command via system(). Returns the
    # exit code (0 on success, 1..255 on failure, 128+signum on signal
    # kill). Consumes the cmd argument. The checker enforces that the
    # command is not tainted (proc_exec is a taint sink).
    r.push("static int64_t hl_proc_exec(hl_str* cmd) {")
    r.push("    int rc = system(cmd->data);")
    r.push("    hl_str_release(cmd);")
    r.push("    if (rc == -1) {")
    r.push("        hl_die(\"proc_exec: system() failed\");")
    r.push("    }")
    r.push("#ifdef WIFEXITED")
    r.push("    if (WIFEXITED(rc)) return (int64_t)WEXITSTATUS(rc);")
    r.push("    if (WIFSIGNALED(rc)) return (int64_t)(128 + WTERMSIG(rc));")
    r.push("#else")
    r.push("    return (int64_t)(rc & 0xFF);")
    r.push("#endif")
    r.push("    return (int64_t)(rc & 0xFF);")
    r.push("}")
    r.push("")
    r.push("// String split helper (placed last because it depends on hl_list)")
    r.push("static hl_list* hl_str_split(hl_str* s, hl_str* sep) {")
    r.push("    if (sep->len == 0) hl_die(\"empty separator not allowed\");")
    r.push("    hl_list* out = hl_list_new(hl_str_release);")
    r.push("    if (s->len == 0) {")
    r.push("        hl_list_push(out, hl_str_from(\"\", 0));")
    r.push("        return out;")
    r.push("    }")
    r.push("    int64_t start = 0;")
    r.push("    int64_t i = 0;")
    r.push("    while (i + sep->len <= s->len) {")
    r.push("        if (memcmp(s->data + i, sep->data, (size_t)sep->len) == 0) {")
    r.push("            hl_list_push(out, hl_str_from(s->data + start, i - start));")
    r.push("            i += sep->len;")
    r.push("            start = i;")
    r.push("        } else {")
    r.push("            i++;")
    r.push("        }")
    r.push("    }")
    r.push("    hl_list_push(out, hl_str_from(s->data + start, s->len - start));")
    r.push("    return out;")
    r.push("}")
    r.push("")
    r.push("// ---- v0.2 additions: pop, float, chr, fmod ----")
    r.push("// hl_list_pop: ownership of the removed item transfers to the caller.")
    r.push("static void* hl_list_pop(hl_list* l) {")
    r.push("    if (l->len == 0) hl_die(\"array access out of bounds\");")
    r.push("    l->len--;")
    r.push("    return l->items[l->len];")
    r.push("}")
    r.push("")
    r.push("// Typed pops for primitive element lists: pop the box, unbox the")
    r.push("// value, free the box. (A plain pop + unbox would leak the box —")
    r.push("// the caller only wanted the primitive.)")
    r.push("static int64_t hl_list_pop_i64(hl_list* l) {")
    r.push("    void* b = hl_list_pop(l);")
    r.push("    int64_t v = hl_unbox_i64(b);")
    r.push("    free(b);")
    r.push("    return v;")
    r.push("}")
    r.push("static double hl_list_pop_f64(hl_list* l) {")
    r.push("    void* b = hl_list_pop(l);")
    r.push("    double v = hl_unbox_f64(b);")
    r.push("    free(b);")
    r.push("    return v;")
    r.push("}")
    r.push("static bool hl_list_pop_bool(hl_list* l) {")
    r.push("    void* b = hl_list_pop(l);")
    r.push("    bool v = hl_unbox_bool(b);")
    r.push("    free(b);")
    r.push("    return v;")
    r.push("}")
    r.push("")
    r.push("static double hl_str_to_double(hl_str* s) {")
    r.push("    int64_t i = 0;")
    r.push("    int64_t dots = 0;")
    r.push("    int64_t digits = 0;")
    r.push("    int saw_exp = 0;")
    r.push("    int exp_digits = 0;")
    r.push("    if (s->len == 0) hl_die(\"cannot convert string to float\");")
    r.push("    if (s->data[0] == '-' || s->data[0] == '+') i = 1;")
    r.push("    if (i >= s->len) hl_die(\"cannot convert string to float\");")
    r.push("    for (; i < s->len; i++) {")
    r.push("        char c = s->data[i];")
    r.push("        if (c == '.') { if (saw_exp) hl_die(\"cannot convert string to float\"); dots++; continue; }")
    r.push("        if (c == 'e' || c == 'E') {")
    r.push("            if (saw_exp || digits == 0) hl_die(\"cannot convert string to float\");")
    r.push("            saw_exp = 1;")
    r.push("            if (i + 1 < s->len && (s->data[i+1] == '+' || s->data[i+1] == '-')) i++;")
    r.push("            exp_digits = 0;")
    r.push("            continue;")
    r.push("        }")
    r.push("        if (c < '0' || c > '9') hl_die(\"cannot convert string to float\");")
    r.push("        if (saw_exp) exp_digits++;")
    r.push("        digits++;")
    r.push("    }")
    r.push("    if (dots > 1 || digits == 0) hl_die(\"cannot convert string to float\");")
    r.push("    if (saw_exp && exp_digits == 0) hl_die(\"cannot convert string to float\");")
    r.push("    return strtod(s->data, NULL);")
    r.push("}")
    r.push("")
    r.push("static hl_str* hl_chr(int64_t c) {")
    r.push("    if (c < 0 || c > 255) hl_die(\"chr out of range 0..255\");")
    r.push("    char b = (char)c;")
    r.push("    return hl_str_from(&b, 1);")
    r.push("}")
    r.push("")
    r.push("static double hl_fmod(double a, double b) {")
    r.push("    return fmod(a, b);")
    r.push("}")
    r.push("")
    r.push("// BUG-15 fix: range-checked float -> int64 conversion. C casts")
    r.push("// silently truncate out-of-range floats; we panic instead so the")
    r.push("// error points to the actual source of the bad value.")
    r.push("static int64_t hl_float_to_int(double v) {")
    r.push("    // NaN fails BOTH comparisons, so an explicit isnan check is")
    r.push("    // required — otherwise the cast below is undefined behaviour.")
    r.push("    if (isnan(v) || v < -9.2233720368547758e18 || v > 9.2233720368547757e18)")
    r.push("        hl_die(\"float.to_int out of int64 range\");")
    r.push("    return (int64_t)v;")
    r.push("}")
    r.push("")
    r.push("// hl_file_exists: consumes the path.")
    r.push("static bool hl_file_exists(hl_str* path) {")
    r.push("    hl_sandbox_check(path->data);")
    r.push("    struct stat st;")
    r.push("    bool ok = stat(path->data, &st) == 0 && S_ISREG(st.st_mode);")
    r.push("    hl_str_release(path);")
    r.push("    return ok;")
    r.push("}")
    r.push("")
    # ----- Stage 8-beta: ownership primitives runtime -----
    # clone(str) is the only fixed clone helper in the runtime. Every other
    # clone() helper is generated per type-instantiation by the codegen
    # (hl_clone_<mangled-type>) because it must know field/elem/value
    # types — including user structs and enums.
    r.push("// clone(str) — strings are immutable, so a shallow copy is a deep copy.")
    r.push("static hl_str* hl_clone_str(hl_str* s) {")
    r.push("    return hl_str_from(s->data, s->len);")
    r.push("}")
    r.push("")
    return r
}

# ----------------------------------------------------------------------------
# 5. CODEGEN — HLS -> C
# ----------------------------------------------------------------------------

fn c_type(ctx: Ctx, t_in: str) -> str {
    # Substitute type params from current instantiation context.
    let mut t: str = t_in
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        t = instantiate_type(t, ctx.cur_typeparams, ctx.cur_targs)
    }
    if t == "int" {
        return "int64_t"
    }
    if t == "float" {
        return "double"
    }
    if t == "bool" {
        return "bool"
    }
    if t == "str" {
        return "hl_str*"
    }
    if t == "void" {
        return "void"
    }
    if is_list_t(t) {
        return "hl_list*"
    }
    if is_map_t(t) {
        return "hl_map*"
    }
    if is_taint_t(t) {
        # Stage 10-alpha: at the C level, a tainted[T] is represented the
        # same as T — the taint is a compile-time property only, enforced
        # by the checker's taint-sink rule. Runtime distinction (e.g. a
        # taint flag carried at runtime) is deferred to Stage 10-beta.
        return c_type(ctx, taint_inner_t(t))
    }
    # Stage 16 (v0.27.0-alpha): concurrency wrappers.
    if is_chan_t(t) {
        return "hl_chan*"
    }
    if is_task_t(t) {
        return "hl_task*"
    }
    return c_type_name(t) + "*"
}

fn is_ptr_type(t: str) -> bool {
    if t == "int" || t == "float" || t == "bool" || t == "void" {
        return false
    }
    if is_taint_t(t) {
        # tainted[T] is a pointer iff T is.
        return is_ptr_type(taint_inner_t(t))
    }
    if is_chan_t(t) || is_task_t(t) {
        # Stage 16: channels and task handles are heap objects.
        return true
    }
    return true
}

fn box_fn_for(t: str) -> str {
    if t == "int" {
        return "hl_box_i64"
    }
    if t == "float" {
        return "hl_box_f64"
    }
    if t == "bool" {
        return "hl_box_bool"
    }
    return "hl_box_ptr"
}

fn gen_unbox(ctx: Ctx, t: str, cexpr: str) -> str {
    if t == "int" {
        return "hl_unbox_i64(" + cexpr + ")"
    }
    if t == "float" {
        return "hl_unbox_f64(" + cexpr + ")"
    }
    if t == "bool" {
        return "hl_unbox_bool(" + cexpr + ")"
    }
    return "(" + c_type(ctx, t) + ")hl_unbox_ptr(" + cexpr + ")"
}

fn box_val(t: str, cexpr: str) -> str {
    return box_fn_for(t) + "(" + cexpr + ")"
}

# c_type_name(t) — mangle a HLS type name into a valid C identifier.
# Used for both user types and their generic instantiations.
# Examples:
#   "Point"            -> "Point"
#   "Box[int]"         -> "Box__int"
#   "Pair[int, str]"   -> "Pair__int__str"
#   "Option[list[int]]" -> "Option__list_int_"
#   "Foo[A, B, C]"     -> "Foo__A__B__C"  (only when A, B, C are already-bound type args)
fn c_type_name(t: str) -> str {
    let base: str = type_base(t)
    let args: list[str] = type_args(t)
    if args.len() == 0 {
        return base
    }
    let mut out: str = base + "__"
    let mut i: int = 0
    while i < args.len() {
        if i > 0 {
            out = out + "__"
        }
        out = out + c_type_name(args.get(i))
        i = i + 1
    }
    return out
}

# c_fn_name(key) — mangle a HLS function key into a C identifier.
# "foo" -> "foo"; "Point.dist" -> "Point_dist"
fn c_fn_name(key: str) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < key.len() {
        if key.byte_at(i) == 46 {
            parts.push("_")
        } else {
            parts.push(key.slice(i, i + 1))
        }
        i = i + 1
    }
    return join(parts, "")
}

# c_mangled_fn_name(key, targs) — mangle a generic function call's
# instantiation: identity[int] -> "identity__int"
fn c_mangled_fn_name(key: str, tps: list[str], targs: list[str]) -> str {
    if tps.len() == 0 {
        return c_fn_name(key)
    }
    let mut out: str = c_fn_name(key) + "__"
    let mut i: int = 0
    while i < targs.len() {
        if i > 0 {
            out = out + "__"
        }
        out = out + c_type_name(targs.get(i))
        i = i + 1
    }
    return out
}

fn c_str_lit(s: str) -> str {
    let mut out: str = "hl_cstr(\""
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b == 34 {
            out = out + "\\\""
        } else if b == 92 {
            out = out + "\\\\"
        } else if b == 10 {
            out = out + "\\n"
        } else if b == 9 {
            out = out + "\\t"
        } else if b >= 32 && b <= 126 {
            out = out + s.slice(i, i + 1)
        } else {
            let o: int = b
            let d1: int = o / 64
            let d2: int = (o / 8) % 8
            let d3: int = o % 8
            out = out + "\\" + chr(48 + d1) + chr(48 + d2) + chr(48 + d3)
        }
        i = i + 1
    }
    return out + "\")"
}

fn fresh_local(ctx: Ctx, name: str) -> str {
    if !ctx.gen_counts.has(name) {
        ctx.gen_counts.set(name, 1)
        ctx.gen_locals.set(name, "u_" + name)
        return "u_" + name
    }
    let n: int = ctx.gen_counts.get_or(name, 1)
    ctx.gen_counts.set(name, n + 1)
    let cname: str = "u_" + name + "_" + (n + 1).to_str()
    ctx.gen_locals.set(name, cname)
    return cname
}

fn fresh_tmp(ctx: Ctx, base: str) -> str {
    ctx.tmp = ctx.tmp + 1
    return base + "_" + ctx.tmp.to_str()
}

fn local_c(ctx: Ctx, name: str) -> str {
    let cn: str = ctx.gen_locals.get_or(name, "")
    if cn == "" {
        panic("internal codegen error: variable not found " + name)
    }
    return cn
}

fn concat_lines(dst: list[str], src: list[str]) -> void {
    let mut i: int = 0
    while i < src.len() {
        dst.push(src.get(i))
        i = i + 1
    }
}

# ============================================================================
# 4c. STAGE 8-BETA OWNERSHIP CODEGEN HELPERS
# ----------------------------------------------------------------------------
# The ownership discipline (see SPEC.md section 16):
#   * Every heap value is reference-counted (refcnt is the first field).
#   * "Fresh" expressions (literals, concat, clone, call results, pop,
#     map.keys, list/struct/enum literals) carry one retain nobody owns —
#     the consumer takes it over.
#   * "Borrow" expressions (idents, field/index access) point at a retain
#     owned elsewhere; a consumer that keeps the value adds its own retain.
#   * Bindings own one retain, released by a C cleanup attribute at block
#     exit (this covers break/continue/return automatically).
#   * Function parameters own one retain of each argument (call sites
#     own-wrap fresh values raw and borrowed values with hl_retain).
#   * take(x) transfers the binding's retain: the C variable is nulled
#     after the statement. drop(x) releases it immediately.
#   * Fresh pointer-typed subexpressions consumed in a borrowed position
#     are hoisted into temps with cleanups so nothing leaks.
# ============================================================================

# inst_t: substitute type params from the current instantiation context.
fn inst_t(ctx: Ctx, t: str) -> str {
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        return instantiate_type(t, ctx.cur_typeparams, ctx.cur_targs)
    }
    return t
}

# is_ptr_t: True when values of this (instantiated) type are refcounted
# pointers. tainted[T] is a pointer iff T is.
fn is_ptr_t(ctx: Ctx, t_in: str) -> bool {
    let t: str = inst_t(ctx, t_in)
    if t == "int" || t == "float" || t == "bool" || t == "void" || t == "never" {
        return false
    }
    if is_taint_t(t) {
        return is_ptr_t(ctx, taint_inner_t(t))
    }
    return true
}

# strip_taint: unwrap tainted[...] chains for release/clone dispatch.
fn strip_taint(t: str) -> str {
    let mut out: str = t
    let mut guard: int = 0
    while is_taint_t(out) && guard < 8 {
        out = taint_inner_t(out)
        guard = guard + 1
    }
    return out
}

# release_fn_for: the type-specific release function name.
fn release_fn_for(ctx: Ctx, t_in: str) -> str {
    let t: str = strip_taint(inst_t(ctx, t_in))
    if t == "str" {
        return "hl_str_release"
    }
    if is_list_t(t) {
        return "hl_list_release"
    }
    if is_map_t(t) {
        return "hl_map_release"
    }
    # Stage 16: channel / task release fns (their refcounts are atomic /
    # mutex-guarded — see the concurrency runtime).
    if is_chan_t(t) {
        return "hl_chan_release"
    }
    if is_task_t(t) {
        return "hl_task_release"
    }
    return "hl_release_" + c_type_name(t)
}

# cleanup_fn_for: the block-exit cleanup function (takes T**).
fn cleanup_fn_for(ctx: Ctx, t_in: str) -> str {
    let t: str = strip_taint(inst_t(ctx, t_in))
    if t == "str" {
        return "hl_cleanup_str"
    }
    if is_list_t(t) {
        return "hl_cleanup_list"
    }
    if is_map_t(t) {
        return "hl_cleanup_map"
    }
    # Stage 16: channel / task cleanups.
    if is_chan_t(t) {
        return "hl_cleanup_chan"
    }
    if is_task_t(t) {
        return "hl_cleanup_task"
    }
    return "hl_cleanup_" + c_type_name(t)
}

# elem_free_fn: the function pointer passed to hl_list_new / hl_map_new
# describing how to release one element / value. `free` for primitive
# boxes (they are single-owner allocations, not refcounted).
fn elem_free_fn(ctx: Ctx, t_in: str) -> str {
    let t: str = strip_taint(inst_t(ctx, t_in))
    if t == "int" || t == "float" || t == "bool" {
        return "free"
    }
    return release_fn_for(ctx, t)
}

# release_call: a full C statement expression releasing cexpr of type t.
fn release_call(ctx: Ctx, t: str, cexpr: str) -> str {
    if !is_ptr_t(ctx, t) {
        return "((void)0)"
    }
    return release_fn_for(ctx, t) + "(" + cexpr + ")"
}

# own_wrap: wrap a generated expression so it arrives OWNED (+1 retain)
# at its consumer. Primitives pass through; fresh pointer values pass
# through raw (their inherent retain is the one transferred); borrowed
# pointer values get an explicit hl_retain.
fn own_wrap(ctx: Ctx, t: str, cexpr: str, fresh: bool) -> str {
    if !is_ptr_t(ctx, t) {
        return cexpr
    }
    if fresh {
        return cexpr
    }
    return "hl_retain(" + cexpr + ")"
}

# gen_store_val: wrap a value being stored into a container
# (list.push/set, map.set). Primitive boxes pass through box_val;
# pointer values are own-wrapped so the container owns one retain.
fn gen_store_val(ctx: Ctx, t: str, cexpr: str, fresh: bool) -> str {
    if !is_ptr_t(ctx, t) {
        return box_val(inst_t(ctx, t), cexpr)
    }
    return own_wrap(ctx, t, cexpr, fresh)
}

# expr_fresh: classify an expression by ownership. True = the value it
# produces is "fresh" (one unowned retain the consumer takes over).
fn expr_fresh(ctx: Ctx, e: int) -> bool {
    let k: str = ctx.exprs[e].kind
    if k == "str" {
        return true
    }
    if k == "int" || k == "float" || k == "bool" || k == "ident" {
        return false
    }
    if k == "bin" {
        # Only pointer-typed binops exist for `+` on str (concat) — the
        # result is fresh. Comparisons/arithmetic on primitives are not
        # pointer values, so their class is irrelevant.
        return is_ptr_t(ctx, ctx.exprs[e].t)
    }
    if k == "un" {
        return false
    }
    if k == "index" {
        return false
    }
    if k == "field" {
        return false
    }
    if k == "listlit" || k == "structlit" || k == "enumlit" || k == "mapnew" {
        return true
    }
    if k == "match" {
        # Match arms own-wrap their results, so the match always yields
        # an owned value.
        return true
    }
    if k == "qmark" {
        return true
    }
    if k == "call" {
        return call_result_fresh(ctx, e)
    }
    if k == "method" {
        return method_result_fresh(ctx, e)
    }
    return false
}

# call_result_fresh: freshness table for builtin/user calls.
fn call_result_fresh(ctx: Ctx, e: int) -> bool {
    if ctx.exprs[e].muser {
        let cf: FnInfo = ctx.fns.get_or(ctx.exprs[e].mkey, dummy_fn())
        if cf.is_extern {
            # Extern C functions return raw values; the codegen does not
            # refcount them (extern signatures returning pointers are
            # handled as borrows).
            return false
        }
        return true
    }
    let name: str = ctx.exprs[e].mkey
    if name == "read_file" || name == "read_file_tainted" {
        return true
    }
    # Stage 9 release (v0.20.0-alpha): net_lookup returns a fresh str
    # (the host is consumed; a new str is allocated for the IP address).
    # Without this, the binding `let ip: str = net_lookup(host)` would
    # get an extra hl_retain wrap (because expr_fresh returns false), and
    # the binding's cleanup would only release the extra retain — leaking
    # the underlying str (the original refcnt=1 from hl_net_lookup).
    if name == "net_lookup" {
        return true
    }
    if name == "range" || name == "chr" {
        return true
    }
    if name == "map_new" {
        return true
    }
    if name == "clone" || name == "take" {
        return true
    }
    # Stage 16 (v0.27.0-alpha): spawn returns a fresh Task handle;
    # chan_new returns a fresh channel (refcnt 1, owned by the spawner).
    # v0.29.0-alpha: chan_new_bounded likewise.
    if name == "spawn" || name == "chan_new" || name == "chan_new_bounded" {
        return true
    }
    # select returns an int (primitive — class irrelevant).
    if name == "str" {
        # str(x) is the identity for str arguments — the result's class
        # follows the argument's. For int/float/bool the codegen calls
        # hl_str_from_int64 / hl_str_from_double / hl_str_from_bool, all
        # of which return a FRESH str (refcnt=1, unowned) — so the result
        # is fresh, matching the method forms int.to_str() / float.to_str()
        # / bool.to_str() (see method_result_fresh). BUG (deep-scan-5):
        # previously this returned `false` for the primitive cases, so
        # `let s: str = str(5)` was emitted as
        # `hl_retain(hl_str_from_int64(5))` — the retain was never
        # released (the binding's cleanup decremented only the extra
        # one), leaking one hl_str per call site on every iteration.
        let at: str = ctx.exprs[ctx.exprs[e].args.get(0)].t
        if at == "str" {
            return expr_fresh(ctx, ctx.exprs[e].args.get(0))
        }
        # int / float / bool -> str produces a fresh str.
        return true
    }
    if name == "taint_mark" || name == "taint_unwrap" {
        return expr_fresh(ctx, ctx.exprs[e].args.get(0))
    }
    # args()/tainted_args() return the process-lifetime global list.
    # print/println/panic/exit/write_file/len/int/float/clock_ms/
    # file_exists/drop return void or primitives.
    return false
}

# method_result_fresh: freshness table for builtin methods.
fn method_result_fresh(ctx: Ctx, e: int) -> bool {
    if ctx.exprs[e].muser {
        return true
    }
    let op: str = ctx.exprs[e].mop
    if op == "str.slice" || op == "str.split" || op == "str.trim" {
        return true
    }
    if op == "str.to_str" {
        # Identity on the receiver — the result's class follows it.
        return expr_fresh(ctx, ctx.exprs[e].left)
    }
    if op == "int.to_str" || op == "float.to_str" || op == "bool.to_str" {
        return true
    }
    if op == "list.pop" {
        # Ownership of the removed element transfers out of the list.
        return true
    }
    # Stage 16 (v0.27.0-alpha): recv transfers message ownership to the
    # receiver; join transfers the task result to the joiner.
    # v0.29.0-alpha: recv_or is fresh the same way — the message's
    # retain transfers, or the own-wrapped default does.
    if op == "chan.recv" || op == "chan.recv_or" || op == "task.join" {
        return true
    }
    if op == "map.keys" {
        return true
    }
    if op == "map.get_or" {
        # Pointer-valued maps return an owned retain (hl_map_get_own).
        # Primitive-valued maps return unboxed primitives.
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        if is_map_t(mt) {
            return is_ptr_t(ctx, map_val_t(mt))
        }
        return false
    }
    return false
}

# flush_null_after: emit `x = NULL;` for every binding moved out by
# take() during the current statement, then clear the list. Nulling
# makes the scope-exit cleanup a no-op (ownership was transferred).
fn flush_null_after(ctx: Ctx, ind: str) -> void {
    let mut i: int = 0
    while i < ctx.null_after.len() {
        ctx.out.push(ind + ctx.null_after.get(i) + " = NULL;")
        i = i + 1
    }
    ctx.null_after = []
}

# collect_hoist: walk the expression tree and record every fresh
# pointer-typed node consumed in a BORROWED position (a position whose
# consumer does not own the value). Those nodes are hoisted into temps
# with cleanup attributes by hoist_all before the statement is emitted.
#
# Position table:
#   bin/un operands, index/field receivers+indices      -> borrowed
#   user fn call args, method receivers (user), container
#   stores (push/set/map.set), struct/enum literal fields,
#   list literal elements, consume-builtin args          -> transferred
#   builtin borrow-fn args (clone, len, str-methods)     -> borrowed
#   match scrutinee, qmark inner                         -> internal
fn collect_hoist(ctx: Ctx, e: int) -> void {
    let k: str = ctx.exprs[e].kind
    if k == "int" || k == "float" || k == "bool" || k == "str" || k == "ident" {
        return
    }
    if k == "un" || k == "index" || k == "field" {
        hoist_child(ctx, ctx.exprs[e].left)
        if k == "index" {
            hoist_child(ctx, ctx.exprs[e].right)
        }
        return
    }
    if k == "bin" {
        # BUGFIX (v0.36.0-alpha, found via the Stage 20 LTO work): the
        # RIGHT operand of &&/|| must NOT be hoisted to statement level.
        # HLS evaluates &&/|| lazily (the interpreter short-circuits);
        # hoisting fresh subexpressions out of the right operand makes
        # the native build evaluate them EAGERLY — a slice or call that
        # the interpreter never runs can panic in the native binary
        # (observed: `k.len() >= 2 && k.slice(0, 2) == "b:"` panicking
        # "invalid string slice" on 1-char keys). gen_bin now scopes the
        # right operand's fresh subexpressions inside a GCC statement
        # expression at the operand position itself, preserving both
        # the laziness and the cleanup discipline.
        if ctx.exprs[e].op == "&&" || ctx.exprs[e].op == "||" {
            hoist_child(ctx, ctx.exprs[e].left)
            return
        }
        hoist_child(ctx, ctx.exprs[e].left)
        hoist_child(ctx, ctx.exprs[e].right)
        return
    }
    if k == "listlit" || k == "structlit" || k == "enumlit" {
        # Elements/fields are transferred into the container — recurse
        # into their subexpressions only.
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            collect_hoist(ctx, ctx.exprs[e].args.get(i))
            i = i + 1
        }
        return
    }
    if k == "mapnew" || k == "match" || k == "qmark" {
        # match/qmark manage their scrutinee/inner ownership internally;
        # still recurse so fresh-borrowed subexpressions get hoisted.
        # NOTE: arm BODIES are NOT walked here — they may reference the
        # match's pattern bindings, which only exist inside the statement
        # expression. gen_match_expr performs arm-local hoisting instead.
        if k == "match" {
            collect_hoist(ctx, ctx.exprs[e].left)
        } else {
            collect_hoist(ctx, ctx.exprs[e].left)
        }
        return
    }
    if k == "call" {
        if ctx.exprs[e].muser {
            let cf: FnInfo = ctx.fns.get_or(ctx.exprs[e].mkey, dummy_fn())
            let mut i: int = 0
            while i < ctx.exprs[e].args.len() {
                if cf.is_extern {
                    # Extern args are borrowed (the C callee knows
                    # nothing about refcounts).
                    hoist_child(ctx, ctx.exprs[e].args.get(i))
                } else {
                    collect_hoist(ctx, ctx.exprs[e].args.get(i))
                }
                i = i + 1
            }
            return
        }
        let name: str = ctx.exprs[e].mkey
        let mut j: int = 0
        while j < ctx.exprs[e].args.len() {
            let aidx: int = ctx.exprs[e].args.get(j)
            if builtin_arg_borrowed(name) {
                hoist_child(ctx, aidx)
            } else {
                collect_hoist(ctx, aidx)
            }
            j = j + 1
        }
        return
    }
    if k == "method" {
        # Builtin method receivers are borrowed (even push/set: the
        # receiver list is mutated, not stored into). User method
        # receivers are transferred (the self param owns one retain).
        if ctx.exprs[e].muser {
            collect_hoist(ctx, ctx.exprs[e].left)
        } else {
            hoist_child(ctx, ctx.exprs[e].left)
        }
        let op: str = ctx.exprs[e].mop
        let mut i: int = 0
        while i < ctx.exprs[e].args.len() {
            let aidx: int = ctx.exprs[e].args.get(i)
            if method_arg_borrowed(op, i) {
                hoist_child(ctx, aidx)
            } else {
                collect_hoist(ctx, aidx)
            }
            i = i + 1
        }
        return
    }
}

# hoist_child: hoist child `c` if it is a fresh pointer value, otherwise
# recurse into it. When hoisting, the node's OWN fresh children (in
# borrowed positions) must be reserved FIRST — they are declared as
# temps before the parent's temp, because the parent's initializer
# expression references them. (HLS maps preserve insertion order, so the
# reservation order in hoist_map is the declaration order.)
fn hoist_child(ctx: Ctx, c: int) -> void {
    if c < 0 {
        return
    }
    let ck: str = c.to_str()
    if is_ptr_t(ctx, ctx.exprs[c].t) && expr_fresh(ctx, c) && !ctx.hoist_map.has(ck) {
        # Reserve the node's children first (declaration order).
        collect_hoist(ctx, c)
        ctx.hoist_map.set(ck, "")
        # Reserved with an empty temp name; hoist_all fills it in.
        return
    }
    collect_hoist(ctx, c)
}

# builtin_arg_borrowed: True when a builtin consumes its argument as a
# borrow (no ownership transfer). Consume builtins (print family, I/O)
# and identity builtins (str, taint_mark) transfer or pass through.
# Stage 9 release (v0.20.0-alpha): net_lookup and proc_exec ALSO consume
# their argument (they call hl_str_release on the host/cmd at the end).
# If this returns true for them, the codegen hoists a fresh-expression
# argument (e.g. `cmd + " " + ip`) into a temporary with cleanup, passes
# the temporary directly to the builtin, and the cleanup releases it
# AGAIN after the builtin has already released it → double-free.
fn builtin_arg_borrowed(name: str) -> bool {
    if name == "println" || name == "print" || name == "panic" || name == "exit" {
        return false
    }
    if name == "write_file" || name == "read_file" || name == "read_file_tainted" {
        return false
    }
    if name == "file_exists" {
        return false
    }
    if name == "str" || name == "taint_mark" || name == "taint_unwrap" {
        return false
    }
    # Stage 9 release: net_lookup and proc_exec consume their argument
    # (the C runtime releases the host/cmd after using it). Without this,
    # `proc_exec(cmd + " " + ip)` would crash with "malloc(): unaligned
    # tcache chunk detected" (double-free of the concat result).
    if name == "net_lookup" || name == "proc_exec" {
        return false
    }
    # Stage 16 (v0.27.0-alpha): spawn TRANSFERS each argument into the
    # task's argbox (ownership crosses the thread boundary). Without
    # this, a fresh argument like clone(ch) was hoisted into a temp WITH
    # a cleanup attribute — the temp's scope-exit release then fought
    # the task's own release of the same retain (double-free /
    # use-after-free on the channel).
    if name == "spawn" {
        return false
    }
    # clone, len, int, float, and the rest borrow their arguments.
    return true
}

# method_arg_borrowed: True when a builtin method consumes argument `i`
# as a borrow. Values stored into containers (push/set/map.set) and
# pointer-valued get_or defaults are transferred.
fn method_arg_borrowed(op: str, i: int) -> bool {
    if op == "list.push" || op == "list.set" {
        return false
    }
    if op == "map.set" {
        return false
    }
    if op == "map.get_or" {
        # The KEY is borrowed; the DEFAULT is transferred (owned) for
        # pointer-valued maps — but primitive defaults pass by value.
        return i == 0
    }
    # Stage 16: ch.send(v) TRANSFERS the message into the channel's
    # queue (the channel owns it). Hoisting a fresh v into a temp with
    # a cleanup would release it again after the transfer. The same
    # holds for try_send (v0.29.0-alpha): on success the queue owns the
    # copy; on failure the runtime releases it.
    if op == "chan.send" || op == "chan.try_send" {
        return false
    }
    # v0.29.0-alpha: ch.recv_or(default) — the runtime consumes the
    # default either way: it is returned owned to the caller, or it is
    # released via elem_release when a message was available. Hoisting
    # it into a temp WITH a cleanup attribute double-releases it.
    if op == "chan.recv_or" {
        return false
    }
    return true
}

# hoist_all: materialise every node reserved by collect_hoist into a
# temp declaration with a cleanup attribute, registered in hoist_map.
# The declarations are appended to `dst` at the given indentation —
# ctx.out for statement-level hoists, or a match arm's local block
# for arm-local hoists (pattern bindings only exist there).
fn hoist_all(ctx: Ctx, dst: list[str], ind: str) -> void {
    let keys: list[str] = ctx.hoist_map.keys()
    let mut i: int = 0
    while i < keys.len() {
        let key: str = keys.get(i)
        if ctx.hoist_map.get_or(key, "") != "" {
            # Already materialised (nested collect pass) — skip.
            i = i + 1
            continue
        }
        let e: int = key.to_int()
        let tmp: str = fresh_tmp(ctx, "hlc_h")
        let t: str = inst_t(ctx, ctx.exprs[e].t)
        let v: str = gen_expr(ctx, e)
        dst.push(ind + c_type(ctx, t) + " " + tmp
            + " __attribute__((cleanup(" + cleanup_fn_for(ctx, t) + "))) = " + v + ";")
        ctx.hoist_map.set(key, tmp)
        i = i + 1
    }
}

# clear_hoists: drop hoist registrations at the end of a statement (the
# temps have been declared; the expression tree is not revisited).
fn clear_hoists(ctx: Ctx) -> void {
    ctx.hoist_map = map_new()
}

# gen_own_arg: generate one argument, own-wrapped for pointer types —
# used at user fn / user method / consume-builtin call sites.
fn gen_own_arg(ctx: Ctx, aidx: int) -> str {
    let t: str = ctx.exprs[aidx].t
    let fresh: bool = expr_fresh(ctx, aidx)
    let c: str = gen_expr(ctx, aidx)
    return own_wrap(ctx, t, c, fresh)
}

# gen_own_args_c: own-wrap every argument of a call.
fn gen_own_args_c(ctx: Ctx, e: int) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        parts.push(gen_own_arg(ctx, ctx.exprs[e].args.get(i)))
        i = i + 1
    }
    return join(parts, ", ")
}

# --- C expression generation ---

# ============================================================================
# STAGE 19 (v0.35.0-alpha): PROFILE-GUIDED OPTIMISATION helpers
# ----------------------------------------------------------------------------
# Two codegen modes:
#   --pgo-generate   every fn entry / branch / loop back-edge gets a counter
#                    increment; counters are dumped to a .hlcprof file at
#                    process exit (registered via atexit in main()).
#   --pgo-use=F      the profile F (produced above) steers codegen:
#                      * __builtin_expect hints on biased branches/loops
#                      * __attribute__((hot))/((cold)) on function signatures
#                      * `static inline` on hot, small functions
#                    Site ids are deterministic (same source => same ids in
#                    both modes), so a profile from build A trains build B.
# ============================================================================

# pgo_site: assign (or reuse) the counter index for a profile site id.
# The id is appended to ctx.pgo_site_ids on FIRST assignment; the index
# is its position. Ids must be assigned in IDENTICAL order in
# --pgo-generate and --pgo-use builds (they are: the codegen walk is
# deterministic). When NO PGO mode is active the call is a no-op —
# plain builds pay zero instrumentation cost.
fn pgo_site(ctx: Ctx, id: str) -> int {
    if !ctx.pgo_gen && !pgo_has_profile(ctx) {
        return 0
    }
    if ctx.pgo_site_map.has(id) {
        return ctx.pgo_site_map.get_or(id, 0)
    }
    ctx.pgo_site_ids.push(id)
    let idx: int = ctx.pgo_site_ids.len() - 1
    ctx.pgo_site_map.set(id, idx)
    return idx
}

# PGO_MAX_SITES: the fixed counter array size in the generated C. hlc
# refuses to instrument programs with more profile sites than this.
fn PGO_MAX_SITES() -> int {
    return 65536
}

# pgo_load_profile: parse a .hlcprof file (one "<site_id> <count>" pair
# per line) into ctx.pgo_counts. Returns an error message or "" on
# success. The format is deliberately line-based plain text: portable,
# diffable, and debuggable.
fn pgo_load_profile(ctx: Ctx, content: str) -> str {
    let mut i: int = 0
    let n: int = content.len()
    let mut sites: int = 0
    while i < n {
        # id = bytes up to the first space (32).
        let id_start: int = i
        while i < n && content.byte_at(i) != 32 && content.byte_at(i) != 10 {
            i = i + 1
        }
        let id: str = content.slice(id_start, i)
        if id.len() == 0 {
            if i < n && content.byte_at(i) == 10 {
                i = i + 1
            }
            continue
        }
        if i >= n || content.byte_at(i) != 32 {
            return "malformed profile line (no count) near offset " + i.to_str()
        }
        # skip spaces.
        while i < n && content.byte_at(i) == 32 {
            i = i + 1
        }
        let num_start: int = i
        while i < n && content.byte_at(i) >= 48 && content.byte_at(i) <= 57 {
            i = i + 1
        }
        if num_start == i {
            return "malformed profile count for site '" + id + "'"
        }
        let count: int = int(content.slice(num_start, i))
        ctx.pgo_counts.set(id, count)
        sites = sites + 1
        # skip to end of line.
        while i < n && content.byte_at(i) != 10 {
            i = i + 1
        }
        if i < n {
            i = i + 1
        }
    }
    if sites == 0 {
        return "profile contains no sites"
    }
    # Total calls = sum of all function-entry counts ("e:<fnkey>").
    let keys: list[str] = ctx.pgo_counts.keys()
    let mut total: int = 0
    let mut ki: int = 0
    while ki < keys.len() {
        let k: str = keys.get(ki)
        if k.len() > 2 && k.slice(0, 2) == "e:" {
            total = total + ctx.pgo_counts.get_or(k, 0)
        }
        ki = ki + 1
    }
    ctx.pgo_total_calls = total
    return ""
}

# pgo_site_count: the profile count for a site id (0 when absent).
fn pgo_site_count(ctx: Ctx, id: str) -> int {
    return ctx.pgo_counts.get_or(id, 0)
}

# pgo_has_profile: is a --pgo-use profile loaded?
fn pgo_has_profile(ctx: Ctx) -> bool {
    return ctx.pgo_counts.keys().len() > 0
}

# pgo_branch_hint: expected value for an if-condition's
# __builtin_expect, or -1 when no hint should be emitted.
# Bias thresholds: >= 90% taken -> expect 1; <= 10% taken -> expect 0.
fn pgo_branch_hint(ctx: Ctx, true_id: str, false_id: str) -> int {
    if !pgo_has_profile(ctx) {
        return -1
    }
    let t: int = pgo_site_count(ctx, true_id)
    let f: int = pgo_site_count(ctx, false_id)
    let total: int = t + f
    if total <= 0 {
        return -1
    }
    if t * 10 >= total * 9 {
        return 1
    }
    if t * 10 <= total {
        return 0
    }
    return -1
}

# pgo_loop_hint: expected value for a loop condition (or -1 for no hint).
# A loop that never iterated in the profile is likely dead -> expect 0;
# one that iterated -> expect 1 (the common case keeps the body hot).
fn pgo_loop_hint(ctx: Ctx, backedge_id: str) -> int {
    if !pgo_has_profile(ctx) {
        return -1
    }
    if pgo_site_count(ctx, backedge_id) <= 0 {
        return 0
    }
    return 1
}

# pgo_wrap_expect: wrap a C condition expression with __builtin_expect.
fn pgo_wrap_expect(cond: str, expected: int) -> str {
    return "__builtin_expect((" + cond + "), " + expected.to_str() + ")"
}

# pgo_fn_is_hot: is this function hot per the loaded profile?
# Hot = at least 1000 entries AND at least 2% of all function entries.
fn pgo_fn_is_hot(ctx: Ctx, key: str) -> bool {
    if !pgo_has_profile(ctx) || ctx.pgo_total_calls <= 0 {
        return false
    }
    let c: int = pgo_site_count(ctx, "e:" + key)
    if c < 1000 {
        return false
    }
    return c * 50 >= ctx.pgo_total_calls
}

# pgo_fn_is_cold: the function was never called in the profile.
fn pgo_fn_is_cold(ctx: Ctx, key: str) -> bool {
    if !pgo_has_profile(ctx) {
        return false
    }
    return pgo_site_count(ctx, "e:" + key) == 0
}

# pgo_fn_attr: the C attribute prefix for a function signature under
# --pgo-use ("" when none).
fn pgo_fn_attr(ctx: Ctx, key: str) -> str {
    if pgo_fn_is_hot(ctx, key) {
        return "__attribute__((hot)) "
    }
    if pgo_fn_is_cold(ctx, key) {
        return "__attribute__((cold)) "
    }
    return ""
}

# pgo_fn_inline: should this function get the `static inline` hint?
# True when the profile marks it hot AND its emitted body is small
# (<= 40 lines) — the per-call-site inlining threshold, realised as a
# hint gcc honours at every call site of the function.
fn pgo_fn_inline(ctx: Ctx, key: str) -> bool {
    if !pgo_fn_is_hot(ctx, key) {
        return false
    }
    if !ctx.pgo_fn_sizes.has(key) {
        return false
    }
    return ctx.pgo_fn_sizes.get_or(key, 0) <= 40
}

# ============================================================================
# STAGE 28 (v0.45.0-alpha): function attribute prefixes
# ----------------------------------------------------------------------------
# fn_attr_prefix(ctx, f) returns the C attribute prefix to attach to a
# function signature. For Stage 28 this is ONLY the frame-layout
# attributes (#[no_red_zone], #[irq_handler]). The PGO hot/cold
# annotation logic (pgo_fn_attr / pgo_fn_inline) is preserved verbatim
# from Stage 19 — Stage 28 does NOT yet override PGO with user attrs
# (that's Stage 29's job).
#
# The caller writes:
#     out.push(fn_attr_prefix(ctx, f, key) + sig + " {")
#
# For prototypes, use fn_attr_prefix the same way.
# ============================================================================

# fn_frame_attr: Stage 28 stack-frame attributes. Always emitted —
# when the host C compiler does not support a given attribute (e.g.
# clang on a non-x86-64 host rejecting `target("no-red-zone")`), it
# emits a warning that the user can suppress with -Wno-attributes.
#
# `irq_handler` automatically disables the x86-64 red zone for that
# function (gcc emits IRETQ semantics which forbid red-zone use); the
# separate `no_red_zone` attribute is for the case where a function
# is NOT an interrupt handler but still wants to be red-zone-free (e.g.
# a signal handler trampoline).
fn fn_frame_attr(ctx: Ctx, f: FnInfo) -> str {
    let mut s: str = ""
    if f.attr_no_red_zone && !f.attr_irq_handler {
        # x86-64 System V ABI reserves a 128-byte "red zone" below RSP
        # that leaf functions may use without decrementing RSP. The
        # CPU may push an exception / interrupt frame at any point
        # inside the red zone, corrupting it. gcc's `optimize`
        # attribute accepts `no-red-zone` and disables it for this
        # function. (`target("no-red-zone")` is NOT a recognised
        # target attribute on x86-64; `optimize("no-red-zone")` is
        # the correct syntax.) gcc emits a `-Wattributes` warning
        # that the attribute "may be ineffective" — this is a
        # limitation of gcc's per-function optimise-attribute
        # machinery; the actual codegen DOES apply the flag. The
        # acceptance gate compiles with -Wno-attributes.
        s = s + "__attribute__((optimize(\"no-red-zone\"))) "
    }
    if f.attr_irq_handler {
        # gcc's `interrupt` attribute on x86-64 makes the function
        # save+restore every caller-saved register (RAX, RCX, RDX, RSI,
        # RDI, R8-R11 + XMM0-15) and return via IRETQ instead of RET.
        # It also implicitly disables the red zone (the IRETQ frame
        # could be corrupted by a red-zone write). The fn must take a
        # single POINTER parameter (the saved frame pointer; gcc
        # populates it from the RSP at the interrupt entry) and return
        # void. The Stage 28 checker validates this signature.
        s = s + "__attribute__((interrupt)) "
    }
    return s
}

# fn_attr_prefix: the combined C attribute prefix for a function
# signature (PGO hot/cold + static-inline hint + Stage 28 frame attrs).
# Used by gen_fn_body, gen_proto_lines, and gen_fn_inst_lines.
#
# Stage 28: the prefix is PGO annotations (Stage 19, unchanged) +
# Stage 28 frame attributes. Stage 29 (next commit) will add the
# inline/hot/cold user-attribute overrides on top of this.
fn fn_attr_prefix(ctx: Ctx, f: FnInfo, key: str) -> str {
    let mut p: str = ""
    # Stage 19 (v0.35.0-alpha): PGO hot/cold annotation + static
    # inline hint (unchanged from Stage 19 / 20).
    if pgo_fn_inline(ctx, key) {
        p = p + "static inline "
    }
    p = p + pgo_fn_attr(ctx, key)
    # Stage 28: frame layout attributes.
    p = p + fn_frame_attr(ctx, f)
    return p
}

# ============================================================================
# STAGE 21 (v0.37.0-alpha): SIMD INTRINSIC FAST PATHS (--target-feature)
# ----------------------------------------------------------------------------
# Under --target-feature sse4.2|avx2, calls to the std.simd kernels
# (matched by name AND argument types, so user-defined functions with
# different signatures are never hijacked) are redirected to C helpers
# with per-function target attributes using native vector intrinsics —
# identical semantics to the portable HLS implementation (per-lane
# wrapping arithmetic, range-checked lane entry, 4-wide gather/scatter
# bounds checks). Programs compiled without the flag, or for an
# architecture without matching intrinsics, use the scalar C fallback
# (still much faster than the bit-by-bit portable HLS path).
# NEON (aarch64) intrinsic tuning is Stage 25 ("AArch64 backend tuning").
# ============================================================================

# simd_redirectable: does this call site look like the std.simd kernel?
# Name match AND argument-type match (the flat namespace convention:
# std.simd owns the simd_* prefix; a user fn with a different signature
# is never redirected).
fn simd_redirectable(ctx: Ctx, name: str, e: int) -> bool {
    if name == "simd_i32x4_add" || name == "simd_i32x4_sub" || name == "simd_i32x4_mul"
        || name == "simd_i32x4_min" || name == "simd_i32x4_max" {
        return ctx.exprs[e].args.len() == 2
            && ctx.exprs[ctx.exprs[e].args.get(0)].t == "I32x4"
            && ctx.exprs[ctx.exprs[e].args.get(1)].t == "I32x4"
    }
    if name == "simd_f64x2_add" || name == "simd_f64x2_sub" || name == "simd_f64x2_mul" {
        return ctx.exprs[e].args.len() == 2
            && ctx.exprs[ctx.exprs[e].args.get(0)].t == "F64x2"
            && ctx.exprs[ctx.exprs[e].args.get(1)].t == "F64x2"
    }
    if name == "simd_i32x4_gather" {
        return ctx.exprs[e].args.len() == 2
            && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[int]"
            && ctx.exprs[ctx.exprs[e].args.get(1)].t == "int"
    }
    if name == "simd_f64x2_gather" {
        return ctx.exprs[e].args.len() == 2
            && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[float]"
            && ctx.exprs[ctx.exprs[e].args.get(1)].t == "int"
    }
    if name == "simd_correlate8_sum_i32x4" {
        return ctx.exprs[e].args.len() == 9
            && ctx.exprs[e].t == "int"
            && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[int]"
    }
    if name == "simd_transform_sum_i32x4" {
        return ctx.exprs[e].args.len() == 4
            && ctx.exprs[e].t == "int"
            && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[int]"
            && ctx.exprs[ctx.exprs[e].args.get(1)].t == "list[int]"
            && ctx.exprs[ctx.exprs[e].args.get(2)].t == "int"
            && ctx.exprs[ctx.exprs[e].args.get(3)].t == "int"
    }
    if name == "simd_i32x4_scatter" {
        return ctx.exprs[e].args.len() == 3
            && ctx.exprs[e].t == "void"
            && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[int]"
            && ctx.exprs[ctx.exprs[e].args.get(1)].t == "int"
            && ctx.exprs[ctx.exprs[e].args.get(2)].t == "I32x4"
    }
    if name == "simd_f64x2_scatter" {
        return ctx.exprs[e].args.len() == 3
            && ctx.exprs[e].t == "void"
            && ctx.exprs[ctx.exprs[e].args.get(0)].t == "list[float]"
            && ctx.exprs[ctx.exprs[e].args.get(1)].t == "int"
            && ctx.exprs[ctx.exprs[e].args.get(2)].t == "F64x2"
    }
    return false
}

# simd_try_redirect: if the call matches a kernel, register (once) the
# intrinsic helper and return the C call expression ("" = no redirect).
fn simd_try_redirect(ctx: Ctx, name: str, e: int) -> str {
    if !simd_redirectable(ctx, name, e) {
        return ""
    }
    let helper: str = "hl_" + name
    if !list_has(ctx.simd_helper_names, helper) {
        ctx.simd_helper_names.push(helper)
        simd_emit_helper(ctx, name)
    }
    return helper + "(" + gen_own_args_c(ctx, e) + ")"
}

# simd_emit_i32x4_ew: one elementwise i32x4 kernel — intrinsic body into
# simd_helpers_main, scalar body into simd_helpers_alt.
fn simd_emit_i32x4_ew(ctx: Ctx, name: str, intrinsic: str) -> void {
    let m: list[str] = ctx.simd_helpers_main
    let a: list[str] = ctx.simd_helpers_alt
    m.push("/* " + name + " */")
    m.push("__attribute__((target(\"" + ctx.target_feature + "\"))) static I32x4* hl_" + name + "(I32x4* x_p, I32x4* y_p) {")
    m.push("    I32x4* x = x_p;")
    m.push("    I32x4* y = y_p;")
    m.push("    I32x4* r = usf_new_I32x4(0, 0);")
    m.push("    __m128i va = _mm_set_epi64x(x->b, x->a);")
    m.push("    __m128i vb = _mm_set_epi64x(y->b, y->a);")
    m.push("    __m128i c = " + intrinsic + "(va, vb);")
    m.push("    r->a = _mm_cvtsi128_si64(c);")
    m.push("    r->b = _mm_cvtsi128_si64(_mm_unpackhi_epi64(c, c));")
    m.push("    hl_release_I32x4(x);")
    m.push("    hl_release_I32x4(y);")
    m.push("    return r;")
    m.push("}")
    a.push("/* " + name + " (scalar fallback) */")
    a.push("static I32x4* hl_" + name + "(I32x4* x_p, I32x4* y_p) {")
    a.push("    I32x4* x = x_p; I32x4* y = y_p;")
    a.push("    I32x4* r = usf_new_I32x4(0, 0);")
    a.push("    int32_t la[4] = { (int32_t)(uint32_t)x->a, (int32_t)(uint32_t)(x->a >> 32),")
    a.push("                       (int32_t)(uint32_t)x->b, (int32_t)(uint32_t)(x->b >> 32) };")
    a.push("    int32_t lb[4] = { (int32_t)(uint32_t)y->a, (int32_t)(uint32_t)(y->a >> 32),")
    a.push("                       (int32_t)(uint32_t)y->b, (int32_t)(uint32_t)(y->b >> 32) };")
    if name == "simd_i32x4_min" {
        a.push("    int32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = la[k] < lb[k] ? la[k] : lb[k];")
    } else if name == "simd_i32x4_max" {
        a.push("    int32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = la[k] > lb[k] ? la[k] : lb[k];")
    } else {
        let mut c_op: str = "+"
        if name == "simd_i32x4_sub" {
            c_op = "-"
        } else if name == "simd_i32x4_mul" {
            c_op = "*"
        }
        a.push("    uint32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = (uint32_t)((uint64_t)(uint32_t)la[k] " + c_op + " (uint64_t)(uint32_t)lb[k]);")
    }
    a.push("    r->a = (int64_t)((uint64_t)(uint32_t)lr[0] | ((uint64_t)(uint32_t)lr[1] << 32));")
    a.push("    r->b = (int64_t)((uint64_t)(uint32_t)lr[2] | ((uint64_t)(uint32_t)lr[3] << 32));")
    a.push("    hl_release_I32x4(x); hl_release_I32x4(y);")
    a.push("    return r;")
    a.push("}")
}

# simd_emit_f64x2_ew: one elementwise f64x2 kernel.
fn simd_emit_f64x2_ew(ctx: Ctx, name: str, intrinsic: str) -> void {
    let m: list[str] = ctx.simd_helpers_main
    let a: list[str] = ctx.simd_helpers_alt
    let mut c_op: str = "+"
    if name == "simd_f64x2_sub" {
        c_op = "-"
    } else if name == "simd_f64x2_mul" {
        c_op = "*"
    }
    m.push("/* " + name + " */")
    m.push("__attribute__((target(\"" + ctx.target_feature + "\"))) static F64x2* hl_" + name + "(F64x2* x_p, F64x2* y_p) {")
    m.push("    F64x2* x = x_p; F64x2* y = y_p;")
    m.push("    F64x2* r = usf_new_F64x2(0.0, 0.0);")
    m.push("    __m128d va = _mm_loadu_pd(&x->a);")
    m.push("    __m128d vb = _mm_loadu_pd(&y->a);")
    m.push("    __m128d c = " + intrinsic + "(va, vb);")
    m.push("    _mm_storeu_pd(&r->a, c);")
    m.push("    hl_release_F64x2(x); hl_release_F64x2(y);")
    m.push("    return r;")
    m.push("}")
    a.push("/* " + name + " (scalar fallback) */")
    a.push("static F64x2* hl_" + name + "(F64x2* x_p, F64x2* y_p) {")
    a.push("    F64x2* x = x_p; F64x2* y = y_p;")
    a.push("    F64x2* r = usf_new_F64x2(0.0, 0.0);")
    a.push("    r->a = x->a " + c_op + " y->a;")
    a.push("    r->b = x->b " + c_op + " y->b;")
    a.push("    hl_release_F64x2(x); hl_release_F64x2(y);")
    a.push("    return r;")
    a.push("}")
}

# ============================================================================
# STAGE 25 (v0.44.0-alpha): AArch64 NEON INTRINSIC FAST PATHS
# ----------------------------------------------------------------------------
# Mirror of the x86 SSE emitter above, but using <arm_neon.h> intrinsics.
# Emitted into simd_helpers_neon; assembled by simd_helper_lines into the
# #elif defined(__aarch64__) || defined(__ARM_NEON__) branch. The same
# scalar fallback (simd_helpers_alt) is used for non-NEON hosts.
#
# NEON intrinsic reference (ARMv8-A):
#   i32x4 add/sub/mul/min/max: vaddq_s32 / vsubq_s32 / vmulq_s32 /
#                              vminq_s32 / vmaxq_s32
#   f64x2 add/sub/mul:         vaddq_f64 / vsubq_f64 / vmulq_f64
#
# The NEON intrinsics take int32x4_t / float64x2_t arguments directly
# (not pointers); we load from the HLS struct's two i64 / f64 fields via
# vld1q_s64 / vld1q_f64 and store back via vst1q_s64 / vst1q_f64. The
# I32x4 struct stores {int64_t a, int64_t b} — a 128-bit value that
# maps directly to a NEON int32x4_t register.
# ============================================================================

# simd_emit_neon_i32x4_ew: one elementwise i32x4 kernel using NEON
# intrinsics. The intrinsic name (e.g. "vaddq_s32") is passed in;
# the body loads x and y from their {i64 a, i64 b} layout into
# int32x4_t registers, applies the intrinsic, and stores the result
# back into a fresh I32x4 struct.
fn simd_emit_neon_i32x4_ew(ctx: Ctx, name: str, intrinsic: str) -> void {
    let m: list[str] = ctx.simd_helpers_neon
    let a: list[str] = ctx.simd_helpers_alt
    m.push("/* " + name + " (NEON) */")
    m.push("static I32x4* hl_" + name + "(I32x4* x_p, I32x4* y_p) {")
    m.push("    I32x4* x = x_p; I32x4* y = y_p;")
    m.push("    I32x4* r = usf_new_I32x4(0, 0);")
    # Load {i64 a, i64 b} into a 128-bit NEON register. The layout is
    # little-endian: lane 0 = low 32 bits of a, lane 1 = high 32 bits
    # of a, lane 2 = low 32 bits of b, lane 3 = high 32 bits of b.
    # vreinterpretq_s32_s64 reinterprets the int64x2_t as int32x4_t.
    m.push("    int64x2_t va = vld1q_s64((const int64_t*)&x->a);")
    m.push("    int64x2_t vb = vld1q_s64((const int64_t*)&y->a);")
    m.push("    int32x4_t va32 = vreinterpretq_s32_s64(va);")
    m.push("    int32x4_t vb32 = vreinterpretq_s32_s64(vb);")
    m.push("    int32x4_t c = " + intrinsic + "(va32, vb32);")
    m.push("    int64x2_t c64 = vreinterpretq_s64_s32(c);")
    m.push("    vst1q_s64((int64_t*)&r->a, c64);")
    m.push("    hl_release_I32x4(x); hl_release_I32x4(y);")
    m.push("    return r;")
    m.push("}")
    a.push("/* " + name + " (scalar fallback) */")
    a.push("static I32x4* hl_" + name + "(I32x4* x_p, I32x4* y_p) {")
    a.push("    I32x4* x = x_p; I32x4* y = y_p;")
    a.push("    I32x4* r = usf_new_I32x4(0, 0);")
    a.push("    int32_t la[4] = { (int32_t)(uint32_t)x->a, (int32_t)(uint32_t)(x->a >> 32),")
    a.push("                       (int32_t)(uint32_t)x->b, (int32_t)(uint32_t)(x->b >> 32) };")
    a.push("    int32_t lb[4] = { (int32_t)(uint32_t)y->a, (int32_t)(uint32_t)(y->a >> 32),")
    a.push("                       (int32_t)(uint32_t)y->b, (int32_t)(uint32_t)(y->b >> 32) };")
    if name == "simd_i32x4_min" {
        a.push("    int32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = la[k] < lb[k] ? la[k] : lb[k];")
    } else if name == "simd_i32x4_max" {
        a.push("    int32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = la[k] > lb[k] ? la[k] : lb[k];")
    } else {
        let mut c_op: str = "+"
        if name == "simd_i32x4_sub" {
            c_op = "-"
        } else if name == "simd_i32x4_mul" {
            c_op = "*"
        }
        a.push("    uint32_t lr[4];")
        a.push("    for (int k = 0; k < 4; k++) lr[k] = (uint32_t)((uint64_t)(uint32_t)la[k] " + c_op + " (uint64_t)(uint32_t)lb[k]);")
    }
    a.push("    r->a = (int64_t)((uint64_t)(uint32_t)lr[0] | ((uint64_t)(uint32_t)lr[1] << 32));")
    a.push("    r->b = (int64_t)((uint64_t)(uint32_t)lr[2] | ((uint64_t)(uint32_t)lr[3] << 32));")
    a.push("    hl_release_I32x4(x); hl_release_I32x4(y);")
    a.push("    return r;")
    a.push("}")
}

# simd_emit_neon_f64x2_ew: one elementwise f64x2 kernel using NEON.
fn simd_emit_neon_f64x2_ew(ctx: Ctx, name: str, intrinsic: str) -> void {
    let m: list[str] = ctx.simd_helpers_neon
    let a: list[str] = ctx.simd_helpers_alt
    let mut c_op: str = "+"
    if name == "simd_f64x2_sub" {
        c_op = "-"
    } else if name == "simd_f64x2_mul" {
        c_op = "*"
    }
    m.push("/* " + name + " (NEON) */")
    m.push("static F64x2* hl_" + name + "(F64x2* x_p, F64x2* y_p) {")
    m.push("    F64x2* x = x_p; F64x2* y = y_p;")
    m.push("    F64x2* r = usf_new_F64x2(0.0, 0.0);")
    m.push("    float64x2_t va = vld1q_f64((const double*)&x->a);")
    m.push("    float64x2_t vb = vld1q_f64((const double*)&y->a);")
    m.push("    float64x2_t c = " + intrinsic + "(va, vb);")
    m.push("    vst1q_f64((double*)&r->a, c);")
    m.push("    hl_release_F64x2(x); hl_release_F64x2(y);")
    m.push("    return r;")
    m.push("}")
    a.push("/* " + name + " (scalar fallback) */")
    a.push("static F64x2* hl_" + name + "(F64x2* x_p, F64x2* y_p) {")
    a.push("    F64x2* x = x_p; F64x2* y = y_p;")
    a.push("    F64x2* r = usf_new_F64x2(0.0, 0.0);")
    a.push("    r->a = x->a " + c_op + " y->a;")
    a.push("    r->b = x->b " + c_op + " y->b;")
    a.push("    hl_release_F64x2(x); hl_release_F64x2(y);")
    a.push("    return r;")
    a.push("}")
}

# simd_emit_helper: dispatch one kernel into the main/alt lists. The
# gather/scatter kernels are arch-independent (plain C field work — the
# win is eliminating the per-element runtime calls), so they go into
# BOTH lists (guarded only by the #if/#else split for tidiness).
fn simd_emit_helper(ctx: Ctx, name: str) -> void {
    # Stage 25 (v0.44.0-alpha): when --target-feature neon is given,
    # dispatch to the NEON emitter (which pushes into simd_helpers_neon
    # + simd_helpers_alt). Otherwise dispatch to the x86 emitter (which
    # pushes into simd_helpers_main + simd_helpers_alt).
    let use_neon: bool = ctx.target_feature == "neon"
    if name == "simd_i32x4_add" {
        if use_neon {
            simd_emit_neon_i32x4_ew(ctx, name, "vaddq_s32")
        } else {
            simd_emit_i32x4_ew(ctx, name, "_mm_add_epi32")
        }
        return
    }
    if name == "simd_i32x4_sub" {
        if use_neon {
            simd_emit_neon_i32x4_ew(ctx, name, "vsubq_s32")
        } else {
            simd_emit_i32x4_ew(ctx, name, "_mm_sub_epi32")
        }
        return
    }
    if name == "simd_i32x4_mul" {
        if use_neon {
            simd_emit_neon_i32x4_ew(ctx, name, "vmulq_s32")
        } else {
            simd_emit_i32x4_ew(ctx, name, "_mm_mullo_epi32")
        }
        return
    }
    if name == "simd_i32x4_min" {
        if use_neon {
            simd_emit_neon_i32x4_ew(ctx, name, "vminq_s32")
        } else {
            simd_emit_i32x4_ew(ctx, name, "_mm_min_epi32")
        }
        return
    }
    if name == "simd_i32x4_max" {
        if use_neon {
            simd_emit_neon_i32x4_ew(ctx, name, "vmaxq_s32")
        } else {
            simd_emit_i32x4_ew(ctx, name, "_mm_max_epi32")
        }
        return
    }
    if name == "simd_f64x2_add" {
        if use_neon {
            simd_emit_neon_f64x2_ew(ctx, name, "vaddq_f64")
        } else {
            simd_emit_f64x2_ew(ctx, name, "_mm_add_pd")
        }
        return
    }
    if name == "simd_f64x2_sub" {
        if use_neon {
            simd_emit_neon_f64x2_ew(ctx, name, "vsubq_f64")
        } else {
            simd_emit_f64x2_ew(ctx, name, "_mm_sub_pd")
        }
        return
    }
    if name == "simd_f64x2_mul" {
        if use_neon {
            simd_emit_neon_f64x2_ew(ctx, name, "vmulq_f64")
        } else {
            simd_emit_f64x2_ew(ctx, name, "_mm_mul_pd")
        }
        return
    }
    if name == "simd_i32x4_gather" {
        let b: list[str] = ctx.simd_helpers_plain
        b.push("/* " + name + " */")
        b.push("static I32x4* hl_" + name + "(hl_list* xs_p, int64_t i) {")
        b.push("    hl_list* xs = xs_p;")
        b.push("    if (i < 0 || i + 4 > xs->len) hl_die(\"simd gather out of bounds\");")
        b.push("    int64_t v[4];")
        b.push("    for (int k = 0; k < 4; k++) {")
        b.push("        v[k] = hl_unbox_i64(xs->items[i + k]);")
        b.push("        if (v[k] < INT32_MIN || v[k] > INT32_MAX)")
        b.push("            hl_die(\"simd i32x4 lane out of range\");")
        b.push("    }")
        b.push("    I32x4* r = usf_new_I32x4(0, 0);")
        b.push("    r->a = (int64_t)((uint32_t)v[0] | ((uint64_t)(uint32_t)v[1] << 32));")
        b.push("    r->b = (int64_t)((uint32_t)v[2] | ((uint64_t)(uint32_t)v[3] << 32));")
        b.push("    hl_list_release(xs);")
        b.push("    return r;")
        b.push("}")
        return
    }
    if name == "simd_f64x2_gather" {
        let b: list[str] = ctx.simd_helpers_plain
        b.push("/* " + name + " */")
        b.push("static F64x2* hl_" + name + "(hl_list* xs_p, int64_t i) {")
        b.push("    hl_list* xs = xs_p;")
        b.push("    if (i < 0 || i + 2 > xs->len) hl_die(\"simd gather out of bounds\");")
        b.push("    F64x2* r = usf_new_F64x2(hl_unbox_f64(xs->items[i]), hl_unbox_f64(xs->items[i + 1]));")
        b.push("    hl_list_release(xs);")
        b.push("    return r;")
        b.push("}")
        return
    }
    if name == "simd_correlate8_sum_i32x4" {
        let m: list[str] = ctx.simd_helpers_main
        let a: list[str] = ctx.simd_helpers_alt
        m.push("/* " + name + " - 8-tap correlation (canonical FIR vectorisation). */")
        m.push("__attribute__((target(\"" + ctx.target_feature + "\"))) static int64_t hl_" + name + "(hl_list* xs_p, int64_t w0, int64_t w1, int64_t w2, int64_t w3, int64_t w4, int64_t w5, int64_t w6, int64_t w7) {")
        m.push("    hl_list* xs = xs_p;")
        m.push("    int64_t ws[8] = { w0, w1, w2, w3, w4, w5, w6, w7 };")
        m.push("    for (int q = 0; q < 8; q++)")
        m.push("        if (ws[q] < INT32_MIN || ws[q] > INT32_MAX)")
        m.push("            hl_die(\"simd_correlate8_sum_i32x4: weight out of int32 range\");")
        m.push("    __m128i vw[8];")
        m.push("    for (int q = 0; q < 8; q++) vw[q] = _mm_set1_epi32((int32_t)ws[q]);")
        m.push("    int64_t n = xs->len;")
        m.push("    int64_t i = 0;")
        m.push("    __m128i acc0 = _mm_setzero_si128();")
        m.push("    __m128i acc1 = _mm_setzero_si128();")
        m.push("    for (; i + 11 <= n; i += 4) {")
        m.push("        __m128i vac = _mm_setzero_si128();")
        m.push("        for (int t = 0; t < 8; t++) {")
        m.push("            int64_t a0 = hl_unbox_i64(xs->items[i+t]);")
        m.push("            int64_t a1 = hl_unbox_i64(xs->items[i+t+1]);")
        m.push("            int64_t a2 = hl_unbox_i64(xs->items[i+t+2]);")
        m.push("            int64_t a3 = hl_unbox_i64(xs->items[i+t+3]);")
        m.push("            if (((((uint64_t)a0 + 0x80000000u) | ((uint64_t)a1 + 0x80000000u)")
        m.push("                 | ((uint64_t)a2 + 0x80000000u) | ((uint64_t)a3 + 0x80000000u))")
        m.push("                > 0xFFFFFFFFu)) hl_die(\"simd i32x4 lane out of range\");")
        m.push("            __m128i win = _mm_set_epi32((int32_t)a3, (int32_t)a2, (int32_t)a1, (int32_t)a0);")
        m.push("            vac = _mm_add_epi32(vac, _mm_mullo_epi32(win, vw[t]));")
        m.push("        }")
        m.push("        acc0 = _mm_add_epi64(acc0, _mm_cvtepi32_epi64(vac));")
        m.push("        acc1 = _mm_add_epi64(acc1, _mm_cvtepi32_epi64(")
        m.push("            _mm_shuffle_epi32(vac, _MM_SHUFFLE(0,0,3,2))));")
        m.push("    }")
        m.push("    int64_t lo[2], hi[2];")
        m.push("    _mm_storeu_si128((__m128i*)lo, acc0);")
        m.push("    _mm_storeu_si128((__m128i*)hi, acc1);")
        m.push("    int64_t total = lo[0] + lo[1] + hi[0] + hi[1];")
        m.push("    for (; i + 8 <= n; i++) {")
        m.push("        total += hl_unbox_i64(xs->items[i]) * w0 + hl_unbox_i64(xs->items[i+1]) * w1")
        m.push("                + hl_unbox_i64(xs->items[i+2]) * w2 + hl_unbox_i64(xs->items[i+3]) * w3")
        m.push("                + hl_unbox_i64(xs->items[i+4]) * w4 + hl_unbox_i64(xs->items[i+5]) * w5")
        m.push("                + hl_unbox_i64(xs->items[i+6]) * w6 + hl_unbox_i64(xs->items[i+7]) * w7;")
        m.push("    }")
        m.push("    hl_list_release(xs);")
        m.push("    return total;")
        m.push("}")
        a.push("/* " + name + " (scalar fallback) */")
        a.push("static int64_t hl_" + name + "(hl_list* xs_p, int64_t w0, int64_t w1, int64_t w2, int64_t w3, int64_t w4, int64_t w5, int64_t w6, int64_t w7) {")
        a.push("    hl_list* xs = xs_p;")
        a.push("    int64_t ws[8] = { w0, w1, w2, w3, w4, w5, w6, w7 };")
        a.push("    for (int q = 0; q < 8; q++)")
        a.push("        if (ws[q] < INT32_MIN || ws[q] > INT32_MAX)")
        a.push("            hl_die(\"simd_correlate8_sum_i32x4: weight out of int32 range\");")
        a.push("    int64_t total = 0;")
        a.push("    int64_t n = xs->len;")
        a.push("    for (int64_t i = 0; i + 8 <= n; i++) {")
        a.push("        int64_t s = 0;")
        a.push("        for (int t = 0; t < 8; t++) {")
        a.push("            int64_t v = hl_unbox_i64(xs->items[i+t]);")
        a.push("            if (v < INT32_MIN || v > INT32_MAX)")
        a.push("                hl_die(\"simd i32x4 lane out of range\");")
        a.push("            s += (int64_t)(int32_t)((uint32_t)v * (uint32_t)ws[t]);")
        a.push("        }")
        a.push("        total += (int64_t)(int32_t)(uint32_t)s;")
        a.push("    }")
        a.push("    hl_list_release(xs);")
        a.push("    return total;")
        a.push("}")
        return
    }
    if name == "simd_transform_sum_i32x4" {
        let m: list[str] = ctx.simd_helpers_main
        let p: list[str] = ctx.simd_helpers_alt
        m.push("/* " + name + " - the fused whole-loop kernel (Stage 21 acceptance). */")
        m.push("__attribute__((target(\"" + ctx.target_feature + "\"))) static int64_t hl_" + name + "(hl_list* xs_p, hl_list* ys_p, int64_t k, int64_t sub) {")
        m.push("    hl_list* xs = xs_p; hl_list* ys = ys_p;")
        m.push("    if (xs->len != ys->len) hl_die(\"simd_transform_sum_i32x4: length mismatch\");")
        m.push("    if (k < INT32_MIN || k > INT32_MAX) hl_die(\"simd_transform_sum_i32x4: k out of int32 range\");")
        m.push("    if (sub < INT32_MIN || sub > INT32_MAX) hl_die(\"simd_transform_sum_i32x4: sub out of int32 range\");")
        m.push("    int64_t total = 0;")
        m.push("    int64_t n = xs->len;")
        m.push("    int64_t i = 0;")
        m.push("    __m128i vk = _mm_set1_epi32((int32_t)k);")
        m.push("    __m128i vs = _mm_set1_epi32((int32_t)sub);")
        m.push("    /* 2x64-bit lane accumulators (paddq, SSE2): lanes 0-1 and 2-3")
        m.push("       of each 4-wide term, sign-extended, accumulated in exact")
        m.push("       int64 (max term ~2^27, 1M terms -> < 2^47, no overflow). */")
        m.push("    __m128i acc0 = _mm_setzero_si128();")
        m.push("    __m128i acc1 = _mm_setzero_si128();")
        m.push("    for (; i + 4 <= n; i += 4) {")
        m.push("        int64_t a0 = hl_unbox_i64(xs->items[i]);")
        m.push("        int64_t a1 = hl_unbox_i64(xs->items[i+1]);")
        m.push("        int64_t a2 = hl_unbox_i64(xs->items[i+2]);")
        m.push("        int64_t a3 = hl_unbox_i64(xs->items[i+3]);")
        m.push("        int64_t b0 = hl_unbox_i64(ys->items[i]);")
        m.push("        int64_t b1 = hl_unbox_i64(ys->items[i+1]);")
        m.push("        int64_t b2 = hl_unbox_i64(ys->items[i+2]);")
        m.push("        int64_t b3 = hl_unbox_i64(ys->items[i+3]);")
        m.push("        /* biased-OR range check: v in [INT32_MIN, INT32_MAX] iff")
        m.push("           (uint64_t)v + 0x80000000u <= 0xFFFFFFFF; the OR of the")
        m.push("           biased values is in range iff EVERY value is. */")
        m.push("        if (((((uint64_t)a0 + 0x80000000u) | ((uint64_t)a1 + 0x80000000u)")
        m.push("             | ((uint64_t)a2 + 0x80000000u) | ((uint64_t)a3 + 0x80000000u)")
        m.push("             | ((uint64_t)b0 + 0x80000000u) | ((uint64_t)b1 + 0x80000000u)")
        m.push("             | ((uint64_t)b2 + 0x80000000u) | ((uint64_t)b3 + 0x80000000u))")
        m.push("            > 0xFFFFFFFFu)) hl_die(\"simd i32x4 lane out of range\");")
        m.push("        __m128i va = _mm_set_epi32((int32_t)a3, (int32_t)a2, (int32_t)a1, (int32_t)a0);")
        m.push("        __m128i vb = _mm_set_epi32((int32_t)b3, (int32_t)b2, (int32_t)b1, (int32_t)b0);")
        m.push("        __m128i t = _mm_add_epi32(va, _mm_sub_epi32(_mm_mullo_epi32(vb, vk), vs));")
        m.push("        acc0 = _mm_add_epi64(acc0, _mm_cvtepi32_epi64(t));")
        m.push("        acc1 = _mm_add_epi64(acc1, _mm_cvtepi32_epi64(")
        m.push("            _mm_shuffle_epi32(t, _MM_SHUFFLE(0,0,3,2))));")
        m.push("    }")
        m.push("    int64_t lo[2], hi[2];")
        m.push("    _mm_storeu_si128((__m128i*)lo, acc0);")
        m.push("    _mm_storeu_si128((__m128i*)hi, acc1);")
        m.push("    total = lo[0] + lo[1] + hi[0] + hi[1];")
        m.push("    for (; i < n; i++) {")
        m.push("        int64_t a = hl_unbox_i64(xs->items[i]);")
        m.push("        int64_t b = hl_unbox_i64(ys->items[i]);")
        m.push("        if (a < INT32_MIN || a > INT32_MAX || b < INT32_MIN || b > INT32_MAX)")
        m.push("            hl_die(\"simd i32x4 lane out of range\");")
        m.push("        total += a + b * k - sub;")
        m.push("    }")
        m.push("    hl_list_release(xs); hl_list_release(ys);")
        m.push("    return total;")
        m.push("}")
        p.push("/* " + name + " (scalar fallback) */")
        p.push("static int64_t hl_" + name + "(hl_list* xs_p, hl_list* ys_p, int64_t k, int64_t sub) {")
        p.push("    hl_list* xs = xs_p; hl_list* ys = ys_p;")
        p.push("    if (xs->len != ys->len) hl_die(\"simd_transform_sum_i32x4: length mismatch\");")
        p.push("    if (k < INT32_MIN || k > INT32_MAX) hl_die(\"simd_transform_sum_i32x4: k out of int32 range\");")
        p.push("    if (sub < INT32_MIN || sub > INT32_MAX) hl_die(\"simd_transform_sum_i32x4: sub out of int32 range\");")
        p.push("    int64_t total = 0;")
        p.push("    int64_t n = xs->len;")
        p.push("    for (int64_t i = 0; i < n; i++) {")
        p.push("        int64_t a = hl_unbox_i64(xs->items[i]);")
        p.push("        int64_t b = hl_unbox_i64(ys->items[i]);")
        p.push("        if (a < INT32_MIN || a > INT32_MAX || b < INT32_MIN || b > INT32_MAX)")
        p.push("            hl_die(\"simd i32x4 lane out of range\");")
        p.push("        int64_t term = a + (int64_t)(int32_t)((uint32_t)b * (uint32_t)k) - sub;")
        p.push("        total += (int64_t)(int32_t)(uint32_t)term;")
        p.push("    }")
        p.push("    hl_list_release(xs); hl_list_release(ys);")
        p.push("    return total;")
        p.push("}")
        return
    }
    if name == "simd_i32x4_scatter" {
        let b: list[str] = ctx.simd_helpers_plain
        b.push("/* " + name + " */")
        b.push("static void hl_" + name + "(hl_list* xs_p, int64_t i, I32x4* v_p) {")
        b.push("    hl_list* xs = xs_p;")
        b.push("    I32x4* v = v_p;")
        b.push("    if (i < 0 || i + 4 > xs->len) hl_die(\"simd scatter out of bounds\");")
        b.push("    int64_t lane[4] = { (int64_t)(int32_t)(uint32_t)v->a, (int64_t)(int32_t)(uint32_t)(v->a >> 32),")
        b.push("                       (int64_t)(int32_t)(uint32_t)v->b, (int64_t)(int32_t)(uint32_t)(v->b >> 32) };")
        b.push("    for (int k = 0; k < 4; k++) {")
        b.push("        if (xs->elem_free) xs->elem_free(xs->items[i + k]);")
        b.push("        xs->items[i + k] = hl_box_i64(lane[k]);")
        b.push("    }")
        b.push("    hl_release_I32x4(v);")
        b.push("    hl_list_release(xs);")
        b.push("}")
        return
    }
    if name == "simd_f64x2_scatter" {
        let b: list[str] = ctx.simd_helpers_plain
        b.push("/* " + name + " */")
        b.push("static void hl_" + name + "(hl_list* xs_p, int64_t i, F64x2* v_p) {")
        b.push("    hl_list* xs = xs_p;")
        b.push("    F64x2* v = v_p;")
        b.push("    if (i < 0 || i + 2 > xs->len) hl_die(\"simd scatter out of bounds\");")
        b.push("    if (xs->elem_free) xs->elem_free(xs->items[i]);")
        b.push("    xs->items[i] = hl_box_f64(v->a);")
        b.push("    if (xs->elem_free) xs->elem_free(xs->items[i + 1]);")
        b.push("    xs->items[i + 1] = hl_box_f64(v->b);")
        b.push("    hl_release_F64x2(v);")
        b.push("    hl_list_release(xs);")
        b.push("}")
        return
    }
}

# Stage 21 perfection (v0.40.0-alpha): simd_detect_native_feature —
# auto-detect the host CPU's best SIMD feature. Called from main()
# when the user passes `--target-feature native`. The probe uses the
# existing simd_cpu_supports() builtin (a runtime CPU probe via
# __builtin_cpu_supports on x86 / NEON baseline on aarch64). The
# result is one of "avx2", "sse4.2", "neon", or "" (no fast path).
#
# Preference order (x86): avx2 (the strongest feature the std.simd
# intrinsic fast paths support today; AVX-512 tuning is post-1.0)
# > sse4.2 > "" (portable). On aarch64: neon (baseline) > "". On
# other architectures: "" (portable path — no intrinsic fast paths
# emitted, the std.simd kernels run their pure-HLS implementation).
fn simd_detect_native_feature() -> str {
    if simd_cpu_supports("avx2") {
        return "avx2"
    }
    if simd_cpu_supports("sse4.2") {
        return "sse4.2"
    }
    if simd_cpu_supports("neon") {
        return "neon"
    }
    return ""
}

# simd_helper_lines: assemble the final C block (prologue + main + alt
# with the arch #if/#else/#endif split, or scalar-only for neon).
fn simd_helper_lines(ctx: Ctx) -> list[str] {
    let out: list[str] = []
    if ctx.simd_helper_names.len() == 0 {
        return out
    }
    let x86: bool = ctx.target_feature == "sse4.2" || ctx.target_feature == "avx2"
    out.push("// ===== Stage 21 (v0.37.0-alpha): std.simd intrinsic fast paths =====")
    out.push("//      --target-feature " + ctx.target_feature
        + " — semantics identical to the portable std/simd.hls path.")
    if x86 {
        out.push("#if defined(__x86_64__) || defined(__i386__)")
        out.push("#include <immintrin.h>")
        concat_lines(out, ctx.simd_helpers_main)
        concat_lines(out, ctx.simd_helpers_plain)
        # Stage 25 (v0.44.0-alpha): if --target-feature neon was given,
        # the NEON emitters populated simd_helpers_neon too — emit them
        # in the #elif __aarch64__ branch so the same C source compiles
        # on both x86 (uses SSE/AVX) and aarch64 (uses NEON).
        if ctx.simd_helpers_neon.len() > 0 {
            out.push("#elif defined(__aarch64__) || defined(__ARM_NEON__)")
            out.push("#include <arm_neon.h>")
            concat_lines(out, ctx.simd_helpers_neon)
            concat_lines(out, ctx.simd_helpers_plain)
        }
        out.push("#else")
        out.push("// non-x86/non-NEON host: portable scalar fallback.")
        concat_lines(out, ctx.simd_helpers_alt)
        concat_lines(out, ctx.simd_helpers_plain)
        out.push("#endif")
    } else if ctx.target_feature == "neon" {
        # Stage 25: --target-feature neon — emit the NEON intrinsics in
        # the #if __aarch64__ branch, with the scalar fallback in #else.
        out.push("#if defined(__aarch64__) || defined(__ARM_NEON__)")
        out.push("#include <arm_neon.h>")
        concat_lines(out, ctx.simd_helpers_neon)
        concat_lines(out, ctx.simd_helpers_plain)
        out.push("#else")
        out.push("// non-NEON host: portable scalar fallback.")
        concat_lines(out, ctx.simd_helpers_alt)
        concat_lines(out, ctx.simd_helpers_plain)
        out.push("#endif")
    } else {
        out.push("// NEON intrinsic tuning is Stage 25 (AArch64 backend); the")
        out.push("// arch-independent fast paths below eliminate the per-element")
        out.push("// runtime calls on every host.")
        concat_lines(out, ctx.simd_helpers_alt)
        concat_lines(out, ctx.simd_helpers_plain)
    }
    out.push("")
    return out
}

# pgo_dump_lines: the C lines for the --pgo-generate profile dumper —
# the site-id table + __hlc_pgo_dump(). Emitted after all function
# bodies (so the site list is complete) and before main (which
# registers the dumper via atexit). The dump is BEST-EFFORT: a profile
# file that cannot be opened is silently skipped — instrumentation must
# never change program behaviour, including its exit code.
fn pgo_dump_lines(ctx: Ctx) -> list[str] {
    let out: list[str] = []
    let n: int = ctx.pgo_site_ids.len()
    if n == 0 {
        # No profile sites at all — emit a no-op dumper so the atexit
        # registration still links.
        out.push("// ===== Stage 19: PGO profile dumper (no sites) =====")
        out.push("static void __hlc_pgo_dump(void) { }")
        out.push("")
        return out
    }
    out.push("// ===== Stage 19: PGO site-id table + profile dumper =====")
    out.push("static const char* __hlc_pgo_names[" + n.to_str() + "] = {")
    # Emit the ids in rows of 4 to keep line lengths sane.
    let mut i: int = 0
    while i < n {
        let mut row: str = "    \"" + ctx.pgo_site_ids.get(i) + "\","
        if i + 1 < n {
            row = row + " \"" + ctx.pgo_site_ids.get(i + 1) + "\","
        }
        if i + 2 < n {
            row = row + " \"" + ctx.pgo_site_ids.get(i + 2) + "\","
        }
        if i + 3 < n {
            row = row + " \"" + ctx.pgo_site_ids.get(i + 3) + "\","
        }
        out.push(row)
        i = i + 4
    }
    out.push("};")
    out.push("")
    out.push("static void __hlc_pgo_dump(void) {")
    out.push("    const char* path = getenv(\"HLS_PGO_FILE\");")
    out.push("    if (!path || !path[0]) path = \"default.hlcprof\";")
    out.push("    /* HLS_PGO_MERGE=1: ADD this run's counters to an existing")
    out.push("       profile instead of overwriting it - a training workload")
    out.push("       of N program runs then accumulates one merged profile. */")
    out.push("    const char* merge = getenv(\"HLS_PGO_MERGE\");")
    out.push("    if (merge && merge[0] == '1') {")
    out.push("        FILE* r = fopen(path, \"r\");")
    out.push("        if (r) {")
    out.push("            char buf[512];")
    out.push("            while (fgets(buf, sizeof buf, r)) {")
    out.push("                char* sp = strchr(buf, ' ');")
    out.push("                if (!sp) continue;")
    out.push("                *sp = 0;")
    out.push("                long long c = strtoll(sp + 1, NULL, 10);")
    out.push("                for (int i = 0; i < " + n.to_str() + "; i++) {")
    out.push("                    if (strcmp(__hlc_pgo_names[i], buf) == 0) {")
    out.push("                        if (c > 0) __hlc_pgo_counts[i] += (uint64_t)c;")
    out.push("                        break;")
    out.push("                    }")
    out.push("                }")
    out.push("            }")
    out.push("            fclose(r);")
    out.push("        }")
    out.push("    }")
    out.push("    FILE* f = fopen(path, \"w\");")
    out.push("    if (!f) return; /* best-effort: profiling must never crash the program */")
    out.push("    for (int i = 0; i < " + n.to_str() + "; i++) {")
    out.push("        if (__hlc_pgo_counts[i] > 0) {")
    out.push("            fprintf(f, \"%s %llu\\n\", __hlc_pgo_names[i],")
    out.push("                    (unsigned long long)__hlc_pgo_counts[i]);")
    out.push("        }")
    out.push("    }")
    out.push("    fclose(f);")
    out.push("}")
    out.push("")
    return out
}

# ============================================================================
# STAGE 20 (v0.36.0-alpha): LINK-TIME OPTIMISATION ACROSS "CRATES"
# ----------------------------------------------------------------------------
# The merged program (entry + every transitive import) is ONE compilation
# unit, so "cross-crate" optimisation happens at the whole-program level:
#   1. cross-crate inlining — a small single-return function from an
#      imported module is inlined at statement-level call positions
#      (let / return / expression statement); the callee's body is
#      generated inline with per-site unique temps, the args get the
#      same own-wrap treatment a real call gives them, and the return
#      expression is bound through the same own-wrap the return path
#      uses — so ownership semantics are bit-for-bit preserved.
#   2. whole-program DCE — functions not reachable from main (plus the
#      struct-default / contract / spawn roots) are not emitted at all;
#      a function whose EVERY call site was inlined is dropped as well
#      ("inlined and the standalone definition is dropped").
#   3. generic specialisation dedup — instantiations are keyed by the
#      mangled name, so two modules instantiating the same generic with
#      the same type args share ONE specialisation (the collection is
#      already keyed; --lto reports how many duplicate requests were
#      collapsed).
# ============================================================================

# lto_reachable: the set of function keys reachable from the roots via
# the CHECKER's call graph (ctx.edges — includes method calls, spawn
# targets and struct-default exprs via the "" synthetic caller).
# Roots: main + every callee of "" (top-level exprs: struct defaults).
fn lto_reachable(ctx: Ctx) -> list[str] {
    let visited: map[str, bool] = map_new()
    let work: list[str] = []
    work.push("main")
    # "" callees: struct default field expressions are checked with the
    # empty caller key; their callees must stay (constructors for ALL
    # structs are emitted unconditionally).
    if ctx.edges.has("") {
        let ec: list[str] = ctx.edges.get_or("", [])
        let mut i: int = 0
        while i < ec.len() {
            work.push(ec.get(i))
            i = i + 1
        }
    }
    while work.len() > 0 {
        let k: str = work.pop()
        if k == "" || k.len() < 1 {
            continue
        }
        if k.len() >= 2 && k.slice(0, 2) == "b:" {
            continue
        }
        if visited.has(k) {
            continue
        }
        visited.set(k, true)
        if ctx.edges.has(k) {
            let outs: list[str] = ctx.edges.get_or(k, [])
            let mut j: int = 0
            while j < outs.len() {
                work.push(outs.get(j))
                j = j + 1
            }
        }
    }
    return visited.keys()
}

# lto_count_stmts: recursive statement count (for the inline budget).
fn lto_count_stmts(ctx: Ctx, stmts: list[int]) -> int {
    let mut n: int = 0
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts[stmts.get(i)]
        n = n + 1
        n = n + lto_count_stmts(ctx, s.body)
        n = n + lto_count_stmts(ctx, s.else_body)
        i = i + 1
    }
    return n
}

# lto_callee_local_names: collect every name the callee body will
# register in gen_locals (let bindings + for loop variables, at any
# nesting depth) so the caller's entries can be saved and restored.
fn lto_callee_local_names(ctx: Ctx, stmts: list[int], out: list[str]) -> void {
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts[stmts.get(i)]
        if s.kind == "let" {
            out.push(s.name)
        }
        if s.kind == "for" {
            out.push(s.name)
        }
        lto_callee_local_names(ctx, s.body, out)
        lto_callee_local_names(ctx, s.else_body, out)
        i = i + 1
    }
}

# lto_expr_has_qmark: does this expression subtree contain the `?`
# operator (qmark nodes lower to a return inside a statement expr)?
fn lto_expr_has_qmark(ctx: Ctx, e: int) -> bool {
    if e == -1 {
        return false
    }
    let ex: ExprN = ctx.exprs[e]
    if ex.kind == "qmark" {
        return true
    }
    if lto_expr_has_qmark(ctx, ex.left) {
        return true
    }
    if lto_expr_has_qmark(ctx, ex.right) {
        return true
    }
    let mut i: int = 0
    while i < ex.args.len() {
        if lto_expr_has_qmark(ctx, ex.args.get(i)) {
            return true
        }
        i = i + 1
    }
    # match: the scrutinee is ex.left; arms carry their own stmt/expr
    # lists on the MatchArm table (covered by lto_body_has_qmark).
    return false
}

# lto_body_has_qmark: any statement (at any depth) whose expressions
# contain a qmark — including match arms (their arm bodies are
# statements; match-as-expression scrutinee is an expr arg).
fn lto_body_has_qmark(ctx: Ctx, stmts: list[int]) -> bool {
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts[stmts.get(i)]
        if s.value != -1 && lto_expr_has_qmark(ctx, s.value) {
            return true
        }
        if s.target != -1 && lto_expr_has_qmark(ctx, s.target) {
            return true
        }
        if s.cond != -1 && lto_expr_has_qmark(ctx, s.cond) {
            return true
        }
        if s.iter != -1 && lto_expr_has_qmark(ctx, s.iter) {
            return true
        }
        if s.e != -1 && lto_expr_has_qmark(ctx, s.e) {
            return true
        }
        if lto_body_has_qmark(ctx, s.body) {
            return true
        }
        if lto_body_has_qmark(ctx, s.else_body) {
            return true
        }
        # match statement: arms hold (cond?, body) — the arm payloads are
        # statement lists reachable via match_arms indexes stored in the
        # stmt's args? MatchArm bodies are found through s.e (the match
        # expr index); its arms list is ctx.exprs[s.e].args -> arm ids.
        if s.kind == "match" || s.e != -1 {
            let mex: ExprN = ctx.exprs[s.e]
            if mex.kind == "match" {
                if lto_expr_has_qmark(ctx, mex.left) {
                    return true
                }
                let mut ai: int = 0
                while ai < mex.args.len() {
                    let arm: MatchArm = ctx.match_arms[mex.args.get(ai)]
                    # arm.body is an EXPRESSION index (not a stmt list).
                    if lto_expr_has_qmark(ctx, arm.body) {
                        return true
                    }
                    ai = ai + 1
                }
            }
        }
        i = i + 1
    }
    return false
}

# lto_count_returns_deep: count return statements at EVERY nesting
# depth (an early return nested inside an if/while CANNOT be inlined —
# emitted inside the caller it would return from the CALLER).
fn lto_count_returns_deep(ctx: Ctx, stmts: list[int]) -> int {
    let mut n: int = 0
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts[stmts.get(i)]
        if s.kind == "return" {
            n = n + 1
        }
        n = n + lto_count_returns_deep(ctx, s.body)
        n = n + lto_count_returns_deep(ctx, s.else_body)
        i = i + 1
    }
    return n
}

# lto_single_return: exactly ONE return in the WHOLE statement tree, and
# it is the LAST top-level statement (non-void: with a value; void:
# either no return at all, or a trailing bare `return;`). Any early /
# nested return disqualifies the callee from inlining.
fn lto_single_return(ctx: Ctx, f: FnInfo) -> int {
    # returns: 0 = void, no return; 1 = non-void trailing return with
    # value; 2 = void trailing bare return; -1 = NOT inlinable.
    let n: int = f.body.len()
    if n == 0 {
        if f.ret == "void" {
            return 0
        }
        return -1
    }
    let rets: int = lto_count_returns_deep(ctx, f.body)
    if rets == 0 {
        if f.ret == "void" {
            return 0
        }
        return -1
    }
    if rets != 1 {
        return -1
    }
    # The single return must be the LAST top-level statement.
    let last: StmtN = ctx.stmts[f.body.get(n - 1)]
    if last.kind != "return" {
        return -1
    }
    if f.ret == "void" {
        if last.value == -1 {
            return 2
        }
        return -1
    }
    if last.value == -1 {
        return -1
    }
    return 1
}

# lto_is_recursive: true when key can reach itself through the checker's
# call graph (direct or mutual recursion — never inline those).
fn lto_is_recursive(ctx: Ctx, key: str) -> bool {
    if !ctx.edges.has(key) {
        return false
    }
    let visited: map[str, bool] = map_new()
    let work: list[str] = []
    let outs: list[str] = ctx.edges.get_or(key, [])
    let mut i: int = 0
    while i < outs.len() {
        work.push(outs.get(i))
        i = i + 1
    }
    while work.len() > 0 {
        let k: str = work.pop()
        if k == key {
            return true
        }
        if k == "" || (k.len() >= 2 && k.slice(0, 2) == "b:") {
            continue
        }
        if visited.has(k) {
            continue
        }
        visited.set(k, true)
        if ctx.edges.has(k) {
            let o2: list[str] = ctx.edges.get_or(k, [])
            let mut j: int = 0
            while j < o2.len() {
                work.push(o2.get(j))
                j = j + 1
            }
        }
    }
    return false
}

# LTO_INLINE_MAX_SITES: total inline expansions per program (bloat
# guard). LTO_INLINE_MAX_STMTS: per-callee statement budget.
# Stage 20 perfection (v0.39.0-alpha): the per-callee budget is
# tunable via --lto-threshold=N (ctx.lto_threshold > 0 overrides
# the default of 30).
fn LTO_INLINE_MAX_SITES() -> int {
    return 100
}
fn LTO_INLINE_MAX_STMTS() -> int {
    return 30
}
fn lto_inline_stmts_budget(ctx: Ctx) -> int {
    if ctx.lto_threshold > 0 {
        return ctx.lto_threshold
    }
    return LTO_INLINE_MAX_STMTS()
}

# lto_can_inline: the inlinability predicate.
fn lto_can_inline(ctx: Ctx, key: str) -> bool {
    if !ctx.lto_mode {
        return false
    }
    if key == "main" {
        return false
    }
    if !ctx.fns.has(key) {
        return false
    }
    let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
    if f.is_extern {
        return false
    }
    if f.is_method {
        return false
    }
    if f.typeparams.len() > 0 {
        return false
    }
    if f.ret == "never" {
        return false
    }
    # Contracted functions keep their standalone bodies (the requires /
    # ensures checks and -O fast elisions interplay with the fn boundary;
    # inlining them is deferred).
    if f.requires_e != -1 || f.ensures_e != -1 {
        return false
    }
    if lto_single_return(ctx, f) == -1 {
        return false
    }
    # The trailing return's VALUE must be bindable (a `return panic(...)`
    # in a non-never fn lowers to a bare call, which cannot feed the
    # result temp).
    let rn: int = f.body.len()
    if rn > 0 {
        let lastst: StmtN = ctx.stmts[f.body.get(rn - 1)]
        if lastst.kind == "return" && lastst.value != -1 {
            if ctx.exprs[lastst.value].t == "never" {
                return false
            }
        }
    }
    # The `?` operator lowers to a `return` INSIDE a C statement
    # expression — splicing such a body into the caller would return
    # from the CALLER. Callees containing ? are never inlined.
    if lto_body_has_qmark(ctx, f.body) {
        return false
    }
    if lto_count_stmts(ctx, f.body) > lto_inline_stmts_budget(ctx) {
        return false
    }
    if lto_is_recursive(ctx, key) {
        return false
    }
    if ctx.lto_inline_n >= LTO_INLINE_MAX_SITES() {
        return false
    }
    return true
}

# lto_note_call: count an emitted out-of-line call (gen_call / method /
# spawn trampoline) so phase-B DCE knows the standalone body is needed.
fn lto_note_call(ctx: Ctx, key: str) -> void {
    if !ctx.lto_mode {
        return
    }
    let cur: int = ctx.lto_calls.get_or(key, 0)
    ctx.lto_calls.set(key, cur + 1)
}

# gen_expr_maybe_inline: the statement-position inline hook. Falls back
# to a plain gen_expr when LTO is off or the callee is not inlinable.
fn gen_expr_maybe_inline(ctx: Ctx, e: int, ind: str) -> str {
    if !ctx.lto_mode {
        return gen_expr(ctx, e)
    }
    if ctx.exprs[e].kind != "call" || !ctx.exprs[e].muser {
        return gen_expr(ctx, e)
    }
    let key: str = ctx.exprs[e].mkey
    if !lto_can_inline(ctx, key) {
        return gen_expr(ctx, e)
    }
    return lto_emit_inline(ctx, key, e, ind)
}

# lto_emit_inline: generate the callee's body AT the call site and
# return the C expression holding the call result ("" for void).
fn lto_emit_inline(ctx: Ctx, key: str, e: int, ind: str) -> str {
    let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
    ctx.lto_inline_n = ctx.lto_inline_n + 1
    if !list_has(ctx.lto_inlined_report, key) {
        ctx.lto_inlined_report.push(key)
    }
    let rkind: int = lto_single_return(ctx, f)
    # ---- 1. argument temps (one owned retain each — exactly what a
    # real call passes; pointer params carry a cleanup attribute so the
    # temp is released at the enclosing C block exit, like param locals).
    let save_names: list[str] = []
    lto_callee_local_names(ctx, f.body, save_names)
    let mut pi: int = 0
    while pi < f.params.len() {
        save_names.push(f.params.get(pi))
        pi = pi + 1
    }
    let save_vals: list[str] = []
    let mut si: int = 0
    while si < save_names.len() {
        if ctx.gen_locals.has(save_names.get(si)) {
            save_vals.push(ctx.gen_locals.get_or(save_names.get(si), ""))
        } else {
            save_vals.push("")
        }
        si = si + 1
    }
    let mut ai: int = 0
    while ai < f.params.len() {
        let pname: str = f.params.get(ai)
        let ptype: str = inst_t(ctx, f.ptypes.get(ai))
        let arg_e: int = ctx.exprs[e].args.get(ai)
        let fresh: bool = expr_fresh(ctx, arg_e)
        let v: str = gen_expr(ctx, arg_e)
        let wrapped: str = own_wrap(ctx, ptype, v, fresh)
        let tname: str = fresh_tmp(ctx, "hl_iv")
        if is_ptr_t(ctx, ptype) {
            ctx.out.push(ind + c_type(ctx, ptype) + " " + tname
                + " __attribute__((cleanup(" + cleanup_fn_for(ctx, ptype) + "))) = " + wrapped + ";")
        } else {
            ctx.out.push(ind + c_type(ctx, ptype) + " " + tname + " = " + wrapped + ";")
        }
        ctx.gen_locals.set(pname, tname)
        ai = ai + 1
    }
    # ---- 2. the callee body statements. The trailing return is NOT
    # emitted (a `return` inside the caller would return from the
    # CALLER); its expression becomes the result binding below.
    let body_n: int = f.body.len()
    let mut gen_n: int = body_n
    if rkind == 1 || rkind == 2 {
        gen_n = body_n - 1
    }
    let mut bi: int = 0
    while bi < gen_n {
        gen_stmt(ctx, f.body.get(bi), ind)
        bi = bi + 1
    }
    # ---- 3. result binding (non-void): the trailing return's
    # expression, own-wrapped exactly like the real return path.
    let mut ret_temp: str = ""
    if rkind == 1 {
        let last: StmtN = ctx.stmts[f.body.get(body_n - 1)]
        let rv: str = gen_expr(ctx, last.value)
        let rfresh: bool = expr_fresh(ctx, last.value)
        let rwrapped: str = own_wrap(ctx, f.ret, rv, rfresh)
        ret_temp = fresh_tmp(ctx, "hl_ir")
        ctx.out.push(ind + c_type(ctx, f.ret) + " " + ret_temp + " = " + rwrapped + ";")
    }
    # ---- 4. restore the caller's gen_locals view (the callee's `let`
    # registrations must not shadow the caller's bindings after the
    # inline site; the result binding above already resolved).
    let mut ri: int = 0
    while ri < save_names.len() {
        let nm: str = save_names.get(ri)
        let sv: str = save_vals.get(ri)
        # HLS maps have no remove; setting "" unbinds (local_c's
        # get_or("") panics exactly like an absent key).
        ctx.gen_locals.set(nm, sv)
        ri = ri + 1
    }
    return ret_temp
}

fn gen_expr(ctx: Ctx, e: int) -> str {
    # Stage 8-beta: if this node was hoisted into a temp, use the temp.
    let hk: str = e.to_str()
    if ctx.hoist_map.has(hk) {
        let tname: str = ctx.hoist_map.get_or(hk, "")
        if tname != "" {
            return tname
        }
    }
    let mut k: str = ctx.exprs[e].kind
    if k == "int" {
        if ctx.exprs[e].ival == -9223372036854775808 {
            return "(-9223372036854775807LL - 1)"
        }
        return ctx.exprs[e].ival.to_str()
    }
    if k == "float" {
        return ctx.exprs[e].fval.to_str()
    }
    if k == "bool" {
        if ctx.exprs[e].bval {
            return "true"
        }
        return "false"
    }
    if k == "str" {
        # Stage 19 (v0.35.0-alpha): profile-driven literal hoisting. In
        # a HOT function a string literal becomes a thread-local
        # one-time cache: the conversion (malloc + strlen + memcpy)
        # runs once per thread instead of once per evaluation. The
        # trailing hl_retain supplies the +1 that a fresh literal's
        # inherent refcount provided, so ownership paths are unchanged.
        if pgo_has_profile(ctx) && pgo_fn_is_hot(ctx, ctx.cur_fn) {
            ctx.pgo_slit_n = ctx.pgo_slit_n + 1
            let name: str = "HLC_SL_" + ctx.pgo_slit_n.to_str()
            ctx.pgo_slits.push("static __thread hl_str* " + name + " = NULL;")
            return "hl_retain((" + name + " ? (" + name + ") : (" + name
                + " = " + c_str_lit(ctx.exprs[e].sval) + ")))"
        }
        return c_str_lit(ctx.exprs[e].sval)
    }
    if k == "ident" {
        return local_c(ctx, ctx.exprs[e].name)
    }
    if k == "bin" {
        return gen_bin(ctx, e)
    }
    if k == "un" {
        let sub: str = gen_expr(ctx, ctx.exprs[e].left)
        if ctx.exprs[e].op == "!" {
            return "(!" + sub + ")"
        }
        if ctx.exprs[e].t == "int" {
            return "hl_neg_i64(" + sub + ")"
        }
        return "(-" + sub + ")"
    }
    if k == "index" {
        let lst: str = gen_expr(ctx, ctx.exprs[e].left)
        let idx: str = gen_expr(ctx, ctx.exprs[e].right)
        # Stage 17: -O fast — a bounds-proven index uses the unchecked
        # getter (the interval prover proved i in [0, len-1)).
        let mut getter: str = "hl_list_get"
        if ctx.fast_mode && ctx.exprs[e].bnd_safe {
            getter = "hl_list_get_unchecked"
        }
        return gen_unbox(ctx, ctx.exprs[e].t, getter + "(" + lst + ", " + idx + ")")
    }
    if k == "field" {
        return "(" + gen_expr(ctx, ctx.exprs[e].left) + ")->" + ctx.exprs[e].name
    }
    if k == "call" {
        return gen_call(ctx, e)
    }
    if k == "method" {
        return gen_method(ctx, e)
    }
    if k == "listlit" {
        return gen_listlit(ctx, e)
    }
    if k == "structlit" {
        return gen_structlit(ctx, e)
    }
    if k == "enumlit" {
        return gen_enumlit(ctx, e)
    }
    if k == "match" {
        # Match in expression position: emit an immediately-invoked lambda
        # equivalent (a block expression). We use a GCC statement expression
        # `({ ... })` for this purpose.
        return gen_match_expr(ctx, e)
    }
    if k == "qmark" {
        # `?` in expression position: similar — emit a statement expression
        # that returns the unwrapped value or returns the error from the
        # enclosing function.
        return gen_qmark_expr(ctx, e)
    }
    if k == "mapnew" {
        return "hl_map_new()"
    }
    panic("internal codegen error: unknown expression " + k)
    return ""
}

fn gen_bin(ctx: Ctx, e: int) -> str {
    let op: str = ctx.exprs[e].op
    let t: str = ctx.exprs[ctx.exprs[e].left].t
    let a: str = gen_expr(ctx, ctx.exprs[e].left)
    if op == "||" || op == "&&" {
        # BUGFIX (v0.36.0-alpha): the right operand is generated LAZILY —
        # see collect_hoist's bin case. Its fresh pointer subexpressions
        # are scoped inside a GCC statement expression placed exactly at
        # the operand position: C's short-circuit skips both their
        # evaluation AND their cleanup when the left operand already
        # decided the result, matching the interpreter exactly.
        let r: int = ctx.exprs[e].right
        collect_hoist(ctx, r)
        let decls: list[str] = []
        hoist_all(ctx, decls, "")
        let bval: str = gen_expr(ctx, r)
        if decls.len() == 0 {
            return "(" + a + " " + op + " " + bval + ")"
        }
        return "(" + a + " " + op + " ({ " + join(decls, " ") + " " + bval + "; }))"
    }
    let b: str = gen_expr(ctx, ctx.exprs[e].right)
    if op == "==" {
        if t == "str" {
            return "hl_str_eq(" + a + ", " + b + ")"
        }
        return "(" + a + " == " + b + ")"
    }
    if op == "!=" {
        if t == "str" {
            return "(!hl_str_eq(" + a + ", " + b + "))"
        }
        return "(" + a + " != " + b + ")"
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if t == "str" {
            return "(hl_str_cmp(" + a + ", " + b + ") " + op + " 0)"
        }
        return "(" + a + " " + op + " " + b + ")"
    }
    if op == "+" {
        if t == "int" {
            # Stage 17: -O fast — an overflow-proven add emits the raw op.
            if ctx.fast_mode && ctx.exprs[e].ovf_safe {
                return "(" + a + " + " + b + ")"
            }
            return "hl_add_i64(" + a + ", " + b + ")"
        }
        if t == "str" {
            return "hl_str_concat(" + a + ", " + b + ")"
        }
        return "(" + a + " + " + b + ")"
    }
    if op == "-" {
        if t == "int" {
            if ctx.fast_mode && ctx.exprs[e].ovf_safe {
                return "(" + a + " - " + b + ")"
            }
            return "hl_sub_i64(" + a + ", " + b + ")"
        }
        return "(" + a + " - " + b + ")"
    }
    if op == "*" {
        if t == "int" {
            if ctx.fast_mode && ctx.exprs[e].ovf_safe {
                return "(" + a + " * " + b + ")"
            }
            return "hl_mul_i64(" + a + ", " + b + ")"
        }
        return "(" + a + " * " + b + ")"
    }
    if op == "/" {
        if t == "int" {
            # Stage 17: -O fast — a divisor-proven-nonzero div/mod skips
            # the zero check (and the INT64_MIN/-1 corner was excluded by
            # the prover).
            if ctx.fast_mode && ctx.exprs[e].div_safe {
                return "(" + a + " / " + b + ")"
            }
            return "hl_div_i64(" + a + ", " + b + ")"
        }
        return "(" + a + " / " + b + ")"
    }
    if op == "%" {
        if t == "int" {
            if ctx.fast_mode && ctx.exprs[e].div_safe {
                return "(" + a + " % " + b + ")"
            }
            return "hl_mod_i64(" + a + ", " + b + ")"
        }
        return "hl_fmod(" + a + ", " + b + ")"
    }
    panic("internal codegen error: unknown operator " + op)
    return ""
}

fn gen_args_c(ctx: Ctx, e: int) -> str {
    let parts: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        parts.push(gen_expr(ctx, ctx.exprs[e].args.get(i)))
        i = i + 1
    }
    return join(parts, ", ")
}

fn gen_call(ctx: Ctx, e: int) -> str {
    if ctx.exprs[e].muser {
        # Stage 15-beta: extern fns use the RAW C name (no `usf_` prefix)
        # so the C linker can resolve them from libc. Extern args are
        # borrowed (the C callee knows nothing about refcounts) — fresh
        # pointer args were hoisted into temps by the statement wrapper.
        let cf: FnInfo = ctx.fns.get_or(ctx.exprs[e].mkey, dummy_fn())
        if cf.is_extern {
            return ctx.exprs[e].mkey + "(" + gen_args_c(ctx, e) + ")"
        }
        # Stage 8-beta: user fn params OWN one retain of each argument —
        # fresh values are passed raw, borrowed values retain-wrapped.
        # Stage 21 (v0.37.0-alpha): --target-feature — std.simd kernel
        # calls redirect to the intrinsic helpers (identical semantics,
        # native vector code; helpers own their args like user fns).
        if ctx.target_feature != "" {
            let redirected: str = simd_try_redirect(ctx, ctx.exprs[e].mkey, e)
            if redirected != "" {
                return redirected
            }
        }
        # Stage 20 (v0.36.0-alpha): count the emitted out-of-line call
        # (LTO phase-B DCE drops standalone bodies at 0).
        lto_note_call(ctx, ctx.exprs[e].mkey)
        return "usf_" + c_fn_name(ctx.exprs[e].mkey) + "(" + gen_own_args_c(ctx, e) + ")"
    }
    let name: str = ctx.exprs[e].mkey
    let args: str = gen_args_c(ctx, e)
    if name == "print" {
        return "hl_print(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "println" {
        return "hl_println(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "panic" {
        return "hl_panic(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    if name == "exit" {
        return "hl_exit(" + args + ")"
    }
    if name == "str" {
        let at: str = ctx.exprs[ctx.exprs[e].args.get(0)].t
        if at == "int" {
            return "hl_str_from_int64(" + args + ")"
        }
        if at == "float" {
            return "hl_str_from_double(" + args + ")"
        }
        if at == "bool" {
            return "hl_str_from_bool(" + args + ")"
        }
        return args
    }
    if name == "int" {
        return "hl_str_to_int(" + args + ")"
    }
    if name == "len" {
        let at: str = ctx.exprs[ctx.exprs[e].args.get(0)].t
        if at == "str" {
            return "hl_str_len(" + args + ")"
        }
        if is_list_t(at) {
            return "hl_list_len(" + args + ")"
        }
        return "hl_map_len(" + args + ")"
    }
    if name == "range" {
        return "hl_range(" + args + ")"
    }
    # Stage 19 (v0.35.0-alpha): O(n) join(list[str], sep) -> str. Args
    # are read-only for the callee (borrowed raw pointers, matching the
    # concat convention); the result is a fresh string.
    if name == "join" {
        return "hl_str_join(" + args + ")"
    }
    # Stage 21 (v0.37.0-alpha): has_feature — const-folded from the
    # --target-feature flag. Exact-match semantics (asking for "avx2"
    # is true only when avx2 was requested).
    if name == "has_feature" {
        if ctx.target_feature == ctx.exprs[ctx.exprs[e].args.get(0)].sval {
            return "true"
        }
        return "false"
    }
    # Stage 21: simd_cpu_supports — runtime CPU probe.
    if name == "simd_cpu_supports" {
        return "hl_simd_cpu_supports(" + args + ")"
    }
    # (Stage 21 redirect lives in the muser branch above — user fn
    # calls return before reaching the builtin section.)
    if name == "map_new" {
        # Stage 8-beta: the map owns its values — val_free comes from the
        # map's value type (the checker types this call from context).
        let mt: str = inst_t(ctx, ctx.exprs[e].t)
        if is_map_t(mt) {
            return "hl_map_new(" + elem_free_fn(ctx, map_val_t(mt)) + ")"
        }
        return "hl_map_new(NULL)"
    }
    if name == "read_file" {
        return "hl_read_file(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # Stage 10-beta: read_file_tainted — at runtime, returns the same hl_read_file
    # result; taint is a compile-time property only (defense-in-depth is deferred).
    if name == "read_file_tainted" {
        return "hl_read_file(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # Stage 10 release: read_line() — reads one line from stdin (newline
    # stripped). At runtime, identical to hl_read_line(); taint is a
    # compile-time property only (the checker enforces sanitisation
    # before sinks; the runtime wrapper is defence-in-depth, deferred).
    if name == "read_line" {
        return "hl_read_line()"
    }
    if name == "write_file" {
        return "hl_write_file(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ", "
            + gen_own_arg(ctx, ctx.exprs[e].args.get(1)) + ")"
    }
    if name == "args" {
        return "hl_args()"
    }
    # Stage 10-alpha: taint primitives — at runtime, taint is a no-op
    # (the check is purely at compile-time). tainted_args() returns the
    # same hl_args() result; taint_mark(x) returns x; taint_unwrap(x)
    # returns x. The C type of tainted[T] is the same as T (see c_type).
    if name == "tainted_args" {
        return "hl_args()"
    }
    if name == "taint_mark" {
        return args
    }
    if name == "taint_unwrap" {
        return args
    }
    if name == "clock_ms" {
        return "hl_clock_ms()"
    }
    if name == "chr" {
        return "hl_chr(" + args + ")"
    }
    if name == "file_exists" {
        return "hl_file_exists(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # ----- Stage 8-beta: ownership primitives -----
    # drop(x): release the value now and null the binding so the
    # scope-exit cleanup is a no-op. The checker guarantees x is an
    # owned binding, so this is always a pointer type.
    if name == "drop" {
        let arg: int = ctx.exprs[e].args.get(0)
        let cn: str = local_c(ctx, ctx.exprs[arg].name)
        let t: str = ctx.exprs[arg].t
        return "((" + release_call(ctx, t, cn) + "), (" + cn + " = NULL, (void)0))"
    }
    # clone(x): dispatch to the per-instantiation helper generated by
    # gen_clone_bodies (str uses the runtime's hl_clone_str). tainted[T]
    # clones as T — the taint is a compile-time property only.
    if name == "clone" {
        let at: str = strip_taint(inst_t(ctx, ctx.exprs[ctx.exprs[e].args.get(0)].t))
        # Stage 16: a channel clones by SHARING (atomic refcount + 1) —
        # no per-instantiation deep-clone helper is registered.
        if is_chan_t(at) {
            return "hl_chan_clone(" + args + ")"
        }
        register_clone(ctx, at)
        if at == "str" {
            return "hl_clone_str(" + args + ")"
        }
        return "hl_clone_" + c_type_name(at) + "(" + args + ")"
    }
    # take(x): a compile-time move — at runtime it is just the value.
    # The binding is nulled at the end of the statement (null_after) so
    # the scope-exit cleanup is a no-op: ownership transfers.
    if name == "take" {
        let arg: int = ctx.exprs[e].args.get(0)
        let cn: str = local_c(ctx, ctx.exprs[arg].name)
        ctx.null_after.push(cn)
        return cn
    }
    # ----- Stage 9 release (v0.20.0-alpha): Net / Rand / Proc builtins -----
    # net_lookup(host: str) -> str — DNS A record lookup. The host
    # argument is an owned str (consumed by the runtime helper).
    if name == "net_lookup" {
        return "hl_net_lookup(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # rand_int(max: int) -> int — uniform random int in [0, max).
    if name == "rand_int" {
        return "hl_rand_int(" + args + ")"
    }
    # rand_float() -> float — uniform random float in [0.0, 1.0).
    if name == "rand_float" {
        return "hl_rand_float()"
    }
    # rand_seed(s: int) -> void — seed the PRNG.
    if name == "rand_seed" {
        return "hl_rand_seed(" + args + ")"
    }
    # proc_exec(cmd: str) -> int — run a shell command via system().
    # The command is an owned str (consumed by the runtime helper).
    if name == "proc_exec" {
        return "hl_proc_exec(" + gen_own_arg(ctx, ctx.exprs[e].args.get(0)) + ")"
    }
    # ----- Stage 16 (v0.27.0-alpha): concurrency builtins -----
    if name == "chan_new" {
        # The channel owns its pending messages: elem_release knows how to
        # release one pointer payload of T (NULL for primitives — they are
        # stored raw in the message union, not boxed).
        let mt: str = inst_t(ctx, ctx.exprs[e].t)
        let mut elem: str = "int"
        if is_chan_t(mt) {
            elem = strip_taint(chan_inner_t(mt))
        }
        let mut rel: str = "NULL"
        if elem != "int" && elem != "float" && elem != "bool" {
            rel = release_fn_for(ctx, elem)
        }
        return "hl_chan_new(" + rel + ")"
    }
    # chan_new_bounded(cap) — v0.29.0-alpha: same release-fn logic as
    # chan_new, plus the capacity expression (validated at runtime; the
    # checker already rejected literal capacities < 1).
    if name == "chan_new_bounded" {
        let mt2: str = inst_t(ctx, ctx.exprs[e].t)
        let mut elem2: str = "int"
        if is_chan_t(mt2) {
            elem2 = strip_taint(chan_inner_t(mt2))
        }
        let mut rel2: str = "NULL"
        if elem2 != "int" && elem2 != "float" && elem2 != "bool" {
            rel2 = release_fn_for(ctx, elem2)
        }
        let cap: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        return "hl_chan_new_bounded(" + cap + ", " + rel2 + ")"
    }
    if name == "spawn" {
        return gen_spawn_call(ctx, e)
    }
    if name == "select" {
        return "hl_chan_select(" + args + ")"
    }
    panic("internal codegen error: unknown builtin function " + name)
    return ""
}

# gen_spawn_call — codegen for spawn(f, a1, ..., aN) after the checker
# rewrite (mkey = "spawn", mop = target fn key, args = value args).
#
# Emits per-site helpers into ctx.spawn_decls (appended to the program):
#   typedef struct { ... } hl_sa_N_t;          — the argument tuple
#   static void* hl_mkargs_N(...)              — heap-allocates + fills it
#   static void hl_tramp_N(void*, hl_task*)    — calls usf_<fn>, stores the
#                                                 result, frees the tuple
# and returns the C expression `hl_spawn(hl_tramp_N, <argbox>)`.
#
# Boundary ownership rule (the data-race-freedom hardening): every OWNED
# argument that is not provably private (a str literal, or syntactically
# clone(...)) is deep-copied at the boundary. A value returned by a user
# function may alias a binding still live in the spawning thread (HLS
# assignment is reference semantics), so the defensive clone guarantees
# no non-atomic refcount is ever touched by two threads. Channels are
# exempt: their refcount is atomic and their state is guarded by the
# runtime mutex. Primitives carry no refcount at all.
fn gen_spawn_call(ctx: Ctx, e: int) -> str {
    let fname: str = ctx.exprs[e].mop
    let tf: FnInfo = ctx.fns.get_or(fname, dummy_fn())
    # Stage 20 (v0.36.0-alpha): the trampoline calls the target
    # out-of-line — count it so LTO DCE keeps the target body.
    lto_note_call(ctx, fname)
    let n: int = ctx.spawn_n
    ctx.spawn_n = ctx.spawn_n + 1
    let nid: str = n.to_str()

    # --- call-site argument expressions (with the boundary rule) ---
    let cargs: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let aidx: int = ctx.exprs[e].args.get(i)
        let pt: str = tf.ptypes.get(i)
        let cex: str = gen_expr(ctx, aidx)
        let argkind: str = ctx.exprs[aidx].kind
        let is_clone_call: bool = argkind == "call" && ctx.exprs[aidx].mkey == "clone"
        let mut bound: str = cex
        if pt == "int" || pt == "float" || pt == "bool" {
            # Copy primitives — no refcount, share freely.
            bound = cex
        } else if is_chan_t(pt) {
            # Channels cross by sharing (atomic refcount).
            bound = cex
        } else if is_clone_call || argkind == "str" || expr_fresh(ctx, aidx) {
            # clone(...) is already a private deep copy; a str literal is
            # a fresh allocation; and any FRESH expression result is
            # provably private (user fns return hl_retain-ed values — the
            # callee's return wrapper adds the retain; concats/to_str/
            # literals allocate). Deep-scan-10 fix: fresh values were
            # previously defensively cloned and the fresh original never
            # released — a leak on every spawn(f, a + b).
            bound = cex
        } else {
            # Borrowed composites (list.get(i) results, ...): defensive
            # deep copy at the boundary — the value may be aliased by
            # the spawner's container.
            bound = clone_expr_for(ctx, pt, cex)
        }
        cargs.push(bound)
        i = i + 1
    }

    # --- emit the top-level helpers ---
    let d: list[str] = []
    let sname: str = "hl_sa_" + nid + "_t"
    let cparams: list[str] = []
    let fields: list[str] = []
    let mut k: int = 0
    while k < tf.ptypes.len() {
        let pct: str = c_type(ctx, tf.ptypes.get(k))
        cparams.push(pct + " a" + k.to_str())
        fields.push("    " + pct + " f" + k.to_str() + ";")
        k = k + 1
    }
    if tf.ptypes.len() > 0 {
        d.push("typedef struct {")
        d.push(join(fields, "\n"))
        d.push("} " + sname + ";")
        d.push("static void* hl_mkargs_" + nid + "(" + join(cparams, ", ") + ") {")
        d.push("    " + sname + "* p = (" + sname + "*)malloc(sizeof(" + sname + "));")
        d.push("    if (!p) hl_die(\"out of memory\");")
        let mut m: int = 0
        while m < tf.ptypes.len() {
            d.push("    p->f" + m.to_str() + " = a" + m.to_str() + ";")
            m = m + 1
        }
        d.push("    return (void*)p;")
        d.push("}")
    }
    # The trampoline: call the target with the struct fields (raw — the
    # checker guaranteed each C value is owned; params own one retain),
    # free the tuple shell, then publish the result.
    d.push("static void hl_tramp_" + nid + "(void* pv, hl_task* t) {")
    let ret: str = tf.ret
    let mut arglist: list[str] = []
    let mut q: int = 0
    while q < tf.ptypes.len() {
        arglist.push("a->f" + q.to_str())
        q = q + 1
    }
    let callname: str = "usf_" + c_fn_name(fname) + "(" + join(arglist, ", ") + ")"
    if tf.ptypes.len() == 0 {
        if ret == "void" {
            d.push("    (void)pv;")
            d.push("    " + callname + ";")
            d.push("    hl_task_finish_ptr(t, NULL);")
        } else if ret == "int" || ret == "bool" {
            d.push("    (void)pv;")
            d.push("    int64_t r = " + callname + ";")
            d.push("    hl_task_finish_i64(t, r);")
        } else if ret == "float" {
            d.push("    (void)pv;")
            d.push("    double r = " + callname + ";")
            d.push("    hl_task_finish_f64(t, r);")
        } else {
            d.push("    (void)pv;")
            d.push("    void* r = (void*)" + callname + ";")
            d.push("    hl_task_finish_ptr(t, r);")
        }
    } else {
        d.push("    " + sname + "* a = (" + sname + "*)pv;")
        if ret == "void" {
            d.push("    " + callname + ";")
            d.push("    free(a);")
            d.push("    hl_task_finish_ptr(t, NULL);")
        } else if ret == "int" || ret == "bool" {
            d.push("    int64_t r = " + callname + ";")
            d.push("    free(a);")
            d.push("    hl_task_finish_i64(t, r);")
        } else if ret == "float" {
            d.push("    double r = " + callname + ";")
            d.push("    free(a);")
            d.push("    hl_task_finish_f64(t, r);")
        } else {
            d.push("    void* r = (void*)" + callname + ";")
            d.push("    free(a);")
            d.push("    hl_task_finish_ptr(t, r);")
        }
    }
    d.push("}")
    d.push("")
    let mut di: int = 0
    while di < d.len() {
        ctx.spawn_decls.push(d.get(di))
        di = di + 1
    }

    # --- the call-site expression ---
    if tf.ptypes.len() == 0 {
        return "hl_spawn(hl_tramp_" + nid + ", NULL)"
    }
    return "hl_spawn(hl_tramp_" + nid + ", hl_mkargs_" + nid + "(" + join(cargs, ", ") + "))"
}

fn gen_method(ctx: Ctx, e: int) -> str {
    if ctx.exprs[e].muser {
        # Stage 8-beta: the self parameter owns one retain of the
        # receiver (the method may mutate through the shared pointer;
        # the retain is released when the method returns).
        let recv_fresh: bool = expr_fresh(ctx, ctx.exprs[e].left)
        let t0: str = gen_expr(ctx, ctx.exprs[e].left)
        let recv: str = own_wrap(ctx, ctx.exprs[ctx.exprs[e].left].t, t0, recv_fresh)
        let rest: str = gen_own_args_c(ctx, e)
        # Stage 20: count the emitted out-of-line method call.
        lto_note_call(ctx, ctx.exprs[e].mkey)
        if ctx.exprs[e].args.len() == 0 {
            return "usf_" + c_fn_name(ctx.exprs[e].mkey) + "(" + recv + ")"
        }
        return "usf_" + c_fn_name(ctx.exprs[e].mkey) + "(" + recv + ", " + rest + ")"
    }
    let op: str = ctx.exprs[e].mop
    let t0: str = gen_expr(ctx, ctx.exprs[e].left)
    let args: str = gen_args_c(ctx, e)
    if op == "str.len" {
        return "hl_str_len(" + t0 + ")"
    }
    if op == "str.byte_at" {
        # Stage 17: -O fast — a bounds-proven access uses the unchecked
        # form.
        if ctx.fast_mode && ctx.exprs[e].bnd_safe {
            return "hl_str_byte_at_unchecked(" + t0 + ", " + args + ")"
        }
        return "hl_str_byte_at(" + t0 + ", " + args + ")"
    }
    if op == "str.slice" {
        if ctx.fast_mode && ctx.exprs[e].bnd_safe {
            return "hl_str_slice_unchecked(" + t0 + ", " + args + ")"
        }
        return "hl_str_slice(" + t0 + ", " + args + ")"
    }
    if op == "str.find" {
        return "hl_str_find(" + t0 + ", " + args + ")"
    }
    if op == "str.contains" {
        return "hl_str_contains(" + t0 + ", " + args + ")"
    }
    if op == "str.starts_with" {
        return "hl_str_starts_with(" + t0 + ", " + args + ")"
    }
    if op == "str.ends_with" {
        return "hl_str_ends_with(" + t0 + ", " + args + ")"
    }
    if op == "str.split" {
        return "hl_str_split(" + t0 + ", " + args + ")"
    }
    if op == "str.trim" {
        return "hl_str_trim(" + t0 + ")"
    }
    if op == "str.to_int" {
        return "hl_str_to_int(" + t0 + ")"
    }
    if op == "str.to_float" {
        return "hl_str_to_double(" + t0 + ")"
    }
    if op == "str.to_str" {
        return t0
    }
    if op == "int.to_str" {
        return "hl_str_from_int64(" + t0 + ")"
    }
    if op == "int.to_float" {
        return "((double)(" + t0 + "))"
    }
    if op == "int.abs" {
        return "hl_abs_i64(" + t0 + ")"
    }
    if op == "float.to_str" {
        return "hl_str_from_double(" + t0 + ")"
    }
    if op == "float.to_int" {
        return "hl_float_to_int(" + t0 + ")"
    }
    if op == "float.abs" {
        return "(((" + t0 + ") < 0) ? -(" + t0 + ") : (" + t0 + "))"
    }
    if op == "bool.to_str" {
        return "hl_str_from_bool(" + t0 + ")"
    }
    if op == "list.len" {
        return "hl_list_len(" + t0 + ")"
    }
    if op == "list.push" {
        # The value is stored into the container: the list owns one
        # retain (fresh raw / borrowed retain-wrapped / prim boxed).
        let et: str = list_elem_t(inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t))
        let aidx: int = ctx.exprs[e].args.get(0)
        let av: str = gen_expr(ctx, aidx)
        let af: bool = expr_fresh(ctx, aidx)
        return "hl_list_push(" + t0 + ", " + gen_store_val(ctx, et, av, af) + ")"
    }
    if op == "list.get" {
        return gen_unbox(ctx, ctx.exprs[e].t, "hl_list_get(" + t0 + ", " + args + ")")
    }
    if op == "list.set" {
        let et: str = list_elem_t(inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t))
        let ai: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        let aidx: int = ctx.exprs[e].args.get(1)
        let av: str = gen_expr(ctx, aidx)
        let af: bool = expr_fresh(ctx, aidx)
        return "hl_list_set(" + t0 + ", " + ai + ", " + gen_store_val(ctx, et, av, af) + ")"
    }
    if op == "list.pop" {
        # Primitive element lists use the typed pops (the box is freed
        # inside); pointer elements transfer ownership of the element.
        let et: str = list_elem_t(inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t))
        if et == "int" {
            return "hl_list_pop_i64(" + t0 + ")"
        }
        if et == "float" {
            return "hl_list_pop_f64(" + t0 + ")"
        }
        if et == "bool" {
            return "hl_list_pop_bool(" + t0 + ")"
        }
        return gen_unbox(ctx, ctx.exprs[e].t, "hl_list_pop(" + t0 + ")")
    }
    if op == "map.len" {
        return "hl_map_len(" + t0 + ")"
    }
    if op == "map.set" {
        # Key and value are stored into the map: it owns one retain of
        # each (fresh raw / borrowed retain-wrapped / prim boxed).
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        let vt: str = map_val_t(mt)
        let kidx: int = ctx.exprs[e].args.get(0)
        let ak: str = gen_expr(ctx, kidx)
        let kf: bool = expr_fresh(ctx, kidx)
        let vidx: int = ctx.exprs[e].args.get(1)
        let av: str = gen_expr(ctx, vidx)
        let vf: bool = expr_fresh(ctx, vidx)
        let kw: str = own_wrap(ctx, "str", ak, kf)
        return "hl_map_set(" + t0 + ", " + kw + ", " + gen_store_val(ctx, vt, av, vf) + ")"
    }
    if op == "map.get_or" {
        # Primitive-valued maps use the typed getters (the default is
        # passed by value — no boxing, no refcount traffic). Pointer-
        # valued maps use hl_map_get_own: the default arrives owned and
        # the result is returned owned.
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        let vt: str = map_val_t(mt)
        let ak: str = gen_expr(ctx, ctx.exprs[e].args.get(0))
        let ad_idx: int = ctx.exprs[e].args.get(1)
        let ad: str = gen_expr(ctx, ad_idx)
        if vt == "int" {
            return "hl_map_get_i64(" + t0 + ", " + ak + ", " + ad + ")"
        }
        if vt == "float" {
            return "hl_map_get_f64(" + t0 + ", " + ak + ", " + ad + ")"
        }
        if vt == "bool" {
            return "hl_map_get_bool(" + t0 + ", " + ak + ", " + ad + ")"
        }
        let adf: bool = expr_fresh(ctx, ad_idx)
        let adw: str = own_wrap(ctx, vt, ad, adf)
        return "((" + c_type(ctx, vt) + ")hl_map_get_own(" + t0 + ", " + ak + ", " + adw + "))"
    }
    if op == "map.has" {
        return "hl_map_has(" + t0 + ", " + args + ")"
    }
    if op == "map.keys" {
        return "hl_map_keys(" + t0 + ")"
    }
    # ----- Stage 16 (v0.27.0-alpha): Chan / Task methods -----
    if op == "chan.send" || op == "chan.try_send" {
        # Boundary ownership rule (same as spawn): a value crossing the
        # task boundary must arrive PRIVATE. Provably-private values
        # pass raw: a str literal (fresh allocation), clone(...) (a
        # private deep copy), and any FRESH expression result — user fn
        # calls return hl_retain-ed values (the callee's return wrapper
        # adds the retain), `+` concats / to_str() allocate, struct/enum
        # literals allocate. NON-fresh values (e.g. list.get(i), which
        # returns a borrow of the element the list still owns) are
        # deep-copied at the boundary — no refcount may be touched by
        # two threads. Deep-scan-10 fix: fresh values were previously
        # cloned too, and the fresh original was never released (a leak
        # on every ch.send(a + b)).
        # v0.29.0-alpha: try_send mirrors send exactly; the runtime
        # releases the private copy when a full bounded channel refuses.
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        let celem: str = chan_inner_t(mt)
        let vidx: int = ctx.exprs[e].args.get(0)
        let cex: str = gen_expr(ctx, vidx)
        let argkind: str = ctx.exprs[vidx].kind
        let is_clone_call: bool = argkind == "call" && ctx.exprs[vidx].mkey == "clone"
        let mut sendf: str = "hl_chan_send"
        if op == "chan.try_send" {
            sendf = "hl_chan_try_send"
        }
        if celem == "int" {
            return sendf + "_i64(" + t0 + ", " + cex + ")"
        }
        if celem == "float" {
            return sendf + "_f64(" + t0 + ", " + cex + ")"
        }
        if celem == "bool" {
            return sendf + "_i64(" + t0 + ", " + cex + " ? 1 : 0)"
        }
        # Channels cross by sharing (atomic refcount); provably private
        # values (clone(...), literals, fresh expression results) pass raw.
        if is_chan_t(celem) || is_clone_call || argkind == "str" || expr_fresh(ctx, vidx) {
            return sendf + "_ptr(" + t0 + ", (void*)" + cex + ")"
        }
        # Borrowed composites (list.get(i) results, ...): defensive deep
        # copy — the value may be aliased by the sender's container.
        let ct: str = strip_taint(celem)
        register_clone(ctx, ct)
        return sendf + "_ptr(" + t0 + ", (void*)" + clone_expr_for(ctx, ct, cex) + ")"
    }
    if op == "chan.recv" {
        # Message ownership transfers to the receiver (fresh result).
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        let celem: str = chan_inner_t(mt)
        if celem == "int" {
            return "hl_chan_recv_i64(" + t0 + ")"
        }
        if celem == "float" {
            return "hl_chan_recv_f64(" + t0 + ")"
        }
        if celem == "bool" {
            return "(hl_chan_recv_i64(" + t0 + ") != 0)"
        }
        return "((" + c_type(ctx, celem) + ")hl_chan_recv_ptr(" + t0 + "))"
    }
    if op == "chan.recv_or" {
        # Non-blocking recv (v0.29.0-alpha): the pending message if one
        # exists, else the caller's default. The result is fresh either
        # way: the message transfers its retain, or the default arrives
        # OWNED (own_wrap adds a retain for borrowed expressions; a
        # message being available makes the runtime release that retain
        # via the channel's elem_release — which owns exactly this type).
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        let celem: str = chan_inner_t(mt)
        let didx: int = ctx.exprs[e].args.get(0)
        let dexpr: str = gen_expr(ctx, didx)
        let dfresh: bool = expr_fresh(ctx, didx)
        if celem == "int" {
            return "hl_chan_recv_or_i64(" + t0 + ", " + dexpr + ")"
        }
        if celem == "float" {
            return "hl_chan_recv_or_f64(" + t0 + ", " + dexpr + ")"
        }
        if celem == "bool" {
            return "(hl_chan_recv_or_i64(" + t0 + ", " + dexpr + " ? 1 : 0) != 0)"
        }
        let dw: str = own_wrap(ctx, celem, dexpr, dfresh)
        return "((" + c_type(ctx, celem) + ")hl_chan_recv_or_ptr(" + t0 + ", (void*)" + dw + "))"
    }
    if op == "chan.len" {
        return "hl_chan_len(" + t0 + ")"
    }
    if op == "task.join" {
        # Result ownership transfers to the joiner (fresh result). The
        # mutex-ordered done-signal guarantees the task's own releases
        # happen-before the joiner touches the result.
        let mt: str = inst_t(ctx, ctx.exprs[ctx.exprs[e].left].t)
        let rt: str = task_inner_t(mt)
        if rt == "int" {
            return "hl_task_join_i64(" + t0 + ")"
        }
        if rt == "float" {
            return "hl_task_join_f64(" + t0 + ")"
        }
        if rt == "bool" {
            return "(hl_task_join_i64(" + t0 + ") != 0)"
        }
        if rt == "void" {
            return "hl_task_join_void(" + t0 + ")"
        }
        return "((" + c_type(ctx, rt) + ")hl_task_join_ptr(" + t0 + "))"
    }
    panic("internal codegen error: unknown method " + op)
    return ""
}

fn gen_listlit(ctx: Ctx, e: int) -> str {
    # Stage 8-beta: list literals are emitted INLINE as a GCC statement
    # expression. The old implementation emitted a separate `hl_lit_N`
    # helper function per literal, but the element expressions were
    # generated in the ENCLOSING function's context — any element that
    # referenced a local variable produced a C identifier that does not
    # exist inside the helper (BUG: `[a, b, 30]` with locals a, b failed
    # to compile natively). Inlining also gives the literal a natural
    # ownership story: the fresh list owns one retain of each element
    # (fresh raw / borrowed retain-wrapped / prim boxed).
    let elem: str = list_elem_t(inst_t(ctx, ctx.exprs[e].t))
    let tmp: str = fresh_tmp(ctx, "hlc_ll")
    let block: list[str] = []
    block.push("({")
    block.push("    hl_list* " + tmp + " = hl_list_new(" + elem_free_fn(ctx, elem) + ");")
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let aidx: int = ctx.exprs[e].args.get(i)
        let v: str = gen_expr(ctx, aidx)
        let fresh: bool = expr_fresh(ctx, aidx)
        block.push("    hl_list_push(" + tmp + ", " + gen_store_val(ctx, elem, v, fresh) + ");")
        i = i + 1
    }
    block.push("    " + tmp + ";")
    block.push("})")
    return join(block, "\n")
}

fn gen_structlit(ctx: Ctx, e: int) -> str {
    let st: StructInfo = ctx.structs.get_or(ctx.exprs[e].name, dummy_struct())
    # Substitute type params from current instantiation context.
    let mut t: str = ctx.exprs[e].t
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        t = instantiate_type(ctx.exprs[e].t, ctx.cur_typeparams, ctx.cur_targs)
    }
    # Record the (now concrete) instantiation for codegen.
    if st.typeparams.len() > 0 && type_is_concrete(ctx, t) && !list_has(ctx.struct_insts, t) {
        ctx.struct_insts.push(t)
    }
    # Compute the constructor name (mangled if generic).
    let ctor_name: str = "usf_new_" + c_type_name(t)
    # Collect provided field values. The constructor stores its params
    # raw, so each pointer-typed field value must arrive OWNED
    # (Stage 8-beta): fresh raw, borrowed retain-wrapped.
    let parts: list[str] = []
    let provided: list[str] = ctx.exprs[e].ffields
    let mut fi: int = 0
    while fi < provided.len() {
        let fidx: int = struct_field_index(st, provided.get(fi))
        let ftype: str = instantiate_field_type(st, fidx, t)
        let aidx: int = ctx.exprs[e].args.get(fi)
        let av: str = gen_expr(ctx, aidx)
        let af: bool = expr_fresh(ctx, aidx)
        parts.push(own_wrap(ctx, ftype, av, af))
        fi = fi + 1
    }
    # For each remaining declared field with a default, evaluate the default
    # (in the calling context) and pass it. The constructor stores its params
    # raw, so the default must arrive OWNED: fresh defaults pass raw, but
    # borrowed defaults (e.g. `args()` which returns the process-lifetime
    # global list) must be retain-wrapped — otherwise the struct's release
    # would decrement the global's refcount (BUG deep-scan-5: a default
    # like `argv: list[str] = args()` used to silently release the global
    # args list when the struct was dropped, freeing it for the rest of
    # the program). Use own_wrap with the instantiated field type so the
    # retain is balanced by the struct's release.
    let mut pi: int = provided.len()
    while pi < st.fields.len() {
        let dflt_idx: int = st.fdefaults.get(pi)
        if dflt_idx == -1 {
            panic("internal codegen error: missing required field " + st.fields.get(pi) + " in struct literal")
        }
        let dflt_ftype: str = instantiate_field_type(st, pi, t)
        let dflt_c: str = gen_expr(ctx, dflt_idx)
        let dflt_fresh: bool = expr_fresh(ctx, dflt_idx)
        parts.push(own_wrap(ctx, dflt_ftype, dflt_c, dflt_fresh))
        pi = pi + 1
    }
    return ctor_name + "(" + join(parts, ", ") + ")"
}

# struct_field_index: find a field's index in a StructInfo (-1 if absent).
fn struct_field_index(st: StructInfo, name: str) -> int {
    let mut i: int = 0
    while i < st.fields.len() {
        if st.fields.get(i) == name {
            return i
        }
        i = i + 1
    }
    return -1
}

# instantiate_field_type: substitute a struct's type params for one field
# using the concrete instantiation `t` (e.g. Box[int] -> field T becomes int).
fn instantiate_field_type(st: StructInfo, fidx: int, t: str) -> str {
    if fidx < 0 || fidx >= st.fields.len() {
        return "int"
    }
    let ftype: str = st.ftypes.get(fidx)
    if st.typeparams.len() == 0 {
        return ftype
    }
    let targs: list[str] = type_args(t)
    if targs.len() != st.typeparams.len() {
        return ftype
    }
    return instantiate_type(ftype, st.typeparams, targs)
}

fn gen_enumlit(ctx: Ctx, e: int) -> str {
    # The enum type is ctx.exprs[e].t (e.g., "Option[int]" or "Color").
    # Substitute type params from current instantiation context.
    let mut t: str = ctx.exprs[e].t
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        t = instantiate_type(ctx.exprs[e].t, ctx.cur_typeparams, ctx.cur_targs)
    }
    # Record the (now concrete) instantiation for codegen.
    let en: EnumInfo = ctx.enums.get_or(ctx.exprs[e].enum_name, dummy_enum())
    if en.typeparams.len() > 0 && type_is_concrete(ctx, t) && !list_has(ctx.enum_insts, t) {
        ctx.enum_insts.push(t)
    }
    # The constructor function name is "usf_make_" + c_type_name(t) + "" + "_" + variant.
    let ctor_name: str = "usf_make_" + c_type_name(t) + "_" + ctx.exprs[e].variant
    # The constructor stores its payloads raw, so each pointer-typed
    # payload must arrive OWNED (Stage 8-beta).
    let parts: list[str] = []
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let aidx: int = ctx.exprs[e].args.get(i)
        let av: str = gen_expr(ctx, aidx)
        let af: bool = expr_fresh(ctx, aidx)
        let pt: str = enum_payload_type(en, ctx.exprs[e].variant, i, t)
        parts.push(own_wrap(ctx, pt, av, af))
        i = i + 1
    }
    return ctor_name + "(" + join(parts, ", ") + ")"
}

# enum_payload_type: the instantiated payload type for variant `vname`,
# payload index `pidx`, of the concrete enum instantiation `t`.
fn enum_payload_type(en: EnumInfo, vname: str, pidx: int, t: str) -> str {
    let mut vidx: int = -1
    let mut i: int = 0
    while i < en.variants.len() {
        if en.variants.get(i) == vname {
            vidx = i
        }
        i = i + 1
    }
    if vidx < 0 {
        return "int"
    }
    let payloads: list[str] = en.payloads.get(vidx)
    if pidx < 0 || pidx >= payloads.len() {
        return "int"
    }
    let pt: str = payloads.get(pidx)
    if en.typeparams.len() == 0 {
        return pt
    }
    let targs: list[str] = type_args(t)
    if targs.len() != en.typeparams.len() {
        return pt
    }
    return instantiate_type(pt, en.typeparams, targs)
}

# gen_match_expr — emit a GCC statement expression for a match in expression
# position. Each arm is checked via tag comparison; the matching arm's body
# is the result.
fn gen_match_expr(ctx: Ctx, e: int) -> str {
    # The scrutinee's type (e.g., "Color" or "Option[int]") — use the
    # scrutinee expression's type, not the match's result type.
    # Substitute type params from current instantiation context (for generic
    # function instantiations).
    let raw_scrut_t: str = ctx.exprs[ctx.exprs[e].left].t
    let mut scrut_t: str = raw_scrut_t
    if ctx.cur_typeparams.len() > 0 && ctx.cur_targs.len() == ctx.cur_typeparams.len() {
        scrut_t = instantiate_type(raw_scrut_t, ctx.cur_typeparams, ctx.cur_targs)
    }
    let ename: str = type_base(scrut_t)
    let scrut_c: str = gen_expr(ctx, ctx.exprs[e].left)
    # BUG (deep-scan-5): match arm bindings are scoped to the arm only
    # (SPEC §5: "Pattern bindings in `match` arms introduce a new scope:
    # each arm's bindings shadow the outer scope for the duration of that
    # arm only"). Each arm binding becomes a C local declared inside the
    # match's statement expression — it goes OUT of C scope when the
    # statement expression exits. The codegen's `gen_locals` map is flat
    # (HLS name -> latest C name) and doesn't track C scope, so without
    # restoration, post-match references to an outer binding with the
    # same name as an arm binding resolved to the arm's now-dead C name
    # — producing `error: 'u_x_3' undeclared` from gcc. Snapshot
    # `gen_locals` BEFORE the arm-binding loop and restore it AFTER, so
    # post-match references resolve back to the outer binding's C name.
    # (`gen_counts` is NOT restored — arm bindings still consumed unique
    # counter values, so a later `let` with the same HLS name gets a
    # fresh C name that does not collide with the arm's.)
    let saved_locals: map[str, str] = map_new()
    let saved_keys: list[str] = ctx.gen_locals.keys()
    let mut si: int = 0
    while si < saved_keys.len() {
        let sk: str = saved_keys.get(si)
        saved_locals.set(sk, ctx.gen_locals.get_or(sk, ""))
        si = si + 1
    }
    # The statement expression uses a tmp variable for the scrutinee.
    # Stage 8-beta: when the scrutinee is a FRESH value (call result,
    # literal, ...), this tmp owns it — a cleanup attribute releases it
    # at the end of the statement expression. When it is borrowed, the
    # binding that owns it stays responsible.
    let scrut_fresh: bool = expr_fresh(ctx, ctx.exprs[e].left)
    let tmp_name: str = fresh_tmp(ctx, "hlc_m")
    let block: list[str] = []
    block.push("({")
    if is_ptr_t(ctx, scrut_t) && scrut_fresh {
        block.push("    " + c_type(ctx, scrut_t) + " " + tmp_name
            + " __attribute__((cleanup(" + cleanup_fn_for(ctx, scrut_t) + "))) = " + scrut_c + ";")
    } else {
        block.push("    " + c_type(ctx, scrut_t) + " " + tmp_name + " = " + scrut_c + ";")
    }
    # BUG-004 fix: if the match result type is `never` (e.g. all arms
    # are panic/exit), we must NOT declare a `hlc_m_r` accumulator —
    # `never` is not a valid C type. Emit the dispatch without an
    # accumulator and without a trailing `hlc_m_r;` value.
    let match_t: str = ctx.exprs[e].t
    let is_never: bool = match_t == "never"
    if !is_never {
        block.push("    " + c_type(ctx, match_t) + " hlc_m_r;")
    }
    block.push("    if (0) {}")
    let mut has_wildcard: bool = false
    let mut i: int = 0
    while i < ctx.exprs[e].args.len() {
        let arm_idx: int = ctx.exprs[e].args.get(i)
        let arm: MatchArm = ctx.match_arms.get(arm_idx)
        if arm.pat_kind == "wildcard" {
            has_wildcard = true
            block.push("    else {")
            # Stage 8-beta: arm-local hoisting — fresh pointer values in
            # borrowed positions within the arm body are materialised
            # INSIDE the arm block (they may reference the pattern
            # bindings, which only exist here).
            collect_hoist(ctx, arm.body)
            hoist_all(ctx, block, "        ")
            if arm.body_t != "never" {
                # Stage 8-beta: the arm result is OWNED — own-wrap borrow
                # bodies with a retain so hlc_m_r always owns one retain.
                let bv: str = gen_expr(ctx, arm.body)
                let bf: bool = expr_fresh(ctx, arm.body)
                block.push("        hlc_m_r = " + own_wrap(ctx, arm.body_t, bv, bf) + ";")
            } else {
                block.push("        " + gen_expr(ctx, arm.body) + ";")
            }
            clear_hoists(ctx)
            block.push("    }")
        } else {
            let cond: str = tmp_name + "->tag == " + ename + "__TAG_" + arm.variant + "_" + c_type_name(scrut_t)
            block.push("    else if (" + cond + ") {")
            # Bind payload values.
            let en: EnumInfo = ctx.enums.get_or(ename, dummy_enum())
            let mut vi: int = 0
            let mut vidx: int = -1
            while vi < en.variants.len() {
                if en.variants.get(vi) == arm.variant {
                    vidx = vi
                }
                vi = vi + 1
            }
            let payloads: list[str] = en.payloads.get(vidx)
            # Compute instantiated payload types.
            let typeparams: list[str] = en.typeparams
            let targs: list[str] = type_args(scrut_t)
            let mut bi: int = 0
            while bi < arm.bindings.len() {
                let bname: str = arm.bindings.get(bi)
                if bname != "_" {
                    let pt: str = payloads.get(bi)
                    let mut inst_pt: str = ""
                    if typeparams.len() > 0 {
                        inst_pt = instantiate_type(pt, typeparams, targs)
                    } else {
                        inst_pt = pt
                    }
                    let cn: str = fresh_local(ctx, bname)
                    # Enum payloads are stored DIRECTLY in the C union (not
                    # boxed), so we access them directly without unboxing.
                    # The union has per-variant structs: data.<Variant>.v<i>.
                    block.push("        " + c_type(ctx, inst_pt) + " " + cn + " = " + tmp_name + "->data." + arm.variant + ".v" + bi.to_str() + ";")
                }
                bi = bi + 1
            }
            if arm.body_t != "never" {
                # Stage 8-beta: arm-local hoisting (see wildcard arm), then
                # own-wrap borrow bodies so hlc_m_r always owns one retain.
                collect_hoist(ctx, arm.body)
                hoist_all(ctx, block, "        ")
                let bv: str = gen_expr(ctx, arm.body)
                let bf: bool = expr_fresh(ctx, arm.body)
                block.push("        hlc_m_r = " + own_wrap(ctx, arm.body_t, bv, bf) + ";")
                clear_hoists(ctx)
            } else {
                collect_hoist(ctx, arm.body)
                hoist_all(ctx, block, "        ")
                block.push("        " + gen_expr(ctx, arm.body) + ";")
                clear_hoists(ctx)
            }
            block.push("    }")
        }
        i = i + 1
    }
    # Only emit the fall-through "no arm matched" trap when no wildcard arm
    # is present — a wildcard already catches all unmatched cases.
    if !has_wildcard {
        block.push("    else { hl_die(\"match: no arm matched (internal)\"); }")
    }
    if !is_never {
        block.push("    hlc_m_r;")
    }
    block.push("})")
    # BUG (deep-scan-5): restore gen_locals to the pre-match state so
    # post-match references to outer bindings (that may have been
    # shadowed by arm bindings) resolve back to the outer binding's
    # C name. The arm bindings' C names went out of scope when the
    # statement expression exited; without this restore, local_c(name)
    # would return those dead names and gcc would fail.
    ctx.gen_locals = saved_locals
    # Append the block to the output (as a multi-line statement expression
    # embedded in the surrounding expression). We need to return the joined
    # string for inline use. Statement expressions can span lines.
    return join(block, "\n")
}

# gen_qmark_expr — emit a statement expression for `expr?`.
fn gen_qmark_expr(ctx: Ctx, e: int) -> str {
    let inner_t: str = ctx.exprs[ctx.exprs[e].left].t
    let ename: str = type_base(inner_t)
    let inner_c: str = gen_expr(ctx, ctx.exprs[e].left)
    let ok_v: str = ctx.exprs[e].ok_variant
    let err_v: str = ctx.exprs[e].err_variant
    let success_t: str = ctx.exprs[e].t
    let tmp_name: str = fresh_tmp(ctx, "hlc_q")
    # Stage 8-beta ownership discipline for `?`:
    #   * When the inner value is FRESH, this tmp owns it — a cleanup
    #     attribute releases the Result at the end of the statement
    #     expression (success path) .
    #   * Error path: `return hl_retain(tmp)` — the +1 goes to the caller
    #     and the cleanup (or the owning binding, for borrowed inners)
    #     balances it. This works uniformly for both fresh and borrowed
    #     inner values.
    #   * Success path: the payload is borrowed from the enum, so the
    #     result gets an explicit retain — the enum's own release (via
    #     the cleanup or its binding) cannot free it underneath us.
    let inner_fresh: bool = expr_fresh(ctx, ctx.exprs[e].left)
    let block: list[str] = []
    block.push("({")
    if is_ptr_t(ctx, inner_t) && inner_fresh {
        block.push("    " + c_type(ctx, inner_t) + " " + tmp_name
            + " __attribute__((cleanup(" + cleanup_fn_for(ctx, inner_t) + "))) = " + inner_c + ";")
    } else {
        block.push("    " + c_type(ctx, inner_t) + " " + tmp_name + " = " + inner_c + ";")
    }
    block.push("    if (" + tmp_name + "->tag == " + ename + "__TAG_" + err_v + "_" + c_type_name(inner_t) + ") {")
    block.push("        return hl_retain(" + tmp_name + ");")
    block.push("    }")
    # Success variant's payload is at data.<ok_v>.v0.
    if is_ptr_t(ctx, success_t) {
        block.push("    " + c_type(ctx, success_t) + " hlc_q_r = hl_retain(" + tmp_name + "->data." + ok_v + ".v0);")
    } else {
        block.push("    " + c_type(ctx, success_t) + " hlc_q_r = " + tmp_name + "->data." + ok_v + ".v0;")
    }
    block.push("    hlc_q_r;")
    block.push("})")
    return join(block, "\n")
}

# --- C statement generation ---

fn gen_stmt(ctx: Ctx, sidx: int, ind: str) -> void {
    let s: StmtN = ctx.stmts[sidx]
    if s.kind == "let" {
        # Stage 8-beta: hoist fresh pointer subexpressions consumed in
        # borrowed positions within the RHS, then bind. Pointer-typed
        # bindings get a cleanup attribute — released exactly at C block
        # exit (covers break/continue/return automatically).
        collect_hoist(ctx, s.value)
        hoist_all(ctx, ctx.out, ind)
        let cn: str = fresh_local(ctx, s.name)
        let fresh: bool = expr_fresh(ctx, s.value)
        # Stage 20 (v0.36.0-alpha): --lto — a call to an inlinable
        # function in let-position is inlined (body generated at this
        # statement; the result temp stands in for the call result).
        let v: str = gen_expr_maybe_inline(ctx, s.value, ind)
        # BUG-004 fix: if the RHS expression is `never`-typed (panic/exit/
        # all-never match), the C call returns void — we must not bind it
        # to a variable. Emit just the side-effect call.
        if ctx.exprs[s.value].t == "never" {
            ctx.out.push(ind + v + ";")
        } else {
            let wrapped: str = own_wrap(ctx, s.vtype, v, fresh)
            if is_ptr_t(ctx, s.vtype) {
                ctx.out.push(ind + c_type(ctx, s.vtype) + " " + cn
                    + " __attribute__((cleanup(" + cleanup_fn_for(ctx, s.vtype) + "))) = " + wrapped + ";")
            } else {
                ctx.out.push(ind + c_type(ctx, s.vtype) + " " + cn + " = " + wrapped + ";")
            }
        }
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
    } else if s.kind == "assign" {
        gen_assign(ctx, s, ind)
    } else if s.kind == "if" {
        collect_hoist(ctx, s.cond)
        hoist_all(ctx, ctx.out, ind)
        let c: str = gen_expr(ctx, s.cond)
        # Stage 19 (v0.35.0-alpha): PGO. Two profile sites per if: the
        # true-path count and the false-path count (ids are deterministic
        # per function: b:<fn>:<n>). Under --pgo-generate both paths get
        # counter increments (an else clause is synthesised when absent);
        # under --pgo-use a strongly-biased condition is wrapped with
        # __builtin_expect so gcc lays the hot path fall-through.
        let true_id: str = "b:" + ctx.cur_fn + ":" + ctx.pgo_fn_branch_n.to_str()
        let false_id: str = "b:" + ctx.cur_fn + ":" + (ctx.pgo_fn_branch_n + 1).to_str()
        ctx.pgo_fn_branch_n = ctx.pgo_fn_branch_n + 2
        let true_idx: int = pgo_site(ctx, true_id)
        let false_idx: int = pgo_site(ctx, false_id)
        let mut cond_c: str = c
        let hint: int = pgo_branch_hint(ctx, true_id, false_id)
        if hint >= 0 {
            cond_c = pgo_wrap_expect(c, hint)
        }
        ctx.out.push(ind + "if (" + cond_c + ") {")
        if ctx.pgo_gen {
            ctx.out.push(ind + "    __hlc_pgo_counts[" + true_idx.to_str() + "]++;")
        }
        gen_stmts(ctx, s.body, ind + "    ")
        if s.else_body.len() > 0 {
            ctx.out.push(ind + "} else {")
            if ctx.pgo_gen {
                ctx.out.push(ind + "    __hlc_pgo_counts[" + false_idx.to_str() + "]++;")
            }
            gen_stmts(ctx, s.else_body, ind + "    ")
        } else if ctx.pgo_gen {
            # No else branch in the source: synthesise one purely to
            # count the false path (semantically a no-op).
            ctx.out.push(ind + "} else {")
            ctx.out.push(ind + "    __hlc_pgo_counts[" + false_idx.to_str() + "]++;")
        }
        ctx.out.push(ind + "}")
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
    } else if s.kind == "while" {
        collect_hoist(ctx, s.cond)
        # If the condition contains hoisted temps, the plain `while (c)`
        # form would evaluate them ONCE before the loop — a semantic
        # change (fresh subexpressions must be re-evaluated per
        # iteration). Use the `while (1) { temps; if (!c) break; ... }`
        # transform so the temps (and their releases) are per-iteration.
        #
        # SCAN-C fix: hoist_all was called BEFORE pushing `while (1) {`,
        # so the hoisted temps were emitted OUTSIDE the loop body —
        # contradicting the adjacent comment. A condition like
        # `while len(f()) > 0` (where `f()` returns a fresh list) used
        # to call `f()` only ONCE before the loop, then reuse the same
        # stale pointer every iteration — leading to infinite loops or
        # use-after-free if the list was mutated. Emit the temps AFTER
        # the `while (1) {` line so they re-execute per iteration.
        #
        # Stage 19: PGO — one loop back-edge site per while
        # (l:<fn>:<n>), counted at the top of the body; the condition is
        # __builtin_expect-hinted from the back-edge count under
        # --pgo-use (a loop that never iterated -> expect 0).
        let backedge_id: str = "l:" + ctx.cur_fn + ":" + ctx.pgo_fn_loop_n.to_str()
        ctx.pgo_fn_loop_n = ctx.pgo_fn_loop_n + 1
        let backedge_idx: int = pgo_site(ctx, backedge_id)
        let lhint: int = pgo_loop_hint(ctx, backedge_id)
        if ctx.hoist_map.keys().len() > 0 {
            ctx.out.push(ind + "while (1) {")
            hoist_all(ctx, ctx.out, ind + "    ")
            let c: str = gen_expr(ctx, s.cond)
            let mut break_c: str = "if (!(" + c + ")) break;"
            if lhint == 1 {
                break_c = "if (!" + pgo_wrap_expect(c, 1) + ") break;"
            } else if lhint == 0 {
                break_c = "if (!" + pgo_wrap_expect(c, 0) + ") break;"
            }
            ctx.out.push(ind + "    " + break_c)
            if ctx.pgo_gen {
                ctx.out.push(ind + "    __hlc_pgo_counts[" + backedge_idx.to_str() + "]++;")
            }
            gen_stmts(ctx, s.body, ind + "    ")
            ctx.out.push(ind + "}")
        } else {
            let c: str = gen_expr(ctx, s.cond)
            let mut cond_c: str = c
            if lhint >= 0 {
                cond_c = pgo_wrap_expect(c, lhint)
            }
            ctx.out.push(ind + "while (" + cond_c + ") {")
            if ctx.pgo_gen {
                ctx.out.push(ind + "    __hlc_pgo_counts[" + backedge_idx.to_str() + "]++;")
            }
            gen_stmts(ctx, s.body, ind + "    ")
            ctx.out.push(ind + "}")
        }
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
    } else if s.kind == "for" {
        collect_hoist(ctx, s.iter)
        hoist_all(ctx, ctx.out, ind + "    ")
        let it_c: str = gen_expr(ctx, s.iter)
        let it_fresh: bool = expr_fresh(ctx, s.iter)
        let itn: str = fresh_tmp(ctx, "hlc_it")
        let itn_len: str = fresh_tmp(ctx, "hlc_n")
        let iv: str = fresh_tmp(ctx, "hlc_i")
        ctx.out.push(ind + "{")
        # Stage 8-beta: when the iterable is FRESH (call result, literal),
        # this loop owns it — the itn temp carries a cleanup attribute and
        # is released after the loop (including on break). A borrowed
        # iterable stays owned by its binding.
        if it_fresh {
            ctx.out.push(ind + "    hl_list* " + itn
                + " __attribute__((cleanup(hl_cleanup_list))) = " + it_c + ";")
        } else {
            ctx.out.push(ind + "    hl_list* " + itn + " = " + it_c + ";")
        }
        ctx.out.push(ind + "    int64_t " + itn_len + " = hl_list_len(" + itn + ");")
        ctx.out.push(ind + "    int64_t " + iv + ";")
        # Stage 19: PGO — for-loop back-edge site (l:<fn>:<n>). The
        # counter is the first statement of the loop body; the C for
        # condition gets an __builtin_expect hint under --pgo-use.
        let backedge_id: str = "l:" + ctx.cur_fn + ":" + ctx.pgo_fn_loop_n.to_str()
        ctx.pgo_fn_loop_n = ctx.pgo_fn_loop_n + 1
        let backedge_idx: int = pgo_site(ctx, backedge_id)
        let lhint: int = pgo_loop_hint(ctx, backedge_id)
        let mut for_cond: str = iv + " < " + itn_len
        if lhint >= 0 {
            for_cond = pgo_wrap_expect(for_cond, lhint)
        }
        ctx.out.push(ind + "    for (" + iv + " = 0; " + for_cond + "; " + iv + "++) {")
        if ctx.pgo_gen {
            ctx.out.push(ind + "        __hlc_pgo_counts[" + backedge_idx.to_str() + "]++;")
        }
        # BUG-SC-4 fix: if the loop body shrinks the list (e.g. xs.pop()),
        # hl_list_get(itn, iv) would panic with "array access out of bounds".
        # Bounds-check before access and break if the list is now shorter
        # than the snapshotted length (matching the interpreter's behavior).
        ctx.out.push(ind + "        if (" + iv + " >= hl_list_len(" + itn + ")) break;")
        let cn: str = fresh_local(ctx, s.name)
        let mut elem: str = s.vtype
        # Stage 8-beta: a pointer-typed loop variable borrows the element
        # from the list — the binding retains it and a cleanup releases it
        # at the end of each iteration (C re-declares the variable in a
        # fresh block scope per iteration). The list keeps its own retain.
        if is_ptr_t(ctx, elem) {
            ctx.out.push(ind + "        " + c_type(ctx, elem) + " " + cn
                + " __attribute__((cleanup(" + cleanup_fn_for(ctx, elem) + ")))"
                + " = hl_retain(" + gen_unbox(ctx, elem, "hl_list_get(" + itn + ", " + iv + ")") + ");")
        } else {
            ctx.out.push(ind + "        " + c_type(ctx, elem) + " " + cn
                + " = " + gen_unbox(ctx, elem, "hl_list_get(" + itn + ", " + iv + ")") + ";")
        }
        gen_stmts(ctx, s.body, ind + "        ")
        ctx.out.push(ind + "    }")
        ctx.out.push(ind + "}")
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
    } else if s.kind == "return" {
        if s.value == -1 {
            ctx.out.push(ind + "return;")
        } else {
            # BUG-004 fix: if the return value expression is `never`-typed
            # (e.g. `return panic("...")` or `return match_all_never`),
            # emit just the side-effect call without a `return <value>;`
            # wrapper (the value is void and the surrounding code is
            # unreachable anyway — the call itself exits the process).
            # Stage 20: --lto — return-position calls inline too.
            let v: str = gen_expr_maybe_inline(ctx, s.value, ind)
            if ctx.exprs[s.value].t == "never" {
                ctx.out.push(ind + v + ";")
            } else {
                # Stage 8-beta ownership on return:
                #   * A BORROWED pointer value (an ident) gets one retain —
                #     the caller owns it; the binding's own retain is
                #     released by its cleanup as the scope exits.
                #   * A FRESH value transfers its inherent retain.
                #   * If the value moved bindings out via take(), null
                #     them BEFORE the return (an `x = NULL` after the
                #     return would be unreachable).
                let fresh: bool = expr_fresh(ctx, s.value)
                let rv: str = own_wrap(ctx, ctx.exprs[s.value].t, v, fresh)
                # Stage-17 perfection (v0.30.0-alpha): under --contracts
                # the ENSURES assertion is checked at EVERY return, with
                # `result` bound to the return value (the interpreter
                # already checks both clauses; the native backend
                # previously checked requires only — a documented gap,
                # now closed). The value is materialised into a temp so
                # the postcondition sees exactly what the caller gets.
                let mut want_ens: bool = false
                if ctx.contracts_mode && ctx.cur_fn != "" {
                    let ef: FnInfo = ctx.fns.get_or(ctx.cur_fn, dummy_fn())
                    if ef.ensures_e >= 0 {
                        want_ens = true
                    }
                }
                if want_ens {
                    let rt: str = ctx.exprs[s.value].t
                    let rt_c: str = c_type(ctx, rt)
                    let tmp: str = fresh_tmp(ctx, "hlc_rv")
                    ctx.out.push(ind + "{ " + rt_c + " " + tmp + " = " + rv + ";")
                    flush_null_after(ctx, ind + "    ")
                    let ef2: FnInfo = ctx.fns.get_or(ctx.cur_fn, dummy_fn())
                    ctx.gen_locals.set("result", tmp)
                    ctx.out.push(ind + "    if (!(" + gen_expr(ctx, ef2.ensures_e)
                        + ")) hl_die(\"contract violation: ensures of '"
                        + ef2.name + "' (function postcondition failed at runtime)\");")
                    ctx.out.push(ind + "    return " + tmp + "; }")
                } else if ctx.null_after.len() > 0 {
                    let rt: str = ctx.exprs[s.value].t
                    let rt_c: str = c_type(ctx, rt)
                    if rt == "void" {
                        ctx.out.push(ind + v + ";")
                    } else {
                        let tmp: str = fresh_tmp(ctx, "hlc_rv")
                        ctx.out.push(ind + "{ " + rt_c + " " + tmp + " = " + rv + ";")
                        flush_null_after(ctx, ind + "    ")
                        ctx.out.push(ind + "    return " + tmp + "; }")
                    }
                } else {
                    ctx.out.push(ind + "return " + rv + ";")
                }
            }
        }
    } else if s.kind == "break" {
        ctx.out.push(ind + "break;")
    } else if s.kind == "continue" {
        ctx.out.push(ind + "continue;")
    } else if s.kind == "expr" {
        collect_hoist(ctx, s.e)
        hoist_all(ctx, ctx.out, ind)
        # Stage 8-beta: a discarded FRESH pointer value (e.g. `make();`
        # or a match used as a statement) still owns one retain — wrap it
        # in a cleanup temp so it is released instead of leaked.
        if is_ptr_t(ctx, ctx.exprs[s.e].t) && expr_fresh(ctx, s.e) {
            let tmp: str = fresh_tmp(ctx, "hlc_ed")
            ctx.out.push(ind + "{ " + c_type(ctx, ctx.exprs[s.e].t) + " " + tmp
                + " __attribute__((cleanup(" + cleanup_fn_for(ctx, ctx.exprs[s.e].t) + "))) = "
                + gen_expr_maybe_inline(ctx, s.e, ind) + "; }")
        } else {
            # Stage 20: --lto — expression-statement calls inline (void
            # callees or discarded results).
            ctx.out.push(ind + gen_expr_maybe_inline(ctx, s.e, ind) + ";")
        }
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
    } else {
        panic("internal codegen error: unknown statement " + s.kind)
    }
}

fn gen_stmts(ctx: Ctx, stmts: list[int], ind: str) -> void {
    let mut i: int = 0
    while i < stmts.len() {
        gen_stmt(ctx, stmts.get(i), ind)
        i = i + 1
    }
}

fn gen_assign(ctx: Ctx, s: StmtN, ind: str) -> void {
    let tgt: int = s.target
    collect_hoist(ctx, s.value)
    # Hoist fresh subexpressions of the assignment TARGET too (e.g. a
    # call result whose field is assigned: `f().name = "x"`).
    collect_hoist(ctx, tgt)
    hoist_all(ctx, ctx.out, ind)
    let v: str = gen_expr(ctx, s.value)
    # BUG-004 fix: if the RHS is `never`-typed (e.g. `x = panic("...")`),
    # emit just the side-effect call without the assignment — the assignment
    # target is unreachable code.
    if ctx.exprs[s.value].t == "never" {
        ctx.out.push(ind + v + ";")
        flush_null_after(ctx, ind)
        clear_hoists(ctx)
        return
    }
    let fresh: bool = expr_fresh(ctx, s.value)
    if ctx.exprs[tgt].kind == "ident" {
        let cn: str = local_c(ctx, ctx.exprs[tgt].name)
        let tgt_t: str = ctx.exprs[tgt].t
        if is_ptr_t(ctx, tgt_t) {
            # Stage 8-beta: release the old value AFTER storing the new
            # one (self-assignment safe: the new value is retained or
            # fresh before the old pointer is released).
            let wrapped: str = own_wrap(ctx, tgt_t, v, fresh)
            ctx.out.push(ind + "{ " + c_type(ctx, tgt_t) + " __hl_old = " + cn + "; "
                + cn + " = " + wrapped + "; " + release_call(ctx, tgt_t, "__hl_old") + "; }")
        } else {
            ctx.out.push(ind + cn + " = " + v + ";")
        }
    } else if ctx.exprs[tgt].kind == "field" {
        let base_t: str = ctx.exprs[ctx.exprs[tgt].left].t
        let base: str = gen_expr(ctx, ctx.exprs[tgt].left)
        let ftype: str = ctx.exprs[tgt].t
        let fname: str = ctx.exprs[tgt].name
        if is_ptr_t(ctx, ftype) {
            # Materialise the base once (calling it twice would
            # double-evaluate), then store-then-release.
            let bt: str = fresh_tmp(ctx, "hlc_fb")
            let wrapped: str = own_wrap(ctx, ftype, v, fresh)
            ctx.out.push(ind + "{ " + c_type(ctx, base_t) + " " + bt + " = " + base + ";")
            ctx.out.push(ind + "  " + c_type(ctx, ftype) + " __hl_old = " + bt + "->" + fname + ";")
            ctx.out.push(ind + "  " + bt + "->" + fname + " = " + wrapped + ";")
            ctx.out.push(ind + "  " + release_call(ctx, ftype, "__hl_old") + "; }")
        } else {
            ctx.out.push(ind + "(" + base + ")->" + fname + " = " + v + ";")
        }
    } else {
        let elem_t: str = list_elem_t(ctx.exprs[ctx.exprs[tgt].left].t)
        let lst: str = gen_expr(ctx, ctx.exprs[tgt].left)
        let idx: str = gen_expr(ctx, ctx.exprs[tgt].right)
        # hl_list_set releases the old element itself (store-then-release
        # inside the runtime); the new value arrives owned.
        let wrapped: str = gen_store_val(ctx, elem_t, v, fresh)
        ctx.out.push(ind + "hl_list_set(" + lst + ", " + idx + ", " + wrapped + ");")
    }
    flush_null_after(ctx, ind)
    clear_hoists(ctx)
}


# --- Function generation ---

fn gen_reset_fn(ctx: Ctx) -> void {
    ctx.gen_locals = map_new()
    ctx.gen_counts = map_new()
    ctx.hoist_map = map_new()
    ctx.null_after = []
    ctx.cur_fn = ""
    # Stage 19 (v0.35.0-alpha): reset the per-function branch / loop
    # site-id sequence numbers (site ids embed them: b:<fn>:<n>).
    ctx.pgo_fn_branch_n = 0
    ctx.pgo_fn_loop_n = 0
}

# gen_param_locals: Stage 8-beta — function parameters OWN one retain of
# each argument. C cannot attach a cleanup attribute to a parameter, so
# the signature uses a `<name>_p` parameter and the body starts with a
# local `u_<name>` copy carrying the cleanup attribute. The body's code
# references the local (via gen_locals), never the raw parameter.
fn gen_param_locals(ctx: Ctx, f: FnInfo, ptypes_c: list[str], param_local_names: list[str], sig_params: list[str]) -> void {
    let mut i: int = 0
    while i < f.params.len() {
        let cn: str = fresh_local(ctx, f.params.get(i))
        param_local_names.push(cn)
        sig_params.push(ptypes_c.get(i) + " " + cn + "_p")
        i = i + 1
    }
}

# emit_param_local_decls: emit the `u_x = u_x_p` declarations (with
# cleanups for pointer types) at the top of a function body.
fn emit_param_local_decls(ctx: Ctx, f: FnInfo, inst_ptypes: list[str], param_local_names: list[str]) -> void {
    let mut i: int = 0
    while i < f.params.len() {
        let cn: str = param_local_names.get(i)
        let pt: str = inst_ptypes.get(i)
        if is_ptr_t(ctx, pt) {
            ctx.out.push("    " + c_type(ctx, pt) + " " + cn
                + " __attribute__((cleanup(" + cleanup_fn_for(ctx, pt) + "))) = " + cn + "_p;")
        } else {
            ctx.out.push("    " + c_type(ctx, pt) + " " + cn + " = " + cn + "_p;")
        }
        i = i + 1
    }
}


# fn_has_elisions: does any expression in the fn body carry a proof
# annotation? Under -O fast such fns MUST emit their entry requires
# assertion — an elided check is only sound when the precondition that
# proved it is enforced (see SPEC §26.4).
fn fn_has_elisions(ctx: Ctx, stmts: list[int]) -> bool {
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if stmt_exprs_have_elisions(ctx, s.value) { return true }
        if stmt_exprs_have_elisions(ctx, s.cond) { return true }
        if stmt_exprs_have_elisions(ctx, s.iter) { return true }
        if stmt_exprs_have_elisions(ctx, s.e) { return true }
        if s.target >= 0 {
            if exprs_have_elisions(ctx, s.target) { return true }
        }
        if stmts_have_elisions(ctx, s.body) { return true }
        if stmts_have_elisions(ctx, s.else_body) { return true }
        i = i + 1
    }
    return false
}

fn stmts_have_elisions(ctx: Ctx, stmts: list[int]) -> bool {
    let mut i: int = 0
    while i < stmts.len() {
        let s: StmtN = ctx.stmts.get(stmts.get(i))
        if stmt_exprs_have_elisions(ctx, s.value) { return true }
        if stmt_exprs_have_elisions(ctx, s.cond) { return true }
        if stmt_exprs_have_elisions(ctx, s.iter) { return true }
        if stmt_exprs_have_elisions(ctx, s.e) { return true }
        if s.target >= 0 {
            if exprs_have_elisions(ctx, s.target) { return true }
        }
        if stmts_have_elisions(ctx, s.body) { return true }
        if stmts_have_elisions(ctx, s.else_body) { return true }
        i = i + 1
    }
    return false
}

fn stmt_exprs_have_elisions(ctx: Ctx, e: int) -> bool {
    return exprs_have_elisions(ctx, e)
}

fn exprs_have_elisions(ctx: Ctx, e: int) -> bool {
    if e < 0 {
        return false
    }
    let n: ExprN = ctx.exprs[e]
    if n.ovf_safe || n.div_safe || n.bnd_safe {
        return true
    }
    if exprs_have_elisions(ctx, n.left) { return true }
    if exprs_have_elisions(ctx, n.right) { return true }
    let mut i: int = 0
    while i < n.args.len() {
        if exprs_have_elisions(ctx, n.args.get(i)) { return true }
        i = i + 1
    }
    if n.kind == "match" {
        let mut a: int = 0
        while a < n.args.len() {
            let arm: MatchArm = ctx.match_arms.get(n.args.get(a))
            if exprs_have_elisions(ctx, arm.body) { return true }
            a = a + 1
        }
    }
    return false
}

fn gen_fn_body(ctx: Ctx, key: str) -> void {
    let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
    # Stage 15-beta: extern fns are forward declarations for C functions.
    # Emit just the prototype (no body) using the RAW C name (no `usf_`
    # prefix) so the C linker can resolve them from libc.
    if f.is_extern {
        gen_reset_fn(ctx)
        let ptypes_c: list[str] = []
        let mut i: int = 0
        while i < f.params.len() {
            ptypes_c.push(c_type(ctx, f.ptypes.get(i)))
            i = i + 1
        }
        let mut sig: str = c_type(ctx, f.ret) + " " + f.name + "("
        if ptypes_c.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(ptypes_c, ", ") + ")"
        }
        ctx.out.push(sig + ";")
        ctx.out.push("")
        return
    }
    gen_reset_fn(ctx)
    # v0.30.0-alpha: record the fn key for the return handler's ensures
    # checks (gen_reset_fn just cleared it).
    ctx.cur_fn = key
    let ptypes_c: list[str] = []
    let inst_ptypes: list[str] = []
    let mut i: int = 0
    while i < f.params.len() {
        inst_ptypes.push(f.ptypes.get(i))
        ptypes_c.push(c_type(ctx, f.ptypes.get(i)))
        i = i + 1
    }
    # Stage 8-beta: parameters own one retain of each argument. The
    # signature carries `<name>_p` params; the body starts with owned
    # local copies (see gen_param_locals / emit_param_local_decls).
    let param_local_names: list[str] = []
    let sig_params: list[str] = []
    gen_param_locals(ctx, f, ptypes_c, param_local_names, sig_params)
    # For generic functions, we emit a specialization. The "key" passed in is
    # the original key; we generate a specialization with a mangled name when
    # the function has type params. The specialization instantiation is
    # handled in gen_program by enumerating instantiations.
    let mut fname: str = "usf_" + c_fn_name(key)
    # BUG-010 fix: removed dead branch that built a mangled name from the
    # type-parameter NAMES (e.g. "T") instead of the type ARGS (e.g. "int").
    # That branch was unreachable because gen_program never routes generic
    # functions through gen_fn_body — they go through gen_fn_inst_lines.
    let mut sig: str = c_type(ctx, f.ret) + " " + fname + "("
    if sig_params.len() == 0 {
        sig = sig + "void)"
    } else {
        sig = sig + join(sig_params, ", ") + ")"
    }
    # Stage 19 (v0.35.0-alpha): --pgo-use — annotate the function
    # signature hot/cold from the loaded profile (entry counts).
    # Stage 20: record the body's start index for LTO phase-B splicing.
    # Stage 28+29 (v0.45.0-alpha): the signature prefix now also
    # carries the user attributes (#[inline(always)], #[hot], #[cold],
    # #[no_red_zone], #[irq_handler]). When a Stage 29 attribute is
    # set, it OVERRIDES the PGO hint (the user's explicit decision
    # wins). When no Stage 29 attribute is set, the PGO profile is
    # consulted as before.
    let sig_start: int = ctx.out.len()
    ctx.lto_fn_start.set(key, sig_start)
    ctx.out.push(fn_attr_prefix(ctx, f, key) + sig + " {")
    emit_param_local_decls(ctx, f, inst_ptypes, param_local_names)
    # Stage 19: PGO — function-entry counter site (e:<fnkey>), emitted
    # under --pgo-generate as the first statement of the body.
    let entry_idx: int = pgo_site(ctx, "e:" + key)
    if ctx.pgo_gen {
        if entry_idx >= PGO_MAX_SITES() {
            panic("pgo: too many profile sites (limit 65536)")
        }
        ctx.out.push("    __hlc_pgo_counts[" + entry_idx.to_str() + "]++;")
    }
    # Stage 17 (v0.28.0-alpha): --contracts — emit the runtime `requires`
    # assertion at the function entry. The requires expression was checked
    # in the params-only scope, so every ident resolves to a param local.
    # SOUNDNESS: under -O fast the assertion is ALSO emitted when the fn
    # body contains proof-elided operations — an elided check is only
    # sound when the precondition that proved it is enforced.
    let mut want_req_check: bool = false
    if ctx.contracts_mode && f.requires_e >= 0 {
        want_req_check = true
    }
    if ctx.fast_mode && f.requires_e >= 0 && fn_has_elisions(ctx, f.body) {
        want_req_check = true
    }
    if want_req_check {
        let rc: str = gen_expr(ctx, f.requires_e)
        ctx.out.push("    if (!(" + rc + ")) hl_die(\"contract violation: requires of '"
            + f.name + "' (function precondition failed at runtime)\");")
    }
    gen_stmts(ctx, f.body, "    ")
    ctx.out.push("}")
    ctx.out.push("")
    # Stage 19: record the emitted body size; under --pgo-use, hot small
    # functions get a `static inline` hint retroactively patched onto the
    # already-pushed signature line (the prototype emitted later consults
    # the same map, so both stay consistent).
    # Stage 28+29 (v0.45.0-alpha): the retro-patch is ONLY for the PGO
    # path. When an explicit #[inline(always)] / #[inline(never)] /
    # #[hot] / #[cold] attribute is set, the prefix is already correct
    # on the signature line (the user attribute is emitted by
    # fn_attr_prefix above); no retro-patch is needed (and would be a
    # no-op: fn_inline_attr returns the same string on both calls).
    ctx.pgo_fn_sizes.set(key, ctx.out.len() - sig_start)
    if f.attr_inline == "" && pgo_fn_inline(ctx, key) {
        ctx.out.set(sig_start, "static inline " + ctx.out.get(sig_start))
    }
}

fn gen_struct_lines(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let names: list[str] = ctx.structs.keys()
    let mut i: int = 0
    while i < names.len() {
        let st: StructInfo = ctx.structs.get_or(names.get(i), dummy_struct())
        # For non-generic structs, emit a typedef and constructor.
        # For generic structs, the instantiations are emitted separately
        # (driven by gen_program which tracks all instantiations used).
        if st.typeparams.len() == 0 {
            let empty_targs: list[str] = []
            concat_lines(out, gen_one_struct_full(ctx, st.name, st, empty_targs))
        }
        i = i + 1
    }
    return out
}

# gen_one_struct_full: typedef (refcnt first) + constructor + release +
# cleanup for one struct definition (targs empty for non-generic).
fn gen_one_struct_full(ctx: Ctx, c_name: str, st: StructInfo, targs: list[str]) -> list[str] {
    let mut out: list[str] = []
    # 1. typedef — refcnt is the FIRST field so hl_retain works uniformly.
    out.push("typedef struct " + c_name + " {")
    out.push("    int64_t refcnt;")
    let mut j: int = 0
    while j < st.fields.len() {
        let ftype: str = st.ftypes.get(j)
        let mut inst_ftype: str = ""
        if st.typeparams.len() > 0 {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        } else {
            inst_ftype = ftype
        }
        out.push("    " + c_type(ctx, inst_ftype) + " " + st.fields.get(j) + ";")
        j = j + 1
    }
    out.push("} " + c_name + ";")
    out.push("")
    # 2. constructor — stores its params raw: they arrive OWNED (the
    # call site own-wraps each field value). refcnt starts at 1.
    # The constructor takes ALL fields as parameters — gen_structlit
    # passes the provided values plus the default expressions evaluated
    # at the literal site (fresh values whose ownership transfers here).
    let ptypes_c: list[str] = []
    let assigns: list[str] = []
    let mut j2: int = 0
    while j2 < st.fields.len() {
        let ftype: str = st.ftypes.get(j2)
        let mut inst_ftype: str = ""
        if st.typeparams.len() > 0 {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        } else {
            inst_ftype = ftype
        }
        ptypes_c.push(c_type(ctx, inst_ftype) + " " + st.fields.get(j2))
        assigns.push("    p->" + st.fields.get(j2) + " = " + st.fields.get(j2) + ";")
        j2 = j2 + 1
    }
    out.push("static " + c_name + "* usf_new_" + c_name + "(" + join(ptypes_c, ", ") + ") {")
    out.push("    " + c_name + "* p = (" + c_name + "*)malloc(sizeof(" + c_name + "));")
    out.push("    if (!p) hl_die(\"out of memory\");")
    out.push("    p->refcnt = 1;")
    let mut k: int = 0
    while k < assigns.len() {
        out.push(assigns.get(k))
        k = k + 1
    }
    out.push("    return p;")
    out.push("}")
    out.push("")
    # 3. release + cleanup (Stage 8-beta).
    concat_lines(out, gen_struct_release_lines(ctx, c_name, st, targs))
    return out
}

# gen_struct_release_lines: the refcounted destructor + cleanup wrapper.
# Only the pointer-typed fields are released; primitives are inline C data.
fn gen_struct_release_lines(ctx: Ctx, c_name: str, st: StructInfo, targs: list[str]) -> list[str] {
    let mut out: list[str] = []
    out.push("static void hl_release_" + c_name + "(void* pv) {")
    out.push("    " + c_name + "* p = (" + c_name + "*)pv;")
    out.push("    if (!p) return;")
    out.push("    if (--p->refcnt == 0) {")
    let mut j: int = 0
    while j < st.fields.len() {
        let ftype: str = st.ftypes.get(j)
        let mut inst_ftype: str = ""
        if st.typeparams.len() > 0 {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        } else {
            inst_ftype = ftype
        }
        if is_ptr_t(ctx, inst_ftype) {
            out.push("        " + release_call(ctx, inst_ftype, "p->" + st.fields.get(j)) + ";")
        }
        j = j + 1
    }
    out.push("        free(p);")
    out.push("    }")
    out.push("}")
    out.push("static void hl_cleanup_" + c_name + "(" + c_name + "** p) { hl_release_" + c_name + "(*p); }")
    out.push("")
    return out
}

# gen_one_enum_full(ctx, c_name, en, targs) emits a complete C enum definition +
# variant constructors + release/cleanup. `c_name` is the mangled C identifier
# (e.g., "Option__int"), `en` is the EnumInfo, `targs` are the concrete type args
# (parallel to en.typeparams, empty for non-generic).
fn gen_one_enum_full(ctx: Ctx, c_name: str, en: EnumInfo, targs: list[str]) -> list[str] {
    let mut out: list[str] = []
    # 1. Tag enum.
    out.push("typedef enum {")
    let mut vi: int = 0
    let mut tag_line: str = "    "
    while vi < en.variants.len() {
        if vi > 0 {
            tag_line = tag_line + ", "
        }
        tag_line = tag_line + en.name + "__TAG_" + en.variants.get(vi) + "_" + c_name
        vi = vi + 1
    }
    out.push(tag_line)
    out.push("} " + c_name + "_Tag;")
    out.push("")
    # 2. Struct with refcnt + tag + union of PER-VARIANT structs (each
    # variant has its own struct containing all its payloads, so payloads
    # don't overlap).
    out.push("typedef struct " + c_name + " {")
    out.push("    int64_t refcnt;")
    out.push("    " + c_name + "_Tag tag;")
    out.push("    union {")
    let mut vi2: int = 0
    while vi2 < en.variants.len() {
        let payloads: list[str] = en.payloads.get(vi2)
        let vname: str = en.variants.get(vi2)
        if payloads.len() > 0 {
            out.push("        struct {")
            let mut pi: int = 0
            while pi < payloads.len() {
                let pt: str = payloads.get(pi)
                let mut inst_pt: str = ""
                if en.typeparams.len() > 0 {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                } else {
                    inst_pt = pt
                }
                out.push("            " + c_type(ctx, inst_pt) + " v" + pi.to_str() + ";")
                pi = pi + 1
            }
            out.push("        } " + vname + ";")
        }
        vi2 = vi2 + 1
    }
    out.push("    } data;")
    out.push("} " + c_name + ";")
    out.push("")
    # 3. Constructor per variant — stores its payloads raw (they arrive
    # OWNED from the call site). refcnt starts at 1.
    let mut vi3: int = 0
    while vi3 < en.variants.len() {
        let vname: str = en.variants.get(vi3)
        let payloads: list[str] = en.payloads.get(vi3)
        let params: list[str] = []
        let mut pi2: int = 0
        while pi2 < payloads.len() {
            let pt: str = payloads.get(pi2)
            let mut inst_pt: str = ""
            if en.typeparams.len() > 0 {
                inst_pt = instantiate_type(pt, en.typeparams, targs)
            } else {
                inst_pt = pt
            }
            params.push(c_type(ctx, inst_pt) + " v" + pi2.to_str())
            pi2 = pi2 + 1
        }
        let mut param_sig: str = "void"
        if params.len() > 0 {
            param_sig = join(params, ", ")
        }
        out.push("static " + c_name + "* usf_make_" + c_name + "_" + vname + "(" + param_sig + ") {")
        out.push("    " + c_name + "* p = (" + c_name + "*)malloc(sizeof(" + c_name + "));")
        out.push("    if (!p) hl_die(\"out of memory\");")
        out.push("    p->refcnt = 1;")
        out.push("    p->tag = " + en.name + "__TAG_" + vname + "_" + c_name + ";")
        let mut pi3: int = 0
        while pi3 < payloads.len() {
            out.push("    p->data." + vname + ".v" + pi3.to_str() + " = v" + pi3.to_str() + ";")
            pi3 = pi3 + 1
        }
        out.push("    return p;")
        out.push("}")
        out.push("")
        vi3 = vi3 + 1
    }
    # 4. release + cleanup (Stage 8-beta). Only the ACTIVE variant's
    # payloads are valid to read — dispatch on the tag.
    out.push("static void hl_release_" + c_name + "(void* pv) {")
    out.push("    " + c_name + "* p = (" + c_name + "*)pv;")
    out.push("    if (!p) return;")
    out.push("    if (--p->refcnt == 0) {")
    out.push("        switch (p->tag) {")
    let mut vi4: int = 0
    while vi4 < en.variants.len() {
        let vname: str = en.variants.get(vi4)
        let payloads: list[str] = en.payloads.get(vi4)
        if payloads.len() > 0 {
            out.push("            case " + en.name + "__TAG_" + vname + "_" + c_name + ":")
            let mut pi4: int = 0
            while pi4 < payloads.len() {
                let pt: str = payloads.get(pi4)
                let mut inst_pt: str = ""
                if en.typeparams.len() > 0 {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                } else {
                    inst_pt = pt
                }
                if is_ptr_t(ctx, inst_pt) {
                    out.push("                " + release_call(ctx, inst_pt, "p->data." + vname + ".v" + pi4.to_str()) + ";")
                }
                pi4 = pi4 + 1
            }
            out.push("                break;")
        }
        vi4 = vi4 + 1
    }
    out.push("            default: break;")
    out.push("        }")
    out.push("        free(p);")
    out.push("    }")
    out.push("}")
    out.push("static void hl_cleanup_" + c_name + "(" + c_name + "** p) { hl_release_" + c_name + "(*p); }")
    out.push("")
    return out
}

# gen_struct_instantiation(ctx, t) emits a typedef + constructor for a generic
# struct instantiation. `t` is the full type string like "Box[int]".
fn gen_struct_instantiation(ctx: Ctx, t: str) -> list[str] {
    let base: str = type_base(t)
    let st: StructInfo = ctx.structs.get_or(base, dummy_struct())
    let targs: list[str] = type_args(t)
    let c_name: str = c_type_name(t)
    return gen_one_struct_full(ctx, c_name, st, targs)
}


# --- Function prototype + instantiation generation ---

fn gen_proto_lines(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let mut key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        # Stage 20 (v0.36.0-alpha): under --lto, skip prototypes of
        # functions dropped by phase A (unreachable) or phase B (every
        # call site inlined — lto_calls == 0 and inlined at least once).
        if ctx.lto_mode && key != "main" && !f.is_extern {
            if !ctx.lto_fn_start.has(key) {
                i = i + 1
                continue
            }
            if ctx.lto_calls.get_or(key, 0) == 0
                    && list_has(ctx.lto_inlined_report, key) {
                i = i + 1
                continue
            }
        }
        if f.typeparams.len() > 0 {
            # Skip generic functions here — their prototypes are emitted
            # with the instantiations in gen_fn_inst_lines.
            i = i + 1
            continue
        }
        let ptypes_c: list[str] = []
        let mut j: int = 0
        while j < f.params.len() {
            ptypes_c.push(c_type(ctx, f.ptypes.get(j)))
            j = j + 1
        }
        let mut sig: str = c_type(ctx, f.ret) + " usf_" + c_fn_name(key) + "("
        if ptypes_c.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(ptypes_c, ", ") + ")"
        }
        # Stage 19 (v0.35.0-alpha): prototype mirrors the body's PGO
        # annotations (hot/cold attribute + static inline hint).
        # Stage 28+29 (v0.45.0-alpha): prototype mirrors the body's
        # user attributes too (#[inline(always)], #[hot], #[cold],
        # #[no_red_zone], #[irq_handler]) — fn_attr_prefix returns
        # the combined prefix identical to what gen_fn_body emitted.
        out.push(fn_attr_prefix(ctx, f, key) + sig + ";")
        i = i + 1
    }
    # Also emit prototypes for generic function instantiations.
    let mut j2: int = 0
    while j2 < ctx.fn_insts.len() {
        let inst: str = ctx.fn_insts.get(j2)
        let parsed: list[str] = parse_inst_str(inst)
        # parsed[0] = key, parsed[1..n] = type args
        let key: str = parsed.get(0)
        let targs: list[str] = list_slice_from(parsed, 1)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        let ptypes_c: list[str] = []
        let mut k: int = 0
        while k < f.params.len() {
            let inst_pt: str = instantiate_type(f.ptypes.get(k), f.typeparams, targs)
            ptypes_c.push(c_type(ctx, inst_pt))
            k = k + 1
        }
        let mut ret_str: str = instantiate_type(f.ret, f.typeparams, targs)
        let mangled: str = c_mangled_fn_name(key, f.typeparams, targs)
        let mut sig: str = c_type(ctx, ret_str) + " usf_" + mangled + "("
        if ptypes_c.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(ptypes_c, ", ") + ")"
        }
        # Stage 19: mirror the instantiation body's PGO annotations.
        # Stage 28+29: mirror the user attributes too. The mangled
        # key is used for PGO lookups (same as gen_fn_inst_lines).
        out.push(fn_attr_prefix(ctx, f, mangled) + sig + ";")
        j2 = j2 + 1
    }
    out.push("")
    return out
}

# parse_inst_str(s) parses "key|arg1,arg2,..." into [key, arg1, arg2, ...].
fn parse_inst_str(s: str) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    let mut key: str = ""
    while i < s.len() {
        if s.byte_at(i) == 124 {
            key = s.slice(0, i)
            break
        }
        i = i + 1
    }
    if key == "" {
        out.push(s)
        return out
    }
    out.push(key)
    let args_str: str = s.slice(i + 1, s.len())
    if args_str == "" {
        return out
    }
    let args: list[str] = split_args_str(args_str)
    let mut j: int = 0
    while j < args.len() {
        out.push(args.get(j))
        j = j + 1
    }
    return out
}

# gen_fn_inst_lines(ctx) emits the body for each generic function
# instantiation recorded in ctx.fn_insts.
fn gen_fn_inst_lines(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let mut i: int = 0
    while i < ctx.fn_insts.len() {
        let inst: str = ctx.fn_insts.get(i)
        let parsed: list[str] = parse_inst_str(inst)
        let key: str = parsed.get(0)
        let targs: list[str] = list_slice_from(parsed, 1)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        gen_reset_fn(ctx)
        # BUG-002 fix: for generic methods on generic structs, we need to
        # combine the struct's type params with the method's. The targs list
        # carries BOTH (struct's args first, then method's args) — see how
        # check_method composes `all_targs`. We mirror that here to build
        # the combined typeparams list and pass the right targs slice.
        let mut combined_tps: list[str] = []
        let mut struct_tps_count: int = 0
        if f.is_method && f.struct_of != "" {
            let st: StructInfo = ctx.structs.get_or(f.struct_of, dummy_struct())
            let mut si: int = 0
            while si < st.typeparams.len() {
                combined_tps.push(st.typeparams.get(si))
                si = si + 1
            }
            struct_tps_count = st.typeparams.len()
        }
        let mut mi: int = 0
        while mi < f.typeparams.len() {
            combined_tps.push(f.typeparams.get(mi))
            mi = mi + 1
        }
        # The method's own type params are appended to combined_tps above;
        # the body uses ctx.cur_typeparams + ctx.cur_targs for instantiation.
        ctx.cur_typeparams = combined_tps
        ctx.cur_targs = targs
        # Stage 19 (v0.35.0-alpha): PGO — set cur_fn to the MANGLED
        # instantiation name so branch/loop site ids (b:<fn>:<n>) are
        # unique per instantiation. The contracts return-handler looks
        # the key up in ctx.fns and gets dummy_fn (ensures_e = -1), so
        # --contracts behaviour is unchanged.
        ctx.cur_fn = c_mangled_fn_name(key, combined_tps, targs)
        # Build the signature. Stage 8-beta: parameters own one retain of
        # each argument — `<name>_p` in the signature, owned local copies
        # with cleanups at the top of the body.
        let ptypes_c: list[str] = []
        let inst_ptypes: list[str] = []
        let param_local_names: list[str] = []
        let sig_params: list[str] = []
        let mut j: int = 0
        while j < f.params.len() {
            let inst_pt: str = instantiate_type(f.ptypes.get(j), combined_tps, targs)
            inst_ptypes.push(inst_pt)
            ptypes_c.push(c_type(ctx, inst_pt))
            j = j + 1
        }
        gen_param_locals(ctx, f, ptypes_c, param_local_names, sig_params)
        let ret_str: str = instantiate_type(f.ret, combined_tps, targs)
        let mut sig: str = c_type(ctx, ret_str) + " usf_" + c_mangled_fn_name(key, combined_tps, targs) + "("
        if sig_params.len() == 0 {
            sig = sig + "void)"
        } else {
            sig = sig + join(sig_params, ", ") + ")"
        }
        # Stage 19 (v0.35.0-alpha): PGO — the instantiation's entry site
        # is keyed by the MANGLED name (stable across builds); hot/cold
        # attributes come from the loaded profile like plain functions.
        let mangled: str = c_mangled_fn_name(key, combined_tps, targs)
        let sig_start: int = out.len()
        out.push(fn_attr_prefix(ctx, f, mangled) + sig + " {")
        # Emit statements. The gen_stmt / gen_expr functions need to use
        # inst_t for types. We achieve this by intercepting in c_type via
        # the ctx.cur_typeparams + ctx.cur_targs.
        let saved_out: list[str] = ctx.out
        ctx.out = []
        emit_param_local_decls(ctx, f, inst_ptypes, param_local_names)
        let entry_idx: int = pgo_site(ctx, "e:" + mangled)
        if ctx.pgo_gen {
            if entry_idx >= PGO_MAX_SITES() {
                panic("pgo: too many profile sites (limit 65536)")
            }
            ctx.out.push("    __hlc_pgo_counts[" + entry_idx.to_str() + "]++;")
        }
        gen_stmts(ctx, f.body, "    ")
        let mut k: int = 0
        while k < ctx.out.len() {
            out.push(ctx.out.get(k))
            k = k + 1
        }
        ctx.out = saved_out
        out.push("}")
        out.push("")
        # Stage 19: body size + retroactive `static inline` hint (same
        # predicate the prototype emission consults).
        # Stage 28+29: only retro-patch under PGO; explicit attrs are
        # already on the signature line via fn_attr_prefix.
        ctx.pgo_fn_sizes.set(mangled, out.len() - sig_start)
        if f.attr_inline == "" && pgo_fn_inline(ctx, mangled) {
            out.set(sig_start, "static inline " + out.get(sig_start))
        }
        ctx.cur_typeparams = []
        ctx.cur_targs = []
        i = i + 1
    }
    return out
}

# ============================================================================
# 4d. STAGE 8-BETA: clone() PER-INSTANTIATION HELPERS
# ----------------------------------------------------------------------------
# clone() now supports EVERY owned type (str, list, map, struct, enum,
# tainted[...]) via generated helpers `hl_clone_<mangled-type>`. Each
# helper deep-copies: primitives by value, pointers by recursively
# cloning. Recursion is guarded by registration (clone_insts).
# ============================================================================

# clone_expr_for: the C expression cloning `cexpr` of HLS type t.
fn clone_expr_for(ctx: Ctx, t: str, cexpr: str) -> str {
    let tt: str = strip_taint(inst_t(ctx, t))
    if tt == "int" || tt == "float" || tt == "bool" {
        return cexpr
    }
    if tt == "str" {
        return "hl_clone_str(" + cexpr + ")"
    }
    # Stage 16: a channel inside a composite clones by SHARING (atomic
    # refcount) — the runtime helper, not a per-instantiation generator.
    if is_chan_t(tt) {
        return "hl_chan_clone(" + cexpr + ")"
    }
    return "hl_clone_" + c_type_name(tt) + "(" + cexpr + ")"
}

# register_clone: record that a clone helper is needed for `t` (plus,
# recursively, for every owned child type its body will clone).
fn register_clone(ctx: Ctx, t: str) -> void {
    let tt: str = strip_taint(t)
    if tt == "int" || tt == "float" || tt == "bool" || tt == "str" {
        return
    }
    # Stage 16: channels clone via the runtime helper hl_chan_clone (no
    # per-instantiation generator); Task cannot be cloned at all.
    if is_chan_t(tt) || is_task_t(tt) {
        return
    }
    if list_has(ctx.clone_insts, t) {
        return
    }
    ctx.clone_insts.push(t)
    if is_list_t(tt) {
        register_clone(ctx, list_elem_t(tt))
        return
    }
    if is_map_t(tt) {
        register_clone(ctx, map_val_t(tt))
        return
    }
    # User struct: register each pointer field's type.
    let sbase: str = type_base(tt)
    if ctx.structs.has(sbase) {
        let st: StructInfo = ctx.structs.get_or(sbase, dummy_struct())
        let targs: list[str] = type_args(tt)
        let mut j: int = 0
        while j < st.fields.len() {
            let ftype: str = st.ftypes.get(j)
            let mut inst_ftype: str = ftype
            if st.typeparams.len() > 0 && targs.len() == st.typeparams.len() {
                inst_ftype = instantiate_type(ftype, st.typeparams, targs)
            }
            if is_ptr_t(ctx, inst_ftype) {
                register_clone(ctx, inst_ftype)
            }
            j = j + 1
        }
        return
    }
    # User enum: register each pointer payload's type (per variant).
    let ebase: str = type_base(tt)
    if ctx.enums.has(ebase) {
        let en: EnumInfo = ctx.enums.get_or(ebase, dummy_enum())
        let targs: list[str] = type_args(tt)
        let mut vi: int = 0
        while vi < en.variants.len() {
            let payloads: list[str] = en.payloads.get(vi)
            let mut pi: int = 0
            while pi < payloads.len() {
                let pt: str = payloads.get(pi)
                let mut inst_pt: str = pt
                if en.typeparams.len() > 0 && targs.len() == en.typeparams.len() {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                }
                if is_ptr_t(ctx, inst_pt) {
                    register_clone(ctx, inst_pt)
                }
                pi = pi + 1
            }
            vi = vi + 1
        }
        return
    }
}

# clone_fn_proto: the prototype line for the clone helper of type t.
fn clone_fn_proto(ctx: Ctx, t: str) -> str {
    let tt: str = strip_taint(t)
    if is_list_t(tt) {
        return "static hl_list* hl_clone_" + c_type_name(tt) + "(hl_list* l);"
    }
    if is_map_t(tt) {
        return "static hl_map* hl_clone_" + c_type_name(tt) + "(hl_map* m);"
    }
    # c_type() already returns a pointer for user types — use the raw
    # mangled name so the prototype is `static T* hl_clone_T(T* p);`.
    return "static " + c_type_name(tt) + "* hl_clone_" + c_type_name(tt) + "(" + c_type_name(tt) + "* p);"
}

# gen_clone_list_lines: the body for clone(list[E]).
fn gen_clone_list_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let elem: str = list_elem_t(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy with fresh boxes / cloned elements.")
    out.push("static hl_list* hl_clone_" + m + "(hl_list* l) {")
    out.push("    hl_list* r = hl_list_new(" + elem_free_fn(ctx, elem) + ");")
    out.push("    for (int64_t i = 0; i < l->len; i++) {")
    if elem == "int" {
        out.push("        hl_list_push(r, hl_box_i64(hl_unbox_i64(l->items[i])));")
    } else if elem == "float" {
        out.push("        hl_list_push(r, hl_box_f64(hl_unbox_f64(l->items[i])));")
    } else if elem == "bool" {
        out.push("        hl_list_push(r, hl_box_bool(hl_unbox_bool(l->items[i])));")
    } else {
        out.push("        hl_list_push(r, " + clone_expr_for(ctx, elem, "(" + c_type(ctx, elem) + ")l->items[i]") + ");")
    }
    out.push("    }")
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_map_lines: the body for clone(map[str, V]).
fn gen_clone_map_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let vt: str = map_val_t(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy with cloned keys and values.")
    out.push("static hl_map* hl_clone_" + m + "(hl_map* m) {")
    out.push("    hl_map* r = hl_map_new(" + elem_free_fn(ctx, vt) + ");")
    out.push("    for (int64_t i = 0; i < m->len; i++) {")
    out.push("        hl_str* k = m->order[i];")
    out.push("        void* v = hl_map_borrow(m, k);")
    out.push("        if (v == NULL) continue;")
    if vt == "int" {
        out.push("        hl_map_set(r, hl_clone_str(k), hl_box_i64(hl_unbox_i64(v)));")
    } else if vt == "float" {
        out.push("        hl_map_set(r, hl_clone_str(k), hl_box_f64(hl_unbox_f64(v)));")
    } else if vt == "bool" {
        out.push("        hl_map_set(r, hl_clone_str(k), hl_box_bool(hl_unbox_bool(v)));")
    } else {
        out.push("        hl_map_set(r, hl_clone_str(k), " + clone_expr_for(ctx, vt, "(" + c_type(ctx, vt) + ")v") + ");")
    }
    out.push("    }")
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_struct_lines: the body for clone(<struct instantiation>).
fn gen_clone_struct_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let sbase: str = type_base(tt)
    let st: StructInfo = ctx.structs.get_or(sbase, dummy_struct())
    let targs: list[str] = type_args(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy of every field.")
    out.push("static " + m + "* hl_clone_" + m + "(" + m + "* p) {")
    out.push("    " + m + "* r = (" + m + "*)malloc(sizeof(" + m + "));")
    out.push("    if (!r) hl_die(\"out of memory\");")
    out.push("    r->refcnt = 1;")
    let mut j: int = 0
    while j < st.fields.len() {
        let ftype: str = st.ftypes.get(j)
        let mut inst_ftype: str = ftype
        if st.typeparams.len() > 0 && targs.len() == st.typeparams.len() {
            inst_ftype = instantiate_type(ftype, st.typeparams, targs)
        }
        out.push("    r->" + st.fields.get(j) + " = " + clone_expr_for(ctx, inst_ftype, "p->" + st.fields.get(j)) + ";")
        j = j + 1
    }
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_enum_lines: the body for clone(<enum instantiation>). Only the
# active variant's payloads are copied (reading another variant's union
# arm would be undefined behaviour).
fn gen_clone_enum_lines(ctx: Ctx, tt: str) -> list[str] {
    let mut out: list[str] = []
    let ebase: str = type_base(tt)
    let en: EnumInfo = ctx.enums.get_or(ebase, dummy_enum())
    let targs: list[str] = type_args(tt)
    let m: str = c_type_name(tt)
    out.push("// clone(" + tt + ") — deep copy of the active variant's payloads.")
    out.push("static " + m + "* hl_clone_" + m + "(" + m + "* p) {")
    out.push("    " + m + "* r = (" + m + "*)malloc(sizeof(" + m + "));")
    out.push("    if (!r) hl_die(\"out of memory\");")
    out.push("    r->refcnt = 1;")
    out.push("    r->tag = p->tag;")
    out.push("    switch (p->tag) {")
    let mut vi: int = 0
    while vi < en.variants.len() {
        let vname: str = en.variants.get(vi)
        let payloads: list[str] = en.payloads.get(vi)
        if payloads.len() > 0 {
            out.push("        case " + en.name + "__TAG_" + vname + "_" + m + ": {")
            let mut pi: int = 0
            while pi < payloads.len() {
                let pt: str = payloads.get(pi)
                let mut inst_pt: str = pt
                if en.typeparams.len() > 0 && targs.len() == en.typeparams.len() {
                    inst_pt = instantiate_type(pt, en.typeparams, targs)
                }
                out.push("            r->data." + vname + ".v" + pi.to_str()
                    + " = " + clone_expr_for(ctx, inst_pt, "p->data." + vname + ".v" + pi.to_str()) + ";")
                pi = pi + 1
            }
            out.push("            break;")
            out.push("        }")
        }
        vi = vi + 1
    }
    out.push("        default: break;")
    out.push("    }")
    out.push("    return r;")
    out.push("}")
    out.push("")
    return out
}

# gen_clone_bodies: bodies for every registered clone instantiation.
fn gen_clone_bodies(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let mut i: int = 0
    while i < ctx.clone_insts.len() {
        let t: str = ctx.clone_insts.get(i)
        let tt: str = strip_taint(t)
        if is_list_t(tt) {
            concat_lines(out, gen_clone_list_lines(ctx, tt))
        } else if is_map_t(tt) {
            concat_lines(out, gen_clone_map_lines(ctx, tt))
        } else if ctx.structs.has(type_base(tt)) {
            concat_lines(out, gen_clone_struct_lines(ctx, tt))
        } else if ctx.enums.has(type_base(tt)) {
            concat_lines(out, gen_clone_enum_lines(ctx, tt))
        }
        i = i + 1
    }
    return out
}

# gen_ownership_protos: forward declarations for every release / cleanup /
# clone helper so struct/enum/clone definitions can reference each other
# regardless of emission order (mutual recursion: a struct containing a
# list of structs, an enum whose payload is the enum itself, ...).
fn gen_ownership_protos(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    out.push("// ---- Stage 8-beta: ownership helper prototypes ----")
    let snames: list[str] = ctx.structs.keys()
    let mut i: int = 0
    while i < snames.len() {
        let st: StructInfo = ctx.structs.get_or(snames.get(i), dummy_struct())
        if st.typeparams.len() == 0 {
            out.push("static void hl_release_" + st.name + "(void* p);")
            out.push("static void hl_cleanup_" + st.name + "(" + st.name + "** p);")
        }
        i = i + 1
    }
    let mut si: int = 0
    while si < ctx.struct_insts.len() {
        let m: str = c_type_name(ctx.struct_insts.get(si))
        out.push("static void hl_release_" + m + "(void* p);")
        out.push("static void hl_cleanup_" + m + "(" + m + "** p);")
        si = si + 1
    }
    let enames: list[str] = ctx.enums.keys()
    let mut ei: int = 0
    while ei < enames.len() {
        let en: EnumInfo = ctx.enums.get_or(enames.get(ei), dummy_enum())
        if en.typeparams.len() == 0 {
            out.push("static void hl_release_" + en.name + "(void* p);")
            out.push("static void hl_cleanup_" + en.name + "(" + en.name + "** p);")
        }
        ei = ei + 1
    }
    let mut eii: int = 0
    while eii < ctx.enum_insts.len() {
        let m: str = c_type_name(ctx.enum_insts.get(eii))
        out.push("static void hl_release_" + m + "(void* p);")
        out.push("static void hl_cleanup_" + m + "(" + m + "** p);")
        eii = eii + 1
    }
    let mut ci: int = 0
    while ci < ctx.clone_insts.len() {
        out.push(clone_fn_proto(ctx, ctx.clone_insts.get(ci)))
        ci = ci + 1
    }
    out.push("")
    return out
}

# --- Top-level program generation ---

fn gen_program(ctx: Ctx) -> list[str] {
    # 1. emit function bodies first (they collect struct/enum/clone
    # instantiations as they are generated).
    # Stage 20 (v0.36.0-alpha) — LTO phase A: under --lto, only
    # REACHABLE functions are generated at all. Reachability runs over
    # the checker's call graph (ctx.edges) rooted at main + the "" top-
    # level exprs (struct defaults). Extern declarations are kept.
    let mut reach: list[str] = []
    if ctx.lto_mode {
        reach = lto_reachable(ctx)
    }
    ctx.out = []
    ctx.clone_insts = []
    ctx.tmp = 0
    ctx.spawn_decls = []
    ctx.spawn_n = 0
    let mut i: int = 0
    while i < ctx.fn_order.len() {
        let key: str = ctx.fn_order.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        if f.typeparams.len() > 0 {
            # Generic function — skip here; we emit per instantiation later.
            i = i + 1
            continue
        }
        # Stage 20: LTO phase-A DCE — skip unreachable functions (their
        # bodies, prototypes and call sites never exist; every emitted
        # usf_ reference is to a reachable callee by construction).
        if ctx.lto_mode && key != "main" && !f.is_extern && !list_has(reach, key) {
            ctx.lto_dropped = ctx.lto_dropped + 1
            i = i + 1
            continue
        }
        gen_fn_body(ctx, key)
        i = i + 1
    }
    # 1b. emit generic function instantiation bodies.
    let fn_inst_bodies: list[str] = gen_fn_inst_lines(ctx)
    # Stage 20 (v0.36.0-alpha) — LTO phase B: a function whose EVERY
    # emitted call site was inlined has lto_calls == 0. Its standalone
    # body is dead — splice it out of the already-generated lines (and
    # out of the prototypes below). "A pure helper used only inside
    # another crate's fn is inlined and the standalone definition is
    # dropped." Phase A already filtered unreachable functions; here we
    # drop the REACHABLE-but-fully-inlined ones (all their inlined
    # bodies live inside their callers).
    if ctx.lto_mode {
        let keys: list[str] = ctx.lto_fn_start.keys()
        let dead_ranges: list[int] = []
        let mut ki: int = 0
        while ki < keys.len() {
            let k: str = keys.get(ki)
            if k == "main" {
                ki = ki + 1
                continue
            }
            if ctx.lto_calls.get_or(k, 0) != 0 {
                ki = ki + 1
                continue
            }
            # inlined at least once? Only then is 0-calls meaningful
            # (phase A already removed never-reachable fns; a reachable
            # fn with zero emitted calls and zero inlines would mean its
            # only callers are... struct-default "" roots — those calls
            # ARE emitted via constructors, so calls > 0. Guard anyway:
            # only drop fns recorded as inlined.)
            if !list_has(ctx.lto_inlined_report, k) {
                ki = ki + 1
                continue
            }
            let start: int = ctx.lto_fn_start.get_or(k, -1)
            let size: int = ctx.pgo_fn_sizes.get_or(k, 0)
            if start < 0 || size <= 0 {
                ki = ki + 1
                continue
            }
            dead_ranges.push(start)
            dead_ranges.push(start + size)
            ctx.lto_dropped = ctx.lto_dropped + 1
            ki = ki + 1
        }
        if dead_ranges.len() > 0 {
            # rebuild ctx.out skipping the dead ranges (ascending order).
            let filtered: list[str] = []
            let mut oi: int = 0
            let mut ri: int = 0
            while oi < ctx.out.len() {
                let mut in_dead: bool = false
                let mut rj: int = 0
                while rj < dead_ranges.len() {
                    if oi >= dead_ranges.get(rj) && oi < dead_ranges.get(rj + 1) {
                        in_dead = true
                    }
                    rj = rj + 2
                }
                if !in_dead {
                    filtered.push(ctx.out.get(oi))
                }
                oi = oi + 1
            }
            ctx.out = filtered
        }
    }
    let bodies: list[str] = ctx.out
    # 2. concatenate in order: header -> runtime -> forward typedefs ->
    #    ownership protos -> struct/enum defs -> clone bodies -> fn protos
    #    -> bodies -> main
    let final: list[str] = []
    final.push("// =============================================================")
    final.push("// C code generated BY hlc — the Halis compiler (HLS)")
    final.push("// The HLS source is compiled by hlc itself (self-hosted).")
    final.push("// =============================================================")
    final.push("")
    concat_lines(final, runtime_lines())
    # Stage 19 (v0.35.0-alpha): --pgo-generate — the profile counter
    # array. Sized by the fixed site cap (checked during body emission;
    # programs with more sites are rejected). Zero-initialised (.bss).
    if ctx.pgo_gen {
        final.push("")
        final.push("// ===== Stage 19: PGO instrumentation counters =====")
        final.push("static uint64_t __hlc_pgo_counts[" + PGO_MAX_SITES().to_str() + "];")
    }
    # Stage 19: --pgo-use — the hoisted string-literal caches collected
    # while generating hot function bodies. Each is a thread-local
    # one-time cache (see the "str" literal case in gen_expr).
    if ctx.pgo_slits.len() > 0 {
        final.push("")
        final.push("// ===== Stage 19: PGO-hoisted string-literal caches =====")
        let mut si3: int = 0
        while si3 < ctx.pgo_slits.len() {
            final.push(ctx.pgo_slits.get(si3))
            si3 = si3 + 1
        }
    }
    final.push("")
    # 2a. Forward declarations for ALL structs and enums (recursive types).
    let struct_names: list[str] = ctx.structs.keys()
    let mut sni: int = 0
    while sni < struct_names.len() {
        let st: StructInfo = ctx.structs.get_or(struct_names.get(sni), dummy_struct())
        if st.typeparams.len() == 0 {
            final.push("typedef struct " + st.name + " " + st.name + ";")
        }
        sni = sni + 1
    }
    let mut si2: int = 0
    while si2 < ctx.struct_insts.len() {
        final.push("typedef struct " + c_type_name(ctx.struct_insts.get(si2)) + " " + c_type_name(ctx.struct_insts.get(si2)) + ";")
        si2 = si2 + 1
    }
    let enum_names: list[str] = ctx.enums.keys()
    let mut eni: int = 0
    while eni < enum_names.len() {
        let en: EnumInfo = ctx.enums.get_or(enum_names.get(eni), dummy_enum())
        if en.typeparams.len() == 0 {
            final.push("typedef struct " + en.name + " " + en.name + ";")
        }
        eni = eni + 1
    }
    let mut ei2: int = 0
    while ei2 < ctx.enum_insts.len() {
        final.push("typedef struct " + c_type_name(ctx.enum_insts.get(ei2)) + " " + c_type_name(ctx.enum_insts.get(ei2)) + ";")
        ei2 = ei2 + 1
    }
    final.push("")
    # 2a-bis. Stage 8-beta: ownership helper prototypes (release / cleanup /
    # clone) so the struct/enum/clone definitions below can reference each
    # other in any order.
    concat_lines(final, gen_ownership_protos(ctx))
    concat_lines(final, gen_struct_lines(ctx))
    # 2b. emit generic struct instantiations.
    let mut si: int = 0
    while si < ctx.struct_insts.len() {
        let inst_t: str = ctx.struct_insts.get(si)
        concat_lines(final, gen_struct_instantiation(ctx, inst_t))
        si = si + 1
    }
    # 2c. emit non-generic enums.
    concat_lines(final, gen_enum_lines_simple(ctx))
    # 2d. emit generic enum instantiations.
    let mut ei: int = 0
    while ei < ctx.enum_insts.len() {
        let inst_t: str = ctx.enum_insts.get(ei)
        let base: str = type_base(inst_t)
        let en: EnumInfo = ctx.enums.get_or(base, dummy_enum())
        let targs: list[str] = type_args(inst_t)
        concat_lines(final, gen_one_enum_full(ctx, c_type_name(inst_t), en, targs))
        ei = ei + 1
    }
    # 2e. Stage 8-beta: clone() per-instantiation helper bodies.
    concat_lines(final, gen_clone_bodies(ctx))
    # 2e-bis. Stage 21 (v0.37.0-alpha): std.simd intrinsic fast paths
    # (--target-feature). Emitted after the struct definitions + clone
    # bodies so the helpers can use the struct types, their constructors
    # and their release functions.
    if ctx.simd_helper_names.len() > 0 {
        concat_lines(final, simd_helper_lines(ctx))
    }
    concat_lines(final, gen_proto_lines(ctx))
    # 2e-bis. Stage 16: spawn-site helpers (arg structs + trampolines),
    # collected while the fn bodies above were generated. Emitted AFTER
    # the fn prototypes so the trampolines can call any usf_ function.
    concat_lines(final, ctx.spawn_decls)
    concat_lines(final, bodies)
    concat_lines(final, fn_inst_bodies)
    # Stage 19 (v0.35.0-alpha): --pgo-generate — the profile dumper,
    # emitted AFTER all bodies (it references the site-id table below)
    # and BEFORE main (which registers it via atexit). The site-id table
    # is emitted in ASSIGNMENT order — index i of __hlc_pgo_names
    # corresponds to counter __hlc_pgo_counts[i], exactly matching the
    # increments emitted inside the bodies above.
    if ctx.pgo_gen {
        concat_lines(final, pgo_dump_lines(ctx))
    }
    # 3. main wrapper
    let mf: FnInfo = ctx.fns.get_or("main", dummy_fn())
    final.push("int main(int argc, char** argv) {")
    final.push("    hl_init_args(argc, argv);")
    if ctx.pgo_gen {
        # Register the profile dumper BEFORE any work: atexit handlers
        # run LIFO, so this runs after the user's own atexit handlers
        # (none today) and catches every exit path, including exit().
        # Panics call exit(101) -> the profile is still written.
        final.push("    atexit(__hlc_pgo_dump);")
    }
    # Stage 10 release: auto-initialise the sandbox from the
    # HLS_SANDBOX_ROOT env var if set. This lets the user compile a
    # program once and run it with different sandboxes (no recompile
    # needed). boot.py --sandbox DIR sets the same env var before
    # running the interpreter, so both paths share the same gating.
    final.push("    const char* hl_sb = getenv(\"HLS_SANDBOX_ROOT\");")
    final.push("    if (hl_sb && hl_sb[0]) hl_set_sandbox_root(hl_sb);")
    if mf.ret == "int" {
        final.push("    return (int)(usf_main());")
    } else {
        final.push("    usf_main();")
        final.push("    return 0;")
    }
    final.push("}")
    return final
}

# gen_enum_lines_simple — emit non-generic enum typedefs + variant constructors.
fn gen_enum_lines_simple(ctx: Ctx) -> list[str] {
    let mut out: list[str] = []
    let names: list[str] = ctx.enums.keys()
    let mut i: int = 0
    while i < names.len() {
        let en: EnumInfo = ctx.enums.get_or(names.get(i), dummy_enum())
        if en.typeparams.len() == 0 {
            let empty_targs: list[str] = []
            concat_lines(out, gen_one_enum_full(ctx, en.name, en, empty_targs))
        }
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# ----------------------------------------------------------------------------
# 6. MAIN — full pipeline: LEX -> PARSE -> CHECK -> GEN -> WRITE C
# ----------------------------------------------------------------------------

# dir_of(path) returns the directory component of a path (everything before
# the last '/'), or "." if the path has no slash.
fn dir_of(path: str) -> str {
    let mut i: int = path.len() - 1
    while i >= 0 {
        if path.byte_at(i) == 47 {
            if i == 0 {
                return "/"
            }
            return path.slice(0, i)
        }
        i = i - 1
    }
    return "."
}

# join_path(dir, rel) joins a directory and a relative path with a single
# slash. Does NOT handle ".." — uses string concatenation.
fn join_path(dir: str, rel: str) -> str {
    if dir == "." {
        return rel
    }
    if dir.len() == 0 {
        return rel
    }
    if dir.byte_at(dir.len() - 1) == 47 {
        return dir + rel
    }
    return dir + "/" + rel
}

# parent_dir(dir) returns the parent directory of dir.
fn parent_dir(dir: str) -> str {
    let mut i: int = dir.len() - 1
    while i >= 0 {
        if dir.byte_at(i) == 47 {
            if i == 0 {
                return "/"
            }
            return dir.slice(0, i)
        }
        i = i - 1
    }
    return "."
}

# resolve_import_path(imp, entry_dir, repo_root) returns the resolved file
# path for an import, or "" if not found.
fn resolve_import_path(imp: str, entry_dir: str, repo_root: str) -> str uses IO {
    if imp.starts_with("std.") {
        let module_name: str = imp.slice(4, imp.len())
        let rel: str = "std/" + module_name + ".hls"
        let mut d: str = entry_dir
        let mut tries: int = 0
        while tries < 5 {
            let candidate: str = join_path(d, rel)
            if file_exists(candidate) {
                return candidate
            }
            let parent: str = parent_dir(d)
            if parent == d {
                break
            }
            d = parent
            tries = tries + 1
        }
        let fallback: str = join_path(repo_root, rel)
        if file_exists(fallback) {
            return fallback
        }
        return ""
    }
    let direct: str = join_path(entry_dir, imp)
    if file_exists(direct) {
        return direct
    }
    return ""
}

# already_loaded(ctx, path) returns true if path has already been loaded.
fn already_loaded(ctx: Ctx, path: str) -> bool {
    let mut i: int = 0
    while i < ctx.loaded_files.len() {
        if ctx.loaded_files.get(i) == path {
            return true
        }
        i = i + 1
    }
    return false
}

# load_file_into(ctx, abs_path) reads, lexes and parses abs_path into ctx.
fn load_file_into(ctx: Ctx, abs_path: str) -> void uses IO {
    if already_loaded(ctx, abs_path) {
        return
    }
    ctx.loaded_files.push(abs_path)
    let file_dir: str = dir_of(abs_path)
    let saved_src: str = ctx.src
    let saved_toks: list[Tok] = ctx.toks
    let saved_pos: int = ctx.pos
    let saved_imports: list[str] = ctx.imports
    ctx.src = read_file(abs_path)
    ctx.toks = []
    ctx.pos = 0
    ctx.imports = []
    lex(ctx)
    parse_program(ctx)
    let my_imports: list[str] = ctx.imports
    let mut i: int = 0
    while i < my_imports.len() {
        let imp: str = my_imports.get(i)
        let resolved: str = resolve_import_path(imp, file_dir, ctx.repo_root)
        if resolved == "" {
            panic("module not found: " + imp)
        }
        load_file_into(ctx, resolved)
        i = i + 1
    }
    ctx.src = saved_src
    ctx.toks = saved_toks
    ctx.pos = saved_pos
    ctx.imports = saved_imports
}

fn main() -> int uses IO {
    let argv: list[str] = args()
    # Stage 17 (v0.28.0-alpha): CLI flags — hlc [flags] <input.hls> <output.c|->
    #   --fast | -O fast   proof-driven check elision (the interval prover
    #                       must have proven the check dead; anything
    #                       unknown keeps its runtime check)
    #   --contracts        emit runtime `requires` assertions at every
    #                       contracted fn entry
    # Stage 19 (v0.35.0-alpha):
    #   --pgo-generate     instrument fn entries / branches / loop
    #                       back-edges with counters; a .hlcprof profile is
    #                       written at exit (HLS_PGO_FILE or default.hlcprof)
    #   --pgo-use <file>   train the codegen with a .hlcprof profile:
    #                       __builtin_expect hints, hot/cold attributes,
    #                       static-inline hints on hot small functions
    # Strip the flags first; `a` below is the positional-argument view.
    let mut fast_mode: bool = false
    let mut contracts_mode: bool = false
    let mut pgo_gen: bool = false
    let mut pgo_use_path: str = ""
    let mut lto_mode: bool = false
    # Stage 20 perfection (v0.39.0-alpha): --lto-stats and --lto-threshold.
    let mut lto_stats: bool = false
    let mut lto_threshold: int = 0
    let mut target_feature: str = ""
    let a: list[str] = []
    let mut ai: int = 1
    while ai < argv.len() {
        let tok: str = argv.get(ai)
        if tok == "--fast" {
            fast_mode = true
        } else if tok == "--contracts" {
            contracts_mode = true
        } else if tok == "--pgo-generate" {
            pgo_gen = true
        } else if tok == "--lto" {
            # Stage 20 (v0.36.0-alpha): link-time optimisation across
            # crates — cross-crate inlining + whole-program DCE.
            lto_mode = true
        } else if tok == "--lto-stats" {
            # Stage 20 perfection (v0.39.0-alpha): print a summary of
            # LTO work (inline count, dropped functions, generic
            # instantiation dedup, total functions before/after) to
            # stderr after codegen. Implies --lto.
            lto_mode = true
            lto_stats = true
        } else if tok == "--lto-threshold" {
            # Stage 20 perfection (v0.39.0-alpha): override the
            # per-callee statement budget (default 30). Implies --lto.
            if ai + 1 >= argv.len() {
                println("error: --lto-threshold expects an integer (1..=200)")
                return 2
            }
            let n_str: str = argv.get(ai + 1)
            let n: int = int(n_str)
            if n_str != n.to_str() || n < 1 || n > 200 {
                println("error: --lto-threshold expects an integer in 1..=200 (got '" + n_str + "')")
                return 2
            }
            lto_mode = true
            lto_threshold = n
            ai = ai + 1
        } else if tok == "--target-feature" {
            # Stage 21 (v0.37.0-alpha): enable the std.simd intrinsic
            # fast paths + const-fold has_feature().
            if ai + 1 >= argv.len() {
                println("error: --target-feature expects a feature name (sse4.2 | avx2 | neon)")
                return 2
            }
            let feat: str = argv.get(ai + 1)
            if feat == "+sse4.2" || feat == "sse4.2" {
                target_feature = "sse4.2"
            } else if feat == "+avx2" || feat == "avx2" {
                target_feature = "avx2"
            } else if feat == "+neon" || feat == "neon" {
                target_feature = "neon"
            } else if feat == "native" {
                # Stage 21 perfection (v0.40.0-alpha): --target-feature
                # native — auto-detect the host's best SIMD feature.
                # On x86-64 hosts, picks avx2 (the strongest x86
                # feature the std.simd intrinsic fast paths support
                # today; AVX-512 tuning is post-1.0). On aarch64,
                # picks neon (baseline on every ARMv8+ core). On
                # other architectures, falls back to "" (portable
                # path — no intrinsic fast paths emitted).
                target_feature = simd_detect_native_feature()
            } else {
                println("error: unknown target feature '" + feat + "' (expected sse4.2 | avx2 | neon | native)")
                return 2
            }
            ai = ai + 1
        } else if tok == "--pgo-use" {
            if ai + 1 >= argv.len() {
                println("error: --pgo-use expects a profile file path")
                return 2
            }
            pgo_use_path = argv.get(ai + 1)
            ai = ai + 1
        } else if tok == "-O" {
            if ai + 1 < argv.len() && argv.get(ai + 1) == "fast" {
                fast_mode = true
                ai = ai + 1
            } else {
                println("error: -O expects 'fast' (the only level today)")
                return 2
            }
        } else {
            a.push(tok)
        }
        ai = ai + 1
    }
    # Stage 9-beta: `hlc --audit <file.hls>` prints the capability tree.
    if argv.len() >= 2 && argv.get(1) == "--audit" {
        if argv.len() < 3 {
            println("usage: hlc --audit <input.hls>")
            return 1
        }
        let entry_path: str = argv.get(2)
        let src: str = read_file(entry_path)
        let ctx: Ctx = new_ctx(src)
        ctx.entry_dir = dir_of(entry_path)
        ctx.repo_root = parent_dir(ctx.entry_dir)
        lex(ctx)
        parse_program(ctx)
        let entry_imports: list[str] = ctx.imports
        let mut i: int = 0
        while i < entry_imports.len() {
            let imp: str = entry_imports.get(i)
            let resolved: str = resolve_import_path(imp, ctx.entry_dir, ctx.repo_root)
            if resolved == "" {
                println("error: module not found: " + imp)
                return 1
            }
            load_file_into(ctx, resolved)
            i = i + 1
        }
        check_program(ctx)
        print_audit(ctx)
        return 0
    }
    if a.len() < 2 {
        println("usage: hlc [--fast | -O fast] [--contracts] [--pgo-generate] [--pgo-use <profile>]")
        println("              [--lto] [--lto-stats] [--lto-threshold N] [--target-feature sse4.2|avx2|neon]")
        println("              <input.hls> <output.c|->")
        println("       hlc --audit <input.hls>")
        return 1
    }
    let entry_path: str = a.get(0)
    let src: str = read_file(entry_path)
    let ctx: Ctx = new_ctx(src)
    ctx.entry_dir = dir_of(entry_path)
    ctx.repo_root = parent_dir(ctx.entry_dir)
    ctx.fast_mode = fast_mode
    ctx.contracts_mode = contracts_mode
    ctx.pgo_gen = pgo_gen
    ctx.lto_mode = lto_mode
    ctx.lto_threshold = lto_threshold
    ctx.lto_stats = lto_stats
    ctx.target_feature = target_feature
    # Stage 19: load the --pgo-use profile BEFORE codegen (the branch /
    # fn-attribute hints consult it during generation).
    if pgo_use_path != "" {
        if !file_exists(pgo_use_path) {
            println("error: --pgo-use: profile file not found: " + pgo_use_path)
            return 2
        }
        let prof: str = read_file(pgo_use_path)
        let perr: str = pgo_load_profile(ctx, prof)
        if perr != "" {
            println("error: --pgo-use: " + perr)
            return 2
        }
    }
    # Lex + parse the entry file.
    lex(ctx)
    parse_program(ctx)
    # Process the entry file's imports (recursively loads transitive deps).
    let entry_imports: list[str] = ctx.imports
    let mut i: int = 0
    while i < entry_imports.len() {
        let imp: str = entry_imports.get(i)
        let resolved: str = resolve_import_path(imp, ctx.entry_dir, ctx.repo_root)
        if resolved == "" {
            println("error: module not found: " + imp)
            return 1
        }
        load_file_into(ctx, resolved)
        i = i + 1
    }
    check_program(ctx)
    let lines: list[str] = gen_program(ctx)
    let code: str = join(lines, "\n")
    let out_path: str = a.get(1)
    if out_path == "-" {
        print(code)
        println("")
    } else {
        write_file(out_path, code)
    }
    # Stage 20 perfection (v0.39.0-alpha): --lto-stats — print a
    # summary of LTO work to stderr. Only emitted under --lto-stats.
    if ctx.lto_stats {
        print_lto_stats(ctx)
    }
    return 0
}

# Stage 20 perfection (v0.39.0-alpha): print the LTO work summary.
# Reports: total functions in the program, unreachable functions
# dropped by phase-A DCE, fully-inlined functions dropped by phase-B
# DCE, total inline expansions, distinct callees inlined, the
# per-callee statement budget in effect, and the generic instantiation
# count (instantiations emitted; the dedup means two modules
# instantiating the same generic with the same type args share ONE
# specialisation).
#
# Stats are printed to STDOUT after the C code is written to the
# output file. When `out_path == "-"` (code to stdout), the stats
# follow the code — callers wanting machine-parsed stats should use
# a file output path.
fn print_lto_stats(ctx: Ctx) -> void uses IO {
    let total_fns: int = ctx.fn_order.len()
    let inlined_keys: int = ctx.lto_inlined_report.len()
    let dropped: int = ctx.lto_dropped
    let inline_n: int = ctx.lto_inline_n
    let budget: int = lto_inline_stmts_budget(ctx)
    let gen_insts: int = ctx.fn_insts.len()
    let struct_insts: int = ctx.struct_insts.len()
    let enum_insts: int = ctx.enum_insts.len()
    println("=== LTO stats ===")
    println("  functions in program        : " + total_fns.to_str())
    println("  inline expansions (sites)   : " + inline_n.to_str())
    println("  distinct callees inlined    : " + inlined_keys.to_str())
    println("  bodies dropped (phase A+B)  : " + dropped.to_str())
    println("  inline stmt budget          : " + budget.to_str() + " (--lto-threshold)")
    println("  generic fn instantiations   : " + gen_insts.to_str())
    println("  generic struct instantiations: " + struct_insts.to_str())
    println("  generic enum instantiations : " + enum_insts.to_str())
    if inlined_keys > 0 {
        println("  inlined callees:")
        let mut i: int = 0
        while i < inlined_keys {
            println("    " + ctx.lto_inlined_report.get(i))
            i = i + 1
        }
    }
}


# Stage 9-beta: print the capability / effect tree of every function.
# Mirrors boot.py's --audit output. Reads ctx.computed_effects (populated
# by check_effects) and the per-function declared effect list.
fn print_audit(ctx: Ctx) -> void uses IO {
    let keys: list[str] = ctx.fn_order
    let mut i: int = 0
    println("==============================================================================")
    println("  function                       declared                       computed")
    println("==============================================================================")
    while i < keys.len() {
        let key: str = keys.get(i)
        let f: FnInfo = ctx.fns.get_or(key, dummy_fn())
        let declared: list[str] = f.effects
        let computed: list[str] = ctx.computed_effects.get_or(key, [])
        let mut decl_disp: str = ""
        if f.is_pure {
            decl_disp = "pure"
        }
        let mut j: int = 0
        while j < declared.len() {
            if decl_disp != "" {
                decl_disp = decl_disp + ", "
            }
            decl_disp = decl_disp + declared.get(j)
            j = j + 1
        }
        if decl_disp == "" {
            decl_disp = "(none - pure)"
        }
        let mut comp_disp: str = ""
        let mut k: int = 0
        while k < computed.len() {
            if comp_disp != "" {
                comp_disp = comp_disp + ", "
            }
            comp_disp = comp_disp + computed.get(k)
            k = k + 1
        }
        if comp_disp == "" {
            comp_disp = "(none)"
        }
        # Pad the function name to 30 chars for alignment.
        let padded: str = pad_right(key, 30)
        let padded_decl: str = pad_right(decl_disp, 30)
        println("  " + padded + "  " + padded_decl + "  " + comp_disp)
        i = i + 1
    }
    println("==============================================================================")
    println("  Active effects:    IO, Fs, Clock, Args, Exit, Net, Rand, Proc")
    println("  `uses IO` expands to: {IO, Fs, Clock, Args, Exit}")
    println("  Net, Rand, Proc are independent effects (not part of the IO")
    println("  family) — declare them explicitly to use net_lookup /")
    println("  rand_int / rand_float / rand_seed / proc_exec builtins.")
    println("  No reserved effects (Stage 9 release).")
    println("")
    # Stage 10-beta: taint-flow audit extension. Scan the call graph for:
    #   - functions calling taint sources (tainted_args, read_file_tainted, read_line)
    #   - functions calling each taint sink
    println("  Taint sources (builtins):  tainted_args, read_file_tainted,")
    println("                              read_line")
    println("  Taint sinks (builtins):    print, println, read_file,")
    println("                            write_file, file_exists, exit,")
    println("                            net_lookup, proc_exec")
    println("  Explicit untaint:         taint_unwrap, std.sanitize.*")
    println("")
    # Find functions calling each taint source.
    let mut targs_users: list[str] = []
    let mut rft_users: list[str] = []
    let mut rl_users: list[str] = []
    let mut si: int = 0
    while si < keys.len() {
        let skey: str = keys.get(si)
        let callees: list[str] = ctx.edges.get_or(skey, [])
        let mut cj: int = 0
        while cj < callees.len() {
            let ce: str = callees.get(cj)
            if ce == "b:tainted_args" {
                if !list_has(targs_users, skey) {
                    targs_users.push(skey)
                }
            }
            if ce == "b:read_file_tainted" {
                if !list_has(rft_users, skey) {
                    rft_users.push(skey)
                }
            }
            if ce == "b:read_line" {
                if !list_has(rl_users, skey) {
                    rl_users.push(skey)
                }
            }
            cj = cj + 1
        }
        si = si + 1
    }
    if targs_users.len() > 0 {
        println("  Functions calling tainted_args():")
        let mut ti: int = 0
        while ti < targs_users.len() {
            println("    - " + targs_users.get(ti))
            ti = ti + 1
        }
    } else {
        println("  No function calls tainted_args() (no argv-taint sources in this program).")
    }
    if rft_users.len() > 0 {
        println("  Functions calling read_file_tainted():")
        let mut ri: int = 0
        while ri < rft_users.len() {
            println("    - " + rft_users.get(ri))
            ri = ri + 1
        }
    } else {
        println("  No function calls read_file_tainted().")
    }
    if rl_users.len() > 0 {
        println("  Functions calling read_line():")
        let mut li: int = 0
        while li < rl_users.len() {
            println("    - " + rl_users.get(li))
            li = li + 1
        }
    } else {
        println("  No function calls read_line().")
    }
}

# Right-pad a string with spaces to width `n`. Truncates if longer than n.
fn pad_right(s: str, n: int) -> str pure {
    let sl: int = s.len()
    if sl >= n {
        return s.slice(0, n)
    }
    let mut out: str = s
    let mut i: int = 0
    while i < n - sl {
        out = out + " "
        i = i + 1
    }
    return out
}

