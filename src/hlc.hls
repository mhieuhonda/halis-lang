# ============================================================================
# hlc — THE HIEU LOUIS COMPILER (HLS -> C)
# ----------------------------------------------------------------------------
# This compiler is written 100% in Halis itself.
# This is the self-hosting step of the language: the language's compiler
# is written in that language.
#
# v0.3 (Stage 7) supports:
#   - enum declarations (generic + non-generic)
#   - match expressions (with exhaustiveness checking)
#   - the `?` error-propagation operator
#   - generic functions / structs / enums (monomorphisation)
#   - struct default field values
#
# Bootstrap chain:
#   python3 boot/boot.py src/hlc.hls <input.hls> <output.c>
#   gcc -O2 -o <program> <output.c> -lm
#
# Structure: LEXER -> PARSER -> CHECKER (types + effects) -> CODEGEN (C)
# All state is passed explicitly through Ctx — no global variables.
# ============================================================================

# ----------------------------------------------------------------------------
# MODULE LAYOUT (structural split of the former single-file hlc.hls).
# Modules are imported below in the original section order, so the merged
# program (and the generated C output) is IDENTICAL to the single-file build.
# ----------------------------------------------------------------------------
#   src/hlc/types.hls      lines     22..845     Data structures: Tok, ExprN, StmtN, FnInfo, struct/enum info, Ctx.
#   src/hlc/lexer.hls      lines    846..1114    Section 2 — LEXER: source text -> token stream.
#   src/hlc/parser.hls     lines   1115..2652    Section 3 — PARSER: token stream -> AST (ExprN/StmtN).
#   src/hlc/checker.hls    lines   2653..4698    Section 4a — CHECKER core: type table, bindings/ownership, effects, unify, escape analysis, tail-call verifier, check_program driver.
#   src/hlc/proof.hls      lines   4699..6261    Section 4b — Stage-17 interval proof engine: contracts, bounds seeding, annotation passes, const evaluation.
#   src/hlc/check_expr.hls lines   6262..7694    Section 4c — CHECKER: statement/expression type checking.
#   src/hlc/check_call.hls lines   7695..9619    Section 4d — CHECKER: builtin calls, spawn/async/stream calls, method calls.
#   src/hlc/check_match.hls lines   9620..10069   Section 4e — CHECKER: match exhaustiveness, ? propagation, effect collection.
#   src/hlc/runtime.hls    lines  10070..12651   Embedded C runtime prelude emitted into every generated program (runtime_lines).
#   src/hlc/codegen.hls    lines  12652..13687   Section 5a — CODEGEN: C types, name mangling, literals, stack layout, hoisting, ownership args.
#   src/hlc/pgo.hls        lines  13688..13997   Section 5b — PGO profile loading/hints and per-function C attributes.
#   src/hlc/simd.hls       lines  13998..15124   Section 5c — SIMD intrinsic emitters (SSE4.2/AVX2/NEON/RVV).
#   src/hlc/lto.hls        lines  15125..15774   Section 5d — LTO: reachability, inliner, PGO profile dump.
#   src/hlc/gen_expr.hls   lines  15775..17378   Section 5e — CODEGEN: expressions, calls, spawn/stream generation.
#   src/hlc/gen_stmt.hls   lines  17379..19260   Section 5f — CODEGEN: statements, match, asm, assignments.
#   src/hlc/gen_fn.hls     lines  19261..20521   Section 5g — CODEGEN: function bodies, struct/enum emission, clone generation, gen_program driver.
#   src/hlc/main.hls       lines  20522..21353   Section 6 — MAIN: CLI entry, flag parsing, full pipeline.

import "hlc/types.hls"
import "hlc/lexer.hls"
import "hlc/parser.hls"
import "hlc/checker.hls"
import "hlc/proof.hls"
import "hlc/check_expr.hls"
import "hlc/check_call.hls"
import "hlc/check_match.hls"
import "hlc/runtime.hls"
import "hlc/codegen.hls"
import "hlc/pgo.hls"
import "hlc/simd.hls"
import "hlc/lto.hls"
import "hlc/gen_expr.hls"
import "hlc/gen_stmt.hls"
import "hlc/gen_fn.hls"
import "hlc/main.hls"
