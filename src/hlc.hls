    # Stage 19 (v0.35.0-alpha): O(n) whole-list join. Computing the total
    # length first and copying each element exactly once turns output
    # assembly from quadratic (growing concat) into linear — the single
    # biggest compile-time win for the self-hosting bootstrap.
    r.push("static hl_str* hl_str_join(hl_list* parts, hl_str* sep) {")
    r.push("    int64_t n = parts->len;")
    r.push("    int64_t total = 0;")
    r.push("    for (int64_t i = 0; i < n; i++) {")
    r.push("        hl_str* p = (hl_str*)parts->items[i];")
    r.push("        total += p->len;")
    r.push("    }")
    r.push("    if (n > 1) total += (n - 1) * sep->len;")
    r.push("    hl_str* s = hl_str_alloc(total);")
    r.push("    int64_t off = 0;")
    r.push("    for (int64_t i = 0; i < n; i++) {")
    r.push("        if (i > 0 && sep->len > 0) {")
    r.push("            memcpy(s->data + off, sep->data, (size_t)sep->len);")
    r.push("            off += sep->len;")
    r.push("        }")
    r.push("        hl_str* p = (hl_str*)parts->items[i];")
    r.push("        if (p->len > 0) memcpy(s->data + off, p->data, (size_t)p->len);")
    r.push("        off += p->len;")
    r.push("    }")
    r.push("    return s;")
