    r.push("        hl_rt_deadlock_check();")
    r.push("        pthread_cond_wait(&g_rt_cv, &g_rt_mu);")
    r.push("        g_rt_blocked--;")
    r.push("        for (int64_t i = 0; i < chs->len; i++)")
    r.push("            ((hl_chan*)chs->items[i])->waiters--;")
