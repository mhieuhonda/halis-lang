    r.push("// ---- tasks ----")
    r.push("static void hl_task_finish(hl_task* t, hl_task_res res) {")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    t->res = res;")
    r.push("    t->done = true;")
    r.push("    g_rt_tasks--;")
    r.push("    if (t->refcnt == 0 && !t->freed) { t->freed = true; free(t); }  // abandoned")
    r.push("    pthread_cond_broadcast(&g_rt_cv);")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
