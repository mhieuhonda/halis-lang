    r.push("// Task release — called by the spawner's binding cleanup. Under the")
    r.push("// global mutex, so task refcounts need no atomics. If the thread is")
    r.push("// still running when the last reference drops, the task is")
    r.push("// abandoned: hl_task_finish frees it.")
    r.push("static void hl_task_release(void* pv) {")
    r.push("    hl_task* t = (hl_task*)pv;")
    r.push("    if (!t) return;")
    r.push("    pthread_mutex_lock(&g_rt_mu);")
    r.push("    if (--t->refcnt == 0) {")
    r.push("        if (t->done && !t->freed) { t->freed = true; free(t); }")
    r.push("    }")
    r.push("    pthread_mutex_unlock(&g_rt_mu);")
    r.push("}")
    r.push("static void hl_cleanup_task(hl_task** p) { hl_task_release(*p); }")
