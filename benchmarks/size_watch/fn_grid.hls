# ============================================================================
# benchmarks/size_watch/fn_grid.hls — Stage 139: the tracked size
# suite, workload 3 of 5 — the PER-FUNCTION MACHINERY.
# ----------------------------------------------------------------------------
# Many small functions, each called through one dispatch chain: the
# per-function call overhead a codegen release regresses — prologue
# girth, per-call boxing, duplicated guards, symbol metadata — grows
# with the FUNCTION COUNT, not the program's work, so sixteen tiny
# leaves behind one small loop expose exactly the axis a "the
# generated C per function got fatter" change moves. The bodies are
# deliberately distinct shapes (arithops, compare chains, small
# constants) so dead-code elimination cannot fold the grid into one
# leaf and quietly hide the growth.
# ============================================================================

fn f00(x: int) -> int {
    return x + 1
}

fn f01(x: int) -> int {
    return x * 3 - 2
}

fn f02(x: int) -> int {
    return x / 2 + x % 7
}

fn f03(x: int) -> int {
    if x > 0 {
        return x - 1
    }
    return 0 - x
}

fn f04(x: int) -> int {
    return(x + 5) * (x - 5)
}

fn f05(x: int) -> int {
    return x * x % 1000
}

fn f06(x: int) -> int {
    return x - 11
}

fn f07(x: int) -> int {
    return x * 17 + 3
}

fn f08(x: int) -> int {
    if x % 2 == 0 {
        return x / 2
    }
    return x * 2 + 1
}

fn f09(x: int) -> int {
    return x + 100
}

fn f10(x: int) -> int {
    return(x % 97) + (x / 31)
}

fn f11(x: int) -> int {
    return x * 0 - 5
}

fn f12(x: int) -> int {
    return x - x % 4
}

fn f13(x: int) -> int {
    return x + 7 * 3
}

fn f14(x: int) -> int {
    if x > 500 {
        return 500
    }
    if x < 0 - 500 {
        return 0 - 500
    }
    return x
}

fn f15(x: int) -> int {
    return(x + 2) * (x + 2) % 4096
}

fn dispatch(i: int, x: int) -> int {
    if i == 0 {
        return f00(x)
    }
    if i == 1 {
        return f01(x)
    }
    if i == 2 {
        return f02(x)
    }
    if i == 3 {
        return f03(x)
    }
    if i == 4 {
        return f04(x)
    }
    if i == 5 {
        return f05(x)
    }
    if i == 6 {
        return f06(x)
    }
    if i == 7 {
        return f07(x)
    }
    if i == 8 {
        return f08(x)
    }
    if i == 9 {
        return f09(x)
    }
    if i == 10 {
        return f10(x)
    }
    if i == 11 {
        return f11(x)
    }
    if i == 12 {
        return f12(x)
    }
    if i == 13 {
        return f13(x)
    }
    if i == 14 {
        return f14(x)
    }
    return f15(x)
}

fn main() -> int uses IO {
    let mut acc: int = 3
    let mut i: int = 0
    while i < 96 {
        acc = dispatch(i % 16, acc + i)
        i = i + 1
    }
    println("grid checksum=" + acc.to_str())
    return 0
}
