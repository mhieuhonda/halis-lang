# ============================================================================
# benchmarks/size_watch/match_matrix.hls — Stage 139: the tracked size
# suite, workload 5 of 5 — the MATCH DISPATCH.
# ----------------------------------------------------------------------------
# A wide enum walked through match arms and an if-chain shadow: the
# dispatch machinery a codegen release regresses — comparison chain
# layout, arm order, per-branch girth — grows with the ARM COUNT,
# and the payload arms keep the extractor code in the emission too.
# Twelve variants, each visited exactly once around a fixed loop;
# the checksum pins the trip, the axes pin the machinery.
# ============================================================================

enum Op {
    Nop,
    AddI(int),
    SubI(int),
    MulI(int),
    DivI(int),
    ModI(int),
    Neg,
    Abs,
    ClampHi(int),
    ClampLo(int),
    SwapSign,
    Fold(int, int)
}

fn abs_of(v: int) -> int {
    if v < 0 {
        return 0 - v
    }
    return v
}

fn clamp_hi(v: int, hi: int) -> int {
    if v > hi {
        return hi
    }
    return v
}

fn clamp_lo(v: int, lo: int) -> int {
    if v < lo {
        return lo
    }
    return v
}

fn apply(op: Op, acc: int) -> int {
    return match op {
        Op.Nop => acc,
        Op.AddI(v) => acc + v,
        Op.SubI(v) => acc - v,
        Op.MulI(v) => acc * v,
        Op.DivI(v) => acc / 3 + v,
        Op.ModI(v) => acc % 1000 + v,
        Op.Neg => 0 - acc,
        Op.Abs => abs_of(acc),
        Op.ClampHi(hi) => clamp_hi(acc, hi),
        Op.ClampLo(lo) => clamp_lo(acc, lo),
        Op.SwapSign => (0 - acc) - 1,
        Op.Fold(a, b) => (acc + a) * 2 - b
    }
}

fn main() -> int uses IO {
    let ops: list[Op] = [Op.Nop, Op.AddI(10), Op.SubI(4), Op.MulI(6),
    Op.DivI(2), Op.ModI(13), Op.Neg, Op.Abs,
    Op.ClampHi(5000), Op.ClampLo(2000),
    Op.SwapSign, Op.Fold(7, 3)]
    let mut acc: int = 1
    let mut i: int = 0
    while i < ops.len() {
        acc = apply(ops.get(i), acc)
        i = i + 1
    }
    println("match checksum=" + acc.to_str())
    return 0
}
