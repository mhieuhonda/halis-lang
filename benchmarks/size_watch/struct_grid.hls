# ============================================================================
# benchmarks/size_watch/struct_grid.hls — Stage 139: the tracked size
# suite, workload 4 of 5 — the TYPE-DRIVEN EMISSION.
# ----------------------------------------------------------------------------
# Struct literals, nested structs, a list of structs walked field by
# field: the type-driven emission a release can bloat (per-field
# clone guards, redundant defaults, wider box headers) without a
# single visible byte of output changing. The grid is fixed — four
# cells built from literal components, folded into one checksum —
# so the axes track the CODEGEN's girth per struct shape, never the
# data's.
# ============================================================================

struct Cell {
    row: int,
    col: int,
    weight: int
}

struct Span {
    start: Cell,
    end: Cell
}

impl Cell {
    fn area(self: Cell) -> int {
        return(self.row + 1) * (self.col + 1) + self.weight
    }
    fn same(self: Cell, other: Cell) -> bool {
        return self.row == other.row && self.col == other.col
    }
}

impl Span {
    fn manhattan(self: Span) -> int {
        let mut dr: int = self.end.row - self.start.row
        let mut dc: int = self.end.col - self.start.col
        if dr < 0 {
            dr = 0 - dr
        }
        if dc < 0 {
            dc = 0 - dc
        }
        return dr + dc
    }
}

fn make_cell(row: int, col: int, weight: int) -> Cell {
    return Cell {
        row: row, col: col, weight: weight
    }
}

fn main() -> int uses IO {
    let cells: list[Cell] = [make_cell(0, 0, 3), make_cell(1, 2, 5),
    make_cell(2, 4, 7), make_cell(3, 6, 11)]
    let span: Span = Span {
        start: make_cell(0, 1, 2),
        end: make_cell(5, 4, 9)
    }
    let mut acc: int = span.manhattan()
    let mut i: int = 0
    while i < cells.len() {
        let c: Cell = cells.get(i)
        acc = acc + c.area()
        if c.same(make_cell(1, 2, 0)) {
            acc = acc + 1
        }
        i = i + 1
    }
    println("struct checksum=" + acc.to_str())
    return 0
}
