# ============================================================================
# benchmarks/size_watch/str_table.hls — Stage 139: the tracked size
# suite, workload 2 of 5 — the STRING SURFACE.
# ----------------------------------------------------------------------------
# The runtime's string machinery: to_str rendering, concatenation,
# slicing, byte reads, split/trim paths — the stdlib surface every
# CLI tool leans on, and the code a release can quietly duplicate
# (a second copy of the render loop, an unshared table) without any
# test noticing, because the OUTPUT never changes — only the .text
# section does. The loop is fixed-count and purely deterministic:
# same run, same bytes, same checksum; only the compiler's emission
# decides how fat the machinery that makes them is.
# ============================================================================

fn render(n: int, tag: str) -> str {
    return tag + "[" + n.to_str() + "]=" + (n * 2).to_str()
}

fn main() -> int uses IO {
    let base: str = "hls-size-string-surface-"
    let mut acc: int = 0
    let mut i: int = 0
    while i < 64 {
        let s: str = render(i, base)
        acc = acc + s.len()
        acc = acc + s.byte_at(i % s.len())
        let head: str = s.slice(0, 4)
        if head.starts_with("hls-") {
            acc = acc + 1
        }
        i = i + 1
    }
    let parts: list[str] = "a,,b,c".split(",")
    acc = acc + parts.len() * 7
    println("str checksum=" + acc.to_str())
    return 0
}
