# ============================================================================
# benchmarks/rss_watch/list_churn.hls — Stage 137: the tracked memory
# suite, workload 3 of 4 — the HEAP CHURN shape.
# ----------------------------------------------------------------------------
# Push-everything-then-pop-everything over a 65536-element int list
# plus an 8-key map per cycle: the allocator-bin traffic a real
# service does between requests. The full list is held LIVE AT THE
# CYCLE MARKER (512 KiB, a deterministic page count) and popped AFTER
# it, because the ledger's marker reading must be a property of the CODE,
# not of which microsecond the sampler fired in: the list's own
# growth ladder (old + new during each doubling) peaks at half again
# the final size — deterministic, code-fixed, and reused cycle after
# cycle by the allocator's bins — while everything else the cycle
# touches is sub-page. The cycle is about a millisecond of native
# work, so the marker reader keeps pace and the marker-aligned
# readings are honestly at marker time. A churn regression (bin
# growth, fragmentation, arena pre-sizing) lands in the marker
# mark; a leak lands in the slope the hls-rss instrument certifies
# flat.
#
# The hls-rss workload convention (Stage 125): argv[1] carries the
# cycle count (in-code default when absent), each cycle prints one
# __HLRSS_CYCLE__ <i> marker, i strictly increasing from 0.
# ============================================================================

fn fill(i: int) -> list[int] {
    let xs: list[int] = []
    let mut j: int = 0
    while j < 65536 {
        xs.push(i * 65536 + j)
        j = j + 1
    }
    return xs
}

fn churn_map(i: int) -> int {
    let m: map[str, int] = map_new()
    m.set("alpha", i)
    m.set("beta", i * 2)
    m.set("gamma", i * 3)
    m.set("delta", i * 4)
    m.set("epsilon", i * 5)
    m.set("zeta", i * 6)
    m.set("eta", i * 7)
    m.set("theta", i * 8)
    return m.get_or("alpha", 0) + m.get_or("theta", 0)
}

fn main() -> int uses IO {
    let mut cycles: int = 200
    let a: list[str] = args()
    if a.len() > 1 {
        cycles = a.get(1).to_int()
    }
    let mut checksum: int = 0
    let mut i: int = 0
    while i < cycles {
        let xs: list[int] = fill(i)
        checksum = checksum + xs.get(65535) + churn_map(i)
        println("__HLRSS_CYCLE__ " + i.to_str())
        # the churn-down happens AFTER the marker: the list is full at
        # the marker, drained one line later — the scope-exit law.
        while xs.len() > 0 {
            checksum = checksum + xs.pop()
        }
        i = i + 1
    }
    println("checksum=" + checksum.to_str())
    return 0
}
