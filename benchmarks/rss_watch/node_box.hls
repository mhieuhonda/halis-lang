# ============================================================================
# benchmarks/rss_watch/node_box.hls — Stage 137: the tracked memory
# suite, workload 2 of 4 — the BOXED-OBJECT shape.
# ----------------------------------------------------------------------------
# 4096 structs per cycle, each carrying an int id, a freshly built
# name string and a two-element list of tag strings: the per-object
# overhead layout (struct header, boxed fields, list node, string
# headers) that every record, message and AST node in a real program
# is built from. The full node list is held LIVE AT THE CYCLE MARKER
# (about 600 KiB, a deterministic page count) and popped AFTER it,
# because the ledger's marker reading must be a property of the CODE, not
# of which microsecond the sampler fired in: every per-object
# allocation is small enough that the growth transients stay
# sub-page, so the marker state dominates everything the sampler
# could catch; the cycle is a millisecond and more of native work
# (some forty thousand small allocations), so the marker reader keeps
# pace and the marker-aligned readings are honestly at marker time.
# A per-object cost regression — one extra hidden header, one wider
# allocation, a dropped packing optimisation — multiplies by exactly
# the node count and lands in the marker reading this workload
# reports.
#
# The hls-rss workload convention (Stage 125): argv[1] carries the
# cycle count (in-code default when absent), each cycle prints one
# __HLRSS_CYCLE__ <i> marker, i strictly increasing from 0.
# ============================================================================

struct Node {
    id: int,
    name: str,
    tags: list[str]
}

fn build(i: int) -> list[Node] {
    let nodes: list[Node] = []
    let mut j: int = 0
    while j < 4096 {
        let t: list[str] = []
        t.push("tag-a-" + j.to_str())
        t.push("tag-b-" + j.to_str())
        nodes.push(Node {
            id: i * 4096 + j,
            name: "node-" + j.to_str(),
            tags: t
        })
        j = j + 1
    }
    return nodes
}

fn main() -> int uses IO {
    let mut cycles: int = 200
    let a: list[str] = args()
    if a.len() > 1 {
        cycles = a.get(1).to_int()
    }
    let mut checksum: int = 0
    let mut i: int = 0
    while i < cycles {
        let nodes: list[Node] = build(i)
        let mut k: int = 0
        while k < nodes.len() {
            let n: Node = nodes.get(k)
            checksum = checksum + n.id + n.name.len()
            + n.tags.get(0).len()
            k = k + 1
        }
        println("__HLRSS_CYCLE__ " + i.to_str())
        # the drain happens AFTER the marker: the nodes are live at
        # the marker, popped one line later — the scope-exit law.
        while nodes.len() > 0 {
            let n: Node = nodes.pop()
            checksum = checksum + n.id
        }
        i = i + 1
    }
    println("checksum=" + checksum.to_str())
    return 0
}
