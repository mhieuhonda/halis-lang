# ============================================================================
# benchmarks/rss_watch/startup_floor.hls — Stage 137: the tracked memory
# suite, workload 1 of 4 — the FLOOR.
# ----------------------------------------------------------------------------
# The resident-set floor every Halis native binary stands on: the C
# runtime's static image, stdio buffers, the initial stack — everything
# the process touches before the program's own heap work begins. The
# cycle body allocates NOTHING (masked integer arithmetic only), so the
# marker reading this workload reports is the floor plus the marker
# println's own line buffer; a growth here means the RUNTIME got
# heavier, not the program — the first thing a memory regression
# dashboard must be able to say.
#
# The hls-rss workload convention (Stage 125): argv[1] carries the
# cycle count (in-code default when absent), each cycle prints one
# __HLRSS_CYCLE__ <i> marker, i strictly increasing from 0, and any
# other output is ignored by the verifier. Purely scalar, purely
# deterministic — no clock, no randomness, no IO beyond the markers.
# The cycle body is sized so one cycle is roughly a millisecond of
# native work: the sampler and the marker reader must both keep pace
# with the workload, or the marker-aligned readings drift into
# neighboring phases and the trace stops being the program's.
# ============================================================================

fn spin(rounds: int) -> int {
    let mut acc: int = 7
    let mut i: int = 0
    while i < rounds {
        acc = acc * 3 + i
        acc = acc - (acc / 1000003) * 1000003
        i = i + 1
    }
    return acc
}

fn main() -> int uses IO {
    let mut cycles: int = 200
    let a: list[str] = args()
    if a.len() > 1 {
        cycles = a.get(1).to_int()
    }
    let mut checksum: int = 0
    let mut i: int = 0
    while i < cycles {
        checksum = checksum + spin(400000)
        println("__HLRSS_CYCLE__ " + i.to_str())
        i = i + 1
    }
    println("checksum=" + checksum.to_str())
    return 0
}
