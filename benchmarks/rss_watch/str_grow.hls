# ============================================================================
# benchmarks/rss_watch/str_grow.hls — Stage 137: the tracked memory
# suite, workload 4 of 4 — the STRING GROWTH shape.
# ----------------------------------------------------------------------------
# Per cycle the workload builds a table of 1024 strings, each grown
# from a 20-byte seed to just over 4 KiB by repeated doubling — the
# realloc ladder every string builder walks (allocate the doubled
# buffer while the old one is still live, copy, free). The table is
# held LIVE AT THE CYCLE MARKER (about 5 MiB, a deterministic page
# count) and
# torn down after it, because the ledger's marker reading must be a
# property of the CODE, not of which microsecond the 10 ms sampler
# happened to fire in: the growth ladder's transient overshoot (old +
# new during one doubling) stays under 2 KiB — half a page — so the
# marker state dominates every transient the sampler could catch.
# The cycle is a millisecond and more of native work on top of that
# (about 10 MB of doubling traffic), so the marker reader keeps pace
# and the marker-aligned readings are honestly at marker time. A
# regression in string headers, concat growth or the allocator's
# per-chunk overhead lands in this workload's marker reading.
#
# The hls-rss workload convention (Stage 125): argv[1] carries the
# cycle count (in-code default when absent), each cycle prints one
# __HLRSS_CYCLE__ <i> marker, i strictly increasing from 0.
# ============================================================================

fn seed(i: int, j: int) -> str {
    return "s" + j.to_str() + "-" + i.to_str() + "-payload"
}

fn str_table(i: int) -> list[str] {
    let xs: list[str] = []
    let mut j: int = 0
    while j < 1024 {
        let mut s: str = seed(i, j)
        while s.len() < 4096 {
            s = s + s
        }
        xs.push(s)
        j = j + 1
    }
    return xs
}

fn main() -> int uses IO {
    let mut cycles: int = 200
    let a: list[str] = args()
    if a.len() > 1 {
        cycles = a.get(1).to_int()
    }
    let mut checksum: int = 0
    let mut i: int = 0
    while i < cycles {
        let xs: list[str] = str_table(i)
        checksum = checksum + xs.get(1023).len()
        + xs.get(0).byte_at(9)
        println("__HLRSS_CYCLE__ " + i.to_str())
        # the tear-down happens AFTER the marker: the table is live at
        # the marker, dead one line later — the scope-exit law.
        checksum = checksum + xs.len()
        i = i + 1
    }
    println("checksum=" + checksum.to_str())
    return 0
}
