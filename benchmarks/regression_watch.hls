# ============================================================================
# benchmarks/regression_watch.hls — Stage 136: the tracked perf suite
# ----------------------------------------------------------------------------
# The suite the per-commit dashboard tracks by default (hls-perf
# record, no --suite). Exactly the shape an hls-bench suite takes
# (Stage 124's convention): a module-style Halis file with NO main —
# the runner is its program — one `fn bench_<name>()` per bench, an
# optional `fn units_<name>() -> int` for the throughput unit.
#
# Five benches, one per hot shape a language release can quietly
# regress:
#
#   bench_int_loop    the arithmetic loop (interpreter dispatch,
#                     integer ops)          units: 128 iterations
#   bench_str_build   repeated string growth (concat + realloc)
#                                           units: 96 chars grown
#   bench_list_ops    heap-list churn (push/pop traffic)
#                                           units: 64 elements moved
#   bench_fnv_hash    byte-level hashing (the FNV-1a inner loop)
#                                           units: 384 bytes hashed
#   bench_match_enum  enum construction + match dispatch
#                                           units: 48 dispatches
#
# Every bench is deterministic and allocation-shaped — no clock, no
# randomness, no IO — so a regression measured here is the toolchain's
# regression, not the workload's mood. The workloads are sized so one
# bench iteration costs at least a few microseconds on the Stage-0
# interpreter: enough timer resolution under the fixed-iter plan
# hls-perf records with (10 samples x 400 iterations) for the Welch
# test to have something to test.
# ============================================================================

fn bench_int_loop() {
    let mut acc: int = 0
    let mut i: int = 0
    while i < 128 {
        acc = acc * 3 + i
        acc = acc - (acc / 1000003) * 1000003
        i = i + 1
    }
    if acc < 0 {
        panic("impossible: the accumulator is masked non-negative")
    }
}

fn units_int_loop() -> int {
    return 128
}

fn bench_str_build() -> str {
    let mut s: str = ""
    let mut i: int = 0
    while i < 12 {
        s = s + "abcdefgh"
        i = i + 1
    }
    return s
}

fn units_str_build() -> int {
    return 96
}

fn bench_list_ops() {
    let mut xs: list[int] = []
    let mut i: int = 0
    while i < 64 {
        xs.push(i * 2 - 13)
        i = i + 1
    }
    while xs.len() > 0 {
        let _top: int = xs.pop()
    }
}

fn units_list_ops() -> int {
    return 64
}

# FNV-1a over a 48-byte literal, 8 rounds — the byte-at-a-time inner
# loop every hash table in the runtime leans on. The xor/multiply
# masking is spelled with the language's own bitwise builtin
# (int_xor — Halis has no `^` operator; this is the mix, not a typo).
# The literal is exactly 48 bytes (counted; the units function derives
# the same number from the same literal, so the two cannot drift).
fn fnv48(s: str) -> int {
    let mut h: int = 2166136261
    let mut round: int = 0
    while round < 8 {
        let mut i: int = 0
        while i < s.len() {
            h = int_xor(h, s.byte_at(i))
            h = h * 16777619
            h = h - (h / 4294967296) * 4294967296
            i = i + 1
        }
        round = round + 1
    }
    return h
}

fn bench_fnv_hash() {
    let h: int = fnv48("the quick brown fox jumps over the lazy dog #048")
    if h < 0 {
        panic("impossible: the hash is masked to 32 bits")
    }
}

fn units_fnv_hash() -> int {
    return 8 * "the quick brown fox jumps over the lazy dog #048".len()
}

enum Op {
    Add,
    Neg,
    Scale,
    Wrap
}

fn dispatch(op: Op, v: int) -> int {
    return match op {
        Op.Add => v + 7,
        Op.Neg => 0 - v,
        Op.Scale => v * 3,
        Op.Wrap => v - (v / 1000) * 1000
    }
}

fn bench_match_enum() {
    let ops: list[Op] = [Op.Add, Op.Neg, Op.Scale, Op.Wrap]
    let mut acc: int = 1
    let mut round: int = 0
    while round < 12 {
        let mut k: int = 0
        while k < 4 {
            acc = dispatch(ops[k], acc)
            acc = acc - (acc / 1000003) * 1000003
            k = k + 1
        }
        round = round + 1
    }
    if acc < 0 {
        panic("impossible: the dispatch accumulator is masked")
    }
}

fn units_match_enum() -> int {
    return 48
}
