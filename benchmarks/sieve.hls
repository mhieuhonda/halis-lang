# benchmarks/sieve.hls — Sieve of Eratosthenes up to N.
# Used as a benchmark program: time it takes to count primes <= N.
import "std.time"

fn count_primes(n: int) -> int {
    if n < 2 {
        return 0
    }
    let sieve: list[bool] = []
    let mut k: int = 0
    while k <= n {
        sieve.push(true)
        k = k + 1
    }
    sieve.set(0, false)
    sieve.set(1, false)
    let mut i: int = 2
    while i * i <= n {
        if sieve.get(i) {
            let mut j: int = i * i
            while j <= n {
                sieve.set(j, false)
                j = j + i
            }
        }
        i = i + 1
    }
    let mut count: int = 0
    let mut c: int = 0
    while c <= n {
        if sieve.get(c) {
            count = count + 1
        }
        c = c + 1
    }
    return count
}

fn main() -> int uses IO {
    let n: int = 100000
    println("sieving primes up to " + n.to_str() + "...")
    let start: int = time_stopwatch_start()
    let count: int = count_primes(n)
    let lap: int = time_stopwatch_lap(start)
    println("found " + count.to_str() + " primes in " + lap.to_str() + " ms")
    return 0
}
