# benchmarks/json_bench.hls — Repeatedly parse a fixed JSON payload.
# Used as a benchmark for the std.json parser.
#
# NOTE: This benchmark deliberately avoids the list-literal-with-calls
# pattern that triggers a known codegen limitation in hlc.hls (the
# native compiler hoists list literals into top-level helper functions
# which then can't see the local variables used as element expressions).
# Instead, we build the payload by appending to lists via .push().
import "std.json"
import "std.time"
import "std.str"

fn build_payload() -> str {
    let people_keys: list[str] = []
    people_keys.push("id")
    people_keys.push("name")
    people_keys.push("email")
    people_keys.push("active")

    let p1: list[JsonValue] = []
    p1.push(json_int(1))
    p1.push(json_str("Alice"))
    p1.push(json_str("alice@example.com"))
    p1.push(json_bool(true))

    let p2: list[JsonValue] = []
    p2.push(json_int(2))
    p2.push(json_str("Bob"))
    p2.push(json_str("bob@example.com"))
    p2.push(json_bool(false))

    let p3: list[JsonValue] = []
    p3.push(json_int(3))
    p3.push(json_str("Charlie"))
    p3.push(json_str("charlie@example.com"))
    p3.push(json_bool(true))

    let rows: list[JsonValue] = []
    rows.push(json_object(people_keys, p1))
    rows.push(json_object(people_keys, p2))
    rows.push(json_object(people_keys, p3))

    let top_keys: list[str] = []
    top_keys.push("count")
    top_keys.push("people")

    let top_vals: list[JsonValue] = []
    top_vals.push(json_int(3))
    top_vals.push(json_array(rows))

    return json_stringify(json_object(top_keys, top_vals))
}

fn main() -> int uses IO {
    let payload: str = build_payload()
    println("payload (" + payload.len().to_str() + " bytes):")
    println(payload)

    let n: int = 100
    println("parsing " + n.to_str() + " times...")
    let start: int = time_stopwatch_start()
    let mut i: int = 0
    let mut total_count: int = 0
    while i < n {
        let v: JsonValue = json_parse(payload)
        let top: JsonValue = json_object_get(v, "count")
        total_count = total_count + top.ival
        i = i + 1
    }
    let lap: int = time_stopwatch_lap(start)
    println("total count = " + total_count.to_str() + "  time = " + lap.to_str() + " ms (" + (lap / n).to_str() + " ms/parse)")
    return 0
}
