# conc_bench.hls — Stage 16 (v0.27.0-alpha): concurrency scaling
# benchmark ("web server" shape).
#
# N worker tasks serve M requests through a shared job channel + a result
# channel — exactly the structure of a thread-per-core HTTP server. The
# program prints the wall-clock milliseconds for 1 worker and for N
# workers running the identical request stream, so the speedup is
# directly observable:
#
#     make bootstrap
#     ./bin/hlc benchmarks/conc_bench.hls /tmp/cb.c
#     gcc -O2 -o /tmp/cb /tmp/cb.c -lm -pthread
#     /tmp/cb
#
# The workload is CPU-bound (per-request compute), which is what makes
# parallelism pay: channels add microseconds, the request loop adds
# milliseconds.

fn serve(n: int) -> int {
    let mut acc: int = 0
    let mut i: int = 0
    while i < n {
        acc = acc + (i % 13)
        i = i + 1
    }
    return acc
}

fn worker(jobs: Chan[int], results: Chan[int]) -> int uses Conc {
    let mut served: int = 0
    let mut running: bool = true
    while running {
        let n: int = jobs.recv()
        if n < 0 {
            running = false
        } else {
            results.send(serve(n))
            served = served + 1
        }
    }
    return served
}

fn run_pool(nw: int, nreq: int, per_req: int) -> int uses IO, Clock, Conc {
    let jobs: Chan[int] = chan_new()
    let results: Chan[int] = chan_new()
    let mut ts: list[Task[int]] = []
    let mut w: int = 0
    while w < nw {
        ts.push(spawn(worker, clone(jobs), clone(results)))
        w = w + 1
    }
    let t0: int = clock_ms()
    let mut j: int = 0
    while j < nreq {
        jobs.send(per_req)
        j = j + 1
    }
    let mut s: int = 0
    while s < nw {
        jobs.send(-1)
        s = s + 1
    }
    let mut checksum: int = 0
    let mut r: int = 0
    while r < nreq {
        checksum = checksum + results.recv()
        r = r + 1
    }
    let mut served: int = 0
    let mut k: int = 0
    while k < nw {
        let t: Task[int] = ts.get(k)
        served = served + t.join()
        k = k + 1
    }
    let t1: int = clock_ms()
    let ms: int = t1 - t0
    println("workers=" + nw.to_str() + " requests=" + nreq.to_str()
            + " served=" + served.to_str() + " checksum=" + checksum.to_str()
            + " wall_ms=" + ms.to_str())
    return ms
}

fn main() -> int uses IO, Clock, Conc {
    let per_req: int = 100000000
    let nreq: int = 8
    # Warm-up + single-worker baseline.
    let ms1: int = run_pool(1, nreq, per_req)
    # 2 and 4 worker pools on the same stream.
    let ms2: int = run_pool(2, nreq, per_req)
    let ms4: int = run_pool(4, nreq, per_req)
    println("speedup 2w=" + (ms1 * 100 / ms2).to_str() + "% 4w=" + (ms1 * 100 / ms4).to_str() + "%")
    return 0
}
