# benchmarks/crypto_bench.hls — Hash a string repeatedly.
# Used as a benchmark for the std.crypto hash functions.
import "std.crypto"
import "std.time"

fn main() -> int uses IO {
    let input: str = "Halis is a high-security, self-hosting, native-compiled programming language."
    let n: int = 100
    println("hashing " + n.to_str() + " times (" + input.len().to_str() + " bytes each)")

    let s1: int = time_stopwatch_start()
    let mut i: int = 0
    let mut acc32: int = 0
    while i < n {
        acc32 = acc32 + crypto_fnv1a_32(input)
        i = i + 1
    }
    let l1: int = time_stopwatch_lap(s1)
    println("fnv1a_32:  " + l1.to_str() + " ms  (acc=" + acc32.to_str() + ")")

    let s2: int = time_stopwatch_start()
    i = 0
    let mut acc64: str = ""
    while i < n {
        acc64 = crypto_fnv1a_64_hex(input)
        i = i + 1
    }
    let l2: int = time_stopwatch_lap(s2)
    println("fnv1a_64:  " + l2.to_str() + " ms  (last=" + acc64 + ")")

    let s3: int = time_stopwatch_start()
    i = 0
    let mut acc_crc: str = ""
    while i < n {
        acc_crc = crypto_crc32_hex(input)
        i = i + 1
    }
    let l3: int = time_stopwatch_lap(s3)
    println("crc32:     " + l3.to_str() + " ms  (last=" + acc_crc + ")")

    return 0
}
