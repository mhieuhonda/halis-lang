# ============================================================================
# benchmarks/ctime_watch/lex_dense.hls — Stage 138: the compile-time
# suite, workload 1 of 5 — THE TOKEN STREAM.
# ----------------------------------------------------------------------------
# One file per front-end shape a compiler release can quietly slow
# down. This one is the LEXER (and the parser's dispatch over a long
# token stream): sixty small functions, each a dense mix of arithmetic
# operators, underscored integer literals, string constants with
# escapes and adjacent punctuation, the bitwise builtins, comment
# lines and match expressions — the LEXED BYTE COUNT, not the checked
# type count, dominates this file's compile time. Every function is
# reachable from main (the compiler walks them all; the program does
# no runtime work worth timing — the work is the compile itself).
#
# Sizing: every workload in the suite is sized so ONE stage0 compile
# (the bootstrap chain) costs at least a few hundred milliseconds and
# one native compile at least a few dozen — under the fixed-sample
# plan hls-ctime records with (6 samples + 1 warmup by default), a
# workload that compiles in microseconds measures the scheduler, not
# the compiler. The suite is IMPORT-FREE by construction: the suite
# digest covers the workload bytes and names, and an imported std
# module would be compiled but not digested — an honest digest only
# covers what it can see.
# ============================================================================

enum Mod5 {
    Zero,
    One,
    Two,
    Three,
    Other
}

enum Mod4 {
    Even,
    Quarter,
    Half,
    Rest
}

enum Small {
    A,
    B,
    C,
    D,
    E
}

fn mod5_of(a: int) -> Mod5 {
    # The residue ladder — Halis match patterns are enum variants and
    # wildcards, not integer literals; the ladder folds ints into the
    # variants the match arms want.
    let r: int = a - (a / 5) * 5
    if r == 0 {
        return Mod5.Zero
    }
    if r == 1 {
        return Mod5.One
    }
    if r == 2 {
        return Mod5.Two
    }
    if r == 3 {
        return Mod5.Three
    }
    return Mod5.Other
}

fn mod4_of(a: int) -> Mod4 {
    let r: int = a - (a / 4) * 4
    if r == 0 {
        return Mod4.Even
    }
    if r == 1 {
        return Mod4.Quarter
    }
    if r == 2 {
        return Mod4.Half
    }
    return Mod4.Rest
}

fn small_of(a: int) -> Small {
    if a == 0 {
        return Small.A
    }
    if a == 1 {
        return Small.B
    }
    if a == 2 {
        return Small.C
    }
    if a == 3 {
        return Small.D
    }
    return Small.E
}

fn lex_mix000(a: int, b: int) -> int {
    # + - * / % over the integer shapes the lexer spells: plain,
    # underscore-grouped, and parenthesised mixes.
    let mut r: int = 0
    r = a + b * 3 - 17 / 5 % 7
    r = r * (a - b) + (a + b) / 2
    r = r - a % 100 * (b / 10 + 3)
    r = r + 1_000_000 + 2_048 + 96
    return r
}

fn lex_mix001(a: int, b: int) -> int {
    let mut r: int = 0
    r = a * 2 + b / 3 - 17 % 5
    r = r + (a - 7) * (b + 11) - (a % 13)
    r = r / (1 + 2 * 3) + 900_719_925 - 474
    return r
}

fn lex_mix002(a: int, b: int) -> int {
    let mut r: int = 0
    r = a - b + a / 7 * b % 3
    r = r * 2 - (b - a) / (a % 9 + 1)
    r = r + 4_294_967 - 296 + 33
    return r
}

fn lex_mix003(a: int, b: int) -> int {
    let mut r: int = 0
    r = (a + b) * (a - b) / (a % 3 + 1)
    r = r % 1000 * 7 - b / 11 + a
    r = r + 65_536 - 4_096 + 256
    return r
}

fn lex_mix004(a: int, b: int) -> int {
    let mut r: int = 0
    r = a * b / (a + 1) - b % (a + 3)
    r = r + (17 - a) * (19 - b) / 5
    r = r - 1_048_576 + 1_024 + 64
    return r
}

fn lex_mix005(a: int, b: int) -> int {
    let mut r: int = 0
    r = a + a + a - b - b + b / 2 * 2
    r = r * 3 % 71 + (a % 7) * (b % 5)
    r = r + 131_072 - 8_192 + 512
    return r
}

fn lex_bits006(a: int, b: int) -> int {
    # The bitwise-builtin surface: six spellings the lexer walks as
    # plain identifiers, the parser as calls.
    let mut r: int = int_xor(a, 15)
    r = int_or(r, int_and(b, 60))
    r = int_xor(int_and(a, 195), r)
    r = int_and(r, 255)
    r = int_or(r, int_shl(r, 2))
    r = r - int_shr(r, 1)
    return r
}

fn lex_bits007(a: int, b: int) -> int {
    let mut r: int = int_and(b, 85)
    r = int_or(r, int_xor(a, 170))
    r = int_and(r, int_shl(b, 1))
    r = int_xor(r, int_shr(r, 3))
    r = r + int_shl(int_and(a, 15), 4)
    return r
}

fn lex_bits008(a: int, b: int) -> int {
    let mut r: int = int_shl(a, 1)
    r = r + int_shr(b, 1)
    r = int_xor(r, int_and(r, 17))
    r = int_or(r, int_shl(r, 3))
    r = int_and(r, 4095)
    return r
}

fn lex_bits009(a: int, b: int) -> int {
    let mut r: int = int_not(a)
    r = int_and(r, int_or(a, b))
    r = int_xor(r, int_shr(int_shl(a, 4), 2))
    r = r + (b - a % 19)
    return r
}

fn lex_bits010(a: int, b: int) -> int {
    let mut r: int = int_shr(a, 2)
    r = int_or(r, int_shl(int_and(a, 3), 6))
    r = int_xor(r, int_and(b, 63))
    r = r + int_xor(int_shr(b, 1), int_shl(b, 1))
    return r
}

fn lex_str011(tag: str, n: int) -> str {
    # The string-literal surface: escapes and adjacent punctuation —
    # the lexer's slow path is here.
    let mut s: str = tag + "-\t-" + tag
    s = s + "\n" + tag + "\"" + " \\ " + "\""
    s = s + "x" + (n / 100).to_str()
    s = s + "..." + tag + "/" + tag + "?" + tag + "!"
    return s
}

fn lex_str012(tag: str, n: int) -> str {
    let mut s: str = "a\tb\nc\\d\"e"
    s = s + tag + (n % 10).to_str() + "-"
    s = s + "::" + tag + ";" + "," + ":" + ";"
    s = s + "\n" + "\\" + "\"" + "'" + tag
    return s
}

fn lex_str013(tag: str, n: int) -> str {
    let mut s: str = "" + tag + tag + tag
    s = s + "0" + (n % 7).to_str()
    s = s + "<>" + "<=" + ">=" + "==" + "!="
    s = s + "&&" + "||" + "!" + "=" + tag
    return s
}

fn lex_str014(tag: str, n: int) -> str {
    let mut s: str = "p" + "q" + "r" + "s" + "t"
    s = s + tag + "-" + (n % 13).to_str() + "-"
    s = s + "{}" + "}" + "{" + "()" + "[]" + "]["
    s = s + "\\\\" + "\n\n" + tag + ".hls"
    return s
}

fn lex_str015(tag: str, n: int) -> str {
    let mut s: str = ""
    s = s + "z" + tag + "!"
    s = s + (n * 1).to_str() + "%" + "&" + "|"
    s = s + "^" + "~" + "+" + "-" + "*" + "/"
    s = s + tag + tag + "#" + "eof"
    return s
}

fn lex_bool016(a: bool, b: bool) -> bool {
    let r: bool = a && b || !a && !b
    return r && (a || b) && !(!a && !b)
}

fn lex_bool017(a: bool, b: bool) -> bool {
    let r: bool = (a || b) && !(a && b)
    return r == (a != b) && true || false
}

fn lex_if018(a: bool, b: bool, c: bool) -> bool {
    if a {
        return b
    }
    return c
}

fn lex_bool018(a: bool, b: bool, c: bool) -> bool {
    let r: bool = lex_if018(a, b, c)
    return r == (a && b || !a && c)
}

fn lex_bool019(a: bool, b: bool) -> bool {
    return (a && !b) || (!a && b) || (a && b) || !(!a && !b)
}

fn lex_bool020(a: bool, b: bool, c: bool) -> bool {
    let r: bool = a == b
    let s: bool = b == c
    return r == s && (r || s) && !(!r && !s)
}

fn lex_loop021(a: int, b: int) -> int {
    let mut r: int = 0
    let mut i: int = 0
    while i < 32 {
        r = (r + a * i - b % (i + 1)) % 1000003
        i = i + 1
    }
    return r
}

fn lex_loop022(a: int, b: int) -> int {
    let mut r: int = 0
    let mut i: int = 0
    while i < 32 {
        r = (r * 2 + (a + i) % (b % 9 + 1)) % 1000003
        i = i + 1
    }
    return r
}

fn lex_loop023(a: int, b: int) -> int {
    let mut r: int = 1
    let mut i: int = 0
    while i < 24 {
        r = (r * (a % (i + 3) + 1) - b / (i + 1)) % 1000003
        i = i + 1
    }
    return r
}

fn lex_loop024(a: int, b: int) -> int {
    let mut r: int = 0
    let mut i: int = 0
    while i < 40 {
        if i % 2 == 0 {
            r = r + a
        } else {
            r = r - b
        }
        i = i + 1
    }
    return r
}

fn lex_branch025(a: int, b: int) -> int {
    let mut r: int = a
    if a > b {
        r = r - b / 2 * 2 + 33
    } else {
        if a < b {
            r = r + b * 2 - 27
        } else {
            r = r + 3
        }
    }
    return r
}

fn lex_branch026(a: int, b: int) -> int {
    let mut r: int = 0
    if a % 2 == 0 {
        r = r + a / 2
    } else {
        if b % 2 == 0 {
            r = r + b * 3
        }
    }
    if r == 0 {
        r = 7
    }
    return r
}

fn lex_build027() -> str {
    let mut s: str = ""
    let mut i: int = 0
    while i < 48 {
        s = s + (i % 10).to_str() + "-"
        i = i + 1
    }
    return s
}

fn lex_build028() -> str {
    let mut s: str = "seed"
    let mut i: int = 0
    while i < 40 {
        s = s + "\t" + (i * i % 100).to_str()
        i = i + 1
    }
    return s
}

fn lex_build029(tag: str) -> str {
    let mut s: str = ""
    let mut i: int = 0
    while i < 36 {
        s = s + tag + "/" + (i % 6).to_str() + ";"
        i = i + 1
    }
    return s
}

fn lex_build030() -> str {
    let mut s: str = ""
    let mut i: int = 0
    while i < 30 {
        if i % 3 == 0 {
            s = s + "a"
        } else {
            if i % 3 == 1 {
                s = s + "\\\\"
            } else {
                s = s + "\"q\""
            }
        }
        i = i + 1
    }
    return s
}

fn lex_match031(a: int) -> int {
    return match mod5_of(a) {
        Mod5.Zero => a * 2,
        Mod5.One => a + 17,
        Mod5.Two => a - 5,
        Mod5.Three => a * a % 101,
        Mod5.Other => a / 3
    }
}

fn lex_match032(a: int) -> int {
    return match mod4_of(a) {
        Mod4.Even => 16 + a,
        Mod4.Quarter => a - 8,
        Mod4.Half => 64 + a,
        Mod4.Rest => a % 9
    }
}

fn lex_match033(a: int, b: int) -> int {
    let r: int = match small_of(a) {
        Small.A => b,
        Small.B => b + 1,
        Small.C => b + 2,
        Small.D => b + 3,
        Small.E => b * 4
    }
    return r * 3 % 257
}

fn lex_match034(a: int, b: int) -> int {
    let m: Mod4 = mod4_of(b % 3)
    let r: int = match m {
        Mod4.Even => a,
        Mod4.Quarter => a + b,
        _ => a - b
    }
    let n: Mod5 = mod5_of(r % 2 + 4)
    let sgn: int = match n {
        Mod5.Other => 0 - 1,
        _ => 1
    }
    return r + sgn
}

fn lex_match035(a: int) -> int {
    let mut r: int = 0
    let mut i: int = 0
    while i < 16 {
        let d: int = match small_of(i % 5) {
            Small.A => a,
            Small.B => r,
            Small.C => 255,
            Small.D => 0 - 251,
            Small.E => r % 31
        }
        r = r + d
        i = i + 1
    }
    return r
}

fn lex_fan036(a: int, b: int) -> int {
    let mut acc: int = 0
    acc = acc + lex_mix000(a, b)
    acc = acc + lex_mix001(a, b)
    acc = acc + lex_mix002(a, b)
    acc = acc + lex_mix003(a, b)
    acc = acc + lex_mix004(a, b)
    acc = acc + lex_mix005(a, b)
    return acc
}

fn lex_fan037(a: int, b: int) -> int {
    let mut acc: int = 0
    acc = acc + lex_bits006(a, b)
    acc = acc + lex_bits007(a, b)
    acc = acc + lex_bits008(a, b)
    acc = acc + lex_bits009(a, b)
    acc = acc + lex_bits010(a, b)
    return acc
}

fn lex_fan038(a: int, b: int) -> str {
    let mut s: str = ""
    s = s + lex_str011("t", a)
    s = s + lex_str012("u", b)
    s = s + lex_str013("v", a + b)
    s = s + lex_str014("w", a * b)
    s = s + lex_str015("x", a - b)
    return s
}

fn lex_fan039(a: int, b: int) -> bool {
    let mut r: bool = lex_bool016(a % 2 == 0, b % 2 == 0)
    r = r && lex_bool017(a > b, a < b)
    r = r || lex_bool018(a == b, a > 0, b > 0)
    r = r == lex_bool019(a != 0, b != 0)
    return r && (lex_bool020(a > 0, b > 0, a + b > 0) || true)
}

fn lex_fan040(a: int, b: int) -> int {
    let mut acc: int = 0
    acc = acc + lex_loop021(a, b)
    acc = acc + lex_loop022(a, b)
    acc = acc + lex_loop023(a, b)
    acc = acc + lex_loop024(a, b)
    return acc
}

fn lex_fan041(a: int, b: int) -> int {
    let mut acc: int = 0
    acc = acc + lex_branch025(a, b)
    acc = acc + lex_branch026(a, b)
    acc = acc + lex_build027().len()
    acc = acc + lex_build028().len()
    acc = acc + lex_build029("k").len()
    acc = acc + lex_build030().len()
    return acc
}

fn lex_fan042(a: int, b: int) -> int {
    let mut acc: int = 0
    acc = acc + lex_match031(a)
    acc = acc + lex_match032(a)
    acc = acc + lex_match033(a, b)
    acc = acc + lex_match034(a, b)
    acc = acc + lex_match035(a)
    return acc
}

fn lex_fan043(a: int, b: int) -> int {
    let mut acc: int = 0
    let mut i: int = 0
    while i < 8 {
        acc = acc + lex_fan036(a + i, b + i)
        acc = acc + lex_fan037(a - i, b - i)
        i = i + 1
    }
    return acc
}

fn lex_fan044(a: int, b: int) -> int {
    let mut acc: int = 0
    let mut i: int = 0
    while i < 6 {
        acc = acc + lex_fan038(a + i, b + i).len()
        acc = acc + lex_fan042(a * i + 1, b * i + 1)
        i = i + 1
    }
    return acc
}

fn lex_fan045(a: int, b: int) -> int {
    let mut acc: int = 0
    if lex_fan039(a, b) {
        acc = acc + lex_fan040(a, b)
    } else {
        acc = acc + lex_fan041(a, b)
    }
    acc = acc + lex_fan043(a % 97, b % 89)
    acc = acc + lex_fan044(a % 53, b % 47)
    return acc
}

# ----------------------------------------------------------------------
# The driver. main walks every family once — the compiler sees every
# function called, the runtime does arithmetic nobody will ever read.
# ----------------------------------------------------------------------

fn main() -> int uses IO {
    let mut total: int = 0
    total = total + lex_fan036(3, 5)
    total = total + lex_fan037(7, 11)
    total = total + lex_fan038(17, 19).len()
    if lex_fan039(4, 2) {
        total = total + 1
    }
    total = total + lex_fan040(2, 9)
    total = total + lex_fan041(13, 6)
    total = total + lex_fan042(5, 8)
    total = total + lex_fan043(29, 31)
    total = total + lex_fan044(23, 37)
    total = total + lex_fan045(41, 43)
    if total < 0 {
        panic("impossible: the checksum is masked non-negative")
    }
    println("lex_dense: " + (total % 65536).to_str())
    return total % 256
}
