# ============================================================================
# benchmarks/ctime_watch/check_generic.hls — Stage 138: the
# compile-time suite, workload 3 of 5 — THE TYPE CHECKER.
# ----------------------------------------------------------------------------
# This one is the CHECKER at its most allocation-hungry: generics.
# Every function here is generic, and every driver instantiates it at
# MANY distinct type arguments — int, str, bool, float, list-of-those,
# and user structs — so the monomorphisation table, the unifier and
# the instantiation cache all fill up. The bodies are trivial; the
# TYPE WORK is the workload. (Values are masked or bounded so the
# program is runtime-sound, but no runtime path here does real work.)
# ============================================================================

struct Wrap[T] {
    value: T
}

struct Pair[A, B] {
    first: A,
    second: B
}

struct Triple[A, B, C] {
    one: A,
    two: B,
    three: C
}

struct Keyed[K] {
    key: K,
    weight: int = 1
}

enum Shape[T] {
    Empty,
    One(T),
    Two(T, T)
}

# ----------------------------------------------------------------------
# Section A — the generic kernels, each with a distinct arity and a
# distinct structural use of its parameters.
# ----------------------------------------------------------------------

fn gen_id[T](x: T) -> T {
    return x
}

fn gen_swap[A, B](p: Pair[A, B]) -> Pair[B, A] {
    return Pair { first: p.second, second: p.first }
}

fn gen_first[A, B](p: Pair[A, B]) -> A {
    return p.first
}

fn gen_second[A, B](p: Pair[A, B]) -> B {
    return p.second
}

fn gen_triple_mid[A, B, C](t: Triple[A, B, C]) -> B {
    return t.two
}

fn gen_wrap[T](v: T) -> Wrap[T] {
    return Wrap { value: v }
}

fn gen_unwrap[T](w: Wrap[T]) -> T {
    return w.value
}

fn gen_pair_of[A, B](a: A, b: B) -> Pair[A, B] {
    return Pair { first: a, second: b }
}

fn gen_const[K](k: K, w: int) -> Keyed[K] {
    return Keyed { key: k, weight: (w % 97) + 1 }
}

fn gen_key_of[K](k: Keyed[K]) -> K {
    return k.key
}

fn gen_weight_of[K](k: Keyed[K]) -> int {
    return k.weight
}

fn gen_shape_len[T](s: Shape[T]) -> int {
    return match s {
        Shape.Empty => 0,
        Shape.One(_) => 1,
        Shape.Two(_, _) => 2
    }
}

fn gen_shape_first[T](s: Shape[T], dflt: T) -> T {
    return match s {
        Shape.Empty => dflt,
        Shape.One(v) => v,
        Shape.Two(v, _) => v
    }
}

fn gen_shape_twice(s: Shape[int]) -> Shape[int] {
    # The map-shaped kernel, specialised at int: the checker still
    # walks the generic Shape[T] construction twice (in and out).
    return match s {
        Shape.Empty => Shape.Empty,
        Shape.One(v) => Shape.One((v * 2) % 1000003),
        Shape.Two(a, b) => Shape.Two((a * 2) % 1000003, (b * 2) % 1000003)
    }
}

fn gen_shape_of_len(s: Shape[str]) -> Shape[int] {
    return match s {
        Shape.Empty => Shape.Empty,
        Shape.One(v) => Shape.One(v.len()),
        Shape.Two(a, b) => Shape.Two(a.len(), b.len())
    }
}

fn gen_shape_flip(s: Shape[bool]) -> Shape[bool] {
    return match s {
        Shape.Empty => Shape.Empty,
        Shape.One(v) => Shape.One(!v),
        Shape.Two(a, b) => Shape.Two(!a, !b)
    }
}

fn gen_zip_len[A, B](xs: list[A], ys: list[B]) -> int {
    let n: int = xs.len()
    let m: int = ys.len()
    if n < m {
        return n
    }
    return m
}

fn gen_nth[T](xs: list[T], i: int, dflt: T) -> T {
    if i < 0 {
        return dflt
    }
    if i >= xs.len() {
        return dflt
    }
    return xs.get(i)
}

# ----------------------------------------------------------------------
# Section B — the concrete helpers every driver calls by name; each
# one a distinct signature the checker resolves against the generic
# kernels above (a call is a constraint the unifier must close).
# ----------------------------------------------------------------------

fn int_twice(n: int) -> int {
    return (n * 2) % 1000003
}

fn int_inc(n: int) -> int {
    return n + 1
}

fn str_tag(s: str) -> str {
    return "[" + s + "]"
}

fn str_len(s: str) -> int {
    return s.len()
}

fn bool_flip(b: bool) -> bool {
    return !b
}

fn int_add(a: int, b: int) -> int {
    return (a + b) % 1000003
}

fn int_mul(a: int, b: int) -> int {
    return (a * b) % 1000003
}

fn str_pair_sum(a: str, b: int) -> int {
    return (a.len() + b) % 1000003
}

fn wrap_weight_i(w: Wrap[int]) -> int {
    return w.value % 1000003
}

# ----------------------------------------------------------------------
# Section C — the drivers. Each line is a fresh instantiation; the
# SAME kernel name at DIFFERENT type arguments is the whole point.
# ----------------------------------------------------------------------

fn drive_id() -> int {
    # NOTE: Halis has no if-expression and no bare float arguments;
    # the drivers spell values through annotated lets, which is the
    # style the checker sees in the wild.
    let fl: float = 2.5
    let a: int = gen_id(7)
    let b: str = gen_id("seven")
    let c: bool = gen_id(true)
    let d: float = gen_id(fl)
    let e: list[int] = gen_id([1, 2, 3])
    let f: list[str] = gen_id(["x", "y"])
    let g0: Wrap[int] = Wrap { value: 9 }
    let g: Wrap[int] = gen_id(g0)
    let h0: Pair[int, str] = Pair { first: 1, second: "one" }
    let h: Pair[int, str] = gen_id(h0)
    let g1: Wrap[int] = Wrap { value: 11 }
    let mut r: int = a + b.len() + f.len() + g.value + h.first
        + e.len() + wrap_weight_i(gen_id(g1))
    if c {
        r = r + 1
    }
    r = r + d.to_int() % 3
    return r
}

fn drive_swap() -> int {
    let p1: Pair[int, str] = Pair { first: 4, second: "four" }
    let p2: Pair[str, int] = gen_swap(p1)
    let p3: Pair[bool, float] = Pair { first: false, second: 1.5 }
    let p4: Pair[float, bool] = gen_swap(p3)
    let p5: Pair[list[int], Wrap[str]] = Pair {
        first: [5, 6],
        second: Wrap { value: "w" }
    }
    let p6: Pair[Wrap[str], list[int]] = gen_swap(p5)
    let r: int = p2.second + p2.first.len() + p6.first.value.len()
    if p4.second {
        return r + 1
    }
    return r + p6.second.len()
}

fn drive_triple() -> int {
    let t1: Triple[int, str, bool] = Triple { one: 1, two: "two", three: true }
    let t2: Triple[str, bool, int] = Triple { one: "a", two: false, three: 3 }
    let t3: Triple[bool, int, str] = Triple { one: true, two: 2, three: "c" }
    let m1: str = gen_triple_mid(t1)
    let m2: bool = gen_triple_mid(t2)
    let m3: int = gen_triple_mid(t3)
    let r: int = m1.len() + m3
    if m2 {
        return r
    }
    return r + 1
}

fn drive_wrap() -> int {
    let w1: Wrap[int] = gen_wrap(21)
    let w2: Wrap[str] = gen_wrap("wrapped")
    let w3: Wrap[Wrap[int]] = gen_wrap(w1)
    let p0: Pair[int, int] = Pair { first: 2, second: 3 }
    let w4: Wrap[Pair[int, int]] = gen_wrap(p0)
    let r1: Wrap[int] = gen_wrap(int_twice(w1.value))
    let r2: Wrap[int] = gen_wrap(str_len(w2.value))
    let r3: Wrap[bool] = gen_wrap(bool_flip(gen_unwrap(gen_wrap(true))))
    let r4: Wrap[int] = gen_wrap(gen_first(w4.value))
    let r: int = r1.value + r2.value + r4.value + w3.value.value
    if r3.value {
        return r
    }
    return r + 1
}

fn drive_pair_of() -> int {
    let a1: Pair[int, int] = gen_pair_of(3, 4)
    let a2: Pair[str, int] = gen_pair_of("abc", 5)
    let a3: Pair[str, str] = gen_pair_of("xy", "zw")
    let a4: Pair[bool, float] = gen_pair_of(true, 4.5)
    return a1.first + a1.second + a2.first.len() + a2.second
        + str_concat_len(a3.first, a3.second) + a4.second.to_int() % 7
}

fn str_concat_len(a: str, b: str) -> int {
    return (a + b).len()
}

fn drive_keyed() -> int {
    let k1: Keyed[int] = gen_const(31, 5)
    let k2: Keyed[str] = gen_const("thirty-one", 9)
    let k3: Keyed[bool] = gen_const(true, 3)
    let kp: Pair[int, int] = Pair { first: 1, second: 2 }
    let k4: Keyed[Pair[int, int]] = gen_const(kp, 7)
    let r: int = gen_key_of(k1) + gen_key_of(k2).len()
        + gen_weight_of(k3) + gen_weight_of(k4)
        + gen_key_of(k4).first + gen_key_of(k4).second
    if gen_key_of(k3) {
        return r
    }
    return r + 1
}

fn drive_shape() -> int {
    let s1: Shape[int] = Shape.Two(10, 20)
    let s2: Shape[str] = Shape.One("one")
    let s3: Shape[bool] = Shape.Empty
    let s4: Shape[list[int]] = Shape.Two([1], [2, 3])
    let m1: Shape[int] = gen_shape_twice(s1)
    let m2: Shape[int] = gen_shape_of_len(s2)
    let m3: Shape[bool] = gen_shape_flip(s3)
    let m4: Shape[int] = gen_shape_twice(gen_shape_of_len(s2))
    let r: int = gen_shape_len(m1) + gen_shape_len(m2)
        + gen_shape_len(m4) + gen_shape_first(m1, 0)
        + gen_shape_first(m2, 99) + gen_shape_len(s4)
    if gen_shape_len(m3) > 0 {
        return r + gen_shape_first(m3, false).to_str().len()
    }
    return r
}

fn list_int_sum(xs: list[int]) -> int {
    let mut acc: int = 0
    let mut i: int = 0
    while i < xs.len() {
        acc = (acc + xs.get(i)) % 1000003
        i = i + 1
    }
    return acc
}

fn gen_fold_ints(xs: list[int], init: int, mode: int) -> int {
    # The fold kernel specialised at int — mode picks add or mul.
    let mut acc: int = init
    let mut i: int = 0
    while i < xs.len() {
        if mode == 0 {
            acc = (acc + xs.get(i)) % 1000003
        } else {
            acc = (acc * (xs.get(i) % 97 + 1)) % 1000003
        }
        i = i + 1
    }
    return acc
}

fn gen_fold_lens(xs: list[str], init: int) -> int {
    let mut acc: int = init
    let mut i: int = 0
    while i < xs.len() {
        acc = (acc + xs.get(i).len()) % 1000003
        i = i + 1
    }
    return acc
}

fn gen_fold_bools(xs: list[bool], init: int) -> int {
    let mut acc: int = init
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) {
            acc = acc + i + 1
        } else {
            acc = acc + 1
        }
        i = i + 1
    }
    return acc
}

fn gen_fold_pairs(xs: list[Pair[int, int]], init: int) -> int {
    let mut acc: int = init
    let mut i: int = 0
    while i < xs.len() {
        acc = (acc + xs.get(i).first + xs.get(i).second + i) % 1000003
        i = i + 1
    }
    return acc
}

fn drive_fold() -> int {
    let ints: list[int] = [3, 5, 7, 11, 13]
    let strs: list[str] = ["a", "bb", "ccc"]
    let bools: list[bool] = [true, false, true]
    let pairs: list[Pair[int, int]] = [
        Pair { first: 1, second: 2 },
        Pair { first: 3, second: 4 }
    ]
    let f1: int = gen_fold_ints(ints, 0, 0)
    let f2: int = gen_fold_ints(ints, 1, 1)
    let f3: int = gen_fold_lens(strs, 0)
    let f4: int = gen_fold_bools(bools, 0)
    let f5: int = gen_fold_pairs(pairs, 0)
    return f1 + f2 + f3 + f4 + f5
}

fn drive_nth() -> int {
    let ints: list[int] = [10, 20, 30]
    let strs: list[str] = ["p", "q"]
    let w5: Wrap[int] = Wrap { value: 5 }
    let w6: Wrap[int] = Wrap { value: 6 }
    let w0: Wrap[int] = Wrap { value: 0 }
    let wraps: list[Wrap[int]] = [w5, w6]
    let s1: Shape[int] = Shape.One(1)
    let s2: Shape[int] = Shape.Two(2, 3)
    let se: Shape[int] = Shape.Empty
    let shapes: list[Shape[int]] = [s1, s2]
    let r: int = gen_nth(ints, 1, 0) + gen_nth(ints, 9, 7)
        + gen_nth(strs, 0, "z").len()
        + gen_nth(wraps, 1, w0).value
        + gen_shape_len(gen_nth(shapes, 1, se))
        + gen_zip_len(ints, strs) + gen_zip_len(strs, wraps)
    return r
}

# ----------------------------------------------------------------------
# Section D — cross-instantiation: kernels calling kernels, generic
# drivers driven by generic drivers.
# ----------------------------------------------------------------------

fn gen_tagged_len[T](w: Wrap[T], tag: str) -> int {
    # One generic layer over one concrete kernel — the checker
    # closes both frames (T never carries a method call; Halis
    # generics are structural, not duck-typed).
    return (tag.len() + wrap_weight_i(Wrap { value: tag.len() })) % 1000003
}

fn drive_pipeline() -> int {
    let a: int = int_twice(int_inc(41))
    let b: int = int_inc(str_len("hello"))
    let c: int = gen_tagged_len(gen_wrap("eight"), "eight")
    let d: int = int_inc(bool_to_int(true))
    return a + b + c + d
}

fn bool_to_int(b: bool) -> int {
    if b {
        return 1
    }
    return 0
}

fn gen_max_int(a: int, b: int) -> int {
    if a < b {
        return b
    }
    return a
}

fn gen_max_str(a: str, b: str) -> str {
    if a < b {
        return b
    }
    return a
}

fn gen_max_bool(a: bool, b: bool) -> bool {
    if !a {
        return b
    }
    return a
}

fn drive_max() -> int {
    let m1: int = gen_max_int(13, 29)
    let m2: str = gen_max_str("m", "z")
    let m3: bool = gen_max_bool(false, true)
    let r: int = m1 + m2.len()
    if m3 {
        return r + 1
    }
    return r
}

# ----------------------------------------------------------------------
# The driver.
# ----------------------------------------------------------------------

fn main() -> int uses IO {
    let mut total: int = 0
    total = total + drive_id()
    total = total + drive_swap()
    total = total + drive_triple()
    total = total + drive_wrap()
    total = total + drive_pair_of()
    total = total + drive_keyed()
    total = total + drive_shape()
    total = total + drive_fold()
    total = total + drive_nth()
    total = total + drive_pipeline()
    total = total + drive_max()
    if total < 0 {
        panic("impossible: every term is masked non-negative")
    }
    println("check_generic: " + total.to_str())
    return total % 256
}
