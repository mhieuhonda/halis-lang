# ============================================================================
# benchmarks/ctime_watch/parse_deep.hls — Stage 138: the compile-time
# suite, workload 2 of 5 — THE PARSE TREE.
# ----------------------------------------------------------------------------
# This one is the PARSER: nesting DEPTH and statement WIDTH. Every
# function builds expressions nested eight to twelve levels deep —
# parenthesised arithmetic, chained calls, nested struct literals,
# deeply indented while/if/match blocks — so the recursive-descent
# parser and the span bookkeeping around it do the work, not the
# type checker (the types here are all int and the bodies all fold
# to constants once checked). The accumulator is masked at every
# level so the program is runtime-sound, but the work is the parse.
# ============================================================================

struct Cell {
    tag: str,
    weight: int,
    left: int,
    right: int = 0
}

enum Tree {
    Leaf,
    Node(int, Tree, Tree)
}

# ----------------------------------------------------------------------
# Section A — nested arithmetic. Each level adds one parenthesised
# layer; twelve levels is deeper than any real program nests and
# shallow enough for the recursive parser to stay honest.
# ----------------------------------------------------------------------

fn deep_arith_000(a: int) -> int {
    return ((((((a + 1) * 2 - 3) / 2 + 5) * 7 - 11) % 97 + 13) * 3 - 1) % 1000003
}

fn deep_arith_001(a: int) -> int {
    return (((((((a * 3) + 4) * 5) - 6) / 2) + 7) * 8 - 9) % 1000003
}

fn deep_arith_002(a: int, b: int) -> int {
    return ((((a + b) * (a - b)) / ((a % 3) + 1)) + ((b % 5) * (a % 7))) % 1000003
}

fn deep_arith_003(a: int, b: int) -> int {
    return (((((a * b) + (a + b)) * ((a - b) + 1)) - (a % 11)) / ((b % 13) + 1)) % 1000003
}

fn deep_arith_004(a: int) -> int {
    let x: int = (((a + 1) * (a + 2)) - (a + 3)) / ((a % 5) + 1)
    let y: int = ((x * 7) + (x % 6)) - (x / (x % 9 + 1))
    return (((x + y) * 2) - (y - x)) % 1000003
}

fn deep_arith_005(a: int, b: int, c: int) -> int {
    return ((((a + b) * c) - (a * (b - c))) + (((a - b) * (b - c)) - ((c - a) * (a + c)))) % 1000003
}

# ----------------------------------------------------------------------
# Section B — chained calls. The call graph itself is the nesting:
# every function here calls the previous two, so the parser walks a
# call tree as deep as the section is long.
# ----------------------------------------------------------------------

fn chain_006(a: int) -> int {
    return deep_arith_000(a) + deep_arith_001(a)
}

fn chain_007(a: int) -> int {
    return chain_006(a) + deep_arith_002(a, a)
}

fn chain_008(a: int) -> int {
    return chain_007(a) + deep_arith_003(a, a - 1)
}

fn chain_009(a: int) -> int {
    return chain_008(a) + deep_arith_004(a + 1)
}

fn chain_010(a: int) -> int {
    return chain_009(a) + deep_arith_005(a, a, a)
}

fn chain_011(a: int) -> int {
    return chain_010(a) + chain_006(chain_007(a % 97))
}

fn chain_012(a: int) -> int {
    return chain_011(a) + chain_008(chain_009(a % 89))
}

fn chain_013(a: int) -> int {
    return chain_012(a) + chain_010(chain_011(a % 83))
}

fn chain_014(a: int) -> int {
    return chain_013(a) + chain_012(chain_013(a % 79))
}

fn chain_015(a: int) -> int {
    return chain_014(a) % 1000003 + chain_011(a % 73) % 1000003
}

# ----------------------------------------------------------------------
# Section C — nested struct literals and nested control flow. The
# parser's statement stack, not its expression stack, is the work.
# ----------------------------------------------------------------------

fn nest_cell(tag: str, w: int) -> Cell {
    return Cell {
        tag: tag,
        weight: (w + (w * 3) - (w / 2)) % 1000003,
        left: ((w % 7) * (w % 11)) % 101,
        right: (w % 13) + (w % 17)
    }
}

fn nest_cells_016(w: int) -> int {
    let a: Cell = nest_cell("a", w)
    let b: Cell = nest_cell("b", a.weight)
    let c: Cell = nest_cell("c", a.left + b.right)
    let d: Cell = nest_cell("d", b.left * c.weight)
    return (((a.weight + b.weight) * (c.weight + d.weight)) - a.right) % 1000003
}

fn nest_flow_017(a: int) -> int {
    let mut r: int = 0
    if a > 0 {
        if a % 2 == 0 {
            if a % 4 == 0 {
                if a % 8 == 0 {
                    r = 1
                } else {
                    r = 2
                }
            } else {
                if a % 6 == 0 {
                    r = 3
                } else {
                    r = 4
                }
            }
        } else {
            if a % 3 == 0 {
                if a % 9 == 0 {
                    r = 5
                } else {
                    r = 6
                }
            } else {
                r = 7
            }
        }
    } else {
        if a == 0 {
            r = 8
        } else {
            r = 9
        }
    }
    return r
}

fn nest_loop_018(a: int) -> int {
    let mut r: int = 0
    let mut i: int = 0
    while i < 12 {
        let mut j: int = 0
        while j < 8 {
            let mut k: int = 0
            while k < 4 {
                if (i + j + k) % 3 == 0 {
                    r = (r + i * j * k + a) % 1000003
                } else {
                    if (i + j) % 2 == 0 {
                        r = (r + i - j + k) % 1000003
                    } else {
                        r = (r + k - i * j) % 1000003
                    }
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return r
}

# ----------------------------------------------------------------------
# Section D — the tree: recursive data, recursive functions, and the
# match that deconstructs it — the parser's deepest single construct.
# ----------------------------------------------------------------------

fn tree_leaf() -> Tree {
    return Tree.Leaf
}

fn tree_node(v: int, l: Tree, r: Tree) -> Tree {
    return Tree.Node(v, l, r)
}

fn tree_build_019(depth: int, seed: int) -> Tree {
    if depth <= 0 {
        return tree_leaf()
    }
    return tree_node(
        (seed % 97) + depth,
        tree_build_019(depth - 1, seed * 3 + 1),
        tree_build_019(depth - 1, seed * 5 + 2)
    )
}

fn tree_sum_020(t: Tree) -> int {
    return match t {
        Tree.Leaf => 0,
        Tree.Node(v, l, r) => (v + tree_sum_020(l) + tree_sum_020(r)) % 1000003
    }
}

fn tree_depth_021(t: Tree) -> int {
    let dl: int = match t {
        Tree.Leaf => 0,
        Tree.Node(_, l, _) => tree_depth_021(l)
    }
    let dr: int = match t {
        Tree.Leaf => 0,
        Tree.Node(_, _, r) => tree_depth_021(r)
    }
    if dl > dr {
        return 1 + dl
    }
    return 1 + dr
}

fn tree_mirror_022(t: Tree) -> Tree {
    return match t {
        Tree.Leaf => Tree.Leaf,
        Tree.Node(v, l, r) => Tree.Node(v, tree_mirror_022(r), tree_mirror_022(l))
    }
}

fn emit_node(xs: list[int], stack: list[Tree], v: int, l: Tree, r: Tree) {
    # Match arms are expression positions in Halis; one call carries
    # the three side effects an arm needs.
    xs.push(v)
    stack.push(l)
    stack.push(r)
}

fn tree_flatten_023(t: Tree) -> int {
    # Width, not depth: every node becomes one list push through a
    # walk with an inner loop.
    let xs: list[int] = []
    let stack: list[Tree] = [t]
    while stack.len() > 0 {
        let cur: Tree = stack.pop()
        match cur {
            Tree.Leaf => xs.push(0),
            Tree.Node(v, l, r) => emit_node(xs, stack, v, l, r)
        }
    }
    let mut sum: int = 0
    let mut i: int = 0
    while i < xs.len() {
        sum = (sum + xs.get(i)) % 1000003
        i = i + 1
    }
    return sum
}

# ----------------------------------------------------------------------
# Section E — the wide statements: one expression per line, each line
# itself a nested call chain; the parser walks the width.
# ----------------------------------------------------------------------

fn wide_024(a: int) -> int {
    let mut r: int = 0
    r = r + chain_006(chain_007(chain_008(a % 71)))
    r = r + chain_009(chain_010(chain_011(a % 67)))
    r = r + chain_012(chain_013(chain_014(a % 61)))
    r = r + deep_arith_000(deep_arith_001(deep_arith_004(a % 59)))
    r = r + deep_arith_002(deep_arith_003(a % 53, a % 47), deep_arith_005(a, 1, 2))
    r = r + nest_cells_016(nest_flow_017(a % 31) + nest_loop_018(a % 29))
    r = r + tree_sum_020(tree_build_019(4, a % 23))
    r = r + tree_depth_021(tree_mirror_022(tree_build_019(3, a % 19)))
    r = r + tree_flatten_023(tree_build_019(5, a % 17))
    return r % 1000003
}

fn wide_025(a: int) -> int {
    let mut r: int = 0
    r = r + wide_024(a % 13)
    r = r + wide_024(a % 11 + 1)
    r = r + wide_024(a % 7 + 2)
    r = r + wide_024(a % 5 + 3)
    return r % 1000003
}

fn wide_026(a: int) -> int {
    let mut r: int = 0
    r = r + wide_025(a % 4)
    r = r + wide_025(a % 3 + 1)
    r = r + wide_025(a % 2 + 2)
    return r % 1000003
}

# ----------------------------------------------------------------------
# The driver.
# ----------------------------------------------------------------------

fn main() -> int uses IO {
    let mut total: int = 0
    total = total + deep_arith_000(2)
    total = total + deep_arith_005(3, 5, 7)
    total = total + chain_015(11)
    total = total + nest_cells_016(13)
    total = total + nest_flow_017(24)
    total = total + nest_loop_018(6)
    total = total + tree_sum_020(tree_build_019(5, 9))
    total = total + tree_depth_021(tree_build_019(6, 4))
    total = total + tree_flatten_023(tree_mirror_022(tree_build_019(4, 8)))
    total = total + wide_024(15)
    total = total + wide_026(17)
    if total < 0 {
        panic("impossible: every term is masked non-negative")
    }
    println("parse_deep: " + total.to_str())
    return total % 256
}
