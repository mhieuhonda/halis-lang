# .hlfmt.toml.example — the hlfmt team configuration file (Stage 117,
# v0.136.0-alpha).
#
# Copy this file to `.hlfmt.toml` at your repo root (or any subdirectory
# — the NEAREST file to the target source wins) and uncomment the keys
# your team wants to pin. Every key is optional; anything left out keeps
# the built-in default, and the defaults are exactly the pre-117
# formatter constants, so an empty .hlfmt.toml changes nothing.
#
# Resolution order:
#   --config PATH   pin one file (discovery off)
#   --no-config     ignore discovery, built-in defaults only
#   otherwise       walk from the target file's directory to the root;
#                   the first .hlfmt.toml found applies
#
# Debug what a run would use:  hlfmt --print-config FILE.hls
# The grammar is strict: an unknown key, a wrong type, an out-of-range
# value, a duplicate key, or a table other than [hlfmt] is an error
# naming file and line (exit 2). Comments start with `#`.

[hlfmt]

# Spaces per indentation level (1..8). Default: 4.
#indent_width = 2

# Indentation unit: "space" or "tab". Default: "space".
#indent_style = "tab"

# Emit a trailing newline at EOF. Default: true.
#final_newline = true

# A run of blank lines in the source collapses to at most this many
# (0..4). Default: 1.
#max_blank_lines = 2

# Re-indent comment-only lines to the canonical block indent (the Stage
# 116 law). Set false for a legacy tree where comment lines must replay
# their source indent verbatim for minimal diffs. Default: true.
#reindent_comments = false
