# ============================================================================
# core/eq.hls — the Eq convention for freestanding code (Stage 78)
# ----------------------------------------------------------------------------
# Pure HLS, no `uses`. Imports only `core.option` (freestanding-safe).
#
# `==` in HLS works on int, float, bool, str — and is REJECTED on
# type parameters (a generic `T` may not support comparison), so
# generic equality cannot be written once and for all. The Eq
# CONVENTION (for the future `trait Eq`) is: a type that wants
# equality provides `fn eq_of(self: T, other: T) -> bool`.
# Generic `impl` blocks are not supported yet, so user types write
# the method on their concrete struct; this module ships the
# concrete container comparisons kernels need most (tables, argv,
# option returns, string-keyed maps).
#
# Float note: `==` on floats is bitwise IEEE equality (NaN != NaN,
# +0.0 == -0.0) — same rule as hosted code. Kernel code comparing
# sensor readings should compare with an epsilon band instead.
# ============================================================================

import "core.option"

# Element-wise equality for int lists (length + every element).
fn eq_list_int(a: list[int], b: list[int]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let mut i: int = 0
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

# Element-wise equality for str lists (bytewise per element).
fn eq_list_str(a: list[str], b: list[str]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let mut i: int = 0
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

# Element-wise equality for bool lists.
fn eq_list_bool(a: list[bool], b: list[bool]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let mut i: int = 0
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

# Equality for int options (None == None; Some(a) == Some(b) iff
# the payloads are equal).
fn eq_option_int(a: Option[int], b: Option[int]) -> bool {
    return match a {
        Option.Some(x) => match b {
            Option.Some(y) => x == y,
            Option.None => false
        },
        Option.None => match b {
            Option.Some(_) => false,
            Option.None => true
        }
    }
}

# Equality for str options.
fn eq_option_str(a: Option[str], b: Option[str]) -> bool {
    return match a {
        Option.Some(x) => match b {
            Option.Some(y) => x == y,
            Option.None => false
        },
        Option.None => match b {
            Option.Some(_) => false,
            Option.None => true
        }
    }
}

# Equality for string-keyed int maps (same key set via insertion
# order, every value equal). Key ORDER is ignored: {a:1,b:2} equals
# {b:2,a:1} (maps are compared as sets of pairs, not sequences).
fn eq_map_str_int(a: map[str, int], b: map[str, int]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let keys: list[str] = a.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        if !b.has(k) {
            return false
        }
        if a.get_or(k, 0) != b.get_or(k, 1) {
            return false
        }
        i = i + 1
    }
    return true
}
