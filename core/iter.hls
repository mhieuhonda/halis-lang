# ============================================================================
# core/iter.hls — the Iterator convention for freestanding code (Stage 78)
# ----------------------------------------------------------------------------
# Pure HLS, no `uses`. Imports only `core.option` (freestanding-safe).
#
# HLS has no trait dispatch yet (the `trait` keyword is reserved for
# a later stage) and generic `impl` blocks are not supported yet, so
# the Iterator protocol ships as FREE generic functions (the same
# "monomorphic helpers" convention `std.tui` uses for `Widget`):
# an iterator is a struct holding its cursor, advanced by `iter_next`.
# When `impl` blocks gain type parameters, each `iter_next[T]` below
# becomes `impl ListIter[T] { fn next(...) }` unchanged in spirit.
#
# This module ships the canonical list iterator plus exhaustion
# helpers. Kernel code iterates tables, command lines, and
# descriptors without touching the allocator beyond the list
# itself (no hidden state — the cursor lives in the struct).
# ============================================================================

import "core.option"

struct ListIter[T] {
    xs: list[T],
    pos: int
}

# Builds an iterator over the whole list (position 0).
fn list_iter[T](xs: list[T]) -> ListIter[T] {
    return ListIter {
        xs: xs, pos: 0
    }
}

# Yields the next element, or None when exhausted. Advances the
# cursor in place (contents mutation through the reference —
# allowed on any binding, like `xs.push(v)`).
fn iter_next[T](mut it: ListIter[T]) -> Option[T] {
    if it.pos >= it.xs.len() {
        return Option.None
    }
    let v: T = it.xs.get(it.pos)
    it.pos = it.pos + 1
    return Option.Some(v)
}

# True while elements remain (does not consume).
fn iter_has_next[T](it: ListIter[T]) -> bool {
    return it.pos < it.xs.len()
}

# Remaining element count (does not consume).
fn iter_remaining[T](it: ListIter[T]) -> int {
    return it.xs.len() - it.pos
}

# Counts the elements of a list via the iterator protocol (exercises
# next/has_next; identical to `xs.len()` by construction).
fn iter_count[T](xs: list[T]) -> int {
    let mut it: ListIter[T] = list_iter(xs)
    let mut n: int = 0
    while iter_has_next(it) {
        let cur: Option[T] = iter_next(it)
        if option_is_some(cur) {
            n = n + 1
        }
    }
    return n
}

# Sums a list of ints via the iterator protocol.
fn iter_sum_int(xs: list[int]) -> int {
    let mut it: ListIter[int] = list_iter(xs)
    let mut total: int = 0
    while iter_has_next(it) {
        total = total + option_unwrap_or(iter_next(it), 0)
    }
    return total
}
