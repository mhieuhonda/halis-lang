# ============================================================================
# core/clone.hls — the Clone convention for freestanding code (Stage 78)
# ----------------------------------------------------------------------------
# Pure HLS, no `uses`. Imports only `core.option` (freestanding-safe).
#
# The language already provides the `clone(x)` builtin (independent
# deep copy of every owned type — Stage 8). The Clone CONVENTION
# (for the future `trait Clone`, like `core.iter`'s Iterator) is: a
# type that wants value-copy semantics provides
# `fn clone_of(self: T) -> T`. Generic `impl` blocks are not
# supported yet, so user types write the method on their concrete
# struct (see the example below); this module ships the container
# helpers that the convention is built on.
#
# Example:
#   struct Config {
#       name: str,
#       retries: int
#   }
#   impl Config {
#       fn clone_of(self: Config) -> Config {
#           return Config { name: clone(self.name), retries: self.retries }
#       }
#   }
# ============================================================================

import "core.option"

# Deep-copies a list (elements cloned recursively by the builtin).
fn clone_list_of[T](xs: list[T]) -> list[T] {
    return clone(xs)
}

# Clones an option, preserving the variant (the inner value is
# deep-copied; None stays None).
fn clone_some[T](o: Option[T]) -> Option[T] {
    return match o {
        Option.Some(v) => Option.Some(clone(v)),
        Option.None => Option.None
    }
}

# Deep-copies a string-keyed map (values cloned recursively).
fn clone_map_of[T](m: map[str, T]) -> map[str, T] {
    return clone(m)
}
