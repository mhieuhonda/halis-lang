# ============================================================================
# core/result.hls — the Result[T, E] type for freestanding code (Stage 78)
# ----------------------------------------------------------------------------
# Pure HLS, no `uses`, no imports. Importable from `#![freestanding]`
# and `#![no_std]` crates. Panic is reserved for programming bugs —
# expected failures (bad input, missing keys) travel in `Result`.
#
# NOTE: `core.result` and `std.result` declare DIFFERENT `Result`
# types. Never import both into one program — hosted code uses
# `std.result`, freestanding / no_std code uses `core.result`. The
# APIs are intentionally identical so porting is a one-line import
# change, except `float_parse` (deliberately ABSENT here: str->float
# needs strtod, which has no freestanding implementation — Stage 77
# rejects it at check time).
# ============================================================================

enum Result[T, E] {
    Ok(T),
    Err(E)
}

# Returns the value if Ok; panics if Err. Use only when the error is
# impossible (proven by construction); otherwise match or `?`.
fn result_unwrap[T, E](r: Result[T, E]) -> T {
    return match r {
        Result.Ok(v) => v,
        Result.Err(_) => panic("result_unwrap on Err")
    }
}

# Returns the value if Ok, or `default` if Err.
fn result_unwrap_or[T, E](r: Result[T, E], default: T) -> T {
    return match r {
        Result.Ok(v) => v,
        Result.Err(_) => default
    }
}

# Returns the error if Err; panics if Ok.
fn result_unwrap_err[T, E](r: Result[T, E]) -> E {
    return match r {
        Result.Ok(_) => panic("result_unwrap_err on Ok"),
        Result.Err(e) => e
    }
}

# Returns true if the result is Ok.
fn result_is_ok[T, E](r: Result[T, E]) -> bool {
    return match r {
        Result.Ok(_) => true,
        Result.Err(_) => false
    }
}

# Returns true if the result is Err.
fn result_is_err[T, E](r: Result[T, E]) -> bool {
    return match r {
        Result.Ok(_) => false,
        Result.Err(_) => true
    }
}

# Parses an integer literal (`-?[0-9]+`, int64 range) without panicking:
# Ok(n) on success, Err(message) on bad input. The digit pre-check is
# hand-rolled (pure, freestanding-safe); `int(s)` itself would panic.
fn parse_int(s: str) -> Result[int, str] {
    if s.len() == 0 {
        return Result.Err("empty integer literal")
    }
    let mut i: int = 0
    if s.byte_at(0) == 45 {
        i = 1
    }
    if i >= s.len() {
        return Result.Err("expected digits")
    }
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c < 48 || c > 57 {
            return Result.Err("invalid digit")
        }
        i = i + 1
    }
    return Result.Ok(int(s))
}
