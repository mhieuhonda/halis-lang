# ============================================================================
# core/option.hls — the Option[T] type for freestanding code (Stage 78)
# ----------------------------------------------------------------------------
# Pure HLS, no `uses`, no imports. Importable from `#![freestanding]`
# and `#![no_std]` crates (unlike `std.option`, which lives behind
# the disabled `std` module boundary).
#
# `Option[T]` represents "a value of type T, or absence". Use it
# instead of sentinel values (-1, NULL, empty string, ...) for
# optional data.
#
# NOTE: `core.option` and `std.option` declare DIFFERENT `Option`
# types (HLS has no re-export mechanism). Never import both into one
# program — hosted code uses `std.option`, freestanding / no_std
# code uses `core.option`. The APIs are intentionally identical so
# porting is a one-line import change.
# ============================================================================

enum Option[T] {
    Some(T),
    None
}

# Returns the value if Some; panics if None. Use this only when you
# have already verified (e.g. via `option_is_some`) that the value
# is present. For a safe alternative, use `option_unwrap_or`.
# In freestanding mode the panic halts via a trap (no stderr).
fn option_unwrap[T](o: Option[T]) -> T {
    return match o {
        Option.Some(v) => v,
        Option.None => panic("option_unwrap on None")
    }
}

# Returns the value if Some, or `default` if None.
fn option_unwrap_or[T](o: Option[T], default: T) -> T {
    return match o {
        Option.Some(v) => v,
        Option.None => default
    }
}

# Returns true if the option is Some.
fn option_is_some[T](o: Option[T]) -> bool {
    return match o {
        Option.Some(_) => true,
        Option.None => false
    }
}

# Returns true if the option is None.
fn option_is_none[T](o: Option[T]) -> bool {
    return match o {
        Option.Some(_) => false,
        Option.None => true
    }
}
