# ============================================================================
# fix_makefile_indent.hls — convert leading 8-space recipe indentation
# to TABs (the Halis twin of what was scripts/fix_makefile_indent.py).
# ----------------------------------------------------------------------------
# Make REQUIRES tabs (not spaces) for command-line indentation. The
# Makefile in this repo was authored with 8-space indentation in some
# editors that silently converted tabs to spaces; `make` rejects it.
# This tool restores a TAB on every line whose leading whitespace is
# spaces AND the enclosing rule is a recipe: a column-0 line is a rule
# line when it has a colon that is NOT part of an assignment operator
# (:= ?= +=), so a plain 'CC := gcc' must not be mistaken for a
# target. Comments and blanks end the current recipe; continuation
# lines (starting with whitespace then content) also use TAB.
#
# Usage:
#   bin/fix-makefile-indent [Makefile]
# ============================================================================

# first_colon_rule(line) — a column-0 rule line: `^[^:]+:($|[^=])` as
# byte logic. The first colon has at least one char before it, all
# non-colon, and is either at end-of-line or not followed by '='.
fn first_colon_rule(line: str) -> bool {
    if line.len() == 0 {
        return false
    }
    if line.byte_at(0) == 35 {
        return false
    }
    let c: int = line.find(":")
    if c <= 0 {
        return false
    }
    # everything before the first colon must be non-colon (find already
    # guarantees it is the FIRST colon)
    if c == line.len() - 1 {
        return true
    }
    if line.byte_at(c + 1) == 61 {
        return false
    }
    return true
}

fn main() -> int uses IO, Args {
    let argv: list[str] = args()
    if argv.len() < 2 {
        println("usage: fix_makefile-indent [Makefile]")
        println("Convert leading 8-space recipe indentation to TABs (default: ./Makefile).")
        return 0
    }
    let path: str = argv.get(1)
    if !file_exists(path) {
        println("fix_makefile_indent: cannot read: " + path)
        return 1
    }
    let src: str = read_file(path)
    let lines: list[str] = src.split("\n")
    let mut out: str = ""
    let mut in_recipe: bool = false
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if i == lines.len() - 1 && line == "" {
            i = i + 1
            continue
        }
        if line.len() > 0 && line.byte_at(0) != 32 && line.byte_at(0) != 9 {
            # Column 0 line: a rule line opens the recipe; anything
            # else (assignment, comment, blank) closes it.
            in_recipe = first_colon_rule(line)
            out = out + line + "\n"
            i = i + 1
            continue
        }
        if in_recipe {
            # Count leading spaces; every 8 becomes one TAB.
            let mut n_leading: int = 0
            while n_leading < line.len() && line.byte_at(n_leading) == 32 {
                n_leading = n_leading + 1
            }
            let n_tabs: int = n_leading / 8
            let n_rest: int = n_leading % 8
            let mut prefix: str = ""
            let mut t: int = 0
            while t < n_tabs {
                prefix = prefix + "\t"
                t = t + 1
            }
            let mut r: int = 0
            while r < n_rest {
                prefix = prefix + " "
                r = r + 1
            }
            out = out + prefix + line.slice(n_leading, line.len()) + "\n"
        } else {
            out = out + line + "\n"
        }
        i = i + 1
    }
    write_file(path, out)
    return 0
}
