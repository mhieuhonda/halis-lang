# ============================================================================
# simd_ratio.hls — Stage 21 (v0.37.0-alpha) acceptance measurement (the
# Halis twin of what was scripts/simd_ratio.py).
# ----------------------------------------------------------------------------
# Parses benchmarks/simd_bench.hls output and gates the acceptance
# criterion: the vector kernel must be at least --min times faster than
# the scalar kernel (default 2.0x) on the 1M-element list, with
# matching checksums (checked by the caller). Exit code 0 on PASS.
#
# Usage:
#   bin/simd-ratio --out FILE [--min 2.0]
# ============================================================================

import "std.fmt"
import "std.regex"

# bench_ms(text, kernel) — the kernel's measured milliseconds (the old
# script's re.search(r"KERNEL\s+time = (\d+) ms") — the bench pads
# the kernel name to a fixed column, so the separator is \s+).
fn bench_ms(text: str, kernel: str) -> int {
    let rr: Result[Regex, str] = regex_compile(kernel + "\\s+time = ([0-9]+) ms")
    if result_is_err(rr) {
        return -1
    }
    let re: Regex = result_unwrap(rr)
    let gs: Option[list[str]] = regex_groups(re, text)
    if !option_is_some(gs) {
        return -1
    }
    let groups: list[str] = option_unwrap(gs)
    if groups.len() < 2 {
        return -1
    }
    return groups.get(1).to_int()
}

fn main() -> int uses IO, Args, Exit {
    let argv: list[str] = args()
    let mut out_path: str = ""
    let mut min_ratio: float = 2.0
    let mut i: int = 1
    while i < argv.len() {
        let a: str = argv.get(i)
        if a == "--out" && i + 1 < argv.len() {
            out_path = argv.get(i + 1)
            i = i + 2
            continue
        }
        if a == "--min" && i + 1 < argv.len() {
            let mval: str = argv.get(i + 1)
            if mval.len() > 0 {
                min_ratio = mval.to_float()
            }
            i = i + 2
            continue
        }
        i = i + 1
    }
    if out_path == "" {
        println("FAIL: --out is required")
        return 1
    }
    let text: str = read_file(out_path)
    let s: int = bench_ms(text, "scalar")
    let v: int = bench_ms(text, "vector")
    if s < 0 || v < 0 {
        println("FAIL: could not parse scalar/vector timings")
        return 1
    }
    if v <= 0 {
        println("PASS: vector path too fast to measure (<= 0 ms); scalar "
            + s.to_str() + " ms")
        return 0
    }
    let ratio: float = s.to_float() / v.to_float()
    println("scalar " + s.to_str() + " ms / vector " + v.to_str() + " ms = "
        + fmt_float_with_precision(ratio, 1) + "x (gate >= "
        + fmt_float_with_precision(min_ratio, 1) + "x)")
    if ratio < min_ratio {
        println("FAIL: ratio below the acceptance threshold")
        return 1
    }
    println("PASS: Stage 21 acceptance (>= "
        + fmt_float_with_precision(min_ratio, 1)
        + "x on the 1M-element kernel, identical output)")
    return 0
}
