# ============================================================================
# std/csv.hls — CSV parser / serialiser for Hieu Louis
# ----------------------------------------------------------------------------
# Pure-HLS CSV (RFC 4180 subset). Handles:
#   * comma-separated fields (configurable delimiter)
#   * double-quoted fields containing commas, newlines, and double quotes
#   * quoted-double escape: "" inside quoted field -> "
#   * optional trailing newline
#   * configurable field delimiter (','  by default)
#
# Two operations:
#   csv_parse(src, delim)        -> list[list[str]]   (rows of fields)
#   csv_stringify(rows, delim)   -> str               (re-serialise)
# Plus a convenience helper:
#   csv_parse_default(src)       -> list[list[str]]   (delim = ',')
#   csv_stringify_default(rows) -> str
#
# All functions are pure (no `uses IO`).
# ============================================================================

import "std.str"

# csv_parse_default(src) parses comma-separated CSV.
fn csv_parse_default(src: str) -> list[list[str]] {
    return csv_parse(src, 44)            # ',' = 44
}

# csv_parse(src, delim) parses CSV where delim is the byte value of the
# field separator (e.g. 44 for ',', 9 for tab, 59 for ';').
fn csv_parse(src: str, delim: int) -> list[list[str]] {
    let rows: list[list[str]] = []
    let mut cur_row: list[str] = []
    let mut cur_field: list[str] = []
    let mut in_quotes: bool = false
    let n: int = src.len()
    let mut i: int = 0
    while i < n {
        let c: int = src.byte_at(i)
        if in_quotes {
            if c == 34 {                  # '"'
                # Lookahead for "" -> escaped quote inside field.
                if i + 1 < n && src.byte_at(i + 1) == 34 {
                    cur_field.push("\"")
                    i = i + 2
                    continue
                }
                in_quotes = false
                i = i + 1
                continue
            }
            cur_field.push(src.slice(i, i + 1))
            i = i + 1
            continue
        }
        # Not in quotes.
        if c == 34 {                  # '"'
            # BUG (deep-scan-5): a stray quote in the MIDDLE of an
            # unquoted field ("ab\"cd,e") switched the parser into quoted
            # mode, swallowing delimiters and corrupting the rest of the
            # row. RFC 4180: quotes are only meaningful at the START of a
            # field — mid-field quotes are literal characters.
            if cur_field.len() == 0 {
                in_quotes = true
                i = i + 1
                continue
            }
            cur_field.push(chr(34))
            i = i + 1
            continue
        }
        if c == delim {
            cur_row.push(str_join(cur_field, ""))
            cur_field = new_empty_str_list()
            i = i + 1
            continue
        }
        if c == 10 {                  # newline LF
            cur_row.push(str_join(cur_field, ""))
            cur_field = new_empty_str_list()
            rows.push(cur_row)
            cur_row = new_empty_str_list()
            i = i + 1
            continue
        }
        if c == 13 {                  # CR — skip if followed by LF
            if i + 1 < n && src.byte_at(i + 1) == 10 {
                i = i + 1
                continue
            }
            # lone CR — treat as newline
            cur_row.push(str_join(cur_field, ""))
            cur_field = new_empty_str_list()
            rows.push(cur_row)
            cur_row = new_empty_str_list()
            i = i + 1
            continue
        }
        cur_field.push(src.slice(i, i + 1))
        i = i + 1
    }
    # Flush last field / row if non-empty OR if we just ended a non-empty row.
    if cur_field.len() > 0 || cur_row.len() > 0 {
        cur_row.push(str_join(cur_field, ""))
        rows.push(cur_row)
    }
    return rows
}

# new_empty_str_list() returns a fresh empty list[str]. Used to "reset"
# a list binding to a new list (HLS lists have reference semantics so
# binding-reassignment to a fresh list is the right way to reset).
fn new_empty_str_list() -> list[str] {
    return []
}

# csv_stringify_default(rows) re-serialises rows as comma-separated CSV.
fn csv_stringify_default(rows: list[list[str]]) -> str {
    return csv_stringify(rows, 44)        # ',' = 44
}

# csv_stringify(rows, delim) serialises rows into a CSV string with \n
# line endings and proper quoting of fields that contain delimiters,
# quotes, or newlines.
fn csv_stringify(rows: list[list[str]], delim: int) -> str {
    let lines: list[str] = []
    let mut i: int = 0
    while i < rows.len() {
        let row: list[str] = rows.get(i)
        let fields: list[str] = []
        let mut j: int = 0
        while j < row.len() {
            fields.push(csv_quote_field(row.get(j), delim))
            j = j + 1
        }
        lines.push(str_join(fields, chr(delim)))
        i = i + 1
    }
    return str_join(lines, "\n")
}

# csv_quote_field decides whether a field needs quoting and applies the
# quotes. A field is quoted if it contains: the delimiter, a double quote,
# a newline, or a carriage return.
fn csv_quote_field(s: str, delim: int) -> str {
    let mut needs_quote: bool = false
    let n: int = s.len()
    let mut k: int = 0
    while k < n {
        let c: int = s.byte_at(k)
        if c == delim || c == 34 || c == 10 || c == 13 {
            needs_quote = true
            break
        }
        k = k + 1
    }
    if !needs_quote {
        return s
    }
    # Escape " -> "" and wrap.
    let escaped: list[str] = []
    let mut m: int = 0
    while m < n {
        let c: int = s.byte_at(m)
        if c == 34 {
            escaped.push("\"\"")
        } else {
            escaped.push(s.slice(m, m + 1))
        }
        m = m + 1
    }
    return "\"" + str_join(escaped, "") + "\""
}
