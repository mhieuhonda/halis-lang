# ============================================================================
# std/regex/regex_class.hls - verbatim slice of the original std/regex.hls
# (lines 1061..1523), split for maintainability. Loaded via the
# std/regex.hls facade; not part of the public import API.
# ============================================================================

fn regex_emit_codepoint(mut p: RegexParser, cp: int) -> RegexFrag {
    if cp < 0 || cp > 1114111 {
        regex_err_pos(p, "codepoint out of range (\\x{...})")
        return regex_frag_empty()
    }
    let bytes: list[int] = regex_encode_utf8(cp)
    let mut out: RegexFrag = regex_frag_epsilon(p)
    if p.err != "" {
        return regex_frag_empty()
    }
    let mut i: int = 0
    while i < bytes.len() {
        let f: RegexFrag = regex_frag_literal(p, bytes.get(i))
        if p.err != "" {
            return regex_frag_empty()
        }
        out = regex_frag_concat(p, out, f)
        i = i + 1
    }
    return out
}

# regex_encode_utf8(cp) -> list[int]. UTF-8 encode a codepoint into
# 1..4 bytes.
fn regex_encode_utf8(cp: int) -> list[int] {
    if cp <= 127 {
        return[cp]
    }
    if cp <= 2047 {
        return[
        int_or(192, int_shr(cp, 6)),
        int_or(128, int_and(cp, 63))
        ]
    }
    if cp <= 65535 {
        return[
        int_or(224, int_shr(cp, 12)),
        int_or(128, int_and(int_shr(cp, 6), 63)),
        int_or(128, int_and(cp, 63))
        ]
    }
    return[
    int_or(240, int_shr(cp, 18)),
    int_or(128, int_and(int_shr(cp, 12), 63)),
    int_or(128, int_and(int_shr(cp, 6), 63)),
    int_or(128, int_and(cp, 63))
    ]
}

# regex_parse_hex_int(p, s) -> int. Parse a hex string of any length.
fn regex_parse_hex_int(p: RegexParser, s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        v = int_shl(v, 4) + regex_hex_digit_value(s.byte_at(i))
        i = i + 1
    }
    return v
}

fn regex_is_hex_digit(b: int) -> bool {
    return(b >= 48 && b <= 57)
    || (b >= 65 && b <= 70)
    || (b >= 97 && b <= 102)
}

fn regex_hex_digit_value(b: int) -> int {
    if b >= 48 && b <= 57 {
        return b - 48
    }
    if b >= 65 && b <= 70 {
        return b - 55
    }
    if b >= 97 && b <= 102 {
        return b - 87
    }
    return 0
}

# ============================================================================
# Character class parser — [...].
# ============================================================================

# regex_parse_class(p) -> RegexFrag. Parse a character class starting
# at '['. Supports ranges (a-z), negation (^), and the predefined
# class shortcuts (\d \w \s) embedded in a class.
fn regex_parse_class(mut p: RegexParser) -> RegexFrag {
    p.pos = p.pos + 1 # consume '['
    let cls: RegexCharClass = regex_charclass_new()
    # Negation?
    if p.pos < p.pattern.len() && p.pattern.byte_at(p.pos) == 94 {
        cls.negate = true
        p.pos = p.pos + 1
    }
    # ']' as the first char is a literal ']'.
    if p.pos < p.pattern.len() && p.pattern.byte_at(p.pos) == 93 {
        regex_charclass_add(cls, 93, 93)
        p.pos = p.pos + 1
    }
    while p.pos < p.pattern.len() && p.pattern.byte_at(p.pos) != 93 {
        let b: int = p.pattern.byte_at(p.pos)
        if b == 92 {
            p.pos = p.pos + 1
            if p.pos >= p.pattern.len() {
                regex_err_eof(p, "trailing backslash in class")
                return regex_frag_empty()
            }
            let esc: int = p.pattern.byte_at(p.pos)
            p.pos = p.pos + 1
            if esc == 100 {
                regex_charclass_add(cls, 48, 57)
                continue
            }
            if esc == 68 {
                regex_charclass_add_neg_range(cls, 48, 57)
                continue
            }
            if esc == 119 {
                regex_class_add_word(cls)
                continue
            }
            if esc == 87 {
                regex_class_add_word_neg(cls)
                continue
            }
            if esc == 115 {
                regex_class_add_space(cls)
                continue
            }
            if esc == 83 {
                regex_class_add_space_neg(cls)
                continue
            }
            if esc == 120 {
                if p.pos + 1 >= p.pattern.len() {
                    regex_err_eof(p, "\\xNN needs two hex digits in class")
                    return regex_frag_empty()
                }
                let h1: int = p.pattern.byte_at(p.pos)
                let h2: int = p.pattern.byte_at(p.pos + 1)
                if !regex_is_hex_digit(h1) || !regex_is_hex_digit(h2) {
                    regex_err_pos(p, "\\xNN needs two hex digits in class")
                    return regex_frag_empty()
                }
                p.pos = p.pos + 2
                let bv: int = regex_hex_digit_value(h1) * 16 + regex_hex_digit_value(h2)
                regex_class_add_byte_or_range(p, cls, bv)
                continue
            }
            let ch: int = regex_translate_escape(esc)
            regex_class_add_byte_or_range(p, cls, ch)
            continue
        }
        p.pos = p.pos + 1
        # Check for range: a-z.
        if p.pos + 1 < p.pattern.len()
        && p.pattern.byte_at(p.pos) == 45
        && p.pattern.byte_at(p.pos + 1) != 93 {
            let hi: int = p.pattern.byte_at(p.pos + 1)
            if hi < b {
                regex_err_pos(p, "range out of order in class (e.g. z-a)")
                return regex_frag_empty()
            }
            regex_charclass_add(cls, b, hi)
            p.pos = p.pos + 2
            continue
        }
        regex_charclass_add(cls, b, b)
    }
    if p.pos >= p.pattern.len() {
        regex_err_eof(p, "unterminated character class")
        return regex_frag_empty()
    }
    p.pos = p.pos + 1
    return regex_frag_class(p, cls)
}

# regex_class_add_byte_or_range(p, cls, byte) — add a single byte,
# checking for a following range.
fn regex_class_add_byte_or_range(p: RegexParser, mut cls: RegexCharClass, byte: int) -> void {
    if p.pos + 1 < p.pattern.len()
    && p.pattern.byte_at(p.pos) == 45
    && p.pattern.byte_at(p.pos + 1) != 93 {
        let hi: int = p.pattern.byte_at(p.pos + 1)
        if hi < byte {
            p.err = "regex error: range out of order in class (escape form)"
            return
        }
        regex_charclass_add(cls, byte, hi)
        p.pos = p.pos + 2
        return
    }
    regex_charclass_add(cls, byte, byte)
}

# regex_translate_escape(c) -> int. Translate a single-letter escape
# to its byte value.
fn regex_translate_escape(c: int) -> int {
    if c == 110 {
        return 10
    }
    if c == 116 {
        return 9
    }
    if c == 114 {
        return 13
    }
    if c == 102 {
        return 12
    }
    if c == 118 {
        return 11
    }
    if c == 48 {
        return 0
    }
    if c == 97 {
        return 7
    }
    return c
}

# ============================================================================
# Predefined character classes — \d \w \s.
# ============================================================================

fn regex_class_digit(negate: bool) -> RegexCharClass {
    let cls: RegexCharClass = regex_charclass_new()
    cls.negate = negate
    regex_charclass_add(cls, 48, 57)
    return cls
}

fn regex_class_word(negate: bool) -> RegexCharClass {
    let cls: RegexCharClass = regex_charclass_new()
    cls.negate = negate
    regex_charclass_add(cls, 65, 90)
    regex_charclass_add(cls, 97, 122)
    regex_charclass_add(cls, 48, 57)
    regex_charclass_add(cls, 95, 95)
    return cls
}

fn regex_class_space(negate: bool) -> RegexCharClass {
    let cls: RegexCharClass = regex_charclass_new()
    cls.negate = negate
    regex_charclass_add(cls, 9, 13)
    regex_charclass_add(cls, 32, 32)
    return cls
}

fn regex_class_add_word(mut cls: RegexCharClass) -> void {
    regex_charclass_add(cls, 65, 90)
    regex_charclass_add(cls, 97, 122)
    regex_charclass_add(cls, 48, 57)
    regex_charclass_add(cls, 95, 95)
}

# regex_class_add_word_neg(cls) — add the complement of \w to a class.
# Word bytes are [A-Za-z0-9_] = 48-57 (digits) + 65-90 (uppercase)
# + 95 (_) + 97-122 (lowercase) = 63 bytes. Non-word bytes are
# the other 193: [0..47] [58..64] [91..94] [96..96] [123..255]
# = 48 + 7 + 4 + 1 + 133 = 193.
#
# Deep-scan-21 fix (MEDIUM): the previous code omitted byte 96
# (backtick). So `\W` failed to match backtick and `[^\W]`
# incorrectly included it. The fix: add the [96..96] range.
fn regex_class_add_word_neg(mut cls: RegexCharClass) -> void {
    regex_charclass_add(cls, 0, 47)
    regex_charclass_add(cls, 58, 64)
    regex_charclass_add(cls, 91, 94)
    regex_charclass_add(cls, 96, 96)
    regex_charclass_add(cls, 123, 255)
}

fn regex_class_add_space(mut cls: RegexCharClass) -> void {
    regex_charclass_add(cls, 9, 13)
    regex_charclass_add(cls, 32, 32)
}

fn regex_class_add_space_neg(mut cls: RegexCharClass) -> void {
    regex_charclass_add(cls, 0, 8)
    regex_charclass_add(cls, 14, 31)
    regex_charclass_add(cls, 33, 255)
}

fn regex_charclass_add_neg_range(mut cls: RegexCharClass, lo: int, hi: int) -> void {
    if lo > 0 {
        regex_charclass_add(cls, 0, lo - 1)
    }
    if hi < 255 {
        regex_charclass_add(cls, hi + 1, 255)
    }
}

# ============================================================================
# Compile entry point — regex_compile.
# ============================================================================

# regex_compile(pattern) -> Result[Regex, str]. Compile a regex
# pattern into an NFA. Returns Result.Ok(re) on success,
# Result.Err(msg) on a malformed pattern.
fn regex_compile(pattern: str) -> Result[Regex, str] {
    if pattern.len() > regex_max_pattern() {
        return Result.Err("regex error: pattern exceeds limit " + regex_max_pattern().to_str() + " bytes")
    }
    let mut p: RegexParser = RegexParser {
        pattern: pattern,
        pos: 0,
        states: [],
        classes: [],
        next_group: 1,
        err: ""
    }
    let body: RegexFrag = regex_parse_alternation(p)
    if p.err != "" {
        return Result.Err(p.err)
    }
    if p.pos != p.pattern.len() {
        return Result.Err("regex error at byte " + p.pos.to_str() + ": unexpected trailing input (unbalanced parenthesis?)")
    }
    # Wrap the body in group 0 (the whole match).
    let whole: RegexFrag = regex_frag_save(p, 0, body)
    if p.err != "" {
        return Result.Err(p.err)
    }
    # Build the MATCH state (accepting).
    let accept_st: RegexState = regex_state_new(regex_st_match())
    let accept_idx: int = regex_add_state(p, accept_st)
    if p.err != "" {
        return Result.Err(p.err)
    }
    regex_patch(p, whole, accept_idx)
    let re: Regex = Regex {
        pattern: pattern,
        states: p.states,
        classes: p.classes,
        num_groups: p.next_group,
        start: whole.start,
        accept: accept_idx
    }
    return Result.Ok(re)
}

# ============================================================================
# NFA simulation — Thompson's algorithm with bitmap active set.
#
# We thread `text` and `pos` through the closure walk so that anchor
# states (^ $ \b \B) can check the current byte position.
# ============================================================================

# regex_run(re, text, start_pos) -> Option[RegexMatch].
# Try to match `re` against `text` starting at `start_pos`. Returns
# Option.Some(match) if a match exists, Option.None otherwise.
fn regex_run(re: Regex, text: str, start_pos: int) -> Option[RegexMatch] {
    let n_states: int = re.states.len()
    if n_states == 0 {
        return Option.None
    }
    let n_words: int = (n_states + 63) / 64
    let current: list[int] = list_filled(n_words, 0)
    let next: list[int] = list_filled(n_words, 0)
    let caps: list[int] = list_filled(re.num_groups * 2, -1)
    # Initial closure: add the start state.
    regex_add_state_to_set(re, current, re.start, caps, text, start_pos)
    let mut pos: int = start_pos
    let mut last_match_end: int = -1
    let last_match_caps: list[int] = list_filled(re.num_groups * 2, -1)
    let n: int = text.len()
    while pos <= n {
        # Check if accept is in the current set.
        if regex_set_has(current, re.accept) {
            last_match_end = pos
            let mut k: int = 0
            while k < caps.len() {
                last_match_caps.set(k, caps.get(k))
                k = k + 1
            }
        }
        if pos == n {
            break
        }
        # Clear the next set.
        let mut w: int = 0
        while w < n_words {
            next.set(w, 0)
            w = w + 1
        }
        let cur_byte: int = text.byte_at(pos)
        let mut s: int = 0
        while s < n_states {
            if !regex_set_has(current, s) {
                s = s + 1
                continue
            }
            let st: RegexState = re.states.get(s)
            if st.kind == regex_st_literal() {
                if st.byte == cur_byte {
                    regex_add_state_to_set(re, next, st.out1, caps, text, pos + 1)
                }
            } else if st.kind == regex_st_any() {
                if cur_byte != 10 {
                    regex_add_state_to_set(re, next, st.out1, caps, text, pos + 1)
                }
            } else if st.kind == regex_st_class() {
                let cls: RegexCharClass = re.classes.get(st.class_id)
                if regex_charclass_match(cls, cur_byte) {
                    regex_add_state_to_set(re, next, st.out1, caps, text, pos + 1)
                }
            }
            s = s + 1
        }
        # Swap current and next.
        let mut t: int = 0
        while t < n_words {
            let tmp: int = current.get(t)
            current.set(t, next.get(t))
            next.set(t, tmp)
            t = t + 1
        }
        pos = pos + 1
        # Deep-scan-21 fix (MEDIUM, perf): break as soon as the
        # active set becomes empty. The NFA simulation is monotone —
        # once the active set is empty, no future byte can revive it
        # (the only way to add states is via byte-consuming
        # transitions from already-active states). The previous
        # code only broke when a match had been found, which left
        # the loop iterating through the rest of the text doing
        # nothing — O(n) wasted iterations per `regex_run` call.
        # Combined with the outer scan in `regex_find` /
        # `regex_is_match` / `regex_find_all` / `regex_split`,
        # this was O(n²·m) in the no-match case. With this fix
        # the inner `regex_run` cost is O(actual_match_length · m)
        # and the outer scan is O(leftmost_match · m).
        if regex_set_empty(current) {
            break
        }
    }
    if last_match_end < 0 {
        return Option.None
    }
    let groups: list[RegexGroupSpan] = []
    let mut g: int = 0
    while g < re.num_groups {
        let start: int = last_match_caps.get(g * 2)
        let end: int = last_match_caps.get(g * 2 + 1)
        groups.push(RegexGroupSpan {
            start: start, end: end
        })
        g = g + 1
    }
    return Option.Some(RegexMatch {
        start: start_pos,
        end: last_match_end,
        groups: groups
    })
}

# regex_add_state_to_set(re, set, state_idx, caps, text, pos) — add
# a state to the active set, recursively following epsilon
# transitions. SAVE states update the captures list. ANCHOR states
# check the current position and discard themselves if the anchor
# is not satisfied. MATCH states are added without further traversal.
