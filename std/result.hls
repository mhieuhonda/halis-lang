# ============================================================================
# std/result.hls — the Result[T, E] type (Stage 7)
# ----------------------------------------------------------------------------
# Pure HLS, no `uses IO`. Can be used in any context — including inside the
# compiler `hlc` itself.
#
# `Result[T, E]` is the standard type for fallible operations. Use it instead
# of `panic` for any error that the program might legitimately encounter
# (file not found, parse error, invalid input, ...). `panic` is reserved for
# programming bugs.
# ============================================================================

enum Result[T, E] {
    Ok(T),
    Err(E)
}

# Returns the value if Ok; panics if Err. Use this only when you have already
# verified (e.g. via `result_is_ok`) that the result is Ok. For a safe
# alternative, use `result_unwrap_or`.
fn result_unwrap[T, E](r: Result[T, E]) -> T {
    return match r {
        Result.Ok(v) => v,
        Result.Err(_) => panic("result_unwrap on Err")
    }
}

# Returns the value if Ok, or `default` if Err.
fn result_unwrap_or[T, E](r: Result[T, E], default: T) -> T {
    return match r {
        Result.Ok(v) => v,
        Result.Err(_) => default
    }
}

# Returns the error value if Err, or `default_err` if Ok.
fn result_err_or[T, E](r: Result[T, E], default_err: E) -> E {
    return match r {
        Result.Ok(_) => default_err,
        Result.Err(e) => e
    }
}

# Returns true if the result is Ok.
fn result_is_ok[T, E](r: Result[T, E]) -> bool {
    return match r {
        Result.Ok(_) => true,
        Result.Err(_) => false
    }
}

# Returns true if the result is Err.
fn result_is_err[T, E](r: Result[T, E]) -> bool {
    return match r {
        Result.Ok(_) => false,
        Result.Err(_) => true
    }
}

# Map a Result[T, E] to Result[U, E] by applying f to the Ok value.
# NOTE: HLS v0.3 does NOT support function pointers, so this is provided
# only as a pattern reference — it cannot actually be called. (Higher-order
# functions arrive with closures in Stage 16.)

# ============================================================================
# int_parse — parse a string into a Result[int, str].
#
# Returns Result.Ok(n) if the string is a valid int literal in range;
# returns Result.Err(msg) with a descriptive message otherwise.
# Accepts an optional leading '-'. Accepts only ASCII digits 0-9.
# NOTE: int_parse rejects INT64_MIN by design; use the `int()` builtin if
# you need INT64_MIN — but be aware that `int()` panics on invalid input.
# ============================================================================
fn int_parse(s: str) -> Result[int, str] {
    if s.len() == 0 {
        return Result.Err("empty string")
    }
    let mut i: int = 0
    let mut neg: bool = false
    if s.byte_at(0) == 45 {
        neg = true
        i = 1
    }
    if i >= s.len() {
        return Result.Err("no digits after sign")
    }
    let mut v: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c < 48 || c > 57 {
            return Result.Err("invalid character in integer literal")
        }
        # Bounds check before mul: v * 10 + (c-48) must fit in int64 (positive).
        # INT64_MAX = 9223372036854775807. INT64_MAX / 10 = 922337203685477580
        # (truncated). If v > 922337203685477580, v * 10 overflows. If v ==
        # 922337203685477580 and (c-48) > 7, v*10 + (c-48) overflows.
        # NOTE: This rejects the magnitude 9223372036854775808 (= INT64_MIN),
        # which we deliberately do not support in int_parse.
        if v > 922337203685477580 {
            return Result.Err("integer too large")
        }
        if v == 922337203685477580 && (c - 48) > 7 {
            return Result.Err("integer too large")
        }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    if neg {
        return Result.Ok(-v)
    }
    return Result.Ok(v)
}

# ============================================================================
# float_parse — parse a string into a Result[float, str].
# Accepts optional leading '-', a single '.' separator, and optional
# scientific notation (e.g. "1e5", "1.5e-3", "2E+10"). Rejects empty
# strings, multiple dots, non-digit characters.
# Deep-scan fix (M6): the previous version rejected any 'e'/'E' as
# "invalid character", so "1.5e10" returned Result.Err even though
# str.to_float() accepts it. The interpreter's str.to_float has
# supported scientific notation since Stage 10-beta (BUG-4 fix); this
# parser now mirrors that.
# ============================================================================
fn float_parse(s: str) -> Result[float, str] {
    if s.len() == 0 {
        return Result.Err("empty string")
    }
    let mut i: int = 0
    if s.byte_at(0) == 45 {
        i = 1
    }
    if i >= s.len() {
        return Result.Err("no digits after sign")
    }
    let mut dots: int = 0
    let mut digits: int = 0
    let mut saw_exp: bool = false
    let mut exp_digits: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c == 46 {
            if saw_exp {
                return Result.Err("dot after exponent")
            }
            dots = dots + 1
            if dots > 1 {
                return Result.Err("multiple dots in float literal")
            }
        } else if c >= 48 && c <= 57 {
            if saw_exp {
                exp_digits = exp_digits + 1
            }
            digits = digits + 1
        } else if c == 101 || c == 69 {
            # 'e' or 'E' — start exponent.
            if saw_exp {
                return Result.Err("multiple exponents in float literal")
            }
            if digits == 0 {
                return Result.Err("no mantissa digits before exponent")
            }
            saw_exp = true
            # Optional '+' or '-' after the exponent marker.
            if i + 1 < s.len() && (s.byte_at(i + 1) == 43 || s.byte_at(i + 1) == 45) {
                i = i + 1
            }
            exp_digits = 0
        } else {
            return Result.Err("invalid character in float literal")
        }
        i = i + 1
    }
    # BUG-007 fix: require at least one digit somewhere, otherwise "."
    # would pass the validation above but then panic in to_float().
    if digits == 0 {
        return Result.Err("no digits in float literal")
    }
    if saw_exp && exp_digits == 0 {
        return Result.Err("no digits after exponent marker")
    }
    # Actually convert: use to_float (which panics on invalid) — but we've
    # already validated above, so it's safe.
    return Result.Ok(s.to_float())
}
