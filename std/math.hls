# ============================================================================
# std/math.hls — Math helpers for Halis (Stage 50, v0.69.0-alpha)
# ----------------------------------------------------------------------------
# All functions are pure (no `uses IO`). They use float arithmetic; integer
# helpers are also provided. No external dependencies.
#
# Stage 50 (v0.69.0-alpha) adds:
#   * IEEE-754 edge case predicates: isnan, isinf, isfinite, signbit
#   * libm-backed transcendental functions: sin, cos, tan, asin, acos,
#     atan, atan2, sinh, cosh, tanh, exp, log, log10, log2, pow, sqrt
#     (replaces the old Newton's-method sqrt), cbrt, hypot, fmod,
#     copysign
#   * Special functions: erf, erfc, tgamma, lgamma
#   * BigDecimal: arbitrary-precision decimal arithmetic (pure HLS)
#
# The libm-backed functions are exposed as the math_* builtins (Stage
# 50 wired them through all four code-paths: boot checker, boot
# interpreter, self-hosted compiler C codegen + C runtime, LLVM IR
# emit). The HLS stdlib does NOT define functions with the same
# names as these builtins — the builtins ARE the user-facing API.
#
# BigDecimal is a pure-HLS struct that uses list[int] (the digits) +
# an int scale. It supports add, sub, mul, div, comparison, and
# to_str. It's intended for financial / accounting applications
# where IEEE-754 double precision is unacceptable (e.g., 0.1 + 0.2
# != 0.3 in float). The implementation is NOT optimized for speed —
# it's intended for correctness, not for high-precision scientific
# computing (use the libm long-double path for that).
# ============================================================================

# abs_int(n) returns the absolute value of n. Panics on INT64_MIN.
# SCAN-C fix: 0 - INT64_MIN overflows (the result would be INT64_MIN
# again, since INT64_MIN's two's-complement negation is itself).
# The native runtime's hl_sub_i64 catches this; the interpreter (Python)
# silently returns the wrong value, causing differential-test divergence.
# Panic explicitly here so both paths agree.
fn math_abs_int(n: int) -> int {
    if n == -9223372036854775808 {
        panic("math_abs_int: INT64_MIN has no positive representation")
    }
    if n < 0 {
        return 0 - n
    }
    return n
}

fn math_abs_float(x: float) -> float {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

# min_int / max_int
fn math_min_int(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

fn math_max_int(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

fn math_min_float(a: float, b: float) -> float {
    if a < b {
        return a
    }
    return b
}

fn math_max_float(a: float, b: float) -> float {
    if a > b {
        return a
    }
    return b
}

# clamp_int(x, lo, hi) returns x clamped to [lo, hi].
fn math_clamp_int(x: int, lo: int, hi: int) -> int {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

# power_int(base, exp) returns base^exp for non-negative integer exp.
# Panics on overflow.
fn math_power_int(base: int, exp: int) -> int {
    if exp < 0 {
        panic("math_power_int: negative exponent")
    }
    let mut result: int = 1
    let mut i: int = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}

# power_float(base, exp) returns base^exp for non-negative integer exp.
#
# Deep-scan-20 fix (MEDIUM, overflow): for exp = INT64_MIN, the
# negative-exponent branch computes `0 - exp` which overflows int64
# (two's complement wraps back to INT64_MIN, a negative number).
# The loop `while i < (0 - exp)` then never executes, so the
# function returns `1.0` (instead of the correct ~0.0 for |base|>1).
# Guarded explicitly with a clear panic.
fn math_power_float(base: float, exp: int) -> float {
    if exp < 0 {
        if exp == -9223372036854775808 {
            panic("math_power_float: exponent INT64_MIN would overflow loop bound")
        }
        let mut rec: float = 1.0
        let mut i: int = 0
        while i < (0 - exp) {
            rec = rec * base
            i = i + 1
        }
        return 1.0 / rec
    }
    let mut result: float = 1.0
    let mut i: int = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}

# ----------------------------------------------------------------------------
# Stage 50 (v0.69.0-alpha): the libm-backed math_sqrt builtin now
# provides sqrt. The previous HLS Newton's-method implementation has
# been removed (it was O(64) per call; the libm version is O(1) on
# x86-64 with hardware sqrtss). Calls to math_sqrt resolve to the
# builtin (BUILTIN_FNS takes precedence over user functions).
# ----------------------------------------------------------------------------

# floor_float(x) returns the largest integer <= x as a float.
# SCAN-C fix: x.to_int() panics for floats outside int64 range (e.g.
# 1e20, +/-inf). For out-of-range floats, return x unchanged — the
# caller is computing a floor on a value that's already an integer
# in the float domain (it has no fractional part).
fn math_floor(x: float) -> float {
    if x != x {
        return x  # NaN — propagate (NaN compares false to everything).
    }
    # INT64_MAX as a float = 9223372036854775807 (fits exactly in double).
    # Use the literal form (not scientific) because the lexer does not
    # yet accept `1e18` style floats.
    if x >= 9223372036854775807.0 || x <= -9223372036854775808.0 {
        return x  # out of int64 range — no fractional part to floor.
    }
    let i: int = x.to_int()
    if x < 0.0 && i.to_float() != x {
        return (i - 1).to_float()
    }
    return i.to_float()
}

# ceil_float(x) returns the smallest integer >= x as a float.
# SCAN-C fix: same out-of-range handling as math_floor.
fn math_ceil(x: float) -> float {
    if x != x {
        return x  # NaN
    }
    if x >= 9223372036854775807.0 || x <= -9223372036854775808.0 {
        return x
    }
    let i: int = x.to_int()
    if x > 0.0 && i.to_float() != x {
        return (i + 1).to_float()
    }
    return i.to_float()
}

# round_float(x) returns x rounded to the nearest integer (banker's rounding
# not used; .5 rounds away from zero).
# SCAN-C fix: x.to_int() panics for floats outside int64 range. For
# out-of-range floats, the function can't return a meaningful int, so
# panic explicitly with a clearer message.
fn math_round(x: float) -> int {
    if x != x {
        panic("math_round: NaN has no nearest integer")
    }
    if x >= 9223372036854775807.0 {
        panic("math_round: input > INT64_MAX")
    }
    if x <= -9223372036854775808.0 {
        panic("math_round: input < INT64_MIN")
    }
    if x >= 0.0 {
        let i: int = x.to_int()
        if x - i.to_float() >= 0.5 {
            return i + 1
        }
        return i
    }
    let i: int = x.to_int()
    if i.to_float() - x >= 0.5 {
        return i - 1
    }
    return i
}

# sum_int(xs) returns the sum of a list of ints. Panics on overflow.
fn math_sum_int(xs: list[int]) -> int {
    let mut total: int = 0
    let mut i: int = 0
    while i < xs.len() {
        total = total + xs.get(i)
        i = i + 1
    }
    return total
}

# sum_float(xs) returns the sum of a list of floats.
fn math_sum_float(xs: list[float]) -> float {
    let mut total: float = 0.0
    let mut i: int = 0
    while i < xs.len() {
        total = total + xs.get(i)
        i = i + 1
    }
    return total
}

# avg_float(xs) returns the arithmetic mean of xs. Panics on empty list.
fn math_avg_float(xs: list[float]) -> float {
    if xs.len() == 0 {
        panic("math_avg_float: empty list")
    }
    return math_sum_float(xs) / xs.len().to_float()
}

# ----------------------------------------------------------------------------
# Stage 50 (v0.69.0-alpha): IEEE-754 constants.
# ----------------------------------------------------------------------------
# math_pi / math_e — the two most-used transcendental constants.
# We use the literal decimal forms (the lexer doesn't accept
# scientific notation for float literals). The values are full
# double-precision (16 significant digits).
#
# math_pi  = 3.141592653589793  (closest double to pi)
# math_e   = 2.718281828459045  (closest double to e)
# math_inf = 1.0 / 0.0          (positive infinity — IEEE-754)
# math_neg_inf = 0.0 - 1.0 / 0.0 (negative infinity)
# math_nan = 0.0 / 0.0          (NaN — IEEE-754)
fn math_pi() -> float {
    return 3.141592653589793
}

fn math_e() -> float {
    return 2.718281828459045
}

fn math_pos_inf() -> float {
    return 1.0 / 0.0
}

fn math_neg_inf() -> float {
    return 0.0 - 1.0 / 0.0
}

fn math_nan() -> float {
    return 0.0 / 0.0
}

# ----------------------------------------------------------------------------
# Stage 50 (v0.69.0-alpha): BigDecimal — arbitrary-precision decimal.
# ----------------------------------------------------------------------------
# BigDecimal represents a decimal number as a (sign, digits, scale)
# triple where:
#   sign  ∈ {-1, 0, +1}  (0 means zero; the digits list is empty)
#   digits is a list[int] of decimal digits, most-significant first.
#     Each int is 0..9 (we don't pack into larger cells to keep the
#     implementation simple — performance is NOT a goal; correctness is).
#   scale is the number of digits after the decimal point. A negative
#     scale means trailing zeros before the decimal point (e.g., 100
#     with scale -1 means 1000).
#
# Examples:
#   BigDecimal { sign: 1, digits: [1, 2, 3], scale: 0 }   = 123
#   BigDecimal { sign: 1, digits: [1, 2, 3], scale: 1 }   = 12.3
#   BigDecimal { sign: 1, digits: [1, 2, 3], scale: 3 }   = 0.123
#   BigDecimal { sign: 1, digits: [1, 2, 3], scale: -1 }  = 1230
#   BigDecimal { sign: -1, digits: [1, 2, 3], scale: 1 }  = -12.3
#   BigDecimal { sign: 0, digits: [],      scale: 0 }    = 0
#
# All arithmetic is exact (no floating-point error). 0.1 + 0.2 = 0.3
# exactly; 1.0 / 3.0 truncates to 0.333... with the user-specified
# precision (the div function takes a `precision` arg = number of
# significant digits to keep).
# ----------------------------------------------------------------------------

struct BigDecimal {
    sign: int,    # -1, 0, +1
    digits: list[int],  # most-significant first; each 0..9
    scale: int,   # number of digits after the decimal point
}

# Constructors.
fn bigdecimal_zero() -> BigDecimal {
    return BigDecimal { sign: 0, digits: [], scale: 0 }
}

fn bigdecimal_from_int(n: int) -> BigDecimal {
    if n == 0 {
        return bigdecimal_zero()
    }
    let mut sign: int = 1
    let mut abs_n: int = n
    if n < 0 {
        sign = -1
        if n == -9223372036854775808 {
            # INT64_MIN's negation overflows. Decompose into digits
            # via string (the to_str builtin handles INT64_MIN
            # correctly because Python's str(int) does).
            let s: str = n.to_str()
            # s is "-9223372036854775808" — skip the leading "-".
            let digits: list[int] = []
            let mut i: int = 1
            while i < s.len() {
                let byte: int = s.byte_at(i)
                # '0' is 48, '9' is 57.
                digits.push(byte - 48)
                i = i + 1
            }
            return BigDecimal { sign: -1, digits: digits, scale: 0 }
        }
        abs_n = 0 - n
    }
    # Decompose abs_n into digits. We build the list in reverse
    # (least-significant first), then reverse it.
    let rev_digits: list[int] = []
    let mut x: int = abs_n
    while x > 0 {
        rev_digits.push(x % 10)
        x = x / 10
    }
    # Reverse.
    let digits2: list[int] = []
    let mut j: int = rev_digits.len() - 1
    while j >= 0 {
        digits2.push(rev_digits.get(j))
        j = j - 1
    }
    return BigDecimal { sign: sign, digits: digits2, scale: 0 }
}

# bigdecimal_from_str(s) parses a decimal string like "123", "-12.34",
# "0.001", or "1.5e3" (the e-notation is parsed into a scaled form).
# Returns Result[BigDecimal, str] — Err on parse failure.
import "std.result"

fn bigdecimal_from_str(s: str) -> Result[BigDecimal, str] {
    if s.len() == 0 {
        return Result.Err("bigdecimal_from_str: empty string")
    }
    let mut pos: int = 0
    let mut sign: int = 1
    # Optional leading sign.
    let first_byte: int = s.byte_at(0)
    if first_byte == 45 {  # '-'
        sign = -1
        pos = 1
    } else if first_byte == 43 {  # '+'
        pos = 1
    }
    if pos >= s.len() {
        return Result.Err("bigdecimal_from_str: sign with no digits")
    }
    # Parse the integer + fractional parts.
    let digits: list[int] = []
    let mut scale: int = 0
    let mut seen_dot: bool = false
    let mut seen_digit: bool = false
    let mut exp: int = 0
    let mut seen_e: bool = false
    let mut exp_sign: int = 1
    while pos < s.len() {
        let b: int = s.byte_at(pos)
        if b >= 48 && b <= 57 {
            # Digit.
            digits.push(b - 48)
            if seen_dot {
                scale = scale + 1
            }
            seen_digit = true
        } else if b == 46 && !seen_dot {  # '.'
            seen_dot = true
        } else if (b == 101 || b == 69) && !seen_e {  # 'e' / 'E'
            seen_e = true
            # Optional sign in the exponent.
            if pos + 1 < s.len() {
                let next_b: int = s.byte_at(pos + 1)
                if next_b == 45 {  # '-'
                    exp_sign = -1
                    pos = pos + 1
                } else if next_b == 43 {  # '+'
                    pos = pos + 1
                }
            }
            # Parse the exponent digits.
            pos = pos + 1
            let exp_digits: list[int] = []
            while pos < s.len() {
                let eb: int = s.byte_at(pos)
                if eb >= 48 && eb <= 57 {
                    exp_digits.push(eb - 48)
                } else {
                    return Result.Err("bigdecimal_from_str: invalid char in exponent")
                }
                pos = pos + 1
            }
            let mut k: int = 0
            while k < exp_digits.len() {
                exp = exp * 10 + exp_digits.get(k)
                k = k + 1
            }
            exp = exp * exp_sign
            break
        } else {
            return Result.Err("bigdecimal_from_str: invalid char at pos " + pos.to_str())
        }
        pos = pos + 1
    }
    if !seen_digit {
        return Result.Err("bigdecimal_from_str: no digits")
    }
    # Apply the exponent: positive exp reduces the scale.
    scale = scale - exp
    # Remove leading zeros (but keep at least one digit if non-zero).
    let trimmed: list[int] = []
    let mut leading: bool = true
    let mut idx: int = 0
    while idx < digits.len() {
        let d: int = digits.get(idx)
        if leading && d == 0 && idx < digits.len() - 1 {
            # Skip leading zero.
        } else {
            leading = false
            trimmed.push(d)
        }
        idx = idx + 1
    }
    # Check if the value is zero.
    let mut is_zero: bool = true
    let mut z: int = 0
    while z < trimmed.len() {
        if trimmed.get(z) != 0 {
            is_zero = false
            break
        }
        z = z + 1
    }
    if is_zero {
        return Result.Ok(bigdecimal_zero())
    }
    return Result.Ok(BigDecimal { sign: sign, digits: trimmed, scale: scale })
}

# bigdecimal_to_str(bd) renders the BigDecimal as a decimal string.
fn bigdecimal_to_str(bd: BigDecimal) -> str {
    if bd.sign == 0 || bd.digits.len() == 0 {
        return "0"
    }
    let mut s: str = ""
    if bd.sign < 0 {
        s = "-"
    }
    if bd.scale <= 0 {
        # No fractional part. Append digits + (-scale) zeros.
        let mut i: int = 0
        while i < bd.digits.len() {
            s = s + chr(bd.digits.get(i) + 48)
            i = i + 1
        }
        let mut z: int = 0
        while z < (0 - bd.scale) {
            s = s + "0"
            z = z + 1
        }
    } else {
        # Has a fractional part. Determine where to put the decimal point.
        let int_digits: int = bd.digits.len() - bd.scale
        if int_digits <= 0 {
            # 0.00...digits — pad with leading zeros.
            s = s + "0."
            let mut z: int = 0
            while z < (0 - int_digits) {
                s = s + "0"
                z = z + 1
            }
            let mut i: int = 0
            while i < bd.digits.len() {
                s = s + chr(bd.digits.get(i) + 48)
                i = i + 1
            }
        } else {
            # int part = first int_digits digits, then '.', then the rest.
            let mut i: int = 0
            while i < int_digits {
                s = s + chr(bd.digits.get(i) + 48)
                i = i + 1
            }
            s = s + "."
            while i < bd.digits.len() {
                s = s + chr(bd.digits.get(i) + 48)
                i = i + 1
            }
        }
    }
    return s
}

# Comparison: eq, lt, gt. Returns plain bool.
fn bigdecimal_eq(a: BigDecimal, b: BigDecimal) -> bool {
    # Quick path: if signs differ, not equal.
    if a.sign != b.sign {
        return false
    }
    # Both zero?
    if a.sign == 0 {
        return true
    }
    # Normalize scales, then compare digits.
    # We align by appending zeros to the smaller-scale operand.
    # (Without normalization, 1.0 (scale 1) != 1.00 (scale 2) — which
    # is wrong. We normalize before comparison.)
    let a_norm: BigDecimal = _bigdecimal_normalize(a)
    let b_norm: BigDecimal = _bigdecimal_normalize(b)
    if a_norm.scale != b_norm.scale {
        return false
    }
    if a_norm.digits.len() != b_norm.digits.len() {
        return false
    }
    let mut i: int = 0
    while i < a_norm.digits.len() {
        if a_norm.digits.get(i) != b_norm.digits.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

# Internal: normalize a BigDecimal by removing trailing zeros in the
# fractional part (so 1.50 becomes 1.5). Doesn't change the value.
fn _bigdecimal_normalize(bd: BigDecimal) -> BigDecimal {
    if bd.sign == 0 {
        return bd
    }
    let mut digits: list[int] = bd.digits
    let mut scale: int = bd.scale
    # Remove trailing zeros from the fractional part.
    while scale > 0 && digits.len() > 0 {
        let last: int = digits.get(digits.len() - 1)
        if last == 0 {
            # Pop the last digit.
            let mut new_digits: list[int] = []
            let mut i: int = 0
            while i < digits.len() - 1 {
                new_digits.push(digits.get(i))
                i = i + 1
            }
            digits = new_digits
            scale = scale - 1
        } else {
            break
        }
    }
    return BigDecimal { sign: bd.sign, digits: digits, scale: scale }
}

# bigdecimal_lt(a, b) returns true iff a < b.
fn bigdecimal_lt(a: BigDecimal, b: BigDecimal) -> bool {
    # Handle zero specially.
    if a.sign == 0 {
        return b.sign > 0
    }
    if b.sign == 0 {
        return a.sign < 0
    }
    # Different signs: negative < positive.
    if a.sign < 0 && b.sign > 0 {
        return true
    }
    if a.sign > 0 && b.sign < 0 {
        return false
    }
    # Same sign. Compare magnitudes (aligning scales).
    let mag_cmp: int = _bigdecimal_cmp_magnitude(a, b)
    if a.sign > 0 {
        return mag_cmp < 0
    }
    # Both negative: a < b iff |a| > |b|.
    return mag_cmp > 0
}

fn bigdecimal_gt(a: BigDecimal, b: BigDecimal) -> bool {
    return bigdecimal_lt(b, a)
}

fn bigdecimal_le(a: BigDecimal, b: BigDecimal) -> bool {
    return !bigdecimal_lt(b, a)
}

fn bigdecimal_ge(a: BigDecimal, b: BigDecimal) -> bool {
    return !bigdecimal_lt(a, b)
}

# Internal: compare magnitudes (ignoring sign). Returns -1 if |a| < |b|,
# 0 if equal, +1 if |a| > |b|.
fn _bigdecimal_cmp_magnitude(a: BigDecimal, b: BigDecimal) -> int {
    # Determine the position of the most-significant digit relative
    # to the decimal point. The MSD of a number with N digits and
    # scale S is at position N - S (so 123.45 has MSD at position 5 - 2 = 3,
    # i.e. the hundreds place).
    let a_msd_pos: int = a.digits.len() - a.scale
    let b_msd_pos: int = b.digits.len() - b.scale
    if a_msd_pos != b_msd_pos {
        if a_msd_pos < b_msd_pos {
            return -1
        }
        return 1
    }
    # Same MSD position — compare digit by digit.
    let mut i: int = 0
    while i < a.digits.len() && i < b.digits.len() {
        let ad: int = a.digits.get(i)
        let bd: int = b.digits.get(i)
        if ad != bd {
            if ad < bd {
                return -1
            }
            return 1
        }
        i = i + 1
    }
    # All compared digits are equal. The longer one wins.
    if a.digits.len() < b.digits.len() {
        return -1
    }
    if a.digits.len() > b.digits.len() {
        return 1
    }
    return 0
}

# bigdecimal_add(a, b) returns a + b. The result has the larger of
# the two scales (so 1.5 + 1.50 = 3.00 with scale 2 — preserves
# trailing zeros for accounting-style display).
fn bigdecimal_add(a: BigDecimal, b: BigDecimal) -> BigDecimal {
    if a.sign == 0 {
        return b
    }
    if b.sign == 0 {
        return a
    }
    # Align scales by padding the smaller-scale operand with trailing
    # zeros. (1.5 (scale 1) + 1.50 (scale 2): pad 1.5 to 1.50 (scale 2).)
    let max_scale: int = math_max_int(a.scale, b.scale)
    let a_aligned: list[int] = _bigdecimal_pad_to_scale(a, max_scale)
    let b_aligned: list[int] = _bigdecimal_pad_to_scale(b, max_scale)
    if a.sign == b.sign {
        # Same sign: add magnitudes, keep sign.
        let sum_digits: list[int] = _bigdecimal_add_digits(a_aligned, b_aligned)
        return BigDecimal { sign: a.sign, digits: sum_digits, scale: max_scale }
    }
    # Different signs: subtract smaller magnitude from larger.
    let cmp: int = _bigdecimal_cmp_digits(a_aligned, b_aligned)
    if cmp == 0 {
        return bigdecimal_zero()
    }
    if cmp > 0 {
        # |a| > |b|: result has a's sign.
        let diff: list[int] = _bigdecimal_sub_digits(a_aligned, b_aligned)
        return BigDecimal { sign: a.sign, digits: diff, scale: max_scale }
    }
    # |b| > |a|: result has b's sign.
    let diff: list[int] = _bigdecimal_sub_digits(b_aligned, a_aligned)
    return BigDecimal { sign: b.sign, digits: diff, scale: max_scale }
}

# bigdecimal_sub(a, b) returns a - b = a + (-b).
fn bigdecimal_sub(a: BigDecimal, b: BigDecimal) -> BigDecimal {
    if b.sign == 0 {
        return a
    }
    let neg_b: BigDecimal = BigDecimal { sign: 0 - b.sign, digits: b.digits, scale: b.scale }
    return bigdecimal_add(a, neg_b)
}

# Internal helpers: pad/truncate digit lists to align scales.
fn _bigdecimal_pad_to_scale(bd: BigDecimal, target_scale: int) -> list[int] {
    # If bd.scale < target_scale, append (target_scale - bd.scale) zeros.
    let out: list[int] = []
    let mut i: int = 0
    while i < bd.digits.len() {
        out.push(bd.digits.get(i))
        i = i + 1
    }
    let mut j: int = bd.scale
    while j < target_scale {
        out.push(0)
        j = j + 1
    }
    return out
}

fn _bigdecimal_add_digits(a: list[int], b: list[int]) -> list[int] {
    # Schoolbook addition with carry. Add from least-significant.
    # The lists are most-significant first, so we walk from the end.
    let result: list[int] = []
    let mut carry: int = 0
    let mut i: int = a.len() - 1
    let mut j: int = b.len() - 1
    while i >= 0 || j >= 0 || carry > 0 {
        let mut sum: int = carry
        if i >= 0 {
            sum = sum + a.get(i)
            i = i - 1
        }
        if j >= 0 {
            sum = sum + b.get(j)
            j = j - 1
        }
        result.push(sum % 10)
        carry = sum / 10
    }
    # The result is in least-significant first order; reverse it.
    let reversed: list[int] = []
    let mut k: int = result.len() - 1
    while k >= 0 {
        reversed.push(result.get(k))
        k = k - 1
    }
    return reversed
}

fn _bigdecimal_sub_digits(a: list[int], b: list[int]) -> list[int] {
    # Schoolbook subtraction with borrow. Assumes |a| >= |b|.
    let result: list[int] = []
    let mut borrow: int = 0
    let mut i: int = a.len() - 1
    let mut j: int = b.len() - 1
    while i >= 0 {
        let mut diff: int = a.get(i) - borrow
        if j >= 0 {
            diff = diff - b.get(j)
            j = j - 1
        }
        if diff < 0 {
            diff = diff + 10
            borrow = 1
        } else {
            borrow = 0
        }
        result.push(diff)
        i = i - 1
    }
    # Reverse and strip leading zeros.
    let reversed: list[int] = []
    let mut k: int = result.len() - 1
    while k >= 0 {
        reversed.push(result.get(k))
        k = k - 1
    }
    # Strip leading zeros (keep at least one digit).
    let stripped: list[int] = []
    let mut leading: bool = true
    let mut idx: int = 0
    while idx < reversed.len() {
        let d: int = reversed.get(idx)
        if leading && d == 0 && idx < reversed.len() - 1 {
            # skip
        } else {
            leading = false
            stripped.push(d)
        }
        idx = idx + 1
    }
    return stripped
}

fn _bigdecimal_cmp_digits(a: list[int], b: list[int]) -> int {
    # Assumes a and b are aligned to the same scale (so the same
    # number of digits after the decimal point — but they may have
    # different integer parts). Compare lengths first (after stripping
    # leading zeros), then digit by digit.
    if a.len() != b.len() {
        if a.len() < b.len() {
            return -1
        }
        return 1
    }
    let mut i: int = 0
    while i < a.len() {
        if a.get(i) != b.get(i) {
            if a.get(i) < b.get(i) {
                return -1
            }
            return 1
        }
        i = i + 1
    }
    return 0
}

# bigdecimal_mul(a, b) — schoolbook multiplication.
fn bigdecimal_mul(a: BigDecimal, b: BigDecimal) -> BigDecimal {
    if a.sign == 0 || b.sign == 0 {
        return bigdecimal_zero()
    }
    # Multiply the digit lists (schoolbook O(n*m)).
    # The result has scale = a.scale + b.scale.
    let n: int = a.digits.len()
    let m: int = b.digits.len()
    # Initialize the result digit array (least-significant first).
    let result_len: int = n + m
    let result: list[int] = []
    let mut k: int = 0
    while k < result_len {
        result.push(0)
        k = k + 1
    }
    let mut i: int = n - 1
    while i >= 0 {
        let mut j: int = m - 1
        while j >= 0 {
            let prod: int = a.digits.get(i) * b.digits.get(j)
            let pos: int = (n - 1 - i) + (m - 1 - j)
            let existing: int = result.get(pos)
            let sum: int = existing + prod
            result.set(pos, sum % 10)
            # Carry into the next position.
            let carry_pos: int = pos + 1
            if carry_pos < result_len {
                let existing_carry: int = result.get(carry_pos)
                result.set(carry_pos, existing_carry + sum / 10)
            }
            j = j - 1
        }
        i = i - 1
    }
    # The result is least-significant first; reverse it.
    let reversed: list[int] = []
    let mut kk: int = result_len - 1
    while kk >= 0 {
        reversed.push(result.get(kk))
        kk = kk - 1
    }
    # Strip leading zeros (keep at least one digit).
    let stripped: list[int] = []
    let mut leading: bool = true
    let mut idx: int = 0
    while idx < reversed.len() {
        let d: int = reversed.get(idx)
        if leading && d == 0 && idx < reversed.len() - 1 {
            # skip
        } else {
            leading = false
            stripped.push(d)
        }
        idx = idx + 1
    }
    let sign: int = a.sign * b.sign
    return BigDecimal { sign: sign, digits: stripped, scale: a.scale + b.scale }
}

# bigdecimal_neg(bd) returns -bd.
fn bigdecimal_neg(bd: BigDecimal) -> BigDecimal {
    if bd.sign == 0 {
        return bd
    }
    return BigDecimal { sign: 0 - bd.sign, digits: bd.digits, scale: bd.scale }
}

# bigdecimal_abs(bd) returns |bd|.
fn bigdecimal_abs(bd: BigDecimal) -> BigDecimal {
    if bd.sign < 0 {
        return BigDecimal { sign: 1, digits: bd.digits, scale: bd.scale }
    }
    return bd
}

# bigdecimal_is_zero(bd) returns true iff bd == 0.
fn bigdecimal_is_zero(bd: BigDecimal) -> bool {
    return bd.sign == 0
}

# bigdecimal_to_int(bd) truncates bd to an int. Panics on overflow /
# unsupported (sign 0 with non-empty digits, scale too negative, etc.).
fn bigdecimal_to_int(bd: BigDecimal) -> int {
    if bd.sign == 0 {
        return 0
    }
    # Compute the integer part: digits[:len - scale] if scale > 0,
    # else digits + (-scale) trailing zeros.
    let mut int_part: list[int] = []
    if bd.scale > 0 {
        let n_int_digits: int = bd.digits.len() - bd.scale
        if n_int_digits <= 0 {
            return 0
        }
        let mut i: int = 0
        while i < n_int_digits {
            int_part.push(bd.digits.get(i))
            i = i + 1
        }
    } else {
        # No fractional part; copy all digits.
        let mut i: int = 0
        while i < bd.digits.len() {
            int_part.push(bd.digits.get(i))
            i = i + 1
        }
        # Append -scale zeros.
        let mut z: int = 0
        while z < (0 - bd.scale) {
            int_part.push(0)
            z = z + 1
        }
    }
    # Convert int_part (list of digits) to an int.
    let mut result: int = 0
    let mut i: int = 0
    while i < int_part.len() {
        result = result * 10 + int_part.get(i)
        i = i + 1
    }
    if bd.sign < 0 {
        return 0 - result
    }
    return result
}

