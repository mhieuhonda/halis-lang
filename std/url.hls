# ============================================================================
# std/url.hls — URL parsing and encoding for Halis
# ----------------------------------------------------------------------------
# Pure-HLS utilities for web programming. All functions are pure (no `uses IO`)
# so they can be used in any context.
#
# URL grammar supported (RFC 3986 subset):
#   scheme://[user[:password]@]host[:port][/path][?query][#fragment]
# ============================================================================

import "std.str"

struct Url {
    scheme: str,
    user: str,
    password: str,
    host: str,
    port: int,
    path: str,
    query: str,
    fragment: str
}

# url_parse(s) parses a URL string. Panics on malformed input.
fn url_parse(s: str) -> Url {
    let u: Url = Url {
        scheme: "",
        user: "",
        password: "",
        host: "",
        port: 0,
        path: "",
        query: "",
        fragment: ""
    }
    let n: int = s.len()
    let mut i: int = 0
    # scheme: letters/digits/+/-/. followed by ":"
    let scheme_start: int = 0
    let mut scheme_end: int = -1
    let mut j: int = 0
    while j < n {
        let c: int = s.byte_at(j)
        if c == 58 {
            scheme_end = j
            break
        }
        # scheme char: ALPHA / DIGIT / "+" / "-" / "."
        let ok: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
            || (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46
        if !ok {
            break
        }
        j = j + 1
    }
    if scheme_end > 0 {
        u.scheme = str_to_lower_ascii(s.slice(0, scheme_end))
        i = scheme_end + 1
    }
    # "//" authority
    if i + 2 <= n && s.byte_at(i) == 47 && s.byte_at(i + 1) == 47 {
        i = i + 2
        let auth_start: int = i
        # authority ends at '/', '?', or '#'
        let mut auth_end: int = n
        while i < n {
            let c: int = s.byte_at(i)
            if c == 47 || c == 63 || c == 35 {
                auth_end = i
                break
            }
            i = i + 1
        }
        if auth_end > auth_start {
            let auth: str = s.slice(auth_start, auth_end)
            url_parse_authority(u, auth)
        }
    }
    # path: up to '?' or '#'
    let path_start: int = i
    let mut path_end: int = n
    while i < n {
        let c: int = s.byte_at(i)
        if c == 63 || c == 35 {
            path_end = i
            break
        }
        i = i + 1
    }
    if path_end > path_start {
        u.path = s.slice(path_start, path_end)
    }
    # query
    if i < n && s.byte_at(i) == 63 {
        i = i + 1
        let q_start: int = i
        let mut q_end: int = n
        while i < n {
            if s.byte_at(i) == 35 {
                q_end = i
                break
            }
            i = i + 1
        }
        u.query = s.slice(q_start, q_end)
    }
    # fragment
    if i < n && s.byte_at(i) == 35 {
        u.fragment = s.slice(i + 1, n)
    }
    return u
}

fn url_parse_authority(u: Url, auth: str) -> void {
    let n: int = auth.len()
    # BUG-33 fix: RFC 3986 doesn't allow `@` in userinfo (must be percent-
    # encoded). If multiple `@` chars appear, treat the FIRST one as the
    # userinfo/host separator — this is the safer, more defensive choice
    # (a malicious URL like `user@evil.com@safe.com` should NOT parse as
    # `user@evil.com` userinfo + `safe.com` host, which is what the LAST-@
    # interpretation gave).
    let mut at_idx: int = -1
    let mut i: int = 0
    while i < n {
        if auth.byte_at(i) == 64 {
            at_idx = i
            break
        }
        i = i + 1
    }
    let mut host_part: str = auth
    if at_idx >= 0 {
        let userinfo: str = auth.slice(0, at_idx)
        host_part = auth.slice(at_idx + 1, n)
        # split userinfo on ":"
        let colon: int = userinfo.find(":")
        if colon >= 0 {
            u.user = userinfo.slice(0, colon)
            u.password = userinfo.slice(colon + 1, userinfo.len())
        } else {
            u.user = userinfo
        }
    }
    # host[:port], with IPv6 [::1]:port support (basic)
    let hn: int = host_part.len()
    if hn > 0 && host_part.byte_at(0) == 91 {
        # IPv6 — find closing ']'
        let close: int = host_part.find("]")
        if close < 0 {
            panic("url_parse: unterminated IPv6 literal")
        }
        u.host = host_part.slice(0, close + 1)
        if close + 2 <= hn && host_part.byte_at(close + 1) == 58 {
            let port_str: str = host_part.slice(close + 2, hn)
            # SCAN-C fix: a trailing colon with no port digits (e.g.
            # `http://[::1]:`) used to call `urlp_parse_port("")`, which
            # panics in `to_int("")`. Mirror the non-IPv6 path's guard.
            if port_str.len() > 0 {
                u.port = urlp_parse_port(port_str)
            } else {
                panic("url_parse: empty port after ':' in IPv6 literal")
            }
        }
        return
    }
    let colon: int = host_part.find(":")
    if colon >= 0 {
        u.host = host_part.slice(0, colon)
        let port_str: str = host_part.slice(colon + 1, hn)
        if port_str.len() > 0 {
            u.port = urlp_parse_port(port_str)
        }
    } else {
        u.host = host_part
    }
}

# urlp_parse_port validates and converts a port string. BUG (deep-scan-5):
# a malformed port ("abc", overflow) reached to_int() and panicked with a
# RAW conversion error (no URL context); a negative port was accepted
# silently. Validate digits + the 0..65535 range.
fn urlp_parse_port(port_str: str) -> int {
    let mut i: int = 0
    while i < port_str.len() {
        let c: int = port_str.byte_at(i)
        if c < 48 || c > 57 {
            panic("url_parse: invalid port '" + port_str + "'")
        }
        i = i + 1
    }
    if port_str.len() > 5 {
        panic("url_parse: port out of range: " + port_str)
    }
    let v: int = port_str.to_int()
    if v > 65535 {
        panic("url_parse: port out of range: " + port_str)
    }
    return v
}

# url_stringify(u) reconstructs a URL string from a Url struct.
fn url_stringify(u: Url) -> str {
    let mut s: str = ""
    if u.scheme.len() > 0 {
        s = s + u.scheme + ":"
    }
    if u.host.len() > 0 {
        s = s + "//"
        if u.user.len() > 0 {
            s = s + u.user
            if u.password.len() > 0 {
                s = s + ":" + u.password
            }
            s = s + "@"
        }
        s = s + u.host
        if u.port != 0 {
            s = s + ":" + u.port.to_str()
        }
    }
    s = s + u.path
    if u.query.len() > 0 {
        s = s + "?" + u.query
    }
    if u.fragment.len() > 0 {
        s = s + "#" + u.fragment
    }
    return s
}

# url_query_parse(qs) parses "k1=v1&k2=v2..." into a map.
# Returns a map[str, str]. Keys with no "=" get an empty value.
fn url_query_parse(qs: str) -> map[str, str] {
    let m: map[str, str] = map_new()
    if qs.len() == 0 {
        return m
    }
    let pairs: list[str] = qs.split("&")
    let mut i: int = 0
    while i < pairs.len() {
        let pair: str = pairs.get(i)
        # BUG (deep-scan-5): empty segments ("&a=1&&b=2") created a
        # phantom "" key. Skip them.
        if pair.len() == 0 {
            i = i + 1
            continue
        }
        let eq: int = pair.find("=")
        if eq < 0 {
            m.set(url_decode(pair), "")
        } else {
            let k: str = url_decode(pair.slice(0, eq))
            let v: str = url_decode(pair.slice(eq + 1, pair.len()))
            m.set(k, v)
        }
        i = i + 1
    }
    return m
}

# url_query_stringify(m) serialises a map[str, str] into "k1=v1&k2=v2...".
fn url_query_stringify(m: map[str, str]) -> str {
    let keys: list[str] = m.keys()
    let parts: list[str] = []
    let mut i: int = 0
    while i < keys.len() {
        let k: str = keys.get(i)
        let v: str = m.get_or(k, "")
        parts.push(url_encode(k) + "=" + url_encode(v))
        i = i + 1
    }
    return str_join(parts, "&")
}

# url_encode(s) percent-encodes characters that are not unreserved in a URL.
# Unreserved: A-Z a-z 0-9 - _ . ~
fn url_encode(s: str) -> str {
    let out: list[str] = []
    let mut i: int = 0
    let n: int = s.len()
    while i < n {
        let c: int = s.byte_at(i)
        let unreserved: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
            || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46 || c == 126
        if unreserved {
            out.push(s.slice(i, i + 1))
        } else {
            out.push("%")
            out.push(url_hex_byte(c))
        }
        i = i + 1
    }
    return str_join(out, "")
}

# url_decode(s) decodes percent-encoded sequences ("+" → " ").
fn url_decode(s: str) -> str {
    let out: list[str] = []
    let n: int = s.len()
    let mut i: int = 0
    while i < n {
        let c: int = s.byte_at(i)
        if c == 43 {
            out.push(" ")
            i = i + 1
        } else if c == 37 && i + 3 <= n {
            let h1: int = url_hex_digit(s.byte_at(i + 1))
            let h2: int = url_hex_digit(s.byte_at(i + 2))
            if h1 < 0 || h2 < 0 {
                out.push(s.slice(i, i + 1))
                i = i + 1
            } else {
                out.push(chr(h1 * 16 + h2))
                i = i + 3
            }
        } else {
            out.push(s.slice(i, i + 1))
            i = i + 1
        }
    }
    return str_join(out, "")
}

fn url_hex_digit(b: int) -> int {
    if b >= 48 && b <= 57 {
        return b - 48
    }
    if b >= 65 && b <= 70 {
        return b - 55
    }
    if b >= 97 && b <= 102 {
        return b - 87
    }
    return -1
}

fn url_hex_byte(b: int) -> str {
    let hi: int = b / 16
    let lo: int = b % 16
    return url_hex_nibble(hi) + url_hex_nibble(lo)
}

fn url_hex_nibble(n: int) -> str {
    if n < 10 {
        return chr(48 + n)
    }
    return chr(65 + (n - 10))
}
