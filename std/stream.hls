# ============================================================================
# std/stream.hls — Stage 34 (v0.53.0-alpha): async stream combinators
# ----------------------------------------------------------------------------
# `Stream[T]` is a built-in generic type (declared in the compiler, not
# here). At runtime it is a bounded `hl_chan*` (backpressure: a slow
# consumer blocks the producer — no unbounded buffering).
#
# The stream primitives are BUILTINS (stream_new, stream_send, stream_recv,
# stream_try_recv, stream_len, stream_close, stream_map_int,
# stream_filter_int, stream_take_int, stream_fold_int, stream_merge_int,
# stream_flat_map_int, gen_spawn) — declared in the compiler.
#
# End-of-stream sentinel convention:
#   For int streams, the sentinel is INT64_MIN (-9223372036854775808).
#   The producer calls `stream_close(s)` which sends the sentinel.
#   The consumer checks each received value against INT64_MIN to detect
#   end-of-stream. The combinator workers handle this automatically.
#
# Zero-allocation design:
#   Each combinator (map, filter, take, fold, merge, flat_map) spawns a
#   worker task that reads from the input stream, applies the transform,
#   and writes to the output stream. The streams are bounded channels —
#   backpressure propagates through the pipeline. After warmup (the first
#   few elements fill the bounded buffers), no heap allocation occurs
#   per element (the channel reuses its internal message slots).
#
# Generator pattern (gen_spawn):
#   `gen_spawn(f, args...)` creates a bounded stream, spawns f(stream,
#   args...), and returns the stream. The generator function takes the
#   stream as its FIRST parameter and writes values via stream_send.
#   When done, the generator calls stream_close to signal end-of-stream.
# ============================================================================

import "std.option"

# ----------------------------------------------------------------------------
# stream_drain_int: consume all values from an int stream, return as a list.
# Blocks until end-of-stream (sentinel). Mainly useful for testing.
# ----------------------------------------------------------------------------
fn stream_drain_int(s: Stream[int]) -> list[int] uses Conc {
    let out: list[int] = []
    let mut done: bool = false
    while !done {
        let v: int = stream_recv(s)
        if v == -9223372036854775808 {
            done = true
        } else {
            out.push(v)
        }
    }
    return out
}

# ----------------------------------------------------------------------------
# stream_count_int: count the number of values in an int stream.
# Blocks until end-of-stream.
# ----------------------------------------------------------------------------
fn stream_count_int(s: Stream[int]) -> int uses Conc {
    let mut count: int = 0
    let mut done: bool = false
    while !done {
        let v: int = stream_recv(s)
        if v == -9223372036854775808 {
            done = true
        } else {
            count = count + 1
        }
    }
    return count
}

# ----------------------------------------------------------------------------
# stream_sum_int: sum all values in an int stream.
# Blocks until end-of-stream.
# ----------------------------------------------------------------------------
fn stream_sum_int(s: Stream[int]) -> int uses Conc {
    let mut sum: int = 0
    let mut done: bool = false
    while !done {
        let v: int = stream_recv(s)
        if v == -9223372036854775808 {
            done = true
        } else {
            sum = sum + v
        }
    }
    return sum
}

# ----------------------------------------------------------------------------
# stream_to_chan: convert a Stream[T] to a Chan[T] (drops the type
# distinction; useful for interop with Stage 16 channel-based code).
# Blocks until end-of-stream, forwarding each value to the output channel.
# ----------------------------------------------------------------------------
fn stream_to_chan_int(s: Stream[int], out: Chan[int]) uses Conc {
    let mut done: bool = false
    while !done {
        let v: int = stream_recv(s)
        if v == -9223372036854775808 {
            done = true
        } else {
            out.send(v)
        }
    }
}

# ----------------------------------------------------------------------------
# stream_from_list_int: create a stream from a list of ints.
# Spawns a generator that pushes each list element, then closes.
# This is the inverse of stream_drain_int.
# ----------------------------------------------------------------------------
fn stream_from_list_int_worker(xs: list[int], out: Stream[int]) uses Conc {
    let mut i: int = 0
    while i < xs.len() {
        stream_send(out, xs.get(i))
        i = i + 1
    }
    stream_close(out)
}

fn stream_from_list_int(xs: list[int]) -> Stream[int] uses Conc {
    let s: Stream[int] = stream_new(16)
    let _t: Task[void] = spawn(stream_from_list_int_worker, clone(xs), clone(s))
    return s
}
