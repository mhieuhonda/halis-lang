# ============================================================================
# std/test.hls — the Halis unit-testing assertions (Stage 18)
# ----------------------------------------------------------------------------
# Pure HLS, no `uses IO`. Provides the assertion primitives used by the
# `hltest` runner (tools/hltest.py). Tests are top-level functions whose
# name begins with `test_`; each test is invoked by the runner with a
# fresh process state, and any panic raised inside is treated as a
# failure. A test that returns normally (exit 0) is a PASS.
#
# HLS equality (==) is only defined for the primitive types int, float,
# bool, and str (the checker rejects == on lists, structs, and enums).
# This file therefore provides TYPED assertion helpers — `assert_eq_int`,
# `assert_eq_str`, etc. — so every comparison type-checks.
#
# On failure the assertion calls `panic(...)` with a clear message that
# hltest captures and reports. `panic` is the language's clean
# termination primitive; it does NOT require `uses IO`.
# ============================================================================


# --- int assertions ---------------------------------------------------------

fn assert_eq_int(got: int, expected: int) {
    if got != expected {
        panic("assert_eq_int failed: got=" + got.to_str() +
              " expected=" + expected.to_str())
    }
}

fn assert_eq_int_msg(got: int, expected: int, msg: str) {
    if got != expected {
        panic("assert_eq_int failed (" + msg + "): got=" + got.to_str() +
              " expected=" + expected.to_str())
    }
}

fn assert_ne_int(got: int, not_expected: int) {
    if got == not_expected {
        panic("assert_ne_int failed: got=" + got.to_str() +
              " (should not equal " + not_expected.to_str() + ")")
    }
}


# --- str assertions ---------------------------------------------------------

fn assert_eq_str(got: str, expected: str) {
    if got != expected {
        panic("assert_eq_str failed: got=\"" + got +
              "\" expected=\"" + expected + "\"")
    }
}

fn assert_eq_str_msg(got: str, expected: str, msg: str) {
    if got != expected {
        panic("assert_eq_str failed (" + msg + "): got=\"" + got +
              "\" expected=\"" + expected + "\"")
    }
}

fn assert_ne_str(got: str, not_expected: str) {
    if got == not_expected {
        panic("assert_ne_str failed: got=\"" + got +
              "\" (should not equal \"" + not_expected + "\")")
    }
}


# --- bool assertions --------------------------------------------------------

fn assert_eq_bool(got: bool, expected: bool) {
    if got != expected {
        panic("assert_eq_bool failed: got=" + got.to_str() +
              " expected=" + expected.to_str())
    }
}

fn assert_true(b: bool) {
    if !b {
        panic("assert_true failed: value is false")
    }
}

fn assert_true_msg(b: bool, msg: str) {
    if !b {
        panic("assert_true failed (" + msg + ")")
    }
}

fn assert_false(b: bool) {
    if b {
        panic("assert_false failed: value is true")
    }
}


# --- float assertions -------------------------------------------------------

# Float equality is exact. For approximate comparison (e.g. after
# arithmetic that may round), use assert_approx_eq_float with an
# explicit tolerance.
fn assert_eq_float(got: float, expected: float) {
    if got != expected {
        panic("assert_eq_float failed: got=" + got.to_str() +
              " expected=" + expected.to_str())
    }
}

# assert_approx_eq_float: panic if |got - expected| > eps. Use this for
# floating-point properties where bit-exact equality is too strict.
fn assert_approx_eq_float(got: float, expected: float, eps: float) {
    let mut diff: float = got - expected
    if diff < 0.0 {
        diff = -diff
    }
    if diff > eps {
        panic("assert_approx_eq_float failed: |got-expected|=" + diff.to_str() +
              " > eps=" + eps.to_str())
    }
}


# --- numeric / length -------------------------------------------------------

# assert_int_range: panic if `v` is outside the closed range [lo, hi].
# Useful for property-based tests where the output is only known to lie
# in a range (e.g. a hash function's bucket index).
fn assert_int_range(v: int, lo: int, hi: int) {
    if v < lo || v > hi {
        panic("assert_int_range failed: v=" + v.to_str() +
              " not in [" + lo.to_str() + ", " + hi.to_str() + "]")
    }
}

# assert_len_int: panic if `len(x) != expected`. Works on lists of int.
fn assert_len_int(x: list[int], expected: int) {
    let n: int = x.len()
    if n != expected {
        panic("assert_len_int failed: len=" + n.to_str() +
              " expected=" + expected.to_str())
    }
}

# assert_len_str: same, for str.
fn assert_len_str(x: str, expected: int) {
    let n: int = x.len()
    if n != expected {
        panic("assert_len_str failed: len=" + n.to_str() +
              " expected=" + expected.to_str())
    }
}


# --- test metadata ----------------------------------------------------------

# mark_skip: explicitly mark a test as skipped by panicking with the
# reserved prefix `__HLTEST_SKIP__: `. The hltest runner recognises this
# prefix and reports the test as SKIP rather than FAIL. (The function is
# named `mark_skip` rather than `test_skip` so hltest — which discovers
# any top-level `test_*` function — does not pick it up as a test
# itself; it is a helper FOR tests, not a test.)
fn mark_skip(reason: str) {
    panic("__HLTEST_SKIP__: " + reason)
}


# --- snapshot assertions (Stage 119, v0.138.0-alpha) -------------------------

# assert_snapshot: record a NAMED snapshot value for hltest to compare.
#
# The roadmap calls this `assert_snapshot!`; HLS has no macro syntax,
# so the plain function carries the semantics. The test renders a
# value ONCE, deterministically, and hands it to the runner through a
# reserved stdout protocol line:
#
#     __SNAP__ <name> <byte-len>\n<value bytes>
#
# The runner (tools/hltest.py) parses these records out of the test's
# captured stdout and compares each against the SNAPSHOT STORE
# (`__snapshots__/<file>.snap` next to the test file):
#   - verify mode (the default): a missing, changed, or obsolete
#     snapshot FAILS the test — the failure detail carries a unified
#     diff plus the `--update-snapshots` hint;
#   - `hltest -u` records new and changed snapshots and prunes
#     obsolete ones, so accepting an intentional change is one flag.
#
# The record is FRAMED: the value bytes are followed by exactly one
# `\n` separator, so records never glue onto whatever the test prints
# next, and the marker may not end up buried mid-line — the parser
# searches for the prefix anywhere outside consumed values, and a
# stray occurrence of `__SNAP__ ` in diagnostic output is a protocol
# error, never a silently-lost record.
#
# Building the assertion on println/print (rather than a new builtin)
# is the design: the protocol bytes are ordinary stdout, whose
# byte-parity between Stage-0 and the native binary is a standing
# invariant of the differential suite — so ONE store serves both
# backends, and a test file run as a program (its `main`) prints the
# same records hltest would parse. Three consequences the test author
# sees:
#   - the assertion carries `uses IO` — a value that leaves the
#     process through a snapshot is I/O by any honest accounting, so
#     the calling test declares it too;
#   - println is a TAINT SINK: a tainted value cannot be snapshotted
#     without an explicit sanitise / taint_unwrap decision — a
#     snapshot is exactly the kind of place untrusted data must not
#     flow into silently;
#   - the `__SNAP__ ` prefix is RESERVED (the same discipline as
#     `__HLTEST_SKIP__:`): a test that printlns a line starting with
#     it corrupts the protocol and fails with a protocol error.
#
# Names are validated runner-side: 1..96 bytes of [A-Za-z0-9_.:-] (no
# spaces, no newlines — either would break the length-prefixed
# framing). Values are raw bytes; the store never trims, re-encodes,
# or normalises anything.
fn assert_snapshot(name: str, value: str) uses IO {
    println("__SNAP__ " + name + " " + value.len().to_str())
    print(value + "\n")
}


# --- parameterised tests (Stage 120, v0.139.0-alpha) -------------------------

# TestCase[T]: one named row of a table-driven test. HLS has no
# attributes on functions and no closures, so the table lives in DATA:
# a parameterised test is a top-level `fn test_<name>(row: R)` that
# takes exactly one parameter, and its cases come from a companion
# `fn cases_<name>() -> list[TestCase[R]]` in the same file. The
# runner (tools/hltest.py) executes the table once per row, in a
# fresh process state each time, and reports every row as its own
# test named `test_<name>#<case-name>`.
#
# The wrapper is what makes the convention TYPE-SAFE end to end: the
# `name` field is checked as `str` (so a case label cannot silently
# be an int or a typo'd variable), the `row` field carries the case
# data with its real type R (a struct of inputs + expected outputs is
# the shape table tests are for), and the declared return type
# `list[TestCase[R]]` pins R to exactly the type the test function
# takes — a mismatch between the table and the test is a runner
# diagnostic naming both types, not a confusing failure deep inside
# one row.
#
# Case names are 1..96 bytes of [A-Za-z0-9_.:-] (the same charset as
# snapshot names): a row's report line `test_<name>#<case-name>` also
# becomes the test key of its snapshot-store records, and a name that
# could contain the framing bytes (spaces, newlines) would make the
# store header ambiguous. Keep tables pure and deterministic — the
# runner re-executes the table function once per row so every row
# runs in a pristine process state, exactly like any other test.
struct TestCase[T] {
    name: str,
    row: T
}
