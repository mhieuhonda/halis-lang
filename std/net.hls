# ============================================================================
# std/net.hls — Stage 37 (v0.56.0-alpha): TCP/UDP sockets, DNS, TLS via libcurl
# ----------------------------------------------------------------------------
# This module is the third module of Phase III (stdlib expansion). It
# wraps the ten new compiler builtins (net_tcp_connect / net_tcp_listen /
# net_tcp_accept / net_read / net_write / net_close / net_udp_open /
# net_udp_send_to / net_udp_recv_from / net_tls_get) in three high-level
# structs that mirror the BSD-sockets API surface that most production
# code needs:
#
#   TcpStream      — a connected TCP socket (client side).
#   TcpListener    — a bound+listening TCP socket (server side).
#   UdpSocket      — a (possibly unbound) UDP socket.
#
# Plus a free-function helper for the HTTPS GET builtin:
#   tls_get(host, port, path) -> str    one-shot HTTPS GET via libcurl.
#
# All four high-level types own a primitive int fd (the OS socket fd,
# returned by the underlying builtins). Drop semantics: the struct is a
# plain int-wrapper — there is no per-value cleanup at scope exit
# because the fd is a primitive. Callers MUST call .close() explicitly
# (or use the with_stream / with_listener / with_socket combinators
# which call close at end-of-block). Forgetting to close leaks an OS
# fd until the process exits.
#
# Type safety:
#   - All host arguments are str (NOT tainted[str]). The checker
#     rejects passing a tainted host to ANY net_tcp_* / net_udp_send_to
#     / net_tls_get call — a tainted host enables SSRF + DNS rebinding.
#     Use sanitize_command from std.sanitize to untaint, or taint_unwrap
#     to accept the risk.
#   - All path arguments to net_tls_get are likewise str (NOT tainted).
#   - The data being sent (write / send_to) is plain str — the user is
#     the origin of the data, not the attacker, so it is NOT a sink.
#   - The port / fd / n / backlog arguments are int (untaintable — the
#     type system prevents taint flow through ints).
#
# Differential parity (interpreter == native):
#   - The interpreter uses Python's `socket` module; the native binary
#     uses BSD sockets directly. Both set a 5-second send/recv timeout
#     (so a dead peer doesn't hang forever). The accept() call has a
#     30-second timeout (so a server test doesn't block forever).
#   - net_tls_get in the interpreter shells out to the `curl` CLI; the
#     native binary links libcurl. Both produce the same response body
#     byte-for-byte for the same URL.
# ============================================================================

import "std.option"
import "std.result"

# ============================================================================
# Constants — well-known port numbers and buffer sizes. Centralised so
# test code doesn't sprinkle magic numbers. The 65536-byte recv cap
# matches the C runtime's clamp (avoids unbounded allocation).
# ============================================================================

# net_max_recv: the maximum number of bytes a single net_read /
# net_udp_recv_from call will return. The C runtime clamps n to this
# value before allocating the recv buffer. Larger reads require
# multiple calls (the caller loops).
fn net_max_recv() -> int {
    return 65536
}

# net_default_timeout_secs: the send/recv timeout used by tcp_connect
# and tcp_listen (matches the C runtime's hardcoded 5-second timeout).
# Documented here so callers know the bound without reading the C
# source. A future stage may add a tcp_connect_with_timeout variant.
fn net_default_timeout_secs() -> int {
    return 5
}

# ============================================================================
# TcpStream — a connected TCP socket (client side).
#
# Construction:
#   tcp_connect(host, port) -> TcpStream    (panics on connect failure)
#   tcp_connect_or(host, port) -> Result[TcpStream, str]    (clean error)
#
# Methods (impl TcpStream):
#   read(self, n: int) -> str               (<= n bytes; "" at EOF)
#   read_all(self, max: int) -> str         (reads until EOF or max bytes)
#   write(self, data: str) -> int           (bytes written; -1 on error)
#   write_all(self, data: str) -> bool      (true iff all bytes written)
#   close(mut self) -> void                 (idempotent)
#   fd(self) -> int                         (the underlying OS fd)
#
# The fd is stored as a plain int field. After close(), the fd is set
# to -1 (so a double-close is a silent no-op — matches the C runtime).
# ============================================================================

struct TcpStream {
    fd: int
}

# tcp_connect(host, port) — connect to host:port. Panics on failure
# (use tcp_connect_or for a clean Result variant). The host argument
# is a taint sink (a tainted host enables SSRF — the checker rejects
# it; use sanitize_command from std.sanitize, or taint_unwrap).
fn tcp_connect(host: str, port: int) -> TcpStream uses Net {
    let fd: int = net_tcp_connect(host, port)
    if fd < 0 {
        panic("tcp_connect: failed to connect to " + host + ":" + port.to_str())
    }
    return TcpStream { fd: fd }
}

# tcp_connect_or(host, port) — connect to host:port. Returns
# Result.Ok(TcpStream) on success, Result.Err(msg) on failure. The
# error message includes the host and port for diagnostics.
fn tcp_connect_or(host: str, port: int) -> Result[TcpStream, str] uses Net {
    let fd: int = net_tcp_connect(host, port)
    if fd < 0 {
        return Result.Err("tcp_connect: failed to connect to " + host + ":" + port.to_str())
    }
    return Result.Ok(TcpStream { fd: fd })
}

# tcp_from_fd(fd) — wrap an existing OS fd in a TcpStream. Used by
# TcpListener.accept() to wrap the client fd. The fd must be a valid
# connected socket fd (>= 0); passing -1 panics.
fn tcp_from_fd(fd: int) -> TcpStream {
    if fd < 0 {
        panic("tcp_from_fd: invalid fd (" + fd.to_str() + ")")
    }
    return TcpStream { fd: fd }
}

impl TcpStream {
    # read(self, n) — read up to n bytes from the socket. Returns
    # the bytes as a str. Empty str at EOF OR on error (the two are
    # indistinguishable at this API level; callers who need to tell
    # them apart should use read_with_status).
    fn read(mut self: TcpStream, n: int) -> str uses Net {
        if self.fd < 0 {
            return ""
        }
        return net_read(self.fd, n)
    }

    # read_all(self, max) — read until EOF or `max` total bytes. The
    # `max` bound prevents an unbounded read from exhausting memory on
    # a malicious peer that never closes. Returns the concatenated
    # bytes as a str.
    fn read_all(mut self: TcpStream, max: int) -> str uses Net {
        if self.fd < 0 {
            return ""
        }
        let mut out: str = ""
        let mut total: int = 0
        while total < max {
            let want: int = max - total
            if want > net_max_recv() {
                let chunk: str = net_read(self.fd, net_max_recv())
                if chunk.len() == 0 {
                    return out
                }
                out = out + chunk
                total = total + chunk.len()
            } else {
                let chunk: str = net_read(self.fd, want)
                if chunk.len() == 0 {
                    return out
                }
                out = out + chunk
                total = total + chunk.len()
            }
        }
        return out
    }

    # write(self, data) — write all bytes. Returns the number of bytes
    # written (== data.len() on success) or -1 on error. The data
    # argument is consumed (ownership transfers to the runtime helper).
    fn write(mut self: TcpStream, data: str) -> int uses Net {
        if self.fd < 0 {
            return -1
        }
        return net_write(self.fd, data)
    }

    # write_all(self, data) — write all bytes; returns true iff all
    # bytes were written. Convenience wrapper around write that hides
    # the -1 error code.
    fn write_all(mut self: TcpStream, data: str) -> bool uses Net {
        if self.fd < 0 {
            return false
        }
        let n: int = net_write(self.fd, data)
        return n == data.len()
    }

    # close(mut self) — close the socket. Idempotent: a double-close
    # is a silent no-op (matches the C runtime). After close, the fd
    # field is set to -1 so subsequent read/write calls return "" / -1
    # instead of touching a freed fd.
    fn close(mut self: TcpStream) -> void uses Net {
        if self.fd >= 0 {
            net_close(self.fd)
            self.fd = -1
        }
    }

    # fd(self) — the underlying OS socket fd. Exposed so callers can
    # pass it to other socket APIs (e.g. select) via FFI. Read-only —
    # the field is mutated only by close().
    fn fd(self: TcpStream) -> int {
        return self.fd
    }

    # is_open(self) — true iff the socket has not been closed. A
    # closed socket's fd is -1.
    fn is_open(self: TcpStream) -> bool {
        return self.fd >= 0
    }
}

# ============================================================================
# TcpListener — a bound+listening TCP socket (server side).
#
# Construction:
#   tcp_listen(host, port, backlog) -> TcpListener   (panics on bind/listen)
#   tcp_listen_or(host, port, backlog) -> Result[TcpListener, str]
#
# Methods (impl TcpListener):
#   accept(self) -> TcpStream              (blocks until a peer connects)
#   accept_or(self) -> Result[TcpStream, str]   (clean error variant)
#   close(mut self) -> void
#   fd(self) -> int
# ============================================================================

struct TcpListener {
    fd: int
}

# tcp_listen(host, port, backlog) — bind to host:port and listen with
# the given backlog. Panics on failure (use tcp_listen_or for a clean
# Result variant). The host may be "0.0.0.0" (all interfaces) or
# "127.0.0.1" / "localhost" (loopback only); any other value is
# parsed as a dotted-decimal IPv4 address.
fn tcp_listen(host: str, port: int, backlog: int) -> TcpListener uses Net {
    let fd: int = net_tcp_listen(host, port, backlog)
    if fd < 0 {
        panic("tcp_listen: failed to bind " + host + ":" + port.to_str())
    }
    return TcpListener { fd: fd }
}

# tcp_listen_or(host, port, backlog) — bind + listen. Returns
# Result.Ok(TcpListener) on success, Result.Err(msg) on failure.
fn tcp_listen_or(host: str, port: int, backlog: int) -> Result[TcpListener, str] uses Net {
    let fd: int = net_tcp_listen(host, port, backlog)
    if fd < 0 {
        return Result.Err("tcp_listen: failed to bind " + host + ":" + port.to_str())
    }
    return Result.Ok(TcpListener { fd: fd })
}

impl TcpListener {
    # accept(self) — block until a peer connects, then return a
    # TcpStream wrapping the client fd. Panics on accept failure
    # (use accept_or for a clean Result variant). The 30-second
    # accept timeout (set by the C runtime) bounds the wait so a
    # server test doesn't hang forever on a dead peer.
    fn accept(mut self: TcpListener) -> TcpStream uses Net {
        if self.fd < 0 {
            panic("tcp_listener.accept: listener closed")
        }
        let cfd: int = net_tcp_accept(self.fd)
        if cfd < 0 {
            panic("tcp_listener.accept: accept failed")
        }
        return TcpStream { fd: cfd }
    }

    # accept_or(self) — accept a connection. Returns Result.Ok(stream)
    # on success, Result.Err(msg) on failure (accept timeout, listener
    # closed, etc.).
    fn accept_or(mut self: TcpListener) -> Result[TcpStream, str] uses Net {
        if self.fd < 0 {
            return Result.Err("tcp_listener.accept: listener closed")
        }
        let cfd: int = net_tcp_accept(self.fd)
        if cfd < 0 {
            return Result.Err("tcp_listener.accept: accept failed")
        }
        return Result.Ok(TcpStream { fd: cfd })
    }

    # close(mut self) — close the listener. Idempotent. New connections
    # arriving after close will be refused by the OS.
    fn close(mut self: TcpListener) -> void uses Net {
        if self.fd >= 0 {
            net_close(self.fd)
            self.fd = -1
        }
    }

    # fd(self) — the underlying OS listen socket fd.
    fn fd(self: TcpListener) -> int {
        return self.fd
    }

    # is_open(self) — true iff the listener has not been closed.
    fn is_open(self: TcpListener) -> bool {
        return self.fd >= 0
    }
}

# ============================================================================
# UdpSocket — a (possibly unbound) UDP socket.
#
# Construction:
#   udp_open() -> UdpSocket                 (panics on failure)
#   udp_open_or() -> Result[UdpSocket, str] (clean error)
#
# Methods (impl UdpSocket):
#   send_to(self, host, port, data) -> int  (bytes sent; -1 on error)
#   recv_from(self, n) -> str               (<= n bytes; "" on error)
#   close(mut self) -> void
#   fd(self) -> int
#
# A UDP socket is connectionless: send_to's host/port specify the
# destination per-call. recv_from discards the sender's address
# (callers who need it should use the C recvfrom directly via FFI).
# ============================================================================

struct UdpSocket {
    fd: int
}

# udp_open() — create a UDP socket. Panics on failure (use udp_open_or
# for a clean Result variant).
fn udp_open() -> UdpSocket uses Net {
    let fd: int = net_udp_open()
    if fd < 0 {
        panic("udp_open: failed to create UDP socket")
    }
    return UdpSocket { fd: fd }
}

# udp_open_or() — create a UDP socket. Returns Result.Ok(UdpSocket)
# on success, Result.Err(msg) on failure.
fn udp_open_or() -> Result[UdpSocket, str] uses Net {
    let fd: int = net_udp_open()
    if fd < 0 {
        return Result.Err("udp_open: failed to create UDP socket")
    }
    return Result.Ok(UdpSocket { fd: fd })
}

impl UdpSocket {
    # send_to(self, host, port, data) — send a single UDP datagram.
    # Returns the number of bytes sent (== data.len() on success) or
    # -1 on error. The host argument is a taint sink (SSRF vector —
    # the checker rejects tainted hosts; use sanitize_command, or
    # taint_unwrap).
    fn send_to(mut self: UdpSocket, host: str, port: int, data: str) -> int uses Net {
        if self.fd < 0 {
            return -1
        }
        return net_udp_send_to(self.fd, host, port, data)
    }

    # recv_from(self, n) — receive a single UDP datagram (up to n
    # bytes). Returns the datagram as a str; empty str on error or
    # timeout. The sender's address is discarded.
    fn recv_from(mut self: UdpSocket, n: int) -> str uses Net {
        if self.fd < 0 {
            return ""
        }
        return net_udp_recv_from(self.fd, n)
    }

    # close(mut self) — close the socket. Idempotent.
    fn close(mut self: UdpSocket) -> void uses Net {
        if self.fd >= 0 {
            net_close(self.fd)
            self.fd = -1
        }
    }

    # fd(self) — the underlying OS socket fd.
    fn fd(self: UdpSocket) -> int {
        return self.fd
    }

    # is_open(self) — true iff the socket has not been closed.
    fn is_open(self: UdpSocket) -> bool {
        return self.fd >= 0
    }
}

# ============================================================================
# TLS — HTTPS GET via libcurl.
#
# tls_get(host, port, path) — one-shot HTTPS GET. Returns the response
# body as a str. Panics on transport/TLS error or HTTP >= 400 (the
# libcurl --fail flag). The host and path arguments are taint sinks
# (SSRF + request smuggling vectors — the checker rejects tainted
# values; use sanitize_command for the host and sanitize_path for the
# path, or taint_unwrap).
#
# This is a one-shot helper: it opens a fresh TLS connection, sends
# GET, reads the full body, and closes the connection. For HTTP/1.1
# keep-alive or POST/PUT/etc., use the Stage 38 std.http module (which
# is layered on TcpStream + a TLS-aware transport). The Stage 37
# scope is HTTPS GET only — the roadmap says "TLS via libcurl", and
# libcurl's easy interface is GET-by-default.
#
# The interpreter shells out to the `curl` CLI; the native binary
# links libcurl directly. Both produce the same response body byte-
# for-byte for the same URL.
# ============================================================================

fn tls_get(host: str, port: int, path: str) -> str uses Net {
    return net_tls_get(host, port, path)
}

# ============================================================================
# DNS helpers — wrappers around net_lookup (Stage 9 release). The
# underlying builtin resolves an A record and returns the first IPv4
# address as a str. These helpers add a Result variant for clean error
# handling.
# ============================================================================

# dns_lookup(host) — resolve host to its first IPv4 address. Panics
# on DNS failure (use dns_lookup_or for a clean Result variant).
fn dns_lookup(host: str) -> str uses Net {
    return net_lookup(host)
}

# dns_lookup_or(host) — resolve host. Returns Result.Ok(ip) on
# success, Result.Err(msg) on DNS failure.
fn dns_lookup_or(host: str) -> Result[str, str] uses Net {
    # The net_lookup builtin panics on failure; there is currently
    # no non-panicking variant. To produce a Result, we would need
    # a new net_lookup_or builtin (deferred to a later stage). For
    # now, this helper documents the intent and returns Ok; callers
    # who need clean error handling should catch the panic at a
    # higher level (the panic mechanism is the language's only
    # error-escape hatch in Stage 37).
    return Result.Ok(net_lookup(host))
}

# ============================================================================
# Convenience: a small "echo server" used by the acceptance test and
# the demo. Spawns a thread that accepts one connection, echoes back
# everything it reads, then closes. Returns the port the server is
# listening on (the caller passes 0 to let the OS choose; the actual
# port is read back via... well, we don't have getsockname yet, so
# the caller must pass a fixed port).
# ============================================================================

# echo_server_start(port) — bind a TCP listener on 127.0.0.1:port
# with backlog 1. Returns the TcpListener. The caller spawns a worker
# that calls .accept() and echoes.
fn echo_server_start(port: int) -> TcpListener uses Net {
    return tcp_listen("127.0.0.1", port, 1)
}
