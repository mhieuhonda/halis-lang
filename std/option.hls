# ============================================================================
# std/option.hls — the Option[T] type (Stage 7)
# ----------------------------------------------------------------------------
# Pure HLS, no `uses IO`. Can be used in any context — including inside the
# compiler `hlc` itself.
#
# `Option[T]` represents "a value of type T, or absence". Use it instead of
# sentinel values (-1, NULL, empty string, ...) for optional data.
# ============================================================================

enum Option[T] {
    Some(T),
    None
}

# Returns the value if Some; panics if None. Use this only when you have
# already verified (e.g. via `option_is_some`) that the value is present.
# For a safe alternative, use `option_unwrap_or`.
fn option_unwrap[T](o: Option[T]) -> T {
    return match o {
        Option.Some(v) => v,
        Option.None => panic("option_unwrap on None")
    }
}

# Returns the value if Some, or `default` if None.
fn option_unwrap_or[T](o: Option[T], default: T) -> T {
    return match o {
        Option.Some(v) => v,
        Option.None => default
    }
}

# Returns true if the option is Some.
fn option_is_some[T](o: Option[T]) -> bool {
    return match o {
        Option.Some(_) => true,
        Option.None => false
    }
}

# Returns true if the option is None.
fn option_is_none[T](o: Option[T]) -> bool {
    return match o {
        Option.Some(_) => false,
        Option.None => true
    }
}
