# ============================================================================
# std/regex.hls — Stage 41 (v0.60.0-alpha): NFA-based regular expressions
# ----------------------------------------------------------------------------
# This module is the eighth module of Phase III (stdlib expansion). It
# implements an NFA-based regular expression engine using Thompson's
# construction (Ken Thompson, CACM 1968). The implementation is
# **non-backtracking** — the NFA is simulated in lockstep using a
# bitmap of active states, which guarantees O(n*m) worst-case time
# (n = text length, m = pattern size). There is **no ReDoS** — the
# pathological "a^n b" patterns that take exponential time on
# backtracking engines (PCRE, RE2, Python re, JavaScript RegExp)
# terminate in linear time here.
#
# **No new compiler builtins** — the entire module is pure HLS,
# layered on `std.str` for byte/string access and `std.list` for
# working with state lists. The byte-level orientation matches
# Rust's `regex` crate (the dominant linear-time engine): UTF-8
# bytes are matched directly; Unicode categories are deferred to a
# future stage.
#
# Supported syntax (POSIX-EGREP + PCRE subset):
#
#   .         any byte (no DOTALL: \n is never matched by .)
#   *         0 or more (greedy)
#   +         1 or more (greedy)
#   ?         0 or 1 (greedy)
#   {n}       exactly n
#   {n,}      n or more
#   {n,m}     n to m
#   {,m}      0 to m (shorthand for {0,m})
#   |         alternation
#   ()        capture group (numbered from 1)
#   (?:)      non-capture group
#   [...]     character class (ranges, negation with ^)
#   [^...]    negated character class
#   \d \D     digit / non-digit
#   \w \W     word / non-word ([A-Za-z0-9_])
#   \s \S     whitespace / non-whitespace
#   \b \B     word boundary / non-word-boundary (zero-width)
#   ^         start-of-text anchor (zero-width)
#   $         end-of-text anchor (zero-width)
#   \n \t \r \f \v \a \0  escapes
#   \xNN      hex byte (exactly 2 hex digits)
#   \x{NNNN}  hex codepoint (1+ hex digits, emits UTF-8 bytes)
#   \\.       literal escape (e.g. \. = literal ., \\ = literal \)
#   *? +? ??  lazy quantifiers — ACCEPTED SYNTAX ONLY: the '?' is
#              consumed but the constructed NFA is the GREEDY one
#              (leftmost-longest matching; deep-scan-20 note: a
#              shortest-match simulation would be needed for true lazy
#              semantics — a*?b on "aab" matches "aab", not "ab")
#
# Not yet supported (deferred):
#   - Lookahead (?=...) / (?!...) — deferred to Stage 64.
#   - Lookbehind (?<=...) / (?<!...) — deferred to Stage 64.
#   - Named groups (?P<name>...) — Stage 42+ will reuse the trait
#     machinery; for now use numbered groups.
#   - Unicode categories (\p{L}, \p{N}, ...) — Stage 50+ (std.unicode).
#   - Backreferences (\1, \2) — fundamentally backtracking; a future
#     "stage 41+ perfection" may add a limited form.
#
# API summary:
#
#   let re: Regex = regex_compile("a(b+)c").unwrap()
#   regex_is_match(re, "abbc")             # true
#   regex_find(re, "xx abbc yy")            # Option.Some(RegexMatch{...})
#   regex_find_all(re, "abbc abbbbc", 100)  # [Match1, Match2]
#   regex_groups(re, "abbc")                # Option.Some(["abbc", "bb"])
#   regex_replace(re, "abbc", "AC")          # "AC"
#   regex_replace_all(re, "abbc abbbbc", "X")  # "X X"
#   regex_split(re.compile(","), "a,b,c", 0)   # ["a", "b", "c"]
#
# Differential parity (interpreter == native):
#
#   The engine is a pure state machine over `str` bytes. The output
#   is byte-identical between the interpreter and the native binary
#   (no I/O, no randomness, no float arithmetic). The acceptance
#   test exercises the parser (compile errors), the NFA simulation
#   (is_match / find / find_all), capture groups, character
#   classes, anchors, word boundaries, escapes, alternation, and
#   the replace/split helpers.
#
# Security:
#
#   * **Linear-time guarantee**: the engine is O(n*m) where n = text
#     length and m = pattern size. There is NO pathological input
#     that triggers exponential behaviour — a peer that sends a
#     crafted pattern + text cannot DoS the regex matcher (the
#     "ReDoS" attack that has been a CVE in JavaScript engines,
#     node.js, and Python's re module). See Russ Cox's "Regular
#     Expression Matching Can Be Simple And Fast" (2007) for the
#     background.
#   * **Compile-time validation**: a malformed regex returns
#     `Result.Err(msg)` from `regex_compile`. The error message
#     names the byte position and the kind of error (unbalanced
#     `(`, bad repetition, bad escape, bad class). This matches
#     Rust's `regex::Regex::new` semantics. (A future stage may
#     lift this to a true compile error once the language has
#     compile-time string parsing.)
#   * **Pattern size limit**: a pattern longer than
#     `REGEX_MAX_PATTERN` (default 64 KiB) is rejected. This is
#     an NFA-state-count bound — Thompson construction produces
#     at most one NFA state per pattern byte, and the bitmap
#     simulation needs `m` bits of state, so 64 KiB is generous.
#   * **Text size**: there is no explicit limit on text size; the
#     simulation allocates O(m) state and reads the text lazily.
#     A text larger than 4 GiB (the int32 range) cannot be
#     addressed by HLS `str.slice` anyway — the language's int is
#     64-bit, but the `byte_at` builtin operates on offsets that
#     are stored in HLS-level `int` and the runtime's address
#     arithmetic wraps at the C level.
# ============================================================================

import "std.result"
import "std.str"
import "std.option"
import "std.list"

import "regex/regex_state.hls"
import "regex/regex_parse.hls"
import "regex/regex_class.hls"
import "regex/regex_exec.hls"
