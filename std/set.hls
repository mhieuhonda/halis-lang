# ============================================================================
# std.set.hls — Set helpers for Halis (Stage 14+ non-roadmap upgrade)
# ----------------------------------------------------------------------------
# HLS's only map type is `map[str, T]`, so a set of strings is naturally
# represented as `map[str, bool]` (the value's truth doesn't matter —
# only key presence). This module wraps that idiom with a clear API
# and adds the common set operations: union, intersect, difference
# (via "is in a but not in b"), from-list, to-list, contains.
#
# (Set operations on non-string element types are deferred until HLS
# gets either non-string map keys or a true Set[T] built-in — both
# are out of scope for this module. Users can use std.list's
# list_contains_* helpers as a stand-in for non-string sets.)
#
# All functions are pure (no `uses IO`).
#
# Helpers provided:
#   set_str_new()               empty set
#   set_str_from_list(xs)       set from a list[str]
#   set_str_add(s, x)           add x to s (mutates s, returns void)
#   set_str_contains(s, x)      is x in s?
#   set_str_size(s)             number of elements in s
#   set_str_to_list(s)          list of elements (insertion-ordered)
#   set_str_union(a, b)         a ∪ b
#   set_str_intersect(a, b)     a ∩ b
#   set_str_diff(a, b)          a \ b
#   set_str_equal(a, b)         deep equality
# ============================================================================

# A "set of strings" is `map[str, bool]`. The bool value is always
# `true`; only key presence matters. (We use `true` rather than
# `false` so that naive code that reads the value out of the map
# sees "yes, this key is in the set".)

fn set_str_new() -> map[str, bool] {
    return map_new()
}

fn set_str_from_list(xs: list[str]) -> map[str, bool] {
    let s: map[str, bool] = map_new()
    let mut i: int = 0
    while i < xs.len() {
        s.set(xs.get(i), true)
        i = i + 1
    }
    return s
}

fn set_str_add(s: map[str, bool], x: str) -> void {
    s.set(x, true)
}

fn set_str_contains(s: map[str, bool], x: str) -> bool {
    return s.has(x)
}

fn set_str_size(s: map[str, bool]) -> int {
    return s.len()
}

fn set_str_to_list(s: map[str, bool]) -> list[str] {
    return s.keys()
}

fn set_str_union(a: map[str, bool], b: map[str, bool]) -> map[str, bool] {
    let out: map[str, bool] = map_new()
    let ka: list[str] = a.keys()
    let mut i: int = 0
    while i < ka.len() {
        out.set(ka.get(i), true)
        i = i + 1
    }
    let kb: list[str] = b.keys()
    let mut j: int = 0
    while j < kb.len() {
        out.set(kb.get(j), true)
        j = j + 1
    }
    return out
}

fn set_str_intersect(a: map[str, bool], b: map[str, bool]) -> map[str, bool] {
    let out: map[str, bool] = map_new()
    let ka: list[str] = a.keys()
    let mut i: int = 0
    while i < ka.len() {
        let k: str = ka.get(i)
        if b.has(k) {
            out.set(k, true)
        }
        i = i + 1
    }
    return out
}

fn set_str_diff(a: map[str, bool], b: map[str, bool]) -> map[str, bool] {
    # Set difference: elements in a that are NOT in b.
    let out: map[str, bool] = map_new()
    let ka: list[str] = a.keys()
    let mut i: int = 0
    while i < ka.len() {
        let k: str = ka.get(i)
        if !b.has(k) {
            out.set(k, true)
        }
        i = i + 1
    }
    return out
}

fn set_str_equal(a: map[str, bool], b: map[str, bool]) -> bool {
    # Two sets are equal iff they have the same size AND every key of
    # one is in the other. (Same size + subset == equal.)
    if a.len() != b.len() {
        return false
    }
    let ka: list[str] = a.keys()
    let mut i: int = 0
    while i < ka.len() {
        if !b.has(ka.get(i)) {
            return false
        }
        i = i + 1
    }
    return true
}
