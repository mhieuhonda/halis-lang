# ============================================================================
# std/str.hls — Extended string operations for Halis
# ----------------------------------------------------------------------------
# Pure-HLS extension layer on top of the builtin str methods. All functions
# are pure (no `uses IO`) unless noted, so they can be used in any context.
# ============================================================================

# repeat(s, n) returns s concatenated n times. n < 0 is treated as 0.
#
# Stage 32 (v0.51.0-alpha): O(n) implementation. The previous
# `out = out + s` accumulating concat was quadratic — n copies of the
# prefix were re-allocated on every iteration. The new implementation
# builds a list of n copies and joins them in a single allocation
# (str_join delegates to the O(n) `hl_str_join` runtime helper).
fn str_repeat(s: str, n: int) -> str {
    if n <= 0 {
        return ""
    }
    if s.len() == 0 {
        return ""
    }
    let parts: list[str] = []
    let mut i: int = 0
    while i < n {
        parts.push(s)
        i = i + 1
    }
    return str_join(parts, "")
}

# reverse(s) returns s with its bytes in reverse order.
fn str_reverse(s: str) -> str {
    let n: int = s.len()
    let chars: list[str] = []
    let mut i: int = n - 1
    while i >= 0 {
        chars.push(s.slice(i, i + 1))
        i = i - 1
    }
    return str_join(chars, "")
}

# join a list of strings with a separator.
fn str_join(parts: list[str], sep: str) -> str {
    # v0.35.0-alpha (Stage 19): delegates to the O(n) `join` builtin
    # (single allocation, one copy per element). The previous
    # accumulating-concat implementation was quadratic and dominated
    # run time for large outputs.
    return join(parts, sep)
}

# replace(haystack, needle, replacement) replaces ALL occurrences of needle.
# Empty needle returns the original string unchanged.
fn str_replace(s: str, old: str, new: str) -> str {
    if old.len() == 0 {
        return s
    }
    let parts: list[str] = s.split(old)
    return str_join(parts, new)
}

# to_lower_ascii(s) lowercases ASCII A-Z; other bytes unchanged.
fn str_to_lower_ascii(s: str) -> str {
    let n: int = s.len()
    let mut i: int = 0
    let chars: list[str] = []
    while i < n {
        let b: int = s.byte_at(i)
        if b >= 65 && b <= 90 {
            chars.push(chr(b + 32))
        } else {
            chars.push(s.slice(i, i + 1))
        }
        i = i + 1
    }
    return str_join(chars, "")
}

# to_upper_ascii(s) uppercases ASCII a-z; other bytes unchanged.
fn str_to_upper_ascii(s: str) -> str {
    let n: int = s.len()
    let mut i: int = 0
    let chars: list[str] = []
    while i < n {
        let b: int = s.byte_at(i)
        if b >= 97 && b <= 122 {
            chars.push(chr(b - 32))
        } else {
            chars.push(s.slice(i, i + 1))
        }
        i = i + 1
    }
    return str_join(chars, "")
}

# count(haystack, needle) returns the number of non-overlapping occurrences.
# Empty needle returns 0.
fn str_count(s: str, sub: str) -> int {
    if sub.len() == 0 {
        return 0
    }
    let mut count: int = 0
    let mut i: int = 0
    let n: int = s.len()
    let m: int = sub.len()
    while i + m <= n {
        if s.slice(i, i + m) == sub {
            count = count + 1
            i = i + m
        } else {
            i = i + 1
        }
    }
    return count
}

# starts_with_prefix(s, prefix) — same as the builtin method but provided
# here as a function for first-class use.
fn str_starts_with(s: str, prefix: str) -> bool {
    return s.starts_with(prefix)
}

fn str_ends_with(s: str, suffix: str) -> bool {
    return s.ends_with(suffix)
}

fn str_contains(s: str, sub: str) -> bool {
    return s.contains(sub)
}

# index_of(s, sub) returns the first byte index of sub in s, or -1 if absent.
fn str_index_of(s: str, sub: str) -> int {
    return s.find(sub)
}

# pad_left(s, width, pad) pads s on the left with pad until it reaches width.
# If pad is empty, returns s unchanged. Deep-scan fix (M5): if pad.len() > 1
# and would overshoot width, the result is filled with a single-byte
# prefix of pad so the final length is exactly `width` (was: overshot
# to e.g. "xyzxyzab" for str_pad_left("ab", 6, "xyz")).
#
# Stage 32 (v0.51.0-alpha): claimed O(n) but the main loop was still
# quadratic (`out = pad + out` copies the entire accumulated string
# on every iteration). Deep-scan-19 (v0.51.1-alpha): now genuinely
# O(n) — compute the exact pad count, build the prefix via a single
# str_repeat (which is O(n) via list+join), and concat once.
# Behaviour-preserving: the remainder (single-byte prefix) goes FIRST
# (leftmost), matching the deep-scan-5 fix's order. So
# str_pad_left("ab", 6, "xyz") = "x" + "xyz" + "ab" = "xxyzab".
fn str_pad_left(s: str, width: int, pad: str) -> str {
    if pad.len() == 0 {
        return s
    }
    if s.len() >= width {
        return s
    }
    let gap: int = width - s.len()
    let full_pads: int = gap / pad.len()
    let remainder: int = gap % pad.len()
    # Remainder first (leftmost), then full pads, then s — matches the
    # deep-scan-5 ordering so existing tests don't break.
    let prefix: str = str_repeat(pad.slice(0, 1), remainder) + str_repeat(pad, full_pads)
    return prefix + s
}

# pad_right(s, width, pad) pads s on the right with pad until it reaches width.
# Same overshoot-fix semantics as str_pad_left.
#
# Stage 32 (v0.51.0-alpha): claimed O(n) but the main loop was still
# quadratic. Deep-scan-19 (v0.51.1-alpha): now genuinely O(n) — same
# approach as str_pad_left.
fn str_pad_right(s: str, width: int, pad: str) -> str {
    if pad.len() == 0 {
        return s
    }
    if s.len() >= width {
        return s
    }
    let gap: int = width - s.len()
    let full_pads: int = gap / pad.len()
    let remainder: int = gap % pad.len()
    # Full pads first, then remainder (rightmost) — matches the old
    # behaviour: `out = out + pad` (full pads) then `out = out + suffix`.
    let suffix: str = str_repeat(pad, full_pads) + str_repeat(pad.slice(0, 1), remainder)
    return s + suffix
}

# Helper for parsing hex digits; returns -1 if not a hex digit.
fn str_hex_digit(b: int) -> int {
    if b >= 48 && b <= 57 {
        return b - 48
    }
    if b >= 65 && b <= 70 {
        return b - 55
    }
    if b >= 97 && b <= 102 {
        return b - 87
    }
    return -1
}

# is_space_byte(b) returns true for ASCII whitespace.
fn str_is_space(b: int) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13
}
