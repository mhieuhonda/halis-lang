# ============================================================================
# std/env.hls — Stage 48 (v0.67.0-alpha): environment + cwd wrappers
# ----------------------------------------------------------------------------
# This module is the fifteenth module of Phase III (stdlib expansion).
# It provides the user-facing API for environment-variable and
# current-working-directory access, layered on seven new compiler
# builtins:
#
#   * env_get(key) -> str — low-level env var lookup (returns "" if
#                 not found; loses the empty-string-vs-missing
#                 distinction; use env_has to distinguish).
#   * env_has(key) -> bool — low-level existence check.
#   * env_set(key, value) -> void — low-level set.
#   * env_unset(key) -> void — low-level unset.
#   * cwd_get() -> str — low-level cwd read.
#   * cwd_set(path) -> int — low-level cwd write (0 / -1).
#   * args_os() -> list[str] — low-level argv.
#
# The builtins carry the Proc effect (env / cwd access is process-
# state access). The KEY arguments of env_get / env_has / env_set /
# env_unset are taint sinks (info disclosure / env injection); the
# PATH argument of cwd_set is a taint sink (directory traversal).
#
# This module (std/env.hls) provides the user-facing API names from
# the roadmap, applying the taint wrappers:
#
#   * env_var(key) -> Option[tainted[str]]
#       Returns Option.Some(tainted[str]) if the env var exists,
#       Option.None if not. The value is tainted by default (env
#       vars are untrusted — they come from the parent process /
#       launch context, not the program). The user must taint_unwrap
#       or sanitise before using the value as a command, path, etc.
#
#   * env_set_var(key, value) -> void
#       Thin wrapper over the env_set builtin.
#
#   * env_unset_var(key) -> void
#       Thin wrapper over the env_unset builtin.
#
#   * env_current_dir() -> tainted[str]
#       Returns the cwd as a tainted[str] (the cwd may be sensitive —
#       e.g., the user cd'd to /etc/something; or the cwd is read on
#       behalf of a network client who shouldn't learn it). The user
#       must taint_unwrap or sanitise before using it as a path or
#       printing it.
#
#   * env_set_current_dir(path) -> int
#       Thin wrapper over the cwd_set builtin. Returns 0 on success,
#       -1 on error.
#
#   * env_args_os() -> list[tainted[str]]
#       Returns the program's argv as a list of tainted[str] (the
#       os-string version of tainted_args; in Halis str = bytes
#       already, so this is currently an alias for the conceptual
#       "raw OS bytes" version). Each element is tainted by default
#       (argv comes from the launch context, not the program).
#
# Type-level taint enforcement:
#   All "set" wrappers (env_set_var, env_unset_var, env_set_current_dir)
#   take plain `str` arguments (NOT `tainted[str]`). Passing a tainted
#   value to one of these is a compile error (the underlying builtin
#   is a taint sink — the checker rejects the call). This is the
#   type-level enforcement the roadmap promised: environment / cwd
#   mutations require explicit untainting.
#
#   All "read" wrappers (env_var, env_current_dir, env_args_os) return
#   tainted values by default. The user must explicitly untaint (via
#   `taint_unwrap` or a sanitiser from std.sanitize) before using the
#   value as a sink (command, path, file content, ...). This matches
#   the convention from Stage 10-alpha (tainted_args, read_file_tainted,
#   read_line) — input from outside the program is untrusted by
#   default.
#
# Differential parity (interpreter == native):
#   All builtins are implemented identically in the interpreter
#   (Python's os.environ / os.getcwd / os.chdir) and the C runtime
#   (getenv / setenv / unsetenv / getcwd / chdir). The HLS stdlib
#   wrappers are pure HLS (no new builtins), so they're identical
#   in both backends.
#
# Limitations (deferred to later stages):
#   * No env_var_count / env_var_iterate — iterating the entire
#     environment is deferred to a later stage (a future std.env
#     extension may add env_iter() -> list[str]).
#   * No env_clear — clearing the entire environment is dangerous
#     and rarely needed; deferred.
#   * No cwd_set with error reporting — cwd_set returns 0/-1; the
#     actual error (errno) is not exposed. A future stage may add
#     a Result[T, str] version.
#   * No thread-safety for env_set / env_unset — the C setenv /
#     unsetenv are NOT thread-safe (POSIX says they're not). The
#     stdlib wrappers do not lock; if you mutate env from multiple
#     threads, you may see corruption. The single-threaded case is
#     safe. A future stage may add a mutex-guarded variant.
#   * Windows — the runtime uses POSIX env functions; on Windows,
#     _putenv / _wgetenv are needed. The interpreter (Python) is
#     portable; the native path is POSIX-only for Stage 48 (matching
#     proc_exec and Stage 47's POSIX-centrism).
# ============================================================================

import "std.option"
import "std.taint"

# ----------------------------------------------------------------------------
# env_var(key) -> Option[tainted[str]]
# ----------------------------------------------------------------------------
# Read an env var. Returns Some(tainted[str]) if the var exists, None
# if not. The value is tainted by default — env vars come from the
# parent process / launch context, not the program, so they're
# untrusted by default (matching the Stage 10-alpha convention for
# args / read_file_tainted / read_line).
#
# The KEY is a taint sink (info disclosure: looking up an attacker-
# controlled env var name reveals which env vars exist by observing
# behaviour). The checker rejects a tainted key at compile time.
fn env_var(key: str) -> Option[tainted[str]] uses Proc {
    if !env_has(key) {
        return Option.None
    }
    let raw: str = env_get(key)
    return Option.Some(taint_mark(raw))
}

# ----------------------------------------------------------------------------
# env_set_var(key, value) -> void
# ----------------------------------------------------------------------------
# Set an env var. The KEY is a taint sink (env injection — attacker
# could set LD_PRELOAD, PATH, IFS, ...). The VALUE is NOT a sink (the
# user is the origin of the value they're setting — same convention
# as net_write: the data being sent is the user's data, not the
# attacker's).
#
# The env is process-global; this call affects all subsequent env_get
# / env_has calls in the same process, AND any child processes
# spawned after this call (proc_spawn / proc_exec inherit the env).
fn env_set_var(key: str, value: str) -> void uses Proc {
    env_set(key, value)
}

# ----------------------------------------------------------------------------
# env_unset_var(key) -> void
# ----------------------------------------------------------------------------
# Unset an env var. The KEY is a taint sink (same threat as env_set_var
# — attacker could unset LD_PRELOAD / PATH / IFS / ...). No-op if the
# var does not exist (unsetenv is idempotent on POSIX).
fn env_unset_var(key: str) -> void uses Proc {
    env_unset(key)
}

# ----------------------------------------------------------------------------
# env_current_dir() -> tainted[str]
# ----------------------------------------------------------------------------
# Read the cwd. The returned value is tainted by default — the cwd
# may be sensitive (e.g., the user cd'd to /etc/something; or the cwd
# is read on behalf of a network client who shouldn't learn it). The
# user must taint_unwrap or sanitise before using it as a path or
# printing it.
fn env_current_dir() -> tainted[str] uses Proc {
    let raw: str = cwd_get()
    return taint_mark(raw)
}

# ----------------------------------------------------------------------------
# env_set_current_dir(path) -> int
# ----------------------------------------------------------------------------
# Change the cwd. Returns 0 on success, -1 on error. The PATH is a
# taint sink (directory traversal — same threat as read_file /
# write_file). The checker rejects a tainted path at compile time.
#
# The cwd is process-global; this call affects all subsequent cwd_get
# / relative-path filesystem operations in the same process, AND any
# child processes spawned after this call (proc_spawn / proc_exec
# inherit the cwd).
fn env_set_current_dir(path: str) -> int uses Proc {
    return cwd_set(path)
}

# ----------------------------------------------------------------------------
# env_args_os() -> list[tainted[str]]
# ----------------------------------------------------------------------------
# Return the program's argv as a list of tainted[str]. The "os-string
# version of tainted_args" from the roadmap — semantically distinct
# from tainted_args (this is the raw OS bytes; tainted_args is the
# logical str version) even though they currently alias at the
# runtime level (Halis str = bytes already).
#
# Each element is tainted by default — argv comes from the launch
# context, not the program. The user must taint_unwrap or sanitise
# before using an arg as a command, path, file content, etc.
fn env_args_os() -> list[tainted[str]] uses Proc {
    let raw: list[str] = args_os()
    let out: list[tainted[str]] = []
    let mut i: int = 0
    while i < raw.len() {
        out.push(taint_mark(raw.get(i)))
        i = i + 1
    }
    return out
}

# ============================================================================
# End of std/env.hls
# ============================================================================
