# ============================================================================
# std/time.hls — Time / clock helpers for Halis
# ----------------------------------------------------------------------------
# Pure-HLS utilities built on the `clock_ms` builtin. The builtin returns
# integer milliseconds since an arbitrary epoch (monotonic on most platforms).
# All formatting helpers in this module are pure (no `uses IO`) except where
# noted.
#
# Helpers provided:
#   time_now_ms()              -> int (millisecond timestamp)
#   time_now_seconds()         -> int (whole seconds, integer division)
#   time_format_hms(ms)        -> "HH:MM:SS.mmm" string
#   time_format_iso8601(ms)    -> "T+<seconds>.<millis>" string
#   time_elapsed_ms(start, end) -> int  (end - start, never negative)
#   time_stopwatch_start()     -> int  (alias for time_now_ms)
#   time_stopwatch_lap(start)  -> int  (elapsed ms since start)
#   time_human_ms(ms)          -> human-readable duration like "1m 23s 456ms"
# ============================================================================

import "std.str"

# time_now_ms() returns the current value of clock_ms (monotonic, ms).
# This is the only function in this module that uses the IO effect.
fn time_now_ms() -> int uses IO {
    return clock_ms()
}

fn time_now_seconds() -> int uses IO {
    return clock_ms() / 1000
}

# Format a millisecond duration as HH:MM:SS.mmm. The duration is taken
# relative to a 0 origin; values >= 24h wrap modulo 24h.
fn time_format_hms(ms: int) -> str {
    if ms < 0 {
        return "00:00:00.000"
    }
    let total_seconds: int = ms / 1000
    let millis_part: int = ms % 1000
    let hours: int = (total_seconds / 3600) % 24
    let minutes: int = (total_seconds / 60) % 60
    let seconds: int = total_seconds % 60
    return pad2(hours) + ":" + pad2(minutes) + ":" + pad2(seconds) + "." + pad3(millis_part)
}

# Format a millisecond duration as a compact ISO-8601-like string.
fn time_format_iso8601(ms: int) -> str {
    if ms < 0 {
        return "T-0.000"
    }
    let secs: int = ms / 1000
    let millis: int = ms % 1000
    return "T+" + secs.to_str() + "." + pad3(millis)
}

# Elapsed ms from start to end (clamped to 0 if end < start).
fn time_elapsed_ms(start: int, end: int) -> int {
    if end < start {
        return 0
    }
    return end - start
}

# Stopwatch helpers — thin wrappers for readability.
fn time_stopwatch_start() -> int uses IO {
    return clock_ms()
}

fn time_stopwatch_lap(start: int) -> int uses IO {
    let now: int = clock_ms()
    return time_elapsed_ms(start, now)
}

# Human-readable duration: "1h 2m 3s 456ms", "3s 12ms", "456ms".
fn time_human_ms(ms: int) -> str {
    if ms < 0 {
        return "0ms"
    }
    let hours: int = ms / 3600000
    let minutes: int = (ms / 60000) % 60
    let seconds: int = (ms / 1000) % 60
    let millis: int = ms % 1000
    let parts: list[str] = []
    if hours > 0 {
        parts.push(hours.to_str() + "h")
    }
    if minutes > 0 || hours > 0 {
        parts.push(minutes.to_str() + "m")
    }
    if seconds > 0 || minutes > 0 || hours > 0 {
        parts.push(seconds.to_str() + "s")
    }
    parts.push(millis.to_str() + "ms")
    return str_join(parts, " ")
}

# pad2 / pad3 — left-pad a non-negative integer to 2 or 3 digits with '0'.
fn pad2(n: int) -> str {
    if n < 0 {
        return "00"
    }
    if n < 10 {
        return "0" + n.to_str()
    }
    return n.to_str()
}

fn pad3(n: int) -> str {
    if n < 0 {
        return "000"
    }
    if n < 10 {
        return "00" + n.to_str()
    }
    if n < 100 {
        return "0" + n.to_str()
    }
    return n.to_str()
}
