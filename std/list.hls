# ============================================================================
# std/list.hls — List utility helpers for Halis
# ----------------------------------------------------------------------------
# HLS v0.3 has no closures or function pointers (those arrive with concurrency
# in Stage 16), so this module exposes the most common list operations as
# monomorphic helpers. Where a higher-order version would normally be wanted
# (e.g. `map`, `filter`), users should write the loop inline in their code;
# the helpers here cover the cases where a single function call is enough.
#
# All functions are pure (no `uses IO`).
#
# Helpers provided:
#   list_reverse_str / list_reverse_int / list_reverse_float / list_reverse_bool
#   list_contains_str / list_contains_int / list_contains_float / list_contains_bool
#   list_index_of_str / list_index_of_int / list_index_of_float
#   list_concat_str / list_concat_int / list_concat_float
#   list_max_int / list_min_int
#   list_max_float / list_min_float
#   list_sort_int_asc / list_sort_int_desc  (insertion sort, stable)
#   list_dedup_sorted_int  (collapse runs of equal ints)
#   list_take_int / list_drop_int   (slice helpers)
#   list_equal_str / list_equal_int  (deep equality)
# ============================================================================

import "std.str"

# ----------------------------------------------------------------------------
# Reverse
# ----------------------------------------------------------------------------
fn list_reverse_str(xs: list[str]) -> list[str] {
    let n: int = xs.len()
    let out: list[str] = []
    let mut i: int = n - 1
    while i >= 0 {
        out.push(xs.get(i))
        i = i - 1
    }
    return out
}

fn list_reverse_int(xs: list[int]) -> list[int] {
    let n: int = xs.len()
    let out: list[int] = []
    let mut i: int = n - 1
    while i >= 0 {
        out.push(xs.get(i))
        i = i - 1
    }
    return out
}

fn list_reverse_float(xs: list[float]) -> list[float] {
    let n: int = xs.len()
    let out: list[float] = []
    let mut i: int = n - 1
    while i >= 0 {
        out.push(xs.get(i))
        i = i - 1
    }
    return out
}

fn list_reverse_bool(xs: list[bool]) -> list[bool] {
    let n: int = xs.len()
    let out: list[bool] = []
    let mut i: int = n - 1
    while i >= 0 {
        out.push(xs.get(i))
        i = i - 1
    }
    return out
}

# ----------------------------------------------------------------------------
# Contains
# ----------------------------------------------------------------------------
fn list_contains_str(xs: list[str], needle: str) -> bool {
    let n: int = xs.len()
    let mut i: int = 0
    while i < n {
        if xs.get(i) == needle {
            return true
        }
        i = i + 1
    }
    return false
}

fn list_contains_int(xs: list[int], needle: int) -> bool {
    let n: int = xs.len()
    let mut i: int = 0
    while i < n {
        if xs.get(i) == needle {
            return true
        }
        i = i + 1
    }
    return false
}

fn list_contains_float(xs: list[float], needle: float) -> bool {
    let n: int = xs.len()
    let mut i: int = 0
    while i < n {
        if xs.get(i) == needle {
            return true
        }
        i = i + 1
    }
    return false
}

fn list_contains_bool(xs: list[bool], needle: bool) -> bool {
    let n: int = xs.len()
    let mut i: int = 0
    while i < n {
        if xs.get(i) == needle {
            return true
        }
        i = i + 1
    }
    return false
}

# ----------------------------------------------------------------------------
# Index of (returns -1 if not found)
# ----------------------------------------------------------------------------
fn list_index_of_str(xs: list[str], needle: str) -> int {
    let n: int = xs.len()
    let mut i: int = 0
    while i < n {
        if xs.get(i) == needle {
            return i
        }
        i = i + 1
    }
    return -1
}

fn list_index_of_int(xs: list[int], needle: int) -> int {
    let n: int = xs.len()
    let mut i: int = 0
    while i < n {
        if xs.get(i) == needle {
            return i
        }
        i = i + 1
    }
    return -1
}

fn list_index_of_float(xs: list[float], needle: float) -> int {
    let n: int = xs.len()
    let mut i: int = 0
    while i < n {
        if xs.get(i) == needle {
            return i
        }
        i = i + 1
    }
    return -1
}

# ----------------------------------------------------------------------------
# Concat
# ----------------------------------------------------------------------------
fn list_concat_str(a: list[str], b: list[str]) -> list[str] {
    let out: list[str] = []
    let na: int = a.len()
    let nb: int = b.len()
    let mut i: int = 0
    while i < na {
        out.push(a.get(i))
        i = i + 1
    }
    i = 0
    while i < nb {
        out.push(b.get(i))
        i = i + 1
    }
    return out
}

fn list_concat_int(a: list[int], b: list[int]) -> list[int] {
    let out: list[int] = []
    let na: int = a.len()
    let nb: int = b.len()
    let mut i: int = 0
    while i < na {
        out.push(a.get(i))
        i = i + 1
    }
    i = 0
    while i < nb {
        out.push(b.get(i))
        i = i + 1
    }
    return out
}

fn list_concat_float(a: list[float], b: list[float]) -> list[float] {
    let out: list[float] = []
    let na: int = a.len()
    let nb: int = b.len()
    let mut i: int = 0
    while i < na {
        out.push(a.get(i))
        i = i + 1
    }
    i = 0
    while i < nb {
        out.push(b.get(i))
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# Max / Min (panic on empty list)
# ----------------------------------------------------------------------------
fn list_max_int(xs: list[int]) -> int {
    if xs.len() == 0 {
        panic("list_max_int: empty list")
    }
    let mut m: int = xs.get(0)
    let mut i: int = 1
    let n: int = xs.len()
    while i < n {
        if xs.get(i) > m {
            m = xs.get(i)
        }
        i = i + 1
    }
    return m
}

fn list_min_int(xs: list[int]) -> int {
    if xs.len() == 0 {
        panic("list_min_int: empty list")
    }
    let mut m: int = xs.get(0)
    let mut i: int = 1
    let n: int = xs.len()
    while i < n {
        if xs.get(i) < m {
            m = xs.get(i)
        }
        i = i + 1
    }
    return m
}

fn list_max_float(xs: list[float]) -> float {
    if xs.len() == 0 {
        panic("list_max_float: empty list")
    }
    let mut m: float = xs.get(0)
    let mut i: int = 1
    let n: int = xs.len()
    while i < n {
        if xs.get(i) > m {
            m = xs.get(i)
        }
        i = i + 1
    }
    return m
}

fn list_min_float(xs: list[float]) -> float {
    if xs.len() == 0 {
        panic("list_min_float: empty list")
    }
    let mut m: float = xs.get(0)
    let mut i: int = 1
    let n: int = xs.len()
    while i < n {
        if xs.get(i) < m {
            m = xs.get(i)
        }
        i = i + 1
    }
    return m
}

# ----------------------------------------------------------------------------
# Insertion sort (stable). Stage 32 (v0.51.0-alpha): O(n²) comparisons
# but O(n) allocations — the previous implementation popped and pushed
# every suffix element on every insertion, allocating O(n²) temporary
# list nodes. The new implementation pre-sizes the output to n zeros,
# then uses the standard half-open shift loop: each new element v is
# inserted by shifting larger elements one slot right (no allocation).
# ----------------------------------------------------------------------------
fn list_sort_int_asc(xs: list[int]) -> list[int] {
    let n: int = xs.len()
    if n == 0 {
        return []
    }
    # Pre-allocate the output list with n zeros. This avoids per-push
    # growth and gives the inner loop a stable slot to shift into.
    let out: list[int] = []
    let mut k: int = 0
    while k < n {
        out.push(0)
        k = k + 1
    }
    let mut filled: int = 0
    let mut i: int = 0
    while i < n {
        let v: int = xs.get(i)
        # Find the insertion point in [0, filled) using a linear scan
        # from the END (the common case for nearly-sorted input is one
        # comparison and zero shifts).
        let mut j: int = filled
        while j > 0 && out.get(j - 1) > v {
            out.set(j, out.get(j - 1))
            j = j - 1
        }
        out.set(j, v)
        filled = filled + 1
        i = i + 1
    }
    return out
}

# Descending variant.
# Stage 32 (v0.51.0-alpha): O(n) sort + reverse was 2x slower than
# necessary. This direct descending insertion sort uses the same
# pre-sized + shift technique as list_sort_int_asc, just with the
# comparison flipped — single pass, no reverse call.
fn list_sort_int_desc(xs: list[int]) -> list[int] {
    let n: int = xs.len()
    if n == 0 {
        return []
    }
    let out: list[int] = []
    let mut k: int = 0
    while k < n {
        out.push(0)
        k = k + 1
    }
    let mut filled: int = 0
    let mut i: int = 0
    while i < n {
        let v: int = xs.get(i)
        # Insert v into the descending-sorted prefix: shift elements
        # that are SMALLER than v one slot to the right.
        let mut j: int = filled
        while j > 0 && out.get(j - 1) < v {
            out.set(j, out.get(j - 1))
            j = j - 1
        }
        out.set(j, v)
        filled = filled + 1
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# Take / Drop (slice helpers)
# ----------------------------------------------------------------------------
fn list_take_int(xs: list[int], n: int) -> list[int] {
    let out: list[int] = []
    if n <= 0 {
        return out
    }
    let mut limit: int = n
    if limit > xs.len() {
        limit = xs.len()
    }
    let mut i: int = 0
    while i < limit {
        out.push(xs.get(i))
        i = i + 1
    }
    return out
}

fn list_drop_int(xs: list[int], n: int) -> list[int] {
    let out: list[int] = []
    let mut start: int = n
    if start < 0 {
        start = 0
    }
    if start > xs.len() {
        return out
    }
    let mut i: int = start
    while i < xs.len() {
        out.push(xs.get(i))
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# Equal (deep equality)
# ----------------------------------------------------------------------------
fn list_equal_str(a: list[str], b: list[str]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let n: int = a.len()
    let mut i: int = 0
    while i < n {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn list_equal_int(a: list[int], b: list[int]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let n: int = a.len()
    let mut i: int = 0
    while i < n {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

# Dedup a *sorted* list of ints (collapses consecutive duplicates).
fn list_dedup_sorted_int(xs: list[int]) -> list[int] {
    let out: list[int] = []
    let n: int = xs.len()
    if n == 0 {
        return out
    }
    out.push(xs.get(0))
    let mut i: int = 1
    while i < n {
        let v: int = xs.get(i)
        if v != out.get(out.len() - 1) {
            out.push(v)
        }
        i = i + 1
    }
    return out
}
