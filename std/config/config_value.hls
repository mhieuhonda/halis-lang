# ============================================================================
# std/config/config_value.hls - verbatim slice of the original std/config.hls
# (lines 133..908), split for maintainability. Loaded via the
# std/config.hls facade; not part of the public import API.
# ============================================================================

# ----------------------------------------------------------------------------
# Constants — config value kinds. Stored as int (HLS v0.3 has no enum-
# with-methods; the accessors switch on these int values).
# ----------------------------------------------------------------------------

fn config_kind_null() -> int { return 0 }
fn config_kind_str() -> int { return 1 }
fn config_kind_int() -> int { return 2 }
fn config_kind_float() -> int { return 3 }
fn config_kind_bool() -> int { return 4 }
fn config_kind_table() -> int { return 5 }
fn config_kind_array() -> int { return 6 }

# ----------------------------------------------------------------------------
# ConfigValue — a tagged union for config values. A config is a tree of
# ConfigValues (tables hold other ConfigValues; arrays hold lists of
# ConfigValues). The top-level config is always a table.
# ----------------------------------------------------------------------------

struct ConfigValue {
    kind: int,
    str_val: str,
    int_val: int,
    float_val: float,
    bool_val: bool,
    table_keys: list[str],
    table_vals: list[ConfigValue],
    array_items: list[ConfigValue],
}

# ----------------------------------------------------------------------------
# Constructors — return a ConfigValue of the given kind.
# ----------------------------------------------------------------------------

fn config_null() -> ConfigValue {
    return ConfigValue {
        kind: config_kind_null(),
        str_val: "", int_val: 0, float_val: 0.0, bool_val: false,
        table_keys: [], table_vals: [], array_items: [],
    }
}

fn config_str(v: str) -> ConfigValue {
    return ConfigValue {
        kind: config_kind_str(),
        str_val: v, int_val: 0, float_val: 0.0, bool_val: false,
        table_keys: [], table_vals: [], array_items: [],
    }
}

fn config_int(v: int) -> ConfigValue {
    return ConfigValue {
        kind: config_kind_int(),
        str_val: "", int_val: v, float_val: 0.0, bool_val: false,
        table_keys: [], table_vals: [], array_items: [],
    }
}

fn config_float(v: float) -> ConfigValue {
    return ConfigValue {
        kind: config_kind_float(),
        str_val: "", int_val: 0, float_val: v, bool_val: false,
        table_keys: [], table_vals: [], array_items: [],
    }
}

fn config_bool(v: bool) -> ConfigValue {
    return ConfigValue {
        kind: config_kind_bool(),
        str_val: "", int_val: 0, float_val: 0.0, bool_val: v,
        table_keys: [], table_vals: [], array_items: [],
    }
}

fn config_table(keys: list[str], vals: list[ConfigValue]) -> ConfigValue {
    return ConfigValue {
        kind: config_kind_table(),
        str_val: "", int_val: 0, float_val: 0.0, bool_val: false,
        table_keys: keys, table_vals: vals, array_items: [],
    }
}

fn config_array(items: list[ConfigValue]) -> ConfigValue {
    return ConfigValue {
        kind: config_kind_array(),
        str_val: "", int_val: 0, float_val: 0.0, bool_val: false,
        table_keys: [], table_vals: [], array_items: items,
    }
}

# ----------------------------------------------------------------------------
# ConfigSchemaEntry — one declared key in the schema. The schema is a
# flat list of entries; the loader uses it to (a) populate defaults and
# (b) coerce file/env values to the declared type.
# ----------------------------------------------------------------------------

struct ConfigSchemaEntry {
    key: str,            # dotted path, e.g. "server.port"
    kind: int,           # one of config_kind_* (must be scalar: str/int/float/bool)
    default_str: str,   # default value as a string (coerced at load time)
    has_default: bool,   # does this entry have a default?
    desc: str,           # human-readable description (for `config_describe`)
    env_name: str,       # explicit env-var name; "" if derived from prefix+key
}

# ----------------------------------------------------------------------------
# ConfigSchema — the schema (a list of entries). Built via the builder
# pattern (immutable updates).
# ----------------------------------------------------------------------------

struct ConfigSchema {
    entries: list[ConfigSchemaEntry],
}

# ----------------------------------------------------------------------------
# ConfigLoadError — a structured error from the loader. Carries the
# layer (defaults / file / env), the key, and a human-readable message.
# ----------------------------------------------------------------------------

struct ConfigLoadError {
    layer: str,          # "defaults" / "file" / "env"
    key: str,            # the dotted path that failed
    message: str,        # human-readable error
}

# ============================================================================
# Builder — immutable updates (same convention as CliParser / Logger).
# ============================================================================

# config_schema_new() — create an empty schema.
fn config_schema_new() -> ConfigSchema {
    let empty: list[ConfigSchemaEntry] = []
    return ConfigSchema { entries: empty }
}

# config_schema_str(schema, key, default, desc) — declare a str key.
fn config_schema_str(schema: ConfigSchema, key: str, default: str, desc: str) -> ConfigSchema {
    return config_schema_add(schema, key, config_kind_str(), default, true, desc, "")
}

# config_schema_int(schema, key, default, desc) — declare an int key.
fn config_schema_int(schema: ConfigSchema, key: str, default: int, desc: str) -> ConfigSchema {
    return config_schema_add(schema, key, config_kind_int(), default.to_str(), true, desc, "")
}

# config_schema_float(schema, key, default, desc) — declare a float key.
fn config_schema_float(schema: ConfigSchema, key: str, default: float, desc: str) -> ConfigSchema {
    return config_schema_add(schema, key, config_kind_float(), default.to_str(), true, desc, "")
}

# config_schema_bool(schema, key, default, desc) — declare a bool key.
fn config_schema_bool(schema: ConfigSchema, key: str, default: bool, desc: str) -> ConfigSchema {
    return config_schema_add(schema, key, config_kind_bool(), default.to_str(), true, desc, "")
}

# config_schema_str_no_default — declare a str key without a default.
fn config_schema_str_no_default(schema: ConfigSchema, key: str, desc: str) -> ConfigSchema {
    return config_schema_add(schema, key, config_kind_str(), "", false, desc, "")
}

# config_schema_int_no_default — declare an int key without a default.
fn config_schema_int_no_default(schema: ConfigSchema, key: str, desc: str) -> ConfigSchema {
    return config_schema_add(schema, key, config_kind_int(), "", false, desc, "")
}

# config_schema_env(schema, key, env_name) — register an explicit env-var
# name for a key (overrides the default `PREFIX_KEY` derivation). Used
# when the env var doesn't follow the standard convention.
fn config_schema_env(schema: ConfigSchema, key: str, env_name: str) -> ConfigSchema {
    let new_entries: list[ConfigSchemaEntry] = []
    let mut i: int = 0
    while i < schema.entries.len() {
        let e: ConfigSchemaEntry = schema.entries.get(i)
        if e.key == key {
            let ne: ConfigSchemaEntry = ConfigSchemaEntry {
                key: e.key, kind: e.kind, default_str: e.default_str,
                has_default: e.has_default, desc: e.desc, env_name: env_name,
            }
            new_entries.push(ne)
        } else {
            new_entries.push(e)
        }
        i = i + 1
    }
    return ConfigSchema { entries: new_entries }
}

# config_schema_add — internal helper: append an entry.
fn config_schema_add(schema: ConfigSchema, key: str, kind: int,
                      default_str: str, has_default: bool, desc: str,
                      env_name: str) -> ConfigSchema {
    let new_entries: list[ConfigSchemaEntry] = []
    let mut i: int = 0
    while i < schema.entries.len() {
        new_entries.push(schema.entries.get(i))
        i = i + 1
    }
    new_entries.push(ConfigSchemaEntry {
        key: key, kind: kind, default_str: default_str,
        has_default: has_default, desc: desc, env_name: env_name,
    })
    return ConfigSchema { entries: new_entries }
}

# ----------------------------------------------------------------------------
# impl ConfigSchema — method twins of the free-function builders.
# ----------------------------------------------------------------------------

impl ConfigSchema {
    fn str_key(self: ConfigSchema, key: str, default: str, desc: str) -> ConfigSchema {
        return config_schema_str(self, key, default, desc)
    }
    fn int_key(self: ConfigSchema, key: str, default: int, desc: str) -> ConfigSchema {
        return config_schema_int(self, key, default, desc)
    }
    fn float_key(self: ConfigSchema, key: str, default: float, desc: str) -> ConfigSchema {
        return config_schema_float(self, key, default, desc)
    }
    fn bool_key(self: ConfigSchema, key: str, default: bool, desc: str) -> ConfigSchema {
        return config_schema_bool(self, key, default, desc)
    }
    fn str_key_no_default(self: ConfigSchema, key: str, desc: str) -> ConfigSchema {
        return config_schema_str_no_default(self, key, desc)
    }
    fn int_key_no_default(self: ConfigSchema, key: str, desc: str) -> ConfigSchema {
        return config_schema_int_no_default(self, key, desc)
    }
    fn env(self: ConfigSchema, key: str, env_name: str) -> ConfigSchema {
        return config_schema_env(self, key, env_name)
    }
}

# ============================================================================
# Layering — config_load(schema, file_content, env_prefix) -> Result[ConfigValue, ConfigLoadError]
#
# The loader applies the three layers (defaults < file < env) and returns
# a flat ConfigValue tree (a top-level table holding nested tables for
# dotted-path keys). The caller then uses config_get / config_get_str /
# _int / _float / _bool to look up values.
#
# `file_content` may be "" (no file — defaults + env only).
# `env_prefix` may be "" (no env overlay — defaults + file only).
# ============================================================================

fn config_load(schema: ConfigSchema, file_content: str, env_prefix: str) -> Result[ConfigValue, ConfigLoadError] uses Proc {
    # Layer 1: defaults.
    let mut cfg: ConfigValue = config_table([], [])
    let mut i: int = 0
    while i < schema.entries.len() {
        let e: ConfigSchemaEntry = schema.entries.get(i)
        if e.has_default {
            let coerced: Result[ConfigValue, str] = config_coerce_str(e.kind, e.default_str)
            if result_is_err(coerced) {
                let err: ConfigLoadError = ConfigLoadError {
                    layer: "defaults",
                    key: e.key,
                    message: result_err_or(coerced, "coercion failed"),
                }
                return Result.Err(err)
            }
            let v: ConfigValue = result_unwrap(coerced)
            config_set_path(cfg, e.key, v)
        }
        i = i + 1
    }

    # Layer 2: file content (TOML / JSON / INI).
    if file_content.len() > 0 {
        let parsed: Result[ConfigValue, str] = config_parse_file(file_content)
        if result_is_err(parsed) {
            let err: ConfigLoadError = ConfigLoadError {
                layer: "file",
                key: "<root>",
                message: result_err_or(parsed, "parse failed"),
            }
            return Result.Err(err)
        }
        let file_cfg: ConfigValue = result_unwrap(parsed)
        # Overlay: for every key in the schema, look it up in file_cfg;
        # if present, coerce to the schema's type and set in cfg.
        let mut j: int = 0
        while j < schema.entries.len() {
            let e: ConfigSchemaEntry = schema.entries.get(j)
            let file_val: ConfigValue = config_get_path(file_cfg, e.key)
            if file_val.kind != config_kind_null() {
                let coerced: Result[ConfigValue, str] = config_coerce_value(e.kind, file_val)
                if result_is_err(coerced) {
                    let err: ConfigLoadError = ConfigLoadError {
                        layer: "file",
                        key: e.key,
                        message: result_err_or(coerced, "coercion failed"),
                    }
                    return Result.Err(err)
                }
                config_set_path(cfg, e.key, result_unwrap(coerced))
            }
            j = j + 1
        }
    }

    # Layer 3: env overlay.
    if env_prefix != "" {
        let mut k: int = 0
        while k < schema.entries.len() {
            let e: ConfigSchemaEntry = schema.entries.get(k)
            let env_name: str = config_env_name(e, env_prefix)
            if env_has(env_name) {
                let raw: str = env_get(env_name)
                let coerced: Result[ConfigValue, str] = config_coerce_str(e.kind, raw)
                if result_is_err(coerced) {
                    let err: ConfigLoadError = ConfigLoadError {
                        layer: "env",
                        key: e.key,
                        message: "env var '" + env_name + "' = '" + raw + "': "
                            + result_err_or(coerced, "coercion failed"),
                    }
                    return Result.Err(err)
                }
                config_set_path(cfg, e.key, result_unwrap(coerced))
            }
            k = k + 1
        }
    }

    return Result.Ok(cfg)
}

# ----------------------------------------------------------------------------
# config_load_file(schema, path, env_prefix) — convenience: read the file
# at `path`, then call config_load. Carries the Fs effect (read_file).
# If the file doesn't exist, this returns Result.Err (NOT a panic —
# the caller decides whether to fall back to defaults-only).
# ----------------------------------------------------------------------------

fn config_load_file(schema: ConfigSchema, path: str, env_prefix: str) -> Result[ConfigValue, ConfigLoadError] uses Fs, Proc {
    let content: str = read_file(path)
    # read_file returns "" if the file doesn't exist (the builtin's
    # convention — see Stage 36). We can't distinguish empty file from
    # missing file here; the caller should check via fs::path_exists
    # if that distinction matters. For the loader, "" = no file.
    if content == "" {
        # Try env-only.
        return config_load(schema, "", env_prefix)
    }
    return config_load(schema, content, env_prefix)
}

# ----------------------------------------------------------------------------
# config_env_name(entry, prefix) — derive the env-var name for a key.
#   "server.port" + prefix "MYAPP" -> "MYAPP_SERVER_PORT"
# If the entry has an explicit env_name, use it verbatim.
# ----------------------------------------------------------------------------

fn config_env_name(entry: ConfigSchemaEntry, prefix: str) -> str {
    if entry.env_name != "" {
        return entry.env_name
    }
    # Replace '.' with '_', uppercase, prepend prefix + '_'.
    let upper_key: str = str_to_upper_ascii(str_replace(entry.key, ".", "_"))
    return prefix + "_" + upper_key
}

# ============================================================================
# Coercion — config_coerce_str(kind, raw) -> Result[ConfigValue, str]
# and config_coerce_value(kind, v) -> Result[ConfigValue, str].
#
# Coercion rules:
#   str:   any value -> its string form. For an int 8080, str "8080".
#   int:   str -> int_parse; int -> as-is; float -> floor; bool -> 0/1.
#   float: str -> float_parse; int -> as float; float -> as-is; bool -> 0.0/1.0.
#   bool:  str -> "true"/"1"/"yes"/"on" (case-insensitive) -> true;
#                "false"/"0"/"no"/"off" -> false; else Err.
#          int -> 0 -> false, non-zero -> true.
#          float -> 0.0 -> false, non-zero -> true.
#          bool -> as-is.
# ============================================================================

fn config_coerce_str(kind: int, raw: str) -> Result[ConfigValue, str] {
    if kind == config_kind_str() {
        return Result.Ok(config_str(raw))
    }
    if kind == config_kind_int() {
        let r: Result[int, str] = int_parse(raw)
        if result_is_err(r) {
            return Result.Err("invalid int '" + raw + "' ("
                + result_err_or(r, "") + ")")
        }
        return Result.Ok(config_int(result_unwrap(r)))
    }
    if kind == config_kind_float() {
        let r: Result[float, str] = float_parse(raw)
        if result_is_err(r) {
            return Result.Err("invalid float '" + raw + "' ("
                + result_err_or(r, "") + ")")
        }
        return Result.Ok(config_float(result_unwrap(r)))
    }
    if kind == config_kind_bool() {
        let lower: str = str_to_lower_ascii(raw)
        if lower == "true" || lower == "1" || lower == "yes" || lower == "on" {
            return Result.Ok(config_bool(true))
        }
        if lower == "false" || lower == "0" || lower == "no" || lower == "off" {
            return Result.Ok(config_bool(false))
        }
        return Result.Err("invalid bool '" + raw
            + "' (expected true/false/1/0/yes/no/on/off)")
    }
    return Result.Err("unsupported kind " + kind.to_str())
}

fn config_coerce_value(kind: int, v: ConfigValue) -> Result[ConfigValue, str] {
    if kind == config_kind_str() {
        return Result.Ok(config_str(config_value_to_str(v)))
    }
    if kind == config_kind_int() {
        if v.kind == config_kind_int() {
            return Result.Ok(v)
        }
        if v.kind == config_kind_float() {
            return Result.Ok(config_int(v.float_val.to_int()))
        }
        if v.kind == config_kind_bool() {
            if v.bool_val {
                return Result.Ok(config_int(1))
            }
            return Result.Ok(config_int(0))
        }
        if v.kind == config_kind_str() {
            return config_coerce_str(config_kind_int(), v.str_val)
        }
        return Result.Err("cannot coerce kind " + v.kind.to_str() + " to int")
    }
    if kind == config_kind_float() {
        if v.kind == config_kind_float() {
            return Result.Ok(v)
        }
        if v.kind == config_kind_int() {
            return Result.Ok(config_float(v.int_val.to_float()))
        }
        if v.kind == config_kind_bool() {
            if v.bool_val {
                return Result.Ok(config_float(1.0))
            }
            return Result.Ok(config_float(0.0))
        }
        if v.kind == config_kind_str() {
            return config_coerce_str(config_kind_float(), v.str_val)
        }
        return Result.Err("cannot coerce kind " + v.kind.to_str() + " to float")
    }
    if kind == config_kind_bool() {
        if v.kind == config_kind_bool() {
            return Result.Ok(v)
        }
        if v.kind == config_kind_int() {
            return Result.Ok(config_bool(v.int_val != 0))
        }
        if v.kind == config_kind_float() {
            return Result.Ok(config_bool(v.float_val != 0.0))
        }
        if v.kind == config_kind_str() {
            return config_coerce_str(config_kind_bool(), v.str_val)
        }
        return Result.Err("cannot coerce kind " + v.kind.to_str() + " to bool")
    }
    return Result.Err("unsupported target kind " + kind.to_str())
}

# ----------------------------------------------------------------------------
# config_value_to_str(v) — render a ConfigValue as a string (for str
# coercion and for serialisation). Ints render via to_str; floats via
# to_str; bools as "true"/"false"; null as ""; tables/arrays as their
# JSON-ish form (debug only — not used in production paths).
# ----------------------------------------------------------------------------

fn config_value_to_str(v: ConfigValue) -> str {
    if v.kind == config_kind_str() {
        return v.str_val
    }
    if v.kind == config_kind_int() {
        return v.int_val.to_str()
    }
    if v.kind == config_kind_float() {
        return v.float_val.to_str()
    }
    if v.kind == config_kind_bool() {
        if v.bool_val {
            return "true"
        }
        return "false"
    }
    if v.kind == config_kind_null() {
        return ""
    }
    # Tables / arrays — render as a debug string (not used in normal
    # coercion paths; only for debugging).
    return "<" + config_kind_name(v.kind) + ">"
}

fn config_kind_name(kind: int) -> str {
    if kind == config_kind_null() { return "null" }
    if kind == config_kind_str() { return "str" }
    if kind == config_kind_int() { return "int" }
    if kind == config_kind_float() { return "float" }
    if kind == config_kind_bool() { return "bool" }
    if kind == config_kind_table() { return "table" }
    if kind == config_kind_array() { return "array" }
    return "unknown"
}

# ============================================================================
# Path access — config_get_path(cfg, dotted_path) -> ConfigValue.
# Splits the path on '.' and walks the table tree. Returns null if any
# segment is missing or non-table.
# ============================================================================

fn config_get_path(cfg: ConfigValue, path: str) -> ConfigValue {
    if path == "" {
        return cfg
    }
    let parts: list[str] = path.split(".")
    let mut cur: ConfigValue = cfg
    let mut i: int = 0
    while i < parts.len() {
        if cur.kind != config_kind_table() {
            return config_null()
        }
        let seg: str = parts.get(i)
        let idx: int = config_table_find(cur, seg)
        if idx < 0 {
            return config_null()
        }
        cur = cur.table_vals.get(idx)
        i = i + 1
    }
    return cur
}

# config_table_find(table, key) -> int — index of key in the table, or -1.
fn config_table_find(table: ConfigValue, key: str) -> int {
    let mut i: int = 0
    while i < table.table_keys.len() {
        if table.table_keys.get(i) == key {
            return i
        }
        i = i + 1
    }
    return -1
}

# ----------------------------------------------------------------------------
# config_set_path(cfg, dotted_path, value) -> void — MUTATES cfg in-place.
# Creates intermediate tables as needed. The cfg's table_keys /
# table_vals lists are mutated (HLS lists are mutable through push when
# the binding is `let mut` — but we use the trick of mutating the
# INNER list directly via set, which works for `let` bindings too).
#
# NOTE: this function assumes `cfg` is a table (the top-level config is
# always a table by construction). It does NOT check; if cfg is not a
# table, the function silently does nothing (the value is lost).
# ----------------------------------------------------------------------------

fn config_set_path(cfg: ConfigValue, path: str, value: ConfigValue) -> void {
    if path == "" {
        return
    }
    if cfg.kind != config_kind_table() {
        return
    }
    let parts: list[str] = path.split(".")
    let mut cur: ConfigValue = cfg
    let mut i: int = 0
    while i < parts.len() - 1 {
        let seg: str = parts.get(i)
        let idx: int = config_table_find(cur, seg)
        if idx < 0 {
            # Create intermediate table.
            let new_tbl: ConfigValue = config_table([], [])
            cur.table_keys.push(seg)
            cur.table_vals.push(new_tbl)
            cur = new_tbl
        } else {
            let next: ConfigValue = cur.table_vals.get(idx)
            if next.kind != config_kind_table() {
                # The path goes through a non-table — overwrite with a table.
                let new_tbl: ConfigValue = config_table([], [])
                cur.table_vals.set(idx, new_tbl)
                cur = new_tbl
            } else {
                cur = next
            }
        }
        i = i + 1
    }
    # Last segment — set or replace.
    let last_seg: str = parts.get(parts.len() - 1)
    let last_idx: int = config_table_find(cur, last_seg)
    if last_idx < 0 {
        cur.table_keys.push(last_seg)
        cur.table_vals.push(value)
    } else {
        cur.table_vals.set(last_idx, value)
    }
}

# ============================================================================
# Typed accessors — config_get_str / _int / _float / _bool.
# These NEVER panic: if the path is missing or the value is the wrong
# type, they return the default (matching std.cli's accessors).
# ============================================================================

fn config_get_str(cfg: ConfigValue, path: str, default: str) -> str {
    let v: ConfigValue = config_get_path(cfg, path)
    if v.kind == config_kind_str() {
        return v.str_val
    }
    if v.kind == config_kind_int() {
        return v.int_val.to_str()
    }
    if v.kind == config_kind_float() {
        return v.float_val.to_str()
    }
    if v.kind == config_kind_bool() {
        if v.bool_val {
            return "true"
        }
        return "false"
    }
    return default
}

fn config_get_int(cfg: ConfigValue, path: str, default: int) -> int {
    let v: ConfigValue = config_get_path(cfg, path)
    if v.kind == config_kind_int() {
        return v.int_val
    }
    if v.kind == config_kind_float() {
        return v.float_val.to_int()
    }
    if v.kind == config_kind_bool() {
        if v.bool_val {
            return 1
        }
        return 0
    }
    if v.kind == config_kind_str() {
        let r: Result[int, str] = int_parse(v.str_val)
        if result_is_ok(r) {
            return result_unwrap_or(r, default)
        }
    }
    return default
}

fn config_get_float(cfg: ConfigValue, path: str, default: float) -> float {
    let v: ConfigValue = config_get_path(cfg, path)
    if v.kind == config_kind_float() {
        return v.float_val
    }
    if v.kind == config_kind_int() {
        return v.int_val.to_float()
    }
    if v.kind == config_kind_bool() {
        if v.bool_val {
            return 1.0
        }
        return 0.0
    }
    if v.kind == config_kind_str() {
        let r: Result[float, str] = float_parse(v.str_val)
        if result_is_ok(r) {
            return result_unwrap_or(r, default)
        }
    }
    return default
}

fn config_get_bool(cfg: ConfigValue, path: str, default: bool) -> bool {
    let v: ConfigValue = config_get_path(cfg, path)
    if v.kind == config_kind_bool() {
        return v.bool_val
    }
    if v.kind == config_kind_int() {
        return v.int_val != 0
    }
    if v.kind == config_kind_float() {
        return v.float_val != 0.0
    }
    if v.kind == config_kind_str() {
        let lower: str = str_to_lower_ascii(v.str_val)
        if lower == "true" || lower == "1" || lower == "yes" || lower == "on" {
            return true
        }
        if lower == "false" || lower == "0" || lower == "no" || lower == "off" {
            return false
        }
    }
    return default
}

# ----------------------------------------------------------------------------
# config_has(cfg, path) — true iff the path exists and is non-null.
# ----------------------------------------------------------------------------

fn config_has(cfg: ConfigValue, path: str) -> bool {
    let v: ConfigValue = config_get_path(cfg, path)
    return v.kind != config_kind_null()
}

# ----------------------------------------------------------------------------
# config_set_str(cfg, path, value) — mutate cfg in-place to set a str.
# Used by the CLI overlay (the caller sets values from cli_get_str after
# loading defaults + file + env). Carries no effect (pure mutation of
# an in-memory value).
# ----------------------------------------------------------------------------

fn config_set_str(cfg: ConfigValue, path: str, value: str) -> void {
    config_set_path(cfg, path, config_str(value))
}

fn config_set_int(cfg: ConfigValue, path: str, value: int) -> void {
    config_set_path(cfg, path, config_int(value))
}

fn config_set_float(cfg: ConfigValue, path: str, value: float) -> void {
    config_set_path(cfg, path, config_float(value))
}

fn config_set_bool(cfg: ConfigValue, path: str, value: bool) -> void {
    config_set_path(cfg, path, config_bool(value))
}

# ============================================================================
# File parsers — config_parse_file(content) -> Result[ConfigValue, str].
# Detects the format by content sniffing and delegates to the appropriate
# parser. Returns a top-level table.
# ============================================================================

fn config_parse_file(content: str) -> Result[ConfigValue, str] {
    # Strip leading whitespace to sniff the first non-whitespace char.
    let mut i: int = 0
    let n: int = content.len()
    while i < n {
        let b: int = content.byte_at(i)
        if b != 32 && b != 9 && b != 10 && b != 13 {
            break
        }
        i = i + 1
    }
    if i >= n {
        # Empty file (or whitespace-only).
        return Result.Ok(config_table([], []))
    }
    let first: int = content.byte_at(i)
    # JSON: starts with '{' (object) — NOT '[' (which could be a TOML
    # table header). TOML files start with '[' for table headers; JSON
    # arrays start with '[' too, but a JSON array is unusual for a
    # config file (configs are objects). We detect JSON by '{' only;
    # everything else is treated as TOML.
    if first == 123 {
        return config_parse_json(content)
    }
    # TOML / INI: both can start with '[' (a table header) or a key.
    # We treat everything else as TOML (the preferred format).
    # A TOML file with a `[section]` header and `key = value` lines is
    # also valid INI; the TOML parser handles both (INI is a subset of
    # TOML's table-header + key=value syntax, minus TOML's typed values).
    return toml_parse(content)
}

# ----------------------------------------------------------------------------
# config_parse_json(content) — delegate to std.json. The JSON parser
# returns a JsonValue; we convert it to a ConfigValue tree. JSON objects
# become tables; JSON arrays become arrays; JSON scalars become the
# corresponding ConfigValue scalars.
