# ============================================================
# std/jsffi.hls — JavaScript FFI for the WebAssembly target
# ============================================================
# Stage 23 (v0.42.0-alpha): declares common JavaScript host
# functions that a wasm-compiled Halis program can call. These
# are IMPORTS — the JS glue (generated by `hlwasm`) must
# provide them in the import object under module "env".
#
# Stage 73 (v0.92.0-alpha): the module grew from 13 to 48
# declarations, the JS glue AUTO-REGISTERS every struct in the
# program for marshalling (the emitter exports
# hl_struct_descriptors() with the computed field layouts — no
# manual Halis.registerStruct calls anymore), and JS -> HLS
# callbacks arrived: define
#
#   fn jsffi_on_callback(cb_id: int, arg: str) -> str { ... }
#
# in your program and `hlwasm` exports hl_call_halis; the JS
# side reaches it via Halis.callHalis(cbId, json) (the same
# handler_id dispatch pattern std.http_router uses — HLS has no
# function pointers, so the callback handler if/else chains on
# cb_id). New declaration groups: console extras (table, clear,
# count, timers, groups), DOM attributes/classes/styles/values,
# a JSON bridge, URL encoding, environment info (platform,
# language, online state, screen, user agent), and performance
# timing.
#
# Stage 24 (v0.43.0-alpha): struct marshalling. The JS glue
# now exposes three utility functions for HLS struct <-> JS
# object conversion:
#
#   Halis.registerStruct(name, descriptor)
#       Register a struct layout. `descriptor` is an array of
#       {name, type, offset} — type is one of "i64", "f64",
#       "i32", "bool", "str" (pointer), "ptr" (raw i32).
#   Halis.readStruct(ptr, name) -> JS object
#       Read a registered struct from wasm memory at `ptr`.
#   Halis.writeStruct(allocFn, obj, name) -> i32 ptr
#       Allocate space, write the struct fields from `obj`,
#       return the pointer.
#
# These are PURE JS utilities — the wasm ABI passes structs as
# i32 pointers (same as the C ABI). The HLS program declares
# an `extern "js"` function that takes an i32 (the struct
# pointer), passes it to the JS function, and the JS function
# calls `Halis.readStruct(ptr, "Point")` to convert to a JS
# object. See examples/web_app_1000loc.hls for a full example.
#
# Usage:
#   import "std.jsffi"
#
#   fn main() -> int uses IO {
#       js_console_log("Hello from wasm!")
#       return 0
#   }
#
# When compiled with `hlwasm` (--target wasm32-unknown-unknown),
# each `extern "js"` fn becomes a wasm import. The JS glue
# provides a default implementation; you can override any of
# them by passing `importOverrides` to `Halis.run()`.
#
# When compiled to native (the C backend) or interpreted,
# `extern "js"` blocks are rejected — JS functions are only
# available on the wasm32 target.
# ============================================================

extern "js" {

    # ---- console ----
    fn js_console_log(msg: str) -> void uses IO
    fn js_console_warn(msg: str) -> void uses IO
    fn js_console_error(msg: str) -> void uses IO
    # Stage 73: console extras.
    fn js_console_table(msg: str) -> void uses IO
    fn js_console_clear() -> void uses IO
    fn js_console_count(label: str) -> int uses IO
    fn js_console_count_reset(label: str) -> void uses IO
    fn js_console_group(label: str) -> void uses IO
    fn js_console_group_end() -> void uses IO
    fn js_console_time(label: str) -> void uses IO
    fn js_console_time_end(label: str) -> int uses IO

    # ---- DOM (browser only; no-op in Node.js) ----
    fn js_dom_set_text(id: str, text: str) -> void uses IO
    fn js_dom_append(id: str, html: str) -> void uses IO
    # Stage 73: attributes, classes, styles, values, title.
    fn js_dom_set_attr(id: str, name: str, value: str) -> void uses IO
    fn js_dom_get_attr(id: str, name: str) -> str uses IO
    fn js_dom_remove(id: str) -> void uses IO
    fn js_dom_add_class(id: str, class: str) -> void uses IO
    fn js_dom_remove_class(id: str, class: str) -> void uses IO
    fn js_dom_toggle_class(id: str, class: str) -> bool uses IO
    fn js_dom_set_style(id: str, prop: str, value: str) -> void uses IO
    fn js_dom_get_value(id: str) -> str uses IO
    fn js_dom_set_value(id: str, value: str) -> void uses IO
    fn js_dom_document_title() -> str uses IO
    fn js_dom_set_title(title: str) -> void uses IO

    # ---- math / random ----
    fn js_random() -> float uses IO
    fn js_random_int(max: int) -> int uses IO

    # ---- HTTP fetch (returns the response body as a str) ----
    fn js_fetch(url: str) -> str uses IO
    # Stage 73: fetch with an options JSON (method, headers, body).
    fn js_fetch_with_options(url: str, options_json: str) -> str uses IO

    # ---- localStorage (browser only) ----
    fn js_localstorage_get(key: str) -> str uses IO
    fn js_localstorage_set(key: str, val: str) -> void uses IO
    # Stage 73: removal, clearing, size.
    fn js_localstorage_remove(key: str) -> void uses IO
    fn js_localstorage_clear() -> void uses IO
    fn js_localstorage_key_count() -> int uses IO

    # ---- performance / timing ----
    fn js_now_ms() -> int uses IO
    fn js_set_timeout(ms: int) -> void uses IO
    # Stage 73: high-resolution timing + an ISO timestamp.
    fn js_performance_now() -> float uses IO
    fn js_date_now_iso() -> str uses IO

    # ---- JSON bridge (Stage 73) ----
    # js_json_canonical re-renders a JSON document in canonical form
    # (sorted-key-free, compact — std.json's exact formatting rules are
    # applied by the JS engine, so this is a round-trip check, not a
    # guarantee of byte-equality with the HLS renderer). Invalid input
    # yields "null".
    fn js_json_canonical(src: str) -> str uses IO
    # js_json_valid checks whether a string parses as JSON.
    fn js_json_valid(src: str) -> bool uses IO

    # ---- URL encoding (Stage 73) ----
    fn js_url_encode(s: str) -> str uses IO
    fn js_url_decode(s: str) -> str uses IO

    # ---- environment info (Stage 73) ----
    fn js_platform_name() -> str uses IO
    fn js_language() -> str uses IO
    fn js_online() -> bool uses IO
    fn js_user_agent() -> str uses IO
    fn js_screen_width() -> int uses IO
    fn js_screen_height() -> int uses IO
    fn js_alert(msg: str) -> void uses IO

    # ---- Stage 24: struct-marshalling entry points ----
    # The wasm ABI passes HLS structs as opaque i32 pointers; the JS
    # glue uses Halis.readStruct / Halis.writeStruct to convert. The
    # user's extern "js" function takes the pointer and calls
    # Halis.readStruct on the JS side. These three functions are the
    # HLS-side entry points to the JS-side helpers — they take a
    # struct pointer + a JS struct-name string and return a JS
    # value (as a str representation, since the wasm ABI can't return
    # arbitrary JS objects).
    #
    # Stage 73: the glue AUTO-REGISTERS every struct in the program
    # (the emitter exports hl_struct_descriptors() with the computed
    # layouts), so js_struct_to_json works for ANY declared struct
    # without manual Halis.registerStruct calls.
    fn js_struct_to_json(ptr: int, name: str) -> str uses IO
    fn js_json_to_struct(json: str, name: str) -> int uses IO
    fn js_call_with_struct(fn_name: str, ptr: int, name: str) -> int uses IO
}

# ============================================================================
# Stage 73: JS -> HLS callbacks — the bookkeeping helpers live in
# std.jsffi_callback (a SEPARATE module: std.jsffi must stay importable
# by the wasm32 target, whose emitter subset has no list/struct
# literals yet; the callback table is a native/C-backend convenience).
# See std/jsffi_callback.hls.
# ============================================================================

