# ============================================================================
# std.bits.hls — Bitwise helpers for Halis (Stage 14+ non-roadmap upgrade;
#                                                Stage 32 native-backed)
# ----------------------------------------------------------------------------
# HLS has no bitwise operators (&, |, ^, ~, <<, >>) in its grammar. The
# language core treats int as a mathematical int64 with checked arithmetic
# only. Many real programs (crypto, hashing, codec work, bit-packing) still
# need bit-level manipulation; rather than extend the language grammar,
# this module exposes the common bit operations as pure functions.
#
# Stage 32 (v0.51.0-alpha): the hot paths now delegate to the native
# bitwise builtins (int_and / int_or / int_xor / int_not / int_shl /
# int_shr / int_sar / int_popcount / int_clz / int_ctz). Each compiles
# to a SINGLE C operation (or a single __builtin_popcountll). The
# previous O(64) bit-by-bit emulation loops were the slowest functions
# in the stdlib microbench (1.2–3.9 µs/call); they now benchmark at
# <0.01 µs/call.
#
# All operations treat int as a 64-bit two's-complement value. Negative
# inputs use C-style wrap-around semantics: the bit pattern of -1 is
# 0xFFFFFFFFFFFFFFFF, etc. The helpers panic on negative shift counts
# (the SPEC's "every operation is checked" rule).
#
# All functions are pure (no `uses IO`).
#
# Helpers provided:
#   bits_pow2(k)           2^k for k in [0, 63]
#   bits_shl(x, n)         logical left shift  (x << n)
#   bits_shr(x, n)         logical right shift (unsigned: fills with 0)
#   bits_sar(x, n)         arithmetic right shift (sign-extending)
#   bits_and(a, b)         bitwise AND
#   bits_or(a, b)          bitwise OR
#   bits_xor(a, b)         bitwise XOR
#   bits_not(x)            bitwise NOT (one's complement)
#   bits_get(x, n)         extract bit n (0 = LSB) as 0 or 1
#   bits_set(x, n, v)      return x with bit n forced to v (0 or 1)
#   bits_popcount(x)       number of 1 bits (treats x as unsigned 64-bit)
#   bits_clz(x)            count leading zeros  (unsigned)
#   bits_ctz(x)            count trailing zeros (unsigned)
#   bits_byte(x, n)        extract byte n (0 = LSB) as 0..255
#   bits_bytes_be(x)       list of 8 bytes, big-endian (index 0 = MSB)
#   bits_bytes_le(x)       list of 8 bytes, little-endian (index 0 = LSB)
#   bits_from_bytes_be(bs) assemble 8 bytes (big-endian) back into an int64
#   bits_from_bytes_le(bs) assemble 8 bytes (little-endian) back into an int64
# ============================================================================

# ----------------------------------------------------------------------------
# Power-of-two (used everywhere; not memoised because HLS has no globals).
# ----------------------------------------------------------------------------
fn bits_pow2(k: int) -> int {
    # 2^k for k in [0, 63]. Stage 32 (v0.51.0-alpha): int_shl(1, k)
    # compiles to a single C operation `(1 << (k & 63))` and correctly
    # produces INT64_MIN for k == 63 (the previous checked-multiply
    # loop would have overflowed at the last iteration; the native
    # bitwise builtin has no such limitation).
    if k < 0 {
        panic("bits_pow2: negative exponent")
    }
    if k >= 64 {
        panic("bits_pow2: exponent out of range (max 63)")
    }
    return int_shl(1, k)
}

# ----------------------------------------------------------------------------
# Single-bit get / set — the foundation.
# ----------------------------------------------------------------------------
fn bits_get(x: int, n: int) -> int {
    if n < 0 {
        panic("bits_get: negative bit index")
    }
    if n >= 64 {
        panic("bits_get: bit index out of range (max 63)")
    }
    # Stage 32: (x >> n) & 1 — single C expression. For negative x,
    # int_shr masks to unsigned first (logical right shift), so the
    # result is always 0 or 1 regardless of x's sign.
    return int_and(int_shr(x, n), 1)
}

fn bits_set(x: int, n: int, v: int) -> int {
    if n < 0 {
        panic("bits_set: negative bit index")
    }
    if n >= 64 {
        panic("bits_set: bit index out of range (max 63)")
    }
    if v != 0 && v != 1 {
        panic("bits_set: value must be 0 or 1")
    }
    let cur: int = bits_get(x, n)
    if cur == v {
        return x
    }
    # Bit needs to flip. Arithmetic works for ANY x (positive or
    # negative) because the bit pattern of x with bit n toggled is
    # exactly x +/- 2^n in two's complement.
    if v == 1 {
        return x + bits_pow2(n)
    }
    return x - bits_pow2(n)
}

# ----------------------------------------------------------------------------
# Shifts — Stage 32: direct delegation to the native builtins.
# ----------------------------------------------------------------------------
fn bits_shl(x: int, n: int) -> int {
    if n < 0 {
        panic("bits_shl: negative shift count")
    }
    if n >= 64 {
        return 0
    }
    return int_shl(x, n)
}

fn bits_shr(x: int, n: int) -> int {
    # Logical right shift: fills with 0.
    if n < 0 {
        panic("bits_shr: negative shift count")
    }
    if n >= 64 {
        return 0
    }
    return int_shr(x, n)
}

fn bits_sar(x: int, n: int) -> int {
    # Arithmetic right shift: sign-extends.
    if n < 0 {
        panic("bits_sar: negative shift count")
    }
    if n >= 64 {
        if x < 0 {
            return -1
        }
        return 0
    }
    return int_sar(x, n)
}

# ----------------------------------------------------------------------------
# Bitwise AND / OR / XOR / NOT — Stage 32: single C operation each.
# ----------------------------------------------------------------------------
fn bits_and(a: int, b: int) -> int {
    return int_and(a, b)
}

fn bits_or(a: int, b: int) -> int {
    return int_or(a, b)
}

fn bits_xor(a: int, b: int) -> int {
    return int_xor(a, b)
}

fn bits_not(x: int) -> int {
    # ~x = -x - 1 (two's complement identity). Stage 32: direct
    # delegation to int_not (~x in C). No arithmetic-negation overflow
    # for x == INT64_MIN.
    return int_not(x)
}

# ----------------------------------------------------------------------------
# Population count, leading/trailing zeros — Stage 32: __builtin_*ll.
# ----------------------------------------------------------------------------
fn bits_popcount(x: int) -> int {
    return int_popcount(x)
}

fn bits_clz(x: int) -> int {
    # Count leading zeros (treats x as unsigned 64-bit). int_clz
    # returns 64 for x == 0 (matching the previous loop semantics).
    return int_clz(x)
}

fn bits_ctz(x: int) -> int {
    # Count trailing zeros (treats x as unsigned 64-bit). int_ctz
    # returns 64 for x == 0 (matching the previous loop semantics).
    return int_ctz(x)
}

# ----------------------------------------------------------------------------
# Byte helpers (a byte is 8 bits; n in [0, 7]).
# ----------------------------------------------------------------------------
fn bits_byte(x: int, n: int) -> int {
    if n < 0 {
        panic("bits_byte: negative byte index")
    }
    if n >= 8 {
        panic("bits_byte: byte index out of range (max 7)")
    }
    # Byte n is bits [8n, 8n+7]. Stage 32: single C expression.
    return int_and(int_shr(x, 8 * n), 255)
}

fn bits_bytes_be(x: int) -> list[int] {
    # Big-endian: index 0 is the MSB (byte 7).
    let out: list[int] = []
    let mut k: int = 7
    while k >= 0 {
        out.push(bits_byte(x, k))
        k = k - 1
    }
    return out
}

fn bits_bytes_le(x: int) -> list[int] {
    # Little-endian: index 0 is the LSB (byte 0).
    let out: list[int] = []
    let mut k: int = 0
    while k < 8 {
        out.push(bits_byte(x, k))
        k = k + 1
    }
    return out
}

fn bits_from_bytes_be(bs: list[int]) -> int {
    if bs.len() != 8 {
        panic("bits_from_bytes_be: list must have exactly 8 bytes")
    }
    # Stage 32: assemble via int_shl + int_or in a single accumulator.
    # Each byte is shifted to its MSB-first position (byte 0 → bits 56..63,
    # byte 7 → bits 0..7). The accumulator never overflows int64 because
    # int_or is bitwise (no arithmetic add), and the final result is the
    # correct two's-complement bit pattern.
    let mut r: int = 0
    let mut i: int = 0
    while i < 8 {
        let b: int = bs.get(i)
        if b < 0 || b > 255 {
            panic("bits_from_bytes_be: byte out of range (must be 0..255)")
        }
        # Byte i (MSB-first) occupies result bits (56 - 8*i) .. (63 - 8*i).
        r = int_or(r, int_shl(b, 56 - 8 * i))
        i = i + 1
    }
    return r
}

fn bits_from_bytes_le(bs: list[int]) -> int {
    if bs.len() != 8 {
        panic("bits_from_bytes_le: list must have exactly 8 bytes")
    }
    # Stage 32: same as bits_from_bytes_be but little-endian (byte 0 →
    # bits 0..7, byte 7 → bits 56..63).
    let mut r: int = 0
    let mut i: int = 0
    while i < 8 {
        let b: int = bs.get(i)
        if b < 0 || b > 255 {
            panic("bits_from_bytes_le: byte out of range (must be 0..255)")
        }
        r = int_or(r, int_shl(b, 8 * i))
        i = i + 1
    }
    return r
}
