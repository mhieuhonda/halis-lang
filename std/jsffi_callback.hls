# ============================================================================
# std/jsffi_callback.hls — Stage 73 (v0.92.0-alpha): JS -> HLS
# callback bookkeeping.
# ----------------------------------------------------------------------------
# Companion module to std.jsffi. The CALLBACK MECHANISM itself lives in
# the wasm backend: define
#
#     fn jsffi_on_callback(cb_id: int, arg: str) -> str { ... }
#
# in your program and `hlwasm` exports hl_call_halis; the JS glue's
# Halis.callHalis(cbId, json) lands in your function (the same
# handler_id dispatch pattern std.http_router uses — HLS has no
# function pointers, so the handler if/else chains on cb_id).
#
# THIS module provides the conventional bookkeeping: bind each cb_id
# to a semantic name + a description of the JSON protocol it speaks.
# It uses list/struct literals, so it targets the native/C backend
# (and the interpreter); the wasm32 emitter subset has no list/struct
# literals yet — wasm programs write their dispatch directly.
#
# Usage:
#   import "std.jsffi_callback"
#
#   fn jsffi_on_callback(cb_id: int, arg: str) -> str uses IO {
#       if cb_id == 1 { return "pong" }
#       return "{}"
#   }
#
#   fn main() -> int uses IO {
#       let table: list[JsffiCallback] = []
#       table.push(jsffi_callback_new(1, "ping", "returns 'pong'"))
#       println(jsffi_callback_describe(table))
#       return 0
#   }
#
# The JS side:
#   const out = await Halis.callHalis(1, "ping");
# ============================================================================

import "std.str"

# JsffiCallback — one row of the (conventional) callback table: a
# stable cb_id, its semantic name, and a description of the JSON
# protocol it speaks. Purely documentation/bookkeeping — the dispatch
# itself lives in the user's jsffi_on_callback.
struct JsffiCallback {
    cb_id: int,
    name: str,
    protocol: str
}

# jsffi_callback_new(cb_id, name, protocol) — build a table row.
fn jsffi_callback_new(cb_id: int, name: str, protocol: str)
    -> JsffiCallback {
    return JsffiCallback {
        cb_id: cb_id,
        name: name,
        protocol: protocol
    }
}

# jsffi_callback_find(callbacks, name) — index of the named row, -1.
fn jsffi_callback_find(callbacks: list[JsffiCallback], name: str) -> int {
    let mut i: int = 0
    while i < callbacks.len() {
        if callbacks.get(i).name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

# jsffi_callback_by_id(callbacks, cb_id) — index of the row with the
# given cb_id, or -1.
fn jsffi_callback_by_id(callbacks: list[JsffiCallback], cb_id: int) -> int {
    let mut i: int = 0
    while i < callbacks.len() {
        if callbacks.get(i).cb_id == cb_id {
            return i
        }
        i = i + 1
    }
    return -1
}

# jsffi_callback_describe(callbacks) — render the callback table as a
# human-readable protocol summary (one line per row).
fn jsffi_callback_describe(callbacks: list[JsffiCallback]) -> str {
    let lines: list[str] = []
    let mut i: int = 0
    while i < callbacks.len() {
        let c: JsffiCallback = callbacks.get(i)
        lines.push("cb_id " + c.cb_id.to_str() + " (" + c.name + "): "
            + c.protocol)
        i = i + 1
    }
    return str_join(lines, "\n")
}
