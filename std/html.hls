# ============================================================================
# std/html.hls — HTML escaping and basic helpers for Halis
# ----------------------------------------------------------------------------
# Pure-HLS utilities for web programming. All functions are pure.
# Essential for safely rendering user-supplied data into HTML pages.
# ============================================================================

import "std.str"

# html_escape(s) escapes &, <, >, ", ', / for safe inclusion in HTML
# text. The forward slash is escaped per OWASP recommendation (prevents
# closing tags inside quoted attributes). Returns the escaped string.
# BUG-12 fix: previously `/` was not escaped, contradicting the SPEC.md
# description of sanitize_html which lists `/` as one of the escaped
# characters.
fn html_escape(s: str) -> str {
    let out: list[str] = []
    let n: int = s.len()
    let mut i: int = 0
    while i < n {
        let c: int = s.byte_at(i)
        if c == 38 {
            out.push("&amp;")
        } else if c == 60 {
            out.push("&lt;")
        } else if c == 62 {
            out.push("&gt;")
        } else if c == 34 {
            out.push("&quot;")
        } else if c == 39 {
            out.push("&#39;")
        } else if c == 47 {
            # Forward slash — escape as &#x2F; per OWASP / SPEC.md.
            out.push("&#x2F;")
        } else {
            out.push(s.slice(i, i + 1))
        }
        i = i + 1
    }
    return str_join(out, "")
}

# html_escape_attr(s) escapes for use inside an HTML attribute value.
# Same as html_escape for now (covers the dangerous characters).
fn html_escape_attr(s: str) -> str {
    return html_escape(s)
}

# html_unescape(s) reverses the most common HTML entities.
# BUG-006 fix: decode `&amp;` LAST to avoid double-decoding when the input
# contains an escaped entity reference like `&amp;lt;` (which should decode
# to the literal text `&lt;`, not `<`). Previously decoding `&amp;` first
# turned `&amp;lt;` into `&lt;` which was then re-decoded to `<`.
# BUG-12 follow-up: also decode `&#x2F;` → `/` (the entity emitted by
# html_escape for the forward slash per OWASP).
fn html_unescape(s: str) -> str {
    let mut out: str = s
    out = str_replace(out, "&lt;", "<")
    out = str_replace(out, "&gt;", ">")
    out = str_replace(out, "&quot;", "\"")
    out = str_replace(out, "&#39;", "'")
    out = str_replace(out, "&apos;", "'")
    out = str_replace(out, "&#x2F;", "/")
    out = str_replace(out, "&nbsp;", " ")
    # `&amp;` must be decoded LAST so that `&amp;lt;` correctly round-trips
    # to `&lt;` (literal), not `<` (double-decoded).
    out = str_replace(out, "&amp;", "&")
    return out
}

# html_tag(name, attrs, content) builds an HTML element string.
# attrs is a map[str, str] of attribute name → value (values are HTML-escaped).
# content is HTML-escaped unless it is empty (then a void element is emitted).
# Deep-scan-15 fix (MEDIUM severity, XSS hardening): the previous
# implementation html-escaped attribute VALUES but interpolated the
# attribute KEY and the tag NAME verbatim. A user-controlled key like
# `onmouseover="alert(1)"` would then appear in the output verbatim,
# producing a valid element with an injected event handler. The same
# applies to the tag NAME (`script`, `img onerror=...`). Validate both
# against a strict allow-list: identifiers must match `[A-Za-z][A-Za-z0-
# 9_-]*` so no whitespace, quote, equals, or angle bracket can sneak in.
fn _html_validate_name(s: str) -> str {
    # Reject any name containing characters outside [A-Za-z0-9_-]; the
    # first character must be a letter. This blocks tag/attr injection
    # via `<`, `>`, ` `, `"`, `'`, `=`, `/`, etc.
    let n: int = s.len()
    if n == 0 {
        panic("html_tag: empty name")
    }
    let mut i: int = 0
    while i < n {
        let c: int = s.byte_at(i)
        let mut ok: bool = false
        if c >= 65 && c <= 90 { ok = true }    # A-Z
        if c >= 97 && c <= 122 { ok = true }  # a-z
        if i > 0 {
            if c >= 48 && c <= 57 { ok = true }   # 0-9 (non-leading)
            if c == 45 { ok = true }              # '-'
            if c == 95 { ok = true }              # '_'
        }
        if !ok {
            panic("html_tag: invalid character in name '" + s + "' (only [A-Za-z][A-Za-z0-9_-]* allowed)")
        }
        i = i + 1
    }
    return s
}

fn html_tag(name: str, attrs: map[str, str], content: str) -> str {
    # Validate the tag name (XSS hardening — see deep-scan-15 fix above).
    let safe_name: str = _html_validate_name(name)
    let mut s: str = "<" + safe_name
    let keys: list[str] = attrs.keys()
    let mut i: int = 0
    while i < keys.len() {
        let k: str = _html_validate_name(keys.get(i))
        let v: str = attrs.get_or(k, "")
        s = s + " " + k + "=\"" + html_escape_attr(v) + "\""
        i = i + 1
    }
    if content.len() == 0 {
        s = s + ">"
    } else {
        s = s + ">" + html_escape(content) + "</" + safe_name + ">"
    }
    return s
}

# html_text(s) escapes s for inclusion as text content. Same as html_escape
# but named for clarity at call sites.
fn html_text(s: str) -> str {
    return html_escape(s)
}
