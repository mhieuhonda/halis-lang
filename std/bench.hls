# ============================================================================
# std/bench.hls — the Halis benchmarking support (Stage 124, v0.142.0-alpha)
# ----------------------------------------------------------------------------
# Pure HLS, no `uses IO`. Provides the skip primitive used by the
# `hls-bench` runner (tools/hls-bench.py), the criterion-style
# micro-benchmark runner the roadmap's Stage 124 names.
#
# The benchmark convention (like hltest's test_ functions, expressed in
# naming because HLS has no attributes): a benchmark suite is a .hls
# file that defines no main — the runner is its program — and a
# benchmark is a top-level `fn bench_<name>()` taking no parameters.
# An optional companion `fn units_<name>() -> int` declares the work
# units one iteration consumes (the throughput denominator). The
# runner synthesizes a measurement driver per bench, runs it on the
# Stage-0 interpreter or through bin/hlc + gcc (--native), and computes
# the criterion-style statistics over the samples.
#
# On failure the skip primitive calls `panic(...)` with a reserved
# prefix that hls-bench recognises; `panic` is the language's clean
# termination primitive and does NOT require `uses IO`.
# ============================================================================


# --- benchmark metadata -----------------------------------------------------

# mark_skip: explicitly mark a benchmark as skipped by panicking with
# the reserved prefix `__HLBENCH_SKIP__: `. The hls-bench runner
# recognises this prefix and reports the bench as SKIP with the reason,
# rather than FAIL — a bench that cannot run meaningfully on this
# backend (a platform-specific code path, a benchmark that needs
# hardware the host lacks) declares that instead of failing the run.
#
# The function is named `mark_skip` rather than `bench_skip` so
# hls-bench — which discovers any top-level `bench_` function — does
# not pick it up as a benchmark itself; it is a helper FOR benchmarks,
# not one. (The same naming discipline as std.test.mark_skip.)
fn mark_skip(reason: str) {
    panic("__HLBENCH_SKIP__: " + reason)
}
