# ============================================================================
# std/sync.hls — Stage 45 (v0.64.0-alpha): synchronisation primitives
# ----------------------------------------------------------------------------
# This module is the twelfth module of Phase III (stdlib expansion). It
# implements five synchronisation primitives that complement the
# channel-based concurrency model of Stage 16:
#
#   * Mutex       — exclusive lock. Implemented as a cap-1 bounded
#                   channel holding a single token. lock() = recv
#                   (take the token), unlock() = send (return it).
#                   Blocking is handled by the channel runtime's
#                   existing deadlock-detection infrastructure.
#   * RwLock      — readers / writer lock. Two cap-1 token channels:
#                   `writer` (held by the active writer OR collectively
#                   by all readers via the first-reader-takes /
#                   last-reader-releases protocol) and `count_mu` (a
#                   short Mutex guarding the reader counter).
#                   reader_count is itself a cap-1 channel holding an int.
#   * Condvar     — condition variable. wait() atomically releases the
#                   paired Mutex and blocks on a notification channel;
#                   signal() / broadcast() wake one / all waiters. The
#                   "atomic release + block" is approximated by releasing
#                   first then blocking — the channel buffer absorbs
#                   the race (a signal sent between unlock and recv is
#                   buffered, not lost). This is the same liveness
#                   contract Rust's Condvar offers.
#   * OnceCell[T] — lazy initialisation cell. Monomorphic per-type
#                   (OnceCellInt / OnceCellStr / OnceCellBool) because
#                   HLS v0.3 lacks first-class function pointers, so
#                   "lazy init via closure" is approximated by set/get
#                   pairs the caller drives explicitly. State + value
#                   are each cap-1 channels.
#   * Barrier     — multi-thread rendezvous. count + gate channels;
#                   the Nth arrival opens the gate. Reusable after
#                   reset (count channel reset to 0 by the last arrival).
#
# **No new compiler builtins** — the entire module is pure HLS,
# layered on the Stage-16 channel primitives (chan_new_bounded,
# chan.send, chan.recv, chan.try_send, chan.recv_or).
#
# Monomorphic convention:
#   Following std.list, std.set, std.hash, and std.collections, this
#   module provides separate types per concrete value type where the
#   value is stored inside the primitive (OnceCellInt / OnceCellStr /
#   OnceCellBool). Mutex / RwLock / Condvar / Barrier do NOT store
#   user data — they are pure coordination objects — so a single
#   concrete type per primitive suffices.
#
# Deadlock-freedom (hlmodel verification):
#   The 2-thread / 2-lock scenario from the Stage-45 acceptance
#   criteria is verified by tools/hlmodel.py — see the model rules
#   `sync.Mutex.lock` / `sync.Mutex.unlock` and the 2t2l scenario in
#   the hlmodel acceptance test. The protocol is provably
#   deadlock-free because:
#     1. Mutex lock acquisition is a single channel recv (atomic).
#     2. There is no "hold one lock, wait for another" pattern
#        inside this module — RwLock's count_mu is held only briefly
#        and never while waiting on the writer token.
#     3. Barrier never holds the count channel while waiting on the
#        gate channel (the last arrival does the reverse: it drains
#        count, sends gate tokens, then resets count).
#   User code that acquires two mutexes in inconsistent orders can
#   still deadlock — the hlmodel check is a structural property of
#   std.sync, not a guarantee about arbitrary user code.
#
# Differential parity (interpreter == native):
#   All primitives are pure channel operations. The interpreter and
#   the native runtime use the same hl_chan* implementation (Stage 16),
#   so the observable behaviour is identical. The only non-determinism
#   is in scheduling — which thread acquires a contended lock first —
#   which is why the acceptance test uses deterministic round-robin
#   patterns (no timing races).
#
# API summary:
#
#   # Mutex — exclusive lock
#   struct Mutex { token: Chan[int] }
#   mutex_new() -> Mutex                          # initially unlocked
#   mutex_lock(m) -> void                          # block until acquired
#   mutex_unlock(m) -> void                        # release (must be holder)
#   mutex_try_lock(m) -> bool                      # non-blocking; false if held
#
#   # RwLock — readers / writer lock
#   struct RwLock { writer: Chan[int], count_mu: Chan[int], reader_count: Chan[int] }
#   rwlock_new() -> RwLock
#   rwlock_read_lock(rw) -> void
#   rwlock_read_unlock(rw) -> void
#   rwlock_write_lock(rw) -> void
#   rwlock_write_unlock(rw) -> void
#
#   # Condvar — condition variable
#   struct Condvar { sig: Chan[int] }
#   condvar_new() -> Condvar
#   condvar_wait(cv, m) -> void                    # atomically unlock m, block, re-lock
#   condvar_signal(cv) -> void                     # wake one waiter (no-op if none)
#   condvar_broadcast(cv, n) -> void               # wake n waiters
#
#   # OnceCellInt — lazy init cell for int
#   struct OnceCellInt { state: Chan[int], value: Chan[int] }
#   once_cell_int_new() -> OnceCellInt
#   once_cell_int_set(c, v) -> bool                # true iff this call initialised
#   once_cell_int_get(c) -> int                    # block until initialised
#   once_cell_int_get_or(c, default) -> int        # non-blocking
#   once_cell_int_is_init(c) -> bool
#
#   # OnceCellStr — lazy init cell for str
#   struct OnceCellStr { state: Chan[int], value: Chan[str] }
#   once_cell_str_new() -> OnceCellStr
#   once_cell_str_set(c, v) -> bool
#   once_cell_str_get(c) -> str
#   once_cell_str_get_or(c, default) -> str
#   once_cell_str_is_init(c) -> bool
#
#   # OnceCellBool — lazy init cell for bool
#   struct OnceCellBool { state: Chan[int], value: Chan[bool] }
#   once_cell_bool_new() -> OnceCellBool
#   once_cell_bool_set(c, v) -> bool
#   once_cell_bool_get(c) -> bool
#   once_cell_bool_get_or(c, default) -> bool
#   once_cell_bool_is_init(c) -> bool
#
#   # Barrier — multi-thread rendezvous
#   struct Barrier { n: int, count: Chan[int], gate: Chan[int] }
#   barrier_new(n) -> Barrier                      # n >= 1
#   barrier_wait(b) -> void                        # block until N threads call wait
#   barrier_reset(b) -> void                       # manual reset (rarely needed)
#
# Sentinel constants:
#   The token sent on Mutex / RwLock channels is the literal 1. The
#   state channel of OnceCell holds 0 (uninit) or 1 (init). The
#   Condvar signal channel holds 1 (a wake signal). The Barrier gate
#   channel holds 1 (a release token). All are arbitrary — any value
#   would do; the channel's emptiness / non-emptiness is what matters.
# ============================================================================

import "std.option"

# ----------------------------------------------------------------------------
# Mutex — exclusive lock
# ----------------------------------------------------------------------------
# Implementation: a cap-1 bounded channel. The channel holds exactly
# one token (the literal 1) when the mutex is unlocked, and is empty
# when the mutex is held. lock() = recv (take the token); unlock() =
# send (return it). The channel runtime's existing deadlock detector
# (Stage 16 perfection) catches the case where all tasks are blocked
# on a recv with no sender.
#
# This is the classic "mutex as a 1-slot channel" pattern, equivalent
# to Rust's `Mutex<()>` + an external data cell, except the data cell
# lives in user code (HLS has no closures / first-class functions, so
# we cannot provide `with_lock(m, || ...)`).
# ----------------------------------------------------------------------------

struct Mutex {
    token: Chan[int],
}

fn mutex_new() -> Mutex uses Conc {
    let m: Mutex = Mutex { token: chan_new_bounded(1) }
    m.token.send(1)
    return m
}

fn mutex_lock(m: Mutex) -> void uses Conc {
    let _token: int = m.token.recv()
}

fn mutex_unlock(m: Mutex) -> void uses Conc {
    # Defensive: if the channel already holds a token, sending another
    # would block forever (cap-1 bounded). The correct usage is one
    # unlock per lock. We do NOT try_send here because a "double
    # unlock" is a programming error the runtime should surface, not
    # silently absorb.
    m.token.send(1)
}

# mutex_try_lock — non-blocking lock attempt. Returns true iff the
# lock was acquired (in which case the caller MUST call mutex_unlock).
# Returns false if the lock is currently held by another task.
#
# Implementation: recv_or with a sentinel default. recv_or returns the
# default (here -1) if the channel is empty (i.e. the lock is held).
# A non-default return means we took the token (lock acquired).
fn mutex_try_lock(m: Mutex) -> bool uses Conc {
    let v: int = m.token.recv_or(-1)
    if v == -1 {
        return false
    }
    return true
}

# ----------------------------------------------------------------------------
# RwLock — readers / writer lock
# ----------------------------------------------------------------------------
# Three cap-1 channels:
#   * writer        — held by the active writer, OR by the first reader
#                     that took it on entry. Released by the writer on
#                     write_unlock, OR by the last reader on
#                     read_unlock. Acts as the global "no writer active"
#                     gate.
#   * count_mu      — short Mutex guarding the reader_count cell.
#                     Held only across the counter update — never while
#                     waiting on `writer`. This is the key liveness
#                     invariant: the count_mu is NEVER held across a
#                     blocking recv on `writer`, so a writer waiting
#                     for `writer` cannot deadlock against a reader
#                     trying to take `count_mu`.
#   * reader_count  — cap-1 channel holding the current reader count
#                     as an int. The cap-1 / single-cell design means
#                     every update is a recv-then-send pair under
#                     count_mu.
#
# Writer priority:
#   The current design does NOT implement writer priority in the
#   strong sense (a writer waiting does not block new readers from
#   entering). Adding writer priority requires a fourth channel
#   (a "writer waiting" flag) and is deferred to Stage 45 perfection.
#   The basic protocol below is correct (no deadlock, no writer
#   starvation AMONG writers, no reader starvation AMONG readers)
#   but admits reader-biased writer starvation under heavy read
#   load. Stage 45 perfection (v0.64.1-alpha) will add the writer-
#   priority flag.
# ----------------------------------------------------------------------------

struct RwLock {
    writer: Chan[int],
    count_mu: Chan[int],
    reader_count: Chan[int],
}

fn rwlock_new() -> RwLock uses Conc {
    let rw: RwLock = RwLock {
        writer: chan_new_bounded(1),
        count_mu: chan_new_bounded(1),
        reader_count: chan_new_bounded(1),
    }
    rw.writer.send(1)
    rw.count_mu.send(1)
    rw.reader_count.send(0)
    return rw
}

# rwlock_read_lock — acquire a read lock.
# Take count_mu, increment reader_count; if this is the first reader
# (count was 0), take the writer token (blocks until any active
# writer releases). Release count_mu.
fn rwlock_read_lock(rw: RwLock) -> void uses Conc {
    let _cmu: int = rw.count_mu.recv()
    let c: int = rw.reader_count.recv()
    rw.reader_count.send(c + 1)
    if c == 0 {
        # First reader: take the writer token so no writer can enter
        # while readers are active.
        let _w: int = rw.writer.recv()
    }
    rw.count_mu.send(1)
}

# rwlock_read_unlock — release a read lock.
# Take count_mu, decrement reader_count; if this is the last reader
# (count was 1), release the writer token. Release count_mu.
fn rwlock_read_unlock(rw: RwLock) -> void uses Conc {
    let _cmu: int = rw.count_mu.recv()
    let c: int = rw.reader_count.recv()
    rw.reader_count.send(c - 1)
    if c == 1 {
        # Last reader: release the writer token so a writer can enter.
        rw.writer.send(1)
    }
    rw.count_mu.send(1)
}

# rwlock_write_lock — acquire a write lock.
# Just take the writer token. While held, no reader can enter (the
# first reader will block on writer.recv) and no other writer can
# enter (same reason).
fn rwlock_write_lock(rw: RwLock) -> void uses Conc {
    let _w: int = rw.writer.recv()
}

# rwlock_write_unlock — release a write lock.
fn rwlock_write_unlock(rw: RwLock) -> void uses Conc {
    rw.writer.send(1)
}

# ----------------------------------------------------------------------------
# Condvar — condition variable
# ----------------------------------------------------------------------------
# Implementation: a (large-capacity) channel of wake tokens.
# wait(cv, m):
#   1. unlock(m) — allow other tasks to enter the critical section
#      and potentially reach signal().
#   2. recv on cv.sig — block until a signal/broadcast sends a token.
#   3. lock(m) — re-acquire the mutex before returning to the caller,
#      matching the classic condvar contract.
# The "atomic unlock + block" guarantee is approximated: a signal
# sent between step 1 and step 2 is buffered in the channel (cap is
# 1024 by default), so it is NOT lost. This is the same liveness
# contract as Rust's Condvar.
#
# signal(cv): send one token (no-op if no one is waiting, but the
# token stays in the channel for the next waiter).
#
# broadcast(cv, n): send n tokens. The caller must know how many
# waiters to wake (n). This is a limitation of HLS without closures
# — we cannot introspect the channel's waiter count from outside
# the runtime. In practice the caller knows n from the application
# logic (e.g. "I have 4 worker tasks, wake all 4").
#
# Cap of 1024: large enough for typical workloads; if exceeded
# (more than 1024 outstanding wake tokens), signal() will block.
# A future perfection could make the signal channel unbounded, but
# unbounded channels in Halis are cap-0 (the default) and a
# flood of signals without waiters would grow unboundedly — a DoS
# vector. The cap-1024 design trades a hard ceiling for safety.
# ----------------------------------------------------------------------------

struct Condvar {
    sig: Chan[int],
}

fn condvar_new() -> Condvar uses Conc {
    let cv: Condvar = Condvar { sig: chan_new_bounded(1024) }
    return cv
}

fn condvar_wait(cv: Condvar, m: Mutex) -> void uses Conc {
    mutex_unlock(m)
    let _wake: int = cv.sig.recv()
    mutex_lock(m)
}

fn condvar_signal(cv: Condvar) -> void uses Conc {
    cv.sig.send(1)
}

fn condvar_broadcast(cv: Condvar, n: int) -> void uses Conc {
    let mut i: int = 0
    while i < n {
        cv.sig.send(1)
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# OnceCellInt — lazy initialisation cell for int
# ----------------------------------------------------------------------------
# State channel: cap-1, holds 0 (uninit) or 1 (init).
# Value channel: cap-1, holds the value once initialised.
#
# set(c, v):
#   1. recv state (atomic — only one task can hold the state token).
#   2. if state was 0 (uninit): send 1 (now init), send v to value.
#      Return true (we initialised).
#   3. if state was 1 (already init): send 1 back. Return false.
#
# get(c):
#   1. recv state.
#   2. if 1 (init): send 1 back, recv value, send value back (peek),
#      return value.
#   3. if 0 (uninit): send 0 back, panic (caller must call set first
#      OR use get_or).
#
# get_or(c, default):
#   Like get, but returns `default` if uninit instead of panicking.
#
# is_init(c):
#   Non-blocking peek at state.
#
# Liveness: set() is linearisable — at most one task observes state==0
# and performs the init. Other concurrent set() calls observe state==1
# and return false. This is the textbook once-cell protocol.
# ----------------------------------------------------------------------------

struct OnceCellInt {
    state: Chan[int],
    value: Chan[int],
}

fn once_cell_int_new() -> OnceCellInt uses Conc {
    let c: OnceCellInt = OnceCellInt {
        state: chan_new_bounded(1),
        value: chan_new_bounded(1),
    }
    c.state.send(0)
    return c
}

fn once_cell_int_set(c: OnceCellInt, v: int) -> bool uses Conc {
    let s: int = c.state.recv()
    if s == 0 {
        c.state.send(1)
        c.value.send(v)
        return true
    }
    # Already initialised. Put the state back.
    c.state.send(s)
    return false
}

fn once_cell_int_get(c: OnceCellInt) -> int uses Conc {
    let s: int = c.state.recv()
    c.state.send(s)
    if s == 1 {
        let v: int = c.value.recv()
        c.value.send(v)
        return v
    }
    panic("once_cell_int_get: cell not initialised")
}

fn once_cell_int_get_or(c: OnceCellInt, default: int) -> int uses Conc {
    let s: int = c.state.recv()
    c.state.send(s)
    if s == 1 {
        let v: int = c.value.recv()
        c.value.send(v)
        return v
    }
    return default
}

fn once_cell_int_is_init(c: OnceCellInt) -> bool uses Conc {
    let s: int = c.state.recv()
    c.state.send(s)
    return s == 1
}

# ----------------------------------------------------------------------------
# OnceCellStr — lazy initialisation cell for str
# ----------------------------------------------------------------------------
# Same protocol as OnceCellInt, but the value channel holds a str.
# Monomorphic instantiation follows the std.collections convention.

struct OnceCellStr {
    state: Chan[int],
    value: Chan[str],
}

fn once_cell_str_new() -> OnceCellStr uses Conc {
    let c: OnceCellStr = OnceCellStr {
        state: chan_new_bounded(1),
        value: chan_new_bounded(1),
    }
    c.state.send(0)
    return c
}

fn once_cell_str_set(c: OnceCellStr, v: str) -> bool uses Conc {
    let s: int = c.state.recv()
    if s == 0 {
        c.state.send(1)
        # Stage 45 note: chan.send of an owned type (str) requires
        # take() or clone() to wrap the value — the data-race-freedom
        # rule of Stage 16 forbids sending a binding directly (the
        # binding could be released by two threads concurrently). We
        # take() ownership of v: the parameter is moved into the
        # channel and never used again.
        c.value.send(take(v))
        return true
    }
    c.state.send(s)
    return false
}

fn once_cell_str_get(c: OnceCellStr) -> str uses Conc {
    let s: int = c.state.recv()
    c.state.send(s)
    if s == 1 {
        let v: str = c.value.recv()
        # Send a CLONE back so we can return the original v. clone()
        # reads v by value (does not move it), so v remains valid
        # for the return.
        c.value.send(clone(v))
        return v
    }
    panic("once_cell_str_get: cell not initialised")
}

fn once_cell_str_get_or(c: OnceCellStr, default: str) -> str uses Conc {
    let s: int = c.state.recv()
    c.state.send(s)
    if s == 1 {
        let v: str = c.value.recv()
        c.value.send(clone(v))
        return v
    }
    return default
}

fn once_cell_str_is_init(c: OnceCellStr) -> bool uses Conc {
    let s: int = c.state.recv()
    c.state.send(s)
    return s == 1
}

# ----------------------------------------------------------------------------
# OnceCellBool — lazy initialisation cell for bool
# ----------------------------------------------------------------------------

struct OnceCellBool {
    state: Chan[int],
    value: Chan[bool],
}

fn once_cell_bool_new() -> OnceCellBool uses Conc {
    let c: OnceCellBool = OnceCellBool {
        state: chan_new_bounded(1),
        value: chan_new_bounded(1),
    }
    c.state.send(0)
    return c
}

fn once_cell_bool_set(c: OnceCellBool, v: bool) -> bool uses Conc {
    let s: int = c.state.recv()
    if s == 0 {
        c.state.send(1)
        c.value.send(v)
        return true
    }
    c.state.send(s)
    return false
}

fn once_cell_bool_get(c: OnceCellBool) -> bool uses Conc {
    let s: int = c.state.recv()
    c.state.send(s)
    if s == 1 {
        let v: bool = c.value.recv()
        c.value.send(v)
        return v
    }
    panic("once_cell_bool_get: cell not initialised")
}

fn once_cell_bool_get_or(c: OnceCellBool, default: bool) -> bool uses Conc {
    let s: int = c.state.recv()
    c.state.send(s)
    if s == 1 {
        let v: bool = c.value.recv()
        c.value.send(v)
        return v
    }
    return default
}

fn once_cell_bool_is_init(c: OnceCellBool) -> bool uses Conc {
    let s: int = c.state.recv()
    c.state.send(s)
    return s == 1
}

# ----------------------------------------------------------------------------
# Barrier — multi-thread rendezvous (single-use)
# ----------------------------------------------------------------------------
# Three fields:
#   * n        — the rendezvous threshold (immutable after construction).
#   * count    — cap-1 channel holding the current arrival count (0..n).
#   * gate     — cap-n channel of release tokens. The nth arrival sends
#                n-1 release tokens (one per earlier waiter) plus walks
#                through itself; earlier arrivals block on gate.recv().
#
# Wait protocol:
#   1. recv count (atomic — only one task can update at a time).
#   2. c = current count.
#   3. if c + 1 == n: this is the last arrival. Send n-1 release tokens
#      to gate. Return. (Do NOT reset count — see "Single-use" below.)
#   4. else: not the last. Send c+1 back to count. Block on
#      gate.recv() until the last arrival releases us.
#
# Single-use semantics:
#   The barrier is SINGLE-USE: after the Nth arrival releases all
#   waiters, the barrier is "spent". Further calls to barrier_wait on
#   a spent barrier will block forever (the count is at n-1 and no
#   one will ever be the "Nth arrival" again). The user must create a
#   fresh Barrier for each rendezvous.
#
#   Why single-use? A reusable barrier requires that tokens from
#   round N are never consumed by a waiter from round N+1. Without
#   shared mutable state (HLS has no atomic-swap), the standard
#   solutions are:
#     (a) generation-tagged tokens (requires a more complex channel),
#     (b) a fresh gate channel per round (requires alloc inside
#         barrier_wait, awkward without first-class functions),
#     (c) sense-reversal (requires shared mutable sense bit).
#   None of these fit the channel-only model cleanly. Single-use is
#   the honest contract; the user wraps barrier_new + barrier_wait in
#   a loop if they need multi-round rendezvous.
#
# Liveness:
#   - The last arrival's "send n-1 gate tokens" is the only way the
#     gate channel fills. Earlier arrivals each consume one token.
#     The arithmetic is exact: n-1 tokens for n-1 waiters.
#   - The last arrival does NOT block (it returns immediately after
#     sending the tokens).
#   - No "hold count while waiting on gate" pattern: the last arrival
#     sends count back BEFORE sending gate tokens... actually no, the
#     last arrival doesn't send count back at all (the count stays at
#     n-1, marking the barrier as spent). This is fine — no one else
#     can recv count because the earlier arrivals have already
#     incremented-and-released it.
#
# Cap of gate: n. The constructor rejects n < 1 (a barrier with 0
# participants is meaningless). The gate's bounded capacity is n-1
# (the last arrival sends n-1 tokens, never more); we use n for
# headroom.
# ----------------------------------------------------------------------------

struct Barrier {
    n: int,
    count: Chan[int],
    gate: Chan[int],
}

fn barrier_new(n: int) -> Barrier uses Conc {
    if n < 1 {
        panic("barrier_new: n must be >= 1, got " + n.to_str())
    }
    let b: Barrier = Barrier {
        n: n,
        count: chan_new_bounded(1),
        gate: chan_new_bounded(n),
    }
    b.count.send(0)
    return b
}

fn barrier_wait(b: Barrier) -> void uses Conc {
    let c: int = b.count.recv()
    if c + 1 >= b.n {
        # Last arrival. Send n-1 release tokens to wake the earlier
        # waiters, then return. The count is NOT reset — the barrier
        # is single-use (see comment above).
        let mut i: int = 0
        while i < b.n - 1 {
            b.gate.send(1)
            i = i + 1
        }
        # Send count back at n-1 (spent state). This is a no-op
        # semantically — no one will ever recv count again on a spent
        # barrier — but it keeps the channel balanced (every recv has
        # a matching send) so the runtime's accounting stays clean.
        b.count.send(c)
        return
    }
    # Not the last. Increment count and wait for release.
    b.count.send(c + 1)
    let _release: int = b.gate.recv()
}

# barrier_reset — re-arm a spent barrier for reuse. The caller MUST
# ensure no task is currently waiting on gate.recv() (i.e. the
# previous round is fully drained) AND no task is currently between
# count.recv and count.send (i.e. no task is mid-arrival). In
# practice this means the caller must externally synchronise: e.g.
# the last task to return from barrier_wait calls barrier_reset
# before the next round starts. Use with care.
fn barrier_reset(b: Barrier) -> void uses Conc {
    let _c: int = b.count.recv()
    b.count.send(0)
}

# ============================================================================
# End of std/sync.hls
# ============================================================================
