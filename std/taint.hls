# ============================================================================
# std/taint.hls — Taint helpers for Halis (Stage 10-alpha, v0.7.0-alpha)
# ----------------------------------------------------------------------------
# A small helper module layered on top of the built-in `tainted[T]` type and
# the three taint builtins:
#   * tainted_args()        -> list[tainted[str]]   (each argv is tainted)
#   * taint_mark(x: T)      -> tainted[T]          (wrap any value as tainted)
#   * taint_unwrap(x: tainted[T]) -> T             (the explicit "I accept
#     the risk" escape hatch — also what the sanitizer helpers below use
#     internally after they have neutralised the dangerous characters)
#
# The checker statically rejects passing a `tainted[T]` value to a sink
# (print, println, read_file, write_file, exit, file_exists) — the user
# must sanitise first. This module provides:
#   * taint_check_len / taint_check_is_empty — pure queries on a tainted
#     string that DO NOT expose the inner string to the caller (the inner
#     str is unwrapped locally to perform the query, but the result is
#     either a non-string type like int/bool, or a re-tainted str — so
#     the caller never receives a CLEAN `str` that could be passed to a
#     sink).
#   * taint_slice — extract a substring; the result REMAINS tainted.
#
# All functions here are pure (no `uses IO`).
# ============================================================================

# taint_check_len(t) returns the byte length of the inner string. The
# taint is preserved from the caller's perspective — the inner str is
# unwrapped locally inside this function but only the int length is
# returned to the caller (an int cannot be a taint vector for the
# string sinks the checker protects).
fn taint_check_len(t: tainted[str]) -> int {
    let inner: str = taint_unwrap(t)
    return inner.len()
}

# taint_check_is_empty(t) returns true if the inner string is empty.
fn taint_check_is_empty(t: tainted[str]) -> bool {
    let inner: str = taint_unwrap(t)
    return inner.len() == 0
}

# taint_check_starts_with(t, prefix) — pure prefix test on the inner
# string. Useful for routing (e.g. "/admin" prefix) without exposing
# the rest of the string to a sink.
fn taint_check_starts_with(t: tainted[str], prefix: str) -> bool {
    let inner: str = taint_unwrap(t)
    return inner.starts_with(prefix)
}

# taint_check_ends_with(t, suffix) — pure suffix test.
fn taint_check_ends_with(t: tainted[str], suffix: str) -> bool {
    let inner: str = taint_unwrap(t)
    return inner.ends_with(suffix)
}

# taint_check_equals(t, literal) — pure equality test with a literal
# string. The result is a bool, so no taint propagation.
fn taint_check_equals(t: tainted[str], literal: str) -> bool {
    let inner: str = taint_unwrap(t)
    return inner == literal
}

# taint_check_contains(t, sub) — pure substring test.
fn taint_check_contains(t: tainted[str], sub: str) -> bool {
    let inner: str = taint_unwrap(t)
    return inner.contains(sub)
}

# taint_slice(t, start, end) — extract a substring; the result REMAINS
# tainted (a slice of attacker-controlled bytes is still attacker-
# controlled bytes).
fn taint_slice(t: tainted[str], start: int, end: int) -> tainted[str] {
    let inner: str = taint_unwrap(t)
    return taint_mark(inner.slice(start, end))
}

# taint_check_byte_at(t, i) — pure byte-at-index query. Returns an int
# (the byte value at position i). The int is not a taint vector for any
# sink, so it does not need to be re-tainted.
fn taint_check_byte_at(t: tainted[str], i: int) -> int {
    let inner: str = taint_unwrap(t)
    if i < 0 || i >= inner.len() {
        panic("taint_check_byte_at: index out of bounds")
    }
    return inner.byte_at(i)
}

# taint_concat(t1, t2) — concatenate two tainted strings. The result
# REMAINS tainted (combining two attacker-controlled strings yields
# an attacker-controlled string).
fn taint_concat(t1: tainted[str], t2: tainted[str]) -> tainted[str] {
    let a: str = taint_unwrap(t1)
    let b: str = taint_unwrap(t2)
    return taint_mark(a + b)
}

# taint_concat_clean(t, clean) — concatenate a tainted string with a
# clean literal string. The result REMAINS tainted (any suffix/prefix
# added to attacker-controlled content does not neutralise it).
fn taint_concat_clean(t: tainted[str], clean: str) -> tainted[str] {
    let inner: str = taint_unwrap(t)
    return taint_mark(inner + clean)
}
