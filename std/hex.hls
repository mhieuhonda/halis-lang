# ============================================================================
# std/hex.hls — Hexadecimal encode / decode for Hieu Louis
# ----------------------------------------------------------------------------
# Pure-HLS utilities for working with hex strings. All functions are pure
# (no `uses IO`) so they can be used in any context — including inside the
# compiler `hlc` itself.
#
# Two operations:
#   * hex_encode(bytes)   -> lowercase hex string
#   * hex_decode(hex_str) -> bytes  (panics on malformed input)
# Plus a helper:
#   * hex_byte(b)         -> two-character hex of a single byte (0..255)
# ============================================================================

import "std.str"

# hex_byte(b) returns the two-character lowercase hex representation of b.
# Panics if b is outside 0..255.
fn hex_byte(b: int) -> str {
    if b < 0 || b > 255 {
        panic("hex_byte: byte out of range 0..255")
    }
    let hi: int = b / 16
    let lo: int = b % 16
    return hex_nibble(hi) + hex_nibble(lo)
}

# hex_nibble(n) returns one hex digit for n in 0..15.
fn hex_nibble(n: int) -> str {
    if n < 10 {
        return chr(48 + n)
    }
    return chr(97 + (n - 10))
}

# hex_encode(s) returns the lowercase hex representation of every byte in s.
fn hex_encode(s: str) -> str {
    let n: int = s.len()
    let out: list[str] = []
    let mut i: int = 0
    while i < n {
        out.push(hex_byte(s.byte_at(i)))
        i = i + 1
    }
    return str_join(out, "")
}

# hex_digit(b) decodes one hex digit byte to 0..15. Returns -1 on bad input.
fn hex_digit(b: int) -> int {
    if b >= 48 && b <= 57 {
        return b - 48
    }
    if b >= 65 && b <= 70 {
        return b - 55
    }
    if b >= 97 && b <= 102 {
        return b - 87
    }
    return -1
}

# hex_decode(s) decodes a lowercase / uppercase hex string back to bytes.
# Panics on odd length or non-hex characters.
fn hex_decode(s: str) -> str {
    let n: int = s.len()
    if n % 2 != 0 {
        panic("hex_decode: odd length")
    }
    if n == 0 {
        return ""
    }
    let out: list[str] = []
    let mut i: int = 0
    while i + 1 < n {
        let hi: int = hex_digit(s.byte_at(i))
        let lo: int = hex_digit(s.byte_at(i + 1))
        if hi < 0 || lo < 0 {
            panic("hex_decode: invalid hex digit")
        }
        out.push(chr(hi * 16 + lo))
        i = i + 2
    }
    return str_join(out, "")
}
