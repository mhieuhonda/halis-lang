# ============================================================================
# std/hlsdoc.hls — Stage 61 (v0.82.0-alpha): rustdoc-style API docs generator
# ----------------------------------------------------------------------------
# This module is the NINTH module of Phase IV (the CLI tooling track,
# Stages 53–62). It implements the roadmap's Stage 61 promise:
#
#   * A `rustdoc`-style API doc generator. Reads `///` doc comments (HLS
#     uses `#` for comments; the doc-comment convention is `##` for
#     section headers and a leading `# ` on a comment line for a doc
#     paragraph — but we ALSO support the standard `///` triple-slash
#     convention for compatibility with editors that highlight it).
#   * Produces HTML with cross-references, search index, type signatures.
#   * Output is static HTML (no JS runtime required).
#
# Design choices (matching the roadmap's "rustdoc-style"):
#
#   1. PARSE HLS SOURCE.
#      The doc generator parses HLS source files (a simplified parser
#      that extracts top-level declarations: `fn`, `struct`, `enum`,
#      `impl`, plus their doc comments). It does NOT do full type
#      checking (the compiler already did that); it just extracts the
#      signature + the doc comment above each declaration.
#
#   2. DOC COMMENT CONVENTION.
#      HLS uses `#` for line comments (like Python / shell). The doc-
#      comment convention is:
#        - A contiguous block of `#` comment lines IMMEDIATELY above
#          a declaration forms that declaration's doc comment.
#        - The `#` and one optional space are stripped from each line.
#        - Blank comment lines (`#` alone) become paragraph breaks.
#        - Lines starting with `# ` (hash space) are doc; lines
#          starting with `##` (hash hash) are section headers within
#          the doc (rendered as <h3> in HTML).
#      This is the simplest convention that fits HLS's existing comment
#      syntax (the codebase already uses `#` for all comments; the
#      doc generator doesn't introduce a new syntax).
#
#   3. CROSS-REFERENCES.
#      Doc comments can contain `[name]` inline links. The generator
#      resolves `name` against the module's declared items (functions,
#      structs, enums). If `name` matches a declared item, the `[name]`
#      becomes an `<a href="#name">name</a>` link. If not, it's left as
#      literal text (no broken links).
#
#   4. SEARCH INDEX.
#      The generator emits a `search.js` file containing a JSON array
#      of {name, kind, signature, anchor} entries. A small `<script>`
#      in the HTML reads this file and implements client-side search
#      (the script is ~50 lines of vanilla JS — no runtime framework,
#      matching the "static HTML, no JS runtime required" promise).
#
#   5. PURE-HLS PARSER + HTML RENDERER.
#      The parser (`hlsdoc_parse_module`) is a pure function: given a
#      source string, it returns a `DocModule` (a list of `DocItem`s).
#      The renderer (`hlsdoc_render_html`) is also pure: given a
#      `DocModule`, it returns the HTML as a str. This makes the
#      generator differential-safe (interpreter == native produce
#      byte-identical HTML).
#
#   6. NO NEW COMPILER BUILTINS.
#      The module is pure-HLS on top of std.str, std.option,
#      std.result. The only builtin used is `write_file` (Fs effect)
#      for `hlsdoc_write_html` (writes the HTML to disk).
#
# Security:
#   * All user-controlled text (doc comments, function names, type
#     signatures) is HTML-escaped via `hlsdoc_escape_html` before
#     being embedded in the output. A malicious doc comment cannot
#     inject `<script>` tags or other HTML.
#   * The cross-reference resolver only links to names that are
#     declared in the SAME module (no external lookups, no SSRF).
#   * The search index is generated by the renderer (not user-
#     supplied), so it's safe.
#   * No shell invocation: `hlsdoc_write_html` writes files directly
#     via `write_file`.
#
# Differential parity (interpreter == native):
#   The parser and renderer are pure functions of the source string.
#   The interpreter and the native binary produce byte-identical HTML.
#
# Limitations (deferred to later stages):
#   * No cross-module links (a doc comment in module A can't link to
#     an item in module B). A future stage may add a module-qualified
#     `[std.str::join]` syntax.
#   * No markdown support (the doc comments are rendered as preformatted
#     text with paragraph breaks; bold / italic / lists are NOT
#     supported). A future stage may add a markdown subset.
#   * No type-signature rendering for generics (a `fn foo[T](x: T) -> T`
#     is rendered verbatim; the type parameter `T` is not hyperlinked
#     to its declaration). A future stage may add type cross-references.
#   * No sidebar navigation (the items are listed in declaration order;
#     a future stage may add a sidebar with grouped sections).
#   * No source-view links (rustdoc links each item to its source line;
#     this generator doesn't read line numbers — a future stage may
#     add them).
# ============================================================================

import "std.str"
import "std.option"
import "std.result"

# ----------------------------------------------------------------------------
# Constants — doc item kinds.
# ----------------------------------------------------------------------------

fn hlsdoc_kind_fn() -> int { return 0 }
fn hlsdoc_kind_struct() -> int { return 1 }
fn hlsdoc_kind_enum() -> int { return 2 }
fn hlsdoc_kind_impl() -> int { return 3 }
fn hlsdoc_kind_const() -> int { return 4 }

# hlsdoc_kind_name(kind) -> str — human-readable name.
fn hlsdoc_kind_name(kind: int) -> str {
    if kind == hlsdoc_kind_fn() { return "fn" }
    if kind == hlsdoc_kind_struct() { return "struct" }
    if kind == hlsdoc_kind_enum() { return "enum" }
    if kind == hlsdoc_kind_impl() { return "impl" }
    if kind == hlsdoc_kind_const() { return "const" }
    return "item"
}

# ----------------------------------------------------------------------------
# DocItem — a single documented declaration. The `signature` is the
# verbatim source line (e.g., `fn foo(x: int) -> int`); the `doc` is
# the doc comment above it (one paragraph per blank-comment-line).
# ----------------------------------------------------------------------------

struct DocItem {
    kind: int,           # one of hlsdoc_kind_*
    name: str,           # the declared name (e.g., "foo")
    signature: str,      # the verbatim source line
    doc: str,            # the doc comment (markdown-like, but we render as preformatted)
    line: int,           # the source line number (1-based)
}

# ----------------------------------------------------------------------------
# DocModule — a parsed module. A list of DocItems + the module's name.
# ----------------------------------------------------------------------------

struct DocModule {
    name: str,           # the module name (e.g., "std.cli")
    items: list[DocItem],
    source_path: str,    # the source file path (for the "source" link)
}

# ============================================================================
# PARSER — hlsdoc_parse_module(name, source) -> DocModule.
#
# Walks the source line-by-line. Tracks the current doc-comment buffer
# (a list of strings). When a declaration line is found (`fn `, `struct `,
# `enum `, `impl `), the buffered doc comment is attached to the new
# DocItem and the buffer is cleared.
# ============================================================================

fn hlsdoc_parse_module(name: str, source: str) -> DocModule {
    let lines: list[str] = source.split("\n")
    let items: list[DocItem] = []
    let mut doc_buffer: list[str] = []
    # Brace-depth tracking. `brace_depth` is the depth AT THE START of
    # the current line (i.e., BEFORE counting this line's braces). We
    # use this to decide whether the current line is inside a block
    # (and thus should NOT be parsed as a top-level declaration).
    let mut brace_depth: int = 0
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        let trimmed: str = hlsdoc_trim_left(line)
        # `in_block` = brace_depth > 0 at the start of this line.
        let in_block: bool = brace_depth > 0
        # Doc comment line: starts with '#' (but not '#!' which is a
        # shebang-style attribute, and not '##' which we treat as a
        # section header WITHIN the doc).
        if hlsdoc_starts_with(line, "# ") || line == "#" {
            # Doc comments inside an impl block are method docs — we
            # DON'T capture them (the impl is treated as one DocItem;
            # its methods are not separately documented in v0.82.0-alpha).
            if !in_block {
                let doc_line: str = hlsdoc_strip_doc_prefix(line)
                doc_buffer.push(doc_line)
            }
            # Update brace_depth (a '#' comment line has no braces, but
            # we update for consistency).
            brace_depth = brace_depth + hlsdoc_count_char(line, 123) - hlsdoc_count_char(line, 125)
            i = i + 1
            continue
        }
        # Section header within doc: '## ' — also a doc comment. We
        # treat '## ' as a paragraph break (so the section header
        # becomes its own paragraph, which the renderer can detect
        # via starts_with(text, "## ")).
        if hlsdoc_starts_with(line, "## ") {
            if !in_block {
                # Flush the current doc buffer as a paragraph boundary
                # (by appending a blank line, which the renderer's
                # split_paragraphs will treat as a paragraph break).
                doc_buffer.push("")
                let doc_line: str = hlsdoc_strip_doc_prefix_section(line)
                doc_buffer.push(doc_line)
                # Also append a blank line AFTER the header, so the
                # header is its own paragraph (the following text starts
                # a new paragraph).
                doc_buffer.push("")
            }
            brace_depth = brace_depth + hlsdoc_count_char(line, 123) - hlsdoc_count_char(line, 125)
            i = i + 1
            continue
        }
        # Non-comment line. If we're NOT inside a block, try to parse
        # it as a declaration.
        if !in_block {
            let decl: DocItem = hlsdoc_parse_decl(line, doc_buffer, i + 1)
            if decl.kind >= 0 {
                items.push(decl)
                doc_buffer = []
            } else if trimmed.len() > 0 && !hlsdoc_starts_with(line, "#") {
                # A non-comment, non-declaration line clears the doc buffer.
                doc_buffer = []
            }
        }
        # Update brace_depth AFTER processing the line (so the next
        # iteration sees the correct depth).
        brace_depth = brace_depth + hlsdoc_count_char(line, 123) - hlsdoc_count_char(line, 125)
        i = i + 1
    }
    return DocModule {
        name: name,
        items: items,
        source_path: "",
    }
}

# hlsdoc_count_char(s, ch) -> int — count occurrences of byte `ch` in s.
fn hlsdoc_count_char(s: str, ch: int) -> int {
    let mut count: int = 0
    let n: int = s.len()
    let mut i: int = 0
    while i < n {
        if s.byte_at(i) == ch {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

# ----------------------------------------------------------------------------
# hlsdoc_parse_decl(line, doc_buffer, line_no) -> DocItem — try to parse
# `line` as a declaration. Returns DocItem{kind: -1, ...} if the line is
# not a declaration.
# ----------------------------------------------------------------------------

fn hlsdoc_parse_decl(line: str, doc_buffer: list[str], line_no: int) -> DocItem {
    let trimmed: str = hlsdoc_trim_left(line)
    let doc: str = str_join(doc_buffer, "\n")
    # fn name(...).
    if hlsdoc_starts_with(trimmed, "fn ") {
        let name: str = hlsdoc_extract_name(trimmed, 3)
        return DocItem {
            kind: hlsdoc_kind_fn(),
            name: name,
            signature: trimmed,
            doc: doc,
            line: line_no,
        }
    }
    # struct name {.
    if hlsdoc_starts_with(trimmed, "struct ") {
        let name: str = hlsdoc_extract_name(trimmed, 7)
        return DocItem {
            kind: hlsdoc_kind_struct(),
            name: name,
            signature: trimmed,
            doc: doc,
            line: line_no,
        }
    }
    # enum name {.
    if hlsdoc_starts_with(trimmed, "enum ") {
        let name: str = hlsdoc_extract_name(trimmed, 5)
        return DocItem {
            kind: hlsdoc_kind_enum(),
            name: name,
            signature: trimmed,
            doc: doc,
            line: line_no,
        }
    }
    # impl name {.
    if hlsdoc_starts_with(trimmed, "impl ") {
        let name: str = hlsdoc_extract_name(trimmed, 5)
        return DocItem {
            kind: hlsdoc_kind_impl(),
            name: name,
            signature: trimmed,
            doc: doc,
            line: line_no,
        }
    }
    return DocItem { kind: -1, name: "", signature: "", doc: "", line: 0 }
}

# ----------------------------------------------------------------------------
# hlsdoc_extract_name(line, prefix_len) -> str — extract the declared
# name from a declaration line. The name is the first token after the
# prefix (`fn `, `struct `, etc.). It ends at the first `(`, `<`, `{`,
# ` `, or `:`.
# ----------------------------------------------------------------------------

fn hlsdoc_extract_name(line: str, prefix_len: int) -> str {
    let n: int = line.len()
    let mut i: int = prefix_len
    # Skip leading whitespace.
    while i < n && line.byte_at(i) == 32 {
        i = i + 1
    }
    let start: int = i
    while i < n {
        let b: int = line.byte_at(i)
        if b == 40 || b == 60 || b == 123 || b == 91 || b == 32 || b == 58 {
            break
        }
        i = i + 1
    }
    return line.slice(start, i)
}

# ----------------------------------------------------------------------------
# hlsdoc_strip_doc_prefix(line) -> str — strip the leading '# ' (or '#')
# from a doc-comment line.
# ----------------------------------------------------------------------------

fn hlsdoc_strip_doc_prefix(line: str) -> str {
    let n: int = line.len()
    if n == 0 {
        return ""
    }
    if line.byte_at(0) != 35 {
        return line
    }
    # Strip the '#'.
    let rest: str = line.slice(1, n)
    # Strip one optional leading space.
    if rest.len() > 0 && rest.byte_at(0) == 32 {
        return rest.slice(1, rest.len())
    }
    return rest
}

# hlsdoc_strip_doc_prefix_section(line) -> str — for '## ' lines, KEEP
# the '##' prefix (so the renderer can detect the section header). We
# only strip the leading '# ' (one hash + one space), leaving '## title'
# -> '# title' — wait, that's wrong. Let me think again.
# Actually: the input is '## Examples'. We want to KEEP '## Examples'
# verbatim (the renderer's render_doc_paragraph checks `starts_with(text,
# "## ")`). So we should NOT strip anything — return the line as-is.
fn hlsdoc_strip_doc_prefix_section(line: str) -> str {
    return line
}

# ----------------------------------------------------------------------------
# hlsdoc_trim_left(line) -> str — strip leading whitespace.
# ----------------------------------------------------------------------------

fn hlsdoc_trim_left(line: str) -> str {
    let n: int = line.len()
    let mut i: int = 0
    while i < n {
        let b: int = line.byte_at(i)
        if b != 32 && b != 9 {
            break
        }
        i = i + 1
    }
    return line.slice(i, n)
}

# ----------------------------------------------------------------------------
# hlsdoc_starts_with(s, prefix) -> bool — true if s starts with prefix.
# ----------------------------------------------------------------------------

fn hlsdoc_starts_with(s: str, prefix: str) -> bool {
    return s.starts_with(prefix)
}

# ============================================================================
# HTML RENDERER — hlsdoc_render_html(module) -> str.
#
# Emits a complete HTML page:
#   <head> — meta charset, title, a small <style> block.
#   <body> — the module header, the items list, the search box, the
#            search <script>.
# Each item is rendered as a <section> with:
#   - an <h2> with the item's name (and a kind badge)
#   - a <pre> with the signature (HTML-escaped)
#   - a <div> with the doc comment (paragraph-split, HTML-escaped,
#     cross-references linked)
#   - a <p> with the source line number
# ============================================================================

fn hlsdoc_render_html(module: DocModule) -> str {
    let parts: list[str] = []
    # HTML head.
    parts.push("<!DOCTYPE html>")
    parts.push("<html lang=\"en\">")
    parts.push("<head>")
    parts.push("<meta charset=\"utf-8\">")
    parts.push("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
    parts.push("<title>" + hlsdoc_escape_html(module.name) + " — Halis API docs</title>")
    parts.push("<style>")
    parts.push(hlsdoc_default_css())
    parts.push("</style>")
    parts.push("</head>")
    parts.push("<body>")
    # Header.
    parts.push("<header>")
    parts.push("<h1>" + hlsdoc_escape_html(module.name) + "</h1>")
    if module.source_path != "" {
        parts.push("<p class=\"source\">Source: <code>" + hlsdoc_escape_html(module.source_path) + "</code></p>")
    }
    parts.push("<p class=\"item-count\">" + module.items.len().to_str() + " items</p>")
    parts.push("</header>")
    # Search box.
    parts.push("<div class=\"search\">")
    parts.push("<input type=\"search\" id=\"search-input\" placeholder=\"Search...\" autocomplete=\"off\">")
    parts.push("</div>")
    # Items.
    parts.push("<main>")
    let mut i: int = 0
    while i < module.items.len() {
        let item: DocItem = module.items.get(i)
        parts.push(hlsdoc_render_item(item, module))
        i = i + 1
    }
    parts.push("</main>")
    # Search script.
    parts.push("<script>")
    parts.push(hlsdoc_render_search_script(module))
    parts.push("</script>")
    parts.push("</body>")
    parts.push("</html>")
    return str_join(parts, "\n") + "\n"
}

# ----------------------------------------------------------------------------
# hlsdoc_render_item(item, module) -> str — render one DocItem as a <section>.
# ----------------------------------------------------------------------------

fn hlsdoc_render_item(item: DocItem, module: DocModule) -> str {
    let parts: list[str] = []
    parts.push("<section id=\"" + hlsdoc_anchor(item.name) + "\">")
    # Header: kind badge + name.
    let kind_badge: str = "<span class=\"badge " + hlsdoc_kind_name(item.kind) + "\">"
        + hlsdoc_kind_name(item.kind) + "</span>"
    parts.push("<h2>" + kind_badge + " " + hlsdoc_escape_html(item.name) + "</h2>")
    # Signature.
    parts.push("<pre class=\"signature\"><code>" + hlsdoc_escape_html(item.signature) + "</code></pre>")
    # Doc comment (if any).
    if item.doc != "" {
        parts.push("<div class=\"doc\">")
        let paragraphs: list[str] = hlsdoc_split_paragraphs(item.doc)
        let mut i: int = 0
        while i < paragraphs.len() {
            let rendered: str = hlsdoc_render_doc_paragraph(paragraphs.get(i), module)
            parts.push("<p>" + rendered + "</p>")
            i = i + 1
        }
        parts.push("</div>")
    }
    # Source line.
    parts.push("<p class=\"line\">Line " + item.line.to_str() + "</p>")
    parts.push("</section>")
    return str_join(parts, "\n")
}

# ----------------------------------------------------------------------------
# hlsdoc_render_doc_paragraph(text, module) -> str — render one paragraph
# of doc-comment text. Handles:
#   - HTML escaping (defense-in-depth).
#   - Cross-references: [name] -> <a href="#name">name</a> if `name` is a
#     declared item in `module`.
#   - Section headers: lines starting with '##' -> <h3>.
# ----------------------------------------------------------------------------

fn hlsdoc_render_doc_paragraph(text: str, module: DocModule) -> str {
    # Section header (## title -> <h3>title</h3>).
    if hlsdoc_starts_with(text, "## ") {
        let title: str = text.slice(3, text.len())
        return "<h3>" + hlsdoc_escape_html(title) + "</h3>"
    }
    # Otherwise, render as inline text with cross-references.
    return hlsdoc_render_cross_refs(text, module)
}

# ----------------------------------------------------------------------------
# hlsdoc_render_cross_refs(text, module) -> str — render text with [name]
# cross-references. HTML-escapes the text first, then scans for [name]
# patterns and replaces them with <a> tags if `name` is a declared item.
# ----------------------------------------------------------------------------

fn hlsdoc_render_cross_refs(text: str, module: DocModule) -> str {
    let escaped: str = hlsdoc_escape_html(text)
    let out: list[str] = []
    let n: int = escaped.len()
    let mut i: int = 0
    while i < n {
        let b: int = escaped.byte_at(i)
        if b == 91 {
            # '[' — look for a matching ']'.
            let end: int = hlsdoc_find_char(escaped, 93, i + 1)
            if end > 0 {
                let name: str = escaped.slice(i + 1, end)
                if hlsdoc_module_has_item(module, name) {
                    out.push("<a href=\"#" + hlsdoc_anchor(name) + "\">"
                        + name + "</a>")
                    i = end + 1
                    continue
                }
            }
            # No match — emit the '[' literally.
            out.push("[")
            i = i + 1
            continue
        }
        out.push(escaped.slice(i, i + 1))
        i = i + 1
    }
    return str_join(out, "")
}

# hlsdoc_find_char(s, ch, start) -> int — find `ch` (a byte value) at or
# after `start`. Returns -1 if not found.
fn hlsdoc_find_char(s: str, ch: int, start: int) -> int {
    let n: int = s.len()
    let mut i: int = start
    while i < n {
        if s.byte_at(i) == ch {
            return i
        }
        i = i + 1
    }
    return -1
}

# hlsdoc_module_has_item(module, name) -> bool — does the module declare
# an item with this name?
fn hlsdoc_module_has_item(module: DocModule, name: str) -> bool {
    let mut i: int = 0
    while i < module.items.len() {
        if module.items.get(i).name == name {
            return true
        }
        i = i + 1
    }
    return false
}

# ----------------------------------------------------------------------------
# hlsdoc_split_paragraphs(text) -> list[str] — split text on blank lines.
# ----------------------------------------------------------------------------

fn hlsdoc_split_paragraphs(text: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = text.split("\n")
    let mut cur: list[str] = []
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if hlsdoc_is_blank(line) {
            if cur.len() > 0 {
                out.push(str_join(cur, "\n"))
                cur = []
            }
        } else {
            cur.push(line)
        }
        i = i + 1
    }
    if cur.len() > 0 {
        out.push(str_join(cur, "\n"))
    }
    return out
}

fn hlsdoc_is_blank(line: str) -> bool {
    let n: int = line.len()
    let mut i: int = 0
    while i < n {
        let b: int = line.byte_at(i)
        if b != 32 && b != 9 {
            return false
        }
        i = i + 1
    }
    return true
}

# ----------------------------------------------------------------------------
# hlsdoc_anchor(name) -> str — the HTML anchor for an item (lowercased).
# ----------------------------------------------------------------------------

fn hlsdoc_anchor(name: str) -> str {
    return str_to_lower_ascii(name)
}

# ----------------------------------------------------------------------------
# hlsdoc_escape_html(s) -> str — escape HTML metacharacters.
#   & -> &amp;
#   < -> &lt;
#   > -> &gt;
#   " -> &quot;
#   ' -> &#39;
# This is the security-critical function: every user-controlled string
# MUST pass through this before being embedded in HTML.
# ----------------------------------------------------------------------------

fn hlsdoc_escape_html(s: str) -> str {
    let out: list[str] = []
    let n: int = s.len()
    let mut i: int = 0
    while i < n {
        let b: int = s.byte_at(i)
        if b == 38 {
            out.push("&amp;")
        } else if b == 60 {
            out.push("&lt;")
        } else if b == 62 {
            out.push("&gt;")
        } else if b == 34 {
            out.push("&quot;")
        } else if b == 39 {
            out.push("&#39;")
        } else {
            out.push(s.slice(i, i + 1))
        }
        i = i + 1
    }
    return str_join(out, "")
}

# ----------------------------------------------------------------------------
# hlsdoc_default_css() -> str — the default stylesheet (embedded in the
# HTML <head>). Minimal, readable, no external dependencies.
# ----------------------------------------------------------------------------

fn hlsdoc_default_css() -> str {
    let lines: list[str] = []
    lines.push("body { font-family: -apple-system, BlinkMacSystemFont, sans-serif;")
    lines.push("       max-width: 800px; margin: 2em auto; padding: 0 1em;")
    lines.push("       color: #333; line-height: 1.5; }")
    lines.push("header { border-bottom: 2px solid #eee; padding-bottom: 1em; }")
    lines.push("h1 { margin: 0; }")
    lines.push("h2 { margin-top: 2em; border-bottom: 1px solid #ddd; padding-bottom: 0.25em; }")
    lines.push("h3 { color: #555; }")
    lines.push(".badge { display: inline-block; padding: 0.2em 0.5em;")
    lines.push("         font-size: 0.8em; border-radius: 3px; color: white;")
    lines.push("         background: #666; margin-right: 0.5em; }")
    lines.push(".badge.fn { background: #2196f3; }")
    lines.push(".badge.struct { background: #4caf50; }")
    lines.push(".badge.enum { background: #ff9800; }")
    lines.push(".badge.impl { background: #9c27b0; }")
    lines.push("pre.signature { background: #f5f5f5; padding: 0.5em;")
    lines.push("                 border-radius: 3px; overflow-x: auto; }")
    lines.push("pre.signature code { font-family: 'SF Mono', Consolas, monospace; }")
    lines.push(".doc p { margin: 0.5em 0; }")
    lines.push(".line { color: #999; font-size: 0.85em; }")
    lines.push(".source { color: #999; }")
    lines.push(".search { margin: 1em 0; }")
    lines.push(".search input { width: 100%; padding: 0.5em;")
    lines.push("                  font-size: 1em; border: 1px solid #ddd;")
    lines.push("                  border-radius: 3px; }")
    lines.push("section.hidden { display: none; }")
    return str_join(lines, "\n")
}

# ----------------------------------------------------------------------------
# hlsdoc_render_search_script(module) -> str — the vanilla JS that
# implements client-side search. Reads the search input, filters the
# sections by name (case-insensitive substring match), and hides the
# non-matching sections.
# ----------------------------------------------------------------------------

fn hlsdoc_render_search_script(module: DocModule) -> str {
    let lines: list[str] = []
    lines.push("(function() {")
    lines.push("    var input = document.getElementById('search-input');")
    lines.push("    var sections = document.querySelectorAll('main > section');")
    lines.push("    input.addEventListener('input', function() {")
    lines.push("        var q = input.value.toLowerCase();")
    lines.push("        for (var i = 0; i < sections.length; i++) {")
    lines.push("            var name = sections[i].querySelector('h2').textContent.toLowerCase();")
    lines.push("            if (q === '' || name.indexOf(q) >= 0) {")
    lines.push("                sections[i].classList.remove('hidden');")
    lines.push("            } else {")
    lines.push("                sections[i].classList.add('hidden');")
    lines.push("            }")
    lines.push("        }")
    lines.push("    });")
    lines.push("})();")
    return str_join(lines, "\n")
}

# ============================================================================
# hlsdoc_render_search_index(module) -> str — emit a JSON search index
# (an array of {name, kind, signature, anchor} entries). This is
# OPTIONAL — the embedded <script> above does client-side search
# without an index. The JSON index is for tools that want to build a
# cross-module search (e.g., a future hls-docs aggregation server).
# ============================================================================

fn hlsdoc_render_search_index(module: DocModule) -> str {
    let parts: list[str] = []
    parts.push("[")
    let mut i: int = 0
    while i < module.items.len() {
        let item: DocItem = module.items.get(i)
        parts.push("  {")
        parts.push("    \"name\": \"" + hlsdoc_escape_json(item.name) + "\",")
        parts.push("    \"kind\": \"" + hlsdoc_kind_name(item.kind) + "\",")
        parts.push("    \"signature\": \"" + hlsdoc_escape_json(item.signature) + "\",")
        parts.push("    \"anchor\": \"" + hlsdoc_anchor(item.name) + "\",")
        parts.push("    \"line\": " + item.line.to_str())
        if i + 1 < module.items.len() {
            parts.push("  },")
        } else {
            parts.push("  }")
        }
        i = i + 1
    }
    parts.push("]")
    return str_join(parts, "\n")
}

# ----------------------------------------------------------------------------
# hlsdoc_escape_json(s) -> str — escape a string for embedding in JSON.
# Escapes: " -> \", \ -> \\, newline -> \n, tab -> \t, control bytes
# -> \uXXXX.
# ----------------------------------------------------------------------------

fn hlsdoc_escape_json(s: str) -> str {
    let out: list[str] = []
    let n: int = s.len()
    let mut i: int = 0
    while i < n {
        let b: int = s.byte_at(i)
        if b == 34 {
            out.push("\\\"")
        } else if b == 92 {
            out.push("\\\\")
        } else if b == 10 {
            out.push("\\n")
        } else if b == 9 {
            out.push("\\t")
        } else if b == 13 {
            out.push("\\r")
        } else if b < 32 {
            out.push("\\u" + hlsdoc_hex4(b))
        } else {
            out.push(s.slice(i, i + 1))
        }
        i = i + 1
    }
    return str_join(out, "")
}

fn hlsdoc_hex4(b: int) -> str {
    let hi: int = b / 256
    let lo: int = b % 256
    return hlsdoc_hex2(hi) + hlsdoc_hex2(lo)
}

fn hlsdoc_hex2(b: int) -> str {
    let hi: int = b / 16
    let lo: int = b % 16
    return hlsdoc_hex_nibble(hi) + hlsdoc_hex_nibble(lo)
}

fn hlsdoc_hex_nibble(n: int) -> str {
    if n < 10 {
        return n.to_str()
    }
    if n == 10 { return "a" }
    if n == 11 { return "b" }
    if n == 12 { return "c" }
    if n == 13 { return "d" }
    if n == 14 { return "e" }
    return "f"
}

# ============================================================================
# hlsdoc_write_html(module, output_path) -> void — write the rendered
# HTML to a file. Carries the Fs effect (write_file).
# ============================================================================

fn hlsdoc_write_html(module: DocModule, output_path: str) -> void uses Fs {
    let html: str = hlsdoc_render_html(module)
    write_file(output_path, html)
}

# ----------------------------------------------------------------------------
# hlsdoc_write_search_index(module, output_path) -> void — write the
# JSON search index to a file. Carries the Fs effect.
# ----------------------------------------------------------------------------

fn hlsdoc_write_search_index(module: DocModule, output_path: str) -> void uses Fs {
    let json: str = hlsdoc_render_search_index(module)
    write_file(output_path, json)
}

# ============================================================================
# hlsdoc_render_summary(module) -> str — a plain-text summary of the
# module (for `hls doc --list` or for terminals without a browser).
# ============================================================================

fn hlsdoc_render_summary(module: DocModule) -> str {
    let lines: list[str] = []
    lines.push("Module: " + module.name)
    lines.push("Items: " + module.items.len().to_str())
    lines.push("")
    let mut i: int = 0
    while i < module.items.len() {
        let item: DocItem = module.items.get(i)
        lines.push("  " + hlsdoc_kind_name(item.kind) + " " + item.name
            + " (line " + item.line.to_str() + ")")
        i = i + 1
    }
    return str_join(lines, "\n")
}

# ============================================================================
# End of std/hlsdoc.hls
