# ============================================================================
# std/graphql/gql_types.hls - verbatim slice of the original std/graphql.hls
# (lines 123..624), split for maintainability. Loaded via the
# std/graphql.hls facade; not part of the public import API.
# ============================================================================

# ============================================================================
# Constants — GraphQL built-in scalars, kind codes, limits.
# ============================================================================

# gql_scalar_int() — the built-in 32-bit integer scalar name. GraphQL
# spec Int; JSON representation is a 64-bit HLS int (i64) for safety.
fn gql_scalar_int() -> str { return "Int" }

# gql_scalar_float() — the built-in IEEE-754 scalar name (spec Float).
fn gql_scalar_float() -> str { return "Float" }

# gql_scalar_string() — the built-in UTF-8 string scalar name.
fn gql_scalar_string() -> str { return "String" }

# gql_scalar_boolean() — the built-in boolean scalar name.
fn gql_scalar_boolean() -> str { return "Boolean" }

# gql_scalar_id() — the built-in ID scalar name. Serialised as a JSON
# string; not intended to be human-readable.
fn gql_scalar_id() -> str { return "ID" }

# gql_type_kind_scalar() — kind code for scalar type definitions.
fn gql_type_kind_scalar() -> int { return 0 }

# gql_type_kind_object() — kind code for object type definitions
# (including the Query/Mutation root types).
fn gql_type_kind_object() -> int { return 1 }

# gql_type_kind_enum() — kind code for enum type definitions.
fn gql_type_kind_enum() -> int { return 2 }

# gql_type_kind_name(kind) — render a kind code as "scalar" / "object"
# / "enum" (used by graphql_schema_to_json and error messages).
fn gql_type_kind_name(kind: int) -> str {
    if kind == gql_type_kind_scalar() {
        return "scalar"
    }
    if kind == gql_type_kind_enum() {
        return "enum"
    }
    return "object"
}

# gql_builtin_scalars() — the five spec-defined scalar names, joined
# with "," (used by schema validation and the SDL printer).
fn gql_builtin_scalars() -> str {
    return gql_scalar_int() + "," + gql_scalar_float() + ","
        + gql_scalar_string() + "," + gql_scalar_boolean() + ","
        + gql_scalar_id()
}

# gql_is_builtin_scalar(name) — true iff name is one of the five
# spec scalars.
fn gql_is_builtin_scalar(name: str) -> bool {
    return name == gql_scalar_int() || name == gql_scalar_float()
        || name == gql_scalar_string() || name == gql_scalar_boolean()
        || name == gql_scalar_id()
}

# gql_typename_field() — the reserved meta-field that every composite
# type exposes; it resolves to the name of the object being resolved.
fn gql_typename_field() -> str { return "__typename" }

# gql_op_query() / gql_op_mutation() — operation kind codes.
fn gql_op_query() -> int { return 0 }
fn gql_op_mutation() -> int { return 1 }

# gql_op_kind_name(kind) — "query" / "mutation" (rendering + errors).
fn gql_op_kind_name(kind: int) -> str {
    if kind == gql_op_mutation() {
        return "mutation"
    }
    return "query"
}

# gql_sel_field() / gql_sel_spread() / gql_sel_inline() — selection
# node kind codes (a field, a named fragment spread, an inline
# fragment `... on Type { ... }`).
fn gql_sel_field() -> int { return 0 }
fn gql_sel_spread() -> int { return 1 }
fn gql_sel_inline() -> int { return 2 }

# gql_var_marker() — the token prefix marking a variable reference
# inside a rendered argument value ("$!name"). A variable reference is
# rendered as a JSON STRING containing the marker so it can ride
# through list/object literals and be substituted at graphql_begin
# time. "$!" cannot appear in a legal GraphQL name, so the marker is
# unambiguous.
fn gql_var_marker() -> str { return "$!" }

# graphql_max_document_len() — maximum byte length of a GraphQL
# document (query or SDL) accepted by the parsers. 16 KiB is far
# beyond any hand-written query and small enough to bound all parser
# work. Larger documents are rejected before parsing begins.
fn graphql_max_document_len() -> int { return 16384 }

# graphql_max_depth() — maximum selection-set NESTING DEPTH (root = 1).
# The default of 10 matches common production gateways (GraphQL Java
# default is similar); deep documents are almost always an attack, not
# an application. Exceeding it is a compile-style error, not a crash.
fn graphql_max_depth() -> int { return 10 }

# graphql_max_nodes() — maximum total selection nodes AFTER fragment
# expansion. This is the billion-laughs defence: fragments may be
# spread repeatedly, multiplying the expanded tree; the EXPANDED node
# count is checked, so a document cannot amplify a small source into
# an unbounded workload. 2048 nodes is ~20x a realistic app query.
fn graphql_max_nodes() -> int { return 2048 }

# graphql_max_args() — maximum arguments per field / variables per
# operation. 16 is beyond any real API field.
fn graphql_max_args() -> int { return 16 }

# graphql_max_name_len() — maximum byte length of a GraphQL name
# (type/field/argument/fragment/operation/enum value). GraphQL spec
# names are short; 64 is generous.
fn graphql_max_name_len() -> int { return 64 }

# graphql_max_alias_len() — maximum byte length of a field alias.
fn graphql_max_alias_len() -> int { return 64 }

# graphql_max_string_len() — maximum byte length of a string literal
# in a document (queries are not the place for megabyte payloads).
fn graphql_max_string_len() -> int { return 8192 }

# graphql_max_list_len() — maximum elements in a list literal.
fn graphql_max_list_len() -> int { return 256 }

# graphql_max_fields() — maximum fields in one object type / one
# selection set (SDL and document alike).
fn graphql_max_fields() -> int { return 256 }

# graphql_max_fragments() — maximum fragment definitions per document.
fn graphql_max_fragments() -> int { return 32 }

# graphql_max_variables() — maximum variable definitions per
# operation.
fn graphql_max_variables() -> int { return 32 }

# graphql_max_types() — maximum type definitions per schema.
fn graphql_max_types() -> int { return 256 }

# graphql_content_type() — the Content-Type for GraphQL HTTP
# responses (application/json per the graphql-over-http spec draft).
fn graphql_content_type() -> str { return "application/json" }

# ============================================================================
# Type-reference helpers — canonical type strings.
#
# A type reference is encoded as a canonical string:
#     "User"      — named type (scalar, object, or enum)
#     "[User]"    — list of User
#     "[User]!"   — non-null list of User
#     "[User!]!"  — non-null list of non-null User
# The list/non-null wrappers nest arbitrarily deep (GraphQL allows
# [[Int]]); the base name is the innermost named type.
# ============================================================================

# gql_type_base(t) — strip every list/non-null wrapper, returning the
# innermost named type ("[User!]!" -> "User").
fn gql_type_base(t: str) -> str {
    let mut cur: str = t
    let mut guard: int = 0
    # Peel wrappers until the string is a bare name. A bare name is
    # non-empty, starts with a letter or '_', contains no '[', ']'
    # or '!', and fits the name length limit.
    while guard < graphql_max_depth() * 2 {
        if cur.len() == 0 {
            return ""
        }
        if cur.ends_with("!") {
            cur = cur.slice(0, cur.len() - 1)
        } else if cur.starts_with("[") && cur.ends_with("]") {
            # Strip the OUTER brackets — find the matching open bracket
            # by scanning from the end (the last char is ']' which
            # matches the first '[' by construction of canonical form).
            cur = cur.slice(1, cur.len() - 1)
        } else {
            break
        }
        guard = guard + 1
    }
    return cur
}

# gql_type_is_non_null(t) — true iff the OUTERMOST wrapper is "!".
fn gql_type_is_non_null(t: str) -> bool {
    return t.ends_with("!")
}

# gql_type_is_list(t) — true iff the outermost wrapper (after any
# non-null) is a list: "[...]" or "[...]!".
fn gql_type_is_list(t: str) -> bool {
    let mut cur: str = t
    if cur.ends_with("!") {
        cur = cur.slice(0, cur.len() - 1)
    }
    return cur.starts_with("[") && cur.ends_with("]")
}

# gql_type_wrap_list(t) — "[t]".
fn gql_type_wrap_list(t: str) -> str {
    return "[" + t + "]"
}

# gql_type_wrap_non_null(t) — "t!".
fn gql_type_wrap_non_null(t: str) -> str {
    return t + "!"
}

# gql_type_strip_non_null(t) — remove one outer non-null wrapper.
fn gql_type_strip_non_null(t: str) -> str {
    if t.ends_with("!") {
        return t.slice(0, t.len() - 1)
    }
    return t
}

# gql_type_element(t) — the element type of a list type reference
# ("[User!]!" -> "User!"). Returns "" if t is not a list.
fn gql_type_element(t: str) -> str {
    let mut cur: str = t
    if cur.ends_with("!") {
        cur = cur.slice(0, cur.len() - 1)
    }
    if cur.starts_with("[") && cur.ends_with("]") {
        return cur.slice(1, cur.len() - 1)
    }
    return ""
}

# gql_is_valid_name(name) — a GraphQL name: [A-Za-z_][A-Za-z0-9_]*,
# bounded by graphql_max_name_len. Used by both parsers.
fn gql_is_valid_name(name: str) -> bool {
    if name.len() == 0 || name.len() > graphql_max_name_len() {
        return false
    }
    let mut i: int = 0
    while i < name.len() {
        let b: int = name.byte_at(i)
        let ok_first: bool = i == 0 && ((b >= 65 && b <= 90)
            || (b >= 97 && b <= 122) || b == 95)
        let ok_rest: bool = i > 0 && ((b >= 65 && b <= 90)
            || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95)
        if !ok_first && !ok_rest {
            return false
        }
        i = i + 1
    }
    return true
}

# ============================================================================
# Schema model — GqlArg, GqlField, GqlType, GqlSchema + builders.
# ============================================================================

# GqlArg — one argument of a field definition: name, canonical type
# string, and an optional default value (rendered JSON).
struct GqlArg {
    name: str,
    type_str: str,
    has_default: bool,
    default_json: str
}

# gql_arg_new(name, type_str) — an argument with no default.
fn gql_arg_new(name: str, type_str: str) -> GqlArg {
    return GqlArg {
        name: name,
        type_str: type_str,
        has_default: false,
        default_json: "null"
    }
}

# gql_arg_with_default(a, default_json) — immutable setter: return a
# copy with the default value set (a rendered JSON value string).
fn gql_arg_with_default(a: GqlArg, default_json: str) -> GqlArg {
    return GqlArg {
        name: a.name,
        type_str: a.type_str,
        has_default: true,
        default_json: default_json
    }
}

# gql_arg_find(args, name) — index of the named argument, or -1.
fn gql_arg_find(args: list[GqlArg], name: str) -> int {
    let mut i: int = 0
    while i < args.len() {
        if args.get(i).name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

# GqlField — one field of an object type: name, canonical return type
# string, argument list, optional description (from SDL doc strings).
struct GqlField {
    name: str,
    type_str: str,
    args: list[GqlArg],
    description: str
}

# gql_field_new(name, type_str) — a field with no args/description.
fn gql_field_new(name: str, type_str: str) -> GqlField {
    return GqlField {
        name: name,
        type_str: type_str,
        args: [],
        description: ""
    }
}

# gql_field_with_arg(f, a) — immutable setter: append an argument.
fn gql_field_with_arg(f: GqlField, a: GqlArg) -> GqlField {
    let mut args: list[GqlArg] = []
    let mut i: int = 0
    while i < f.args.len() {
        args.push(f.args.get(i))
        i = i + 1
    }
    args.push(a)
    return GqlField {
        name: f.name,
        type_str: f.type_str,
        args: args,
        description: f.description
    }
}

# gql_field_with_description(f, description) — immutable setter.
fn gql_field_with_description(f: GqlField, description: str) -> GqlField {
    return GqlField {
        name: f.name,
        type_str: f.type_str,
        args: f.args,
        description: description
    }
}

# gql_field_find(fields, name) — index of the named field, or -1.
fn gql_field_find(fields: list[GqlField], name: str) -> int {
    let mut i: int = 0
    while i < fields.len() {
        if fields.get(i).name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

# GqlType — one named type. kind is one of the gql_type_kind_*
# constants. For objects, `fields` holds the field list; for enums,
# `enum_values` holds the value names; for scalars both are empty.
struct GqlType {
    name: str,
    kind: int,
    fields: list[GqlField],
    enum_values: list[str],
    description: str
}

# gql_type_object(name) — a new empty object type.
fn gql_type_object(name: str) -> GqlType {
    return GqlType {
        name: name,
        kind: gql_type_kind_object(),
        fields: [],
        enum_values: [],
        description: ""
    }
}

# gql_type_scalar_def(name) — a custom scalar definition.
fn gql_type_scalar_def(name: str) -> GqlType {
    return GqlType {
        name: name,
        kind: gql_type_kind_scalar(),
        fields: [],
        enum_values: [],
        description: ""
    }
}

# gql_type_enum_def(name) — a new empty enum type.
fn gql_type_enum_def(name: str) -> GqlType {
    return GqlType {
        name: name,
        kind: gql_type_kind_enum(),
        fields: [],
        enum_values: [],
        description: ""
    }
}

# gql_type_with_field(t, f) — immutable setter: append a field.
fn gql_type_with_field(t: GqlType, f: GqlField) -> GqlType {
    let mut fields: list[GqlField] = []
    let mut i: int = 0
    while i < t.fields.len() {
        fields.push(t.fields.get(i))
        i = i + 1
    }
    fields.push(f)
    return GqlType {
        name: t.name,
        kind: t.kind,
        fields: fields,
        enum_values: t.enum_values,
        description: t.description
    }
}

# gql_type_with_enum_value(t, value_name) — immutable setter: append
# an enum value.
fn gql_type_with_enum_value(t: GqlType, value_name: str) -> GqlType {
    let mut vals: list[str] = []
    let mut i: int = 0
    while i < t.enum_values.len() {
        vals.push(t.enum_values.get(i))
        i = i + 1
    }
    vals.push(value_name)
    return GqlType {
        name: t.name,
        kind: t.kind,
        fields: t.fields,
        enum_values: vals,
        description: t.description
    }
}

# gql_type_with_description(t, description) — immutable setter.
fn gql_type_with_description(t: GqlType, description: str) -> GqlType {
    return GqlType {
        name: t.name,
        kind: t.kind,
        fields: t.fields,
        enum_values: t.enum_values,
        description: description
    }
}

# gql_type_is_composite(t) — true iff a selection set may appear on
# this type (objects only — enums and scalars are leaves).
fn gql_type_is_composite(t: GqlType) -> bool {
    return t.kind == gql_type_kind_object()
}

# GqlSchema — the parsed schema: the type list plus the root
# operation type names. query_type defaults to "Query".
struct GqlSchema {
    types: list[GqlType],
    query_type: str,
    mutation_type: str,
    description: str
}

# graphql_schema_new() — an empty schema with the conventional root
# names. Build it up with graphql_schema_with_type, or parse SDL.
fn graphql_schema_new() -> GqlSchema {
    return GqlSchema {
        types: [],
        query_type: "Query",
        mutation_type: "",
        description: ""
    }
}

# graphql_schema_with_type(s, t) — immutable setter: append a type
# definition. If the type is named "Query" or "Mutation" it
# automatically becomes the corresponding root operation type.
fn graphql_schema_with_type(s: GqlSchema, t: GqlType) -> GqlSchema {
    let mut types: list[GqlType] = []
    let mut i: int = 0
    while i < s.types.len() {
        types.push(s.types.get(i))
        i = i + 1
    }
    types.push(t)
    let mut q: str = s.query_type
    let mut m: str = s.mutation_type
    if t.kind == gql_type_kind_object() && t.name == "Query" {
        q = "Query"
    }
    if t.kind == gql_type_kind_object() && t.name == "Mutation" {
        m = "Mutation"
    }
    return GqlSchema {
        types: types,
        query_type: q,
        mutation_type: m,
        description: s.description
    }
}

# graphql_schema_find_type(s, name) — index of the named type, or -1.
