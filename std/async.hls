# ============================================================================
# std/async.hls — Stage 33 (v0.52.0-alpha): async/await zero-runtime futures
# ----------------------------------------------------------------------------
# `Future[T]` is a built-in generic type (declared in the compiler, not here).
# At runtime it is a `hl_chan*` of capacity 1 (bounded — backpressure: the
# producing task blocks at send time until the consumer takes the value).
#
# The async/await primitives are BUILTINS (async_spawn, await,
# future_ready, future_poll, future_select) — declared in the compiler.
# This module provides higher-level combinators built on top of them.
#
# Design (zero-runtime):
#   - A `Future[T]` is NOT a heap-allocated state-machine object. It is a
#     channel (the same runtime primitive used by Stage 16 concurrency).
#     The "state" of the future is implicit: a future is ready when its
#     channel has a pending message.
#   - `async_spawn(f, args...)` creates a cap-1 bounded channel, spawns a
#     detached thread running f(args...), and returns the channel as a
#     Future. When f returns, the result is sent on the channel.
#   - `await(fut)` is a channel recv — blocks until the result is available.
#   - No GC, no per-future heap allocation beyond the channel primitive
#     (which is required for the synchronization itself).
#
# All functions carry the `Conc` effect (they drive the concurrency runtime).
# ============================================================================

import "std.option"

# ----------------------------------------------------------------------------
# async_run_all: drive a list of futures to completion, return results.
# The futures are already backed by tasks (the work is happening in
# parallel); this function just collects results in order. This is the
# simplest "block on each" executor — sufficient when the futures are
# already running concurrently.
# ----------------------------------------------------------------------------
fn async_run_all_int(futs: list[Future[int]]) -> list[int] uses Conc {
    let out: list[int] = []
    let mut i: int = 0
    while i < futs.len() {
        out.push(await(futs.get(i)))
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# async_race: return the value of the first future to complete.
# Uses future_select to find the ready index, then awaits that future.
# The other futures continue running (they are detached threads); their
# results are discarded when the channels are cleaned up.
# ----------------------------------------------------------------------------
fn async_race_int(futs: list[Future[int]]) -> int uses Conc {
    let idx: int = future_select(futs)
    return await(futs.get(idx))
}

# ----------------------------------------------------------------------------
# async_block_on: block until the future is ready (alias for await).
# Provided for documentation / API parity with other async runtimes.
# ----------------------------------------------------------------------------
fn async_block_on_int(fut: Future[int]) -> int uses Conc {
    return await(fut)
}

# ----------------------------------------------------------------------------
# async_all_ok: AND-reduce a list of bool futures. Returns true iff all
# futures complete with true. Short-circuits on the first false (the
# remaining futures continue running but their results are ignored).
# ----------------------------------------------------------------------------
fn async_all_ok(futs: list[Future[bool]]) -> bool uses Conc {
    let mut i: int = 0
    while i < futs.len() {
        if !await(futs.get(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

# ----------------------------------------------------------------------------
# async_any_ok: OR-reduce a list of bool futures. Returns true iff any
# future completes with true. Uses future_select to check the first
# ready one; if true, returns immediately.
# ----------------------------------------------------------------------------
fn async_any_ok(futs: list[Future[bool]]) -> bool uses Conc {
    let idx: int = future_select(futs)
    return await(futs.get(idx))
}
