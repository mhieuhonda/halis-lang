# Artifacts produced by the bootstrap chain and the test suite.
bin/
build/
*.o
*.out
*.bin
tests/stage84/_gate_link_*/
tests/_gate_boot_*/
tests/_gate_idt_*/
tests/_gate_mmio_*/
tests/_gate_s119_*/
tests/_gate_s124_*/
tests/_gate_s120_*/
tests/_gate_s121_*/
tests/_gate_port_*/
tests/_gate_dma_*/
tests/_gate_atomics_*/
tests/_gate_xboot_*/
tests/_gate_irqsafe_*/
tests/_gate_ref_*/
tests/_gate_triple93_*/
tests/_gate_s99_*/
tests/_gate_s100_*/
tests/_gate_s103_*/
hlc.c
hlc2.c
hlc_s1.c
hlc_s2.c

# Stage 142 (v0.161.0-alpha): the committed C snapshot is the seed the
# pure bootstrap compiles — it is tree content, not a build artifact.
# Re-cut ONLY through `make snapshot-regen` (never by hand); it always
# travels with snapshot/MANIFEST.json.
!snapshot/hlc.c

# Python bytecode caches.
__pycache__/
*.pyc
*.pyo

# Editor / OS metadata.
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Local scratch space (NOT committed — should never appear in a release).
scratch/

# Coverage / profiling artifacts.
*.gcov
*.gcda
*.gcno
perf.data
perf.data.old

# Stage 13 release: hls-pkg artifacts (do NOT commit).
.hls-pkg-cache/
.hls-pkg-deps/
.hls-pkg-transparency.log
.hls-pkg.lock

# SMT-LIB2 dumps (the contract bridge and the Stage 97 invariant
# obligations are generated artifacts, written next to the source).
*.smt2

# Stage 104: working-copy SBOM documents (the default-named files the
# tool writes next to an entry/manifest). Release SBOMs carry the
# versioned name hls-sbom-<pkg>-<version>.* and ARE meant to be
# committed.
hls-sbom.cdx.json
hls-sbom.spdx.json

# Stage 105: the working-copy buildinfo (the default-named file the
# tool writes next to an entry/manifest). Release buildinfos carry
# the versioned name hls-repro-<pkg>-<version>.buildinfo.json and
# ARE meant to be committed.
hls-repro.buildinfo.json

# Stage 106: signing keys. The secret key is the name behind every
# signature — it NEVER enters the tree. The release-named statement
# and signature files (hls-sign-<pkg>-<version>.release.json /
# .minisig) ARE meant to be committed; so is a public key published
# on purpose.
hls-sign.key
# Stage 109: the FFI-taint acceptance gate scratch dir (a gate killed
# mid-run cannot clean up after itself).
tests/_gate_s109_*/
tests/_gate_s110_*/
.hls-pkg-transparency.log.lock
# Stage 111: the capability acceptance gate scratch dir.
tests/_gate_cap_*/

# Stage 112: the audit log records every privileged operation the
# toolchain performs on this checkout. It is machine-local evidence,
# not tree content; signed checkpoints (hls-audit-ckpt-*.ckpt.json +
# .minisig) ARE meant to be committed.
.hls-audit.log
.hls-audit.log.lock
tests/_gate_s112_*/


# Stage 113: the LSP acceptance gate scratch workspace.
tests/_gate_s113_*/

# Stage 116: the hlfmt comment-preservation gate scratch workspace.
tests/_gate_s116_*/

# Stage 117: the hlfmt team-config acceptance gate scratch workspace.
tests/_gate_s117_*/

# Stage 118: the hllint autofix acceptance gate scratch workspace.
tests/_gate_s118_*/

# Stage 119: the hltest snapshot acceptance gate scratch workspace.
tests/_gate_s119_*/
tests/_gate_s124_*/

# Stage 124 (v0.142.0-alpha): hls-bench baseline records — machine-local
# by nature (timings are a property of the machine that measured them),
# so unlike snapshot stores they are never committed.
.hlbench/
# Stage 128: the compat acceptance gate scratch workspace (a gate
# killed mid-run cannot clean up after itself).
tests/_gate_s128_*/
# Stage 131/132 acceptance gates: crash debris from their
# tempfile roots (a gate killed mid-run cannot clean up).
.lts-gate-*/
.perf-gate-*/
.hlperf/
.memdash-gate-*/
.hlmem/
.ctime-gate-*/
.hlctime/
.hlsize/
.hlsize-out/
.size-gate-*/

.semver-gate-*/

# Stage 140 (v0.158.0-alpha): the audit engagement ledger —
# machine-local like every ledger in this tree (the engagement is a
# fact of THIS checkout's history, and the gates point the tool at
# scratch ledgers without touching the tree's).
.hlaudit/
.auditkit-gate-*/

# Stage 144 (v0.165.0-alpha): the FINAL audit ledger — same law as
# Stage 140's (machine-local, a fact of this checkout), plus the
# scratch trees its acceptance gate builds.
.hlfa/
.finalaudit-gate-*/
FINALBRIEF.md
FINALREPORT.md

# Stage 141 (v0.159.0-alpha): the API-freeze acceptance gate scratch
# trees (the gate verifies the drift laws on disposable copies of the
# tree; a gate killed mid-run cannot clean them up).
.freeze-gate-*/
tests/_gate_freeze_*/

# Stage 142 (v0.161.0-alpha): the pure-bootstrap acceptance gate
# scratch trees (disposable build copies + the python-free bin dir).
tests/_gate_pboot_*/

# Stage 134: the seeded fuzz corpus — generated, reproducible from the
# source tree by `make fuzzseed`; the manifest is the audit trail.
fuzz-corpus/

# Acceptance-gate scratch (tests/acc/harness.hls wipes it per run)
tests/.acc-scratch/
