# Artifacts produced by the bootstrap chain and the test suite.
bin/
build/
*.o
*.out
*.bin
tests/stage84/_gate_link_*/
tests/_gate_boot_*/
tests/_gate_idt_*/
tests/_gate_mmio_*/
tests/_gate_port_*/
tests/_gate_dma_*/
tests/_gate_atomics_*/
tests/_gate_xboot_*/
tests/_gate_irqsafe_*/
tests/_gate_ref_*/
tests/_gate_triple93_*/
tests/_gate_s99_*/
tests/_gate_s100_*/
tests/_gate_s103_*/
hlc.c
hlc2.c
hlc_s1.c
hlc_s2.c

# Python bytecode caches.
__pycache__/
*.pyc
*.pyo

# Editor / OS metadata.
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Local scratch space (NOT committed — should never appear in a release).
scratch/

# Coverage / profiling artifacts.
*.gcov
*.gcda
*.gcno
perf.data
perf.data.old

# Stage 13 release: hls-pkg artifacts (do NOT commit).
.hls-pkg-cache/
.hls-pkg-deps/
.hls-pkg-transparency.log
.hls-pkg.lock

# SMT-LIB2 dumps (the contract bridge and the Stage 97 invariant
# obligations are generated artifacts, written next to the source).
*.smt2

# Stage 104: working-copy SBOM documents (the default-named files the
# tool writes next to an entry/manifest). Release SBOMs carry the
# versioned name hls-sbom-<pkg>-<version>.* and ARE meant to be
# committed.
hls-sbom.cdx.json
hls-sbom.spdx.json

# Stage 105: the working-copy buildinfo (the default-named file the
# tool writes next to an entry/manifest). Release buildinfos carry
# the versioned name hls-repro-<pkg>-<version>.buildinfo.json and
# ARE meant to be committed.
hls-repro.buildinfo.json

# Stage 106: signing keys. The secret key is the name behind every
# signature — it NEVER enters the tree. The release-named statement
# and signature files (hls-sign-<pkg>-<version>.release.json /
# .minisig) ARE meant to be committed; so is a public key published
# on purpose.
hls-sign.key
tests/_gate_s110_*/
.hls-pkg-transparency.log.lock
# Stage 111: the capability acceptance gate scratch dir.
tests/_gate_cap_*/

# Stage 112: the audit log records every privileged operation the
# toolchain performs on this checkout. It is machine-local evidence,
# not tree content; signed checkpoints (hls-audit-ckpt-*.ckpt.json +
# .minisig) ARE meant to be committed.
.hls-audit.log
.hls-audit.log.lock
tests/_gate_s112_*/


# Stage 113: the LSP acceptance gate scratch workspace.
tests/_gate_s113_*/

# Stage 116: the hlfmt comment-preservation gate scratch workspace.
tests/_gate_s116_*/

# Stage 117: the hlfmt team-config acceptance gate scratch workspace.
tests/_gate_s117_*/

# Stage 118: the hllint autofix acceptance gate scratch workspace.
tests/_gate_s118_*/
