# fairness_poll.hls — Stage 127 fixture: the rotation-fairness witness.
# A consumer spins on the NON-BLOCKING recv_or (which never parks — a
# poll loop that would starve a cooperative scheduler that only yields
# at blocking points). Under the det rotation every recv_or is a yield,
# so the producer always gets its turn and the loop terminates; the
# number of empty polls is exactly what the rotation says, every run.
# (Unarmed, that count is genuinely timing-dependent — the fixture is
# the reason the mode exists: the same test, stable under det.)

fn producer(ch: Chan[int]) -> int uses Conc {
    let mut i: int = 0
    while i < 3 {
        ch.send(i)
        i = i + 1
    }
    return 0
}

fn main() -> int uses IO, Conc {
    let ch: Chan[int] = chan_new()
    let t: Task[int] = spawn(producer, clone(ch))
    let mut got: int = 0
    let mut empty_polls: int = 0
    while got < 3 {
        let v: int = ch.recv_or(-1)
        if v >= 0 {
            got = got + 1
        } else {
            empty_polls = empty_polls + 1
        }
    }
    let r: int = t.join()
    println("got=" + got.to_str() + " empty_polls=" + empty_polls.to_str() + " r=" + r.to_str())
    return 0
}
