# park_wake.hls — Stage 127 fixture: the wake-order witness. A blocking
# recv is woken by a send; the woken task is enqueued BEFORE the waker
# requeues itself, so the wakee's next op runs ahead of the waker's.
# The trace pins that order (and the deadlock detector is exercised on
# the way: nothing else is runnable while the receiver parks).

fn sleeper(ch: Chan[int]) -> int uses Conc {
    let v: int = ch.recv()
    return v * 3
}

fn main() -> int uses IO, Conc {
    let ch: Chan[int] = chan_new()
    let t: Task[int] = spawn(sleeper, clone(ch))
    ch.send(7)
    let r: int = t.join()
    println("r=" + r.to_str())
    return 0
}
