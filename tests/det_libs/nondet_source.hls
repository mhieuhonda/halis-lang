# nondet_source.hls — Stage 127 fixture: the HONESTY witness. The
# deterministic scheduler fixes INTERLEAVING, not the world: a program
# that reads the wall clock produces different output on every run
# however it is scheduled. hls-det must refuse to certify it (and say
# why) — a verifier that certified this would be a verifier that
# compares nothing.

fn main() -> int uses IO, Clock {
    let ms: int = system_time_now_ms()
    println("clock=" + (ms % 1000).to_str())
    return 0
}
