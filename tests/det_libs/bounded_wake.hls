# bounded_wake.hls — Stage 127 fixture: the bounded-channel backpressure
# witness. Two producers contend for a cap-1 channel: the first fills it,
# the second PARKS in send; every recv frees capacity and wakes the
# parked sender ahead of the waker; a sender that lost the race to the
# freed slot re-parks. The trace pins the park, the wake order and the
# re-park (the interleaving-sensitive sum is 306 either way, so the
# fixture is also deterministic unarmed).

fn producer(ch: Chan[int], base: int) -> int uses Conc {
    let mut i: int = 0
    while i < 3 {
        ch.send(base + i)
        i = i + 1
    }
    return 0
}

fn main() -> int uses IO, Conc {
    let ch: Chan[int] = chan_new_bounded(1)
    let p1: Task[int] = spawn(producer, clone(ch), 0)
    let p2: Task[int] = spawn(producer, clone(ch), 100)
    let mut total: int = 0
    let mut i: int = 0
    while i < 6 {
        let v: int = ch.recv()
        total = total + v
        i = i + 1
    }
    let r1: int = p1.join()
    let r2: int = p2.join()
    println("total=" + total.to_str() + " r1=" + r1.to_str() + " r2=" + r2.to_str())
    return 0
}
