# select_rotation.hls — Stage 127 fixture: the select-park witness. The
# select must run while BOTH of its channels are empty (it parks on both
# lists), and the feeders — released by a gatekeeper task — are the
# only possible wakers. The trace pins the multi-channel park, the wake
# through the first fed channel, and the stale-cell dedup (the select's
# cell on the second channel is skipped by the queued flag).

fn feeder(go: Chan[int], out: Chan[int], v: int) -> int uses Conc {
    go.recv()
    out.send(v)
    return 0
}

fn gatekeeper(start: Chan[int], go: Chan[int]) -> int uses Conc {
    start.recv()
    go.send(1)
    go.send(2)
    return 0
}

fn main() -> int uses IO, Conc {
    let ch_a: Chan[int] = chan_new()
    let ch_b: Chan[int] = chan_new()
    let start: Chan[int] = chan_new()
    let go: Chan[int] = chan_new()
    let g: Task[int] = spawn(gatekeeper, clone(start), clone(go))
    let f1: Task[int] = spawn(feeder, clone(go), clone(ch_a), 11)
    let f2: Task[int] = spawn(feeder, clone(go), clone(ch_b), 22)
    start.send(1)
    let chs: list[Chan[int]] = [ch_a, ch_b]
    let idx: int = select(chs)
    let a: int = ch_a.recv()
    let b: int = ch_b.recv()
    let rg: int = g.join()
    let r1: int = f1.join()
    let r2: int = f2.join()
    println("idx=" + idx.to_str() + " a=" + a.to_str() + " b=" + b.to_str())
    println("rg=" + rg.to_str() + " r1=" + r1.to_str() + " r2=" + r2.to_str())
    return 0
}
