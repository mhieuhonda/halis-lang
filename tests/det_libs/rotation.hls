# rotation.hls — Stage 127 fixture: the FIFO rotation witness. The trace
# this program produces under HL_DET_SCHED (+ HL_DET_TRACE) is asserted
# line-by-line by tests/det_acceptance.py, and the same trace must come
# out of the native backend — the policy made visible.

fn echo(inp: Chan[int], out: Chan[int]) -> int uses Conc {
    let mut i: int = 0
    while i < 2 {
        let v: int = inp.recv()
        out.send(v + 1)
        i = i + 1
    }
    return 0
}

fn main() -> int uses IO, Conc {
    let req: Chan[int] = chan_new()
    let rep: Chan[int] = chan_new()
    let t: Task[int] = spawn(echo, clone(req), clone(rep))
    req.send(10)
    req.send(20)
    let a: int = rep.recv()
    let b: int = rep.recv()
    let total: int = t.join()
    println("a=" + a.to_str() + " b=" + b.to_str() + " total=" + total.to_str())
    return 0
}
