# deadlock.hls — Stage 127 fixture: a REAL deadlock under the
# deterministic scheduler. Both tasks block on channels nobody will ever
# feed, and main joins one of them: the all-blocked moment arrives, the
# det deadlock scan runs (the ready queue is empty, every waiter is
# live), and the program must die with the canonical Stage 16 message —
# the same verdict the preemptive runtime gives.

fn stuck(ch: Chan[int]) -> int uses Conc {
    let v: int = ch.recv()
    return v
}

fn main() -> int uses IO, Conc {
    let ch: Chan[int] = chan_new()
    let t: Task[int] = spawn(stuck, clone(ch))
    let r: int = t.join()
    println("unreachable=" + r.to_str())
    return 0
}
