# rotation_test.hls — Stage 127 fixture: hltest --det witness. A
# test_-function workload (the hltest shape) whose assertions depend on
# channel traffic between tasks; under --det the run is reproducible
# and the trace stable. The functions return normally on success and
# panic on failure (the hltest contract).

import "std.test"

fn sum_worker(jobs: Chan[int], results: Chan[int]) -> int uses Conc {
    let mut total: int = 0
    let mut go: int = 1
    while go == 1 {
        let j: int = jobs.recv()
        if j < 0 {
            go = 0
        } else {
            total = total + j
            results.send(j)
        }
    }
    return total
}

fn test_pipeline_roundtrip() uses IO, Conc {
    let jobs: Chan[int] = chan_new()
    let results: Chan[int] = chan_new()
    let t: Task[int] = spawn(sum_worker, clone(jobs), clone(results))
    jobs.send(2)
    jobs.send(3)
    jobs.send(5)
    jobs.send(-1)
    let mut acc: int = 0
    let mut i: int = 0
    while i < 3 {
        let v: int = results.recv()
        acc = acc + v
        i = i + 1
    }
    let total: int = t.join()
    if acc != 10 {
        panic("roundtrip sum wrong: " + acc.to_str())
    }
    if total != 10 {
        panic("worker total wrong: " + total.to_str())
    }
}

fn test_bounded_backpressure() uses IO, Conc {
    let jobs: Chan[int] = chan_new_bounded(1)
    let results: Chan[int] = chan_new()
    let t: Task[int] = spawn(sum_worker, clone(jobs), clone(results))
    # A cap-1 jobs channel: every send after the first blocks until the
    # worker has consumed the previous one — backpressure both ways.
    let mut sent: int = 0
    while sent < 4 {
        jobs.send(sent)
        sent = sent + 1
    }
    jobs.send(-1)
    let mut echo: int = 0
    let mut i: int = 0
    while i < 4 {
        let v: int = results.recv()
        echo = echo + v
        i = i + 1
    }
    let r: int = t.join()
    if echo != 6 {
        panic("echo sum wrong: " + echo.to_str())
    }
    if r != 6 {
        panic("worker total wrong: " + r.to_str())
    }
}

# The differential-suite shape: main() runs every test so boot.py and
# the native backend get the same answer as hltest.
fn main() -> int uses IO, Conc {
    test_pipeline_roundtrip()
    test_bounded_backpressure()
    println("rotation_test ok")
    return 0
}
