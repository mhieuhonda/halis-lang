# kernel.hls — the Stage 83 register-width migration bed.
#
# Four asm! helpers, every narrow GPR family the width rule owns:
# 32-bit names (eax/edx), 16-bit (dx), 8-bit low (al), a narrow
# clobber entry (r9d) and a 32-bit name on a bool operand (r14d —
# Stage 83 carries a bool through an int64 register variable, so the
# full register is the only honest spelling).
#
# The helpers are declared but never called from main(): the boot
# interpreter cannot execute assembly; the native backend compiles
# them. Pre-migration the checker rejects every narrow spelling;
# post-migration (asm-width) the file checks clean.

fn read_tsc_old() -> int {
    let mut lo: int = 0
    let mut hi: int = 0
    asm!("rdtsc", out("eax") lo, out("edx") hi)
    return lo
}

fn port_in_old(port: int) -> int {
    let mut v: int = 0
    asm!("in %w1, %b0", in("dx") port, out("al") v, options(nomem, preserves_flags))
    return v
}

fn add_one_old(x: int) -> int {
    let mut s: int = x
    asm!("add $1, %0", inout("ecx") s, clobber("r9d"), options(nomem))
    return s
}

fn flag_old() -> bool {
    let mut hit: bool = false
    asm!("mov $1, %0", out("r14d") hit, options(nomem))
    return hit
}

fn main() -> int {
    return 0
}
