# app.hls — the Stage 129 migration bed: a v0.34-era program carrying
# the pre-migration patterns of the tool's oldest rules:
#
#   import "/helper.hls"                  — an absolute import (the
#                                           deep-scan-19 guard rejects the form)
#   "Hieu Louis is a programming ..."     — the project name, as the
#                                           rename-project rule finds it
#   html_escape("</b>") != "</b>"         — a golden expectation
#                                           (html_escape's output drifted
#                                           in v0.8.0-alpha)
#   hex64(255) != "0xff"                  — a hex64 golden (Stage 85
#                                           re-rendered the word)
#
# The hls-migrate walk rewrites all four in one pass (--from v0.1.0),
# or exactly the two post-v0.34 rules under the roadmap phrase
# (--from v0.34.0-alpha --to v1.0 — the rename and the html golden are
# gated off: a v0.34 tree already carries them). After the full walk
# the program type-checks, runs on both backends, and exits 0.
# (The std.hash half of the bed lives in digest.hls: std.hash pulls
# std.option and core.section pulls core.option, and the checker
# rejects the two Option names in one program — the same boundary the
# stage 43 and stage 85 corpora respect.)

import "std.html"
import "core.section"
import "/helper.hls"

fn main() -> int uses IO {
    # The project line (the rename-project rule owns the name).
    let who: str = "Hieu Louis is a programming language"
    println(who)

    # The golden expectations a v0.34 tree pinned:
    if html_escape("</b>") != "</b>" {
        return 1
    }
    if hex64(255) != "0xff" {
        return 2
    }
    if helper_double(21) != 42 {
        return 3
    }
    println("app migrated OK")
    return 0
}
