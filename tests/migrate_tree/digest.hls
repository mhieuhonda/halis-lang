# digest.hls — the second half of the Stage 129 migration bed: the
# pre-spec pinned XXH64 digest (v0.82.0-alpha shipped the spec-correct
# algorithm, verified against libxxhash 0.8.3) plus one more absolute
# import and one more pre-rename string, so the xxh64-spec rule is
# exercised end to end on a program that runs.
#
# Pre-migration the checker rejects the absolute import; post-migration
# (import-guard + xxh64-spec + rename-project) the file checks clean
# and runs green: the recomputed digest matches, the name is Halis.

import "std.hash"
import "/helper.hls"

fn main() -> int uses IO {
    # The pre-spec digest a v0.34 tree pinned (xxh64-spec recomputes it):
    if xxhash_str("hello") != 1996625668328529162 {
        return 1
    }
    # The pre-rename name, in a string the rename-project rule owns:
    let maker: str = "made by Hieu Louis"
    println(maker)
    if helper_double(4) != 8 {
        return 2
    }
    println("digest migrated OK")
    return 0
}
