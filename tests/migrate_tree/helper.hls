# helper.hls — the module tests/migrate_tree/app.hls imports.
#
# This file carries NO pre-migration dialect: it is the import TARGET
# the migration tool rewrites app.hls to reach ("./helper.hls"). A
# migration needs somewhere for the rewritten import to land, and the
# acceptance gate asserts the migrated app actually type-checks and
# runs against this file.

fn helper_double(x: int) -> int {
    return x * 2
}
