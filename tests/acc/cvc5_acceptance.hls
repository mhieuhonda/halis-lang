# ============================================================================
# tests/acc/cvc5_acceptance.hls — Stage 99 acceptance gate, in Halis
# (the Halis twin of tests/cvc5_acceptance.py; same six sections, same
# assertions, same needles — the harness is tests/acc/harness.hls and
# the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make cvc5-acceptance` (which compiles this file to
# bin/acc-cvc5 and runs it from the repo root).
#
# The old battery reached into tools.hlprove internals (_cvc5_binary_decide,
# _cvc5_module_decide, make_cvc5_decider, gen_smt) and into the proof
# engine's loop summaries; the gate asks the same questions through the
# front door: `hlprove --cvc5 / --z3 / --smt / --infer-invariants` per
# probe, the obligation dumps re-decided segment by segment through BOTH
# deciders (binary first, module fallback — the module driven through a
# `python3 -c` child, like every other tool the gate spawns). A missing
# backend is the battery's [note] leg: neither a pass nor a failure —
# but with NO cvc5 backend (or no z3, which the parity sections need)
# the gate says so and exits 1, exactly like the battery.
#
# The gate's scratch tree is named s99 (NOT cvc5) for the same reason
# the battery's tempfile is: the parity sections normalise the solver's
# name in the CLI output, and a path carrying the name would survive
# one side's replace.
#
#  1. the backend — the cvc5 binary and the cvc5 module answer a
#     trivial probe; the decider exists; a trivial unsat is unsat
#     through it; the z3 decider exists for the parity sections
#  2. the bridge — implied / not-implied / vacuous contracts under
#     --cvc5, --cvc5 implies --smt, verdicts match --z3 word for word
#  3. the inference — the Stage 97 battery through the cvc5 decider
#  4. cross-solver parity — every demo obligation decided by BOTH
#     backends agrees; the HMAC bridge too; the full CLI reports are
#     byte-identical modulo the solver's name
#  5. the CLI — the cvc5 labels, the refusal of --z3 together with
#     --cvc5, the honesty of a missing backend
#  6. the dump — the obligation files written under --cvc5 re-decide
#     unsat from the file alone
# ============================================================================

import "./harness.hls"
import "std.str"

# ----------------------------------------------------------------------------
# The gate's subjects.
# ----------------------------------------------------------------------------

fn demo() -> str {
    return "examples/invariant_demo.hls"
}

fn hmac() -> str {
    return "examples/hmac_proven.hls"
}

# ----------------------------------------------------------------------------
# The probe programs (verbatim from the battery).
# ----------------------------------------------------------------------------

fn sum_to_src() -> str {
    return "\n" +
    "fn sum_to(n: int) -> int\n" +
    "    requires n >= 0\n" +
    "{\n" +
    "    let mut s: int = 0\n" +
    "    let mut i: int = 0\n" +
    "    while i < n {\n" +
    "        s = s + i\n" +
    "        i = i + 1\n" +
    "    }\n" +
    "    return s\n" +
    "}\n" +
    "fn main() -> int { return 0 }\n"
}

fn step_two_src() -> str {
    return "\n" +
    "fn step_two(n: int) -> int\n" +
    "    requires n >= 0\n" +
    "{\n" +
    "    let mut i: int = 0\n" +
    "    while i < n {\n" +
    "        i = i + 2\n" +
    "    }\n" +
    "    return i\n" +
    "}\n" +
    "fn main() -> int { return 0 }\n"
}

fn skipper_src() -> str {
    return "\n" +
    "fn skipper(n: int) -> int\n" +
    "    requires n >= 0\n" +
    "{\n" +
    "    let mut i: int = n\n" +
    "    while i > 0 {\n" +
    "        i = i - 2\n" +
    "    }\n" +
    "    return i\n" +
    "}\n" +
    "fn main() -> int { return 0 }\n"
}

fn mod4_src() -> str {
    return "\n" +
    "fn mod4(n: int) -> int\n" +
    "    requires n >= 0\n" +
    "{\n" +
    "    let mut x: int = 0\n" +
    "    let mut k: int = 0\n" +
    "    while k < n {\n" +
    "        x = x + 4\n" +
    "        k = k + 1\n" +
    "    }\n" +
    "    return x\n" +
    "}\n" +
    "fn main() -> int { return 0 }\n"
}

fn times2_src() -> str {
    return "\n" +
    "fn times2(n: int) -> int\n" +
    "    requires n >= 0\n" +
    "{\n" +
    "    let mut i: int = 1\n" +
    "    while i < n {\n" +
    "        i = i * i\n" +
    "    }\n" +
    "    return i\n" +
    "}\n" +
    "fn main() -> int { return 0 }\n"
}

fn escaper_src() -> str {
    return "\n" +
    "fn escaper(n: int) -> int\n" +
    "    requires n >= 0\n" +
    "{\n" +
    "    let mut i: int = 0\n" +
    "    while i < n {\n" +
    "        if i == 3 {\n" +
    "            break\n" +
    "        }\n" +
    "        i = i + 1\n" +
    "    }\n" +
    "    return i\n" +
    "}\n" +
    "fn main() -> int { return 0 }\n"
}

# Three contracts built to force three DIFFERENT verdicts.
fn bridge_src() -> str {
    return "fn implied(x: int, y: int) -> int\n" +
    "    requires x >= 2\n" +
    "    requires y >= 3\n" +
    "    ensures x + y >= 5\n" +
    "{\n" +
    "    return x + y\n" +
    "}\n" +
    "fn not_implied(x: int, y: int) -> int\n" +
    "    requires x >= 2\n" +
    "    requires y >= 3\n" +
    "    ensures x + y >= 6\n" +
    "{\n" +
    "    return x + y\n" +
    "}\n" +
    "fn vacuous(n: int) -> int\n" +
    "    requires n > 0\n" +
    "    requires n < 0\n" +
    "{\n" +
    "    return 0\n" +
    "}\n" +
    "fn main() -> int { return 0 }\n"
}

# ----------------------------------------------------------------------------
# Shared legs: the tool front door, the needle helpers, the deciders.
# ----------------------------------------------------------------------------

fn hp(path: str, flags: list[str]) -> RunResult uses Proc {
    let argv: list[str] = ["tools/hlprove.py", path]
    let mut i: int = 0
    while i < flags.len() {
        argv.push(flags.get(i))
        i = i + 1
    }
    return run_capture("python3", argv)
}

fn has_line_start(text: str, prefix: str) -> bool {
    let lines: list[str] = text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).starts_with(prefix) {
            return true
        }
        i = i + 1
    }
    return false
}

fn has_accepted(out: str, t: str) -> bool {
    return has_line_start(out, "      " + t + "   (")
}

fn has_rejected(out: str, t: str) -> bool {
    return has_line_start(out, "    rejected: " + t + " (")
}

fn count_loop_headers(out: str) -> int {
    let lines: list[str] = out.split("\n")
    let mut n: int = 0
    let mut i: int = 0
    while i < lines.len() {
        let l: str = lines.get(i)
        if l.starts_with("  ") && !l.starts_with("   ")
        && (l.contains(": while ") || l.contains(": for ")) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn obligation_paths(out: str) -> list[str] {
    let paths: list[str] = []
    let lines: list[str] = out.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let t: str = lines.get(i).trim()
        if t.starts_with("obligations -> ") {
            paths.push(t.slice(15, t.len()))
        }
        i = i + 1
    }
    return paths
}

# bridge_paths(out) — the `    <fn>  -> <path>.smt2` lines of the
# SMT-LIB2 bridge section (the contract files gen_smt wrote).
fn bridge_paths(out: str) -> list[str] {
    let paths: list[str] = []
    let lines: list[str] = out.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let t: str = lines.get(i).trim()
        if t.ends_with(".smt2") && t.contains(" -> ")
        && !t.starts_with("obligations -> ") {
            let at: int = t.find(" -> ")
            paths.push(t.slice(at + 4, t.len()))
        }
        i = i + 1
    }
    return paths
}

fn split_reset(text: str) -> list[str] {
    let out: list[str] = []
    let mut start: int = 0
    let mut going: bool = true
    while going {
        let rest: str = text.slice(start, text.len())
        let rel: int = rest.find("(reset)")
        if rel < 0 {
            out.push(rest)
            going = false
        } else {
            out.push(rest.slice(0, rel))
            start = start + rel + 7
        }
    }
    return out
}

fn first_verdict(out: str) -> str {
    let lines: list[str] = out.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let t: str = lines.get(i).trim()
        if t == "sat" || t == "unsat" || t == "unknown" {
            return t
        }
        i = i + 1
    }
    return ""
}

fn replace_all(s: str, from: str, to: str) -> str {
    if from == "" {
        return s
    }
    let mut out: str = ""
    let mut rest: str = s
    let mut going: bool = true
    while going {
        let at: int = rest.find(from)
        if at < 0 {
            out = out + rest
            going = false
        } else {
            out = out + rest.slice(0, at) + to
            rest = rest.slice(at + from.len(), rest.len())
        }
    }
    return out
}

# The module deciders, run through `python3 -c` children (one segment
# file in, the check-sat verdict out) — the same logic the battery's
# _z3_module_decide / _cvc5_module_decide wrap.
fn z3_mod_script() -> str {
    return "import sys, z3\n" +
    "s = z3.Solver()\n" +
    "s.from_string(open(sys.argv[1]).read())\n" +
    "print(s.check())\n"
}

fn cvc5_mod_script() -> str {
    return "import sys, cvc5\n" +
    "tm = cvc5.TermManager()\n" +
    "s = cvc5.Solver(tm)\n" +
    "try:\n" +
    "    p = cvc5.InputParser(s)\n" +
    "except (TypeError, RuntimeError):\n" +
    "    p = cvc5.InputParser(tm, s)\n" +
    "sm = p.getSymbolManager()\n" +
    "lang = getattr(cvc5.InputLanguage, 'SMT_LIB_2_6',"
    + " getattr(cvc5.InputLanguage, 'SMT_LIB_V2', None))\n" +
    "p.setStringInput(lang, open(sys.argv[1]).read(), 'gate')\n" +
    "last = None\n" +
    "while not p.done():\n" +
    "    cmd = p.nextCommand()\n" +
    "    if cmd.isNull():\n" +
    "        break\n" +
    "    try:\n" +
    "        last = cmd.invoke(s, sm)\n" +
    "    except TypeError:\n" +
    "        last = cmd.invoke(s)\n" +
    "v = (last or '').strip()\n" +
    "print(v if v in ('sat', 'unsat', 'unknown') else '?')\n"
}

# decide_z3(acc, text, tag) — z3 binary first, then the module.
fn decide_z3(acc: Acc, text: str, tag: str) -> str uses Fs, Proc {
    let p: str = write_src(acc, "z3seg_" + tag + ".smt2", text)
    if which("z3") {
        let r: RunResult = run_capture("z3", [p])
        if r.code == 0 {
            let v: str = first_verdict(r.out)
            if v != "" {
                return v
            }
            return "?"
        }
        return "?"
    }
    let m: RunResult = run_capture("python3", ["-c", z3_mod_script(), p])
    let v2: str = m.out.trim()
    if v2 == "sat" || v2 == "unsat" || v2 == "unknown" {
        return v2
    }
    if v2 == "?" {
        return "?"
    }
    return "?"
}

# decide_cvc5(acc, text, tag) — cvc5 binary first (`--lang smt2 -q`, the
# stdin `-` convention is not portable across cvc5 builds), then the
# cvc5 python module. The same order make_cvc5_decider() uses.
fn decide_cvc5(acc: Acc, text: str, tag: str) -> str uses Fs, Proc {
    let p: str = write_src(acc, "cvcseg_" + tag + ".smt2", text)
    if which("cvc5") {
        let r: RunResult = run_capture("cvc5", ["--lang", "smt2", "-q", p])
        if r.code == 0 {
            let v: str = first_verdict(r.out)
            if v != "" {
                return v
            }
            return "?"
        }
        return "?"
    }
    let m: RunResult = run_capture("python3", ["-c", cvc5_mod_script(), p])
    let v2: str = m.out.trim()
    if v2 == "sat" || v2 == "unsat" || v2 == "unknown" {
        return v2
    }
    return "?"
}

# probe_cvc5_binary(acc) — the trivial probe through the binary; ""
# when there is no binary on PATH.
fn probe_cvc5_binary(acc: Acc) -> str uses Fs, Proc {
    if !which("cvc5") {
        return ""
    }
    let p: str = write_src(acc, "cvc_bin_probe.smt2", "(check-sat)\n")
    let r: RunResult = run_capture("cvc5", ["--lang", "smt2", "-q", p])
    if r.code == 0 {
        let v: str = first_verdict(r.out)
        if v != "" {
            return v
        }
        return "?"
    }
    return "?"
}

# probe_cvc5_module(acc) — the trivial probe through the module; ""
# when the module is unavailable.
fn probe_cvc5_module(acc: Acc) -> str uses Fs, Proc {
    let p: str = write_src(acc, "cvc_mod_probe.smt2", "(check-sat)\n")
    let m: RunResult = run_capture("python3", ["-c", cvc5_mod_script(), p])
    let v: str = m.out.trim()
    if v == "sat" || v == "unsat" || v == "unknown" {
        return v
    }
    if v == "?" {
        return "?"
    }
    return ""
}

fn z3_module_ok(acc: Acc) -> bool uses Fs, Proc {
    let p: str = write_src(acc, "z3probe.smt2", "(check-sat)\n")
    let m: RunResult = run_capture("python3", ["-c", z3_mod_script(), p])
    let v: str = m.out.trim()
    return v == "sat" || v == "unsat" || v == "unknown"
}

fn z3_available(acc: Acc) -> bool uses Fs, Proc {
    if which("z3") {
        return true
    }
    return z3_module_ok(acc)
}

# ls_dir(path) — the entries of a directory (the batteries' listdir).
fn ls_dir(path: str) -> list[str] uses Proc {
    let out: list[str] = []
    let r: RunResult = run_capture("ls", ["-1", path])
    if r.code != 0 {
        return out
    }
    let lines: list[str] = r.out.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let t: str = lines.get(i).trim()
        if t != "" {
            out.push(t)
        }
        i = i + 1
    }
    return out
}

# clean_demo_dumps(acc) — remove the obligation dumps the demo runs
# leave next to the source (the bridge convention: same directory as
# the .hls).
fn clean_demo_dumps(acc: Acc) -> void uses Fs, Proc {
    let entries: list[str] = ls_dir("examples")
    let mut i: int = 0
    while i < entries.len() {
        let f: str = entries.get(i)
        if f.ends_with(".smt2") && f.contains("__L") {
            rmrf(path_join3("examples", f))
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 1. the backend
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs, Proc, Exit {
    section("1. the backend")
    let bin_v: str = probe_cvc5_binary(acc)
    let mod_v: str = probe_cvc5_module(acc)
    if bin_v != "" {
        pass_msg(acc, "the cvc5 binary is on PATH and answers: " + bin_v)
    } else {
        println("  [note] no cvc5 binary on PATH — the module carries the gate")
    }
    if mod_v != "" {
        pass_msg(acc, "the cvc5 python module is importable and answers: " + mod_v)
    } else {
        println("  [note] no cvc5 python module — the binary carries the gate")
    }
    if bin_v == "" && mod_v == "" {
        fail_msg(acc, "no cvc5 binary and no cvc5 module — install one:"
        + " put a cvc5 binary on PATH or pip install cvc5")
        exit(1)
    }
    pass_msg(acc, "the cvc5 decider is available (binary first, module fallback)")
    let trivial: str = "(declare-const x Int)\n(assert (> x 0))\n" +
    "(assert (not (> x 0)))\n(check-sat)"
    let v: str = decide_cvc5(acc, trivial, "trivial")
    check(acc, "a trivial contradiction decides unsat through the cvc5 decider",
    v == "unsat", "decided " + v)
    if !z3_available(acc) {
        fail_msg(acc, "no z3 binary and no z3-solver module — the parity"
        + " sections need both backends (pip install z3-solver)")
        exit(1)
    }
    pass_msg(acc, "the z3 decider is available (the parity sections need it)")
}

# ----------------------------------------------------------------------------
# 2. the bridge
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    section("2. the bridge")
    let probe: str = write_src(acc, "bridge_probe.hls", bridge_src())
    let out_cvc5: RunResult = hp(probe, ["--cvc5"])
    let out_z3: RunResult = hp(probe, ["--z3"])
    check(acc, "hlprove --cvc5 runs the bridge clean on the probe",
    out_cvc5.code == 0, "rc=" + out_cvc5.code.to_str())
    check(acc, "bridge: the implied ensures is certified unsat (requires |= ensures)",
    out_cvc5.out.contains("implied")
    && out_cvc5.out.contains("cvc5: vacuity: sat, ensures: unsat"), "")
    check(acc, "bridge: the NOT-implied ensures is certified sat (no rubber stamp)",
    out_cvc5.out.contains("not_implied")
    && out_cvc5.out.contains("cvc5: vacuity: sat, ensures: sat"), "")
    check(acc, "bridge: the vacuous contract is certified unsat (vacuity)",
    out_cvc5.out.contains("cvc5: vacuity: unsat"), "")
    check(acc, "bridge: the header says cvc5-ready under --cvc5",
    out_cvc5.out.contains("SMT-LIB2 bridge (cvc5-ready"), "")
    # --cvc5 implies --smt: the .smt2 files land next to the source.
    check(acc, "--cvc5 implies --smt (the obligation files are written)",
    file_exists(path_join3(acc.scratch_base, "implied.smt2"))
    && file_exists(path_join3(acc.scratch_base, "not_implied.smt2"))
    && file_exists(path_join3(acc.scratch_base, "vacuous.smt2")), "")
    # The verdict lines agree word for word once the solver name is
    # normalised.
    check(acc, "the cvc5 bridge verdicts match the z3 run word for word",
    out_z3.code == 0 && replace_all(out_cvc5.out, "cvc5", "z3") == out_z3.out,
    "")
}

# ----------------------------------------------------------------------------
# 3. the inference battery
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. the inference battery")
    # The Stage 97 battery, re-decided by cvc5: every acceptance and
    # every refusal must be the SAME verdict z3 gave.
    let p1: str = write_src(acc, "sum_to.hls", sum_to_src())
    let r1: RunResult = hp(p1, ["--cvc5", "--infer-invariants"])
    check(acc, "sum_to: i <= n, i >= 0 AND the strengthened s >= 0 are inferred",
    has_accepted(r1.out, "i <= n") && has_accepted(r1.out, "i >= 0")
    && has_accepted(r1.out, "s >= 0"),
    clip(r1.out, 120))
    check(acc, "sum_to: the stale entry bound i <= 0 is refused (preservation)",
    has_rejected(r1.out, "i <= 0"), "")
    let p2: str = write_src(acc, "step_two.hls", step_two_src())
    let r2: RunResult = hp(p2, ["--cvc5", "--infer-invariants"])
    check(acc, "step_two: i <= n refused, the overshoot bound i <= n + 1 kept",
    !has_accepted(r2.out, "i <= n") && has_accepted(r2.out, "i <= n + 1")
    && has_accepted(r2.out, "i >= 0"),
    clip(r2.out, 120))
    let p3: str = write_src(acc, "skipper.hls", skipper_src())
    let r3: RunResult = hp(p3, ["--cvc5", "--infer-invariants"])
    check(acc, "skipper: i >= 0 refused, the true floor i >= -1 discovered",
    !has_accepted(r3.out, "i >= 0") && has_accepted(r3.out, "i >= -1"),
    clip(r3.out, 120))
    let p4: str = write_src(acc, "mod4.hls", mod4_src())
    let r4: RunResult = hp(p4, ["--cvc5", "--infer-invariants"])
    check(acc, "mod4: the congruence x ≡ 0 (mod 4) is inferred (non-interval)",
    has_accepted(r4.out, "x ≡ 0 (mod 4)"), clip(r4.out, 120))
    let p5: str = write_src(acc, "times2.hls", times2_src())
    let r5: RunResult = hp(p5, ["--cvc5", "--infer-invariants"])
    check(acc, "times2: the non-affine body is reported unmodeled",
    r5.out.contains("unmodeled: i (non-affine update"), clip(r5.out, 120))
    check(acc, "times2: no invariant is claimed over an unmodeled variable",
    r5.out.contains("inferred: (none)"), "")
    let p6: str = write_src(acc, "escaper.hls", escaper_src())
    let r6: RunResult = hp(p6, ["--cvc5", "--infer-invariants"])
    check(acc, "escaper: the break sends i unmodeled and nothing is claimed",
    r6.out.contains("unmodeled: i (") && r6.out.contains("inferred: (none)"),
    clip(r6.out, 120))
}

# ----------------------------------------------------------------------------
# 4. cross-solver parity
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> RunResult uses IO, Fs, Proc {
    section("4. cross-solver parity")
    # The obligations decide the verdicts — so BOTH backends must
    # certify every obligation of the demo.
    let dump: RunResult = hp(demo(), ["--cvc5", "--infer-invariants", "--smt"])
    let paths: list[str] = obligation_paths(dump.out)
    let mut seg_count: int = 0
    let mut cvc5_unsat: bool = true
    let mut z3_agrees: bool = true
    let mut i: int = 0
    while i < paths.len() {
        let text: str = read_or(paths.get(i), "")
        let segs: list[str] = split_reset(text)
        let mut s: int = 0
        while s < segs.len() {
            let seg: str = segs.get(s).trim()
            if seg != "" {
                seg_count = seg_count + 1
                let tag: str = "p" + i.to_str() + "_" + s.to_str()
                let v1: str = decide_cvc5(acc, seg, tag)
                let v2: str = decide_z3(acc, seg, tag + "z")
                if v1 != "unsat" {
                    cvc5_unsat = false
                    fail_msg(acc, basename(paths.get(i))
                    + ": cvc5 decided " + v1 + " (expected unsat)")
                }
                if v2 != v1 {
                    z3_agrees = false
                    fail_msg(acc, basename(paths.get(i)) + ": z3 decided "
                    + v2 + " against cvc5's " + v1)
                }
            }
            s = s + 1
        }
        rmrf(paths.get(i))
        i = i + 1
    }
    if cvc5_unsat && z3_agrees && seg_count > 0 {
        pass_msg(acc, seg_count.to_str() + " obligation segments across "
        + count_loop_headers(dump.out).to_str()
        + " loops: cvc5-unsat, z3 agrees")
    } else {
        if seg_count == 0 {
            fail_msg(acc, "no obligation segments were generated for the demo")
        }
    }
    # The contract bridge of the HMAC acceptance example: every segment
    # decided independently by both backends must pair up.
    let hm: RunResult = hp(hmac(), ["--smt"])
    let hpaths: list[str] = bridge_paths(hm.out)
    let mut pairs: int = 0
    let mut parity: bool = true
    let mut j: int = 0
    while j < hpaths.len() {
        let text: str = read_or(hpaths.get(j), "")
        let segs: list[str] = split_reset(text)
        let mut s: int = 0
        while s < segs.len() {
            let seg: str = segs.get(s).trim()
            if seg != "" && seg.contains("(check-sat)") {
                let tag: str = "h" + j.to_str() + "_" + s.to_str()
                let v1: str = decide_cvc5(acc, seg, tag)
                let v2: str = decide_z3(acc, seg, tag + "z")
                pairs = pairs + 1
                if v1 != v2 || (v1 != "sat" && v1 != "unsat") {
                    parity = false
                    fail_msg(acc, basename(hpaths.get(j))
                    + ": backends disagree (" + v1 + " vs " + v2 + ")")
                }
            }
            s = s + 1
        }
        rmrf(hpaths.get(j))
        j = j + 1
    }
    if parity && pairs > 0 {
        pass_msg(acc, pairs.to_str() + " bridge segments of " + hmac()
        + ": cvc5 and z3 agree on every verdict")
    } else {
        if pairs == 0 {
            fail_msg(acc, "no bridge segments for the HMAC example")
        }
    }
    # The full CLI reports are byte-identical modulo the solver's name.
    let cli_cvc5: RunResult = hp(demo(), ["--cvc5", "--infer-invariants"])
    let cli_z3: RunResult = hp(demo(), ["--z3", "--infer-invariants"])
    check(acc, "the full CLI report is identical across backends (modulo the"
    + " solver's name)",
    cli_cvc5.code == 0 && cli_z3.code == 0
    && replace_all(cli_cvc5.out, "cvc5", "z3") == cli_z3.out, "")
    # Both parity runs implied --smt: take their dumps back in.
    let ob1: list[str] = obligation_paths(cli_cvc5.out)
    let mut m1: int = 0
    while m1 < ob1.len() {
        rmrf(ob1.get(m1))
        m1 = m1 + 1
    }
    let ob2: list[str] = obligation_paths(cli_z3.out)
    let mut m2: int = 0
    while m2 < ob2.len() {
        rmrf(ob2.get(m2))
        m2 = m2 + 1
    }
    return cli_cvc5
}

# ----------------------------------------------------------------------------
# 5. the CLI
# ----------------------------------------------------------------------------
fn sec5(acc: Acc, cli_cvc5: RunResult) -> void uses IO, Fs, Proc {
    section("5. the CLI")
    let txt: str = cli_cvc5.out
    check(acc, "cli: the inference header names the backend",
    txt.contains("cvc5-checked"), "")
    check(acc, "cli: the strengthened accumulator is reported as cvc5-verified",
    txt.contains("inferred (cvc5-verified inductive):")
    && txt.contains("      s >= 0   (entry-bound)"), "")
    check(acc, "cli: the overshoot bound is reported",
    txt.contains("i <= n + 1   (cond-bound)"), "")
    check(acc, "cli: the refusal names its obligation",
    txt.contains("rejected: i >= 0 (preservation obligation not discharged)"), "")
    check(acc, "cli: the totals line closes the report",
    txt.contains("INFERENCE TOTAL:") && txt.contains("invariants verified"), "")
    let both: RunResult = hp(demo(), ["--z3", "--cvc5"])
    check(acc, "cli: --z3 together with --cvc5 is refused (rc=2, pick one)",
    both.code == 2 && both.err.contains("pick one"),
    "rc=" + both.code.to_str())
    # With neither binary nor module the decider is None — nothing is
    # ever claimed without verdicts. Through the front door: a python
    # without site-packages cannot import cvc5 and a stripped PATH hides
    # any binary, so hlprove's own decider probe must come back empty
    # and the report must claim nothing.
    let hon: RunResult = run_capture("/usr/bin/env",
    ["PATH=/usr/bin:/bin", "/usr/bin/python3", "-S", "tools/hlprove.py",
    demo(), "--cvc5", "--infer-invariants"])
    check(acc, "cli: with neither binary nor module the decider is None"
    + " (nothing is ever claimed without verdicts)",
    hon.out.contains("nothing is claimed as inferred")
    && hon.out.contains("0 invariants verified")
    && !hon.out.contains("cvc5-verified"),
    clip(hon.out, 90))
}

# ----------------------------------------------------------------------------
# 6. the dump
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    section("6. the dump")
    clean_demo_dumps(acc)
    let dump: RunResult = hp(demo(), ["--cvc5", "--infer-invariants", "--smt"])
    if dump.code != 0 {
        fail_msg(acc, "the --cvc5 --smt dump run failed (rc=" + dump.code.to_str() + ")")
    }
    let entries: list[str] = ls_dir("examples")
    let mut dumps: list[str] = []
    let mut i: int = 0
    while i < entries.len() {
        let f: str = entries.get(i)
        if f.ends_with(".smt2") && f.contains("__L") {
            dumps.push(f)
        }
        i = i + 1
    }
    if dumps.len() == 0 {
        fail_msg(acc, "the --cvc5 --smt dump wrote no obligation files")
        return
    }
    pass_msg(acc, dumps.len().to_str() + " obligation files dumped next to the demo")
    let mut dumped_ok: bool = true
    let mut k: int = 0
    while k < dumps.len() {
        let fpath: str = path_join3("examples", dumps.get(k))
        let text: str = read_or(fpath, "")
        let segs: list[str] = split_reset(text)
        let mut s: int = 0
        while s < segs.len() {
            let seg: str = segs.get(s).trim()
            if seg != "" {
                if decide_cvc5(acc, seg, "d" + k.to_str() + "_" + s.to_str()) != "unsat" {
                    dumped_ok = false
                }
            }
            s = s + 1
        }
        rmrf(fpath)
        k = k + 1
    }
    if dumped_ok {
        pass_msg(acc, "every dumped obligation re-decides unsat through cvc5")
    } else {
        fail_msg(acc, "a dumped obligation is not unsat — the file lies")
    }
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("s99")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    let cli_cvc5: RunResult = sec4(acc)
    sec5(acc, cli_cvc5)
    sec6(acc)
    return finish(acc, "Stage 99 -- hlprove --cvc5, the CVC5 SMT backend")
}
