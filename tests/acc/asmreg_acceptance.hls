# ============================================================================
# tests/acc/asmreg_acceptance.hls — Stage 83 acceptance gate, in Halis
# (the Halis twin of what was tests/asmreg_acceptance.py; same seven
# sections, same assertions, same needles — the harness is
# tests/acc/harness.hls and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make asmreg-acceptance` (which compiles this file to
# bin/acc-asmreg and runs it from the repo root).
#
# The old battery reached into the lab interpreter's Python internals
# (_resolve_import, tokenize/Parser) for its first two sections; the
# gate asks the same questions through the FRONT DOOR — probe programs
# the CLI must accept or reject, and source-shape greps — so the gate
# itself needs no Python of its own beyond the oracle legs every gate
# spawns by design.
#
#  1. core.asm resolution + traversal guards (through probe programs)
#  2. core.asm parses standalone (enum + fns, zero imports)
#  3. Stage-0 enforcement (ok-test clean; demo native-only; fails
#     rejected with the asm! diagnostics)
#  4. Targeted probes: valid register-constraint forms accepted, every
#     diagnostic class fires with its exact message
#  5. Self-hosted emission (hlc.hls through the interpreter): the demo
#     compiles to C carrying local register variables and explicit
#     clobbers, links -Werror and prints DEMO OK; the ok-test compiles
#     hosted and freestanding with exit 0; boot/hlc parity on the fail
#     programs
#  6. hlfmt stability over every Stage 83 file
#  7. --audit shows every core.asm function pure (no uses)
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.regex"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

struct ProbeV {
    name: str,
    body: str
}

struct ProbeR {
    name: str,
    fragment: str,
    needle: str
}

fn demo() -> str {
    return "examples/asmreg_demo.hls"
}

fn ok_test() -> str {
    return "tests/ok/feat_stage83_asmreg.hls"
}

fn core_asm() -> str {
    return "core/asm.hls"
}

fn core_modules() -> list[str] {
    return ["option", "result", "iter", "clone", "eq", "alloc", "mem",
            "panic", "stack", "asm"]
}

fn fail_programs() -> list[str] {
    return [
        "fail_asmreg_clobber_dup",
        "fail_asmreg_clobber_flags",
        "fail_asmreg_clobber_overlap",
        "fail_asmreg_clobber_rsp",
        "fail_asmreg_clobber_subreg",
        "fail_asmreg_dup_clause",
        "fail_asmreg_dup_operand_reg",
        "fail_asmreg_float_gp",
        "fail_asmreg_int_sse",
        "fail_asmreg_reg_width",
    ]
}

fn must_have_fns() -> list[str] {
    return [
        "asm64_gp_regs", "asm64_sse_regs", "asm_reg_width",
        "asm_reg_is_sse", "asm_reg_base", "asm_regs_overlap",
        "asm_valid_clobber", "asm_clobber_fault", "asm_operand_conflict",
        "asm_fault_name", "asm_fault_code", "asm_sysv_arg_reg",
        "asm_syscall_arg_reg", "asm_syscall_clobbers", "asm_sysv_ret_reg",
        "asm_sysv_fp_ret_reg", "asm_caller_saved", "asm_callee_saved",
        "asm_regs_to_save", "asm_scratch_reg", "asm_check_invariants",
    ]
}

fn valid_probes() -> list[ProbeV] {
    return [
        ProbeV {
            name: "syscall shape",
            body: "fn main() -> int { let mut ret: int = 231\n" +
                  " asm!(\"syscall\", in(\"rdi\") 0, inout(\"rax\") ret, clobber(\"rcx\", \"r11\"), options(nomem))\n" +
                  " return 0 }"
        },
        ProbeV {
            name: "64-bit names",
            body: "fn main() -> int { let mut a: int = 1\n" +
                  " asm!(\"nop\", in(\"rax\") a, inout(\"rbx\") a, out(\"r9\") a, options(nomem))\n" +
                  " return 0 }"
        },
        ProbeV {
            name: "r10/xmm regvars",
            body: "fn main() -> int { let mut i: int = 1\n let mut f: float = 0.0\n" +
                  " asm!(\"nop\", inout(\"r10\") i, in(\"xmm4\") f, out(\"xmm1\") f, clobber(\"r11\", \"xmm3\"), options(nomem))\n" +
                  " return 0 }"
        },
        ProbeV {
            name: "bool named reg",
            body: "fn main() -> int { let mut b: bool = false\n" +
                  " asm!(\"nop\", out(\"r14\") b, options(nomem))\n return 0 }"
        },
        ProbeV {
            name: "float reg/mem classes",
            body: "fn main() -> int { let mut f: float = 1.0\n" +
                  " asm!(\"nop\", in(reg) f, in(mem) f, options(nomem))\n return 0 }"
        },
        ProbeV {
            name: "fixed letters a/d",
            body: "fn main() -> int { let mut x: int = 0\n" +
                  " asm!(\"mov {1}, {0}\", in(\"a\") x, out(\"d\") x, options(nomem, preserves_flags))\n" +
                  " return 0 }"
        },
    ]
}

fn reject_probes() -> list[ProbeR] {
    return [
        ProbeR { name: "32-bit name for int", fragment: "in(\"eax\") x",
                 needle: "asm! register 'eax' is 32-bit; an int operand needs a 64-bit register — use 'rax'" },
        ProbeR { name: "16-bit name for int", fragment: "in(\"ax\") x",
                 needle: "asm! register 'ax' is 16-bit; an int operand needs a 64-bit register — use 'rax'" },
        ProbeR { name: "8-bit name for int", fragment: "in(\"al\") x",
                 needle: "asm! register 'al' is 8-bit; an int operand needs a 64-bit register — use 'rax'" },
        ProbeR { name: "SSE name for int", fragment: "out(\"xmm0\") x",
                 needle: "asm! register 'xmm0' is an SSE register; an int operand needs a general-purpose register (rax, rbx, ..., r15)" },
        ProbeR { name: "GP name for float", fragment: "in(\"rbx\") f",
                 needle: "asm! register 'rbx' is a general-purpose register; a float operand needs an SSE register — use reg (the SSE class) or an xmm0..xmm15 name" },
        ProbeR { name: "GP class for float", fragment: "in(\"r\") f",
                 needle: "asm! constraint 'r' is a general-purpose register class; a float operand needs an SSE class — use reg or an xmm0..xmm15 name" },
        ProbeR { name: "x87 class for float", fragment: "in(\"t\") f",
                 needle: "asm! constraint 't' is an x87/MMX register class; a float operand needs the SSE class — use reg or an xmm0..xmm15 name" },
        ProbeR { name: "int immediate for float", fragment: "in(\"i\") f",
                 needle: "asm! constraint 'i' is an integer-immediate class; a float operand must go through a register — use reg" },
        ProbeR { name: "SSE class for int", fragment: "in(\"x\") x",
                 needle: "asm! constraint 'x' is an SSE register class; an int operand needs a general-purpose class (r, q, a, b, c, d, S, D)" },
        ProbeR { name: "stack pointer operand", fragment: "in(\"rsp\") x",
                 needle: "asm! register 'rsp' cannot be bound to an operand — the compiler owns the stack pointer" },
        ProbeR { name: "frame pointer operand", fragment: "in(\"rbp\") x",
                 needle: "asm! register 'rbp' cannot be bound to an operand — the compiler owns the frame pointer" },
        ProbeR { name: "clobber destroys input", fragment: "in(\"rax\") x, clobber(\"rax\")",
                 needle: "asm! clobber 'rax' overlaps operand 0 (in \"rax\") — a clobbered register cannot also be bound to an operand" },
        ProbeR { name: "clobber destroys fixed letter", fragment: "in(\"a\") x, clobber(\"rax\")",
                 needle: "asm! clobber 'rax' overlaps operand 0 (in \"a\") — a clobbered register cannot also be bound to an operand" },
        ProbeR { name: "two operands one register", fragment: "in(\"rax\") x, out(\"rax\") x",
                 needle: "asm! operands 0 and 1 are both bound to 'rax' — each fixed register can be bound to at most one operand" },
        ProbeR { name: "clobber alias overlap", fragment: "in(\"rax\") x, clobber(\"eax\")",
                 needle: "asm! clobber 'eax' names a 32-bit sub-register — clobbers must name the full 64-bit register ('rax')" },
        ProbeR { name: "clobber duplicate", fragment: "clobber(\"rcx\", \"rcx\")",
                 needle: "asm! clobbers 'rcx' and 'rcx' overlap (both are rcx)" },
        ProbeR { name: "clobber stack pointer", fragment: "clobber(\"rsp\")",
                 needle: "asm! clobber 'rsp' is not allowed — the compiler owns the stack pointer" },
        ProbeR { name: "clobber frame pointer", fragment: "clobber(\"ebp\")",
                 needle: "asm! clobber 'ebp' is not allowed — the compiler owns the frame pointer" },
        ProbeR { name: "clobber sub-register", fragment: "clobber(\"eax\")",
                 needle: "asm! clobber 'eax' names a 32-bit sub-register — clobbers must name the full 64-bit register ('rax')" },
        ProbeR { name: "clobber bad name", fragment: "clobber(\"raxx\")",
                 needle: "asm! clobber 'raxx' is not a valid x86-64 register name, 'cc' or 'memory'" },
        ProbeR { name: "clobber cc reserved", fragment: "in(\"rax\") x, clobber(\"cc\")",
                 needle: "asm! clobber 'cc' is not allowed — flag effects are controlled by options(preserves_flags), not the clobber list (the default clobber list already includes \"cc\")" },
        ProbeR { name: "clobber memory reserved", fragment: "clobber(\"memory\")",
                 needle: "asm! clobber 'memory' is not allowed — memory effects are controlled by options(nomem), not the clobber list (the default clobber list already includes \"memory\")" },
        ProbeR { name: "two clobber clauses", fragment: "clobber(\"rcx\"), clobber(\"r11\")",
                 needle: "asm! clobber list appears more than once — merge all clobbers into a single clobber(...) clause" },
        ProbeR { name: "non-string clobber", fragment: "clobber(rcx)",
                 needle: "asm! clobber names must be string literals (a register name like \"rcx\", or \"cc\" / \"memory\")" },
    ]
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

fn decl_word(src: str, kw: str, name: str) -> bool {
    let rr: Result[Regex, str] = regex_compile(kw + "\\s+" + name + "\\b")
    if result_is_err(rr) {
        return false
    }
    let re: Regex = result_unwrap(rr)
    return regex_is_match(re, src)
}

fn import_paths(src: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i).trim()
        if line.starts_with("import ") {
            let rest: str = line.slice(7, line.len()).trim()
            if rest.starts_with("\"") {
                let tail: str = rest.slice(1, rest.len())
                let end: int = tail.find("\"")
                if end > 0 {
                    out.push(tail.slice(0, end))
                }
            }
        }
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# 1. core.asm resolution + traversal guards
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    section("1. core.asm import resolution (+ traversal guards)")
    # core.asm resolves: a probe that imports it must check clean.
    let p: str = write_src(acc, "res_core_asm.hls",
        "import \"core.asm\"\n" +
        "\n" +
        "fn main() -> int {\n" +
        "    return 0\n" +
        "}\n")
    let r: RunResult = boot_check(acc, p)
    check(acc, "core.asm resolves", r.code == 0, clip(r.combined, 60))
    # The rest of the core closure still resolves.
    let mods: list[str] = core_modules()
    let mut i: int = 0
    while i < mods.len() {
        let m: str = mods.get(i)
        let q: str = write_src(acc, "res_core_" + m + ".hls",
            "import \"core." + m + "\"\n" +
            "\n" +
            "fn main() -> int {\n" +
            "    return 0\n" +
            "}\n")
        let rq: RunResult = boot_check(acc, q)
        check(acc, "core." + m + " still resolves", rq.code == 0, clip(rq.combined, 60))
        i = i + 1
    }
    let s: str = write_src(acc, "res_std_str.hls",
        "import \"std.str\"\n" +
        "\n" +
        "fn main() -> int {\n" +
        "    return 0\n" +
        "}\n")
    let rs: RunResult = boot_check(acc, s)
    check(acc, "std.str still resolves", rs.code == 0, clip(rs.combined, 60))
    # The traversal guards: the three evil paths are refused.
    let evils: list[str] = ["core.../secret", "core./x", "core"]
    let mut j: int = 0
    while j < evils.len() {
        let e: str = evils.get(j)
        let q: str = write_src(acc, "guard_" + j.to_str() + ".hls",
            "import \"" + e + "\"\n" +
            "\n" +
            "fn main() -> int {\n" +
            "    return 0\n" +
            "}\n")
        let rq: RunResult = boot_check(acc, q)
        check(acc, "guard '" + e + "'", rq.code != 0, clip(rq.combined, 70))
        j = j + 1
    }
}

# ----------------------------------------------------------------------------
# 2. core.asm parses standalone
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    section("2. core.asm parses standalone (enum + fns, zero imports)")
    let src: str = read_or(core_asm(), "")
    # Standalone parse through the front door: a probe that imports the
    # module parses it (core/asm.hls itself has no main, so it cannot
    # be an entry file).
    let pp: str = write_src(acc, "parse_probe.hls",
        "import \"core.asm\"\n" +
        "\n" +
        "fn main() -> int {\n" +
        "    return 0\n" +
        "}\n")
    let r: RunResult = boot_check(acc, pp)
    check(acc, "core/asm.hls parses", r.code == 0 && src.len() > 0,
        clip(r.combined, 80))
    check(acc, "AsmFault enum present", decl_word(src, "enum", "AsmFault"), "")
    let imps: list[str] = import_paths(src)
    let mut all_core: bool = true
    let mut k: int = 0
    while k < imps.len() {
        if !imps.get(k).starts_with("core.") {
            all_core = false
        }
        k = k + 1
    }
    check(acc, "imports are core-only", all_core, str_join(imps, ", "))
    let must: list[str] = must_have_fns()
    let mut missing: str = ""
    let mut n_present: int = 0
    let mut i: int = 0
    while i < must.len() {
        if decl_word(src, "fn", must.get(i)) {
            n_present = n_present + 1
        } else {
            missing = missing + " " + must.get(i)
        }
        i = i + 1
    }
    check(acc, "all reference functions present", missing == "", clip(missing, 90))
    # Function count sane: at least 21 `fn ` lines at column 0.
    let src_lines: list[str] = src.split("\n")
    let mut fn_count: int = 0
    let mut li: int = 0
    while li < src_lines.len() {
        if src_lines.get(li).starts_with("fn ") {
            fn_count = fn_count + 1
        }
        li = li + 1
    }
    check(acc, "function count sane (>= 21)", fn_count >= 21, fn_count.to_str())
}

# ----------------------------------------------------------------------------
# 3. Stage-0 enforcement
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Proc {
    section("3. Stage-0 enforcement (ok-test clean; demo native-only; fails rejected)")
    let r: RunResult = boot_check(acc, ok_test())
    check(acc, "no_std ok-test checks", r.code == 0, clip(r.out, 80))
    let r2: RunResult = boot(acc, [ok_test()])
    check(acc, "no_std ok-test runs (exit 0)", r2.code == 0, "rc=" + r2.code.to_str())
    # The demo EXECUTES asm! — the interpreter must refuse (that is the
    # documented Stage 27 behaviour; the demo runs natively, section 5).
    let rd: RunResult = boot(acc, [demo()])
    check(acc, "demo refused by the interpreter (asm! executed)",
        rd.code != 0 && rd.combined.contains("asm! cannot be executed by the boot interpreter"),
        "rc=" + rd.code.to_str())
    let rc2: RunResult = boot_check(acc, demo())
    check(acc, "demo checks (asm! is a declared-statement parse)", rc2.code == 0,
        clip(rc2.combined, 80))
    # Every Stage 83 fail program is rejected with an asm! diagnostic.
    let fails: list[str] = fail_programs()
    let mut i: int = 0
    while i < fails.len() {
        let path: str = "tests/fail/" + fails.get(i) + ".hls"
        let rf: RunResult = boot_check(acc, path)
        check(acc, "rejected: " + fails.get(i),
            rf.code == 1 && rf.combined.contains("asm!"),
            clip(first_line(rf.combined), 100))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 4. Targeted probes: exact messages for every diagnostic class
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("4. Targeted probes (boot): valid forms accepted, diagnostics exact")
    let vs: list[ProbeV] = valid_probes()
    let mut i: int = 0
    while i < vs.len() {
        let p: ProbeV = vs.get(i)
        let path: str = write_src(acc, "valid_" + i.to_str() + ".hls", p.body)
        let r: RunResult = boot_check(acc, path)
        check(acc, "accepts: " + p.name, r.code == 0, clip(r.combined, 90))
        i = i + 1
    }
    let rs: list[ProbeR] = reject_probes()
    let mut j: int = 0
    while j < rs.len() {
        let p: ProbeR = rs.get(j)
        let mut src: str = "fn main() -> int { let mut x: int = 0\n" +
                           " let mut f: float = 1.0\n" +
                           " asm!(\"nop\", " + p.fragment + ", options(nomem))\n" +
                           " return 0 }"
        # non-string clobber probe is a PARSE error: drop the options
        # tail so the paren shape still parses up to the error
        if p.name == "non-string clobber" {
            src = "fn main() -> int { asm!(\"nop\", clobber(rcx))\n" +
                  " return 0 }"
        }
        if p.name == "two clobber clauses" {
            src = "fn main() -> int { asm!(\"nop\", clobber(\"rcx\"), " +
                  "clobber(\"r11\"))\n return 0 }"
        }
        let path: str = write_src(acc, "reject_" + j.to_str() + ".hls", src)
        let r: RunResult = boot_check(acc, path)
        check(acc, "rejects: " + p.name,
            r.code == 1 && r.combined.contains(p.needle),
            clip(first_line(r.combined), 110))
        j = j + 1
    }
}

# ----------------------------------------------------------------------------
# 5. Self-hosted emission (hlc) + native parity
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("5. Self-hosted emission (hlc) + native parity")
    let hlc_src: str = "src/hlc.hls"
    let out: str = scratch(acc, "demo.c")
    let r: RunResult = boot(acc, [hlc_src, demo(), out])
    check(acc, "hlc emits hosted C", r.code == 0 && file_exists(out),
        clip(r.combined, 100))
    let src: str = read_or(out, "")
    check(acc, "local register variable for r10", src.contains("__asm__(\"r10\")"), "")
    check(acc, "local register variable for r11", src.contains("__asm__(\"r11\")"), "")
    check(acc, "local register variable for r14", src.contains("__asm__(\"r14\")"), "")
    check(acc, "local register variable for xmm0", src.contains("__asm__(\"xmm0\")"), "")
    check(acc, "syscall stub pins rax", src.contains("\"syscall\" : \"+a\""), "")
    check(acc, "explicit clobbers emitted", src.contains("\"cc\", \"rcx\", \"r11\""), "")
    check(acc, "xmm clobber emitted", src.contains("\"cc\", \"xmm3\""), "")
    check(acc, "default clobbers kept", src.contains("\"cc\", \"memory\""), "")
    check(acc, "bool writeback converts", src.contains("!= 0"), "")
    let binp: str = scratch(acc, "demo.bin")
    let g: RunResult = run_capture("gcc", ["-O2", "-Werror", "-o", binp, out,
        "-lm", "-pthread"])
    if g.code == 0 {
        let nat: RunResult = run_capture(binp, [])
        check(acc, "native demo DEMO OK",
            nat.code == 0 && nat.out.contains("DEMO OK"), "rc=" + nat.code.to_str())
        check(acc, "xchg swapped via pinned regs", nat.out.contains("a=222 b=111"), "")
    } else {
        check(acc, "native demo links (-Werror)", false, "gcc failed")
    }
    # The no_std ok-test compiles hosted + freestanding, exit 0 both.
    let out3: str = scratch(acc, "ok.c")
    let r3: RunResult = boot(acc, [hlc_src, ok_test(), out3])
    check(acc, "hlc emits no_std ok C", r3.code == 0 && file_exists(out3), "")
    let bin3: str = scratch(acc, "ok.bin")
    let g3: RunResult = run_capture("gcc", ["-O2", "-Werror", "-o", bin3, out3,
        "-lm", "-pthread"])
    if g3.code == 0 {
        let nat3: RunResult = run_capture(bin3, [])
        check(acc, "native ok-test exit 0", nat3.code == 0, "rc=" + nat3.code.to_str())
    } else {
        check(acc, "native ok-test links", false, "gcc failed")
    }
    let fs_src: str = str_replace(read_file(ok_test()),
        "\n#![no_std]\n", "\n#![freestanding]\n")
    let fs_p: str = write_src(acc, "ok_fs.hls", fs_src)
    let interp: RunResult = boot(acc, [fs_p])
    let out2: str = scratch(acc, "fs.c")
    let r2: RunResult = boot(acc, [hlc_src, fs_p, out2])
    check(acc, "hlc emits freestanding C", r2.code == 0 && file_exists(out2),
        clip(r2.combined, 100))
    check(acc, "freestanding _start emitted",
        read_or(out2, "").contains("void _start"), "")
    let bin2: str = scratch(acc, "fs.bin")
    let g2: RunResult = run_capture("gcc", ["-O2", "-ffreestanding", "-nostdlib",
        "-ffunction-sections", "-fno-stack-protector", "-Wl,--gc-sections",
        "-o", bin2, out2])
    if g2.code == 0 {
        let nat2: RunResult = run_capture(bin2, [])
        check(acc, "freestanding native == interpreter",
            nat2.code == interp.code,
            "interp=" + interp.code.to_str() + " nat=" + nat2.code.to_str())
    } else {
        check(acc, "freestanding binary links", false, "gcc failed")
    }
    # Boot/hlc parity on the fail programs: the self-hosted checker
    # rejects them with the same Stage 83 messages.
    let fails: list[str] = fail_programs()
    let mut i: int = 0
    while i < fails.len() {
        let path: str = "tests/fail/" + fails.get(i) + ".hls"
        let outf: str = scratch(acc, "fail.c")
        let rf: RunResult = boot(acc, [hlc_src, path, outf])
        check(acc, "hlc rejects " + fails.get(i),
            rf.code != 0 && rf.combined.contains("asm!"),
            clip(first_line(rf.combined), 110))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 6. hlfmt stability
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Proc {
    section("6. hlfmt stability over every Stage 83 file")
    let files: list[str] = [core_asm(), demo(), ok_test()]
    let fails: list[str] = fail_programs()
    let mut i: int = 0
    while i < fails.len() {
        files.push("tests/fail/" + fails.get(i) + ".hls")
        i = i + 1
    }
    let mut j: int = 0
    while j < files.len() {
        let r: RunResult = run_capture("./bin/hlfmt", ["-c", files.get(j)])
        check(acc, "hlfmt clean: " + basename(files.get(j)),
            !r.out.contains("NOT formatted"), clip(r.out, 80))
        j = j + 1
    }
}

# ----------------------------------------------------------------------------
# 7. --audit: every core.asm function pure
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Proc {
    section("7. --audit: every core.asm function pure (no uses)")
    let r: RunResult = boot(acc, ["--audit", ok_test()])
    let out: str = r.out
    check(acc, "audit ran", r.code == 0, "")
    let must: list[str] = must_have_fns()
    let mut missing: str = ""
    let mut i: int = 0
    while i < must.len() {
        if !out.contains(must.get(i)) {
            missing = missing + " " + must.get(i)
        }
        i = i + 1
    }
    check(acc, "all asm fns in audit output", missing == "", clip(missing, 90))
    # Every audit line that names one of the fns must declare it pure.
    let lines: list[str] = out.split("\n")
    let mut bad: str = ""
    let mut li: int = 0
    while li < lines.len() {
        let s: str = lines.get(li).trim()
        let mut fi: int = 0
        while fi < must.len() {
            if s.starts_with(must.get(fi) + " ") {
                if !s.contains("(none - pure)") && !s.contains("(none)") {
                    bad = bad + " " + s
                }
                break
            }
            fi = fi + 1
        }
        li = li + 1
    }
    check(acc, "all asm fns declared pure", bad == "", clip(bad, 90))
    check(acc, "crate mode reported",
        out.contains("Crate mode:") && out.contains("#![no_std]"), "")
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("asmreg")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    return finish(acc, "Stage 83 -- inline-asm register constraints")
}
