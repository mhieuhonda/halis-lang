    let m: RunResult = run_capture("make", ["dma-acceptance"])
    check(acc, "dma: make dma-acceptance runs end-to-end",
          m.code == 0 && m.combined.contains("ACCEPTANCE OK: Stage 89"),
          clip(tail_lines(m.combined, 15), 120))
}

fn sec90_atomics(acc: Acc, hlc1: str) -> void uses IO, Fs, Proc {
    section("27. Stage 90: core.sync.nolock — lock-free primitives")

    let at_f: str = "tests/ok/feat_stage90_atomics.hls"

    let a: RunResult = boot_run(at_f)
    check(acc, "atomics: feat_stage90_atomics runs on the interpreter (exit 0)",
          a.code == 0, "atomics: feat_stage90_atomics interpreter exit=" + a.code.to_str())
    check(acc, "atomics: core/atomics.hls present",
          core_file_has("core/atomics.hls", "fn seqlock_read_ok"),
          "atomics: core/atomics.hls missing")

    # ZERO imports: the module must be usable from a freestanding image.
    check(acc, "atomics: core/atomics.hls has zero imports (freestanding-clean)",
          count_import_lines("core/atomics.hls") == 0,
          "atomics: core/atomics.hls imports something")

    let t_c: str = scratch(acc, "at_demo.c")
    let t: str = scratch(acc, "at_demo")
    let t1: RunResult = run_capture(hlc1, ["examples/atomics_demo.hls", t_c])
    let t2: RunResult = run_capture("gcc",
        ["-O2", "-Werror", "-o", t, t_c, "-lm", "-pthread"])
    if t1.code == 0 && t2.code == 0 {
        check(acc, "atomics: examples/atomics_demo.hls runs natively, exit 0",
              run_capture(t, []).code == 0, "atomics: atomics_demo did not run")
    } else {
        check(acc, "atomics: examples/atomics_demo.hls runs natively, exit 0",
              false, "atomics: atomics_demo failed to build")
    }

    let m: RunResult = run_capture("make", ["atomics-acceptance"])
    check(acc, "atomics: make atomics-acceptance runs end-to-end",
          m.code == 0 && m.combined.contains("ACCEPTANCE OK: Stage 90"),
          clip(tail_lines(m.combined, 15), 120))
}

# ----------------------------------------------------------------------------
# 28. Stage 91: verified interrupt-safety (no alloc in IRQ context)
# ----------------------------------------------------------------------------

fn sec91_irqsafe(acc: Acc, hlc1: str) -> void uses IO, Fs, Proc {
    section("28. Stage 91: verified interrupt-safety (no alloc in IRQ context)")

    let irq_f: str = "tests/ok/feat_stage91_irqsafe.hls"

    let a: RunResult = boot_run(irq_f)
    check(acc, "irqsafe: feat_stage91_irqsafe runs on the interpreter (exit 0)",
          a.code == 0, "irqsafe: feat_stage91_irqsafe interpreter exit=" + a.code.to_str())

    # (a) every Stage 91 fail program: rejected by Stage-0 AND by the
    # self-hosted --audit (bin/hlc), with the same diagnostic
    # (prefix-stripped, first line, line-number stripped).
    let corpus: list[str] = glob_hls("tests/fail", "fail_stage91_")
    let mut i: int = 0
    while i < corpus.len() {
        let ff: str = corpus.get(i)
        let name: str = stem(ff)
        let e: RunResult = boot_check_err(ff)
        let h: RunResult = run_capture("./bin/hlc", ["--audit", ff])
        let nb: str = norm_head(e.err, false)
        let nh: str = norm_head(h.err, true)
        check(acc, "irqsafe: " + name + " rejected identically by both front-ends",
              e.code == 1 && h.code != 0 && nb == nh,
              "irqsafe: " + name + " parity broken (boot rc=" + e.code.to_str()
                  + ", hlc rc=" + h.code.to_str() + ")")
        i = i + 1
    }

    # (b) the demo compiles -Werror and runs natively with exit 0.
    let d_c: str = scratch(acc, "irq91_demo.c")
    let d: str = scratch(acc, "irq91_demo")
    let d1: RunResult = run_capture(hlc1, ["examples/irqsafe_demo.hls", d_c])
    let d2: RunResult = run_capture("gcc",
        ["-O2", "-Werror", "-o", d, d_c, "-lm", "-pthread"])
    if d1.code == 0 && d2.code == 0 {
        check(acc, "irqsafe: examples/irqsafe_demo.hls runs natively, exit 0",
              run_capture(d, []).code == 0, "irqsafe: irqsafe_demo did not run")
    } else {
        check(acc, "irqsafe: examples/irqsafe_demo.hls runs natively, exit 0",
              false, "irqsafe: irqsafe_demo failed to build")
    }

    # (c) --audit publishes the proof lines (bin/hlc).
    let c: RunResult = run_capture("./bin/hlc", ["--audit", "examples/irqsafe_demo.hls"])
    check(acc, "irqsafe: --audit publishes the per-handler proof lines",
          c.out.contains("IRQ vector 32: 'pit_isr' — allocation-free"),
          "irqsafe: --audit proof lines missing")

    # (d) the gate itself.
    let m: RunResult = run_capture("make", ["irqsafe-acceptance"])
    check(acc, "irqsafe: make irqsafe-acceptance runs end-to-end",
          m.code == 0 && m.combined.contains("ACCEPTANCE OK: Stage 91"),
          clip(tail_lines(m.combined, 15), 120))
}

# ----------------------------------------------------------------------------
# 29. Stage 92: cross-bootstrappable build (Stage-0 -> freestanding hlc)
# 30.-33. Stages 93-96: the bare-metal triples + DWARF close-out
# ----------------------------------------------------------------------------

fn sec92_xboot(acc: Acc) -> void uses IO, Fs, Proc {
    section("29. Stage 92: cross-bootstrappable build (Stage-0 -> freestanding hlc)")

    # the gate builds bin/hlc-fs via the ladder.
    let m: RunResult = run_capture("make", ["xbootstrap-acceptance"])
    check(acc, "xbootstrap: make xbootstrap-acceptance runs end-to-end",
          m.code == 0 && m.combined.contains("ACCEPTANCE OK: Stage 92"),
          clip(tail_lines(m.combined, 15), 120))

    # The freestanding binary exists after the gate and is honest about
    # libc (a missing bin/hlc-fs is a FAIL naming the build recipe).
    let fs_ok: bool = file_exists("bin/hlc-fs")
        && !contains_libc_sym(run_capture("nm", ["-u", "bin/hlc-fs"]).out)
    check(acc, "xbootstrap: bin/hlc-fs links with zero libc symbols",
          fs_ok,
          "xbootstrap: bin/hlc-fs missing or carries libc symbols — build it "
              + "with `make bootstrap-nolibc` (the xbootstrap-acceptance ladder)")
}

# contains_libc_sym(text) — the `nm -u | grep -E 'fopen|malloc|printf|getenv'`
# probe, as a str extension so the leg stays one line.
fn contains_libc_sym(text: str) -> bool {
    return text.contains("fopen") || text.contains("malloc")
        || text.contains("printf") || text.contains("getenv")
}

fn sec93_triples(acc: Acc, hlc1: str) -> void uses IO, Fs, Proc {
    section("30. Stage 93: target x86_64-unknown-none (bare-metal triple)")

    # (a) the demo probe runs on the interpreter (exit 42).
    let a: RunResult = boot_run("examples/bare_x86_64.hls")
    check(acc, "triple93: bare_x86_64 probe computes 42 on the interpreter",
          a.code == 42, "triple93: bare_x86_64 probe exit=" + a.code.to_str() + " (want 42)")

    # (b) a float literal is refused under --target by BOTH front-ends
    # with the same words, and stays legal WITHOUT the flag.
    let bm_f: str = "tests/bare/fail_bare_float_literal.hls"
    let b: RunResult = run_capture("python3",
        ["tools/hlinterp/boot.py", "--check", "--target", "x86_64-unknown-none", bm_f])
    let h: RunResult = run_capture("./bin/hlc",
        ["--target", "x86_64-unknown-none", bm_f, scratch(acc, "bm93.c")])
    let mb: str = norm_greedy_stream(b.err)
    let mh: str = norm_greedy_stream(h.err)
    check(acc, "triple93: the float-literal probe rejected identically by both",
          b.code != 0 && h.code != 0
              && b.err.contains("bare-metal targets are integer-only")
              && mb == mh,
          "triple93: float-literal probe parity (boot rc=" + b.code.to_str()
              + ", hlc rc=" + h.code.to_str() + ")")
    let c: RunResult = boot_check_err(bm_f)
    check(acc, "triple93: the probe is a legal hosted crate without --target",
          c.code == 0,
          "triple93: the probe is rejected without --target (not conditional)")

    # (c) the gate itself.
    let m: RunResult = run_capture("make", ["triple-x86_64-acceptance"])
    check(acc, "triple93: make triple-x86_64-acceptance runs end-to-end",
          m.code == 0 && m.combined.contains("ACCEPTANCE OK: Stage 93"),
          clip(tail_lines(m.combined, 15), 120))
}

fn sec9495_close(acc: Acc) -> void uses IO, Proc {
    section("31. Stage 94: target aarch64-unknown-none (bare-metal ARM)")
    let m94: RunResult = run_capture("make", ["triple-aarch64-acceptance"])
    check(acc, "triple94: make triple-aarch64-acceptance runs end-to-end",
          m94.code == 0 && m94.combined.contains("ACCEPTANCE OK: Stage 94"),
          clip(tail_lines(m94.combined, 15), 120))

    section("32. Stage 95: target riscv64-unknown-none (bare-metal RISC-V)")
    let m95: RunResult = run_capture("make", ["triple-riscv64-acceptance"])
    check(acc, "triple95: make triple-riscv64-acceptance runs end-to-end",
          m95.code == 0 && m95.combined.contains("ACCEPTANCE OK: Stage 95"),
          clip(tail_lines(m95.combined, 15), 120))

    section("33. Stage 96: ELF symbol-table emission + debug-info (DWARF 5)")
    let m96: RunResult = run_capture("make", ["debuginfo-acceptance"])
    check(acc, "stage96: make debuginfo-acceptance runs end-to-end",
          m96.code == 0 && m96.combined.contains("ACCEPTANCE OK: Stage 96"),
          clip(tail_lines(m96.combined, 15), 120))
}

# ----------------------------------------------------------------------------
# main
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Fs, Proc, Exit {
    let acc: Acc = acc_new("suite_08_osdev")
    let hlc1: str = build_hlc1(acc, "osdev sections")
    sec77_freestanding(acc)
    sec78_nostd(acc)
    sec79_alloc(acc)
    sec80_mem(acc)
    sec81_panic(acc)
    sec82_stack(acc, hlc1)
    sec83_asmreg(acc, hlc1)
    sec84_link(acc, hlc1)
    sec85_boot(acc, hlc1)
    sec86_idt(acc, hlc1)
    sec87_mmio(acc, hlc1)
    sec88_port(acc, hlc1)
    sec89_dma(acc, hlc1)
    sec90_atomics(acc, hlc1)
    sec91_irqsafe(acc, hlc1)
    sec92_xboot(acc)
    sec93_triples(acc, hlc1)
    sec9495_close(acc)
    return finish(acc, "suite 08 -- osdev (Stages 77-96)")
}
