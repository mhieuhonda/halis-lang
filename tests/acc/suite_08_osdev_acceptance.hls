    let d2: RunResult = run_capture("gcc",
        ["-O2", "-Werror", "-o", d, d_c, "-lm", "-pthread"])
    if d1.code == 0 && d2.code == 0 {
        check(acc, "dma: examples/dma_demo.hls runs natively, exit 0",
              run_capture(d, []).code == 0, "dma: dma_demo did not run")
    } else {
        check(acc, "dma: examples/dma_demo.hls runs natively, exit 0",
              false, "dma: dma_demo failed to build")
