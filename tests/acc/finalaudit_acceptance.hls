# ============================================================================
# tests/acc/finalaudit_acceptance.hls — Stage 144 acceptance gate, in Halis
# (the Halis twin of tests/finalaudit_acceptance.py; same nine sections,
# same laws, same needles — the harness is tests/acc/harness.hls and
# the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make finalaudit-acceptance`.
#
#  1. the convention      — usage exits 2; readers on a missing ledger are
#                           named errors; the gate names its own law
#  2. the engagement      — entry one chained from GENESIS; the THREE live
#                           anchors pinned (the gate re-derives them); the
#                           window / self-signature / roster refusals; the
#                           frozen-artifact law
#  3. the brief law       — the anchors quoted live, the engagement line,
#                           the closure demands, the determinism, the
#                           channel anchor
#  4. the evidence law    — INDEPENDENT vs SELF-ASSESSED, the engine's
#                           counts, the FAILED pass on record, the drift
#                           fact
#  5. the finding law     — sequential ids and the authorship / severity /
#                           scope / reproducer refusals
#  6. the triage law      — the LANDING law in a real git tree: the fix
#                           must be 40 hex, exist, be an ancestor of HEAD,
#                           and postdate the finding
#  7. the signoff law     — the seal: authorship, the solo refusal, the
#                           untriaged refusal, the landing re-check, the
#                           moved-anchor refusal, the seal law
#  8. the gate law        — red on every unsealed state, green on the
#                           sealed tree and its descendants, refused around
#                           the audit and on any moved anchor
#  9. the corpus          — the showcase boots, formats, lints, runs green
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.json"
import "std.sha256"

# ----------------------------------------------------------------------------
# The world (the auditkit gate's toolkit, plus the git helpers).
# ----------------------------------------------------------------------------

struct FaRun {
    code: int,
    out: str,
    err: str
}

fn fa_run(argv: list[str]) -> FaRun uses Proc {
    let full: list[str] = ["tools/hls-finalaudit.py"]
    let mut i: int = 0
    while i < argv.len() {
        full.push(argv.get(i))
        i = i + 1
    }
    let r: RunResult = run_capture("python3", full)
    return FaRun { code: r.code, out: r.out, err: r.err }
}

fn guar(argv: list[str]) -> FaRun uses Proc {
    let full: list[str] = ["tools/hls-guarantee.py"]
    let mut i: int = 0
    while i < argv.len() {
        full.push(argv.get(i))
        i = i + 1
    }
    let r: RunResult = run_capture("python3", full)
    return FaRun { code: r.code, out: r.out, err: r.err }
}

# fa(root, ledger, argv) — the section 6-8 wrapper: --root + --ledger
# appended to every call.
fn fa(root: str, ledger: str, argv: list[str]) -> FaRun uses Proc {
    let full: list[str] = ["tools/hls-finalaudit.py"]
    let mut i: int = 0
    while i < argv.len() {
        full.push(argv.get(i))
        i = i + 1
    }
    full.push("--root")
    full.push(root)
    full.push("--ledger")
    full.push(ledger)
    let r: RunResult = run_capture("python3", full)
    return FaRun { code: r.code, out: r.out, err: r.err }
}

fn starts_with(s: str, prefix: str) -> bool {
    if s.len() < prefix.len() {
        return false
    }
    return s.slice(0, prefix.len()) == prefix
}

fn repeat_str(s: str, n: int) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

fn genesis() -> str {
    return repeat_str("0", 64)
}

fn replace_first(s: str, from: str, to: str) -> str {
    let mut i: int = 0
    while i + from.len() <= s.len() {
        if s.slice(i, i + from.len()) == from {
            return s.slice(0, i) + to + s.slice(i + from.len(), s.len())
        }
        i = i + 1
    }
    return s
}

# ----------------------------------------------------------------------------
# The canonical JSON + the chain arithmetic (the gate re-derives it).
# ----------------------------------------------------------------------------

fn canon_str(s: str) -> str {
    let mut out: str = "\""
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c == 34 {
            out = out + "\\\""
        } else if c == 92 {
            out = out + "\\\\"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 13 {
            out = out + "\\r"
        } else if c == 9 {
            out = out + "\\t"
        } else if c < 32 {
            out = out + hex_byte_lo(c)
        } else if c < 128 {
            out = out + s.slice(i, i + 1)
        } else {
            let mut cp: int = 0
            let mut advance: int = 1
            if c >= 240 {
                cp = (c - 240) * 262144
                    + (s.byte_at(i + 1) - 128) * 4096
                    + (s.byte_at(i + 2) - 128) * 64
                    + (s.byte_at(i + 3) - 128)
                advance = 4
            } else if c >= 224 {
                cp = (c - 224) * 4096
                    + (s.byte_at(i + 1) - 128) * 64
                    + (s.byte_at(i + 2) - 128)
                advance = 3
            } else {
                cp = (c - 192) * 64 + (s.byte_at(i + 1) - 128)
                advance = 2
            }
            if cp > 65535 {
                out = out + hex4_surro(cp)
            } else {
                out = out + hex4(cp)
            }
            i = i + advance
            continue
        }
        i = i + 1
    }
    return out + "\""
}

fn hex_byte_lo(c: int) -> str {
    let lo: int = c % 16
    let digits: str = "0123456789abcdef"
    return "0" + digits.slice(lo, lo + 1)
}

fn hex4(cp: int) -> str {
    let digits: str = "0123456789abcdef"
    let a: int = (cp / 4096) % 16
    let b: int = (cp / 256) % 16
    let c: int = (cp / 16) % 16
    let d: int = cp % 16
    return "\\u" + digits.slice(a, a + 1) + digits.slice(b, b + 1)
        + digits.slice(c, c + 1) + digits.slice(d, d + 1)
}

fn hex4_surro(cp: int) -> str {
    let v: int = cp - 65536
    let hi: int = 55296 + v / 1024
    let lo: int = 56320 + v % 1024
    return hex4(hi) + hex4(lo)
}

fn sort_strs(items: list[str]) -> list[str] {
    let a: list[str] = items
    let mut i: int = 1
    while i < a.len() {
        let key: str = a.get(i)
        let mut j: int = i - 1
        while j >= 0 && a.get(j) > key {
            a.set(j + 1, a.get(j))
            j = j - 1
        }
        a.set(j + 1, key)
        i = i + 1
    }
    return a
}

fn canon(v: JsonValue) -> str {
    if json_is_null(v) {
        return "null"
    }
    if json_is_bool(v) {
        if v.bval {
            return "true"
        }
        return "false"
    }
    if json_is_int(v) {
        return v.ival.to_str()
    }
    if json_is_float(v) {
        return v.fval.to_str()
    }
    if json_is_str(v) {
        return canon_str(v.sval)
    }
    if json_is_array(v) {
        let parts: list[str] = []
        parts.push("[")
        let mut i: int = 0
        while i < v.arr.len() {
            if i > 0 {
                parts.push(",")
            }
            parts.push(canon(v.arr.get(i)))
            i = i + 1
        }
        parts.push("]")
        return str_join(parts, "")
    }
    let keys: list[str] = sort_strs(v.obj_keys)
    let parts: list[str] = []
    parts.push("{")
    let mut i: int = 0
    while i < keys.len() {
        if i > 0 {
            parts.push(",")
        }
        let k: str = keys.get(i)
        parts.push(canon_str(k))
        parts.push(":")
        parts.push(canon(json_object_get(v, k)))
        i = i + 1
    }
    parts.push("}")
    return str_join(parts, "")
}

fn chain_of(prev_hash: str, record: JsonValue) -> str {
    return sha256_hex(prev_hash + canon(drop_key(record, "chain_hash")))
}

fn drop_key(obj: JsonValue, key: str) -> JsonValue {
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    while i < obj.obj_keys.len() {
        if obj.obj_keys.get(i) != key {
            keys.push(obj.obj_keys.get(i))
            vals.push(obj.obj_vals.get(i))
        }
        i = i + 1
    }
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
                       sval: "", arr: [], obj_keys: keys, obj_vals: vals }
}

fn parse_json_or_null(text: str) -> JsonValue {
    let rr: Result[JsonValue, str] = json_parse_result(text)
    if result_is_ok(rr) {
        return result_unwrap(rr)
    }
    return json_null()
}

fn entries_of(path: str) -> list[JsonValue] uses Fs {
    let out: list[JsonValue] = []
    if !file_exists(path) {
        return out
    }
    let lines: list[str] = read_file(path).split("\n")
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).trim() != "" {
            out.push(parse_json_or_null(lines.get(i)))
        }
        i = i + 1
    }
    return out
}

struct ChainVerdict {
    ok: bool,
    detail: str
}

fn verify_chain(path: str) -> ChainVerdict uses Fs {
    let entries: list[JsonValue] = entries_of(path)
    let mut prev: str = genesis()
    let mut i: int = 0
    while i < entries.len() {
        let e: JsonValue = entries.get(i)
        let seq: int = jint(e, "seq")
        if seq != i + 1 {
            return ChainVerdict { ok: false,
                detail: "line " + (i + 1).to_str() + ": seq wrong" }
        }
        if jstr(e, "prev_hash") != prev {
            return ChainVerdict { ok: false,
                detail: "line " + (i + 1).to_str() + ": prev does not chain" }
        }
        if jstr(e, "chain_hash") != chain_of(prev, e) {
            return ChainVerdict { ok: false,
                detail: "line " + (i + 1).to_str() + ": chain_hash does not hash" }
        }
        prev = jstr(e, "chain_hash")
        i = i + 1
    }
    return ChainVerdict { ok: true,
        detail: entries.len().to_str() + " entries, head "
            + prev.slice(0, 12) + "..." }
}

fn jstr(v: JsonValue, key: str) -> str {
    let x: JsonValue = json_object_get(v, key)
    if json_is_str(x) {
        return json_str_value(x)
    }
    return ""
}

fn jint(v: JsonValue, key: str) -> int {
    let x: JsonValue = json_object_get(v, key)
    if json_is_int(x) {
        return json_int_value(x)
    }
    return -1
}

fn jbool(v: JsonValue, key: str) -> bool {
    let x: JsonValue = json_object_get(v, key)
    if json_is_bool(x) {
        return json_bool_value(x)
    }
    return false
}

fn jobj(v: JsonValue, key: str) -> JsonValue {
    let x: JsonValue = json_object_get(v, key)
    if json_is_object(x) {
        return x
    }
    return json_null()
}

fn jarray(v: JsonValue, key: str) -> list[JsonValue] {
    let x: JsonValue = json_object_get(v, key)
    if json_is_array(x) {
        return x.arr
    }
    let empty: list[JsonValue] = []
    return empty
}

# ----------------------------------------------------------------------------
# The engagement, the trees, the git helpers, the anchors.
# ----------------------------------------------------------------------------

fn engage(acc: Acc, path: str, by: str, window: str, basis: str,
          firm: str, auditors: list[str], root: str) -> FaRun uses Proc {
    let argv: list[str] = ["engage", "--ledger", path, "--firm", firm,
                           "--window", window, "--basis", basis, "--by", by]
    let mut i: int = 0
    while i < auditors.len() {
        argv.push("--auditor")
        argv.push(auditors.get(i))
        i = i + 1
    }
    if root != "" {
        argv.push("--root")
        argv.push(root)
    }
    return fa_run(argv)
}

fn default_engage(acc: Acc, path: str) -> FaRun uses Proc {
    return engage(acc, path, "mhieuhonda", "2026-11-02/2026-12-24",
                  "fixed fee against the scope census, half at engagement",
                  "Meridian Audit Partners", two_auditors(), "")
}

fn two_auditors() -> list[str] {
    let out: list[str] = ["Dana Fischer", "Ravi Chandran"]
    return out
}

fn led(acc: Acc, name: str) -> str uses Proc {
    return scratch(acc, name + "/final.jsonl")
}

# full_tree(tag) — a full repo copy the tamper sections mangle.
fn full_tree(acc: Acc, tag: str) -> str uses Proc {
    let dst: str = scratch(acc, "tree-" + tag)
    mkdirs(dst)
    sh("tar -C . --exclude=./.git --exclude=./bin --exclude=./fuzz-corpus"
       + " --exclude=./tests/.acc-scratch --exclude='__pycache__'"
       + " --exclude='*.pyc' --exclude='./.hlaudit' -cf - ."
       + " | tar -C '" + shell_quote(dst) + "' -xf -")
    return dst
}

# git_tree(tag) — a full copy that is also a real git repository.
fn git_tree(acc: Acc, tag: str) -> str uses IO, Proc {
    let d: str = full_tree(acc, tag)
    if sh("cd '" + shell_quote(d) + "' && git init -q ."
          + " && git config user.name gate"
          + " && git config user.email gate@example.com"
          + " && git add -A"
          + " && git commit -q -m 'the tree the audit runs on'") != 0 {
        check(acc, "git_tree(" + tag + ")", false, "git init failed")
    }
    return d
}

fn git_head(tree: str) -> str uses Proc {
    let r: RunResult = run_capture("git", ["-C", tree, "rev-parse", "HEAD"])
    return r.out.trim()
}

fn git_initial(tree: str) -> str uses Proc {
    let r: RunResult = run_capture("git",
        ["-C", tree, "rev-list", "--max-parents=0", "HEAD"])
    return r.out.trim()
}

fn git_empty_commit(tree: str, msg: str) -> str uses Proc {
    run_capture("git", ["-C", tree, "commit", "-q", "--allow-empty",
                        "-m", msg])
    return git_head(tree)
}

struct Anchors {
    guarantee_scope: str,
    api_freeze: str,
    bootstrap_snapshot: str
}

# live_anchor_digests() — the three anchors, re-derived by the gate's OWN
# arithmetic over the committed files.
fn live_anchor_digests(acc: Acc) -> Anchors uses Fs, Proc {
    let freeze: JsonValue = parse_json_or_null(read_file("tests/api_freeze.json"))
    let freeze_digest: str = jstr(freeze, "digest")
    let mut head: str = genesis()
    let am_path: str = "tests/api_freeze_amendments.jsonl"
    if file_exists(am_path) {
        let lines: list[str] = nonempty_lines(read_file(am_path))
        let mut prev: str = genesis()
        let mut i: int = 0
        while i < lines.len() {
            let e: JsonValue = parse_json_or_null(lines.get(i))
            if jint(e, "seq") == i + 1 && jstr(e, "prev_hash") == prev
                    && jstr(e, "chain_hash") == chain_of(prev, e) {
                prev = jstr(e, "chain_hash")
            }
            i = i + 1
        }
        head = prev
    }
    let man: JsonValue = parse_json_or_null(read_file("snapshot/MANIFEST.json"))
    let g_run: FaRun = guar(["list", "--json"])
    let g: JsonValue = parse_json_or_null(g_run.out)
    let af_obj: JsonValue = JsonValue { kind: "object", bval: false, ival: 0,
        fval: 0.0, sval: "", arr: [],
        obj_keys: ["amendments_head", "digest"],
        obj_vals: [json_str(head), json_str(freeze_digest)] }
    let bs_obj: JsonValue = JsonValue { kind: "object", bval: false, ival: 0,
        fval: 0.0, sval: "", arr: [],
        obj_keys: ["closure", "snapshot", "version"],
        obj_vals: [json_str(jstr(man, "closure_digest")),
                   json_str(jstr(man, "hlc_c_sha256")),
                   json_object_get(man, "version")] }
    return Anchors { guarantee_scope: jstr(g, "ledger_sha256"),
                     api_freeze: sha256_hex(canon(af_obj)),
                     bootstrap_snapshot: sha256_hex(canon(bs_obj)) }
}

fn nonempty_lines(text: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).trim() != "" {
            out.push(lines.get(i))
        }
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# 1-9. The sections.
# ----------------------------------------------------------------------------

fn s1_convention(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 1 — the convention")
    let p: FaRun = fa_run([])
    check(acc, "a bare invocation is a usage error (exit 2)", p.code == 2, "")
    let q: FaRun = fa_run(["no-such-command"])
    check(acc, "an unknown command is a usage error (exit 2)", q.code == 2, "")
    let e: FaRun = fa_run(["engage"])
    check(acc, "engage without its terms is a usage error (exit 2)",
          e.code == 2, "")

    let missing: str = led(acc, "missing")
    let cmds: list[str] = ["evidence", "file", "triage", "signoff",
                           "report", "status"]
    let mut i: int = 0
    while i < cmds.len() {
        let cmdname: str = cmds.get(i)
        let argv: list[str] = [cmdname, "--ledger", missing]
        if cmdname == "file" {
            argv.push("--against")
            argv.push("G-TAINT-01")
            argv.push("--severity")
            argv.push("high")
            argv.push("--title")
            argv.push("t")
            argv.push("--repro-text")
            argv.push("t")
        }
        if cmdname == "triage" {
            argv.push("AF-001")
            argv.push("--verdict")
            argv.push("disputed")
            argv.push("--reason")
            argv.push("r")
        }
        if cmdname == "report" {
            argv.push("--out")
            argv.push(scratch(acc, "d.md"))
        }
        let r: FaRun = fa_run(argv)
        check(acc, cmdname + " on a missing ledger is a named error",
              r.code == 1 && r.err.contains("no final-audit ledger"), "")
        i = i + 1
    }

    let b: FaRun = fa_run(["brief", "--ledger", missing])
    check(acc, "brief on a missing ledger is the RFP, open solicitation",
          b.code == 0 && b.out.contains("OPEN SOLICITATION"), "")

    let g: FaRun = fa_run(["gate", "--ledger", missing])
    check(acc, "the gate on a missing ledger: a release candidate is not cut from an unaudited tree",
          g.code == 1 && g.err.contains("not cut from an unaudited tree"), "")
}

fn s2_engagement(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 2 — the engagement law")
    let h: str = led(acc, "engage")
    let p: FaRun = default_engage(acc, h)
    check(acc, "engage signs on a fresh ledger",
          p.code == 0 && p.out.contains("engaged"), clip(first_line(p.err), 120))

    let entries: list[JsonValue] = entries_of(h)
    check(acc, "exactly one entry was written", entries.len() == 1, "")
    if entries.len() < 1 {
        return
    }
    let e: JsonValue = entries.get(0)
    check(acc, "the entry is an engagement", jstr(e, "kind") == "engagement", "")
    check(acc, "the engagement is entry one", jint(e, "seq") == 1, "")
    check(acc, "entry one chains from GENESIS, 64 zeros",
          jstr(e, "prev_hash") == genesis(), "")
    let roster: list[JsonValue] = jarray(e, "roster")
    check(acc, "the roster is recorded in order, verbatim",
          roster.len() == 2 && json_is_str(roster.get(0))
              && json_str_value(roster.get(0)) == "Dana Fischer"
              && json_is_str(roster.get(1))
              && json_str_value(roster.get(1)) == "Ravi Chandran", "")
    check(acc, "the firm, the window and the basis are recorded verbatim",
          jstr(e, "window") == "2026-11-02/2026-12-24"
              && jstr(e, "basis") == "fixed fee against the scope census, half at engagement"
              && jstr(e, "firm") == "Meridian Audit Partners", "")
    check(acc, "the signer is recorded", jstr(e, "by") == "mhieuhonda", "")
    let cv: ChainVerdict = verify_chain(h)
    check(acc, "the chain law holds, re-derived by the gate (" + cv.detail + ")",
          cv.ok, "")

    let live: Anchors = live_anchor_digests(acc)
    let anchors: JsonValue = jobj(e, "anchors")
    check(acc, "the engagement pins the live guarantee-scope anchor",
          jstr(anchors, "guarantee-scope") == live.guarantee_scope, "")
    check(acc, "the engagement pins the live api-freeze anchor",
          jstr(anchors, "api-freeze") == live.api_freeze, "")
    check(acc, "the engagement pins the live bootstrap-snapshot anchor",
          jstr(anchors, "bootstrap-snapshot") == live.bootstrap_snapshot, "")
    check(acc, "the engagement pins exactly the three anchors — no more, no less",
          anchors.obj_keys.len() == 3, "")

    let g_run: FaRun = guar(["list", "--json"])
    check(acc, "the scope is the 15 guarantees of Stage 135",
          jarray(parse_json_or_null(g_run.out), "guarantees").len() == 15, "")

    let windows: list[str] = ["2026-12-24/2026-11-02", "2026-11-02",
                              "2026-13-45/2026-12-24"]
    let whys: list[str] = ["a window that ends before it starts",
                           "a window that is not two dates",
                           "a window that is not ISO"]
    let mut wi: int = 0
    while wi < windows.len() {
        let r: FaRun = engage(acc, led(acc, "win-" + wi.to_str()),
                              "mhieuhonda", windows.get(wi),
                              "fixed fee against the scope census, half at engagement",
                              "Meridian Audit Partners", two_auditors(), "")
        check(acc, whys.get(wi) + " is refused at the signature",
              r.code == 1 && r.err.contains("window"), "")
        wi = wi + 1
    }

    let second: FaRun = default_engage(acc, h)
    check(acc, "a second engagement is refused — a contract is not a draft",
          second.code == 1 && second.err.contains("already on record"), "")

    let ss: FaRun = engage(acc, led(acc, "selfsig"), "Dana Fischer",
                           "2026-11-02/2026-12-24",
                           "fixed fee against the scope census, half at engagement",
                           "Meridian Audit Partners", two_auditors(), "")
    check(acc, "a signer on their own roster is refused — independence starts at the signature",
          ss.code == 1 && ss.err.contains("own roster"), "")

    let none: list[str] = []
    let nr: FaRun = engage(acc, led(acc, "noroster"), "mhieuhonda",
                           "2026-11-02/2026-12-24",
                           "fixed fee against the scope census, half at engagement",
                           "Meridian Audit Partners", none, "")
    check(acc, "an empty roster is refused — an audit with no auditors is a monologue",
          nr.code == 1 && nr.err.contains("monologue"), "")

    # A tree that carries no freeze cannot be engaged at all.
    let mini: str = scratch(acc, "mini-nofreeze")
    mkdirs(path_join3(mini, "tools"))
    cp("tools/hls-guarantee.py", path_join3(mini, "tools/hls-guarantee.py"))
    cp("SECURITY.md", path_join3(mini, "SECURITY.md"))
    let nf: FaRun = engage(acc, led(acc, "nofreeze"), "mhieuhonda",
                           "2026-11-02/2026-12-24",
                           "fixed fee against the scope census, half at engagement",
                           "Meridian Audit Partners", two_auditors(), mini)
    check(acc, "a tree that carries no freeze cannot be engaged — the final audit audits the frozen artifact",
          nf.code == 1 && nf.err.contains("no API freeze"), "")

    let nomft: str = full_tree(acc, "nomft")
    rmrf(path_join3(nomft, "snapshot/MANIFEST.json"))
    let nm: FaRun = engage(acc, led(acc, "nomft"), "mhieuhonda",
                           "2026-11-02/2026-12-24",
                           "fixed fee against the scope census, half at engagement",
                           "Meridian Audit Partners", two_auditors(), nomft)
    check(acc, "a tree that carries no snapshot manifest cannot be engaged either",
          nm.code == 1 && nm.err.contains("no snapshot manifest"), "")
    rmrf(nomft)
}

fn s3_brief_law(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 3 — the brief law")
    let h: str = led(acc, "brief")
    default_engage(acc, h)

    let b1: str = scratch(acc, "brief-1.md")
    let p: FaRun = fa_run(["brief", "--ledger", h, "--out", b1])
    check(acc, "brief renders from the live tree",
          p.code == 0 && p.out.contains("15 guarantees"), "")
    let doc: str = read_file(b1)

    let live: Anchors = live_anchor_digests(acc)
    check(acc, "the brief quotes the live guarantee-scope anchor with its digest",
          doc.contains("| guarantee-scope |")
              && doc.contains("`sha256:" + live.guarantee_scope + "`"), "")
    check(acc, "the brief quotes the live api-freeze anchor with its digest",
          doc.contains("| api-freeze |")
              && doc.contains("`sha256:" + live.api_freeze + "`"), "")
    check(acc, "the brief quotes the live bootstrap-snapshot anchor with its digest",
          doc.contains("| bootstrap-snapshot |")
              && doc.contains("`sha256:" + live.bootstrap_snapshot + "`"), "")

    check(acc, "the engaged brief names the firm, the window, the basis",
          doc.contains("window 2026-11-02/2026-12-24")
              && doc.contains("Meridian Audit Partners")
              && doc.contains("fixed fee against the scope census, half at engagement"),
          "")
    check(acc, "the brief says what this engagement gates and what its closure demands",
          doc.contains("the v1.0 release candidates")
              && doc.contains("closure criteria"), "")
    check(acc, "the reporting channel is quoted in the brief",
          doc.contains("90-day coordinated-disclosure")
              && doc.contains("security/advisories"), "")

    let b2: str = scratch(acc, "brief-2.md")
    fa_run(["brief", "--ledger", h, "--out", b2])
    check(acc, "two renders of one tree are byte-identical",
          read_file(b1) == read_file(b2), "")

    let b3: str = scratch(acc, "brief-3.md")
    fa_run(["brief", "--ledger", h, "--out", b3, "--stamp"])
    let d1: list[str] = read_file(b1).split("\n")
    let d2: list[str] = read_file(b3).split("\n")
    let keep1: list[str] = without_generated(d1)
    let keep2: list[str] = without_generated(d2)
    let mut gen_count: int = 0
    let mut j: int = 0
    while j < d2.len() {
        if starts_with(d2.get(j), "- Generated") {
            gen_count = gen_count + 1
        }
        j = j + 1
    }
    let mut same: bool = keep1.len() == keep2.len()
    j = 0
    while same && j < keep1.len() {
        if keep1.get(j) != keep2.get(j) {
            same = false
        }
        j = j + 1
    }
    check(acc, "--stamp changes ONLY the Generated line",
          same && gen_count == 1, "")

    let gone: str = scratch(acc, "mini-nochan")
    mkdirs(path_join3(gone, "tools"))
    cp("tools/hls-guarantee.py", path_join3(gone, "tools/hls-guarantee.py"))
    write_file(path_join3(gone, "SECURITY.md"),
               "# Security policy\n(no anchored channel here)\n")
    let g1: FaRun = fa_run(["brief", "--ledger", h, "--root", gone])
    check(acc, "a tree that lost the anchored channel refuses to brief",
          g1.code == 1 && g1.err.contains("reporting channel anchor is gone"), "")
    rmrf(gone)
}

fn without_generated(lines: list[str]) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    while i < lines.len() {
        if !starts_with(lines.get(i), "- Generated") {
            out.push(lines.get(i))
        }
        i = i + 1
    }
    return out
}

fn s4_evidence_law(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 4 — the evidence law")
    let h: str = led(acc, "life-real")
    default_engage(acc, h)
    let head_sha: str = git_head(".")

    let gv_run: FaRun = guar(["verify", "--json"])
    let gv: JsonValue = parse_json_or_null(gv_run.out)
    let glist: list[JsonValue] = jarray(gv, "guarantees")
    let mut g_ok: int = 0
    let mut g_anchors: int = 0
    let mut g_probes: int = 0
    let mut i: int = 0
    while i < glist.len() {
        let r: JsonValue = glist.get(i)
        if jstr(r, "status") == "verified" {
            g_ok = g_ok + 1
        }
        let anchors: list[JsonValue] = jarray(r, "anchors")
        let mut a: int = 0
        while a < anchors.len() {
            if jbool(anchors.get(a), "ok") {
                g_anchors = g_anchors + 1
            }
            a = a + 1
        }
        let probes: list[JsonValue] = jarray(r, "probes")
        let mut b: int = 0
        while b < probes.len() {
            if jstr(probes.get(b), "verdict") == "ok" {
                g_probes = g_probes + 1
            }
            b = b + 1
        }
        i = i + 1
    }

    let p: FaRun = fa_run(["evidence", "--ledger", h, "--by", "Dana Fischer"])
    check(acc, "a pass by a roster member is labelled INDEPENDENT",
          p.code == 0 && p.out.contains("INDEPENDENT"), clip(first_line(p.err), 120))
    let entries: list[JsonValue] = entries_of(h)
    let e: JsonValue = entries.get(entries.len() - 1)
    check(acc, "the transcript records the auditor role and the label",
          jstr(e, "kind") == "evidence" && jstr(e, "role") == "auditor"
              && jbool(e, "independent"), "")
    check(acc, "the transcript pins the tree it ran", jstr(e, "tree") == head_sha, "")
    check(acc, "the counts are the guarantee engine's counts (" + g_ok.to_str()
          + " guarantees, " + g_anchors.to_str() + " anchors, "
          + g_probes.to_str() + " probes)",
          jint(e, "verified_guarantees") == g_ok
              && jint(e, "guarantee_anchors") == g_anchors
              && jint(e, "guarantee_probes") == g_probes, "")
    check(acc, "the transcript records no drift on an unmoved tree",
          jarray(e, "anchor_drift").len() == 0, "")

    let before: str = read_file(h)
    let p2: FaRun = fa_run(["evidence", "--ledger", h, "--by", "mhieuhonda"])
    let after: str = read_file(h)
    check(acc, "the ledger is append-only: the bytes before are a prefix of the bytes after",
          p2.code == 0 && starts_with(after, before), "")
    let entries2: list[JsonValue] = entries_of(h)
    let e2: JsonValue = entries2.get(entries2.len() - 1)
    check(acc, "a pass by the project itself is labelled SELF-ASSESSED, role project — the roster decides, never the mood",
          jstr(e2, "role") == "project" && !jbool(e2, "independent")
              && p2.out.contains("SELF-ASSESSED"), "")

    # A FAILED pass is recorded, not skipped.
    let broken: str = full_tree(acc, "broken")
    let expr: str = path_join3(broken, "tools/hlinterp/checking/expr.py")
    write_file(expr, replace_first(read_file(expr), "use of moved value",
                                   "use of moved VALUE"))
    let p3: FaRun = fa_run(["evidence", "--ledger", h, "--root", broken,
                            "--by", "Dana Fischer"])
    check(acc, "a failed pass exits 1 naming its refusals",
          p3.code == 1 && p3.err.contains("EVIDENCE FAILED"), "")
    let entries3: list[JsonValue] = entries_of(h)
    let e3: JsonValue = entries3.get(entries3.len() - 1)
    let refusals: list[JsonValue] = jarray(e3, "refusals")
    let mut names_mem: bool = false
    let mut r_i: int = 0
    while r_i < refusals.len() {
        let r: JsonValue = refusals.get(r_i)
        if json_is_str(r) && json_str_value(r).contains("G-MEM-01") {
            names_mem = true
        }
        r_i = r_i + 1
    }
    check(acc, "the failed pass is ON RECORD — a failed pass is a record, not a shame",
          jstr(e3, "outcome") == "failed" && refusals.len() > 0, "")
    check(acc, "the refusals name the voided guarantee", names_mem, "")
    let cv: ChainVerdict = verify_chain(h)
    check(acc, "the chain still verifies across a failed pass (" + cv.detail + ")",
          cv.ok, "")
    rmrf(broken)

    # The anchors that moved: drift is a fact to record, not a refusal.
    let drift: str = full_tree(acc, "drift4")
    let fz: str = path_join3(drift, "tests/api_freeze.json")
    let doc: JsonValue = parse_json_or_null(read_file(fz))
    let mut doc2: JsonValue = doc
    let dkeys: list[str] = []
    let dvals: list[JsonValue] = []
    let mut d_i: int = 0
    while d_i < doc.obj_keys.len() {
        if doc.obj_keys.get(d_i) == "digest" {
            dkeys.push("digest")
            dvals.push(json_str(repeat_str("f", 64)))
        } else {
            dkeys.push(doc.obj_keys.get(d_i))
            dvals.push(doc.obj_vals.get(d_i))
        }
        d_i = d_i + 1
    }
    doc2 = JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
                       sval: "", arr: [], obj_keys: dkeys, obj_vals: dvals }
    write_file(fz, json_stringify(doc2))
    let p4: FaRun = fa_run(["evidence", "--ledger", h, "--root", drift,
                            "--by", "Dana Fischer"])
    check(acc, "a pass against the moved anchor still runs — drift is a fact to record, not a refusal",
          p4.code == 0, "")
    let entries4: list[JsonValue] = entries_of(h)
    let e4: JsonValue = entries4.get(entries4.len() - 1)
    let drift_list: list[JsonValue] = jarray(e4, "anchor_drift")
    let mut drift_ok: bool = drift_list.len() == 1
    if drift_ok {
        drift_ok = json_is_str(drift_list.get(0))
            && json_str_value(drift_list.get(0)) == "api-freeze"
    }
    check(acc, "the pass records the drifted anchor by name", drift_ok, "")
    check(acc, "and says so on the record it prints",
          p4.out.contains("drift: api-freeze"), "")
    rmrf(drift)

    let p5: FaRun = fa_run(["evidence", "--ledger", led(acc, "noeng")])
    check(acc, "a pass without a ledger is a named error",
          p5.code == 1 && p5.err.contains("no final-audit ledger"), "")
}

fn s5_finding_law(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 5 — the finding law")
    let h: str = led(acc, "life-real")
    let entries: list[JsonValue] = entries_of(h)
    let mut engaged: bool = false
    let mut has_finding: bool = false
    let mut i: int = 0
    while i < entries.len() {
        if jstr(entries.get(i), "kind") == "engagement" {
            engaged = true
        }
        if jstr(entries.get(i), "kind") == "finding" {
            has_finding = true
        }
        i = i + 1
    }
    check(acc, "the finding law runs on the section-4 ledger, engaged",
          engaged, "")

    if !has_finding {
        let p: FaRun = fa_run(["file", "--ledger", h, "--against", "G-TAINT-01",
                               "--severity", "high",
                               "--title", "taint sink accepts through a crafted alias",
                               "--repro-path", "tests/fail/fail_taint_read_file.hls",
                               "--by", "Dana Fischer"])
        check(acc, "a roster member files the first finding, AF-001",
              p.code == 0 && p.out.contains("filed AF-001"), "")
        let entries2: list[JsonValue] = entries_of(h)
        let f: JsonValue = entries2.get(entries2.len() - 1)
        check(acc, "the finding carries the row, the severity and the path reproducer",
              jstr(f, "repro_mode") == "path" && jstr(f, "severity") == "high"
                  && jstr(f, "against") == "G-TAINT-01", "")

        let p2: FaRun = fa_run(["file", "--ledger", h, "--against", "G-CT-01",
                                "--severity", "info",
                                "--title", "const-time margin thinner than claimed",
                                "--repro-text",
                                "echo 'CT lane leaks through the scheduler' && exit 1",
                                "--by", "Ravi Chandran"])
        check(acc, "the second roster member files AF-002 — ids are sequential",
              p2.code == 0 && p2.out.contains("filed AF-002"), "")
        let entries3: list[JsonValue] = entries_of(h)
        let f2: JsonValue = entries3.get(entries3.len() - 1)
        check(acc, "an inline reproducer is filed as text",
              jstr(f2, "repro_mode") == "text", "")
    }

    let p3: FaRun = fa_run(["file", "--ledger", h, "--against", "G-CT-01",
                            "--severity", "low", "--title", "x",
                            "--repro-text", "x", "--by", "mhieuhonda"])
    check(acc, "the project cannot author a finding",
          p3.code == 1 && p3.err.contains("findings are the auditors' to file"), "")

    let p4: FaRun = fa_run(["file", "--ledger", h, "--against", "G-CT-01",
                            "--severity", "severe", "--title", "x",
                            "--repro-text", "x", "--by", "Dana Fischer"])
    check(acc, "a severity outside the closed vocabulary is refused",
          p4.code == 1 && p4.err.contains("severity"), "")

    let p5: FaRun = fa_run(["file", "--ledger", h, "--against", "G-NOPE-99",
                            "--severity", "low", "--title", "x",
                            "--repro-text", "x", "--by", "Dana Fischer"])
    check(acc, "a finding against a row outside the scope is refused naming the known rows",
          p5.code == 1 && p5.err.contains("not one of the scope's"), "")

    let p6: FaRun = fa_run(["file", "--ledger", h, "--against", "G-CT-01",
                            "--severity", "low", "--title", "x",
                            "--by", "Dana Fischer"])
    check(acc, "a finding with no reproducer is an opinion",
          p6.code == 1 && p6.err.contains("opinions are not findings"), "")

    let p7: FaRun = fa_run(["file", "--ledger", h, "--against", "G-CT-01",
                            "--severity", "low", "--title", "x",
                            "--repro-path", "a.hls", "--repro-text", "x",
                            "--by", "Dana Fischer"])
    check(acc, "a finding carries one reproducer, never two",
          p7.code == 1 && p7.err.contains("ONE reproducer, not two"), "")

    let p8: FaRun = fa_run(["file", "--ledger", h, "--against", "G-CT-01",
                            "--severity", "low", "--title", "x",
                            "--repro-path", "no/such/file.hls",
                            "--by", "Dana Fischer"])
    check(acc, "a reproducer that points at nothing is a rumor",
          p8.code == 1 && p8.err.contains("points at nothing"), "")
}

fn s6_triage_law(acc: Acc) -> str uses IO, Fs, Proc {
    section("Section 6 — the triage law (the landing law)")
    let tree: str = git_tree(acc, "life")
    let h: str = path_join3(tree, "final.jsonl")

    let p: FaRun = fa(tree, h, engage_args())
    check(acc, "the lifecycle engages in a real git tree — the landing law needs history to read",
          p.code == 0, "")

    let p2: FaRun = fa(tree, h, ["evidence", "--by", "Dana Fischer"])
    check(acc, "the auditors' own pass, on the record",
          p2.code == 0 && p2.out.contains("INDEPENDENT"), "")

    let p3: FaRun = fa(tree, h, ["file", "--against", "G-TAINT-01",
                                 "--severity", "high",
                                 "--title", "taint sink accepts through a crafted alias",
                                 "--repro-path", "tests/fail/fail_taint_read_file.hls",
                                 "--by", "Dana Fischer"])
    check(acc, "the auditors file AF-001",
          p3.code == 0 && p3.out.contains("filed AF-001"), "")

    let initial: str = git_initial(tree)

    let p4: FaRun = fa(tree, h, ["triage", "AF-001", "--verdict", "accepted",
                                 "--reason", "r"])
    check(acc, "an acceptance without its remediation is a wish",
          p4.code == 1 && p4.err.contains("wish, not a fix"), "")

    let p5: FaRun = fa(tree, h, ["triage", "AF-001", "--verdict", "accepted",
                                 "--reason", "r", "--fix", "not-a-sha"])
    check(acc, "the fix must be 40 hex",
          p5.code == 1 && p5.err.contains("40 hex"), "")

    let p6: FaRun = fa(tree, h, ["triage", "AF-001", "--verdict", "accepted",
                                 "--reason", "r", "--fix", repeat_str("f", 40)])
    check(acc, "a well-formed sha that names no commit is refused — a remediation that exists nowhere is a promise",
          p6.code == 1 && p6.err.contains("names no commit"), "")

    let dangling: RunResult = run_capture("git",
        ["-C", tree, "commit-tree", "HEAD^{tree}", "-m",
         "a commit that never landed"])
    let p7: FaRun = fa(tree, h, ["triage", "AF-001", "--verdict", "accepted",
                                 "--reason", "r",
                                 "--fix", dangling.out.trim()])
    check(acc, "a commit that exists but is not an ancestor of HEAD is refused — a fix that has not landed is a promise, not a fix",
          p7.code == 1 && p7.err.contains("not in the tree being released")
              && p7.err.contains("has not landed"), "")

    let p8: FaRun = fa(tree, h, ["triage", "AF-001", "--verdict", "accepted",
                                 "--reason", "r", "--fix", initial])
    check(acc, "the tree's initial commit predates the finding — a fix that predates its finding is a contradiction",
          p8.code == 1 && p8.err.contains("predates the finding")
              && p8.err.contains("contradiction"), "")

    let p9: FaRun = fa(tree, h, ["triage", "AF-001", "--verdict", "disputed",
                                 "--reason", "r", "--fix", initial])
    check(acc, "a disputed finding with a fix is a contradiction",
          p9.code == 1 && p9.err.contains("only an acceptance carries a fix"), "")

    let p10: FaRun = fa(tree, h, ["triage", "AF-001", "--verdict", "disputed",
                                  "--reason", ""])
    check(acc, "a triage without a reason is refused — the sanction law, on the other side of the table",
          p10.code == 1 && p10.err.contains("sanction law"), "")

    let p11: FaRun = fa(tree, h, ["triage", "AF-001", "--verdict", "disputed",
                                  "--reason", "r", "--by", "Ravi Chandran"])
    check(acc, "an auditor cannot triage — the response is the project's to give",
          p11.code == 1 && p11.err.contains("the project's to give"), "")

    let p12: FaRun = fa(tree, h, ["triage", "AF-099", "--verdict", "disputed",
                                  "--reason", "r"])
    check(acc, "a triage on a finding that is not on record is refused",
          p12.code == 1 && p12.err.contains("no finding AF-099"), "")

    # The happy path: commit the fix AFTER the finding, then accept.
    sh("sleep 1.1")
    let fix: str = git_empty_commit(tree,
        "fix: the alias route at the checker boundary")
    let p13: FaRun = fa(tree, h, ["triage", "AF-001", "--verdict", "accepted",
                                  "--reason", "the alias route is real; fixed at the checker boundary",
                                  "--fix", fix])
    check(acc, "the project accepts with the remediation commit that landed — and postdates the finding",
          p13.code == 0 && p13.out.contains("triaged AF-001: accepted"), "")
    let entries: list[JsonValue] = entries_of(h)
    let t: JsonValue = entries.get(entries.len() - 1)
    check(acc, "the triage records the fix sha verbatim",
          jstr(t, "fix") == fix && jstr(t, "verdict") == "accepted", "")

    let p14: FaRun = fa(tree, h, ["triage", "AF-001", "--verdict", "disputed",
                                  "--reason", "x"])
    check(acc, "a second triage is refused — the record is the response, not a negotiation",
          p14.code == 1 && p14.err.contains("one finding, one response"), "")

    let cv: ChainVerdict = verify_chain(h)
    check(acc, "the chain law holds over the life ledger (" + cv.detail + ")",
          cv.ok, "")
    return tree
}

fn engage_args() -> list[str] {
    let out: list[str] = ["engage", "--firm", "Meridian Audit Partners",
                          "--window", "2026-11-02/2026-12-24",
                          "--basis", "fixed fee against the scope census, half at engagement",
                          "--by", "mhieuhonda",
                          "--auditor", "Dana Fischer",
                          "--auditor", "Ravi Chandran"]
    return out
}

fn s7_signoff_law(acc: Acc, tree: str, h: str) -> void uses IO, Fs, Proc {
    section("Section 7 — the signoff law")

    let p: FaRun = fa(tree, h, ["signoff", "--by", "Dana Fischer"])
    check(acc, "an auditor cannot sign off — the auditors' deliverable is the findings, not the closure",
          p.code == 1 && p.err.contains("the signoff is the project's act"), "")

    # A solo ledger: remediated-shaped, but no independent pass.
    let solo: str = led(acc, "solo")
    default_engage(acc, solo)
    fa_run(["evidence", "--ledger", solo, "--by", "mhieuhonda"])
    let p2: FaRun = fa_run(["signoff", "--ledger", solo, "--by", "mhieuhonda"])
    check(acc, "a solo, self-assessed ledger is refused at the seal — an audit that closes on the project's own evidence is a rubber stamp with a paper trail",
          p2.code == 1 && p2.err.contains("no independent pass")
              && p2.err.contains("rubber stamp"), "")

    # A finding without its triage keeps the seal shut.
    let untr: str = led(acc, "untr")
    default_engage(acc, untr)
    fa_run(["evidence", "--ledger", untr, "--by", "Dana Fischer"])
    fa_run(["file", "--ledger", untr, "--against", "G-CT-01",
            "--severity", "low", "--title", "x", "--repro-text", "x",
            "--by", "Dana Fischer"])
    let p3: FaRun = fa_run(["signoff", "--ledger", untr, "--by", "mhieuhonda"])
    check(acc, "a finding without its triage refuses the seal",
          p3.code == 1 && p3.err.contains("carries no triage"), "")

    # A fix that no longer lands: reset the life tree past the fix.
    let entries: list[JsonValue] = entries_of(h)
    let mut fix: str = ""
    let mut i: int = 0
    while i < entries.len() {
        if jstr(entries.get(i), "kind") == "triage" {
            fix = jstr(entries.get(i), "fix")
        }
        i = i + 1
    }
    run_capture("git", ["-C", tree, "reset", "-q", "--hard", "HEAD~1"])
    let p4: FaRun = fa(tree, h, ["signoff", "--by", "mhieuhonda"])
    check(acc, "a remediation that no longer lands refuses the seal",
          p4.code == 1 && p4.err.contains("not an ancestor"), "")
    run_capture("git", ["-C", tree, "reset", "-q", "--hard", fix])

    # The drifted anchor: a closure-ready ledger on a moved freeze.
    let drift: str = git_tree(acc, "drift7")
    let dh: str = path_join3(drift, "final.jsonl")
    fa(drift, dh, engage_args())
    fa(drift, dh, ["evidence", "--by", "Dana Fischer"])
    fa(drift, dh, ["file", "--against", "G-CT-01", "--severity", "medium",
                   "--title", "x", "--repro-text", "x", "--by", "Dana Fischer"])
    sh("sleep 1.1")
    let dfx: str = git_empty_commit(drift, "fix: the boundary")
    fa(drift, dh, ["triage", "AF-001", "--verdict", "accepted",
                   "--reason", "r", "--fix", dfx])
    let fz: str = path_join3(drift, "tests/api_freeze.json")
    let doc: JsonValue = parse_json_or_null(read_file(fz))
    let dkeys: list[str] = []
    let dvals: list[JsonValue] = []
    let mut d_i: int = 0
    while d_i < doc.obj_keys.len() {
        if doc.obj_keys.get(d_i) == "digest" {
            dkeys.push("digest")
            dvals.push(json_str(repeat_str("e", 64)))
        } else {
            dkeys.push(doc.obj_keys.get(d_i))
            dvals.push(doc.obj_vals.get(d_i))
        }
        d_i = d_i + 1
    }
    write_file(fz, json_stringify(JsonValue { kind: "object", bval: false,
        ival: 0, fval: 0.0, sval: "", arr: [], obj_keys: dkeys,
        obj_vals: dvals }))
    let p5: FaRun = fa(drift, dh, ["signoff", "--by", "mhieuhonda"])
    check(acc, "a closure-ready ledger on a moved freeze is refused — a moved surface is a new engagement, not an amendment",
          p5.code == 1 && p5.err.contains("api-freeze anchor moved")
              && p5.err.contains("new engagement"), "")
    rmrf(drift)

    # A non-git tree: the landing law cannot even be read.
    let nogit: str = full_tree(acc, "nogit")
    let nh: str = path_join3(nogit, "final.jsonl")
    fa_run(["engage", "--ledger", nh, "--root", nogit,
            "--firm", "Meridian Audit Partners",
            "--window", "2026-11-02/2026-12-24",
            "--basis", "fixed fee against the scope census, half at engagement",
            "--by", "mhieuhonda", "--auditor", "Dana Fischer"])
    fa_run(["evidence", "--ledger", nh, "--root", nogit,
            "--by", "Dana Fischer"])
    let p6: FaRun = fa_run(["signoff", "--ledger", nh, "--root", nogit,
                            "--by", "mhieuhonda"])
    check(acc, "a non-git tree refuses the seal — the final audit does not close on a tree whose history it cannot read",
          p6.code == 1 && p6.err.contains("not a git repository"), "")
    rmrf(nogit)

    # The happy seal, on the life tree.
    let p7: FaRun = fa(tree, h, ["signoff", "--by", "mhieuhonda"])
    check(acc, "the project signs the closure and the seal is written",
          p7.code == 0 && p7.out.contains("sealed"), "")
    let entries2: list[JsonValue] = entries_of(h)
    let mut seal: JsonValue = json_null()
    i = 0
    while i < entries2.len() {
        if jstr(entries2.get(i), "kind") == "signoff" {
            seal = entries2.get(i)
        }
        i = i + 1
    }
    check(acc, "the seal records the tree it closed",
          jstr(seal, "tree") == git_head(tree), "")
    let live: Anchors = live_anchor_digests(acc)
    let seal_anchors: JsonValue = jobj(seal, "anchors")
    check(acc, "the seal pins the live guarantee-scope anchor",
          jstr(seal_anchors, "guarantee-scope") == live.guarantee_scope, "")
    check(acc, "the seal pins the live api-freeze anchor",
          jstr(seal_anchors, "api-freeze") == live.api_freeze, "")
    check(acc, "the seal pins the live bootstrap-snapshot anchor",
          jstr(seal_anchors, "bootstrap-snapshot") == live.bootstrap_snapshot, "")
    check(acc, "the seal records the closure census",
          jint(seal, "findings") == 1 && jint(seal, "fixes") == 1
              && jint(seal, "independent_passes") >= 1, "")

    let p8: FaRun = fa(tree, h, ["status", "--json"])
    check(acc, "status --json derives the seventh state",
          jstr(parse_json_or_null(p8.out), "state") == "sealed", "")

    # THE SEAL LAW: every writer refuses by name, the readers read.
    let raw_before: str = read_file(h)
    let writer_args: list[list[str]] = [
        ["evidence", "--by", "Dana Fischer"],
        ["file", "--against", "G-CT-01", "--severity", "low",
         "--title", "x", "--repro-text", "x", "--by", "Dana Fischer"],
        ["triage", "AF-001", "--verdict", "disputed", "--reason", "x"],
        ["signoff", "--by", "mhieuhonda"]]
    let names: list[str] = ["evidence", "file", "triage", "signoff"]
    let mut w: int = 0
    while w < writer_args.len() {
        let r: FaRun = fa(tree, h, writer_args.get(w))
        check(acc, "`" + names.get(w) + "` after the seal is refused by name",
              r.code == 1 && r.err.contains("after the seal is the next audit"), "")
        w = w + 1
    }
    check(acc, "the sealed ledger's bytes did not move",
          read_file(h) == raw_before, "")
    let p9: FaRun = fa(tree, h, ["status"])
    check(acc, "the readers still read the sealed ledger",
          p9.code == 0 && p9.out.contains("sealed"), "")

    # The report renders the seal.
    let r1: str = scratch(acc, "rep-1.md")
    let r2: str = scratch(acc, "rep-2.md")
    let p10: FaRun = fa(tree, h, ["report", "--out", r1])
    check(acc, "report renders the deliverable",
          p10.code == 0 && p10.out.contains("state sealed"), "")
    let doc_r: str = read_file(r1)
    let raw: str = read_file(h)
    check(acc, "the report embeds the ledger digest, re-derived by the gate from the raw bytes",
          doc_r.contains("`sha256:" + sha256_hex(raw) + "`"), "")
    check(acc, "the report renders the signoff block and the seal's law",
          doc_r.contains("**SEALED**")
              && doc_r.contains("What comes after the seal"), "")
    fa(tree, h, ["report", "--out", r2])
    check(acc, "two renders of one ledger are byte-identical",
          read_file(r1) == read_file(r2), "")
}

fn s8_gate_law(acc: Acc, tree: str, h: str) -> void uses IO, Fs, Proc {
    section("Section 8 — the gate law")

    let p: FaRun = fa_run(["gate", "--ledger", led(acc, "none")])
    check(acc, "the gate on a missing ledger: a release candidate is not cut from an unaudited tree",
          p.code == 1 && p.err.contains("not cut from an unaudited tree"), "")

    let names: list[str] = ["engage", "solo", "untr"]
    let wants: list[str] = ["open", "underway", "reported"]
    let mut i: int = 0
    while i < names.len() {
        let r: FaRun = fa_run(["gate", "--ledger", led(acc, names.get(i))])
        check(acc, "the gate is red on the " + names.get(i)
              + " ledger, naming its state",
              r.code == 1 && r.err.contains(wants.get(i)), "")
        i = i + 1
    }

    let pg: FaRun = fa(tree, h, ["gate"])
    check(acc, "the gate is green on the sealed audit",
          pg.code == 0 && pg.out.contains("GATE GREEN"), "")

    # A release cut from a DESCENDANT of the sealed tree: green.
    git_empty_commit(tree, "rc1 prep — the release moves on")
    let pg2: FaRun = fa(tree, h, ["gate"])
    check(acc, "a release cut from a descendant of the sealed tree is green — the audited artifact is still the ancestor",
          pg2.code == 0 && pg2.out.contains("GATE GREEN"), "")

    # A release cut AROUND the audit: refused.
    let entries: list[JsonValue] = entries_of(h)
    let mut sealed_tree: str = ""
    i = 0
    while i < entries.len() {
        if jstr(entries.get(i), "kind") == "signoff" {
            sealed_tree = jstr(entries.get(i), "tree")
        }
        i = i + 1
    }
    run_capture("git", ["-C", tree, "reset", "-q", "--hard", "HEAD~2"])
    let pg3: FaRun = fa(tree, h, ["gate"])
    check(acc, "a release cut around the audit is refused",
          pg3.code == 1 && pg3.err.contains("cut around the audit"), "")
    run_capture("git", ["-C", tree, "reset", "-q", "--hard", sealed_tree])
    let pg4: FaRun = fa(tree, h, ["gate"])
    check(acc, "restored to the sealed tree, the gate is green again",
          pg4.code == 0, "")

    # Each anchor mutated after the seal: refused by name.
    let anchor_names: list[str] = ["api-freeze", "bootstrap-snapshot",
                                   "guarantee-scope"]
    let anchor_paths: list[str] = ["tests/api_freeze.json",
                                   "snapshot/MANIFEST.json",
                                   "tools/hls-guarantee.py"]
    let mut a: int = 0
    while a < anchor_names.len() {
        let path: str = anchor_paths.get(a)
        let full: str = path_join3(tree, path)
        if ends_with_json(path) {
            let doc: JsonValue = parse_json_or_null(read_file(full))
            let key: str = "digest"
            if path.contains("MANIFEST") {
                let key2: str = "hlc_c_sha256"
                write_file(full, json_stringify(
                    json_clone_set(doc, key2, repeat_str("b", 64))))
            } else {
                write_file(full, json_stringify(
                    json_clone_set(doc, key, repeat_str("a", 64))))
            }
        } else {
            write_file(full, read_file(full) + "\nLEDGER = LEDGER[:14]\n")
        }
        let r: FaRun = fa(tree, h, ["gate"])
        check(acc, "the " + anchor_names.get(a)
              + " anchor moved after the seal — the candidate is not the artifact that was audited",
              r.code == 1
                  && r.err.contains(anchor_names.get(a)
                      + " anchor moved after the seal"), "")
        run_capture("git", ["-C", tree, "checkout", "-q", "--", path])
        a = a + 1
    }

    let pg5: FaRun = fa(tree, h, ["gate"])
    check(acc, "the tree restored, the gate is green", pg5.code == 0, "")
    rmrf(tree)
}

# ends_with_json(s) — the .json suffix test.
fn ends_with_json(s: str) -> bool {
    if s.len() < 5 {
        return false
    }
    return s.slice(s.len() - 5, s.len()) == ".json"
}

fn json_clone_set(obj: JsonValue, key: str, val: str) -> JsonValue {
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    while i < obj.obj_keys.len() {
        if obj.obj_keys.get(i) == key {
            keys.push(key)
            vals.push(json_str(val))
        } else {
            keys.push(obj.obj_keys.get(i))
            vals.push(obj.obj_vals.get(i))
        }
        i = i + 1
    }
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
                       sval: "", arr: [], obj_keys: keys, obj_vals: vals }
}

fn s9_corpus(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 9 — the corpus showcase")
    let showcase: str = "tests/ok/feat_stage144_finalaudit.hls"
    let expected: str = "all 8 finalaudit laws hold\n"

    let chk: RunResult = run_capture("python3",
        ["tools/hlinterp/boot.py", "--check", showcase])
    check(acc, "the showcase boots through the real checker", chk.code == 0, "")
    let run_it: RunResult = run_capture("python3",
        ["tools/hlinterp/boot.py", showcase])
    check(acc, "the showcase runs green on the interpreter, exact output",
          run_it.code == 0 && run_it.out == expected, "")
    let fmt: RunResult = run_capture("bin/hlfmt", ["--check", showcase])
    check(acc, "the showcase is hlfmt-canonical", fmt.code == 0, "")
    let lint: RunResult = run_capture("./bin/hllint", [showcase])
    check(acc, "the showcase is hllint-clean",
          lint.code == 0 && lint.out.contains("no warnings"), "")

    if file_exists("bin/hlc") && which("gcc") {
        let c_path: str = scratch(acc, "showcase.c")
        let bin_path: str = scratch(acc, "showcase_bin")
        let r1: RunResult = run_capture("bin/hlc", [showcase, c_path])
        if r1.code != 0 {
            check(acc, "hlc compiled the showcase", false, clip(first_line(r1.out), 120))
        } else {
            let r2: RunResult = run_capture("gcc",
                ["-O2", "-o", bin_path, c_path, "-lm", "-pthread"])
            if r2.code != 0 {
                check(acc, "gcc compiled the showcase", false,
                      clip(first_line(r2.err), 120))
            } else {
                let rn: RunResult = run_capture(bin_path, [])
                check(acc, "the showcase matches natively, byte for byte",
                      rn.code == 0 && rn.out == expected, "")
            }
        }
    } else {
        println("  (bin/hlc or cc not available — native differential skipped, interpreter legs ran)")
    }
}

# ----------------------------------------------------------------------------
# main
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Fs, Proc, Exit {
    let acc: Acc = acc_new("finalaudit")
    s1_convention(acc)
    s2_engagement(acc)
    s3_brief_law(acc)
    s4_evidence_law(acc)
    s5_finding_law(acc)
    let tree: str = s6_triage_law(acc)
    s7_signoff_law(acc, tree, path_join3(tree, "final.jsonl"))
    s8_gate_law(acc, tree, path_join3(tree, "final.jsonl"))
    s9_corpus(acc)
    return finish(acc, "Stage 144 -- the final audit")
}
