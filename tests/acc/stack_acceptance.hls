# ============================================================================
# tests/acc/stack_acceptance.hls — Stage 82 acceptance gate, in Halis
# (the Halis twin of what was tests/stack_acceptance.py; same seven
# sections, same assertions, same needles — the harness is
# tests/acc/harness.hls and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make stackguard-acceptance` (which compiles this file to
# bin/acc-stack and runs it from the repo root).
#
# The old battery reached into the lab interpreter's Python internals
# (_resolve_import, tokenize/Parser) for its first two sections; the
# gate asks the same questions through the front door.
#
#  1. core.stack import resolution (+ traversal guards)
#  2. core.stack parses standalone (zero imports)
#  3. Stage-0 enforcement (demo hits the guard; ok-test clean)
#  4. Budget probes (interpreter): accept/reject + the audit chain,
#     the guard panics
#  5. Self-hosted emission (hlc) + native parity + the task runtime's
#     deterministic-stack machinery
#  6. hlfmt stability over every Stage 82 file
#  7. --audit: every core.stack function pure (no uses)
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.regex"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

struct GuardP {
    name: str,
    body: str
}

fn demo() -> str {
    return "examples/stack_guard_demo.hls"
}

fn ok_test() -> str {
    return "tests/ok/feat_stage82_stack.hls"
}

fn core_stack() -> str {
    return "core/stack.hls"
}

fn core_modules() -> list[str] {
    return ["option", "result", "iter", "clone", "eq", "alloc", "mem",
            "panic", "stack"]
}

fn fail_budget() -> str {
    return "tests/fail/fail_stack_budget_exceeded.hls"
}

fn fail_recur() -> str {
    return "tests/fail/fail_stack_budget_recursion.hls"
}

fn fail_fnbody() -> str {
    return "tests/fail/fail_stack_size_fn.hls"
}

fn must_fns() -> list[str] {
    return [
        "stack_page_size", "stack_page_align", "stack_page_align_up",
        "stack_pages_for", "stack_fault_name", "stack_fault_code",
        "stack_config_new", "stack_usable_bytes", "stack_guard_bytes",
        "stack_total_footprint_size", "stack_total_footprint",
        "stack_bottom", "stack_guard_base", "stack_offset_valid",
        "stack_classify_offset", "stack_probe", "stack_try_probe",
        "stack_remaining", "stack_has_overflow", "stack_frame_cost",
        "stack_chain_bytes", "stack_max_depth", "stack_chain_fits",
        "stack_plan_new", "stack_canary_value", "stack_canary_ok",
    ]
}

fn fits_hls() -> str {
    return "#![stack_size(4096)]\n" +
           "fn leaf() -> int { return 7 }\n" +
           "fn main() -> int {\n" +
           "    let x: int = leaf()\n" +
           "    let y: int = leaf()\n" +
           "    if x + y != 14 { return 1 }\n" +
           "    return 0\n" +
           "}\n"
}

fn over_hls() -> str {
    return "#![stack_size(100)]\n" +
           "fn leaf() -> int { return 7 }\n" +
           "fn main() -> int {\n" +
           "    let x: int = leaf()\n" +
           "    let y: int = leaf()\n" +
           "    return x + y\n" +
           "}\n"
}

fn spawner_hls() -> str {
    return "fn work() -> bool {\n" +
           "    return true\n" +
           "}\n" +
           "fn main() -> int uses Conc {\n" +
           "    let t: Task[bool] = spawn(work)\n" +
           "    let r: bool = t.join()\n" +
           "    if r != true { return 1 }\n" +
           "    return 0\n" +
           "}\n"
}

fn guard_probes() -> list[GuardP] {
    return [
        GuardP {
            name: "guard: config zero size",
            body: "import \"core.stack\"\n" +
                  "fn main() -> int {\n" +
                  "    let _: StackConfig = stack_config_new(0, 1, 1048576)\n" +
                  "    return 0\n" +
                  "}\n"
        },
        GuardP {
            name: "guard: config unaligned size",
            body: "import \"core.stack\"\n" +
                  "fn main() -> int {\n" +
                  "    let _: StackConfig = stack_config_new(4097, 1, 1048576)\n" +
                  "    return 0\n" +
                  "}\n"
        },
        GuardP {
            name: "guard: config zero guard pages",
            body: "import \"core.stack\"\n" +
                  "fn main() -> int {\n" +
                  "    let _: StackConfig = stack_config_new(4096, 0, 1048576)\n" +
                  "    return 0\n" +
                  "}\n"
        },
        GuardP {
            name: "guard: probe onto the guard page",
            body: "import \"core.stack\"\n" +
                  "fn main() -> int {\n" +
                  "    let cfg: StackConfig = stack_config_new(4096, 1, 1048576)\n" +
                  "    let _: int = stack_probe(cfg, 4097)\n" +
                  "    return 0\n" +
                  "}\n"
        },
        GuardP {
            name: "guard: remaining past the region",
            body: "import \"core.stack\"\n" +
                  "fn main() -> int {\n" +
                  "    let cfg: StackConfig = stack_config_new(4096, 1, 1048576)\n" +
                  "    let _: int = stack_remaining(cfg, 4097)\n" +
                  "    return 0\n" +
                  "}\n"
        },
        GuardP {
            name: "guard: zero frame plan",
            body: "import \"core.stack\"\n" +
                  "fn main() -> int {\n" +
                  "    let _: StackConfig = stack_plan_new(0, 1, 1, 1048576)\n" +
                  "    return 0\n" +
                  "}\n"
        },
    ]
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

fn decl_word(src: str, kw: str, name: str) -> bool {
    let rr: Result[Regex, str] = regex_compile(kw + "\\s+" + name + "\\b")
    if result_is_err(rr) {
        return false
    }
    let re: Regex = result_unwrap(rr)
    return regex_is_match(re, src)
}

fn import_paths(src: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i).trim()
        if line.starts_with("import ") {
            let rest: str = line.slice(7, line.len()).trim()
            if rest.starts_with("\"") {
                let tail: str = rest.slice(1, rest.len())
                let end: int = tail.find("\"")
                if end > 0 {
                    out.push(tail.slice(0, end))
                }
            }
        }
        i = i + 1
    }
    return out
}

fn swap_no_std(text: str) -> str {
    let at: int = text.find("\n#![no_std]\n")
    if at < 0 {
        return text
    }
    return text.slice(0, at) + "\n#![freestanding]\n"
        + text.slice(at + 12, text.len())
}

fn drop_no_std(text: str) -> str {
    let at: int = text.find("#![no_std]\n")
    if at < 0 {
        return text
    }
    return text.slice(0, at) + text.slice(at + 11, text.len())
}

# ----------------------------------------------------------------------------
# 1. core.stack resolution + traversal guards
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    section("1. core.stack import resolution (+ traversal guards)")
    let p: str = write_src(acc, "res_stack.hls",
        "import \"core.stack\"\n" +
        "\n" +
        "fn main() -> int {\n" +
        "    return 0\n" +
        "}\n")
    let r: RunResult = boot_check(acc, p)
    check(acc, "core.stack resolves", r.code == 0, clip(r.combined, 60))
    let mods: list[str] = core_modules()
    let mut i: int = 0
    while i < mods.len() {
        let m: str = mods.get(i)
        let q: str = write_src(acc, "res_" + m + ".hls",
            "import \"core." + m + "\"\n" +
            "\n" +
            "fn main() -> int {\n" +
            "    return 0\n" +
            "}\n")
        let rq: RunResult = boot_check(acc, q)
        check(acc, "core." + m + " still resolves", rq.code == 0, "")
        i = i + 1
    }
    let s: str = write_src(acc, "res_std_str.hls",
        "import \"std.str\"\n" +
        "\n" +
        "fn main() -> int {\n" +
        "    return 0\n" +
        "}\n")
    let rs: RunResult = boot_check(acc, s)
    check(acc, "std.str still resolves", rs.code == 0, "")
    let evils: list[str] = ["core.../secret", "core./x", "core"]
    let mut j: int = 0
    while j < evils.len() {
        let e: str = evils.get(j)
        let q: str = write_src(acc, "guard_" + j.to_str() + ".hls",
            "import \"" + e + "\"\n" +
            "\n" +
            "fn main() -> int {\n" +
            "    return 0\n" +
            "}\n")
        let rq: RunResult = boot_check(acc, q)
        check(acc, "guard '" + e + "'", rq.code != 0, clip(rq.combined, 70))
        j = j + 1
    }
}

# ----------------------------------------------------------------------------
# 2. core.stack parses standalone + imports are core-only
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO {
    section("2. core.stack parses standalone + core-only imports")
    let src: str = read_or(core_stack(), "")
    check(acc, "core/stack.hls parses", src.len() > 0 && top_kinds_pos(src), "shape ok")
    check(acc, "StackConfig present", decl_word(src, "struct", "StackConfig"), "")
    check(acc, "StackFault enum present", decl_word(src, "enum", "StackFault"), "")
    let imps: list[str] = import_paths(src)
    let mut all_core: bool = true
    let mut k: int = 0
    while k < imps.len() {
        if !imps.get(k).starts_with("core.") {
            all_core = false
        }
        k = k + 1
    }
    check(acc, "imports are core-only", all_core, str_join(imps, ", "))
    let fns: list[str] = must_fns()
    let mut missing: str = ""
    let mut j: int = 0
    while j < fns.len() {
        if !decl_word(src, "fn", fns.get(j)) {
            missing = missing + " " + fns.get(j)
        }
        j = j + 1
    }
    check(acc, "all reference functions present", missing == "", clip(missing, 90))
    let lines: list[str] = src.split("\n")
    let mut fn_count: int = 0
    let mut li: int = 0
    while li < lines.len() {
        if lines.get(li).starts_with("fn ") {
            fn_count = fn_count + 1
        }
        li = li + 1
    }
    check(acc, "function count sane (>= 25)", fn_count >= 25, fn_count.to_str())
}

fn top_kinds_pos(src: str) -> bool {
    let lines: list[str] = src.split("\n")
    let mut has_s: bool = false
    let mut has_e: bool = false
    let mut has_f: bool = false
    let mut i: int = 0
    while i < lines.len() {
        let l: str = lines.get(i)
        if l.starts_with("struct ") {
            has_s = true
        }
        if l.starts_with("enum ") {
            has_e = true
        }
        if l.starts_with("fn ") {
            has_f = true
        }
        i = i + 1
    }
    return has_s && has_e && has_f
}

# ----------------------------------------------------------------------------
# 3. Stage-0 enforcement (demo + no_std / freestanding / hosted ok-test)
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. Stage-0 enforcement (demo hits the guard; ok-test clean)")
    let rd: RunResult = boot_check(acc, demo())
    check(acc, "hosted demo checks", rd.code == 0, clip(rd.combined, 60))
    let rd2: RunResult = boot(acc, [demo()])
    check(acc, "demo hits the guard (exit 101)", rd2.code == 101,
        "rc=" + rd2.code.to_str())
    check(acc, "guard message present",
        rd2.out.contains("guard page hit at offset 8193")
            || rd2.err.contains("guard page hit at offset 8193"), "")
    check(acc, "handler marker on stdout",
        rd2.out.contains("kernel panic: stack overflow"), "")
    check(acc, "default report on stderr", rd2.err.contains("guard page hit"), "")
    let rt: RunResult = boot_check(acc, ok_test())
    check(acc, "no_std ok-test checks", rt.code == 0, clip(rt.combined, 60))
    let rt2: RunResult = boot(acc, [ok_test()])
    check(acc, "no_std ok-test runs (exit 0)", rt2.code == 0, "rc=" + rt2.code.to_str())
    let fs_src: str = swap_no_std(read_file(ok_test()))
    let fs_p: str = write_src(acc, "ok_fs.hls", fs_src)
    let rf: RunResult = boot_check(acc, fs_p)
    check(acc, "freestanding ok-test checks", rf.code == 0, clip(rf.combined, 60))
    let rf2: RunResult = boot(acc, [fs_p])
    check(acc, "freestanding ok-test runs (exit 0)", rf2.code == 0,
        "rc=" + rf2.code.to_str())
    let bare_src: str = drop_no_std(read_file(ok_test()))
    let bare_p: str = write_src(acc, "ok_bare.hls", bare_src)
    let rb: RunResult = boot(acc, [bare_p])
    check(acc, "hosted (no crate attr) ok-test runs (exit 0)", rb.code == 0,
        "rc=" + rb.code.to_str())
    let ra: RunResult = boot(acc, ["--audit", ok_test()])
    check(acc, "--audit shows no_std", ra.code == 0 && ra.out.contains("#![no_std]"), "")
    # The three Stage 82 fail programs.
    let fails: list[list[str]] = [
        [fail_budget(), "worst-case stack chain is"],
        [fail_recur(), "requires bounded recursion"],
        [fail_fnbody(), "#[stack_size(40)] violated by function 'fat'"],
    ]
    let mut i: int = 0
    while i < fails.len() {
        let f: list[str] = fails.get(i)
        let r: RunResult = boot_check(acc, f.get(0))
        check(acc, "rejected: " + basename(f.get(0)),
            r.code == 1 && r.combined.contains(f.get(1)),
            clip(r.combined, 100))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 4. Targeted probes (interpreter): budget accept/reject + audit
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("4. Budget probes (interpreter)")
    # A fitting program: accepted, and --audit reports the chain.
    let fits: str = write_src(acc, "fits.hls", fits_hls())
    let r: RunResult = boot_check(acc, fits)
    check(acc, "fitting budget accepted", r.code == 0, clip(r.combined, 80))
    let ra: RunResult = boot(acc, ["--audit", fits])
    check(acc, "audit reports the budget line",
        ra.out.contains("Stack budget: #![stack_size(4096)]")
            && ra.out.contains("worst chain"), clip(ra.out, 90))
    check(acc, "audit names the worst chain", ra.out.contains("main -> leaf"), "")
    let rrun: RunResult = boot(acc, [fits])
    check(acc, "fitting budget runs (exit 0)", rrun.code == 0,
        "rc=" + rrun.code.to_str())
    # Over budget: rejected with the chain named.
    let over: str = write_src(acc, "over.hls", over_hls())
    let ro: RunResult = boot_check(acc, over)
    check(acc, "over-budget rejected with the exact chain",
        ro.code == 1 && ro.combined.contains("worst-case stack chain is 112 bytes (main -> leaf)"),
        clip(ro.combined, 120))
    # Recursion: rejected regardless of the budget size.
    let rc2: RunResult = boot_check(acc, fail_recur())
    check(acc, "recursion cycle rejected",
        rc2.code == 1 && rc2.combined.contains("shrink -> shrink"),
        clip(rc2.combined, 100))
    # The guard probes (each exits 101 with the guard message).
    let gps: list[GuardP] = guard_probes()
    let mut i: int = 0
    while i < gps.len() {
        let g: GuardP = gps.get(i)
        let path: str = write_src(acc, "gp_" + i.to_str() + ".hls", g.body)
        let rg: RunResult = boot(acc, [path])
        check(acc, "probe: " + g.name,
            rg.code == 101 && (rg.combined.contains("panic") || rg.combined.contains("guard")),
            "rc=" + rg.code.to_str())
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 5. Self-hosted emission (hlc) + native parity + runtime machinery
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("5. Self-hosted emission (hlc) + native parity")
    let out: str = scratch(acc, "sgd.c")
    let r: RunResult = boot(acc, ["src/hlc.hls", demo(), out])
    check(acc, "hlc emits hosted C", r.code == 0 && file_exists(out),
        clip(r.combined, 100))
    let src: str = read_or(out, "")
    let mre: Result[Regex, str] = regex_compile("int main\\s*\\(")
    let mut has_main: bool = false
    if result_is_ok(mre) {
        if regex_is_match(result_unwrap(mre), src) {
            has_main = true
        }
    }
    check(acc, "hosted main kept", has_main, "")
    check(acc, "handler body compiled", src.contains("usf_panic_handler"), "")
    check(acc, "hook machinery present",
        src.contains("hl_panic_hook") && src.contains("hl_in_panic"), "")
    let binp: str = scratch(acc, "sgd.bin")
    let g: RunResult = run_capture("gcc", ["-O2", "-o", binp, out, "-lm", "-pthread"])
    if g.code == 0 {
        let nat: RunResult = run_capture(binp, [])
        check(acc, "native guard marker",
            nat.out.contains("kernel panic: stack overflow"),
            "rc=" + nat.code.to_str())
        check(acc, "native guard message",
            nat.out.contains("guard page hit at offset 8193")
                || nat.err.contains("guard page hit at offset 8193"), "")
        check(acc, "native demo exit 101", nat.code == 101,
            "rc=" + nat.code.to_str())
    } else {
        check(acc, "native stack_guard_demo links", false, "gcc failed")
    }
    # The no_std ok-test compiles to hosted C and exits 0 natively.
    let out3: str = scratch(acc, "ok.c")
    let r3: RunResult = boot(acc, ["src/hlc.hls", ok_test(), out3])
    check(acc, "hlc emits no_std ok C", r3.code == 0 && file_exists(out3), "")
    let okbin: str = scratch(acc, "ok.bin")
    let g3: RunResult = run_capture("gcc", ["-O2", "-o", okbin, out3, "-lm", "-pthread"])
    if g3.code == 0 {
        let nat: RunResult = run_capture(okbin, [])
        check(acc, "native ok-test exit 0", nat.code == 0,
            "rc=" + nat.code.to_str())
    } else {
        check(acc, "native ok-test links", false, "gcc failed")
    }
    # Freestanding parity.
    let fs_src: str = swap_no_std(read_file(ok_test()))
    let fs_p: str = write_src(acc, "ok_fs2.hls", fs_src)
    let interp: RunResult = boot(acc, [fs_p])
    let out2: str = scratch(acc, "fs.c")
    let r2: RunResult = boot(acc, ["src/hlc.hls", fs_p, out2])
    check(acc, "hlc emits freestanding C", r2.code == 0 && file_exists(out2),
        clip(r2.combined, 100))
    check(acc, "freestanding _start emitted",
        read_or(out2, "").contains("void _start"), "")
    let bin2: str = scratch(acc, "fs.bin")
    let g2: RunResult = run_capture("gcc", ["-O2", "-ffreestanding", "-nostdlib",
        "-ffunction-sections", "-fno-stack-protector", "-Wl,--gc-sections",
        "-o", bin2, out2])
    if g2.code == 0 {
        let nat2: RunResult = run_capture(bin2, [])
        check(acc, "freestanding native == interpreter",
            nat2.code == interp.code,
            "interp=" + interp.code.to_str() + " nat=" + nat2.code.to_str())
    } else {
        check(acc, "freestanding binary links", false, "gcc failed")
    }
    # The task runtime carries the deterministic-stack machinery.
    let spawner: str = write_src(acc, "spawn.hls", spawner_hls())
    let outs: str = scratch(acc, "spawn.c")
    let rs: RunResult = boot(acc, ["src/hlc.hls", spawner, outs])
    check(acc, "hlc emits spawn C", rs.code == 0 && file_exists(outs),
        clip(rs.combined, 120))
    if file_exists(outs) {
        let srcs: str = read_or(outs, "")
        check(acc, "hl_thread_start present", srcs.contains("hl_thread_start"), "")
        check(acc, "deterministic stack size pinned",
            srcs.contains("HL_TASK_STACK_BYTES"), "")
        check(acc, "guard page wired",
            srcs.contains("pthread_attr_setguardsize")
                && srcs.contains("HL_TASK_GUARD_BYTES"), "")
        let sbin: str = scratch(acc, "spawn.bin")
        let gs: RunResult = run_capture("gcc", ["-O2", "-o", sbin, outs, "-lm", "-pthread"])
        if gs.code == 0 {
            let nat: RunResult = run_capture(sbin, [])
            check(acc, "native spawn task exit 0", nat.code == 0,
                "rc=" + nat.code.to_str())
        } else {
            check(acc, "native spawn program links", false, "gcc failed")
        }
    }
    # Boot/hlc parity on the fail programs.
    let fails: list[list[str]] = [
        [fail_budget(), "worst-case stack chain"],
        [fail_recur(), "requires bounded recursion"],
        [fail_fnbody(), "violated by function 'fat'"],
    ]
    let mut i: int = 0
    while i < fails.len() {
        let f: list[str] = fails.get(i)
        let outf: str = scratch(acc, "fail.c")
        let rf: RunResult = boot(acc, ["src/hlc.hls", f.get(0), outf])
        check(acc, "hlc rejects " + basename(f.get(0)),
            rf.code != 0 && rf.combined.contains(f.get(1)),
            clip(rf.combined, 120))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 6. hlfmt stability
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Proc {
    section("6. hlfmt stability over every Stage 82 file")
    let files: list[str] = [core_stack(), demo(), ok_test(),
        fail_budget(), fail_recur(), fail_fnbody()]
    let mut i: int = 0
    while i < files.len() {
        let r: RunResult = run_capture("./bin/hlfmt", ["-c", files.get(i)])
        check(acc, "hlfmt clean: " + basename(files.get(i)),
            !r.out.contains("NOT formatted"), clip(r.out, 80))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 7. --audit shows every core.stack function pure
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Proc {
    section("7. --audit: every core.stack function pure (no uses)")
    let r: RunResult = boot(acc, ["--audit", ok_test()])
    let out: str = r.out
    check(acc, "audit ran", r.code == 0, "")
    let must: list[str] = must_fns()
    let mut missing: str = ""
    let mut i: int = 0
    while i < must.len() {
        if !out.contains(must.get(i)) {
            missing = missing + " " + must.get(i)
        }
        i = i + 1
    }
    check(acc, "all stack fns in audit output", missing == "", clip(missing, 90))
    let lines: list[str] = out.split("\n")
    let mut bad: str = ""
    let mut li: int = 0
    while li < lines.len() {
        let s: str = lines.get(li).trim()
        let mut fi: int = 0
        while fi < must.len() {
            if s.starts_with(must.get(fi) + " ") {
                if !s.contains("(none - pure)") && !s.contains("(none)") {
                    bad = bad + " " + s
                }
                break
            }
            fi = fi + 1
        }
        li = li + 1
    }
    check(acc, "all stack fns declared pure", bad == "", clip(bad, 90))
    check(acc, "crate mode reported",
        out.contains("Crate mode:") && out.contains("#![no_std]"), "")
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("stack")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    return finish(acc, "Stage 82 -- deterministic stack size + guard pages")
}
