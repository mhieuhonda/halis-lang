# ============================================================================
# tests/acc/lsp_hints_acceptance.hls — Stage 114 acceptance gate, in Halis
# (the Halis twin of tests/lsp_hints_acceptance.py; same eight sections,
# same laws, same needles — the harness is tests/acc/harness.hls and
# the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make lsp-hints-acceptance`.
#
#  1. the call sites  — bare fns name their arguments, methods skip the
#                       receiver, constructors name nothing, nesting found
#  2. the layer law   — builtins beat user fns, local beats import,
#                       imports provide, open buffers beat disk
#  3. the guards      — every ambiguity degrades to NO hint, never to a
#                       wrong one, and never takes the server down
#  4. the bindings    — checker-instantiated generics, the wildcard skip,
#                       the bare pattern, the fallback
#  5. the redundancies— f(x: x) says nothing the source does not
#  6. the protocol    — the capability, the version, the range, the sorted
#                       output, the didChange
#  7. the utf-16 line — an emoji shifts bytes, not the character units
#  8. the corpus      — lsp_smoke stays green; the stage's ok file yields
#                       exactly the hints it describes
#
# The protocol harness drives the real server the way an editor does
# (initialize -> didOpen -> requests -> shutdown/exit) over stdin/stdout
# pipes: run_feed, then the gate parses the Content-Length frames itself.
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.json"

# ----------------------------------------------------------------------------
# The protocol harness.
# ----------------------------------------------------------------------------

struct LspOut {
    results: list[JsonValue],   # one per request, in order (null when absent)
    rc: int,
    err: str,
    init: JsonValue             # initialize's result (null when absent)
}

# frame(obj) — Content-Length framing; the length counts BYTES.
fn frame(obj: JsonValue) -> str {
    let body: str = json_stringify(obj)
    let crlf: str = chr(13) + chr(10)
    return "Content-Length: " + body.len().to_str() + crlf + crlf + body
}

# replace_first(s, from, to) — the one-shot string surgery.
fn replace_first(s: str, from: str, to: str) -> str {
    let mut i: int = 0
    while i + from.len() <= s.len() {
        if s.slice(i, i + from.len()) == from {
            return s.slice(0, i) + to + s.slice(i + from.len(), s.len())
        }
        i = i + 1
    }
    return s
}

fn jarr(items: list[JsonValue]) -> JsonValue {
    return JsonValue { kind: "array", bval: false, ival: 0, fval: 0.0,
                       sval: "", arr: items, obj_keys: [], obj_vals: [] }
}

fn starts_with(s: str, prefix: str) -> bool {
    if s.len() < prefix.len() {
        return false
    }
    return s.slice(0, prefix.len()) == prefix
}

# index_of_str(hay, needle) — the first byte offset (or -1).
fn index_of_str(hay: str, needle: str) -> int {
    let mut i: int = 0
    while i + needle.len() <= hay.len() {
        if hay.slice(i, i + needle.len()) == needle {
            return i
        }
        i = i + 1
    }
    return -1
}

# last_index_of_str(hay, needle) — the last byte offset (or -1).
fn last_index_of_str(hay: str, needle: str) -> int {
    let mut i: int = hay.len() - needle.len()
    while i >= 0 {
        if hay.slice(i, i + needle.len()) == needle {
            return i
        }
        i = i - 1
    }
    return -1
}

fn parse_json_or_null(text: str) -> JsonValue {
    let rr: Result[JsonValue, str] = json_parse_result(text)
    if result_is_ok(rr) {
        return result_unwrap(rr)
    }
    return json_null()
}

# parse_frames(buf) — every complete JSON body, in order.
fn parse_frames(buf: str) -> list[JsonValue] {
    let msgs: list[JsonValue] = []
    let mut rest: str = buf
    while true {
        let i: int = index_of_str(rest, "Content-Length:")
        if i < 0 {
            break
        }
        let j: int = index_of_str(rest, chr(13) + chr(10) + chr(13) + chr(10))
        if j < 0 {
            break
        }
        let num: str = rest.slice(i + 15, j).trim()
        let n: int = parse_uint(num)
        if j + 4 + n > rest.len() {
            break
        }
        msgs.push(parse_json_or_null(rest.slice(j + 4, j + 4 + n)))
        rest = rest.slice(j + 4 + n, rest.len())
    }
    return msgs
}

fn parse_uint(s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
        } else {
            break
        }
        i = i + 1
    }
    return v
}

fn jstr(v: JsonValue, key: str) -> str {
    let x: JsonValue = json_object_get(v, key)
    if json_is_str(x) {
        return json_str_value(x)
    }
    return ""
}

fn jint(v: JsonValue, key: str) -> int {
    let x: JsonValue = json_object_get(v, key)
    if json_is_int(x) {
        return json_int_value(x)
    }
    return -1
}

fn jobj(v: JsonValue, key: str) -> JsonValue {
    let x: JsonValue = json_object_get(v, key)
    if json_is_object(x) {
        return x
    }
    return json_null()
}

fn jbool(v: JsonValue, key: str) -> bool {
    let x: JsonValue = json_object_get(v, key)
    if json_is_bool(x) {
        return json_bool_value(x)
    }
    return false
}

fn jarray(v: JsonValue, key: str) -> list[JsonValue] {
    let x: JsonValue = json_object_get(v, key)
    if json_is_array(x) {
        return x.arr
    }
    let empty: list[JsonValue] = []
    return empty
}

# req(method, id, params) — one request frame's JSON.
fn req(method: str, id: int, params: JsonValue) -> JsonValue {
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
        sval: "", arr: [],
        obj_keys: ["id", "jsonrpc", "method", "params"],
        obj_vals: [json_int(id), json_str("2.0"), json_str(method), params] }
}

fn note(method: str, params: JsonValue) -> JsonValue {
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
        sval: "", arr: [],
        obj_keys: ["jsonrpc", "method", "params"],
        obj_vals: [json_str("2.0"), json_str(method), params] }
}

fn td_object(uri: str, version: int, text: str) -> JsonValue {
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
        sval: "", arr: [],
        obj_keys: ["text", "uri", "version"],
        obj_vals: [json_str(text), json_str(uri), json_int(version)] }
}

# session(ws_name, opens_rels, opens_text, req_methods, req_params,
#         seed_rels, seed_text) — one server session, driven by pipe.
# The request params carry no textDocument; request i targets open 0
# unless the caller routes it (the battery's open_idx stays 0 everywhere).
fn session(acc: Acc, ws_name: str, opens_rels: list[str],
           opens_text: list[str], req_methods: list[str],
           req_params: list[JsonValue], seed_rels: list[str],
           seed_text: list[str]) -> LspOut uses Fs, Proc {
    let base: str = scratch(acc, ws_name)
    let mut i: int = 0
    while i < seed_rels.len() {
        let full: str = path_join3(base, seed_rels.get(i))
        mkdirs(path_dir3(full))
        write_file(full, seed_text.get(i))
        i = i + 1
    }
    let uris: list[str] = []
    i = 0
    while i < opens_rels.len() {
        uris.push("file://" + path_join3(base, opens_rels.get(i)))
        i = i + 1
    }
    let payload: list[str] = []
    payload.push(frame(req("initialize", 1, json_null())))
    i = 0
    while i < opens_rels.len() {
        payload.push(frame(note("textDocument/didOpen",
            JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
                sval: "", arr: [], obj_keys: ["textDocument"],
                obj_vals: [td_object(uris.get(i), 1, opens_text.get(i))] })))
        i = i + 1
    }
    i = 0
    while i < req_methods.len() {
        let p: JsonValue = req_params.get(i)
        let with_td: JsonValue = JsonValue { kind: "object", bval: false,
            ival: 0, fval: 0.0, sval: "", arr: [],
            obj_keys: ["textDocument"],
            obj_vals: [td_object(uris.get(0), 0, "")] }
        # merge: the request's own keys + textDocument (params win on
        # their own keys by re-adding them after).
        let merged: JsonValue = merge_objects(with_td, p)
        payload.push(frame(req(req_methods.get(i), 100 + i, merged)))
        i = i + 1
    }
    payload.push(frame(req("shutdown", 2, json_null())))
    payload.push(frame(note("exit", json_null())))

    let r: RunResult = run_feed("python3", ["tools/hls-lsp.py"],
                                str_join(payload, ""))
    let out: LspOut = LspOut { results: [], rc: r.code, err: r.err,
                               init: json_null() }
    let frames: list[JsonValue] = parse_frames(r.out)
    let mut k: int = 0
    while k < req_methods.len() {
        out.results.push(json_null())
        k = k + 1
    }
    k = 0
    while k < frames.len() {
        let m: JsonValue = frames.get(k)
        let id: int = jint(m, "id")
        if id == 1 {
            out.init = json_object_get(m, "result")
        }
        if id >= 100 && id - 100 < out.results.len() {
            out.results.set(id - 100, json_object_get(m, "result"))
        }
        k = k + 1
    }
    return out
}

# merge_objects(a, b) — a's keys, then b's keys overriding.
fn merge_objects(a: JsonValue, b: JsonValue) -> JsonValue {
    if !json_is_object(b) {
        return a
    }
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    while i < a.obj_keys.len() {
        keys.push(a.obj_keys.get(i))
        vals.push(a.obj_vals.get(i))
        i = i + 1
    }
    i = 0
    while i < b.obj_keys.len() {
        let k: str = b.obj_keys.get(i)
        let mut found: bool = false
        let mut j: int = 0
        while j < keys.len() {
            if keys.get(j) == k {
                vals.set(j, b.obj_vals.get(i))
                found = true
            }
            j = j + 1
        }
        if !found {
            keys.push(k)
            vals.push(b.obj_vals.get(i))
        }
        i = i + 1
    }
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
                       sval: "", arr: [], obj_keys: keys, obj_vals: vals }
}

# hints_of(ws, main_rel, main_text, extra_open_rel, extra_open_text,
#          seed_rel, seed_text, range_json) — one inlayHint request.
# Empty strings mean "absent".
fn hints_of(acc: Acc, ws: str, main_rel: str, main_text: str,
            extra_rel: str, extra_text: str, seed_rel: str, seed_text: str,
            range_json: JsonValue) -> LspOut uses Fs, Proc {
    let opens_rels: list[str] = [main_rel]
    let opens_text: list[str] = [main_text]
    if extra_rel != "" {
        opens_rels.push(extra_rel)
        opens_text.push(extra_text)
    }
    let mut params: JsonValue = json_null()
    if json_is_object(range_json) {
        params = JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
            sval: "", arr: [], obj_keys: ["range"],
            obj_vals: [range_json] }
    }
    let methods: list[str] = ["textDocument/inlayHint"]
    let params_list: list[JsonValue] = [params]
    let seed_rels: list[str] = []
    let seed_texts: list[str] = []
    if seed_rel != "" {
        seed_rels.push(seed_rel)
        seed_texts.push(seed_text)
    }
    return session(acc, ws, opens_rels, opens_text, methods, params_list,
                   seed_rels, seed_texts)
}

# hints_of_simple — the common no-extras shape.
fn hints_of_simple(acc: Acc, ws: str, main_text: str) -> LspOut uses Fs, Proc {
    return hints_of(acc, ws, "main.hls", main_text, "", "", "", "",
                    json_null())
}

# find(hs, line0, label) — the hint at an exact (line, label) pair.
fn find(hs: JsonValue, line0: int, label: str) -> JsonValue {
    if !json_is_array(hs) {
        return json_null()
    }
    let mut i: int = 0
    while i < hs.arr.len() {
        let h: JsonValue = hs.arr.get(i)
        let pos: JsonValue = jobj(h, "position")
        if jint(pos, "line") == line0 && jstr(h, "label") == label {
            return h
        }
        i = i + 1
    }
    return json_null()
}

fn is_null(v: JsonValue) -> bool {
    return !json_is_object(v) && !json_is_array(v) && !json_is_str(v)
        && !json_is_int(v) && !json_is_float(v) && !json_is_bool(v)
}

# line_of(text, needle) — the 0-based line carrying the needle (-1).
fn line_of(text: str, needle: str) -> int {
    let lines: list[str] = text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).contains(needle) {
            return i
        }
        i = i + 1
    }
    return -1
}

# line_text(text, n) — the n-th line.
fn line_text(text: str, n: int) -> str {
    let lines: list[str] = text.split("\n")
    if n >= 0 && n < lines.len() {
        return lines.get(n)
    }
    return ""
}

# count_kind(hs, kind) — hints of one kind.
fn count_kind(hs: JsonValue, kind: int) -> int {
    if !json_is_array(hs) {
        return 0
    }
    let mut n: int = 0
    let mut i: int = 0
    while i < hs.arr.len() {
        if jint(hs.arr.get(i), "kind") == kind {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

# has_label(hs, label) — any hint with that label.
fn has_label(hs: JsonValue, label: str) -> bool {
    if !json_is_array(hs) {
        return false
    }
    let mut i: int = 0
    while i < hs.arr.len() {
        if jstr(hs.arr.get(i), "label") == label {
            return true
        }
        i = i + 1
    }
    return false
}

# line_has_kind(hs, line0, kind) — hints of one kind on one line.
fn line_has_kind(hs: JsonValue, line0: int, kind: int) -> bool {
    if !json_is_array(hs) {
        return false
    }
    let mut i: int = 0
    while i < hs.arr.len() {
        let h: JsonValue = hs.arr.get(i)
        if jint(jobj(h, "position"), "line") == line0
                && jint(h, "kind") == kind {
            return true
        }
        i = i + 1
    }
    return false
}

# count_kind_on_line(hs, line0, kind).
fn count_kind_on_line(hs: JsonValue, line0: int, kind: int) -> int {
    if !json_is_array(hs) {
        return 0
    }
    let mut n: int = 0
    let mut i: int = 0
    while i < hs.arr.len() {
        let h: JsonValue = hs.arr.get(i)
        if jint(jobj(h, "position"), "line") == line0
                && jint(h, "kind") == kind {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

# hints_sorted(hs) — the (line, character) pairs ascend.
fn hints_sorted(hs: JsonValue) -> bool {
    if !json_is_array(hs) {
        return true
    }
    let mut i: int = 1
    while i < hs.arr.len() {
        let a: JsonValue = hs.arr.get(i - 1)
        let b: JsonValue = hs.arr.get(i)
        let la: int = jint(jobj(a, "position"), "line")
        let lb: int = jint(jobj(b, "position"), "line")
        if la > lb {
            return false
        }
        if la == lb && jint(jobj(a, "position"), "character")
                > jint(jobj(b, "position"), "character") {
            return false
        }
        i = i + 1
    }
    return true
}

# all_in_range(hs, lo, hi).
fn all_in_range(hs: JsonValue, lo: int, hi: int) -> bool {
    if !json_is_array(hs) {
        return true
    }
    let mut i: int = 0
    while i < hs.arr.len() {
        let l: int = jint(jobj(hs.arr.get(i), "position"), "line")
        if l < lo || l > hi {
            return false
        }
        i = i + 1
    }
    return true
}

# ----------------------------------------------------------------------------
# The probe sources (the battery's heredocs, verbatim).
# ----------------------------------------------------------------------------

fn main_basic() -> str {
    return "fn add(a: int, b: int) -> int {\n"
        + "    return a + b\n"
        + "}\n"
        + "\n"
        + "fn shout(s: str, times: int) -> str {\n"
        + "    let mut out: str = s\n"
        + "    let mut i: int = 0\n"
        + "    while i < times {\n"
        + "        out = out + s\n"
        + "        i = i + 1\n"
        + "    }\n"
        + "    return out\n"
        + "}\n"
        + "\n"
        + "struct Acc {\n"
        + "    total: int,\n"
        + "}\n"
        + "\n"
        + "impl Acc {\n"
        + "    fn bump(self: Acc, by: int) -> Acc {\n"
        + "        return Acc { total: self.total + by }\n"
        + "    }\n"
        + "}\n"
        + "\n"
        + "enum Shape {\n"
        + "    Circle(int),\n"
        + "    Rect(int, int),\n"
        + "    Point\n"
        + "}\n"
        + "\n"
        + "fn area(sh: Shape) -> int {\n"
        + "    return match sh {\n"
        + "        Shape.Circle(r) => 3 * r * r,\n"
        + "        Shape.Rect(w, h) => w * h,\n"
        + "        Shape.Point => 0\n"
        + "    }\n"
        + "}\n"
        + "\n"
        + "fn wrap(inner: int) -> int {\n"
        + "    return inner\n"
        + "}\n"
        + "\n"
        + "fn main() -> int uses IO {\n"
        + "    let sum: int = add(40, 2)\n"
        + "    let banner: str = shout(\"hi\", 2)\n"
        + "    let acc: Acc = Acc { total: 1 }\n"
        + "    let acc2: Acc = acc.bump(2)\n"
        + "    let a1: int = area(Shape.Circle(3))\n"
        + "    let a2: int = area(Shape.Rect(4, 5))\n"
        + "    let w: int = wrap(add(1, add(2, 3)))\n"
        + "    println(sum.to_str())\n"
        + "    return 0\n"
        + "}\n"
}

fn lib_v1() -> str {
    return "fn scale(base: int, factor: int) -> int {\n"
        + "    return base * factor\n"
        + "}\n"
}

fn lib_v2() -> str {
    return "fn scale(mantissa: int, exponent: int) -> int {\n"
        + "    return mantissa * exponent\n"
        + "}\n"
}

fn main_import() -> str {
    return "import \"lib.hls\"\n"
        + "\n"
        + "fn local_only(grit: int) -> int {\n"
        + "    return grit\n"
        + "}\n"
        + "\n"
        + "fn scale(local_first: int, local_second: int) -> int {\n"
        + "    return local_first + local_second\n"
        + "}\n"
        + "\n"
        + "fn main() -> int {\n"
        + "    let a: int = scale(6, 7)\n"
        + "    let b: int = local_only(1)\n"
        + "    return a + b\n"
        + "}\n"
}

# main_import_only() — the import-only main (the local scale dropped).
fn main_import_only() -> str {
    return "import \"lib.hls\"\n"
        + "\n"
        + "fn local_only(grit: int) -> int {\n"
        + "    return grit\n"
        + "}\n"
        + "\n"
        + "fn main() -> int {\n"
        + "    let a: int = scale(6, 7)\n"
        + "    let b: int = local_only(1)\n"
        + "    return a + b\n"
        + "}\n"
}

fn main_shadow() -> str {
    return "fn write_file(destination: str, payload: str) -> int {\n"
        + "    return 0\n"
        + "}\n"
        + "\n"
        + "fn main() -> int {\n"
        + "    let n: int = write_file(\"a.txt\", \"b\")\n"
        + "    return n\n"
        + "}\n"
}

fn bad_arity() -> str {
    return "fn two(a: int, b: int) -> int {\n    return a + b\n}\n\n"
        + "fn main() -> int {\n    let x: int = two(1, 2, 3)\n"
        + "    return x\n}\n"
}

fn unknown_callee() -> str {
    return "fn main() -> int {\n    let t: int = spawn(1, 2, 3)\n"
        + "    return t\n}\n"
}

fn set_ambig() -> str {
    return "fn main() -> int {\n"
        + "    let xs: list[int] = [1, 2]\n"
        + "    let m: map[str, int] = map_new()\n"
        + "    xs.set(0, 9)\n"
        + "    m.set(\"k\", 9)\n"
        + "    return 0\n}\n"
}

fn two_structs() -> str {
    return "struct S1 {\n    x: int,\n}\n\nstruct S2 {\n    x: int,\n}\n\n"
        + "impl S1 {\n    fn grow(self: S1, n: int) -> S1 {\n"
        + "        return self\n    }\n}\n\n"
        + "impl S2 {\n    fn grow(self: S2, n: int) -> S2 {\n"
        + "        return self\n    }\n}\n\n"
        + "fn main() -> int {\n    let a: S1 = S1 { x: 1 }\n"
        + "    let b: S2 = a.grow(2)\n    return 0\n}\n"
}

fn shadow_m() -> str {
    return "struct S {\n    v: int,\n}\n\n"
        + "impl S {\n    fn split(self: S, sep: str) -> S {\n"
        + "        return self\n    }\n}\n\n"
        + "fn main() -> int {\n    let s: S = S { v: 1 }\n"
        + "    let t: S = s.split(\"-\")\n    return 0\n}\n"
}

fn broken_doc() -> str {
    return "fn broken( {\n    let x: int = =\n}\n"
}

