# ============================================================================
# tests/acc/mmio_acceptance.hls — Stage 87 acceptance gate, in Halis
# (the Halis twin of what was tests/mmio_acceptance.py; same seven
# sections, same assertions, same needles — the harness is
# tests/acc/harness.hls and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make mmio-acceptance` (which compiles this file to
# bin/acc-mmio and runs it from the repo root).
#
#  1. the register rule         — a 32-bit register is accepted for an
#                                 `int` operand exactly when the
#                                 template's instruction is 32-bit, and
#                                 still rejected otherwise
#  2. core/mmio.hls             — the enums / structs / surface, the
#                                 `core.*`-only import, no effects
#  3. the PATTERN               — the demo's `asm!` accesses compile
#                                 `-Werror`, and the emitted C really
#                                 is a volatile access with the memory
#                                 clobber
#  4. volatility                — a volatile DEVICE read is not folded:
#                                 two `rdtsc` reads with a million
#                                 iterations between them must differ,
#                                 hosted AND -nostdlib
#  5. the checked constructors  — four run-time panics, accepted by the
#                                 checker, panicking on the interpreter
#                                 AND natively
#  6. behaviour probes          — widths, masks, sign extension,
#                                 alignment, windows, bit fields,
#                                 barriers, domains, the LAPIC map
#  7. the demo + tools          — mmio_demo runs natively, the ok-test
#                                 is clean on all three paths, hlfmt
#                                 and hllint are clean
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.regex"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

struct PanicP {
    name: str,
    needle: str,
    desc: str
}

struct Probe {
    name: str,
    want: int,
    desc: str,
    body: str
}

struct ToolLeg {
    label: str,
    argv: list[str]
}

fn ok_test() -> str {
    return "tests/ok/feat_stage87_mmio.hls"
}

fn demo() -> str {
    return "examples/mmio_demo.hls"
}

fn core_mmio() -> str {
    return "core/mmio.hls"
}

fn core_fns() -> list[str] {
    return [
        "mmio_width_mask", "mmio_width_bits", "mmio_width_suffix", "mmio_read",
        "mmio_read_signed", "mmio_write", "mmio_sign_extend", "mmio_is_aligned",
        "mmio_is_page_aligned", "mmio_region_new", "mmio_region_contains",
        "mmio_region_end", "mmio_access_fits", "mmio_access_ok",
        "mmio_region_find", "mmio_overlaps", "mmio_regions_disjoint",
        "mmio_regions_total", "mmio_field_new", "mmio_field_mask", "mmio_field_ok",
        "mmio_field_straddles32", "mmio_read_field", "mmio_read_field_signed",
        "mmio_write_field", "mmio_set_field", "mmio_clear_field",
        "mmio_toggle_field", "mmio_field_write_ok", "mmio_barrier_name",
        "mmio_default_barrier", "mmio_is_fence", "mmio_domain_needs_barrier",
        "mmio_domain_needs_cache_maintenance", "lapic_map_valid", "lapic_reg_addr",
        "lapic_reg_aligned", "lapic_reg_fits", "lapic_encode_delivery",
        "lapic_decode_delivery", "lapic_svr_encode", "lapic_svr_vector",
        "lapic_lvt_masked",
    ]
}

fn panic_programs() -> list[PanicP] {
    return [
        PanicP { name: "panic_stage87_window_base", needle: "a device window must be page-aligned",
                 desc: "a non-page-aligned MMIO base" },
        PanicP { name: "panic_stage87_field_mask", needle: "width must be 1..64",
                 desc: "a bit field wider than the register" },
        PanicP { name: "panic_stage87_read_field", needle: "does not fit in a 64-bit register",
                 desc: "a field ending past bit 63" },
        PanicP { name: "panic_stage87_lapic", needle: "register id must be >= 0",
                 desc: "a negative LAPIC register id" },
    ]
}

# The register-rule programs, written out rather than generated so the
# exact spelling the compiler sees is visible in the gate.
fn narrow_hls() -> str {
    return "fn rd(a: int) -> int {\n" +
           "    let mut v: int = 0\n" +
           "    asm!(\"movl ({1}), {0}\", out(\"eax\") v, in(\"ecx\") a)\n" +
           "    return v\n" +
           "}\n\nfn main() -> int { return 0 }\n"
}

fn wide_hls() -> str {
    return "fn rd(a: int) -> int {\n" +
           "    let mut v: int = 0\n" +
           "    asm!(\"movq ({1}), {0}\", out(\"eax\") v, in(\"ecx\") a)\n" +
           "    return v\n" +
           "}\n\nfn main() -> int { return 0 }\n"
}

fn tsc_hls() -> str {
    return "fn rd() -> int {\n" +
           "    let mut lo: int = 0\n" +
           "    let mut hi: int = 0\n" +
           "    asm!(\"rdtsc\", out(\"rax\") lo, out(\"rdx\") hi)\n" +
           "    return hi\n" +
           "}\n\nfn main() -> int { return 0 }\n"
}

fn vol_hls() -> str {
    return "fn rd() -> int {\n" +
           "    let mut lo: int = 0\n" +
           "    let mut hi: int = 0\n" +
           "    asm!(\"rdtsc\", out(\"rax\") lo, out(\"rdx\") hi)\n" +
           "    return int_or(int_shl(int_and(hi, 4294967295), 32), int_and(lo, 4294967295))\n" +
           "}\n\n" +
           "fn main() -> int {\n" +
           "    let a: int = rd()\n" +
           "    let mut i: int = 0\n" +
           "    while i < 4000000 {\n" +
           "        i = i + 1\n" +
           "    }\n" +
           "    let b: int = rd()\n" +
           "    if b < a {\n" +
           "        return 1\n" +
           "    }\n" +
           "    if b == a {\n" +
           "        return 2\n" +
           "    }\n" +
           "    return 0\n" +
           "}\n"
}

fn aligned_hls() -> str {
    return "import \"core.result\"\n\n" +
           "fn main() -> int {\n" +
           "    let xs: list[int] = [1, 2, 3, 4, 5, 6, 7, 8]\n" +
           "    let mut i: int = 0\n" +
           "    let mut sum: int = 0\n" +
           "    while i < xs.len() {\n" +
           "        sum = sum + xs.get(i)\n" +
           "        i = i + 1\n" +
           "    }\n" +
           "    if sum != 36 {\n" +
           "        return 1\n" +
           "    }\n" +
           "    return 0\n" +
           "}\n"
}

fn probes() -> list[Probe] {
    return [
        Probe {
            name: "widths",
            want: 0,
            desc: "the width masks, and the upper half a 32-bit read leaves behind",
            body: "import \"core.mmio\"\n" +
                  "fn main() -> int {\n" +
                  "    if mmio_width_mask(MmioWidth.Dword) != 4294967295 { return 1 }\n" +
                  "    if mmio_width_mask(MmioWidth.Qword) != -1 { return 2 }\n" +
                  "    let poisoned: int = 1311768467463791224\n" +
                  "    if mmio_read(poisoned, MmioWidth.Dword) != 2596070008 { return 3 }\n" +
                  "    if mmio_read(poisoned, MmioWidth.Byte) != 120 { return 4 }\n" +
                  "    if mmio_read(poisoned, MmioWidth.Qword) != poisoned { return 5 }\n" +
                  "    if mmio_width_suffix(MmioWidth.Dword) != \"l\" { return 6 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "sign-extend",
            want: 0,
            desc: "sign extension fills bits n..63, not just the sign bit",
            body: "import \"core.mmio\"\n" +
                  "fn main() -> int {\n" +
                  "    if mmio_read_signed(251, MmioWidth.Byte) != -5 { return 1 }\n" +
                  "    if mmio_read_signed(5, MmioWidth.Byte) != 5 { return 2 }\n" +
                  "    if mmio_read_signed(65534, MmioWidth.Word) != -2 { return 3 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "windows",
            want: 0,
            desc: "a window answers whether an access is legal, in one predicate",
            body: "import \"core.mmio\"\n" +
                  "fn main() -> int {\n" +
                  "    let w: MmioRegion = mmio_region_new(67108864, 8192, false)\n" +
                  "    if !mmio_access_ok(w, 67108864 + 8, MmioWidth.Dword) { return 1 }\n" +
                  "    if mmio_access_ok(w, 67108864 + 8190, MmioWidth.Dword) { return 2 }\n" +
                  "    if mmio_access_ok(w, 67108864 + 1, MmioWidth.Dword) { return 3 }\n" +
                  "    if !mmio_region_contains(w, 67117055) { return 4 }\n" +
                  "    if mmio_region_contains(w, 67117056) { return 5 }\n" +
                  "    let odd: MmioRegion = mmio_region_new(67125248, 6, false)\n" +
                  "    if mmio_access_ok(odd, 67125248 + 4, MmioWidth.Dword) { return 6 }\n" +
                  "    if !mmio_access_ok(odd, 67125248, MmioWidth.Dword) { return 7 }\n" +
                  "    if mmio_region_find([w, odd], 0) != -1 { return 8 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "fields",
            want: 0,
            desc: "the read-modify-write arithmetic, and the two hazard cases",
            body: "import \"core.mmio\"\n" +
                  "fn main() -> int {\n" +
                  "    let f: MmioField = mmio_field_new(4, 3)\n" +
                  "    let wide: MmioField = mmio_field_new(4, 12)\n" +
                  "    let split: MmioField = mmio_field_new(30, 4)\n" +
                  "    let whole: MmioField = mmio_field_new(0, 64)\n" +
                  "    if mmio_field_mask(f) != 112 { return 1 }\n" +
                  "    if mmio_read_field(240, f) != 7 { return 2 }\n" +
                  "    if mmio_write_field(0, f, 255) != 112 { return 3 }\n" +
                  "    if mmio_set_field(0, f) != 112 { return 4 }\n" +
                  "    if mmio_clear_field(127, f) != 15 { return 5 }\n" +
                  "    if !mmio_field_straddles32(split) { return 6 }\n" +
                  "    if mmio_field_write_ok(split, MmioWidth.Dword) { return 7 }\n" +
                  "    if !mmio_field_write_ok(split, MmioWidth.Qword) { return 8 }\n" +
                  "    if mmio_field_write_ok(wide, MmioWidth.Byte) { return 9 }\n" +
                  "    if mmio_field_mask(whole) != -1 { return 10 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "domains",
            want: 0,
            desc: "the barrier levels, and the x86/aarch64 difference",
            body: "import \"core.mmio\"\n" +
                  "fn main() -> int {\n" +
                  "    if mmio_barrier_name(mmio_default_barrier()) != \"cpu\" { return 1 }\n" +
                  "    if !mmio_is_fence(mmio_default_barrier()) { return 2 }\n" +
                  "    if mmio_is_fence(MmioBarrier.Compiler) { return 3 }\n" +
                  "    if mmio_domain_needs_cache_maintenance(MmioDomain.Uncacheable) { return 4 }\n" +
                  "    if !mmio_domain_needs_barrier(MmioDomain.DeviceNgnRnE) { return 5 }\n" +
                  "    if mmio_domain_needs_barrier(MmioDomain.Normal) { return 6 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "lapic",
            want: 0,
            desc: "the LAPIC map, the delivery mode, and the SVR's two fields",
            body: "import \"core.mmio\"\n" +
                  "fn main() -> int {\n" +
                  "    if !lapic_map_valid() { return 1 }\n" +
                  "    if lapic_reg_addr(lapic_reg_id()) != 8 { return 2 }\n" +
                  "    if lapic_reg_addr(lapic_reg_version()) != 12 { return 3 }\n" +
                  "    if lapic_reg_addr(lapic_reg_svr()) != 60 { return 4 }\n" +
                  "    if lapic_decode_delivery(lapic_encode_delivery(0, lapic_delivery_nmi())) != 2 { return 5 }\n" +
                  "    if lapic_svr_vector(lapic_svr_encode(true, 255)) != 255 { return 6 }\n" +
                  "    if !lapic_lvt_is_enabled(lapic_lvt_masked()) { return 7 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
    ]
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

fn decl_word(src: str, kw: str, name: str) -> bool {
    let rr: Result[Regex, str] = regex_compile(kw + "\\s+" + name + "\\b")
    if result_is_err(rr) {
        return false
    }
    let re: Regex = result_unwrap(rr)
    return regex_is_match(re, src)
}

fn import_paths(src: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i).trim()
        if line.starts_with("import ") {
            let rest: str = line.slice(7, line.len()).trim()
            if rest.starts_with("\"") {
                let tail: str = rest.slice(1, rest.len())
                let end: int = tail.find("\"")
                if end > 0 {
                    out.push(tail.slice(0, end))
                }
            }
        }
        i = i + 1
    }
    return out
}

fn strip_no_std(text: str) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: str = ""
    let mut removed: bool = false
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if !removed && line == "#![no_std]" {
            removed = true
            i = i + 1
            continue
        }
        out = out + line + "\n"
        i = i + 1
    }
    return out
}

fn hlc_run(acc: Acc, src: str) -> RunResult uses Fs, Proc {
    let r: RunResult = RunResult {
        code: -1, out: "", err: "", combined: "", spawned: false
    }
    let c_path: str = scratch(acc, stem(src) + ".c")
    let exe: str = scratch(acc, stem(src) + ".bin")
    let comp: RunResult = run_capture(hlc_path(acc), [src, c_path])
    if comp.code != 0 {
        r.combined = comp.combined
        return r
    }
    let cc: RunResult = run_capture("gcc", ["-O2", "-Werror", "-o", exe, c_path, "-lm", "-pthread"])
    if cc.code != 0 {
        r.combined = cc.combined
        return r
    }
    let runr: RunResult = run_capture(exe, [])
    runr.spawned = true
    return runr
}

fn hlc_run_fs(acc: Acc, src: str) -> RunResult uses Fs, Proc {
    let r: RunResult = RunResult {
        code: -1, out: "", err: "", combined: "", spawned: false
    }
    let c_path: str = scratch(acc, stem(src) + ".fs.c")
    let exe: str = scratch(acc, stem(src) + ".fs")
    let comp: RunResult = run_capture(hlc_path(acc), [src, c_path])
    if comp.code != 0 {
        r.combined = comp.combined
        return r
    }
    let cc: RunResult = run_capture("gcc", ["-O2", "-ffreestanding", "-nostdlib",
        "-ffunction-sections", "-fno-stack-protector", "-Wl,--gc-sections", "-o", exe, c_path])
    if cc.code != 0 {
        r.combined = cc.combined
        return r
    }
    let runr: RunResult = run_capture(exe, [])
    runr.spawned = true
    return runr
}

# ----------------------------------------------------------------------------
# 1. the register rule
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    section("1. the register rule")
    let narrow: str = write_src(acc, "narrow.hls", narrow_hls())
    let nc: str = scratch(acc, "narrow.c")
    let r: RunResult = run_capture(hlc_path(acc), [narrow, nc])
    if r.code == 0 {
        pass_msg(acc, "mmio: a 32-bit register is accepted for a 32-bit template")
    } else {
        fail_msg(acc, "mmio: 32-bit register rejected: " + clip(r.combined, 120))
    }
    let text: str = read_or(nc, "")
    if text.contains("movl") {
        pass_msg(acc, "mmio: the template keeps its 32-bit mnemonic")
    } else {
        fail_msg(acc, "mmio: the 32-bit mnemonic is missing")
    }

    # ...and a 64-BIT template with a 32-bit register is STILL rejected:
    # that is Stage 83's truncation bug, and relaxing it was not the point.
    let wide: str = write_src(acc, "wide.hls", wide_hls())
    let rw: RunResult = run_capture(hlc_path(acc), [wide, scratch(acc, "wide.c")])
    if rw.code != 0 && rw.combined.contains("64-bit register") {
        pass_msg(acc, "mmio: a 32-bit register on a 64-bit template is still rejected")
    } else {
        fail_msg(acc, "mmio: a 32-bit register on movq was accepted")
    }

    let tsc: str = write_src(acc, "tsc.hls", tsc_hls())
    let rt: RunResult = run_capture(hlc_path(acc), [tsc, scratch(acc, "tsc.c")])
    if rt.code == 0 {
        pass_msg(acc, "mmio: rdtsc binds rax/rdx (a 64-bit instruction)")
    } else {
        fail_msg(acc, "mmio: rdtsc rejected: " + clip(rt.combined, 120))
    }

    # The 32-bit lowering must use an int32_t register variable, or GCC
    # prints the full register name and `movl %rax` does not assemble.
    let rr: Result[Regex, str] = regex_compile("register int32_t \\w+ __asm__\\(\"eax\"\\)")
    let mut has_regvar: bool = false
    if result_is_ok(rr) {
        let re: Regex = result_unwrap(rr)
        if regex_is_match(re, text) {
            has_regvar = true
        }
    }
    if has_regvar {
        pass_msg(acc, "mmio: the 32-bit operand lowers to an int32_t register variable")
    } else {
        fail_msg(acc, "mmio: no int32_t register variable for the 32-bit operand")
    }
}

# ----------------------------------------------------------------------------
# 2. core/mmio.hls
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO, Fs {
    section("2. core/mmio.hls")
    if !file_exists(core_mmio()) {
        fail_msg(acc, "mmio: core/mmio.hls missing")
        return
    }
    let src: str = read_file(core_mmio())
    let enums: list[str] = ["MmioWidth", "MmioBarrier", "MmioDomain"]
    let mut ei: int = 0
    while ei < enums.len() {
        let e: str = enums.get(ei)
        if decl_word(src, "enum", e) {
            pass_msg(acc, "mmio: core.mmio declares enum " + e)
        } else {
            fail_msg(acc, "mmio: core.mmio missing enum " + e)
        }
        ei = ei + 1
    }
    let structs: list[str] = ["MmioRegion", "MmioField"]
    let mut si: int = 0
    while si < structs.len() {
        let s: str = structs.get(si)
        if decl_word(src, "struct", s) {
            pass_msg(acc, "mmio: core.mmio declares struct " + s)
        } else {
            fail_msg(acc, "mmio: core.mmio missing struct " + s)
        }
        si = si + 1
    }
    let imports: list[str] = import_paths(src)
    if imports.len() == 1 && imports.get(0) == "core.result" {
        pass_msg(acc, "mmio: core.mmio imports only core.result (freestanding-safe)")
    } else {
        fail_msg(acc, "mmio: core.mmio imports " + str_join(imports, ", "))
    }
    let lines: list[str] = src.split("\n")
    let mut has_effects: bool = false
    let mut has_extern: bool = false
    let mut li: int = 0
    while li < lines.len() {
        let line: str = lines.get(li)
        if line.trim().starts_with("#") {
            li = li + 1
            continue
        }
        if line.starts_with("fn ") && line.contains(" uses ") {
            has_effects = true
        }
        if line.trim().starts_with("extern") {
            has_extern = true
        }
        li = li + 1
    }
    if !has_effects && !has_extern {
        pass_msg(acc, "mmio: core.mmio declares no effects and no externs")
    } else {
        fail_msg(acc, "mmio: core.mmio declares effects or externs")
    }
    let fns: list[str] = core_fns()
    let mut fi: int = 0
    while fi < fns.len() {
        let f: str = fns.get(fi)
        if decl_word(src, "fn", f) {
            pass_msg(acc, "mmio: core.mmio exposes " + f)
        } else {
            fail_msg(acc, "mmio: core.mmio missing " + f)
        }
        fi = fi + 1
    }
}

# ----------------------------------------------------------------------------
# 3. the PATTERN
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. the PATTERN")
    let dc: str = scratch(acc, "demo.c")
    let r: RunResult = run_capture(hlc_path(acc), [demo(), dc])
    if r.code != 0 {
        fail_msg(acc, "mmio: the demo did not compile: " + clip(r.combined, 160))
        return
    }
    let text: str = read_or(dc, "")
    if text.contains("__asm__ __volatile__") {
        pass_msg(acc, "mmio: the accesses are __volatile__")
    } else {
        fail_msg(acc, "mmio: the accesses are not volatile")
    }
    if text.contains("\"memory\"") {
        pass_msg(acc, "mmio: the default clobber list carries memory")
    } else {
        fail_msg(acc, "mmio: the memory clobber is missing")
    }
    let wants: list[str] = ["movq", "movl", "mfence"]
    let whys: list[str] = ["the 64-bit load", "the 32-bit load and store", "the fence"]
    let mut i: int = 0
    while i < wants.len() {
        if text.contains(wants.get(i)) {
            pass_msg(acc, "mmio: the demo emits " + whys.get(i))
        } else {
            fail_msg(acc, "mmio: " + whys.get(i) + " is missing")
        }
        i = i + 1
    }
    let exe: str = scratch(acc, "demo")
    let g: RunResult = run_capture("gcc", ["-O2", "-Werror", "-o", exe, dc, "-lm", "-pthread"])
    if g.code != 0 {
        fail_msg(acc, "mmio: the demo did not link -Werror: " + clip(g.combined, 160))
        return
    }
    let p: RunResult = run_capture(exe, [])
    if p.code == 0 && p.out.contains("DEMO OK") {
        pass_msg(acc, "mmio: the demo runs, DEMO OK")
    } else {
        fail_msg(acc, "mmio: the demo exit=" + p.code.to_str() + " " + clip(p.out, 120))
    }
}

# ----------------------------------------------------------------------------
# 4. volatility
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("4. volatility")
    # A compiler that cached the second rdtsc would return a value that does
    # not advance across a million iterations of real work.
    let vol: str = write_src(acc, "vol.hls", vol_hls())
    let hosted: RunResult = hlc_run(acc, vol)
    if hosted.spawned && hosted.code == 0 {
        pass_msg(acc, "mmio: a volatile device read is not folded (hosted)")
    } else {
        fail_msg(acc, "mmio: the hosted volatility probe exit=" + hosted.code.to_str()
            + " (" + clip(hosted.combined, 120) + ")")
    }
    let volfs: str = write_src(acc, "volfs.hls", "#![freestanding]\n" + vol_hls())
    let fs: RunResult = hlc_run_fs(acc, volfs)
    if fs.spawned && fs.code == 0 {
        pass_msg(acc, "mmio: the same read is not folded under -nostdlib")
    } else {
        fail_msg(acc, "mmio: the freestanding volatility probe exit=" + fs.code.to_str()
            + " (" + clip(fs.combined, 120) + ")")
    }

    # A 16-byte-aligned stack list must not fault: GCC reaches for
    # `movaps` to initialise one, and `movaps` faults on an 8-aligned
    # address — which is what a non-naked freestanding entry produced.
    let aligned: str = write_src(acc, "aligned.hls", "#![freestanding]\n" + aligned_hls())
    let al: RunResult = hlc_run_fs(acc, aligned)
    if al.spawned && al.code == 0 {
        pass_msg(acc, "mmio: a stack-allocated list survives -nostdlib (aligned frame slots)")
    } else {
        fail_msg(acc, "mmio: the stack-list probe exit=" + al.code.to_str()
            + " (" + clip(al.combined, 120) + ")")
    }

    # The entry must be naked: an ordinary C entry lets GCC leave the
    # first Halis function 8 bytes off the SysV alignment.
    let entry: str = write_src(acc, "entry.hls", "#![freestanding]\nfn main() -> int { return 0 }\n")
    let ec: str = scratch(acc, "entry.fs.c")
    run_capture(hlc_path(acc), [entry, ec])
    if read_or(ec, "").contains("__attribute__((naked, noreturn)) void _start(void)") {
        pass_msg(acc, "mmio: the freestanding entry is naked (ABI stack alignment holds)")
    } else {
        fail_msg(acc, "mmio: the freestanding entry is not naked")
    }
}

# ----------------------------------------------------------------------------
# 5. the checked constructors
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("5. the checked constructors")
    let ps: list[PanicP] = panic_programs()
    let mut i: int = 0
    while i < ps.len() {
        let p: PanicP = ps.get(i)
        let path: str = "tests/ok/" + p.name + ".hls"
        if !file_exists(path) {
            fail_msg(acc, "mmio: " + path + " missing")
            i = i + 1
            continue
        }
        let chk: RunResult = boot_check(acc, path)
        if chk.code != 0 {
            fail_msg(acc, "mmio: " + p.name + " must be ACCEPTED by the checker")
            i = i + 1
            continue
        }
        let r: RunResult = boot(acc, [path])
        if r.code == 101 && r.combined.contains(p.needle) {
            pass_msg(acc, "mmio: " + p.name + " panics at run time (" + p.desc + ")")
        } else {
            fail_msg(acc, "mmio: " + p.name + " did not panic: exit=" + r.code.to_str())
        }
        let nat: RunResult = hlc_run(acc, path)
        if nat.spawned && nat.code == 101 && nat.combined.contains(p.needle) {
            pass_msg(acc, "mmio: " + p.name + " panics natively too")
        } else {
            fail_msg(acc, "mmio: " + p.name + " native exit=" + nat.code.to_str())
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 6. behaviour probes
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    section("6. behaviour probes")
    let ps: list[Probe] = probes()
    let mut i: int = 0
    while i < ps.len() {
        let p: Probe = ps.get(i)
        let path: str = write_src(acc, "probe_" + p.name + ".hls", p.body)
        let r: RunResult = boot(acc, [path])
        if r.code != p.want {
            fail_msg(acc, "mmio: probe " + p.name + " (interp) exit=" + r.code.to_str()
                + " want=" + p.want.to_str() + " — " + clip(r.combined, 100))
            i = i + 1
            continue
        }
        let code: RunResult = hlc_run(acc, path)
        if !code.spawned || code.code != p.want {
            fail_msg(acc, "mmio: probe " + p.name + " (native) exit=" + code.code.to_str()
                + " want=" + p.want.to_str() + " — " + clip(code.combined, 100))
            i = i + 1
            continue
        }
        let fs_path: str = write_src(acc, "probe_" + p.name + "_fs.hls", "#![freestanding]\n" + p.body)
        let fcode: RunResult = hlc_run_fs(acc, fs_path)
        if !fcode.spawned || fcode.code != p.want {
            fail_msg(acc, "mmio: probe " + p.name + " (-nostdlib) exit=" + fcode.code.to_str()
                + " want=" + p.want.to_str() + " — " + clip(fcode.combined, 100))
            i = i + 1
            continue
        }
        pass_msg(acc, "mmio: " + p.name + " — " + p.desc)
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 7. the demo + tools
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Fs, Proc {
    section("7. the demo + tools")
    let r: RunResult = boot(acc, [ok_test()])
    if r.code == 0 {
        pass_msg(acc, "mmio: the ok-test is clean on the interpreter")
    } else {
        fail_msg(acc, "mmio: ok-test interpreter exit=" + r.code.to_str())
    }
    let code: RunResult = hlc_run(acc, ok_test())
    if code.spawned && code.code == 0 {
        pass_msg(acc, "mmio: the ok-test is clean natively")
    } else {
        fail_msg(acc, "mmio: ok-test native exit=" + code.code.to_str())
    }
    let text: str = strip_no_std(read_file(ok_test()))
    let fs_path: str = write_src(acc, "ok_fs.hls", "#![freestanding]\n" + text)
    let fcode: RunResult = hlc_run_fs(acc, fs_path)
    if fcode.spawned && fcode.code == 0 {
        pass_msg(acc, "mmio: the ok-test links -nostdlib and exits 0 (freestanding)")
    } else {
        fail_msg(acc, "mmio: the freestanding ok-test exit=" + fcode.code.to_str()
            + " (" + clip(fcode.combined, 120) + ")")
    }
    let tools: list[ToolLeg] = [
        ToolLeg { label: "hlfmt -c (ok-test)", argv: ["./bin/hlfmt", "-c", ok_test()] },
        ToolLeg { label: "hlfmt -c (demo)", argv: ["./bin/hlfmt", "-c", demo()] },
        ToolLeg { label: "hlfmt -c (core)", argv: ["./bin/hlfmt", "-c", core_mmio()] },
        ToolLeg { label: "hllint (ok-test)", argv: ["python3", "tools/hllint.py", ok_test()] },
    ]
    let mut i: int = 0
    while i < tools.len() {
        let t: ToolLeg = tools.get(i)
        let rest: list[str] = []
        let mut k: int = 1
        while k < t.argv.len() {
            rest.push(t.argv.get(k))
            k = k + 1
        }
        let tr: RunResult = run_capture(t.argv.get(0), rest)
        if tr.code == 0 {
            pass_msg(acc, "mmio: " + t.label)
        } else {
            fail_msg(acc, "mmio: " + t.label + ": " + clip(tr.combined, 140))
        }
        i = i + 1
    }
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("mmio")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    return finish(acc, "Stage 87 -- core.mmio: volatile device access")
}
