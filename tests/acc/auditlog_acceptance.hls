# ============================================================================
# tests/acc/auditlog_acceptance.hls — Stage 112 acceptance gate, in Halis
# (the Halis twin of tests/auditlog_acceptance.py; same nine sections,
# same command sequences, same needles — the harness is
# tests/acc/harness.hls and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run from the repo root. The gate drives the audit-log CLI
# (`python3 tools/hls-auditlog.py` — list / show / verify / sign /
# verify-sign / selftest) plus hls-pkg, hls-sign and hls-sandbox over a
# scratch log dir (HLS_AUDIT_LOG); every subprocess is the subject.
#
# The old battery's legs that reached into Python library internals
# (hal_ops.record, hal_log.load_log/verify_log/summarize,
# hal_checkpoint.build_checkpoint, entry_shape_error) drive the same
# contracts through the CLI front door here: the flows write the log,
# `list --json` reads it back (the CLI replays the chain before
# listing), and the CLI selftest pins the library-level vectors the
# battery asserted by import.
#
#  1. the primitives — the ONE DEFINITION, the entry shape refusals,
#                       the CLI selftest (RFC 8032 vectors)
#  2. the log          — the append/verify round-trip (real lock
#                       flows: 4 ok + 1 refused), the inventory, the
#                       actor override, strict mode vs fail-open, the
#                       caller tool identity
#  3. the hooks        — a real package through init/add/lock/publish
#                       and real keys through keygen/sign: every op
#                       lands with its subject, detail and tool name
#  4. the refusals     — a release gate that says no, a profile that
#                       refuses, a lock without a manifest: refused
#                       ops sit in the SAME chain, reasons attached
#  5. the launcher     — a real armed run: the entry carries the
#                       command, the exit, the effect surface
#  6. the checkpoint   — sign, verify-sign (held), the rollback, the
#                       rewritten history, the tampered document, the
#                       foreign key; determinism over unchanged bytes
#  7. the ledger       — the transparency ledger stays sound; the
#                       audit log is a DIFFERENT file; the audit tool
#                       refuses to bless a non-audit log
#  8. the demos        — the demo and the ok-test run; interpreter
#                       and native agree byte for byte
#  9. the tools        — hlfmt stable, hllint clean on the new sources
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.json"
import "std.env"

# ----------------------------------------------------------------------------
# The gate's fixed subjects.
# ----------------------------------------------------------------------------

fn auditlog_tool() -> str {
    return "tools/hls-auditlog.py"
}

fn sign_tool() -> str {
    return "tools/hls-sign.py"
}

fn pkg_tool() -> str {
    return "tools/hls-pkg.py"
}

fn sandbox_tool() -> str {
    return "tools/hls-sandbox.py"
}

fn demo() -> str {
    return "examples/auditlog_demo.hls"
}

fn ok_test() -> str {
    return "tests/ok/feat_stage112_auditlog.hls"
}

# log_path(acc) — every flow's audit log (the battery's TMP/audit.log;
# the env override HLS_AUDIT_LOG points every writer here).
fn log_path(acc: Acc) -> str {
    return path_join3(acc.scratch_base, "audit.log")
}

fn lib_log(acc: Acc) -> str {
    return path_join3(acc.scratch_base, "lib.log")
}

fn app_dir(acc: Acc) -> str {
    return path_join3(acc.scratch_base, "hookapp")
}

fn dep_dir(acc: Acc) -> str {
    return path_join3(acc.root, "tests/_gate_s112_dep")
}

fn kkey(acc: Acc) -> str {
    return path_join3(acc.scratch_base, "g.key")
}

fn kpub(acc: Acc) -> str {
    return path_join3(acc.scratch_base, "g.pub")
}

fn repo_audit_log(acc: Acc) -> str {
    return path_join3(acc.root, ".hls-audit.log")
}

fn repo_tlog(acc: Acc) -> str {
    return path_join3(acc.root, ".hls-pkg-transparency.log")
}

# ----------------------------------------------------------------------------
# Small helpers.
# ----------------------------------------------------------------------------

fn expect(acc: Acc, okc: bool, msg: str, detail: str) -> bool uses IO {
    if okc {
        pass_msg(acc, msg)
        return true
    }
    fail_msg(acc, msg)
    if detail != "" {
        println("        · " + clip(detail, 240))
    }
    return false
}

fn pytool(acc: Acc, relpath: str, args: list[str]) -> RunResult uses Proc {
    let argv: list[str] = [path_join3(acc.root, relpath)]
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    return run_capture("python3", argv)
}

fn alcmd(acc: Acc, args: list[str]) -> RunResult uses Proc {
    return pytool(acc, auditlog_tool(), args)
}

fn pkg(acc: Acc, args: list[str]) -> RunResult uses Proc {
    return pytool(acc, pkg_tool(), args)
}

fn sign(acc: Acc, args: list[str]) -> RunResult uses Proc {
    return pytool(acc, sign_tool(), args)
}

fn sandbox(acc: Acc, args: list[str]) -> RunResult uses Proc {
    return pytool(acc, sandbox_tool(), args)
}

fn boot_run(acc: Acc, args: list[str]) -> RunResult uses Proc {
    return pytool(acc, "tools/hlinterp/boot.py", args)
}

# alist_json(acc, args) — run the audit-log CLI with --json appended
# and parse its report (null on any failure; the downstream checks
# fail instead of crashing).
fn alist_json(acc: Acc, args: list[str]) -> JsonValue uses IO, Proc {
    let mut argv: list[str] = []
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    argv.push("--json")
    let r: RunResult = alcmd(acc, argv)
    if r.code != 0 || r.out.trim() == "" {
        return json_null()
    }
    let rr: Result[JsonValue, str] = json_parse_result(r.out)
    if result_is_err(rr) {
        return json_null()
    }
    return result_unwrap(rr)
}

# log_rep(acc, path) — `list <path> --json`: the whole inventory, the
# chain replayed first by the CLI itself.
fn log_rep(acc: Acc, path: str) -> JsonValue uses IO, Proc {
    return alist_json(acc, ["list", path])
}

fn rep_length(rep: JsonValue) -> int {
    return jint_or(json_object_get(rep, "length"), -1)
}

fn rep_entries(rep: JsonValue) -> list[JsonValue] {
    return json_object_get(rep, "entries").arr
}

# count_op(rep, op) — entries with that op name.
fn count_op(rep: JsonValue, op: str) -> int {
    let es: list[JsonValue] = rep_entries(rep)
    let mut n: int = 0
    let mut i: int = 0
    while i < es.len() {
        if jstr_or(json_object_get(es.get(i), "op"), "") == op {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

# first_op(rep, op) — the first entry with that op name (null when
# absent — the batteries' by_op[op][0] with a missing key guarded).
fn first_op(rep: JsonValue, op: str) -> JsonValue {
    let es: list[JsonValue] = rep_entries(rep)
    let mut i: int = 0
    while i < es.len() {
        if jstr_or(json_object_get(es.get(i), "op"), "") == op {
            return es.get(i)
        }
        i = i + 1
    }
    return json_null()
}

# entry_field helpers — jstr/jint with the null-safe defaults.
fn jint_or(v: JsonValue, d: int) -> int {
    if json_is_int(v) {
        return json_int_value(v)
    }
    return d
}

fn jstr_or(v: JsonValue, d: str) -> str {
    if json_is_str(v) {
        return json_str_value(v)
    }
    return d
}

fn eq_strs(a: list[str], b: list[str]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let mut i: int = 0
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn jstrs(v: JsonValue) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    while i < v.arr.len() {
        out.push(json_str_value(v.arr.get(i)))
        i = i + 1
    }
    return out
}

# replace_once(s, old, new) — the battery's bytes.replace(..., 1).
fn replace_once(s: str, old: str, new: str) -> str {
    let at: int = s.find(old)
    if at < 0 {
        return s
    }
    return s.slice(0, at) + new + s.slice(at + old.len(), s.len())
}

# entry_at(es, i) — the i-th entry, or null when out of range (the
# gate fails its check instead of crashing on a broken log).
fn entry_at(es: list[JsonValue], i: int) -> JsonValue {
    if i >= 0 && i < es.len() {
        return es.get(i)
    }
    return json_null()
}

# jparse_report(text) — parse a sign report ("" on failure).
fn jparse_report(text: str) -> JsonValue {
    if text.trim() == "" {
        return json_null()
    }
    let rr: Result[JsonValue, str] = json_parse_result(text)
    if result_is_err(rr) {
        return json_null()
    }
    return result_unwrap(rr)
}

# first_written(rep) — the checkpoint document path (written[0]).
fn first_written(rep: JsonValue) -> str {
    let w: JsonValue = json_object_get(rep, "written")
    if json_is_array(w) && w.arr.len() > 0 {
        return json_str_value(w.arr.get(0))
    }
    return ""
}

# first_lines(text, n) — the first n newline-terminated lines (the
# battery's f.readlines()[:n]).
fn first_lines(text: str, n: int) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: list[str] = []
    let mut i: int = 0
    while i < lines.len() && i < n {
        out.push(lines.get(i))
        i = i + 1
    }
    return str_join(out, "\n") + "\n"
}

# key_id_from_pub(path) — the kid off the minisign public key file
# ("untrusted comment: minisign public key <kid> <comment>").
fn key_id_from_pub(path: str) -> str uses Fs {
    let src: str = read_file(path)
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let l: str = lines.get(i)
        if l.starts_with("untrusted comment: minisign public key ") {
            let tail: str = l.slice(39, l.len())
            let sp: int = tail.find(" ")
            if sp > 0 {
                return tail.slice(0, sp)
            }
            return tail.trim()
        }
        i = i + 1
    }
    return ""
}

# ----------------------------------------------------------------------------
# 1. the primitives (one definition, the shape, the selftest)
# ----------------------------------------------------------------------------

fn sec1(acc: Acc) -> void uses IO, Proc {
    section("1. the primitives (one definition, the shape, the selftest)")
    let st: RunResult = alcmd(acc, ["selftest"])
    let _e1: bool = expect(acc, st.code == 0 && st.out.contains("RFC 8032 vector 1"),
    "the CLI selftest passes (the RFC vectors ride along)",
    "rc=" + st.code.to_str() + " " + clip(st.out, 200))
    # The ONE DEFINITION: the chain arithmetic is hpkg_log's writer —
    # the selftest pins it against a hand-built canonical record.
    let _e2: bool = expect(acc,
    st.out.contains("the chain arithmetic is hpkg_log's writer, "
    + "pinned to a hand-built canonical record"),
    "hls-auditlog's chain hash IS hpkg_log's writer (one definition)",
    clip(st.out, 200))
    # The entry shape: a well-formed entry is accepted, the wrong
    # kind / op / actor / outcome are refused (the selftest's pinned
    # refusal leg drives entry_shape_error for the gate).
    let _e3: bool = expect(acc,
    st.out.contains("the entry shape refuses a wrong kind, op, "
    + "actor, outcome"),
    "the entry shape refuses a wrong kind, op, actor, outcome",
    clip(st.out, 200))
    # The chain round-trip: append + verify; a mutated body caught at
    # its own line; a repaired hash moves the break, never past it.
    let _e4: bool = expect(acc,
    st.out.contains("the round-trip verifies; a mutated entry is "
    + "caught, a repaired hash moves the break, never past it"),
    "the round-trip verifies; a mutated entry is caught at its own line",
    clip(st.out, 200))
    let _e5: bool = expect(acc,
    st.out.contains("the inventory counts every outcome, refused included"),
    "the inventory counts ops, outcomes and actors", clip(st.out, 200))
    let _e6: bool = expect(acc,
    st.out.contains("the checkpoint verdicts: rollback, rewritten, "
    + "held, byte-identical"),
    "the checkpoint verdict vocabulary is pinned", clip(st.out, 200))
    let _e7: bool = expect(acc,
    st.out.contains("the checkpoint signs, verifies, and refuses a "
    + "tampered document or a foreign key"),
    "the checkpoint signature refuses tampering and foreign keys",
    clip(st.out, 200))
}

# ----------------------------------------------------------------------------
# 2. the log (round-trip, inventory, actor, strict mode)
# ----------------------------------------------------------------------------

fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    section("2. the log (round-trip, inventory, actor, strict mode)")
    # The library writes to its own scratch log here — via the real
    # flows (hls-pkg lock) pointed at it by HLS_AUDIT_LOG, four ok
    # locks and one refused one, all with the actor override.
    let libpkg: str = scratch(acc, "libpkg")
    let _w1: str = write_src(acc, "libpkg/hls-pkg.toml",
    "[package]\nname = \"libpkg\"\nversion = \"0.0.4\"\n")
    let _w2: str = write_src(acc, "libpkg/main.hls",
    "fn main() -> int { return 0 }\n")
    env_set_var("HLS_AUDIT_LOG", lib_log(acc))
    let _d1: int = env_set_current_dir(libpkg)
    let mut li: int = 0
    while li < 4 {
        let _r: RunResult = pkg(acc, ["lock"])
        li = li + 1
    }
    let _b1: int = env_set_current_dir(acc.root)
    # The refused lock: no manifest where the command runs (the
    # battery's cwd=TMP probe — probing shows up as probing).
    let _d2: int = env_set_current_dir(acc.scratch_base)
    let lr: RunResult = pkg(acc, ["lock"])
    let _b2: int = env_set_current_dir(acc.root)
    let _lr: bool = expect(acc, lr.code == 1,
    "the probing lock exits 1 (the refusal feeds the log)",
    "rc=" + lr.code.to_str())
    let llog: str = lib_log(acc)
    let rep: JsonValue = log_rep(acc, llog)
    let es: list[JsonValue] = rep_entries(rep)
    let mut refused_n: int = 0
    let mut ei: int = 0
    while ei < es.len() {
        if jstr_or(json_object_get(es.get(ei), "outcome"), "") == "refused" {
            refused_n = refused_n + 1
        }
        ei = ei + 1
    }
    let head_ok: bool = rep_length(rep) == 5 && es.len() == 5 && refused_n == 1
    && jstr_or(json_object_get(rep, "head"), "")
    == jstr_or(json_object_get(entry_at(es, 4), "chain_hash"), "")
    let _e1: bool = expect(acc, head_ok,
    "the library round-trips ok and refused entries alike",
    "length=" + rep_length(rep).to_str() + " refused=" + refused_n.to_str())
    # The replay is sound from genesis to head.
    let vr: RunResult = alcmd(acc, ["verify", llog])
    let _e2: bool = expect(acc, vr.code == 0 && vr.out.contains("sound"),
    "the replay is sound from genesis to head",
    "rc=" + vr.code.to_str() + " " + clip(vr.combined, 200))
    # The inventory counts ops, outcomes and actors.
    let outcomes: JsonValue = json_object_get(rep, "outcomes")
    let ops: JsonValue = json_object_get(rep, "ops")
    let actors: JsonValue = json_object_get(rep, "actors")
    let inv_ok: bool = json_is_object(outcomes) && json_is_object(ops)
    && json_is_object(actors)
    && outcomes.obj_keys.len() == 2
    && jint_or(json_object_get(outcomes, "ok"), -1) == 4
    && jint_or(json_object_get(outcomes, "refused"), -1) == 1
    && ops.obj_keys.len() == 1
    && jint_or(json_object_get(ops, "pkg.lock"), -1) == 5
    && actors.obj_keys.len() == 1
    && jint_or(json_object_get(actors, "gate_s112@test"), -1) == 5
    let _e3: bool = expect(acc, inv_ok,
    "the inventory counts ops, outcomes and actors",
    clip(json_stringify(outcomes), 120) + " / "
    + clip(json_stringify(ops), 120))
    # The inventory is deterministic over the same bytes.
    let rep2: JsonValue = log_rep(acc, llog)
    let det_ok: bool = json_stringify(json_object_get(rep, "ops"))
    == json_stringify(json_object_get(rep2, "ops"))
    && json_stringify(json_object_get(rep, "outcomes"))
    == json_stringify(json_object_get(rep2, "outcomes"))
    && json_stringify(json_object_get(rep, "actors"))
    == json_stringify(json_object_get(rep2, "actors"))
    let _e4: bool = expect(acc, det_ok,
    "the inventory is deterministic over the same bytes", "")
    # strict mode: an unwritable audit log refuses; fail-open warns.
    # (NOT scratch() — that helper mkdirs the parents; the point is a
    # directory that does not exist.)
    let bad_log: str = path_join3(acc.scratch_base, "no/such/dir/audit.log")
    env_set_var("HLS_AUDIT_STRICT", "1")
    env_set_var("HLS_AUDIT_LOG", bad_log)
    let _d3: int = env_set_current_dir(libpkg)
    let ls: RunResult = pkg(acc, ["lock"])
    let _b3: int = env_set_current_dir(acc.root)
    env_set_var("HLS_AUDIT_LOG", lib_log(acc))
    env_unset_var("HLS_AUDIT_STRICT")
    let _e5: bool = expect(acc, ls.code != 0,
    "strict mode turns an unwritable log into a refusal",
    "rc=" + ls.code.to_str() + " " + clip(ls.combined, 200))
    env_set_var("HLS_AUDIT_LOG", bad_log)
    let _d4: int = env_set_current_dir(libpkg)
    let lf: RunResult = pkg(acc, ["lock"])
    let _b4: int = env_set_current_dir(acc.root)
    env_set_var("HLS_AUDIT_LOG", lib_log(acc))
    let _e6: bool = expect(acc, lf.code == 0,
    "fail-open (the default) warns and keeps the toolchain usable",
    "rc=" + lf.code.to_str() + " " + clip(lf.combined, 200))
    env_set_var("HLS_AUDIT_LOG", log_path(acc))
    # The CLI reads the same log the library wrote.
    let _e7: bool = expect(acc, rep_length(rep2) == 5
    && jint_or(json_object_get(rep2, "shown"), -1) == 5,
    "the CLI reads the same log the library wrote",
    "length=" + rep_length(rep2).to_str())
    # The actor override reaches every entry.
    let mut all_actor: bool = es.len() > 0
    let mut ai: int = 0
    while ai < es.len() {
        if jstr_or(json_object_get(es.get(ai), "actor"), "")
        != "gate_s112@test" {
            all_actor = false
        }
        ai = ai + 1
    }
    let _e8: bool = expect(acc, all_actor,
    "the actor override reaches every entry", "")
    # the caller-tool identity comes off the stack — every entry the
    # flows wrote names the tool script that ran the op.
    let _e9: bool = expect(acc, es.len() > 0
    && jstr_or(json_object_get(entry_at(es, 0), "tool"), "") == "hls-pkg",
    "the tool identity resolves to a tool script (hls-pkg)",
    jstr_or(json_object_get(entry_at(es, 0), "tool"), "<none>"))
}

# ----------------------------------------------------------------------------
# 3. the hooks (a real package, real keys)
# ----------------------------------------------------------------------------

fn hookapp_manifest() -> str {
    return "[package]\nname = \"hookapp\"\nversion = \"2.3.4\"\n\n"
    + "[dependencies]\n"
    + "audit_dep = { path = \"tests/_gate_s112_dep/main.hls\" }\n\n"
    + "[effects]\nallowed = [\"IO\", \"Fs\"]\n"
}

fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. the hooks (a real package, real keys)")
    let app: str = app_dir(acc)
    let _d0: int = env_set_current_dir(acc.scratch_base)
    let _init: RunResult = pkg(acc, ["init", "hookapp"])
    let _b0: int = env_set_current_dir(acc.root)
    let _e0: bool = expect(acc,
    sh("test -d '" + shell_quote(app) + "'") == 0,
    "hls-pkg init creates the fixture", "")
    let dep: str = dep_dir(acc)
    let _md: int = mkdirs(dep)
    write_file(path_join3(dep, "hls-pkg.toml"),
    "[package]\nname = \"audit_dep\"\nversion = \"0.1.0\"\n")
    write_file(path_join3(dep, "main.hls"),
    "fn hi() -> int uses IO {\n    println(\"hi\")\n    return 0\n}\n")
    write_file(path_join3(app, "hls-pkg.toml"), hookapp_manifest())
    write_file(path_join3(app, "main.hls"),
    "fn main() -> int uses IO {\n    println(\"x\")\n    return 0\n}\n")
    let _d1: int = env_set_current_dir(app)
    let pa: RunResult = pkg(acc, ["add", "second_dep",
    "https://example.invalid/x.git", "std/x.hls"])
    let _e1: bool = expect(acc, pa.code == 0, "hls-pkg add edits the manifest",
    "rc=" + pa.code.to_str() + " " + clip(pa.combined, 160))
    # The add edit is real but the git dep is unresolvable by design —
    # restore the manifest so lock works; the ADD ENTRY stays recorded.
    write_file(path_join3(app, "hls-pkg.toml"), hookapp_manifest())
    let pl: RunResult = pkg(acc, ["lock"])
    let _e2: bool = expect(acc, pl.code == 0, "hls-pkg lock pins the fixture",
    "rc=" + pl.code.to_str() + " " + clip(pl.combined, 160))
    let pp: RunResult = pkg(acc, ["publish"])
    let _b1: int = env_set_current_dir(acc.root)
    let _e3: bool = expect(acc, pp.code == 0,
    "hls-pkg publish chains the claim",
    "rc=" + pp.code.to_str() + " " + clip(pp.combined, 160))
    let llog: str = log_path(acc)
    let rep: JsonValue = log_rep(acc, llog)
    let e_init: JsonValue = first_op(rep, "pkg.init")
    let _e4: bool = expect(acc, count_op(rep, "pkg.init") == 1
    && jstr_or(json_object_get(e_init, "subject"), "") == "hookapp",
    "pkg.init is recorded with the package name", "")
    let e_add: JsonValue = first_op(rep, "pkg.add")
    let _e5: bool = expect(acc, count_op(rep, "pkg.add") == 1
    && jstr_or(json_object_get(e_add, "subject"), "") == "second_dep"
    && json_stringify(json_object_get(e_add, "detail"))
    .contains("example.invalid"),
    "pkg.add is recorded with the dep and its source", "")
    let e_lock: JsonValue = first_op(rep, "pkg.lock")
    let _e6: bool = expect(acc, count_op(rep, "pkg.lock") == 1
    && jstr_or(json_object_get(e_lock, "subject"), "") == "hookapp@2.3.4"
    && jint_or(json_object_get(
    json_object_get(e_lock, "detail"), "packages"), -1) == 1,
    "pkg.lock is recorded with the package and its dep count", "")
    let e_pub: JsonValue = first_op(rep, "pkg.publish")
    let _e7: bool = expect(acc, count_op(rep, "pkg.publish") == 1
    && jint_or(json_object_get(
    json_object_get(e_pub, "detail"), "ledger_seq"), 0) > 0,
    "pkg.publish is recorded with the ledger seq it produced", "")
    let es: list[JsonValue] = rep_entries(rep)
    let mut all_tool: bool = es.len() > 0
    let mut ti: int = 0
    while ti < es.len() {
        if jstr_or(json_object_get(es.get(ti), "tool"), "") != "hls-pkg" {
            all_tool = false
        }
        ti = ti + 1
    }
    let _e8: bool = expect(acc, all_tool, "every pkg entry names its tool", "")
    let _k1: str = kkey(acc)
    let _k2: str = kpub(acc)
    let kg: RunResult = sign(acc, ["keygen", "-f", _k1, "-p", _k2, "-c", "gate"])
    let _e9: bool = expect(acc, kg.code == 0,
    "hls-sign keygen mints the fixture key",
    "rc=" + kg.code.to_str() + " " + clip(kg.combined, 160))
    let kid: str = key_id_from_pub(_k2)
    let _e10: bool = expect(acc, kid != "",
    "the fixture key id parses from the pub file", clip(kid, 60))
    let sg: RunResult = sign(acc, ["sign", path_join3(app, "main.hls"),
    "-s", _k1])
    let _e11: bool = expect(acc, sg.code == 0,
    "hls-sign sign signs the entry source",
    "rc=" + sg.code.to_str() + " " + clip(sg.combined, 160))
    let rep2: JsonValue = log_rep(acc, llog)
    let e_kg: JsonValue = first_op(rep2, "sign.keygen")
    let e_sg: JsonValue = first_op(rep2, "sign.sign")
    let _e12: bool = expect(acc, count_op(rep2, "sign.keygen") == 1
    && jstr_or(json_object_get(e_kg, "subject"), "") == kid,
    "sign.keygen is recorded with the key id (never the secret)",
    jstr_or(json_object_get(e_kg, "subject"), "<none>"))
    let _e13: bool = expect(acc, count_op(rep2, "sign.sign") == 1
    && jstr_or(json_object_get(e_sg, "subject"), "").ends_with("main.hls"),
    "sign.sign is recorded with the payload it signed",
    jstr_or(json_object_get(e_sg, "subject"), "<none>"))
    let lf: JsonValue = alist_json(acc, ["list", llog, "--op", "pkg.lock"])
    let _e14: bool = expect(acc, jint_or(json_object_get(lf, "shown"), -1) == 1,
    "list --op filters the inventory",
    "shown=" + jint_or(json_object_get(lf, "shown"), -1).to_str())
    let seq: int = jint_or(json_object_get(e_sg, "seq"), -1)
    let sh_rep: JsonValue = alist_json(acc, ["show", seq.to_str(), llog])
    let _e15: bool = expect(acc, sh_rep.obj_keys.len() > 0
    && json_object_has(json_object_get(sh_rep, "entry"), "detail")
    && json_object_has(json_object_get(
    json_object_get(sh_rep, "entry"), "detail"), "key_id"),
    "show exposes the full detail of one entry", "")
}

# ----------------------------------------------------------------------------
# 4. the refusals (a refused op is still an op)
# ----------------------------------------------------------------------------

fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("4. the refusals (a refused op is still an op)")
    let app: str = app_dir(acc)
    let llog: str = log_path(acc)
    let _k1: str = kkey(acc)
    let before: int = rep_length(log_rep(acc, llog))
    rmrf(path_join3(app, "hls-pkg.lock"))
    let rel: RunResult = sign(acc, ["release", app, "--key", _k1])
    let _e1: bool = expect(acc, rel.code == 1 && rel.err.contains("lockfile"),
    "the release gate refuses without a lockfile",
    "rc=" + rel.code.to_str() + " " + clip(rel.err, 160))
    let rep: JsonValue = log_rep(acc, llog)
    let es: list[JsonValue] = rep_entries(rep)
    let r1: JsonValue = entry_at(es, before)
    let _e2: bool = expect(acc, es.len() == before + 1
    && jstr_or(json_object_get(r1, "op"), "") == "sign.release"
    && jstr_or(json_object_get(r1, "outcome"), "") == "refused"
    && jstr_or(json_object_get(
    json_object_get(r1, "detail"), "reason"), "").contains("lockfile"),
    "the refusal is chained with the gate's reason",
    clip(json_stringify(r1), 200))
    let before2: int = rep_length(rep)
    let sb: RunResult = sandbox(acc, ["run", "--effects", "NotAnEffect",
    "--", "/bin/echo", "x"])
    let _e3: bool = expect(acc, sb.code == 1 && sb.err.contains("unknown effect"),
    "an unknown effect refuses the launcher",
    "rc=" + sb.code.to_str() + " " + clip(sb.err, 160))
    let rep2: JsonValue = log_rep(acc, llog)
    let es2: list[JsonValue] = rep_entries(rep2)
    let r2: JsonValue = entry_at(es2, before2)
    let _e4: bool = expect(acc, es2.len() == before2 + 1
    && jstr_or(json_object_get(r2, "op"), "") == "sandbox.run"
    && jstr_or(json_object_get(r2, "outcome"), "") == "refused"
    && jstr_or(json_object_get(
    json_object_get(r2, "detail"), "reason"), "").contains("NotAnEffect"),
    "the launcher's refusal is chained with its reason",
    clip(json_stringify(r2), 200))
    let before3: int = rep_length(rep2)
    let _d1: int = env_set_current_dir(acc.scratch_base)
    let pl: RunResult = pkg(acc, ["lock"]) # no manifest here
    let _b1: int = env_set_current_dir(acc.root)
    let _e5: bool = expect(acc, pl.code == 1,
    "hls-pkg lock without a manifest exits 1",
    "rc=" + pl.code.to_str())
    let rep3: JsonValue = log_rep(acc, llog)
    let es3: list[JsonValue] = rep_entries(rep3)
    let r3: JsonValue = entry_at(es3, before3)
    let _e6: bool = expect(acc, es3.len() == before3 + 1
    && jstr_or(json_object_get(r3, "op"), "") == "pkg.lock"
    && jstr_or(json_object_get(r3, "outcome"), "") == "refused",
    "a failed lock is recorded too (probing shows up as probing)",
    clip(json_stringify(r3), 200))
    let lr: JsonValue = alist_json(acc, ["list", llog, "--outcome", "refused"])
    let _e7: bool = expect(acc, jint_or(json_object_get(lr, "shown"), -1) == 3,
    "list --outcome refused shows exactly the refusals",
    "shown=" + jint_or(json_object_get(lr, "shown"), -1).to_str())
}

# ----------------------------------------------------------------------------
# 5. the launcher (the enforcement entry)
# ----------------------------------------------------------------------------

fn sec5(acc: Acc) -> void uses IO, Proc {
    section("5. the launcher (the enforcement entry)")
    let llog: str = log_path(acc)
    let before: int = rep_length(log_rep(acc, llog))
    let sb: RunResult = sandbox(acc, ["run", "--effects", "IO", "--",
    "/bin/echo", "sandboxed-hello"])
    let _e1: bool = expect(acc, sb.code == 0,
    "the launcher runs a real command armed",
    "rc=" + sb.code.to_str() + " " + clip(sb.combined, 160))
    let rep: JsonValue = log_rep(acc, llog)
    let es: list[JsonValue] = rep_entries(rep)
    let entry: JsonValue = entry_at(es, before)
    let _e2: bool = expect(acc,
    jstr_or(json_object_get(entry, "op"), "") == "sandbox.run"
    && jstr_or(json_object_get(entry, "outcome"), "") == "ok"
    && jstr_or(json_object_get(entry, "subject"), "") == "/bin/echo"
    && jint_or(json_object_get(
    json_object_get(entry, "detail"), "exit"), -1) == 0
    && eq_strs(jstrs(json_object_get(
    json_object_get(entry, "detail"), "effects")), ["IO"]),
    "the entry carries the command, exit and effect surface",
    clip(json_stringify(entry), 240))
}

# ----------------------------------------------------------------------------
# 6. the checkpoint (sign, verify, rollback, rewrite)
# ----------------------------------------------------------------------------

fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    section("6. the checkpoint (sign, verify, rollback, rewrite)")
    let llog: str = log_path(acc)
    let _k1: str = kkey(acc)
    let _k2: str = kpub(acc)
    let app: str = app_dir(acc)
    let head_rep: JsonValue = log_rep(acc, llog)
    let head_before: int = rep_length(head_rep)
    let es0: list[JsonValue] = rep_entries(head_rep)
    let head_hash: str = jstr_or(json_object_get(
    entry_at(es0, head_before - 1), "chain_hash"), "")
    if head_before < 1 {
        fail_msg(acc, "the log to checkpoint holds no entries")
        return
    }
    let out_dir: str = path_join3(acc.scratch_base, "ckpt")
    let _mc: int = mkdirs(out_dir)
    let sg: RunResult = alcmd(acc, ["sign", llog, "-s", _k1, "--out", out_dir,
    "--json"])
    let _sg: bool = expect(acc, sg.code == 0, "auditlog sign runs",
    "rc=" + sg.code.to_str() + " " + clip(sg.combined, 200))
    let rep: JsonValue = jparse_report(sg.out)
    let ckpt: JsonValue = json_object_get(rep, "checkpoint")
    let doc_path: str = first_written(rep)
    if doc_path == "" || !file_exists(doc_path) {
        fail_msg(acc, "the checkpoint document was not written")
        return
    }
    let _e1: bool = expect(acc, rep.obj_keys.len() > 0
    && jint_or(json_object_get(ckpt, "length"), -1) == head_before,
    "auditlog sign pins the log's length",
    "length=" + jint_or(json_object_get(ckpt, "length"), -1).to_str()
    + " want=" + head_before.to_str())
    let _e2: bool = expect(acc,
    jstr_or(json_object_get(ckpt, "head"), "") == head_hash,
    "the pinned head is the chain hash the log carried", "")
    let _e3: bool = expect(acc,
    jint_or(json_object_get(rep, "record_seq"), -1) == head_before + 1,
    "the checkpoint op is recorded at length+1 (the log describes "
    + "its own checkpointing)",
    "seq=" + jint_or(json_object_get(rep, "record_seq"), -1).to_str())
    let _e4: bool = expect(acc, doc_path != "" && file_exists(doc_path)
    && file_exists(doc_path + ".minisig"),
    "the checkpoint pair is written (doc + minisig)", doc_path)
    # determinism: the SAME log state produces the SAME checkpoint
    # bytes — two signs over two copies of the same log, same key.
    let c1: str = scratch(acc, "det_copy1.log")
    let c2: str = scratch(acc, "det_copy2.log")
    cp(llog, c1)
    cp(llog, c2)
    let d1: str = path_join3(acc.scratch_base, "det_out1")
    let d2: str = path_join3(acc.scratch_base, "det_out2")
    let _md1: int = mkdirs(d1)
    let _md2: int = mkdirs(d2)
    let s1: RunResult = alcmd(acc, ["sign", c1, "-s", _k1, "--out", d1,
    "--json"])
    let s2: RunResult = alcmd(acc, ["sign", c2, "-s", _k1, "--out", d2,
    "--json"])
    let doc1: str = first_written(jparse_report(s1.out))
    let doc2: str = first_written(jparse_report(s2.out))
    let _e5: bool = expect(acc, s1.code == 0 && s2.code == 0 && doc1 != ""
    && doc2 != "" && read_file(doc1) == read_file(doc2),
    "a checkpoint is deterministic over an unchanged log",
    clip(read_or(doc1, "<no doc1>"), 120))
    let vs: RunResult = alcmd(acc, ["verify-sign", doc_path, "-p", _k2,
    "--against", llog])
    let _e6: bool = expect(acc, vs.code == 0 && vs.out.contains("held"),
    "verify-sign: the checkpointed history is a prefix (the log "
    + "grew by its own checkpoint record)",
    "rc=" + vs.code.to_str() + " " + clip(vs.out, 160))
    # grow: the checkpoint holds over a longer log
    let before: int = rep_length(log_rep(acc, llog))
    let _g: RunResult = sign(acc, ["sign", path_join3(app, "main.hls"),
    "-s", _k1, "--sig-out", path_join3(acc.scratch_base,
    "another.minisig")])
    let _e7: bool = expect(acc, rep_length(log_rep(acc, llog)) == before + 1,
    "the log grew by one op", "")
    let vs2: RunResult = alcmd(acc, ["verify-sign", doc_path, "-p", _k2,
    "--against", llog])
    let _e8: bool = expect(acc, vs2.code == 0 && vs2.out.contains("held"),
    "verify-sign: held over a grown log",
    "rc=" + vs2.code.to_str() + " " + clip(vs2.out, 160))
    # rollback: entries below the signed length are gone
    let ck_len: int = jint_or(json_object_get(ckpt, "length"), 0)
    let rolled: str = scratch(acc, "rolled.log")
    write_file(rolled, first_lines(read_file(llog), ck_len - 1))
    let vr: RunResult = alcmd(acc, ["verify-sign", doc_path, "-p", _k2,
    "--against", rolled])
    let _e9: bool = expect(acc, vr.code == 1 && vr.out.contains("rollback"),
    "a log shrunk under a signed promise is ROLLBACK evidence",
    "rc=" + vr.code.to_str() + " " + clip(vr.out, 160))
    # rewritten: a mutated entry breaks the chain before any verdict
    let rw: str = scratch(acc, "rw.log")
    let lines: list[str] = read_file(llog).split("\n")
    let mut rw_src: str = replace_once(lines.get(0), "hookapp", "hookevil")
    let mut li: int = 1
    while li < lines.len() {
        rw_src = rw_src + "\n" + lines.get(li)
        li = li + 1
    }
    write_file(rw, rw_src)
    let vw: RunResult = alcmd(acc, ["verify-sign", doc_path, "-p", _k2,
    "--against", rw])
    let _e10: bool = expect(acc, vw.code == 1
    && vw.err.contains("chain_hash does not match"),
    "a rewritten entry refuses the checkpoint outright",
    "rc=" + vw.code.to_str() + " " + clip(vw.err, 200))
    let vfy: RunResult = alcmd(acc, ["verify", rw])
    let _e11: bool = expect(acc, vfy.code == 1,
    "verify names the break on the rewritten log",
    "rc=" + vfy.code.to_str() + " " + clip(vfy.out, 160))
    # a tampered checkpoint document refuses
    let doc_raw: str = read_file(doc_path)
    let bad_doc: str = scratch(acc, "bad.ckpt.json")
    write_file(bad_doc, replace_once(doc_raw,
    "\"length\": " + ck_len.to_str(), "\"length\": 9999"))
    cp(doc_path + ".minisig", bad_doc + ".minisig")
    let vt: RunResult = alcmd(acc, ["verify-sign", bad_doc, "-p", _k2,
    "--against", llog])
    let _e12: bool = expect(acc, vt.code == 1 && vt.err.contains("does not verify"),
    "a tampered checkpoint document refuses",
    "rc=" + vt.code.to_str() + " " + clip(vt.err, 200))
    # a foreign key refuses
    let fk: str = scratch(acc, "f.key")
    let fp: str = scratch(acc, "f.pub")
    let _f: RunResult = sign(acc, ["keygen", "-f", fk, "-p", fp, "-c", "foreign"])
    let vf: RunResult = alcmd(acc, ["verify-sign", doc_path, "-p", fp,
    "--against", llog])
    let _e13: bool = expect(acc, vf.code == 1 && vf.err.contains("does not verify"),
    "a checkpoint verifies only against its own key",
    "rc=" + vf.code.to_str() + " " + clip(vf.err, 200))
}

# ----------------------------------------------------------------------------
# 7. the ledger (two files, both sound)
# ----------------------------------------------------------------------------

fn sec7(acc: Acc) -> void uses IO, Proc {
    section("7. the ledger (two files, both sound)")
    let lv: RunResult = pkg(acc, ["log", "--verify"])
    let _e1: bool = expect(acc, lv.code == 0,
    "hls-pkg log --verify: the transparency ledger stays sound",
    "rc=" + lv.code.to_str() + " " + clip(lv.combined, 200))
    let tlog: str = repo_tlog(acc)
    let alog: str = repo_audit_log(acc)
    if file_exists(tlog) {
        let _e2: bool = expect(acc, alog != tlog,
        "the audit log and the transparency ledger are two files", "")
    }
    # the audit tool refuses to bless a log that is not an audit log
    let nr: RunResult = alcmd(acc, ["verify", tlog])
    let _e3: bool = expect(acc, nr.code == 1,
    "the audit tool refuses a log whose entries are not audit entries",
    "rc=" + nr.code.to_str() + " " + clip(nr.combined, 160))
    # the repo's own audit log (if any) replays soundly
    if file_exists(alog) {
        let ra: RunResult = alcmd(acc, ["verify", alog])
        let _e4: bool = expect(acc, ra.code == 0,
        "the repo's own audit log replays soundly",
        "rc=" + ra.code.to_str() + " " + clip(ra.combined, 160))
    } else {
        println("  [SKIP] no repo audit log yet — the repo-log check is "
        + "skipped (the gate stays hermetic)")
    }
}

# ----------------------------------------------------------------------------
# 8. the demos
# ----------------------------------------------------------------------------

fn sec8(acc: Acc) -> void uses IO, Fs, Proc {
    section("8. the demos")
    let p1: RunResult = boot_run(acc, [demo()])
    let _e1: bool = expect(acc, p1.code == 0
    && p1.out.contains("hashed, chained, signed"),
    "the demo runs (interpreter)", "rc=" + p1.code.to_str())
    let p2: RunResult = boot_run(acc, [ok_test()])
    let _e2: bool = expect(acc, p2.code == 0 && p2.out.contains("checks passed"),
    "the ok-test runs (interpreter)", "rc=" + p2.code.to_str())
    let hlc: str = path_join3(acc.root, "bin/hlc")
    if file_exists(hlc) {
        let n1c: str = scratch(acc, "demo_native.c")
        let n2c: str = scratch(acc, "ok_native.c")
        let b1: str = scratch(acc, "demo_native")
        let b2: str = scratch(acc, "ok_native")
        let r1: RunResult = run_capture(hlc, [demo(), n1c])
        let g1: RunResult = run_capture("cc", ["-O2", "-o", b1, n1c,
        "-lm", "-pthread"])
        let r2: RunResult = run_capture(hlc, [ok_test(), n2c])
        let g2: RunResult = run_capture("cc", ["-O2", "-o", b2, n2c,
        "-lm", "-pthread"])
        let built: bool = r1.code == 0 && g1.code == 0 && r2.code == 0
        && g2.code == 0
        let _e3: bool = expect(acc, built,
        "native compilation of the demos",
        clip(r1.combined, 120) + clip(g1.combined, 120)
        + clip(r2.combined, 120) + clip(g2.combined, 120))
        if built {
            let q1: RunResult = run_capture(b1, [])
            let _e4: bool = expect(acc, q1.code == 0 && q1.out == p1.out,
            "the demo agrees byte for byte with the native binary",
            "rc=" + q1.code.to_str())
            let q2: RunResult = run_capture(b2, [])
            let _e5: bool = expect(acc, q2.code == 0 && q2.out == p2.out,
            "the ok-test agrees byte for byte with the native binary",
            "rc=" + q2.code.to_str())
        }
    } else {
        println("  [SKIP] bin/hlc not built — the native half of section 8 "
        + "is skipped (the gate stays hermetic)")
    }
}

# ----------------------------------------------------------------------------
# 9. the tools
# ----------------------------------------------------------------------------

fn sec9(acc: Acc) -> void uses IO, Fs, Proc {
    section("9. the tools")
    let files: list[str] = [demo(), ok_test()]
    let mut i: int = 0
    while i < files.len() {
        let original: str = read_file(files.get(i))
        let p1f: str = scratch(acc, "fmt1.hls")
        let p2f: str = scratch(acc, "fmt2.hls")
        write_file(p1f, original)
        write_file(p2f, original)
        let _r1: RunResult = run_capture("./bin/hlfmt", ["-w", p1f])
        cp(p1f, p2f)
        let _r2: RunResult = run_capture("./bin/hlfmt", ["-w", p2f])
        let once: str = read_file(p1f)
        let twice: str = read_file(p2f)
        let _e: bool = expect(acc, once == twice,
        "hlfmt: stable formatting on " + files.get(i), "")
        i = i + 1
    }
    let l1: RunResult = pytool(acc, "tools/hllint.py", [demo()])
    let l2: RunResult = pytool(acc, "tools/hllint.py", [ok_test()])
    let _lint: bool = expect(acc, l1.code == 0 && l2.code == 0,
    "hllint: no findings on the demo or the ok-test",
    clip(l1.combined, 160) + clip(l2.combined, 160))
}

# ----------------------------------------------------------------------------
# Gate hygiene — the package flows appended to the repo's TRANSPARENCY
# ledger (its path is fixed by convention); remove it when the gate
# created it, so a fresh checkout stays fresh (the battery's cleanup).
# ----------------------------------------------------------------------------

fn hygiene(acc: Acc, had_tlog: bool) -> void uses Proc {
    rmrf(dep_dir(acc))
    if !had_tlog {
        rmrf(repo_tlog(acc))
        rmrf(repo_tlog(acc) + ".lock")
    }
    rmrf(acc.scratch_base)
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("auditlog")
    # BASE_ENV: the scratch log, the pinned actor, an empty signing
    # passphrase, no strict mode (the battery's env contract).
    env_set_var("HLS_AUDIT_LOG", log_path(acc))
    env_set_var("HLS_AUDIT_ACTOR", "gate_s112@test")
    env_set_var("HLS_SIGN_PASSWORD", "")
    env_unset_var("HLS_AUDIT_STRICT")
    let had_tlog: bool = file_exists(repo_tlog(acc))
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    sec8(acc)
    sec9(acc)
    hygiene(acc, had_tlog)
    return finish(acc,
    "Stage 112 -- hls-auditlog, the audit-log signing")
}
