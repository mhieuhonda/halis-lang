# ============================================================================
# tests/acc/rt_acceptance.hls — Stage 126 acceptance gate, in Halis
# (the Halis twin of tests/rt_acceptance.py; same eight sections, same
# assertions, same needles — the harness is tests/acc/harness.hls and
# the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make rt-acceptance` (which compiles this file and runs it
# from the repo root).
#
# The battery reached into tools/hls-rt.py with importlib for the
# instrument's ledger parser and the statistics numerics; the gate asks
# the same questions through a small python3 driver it writes into its
# scratch world (the module stays the subject; the comparisons run here).
# The per-run env dict (HLRT_REPORT=1) becomes a shell env prefix on the
# one-liners that need it — the children inherit exactly what the
# battery passed, nothing more.
#
#  1. the convention  — plan flags, optional axes, at least one axis
#     & the refusals    required; usage failures exit 2
#  2. the instrument  — the wrap driven from a C harness: snapshot/roll
#     & its ledger      semantics, realloc delta, live bytes, tail
#                       window, fenced report; the verifier's
#                       re-derivation rule and its refusals
#  3. the runtime     — weak hook fallback definitions, the arm call,
#     wiring            the marker scan, the budget env; --no-libc and
#                       freestanding emissions carry none of the mode;
#                       an uninstrumented binary ignores its markers
#  4. the steady      — RT BOUNDED; the ledger is a constant line;
#     certification     --json carries config/ledger/stats; extra argv
#                       drives the workload's plan
#  5. the enforcement — the three canaries die in-process on their own
#     matrix            axis; --warmup 1 rescues the fat first cycle;
#                       --no-enforce judges from the ledger alone
#  6. the honesty     — marker-free and late-work are INCONCLUSIVE;
#     gates             malformed / non-advancing / look-alike markers
#                       are loud protocol errors
#  7. the report      — the layout and the numbers (integer median,
#     & the numbers     interpolated p95, jitter, human formats);
#                       --json agrees with the text
#  8. the differential— the model fixture is byte-identical interpreter
#     & the corpus      vs native; the enforce-over fixture dies 101
#     hygiene           with the canonical message on both; hlfmt /
#                       hllint / checker hygiene; no gate litter
#
# The battery's timeout=600 wrappers have no Halis equivalent (no
# per-child alarm); every child here is the verifier, a compiler, cc,
# boot.py or the gate's own probes.
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.json"
import "std.regex"
import "std.result"
import "std.option"

# ----------------------------------------------------------------------------
# The gate's fixtures.
# ----------------------------------------------------------------------------

fn fixture_path() -> str {
    return "tests/ok/feat_stage126_rt.hls"
}

fn panic_fixture_path() -> str {
    return "tests/ok/panic_stage126_rt.hls"
}

fn steady_path() -> str {
    return "tests/rt_libs/steady_rt.hls"
}

fn over_allocs_path() -> str {
    return "tests/rt_libs/over_allocs_rt.hls"
}

fn over_bytes_path() -> str {
    return "tests/rt_libs/over_bytes_rt.hls"
}

fn deadline_path() -> str {
    return "tests/rt_libs/deadline_rt.hls"
}

fn warmup_path() -> str {
    return "tests/rt_libs/warmup_rt.hls"
}

fn no_cycles_path() -> str {
    return "tests/rt_libs/no_cycles_rt.hls"
}

fn late_work_path() -> str {
    return "tests/rt_libs/late_work_rt.hls"
}

fn wrap_path() -> str {
    return "tools/rt_parts/hlrt_budget_wrap.c"
}

fn rt_run(args: list[str]) -> RunResult uses Proc {
    let argv: list[str] = ["tools/hls-rt.py"]
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    return run_capture("python3", argv)
}

fn boot_run(args: list[str]) -> RunResult uses Proc {
    let argv: list[str] = ["tools/hlinterp/boot.py"]
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    return run_capture("python3", argv)
}

# chk(acc, cond, msg) — the battery's check(): the [PASS]/[FAIL] grammar.
fn chk(acc: Acc, cond: bool, msg: str) -> void uses IO {
    if cond {
        pass_msg(acc, msg)
    } else {
        fail_msg(acc, msg)
    }
}

# sh_run_env(env_prefix, bin, args, outf, errf) — the battery's
# subprocess.run(cmd, env=dict(os.environ, HLRT_REPORT="1"),
# stdin=DEVNULL): a shell one-liner with the env on the front and both
# stdio streams redirected into scratch files. Returns the exit code.
fn sh_run_env(env_prefix: str, binp: str, args: list[str], outf: str,
              errf: str) -> int uses Proc {
    let mut cmd: str = env_prefix + " '" + shell_quote(binp) + "'"
    let mut i: int = 0
    while i < args.len() {
        cmd = cmd + " '" + shell_quote(args.get(i)) + "'"
        i = i + 1
    }
    cmd = cmd + " >'" + shell_quote(outf) + "' 2>'" + shell_quote(errf)
        + "' </dev/null"
    return sh(cmd)
}

# The instrument harness's C body — the battery's rt_harness.c, verbatim.
fn harness_c_src() -> str {
    return "#include <stdio.h>\n" +
        "#include <stdlib.h>\n" +
        "#include <string.h>\n" +
        "\n" +
        "void hlrt_cycle_mark(long long idx);\n" +
        "long long hlrt_cycle_allocs(void);\n" +
        "long long hlrt_cycle_bytes(void);\n" +
        "long long hlrt_cycle_live_bytes(void);\n" +
        "\n" +
        "int main(void) {\n" +
        "    /* the getters read the SNAPSHOT (the last CLOSED cycle); before any\n" +
        "     * mark nothing has closed */\n" +
        "    if (hlrt_cycle_allocs() != 0) return 1;\n" +
        "    /* cycle 0: two allocations, 24 bytes asked */\n" +
        "    void* a = malloc(8);\n" +
        "    void* b = malloc(16);\n" +
        "    memset(a, 1, 8);\n" +
        "    memset(b, 2, 16);\n" +
        "    /* the mark CLOSES cycle 0: the getters now read the SNAPSHOT (the\n" +
        "     * just-closed cycle), never the already-reset open one */\n" +
        "    hlrt_cycle_mark(0);\n" +
        "    if (hlrt_cycle_allocs() != 2 || hlrt_cycle_bytes() != 24) return 2;\n" +
        "    /* cycle 1: a realloc grows in place (its DELTA is counted, not the\n" +
        "     * size, and it IS an allocation event), one free, one fresh. The\n" +
        "     * getters stay on cycle 0's snapshot until the next mark — the\n" +
        "     * ledger lines below carry the cycle-1 numbers. */\n" +
        "    a = realloc(a, 32);                          /* +24 bytes */\n" +
        "    free(b);\n" +
        "    void* c = malloc(40);\n" +
        "    ((char*)c)[0] = 1;   /* the store keeps -O2 from dead-malloc-eliminating it */\n" +
        "    hlrt_cycle_mark(1);\n" +
        "    if (hlrt_cycle_allocs() != 2 || hlrt_cycle_bytes() != 64) return 3;\n" +
        "    /* the live set at exit: a (32) + c (40) = 72 bytes over 2 objects */\n" +
        "    if (hlrt_cycle_live_bytes() != 72) return 4;\n" +
        "    return 0;\n" +
        "}\n"
}

# The python3 driver: the front door to tools/hls-rt.py's own module —
# `flags` prints the wrap flags, `parse_report <file>` prints the parsed
# ledger summary (or NONE), `stats` prints the numerics the battery
# hand-computed against. The comparisons stay on the Halis side.
fn mod_driver_src() -> str {
    return "import importlib.util, sys\n" +
        "spec = importlib.util.spec_from_file_location(\"hls_rt_mod\", \"tools/hls-rt.py\")\n" +
        "mod = importlib.util.module_from_spec(spec)\n" +
        "spec.loader.exec_module(mod)\n" +
        "cmd = sys.argv[1]\n" +
        "if cmd == \"flags\":\n" +
        "    print(\" \".join(mod._WRAP_FLAGS))\n" +
        "elif cmd == \"parse_report\":\n" +
        "    data = open(sys.argv[2], \"rb\").read()\n" +
        "    rep = mod.parse_report(data)\n" +
        "    if rep is None:\n" +
        "        print(\"NONE\")\n" +
        "    else:\n" +
        "        print(\"CYCLES=%d TOTALS_ALLOCS=%d TAIL_ALLOCS=%d\" % (\n" +
        "            len(rep[\"cycles\"]), rep[\"totals\"][\"allocs\"],\n" +
        "            rep[\"tail\"][\"allocs\"]))\n" +
        "elif cmd == \"stats\":\n" +
        "    print(\"median_one=%d\" % mod.median([5]))\n" +
        "    print(\"median_odd=%d\" % mod.median([3, 1, 2]))\n" +
        "    print(\"median_even=%d\" % mod.median([100, 201]))\n" +
        "    print(\"p95_ok=%d\" % (abs(mod.p95([0] * 19 + [100]) - 5.0) < 1e-9))\n" +
        "    print(\"b1=%r\" % mod.fmt_bytes(2048))\n" +
        "    print(\"b2=%r\" % mod.fmt_bytes(3 * 1024 * 1024))\n" +
        "    print(\"b3=%r\" % mod.fmt_bytes(512))\n" +
        "    print(\"t1=%r\" % mod.fmt_nanos(1500000))\n" +
        "    print(\"t2=%r\" % mod.fmt_nanos(2500))\n" +
        "    print(\"t3=%r\" % mod.fmt_nanos(40))\n"
}

# ----------------------------------------------------------------------------
# JSON helpers (the battery's json.load(...) walks).
# ----------------------------------------------------------------------------

fn jget(v: JsonValue, k: str) -> JsonValue {
    return json_object_get(v, k)
}

fn jint(v: JsonValue, k: str) -> int {
    return json_int_value(jget(v, k))
}

fn jstr(v: JsonValue, k: str) -> str {
    return json_str_value(jget(v, k))
}

# jnum_ge(v, k, bound) — k's numeric value >= bound (int or float).
fn jnum_ge(v: JsonValue, k: str, bound: float) -> bool {
    let x: JsonValue = jget(v, k)
    if json_is_int(x) {
        return json_int_value(x).to_float() >= bound
    }
    if json_is_float(x) {
        return json_float_value(x) >= bound
    }
    return false
}

fn jnum_gt(v: JsonValue, k: str, bound: float) -> bool {
    let x: JsonValue = jget(v, k)
    if json_is_int(x) {
        return json_int_value(x).to_float() > bound
    }
    if json_is_float(x) {
        return json_float_value(x) > bound
    }
    return false
}

# ----------------------------------------------------------------------------
# 1. the convention and the refusal matrix
# ----------------------------------------------------------------------------

fn sec1(acc: Acc) -> void uses IO, Proc {
    section("Section 1 — the convention and the refusal matrix")
    let p1: RunResult = rt_run(["no-such-file.hls", "--budget-allocs", "10"])
    chk(acc, p1.code == 2 && p1.err.contains("no such workload"),
        "a missing workload is a usage failure (exit 2)")

    let p2: RunResult = rt_run(["--budget-allocs", "10", "tools/hls-rt.py"])
    chk(acc, p2.code == 2 && p2.err.contains("must be a .hls program"),
        "a non-.hls workload is a usage failure (exit 2)")

    let bads: list[list[str]] = [
        ["--budget-allocs", "0"],
        ["--budget-allocs", "-1"],
        ["--budget-bytes", "-8"],
        ["--budget-ms", "-3"],
        ["--budget-allocs", "10", "--warmup", "-1"],
        ["--budget-allocs", "10", "--min-cycles", "0"],
        ["--budget-allocs", "10", "--timeout", "0"],
    ]
    let whys: list[str] = [
        "a budget with every axis 0 is not a mode",
        "a negative allocs budget is refused",
        "a negative bytes budget is refused",
        "a negative deadline is refused",
        "a negative warmup is refused",
        "--min-cycles below 1 is refused",
        "a non-positive timeout is refused",
    ]
    let mut i: int = 0
    while i < bads.len() {
        let flags: list[str] = bads.get(i)
        let argv: list[str] = []
        let mut k: int = 0
        while k < flags.len() {
            argv.push(flags.get(k))
            k = k + 1
        }
        argv.push(steady_path())
        let p: RunResult = rt_run(argv)
        chk(acc, p.code == 2, whys.get(i) + " (exit 2)")
        i = i + 1
    }

    let p8: RunResult = rt_run(["--budget-allocs", "10", "--budget-bytes", "0",
        "--budget-ms", "0", steady_path()])
    chk(acc, p8.code == 0 || p8.code == 1,
        "a single non-zero axis is a mode (the run happened)")
}

# ----------------------------------------------------------------------------
# 2. the instrument and its ledger
# ----------------------------------------------------------------------------

fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 2 — the instrument and its ledger")
    let driver: str = write_src(acc, "rt_mod_driver.py", mod_driver_src())
    let harness: str = write_src(acc, "rt_harness.c", harness_c_src())
    let harness_bin: str = scratch(acc, "rt_harness.bin")

    # the wrap flags come from the verifier's own module
    let pf: RunResult = run_capture("python3", [driver, "flags"])
    let wrap_flags: list[str] = pf.out.trim().split(" ")

    let gargs: list[str] = ["-O2", "-o", harness_bin, harness, wrap_path(),
        "-pthread"]
    let mut gi: int = 0
    while gi < wrap_flags.len() {
        gargs.push(wrap_flags.get(gi))
        gi = gi + 1
    }
    let g: RunResult = run_capture("gcc", gargs)
    if g.code != 0 {
        chk(acc, false, "the instrument harness compiles")
        return
    }

    let outf: str = scratch(acc, "harness.out")
    let errf: str = scratch(acc, "harness.err")
    let rc: int = sh_run_env("HLRT_REPORT=1", harness_bin, [], outf, errf)
    let perr: str = read_or(errf, "")
    chk(acc, rc == 0,
        "the harness's own assertions hold (snapshot, delta, live)")
    chk(acc, perr.contains("HLRT_REPORT_BEGIN") && perr.contains("HLRT_REPORT_END"),
        "the report is fenced (BEGIN/END)")
    let lines: list[str] = perr.split("\n")
    let cyc: list[str] = []
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).starts_with("HLRT_CYCLE=") {
            cyc.push(lines.get(i))
        }
        i = i + 1
    }
    chk(acc, cyc.len() == 2, "two closed cycles in the ledger")
    if cyc.len() < 2 {
        return
    }
    let c0: list[str] = cyc.get(0).split(" ")
    let c1: list[str] = cyc.get(1).split(" ")
    chk(acc, c0.get(0) == "HLRT_CYCLE=0" && c0.get(1) == "ALLOCS=2"
        && c0.get(2) == "BYTES=24",
        "cycle 0: 2 allocations, 24 bytes (the mallocs, not the "
            + "instrument's own)")
    chk(acc, c1.get(0) == "HLRT_CYCLE=1" && c1.get(1) == "ALLOCS=2"
        && c1.get(2) == "BYTES=64",
        "cycle 1: the in-place realloc's DELTA (24) + the fresh 40, "
            + "the free counted once")
    let live0: int = kv_value(c0, "LIVE")
    let live1: int = kv_value(c1, "LIVE")
    chk(acc, live0 == 24 && live1 == 72,
        "live bytes: 24 after cycle 0, 72 at the mark (a-32 + c-40)")

    let tail: list[str] = first_prefixed(lines, "HLRT_TAIL ").split(" ")
    chk(acc, tail.get(1) == "ALLOCS=0" && tail.get(2) == "BYTES=0",
        "the tail window is empty (nothing allocated after the mark)")
    let total: str = first_prefixed(lines, "HLRT_TOTAL ")
    chk(acc, total.contains("ALLOCS=4") && total.contains("BYTES=88")
        && total.contains("FREES=1"),
        "the totals re-derive: 4 allocations, 88 bytes, 1 free")
    chk(acc, has_prefixed(lines, "HLRT_LIVE_EXIT=2"), "two live objects at exit")
    chk(acc, has_exact(lines, "HLRT_OVERFLOW=0"), "no tracking-table overflow")

    # The verifier's parser: the same report text, and the refusals.
    let pr: RunResult = run_capture("python3", [driver, "parse_report", errf])
    chk(acc, pr.out.trim().starts_with("CYCLES=2"),
        "parse_report accepts the real ledger")
    chk(acc, pr.out.contains("TOTALS_ALLOCS=4") && pr.out.contains("TAIL_ALLOCS=0"),
        "parse_report re-derives the totals from the lines")
    let broken: str = write_src(acc, "broken_report.bin",
        "HLRT_REPORT_BEGIN\n" +
        "HLRT_CYCLE=0 ALLOCS=2 BYTES=24 LIVE=24 FREES=0 NANOS=5\n" +
        "HLRT_TAIL ALLOCS=0 BYTES=0\n" +
        "HLRT_TOTAL ALLOCS=7 BYTES=24 FREES=0\n" +
        "HLRT_LIVE_EXIT=2\nHLRT_OVERFLOW=0\n" +
        "HLRT_REPORT_END\n")
    let pb: RunResult = run_capture("python3", [driver, "parse_report", broken])
    chk(acc, pb.out.trim() == "NONE",
        "a report whose totals disagree with its lines is refused whole")
    let at: int = perr.find("HLRT_REPORT_END")
    let no_end: str = write_src(acc, "no_end_report.bin", perr.slice(0, at))
    let pn: RunResult = run_capture("python3", [driver, "parse_report", no_end])
    chk(acc, pn.out.trim() == "NONE", "an unfenced report (no END) is refused")
    let empty: str = write_src(acc, "empty_report.bin", "")
    let pe: RunResult = run_capture("python3", [driver, "parse_report", empty])
    chk(acc, pe.out.trim() == "NONE", "no report at all is not a ledger")
}

# kv_value(tokens, key) — the value of `KEY=<n>` among the space-split
# tokens of a ledger line (-1 when absent).
fn kv_value(tokens: list[str], key: str) -> int {
    let mut i: int = 0
    while i < tokens.len() {
        let t: str = tokens.get(i)
        if t.starts_with(key + "=") {
            return t.slice(key.len() + 1, t.len()).to_int()
        }
        i = i + 1
    }
    return -1
}

fn first_prefixed(lines: list[str], prefix: str) -> str {
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).starts_with(prefix) {
            return lines.get(i)
        }
        i = i + 1
    }
    return ""
}

fn has_prefixed(lines: list[str], prefix: str) -> bool {
    return first_prefixed(lines, prefix) != ""
}

fn has_exact(lines: list[str], want: str) -> bool {
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i) == want {
            return true
        }
        i = i + 1
    }
    return false
}

# ----------------------------------------------------------------------------
# 3. the runtime wiring
# ----------------------------------------------------------------------------

fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 3 — the runtime wiring")
    if !(file_exists("bin/hlc") && which("gcc")) {
        chk(acc, false, "bin/hlc missing — the wiring section cannot run")
        return
    }
    let hello: str = write_src(acc, "hello.hls",
        "fn main() -> int uses IO {\n" +
        "    println(\"hello\")\n" +
        "    return 0\n" +
        "}\n")
    let c_path: str = scratch(acc, "hello.c")
    let r: RunResult = run_capture("./bin/hlc", [hello, c_path])
    chk(acc, r.code == 0, "the hosted probe compiles")
    let src: str = read_or(c_path, "")
    chk(acc, src.contains("__attribute__((weak)) int hlrt_cycle_hooked = 0;")
        && src.contains("__attribute__((weak)) void hlrt_cycle_mark")
        && !src.contains("extern void hlrt_cycle_mark"),
        "the emitted C defines the weak instrument hooks as fallbacks "
            + "(no weak references: Mach-O links the plain build)")
    chk(acc, src.contains("hl_srt_init();"),
        "main arms the mode before any user code")
    chk(acc, src.contains("__HLRT_CYCLE__ ") && src.contains("hl_srt_on_mark"),
        "println scans the reserved marker prefix when armed")
    chk(acc, src.contains("HLRT_BUDGET_ALLOCS") && src.contains("HLRT_BUDGET_NANOS")
        && src.contains("HLRT_WARMUP"),
        "the budget/warmup environment is read by name")

    let c_nl: str = scratch(acc, "hello_nl.c")
    let rnl: RunResult = run_capture("./bin/hlc", ["--no-libc", hello, c_nl])
    chk(acc, rnl.code == 0, "the --no-libc probe compiles")
    let src_nl: str = read_or(c_nl, "")
    chk(acc, !src_nl.contains("hl_srt_init") && !src_nl.contains("hlrt_cycle_mark"),
        "a --no-libc emission carries none of the mode")

    let fs_path: str = write_src(acc, "fs_probe.hls",
        "#![freestanding]\n" +
        "fn main() -> int {\n" +
        "    return 42\n" +
        "}\n")
    let c_fs: str = scratch(acc, "hello_fs.c")
    let rfs: RunResult = run_capture("./bin/hlc", [fs_path, c_fs])
    chk(acc, rfs.code == 0, "the freestanding probe compiles")
    chk(acc, !read_or(c_fs, "").contains("hl_srt_init"),
        "a freestanding emission carries none of the mode")

    let bin_path: str = scratch(acc, "hello.bin")
    let rl: RunResult = run_capture("gcc",
        ["-O2", "-o", bin_path, c_path, "-lm", "-pthread"])
    chk(acc, rl.code == 0, "the hosted probe links WITHOUT the wrap")
    let outf: str = scratch(acc, "hello.out")
    let errf: str = scratch(acc, "hello.err")
    let rc: int = sh_run_env("HLRT_REPORT=1", bin_path, [], outf, errf)
    chk(acc, read_or(outf, "") == "hello\n" && rc == 0,
        "an uninstrumented binary ignores its own markers and the "
            + "report switch (mode not armed, one flag test)")
    chk(acc, !read_or(errf, "").contains("HLRT_REPORT_BEGIN"),
        "no ledger without the instrument (the runtime never rolls)")
}

# ----------------------------------------------------------------------------
# 4. the steady certification
# ----------------------------------------------------------------------------

fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 4 — the steady certification")
    if !(file_exists("bin/hlc") && which("gcc")) {
        chk(acc, false, "bin/hlc missing — the steady section cannot run")
        return
    }
    let json_path: str = scratch(acc, "steady.json")
    let p: RunResult = rt_run(["--budget-allocs", "20000", "--budget-bytes",
        "1048576", "--warmup", "2", "--json", json_path, steady_path()])
    chk(acc, p.code == 0 && p.out.contains("RT BOUNDED"),
        "the steady workload certifies RT BOUNDED")
    chk(acc, p.out.contains("every measured cycle is inside its budget"),
        "the reason line names the bounded leg")
    chk(acc, p.out.contains("in-process enforcement: armed"),
        "the report says the in-process leg was armed")
    let blob: JsonValue = json_parse(read_or(json_path, ""))
    chk(acc, jstr(blob, "tool") == "hls-rt" && jstr(blob, "verdict") == "bounded",
        "the json carries the tool name and the verdict")
    let cfg: JsonValue = jget(blob, "config")
    chk(acc, jint(cfg, "budget_allocs") == 20000 && jint(cfg, "warmup") == 2
        && json_is_bool(jget(cfg, "enforce")) && json_bool_value(jget(cfg, "enforce")),
        "the config echoes the plan")
    let ledger: JsonValue = jget(jget(blob, "ledger"), "cycles")
    let mut ledger_ok: bool = json_is_array(ledger) && ledger.arr.len() == 24
    let mut li: int = 0
    while ledger_ok && li < 24 {
        if jint(ledger.arr.get(li), "cycle") != li {
            ledger_ok = false
        }
        li = li + 1
    }
    chk(acc, ledger_ok, "the ledger holds all 24 cycles, in mark order")
    let marks: JsonValue = jget(blob, "observed_markers")
    let mut marks_ok: bool = json_is_array(marks) && marks.arr.len() == 24
    let mut mi: int = 0
    while marks_ok && mi < 24 {
        if json_int_value(marks.arr.get(mi)) != mi {
            marks_ok = false
        }
        mi = mi + 1
    }
    chk(acc, marks_ok, "the marker stream was observed complete")
    let stats: JsonValue = jget(blob, "stats")
    chk(acc, jint(stats, "cycles") == 22,
        "22 measured cycles after the warmup of 2")
    chk(acc, jint(stats, "allocs_max") == jint(stats, "allocs_median"),
        "identical churn per cycle: max allocs == median allocs")
    let mut live_min: int = 0
    let mut live_max: int = 0
    let mut have: bool = false
    let mut k: int = 2
    while k < ledger.arr.len() {
        let lb: int = jint(ledger.arr.get(k), "live_bytes")
        if !have {
            live_min = lb
            live_max = lb
            have = true
        } else {
            if lb < live_min {
                live_min = lb
            }
            if lb > live_max {
                live_max = lb
            }
        }
        k = k + 1
    }
    let drift: int = live_max - live_min
    chk(acc, have && drift <= 64,
        "live bytes are flat across the measured window (drift "
        + drift.to_str() + " B -- the in-flight marker strings' width "
        + "grows at two-digit indices; retained state does not)")
    chk(acc, jnum_ge(stats, "nanos_jitter", 0.0) && jnum_gt(stats, "nanos_max", 0.0),
        "the time stats are present")
    chk(acc, jint(blob, "exit") == 0 && json_is_null(jget(blob, "protocol_error")),
        "a clean exit, no protocol error")

    # extra argv reaches the program: the marker count follows the plan
    let p2: RunResult = rt_run(["--budget-allocs", "20000", "--budget-bytes",
        "1048576", steady_path(), "6"])
    chk(acc, p2.code == 0 && p2.out.contains("cycle 5")
        && !str_replace(p2.out, "cycle 5", "X").contains("cycle 6 "),
        "extra argv drives the workload's own plan (6 cycles)")
}

# ----------------------------------------------------------------------------
# 5. the enforcement matrix
# ----------------------------------------------------------------------------

fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 5 — the enforcement matrix")
    if !(file_exists("bin/hlc") && which("gcc")) {
        chk(acc, false, "bin/hlc missing — the enforcement section cannot run")
        return
    }
    let pa: RunResult = rt_run(["--budget-allocs", "200", over_allocs_path()])
    chk(acc, pa.code == 1 && pa.out.contains("RT REFUSED"),
        "the allocs canary is refused (exit 1)")
    chk(acc, pa.out.contains("in-process enforcement fired (exit 101)"),
        "the refusal names the in-process leg")
    let rexit: Result[Regex, str] = regex_compile("exit:\\s+101")
    let mut exit_ok: bool = false
    if result_is_ok(rexit) {
        exit_ok = regex_is_match(result_unwrap(rexit), pa.out)
    }
    chk(acc, exit_ok, "the program died its own death (exit 101), not the tool's")
    let rmsg: Result[Regex, str] = regex_compile(
        "soft real-time violation: cycle (\\d+) made (\\d+) allocations \\(budget 200\\)")
    let mut msg_ok: bool = false
    let mut named: int = -1
    let mut made: int = -1
    if result_is_ok(rmsg) {
        let gs: Option[list[str]] = regex_groups(result_unwrap(rmsg), pa.out)
        if option_is_some(gs) {
            msg_ok = true
            let gv: list[str] = option_unwrap(gs)
            named = gv.get(1).to_int()
            made = gv.get(2).to_int()
        }
    }
    chk(acc, msg_ok, "the canonical allocs-axis message, the runtime's own line")

    # the ramp, verified from the ledger: the per-cycle traffic grows
    # strictly, and the cycle the runtime killed is EXACTLY the first
    # cycle the ledger shows over 200 — enforcement and ledger agree on
    # the witness
    let pj: str = scratch(acc, "ramp.json")
    rt_run(["--no-enforce", "--budget-allocs", "1000000", "--json", pj,
        over_allocs_path()])
    let ramp: JsonValue = jget(jget(json_parse(read_or(pj, "")), "ledger"), "cycles")
    let n: int = ramp.arr.len()
    let mut seq: list[int] = []
    let mut i: int = 0
    while i < n {
        seq.push(jint(ramp.arr.get(i), "allocs"))
        i = i + 1
    }
    let mut increasing: bool = seq.len() > 1
    let mut j: int = 0
    while increasing && j < seq.len() - 1 {
        if seq.get(j) >= seq.get(j + 1) {
            increasing = false
        }
        j = j + 1
    }
    let head: str = "[" + seq.get(0).to_str() + ", " + seq.get(1).to_str()
        + ", " + seq.get(2).to_str() + ", " + seq.get(3).to_str() + "]"
    chk(acc, increasing,
        "the ramp is strictly increasing cycle over cycle (" + head + "...)")
    let mut first_over: int = -1
    let mut k: int = 0
    while first_over < 0 && k < seq.len() {
        if seq.get(k) > 200 {
            first_over = k
        }
        k = k + 1
    }
    chk(acc, named == first_over && first_over >= 0 && made == seq.get(first_over),
        "the runtime killed cycle " + named.to_str() + " with " + made.to_str()
            + " allocations — the ledger's first over-budget cycle, "
            + "to the allocation")

    let pb: RunResult = rt_run(["--budget-bytes", "8192", over_bytes_path()])
    chk(acc, pb.code == 1 && pb.out.contains("RT REFUSED"),
        "the bytes canary is refused (exit 1)")
    chk(acc, regex_match_ok("soft real-time violation: cycle \\d+ allocated \\d+ bytes \\(budget 8192\\)", pb.out),
        "the canonical bytes-axis message (few allocations, big payload)")

    let pd: RunResult = rt_run(["--budget-ms", "10", deadline_path()])
    chk(acc, pd.code == 1 && pd.out.contains("RT REFUSED"),
        "the deadline canary is refused (exit 1)")
    chk(acc, regex_match_ok("soft real-time violation: cycle \\d+ took \\d+ ns \\(deadline 10000000 ns\\)", pd.out),
        "the canonical time-axis message (the runtime's own clock)")

    let pw: RunResult = rt_run(["--budget-allocs", "60", warmup_path()])
    chk(acc, pw.code == 1 && pw.out.contains("RT REFUSED"),
        "the fat-first-cycle canary without warmup is refused")
    let wj: str = scratch(acc, "w.json")
    let pw2: RunResult = rt_run(["--budget-allocs", "60", "--warmup", "1",
        "--json", wj, warmup_path()])
    chk(acc, pw2.code == 0 && pw2.out.contains("RT BOUNDED"),
        "the same canary with --warmup 1 certifies: cycle 0 measured "
            + "but not enforced, the quiet line bounded")
    let wb: JsonValue = json_parse(read_or(wj, ""))
    chk(acc, jint(jget(wb, "config"), "warmup") == 1
        && jint(jget(wb, "stats"), "cycles") == 11,
        "the warmup cycle is excluded from the measured window")

    let pn: RunResult = rt_run(["--no-enforce", "--budget-allocs", "200",
        over_allocs_path()])
    chk(acc, pn.code == 1 && pn.out.contains("RT REFUSED"),
        "--no-enforce: the run completes, the verdict still refuses")
    chk(acc, !pn.out.contains("in-process enforcement fired"),
        "the refusal is NOT the program's death (the mode was off)")
    chk(acc, pn.out.contains("the ledger shows the overrun")
        && pn.out.contains("measure only"),
        "the ledger leg judged alone, and says so")
    chk(acc, regex_match_ok("exit:\\s+0", pn.out),
        "the canary ran to completion (exit 0) — measured, not "
            + "judged in-process")
}

fn regex_match_ok(pattern: str, text: str) -> bool {
    let rr: Result[Regex, str] = regex_compile(pattern)
    if result_is_err(rr) {
        return false
    }
    return regex_is_match(result_unwrap(rr), text)
}

# ----------------------------------------------------------------------------
# 6. the honesty gates
# ----------------------------------------------------------------------------

fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 6 — the honesty gates")
    if !(file_exists("bin/hlc") && which("gcc")) {
        chk(acc, false, "bin/hlc missing — the honesty section cannot run")
        return
    }
    let p1: RunResult = rt_run(["--budget-allocs", "1000", no_cycles_path()])
    chk(acc, p1.code == 1 && p1.out.contains("RT INCONCLUSIVE"),
        "a marker-free program is INCONCLUSIVE (exit 1)")
    chk(acc, p1.out.contains("only 0 measured cycle(s)"),
        "the reason says the sample was empty, not the verdict vague")

    let p2: RunResult = rt_run(["--budget-allocs", "100000", "--budget-bytes",
        "10000000", late_work_path()])
    chk(acc, p2.code == 1 && p2.out.contains("RT INCONCLUSIVE"),
        "the late-work canary is INCONCLUSIVE (exit 1)")
    chk(acc, p2.out.contains("the markers do not cover the work"),
        "the tail rule fires: 4000 tail allocations vs a quiet marked phase")

    let bad_marker: str = write_src(acc, "bad_marker.hls",
        "fn main() -> int uses IO {\n" +
        "    println(\"__HLRT_CYCLE__ abc\")\n" +
        "    return 0\n" +
        "}\n")
    let p3: RunResult = rt_run(["--budget-allocs", "1000", bad_marker])
    chk(acc, p3.code == 1 && p3.out.contains("malformed cycle marker"),
        "a malformed marker is a loud protocol error")

    let twice: str = write_src(acc, "twice.hls",
        "fn main() -> int uses IO {\n" +
        "    println(\"__HLRT_CYCLE__ 0\")\n" +
        "    println(\"__HLRT_CYCLE__ 0\")\n" +
        "    return 0\n" +
        "}\n")
    let p4: RunResult = rt_run(["--budget-allocs", "1000", twice])
    chk(acc, p4.code == 1 && p4.out.contains("does not advance"),
        "a non-advancing marker is a loud protocol error")

    let stem: str = write_src(acc, "stem.hls",
        "fn main() -> int uses IO {\n" +
        "    println(\"hello __HLRT_CYCLE__ 0\")\n" +
        "    return 0\n" +
        "}\n")
    let p5: RunResult = rt_run(["--budget-allocs", "1000", stem])
    chk(acc, p5.code == 1 && p5.out.contains("reserved stem"),
        "a look-alike (stem in a non-record) is a loud protocol error")

    let talker: str = write_src(acc, "talker.hls",
        "fn main() -> int uses IO {\n" +
        "    println(\"chatter before\")\n" +
        "    println(\"__HLRT_CYCLE__ 0\")\n" +
        "    println(\"chatter after\")\n" +
        "    return 0\n" +
        "}\n")
    let p6: RunResult = rt_run(["--budget-allocs", "1000", talker])
    chk(acc, p6.code == 1 && p6.out.contains("RT INCONCLUSIVE")
        && p6.out.contains("only 1 measured cycle(s)"),
        "ordinary output survives the protocol scan (a talking "
            + "workload is legal; one cycle is just too few to certify)")
}

# ----------------------------------------------------------------------------
# 7. the report and the numbers
# ----------------------------------------------------------------------------

fn sec7(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 7 — the report and the numbers")
    let driver: str = write_src(acc, "rt_mod_driver.py", mod_driver_src())
    let st: RunResult = run_capture("python3", [driver, "stats"])
    let out: str = st.out
    chk(acc, out.contains("median_one=5"), "the median of one is the one")
    chk(acc, out.contains("median_odd=2"), "the odd median sorts to the middle")
    chk(acc, out.contains("median_even=150"),
        "the even median floors the average (the core.rt definition)")
    chk(acc, out.contains("p95_ok=1"),
        "the p95 interpolates (the hls-bench estimator)")
    chk(acc, out.contains("b1='2.0 KiB'") && out.contains("b2='3.00 MiB'")
        && out.contains("b3='512 B'"),
        "the human byte formats")
    chk(acc, out.contains("t1='1.50 ms'") && out.contains("t2='2.5 us'")
        && out.contains("t3='40 ns'"),
        "the human time formats")

    if !(file_exists("bin/hlc") && which("gcc")) {
        return
    }
    let p: RunResult = rt_run(["--budget-allocs", "20000", "--budget-bytes",
        "1048576", "--warmup", "2", steady_path(), "6"])
    chk(acc, p.out.contains("hls-rt 0.144.0-alpha"),
        "the header carries the version")
    chk(acc, p.out.contains("budget 20000 allocs/cycle"),
        "the plan line names the axis")
    chk(acc, p.out.contains("deadline off"), "an unset axis says off")
    chk(acc, p.out.contains("warmup 2"), "the plan line names the warmup")
    chk(acc, p.out.contains("mode:            enforce"),
        "the mode line says enforce")
    chk(acc, p.out.contains("per-cycle ledger"), "the ledger block is titled")
    chk(acc, p.out.contains("measured window: 4 cycles"),
        "the window after the warmup")
    chk(acc, p.out.contains("tail after the last mark"),
        "the coverage line is present")
    chk(acc, p.out.contains("RT BOUNDED"), "the verdict word")

    let jpath: str = scratch(acc, "layout.json")
    rt_run(["--budget-allocs", "20000", "--budget-bytes", "1048576",
        "--warmup", "2", "--json", jpath, steady_path(), "6"])
    let blob: JsonValue = json_parse(read_or(jpath, ""))
    chk(acc, jstr(blob, "verdict") == "bounded" && jint(blob, "exit") == 0,
        "the json verdict agrees with the text and the exit code")
    chk(acc, json_object_has(blob, "stats") && !json_is_null(jget(blob, "stats"))
        && jint(jget(blob, "stats"), "cycles") == 4,
        "the json stats agree with the measured window")
    chk(acc, jget(jget(blob, "ledger"), "cycles").arr.len() == 6,
        "the json ledger holds every closed cycle (warmup included)")
}

# ----------------------------------------------------------------------------
# 8. the differential and the corpus hygiene
# ----------------------------------------------------------------------------

fn sec8(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 8 — the differential and the corpus hygiene")
    let fx: str = fixture_path()
    let pfx: str = panic_fixture_path()

    let pc: RunResult = boot_run(["--check", fx])
    chk(acc, pc.out.contains("OK: types and effects valid"),
        "the model fixture boots through the real checker")

    let interp: RunResult = boot_run([fx])
    chk(acc, interp.code == 0 && interp.out.contains("rt model ok: 62 assertions"),
        "the model fixture passes on the interpreter (62 assertions)")

    if file_exists("bin/hlc") && which("gcc") {
        let fc: str = scratch(acc, "fixture.c")
        let fb: str = scratch(acc, "fixture.bin")
        let r: RunResult = run_capture("./bin/hlc", [fx, fc])
        chk(acc, r.code == 0, "the model fixture compiles natively")
        let r2: RunResult = run_capture("gcc", ["-O2", "-o", fb, fc, "-lm", "-pthread"])
        chk(acc, r2.code == 0, "the model fixture links")
        let native: RunResult = run_capture(fb, [])
        chk(acc, native.code == 0 && native.out == interp.out,
            "interpreter and native agree byte for byte")

        let pcsrc: str = scratch(acc, "panic.c")
        let pbin: str = scratch(acc, "panic.bin")
        let r3: RunResult = run_capture("./bin/hlc", [pfx, pcsrc])
        let r4: RunResult = run_capture("gcc", ["-O2", "-o", pbin, pcsrc, "-lm", "-pthread"])
        if r3.code == 0 && r4.code == 0 {
            let pnat: RunResult = run_capture(pbin, [])
            let canon: str = "soft real-time violation: cycle 7 made 1200 allocations (budget 1000)"
            chk(acc, pnat.code == 101 && pnat.err.contains(canon),
                "the native enforce-over dies 101 with the canonical message")
            let pinterp: RunResult = boot_run([pfx])
            chk(acc, pinterp.code == 101 && pinterp.err.contains(canon),
                "the interpreter agrees (exit 101, same message)")
        } else {
            chk(acc, false, "the panic fixture compiles natively")
        }
    }

    let files: list[str] = [fx, pfx, steady_path(), over_allocs_path(),
        over_bytes_path(), deadline_path(), warmup_path(), no_cycles_path(),
        late_work_path()]
    let mut i: int = 0
    while i < files.len() {
        let r: RunResult = run_capture("./bin/hlfmt", ["-c", files.get(i)])
        chk(acc, r.out.contains("already formatted"),
            basename(files.get(i)) + " is hlfmt-canonical")
        i = i + 1
    }
    let li1: RunResult = run_capture("python3", ["tools/hllint.py", fx])
    chk(acc, li1.out.contains("no warnings"), "the model fixture is hllint-clean")
    let li2: RunResult = run_capture("python3", ["tools/hllint.py", steady_path()])
    chk(acc, li2.out.contains("no warnings"), "the steady workload is hllint-clean")

    # no gate litter survives anywhere
    let litter: list[str] = collect_litter("tests")
    let litter2: list[str] = collect_litter("tests/rt_libs")
    let mut all: str = ""
    let mut k: int = 0
    while k < litter.len() {
        all = all + litter.get(k) + " "
        k = k + 1
    }
    k = 0
    while k < litter2.len() {
        all = all + litter2.get(k) + " "
        k = k + 1
    }
    let mut litter_detail: str = all.trim()
    if litter_detail == "" {
        litter_detail = "clean"
    }
    chk(acc, all == "", "no gate temp files survive anywhere ("
        + litter_detail + ")")
}

fn collect_litter(dir: str) -> list[str] uses Fs {
    let out: list[str] = []
    let entries: list[str] = fs_read_dir(dir)
    let mut i: int = 0
    while i < entries.len() {
        let f: str = basename(entries.get(i))
        if f.starts_with("hlrt-") || f.starts_with("_gate_s126_") {
            out.push(f)
        }
        i = i + 1
    }
    return out
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("rt")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    sec8(acc)
    return finish(acc, "Stage 126 -- hls-rt (the soft-real-time verifier)")
}
