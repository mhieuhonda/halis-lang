        "\n" +
        "fn main() -> int uses IO {\n" +
        "    test_glue()\n" +
        "    return 0\n" +
        "}\n"
}

fn glue_store() -> str {
    return store_header() +
        "@@@ test_glue glued 5\nvalue\n"
}

