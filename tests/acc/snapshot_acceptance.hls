# ============================================================================
# tests/acc/snapshot_acceptance.hls — Stage 119 acceptance gate, in Halis
# (the Halis twin of tests/snapshot_acceptance.py; same eight sections,
# same assertions, same needles — the harness is tests/acc/harness.hls
# and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# The old battery reached into tools/hltest.py internals
# (parse_snapshot_records, load_store, store_path_for) for its parser
# and store legs; the gate asks the same questions through the front
# door: `python3 tools/hltest.py` (the same CLI the runner's users
# drive). A parser leg pins the exact expected record set as a
# canonical store (hand-built, the writer's own byte grammar) and
# checks that `-u` reproduces it byte for byte; the store-value legs
# read the store frames with a small in-gate scanner of the documented
# v1 grammar (`@@@ <test> <name> <len>\n<value>\n`).
#
#  1. the assertion  — std.test's assert_snapshot emits the exact wire
#                      protocol (marker line, length-prefixed value,
#                      frame separator), byte for byte, on the
#                      interpreter; the parser reads the records back
#                      (an embedded marker-lookalike line is data, not
#                      framing); interleaved println diagnostics never
#                      leak into values; a marker glued mid-line by
#                      print() noise still parses; a tainted value is
#                      a compile error naming assert_snapshot on BOTH
#                      front-ends
#  2. the store      — verify without a store fails with "new
#                      snapshot" + the recording hint; `-u` writes
#                      __snapshots__/<stem>.snap byte-identical to the
#                      committed one; the v1 header and @@@ framing
#                      pinned; records sorted by (test, name); a
#                      second -u changes nothing; verify passes
#  3. the verify     — a changed value fails with a unified diff and
#                      the accept hint; -u accepts it; the
#                      tampered-store matrix (bad magic, wrong header,
#                      truncation, missing separator, length overrun,
#                      duplicate record, invalid name) all fail as
#                      <snapshots> corruption, and -u refuses to
#                      regenerate over them
#  4. new/obsolete   — a new assertion fails verify until recorded;
#                      a removed assertion is an obsolete failure,
#                      pruned by -u; a deleted test fn is a file-level
#                      <snapshots> failure, pruned by -u; --grep never
#                      mislabels filtered tests; a panicking test's
#                      partial records are never recorded
#  5. the protocol   — the parser (driven by the runner) rejects a
#                      duplicate snapshot name in one test, a missing
#                      length field, a declared length past EOF, a
#                      missing frame separator, an invalid name
#                      charset, a leading-zero length, and an
#                      unterminated record header
#  6. the runner     — parallel -u across two directories writes both
#                      stores without cross-contamination; exit codes
#                      follow the suite contract; JUnit XML carries
#                      the diff; a file without snapshots never grows
#                      a store; the store path convention
#  7. the differential—the fixture's protocol output is byte-identical
#                      from interpreter and native; the native run's
#                      records equal the committed store's values;
#                      -u on a copy regenerates the committed store
#  8. the fixed point— the committed store verifies green in-tree; -u
#                      is idempotent (bytes, report, no .tmp); the
#                      fixture is an hlfmt fixed point; the taint fail
#                      file rejects under --check
# ============================================================================

import "./harness.hls"
import "std.str"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

fn fixture_path() -> str {
    return "tests/ok/feat_stage119_snapshot.hls"
}

fn committed_store() -> str {
    return "tests/ok/__snapshots__/feat_stage119_snapshot.snap"
}

fn fail_taint() -> str {
    return "tests/fail/fail_snapshot_taint.hls"
}

fn store_header() -> str {
    return "# hltest-snapshots v1\n# generated by `hltest --update-snapshots` - do not edit by hand\n"
}

# The s1 probe, verbatim from the battery (a plain program: the
# protocol bytes ARE the stdout).
fn probe_src() -> str {
    return "import \"std.test\"\n" +
        "\n" +
        "fn main() -> int uses IO {\n" +
        "    assert_snapshot(\"greeting\", \"hello, snapshot\")\n" +
        "    assert_snapshot(\"empty\", \"\")\n" +
        "    assert_snapshot(\"multi\", \"line1\\nline2\\n__SNAP__ fake 2\\nzz\")\n" +
        "    println(\"done\")\n" +
        "    return 0\n" +
        "}\n"
}

# The exact stdout the probe must produce.
fn probe_want() -> str {
    return "__SNAP__ greeting 15\nhello, snapshot\n" +
        "__SNAP__ empty 0\n\n" +
        "__SNAP__ multi 30\nline1\nline2\n__SNAP__ fake 2\nzz\n" +
        "done\n"
}

# The probe as a test file, so the runner's parser consumes the same
# records; main exists so the file type-checks as a program.
fn records_src() -> str {
    return "import \"std.test\"\n" +
        "\n" +
        "fn test_records() uses IO {\n" +
        "    assert_snapshot(\"greeting\", \"hello, snapshot\")\n" +
        "    assert_snapshot(\"empty\", \"\")\n" +
        "    assert_snapshot(\"multi\", \"line1\\nline2\\n__SNAP__ fake 2\\nzz\")\n" +
        "    println(\"done\")\n" +
        "}\n" +
        "\n" +
        "fn main() -> int uses IO {\n" +
        "    test_records()\n" +
        "    return 0\n" +
        "}\n"
}

# The canonical store for the probe's record set — exactly what -u
# must write if the parser read the three records back byte for byte.
fn records_store() -> str {
    return store_header() +
        "@@@ test_records empty 0\n\n" +
        "@@@ test_records greeting 15\nhello, snapshot\n" +
        "@@@ test_records multi 30\nline1\nline2\n__SNAP__ fake 2\nzz\n"
}

fn interleave_src() -> str {
    return "import \"std.test\"\n" +
        "\n" +
        "fn test_interleave() uses IO {\n" +
        "    println(\"computing...\")\n" +
        "    assert_snapshot(\"a\", \"first\")\n" +
        "    println(\"middle\")\n" +
        "    assert_snapshot(\"b\", \"second\")\n" +
        "    println(\"done\")\n" +
        "}\n" +
        "\n" +
        "fn main() -> int uses IO {\n" +
        "    test_interleave()\n" +
        "    return 0\n" +
        "}\n"
}

fn interleave_store() -> str {
    return store_header() +
        "@@@ test_interleave a 5\nfirst\n" +
        "@@@ test_interleave b 6\nsecond\n"
}

fn glue_src() -> str {
    return "import \"std.test\"\n" +
        "\n" +
        "fn test_glue() uses IO {\n" +
