# The adversarial streams (battery section 5): each printed verbatim
# by a test fn that then returns normally, so the RUNNER's parser is
# what consumes them.
fn adv_streams() -> list[str] {
    return [
        "__SNAP__ bogus no-length-here\n",
        "__SNAP__ big 999\n",
        "__SNAP__ sep 5\nvalue",
        "__SNAP__ bad name 5\nvalue\n",
        "__SNAP__ z 007\nvalue\n",
        "__SNAP__ end 3",
    ]
}

fn adv_labels() -> list[str] {
    return [
        "missing length field",
        "declared length past EOF",
        "missing frame separator",
        "invalid name charset",
        "leading-zero length",
        "unterminated record header",
    ]
}

fn adv_needles() -> list[str] {
    return [
        "length",
        "999 bytes",
        "separator",
        "name",
        "length",
        "unterminated",
    ]
}

fn esc_str(s: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b == 34 {
            out = out + "\\\""
        } else if b == 92 {
            out = out + "\\\\"
        } else if b == 10 {
            out = out + "\\n"
        } else {
            out = out + s.slice(i, i + 1)
        }
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

fn hltest(args: list[str]) -> RunResult uses Proc {
    let argv: list[str] = ["tools/hltest.py"]
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    return run_capture("python3", argv)
}

fn find_from(s: str, needle: str, from: int) -> int {
    if from >= s.len() {
        return -1
    }
    let idx: int = s.slice(from, s.len()).find(needle)
    if idx < 0 {
        return -1
    }
    return idx + from
}

fn all_digits(s: str) -> bool {
    if s.len() == 0 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b < 48 || b > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

# Recs — the parsed records of a __SNAP__ stream (tests empty) or a
# v1 store (tests filled), the battery's parse_snapshot_records /
# load_store outcome.
struct Recs {
    tests: list[str],
    names: list[str],
    vals: list[str],
    err: str
}

# scan_stream(src) — the documented stream grammar: find the marker,
# read `name len\n` + value bytes + `\n`, resume after each consumed
# value (value content is never re-scanned).
fn scan_stream(src: str) -> Recs {
    let r: Recs = Recs { tests: [], names: [], vals: [], err: "" }
    let n: int = src.len()
    let mut i: int = 0
    while i < n {
        let k: int = find_from(src, "__SNAP__ ", i)
        if k < 0 {
            break
        }
        let j: int = find_from(src, "\n", k)
        if j < 0 {
            r.err = "unterminated record header"
            return r
        }
        let rest: str = src.slice(k + 9, j)
        let sp: int = rest.find(" ")
        if sp < 0 {
            r.err = "record header is missing its length field"
            return r
        }
        let name: str = rest.slice(0, sp)
        let lenb: str = rest.slice(sp + 1, rest.len())
        if !all_digits(lenb) {
            r.err = "malformed record length " + lenb
            return r
        }
        let ln: int = lenb.to_int()
        let vstart: int = j + 1
        let vend: int = vstart + ln
        if vend > n {
            r.err = "record '" + name + "' declares bytes past EOF"
            return r
        }
        if src.byte_at(vend) != 10 {
            r.err = "record '" + name + "' is missing its frame separator"
            return r
        }
        r.names.push(name)
        r.vals.push(src.slice(vstart, vend))
        i = vend + 1
    }
    return r
}

# scan_store(src) — the v1 store grammar: two fixed header lines, then
# `@@@ <test> <name> <len>\n<value>\n` frames.
fn scan_store(src: str) -> Recs {
    let r: Recs = Recs { tests: [], names: [], vals: [], err: "" }
    let n: int = src.len()
    let mut i: int = 0
    let mut hdr: int = 0
    while hdr < 2 {
        let j: int = find_from(src, "\n", i)
        if j < 0 {
            r.err = "truncated store header"
            return r
        }
        i = j + 1
        hdr = hdr + 1
    }
    while i < n {
        let j: int = find_from(src, "\n", i)
        if j < 0 {
            r.err = "truncated record header"
            return r
        }
        let line: str = src.slice(i, j)
        if !line.starts_with("@@@ ") {
            r.err = "expected a record at the store body"
            return r
        }
        let rest: str = line.slice(4, line.len())
        let sp1: int = rest.find(" ")
        if sp1 < 0 {
            r.err = "malformed record header"
            return r
        }
        let tname: str = rest.slice(0, sp1)
        let rest2: str = rest.slice(sp1 + 1, rest.len())
        let sp2: int = rest2.find(" ")
        if sp2 < 0 {
            r.err = "malformed record header"
            return r
        }
        let sname: str = rest2.slice(0, sp2)
        let lenb: str = rest2.slice(sp2 + 1, rest2.len())
        if !all_digits(lenb) {
            r.err = "malformed record length " + lenb
            return r
        }
        let ln: int = lenb.to_int()
        let vstart: int = j + 1
        let vend: int = vstart + ln
        if vend > n - 1 {
            r.err = "record value runs past EOF"
            return r
        }
        if src.byte_at(vend) != 10 {
            r.err = "record is missing its frame separator"
            return r
        }
        r.tests.push(tname)
        r.names.push(sname)
        r.vals.push(src.slice(vstart, vend))
        i = vend + 1
    }
    return r
}

# store_headers(text) — the `@@@ ...` record-header lines, in file order.
fn store_headers(text: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).starts_with("@@@ ") {
            out.push(lines.get(i))
        }
        i = i + 1
    }
    return out
}

# dir_exists via the builtin (fs_is_dir, Stage 36).
fn dir_exists(p: str) -> bool uses Fs {
    return fs_is_dir(p)
}

# ----------------------------------------------------------------------------
# 1. the assertion emits the exact wire protocol
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 1 — the assertion emits the exact wire protocol")
    let probe: str = write_src(acc, "s1/probe.hls", probe_src())
    let r: RunResult = boot(acc, [probe])
    check(acc, "assert_snapshot writes marker line + length-prefixed value + frame separator, byte for byte",
        r.code == 0 && r.out == probe_want(),
        "rc=" + r.code.to_str())
    # The parser reads the records back: -u on the test-shaped probe
    # must write exactly the canonical store for the three records
    # (the embedded marker-lookalike line is data, not framing).
    let recp: str = write_src(acc, "s1/records.hls", records_src())
    let ru: RunResult = hltest(["-u", recp])
    let got: str = read_or(acc.scratch_base + "/s1/__snapshots__/records.snap", "")
    check(acc, "the parser reads the records back (the embedded marker-lookalike line is data, not framing)",
        ru.code == 0 && got == records_store(), clip(ru.out, 100))
    # Interleaved diagnostics never leak into values.
    let intp: str = write_src(acc, "s1/interleave.hls", interleave_src())
    let ri: RunResult = hltest(["-u", intp])
    let got2: str = read_or(acc.scratch_base + "/s1/__snapshots__/interleave.snap", "")
    check(acc, "diagnostic println lines between records never leak into values",
        ri.code == 0 && got2 == interleave_store(), clip(ri.out, 100))
    # A marker glued mid-line by preceding print() noise still parses.
    let glp: str = write_src(acc, "s1/glue.hls", glue_src())
    let rg: RunResult = hltest(["-u", glp])
    let got3: str = read_or(acc.scratch_base + "/s1/__snapshots__/glue.snap", "")
    check(acc, "a marker glued mid-line by preceding print() noise still parses",
        rg.code == 0 && got3 == glue_store(), clip(rg.out, 100))
    # A tainted value cannot be snapshotted (both front-ends).
    let rc: RunResult = boot_check(acc, fail_taint())
    check(acc, "a tainted value is a compile error naming assert_snapshot (interpreter front-end)",
        rc.code == 1 && rc.err.contains("tainted[str]") && rc.err.contains("assert_snapshot"),
        clip(rc.combined, 90))
    if file_exists("bin/hlc") && which("gcc") {
        let sink: str = scratch(acc, "s1/x.c")
        let rn: RunResult = run_capture("./bin/hlc", [fail_taint(), sink])
        check(acc, "the native front-end rejects the tainted value with the same words",
            rn.code != 0 && rn.err.contains("tainted[str]") && rn.err.contains("assert_snapshot"),
            clip(rn.err, 90))
    } else {
        fail_msg(acc, "bin/hlc missing — the native front-end half of section 1 could not run")
    }
}

# ----------------------------------------------------------------------------
# 2. the store: record, frame, fixed point
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 2 — the store: record, frame, fixed point")
    let work: str = write_src(acc, "s2/fixture.hls", read_file(fixture_path()))
    let r: RunResult = hltest([work])
    check(acc, "verify without a store fails with 'new snapshot' + the recording hint (exit 1)",
        r.code == 1 && r.out.contains("new snapshot 'greeting'")
            && r.out.contains("--update-snapshots"), clip(r.out, 90))
    let ru: RunResult = hltest(["-u", work])
    let store: str = acc.scratch_base + "/s2/__snapshots__/fixture.snap"
    check(acc, "-u records the snapshots and writes the store at __snapshots__/<stem>.snap",
        ru.code == 0 && file_exists(store), clip(ru.out, 90))
    let committed: str = read_file(committed_store())
    let recorded: str = read_file(store)
    check(acc, "the recorded store is byte-identical to the committed one (deterministic serialization: magic line, generator note, sorted @@@ records)",
        recorded == committed, "")
    check(acc, "the store header is the two fixed v1 lines",
        recorded.starts_with(store_header()), "")
    check(acc, "records are framed '@@@ <test> <name> <len>' + value + separator",
        recorded.contains("@@@ test_snapshot_plain greeting 15\nhello, snapshot\n")
            && recorded.contains("@@@ test_snapshot_empty empty 0\n\n"), "")
    let heads: list[str] = store_headers(recorded)
    let mut sorted_ok: bool = heads.len() > 0
    let mut i: int = 1
    while i < heads.len() {
        if heads.get(i) < heads.get(i - 1) {
            sorted_ok = false
        }
        i = i + 1
    }
    check(acc, "records are sorted by (test, name) so reruns do not churn the file",
        sorted_ok, heads.len().to_str() + " records")
    let r2: RunResult = hltest(["-u", work])
    check(acc, "a second -u changes nothing (no rewrite, no report line)",
        r2.code == 0 && !r2.out.contains("store(s) updated")
            && read_file(store) == recorded, clip(r2.out, 90))
    let r3: RunResult = hltest([work])
    check(acc, "verify passes against the recorded store (6 pass, 0 fail)",
        r3.code == 0 && r3.out.contains("6 pass, 0 fail"), clip(r3.out, 90))
}

# ----------------------------------------------------------------------------
# 3. the verify: diffs, and the corrupt-store matrix
# ----------------------------------------------------------------------------
fn corrupt_leg(acc: Acc, root: str, name: str, needle: str, tampered: str) -> void uses IO, Fs, Proc {
    let dir: str = root + "/s3c/" + name
    let f: str = write_src(acc, "s3c/" + name + "/fixture.hls", read_file(fixture_path()))
    let sp: str = dir + "/__snapshots__/fixture.snap"
    mkdirs(path_dir3(sp))
    write_file(sp, tampered)
    let rv: RunResult = hltest([f])
    let mut good: bool = rv.code == 1 && rv.out.contains("<snapshots>")
        && rv.out.contains("corrupt") && rv.out.contains(needle)
    let ru: RunResult = hltest(["-u", f])
    let kept: str = read_or(sp, "")
    good = good && ru.code == 1 && kept == tampered
    check(acc, "store tampered (" + name + ") -> <snapshots> failure mentioning '" + needle
        + "', and -u refuses to regenerate over it", good, clip(rv.out, 110))
}

fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 3 — the verify: diffs, and the corrupt-store matrix")
    let mut_src: str = str_replace(read_file(fixture_path()), "hello, snapshot", "hello, CHANGED!")
    let mut_p: str = write_src(acc, "s3/fixture.hls", mut_src)
    let recorded: str = read_file(acc.scratch_base + "/s2/__snapshots__/fixture.snap")
    mkdirs(acc.scratch_base + "/s3/__snapshots__")
    write_file(acc.scratch_base + "/s3/__snapshots__/fixture.snap", recorded)
    let r: RunResult = hltest([mut_p])
    check(acc, "a changed value fails with a unified diff and the accept hint",
        r.code == 1 && r.out.contains("snapshot 'greeting' differs")
            && r.out.contains("--- stored") && r.out.contains("+++ received")
            && r.out.contains("-hello, snapshot") && r.out.contains("+hello, CHANGED!")
            && r.out.contains("--update-snapshots to accept"), clip(r.out, 110))
    let ru: RunResult = hltest(["-u", mut_p])
    check(acc, "-u accepts the change and records the new bytes",
        ru.code == 0 && ru.out.contains("~1 changed")
            && read_file(acc.scratch_base + "/s3/__snapshots__/fixture.snap").contains("hello, CHANGED!"),
        clip(ru.out, 90))
    # The corrupt-store matrix.
    let raw: str = read_file(committed_store())
    corrupt_leg(acc, acc.scratch_base, "bad-magic", "magic line",
        "# not a store at all\n" + raw)
    let i1: int = raw.find("\n")
    let i2: int = find_from(raw, "\n", i1 + 1)
    corrupt_leg(acc, acc.scratch_base, "bad-header", "non-canonical store header",
        raw.slice(0, i1) + "\n# wrong note\n" + raw.slice(i2 + 1, raw.len()))
    corrupt_leg(acc, acc.scratch_base, "truncated-mid-record", "runs past EOF",
        raw.slice(0, raw.len() - 2))
    corrupt_leg(acc, acc.scratch_base, "missing-final-separator", "frame separator",
        raw.slice(0, raw.len() - 1))
    corrupt_leg(acc, acc.scratch_base, "length-overrun", "runs past EOF",
        str_replace(raw, "@@@ test_snapshot_two_records second 3",
            "@@@ test_snapshot_two_records second 99"))
    corrupt_leg(acc, acc.scratch_base, "duplicate-record", "duplicate record",
        raw + "@@@ test_snapshot_plain greeting 15\nhello, snapshot\n")
    corrupt_leg(acc, acc.scratch_base, "invalid-name", "invalid test or snapshot name",
        str_replace(raw, "greeting", "gr;eting"))
}

# ----------------------------------------------------------------------------
# 4. new and obsolete snapshots, grep safety, panics
# ----------------------------------------------------------------------------
fn copy_store(acc: Acc, sub: str, recorded: str) -> void uses Fs, Proc {
    mkdirs(acc.scratch_base + "/" + sub + "/__snapshots__")
    write_file(acc.scratch_base + "/" + sub + "/__snapshots__/fixture.snap", recorded)
}

fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 4 — new and obsolete snapshots, grep safety, panics")
    let recorded: str = read_file(acc.scratch_base + "/s2/__snapshots__/fixture.snap")
    # A new assertion is a verify failure until recorded.
    let newf: str = write_src(acc, "s4/fixture.hls",
        str_replace(read_file(fixture_path()),
            "assert_snapshot(\"first\", \"one\")",
            "assert_snapshot(\"first\", \"one\")\n    assert_snapshot(\"extra\", \"bonus\")"))
    let r: RunResult = hltest([newf])
    check(acc, "a new assertion fails verify until it is recorded",
        r.code == 1 && r.out.contains("new snapshot 'extra'"), clip(r.out, 90))
    copy_store(acc, "s4", recorded)
    let ru: RunResult = hltest(["-u", newf])
    check(acc, "-u records the new snapshot",
        ru.code == 0 && ru.out.contains("+1 new")
            && read_file(acc.scratch_base + "/s4/__snapshots__/fixture.snap")
                .contains("@@@ test_snapshot_two_records extra 5\nbonus\n"),
        clip(ru.out, 90))
    # A removed assertion is an obsolete failure naming the record.
    let delf: str = write_src(acc, "s4b/fixture.hls",
        str_replace(read_file(fixture_path()),
            "    assert_snapshot(\"padded\", \"  keep my spaces  \")\n", ""))
    copy_store(acc, "s4b", recorded)
    let rd: RunResult = hltest([delf])
    check(acc, "a removed assertion fails verify naming the obsolete record",
        rd.code == 1 && rd.out.contains("obsolete snapshot 'padded'")
            && rd.out.contains("--update-snapshots"), clip(rd.out, 90))
    let rdu: RunResult = hltest(["-u", delf])
    check(acc, "-u prunes the obsolete record from the store",
        rdu.code == 0 && !read_file(acc.scratch_base + "/s4b/__snapshots__/fixture.snap").contains("padded"),
        clip(rdu.out, 90))
    # A deleted TEST FUNCTION is a file-level <snapshots> failure.
    let nofn: str = write_src(acc, "s4c/fixture.hls", nofn_src())
    copy_store(acc, "s4c", recorded)
    let rn: RunResult = hltest([nofn])
    check(acc, "a deleted test function fails with the file-level <snapshots> entry naming it",
        rn.code == 1 && rn.out.contains("<snapshots>")
            && rn.out.contains("not in the file")
            && rn.out.contains("test_snapshot_multiline"), clip(rn.out, 110))
    let rnu: RunResult = hltest(["-u", nofn])
    let sp: str = acc.scratch_base + "/s4c/__snapshots__/fixture.snap"
    let heads: list[str] = store_headers(read_or(sp, ""))
    let mut only_plain: bool = heads.len() >= 1
    let mut i: int = 0
    while i < heads.len() {
        if !heads.get(i).starts_with("@@@ test_snapshot_plain ") {
            only_plain = false
        }
        i = i + 1
    }
    check(acc, "-u prunes the deleted function's records and keeps the rest",
        rnu.code == 0 && only_plain, clip(rnu.out, 90))
    # --grep never mislabels filtered tests.
    let rg: RunResult = hltest(["--grep", "test_snapshot_plain", nofn])
    check(acc, "--grep runs stay silent about tests that did not run (verify)",
        rg.code == 0 && !rg.out.contains("not in the file")
            && !rg.out.contains("obsolete"), clip(rg.out, 90))
    let sp_before: str = read_file(sp)
    let rgu: RunResult = hltest(["-u", "--grep", "test_snapshot_plain", nofn])
    check(acc, "--grep updates never touch the filtered tests' records",
        rgu.code == 0 && read_file(sp) == sp_before, clip(rgu.out, 90))
    # A panicking test's partial records are never recorded.
    let pan: str = write_src(acc, "s4d/panic.hls", panic_src())
    let rp: RunResult = hltest(["-u", pan])
    check(acc, "a panicking test fails with its panic, and its partial records are never written to a store",
        rp.code == 1 && rp.out.contains("boom")
            && !dir_exists(acc.scratch_base + "/s4d/__snapshots__"), clip(rp.out, 90))
}

# ----------------------------------------------------------------------------
# 5. the protocol errors
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 5 — the protocol errors")
    # Duplicate name in one test (HLS level).
    let dupp: str = write_src(acc, "s5/dup.hls", dup_src())
    let r: RunResult = hltest([dupp])
    check(acc, "a duplicate snapshot name in one test fails verify",
        r.code == 1 && r.out.contains("duplicate snapshot name 'a'"), clip(r.out, 90))
    # Malformed / adversarial stream bytes, printed verbatim by a test
    # fn so the RUNNER's parser (the same parser verify drives) reads
    # them; the parse error becomes the failure detail.
    let streams: list[str] = adv_streams()
    let labels: list[str] = adv_labels()
    let needles: list[str] = adv_needles()
    let mut i: int = 0
    while i < streams.len() {
        let stream: str = streams.get(i)
        let src: str = "import \"std.test\"\n" +
            "\n" +
            "fn test_adv" + i.to_str() + "() uses IO {\n" +
            "    print(\"" + esc_str(stream) + "\")\n" +
            "}\n" +
            "\n" +
            "fn main() -> int uses IO {\n" +
            "    return 0\n" +
            "}\n"
        let p: str = write_src(acc, "s5/adv" + i.to_str() + ".hls", src)
        let ra: RunResult = hltest([p])
        check(acc, "the parser rejects " + labels.get(i) + " ('" + clip(stream, 28) + "')",
            ra.code == 1 && ra.out.contains(needles.get(i)), clip(ra.out, 110))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 6. the runner integration
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 6 — the runner integration")
    # Parallel -u across two directories.
    let fa: str = write_src(acc, "s6/a/alpha.hls", read_file(fixture_path()))
    let fb: str = write_src(acc, "s6/b/beta.hls",
        str_replace(read_file(fixture_path()), "hello, snapshot", "other value"))
    let r: RunResult = hltest(["-j", "4", "-u", "-r", acc.scratch_base + "/s6"])
    let sa: str = acc.scratch_base + "/s6/a/__snapshots__/alpha.snap"
    let sb: str = acc.scratch_base + "/s6/b/__snapshots__/beta.snap"
    check(acc, "parallel -u writes each file's own store, values never cross files",
        r.code == 0 && file_exists(sa) && file_exists(sb)
            && read_or(sa, "").contains("@@@ test_snapshot_plain greeting 15\nhello, snapshot\n")
            && read_or(sb, "").contains("@@@ test_snapshot_plain greeting 11\nother value\n"),
        clip(r.out, 110))
    # Exit codes follow the suite contract (a FRESH mismatch).
    mkdirs(acc.scratch_base + "/s6c/__snapshots__")
    let mut2: str = acc.scratch_base + "/s6c/fixture.hls"
    write_file(mut2, read_file(fixture_path()))
    write_file(acc.scratch_base + "/s6c/__snapshots__/fixture.snap",
        read_file(committed_store()))
    write_file(mut2, str_replace(read_file(mut2), "hello, snapshot", "hello, MISMATCH!"))
    check(acc, "exit codes: 0 when snapshots verify, 1 when any fails",
        hltest([fa]).code == 0 && hltest([mut2]).code == 1, "")
    # JUnit carries the diff in the failure node.
    let jpath: str = acc.scratch_base + "/s6/j.xml"
    let jr: RunResult = hltest(["--junit", jpath, mut2])
    let xml: str = read_or(jpath, "")
    check(acc, "the JUnit XML failure node carries the unified diff",
        jr.code == 1 && xml.contains("<failure")
            && xml.contains("'greeting' differs") && xml.contains("+hello, MISMATCH!"),
        clip(jr.out, 90))
    # Files without snapshots pay nothing.
    let r18: RunResult = hltest(["tests/ok/feat_stage18_hltest.hls"])
    let no_store: bool = !file_exists("tests/ok/__snapshots__/feat_stage18_hltest.snap")
    check(acc, "a file without snapshots runs unchanged and never grows a store",
        r18.code == 0 && r18.out.contains("12 pass, 0 fail") && no_store,
        clip(r18.out, 90))
    # Store path convention: __snapshots__/<stem>.snap next to the file.
    let convp: str = write_src(acc, "s6p/conv/feat.hls", conv_src())
    let rc: RunResult = hltest(["-u", convp])
    check(acc, "store_path_for: __snapshots__/<stem>.snap next to the test file",
        rc.code == 0 && file_exists(acc.scratch_base + "/s6p/conv/__snapshots__/feat.snap"),
        clip(rc.out, 90))
}

# ----------------------------------------------------------------------------
# 7. the differential: one store, both backends
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 7 — the differential: one store, both backends")
    if file_exists("bin/hlc") && which("gcc") {
        let c: str = scratch(acc, "s7.c")
        let e: str = scratch(acc, "s7")
        let b: RunResult = run_capture("./bin/hlc", [fixture_path(), c])
        let g: RunResult = run_capture("gcc", ["-O2", "-o", e, c, "-lm", "-pthread"])
        if b.code == 0 && g.code == 0 {
            let rn: RunResult = run_capture(e, [])
            let ri: RunResult = boot(acc, [fixture_path()])
            check(acc, "the fixture's protocol output is byte-identical: interpreter vs native (println parity)",
                rn.code == 0 && rn.out == ri.out, "native rc=" + rn.code.to_str())
            # The native run's parsed records equal the committed
            # store's values (one store serves both backends).
            let nat: Recs = scan_stream(rn.out)
            let stored: Recs = scan_store(read_file(committed_store()))
            let mut ok: bool = nat.err == "" && stored.err == ""
                && nat.names.len() == stored.names.len()
            let mut i: int = 0
            while i < nat.names.len() && ok {
                let mut found: bool = false
                let mut j: int = 0
                while j < stored.names.len() {
                    if stored.names.get(j) == nat.names.get(i)
                        && stored.vals.get(j) == nat.vals.get(i) {
                        found = true
                    }
                    j = j + 1
                }
                if !found {
                    ok = false
                }
                i = i + 1
            }
            check(acc, "the native run's parsed records equal the committed store's values (one store serves both backends)",
                ok, "protocol: " + nat.err + " / store: " + stored.err)
        } else {
            check(acc, "the native build of the fixture failed", false,
                clip(b.err, 60) + " / " + clip(g.err, 60))
        }
    } else {
        fail_msg(acc, "the native half of the differential could not run (no gcc or no bin/hlc)")
    }
    # -u on a copy regenerates the committed store byte for byte
    # (proven in section 2, restated as the differential contract).
    let recorded: str = read_or(acc.scratch_base + "/s2/__snapshots__/fixture.snap", "")
    let committed: str = read_file(committed_store())
    check(acc, "-u on a fresh copy reproduces the committed store byte for byte",
        recorded == committed, "")
}

# ----------------------------------------------------------------------------
# 8. the fixed point and tree hygiene
# ----------------------------------------------------------------------------
fn sec8(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 8 — the fixed point and tree hygiene")
    # The committed store verifies green in-tree.
    let r: RunResult = hltest([fixture_path()])
    check(acc, "the committed store verifies the committed fixture green",
        r.code == 0 && r.out.contains("6 pass, 0 fail"), clip(r.out, 90))
    # -u is idempotent: no rewrite, no report line, no .tmp leftovers.
    let before: str = read_file(committed_store())
    let ru: RunResult = hltest(["-u", fixture_path()])
    let after: str = read_file(committed_store())
    let listing: list[str] = fs_read_dir("tests/ok/__snapshots__")
    let mut leftovers: int = 0
    let mut i: int = 0
    while i < listing.len() {
        if listing.get(i).ends_with(".tmp") {
            leftovers = leftovers + 1
        }
        i = i + 1
    }
    check(acc, "-u on the committed fixture is a no-op (bytes, report, no .tmp)",
        ru.code == 0 && before == after && !ru.out.contains("store(s) updated")
            && leftovers == 0, clip(ru.out, 90))
    # The fixture is a formatter fixed point.
    let fr: RunResult = run_capture("./bin/hlfmt", ["-c", fixture_path()])
    check(acc, "the fixture is an hlfmt fixed point",
        fr.code == 0 && fr.out.contains("already formatted"), clip(fr.out, 80))
    # The fail probe is rejected by the full suite contract.
    let rc: RunResult = boot_check(acc, fail_taint())
    check(acc, "the taint fail file rejects under --check with exit 1",
        rc.code == 1 && rc.err.contains("tainted"), clip(rc.err, 90))
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("snapshot")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    sec8(acc)
    return finish(acc, "Stage 119 -- hltest snapshot testing (assert_snapshot)")
}
