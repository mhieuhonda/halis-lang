# ============================================================================
# tests/acc/release_acceptance.hls — Stage 150 acceptance gate, in Halis
# (the Halis twin of tests/release_acceptance.py; same six sections,
# same assertions, same needles — the harness is tests/acc/harness.hls
# and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Six sections over the REAL tree and a REAL scratch git world (seeded
# under tests/.acc-scratch/release/, the gate's scratch world) — the
# release judged where it lands, at both legal states of the line.
#
# The battery set GIT_* env vars for every child so the scratch
# commits carry a pinned committer day; the gate does the same with
# std.env before the first child spawns.
#
#  1. the state     — the tree this gate runs on is a legal state of
#     law              the candidate line: the eve (the rc.4 anchor
#                      stands, no line declared) or the release (the
#                      anchor retired with the release commit, the LTS
#                      line declared). A half-cut release — an anchor
#                      gone without a line, or a line under a live
#                      anchor — is not a state, and the gate names it.
#                      The roadmap parses to exactly 150 rows, numbered
#                      1..150, the closed prefix contiguous; the three
#                      version markers speak with one voice;
#  2. the retirement — the RC kit answers as its state demands: on the
#     law               eve, readiness/gate/record/signoff all green;
#                       after the release, every one of them refuses,
#                       NAMED — readiness on both the roadmap law and
#                       the lts law, gate, record and witness on the
#                       missing anchor. The kit that certified the road
#                       does not pretend (0) and does not crash (101)
#                       when its office closes;
#  3. the line       — the clock the release opens, on the real tree:
#     law               `.hls-lts.json` declares branch release/1.0
#                       from the v1.0.0 tag, the branch stands where
#                       the tag stands, `hls-lts status` reads the
#                       gate and the clock, and LTS.md still matches
#                       its render — the promise and the clock are
#                       the same numbers;
#  4. the wrong      — a scratch world runs the release day: the
#     turns, the cut    wrong turns refused by name (a bare v1.0.0 is
#                       not a candidate, a pre-release is not an LTS
#                       base, a pre-1.0 tag is not a line, the line
#                       opens only on a tag that exists), then the
#                       cut — the markers move, the anchor retires
#                       with the release commit, the tag is cut, the
#                       line opens, the clock starts, the RC kit
#                       retires named;
#  5. the docs law   — the release speaks where the road wrote:
#                       RELEASES.md's head section is the release's
#                       own, the roadmap's last row keeps its phrase,
#                       the README tour carries the gate, the clock
#                       and the line;
#  6. the corpus     — tests/ok/feat_stage150_release.hls is hlfmt-
#     showcase          canonical, hllint-clean, boots through the
#                       real checker, runs green on the interpreter
#                       and (when bin/hlc exists) matches natively
#                       byte for byte.
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.json"
import "std.env"

# ----------------------------------------------------------------------------
# The gate's data (the battery's constants).
# ----------------------------------------------------------------------------

fn scratch_day() -> str {
    return "2026-10-29"
}

fn freeze_digest() -> str {
    return "84d1068f80d62f3f741785ce2241b423fa5bd36b4e28e0a872c6e772e4decaf6"
}

fn showcase() -> str {
    return "tests/ok/feat_stage150_release.hls"
}

fn showcase_out() -> str {
    return "stage 150: v1.0.0\n"
        + "  RELEASE laws OK: order, handoff, retirement, window, "
        + "marker, line\n"
}

# the REAL tail titles — the rows whose parentheticals name each
# candidate's identity
fn road_title(n: int) -> str {
    if n == 146 { return "v1.0 Release Candidate 1 (feature freeze)" }
    if n == 147 { return "v1.0 Release Candidate 2 (bug-fix only)" }
    if n == 148 { return "v1.0 Release Candidate 3 (final dry-run)" }
    if n == 149 { return "v1.0 Release Candidate 4 (sign-off)" }
    if n == 150 { return "HLS v1.0 — LTS release" }
    return "stage " + n.to_str() + " title"
}

fn header(title: str) -> void uses IO {
    println("")
    println("--- " + title + " ---")
}

# ----------------------------------------------------------------------------
# Port helpers — the battery's world builders and needle tools.
# ----------------------------------------------------------------------------

# rc(args, repo) — the battery's rc(*argv, cwd): the RC kit with --root
# pinned to the world. The battery runs the child with cwd=repo — the
# kit spawns its own git children in ITS cwd — so the gate chdirs to
# the world for the spawn and restores the repo root after.
fn rc(args: list[str], repo: str) -> RunResult uses Proc {
    let home: str = cwd_get()
    let argv: list[str] = []
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    argv.push("--root")
    argv.push(repo)
    env_set_current_dir(repo)
    let r: RunResult = run_capture(path_join3(home, "bin/hls-rc"), argv)
    env_set_current_dir(home)
    return r
}

# lts(args, repo) — the battery's lts(*argv, cwd), the same chdir dance.
fn lts(args: list[str], repo: str) -> RunResult uses Proc {
    let home: str = cwd_get()
    let argv: list[str] = []
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    argv.push("--repo")
    argv.push(repo)
    env_set_current_dir(repo)
    let r: RunResult = run_capture(path_join3(home, "bin/hls-lts"), argv)
    env_set_current_dir(home)
    return r
}

fn git(repo: str, args: list[str]) -> RunResult uses Proc {
    let argv: list[str] = ["-C", repo]
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    return run_capture("git", argv)
}

# wf(repo, rel, content) — write inside a world, parents made.
fn wf(repo: str, rel: str, content: str) -> void uses Fs, Proc {
    let p: str = path_join3(repo, rel)
    mkdirs(path_dir3(p))
    write_file(p, content)
}

fn rf(repo: str, rel: str) -> str uses Fs {
    return read_file(path_join3(repo, rel))
}

fn has(repo: str, rel: str) -> bool uses Fs {
    return file_exists(path_join3(repo, rel))
}

fn commit_all(repo: str, msg: str) -> str uses Proc {
    git(repo, ["add", "-A"])
    git(repo, ["commit", "-q", "-m", msg])
    let r: RunResult = git(repo, ["rev-parse", "HEAD"])
    return r.out.trim()
}

# JSON accessors with the battery's .get(key, default) semantics.
fn jget_str(v: JsonValue, key: str) -> str {
    let x: JsonValue = json_object_get(v, key)
    if json_is_str(x) {
        return json_str_value(x)
    }
    return ""
}

fn parse_json_or_null(text: str) -> JsonValue {
    let rr: Result[JsonValue, str] = json_parse_result(text)
    if result_is_ok(rr) {
        return result_unwrap(rr)
    }
    return json_null()
}

fn pad2(n: int) -> str {
    let s: str = n.to_str()
    if s.len() < 2 {
        return "0" + s
    }
    return s
}

# dec_int(s) — a plain decimal string to int (the battery's int() on
# gate-built digit strings; -1 guards the caller on anything else).
fn dec_int(s: str) -> int {
    if s.len() == 0 || s.len() > 9 {
        return -1
    }
    let mut n: int = 0
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b < 48 || b > 57 {
            return -1
        }
        n = n * 10 + (b - 48)
        i = i + 1
    }
    return n
}

fn pad4(n: int) -> str {
    let s: str = n.to_str()
    let mut out: str = s
    while out.len() < 4 {
        out = "0" + out
    }
    return out
}

# add_years(day, n) — base + N years — an anniversary, not a count of
# days: February 29 clamps to the 28th when the target year is not
# leap (the calendar law the tool enforces, re-derived here).
fn add_years(day: str, n: int) -> str {
    let parts: list[str] = day.split("-")
    let y: int = dec_int(parts.get(0)) + n
    let m: int = dec_int(parts.get(1))
    let d: int = dec_int(parts.get(2))
    let leap: bool = y % 400 == 0 || (y % 100 != 0 && y % 4 == 0)
    let mut dd: int = d
    if m == 2 && d == 29 && !leap {
        dd = 28
    }
    return pad4(y) + "-" + pad2(m) + "-" + pad2(dd)
}

# head_version() — the head release of the tree's record — RELEASES.md
# since v1.0.0 retired the changelog; the old CHANGELOG.md remains a
# fallback so an eve-shaped tree still reads.
fn head_version() -> str uses Fs {
    let docs: list[str] = ["RELEASES.md", "CHANGELOG.md"]
    let mut i: int = 0
    while i < docs.len() {
        if file_exists(docs.get(i)) {
            let lines: list[str] = read_file(docs.get(i)).split("\n")
            let mut j: int = 0
            while j < lines.len() {
                let line: str = lines.get(j)
                if line.starts_with("## [v") {
                    let end: int = line.find("]")
                    let start: int = line.find("[v")
                    if end > start {
                        return line.slice(start + 2, end)
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return ""
}

# release_state() — the candidate line's legal states, read off the
# real tree: 'eve' — the anchor stands, no line declared (Stage 150
# has not run); 'released' — the anchor retired with the release
# commit and the LTS line is declared. Anything else is a half-cut
# release, and a half-cut release is not a state.
fn release_state() -> str uses Fs {
    let anchor: bool = file_exists(".hls-rc.json")
    let line: bool = file_exists(".hls-lts.json")
    if anchor && !line {
        return "eve"
    }
    if line && !anchor {
        return "released"
    }
    return "half-cut"
}

# ----------------------------------------------------------------------------
# RRow — one stage row of the roadmap, parsed the way the kit reads it.
# ----------------------------------------------------------------------------

struct RRow {
    num: int,
    title: str,
    status: str,
    effort: str,
    open: bool
}

# roadmap_rows() — any row whose first cell parses as a stage number
# (1..3 digits) is a stage row; a narrow row (a cancelled stage — row
# 122 carries no status cells at all) is neither ticked nor open.
fn roadmap_rows() -> list[RRow] uses Fs {
    let out: list[RRow] = []
    let src: str = read_or("ROADMAP.md", "")
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if line.starts_with("|") {
            let cells: list[str] = line.split("|")
            if cells.len() >= 3 {
                let num_s: str = cells.get(1).trim()
                let mut digits: bool = num_s.len() > 0 && num_s.len() <= 3
                let mut k: int = 0
                while digits && k < num_s.len() {
                    let b: int = num_s.byte_at(k)
                    if b < 48 || b > 57 {
                        digits = false
                    }
                    k = k + 1
                }
                if digits {
                    let wide: bool = cells.len() >= 5
                    let mut status: str = ""
                    let mut effort: str = ""
                    if wide {
                        status = cells.get(3).trim()
                        effort = cells.get(4).trim()
                    }
                    out.push(RRow {
                        num: dec_int(num_s),
                        title: cells.get(2).trim(),
                        status: status,
                        effort: effort,
                        open: status.contains("⬜") || status.contains("🔄")
                    })
                }
            }
        }
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# The scratch world — Stage 149 closed, the eve of the release.
# ----------------------------------------------------------------------------

fn seed_world(acc: Acc, name: str) -> str uses IO, Fs, Proc, Exit {
    let repo: str = scratch(acc, name)
    mkdirs(repo)
    let init: RunResult = git(repo, ["init", "-q", "-b", "main"])
    if init.code != 0 {
        # a world that is not its own repository would commit into the
        # gate's OUTER repo — refuse loudly instead
        println("release-acceptance: git init failed in " + repo + " — " + init.err)
        exit(2)
    }
    let rows: list[str] = []
    let mut n: int = 1
    while n <= 150 {
        let mut st: str = "⬜"
        if n <= 149 {
            st = "✅"
        }
        rows.push("| " + n.to_str() + " | " + road_title(n) + " | " + st
            + " | (done in v0.1.0) |")
        n = n + 1
    }
    wf(repo, "ROADMAP.md", "# ROADMAP\n\n"
        + "| # | Stage | Status | Effort |\n"
        + "|---|-------|--------|--------|\n" + str_join(rows, "\n") + "\n")
    wf(repo, "CHANGELOG.md",
        "## [v1.0.0-rc.4] — Stage 149: the sign-off\n- the body\n")
    wf(repo, "snapshot/MANIFEST.json",
        "{\"closure\": {}, \"version\": \"v1.0.0-rc.4\"}")
    wf(repo, "editors/vscode/halis/package.json",
        "{\"name\": \"halis\", \"version\": \"1.0.0-rc.4\"}")
    wf(repo, "LTS.md", "the promise\n")
    wf(repo, "snapshot/hlc.c", "int main(void){return 0;}\n")
    git(repo, ["add", "-A"])
    git(repo, ["commit", "-q", "-m", "seed"])
    let frozen: str = git(repo, ["rev-parse", "HEAD"]).out.trim()
    let freeze: str = "{\"digest\": \"" + freeze_digest()
        + "\", \"frozen_commit\": \"" + frozen
        + "\", \"release\": \"0.159.0-alpha\", \"stage\": 141"
        + ", \"surface\": {\"syntax\": {\"keywords\": [\"fn\"]}}"
        + ", \"surface_version\": 1, \"tool\": \"hls-freeze\"}"
    wf(repo, "tests/api_freeze.json", freeze)
    git(repo, ["add", "-A"])
    git(repo, ["commit", "-q", "-m", "the freeze document"])
    return repo
}

# ----------------------------------------------------------------------------
# 1. the state law — this tree, a legal state of the line
# ----------------------------------------------------------------------------

fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    let state: str = release_state()
    header("1. the state law — this tree, a legal state of the line")
    if state == "half-cut" {
        fail_msg(acc, "the tree is a HALF-CUT release (anchor and line "
            + "disagree) — not a state; restore one or the other")
    } else {
        check(acc, "the tree is a legal state of the line (" + state + ")",
            state == "eve" || state == "released", "")
        check(acc, "the candidate's record still travels (the last render "
            + "of the line)", file_exists("RC.md"), "")
        check(acc, "the line declaration only exists after the release",
            !file_exists(".hls-lts.json") || state == "released", "")
        # the road retired with the release: the roadmap and the
        # changelog left the tree, and RELEASES.md carries the record.
        # On an eve-shaped tree the old documents still read.
        if state == "released" {
            check(acc, "the roadmap retired with the release (the road is "
                + "kept, the diary is not)", !file_exists("ROADMAP.md"), "")
            check(acc, "the changelog retired with the release (the record "
                + "lives in RELEASES.md)", !file_exists("CHANGELOG.md"), "")
            check(acc, "the release record travels (RELEASES.md)",
                file_exists("RELEASES.md"), "")
        }
        if file_exists("ROADMAP.md") {
            # the stage table, parsed the way the kit reads it — 150
            # rows numbered 1..150, the closed prefix contiguous
            let rows: list[RRow] = roadmap_rows()
            check(acc, "the roadmap parses to exactly 150 stage rows ("
                + rows.len().to_str() + ")", rows.len() == 150, "")
            let mut in_order: bool = rows.len() == 150
            let mut closed: int = 0
            let mut opened: int = 0
            let mut i: int = 0
            while i < rows.len() {
                if rows.get(i).num != i + 1 {
                    in_order = false
                }
                if rows.get(i).open {
                    opened = opened + 1
                } else {
                    closed = closed + 1
                }
                i = i + 1
            }
            check(acc, "the rows are numbered 1..150 in order", in_order, "")
            if state == "eve" {
                let mut tail_is_150: bool = false
                if opened == 1 && closed > 0 {
                    # the one open row must be Stage 150
                    let mut j: int = 0
                    while j < rows.len() {
                        if rows.get(j).open {
                            tail_is_150 = rows.get(j).num == 150
                        }
                        j = j + 1
                    }
                }
                check(acc, "the eve roadmap: 149 closed, the tail is Stage 150",
                    opened == 1 && tail_is_150, "")
                check(acc, "149 stages closed on the eve (" + closed.to_str() + ")",
                    closed == 149, "")
            } else {
                check(acc, "the released roadmap: every stage ticked (nothing "
                    + "left to candidate for)", opened == 0, "")
                check(acc, "150 stages closed (" + closed.to_str() + ")",
                    closed == 150, "")
                let row150: RRow = rows.get(149)
                check(acc, "Stage 150's row keeps its own phrase ("
                    + row150.title + ")",
                    row150.title.contains("LTS release"), "")
                check(acc, "Stage 150's row names its release ("
                    + row150.effort + ")",
                    row150.effort.contains("v1.0.0"), "")
            }
        }
        # the three markers speak with one voice
        let head_v: str = head_version()
        let man_v: str = jget_str(parse_json_or_null(read_or(
            "snapshot/MANIFEST.json", "")), "version")
        let vs_v: str = jget_str(parse_json_or_null(read_or(
            "editors/vscode/halis/package.json", "")), "version")
        check(acc, "the three markers speak with one voice (" + head_v + ")",
            man_v == "v" + head_v && vs_v == head_v,
            "manifest=" + man_v + " vscode=" + vs_v)
        if state == "eve" {
            check(acc, "on the eve the voice is still the candidate's ("
                + head_v + ")", head_v == "1.0.0-rc.4", "")
        } else {
            check(acc, "the release's voice is v1.0.0 (" + head_v + ")",
                head_v == "1.0.0", "")
        }
    }
}

# ----------------------------------------------------------------------------
# 2. the retirement law — the kit answers as its state demands
# ----------------------------------------------------------------------------

fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    let state: str = release_state()
    header("2. the retirement law — the kit answers as its state demands")
    if state == "eve" {
        let r: RunResult = rc(["readiness"], ".")
        check(acc, "the eve tree is ready (the last candidate stands)",
            r.code == 0 && r.out.contains("READY"), "")
        let g: RunResult = rc(["gate"], ".")
        check(acc, "the gate over the live range names only BUGFIX and CHORE",
            g.code == 0, "")
        let rc2: RunResult = rc(["report", "--check"], ".")
        check(acc, "the committed record matches the render (drift refused)",
            rc2.code == 0, "")
        let s: RunResult = rc(["signoff", "--check"], ".")
        check(acc, "the signature is re-derived green on the eve",
            s.code == 0 && s.out.contains("signed off by"), "")
    } else if state == "released" {
        let r: RunResult = rc(["readiness"], ".")
        check(acc, "readiness refuses on BOTH laws, named (nothing left "
            + "to candidate for; a line is declared)",
            r.code == 1 && r.out.contains("NOT READY: the roadmap law")
                && r.out.contains("NOT READY: the lts law"), "")
        let g: RunResult = rc(["gate"], ".")
        check(acc, "the gate refuses on the missing anchor",
            g.code == 1 && g.combined.contains("no anchor"), "")
        let rc2: RunResult = rc(["report", "--check"], ".")
        check(acc, "the record refuses on the missing anchor",
            rc2.code == 1 && rc2.combined.contains("no anchor"), "")
        let s: RunResult = rc(["signoff", "--check"], ".")
        check(acc, "the witness refuses on the missing anchor (the office "
            + "closed with the release commit)",
            s.code == 1 && s.combined.contains("no anchor"), "")
    }
}

# ----------------------------------------------------------------------------
# 3. the line law — the clock on the real tree
# ----------------------------------------------------------------------------

fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    let state: str = release_state()
    header("3. the line law — the clock on the real tree")
    let p: RunResult = lts(["policy", "--check"], ".")
    check(acc, "LTS.md still matches its render (the promise and the "
        + "clock are the same numbers)", p.code == 0, "")
    if state == "eve" {
        check(acc, "no line is declared on the eve (a candidate opens no "
            + "window)", !file_exists(".hls-lts.json"), "")
        let promise: str = read_or("LTS.md", "")
        check(acc, "the promise names the day it becomes the clock",
            promise.contains("hls-lts init --tag v1.0.0"), "")
    } else if state == "released" {
        check(acc, "the line is declared (the promise became the clock)",
            file_exists(".hls-lts.json"), "")
        let decl: JsonValue = parse_json_or_null(read_or(".hls-lts.json", ""))
        check(acc, "the line's base is the release tag (" + jget_str(decl, "base_tag")
            + ")", jget_str(decl, "base_tag") == "v1.0.0", "")
        check(acc, "the line's branch is release/1.0 (" + jget_str(decl, "branch")
            + ")", jget_str(decl, "branch") == "release/1.0", "")
        check(acc, "the declaration carries the policy's name ("
            + jget_str(decl, "policy") + ")",
            jget_str(decl, "policy") == "halis-lts-1", "")
        let tag_sha: str = git(".", ["rev-parse", "v1.0.0^{commit}"]).out.trim()
        check(acc, "the base sha is the commit the tag names",
            jget_str(decl, "base_sha") == tag_sha && tag_sha != "", "")
        let branch_sha: str = git(".", ["rev-parse", "release/1.0^{commit}"]).out.trim()
        check(acc, "the branch stands where the release stands",
            branch_sha == tag_sha, "")
        check(acc, "the declaration records the day it opened",
            jget_str(decl, "created") != "", "")
        # the clock: windows read off the base commit's day
        let base_day: str = git(".", ["log", "-1", "--format=%cd",
            "--date=short", tag_sha]).out.trim()
        let bug_until: str = add_years(base_day, 3)
        let sec_until: str = add_years(base_day, 5)
        let r: RunResult = lts(["status"], ".")
        check(acc, "status is green on the real line", r.code == 0, "")
        check(acc, "status names the branch and its base",
            r.out.contains("branch release/1.0 from v1.0.0"), "")
        check(acc, "the bug-fix window runs to the third anniversary ("
            + bug_until + ")",
            r.out.contains("bug fixes until " + bug_until), "")
        check(acc, "the security window runs to the fifth (" + sec_until + ")",
            r.out.contains("security until " + sec_until), "")
        check(acc, "the line is active today",
            r.out.contains("phase today: active"), "")
        check(acc, "the fresh line audits clean",
            r.out.contains("audit: clean"), "")
        let w: RunResult = lts(["window", "--tag", "v1.0.0", "--at", base_day], ".")
        check(acc, "the release day itself is active (the horizon belongs "
            + "to the phase it closes)",
            w.code == 0 && w.out.contains("phase at " + base_day + ": active"), "")
        # idempotent, and one declaration only
        let i1: RunResult = lts(["init", "--tag", "v1.0.0"], ".")
        check(acc, "declaring the same line again is a no-op, not noise",
            i1.code == 0 && i1.out.contains("idempotent"), "")
        let i2: RunResult = lts(["init", "--tag", "v1.1.0"], ".")
        check(acc, "a different base is a new policy decision, refused",
            i2.code == 1 && i2.combined.contains("one declaration"), "")
    }
}

# ----------------------------------------------------------------------------
# 4. the wrong turns, the cut — a scratch world runs the release day
# ----------------------------------------------------------------------------

fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    header("4. the wrong turns, the cut — a scratch world runs the "
        + "release day")
    let repo: str = seed_world(acc, "the-release")
    let d: RunResult = rc(["declare", "--tag", "v1.0.0-rc.4"], repo)
    check(acc, "the scratch world declares its last candidate",
        d.code == 0, "")
    commit_all(repo, "release: v1.0.0-rc.4 anchored, the record rendered")
    git(repo, ["tag", "v1.0.0-rc.4"])
    # the wrong turns first
    let w1: RunResult = rc(["declare", "--tag", "v1.0.0"], repo)
    check(acc, "a bare v1.0.0 is refused as a candidate (the rc grammar)",
        w1.code == 1 && w1.combined.contains("the LTS release"), "")
    let w2: RunResult = lts(["init", "--tag", "v1.0.0-rc.4"], repo)
    check(acc, "a pre-release is not an LTS base",
        w2.code == 1 && w2.combined.contains("pre-release"), "")
    let w3: RunResult = lts(["init", "--tag", "v0.166.0"], repo)
    check(acc, "a pre-1.0 tag is not a line",
        w3.code == 1 && w3.combined.contains("pre-1.0"), "")
    let w4: RunResult = lts(["init", "--tag", "v1.0.0"], repo)
    check(acc, "the line opens only on a tag that exists (the order law)",
        w4.code == 1 && w4.combined.contains("does not exist"), "")
    # the cut: the markers move, the anchor retires with the release
    # commit, the tag is cut, the line opens
    let rows: list[str] = []
    let mut n: int = 1
    while n <= 150 {
        rows.push("| " + n.to_str() + " | " + road_title(n)
            + " | ✅ | (done in v1.0.0) |")
        n = n + 1
    }
    wf(repo, "ROADMAP.md", "# ROADMAP\n\n"
        + "| # | Stage | Status | Effort |\n"
        + "|---|-------|--------|--------|\n" + str_join(rows, "\n") + "\n")
    wf(repo, "CHANGELOG.md",
        "## [v1.0.0] — Stage 150: the LTS release\n- the body\n")
    wf(repo, "snapshot/MANIFEST.json",
        "{\"closure\": {}, \"version\": \"v1.0.0\"}")
    wf(repo, "editors/vscode/halis/package.json",
        "{\"name\": \"halis\", \"version\": \"1.0.0\"}")
    git(repo, ["rm", "-q", ".hls-rc.json"])
    let release_sha: str = commit_all(repo, "docs: stage 150 markers, the "
        + "release")
    git(repo, ["tag", "v1.0.0"])
    let init: RunResult = lts(["init", "--tag", "v1.0.0"], repo)
    check(acc, "the LTS line opens on the v1.0.0 tag (branch release/1.0)",
        init.code == 0 && init.out.contains("release/1.0"), "")
    let branch: str = git(repo, ["rev-parse", "release/1.0^{commit}"]).out.trim()
    check(acc, "the branch stands at the release commit",
        branch == release_sha, "")
    commit_all(repo, "release: the LTS line opens")
    # the windows became the clock
    let st: RunResult = lts(["status"], repo)
    check(acc, "the clock runs from the base day (3 years, 5 years)",
        st.code == 0
            && st.out.contains("bug fixes until " + add_years(scratch_day(), 3))
            && st.out.contains("security until " + add_years(scratch_day(), 5)), "")
    check(acc, "the fresh line audits clean",
        st.out.contains("audit: clean"), "")
    let w: RunResult = lts(["window", "--tag", "v1.0.0", "--at", scratch_day()], repo)
    check(acc, "the release day itself is active",
        w.code == 0 && w.out.contains("phase at " + scratch_day() + ": active"), "")
    # the RC kit retires, named — both laws, not one
    let rd: RunResult = rc(["readiness"], repo)
    check(acc, "readiness refuses on BOTH laws after the release",
        rd.code == 1 && rd.out.contains("NOT READY: the roadmap law")
            && rd.out.contains("NOT READY: the lts law"), "")
    let g: RunResult = rc(["gate"], repo)
    check(acc, "the gate refuses on the missing anchor",
        g.code == 1 && g.combined.contains("no anchor"), "")
    let rc2: RunResult = rc(["report", "--check"], repo)
    check(acc, "the record refuses on the missing anchor",
        rc2.code == 1 && rc2.combined.contains("no anchor"), "")
    let s: RunResult = rc(["signoff", "--check"], repo)
    check(acc, "the witness refuses on the missing anchor",
        s.code == 1 && s.combined.contains("no anchor"), "")
    # the line is idempotent; a second line is a new decision
    let i1: RunResult = lts(["init", "--tag", "v1.0.0"], repo)
    check(acc, "declaring the same line again is a no-op, not noise",
        i1.code == 0 && i1.out.contains("idempotent"), "")
    let i2: RunResult = lts(["init", "--tag", "v1.1.0"], repo)
    check(acc, "a different base is a new policy decision, not a re-init",
        i2.code == 1 && i2.combined.contains("one declaration"), "")
}

# ----------------------------------------------------------------------------
# 5. the docs law — the release speaks where the road wrote
# ----------------------------------------------------------------------------

fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    let state: str = release_state()
    header("5. the docs law — the release speaks where the road wrote")
    if state == "released" {
        let mut head_line: str = ""
        let lines: list[str] = read_or("RELEASES.md", "").split("\n")
        let mut i: int = 0
        while i < lines.len() {
            if lines.get(i).starts_with("## [v") {
                head_line = lines.get(i).trim()
                i = lines.len()
            }
            i = i + 1
        }
        check(acc, "the release record's head section is the release's "
            + "own (" + head_line + ")",
            head_line.contains("[v1.0.0]") && head_line.contains("LTS release"), "")
        if file_exists("ROADMAP.md") {
            let rows: list[RRow] = roadmap_rows()
            check(acc, "the roadmap's last row is ticked",
                rows.get(149).status.contains("✅"), "")
            check(acc, "the last row keeps the roadmap's own phrase ("
                + rows.get(149).title + ")",
                rows.get(149).title.contains("HLS v1.0"), "")
        }
        let readme: str = read_or("README.md", "")
        check(acc, "the README tour carries the stage 150 gate",
            readme.contains("make release-acceptance"), "")
        check(acc, "the README tour carries the clock",
            readme.contains("hls-lts status"), "")
        check(acc, "the README speaks the line the release opened",
            readme.contains("release/1.0"), "")
    } else {
        check(acc, "on the eve the record's head is still the candidate's",
            head_version() == "1.0.0-rc.4", "")
        let readme: str = read_or("README.md", "")
        check(acc, "the README tour still carries the candidate gates",
            readme.contains("make rc4-acceptance"), "")
    }
}

# ----------------------------------------------------------------------------
# 6. the corpus showcase — the release laws in pure HLS
# ----------------------------------------------------------------------------

fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    header("6. the corpus showcase — the release laws in pure HLS")
    check(acc, path_join3(cwd_get(), showcase()) + " exists",
        file_exists(showcase()), "")
    let fmt: RunResult = run_capture("./bin/hlfmt", [showcase()])
    let src: str = read_file(showcase())
    check(acc, "the showcase is hlfmt-canonical",
        fmt.code == 0 && fmt.out == src, "")
    let lint: RunResult = run_capture("python3", ["tools/hllint.py", showcase()])
    check(acc, "the showcase is hllint-clean",
        lint.code == 0 && lint.out.contains("no warnings"), "")
    let chk: RunResult = boot(acc, ["--check", showcase()])
    check(acc, "the showcase passes the real checker", chk.code == 0, "")
    let run: RunResult = boot(acc, [showcase()])
    check(acc, "the showcase runs green on the interpreter",
        run.code == 0 && run.out == showcase_out(), "")
    if file_exists("bin/hlc") && which("gcc") {
        let out_c: str = scratch(acc, "showcase.c")
        let comp: RunResult = run_capture("./bin/hlc", [showcase(), out_c])
        if comp.code != 0 {
            fail_msg(acc, "the showcase does not compile natively: "
                + clip(comp.combined, 160))
        } else {
            let binp: str = scratch(acc, "showcase")
            let link: RunResult = run_capture("gcc",
                ["-O2", "-o", binp, out_c, "-lm", "-pthread"])
            if link.code != 0 {
                fail_msg(acc, "the showcase binary does not link")
            } else {
                let nat: RunResult = run_capture(binp, [])
                check(acc, "the showcase matches natively, byte for byte",
                    nat.code == 0 && nat.out == showcase_out(), "")
            }
        }
    }
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    # the battery's GIT_ENV — every child (git, the kit) sees the
    # pinned identity and the pinned committer day
    env_set_var("GIT_AUTHOR_NAME", "rc150-gate")
    env_set_var("GIT_AUTHOR_EMAIL", "rc150-gate@example.invalid")
    env_set_var("GIT_COMMITTER_NAME", "rc150-gate")
    env_set_var("GIT_COMMITTER_EMAIL", "rc150-gate@example.invalid")
    env_set_var("GIT_COMMITTER_DATE", "2026-10-29T11:00:00+00:00")
    env_set_var("GIT_AUTHOR_DATE", "2026-10-29T11:00:00+00:00")
    let acc: Acc = acc_new("release")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    return finish(acc, "Stage 150 -- v1.0.0, the LTS release")
}
