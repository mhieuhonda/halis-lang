# ============================================================================
# tests/acc/freeze_acceptance.hls — Stage 141 acceptance gate, in Halis
# (the Halis twin of the retired tests/freeze_acceptance.py; same eight
# sections, same assertions, same needles — the harness is
# tests/acc/harness.hls and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Eight sections over the REAL hls-freeze BINARY (bin/hls-freeze), the
# REAL front-end (the compiler, linked through tools/hlfront.hls — the
# gate's own re-derivation walks std/ and core/ with the real parser;
# the syntax tables are read out of the tree's own chains: the
# compiler's is_keyword/is_effect_name in src/hlc/types.hls, the
# parser's reserved and crate-attr vocabularies, the lexer's token
# chains, the checker's builtin-fn chain and method dispatch in
# src/hlc/check_call.hls, the formatter's keyword chain for the
# two-front-end agreement), the checker as a live probe channel
# (bin/hlboot --check: the junk-attribute census, the container
# surface, every probe program), disposable copies of the tree parts
# the tool reads, and the family's ONE chain arithmetic (chain_of —
# sha256(prev + canonical(record minus chain_hash)), carried in the
# gate under the same law) recomputing every hash:
#
#  1. the convention — the freeze document exists, is surface version
#                       1, stamps Stage 141 / v0.159.0-alpha, its
#                       digest is the sha256 of the canonical surface
#                       it carries (the gate's OWN canonicaliser), the
#                       chain replays, the tools answer on the real
#                       tree, both files are committed
#  2. the syntax law  — every frozen table is exactly the live table;
#                       the two front-ends agree; the attribute census
#                       is the parser's live words; the method tables
#                       row for row; the container surface DEMONSTRATED
#                       through the real checker
#  3. the census law  — the frozen stdlib census equals the gate's own
#                       re-derivation canonically; the counts; the
#                       signatures; impl methods under their keys
#  4. the removal law — a deleted fn is REMOVED at its dotted path, a
#                       one-front-end keyword removal is refused
#                       outright, a both-front-end removal is drift
#  5. the mutation    — param/ret/effects changes, a removed enum
#     law               variant, a removed struct field, a new
#                       deprecation — each named at its path
#  6. the addition    — a post-freeze fn is ADDED drift, a grown
#     law                builtin table is syntax drift, a comment-only
#                       edit moves NO row
#  7. the amend law   — the named refusals; a real amendment appends
#                       exactly one record whose delta is the tool's
#                       diff, whose chain_hash the gate recomputes
#                       through the family's chain arithmetic; verify
#                       green; a second amend refused; a tampered
#                       record breaks the replay at its line
#  8. the report      — the frozen API document renders twice
#     + corpus          byte-identically, embeds the digest, refuses a
#     showcase          drifted tree; the corpus showcase boots, runs,
#                       is hlfmt-canonical, hllint-clean, and matches
#                       natively byte for byte
#
# The gate's own canonicaliser (canon) and sha live HERE in Halis —
# written independently of the tool's, and required to agree with it,
# exactly as the battery required of its own.
# ============================================================================

import "./harness.hls"
import "../../tools/hlfront.hls"
import "std.json"
import "std.sha256"
import "std.env"
import "std.taint"
import "std.str"

# ----------------------------------------------------------------------------
# The gate's own canonicaliser — json.dumps(sort_keys=True,
# separators=(",", ":"), ensure_ascii=True), independently written.
# ----------------------------------------------------------------------------

fn hex4(cp: int) -> str {
    let digits: str = "0123456789abcdef"
    let a: int = (cp / 4096) % 16
    let b: int = (cp / 256) % 16
    let c: int = (cp / 16) % 16
    let d: int = cp % 16
    return "\\u" + digits.slice(a, a + 1) + digits.slice(b, b + 1)
    + digits.slice(c, c + 1) + digits.slice(d, d + 1)
}

# hex4_surro(st) — the escaped UTF-16 form of a decoded multi-byte
# sequence (a surrogate pair above the BMP, \uXXXX twice).
fn hex4_surro(cp: int) -> str {
    let v: int = cp - 65536
    let hi: int = 55296 + (v / 1024)
    let lo: int = 56320 + (v % 1024)
    return hex4(hi) + hex4(lo)
}

fn canon_str(s: str) -> str {
    let mut out: str = "\""
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c == 34 {
            out = out + "\\\""
        } else if c == 92 {
            out = out + "\\\\"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 13 {
            out = out + "\\r"
        } else if c == 9 {
            out = out + "\\t"
        } else if c < 32 {
            out = out + "\\u00" + hex_byte_lo(c)
        } else if c < 128 {
            out = out + s.slice(i, i + 1)
        } else {
            # ensure_ascii: decode the UTF-8 sequence, escape it
            let mut cp: int = 0
            let mut advance: int = 1
            if c >= 240 {
                cp = (c - 240) * 262144
                + (s.byte_at(i + 1) - 128) * 4096
                + (s.byte_at(i + 2) - 128) * 64
                + (s.byte_at(i + 3) - 128)
                advance = 4
            } else if c >= 224 {
                cp = (c - 224) * 4096
                + (s.byte_at(i + 1) - 128) * 64
                + (s.byte_at(i + 2) - 128)
                advance = 3
            } else {
                cp = (c - 192) * 64 + (s.byte_at(i + 1) - 128)
                advance = 2
            }
            if cp > 65535 {
                out = out + hex4_surro(cp)
            } else {
                out = out + hex4(cp)
            }
            i = i + advance
            continue
        }
        i = i + 1
    }
    return out + "\""
}

fn hex_byte_lo(c: int) -> str {
    let lo: int = c % 16
    let digits: str = "0123456789abcdef"
    return "0" + digits.slice(lo, lo + 1)
}

# sort_keys: the surface's keys are identifiers and dotted paths —
# plain byte order is python's order for them.
fn sort_strs(items: list[str]) -> list[str] {
    let a: list[str] = items
    let mut i: int = 1
    while i < a.len() {
        let key: str = a.get(i)
        let mut j: int = i - 1
        while j >= 0 && a.get(j) > key {
            a.set(j + 1, a.get(j))
            j = j - 1
        }
        a.set(j + 1, key)
        i = i + 1
    }
    return a
}

fn canon(v: JsonValue) -> str {
    if json_is_null(v) {
        return "null"
    }
    if json_is_bool(v) {
        if v.bval {
            return "true"
        }
        return "false"
    }
    if json_is_int(v) {
        return v.ival.to_str()
    }
    if json_is_float(v) {
        return v.fval.to_str()
    }
    if json_is_str(v) {
        return canon_str(v.sval)
    }
    if json_is_array(v) {
        # collect + join: the O(n) shape (an accumulating concat is
        # quadratic in Halis — see std.str's own str_join note)
        let parts: list[str] = []
        parts.push("[")
        let mut i: int = 0
        while i < v.arr.len() {
            if i > 0 {
                parts.push(",")
            }
            parts.push(canon(v.arr.get(i)))
            i = i + 1
        }
        parts.push("]")
        return str_join(parts, "")
    }
    # object: keys sorted
    let keys: list[str] = sort_strs(v.obj_keys)
    let parts: list[str] = []
    parts.push("{")
    let mut i: int = 0
    while i < keys.len() {
        if i > 0 {
            parts.push(",")
        }
        let k: str = keys.get(i)
        parts.push(canon_str(k))
        parts.push(":")
        parts.push(canon(json_object_get(v, k)))
        i = i + 1
    }
    parts.push("}")
    return str_join(parts, "")
}

# jget_str / jget_int / jget_bool — kind-guarded accessors.
fn jget_str(v: JsonValue, key: str) -> str {
    let x: JsonValue = json_object_get(v, key)
    if json_is_str(x) {
        return json_str_value(x)
    }
    return ""
}

fn jget_int(v: JsonValue, key: str) -> int {
    let x: JsonValue = json_object_get(v, key)
    if json_is_int(x) {
        return json_int_value(x)
    }
    return -1
}

fn parse_json_or_null(text: str) -> JsonValue {
    let rr: Result[JsonValue, str] = json_parse_result(text)
    if result_is_ok(rr) {
        return result_unwrap(rr)
    }
    return json_null()
}

fn json_with_str(v: JsonValue, key: str, val: str) -> JsonValue {
    return json_with_val(v, key, json_str(val))
}

fn json_with_val(v: JsonValue, key: str, val: JsonValue) -> JsonValue {
    if !json_is_object(v) {
        return v
    }
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    while i < v.obj_keys.len() {
        if v.obj_keys.get(i) != key {
            keys.push(v.obj_keys.get(i))
            vals.push(v.obj_vals.get(i))
        }
        i = i + 1
    }
    keys.push(key)
    vals.push(val)
    return json_object(keys, vals)
}

# replace_first(s, from, to) — the battery's str.replace(..., 1).
fn replace_first(s: str, from: str, to: str) -> str {
    let i: int = s.find(from)
    if i < 0 {
        return s
    }
    return s.slice(0, i) + to + s.slice(i + from.len(), s.len())
}

# ----------------------------------------------------------------------------
# The tool runner — the battery's run(TOOL + args, cwd=root), native:
# bin/hls-freeze itself, its --root pointing at the tree under test.
# ----------------------------------------------------------------------------

# freeze_run(args, dir) — run the binary in dir (the repo when ""),
# the arguments carrying --root when a scratch tree is under test.
fn freeze_run(acc: Acc, args: list[str], dir: str) -> RunResult uses Proc {
    let tool: str = path_join3(acc.root, "bin/hls-freeze")
    let home: str = cwd_get()
    if dir != "" {
        env_set_current_dir(dir)
    }
    let r: RunResult = run_capture(tool, args)
    if dir != "" {
        env_set_current_dir(home)
    }
    return r
}

# ----------------------------------------------------------------------------
# The family's ONE chain arithmetic — sha256(prev + canonical(record
# minus chain_hash)) — carried in the gate under the same law the
# ledgers share (hls-tlog, hls-sandbox, hls-freeze); the gate
# recomputes every hash through its own copy and its own
# canonicaliser, and the two are required to agree.
# ----------------------------------------------------------------------------

fn gate_chain_of(prev: str, rec: JsonValue) -> str {
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    while i < rec.obj_keys.len() {
        if rec.obj_keys.get(i) != "chain_hash" {
            keys.push(rec.obj_keys.get(i))
            vals.push(rec.obj_vals.get(i))
        }
        i = i + 1
    }
    return sha256_hex(prev + canon(json_object(keys, vals)))
}

# ----------------------------------------------------------------------------
# The syntax tables — read out of the tree's own front-end source: the
# chains the compiler and the formatter actually dispatch on. Every
# reader is the gate's own; the tool carries its own; the frozen
# document is required to agree with both.
# ----------------------------------------------------------------------------

# has_str(xs, x) — membership in a string list.
fn has_str(xs: list[str], x: str) -> bool {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) == x {
            return true
        }
        i = i + 1
    }
    return false
}

# chain_words(text, fname, word_class) — the `== "word"` chain inside
# `fn NAME(...)`, sorted and deduped; "lower" takes [a-z_0-9], "upper"
# takes [A-Za-z_].
fn chain_words(text: str, fname: str, word_class: str) -> list[str] {
    let at: int = text.find("fn " + fname + "(")
    if at < 0 {
        return[]
    }
    let end: int = find_from(text, "\n}", at)
    if end < 0 {
        return[]
    }
    let body: str = text.slice(at, end)
    let words: list[str] = []
    let mut i: int = 0
    while i < body.len() {
        if body.byte_at(i) == 61 && i + 3 < body.len()
        && body.byte_at(i + 1) == 61
        && body.byte_at(i + 2) == 32
        && body.byte_at(i + 3) == 34 {
            let mut j: int = i + 4
            let mut w: str = ""
            while j < body.len() {
                let c: int = body.byte_at(j)
                let mut ok: bool = false
                if word_class == "upper" {
                    ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
                    || c == 95
                } else {
                    ok = (c >= 97 && c <= 122) || c == 95
                    || (c >= 48 && c <= 57)
                }
                if !ok {
                    break
                }
                w = w + body.slice(j, j + 1)
                j = j + 1
            }
            if w != "" && j < body.len() && body.byte_at(j) == 34 {
                if !has_str(words, w) {
                    words.push(w)
                }
            }
            i = j
            continue
        }
        i = i + 1
    }
    return sort_strs(words)
}

# reserved_ids(parser_src) — the `t.value == "..."` words in the
# parser's reserved-identifier check (the lines above the diagnostic).
fn reserved_ids(parser_src: str) -> list[str] {
    let lines: list[str] = parser_src.split("\n")
    let mut at: int = -1
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).contains("is a reserved identifier") {
            at = i
        }
        i = i + 1
    }
    if at < 0 {
        return[]
    }
    let words: list[str] = []
    # the condition sits on the line(s) immediately above; scan back
    # up to 3 lines for t.value == "..." occurrences.
    let mut j: int = at - 1
    let mut steps: int = 0
    while j >= 0 && steps < 3 {
        let l: str = lines.get(j)
        let mut k: int = 0
        while k + 12 <= l.len() {
            if l.slice(k, l.len()).starts_with("t.value == \"") {
                let rest: str = l.slice(k + 12, l.len())
                let q: int = rest.find("\"")
                if q > 0 {
                    if !has_str(words, rest.slice(0, q)) {
                        words.push(rest.slice(0, q))
                    }
                }
            }
            k = k + 1
        }
        if l.trim().starts_with("if t.value") {
            break
        }
        j = j - 1
        steps = steps + 1
    }
    return sort_strs(words)
}

# crate_attrs(parser_src) — the `name != "..."` words in the parser's
# unknown-crate-attribute refusal (the line above the diagnostic).
fn crate_attrs(parser_src: str) -> list[str] {
    let lines: list[str] = parser_src.split("\n")
    let mut at: int = -1
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).contains("unknown crate attribute") {
            at = i
        }
        i = i + 1
    }
    if at < 0 {
        return[]
    }
    let words: list[str] = []
    # the condition is on the line above the diagnostic
    let mut j: int = at - 1
    let mut steps: int = 0
    while j >= 0 && steps < 3 {
        let l: str = lines.get(j)
        let mut k: int = 0
        while k + 9 <= l.len() {
            if l.slice(k, l.len()).starts_with("name != \"") {
                let rest: str = l.slice(k + 9, l.len())
                let q: int = rest.find("\"")
                if q > 0 {
                    if !has_str(words, rest.slice(0, q)) {
                        words.push(rest.slice(0, q))
                    }
                }
            }
            k = k + 1
        }
        if l.trim().starts_with("if name !=") {
            break
        }
        j = j - 1
        steps = steps + 1
    }
    return sort_strs(words)
}

# two_char(lexer_src) — the `two == "XX"` chain on the lexer's
# two-character operator line.
fn two_char(lexer_src: str) -> list[str] {
    let lines: list[str] = lexer_src.split("\n")
    let mut line: str = ""
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).contains("two == \"->\"") {
            line = lines.get(i)
            break
        }
        i = i + 1
    }
    if line == "" {
        return[]
    }
    let words: list[str] = []
    let mut k: int = 0
    while k + 8 <= line.len() {
        if line.slice(k, line.len()).starts_with("two == \"") {
            let rest: str = line.slice(k + 8, line.len())
            let q: int = rest.find("\"")
            if q > 0 {
                if !has_str(words, rest.slice(0, q)) {
                    words.push(rest.slice(0, q))
                }
            }
        }
        k = k + 1
    }
    return sort_strs(words)
}

# one_char(lexer_src) — the `c == N` byte-code chain on the lexer's
# single-character operator line, rendered as characters.
fn one_char(lexer_src: str) -> list[str] {
    let lines: list[str] = lexer_src.split("\n")
    let mut line: str = ""
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).contains("c == 40") {
            line = lines.get(i)
            break
        }
        i = i + 1
    }
    if line == "" {
        return[]
    }
    let words: list[str] = []
    let mut k: int = 0
    while k + 5 <= line.len() {
        if line.slice(k, line.len()).starts_with("c == ") {
            let mut j: int = k + 5
            let mut n: int = 0
            let mut digits: int = 0
            while j < line.len() {
                let c: int = line.byte_at(j)
                if c >= 48 && c <= 57 {
                    n = n * 10 + (c - 48)
                    digits = digits + 1
                    j = j + 1
                    continue
                }
                break
            }
            if digits > 0 && n > 0 && n < 128 {
                let ch: str = chr(n)
                if !has_str(words, ch) {
                    words.push(ch)
                }
            }
            k = j
            continue
        }
        k = k + 1
    }
    return sort_strs(words)
}

# builtin_fns(acc) — the is_builtin_fn chain out of the tree's own
# checker.
fn builtin_fns(acc: Acc) -> list[str] uses Fs {
    let chk: str = read_file(path_join3(acc.root, "src/hlc/checker.hls"))
    return chain_words(chk, "is_builtin_fn", "lower")
}

# ----------------------------------------------------------------------------
# The checker, live — bin/hlboot --check is the probe channel: the
# battery ran the interpreter's checker in-process; the gate asks the
# REAL evaluator over its CLI and reads the verdict (exit 0 = NONE,
# else the diagnostic text). The probe channel the container surface
# is DEMONSTRATED through is the same one.
# ----------------------------------------------------------------------------

# checker_verdict(acc, tag, prog) — one program through the real
# checker; the RunResult is the verdict (code 0 = accepted).
fn checker_verdict(acc: Acc, tag: str, prog: str) -> RunResult
uses Fs, Proc {
    let path: str = write_src(acc, tag, prog)
    return boot_check(acc, path)
}

# ----------------------------------------------------------------------------
# The primitive method tables — the checker's own dispatch, read out
# of src/hlc/check_call.hls: one `tt == "<ty>"` block, every arm's
# name, its ptypes.push("T") parameters in order, the ret = "R"
# assignment (last wins), sorted by name. The battery imported
# STR_M/INT_M/FLOAT_M/BOOL_M; the gate reads the live dispatch.
# ----------------------------------------------------------------------------

struct GateMethod {
    name: str,
    params: list[str],
    ret: str
}

# arm_name(line) — the method an arm dispatches on, "" when the line
# is not an arm opener.
fn arm_name(line: str) -> str {
    let trimmed: str = line.trim()
    let mut rest: str = ""
    if trimmed.starts_with("if name == \"") {
        rest = trimmed.slice(12, trimmed.len())
    } else {
        if trimmed.starts_with("else if name == \"") {
            rest = trimmed.slice(17, trimmed.len())
        } else {
            return ""
        }
    }
    let q: int = rest.find("\"")
    if q <= 0 {
        return ""
    }
    return rest.slice(0, q)
}

# prim_methods(acc, ty) — the `tt == "ty"` block's method arms, sorted
# by name (canonical order).
fn prim_methods(acc: Acc, ty: str) -> list[GateMethod] uses Fs {
    let src: str = read_file(path_join3(acc.root,
    "src/hlc/check_call.hls"))
    let lines: list[str] = src.split("\n")
    let opener: str = "tt == \"" + ty + "\" {"
    let mut start: int = -1
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).contains(opener) {
            start = i
            break
        }
        i = i + 1
    }
    if start < 0 {
        return[]
    }
    # the block ends at the next line of the dispatch chain's arms.
    let mut end: int = lines.len()
    let mut j: int = start + 1
    while j < lines.len() {
        let l: str = lines.get(j)
        if l.len() >= 10 && l.slice(0, 10) == "    } else" {
            end = j
            break
        }
        j = j + 1
    }
    let tbl: list[GateMethod] = []
    let mut cur: str = ""
    let mut params: list[str] = []
    let mut ret: str = "void"
    let mut have: bool = false
    let mut k: int = start + 1
    while k < end {
        let l2: str = lines.get(k)
        # arm opener: `if name == "X" {` or `else if name == "X" {`
        let arm: str = arm_name(l2)
        if arm != "" {
            if have {
                tbl.push(GateMethod {
                    name: cur, params: params, ret: ret
                })
            }
            cur = arm
            let fresh: list[str] = []
            params = fresh
            ret = "void"
            have = true
            k = k + 1
            continue
        }
        if have {
            # ptypes.push("T") — a parameter type, in order
            if l2.contains("ptypes.push(\"") {
                let at: int = l2.find("ptypes.push(\"")
                let rest: str = l2.slice(at + 13, l2.len())
                let q: int = rest.find("\"")
                if q > 0 {
                    params.push(rest.slice(0, q))
                }
            }
            # ret = "R" — the return type (last wins)
            let rat: int = l2.find("ret = \"")
            if rat >= 0 {
                let rest2: str = l2.slice(rat + 7, l2.len())
                let q2: int = rest2.find("\"")
                if q2 > 0 {
                    ret = rest2.slice(0, q2)
                }
            }
        }
        k = k + 1
    }
    if have {
        tbl.push(GateMethod {
            name: cur, params: params, ret: ret
        })
    }
    let mut a: int = 1
    while a < tbl.len() {
        let v: GateMethod = tbl.get(a)
        let mut b: int = a - 1
        while b >= 0 && tbl.get(b).name > v.name {
            tbl.set(b + 1, tbl.get(b))
            b = b - 1
        }
        tbl.set(b + 1, v)
        a = a + 1
    }
    return tbl
}

# prim_mtable(acc, ty) — the table as canonical JSON, the freeze
# document's own shape: {name: {"params": [...], "ret": ...}}.
fn prim_mtable(acc: Acc, ty: str) -> str uses Fs {
    let tbl: list[GateMethod] = prim_methods(acc, ty)
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    while i < tbl.len() {
        let m: GateMethod = tbl.get(i)
        let pstrs: list[JsonValue] = []
        let mut q: int = 0
        while q < m.params.len() {
            pstrs.push(json_str(m.params.get(q)))
            q = q + 1
        }
        let pkeys: list[str] = ["params", "ret"]
        let pvals: list[JsonValue] = []
        pvals.push(json_array(pstrs))
        pvals.push(json_str(m.ret))
        keys.push(m.name)
        vals.push(json_object(pkeys, pvals))
        i = i + 1
    }
    return canon(json_object(keys, vals))
}

# ----------------------------------------------------------------------------
# The stdlib surface — the gate's own re-derivation: every module
# under std/ and core/ parsed with the real front-end (hlfront — the
# compiler, linked), the public items recorded under the freeze
# document's law, canonicalised with the gate's own canon. Line
# numbers are NOT part of the surface.
# ----------------------------------------------------------------------------

struct GateModule {
    id: str,
    path: str
}

# walk_modules(dir, prefix, out) — every .hls under dir, module ids
# dotted from the prefix.
fn walk_modules(dir: str, prefix: str, out: list[GateModule]) -> void
uses Fs {
    let names: list[str] = fs_read_dir(dir)
    let mut i: int = 0
    while i < names.len() {
        let nm: str = names.get(i)
        if nm != "." && nm != ".." {
            let full: str = path_join3(dir, nm)
            if fs_is_dir(full) {
                walk_modules(full, prefix + "." + nm, out)
            } else {
                if nm.ends_with(".hls") {
                    out.push(GateModule {
                        id: prefix + "."
                        + nm.slice(0, nm.len() - 4),
                        path: full
                    })
                }
            }
        }
        i = i + 1
    }
}

# module_files(acc) — core/ then std/, sorted by module id (the
# battery's os.walk with sorted names; order-independent because the
# census sorts).
fn module_files(acc: Acc) -> list[GateModule] uses Fs {
    let out: list[GateModule] = []
    walk_modules(path_join3(acc.root, "core"), "core", out)
    walk_modules(path_join3(acc.root, "std"), "std", out)
    let mut a: int = 1
    while a < out.len() {
        let v: GateModule = out.get(a)
        let mut b: int = a - 1
        while b >= 0 && out.get(b).id > v.id {
            out.set(b + 1, out.get(b))
            b = b - 1
        }
        out.set(b + 1, v)
        a = a + 1
    }
    return out
}

# float_canon(v) — the canonical text of a float value (integral
# values render N.0, zero renders 0.0): the form the contract text of
# the freeze document carries.
fn float_canon(v: float) -> str {
    if v == 0.0 {
        return "0.0"
    }
    let neg: bool = v < 0.0
    let mut a: float = v
    if neg {
        a = -v
    }
    if a < 9007199254740992.0 {
        let i: int = a.to_int()
        if a == i.to_float() {
            if neg {
                return "-" + i.to_str() + ".0"
            }
            return i.to_str() + ".0"
        }
    }
    return v.to_str()
}

# expr_text(ctx, e) — the deterministic text form of a contract
# expression (requires / ensures).
fn expr_text(ctx: Ctx, e: int) -> str {
    let n: ExprN = ctx.exprs.get(e)
    if n.kind == "bin" {
        return "(" + expr_text(ctx, n.left) + " " + n.op + " "
        + expr_text(ctx, n.right) + ")"
    }
    if n.kind == "un" {
        return n.op + "(" + expr_text(ctx, n.left) + ")"
    }
    if n.kind == "ident" {
        return n.name
    }
    if n.kind == "int" {
        return n.ival.to_str()
    }
    if n.kind == "float" {
        return float_canon(n.fval)
    }
    if n.kind == "str" {
        return canon_str(n.sval)
    }
    if n.kind == "bool" {
        if n.bval {
            return "true"
        }
        return "false"
    }
    if n.kind == "call" {
        let args: list[str] = []
        let mut i: int = 0
        while i < n.args.len() {
            args.push(expr_text(ctx, n.args.get(i)))
            i = i + 1
        }
        return n.name + "(" + join_with(args, ", ") + ")"
    }
    if n.kind == "fieldcall" {
        let args2: list[str] = []
        let mut k: int = 0
        while k < n.args.len() {
            args2.push(expr_text(ctx, n.args.get(k)))
            k = k + 1
        }
        return expr_text(ctx, n.left) + "." + n.name + "("
        + join_with(args2, ", ") + ")"
    }
    if n.kind == "field" {
        return expr_text(ctx, n.left) + "." + n.name
    }
    if n.kind == "index" {
        return expr_text(ctx, n.left) + "["
        + expr_text(ctx, n.right) + "]"
    }
    if n.kind == "qmark" {
        return expr_text(ctx, n.left) + "?"
    }
    return "ast:" + n.kind
}

# dead_fn() — the FnInfo default (a missing key answers empty).
fn dead_fn() -> FnInfo {
    let no_body: list[int] = []
    return FnInfo {
        name: "", params: [], ptypes: [], pmuts: [], ret: "",
        effects: [], is_pure: false, body: no_body, is_method: false,
        struct_of: "", typeparams: [], line: 0, is_extern: false,
        requires_e: -1, ensures_e: -1, attr_stack_size: -1,
        attr_no_red_zone: false, attr_irq_handler: false,
        attr_irq_vector: -1, attr_inline: "", attr_hot: false,
        attr_cold: false, attr_tail_call: false,
        attr_panic_handler: false, attr_section: "", attr_align: -1,
        src_file: "", param_preds: map_new(), ret_pred: "",
        has_refinements: false, attr_secrets: "", attr_ct: false,
        attr_deprecated: false, attr_deprecated_msg: "",
        attr_taint_source: false, attr_taint_sinks: ""
    }
}

# fn_record(ctx, key) — one fn's census record (the freeze document's
# law: params, effects, extern, generic, pure, ret, the contract text
# when present, the deprecation, the taint marks).
fn fn_record(ctx: Ctx, key: str) -> JsonValue {
    let f: FnInfo = ctx.fns.get_or(key, dead_fn())
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let prows: list[JsonValue] = []
    let mut i: int = 0
    while i < f.params.len() {
        let row: list[JsonValue] = []
        row.push(json_str(f.params.get(i)))
        row.push(json_str(f.ptypes.get(i)))
        row.push(json_bool(f.pmuts.get(i)))
        prows.push(json_array(row))
        i = i + 1
    }
    keys.push("effects")
    let esorted: list[str] = sort_strs(f.effects)
    let eitems: list[JsonValue] = []
    let mut e: int = 0
    while e < esorted.len() {
        eitems.push(json_str(esorted.get(e)))
        e = e + 1
    }
    vals.push(json_array(eitems))
    keys.push("extern")
    vals.push(json_bool(f.is_extern))
    keys.push("generic")
    let gitems: list[JsonValue] = []
    let mut g: int = 0
    while g < f.typeparams.len() {
        gitems.push(json_str(f.typeparams.get(g)))
        g = g + 1
    }
    vals.push(json_array(gitems))
    keys.push("params")
    vals.push(json_array(prows))
    keys.push("pure")
    vals.push(json_bool(f.is_pure))
    keys.push("ret")
    vals.push(json_str(f.ret))
    if f.requires_e >= 0 {
        keys.push("requires")
        vals.push(json_str(expr_text(ctx, f.requires_e)))
    }
    if f.ensures_e >= 0 {
        keys.push("ensures")
        vals.push(json_str(expr_text(ctx, f.ensures_e)))
    }
    if f.attr_deprecated {
        keys.push("deprecated")
        vals.push(json_str(f.attr_deprecated_msg))
    }
    if f.attr_taint_source {
        keys.push("taint_source")
        vals.push(json_bool(true))
    }
    if f.attr_taint_sinks != "" {
        keys.push("taint_sinks")
        let ssorted: list[str] = sort_strs(f.attr_taint_sinks.split(","))
        let sitems: list[JsonValue] = []
        let mut s: int = 0
        while s < ssorted.len() {
            sitems.push(json_str(ssorted.get(s)))
            s = s + 1
        }
        vals.push(json_array(sitems))
    }
    return json_object(keys, vals)
}

# struct_record(s) — one struct's census record.
fn struct_record(s: StructInfo) -> JsonValue {
    let frows: list[JsonValue] = []
    let mut i: int = 0
    while i < s.fields.len() {
        let mut has_d: bool = false
        if s.fdefaults.get(i) >= 0 {
            has_d = true
        }
        let row: list[JsonValue] = []
        row.push(json_str(s.fields.get(i)))
        row.push(json_str(s.ftypes.get(i)))
        row.push(json_bool(has_d))
        frows.push(json_array(row))
        i = i + 1
    }
    let gitems: list[JsonValue] = []
    let mut g: int = 0
    while g < s.typeparams.len() {
        gitems.push(json_str(s.typeparams.get(g)))
        g = g + 1
    }
    let skeys: list[str] = ["fields", "generic"]
    let svals: list[JsonValue] = []
    svals.push(json_array(frows))
    svals.push(json_array(gitems))
    return json_object(skeys, svals)
}

# enum_record(e) — one enum's census record.
fn enum_record(e: EnumInfo) -> JsonValue {
    let vrows: list[JsonValue] = []
    let mut i: int = 0
    while i < e.variants.len() {
        let pl: list[str] = e.payloads.get(i)
        let pays: list[JsonValue] = []
        let mut q: int = 0
        while q < pl.len() {
            pays.push(json_str(pl.get(q)))
            q = q + 1
        }
        let row: list[JsonValue] = []
        row.push(json_str(e.variants.get(i)))
        row.push(json_array(pays))
        vrows.push(json_array(row))
        i = i + 1
    }
    let gitems: list[JsonValue] = []
    let mut g: int = 0
    while g < e.typeparams.len() {
        gitems.push(json_str(e.typeparams.get(g)))
        g = g + 1
    }
    let ekeys: list[str] = ["generic", "variants"]
    let evals: list[JsonValue] = []
    evals.push(json_array(gitems))
    evals.push(json_array(vrows))
    return json_object(ekeys, evals)
}

# module_record(path) — one module's census: fns under their keys
# (impl methods under their Struct.method keys), structs, enums,
# imports — the single-file view (imports listed, not followed).
fn module_record(path: str) -> JsonValue uses IO {
    let ctx: Ctx = hl_parse_file(path)
    let fkeys: list[str] = sort_strs(ctx.fn_order)
    let fvals: list[JsonValue] = []
    let mut i: int = 0
    while i < fkeys.len() {
        fvals.push(fn_record(ctx, fkeys.get(i)))
        i = i + 1
    }
    let skeys: list[str] = sort_strs(ctx.structs.keys())
    let svals: list[JsonValue] = []
    let mut j: int = 0
    while j < skeys.len() {
        let s: StructInfo = ctx.structs.get_or(skeys.get(j), StructInfo {
            name: "", fields: [], ftypes: [], fdefaults: [],
            typeparams: [], line: 0, field_preds: map_new()
        })
        svals.push(struct_record(s))
        j = j + 1
    }
    let ekeys: list[str] = sort_strs(ctx.enums.keys())
    let evels: list[JsonValue] = []
    let mut m: int = 0
    while m < ekeys.len() {
        let ev: EnumInfo = ctx.enums.get_or(ekeys.get(m), EnumInfo {
            name: "", variants: [], payloads: [], typeparams: [],
            line: 0
        })
        evels.push(enum_record(ev))
        m = m + 1
    }
    let isorted: list[str] = sort_strs(ctx.imports)
    let iitems: list[JsonValue] = []
    let mut n: int = 0
    while n < isorted.len() {
        iitems.push(json_str(isorted.get(n)))
        n = n + 1
    }
    let mkeys: list[str] = ["enums", "fns", "imports", "structs"]
    let mvals: list[JsonValue] = []
    mvals.push(json_object(ekeys, evels))
    mvals.push(json_object(fkeys, fvals))
    mvals.push(json_array(iitems))
    mvals.push(json_object(skeys, svals))
    return json_object(mkeys, mvals)
}

# stdsurface(acc) — the whole live stdlib surface, canonical, through
# the gate's own derivation.
fn stdsurface(acc: Acc) -> str uses IO, Fs {
    let mods: list[GateModule] = module_files(acc)
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    while i < mods.len() {
        keys.push(mods.get(i).id)
        vals.push(module_record(mods.get(i).path))
        i = i + 1
    }
    return canon(json_object(keys, vals))
}

# make_scratch(acc, tag) — a disposable copy of the tree parts the
# tool reads.
# The path is ABSOLUTE: the freeze legs chdir into the tree, and a
# relative --root would re-resolve against the new cwd (the battery's
# tempfile root was absolute for the same reason).
fn make_scratch(acc: Acc, tag: str) -> str uses IO, Fs, Proc {
    let root: str = scratch(acc, "tree-" + tag)
    let parts: list[str] = ["tools", "std", "core",
    "src/hlc/types.hls", "src/hlc/parser.hls",
    "src/hlc/lexer.hls", "src/hlc/checker.hls",
    "src/hlc/check_call.hls",
    "tests/api_freeze.json",
    "tests/api_freeze_amendments.jsonl"]
    let mut i: int = 0
    while i < parts.len() {
        let part: str = parts.get(i)
        let src: str = path_join3(acc.root, part)
        let dst: str = path_join3(root, part)
        let d_ok: int = mkdirs(path_dir3(dst))
        if d_ok != 0 {
            println("freeze-acceptance: mkdirs failed for " + dst)
        }
        # -r: tools / std / core are directories
        sh("cp -r '" + shell_quote(src) + "' '" + shell_quote(dst) + "'")
        i = i + 1
    }
    return root
}

# collect_eq_idents(text) — the battery's
# set(re.findall(r'==\s*"([a-z_]+)"', body)), sorted.
fn collect_eq_idents(text: str) -> list[str] {
    let found: list[str] = []
    let mut i: int = 0
    while i < text.len() - 4 {
        if text.byte_at(i) == 61 && text.byte_at(i + 1) == 61 {
            let mut j: int = i + 2
            while j < text.len() && text.byte_at(j) == 32 {
                j = j + 1
            }
            if j < text.len() && text.byte_at(j) == 34 {
                let mut k: int = j + 1
                let mut ident: str = ""
                while k < text.len() {
                    let c: int = text.byte_at(k)
                    if(c >= 97 && c <= 122) || c == 95 {
                        ident = ident + text.slice(k, k + 1)
                        k = k + 1
                    } else {
                        break
                    }
                }
                if ident != "" && k < text.len()
                && text.byte_at(k) == 34 {
                    let mut dup: bool = false
                    let mut m: int = 0
                    while m < found.len() {
                        if found.get(m) == ident {
                            dup = true
                        }
                        m = m + 1
                    }
                    if !dup {
                        found.push(ident)
                    }
                }
                i = k
            }
        }
        i = i + 1
    }
    return sort_strs(found)
}

# join_with(items, sep) — "|".join.
fn join_with(items: list[str], sep: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < items.len() {
        if i > 0 {
            out = out + sep
        }
        out = out + items.get(i)
        i = i + 1
    }
    return out
}

# count_dotted_fns(stdlib) — fn keys containing "." across modules.
fn count_dotted_fns(stdlib: JsonValue) -> int {
    let mut n: int = 0
    let mut i: int = 0
    while i < stdlib.obj_vals.len() {
        let m: JsonValue = stdlib.obj_vals.get(i)
        let fns: JsonValue = json_object_get(m, "fns")
        if json_is_object(fns) {
            let mut k: int = 0
            while k < fns.obj_keys.len() {
                if fns.obj_keys.get(k).contains(".") {
                    n = n + 1
                }
                k = k + 1
            }
        }
        i = i + 1
    }
    return n
}

# ----------------------------------------------------------------------------
# Section 1 — the convention
# ----------------------------------------------------------------------------

fn section_1(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 1 — the convention")

    let freeze_p: str = path_join3(acc.root, "tests/api_freeze.json")
    let chain_p: str = path_join3(acc.root,
    "tests/api_freeze_amendments.jsonl")
    check(acc, "the freeze document exists at tests/api_freeze.json",
    file_exists(freeze_p), freeze_p)
    let doc: JsonValue = parse_json_or_null(read_file(freeze_p))
    check(acc, "the freeze is surface version 1",
    json_is_object(doc) && jget_int(doc, "surface_version") == 1,
    jget_int(doc, "surface_version").to_str())
    check(acc, "the freeze names its tool",
    jget_str(doc, "tool") == "hls-freeze", jget_str(doc, "tool"))
    check(acc, "the freeze is Stage 141", jget_int(doc, "stage") == 141,
    jget_int(doc, "stage").to_str())
    check(acc, "the freeze stamps v0.159.0-alpha",
    jget_str(doc, "release") == "0.159.0-alpha",
    jget_str(doc, "release"))

    let fc: str = jget_str(doc, "frozen_commit")
    let mut fc_hex: bool = fc.len() == 40
    if fc_hex {
        let mut i: int = 0
        while i < fc.len() {
            let c: int = fc.byte_at(i)
            if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) {
                fc_hex = false
            }
            i = i + 1
        }
    }
    check(acc, "the frozen commit is a 40-hex sha", fc_hex, fc)

    # The self-consistency law, through the gate's own canonicaliser.
    let want: str = sha256_hex(canon(json_object_get(doc, "surface")))
    check(acc, "the digest is the sha256 of the canonical surface it "
    + "carries (gate's own canonicaliser)",
    jget_str(doc, "digest") == want,
    jget_str(doc, "digest") + " vs " + want)

    # The chain: present, carrying the four amendments on record,
    # replaying under the family's arithmetic.
    check(acc, "the amendment chain exists beside the freeze",
    file_exists(chain_p), chain_p)
    let records: list[JsonValue] = jsonl_records(read_file(chain_p))
    check(acc, "the chain carries the four amendments on record "
    + "(sha256, the census words, the probe pair, the deep-scan std fixes)",
    records.len() == 4, records.len().to_str())
    let mut rec_ok: bool = records.len() == 4
    if rec_ok {
        let r1: JsonValue = records.get(0)
        let r3: JsonValue = records.get(2)
        let r4: JsonValue = records.get(3)
        rec_ok = jget_int(r1, "seq") == 1
        && arr_has_str(json_object_get(json_object_get(r1, "delta"),
        "added"), "stdlib.std.sha256")
        && jget_int(r3, "seq") == 3
        && arr_has_str(json_object_get(json_object_get(r3, "delta"),
        "changed"),
        "syntax.builtin_fns")
        && jget_int(r4, "seq") == 4
        && arr_has_str(json_object_get(json_object_get(r4, "delta"),
        "added"), "stdlib.std.cookie.fns.cookie_b64url_ok")
        && arr_has_str(json_object_get(json_object_get(r4, "delta"),
        "changed"),
        "stdlib.std.json_stream.structs.JsonReader.fields")
    }
    check(acc, "seq 1 amends in stdlib.std.sha256, seq 3 in the "
    + "checker's builtin chain (the DAP probe pair), seq 4 in the "
    + "cookie validator and the JsonReader separator phase",
    rec_ok, clip(json_stringify(records.get(records.len() - 1)), 80))
    # The replay: seq order, prev chaining, every chain_hash recomputed
    # through the gate's own copy of the family's arithmetic.
    let mut replay_ok: bool = records.len() > 0
    let mut prev: str = hex64("0")
    let mut want_seq: int = 1
    let mut ri: int = 0
    while ri < records.len() {
        let rec: JsonValue = records.get(ri)
        if jget_int(rec, "seq") != want_seq
        || jget_str(rec, "prev_hash") != prev
        || jget_str(rec, "chain_hash")
        != gate_chain_of(jget_str(rec, "prev_hash"), rec) {
            replay_ok = false
        }
        prev = jget_str(rec, "chain_hash")
        want_seq = want_seq + 1
        ri = ri + 1
    }
    check(acc, "the chain replays under the gate's own arithmetic "
    + "(seq order, prev chaining, every hash recomputed)",
    replay_ok, records.len().to_str() + " records")

    # The tools answer on the real tree.
    let p: RunResult = freeze_run(acc, ["status"], "")
    check(acc, "status answers IDENTICAL on the tree",
    p.code == 0 && p.combined.contains("IDENTICAL"),
    clip(first_line(p.combined), 120))
    let p2: RunResult = freeze_run(acc, ["verify", "--quiet"], "")
    check(acc, "verify is green on the tree", p2.code == 0,
    clip(first_line(p2.combined), 120))

    # The freeze travels with the repository.
    let gl: RunResult = run_capture("git",
    ["ls-files", "tests/api_freeze.json",
    "tests/api_freeze_amendments.jsonl"])
    let named: list[str] = gl.out.trim().split("\n")
    let mut both: bool = false
    let mut has_j: bool = false
    let mut has_c: bool = false
    let mut i: int = 0
    while i < named.len() {
        let t: str = named.get(i).trim()
        if t == "tests/api_freeze.json" {
            has_j = true
        }
        if t == "tests/api_freeze_amendments.jsonl" {
            has_c = true
        }
        i = i + 1
    }
    both = has_j && has_c
    check(acc, "both freeze files are committed (git ls-files names them)",
    both, gl.out.trim())
}

# jsonl_records(text) — one parsed record per non-empty line.
fn jsonl_records(text: str) -> list[JsonValue] {
    let out: list[JsonValue] = []
    let lines: list[str] = text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let t: str = lines.get(i).trim()
        if t != "" {
            out.push(parse_json_or_null(t))
        }
        i = i + 1
    }
    return out
}

# arr_has_str(v, needle) — needle in v (a JSON array of strings).
fn arr_has_str(v: JsonValue, needle: str) -> bool {
    if !json_is_array(v) {
        return false
    }
    let mut i: int = 0
    while i < v.arr.len() {
        if json_is_str(v.arr.get(i)) && v.arr.get(i).sval == needle {
            return true
        }
        i = i + 1
    }
    return false
}

# ----------------------------------------------------------------------------
# Section 2 — the syntax law
# ----------------------------------------------------------------------------

# syn_list_equals_live(syn_arr, live_line) — the frozen array equals the
# child's sorted "|"-joined line.
fn syn_list_equals_live(syn_arr: JsonValue, live_line: str) -> bool {
    if !json_is_array(syn_arr) {
        return false
    }
    let items: list[str] = []
    let mut i: int = 0
    while i < syn_arr.arr.len() {
        if !json_is_str(syn_arr.arr.get(i)) {
            return false
        }
        items.push(syn_arr.arr.get(i).sval)
        i = i + 1
    }
    return join_with(items, "|") == live_line
}

fn section_2(acc: Acc, syn: JsonValue) -> void uses IO, Fs, Proc {
    section("Section 2 — the syntax law")

    # The live tables, derived by the gate's own readers out of the
    # tree's own front-end source.
    let types_src: str = read_file(path_join3(acc.root,
    "src/hlc/types.hls"))
    let parser_src: str = read_file(path_join3(acc.root,
    "src/hlc/parser.hls"))
    let lexer_src: str = read_file(path_join3(acc.root,
    "src/hlc/lexer.hls"))
    let live_kw: str = join_with(
    chain_words(types_src, "is_keyword", "lower"), "|")
    let live_res: str = join_with(reserved_ids(parser_src), "|")
    let live_two: str = join_with(two_char(lexer_src), "|")
    let live_one: str = join_with(one_char(lexer_src), "|")
    let live_eff: str = join_with(
    chain_words(types_src, "is_effect_name", "upper"), "|")
    let live_attrs: str = join_with(crate_attrs(parser_src), "|")
    let live_blt: str = join_with(builtin_fns(acc), "|")

    check(acc, "the frozen keywords are exactly the compiler's live "
    + "chain (src/hlc/types.hls)",
    syn_list_equals_live(json_object_get(syn, "keywords"), live_kw),
    clip(live_kw, 120))

    check(acc, "the frozen reserved identifiers are exactly the "
    + "parser's check",
    syn_list_equals_live(
    json_object_get(syn, "reserved_identifiers"), live_res),
    clip(live_res, 120))

    check(acc, "the frozen two-char tokens are exactly the lexer's "
    + "chain",
    syn_list_equals_live(json_object_get(syn, "tokens_two_char"),
    live_two),
    clip(live_two, 120))

    check(acc, "the frozen one-char tokens are exactly the lexer's "
    + "chain",
    syn_list_equals_live(json_object_get(syn, "tokens_one_char"),
    live_one),
    clip(live_one, 120))

    check(acc, "the frozen effect vocabulary is exactly the "
    + "compiler's chain",
    syn_list_equals_live(json_object_get(syn, "effects"), live_eff),
    clip(live_eff, 120))

    check(acc, "the frozen crate attributes are exactly the parser's "
    + "refusal",
    syn_list_equals_live(json_object_get(syn, "crate_attrs"),
    live_attrs),
    clip(live_attrs, 120))

    check(acc, "the frozen builtin fns are exactly the checker's "
    + "chain",
    syn_list_equals_live(json_object_get(syn, "builtin_fns"),
    live_blt),
    clip(live_blt, 120))

    # The two-front-end agreement, grepped by the gate itself.
    let text: str = read_file(path_join3(acc.root, "src/hlc/types.hls"))
    let anchor: str = "fn is_keyword(w: str) -> bool {"
    let start: int = text.find(anchor)
    let mut greppable: bool = start >= 0
    let mut body: str = ""
    if greppable {
        let end: int = find_from(text, "\n}", start + anchor.len())
        greppable = end > start
        if greppable {
            body = text.slice(start + anchor.len(), end)
        }
    }
    check(acc, "the self-hosted keyword chain is greppable", greppable, "")
    if greppable {
        let selfhost: list[str] = collect_eq_idents(body)
        # the second front-end is the formatter now: its chain must
        # equal the compiler's (the tool's agreement law, read by the
        # gate's own grep)
        let fmt_src: str = read_file(path_join3(acc.root,
        "tools/hlfmt.hls"))
        let fmt_kw: str = join_with(
        chain_words(fmt_src, "is_keyword", "lower"), "|")
        let frozen_ok: bool =
        syn_list_equals_live(json_object_get(syn, "keywords"),
        join_with(selfhost, "|"))
        check(acc, "the self-hosted chain equals the formatter's set",
        join_with(selfhost, "|") == fmt_kw,
        clip(join_with(selfhost, "|"), 120))
        check(acc, "the frozen keywords equal the self-hosted chain",
        frozen_ok
        && syn_list_equals_live(
        json_object_get(syn, "keywords"),
        join_with(selfhost, "|")),
        "")
    }

    # The attribute census, probed live by the gate.
    let diag: RunResult = checker_verdict(acc, "s2/census_probe.hls",
    "#[zz_gate_census]\nfn main() -> void { return }\n")
    let diag_txt: str = diag.combined
    check(acc, "the junk-attribute probe is refused with the known-list",
    diag.code != 0
    && diag_txt.contains("unknown attribute")
    && diag_txt.contains("known:"),
    clip(first_line(diag_txt), 120))
    if diag_txt.contains("known:") {
        let cut_i: int = diag_txt.find("known:")
        let mut tail: str = diag_txt.slice(cut_i + 6, diag_txt.len())
        let cut: int = tail.find(" (line")
        if cut != -1 {
            tail = tail.slice(0, cut)
        }
        let mut live_raw: str = tail.trim()
        if live_raw.len() >= 2
        && live_raw.slice(live_raw.len() - 2, live_raw.len()) == "))" {
            live_raw = live_raw.slice(0, live_raw.len() - 1)
        }
        check(acc, "the frozen attribute census is the parser's live words",
        jget_str(syn, "fn_attr_census_raw") == live_raw,
        clip(live_raw, 120))
        let fn_attrs: JsonValue = json_object_get(syn, "fn_attrs")
        let mut n_attrs: int = -1
        if json_is_array(fn_attrs) {
            n_attrs = fn_attrs.arr.len()
        }
        check(acc, "the frozen attribute vocabulary carries 16 names "
        + "including deprecated and taint_sink",
        n_attrs == 16 && arr_has_str(fn_attrs, "deprecated")
        && arr_has_str(fn_attrs, "taint_sink"),
        n_attrs.to_str())
    }

    # The primitive method tables, read from the checker's own
    # dispatch, compared row for row.
    let bm: JsonValue = json_object_get(syn, "builtin_methods")
    check(acc, "the str method table is the checker's own",
    canon(json_object_get(bm, "str")) == prim_mtable(acc, "str"),
    "")
    check(acc, "the int method table is the checker's own",
    canon(json_object_get(bm, "int")) == prim_mtable(acc, "int"),
    "")
    check(acc, "the float method table is the checker's own",
    canon(json_object_get(bm, "float")) == prim_mtable(acc, "float"),
    "")
    check(acc, "the bool method table is the checker's own",
    canon(json_object_get(bm, "bool")) == prim_mtable(acc, "bool"),
    "")

    # The container / concurrency method surface, DEMONSTRATED: the
    # gate's own probes through the real checker.
    # (the probes are the battery's, verbatim — the underscore
    # bindings are the battery's own "value computed, not used" probe
    # shape; the checker they exercise accepts them)
    let p1: str = write_src(acc, "s2/probe_list_push.hls",
    "fn main() -> void {\n    let xs: list[int] = [1, 2]\n"
    + "    xs.push(3)\n    let _n: int = xs.len()\n"
    + "    return\n}\n")
    let p2: str = write_src(acc, "s2/probe_list_get.hls",
    "fn main() -> void {\n    let xs: list[int] = [1]\n"
    + "    let _x: int = xs.get(0)\n    return\n}\n")
    let p3: str = write_src(acc, "s2/probe_chan_recv.hls",
    "fn main() -> void uses Conc {\n"
    + "    let ch: Chan[int] = chan_new()\n"
    + "    let _x: int = ch.recv()\n    return\n}\n")
    let p4: str = write_src(acc, "s2/probe_chan_try.hls",
    "fn main() -> void uses Conc {\n"
    + "    let ch: Chan[int] = chan_new()\n"
    + "    let _b: bool = ch.try_send(1)\n    return\n}\n")
    let p5: str = write_src(acc, "s2/probe_task_join.hls",
    "fn __work() -> int { return 7 }\n"
    + "fn main() -> void uses Conc {\n"
    + "    let t: Task[int] = spawn(__work)\n"
    + "    let _x: int = t.join()\n    return\n}\n")
    let p6: str = write_src(acc, "s2/probe_map_get_or.hls",
    "fn main() -> void {\n"
    + "    let m: map[str, int] = map_new()\n"
    + "    let _x: int = m.get_or(\"k\", 1)\n    return\n}\n")
    let p7: str = write_src(acc, "s2/probe_str_byte_at.hls",
    "fn main() -> void {\n    let s: str = \"abc\"\n"
    + "    let _n: int = s.byte_at(0)\n    return\n}\n")
    let p8: str = write_src(acc, "s2/probe_list_junk.hls",
    "fn main() -> void {\n    let xs: list[int] = [1]\n"
    + "    let _x: int = xs.zz_gate_junk(1)\n    return\n}\n")
    let p9: str = write_src(acc, "s2/probe_chan_junk.hls",
    "fn main() -> void uses Conc {\n"
    + "    let ch: Chan[int] = chan_new()\n"
    + "    let _x: int = ch.zz_gate_junk()\n    return\n}\n")

    check_probe(acc, p1, "list.push", true, bm)
    check_probe(acc, p2, "list.get", true, bm)
    check_probe(acc, p3, "chan.recv", true, bm)
    check_probe(acc, p4, "chan.try_send", true, bm)
    check_probe(acc, p5, "task.join", true, bm)
    check_probe(acc, p6, "map.get_or", true, bm)
    check_probe(acc, p7, "str.byte_at", true, bm)
    check_probe(acc, p8, "list junk", false, bm)
    check_probe(acc, p9, "chan junk", false, bm)
}

# check_probe(acc, path, label, expect_accept, bm) — one probe through
# the real checker, plus the roster row for the named labels.
fn check_probe(acc: Acc, path: str, label: str, expect_accept: bool,
bm: JsonValue) -> void uses IO, Fs, Proc {
    let r: RunResult = boot_check(acc, path)
    let verdict: str = first_line(r.combined)
    if expect_accept {
        check(acc, "the probe channel accepts " + label
        + " (demonstrated, not asserted)",
        r.code == 0, clip(verdict, 120))
        if label == "list.push" || label == "chan.recv"
        || label == "task.join" || label == "map.get_or"
        || label == "str.byte_at" {
            let dot: int = label.find(".")
            let kind: str = label.slice(0, dot)
            let name: str = label.slice(dot + 1, label.len())
            check(acc, "the frozen roster carries " + name + " for " + kind,
            json_object_has(json_object_get(bm, kind), name), "")
        }
    } else {
        check(acc, "the probe channel refuses " + label,
        r.code != 0 && r.combined.contains("no method"),
        clip(verdict, 120))
    }
}

# find_from(text, needle, from) — text.find(needle, from).
fn find_from(text: str, needle: str, from: int) -> int {
    if from >= text.len() {
        return -1
    }
    let rel: int = text.slice(from, text.len()).find(needle)
    if rel < 0 {
        return -1
    }
    return from + rel
}

# ----------------------------------------------------------------------------
# Section 3 — the census law
# ----------------------------------------------------------------------------

fn section_3(acc: Acc, stdlib_frozen: JsonValue) -> void uses IO, Fs, Proc {
    section("Section 3 — the census law")

    let live: str = stdsurface(acc)
    check(acc, "the frozen stdlib census equals the gate's own "
    + "re-derivation, canonically",
    live != ""
    && canon(stdlib_frozen) == live,
    "canon bytes: frozen " + canon(stdlib_frozen).len().to_str()
    + ", live " + live.len().to_str())

    let fns: int = sum_modules(stdlib_frozen, "fns")
    let structs: int = sum_modules(stdlib_frozen, "structs")
    let enums: int = sum_modules(stdlib_frozen, "enums")
    let edges: int = sum_modules(stdlib_frozen, "imports")
    check(acc, "99 modules are frozen (sha256 amended in)",
    stdlib_frozen.obj_keys.len() == 99,
    stdlib_frozen.obj_keys.len().to_str())
    check(acc, "3429 stdlib fns are frozen", fns == 3429, fns.to_str())
    check(acc, "185 stdlib structs are frozen", structs == 185,
    structs.to_str())
    check(acc, "36 stdlib enums are frozen", enums == 36, enums.to_str())
    check(acc, "213 import edges are frozen", edges == 213, edges.to_str())

    # Row-level spot checks.
    let hex_mod: JsonValue = json_object_get(stdlib_frozen, "std.hex")
    let hex_fns: JsonValue = json_object_get(hex_mod, "fns")
    check(acc, "std.hex carries hex_byte in the freeze",
    json_object_has(hex_fns, "hex_byte"), "")
    if json_object_has(hex_fns, "hex_byte") {
        let rec: JsonValue = json_object_get(hex_fns, "hex_byte")
        let params: JsonValue = json_object_get(rec, "params")
        let mut sig_ok: bool = json_is_array(params) && params.arr.len() == 1
        if sig_ok {
            let row: JsonValue = params.arr.get(0)
            sig_ok = json_is_array(row) && row.arr.len() == 3
            && json_is_str(row.arr.get(0)) && row.arr.get(0).sval == "b"
            && json_is_str(row.arr.get(1)) && row.arr.get(1).sval == "int"
            && json_is_bool(row.arr.get(2))
            && row.arr.get(2).bval == false
        }
        check(acc, "hex_byte's frozen signature is (b: int) -> str",
        sig_ok && jget_str(rec, "ret") == "str",
        clip(json_stringify(rec), 120))
    }

    # A method-keyed fn (impl Struct.method) lands in the census.
    let dotted: int = count_dotted_fns(stdlib_frozen)
    check(acc, "impl methods are frozen under their Struct.method keys ("
    + dotted.to_str() + " of them)",
    dotted > 0, dotted.to_str())
}

# sum_modules(stdlib, key) — sum of len(m[key]) over the modules.
fn sum_modules(stdlib: JsonValue, key: str) -> int {
    let mut n: int = 0
    let mut i: int = 0
    while i < stdlib.obj_vals.len() {
        let x: JsonValue = json_object_get(stdlib.obj_vals.get(i), key)
        if json_is_object(x) {
            n = n + x.obj_keys.len()
        } else if json_is_array(x) {
            n = n + x.arr.len()
        }
        i = i + 1
    }
    return n
}

# ----------------------------------------------------------------------------
# Section 4 — the removal law
# ----------------------------------------------------------------------------

fn section_4(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 4 — the removal law")

    let root: str = make_scratch(acc, "removal")

    # (a) a deleted stdlib fn is REMOVED at its dotted path.
    let hex_path: str = path_join3(root, "std/hex.hls")
    let src: str = read_file(hex_path)
    let i: int = src.find("fn hex_byte")
    let j: int = find_from(src, "\nfn ", i + 1)
    check(acc, "the scratch edit finds hex_byte's span", i > 0 && j > i,
    i.to_str() + " / " + j.to_str())
    if i > 0 && j > i {
        write_file(hex_path, src.slice(0, i) + src.slice(j, src.len()))
        let p: RunResult = freeze_run(acc, ["verify", "--root", root], root)
        check(acc, "a removed export is drift, exit 1",
        p.code == 1 && p.combined.contains("DRIFTED"),
        clip(first_line(p.combined), 120))
        check(acc, "the removal is named at its dotted path",
        p.out.contains("REMOVED")
        && p.combined.contains("stdlib.std.hex.fns.hex_byte"),
        clip(first_line(p.combined), 120))
        write_file(hex_path, src)
        let p2: RunResult = freeze_run(acc,
        ["verify", "--quiet", "--root", root], root)
        check(acc, "the revert is green again", p2.code == 0,
        clip(first_line(p2.combined), 120))
    } else {
        check(acc, "a removed export is drift, exit 1", false, "no span")
        check(acc, "the removal is named at its dotted path", false,
        "no span")
        check(acc, "the revert is green again", false, "no span")
    }

    # (b) a keyword removed from BOTH front-ends is syntax drift —
    # the two front-ends are the compiler and the formatter now.
    let fmt_hls: str = path_join3(root, "tools/hlfmt.hls")
    let types_hls: str = path_join3(root, "src/hlc/types.hls")
    let fl: str = read_file(fmt_hls)
    let th: str = read_file(types_hls)
    write_file(fmt_hls, replace_first(fl, "word == \"where\"",
    "word == \"__moved__\""))
    let p3: RunResult = freeze_run(acc, ["verify", "--root", root], root)
    check(acc, "a one-front-end keyword removal is refused outright (the "
    + "agreement law fires first)",
    p3.code == 1 && p3.combined.contains("front-ends disagree"),
    clip(first_line(p3.combined), 120))
    write_file(fmt_hls, fl)

    # Now both: the formatter's chain and the compiler's.
    write_file(fmt_hls, replace_first(fl, "word == \"where\"",
    "word == \"__moved__\""))
    write_file(types_hls,
    replace_first(th, "|| w == \"where\"",
    "|| w == \"__moved__\""))
    let p4: RunResult = freeze_run(acc, ["verify", "--root", root], root)
    check(acc, "a keyword removed from both front-ends is drift",
    p4.code == 1 && p4.combined.contains("DRIFTED"),
    clip(first_line(p4.combined), 120))
    check(acc, "the keyword drift is named in the syntax section",
    p4.out.contains("syntax.keywords"),
    clip(first_line(p4.combined), 120))
    write_file(fmt_hls, fl)
    write_file(types_hls, th)
}

# ----------------------------------------------------------------------------
# Section 5 — the mutation law
# ----------------------------------------------------------------------------

# expect_drift(acc, root, hex_path, restore, tag, needle) — the
# battery's expect_drift: the verify run names the row, then the file
# is restored and the quiet re-verify green.
fn expect_drift(acc: Acc, root: str, hex_path: str, restore: str, tag: str,
needle: str) -> void uses IO, Proc {
    let p: RunResult = freeze_run(acc, ["verify", "--root", root], root)
    check(acc, tag + " is named at its path",
    p.code == 1 && p.combined.contains(needle),
    clip(first_line(p.combined), 120))
    write_file(hex_path, restore)
    freeze_run(acc, ["verify", "--quiet", "--root", root], root)
}

fn section_5(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 5 — the mutation law")

    let root: str = make_scratch(acc, "mutation")
    let hex_path: str = path_join3(root, "std/hex.hls")
    let src: str = read_file(hex_path)

    # (a) a parameter type change.
    write_file(hex_path, replace_first(src, "fn hex_byte(b: int) -> str",
    "fn hex_byte(b: str) -> str"))
    expect_drift(acc, root, hex_path, src, "a parameter type change",
    "fns.hex_byte.params")

    # (b) a return type change.
    write_file(hex_path, replace_first(src, "fn hex_byte(b: int) -> str",
    "fn hex_byte(b: int) -> int"))
    expect_drift(acc, root, hex_path, src, "a return type change",
    "fns.hex_byte.ret")

    # (c) an effect clause change (a pure fn grows uses IO).
    let ci: int = src.find("fn hex_byte(b: int) -> str {")
    if ci >= 0 {
        write_file(hex_path, src.slice(0, ci)
        + "fn hex_byte(b: int) -> str uses IO {"
        + src.slice(ci + "fn hex_byte(b: int) -> str {".len(),
        src.len()))
        expect_drift(acc, root, hex_path, src, "an effect clause change",
        "fns.hex_byte.effects")
    } else {
        check(acc, "an effect clause change is named at its path", false,
        "no span")
    }

    # (d) a removed enum variant.
    let opt_path: str = path_join3(root, "core/option.hls")
    let opt: str = read_file(opt_path)
    let oi: int = opt.find("enum Option")
    let mut has_enum: bool = oi >= 0
    if has_enum {
        has_enum = find_from(opt, "{", oi) > oi
    }
    check(acc, "core.option carries the Option enum", has_enum, "")
    if has_enum {
        # the exact variant line: None carries no payload and closes
        # the enum body
        check(acc, "the None variant's span is found",
        opt.contains("    None\n}"), "")
        if opt.contains("    None\n}") {
            write_file(opt_path, replace_first(opt, "    None\n}", "}"))
            let p: RunResult = freeze_run(acc, ["verify", "--root", root],
            root)
            check(acc, "a removed enum variant is named at its path",
            p.code == 1
            && p.combined.contains("stdlib.core.option.enums."
            + "Option.variants"),
            clip(first_line(p.combined), 120))
            write_file(opt_path, opt)
        }
    }

    # (e) a removed struct field.
    let io_path: str = path_join3(root, "std/io.hls")
    let io_src: str = read_file(io_path)
    let si: int = io_src.find("struct ")
    let mut has_struct: bool = si >= 0
    let mut brace: int = -1
    if has_struct {
        brace = find_from(io_src, "{", si)
        has_struct = brace > si
    }
    check(acc, "std.io carries a struct", has_struct, "")
    if has_struct {
        let f_colon: int = find_from(io_src, ":", brace)
        let mut f_name_start: int = brace
        let mut k: int = brace
        while k < f_colon {
            if io_src.byte_at(k) == 32 {
                f_name_start = k
            }
            k = k + 1
        }
        let mut line_end: int = find_from(io_src, ",", f_colon)
        if line_end == -1 {
            line_end = find_from(io_src, "}", f_colon)
        }
        if f_colon > f_name_start && line_end > f_colon {
            write_file(io_path, io_src.slice(0, f_name_start + 1)
            + io_src.slice(line_end + 1, io_src.len()))
            let p2: RunResult = freeze_run(acc, ["verify", "--root", root],
            root)
            check(acc, "a removed struct field is named at its path",
            p2.code == 1 && p2.combined.contains(".fields"),
            clip(first_line(p2.combined), 120))
            write_file(io_path, io_src)
        } else {
            check(acc, "a removed struct field is named at its path", false,
            "no field span")
        }
    }

    # (f) a newly-deprecated fn: the record GAINS a key.
    let i3: int = src.find("fn hex_byte")
    if i3 >= 0 {
        write_file(hex_path, src.slice(0, i3)
        + "#[deprecated(\"use hex_encode\")]\n"
        + src.slice(i3, src.len()))
        let p3: RunResult = freeze_run(acc, ["verify", "--root", root], root)
        check(acc, "a new deprecation is drift at the record's path",
        p3.code == 1 && p3.combined.contains("ADDED")
        && p3.combined.contains("fns.hex_byte.deprecated"),
        clip(first_line(p3.combined), 120))
        write_file(hex_path, src)
    } else {
        check(acc, "a new deprecation is drift at the record's path", false,
        "no span")
    }
}

# ----------------------------------------------------------------------------
# Section 6 — the addition law
# ----------------------------------------------------------------------------

fn section_6(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 6 — the addition law")

    let root: str = make_scratch(acc, "addition")
    let hex_path: str = path_join3(root, "std/hex.hls")
    let src: str = read_file(hex_path)

    # (a) a new stdlib fn is ADDED drift.
    write_file(hex_path, src + "\nfn hex_freeze_new(x: int) -> int "
    + "{ return x + 1 }\n")
    let p: RunResult = freeze_run(acc, ["verify", "--root", root], root)
    check(acc, "a post-freeze addition is drift, named at its path",
    p.code == 1 && p.combined.contains("ADDED")
    && p.combined.contains("stdlib.std.hex.fns.hex_freeze_new"),
    clip(first_line(p.combined), 120))
    write_file(hex_path, src)

    # (b) a new builtin: the checker's own chain grew.
    let checker_hls: str = path_join3(root, "src/hlc/checker.hls")
    let csrc: str = read_file(checker_hls)
    write_file(checker_hls, replace_first(csrc,
    "n == \"range\"",
    "n == \"range\" || n == \"zz_gate_new_builtin\""))
    let p2: RunResult = freeze_run(acc, ["verify", "--root", root], root)
    check(acc, "a grown builtin table is syntax drift, named",
    p2.code == 1 && p2.combined.contains("syntax.builtin_fns"),
    clip(first_line(p2.combined), 120))
    write_file(checker_hls, csrc)

    # (c) the contrast: a comment-only edit moves NO row.
    write_file(hex_path, "# a comment the freeze must not see\n" + src)
    let p3: RunResult = freeze_run(acc,
    ["verify", "--quiet", "--root", root], root)
    check(acc, "a comment-only edit is NOT drift (the contract, not the "
    + "bytes)",
    p3.code == 0, clip(first_line(p3.combined), 120))
}

# ----------------------------------------------------------------------------
# Section 7 — the amend law
# ----------------------------------------------------------------------------

fn section_7(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 7 — the amend law")

    let root: str = make_scratch(acc, "amend")
    let hex_path: str = path_join3(root, "std/hex.hls")
    let src: str = read_file(hex_path)
    let freeze_p: str = path_join3(root, "tests/api_freeze.json")
    let chain_p: str = path_join3(root, "tests/api_freeze_amendments.jsonl")
    let old_digest: str = jget_str(
    parse_json_or_null(read_file(freeze_p)), "digest")

    # (a) the refusals, named.
    let p: RunResult = freeze_run(acc,
    ["amend", "--by", "tester", "--root", root], root)
    check(acc, "missing --reason is a usage error", p.code == 2,
    p.code.to_str())
    let p2: RunResult = freeze_run(acc,
    ["amend", "--reason", "   ", "--by", "tester", "--root", root],
    root)
    check(acc, "a whitespace-only reason is a named refusal",
    p2.code == 1 && p2.combined.contains("without a written reason"),
    clip(first_line(p2.combined), 120))
    let p3: RunResult = freeze_run(acc,
    ["amend", "--reason", "a real reason", "--root", root], root)
    check(acc, "missing --by is a usage error", p3.code == 2,
    p3.code.to_str())
    let p4: RunResult = freeze_run(acc,
    ["amend", "--reason", "a real reason", "--by", "tester", "--root",
    root], root)
    check(acc, "a no-op amendment is refused (noise is how real amendments "
    + "stop being read)",
    p4.code == 1 && p4.combined.contains("nothing to amend"),
    clip(first_line(p4.combined), 120))

    # (b) the real amendment: the drift is absorbed, exactly one
    # record lands, the delta is the diff the tool computed. The
    # chain under test carries every amendment the line has filed
    # (three today); the gate takes the count as it finds it and
    # asserts the ONE-record law against it.
    let pre: int = jsonl_records(read_file(chain_p)).len()
    write_file(hex_path, src + "\nfn hex_freeze_new(x: int) -> int "
    + "{ return x + 1 }\n")
    let p5: RunResult = freeze_run(acc,
    ["amend", "--reason",
    "std.hex grows a helper for the v0.160 formatter",
    "--by", "mhieuhonda", "--root", root], root)
    check(acc, "a real amendment succeeds",
    p5.code == 0 && p5.combined.contains("AMENDED"),
    clip(first_line(p5.combined), 120))
    let records: list[JsonValue] = jsonl_records(read_file(chain_p))
    check(acc, "exactly one record appended (the chain carried "
    + pre.to_str() + " records already)",
    records.len() == pre + 1, records.len().to_str())
    if records.len() == pre + 1 {
        let rec: JsonValue = records.get(pre)
        check(acc, "the record is seq " + (pre + 1).to_str(),
        jget_int(rec, "seq") == pre + 1,
        jget_int(rec, "seq").to_str())
        check(acc, "the record is an amendment",
        jget_str(rec, "kind") == "amend", jget_str(rec, "kind"))
        check(acc, "the record names its author",
        jget_str(rec, "by") == "mhieuhonda", jget_str(rec, "by"))
        check(acc, "the record carries the written reason",
        jget_str(rec, "reason").contains("v0.160 formatter"),
        clip(jget_str(rec, "reason"), 80))
        check(acc, "the recorded delta is the diff the tool computed",
        arr_has_str(json_object_get(json_object_get(rec, "delta"),
        "added"), "stdlib.std.hex.fns.hex_freeze_new"),
        clip(json_stringify(json_object_get(rec, "delta")), 120))
        check(acc, "the record's from_digest is the digest it amended away",
        jget_str(rec, "from_digest") == old_digest
        && old_digest != "",
        "")

        # (c) the chain, re-derived through the family's arithmetic.
        check(acc, "the new record chains from the record before it",
        jget_str(rec, "prev_hash")
        == jget_str(records.get(pre - 1), "chain_hash"),
        "")
        check(acc, "chain_hash recomputes through the gate's own copy "
        + "of the family's chain_of",
        jget_str(rec, "chain_hash")
        == gate_chain_of(jget_str(rec, "prev_hash"), rec)
        && jget_str(rec, "chain_hash") != "",
        jget_str(rec, "chain_hash"))

        # (d) the document moved WITH the chain.
        let new_doc: JsonValue = parse_json_or_null(read_file(freeze_p))
        let hex_row: JsonValue = json_object_get(
        json_object_get(json_object_get(new_doc, "surface"), "stdlib"),
        "std.hex")
        check(acc, "the amended document carries the added export",
        json_object_has(json_object_get(hex_row, "fns"),
        "hex_freeze_new"),
        "")
        check(acc, "the new digest is the record's to_digest",
        jget_str(new_doc, "digest") == jget_str(rec, "to_digest"),
        "")
        check(acc, "the amended document agrees with itself (gate's own "
        + "canonicaliser)",
        sha256_hex(canon(json_object_get(new_doc, "surface")))
        == jget_str(new_doc, "digest"),
        "")
        let p6: RunResult = freeze_run(acc,
        ["verify", "--quiet", "--root", root], root)
        check(acc, "verify is green after the amendment", p6.code == 0,
        clip(first_line(p6.combined), 120))
    } else {
        check(acc, "the record is seq " + (pre + 1).to_str(), false,
        "no records")
        check(acc, "the record is an amendment", false, "no records")
        check(acc, "the record names its author", false, "no records")
        check(acc, "the record carries the written reason", false,
        "no records")
        check(acc, "the recorded delta is the diff the tool computed",
        false, "no records")
        check(acc, "the record's from_digest is the digest it amended away",
        false, "no records")
        check(acc, "the new record chains from the record before it", false,
        "no records")
        check(acc, "chain_hash recomputes through the gate's own copy "
        + "of the family's chain_of",
        false, "no records")
        check(acc, "the amended document carries the added export", false,
        "no records")
        check(acc, "the new digest is the record's to_digest", false,
        "no records")
        check(acc, "the amended document agrees with itself (gate's own "
        + "canonicaliser)", false, "no records")
        check(acc, "verify is green after the amendment", false, "no "
        + "records")
    }

    # (e) a second amendment is refused — the drift is absorbed.
    let p7: RunResult = freeze_run(acc,
    ["amend", "--reason", "another", "--by", "tester", "--root", root],
    root)
    check(acc, "a second amendment with no drift is refused",
    p7.code == 1 && p7.combined.contains("nothing to amend"),
    clip(first_line(p7.combined), 120))

    # (f) a tampered record breaks the replay at its line — the gate
    # does the surgery itself now: the last record's reason changed,
    # its chain_hash zeroed, the file rewritten canonically.
    let records2: list[JsonValue] = jsonl_records(read_file(chain_p))
    if records2.len() == pre + 1 {
        if !tamper_last(chain_p, pre + 1) {
            check(acc, "a tampered record breaks the replay at its line",
            false, "the tamper surgery failed")
            return
        }
        let p8: RunResult = freeze_run(acc, ["verify", "--root", root],
        root)
        check(acc, "a tampered record breaks the replay at its line",
        p8.code == 1 && p8.combined.contains("BROKEN")
        && p8.combined.contains("record " + (pre + 1).to_str()),
        clip(first_line(p8.combined), 120))
        if !untamper(chain_p) {
            check(acc, "the restored chain replays clean", false,
            "the restore surgery failed")
            return
        }
        let p9: RunResult = freeze_run(acc,
        ["verify", "--quiet", "--root", root], root)
        check(acc, "the restored chain replays clean", p9.code == 0,
        clip(first_line(p9.combined), 120))
    } else {
        check(acc, "a tampered record breaks the replay at its line", false,
        "no records")
        check(acc, "the restored chain replays clean", false, "no records")
    }
}

# hex64(c) — "0" * 64.
fn hex64(c: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < 64 {
        out = out + c
        i = i + 1
    }
    return out
}

# tamper_last(chain_p, count) — the battery's tamper probe, native:
# the file is saved aside (.orig), the LAST record's reason changed
# and its chain_hash zeroed, every line rewritten canonically.
fn tamper_last(chain_p: str, count: int) -> bool uses Fs {
    let orig: str = read_file(chain_p)
    write_file(chain_p + ".orig", orig)
    let recs: list[JsonValue] = jsonl_records(orig)
    if recs.len() != count {
        return false
    }
    let mut out: str = ""
    let mut i: int = 0
    while i < recs.len() {
        let mut rec: JsonValue = recs.get(i)
        if i == count - 1 {
            rec = json_with_str(rec, "reason", "a different story")
            rec = json_with_str(rec, "chain_hash", hex64("0"))
        }
        if i > 0 {
            out = out + "\n"
        }
        out = out + canon(rec)
        i = i + 1
    }
    write_file(chain_p, out + "\n")
    return true
}

# untamper(chain_p) — restore the saved-aside original, byte for byte.
fn untamper(chain_p: str) -> bool uses Fs {
    let orig_p: str = chain_p + ".orig"
    if !file_exists(orig_p) {
        return false
    }
    write_file(chain_p, read_file(orig_p))
    return true
}

# ----------------------------------------------------------------------------
# Section 8 — the report + corpus showcase
# ----------------------------------------------------------------------------

fn section_8(acc: Acc) -> void uses IO, Fs, Proc {
    section("Section 8 — the report + corpus showcase")

    let root: str = make_scratch(acc, "report")
    let out1: str = scratch(acc, "api_report_1.md")
    let out2: str = scratch(acc, "api_report_2.md")
    let p: RunResult = freeze_run(acc,
    ["report", "--out", out1, "--root", root], root)
    check(acc, "the report renders from the freeze", p.code == 0,
    clip(first_line(p.combined), 120))
    if p.code != 0 {
        println("    report said: " + clip(p.out, 200))
        check(acc, "the report embeds the digest", false, "no report")
        check(acc, "the report names the stage and the release", false,
        "no report")
        check(acc, "the report carries the stdlib census (std.hex row)",
        false, "no report")
        check(acc, "the report carries the syntax surface", false,
        "no report")
        check(acc, "two renders of one freeze are byte-identical", false,
        "no report")
    } else {
        let r1: str = read_file(out1)
        let doc: JsonValue = parse_json_or_null(
        read_file(path_join3(root, "tests/api_freeze.json")))
        check(acc, "the report embeds the digest",
        r1.contains(jget_str(doc, "digest")), "")
        check(acc, "the report names the stage and the release",
        r1.contains("Stage 141") && r1.contains("v0.159.0-alpha"),
        "")
        check(acc, "the report carries the stdlib census (std.hex row)",
        r1.contains("hex_byte") && r1.contains("std.hex"),
        "")
        check(acc, "the report carries the syntax surface",
        r1.contains("keywords") && r1.contains("asm"),
        "")
        let p2: RunResult = freeze_run(acc,
        ["report", "--out", out2, "--root", root], root)
        check(acc, "two renders of one freeze are byte-identical",
        p2.code == 0 && read_file(out1) == read_file(out2),
        "")
    }

    # The verify-first refusal: a drifted tree renders nothing.
    let hex_path: str = path_join3(root, "std/hex.hls")
    let src: str = read_file(hex_path)
    write_file(hex_path, src + "\nfn zz_drift(x: int) -> int "
    + "{ return x }\n")
    let out3: str = scratch(acc, "api_report_3.md")
    let p3: RunResult = freeze_run(acc,
    ["report", "--out", out3, "--root", root], root)
    check(acc, "a report is never rendered from a drifted tree, and writes "
    + "no file",
    p3.code == 1 && !file_exists(out3),
    clip(first_line(p3.combined), 120))
    write_file(hex_path, src)

    # The corpus showcase.
    let showcase: str = path_join3(acc.root,
    "tests/ok/feat_stage141_apifreeze.hls")
    let showcase_out: str = "stage 141: api freeze\n"
    + "  freeze laws OK: drift vocabulary, amendment, digest,\n"
    + "  chain, count, method roster, contract, state machine\n"

    let p4: RunResult = boot_check(acc, showcase)
    check(acc, "the showcase boots through the real checker", p4.code == 0,
    clip(first_line(p4.combined), 120))
    let p5: RunResult = boot(acc, [showcase])
    check(acc, "the showcase runs green on the interpreter, exact output",
    p5.code == 0 && p5.out == showcase_out,
    clip(first_line(p5.combined), 120))
    let p6: RunResult = run_capture(path_join3(acc.root, "bin/hlfmt"),
    ["--check", showcase])
    check(acc, "the showcase is hlfmt-canonical", p6.code == 0,
    clip(first_line(p6.combined), 120))
    let p7: RunResult = run_capture("./bin/hllint", [showcase])
    check(acc, "the showcase is hllint-clean",
    p7.code == 0 && p7.combined.contains("no warnings"),
    clip(first_line(p7.combined), 120))

    let mut cc: str = "gcc"
    let ccv: Option[tainted[str]] = env_var("CC")
    if option_is_some(ccv) {
        cc = taint_unwrap(option_unwrap(ccv))
    }
    if file_exists(hlc_path(acc)) && which(cc) {
        let c_path: str = scratch(acc, "showcase.c")
        let bin_path: str = scratch(acc, "showcase_bin")
        let r1: RunResult = run_capture(hlc_path(acc), [showcase, c_path])
        if r1.code != 0 {
            check(acc, "hlc compiled the showcase", false,
            clip(r1.out.trim(), 120))
        } else {
            let r2: RunResult = run_capture(cc,
            ["-O2", "-o", bin_path, c_path, "-lm", "-pthread"])
            if r2.code != 0 {
                check(acc, "gcc compiled the showcase", false,
                clip(r2.out.trim(), 120))
            } else {
                let rn: RunResult = run_capture(bin_path, [])
                check(acc, "the showcase matches natively, byte for byte",
                rn.code == 0 && rn.out == showcase_out,
                clip(first_line(rn.combined), 120))
            }
        }
    } else {
        println("  (bin/hlc or cc not available — native differential "
        + "skipped, interpreter legs ran)")
    }
}

# ----------------------------------------------------------------------------
# main
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Fs, Proc, Exit {
    let acc: Acc = acc_new("freeze")

    let doc: JsonValue = parse_json_or_null(
    read_file(path_join3(acc.root, "tests/api_freeze.json")))
    let syn: JsonValue = json_object_get(
    json_object_get(doc, "surface"), "syntax")
    let stdlib_frozen: JsonValue = json_object_get(
    json_object_get(doc, "surface"), "stdlib")

    section_1(acc)
    section_2(acc, syn)
    section_3(acc, stdlib_frozen)
    section_4(acc)
    section_5(acc)
    section_6(acc)
    section_7(acc)
    section_8(acc)
    return finish(acc, "Stage 141 -- the API freeze")
}
