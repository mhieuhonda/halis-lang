# ============================================================================
# tests/acc/xbootstrap_acceptance.hls — Stage 92 acceptance gate, in Halis
# (the Halis twin of tests/xbootstrap_acceptance.py; same seven sections,
# same assertions, same needles — the harness is tests/acc/harness.hls and
# the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make xbootstrap-acceptance` (which compiles this file to
# bin/acc-xbootstrap and runs it from the repo root).
#
# Section 3 SPAWNS `make bootstrap-nolibc` as the test subject — the
# ladder is the thing under test, the gate only drives it. The ladder
# compiles the compiler several times; the leg runs for minutes.
#
#  1. the flag             — `hlc --no-libc` emits the no-libc runtime for
#                            a HOSTED source (crt0 _start, 3-arg main);
#                            the hosted output is unchanged; the flag
#                            cannot combine with #![freestanding]
#  2. the runtime shape    — raw syscall layer, mmap-backed arena, fd-
#                            backed streams, and NOT a single libc header
#  3. the ladder           — `make bootstrap-nolibc`: hosted hlc -> no-libc
#                            TU -> freestanding hlc -> byte-identical
#                            self-recompile + hosted parity
#  4. the binary honesty   — no undefined libc symbols, not dynamically
#                            linked
#  5. the parity           — the freestanding compiler emits byte-
#                            identical C for hosted AND no_std programs,
#                            and its --audit agrees word for word
#  6. the no-libc world    — a program using file IO, env, cwd, floats,
#                            and str conversions runs with no libc and
#                            matches the interpreter
#  7. the pinned gaps      — a no-libc program that reaches threads or
#                            directory listing fails the LINK with the
#                            exact name (the honest "not available")
# ============================================================================

import "./harness.hls"
import "std.str"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

fn demo() -> str {
    return "examples/hello.hls"
}

fn fs_exe() -> str {
    return "bin/hlc-fs"
}

fn libc_syms() -> list[str] {
    return ["fopen", "malloc", "free", "printf", "fprintf", "exit",
            "getenv", "strtod", "memcpy", "strlen"]
}

# shape_needles() — (needle, what) pairs, section 2's needs.
fn shape_needles() -> list[list[str]] {
    return [
        ["HL_SYS_exit_group 231L", "the x86-64 syscall numbers"],
        ["HL_SYS_openat", "the open path"],
        ["1073741824", "the 1 GiB reserved arena"],
        ["hl_nl_sys(long n", "the raw syscall layer"],
        ["#define stdout (&hl_nl_fout)", "the fd-backed stdout"],
        ["hl_nl_fopen", "the fd-backed fopen shim"],
        ["hl_nl_strtod", "the float parse shim"],
        ["hl_nl_vfmt", "the printf-family shim"],
    ]
}

fn parity_files() -> list[str] {
    return [demo(), "tests/ok/feat_stage91_irqsafe.hls",
            "tests/ok/feat_stage90_atomics.hls"]
}

# ----------------------------------------------------------------------------
# Shared legs: emit() and link_nl() — the battery's subprocess wrappers.
# ----------------------------------------------------------------------------

# emit(extra, src, out) — `./bin/hlc <extra...> src out`. The program and
# its args are separate in the harness (unlike Python's cmd[0] list), so
# args carries ONLY the flags + the two paths.
fn emit(extra: list[str], src: str, out: str) -> RunResult uses Proc {
    let args: list[str] = []
    let mut i: int = 0
    while i < extra.len() {
        args.push(extra.get(i))
        i = i + 1
    }
    args.push(src)
    args.push(out)
    return run_capture("./bin/hlc", args)
}

# gcc_nl_args(exe, cfile) — the no-libc link line.
fn gcc_nl_args(exe: str, cfile: str) -> list[str] {
    let a: list[str] = ["-O2", "-ffreestanding", "-nostdlib",
                        "-ffunction-sections", "-fno-stack-protector",
                        "-Wl,--gc-sections"]
    a.push("-o")
    a.push(exe)
    a.push(cfile)
    return a
}

fn link_nl(exe: str, cfile: str) -> RunResult uses Proc {
    return run_capture("gcc", gcc_nl_args(exe, cfile))
}

fn trunc(text: str, n: int) -> str {
    if text.len() <= n {
        return text
    }
    return text.slice(0, n)
}

fn last_lines(text: str, n: int) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: list[str] = []
    let mut i: int = lines.len() - n
    if i < 0 {
        i = 0
    }
    while i < lines.len() {
        out.push(lines.get(i))
        i = i + 1
    }
    return str_join(out, "\n")
}

# line_has_libc_sym(line) — the battery's
#   \b(fopen|malloc|free|printf|fprintf|exit|getenv|strtod|memcpy|strlen)\b
# as a boundary-checked scan: the symbol must not sit inside a longer
# identifier (`hl_exit_group` is not `exit`, `freestanding` is not `free`).
fn word_char(b: int) -> bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90)
        || (b >= 48 && b <= 57) || b == 95
}

fn line_names_sym(line: str, name: str) -> bool {
    let mut at: int = line.find(name)
    while at >= 0 {
        let before_ok: bool = at == 0 || !word_char(line.byte_at(at - 1))
        let after: int = at + name.len()
        let after_ok: bool = after >= line.len()
            || !word_char(line.byte_at(after))
        if before_ok && after_ok {
            return true
        }
        let next: int = line.slice(at + 1, line.len()).find(name)
        if next < 0 {
            return false
        }
        at = at + 1 + next
    }
    return false
}

fn line_has_libc_sym(line: str) -> bool {
    let syms: list[str] = libc_syms()
    let mut i: int = 0
    while i < syms.len() {
        if line_names_sym(line, syms.get(i)) {
            return true
        }
        i = i + 1
    }
    return false
}

# ----------------------------------------------------------------------------
# 1. the flag
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> str uses IO, Fs, Proc {
    section("1. the flag")
    let nl_c_path: str = scratch(acc, "hello_nl.c")
    let r: RunResult = emit(["--no-libc"], demo(), nl_c_path)
    let mut nl_c: str = ""
    if r.code != 0 {
        fail_msg(acc, "flag: --no-libc emission failed: "
            + trunc(r.combined, 200))
    } else {
        nl_c = read_file(nl_c_path)
        let needles: list[str] = ["HL_NO_LIBC 1", "void _start(void)",
            "int main(int argc, char** argv, char** envp)",
            "hl_environ = envp;"]
        let whats: list[str] = ["the HL_NO_LIBC marker",
            "the crt0 _start entry",
            "the 3-argument main (envp captured)",
            "the environ capture"]
        let mut missing: str = ""
        let mut i: int = 0
        while i < needles.len() {
            if !nl_c.contains(needles.get(i)) {
                if missing != "" {
                    missing = missing + ", "
                }
                missing = missing + whats.get(i)
            }
            i = i + 1
        }
        if missing == "" {
            pass_msg(acc, "flag: the no-libc TU carries _start, 3-arg main, environ capture")
        } else {
            fail_msg(acc, "flag: missing " + missing)
        }
    }

    let hosted_c_path: str = scratch(acc, "hello_hosted.c")
    let r2: RunResult = emit([], demo(), hosted_c_path)
    let hosted_c: str = read_or(hosted_c_path, "")
    if r2.code != 0 {
        fail_msg(acc, "flag: plain emission failed")
    } else if !hosted_c.contains("int main(int argc, char** argv)")
        || hosted_c.contains("void _start(void)") {
        fail_msg(acc, "flag: the hosted emission changed shape (2-arg main, no _start expected)")
    } else if !hosted_c.contains("#include <stdio.h>") {
        fail_msg(acc, "flag: the hosted emission lost its libc includes")
    } else {
        pass_msg(acc, "flag: the plain hosted emission is untouched")
    }

    let conflict_src: str = "#![freestanding]\n" +
        "\n" +
        "fn main() -> int {\n" +
        "    return 0\n" +
        "}\n"
    let cp: str = write_src(acc, "conflict.hls", conflict_src)
    let rc: RunResult = emit(["--no-libc"], cp, scratch(acc, "conflict.c"))
    if rc.code == 0 {
        fail_msg(acc, "conflict: --no-libc accepted on a #![freestanding] crate")
    } else if !rc.combined.contains("--no-libc cannot be combined") {
        fail_msg(acc, "conflict: wrong diagnostic: " + trunc(rc.combined, 160))
    } else {
        pass_msg(acc, "conflict: --no-libc + #![freestanding] rejected with its own words")
    }
    return nl_c
}

# ----------------------------------------------------------------------------
# 2. the no-libc runtime shape
# ----------------------------------------------------------------------------
fn sec2(acc: Acc, nl_c: str) -> void uses IO {
    section("2. the no-libc runtime shape")
    let needs: list[list[str]] = shape_needles()
    let mut missing: str = ""
    let mut i: int = 0
    while i < needs.len() {
        if !nl_c.contains(needs.get(i).get(0)) {
            if missing != "" {
                missing = missing + ", "
            }
            missing = missing + needs.get(i).get(1)
        }
        i = i + 1
    }
    if missing != "" {
        fail_msg(acc, "runtime shape: missing " + missing)
    } else if nl_c.contains("#include <stdio.h>")
        || nl_c.contains("#include <stdlib.h>") {
        fail_msg(acc, "runtime shape: a libc header slipped in")
    } else if !nl_c.contains("typedef struct { int fd; } FILE;") {
        fail_msg(acc, "runtime shape: the fd-backed FILE typedef is missing")
    } else {
        pass_msg(acc, "runtime shape: syscall layer + arena + fd streams, zero libc headers")
    }
}

# ----------------------------------------------------------------------------
# 3. the ladder — `make bootstrap-nolibc` IS the test subject.
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Proc {
    section("3. the ladder")
    let mk: RunResult = run_capture("make", ["bootstrap-nolibc"])
    let log: str = mk.combined
    if mk.code != 0 {
        fail_msg(acc, "ladder: make bootstrap-nolibc failed:\n"
            + last_lines(log, 6))
    } else if !log.contains("CROSS-BOOTSTRAP OK") {
        fail_msg(acc, "ladder: the ladder ran but did not print CROSS-BOOTSTRAP OK")
    } else {
        pass_msg(acc, "ladder: Stage-0 -> hosted hlc -> freestanding hlc, byte-identical at every step")
    }
}

# ----------------------------------------------------------------------------
# 4. the binary honesty
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Proc {
    section("4. the binary honesty")
    let exe: str = fs_exe()
    if !file_exists(exe) {
        fail_msg(acc, "honesty: bin/hlc-fs was not built by the ladder")
        return
    }
    let ldd: RunResult = run_capture("ldd", [exe])
    if ldd.err.contains("not a dynamic executable")
        || ldd.out.contains("statically linked")
        || ldd.out.contains("not a dynamic") {
        pass_msg(acc, "honesty: not a dynamic executable")
    } else {
        fail_msg(acc, "honesty: ldd says: " + trunc(ldd.out, 80)
            + " " + trunc(ldd.err, 80))
    }
    let nm: RunResult = run_capture("nm", ["-u", exe])
    if nm.code != 0 {
        fail_msg(acc, "honesty: nm failed")
        return
    }
    let lines: list[str] = nm.out.split("\n")
    let mut bad_syms: list[str] = []
    let mut i: int = 0
    while i < lines.len() {
        if line_has_libc_sym(lines.get(i)) {
            bad_syms.push(lines.get(i))
        }
        i = i + 1
    }
    if bad_syms.len() > 0 {
        let mut head: list[str] = []
        let mut k: int = 0
        while k < bad_syms.len() && k < 4 {
            head.push(bad_syms.get(k))
            k = k + 1
        }
        fail_msg(acc, "honesty: undefined libc symbols present: ["
            + str_join(head, ", ") + "]")
    } else {
        pass_msg(acc, "honesty: no undefined libc symbols")
    }
}

# ----------------------------------------------------------------------------
# 5. the parity
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("5. the parity")
    let exe: str = fs_exe()
    let files: list[str] = parity_files()
    let mut all_same: bool = true
    let mut i: int = 0
    while i < files.len() {
        let f: str = files.get(i)
        let a: str = scratch(acc, "fs_out.c")
        let b: str = scratch(acc, "hosted_out.c")
        let r1: RunResult = run_capture(exe, [f, a])
        let r2: RunResult = run_capture("./bin/hlc", [f, b])
        if r1.code != 0 || r2.code != 0 {
            fail_msg(acc, "parity: " + f + " compile failed (fs rc="
                + r1.code.to_str() + " hosted rc=" + r2.code.to_str() + ")")
            all_same = false
        } else if read_or(a, "") != read_or(b, "") {
            fail_msg(acc, "parity: " + f
                + " emits different C from the freestanding compiler")
            all_same = false
        }
        i = i + 1
    }
    if all_same {
        pass_msg(acc, "parity: hosted and no_std programs compile byte-identically")
    }

    let a: RunResult = run_capture(exe, ["--audit", "examples/irqsafe_demo.hls"])
    let b: RunResult = run_capture("./bin/hlc", ["--audit", "examples/irqsafe_demo.hls"])
    if a.code != 0 || b.code != 0 {
        fail_msg(acc, "parity: --audit failed (fs rc=" + a.code.to_str()
            + " hosted rc=" + b.code.to_str() + ")")
    } else if a.out != b.out {
        fail_msg(acc, "parity: --audit outputs differ")
    } else if !a.out.contains("IRQ vector 32: 'pit_isr' — allocation-free") {
        fail_msg(acc, "parity: the audit proof lines are missing")
    } else {
        pass_msg(acc, "parity: --audit agrees word for word, proof lines included")
    }
}

# ----------------------------------------------------------------------------
# 6. the no-libc world
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    section("6. the no-libc world")
    let out_path: str = scratch(acc, "world_out.txt")
    let world: str = "fn main() -> int uses IO, Proc {\n" +
        "    let cwd: str = cwd_get()\n" +
        "    if cwd == \"\" {\n" +
        "        return 1\n" +
        "    }\n" +
        "    if file_exists(\"examples/hello.hls\") != true {\n" +
        "        return 2\n" +
        "    }\n" +
        "    let src: str = read_file(\"examples/hello.hls\")\n" +
        "    if len(src) < 10 {\n" +
        "        return 3\n" +
        "    }\n" +
        "    write_file(\"" + out_path + "\", \"written by a no-libc binary\")\n" +
        "    let back: str = read_file(\"" + out_path + "\")\n" +
        "    if back != \"written by a no-libc binary\" {\n" +
        "        return 4\n" +
        "    }\n" +
        "    let n: int = \"42\".to_int()\n" +
        "    if n != 42 {\n" +
        "        return 5\n" +
        "    }\n" +
        "    let t: str = str(1234)\n" +
        "    if t != \"1234\" {\n" +
        "        return 6\n" +
        "    }\n" +
        "    let f: float = 2.5 + 2.5\n" +
        "    if f != 5.0 {\n" +
        "        return 7\n" +
        "    }\n" +
        "    return 0\n" +
        "}\n"
    let wpath: str = write_src(acc, "world.hls", world)
    let interp: RunResult = run_capture("python3",
        ["tools/hlinterp/boot.py", wpath])
    let w_c: str = scratch(acc, "world.c")
    let w_exe: str = scratch(acc, "world")
    let r: RunResult = emit(["--no-libc"], wpath, w_c)
    if r.code != 0 {
        fail_msg(acc, "world: --no-libc emission failed: " + trunc(r.combined, 200))
        return
    }
    let g: RunResult = link_nl(w_exe, w_c)
    if g.code != 0 {
        fail_msg(acc, "world: link failed: " + trunc(g.err, 300))
        return
    }
    let rr: RunResult = run_capture(w_exe, [])
    if rr.code != 0 {
        fail_msg(acc, "world: the no-libc program exited " + rr.code.to_str())
    } else if rr.code != interp.code {
        fail_msg(acc, "world: interpreter exit " + interp.code.to_str()
            + " vs native " + rr.code.to_str())
    } else {
        pass_msg(acc, "world: file IO + env + cwd + float/int conversions, exit 0, no libc")
    }
}

# ----------------------------------------------------------------------------
# 7. the pinned gaps
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Fs, Proc {
    section("7. the pinned gaps")
    let threads: str = "fn worker(n: int) -> int {\n" +
        "    return n + 1\n" +
        "}\n" +
        "\n" +
        "fn main() -> int uses Conc {\n" +
        "    let t: Task[int] = spawn(worker, 41)\n" +
        "    return t.join()\n" +
        "}\n"
    let tpath: str = write_src(acc, "threads.hls", threads)
    let t_c: str = scratch(acc, "threads.c")
    let t_exe: str = scratch(acc, "threads")
    let r: RunResult = emit(["--no-libc"], tpath, t_c)
    if r.code != 0 {
        fail_msg(acc, "gaps: the spawn TU did not compile: " + trunc(r.combined, 160))
        return
    }
    let g: RunResult = link_nl(t_exe, t_c)
    if g.code == 0 {
        fail_msg(acc, "gaps: a spawn() program LINKED without libc — the gap is hidden")
    } else if !g.err.contains("pthread_create") {
        fail_msg(acc, "gaps: the link failed but not on pthread_create: "
            + trunc(g.err, 200))
    } else {
        pass_msg(acc, "gaps: a spawn() program fails the LINK on pthread_create (named, not hidden)")
    }

    let dirs: str = "fn main() -> int uses IO {\n" +
        "    let entries: list[str] = fs_read_dir(\"examples\")\n" +
        "    return 0\n" +
        "}\n"
    let dpath: str = write_src(acc, "dirs.hls", dirs)
    let d_c: str = scratch(acc, "dirs.c")
    let d_exe: str = scratch(acc, "dirs")
    let rd: RunResult = emit(["--no-libc"], dpath, d_c)
    if rd.code != 0 {
        fail_msg(acc, "gaps: the fs_read_dir TU did not compile: " + trunc(rd.combined, 160))
        return
    }
    let gd: RunResult = link_nl(d_exe, d_c)
    if gd.code == 0 {
        fail_msg(acc, "gaps: an fs_read_dir program LINKED without libc")
    } else if !gd.err.contains("opendir") {
        fail_msg(acc, "gaps: the link failed but not on opendir: " + trunc(gd.err, 200))
    } else {
        pass_msg(acc, "gaps: an fs_read_dir program fails the LINK on opendir (named, not hidden)")
    }
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("xbootstrap")
    let nl_c: str = sec1(acc)
    sec2(acc, nl_c)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    return finish(acc, "Stage 92 -- cross-bootstrappable build (Stage-0 -> freestanding hlc)")
}
