# ============================================================================
# tests/acc/alloc_acceptance.hls — Stage 79 acceptance gate, in Halis
# (the Halis twin of what was tests/alloc_acceptance.py; same sections,
# same assertions, same needles — the harness is tests/acc/harness.hls
# and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make alloc-acceptance` (which compiles this file to
# bin/acc-alloc and runs it from the repo root).
#
# The old battery reached into the lab interpreter's Python internals
# (_resolve_import, tokenize/Parser) for its first two sections; the
# gate asks the same questions through the front door — probe programs
# the CLI must accept or reject, and source-shape greps.
#
#  1. core.alloc import resolution (+ traversal guards)
#  2. core.alloc parses standalone + core-only imports
#  3. Stage-0 enforcement (demo + ok-test pass in both modes)
#  4. Behavior probes (interpreter, no_std mode): layout validation,
#     BumpAlloc offsets/peak/reset/OOM/alignment padding, PoolAlloc
#     LIFO recycle + double-free detection, NullAlloc sentinel,
#     AllocStats accounting + peak watermark
#  5. Self-hosted emission (hlc) + native parity
#  6. hlfmt stability over every Stage 79 file
#  7. --audit: every alloc function pure (no uses)
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.regex"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

struct Probe {
    label: str,
    body: str
}

fn demo() -> str {
    return "examples/alloc_demo.hls"
}

fn ok_test() -> str {
    return "tests/ok/feat_stage79_alloc.hls"
}

fn core_alloc() -> str {
    return "core/alloc.hls"
}

fn core_modules() -> list[str] {
    return ["option", "result", "iter", "clone", "eq", "alloc"]
}

fn must_structs() -> list[str] {
    return ["Layout", "BumpAlloc", "PoolAlloc", "NullAlloc", "AllocStats"]
}

fn must_fns() -> list[str] {
    return ["layout_new", "layout_pad_to", "layout_align_up",
            "bump_new", "bump_alloc", "bump_dealloc", "bump_reset",
            "pool_new", "pool_alloc", "pool_dealloc",
            "null_alloc_new", "null_alloc_alloc",
            "stats_new", "stats_record_alloc", "stats_record_dealloc",
            "alloc_error_msg"]
}

fn must_be_pure() -> list[str] {
    return [
        "alloc_error_msg", "layout_is_power_of_two", "layout_new",
        "layout_for_words", "layout_align_up", "layout_size", "layout_align",
        "layout_pad_to", "layout_resize",
        "bump_new", "bump_alloc", "bump_dealloc", "bump_reset", "bump_used",
        "bump_peak", "bump_allocations", "bump_capacity", "bump_full",
        "pool_new", "pool_alloc", "pool_dealloc", "pool_free_count",
        "pool_used_count", "pool_total", "pool_block_size", "pool_peak",
        "pool_allocations", "pool_full",
        "null_alloc_new", "null_alloc_alloc", "null_alloc_dealloc",
        "stats_new", "stats_record_alloc", "stats_record_dealloc",
        "stats_bytes_alloc", "stats_bytes_dealloc", "stats_current",
        "stats_peak", "stats_allocations", "stats_deallocations",
    ]
}

fn probes() -> list[Probe] {
    return [
        Probe {
            label: "layout validation",
            body: "import \"core.alloc\"\n" +
                  "import \"core.result\"\n" +
                  "fn main() -> int {\n" +
                  "    if !result_is_err(layout_new(0, 8)) { return 1 }\n" +
                  "    if !result_is_err(layout_new(16, 7)) { return 2 }\n" +
                  "    if !result_is_err(layout_new(16, 8192)) { return 3 }\n" +
                  "    let l: Layout = result_unwrap(layout_new(24, 8))\n" +
                  "    if layout_size(l) != 24 { return 4 }\n" +
                  "    if layout_align(l) != 8 { return 5 }\n" +
                  "    if layout_pad_to(l) != 24 { return 6 }\n" +
                  "    let l4: Layout = result_unwrap(layout_new(4, 4))\n" +
                  "    if layout_pad_to(l4) != 4 { return 7 }\n" +
                  "    let l5: Layout = result_unwrap(layout_new(5, 4))\n" +
                  "    if layout_pad_to(l5) != 8 { return 8 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            label: "bump alloc + reset + OOM",
            body: "import \"core.alloc\"\n" +
                  "import \"core.result\"\n" +
                  "fn main() -> int {\n" +
                  "    let a: BumpAlloc = bump_new(32)\n" +
                  "    let l8: Layout = result_unwrap(layout_new(8, 8))\n" +
                  "    let p1: int = result_unwrap(bump_alloc(a, l8))\n" +
                  "    if p1 != 0 { return 1 }\n" +
                  "    let p2: int = result_unwrap(bump_alloc(a, l8))\n" +
                  "    if p2 != 8 { return 2 }\n" +
                  "    let p3: int = result_unwrap(bump_alloc(a, l8))\n" +
                  "    if p3 != 16 { return 3 }\n" +
                  "    if bump_used(a) != 24 { return 4 }\n" +
                  "    if bump_peak(a) != 24 { return 5 }\n" +
                  "    if bump_allocations(a) != 3 { return 6 }\n" +
                  "    bump_reset(a)\n" +
                  "    if bump_used(a) != 0 { return 7 }\n" +
                  "    if bump_peak(a) != 24 { return 8 }\n" +
                  "    if bump_allocations(a) != 3 { return 9 }\n" +
                  "    let small: BumpAlloc = bump_new(8)\n" +
                  "    let _p: int = result_unwrap(bump_alloc(small, l8))\n" +
                  "    if !result_is_err(bump_alloc(small, l8)) { return 10 }\n" +
                  "    if !bump_full(small) { return 11 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            label: "bump alignment padding",
            body: "import \"core.alloc\"\n" +
                  "import \"core.result\"\n" +
                  "fn main() -> int {\n" +
                  "    let a: BumpAlloc = bump_new(64)\n" +
                  "    let l4: Layout = result_unwrap(layout_new(4, 4))\n" +
                  "    let l8: Layout = result_unwrap(layout_new(8, 8))\n" +
                  "    let p1: int = result_unwrap(bump_alloc(a, l4))\n" +
                  "    if p1 != 0 { return 1 }\n" +
                  "    let p2: int = result_unwrap(bump_alloc(a, l8))\n" +
                  "    if p2 != 8 { return 2 }\n" +
                  "    let p3: int = result_unwrap(bump_alloc(a, l4))\n" +
                  "    if p3 != 16 { return 3 }\n" +
                  "    let p4: int = result_unwrap(bump_alloc(a, l8))\n" +
                  "    if p4 != 24 { return 4 }\n" +
                  "    if bump_used(a) != 32 { return 5 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            label: "pool LIFO recycle",
            body: "import \"core.alloc\"\n" +
                  "import \"core.result\"\n" +
                  "fn main() -> int {\n" +
                  "    let pool: PoolAlloc = pool_new(16, 3)\n" +
                  "    let l: Layout = result_unwrap(layout_new(16, 16))\n" +
                  "    let b1: int = result_unwrap(pool_alloc(pool, l))\n" +
                  "    if b1 != 0 { return 1 }\n" +
                  "    let b2: int = result_unwrap(pool_alloc(pool, l))\n" +
                  "    if b2 != 16 { return 2 }\n" +
                  "    let b3: int = result_unwrap(pool_alloc(pool, l))\n" +
                  "    if b3 != 32 { return 3 }\n" +
                  "    if !pool_full(pool) { return 4 }\n" +
                  "    if result_is_err(pool_dealloc(pool, b2, l)) { return 5 }\n" +
                  "    let b4: int = result_unwrap(pool_alloc(pool, l))\n" +
                  "    if b4 != 16 { return 6 }\n" +
                  "    if !result_is_err(pool_alloc(pool, l)) { return 7 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            label: "pool double-free + range",
            body: "import \"core.alloc\"\n" +
                  "import \"core.result\"\n" +
                  "fn main() -> int {\n" +
                  "    let pool: PoolAlloc = pool_new(16, 2)\n" +
                  "    let l: Layout = result_unwrap(layout_new(16, 16))\n" +
                  "    let b1: int = result_unwrap(pool_alloc(pool, l))\n" +
                  "    if result_is_err(pool_dealloc(pool, b1, l)) { return 1 }\n" +
                  "    let dbl: Result[int, AllocError] = pool_dealloc(pool, b1, l)\n" +
                  "    if !result_is_err(dbl) { return 2 }\n" +
                  "    if alloc_error_msg(result_unwrap_err(dbl)) != \"double free\" { return 3 }\n" +
                  "    if !result_is_err(pool_dealloc(pool, 1000, l)) { return 4 }\n" +
                  "    if !result_is_err(pool_dealloc(pool, -1, l)) { return 5 }\n" +
                  "    if !result_is_err(pool_dealloc(pool, 7, l)) { return 6 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            label: "null alloc sentinel",
            body: "import \"core.alloc\"\n" +
                  "import \"core.result\"\n" +
                  "fn main() -> int {\n" +
                  "    let na: NullAlloc = null_alloc_new()\n" +
                  "    let l: Layout = result_unwrap(layout_new(8, 8))\n" +
                  "    if !result_is_err(null_alloc_alloc(na, l)) { return 1 }\n" +
                  "    if !result_is_err(null_alloc_dealloc(na, 0, l)) { return 2 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            label: "stats accounting + peak",
            body: "import \"core.alloc\"\n" +
                  "import \"core.result\"\n" +
                  "fn main() -> int {\n" +
                  "    let s: AllocStats = stats_new()\n" +
                  "    if stats_current(s) != 0 { return 1 }\n" +
                  "    stats_record_alloc(s, 100)\n" +
                  "    if stats_current(s) != 100 { return 2 }\n" +
                  "    if stats_peak(s) != 100 { return 3 }\n" +
                  "    stats_record_alloc(s, 50)\n" +
                  "    if stats_current(s) != 150 { return 4 }\n" +
                  "    if stats_peak(s) != 150 { return 5 }\n" +
                  "    stats_record_dealloc(s, 100)\n" +
                  "    if stats_current(s) != 50 { return 6 }\n" +
                  "    if stats_peak(s) != 150 { return 7 }\n" +
                  "    if stats_allocations(s) != 2 { return 8 }\n" +
                  "    if stats_deallocations(s) != 1 { return 9 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
    ]
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

fn decl_word(src: str, kw: str, name: str) -> bool {
    let rr: Result[Regex, str] = regex_compile(kw + "\\s+" + name + "\\b")
    if result_is_err(rr) {
        return false
    }
    let re: Regex = result_unwrap(rr)
    return regex_is_match(re, src)
}

fn import_paths(src: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i).trim()
        if line.starts_with("import ") {
            let rest: str = line.slice(7, line.len()).trim()
            if rest.starts_with("\"") {
                let tail: str = rest.slice(1, rest.len())
                let end: int = tail.find("\"")
                if end > 0 {
                    out.push(tail.slice(0, end))
                }
            }
        }
        i = i + 1
    }
    return out
}

# swap_no_std(text) — "\n#![no_std]\n" -> "\n#![freestanding]\n", the
# first occurrence only (the comment headers also contain the tokens).
fn swap_no_std(text: str) -> str {
    let at: int = text.find("\n#![no_std]\n")
    if at < 0 {
        return text
    }
    return text.slice(0, at) + "\n#![freestanding]\n"
        + text.slice(at + 12, text.len())
}

# drop_no_std(text) — remove the first "#![no_std]\n".
fn drop_no_std(text: str) -> str {
    let at: int = text.find("#![no_std]\n")
    if at < 0 {
        return text
    }
    return text.slice(0, at) + text.slice(at + 11, text.len())
}

# ----------------------------------------------------------------------------
# 1. core.alloc resolution + traversal guards
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    section("1. core.alloc import resolution (+ traversal guards)")
    let p: str = write_src(acc, "res_alloc.hls",
        "import \"core.alloc\"\n" +
        "\n" +
        "fn main() -> int {\n" +
        "    return 0\n" +
        "}\n")
    let r: RunResult = boot_check(acc, p)
    check(acc, "core.alloc resolves", r.code == 0, clip(r.combined, 60))
    # The existing core.* modules still resolve (regression check)
    let mods: list[str] = core_modules()
    let mut i: int = 0
    while i < mods.len() {
        let m: str = mods.get(i)
        let q: str = write_src(acc, "res_" + m + ".hls",
            "import \"core." + m + "\"\n" +
            "\n" +
            "fn main() -> int {\n" +
            "    return 0\n" +
            "}\n")
        let rq: RunResult = boot_check(acc, q)
        check(acc, "core." + m + " still resolves", rq.code == 0, "")
        i = i + 1
    }
    # std.str (hosted) still resolves alongside core.alloc
    let s: str = write_src(acc, "res_std_str.hls",
        "import \"std.str\"\n" +
        "\n" +
        "fn main() -> int {\n" +
        "    return 0\n" +
        "}\n")
    let rs: RunResult = boot_check(acc, s)
    check(acc, "std.str still resolves", rs.code == 0, "")
    # Path traversal guards: the same three evil paths continue to be
    # rejected.
    let evils: list[str] = ["core.../secret", "core./x", "core"]
    let mut j: int = 0
    while j < evils.len() {
        let e: str = evils.get(j)
        let q: str = write_src(acc, "guard_" + j.to_str() + ".hls",
            "import \"" + e + "\"\n" +
            "\n" +
            "fn main() -> int {\n" +
            "    return 0\n" +
            "}\n")
        let rq: RunResult = boot_check(acc, q)
        check(acc, "guard '" + e + "'", rq.code != 0, clip(rq.combined, 70))
        j = j + 1
    }
}

# ----------------------------------------------------------------------------
# 2. core.alloc parses standalone + imports are core-only
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO {
    section("2. core.alloc parses standalone + core-only imports")
    let src: str = read_or(core_alloc(), "")
    check(acc, "core/alloc.hls parses", src.len() > 0
        && top_kinds_pos(src), "shape ok")
    let structs: list[str] = must_structs()
    let mut all_structs: bool = true
    let mut i: int = 0
    while i < structs.len() {
        if !decl_word(src, "struct", structs.get(i)) {
            all_structs = false
        }
        i = i + 1
    }
    check(acc, "all five structs present", all_structs, "")
    check(acc, "AllocError enum present", decl_word(src, "enum", "AllocError"), "")
    # Imports: must be exactly core.option + core.result.
    let imps: list[str] = import_paths(src)
    check(acc, "imports are core-only",
        imps.len() == 2 && ((imps.get(0) == "core.option" && imps.get(1) == "core.result")
            || (imps.get(0) == "core.result" && imps.get(1) == "core.option")),
        str_join(imps, ", "))
    let fns: list[str] = must_fns()
    let mut missing: str = ""
    let mut j: int = 0
    while j < fns.len() {
        if !decl_word(src, "fn", fns.get(j)) {
            missing = missing + " " + fns.get(j)
        }
        j = j + 1
    }
    check(acc, "all reference functions present", missing == "", clip(missing, 90))
}

# top_kinds_pos(src) — the file declares at least one struct, one enum
# and one fn at column 0 (the old battery's parse shape).
fn top_kinds_pos(src: str) -> bool {
    let lines: list[str] = src.split("\n")
    let mut has_s: bool = false
    let mut has_e: bool = false
    let mut has_f: bool = false
    let mut i: int = 0
    while i < lines.len() {
        let l: str = lines.get(i)
        if l.starts_with("struct ") {
            has_s = true
        }
        if l.starts_with("enum ") {
            has_e = true
        }
        if l.starts_with("fn ") {
            has_f = true
        }
        i = i + 1
    }
    return has_s && has_e && has_f
}

# ----------------------------------------------------------------------------
# 3. Stage-0 enforcement (no_std + freestanding)
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. Stage-0 enforcement (demo + ok-test pass in both modes)")
    let rd: RunResult = boot_check(acc, demo())
    check(acc, "no_std demo checks", rd.code == 0, clip(rd.combined, 60))
    let rt: RunResult = boot_check(acc, ok_test())
    check(acc, "no_std ok-test checks", rt.code == 0, clip(rt.combined, 60))
    let rd2: RunResult = boot(acc, [demo()])
    check(acc, "no_std demo runs (exit 0)", rd2.code == 0, "rc=" + rd2.code.to_str())
    let rt2: RunResult = boot(acc, [ok_test()])
    check(acc, "no_std ok-test runs (exit 0)", rt2.code == 0, "rc=" + rt2.code.to_str())
    # The same ok-test with #![freestanding] instead of #![no_std].
    let fs_src: str = swap_no_std(read_file(ok_test()))
    let fs_p: str = write_src(acc, "ok_fs.hls", fs_src)
    let rf: RunResult = boot_check(acc, fs_p)
    check(acc, "freestanding ok-test checks", rf.code == 0, clip(rf.combined, 60))
    let rf2: RunResult = boot(acc, [fs_p])
    check(acc, "freestanding ok-test runs (exit 0)", rf2.code == 0,
        "rc=" + rf2.code.to_str())
    # The same ok-test with NO crate attr — the std.* boundary is
    # closed but core.* is fine.
    let bare_src: str = drop_no_std(read_file(ok_test()))
    let bare_p: str = write_src(acc, "ok_bare.hls", bare_src)
    let rb: RunResult = boot(acc, [bare_p])
    check(acc, "hosted (no crate attr) ok-test runs (exit 0)", rb.code == 0,
        "rc=" + rb.code.to_str())
    # --audit reports the crate mode
    let ra: RunResult = boot(acc, ["--audit", demo()])
    check(acc, "--audit shows no_std", ra.code == 0 && ra.out.contains("#![no_std]"), "")
    # extern + uses are still rejected in no_std mode
    let p: str = write_src(acc, "extern_probe.hls",
        "#![no_std]\nimport \"core.alloc\"\n" +
        "extern \"C\" {\n    fn malloc(n: int) -> int uses IO\n}\n" +
        "fn main() -> int { return 0 }\n")
    let r: RunResult = boot_check(acc, p)
    check(acc, "no_std extern rejected",
        r.code == 1 && r.combined.contains("not available in #![no_std]"),
        clip(r.combined, 90))
}

# ----------------------------------------------------------------------------
# 4. Targeted behavior probes (interpreter, no_std mode)
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("4. Behavior probes (interpreter, no_std mode)")
    let ps: list[Probe] = probes()
    let mut i: int = 0
    while i < ps.len() {
        let p: Probe = ps.get(i)
        let path: str = write_src(acc, "probe_" + i.to_str() + ".hls",
            "#![no_std]\n" + p.body)
        let r: RunResult = boot(acc, [path])
        check(acc, p.label, r.code == 0, "rc=" + r.code.to_str()
            + " " + clip(r.combined, 80))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 5. Self-hosted emission + parity
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("5. Self-hosted emission (hlc) + native parity")
    let out: str = scratch(acc, "alloc.c")
    let r: RunResult = boot(acc, ["src/hlc.hls", demo(), out])
    check(acc, "hlc emits no_std C", r.code == 0 && file_exists(out),
        clip(r.combined, 100))
    let src: str = read_or(out, "")
    let mre: Result[Regex, str] = regex_compile("int main\\s*\\(")
    let mut has_main: bool = false
    if result_is_ok(mre) {
        if regex_is_match(result_unwrap(mre), src) {
            has_main = true
        }
    }
    check(acc, "hosted main kept", has_main, "")
    check(acc, "no _start entry", !src.contains("void _start"), "")
    check(acc, "stdio kept", src.contains("#include <stdio.h>"), "")
    check(acc, "no freestanding markers",
        !src.contains("HL_FREESTANDING") && !src.contains("__builtin_trap"), "")
    check(acc, "core.alloc fns compiled",
        src.contains("usf_layout_new") && src.contains("usf_bump_alloc")
            && src.contains("usf_bump_reset") && src.contains("usf_pool_alloc")
            && src.contains("usf_pool_dealloc") && src.contains("usf_null_alloc_alloc")
            && src.contains("usf_stats_record_alloc") && src.contains("usf_alloc_error_msg"),
        "")
    # Compile the emitted C and run it; the exit code must match the
    # interpreter's (0).
    let binp: str = scratch(acc, "alloc.bin")
    let g: RunResult = run_capture("gcc", ["-O2", "-o", binp, out, "-lm", "-pthread"])
    if g.code == 0 {
        let nat: RunResult = run_capture(binp, [])
        check(acc, "native alloc_demo exit 0", nat.code == 0,
            "rc=" + nat.code.to_str())
    } else {
        check(acc, "native alloc_demo links", false, "gcc failed")
    }
    # Freestanding parity: the same ok-test with #![freestanding].
    let fs_src: str = swap_no_std(read_file(ok_test()))
    let fs_p: str = write_src(acc, "ok_fs2.hls", fs_src)
    let interp: RunResult = boot(acc, [fs_p])
    let out2: str = scratch(acc, "fs.c")
    let r2: RunResult = boot(acc, ["src/hlc.hls", fs_p, out2])
    check(acc, "hlc emits freestanding C", r2.code == 0 && file_exists(out2),
        clip(r2.combined, 100))
    let bin2: str = scratch(acc, "fs.bin")
    let g2: RunResult = run_capture("gcc", ["-O2", "-ffreestanding", "-nostdlib",
        "-ffunction-sections", "-fno-stack-protector", "-Wl,--gc-sections",
        "-o", bin2, out2])
    if g2.code == 0 {
        let nat2: RunResult = run_capture(bin2, [])
        check(acc, "freestanding native == interpreter",
            nat2.code == interp.code,
            "interp=" + interp.code.to_str() + " nat=" + nat2.code.to_str())
    } else {
        check(acc, "freestanding binary links", false, "gcc failed")
    }
}

# ----------------------------------------------------------------------------
# 6. hlfmt stability
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Proc {
    section("6. hlfmt stability over every Stage 79 file")
    let files: list[str] = [core_alloc(), demo(), ok_test()]
    let mut i: int = 0
    while i < files.len() {
        let r: RunResult = run_capture("python3", ["tools/hlfmt.py", "-c", files.get(i)])
        check(acc, "hlfmt clean: " + basename(files.get(i)),
            !r.out.contains("NOT formatted"), clip(r.out, 80))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 7. --audit shows every alloc function pure
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Proc {
    section("7. --audit: every alloc function pure (no uses)")
    let r: RunResult = boot(acc, ["--audit", demo()])
    let out: str = r.out
    check(acc, "audit ran", r.code == 0, "")
    let must: list[str] = must_be_pure()
    let mut missing: str = ""
    let mut i: int = 0
    while i < must.len() {
        if !out.contains(must.get(i)) {
            missing = missing + " " + must.get(i)
        }
        i = i + 1
    }
    check(acc, "all alloc fns in audit output", missing == "", clip(missing, 90))
    # Every audit line that names one of the fns must declare it pure.
    let lines: list[str] = out.split("\n")
    let mut bad: str = ""
    let mut li: int = 0
    while li < lines.len() {
        let s: str = lines.get(li).trim()
        let mut fi: int = 0
        while fi < must.len() {
            if s.starts_with(must.get(fi) + " ") {
                if !s.contains("(none - pure)") && !s.contains("(none)") {
                    bad = bad + " " + s
                }
                break
            }
            fi = fi + 1
        }
        li = li + 1
    }
    check(acc, "all alloc fns declared pure", bad == "", clip(bad, 90))
    check(acc, "crate mode reported",
        out.contains("Crate mode:") && out.contains("#![no_std]"), "")
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("alloc")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    return finish(acc, "Stage 79 -- core.alloc (Layout + AllocError + BumpAlloc + PoolAlloc + NullAlloc + AllocStats)")
}
