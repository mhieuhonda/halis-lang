# ============================================================================
# tests/acc/rc4_acceptance.hls — Stage 149 acceptance gate, in Halis
# (the Halis twin of tests/rc4_acceptance.py; same six sections, same
# assertions, same needles — the harness is tests/acc/harness.hls and
# the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Six sections over the REAL CLIs (bin/hls-rc, bin/hls-lts) and REAL
# scratch git repositories (seeded under tests/.acc-scratch/rc4/, the
# gate's scratch world) — the last approval is treated like every
# other law in this project: re-derived, not narrated.
#
# The battery set GIT_* env vars for every child so the scratch
# commits carry a pinned committer day; the gate does the same with
# std.env before the first child spawns.
#
#  1. the destination — the RC4 fixes pinned as laws: the record and
#     law               the policy refuse an unwritable destination
#                       with its NAME (exit 2) — a directory sitting
#                       where the file would be, a parent that does
#                       not exist — and never panic (101) on a path
#                       the user typed; the writable path still
#                       renders;
#  2. the signature  — the signing act over a world walked to rc.4:
#     law               the name law (no --by, blank --by: usage
#                       errors), the anchor law (no anchor: nothing to
#                       sign), the tree law (a dirty tracked tree
#                       refuses the signature), the landing (the
#                       signature rides in the anchor, its name and
#                       its day), the once law (a second signature
#                       refused — one per candidate);
#  3. the witness    — `signoff --check` re-derives the verdict: an
#     law               unsigned candidate says so, the signed world
#                       is green (--json parses, the laws named), a
#                       FEATURE commit past the anchor voids the gate
#                       law, a hand-edited record voids the record
#                       law — and restoring the world greens the SAME
#                       signature again: re-earned, not archived;
#  4. the record     — the render speaks the signature only when the
#     law               candidate carries one: the unsigned render
#                       carries no sign-off line, the signed render
#                       gains exactly one (the name, the day), the
#                       render-before/after diff is that one line,
#                       and the record must be re-rendered before the
#                       release commit or the drift check refuses;
#  5. the real-tree  — the tree this gate runs on: readiness green,
#     pre-flight        the gate green, the record drift-free, the
#                       markers one voice, the anchor a candidate of
#                       the line speaking its stage's own phrase —
#                       and signoff --check pinned DYNAMICALLY: green
#                       on a signed anchor, the unsigned refusal on an
#                       unsigned one (both states are legal states of
#                       the line);
#  6. the corpus     — tests/ok/feat_stage149_rc4.hls is hlfmt-
#     showcase          canonical, hllint-clean, boots through the
#                       real checker, runs green on the interpreter
#                       and (when bin/hlc exists) matches natively
#                       byte for byte.
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.json"
import "std.result"
import "std.env"

# ----------------------------------------------------------------------------
# The gate's data (the battery's constants).
# ----------------------------------------------------------------------------

fn signer() -> str {
    return "the maintainer"
}

fn release_day() -> str {
    return "2026-10-29"
}

fn freeze_digest() -> str {
    return "84d1068f80d62f3f741785ce2241b423fa5bd36b4e28e0a872c6e772e4decaf6"
}

fn showcase() -> str {
    return "tests/ok/feat_stage149_rc4.hls"
}

fn showcase_out() -> str {
    return "stage 149: v1.0.0-rc.4\n"
        + "  RC4 laws OK: signature, green, order, witness, "
        + "refusal, anchor\n"
}

# the fancy roadmap's REAL tail titles — the rows whose
# parentheticals name each candidate's identity
fn road_title(n: int) -> str {
    if n == 146 { return "v1.0 Release Candidate 1 (feature freeze)" }
    if n == 147 { return "v1.0 Release Candidate 2 (bug-fix only)" }
    if n == 148 { return "v1.0 Release Candidate 3 (final dry-run)" }
    if n == 149 { return "v1.0 Release Candidate 4 (sign-off)" }
    if n == 150 { return "HLS v1.0 — LTS release" }
    return "stage " + n.to_str() + " title"
}

fn fancy_roadmap(closed_through: int) -> str {
    let rows: list[str] = []
    let mut n: int = 1
    while n <= 150 {
        let mut st: str = "⬜"
        if n <= closed_through {
            st = "✅"
        }
        rows.push("| " + n.to_str() + " | " + road_title(n) + " | " + st
            + " | (done in v0.1.0) |")
        n = n + 1
    }
    return "# ROADMAP\n\n"
        + "| # | Stage | Status | Effort |\n"
        + "|---|-------|--------|--------|\n"
        + str_join(rows, "\n") + "\n"
}

# the sign-off line the render speaks for a signed candidate
fn signoff_line(name: str, day: str) -> str {
    return ("- the sign-off: **" + name + "**, " + day
        + " — the candidate carries its signer's approval; "
        + "`bin/hls-rc signoff --check` re-derives it at every gate")
}

# ----------------------------------------------------------------------------
# Port helpers — the battery's world builders and needle tools.
# ----------------------------------------------------------------------------

fn header(title: str) -> void uses IO {
    println("")
    println("--- " + title + " ---")
}

# rc(args, repo) — the battery's rc(*argv, cwd): the RC kit with --root
# pinned to the world. The battery runs the child with cwd=repo — the
# kit spawns its own git children in ITS cwd (the tag census reads the
# working directory, not --root) — so the gate chdirs to the world for
# the spawn and restores the repo root after: the same semantics.
fn rc(args: list[str], repo: str) -> RunResult uses Proc {
    let home: str = cwd_get()
    let argv: list[str] = []
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    argv.push("--root")
    argv.push(repo)
    env_set_current_dir(repo)
    let r: RunResult = run_capture(path_join3(home, "bin/hls-rc"), argv)
    env_set_current_dir(home)
    return r
}

# lts(args, repo) — the battery's lts(*argv, cwd), the same chdir dance.
fn lts(args: list[str], repo: str) -> RunResult uses Proc {
    let home: str = cwd_get()
    let argv: list[str] = []
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    argv.push("--repo")
    argv.push(repo)
    env_set_current_dir(repo)
    let r: RunResult = run_capture(path_join3(home, "bin/hls-lts"), argv)
    env_set_current_dir(home)
    return r
}

fn git(repo: str, args: list[str]) -> RunResult uses Proc {
    let argv: list[str] = ["-C", repo]
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    return run_capture("git", argv)
}

# wf(repo, rel, content) — write inside a world, parents made.
fn wf(repo: str, rel: str, content: str) -> void uses Fs, Proc {
    let p: str = path_join3(repo, rel)
    mkdirs(path_dir3(p))
    write_file(p, content)
}

fn rf(repo: str, rel: str) -> str uses Fs {
    return read_file(path_join3(repo, rel))
}

fn has(repo: str, rel: str) -> bool uses Fs {
    return file_exists(path_join3(repo, rel))
}

fn commit_all(repo: str, msg: str) -> str uses Proc {
    git(repo, ["add", "-A"])
    git(repo, ["commit", "-q", "-m", msg])
    let r: RunResult = git(repo, ["rev-parse", "HEAD"])
    return r.out.trim()
}

# list_contains(xs, s) — Python's `s in list`.
fn list_contains(xs: list[str], s: str) -> bool {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) == s {
            return true
        }
        i = i + 1
    }
    return false
}

fn lists_equal(a: list[str], b: list[str]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let mut i: int = 0
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

# added_lines(after, before) — the battery's render diff:
# [l for l in after.split("\n") if l not in before.split("\n")]
fn added_lines(after: str, before: str) -> list[str] {
    let out: list[str] = []
    let bl: list[str] = before.split("\n")
    let al: list[str] = after.split("\n")
    let mut i: int = 0
    while i < al.len() {
        if !list_contains(bl, al.get(i)) {
            out.push(al.get(i))
        }
        i = i + 1
    }
    return out
}

# JSON accessors with the battery's .get(key, default) semantics —
# std.json's typed accessors panic on a kind mismatch, so guard first.
fn jget_str(v: JsonValue, key: str) -> str {
    let x: JsonValue = json_object_get(v, key)
    if json_is_str(x) {
        return json_str_value(x)
    }
    return ""
}

fn jget_int(v: JsonValue, key: str) -> int {
    let x: JsonValue = json_object_get(v, key)
    if json_is_int(x) {
        return json_int_value(x)
    }
    return 0
}

# data.get(key) is False / is True — the key present and that bool.
fn jget_bool_is(v: JsonValue, key: str, want: bool) -> bool {
    let x: JsonValue = json_object_get(v, key)
    return json_is_bool(x) && json_bool_value(x) == want
}

fn parse_json_or_null(text: str) -> JsonValue {
    let rr: Result[JsonValue, str] = json_parse_result(text)
    if result_is_ok(rr) {
        return result_unwrap(rr)
    }
    return json_null()
}

# the anchor file (read_or: a world whose walk failed has none — the
# accessors then see null, the way the battery's {} default reads)
fn anchor_of(repo: str) -> JsonValue uses Fs {
    return parse_json_or_null(read_or(path_join3(repo, ".hls-rc.json"), ""))
}

fn tag_line_of(text: str) -> str {
    let lines: list[str] = text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).starts_with("- the tag: ") {
            return lines.get(i)
        }
        i = i + 1
    }
    return ""
}

fn signoff_lines_of(text: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = text.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).starts_with("- the sign-off: ") {
            out.push(lines.get(i))
        }
        i = i + 1
    }
    return out
}

# The candidate line's legal states, read off the real tree:
# 'eve' — the anchor stands, no line declared; 'released' — the
# anchor retired with the release commit and the LTS line is
# declared. Anything else is a half-cut release, and a half-cut
# release is not a state. This gate certified the signature; after
# the release it must still run — the signature's tree outlives
# the signature's office.
fn release_state() -> str uses Fs {
    let anchor: bool = file_exists(".hls-rc.json")
    let line: bool = file_exists(".hls-lts.json")
    if anchor && !line {
        return "eve"
    }
    if line && !anchor {
        return "released"
    }
    return "half-cut"
}

# the head release of the tree's record — the first `## [v...]`
# line of RELEASES.md (the battery reads RELEASES.md directly)
fn real_head_version() -> str uses Fs {
    let src: str = read_or("RELEASES.md", "")
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if line.starts_with("## [v") {
            let end: int = line.find("]")
            let start: int = line.find("[v")
            if end > start {
                return line.slice(start + 2, end)
            }
        }
        i = i + 1
    }
    return ""
}

# ----------------------------------------------------------------------------
# The scratch worlds.
# ----------------------------------------------------------------------------

# seed_world(name, roadmap_text) — a minimal compliant world at
# Stage 145 closed, freeze anchored.
fn seed_world(acc: Acc, name: str, roadmap_text: str) -> str uses IO, Fs, Proc, Exit {
    let repo: str = scratch(acc, name)
    mkdirs(repo)
    let init: RunResult = git(repo, ["init", "-q", "-b", "main"])
    if init.code != 0 {
        # a world that is not its own repository would commit into the
        # gate's OUTER repo — refuse loudly instead
        println("rc4-acceptance: git init failed in " + repo + " — " + init.err)
        exit(2)
    }
    wf(repo, "ROADMAP.md", roadmap_text)
    wf(repo, "CHANGELOG.md",
        "## [v0.165.0-alpha] — the last alpha\n- the body\n")
    wf(repo, "snapshot/MANIFEST.json",
        "{\"closure\": {}, \"version\": \"v0.165.0-alpha\"}")
    wf(repo, "editors/vscode/halis/package.json",
        "{\"name\": \"halis\", \"version\": \"0.165.0-alpha\"}")
    wf(repo, "LTS.md", "the promise\n")
    wf(repo, "snapshot/hlc.c", "int main(void){return 0;}\n")
    git(repo, ["add", "-A"])
    git(repo, ["commit", "-q", "-m", "seed"])
    let frozen: str = git(repo, ["rev-parse", "HEAD"]).out.trim()
    let freeze: str = "{\"digest\": \"" + freeze_digest()
        + "\", \"frozen_commit\": \"" + frozen
        + "\", \"release\": \"0.159.0-alpha\", \"stage\": 141"
        + ", \"surface\": {\"syntax\": {\"keywords\": [\"fn\"]}}"
        + ", \"surface_version\": 1, \"tool\": \"hls-freeze\"}"
    wf(repo, "tests/api_freeze.json", freeze)
    git(repo, ["add", "-A"])
    git(repo, ["commit", "-q", "-m", "the freeze document"])
    return repo
}

fn move_markers(acc: Acc, repo: str, n: int, stage: int) -> void uses Fs, Proc {
    wf(repo, "ROADMAP.md", fancy_roadmap(stage))
    wf(repo, "CHANGELOG.md", "## [v1.0.0-rc." + n.to_str() + "] — Stage "
        + stage.to_str() + ": the candidate\n- the body\n")
    wf(repo, "snapshot/MANIFEST.json", "{\"closure\": {}, \"version\": \"v1.0.0-rc."
        + n.to_str() + "\"}")
    wf(repo, "editors/vscode/halis/package.json",
        "{\"name\": \"halis\", \"version\": \"1.0.0-rc." + n.to_str() + "\"}")
    if has(repo, ".hls-rc.json") {
        git(repo, ["rm", "-q", ".hls-rc.json"])
    }
    commit_all(repo, "docs: stage " + stage.to_str()
        + " markers, the candidate " + n.to_str() + " line")
}

# walk_candidate(repo, n) — cut candidate n the unsigned way: the row
# ticked, the markers moved, the old anchor leaving with the release
# commit, declare, the record rendered, the tag cut.
fn walk_candidate(acc: Acc, repo: str, n: int) -> str uses IO, Fs, Proc {
    let stage: int = 145 + n
    move_markers(acc, repo, n, stage)
    let r: RunResult = rc(["declare", "--tag", "v1.0.0-rc." + n.to_str()], repo)
    if r.code != 0 {
        fail_msg(acc, "candidate rc." + n.to_str() + " did not declare: "
            + clip(r.combined, 200))
        return ""
    }
    rc(["report", "--out", path_join3(repo, "RC.md")], repo)
    commit_all(repo, "release: v1.0.0-rc." + n.to_str()
        + " anchored, the record rendered")
    git(repo, ["tag", "v1.0.0-rc." + n.to_str()])
    return rf(repo, "RC.md")
}

# walk_signed_candidate(repo, n, signer) — cut candidate n the SIGNED
# way (Stage 149's own choreography): the markers moved, declare, the
# signature into the anchor, the record re-rendered so it speaks the
# signature, the release commit, the tag. Returns the anchor JSON.
fn walk_signed_candidate(acc: Acc, repo: str, n: int, by: str) -> JsonValue
    uses IO, Fs, Proc {
    let stage: int = 145 + n
    move_markers(acc, repo, n, stage)
    let r: RunResult = rc(["declare", "--tag", "v1.0.0-rc." + n.to_str()], repo)
    if r.code != 0 {
        fail_msg(acc, "candidate rc." + n.to_str() + " did not declare: "
            + clip(r.combined, 200))
        return json_null()
    }
    let s: RunResult = rc(["signoff", "--by", by], repo)
    if s.code != 0 {
        fail_msg(acc, "candidate rc." + n.to_str() + " did not sign off: "
            + clip(s.combined, 200))
        return json_null()
    }
    rc(["report", "--out", path_join3(repo, "RC.md")], repo)
    commit_all(repo, "release: v1.0.0-rc." + n.to_str()
        + " anchored, the record rendered")
    git(repo, ["tag", "v1.0.0-rc." + n.to_str()])
    return anchor_of(repo)
}

# render_to_text(repo) — the record as the kit would render it, into
# the probe dir, without touching the world's committed copy.
fn render_to_text(acc: Acc, repo: str) -> str uses IO, Fs, Proc {
    let out_dir: str = scratch(acc, "render-probe")
    rmrf(out_dir)
    mkdirs(out_dir)
    let r: RunResult = rc(["report", "--out", path_join3(out_dir, "RC.md")], repo)
    if r.code != 0 {
        fail_msg(acc, "the render probe failed: " + clip(r.combined, 160))
        return ""
    }
    return read_file(path_join3(out_dir, "RC.md"))
}

# ----------------------------------------------------------------------------
# 1. the destination law — the refusal names the path, exit 2, no panic
# ----------------------------------------------------------------------------

fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    header("1. the destination law — the refusal names the path, "
        + "exit 2, no panic")
    let repo: str = seed_world(acc, "the-destination", fancy_roadmap(149))
    let missing: str = path_join3(acc.scratch_base, "no-such-dir")

    let r: RunResult = rc(["report", "--out", path_join3(missing, "RC.md")], repo)
    check(acc, "the record refuses a missing directory (exit 2, named)",
        r.code == 2 && r.err.contains("cannot write file")
            && r.err.contains("(the directory does not exist)"), "")
    check(acc, "no panic on the path the user typed",
        !str_to_lower_ascii(r.combined).contains("panic"), "")
    let r2: RunResult = rc(["report", "--out", repo], repo)
    check(acc, "the record refuses a directory destination (exit 2, named)",
        r2.code == 2 && r2.err.contains("(a directory sits there)"), "")
    let r3: RunResult = lts(["policy", "--out", path_join3(missing, "LTS.md")], repo)
    check(acc, "the policy refuses a missing directory (exit 2, named)",
        r3.code == 2 && r3.err.contains("cannot write file")
            && r3.err.contains("(the directory does not exist)"), "")
    check(acc, "the policy refuses without a panic either",
        !str_to_lower_ascii(r3.combined).contains("panic"), "")
    let r4: RunResult = lts(["policy", "--out", repo], repo)
    check(acc, "the policy refuses a directory destination (exit 2, named)",
        r4.code == 2 && r4.err.contains("(a directory sits there)"), "")

    # the writable path still renders (the refusals did not eat the road)
    move_markers(acc, repo, 4, 149)
    let d: RunResult = rc(["declare", "--tag", "v1.0.0-rc.4"], repo)
    check(acc, "the candidate declares for the render", d.code == 0,
        clip(d.combined, 80))
    let out_dir: str = scratch(acc, "rendered")
    mkdirs(out_dir)
    let r5: RunResult = rc(["report", "--out", path_join3(out_dir, "RC.md")], repo)
    check(acc, "the writable destination still renders the record",
        r5.code == 0 && file_exists(path_join3(out_dir, "RC.md")), "")
    let r6: RunResult = lts(["policy", "--out", path_join3(out_dir, "LTS.md")], repo)
    check(acc, "the writable destination still renders the policy",
        r6.code == 0 && file_exists(path_join3(out_dir, "LTS.md")), "")

    # the working paths the kit already had stay green
    let r7: RunResult = rc(["readiness"], repo)
    check(acc, "the scratch world is ready",
        r7.code == 0 && r7.out.contains("READY"), clip(r7.combined, 80))
    let r8: RunResult = rc(["report", "--check"], repo)
    check(acc, "a declared world without a published record says so, named",
        r8.code == 1 && r8.combined.contains("not published"), "")
}

# ----------------------------------------------------------------------------
# 2. the signature law — the signing act, refused and landed
# ----------------------------------------------------------------------------

fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    header("2. the signature law — the signing act, refused and landed")
    let repo: str = seed_world(acc, "the-signature", fancy_roadmap(145))

    # no anchor: nothing to sign
    let r: RunResult = rc(["signoff", "--by", signer()], repo)
    check(acc, "a world without a candidate has nothing to sign",
        r.code == 1 && r.combined.contains("no anchor"), "")
    # the name law: a signature names its signer
    let r2: RunResult = rc(["signoff"], repo)
    check(acc, "an anonymous sign-off is a usage error",
        r2.code == 2 && r2.err.contains("--by NAME is required"), "")
    let r3: RunResult = rc(["signoff", "--by", "   "], repo)
    check(acc, "a blank signer is a usage error",
        r3.code == 2 && r3.err.contains("--by NAME is required"), "")

    # the wrong tag is not the candidate the stage names
    move_markers(acc, repo, 4, 149)
    let r4: RunResult = rc(["declare", "--tag", "v1.0.0-rc.3"], repo)
    check(acc, "declare refuses the candidate whose stage is not the open one",
        r4.code == 1 && r4.combined.contains("closes Stage"), "")

    # the signed walk: declare, sign, render, release, tag
    let anchor: JsonValue = walk_signed_candidate(acc, repo, 4, signer())
    check(acc, "the rc.4 anchor carries the candidate and its stage",
        jget_str(anchor, "tag") == "v1.0.0-rc.4"
            && jget_int(anchor, "stage") == 149, "")
    let so: JsonValue = json_object_get(anchor, "signoff")
    check(acc, "the anchor carries the signature (the name, the day)",
        jget_str(so, "by") == signer() && jget_str(so, "day") == release_day(), "")

    # the once law: a live signature is not overwritten
    let r5: RunResult = rc(["signoff", "--by", "someone else"], repo)
    check(acc, "a second signature over a live one is refused",
        r5.code == 1 && r5.combined.contains("already signed off"), "")
    check(acc, "the refusal names the signer who owns the candidate",
        r5.combined.contains(signer()), "")

    # the tree law, on its own world: a dirty tracked tree refuses
    let repo2: str = seed_world(acc, "the-dirty", fancy_roadmap(149))
    move_markers(acc, repo2, 4, 149)
    rc(["declare", "--tag", "v1.0.0-rc.4"], repo2)
    wf(repo2, "ROADMAP.md", fancy_roadmap(149) + "drift\n")
    let r6: RunResult = rc(["signoff", "--by", signer()], repo2)
    check(acc, "a signature refuses a dirty tracked tree",
        r6.code == 1 && r6.combined.contains("dirty"), "")
    git(repo2, ["checkout", "-q", "--", "ROADMAP.md"])
    let r7: RunResult = rc(["signoff", "--by", signer()], repo2)
    check(acc, "the committed tree signs (the anchor file itself is exempt)",
        r7.code == 0 && r7.out.contains("signed off by"), "")
    let so2: JsonValue = json_object_get(anchor_of(repo2), "signoff")
    check(acc, "the day is the committer day (--at pins it)",
        jget_str(so2, "by") == signer() && jget_str(so2, "day") == release_day(), "")

    # --at pins the day the signature is judged on
    let repo3: str = seed_world(acc, "the-at-day", fancy_roadmap(149))
    move_markers(acc, repo3, 4, 149)
    rc(["declare", "--tag", "v1.0.0-rc.4"], repo3)
    let r8: RunResult = rc(["signoff", "--by", signer(), "--at", "2026-12-24"], repo3)
    check(acc, "the signature cuts with --at", r8.code == 0, "")
    let so3: JsonValue = json_object_get(anchor_of(repo3), "signoff")
    check(acc, "--at pins the day the signature speaks",
        jget_str(so3, "day") == "2026-12-24", "")
}

# ----------------------------------------------------------------------------
# 3. the witness law — the check re-derives, re-earns
# ----------------------------------------------------------------------------

fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    header("3. the witness law — the check re-derives, re-earns")
    let repo: str = seed_world(acc, "the-witness", fancy_roadmap(145))
    walk_candidate(acc, repo, 4)

    # the unsigned law: the check says so, named
    let r: RunResult = rc(["signoff", "--check"], repo)
    check(acc, "an unsigned candidate says so at --check",
        r.code == 1 && r.combined.contains("unsigned"), "")
    let rj: RunResult = rc(["signoff", "--check", "--json"], repo)
    check(acc, "the unsigned verdict parses as JSON too", rj.code == 1, "")
    let data: JsonValue = parse_json_or_null(rj.out)
    if json_is_object(data) {
        let laws: JsonValue = json_object_get(data, "laws")
        let n_laws: int = laws.arr.len()
        check(acc, "the unsigned JSON carries the named laws (" + n_laws.to_str() + ")",
            jget_bool_is(data, "signed", false)
                && jget_bool_is(data, "ok", false)
                && json_is_array(laws) && n_laws >= 9, "")
    } else {
        fail_msg(acc, "the unsigned JSON does not parse: " + clip(rj.out, 80))
    }

    # the signing act on the witness world
    let r2: RunResult = rc(["signoff", "--by", signer()], repo)
    check(acc, "the candidate signs", r2.code == 0, "")

    # the record must be re-rendered: the committed record no longer
    # speaks the signed state (the drift the choreography renders away)
    let r3: RunResult = rc(["report", "--check"], repo)
    check(acc, "the record drifts the moment the signature lands (render "
        + "before commit)", r3.code == 1, "")
    let r4: RunResult = rc(["signoff", "--check"], repo)
    check(acc, "the witness refuses on the record law until the render",
        r4.code == 1 && r4.out.contains("the record law"), "")

    rc(["report", "--out", path_join3(repo, "RC.md")], repo)
    commit_all(repo, "release: v1.0.0-rc.4 anchored, the record rendered")
    git(repo, ["tag", "v1.0.0-rc.4"])
    let r5: RunResult = rc(["signoff", "--check"], repo)
    check(acc, "the signed world is green at the witness",
        r5.code == 0 && r5.out.contains("signed off by"), "")
    let rj2: RunResult = rc(["signoff", "--check", "--json"], repo)
    check(acc, "the signed verdict parses as JSON", rj2.code == 0, "")
    let data2: JsonValue = parse_json_or_null(rj2.out)
    if json_is_object(data2) {
        let laws2: JsonValue = json_object_get(data2, "laws")
        let n2: int = laws2.arr.len()
        check(acc, "the signed JSON carries the signature and the laws (" + n2.to_str() + ")",
            jget_bool_is(data2, "signed", true)
                && jget_str(data2, "by") == signer()
                && jget_str(data2, "day") == release_day()
                && jget_bool_is(data2, "ok", true)
                && json_is_array(laws2) && n2 >= 9, "")
    } else {
        fail_msg(acc, "the signed JSON does not parse: " + clip(rj2.out, 80))
    }

    # the gate law voids: a FEATURE past the anchor is not covered
    wf(repo, "src/new_surface.hls", "fn added() -> int {\n    return 1\n}\n")
    commit_all(repo, "feat: a surface the freeze refuses")
    let g: RunResult = rc(["gate"], repo)
    check(acc, "the gate refuses the feature (the kit's own voice)",
        g.code == 1 && g.out.contains("VIOLATION"), "")
    let r6: RunResult = rc(["signoff", "--check"], repo)
    check(acc, "the witness voids on the gate law",
        r6.code == 1 && r6.out.contains("the gate law"), "")
    git(repo, ["reset", "-q", "--hard", "HEAD~1"])

    # the record law voids: a hand-edited record is visible
    wf(repo, "RC.md", str_replace(read_or(path_join3(repo, "RC.md"), ""),
        signer(), "someone else"))
    let r7: RunResult = rc(["signoff", "--check"], repo)
    check(acc, "the witness voids on the record law",
        r7.code == 1 && r7.out.contains("the record law"), "")
    git(repo, ["checkout", "-q", "--", "RC.md"])

    # re-earned: the SAME signature is green again
    let r8: RunResult = rc(["signoff", "--check"], repo)
    check(acc, "the signature is re-earned, not archived",
        r8.code == 0 && r8.out.contains("signed off by"), "")
}

# ----------------------------------------------------------------------------
# 4. the record law — the render speaks the signature, once
# ----------------------------------------------------------------------------

fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    header("4. the record law — the render speaks the signature, once")
    let repo: str = seed_world(acc, "the-record", fancy_roadmap(145))
    let before: str = walk_candidate(acc, repo, 4)
    check(acc, "the unsigned render carries no sign-off line",
        signoff_lines_of(before).len() == 0, "")
    let r: RunResult = rc(["report", "--check"], repo)
    check(acc, "the committed unsigned record is the kit's render",
        r.code == 0, "")

    let s: RunResult = rc(["signoff", "--by", signer()], repo)
    check(acc, "the candidate signs", s.code == 0, "")
    let after: str = render_to_text(acc, repo)
    check(acc, "the signed render carries exactly one sign-off line",
        signoff_lines_of(after).len() == 1, "")
    check(acc, "the sign-off line names the signer and the day",
        list_contains(signoff_lines_of(after),
            signoff_line(signer(), release_day())), "")
    let added: list[str] = added_lines(after, before)
    check(acc, "the render diff is exactly the sign-off line ("
        + added.len().to_str() + " line(s) added)",
        lists_equal(added, signoff_lines_of(after)), "")

    # the choreography: render, commit, tag — then the record is the
    # anchored one
    rc(["report", "--out", path_join3(repo, "RC.md")], repo)
    commit_all(repo, "release: v1.0.0-rc.4 anchored, the record rendered")
    git(repo, ["tag", "v1.0.0-rc.4"])
    let r2: RunResult = rc(["report", "--check"], repo)
    check(acc, "the committed record is the signed render (drift refused)",
        r2.code == 0, "")
}

# ----------------------------------------------------------------------------
# 5. the real-tree pre-flight — this tree, this moment
# ----------------------------------------------------------------------------

fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    header("5. the real-tree pre-flight — this tree, this moment")
    let r: RunResult = rc(["readiness"], ".")
    if release_state() == "released" {
        check(acc, "the REAL tree is released (readiness refuses on both "
            + "laws, named)",
            r.code == 1 && r.out.contains("NOT READY: the roadmap law")
                && r.out.contains("NOT READY: the lts law"), "")
        let g: RunResult = rc(["gate"], ".")
        check(acc, "the gate refuses on the missing anchor",
            g.code == 1 && g.combined.contains("no anchor"), "")
        let rc2: RunResult = rc(["report", "--check"], ".")
        check(acc, "the record refuses on the missing anchor",
            rc2.code == 1 && rc2.combined.contains("no anchor"), "")
    } else {
        check(acc, "the REAL tree is ready",
            r.code == 0 && r.out.contains("READY"), "")
        let g: RunResult = rc(["gate"], ".")
        check(acc, "the gate over the live range names only BUGFIX and CHORE",
            g.code == 0, "")
        let rc2: RunResult = rc(["report", "--check"], ".")
        check(acc, "the committed record matches the render (drift refused)",
            rc2.code == 0, "")
    }

    let head_v: str = real_head_version()
    let man_v: str = jget_str(parse_json_or_null(read_or(
        "snapshot/MANIFEST.json", "")), "version")
    let vs_v: str = jget_str(parse_json_or_null(read_or(
        "editors/vscode/halis/package.json", "")), "version")
    check(acc, "the three markers speak with one voice (" + head_v + ")",
        man_v == "v" + head_v && vs_v == head_v,
        "manifest=" + man_v + " vscode=" + vs_v)

    # the anchor is a candidate of the line, speaking its stage's own
    # phrase off the live roadmap (the law stays green for every
    # candidate: each row's phrase is read where the record stands)
    if file_exists(".hls-rc.json") {
        let anchor: JsonValue = anchor_of(".")
        let atag: str = jget_str(anchor, "tag")
        check(acc, "the real tree's anchor is a candidate of the line ("
            + atag + ")",
            atag == "v1.0.0-rc.1" || atag == "v1.0.0-rc.2"
                || atag == "v1.0.0-rc.3" || atag == "v1.0.0-rc.4", "")
        let stage: int = jget_int(anchor, "stage")
        let mut phrase: str = ""
        let src: str = read_or("ROADMAP.md", "")
        let lines: list[str] = src.split("\n")
        let mut i: int = 0
        while i < lines.len() {
            let line: str = lines.get(i)
            if line.starts_with("|") {
                let cells: list[str] = line.split("|")
                if cells.len() >= 4 && cells.get(1).trim() == stage.to_str() {
                    let title: str = cells.get(2).trim()
                    if title.contains("(") && title.ends_with(")") {
                        phrase = title.slice(title.find("(") + 1,
                            title.len() - 1)
                    }
                    i = lines.len()
                }
            }
            i = i + 1
        }
        let committed: str = read_or("RC.md", "")
        if phrase != "" {
            check(acc, "the committed record speaks Stage " + stage.to_str()
                + "'s own phrase (" + phrase + ")",
                tag_line_of(committed).contains(phrase), "")
        }

        # signoff --check, pinned DYNAMICALLY: green on a signed
        # anchor, the unsigned refusal on an unsigned one — both are
        # legal states of the line, and the witness names its state
        let sc: RunResult = rc(["signoff", "--check"], ".")
        let signed: bool = jget_str(json_object_get(
            anchor_of("."), "signoff"), "by") != ""
        if signed {
            check(acc, "the real tree's signature is re-derived green",
                sc.code == 0 && sc.out.contains("signed off by"), "")
        } else {
            check(acc, "the real tree's unsigned state is named (the "
                + "instrument reads the anchor, not the wish)",
                sc.code == 1 && sc.combined.contains("unsigned"), "")
        }
    } else {
        check(acc, "no anchor on the tree — and the line is declared (the "
            + "release, not a gap)",
            release_state() == "released", "")
        let sc: RunResult = rc(["signoff", "--check"], ".")
        check(acc, "the signature's office closed with the anchor (the "
            + "witness names it)",
            sc.code == 1 && sc.combined.contains("no anchor"), "")
    }
}

# ----------------------------------------------------------------------------
# 6. the corpus showcase — the sign-off laws in pure HLS
# ----------------------------------------------------------------------------

fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    header("6. the corpus showcase — the sign-off laws in pure HLS")
    let fmt: RunResult = run_capture("./bin/hlfmt", [showcase()])
    let src: str = read_file(showcase())
    check(acc, "the showcase is hlfmt-canonical",
        fmt.code == 0 && fmt.out == src, "")
    let lint: RunResult = run_capture("python3", ["tools/hllint.py", showcase()])
    check(acc, "the showcase is hllint-clean",
        lint.code == 0 && lint.out.contains("no warnings"), "")
    let chk: RunResult = boot(acc, ["--check", showcase()])
    check(acc, "the showcase passes the real checker", chk.code == 0, "")
    let run: RunResult = boot(acc, [showcase()])
    check(acc, "the showcase runs green on the interpreter",
        run.code == 0 && run.out == showcase_out(), "")
    if file_exists("bin/hlc") && which("gcc") {
        let out_c: str = scratch(acc, "showcase.c")
        let comp: RunResult = run_capture("./bin/hlc", [showcase(), out_c])
        if comp.code != 0 {
            fail_msg(acc, "the showcase does not compile natively: "
                + clip(comp.combined, 160))
        } else {
            let binp: str = scratch(acc, "showcase")
            let link: RunResult = run_capture("gcc",
                ["-O2", "-o", binp, out_c, "-lm", "-pthread"])
            if link.code != 0 {
                fail_msg(acc, "the showcase binary does not link")
            } else {
                let nat: RunResult = run_capture(binp, [])
                check(acc, "the showcase matches natively, byte for byte",
                    nat.code == 0 && nat.out == showcase_out(), "")
            }
        }
    }
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    # the battery's GIT_ENV — every child (git, the kit) sees the
    # pinned identity and the pinned committer day
    env_set_var("GIT_AUTHOR_NAME", "rc149-gate")
    env_set_var("GIT_AUTHOR_EMAIL", "rc149-gate@example.invalid")
    env_set_var("GIT_COMMITTER_NAME", "rc149-gate")
    env_set_var("GIT_COMMITTER_EMAIL", "rc149-gate@example.invalid")
    env_set_var("GIT_COMMITTER_DATE", "2026-10-29T09:00:00+00:00")
    env_set_var("GIT_AUTHOR_DATE", "2026-10-29T09:00:00+00:00")
    let acc: Acc = acc_new("rc4")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    return finish(acc, "Stage 149 -- v1.0.0-rc.4, the sign-off")
}
