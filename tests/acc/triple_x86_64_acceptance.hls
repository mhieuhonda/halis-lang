# ============================================================================
# tests/acc/triple_x86_64_acceptance.hls — Stage 93 acceptance gate, in Halis
# (the Halis twin of tests/triple_x86_64_acceptance.py; same eight
# sections, same assertions, same needles — the harness is
# tests/acc/harness.hls and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make triple-x86_64-acceptance` (which compiles this file
# to bin/acc-triple-x86_64 and runs it from the repo root).
#
#  1. the CLI surface        — the triple names, and the two flag
#                              combinations a bare-metal build refuses
#                              (--target-feature: SIMD computes in FP
#                              registers; --no-libc: the hosted no-libc
#                              mode, not a freestanding image) — the
#                              SAME words from both front-ends
#  2. the integer-only rule  — eight fail programs (a float literal, a
#                              parameter, a return, a struct field, an
#                              enum payload, a let, a generic argument,
#                              a list element) rejected by BOTH
#                              compilers with the SAME words, and the
#                              boundary that every one of them stays a
#                              LEGAL hosted crate (they are
#                              deliberately not in tests/fail/)
#  3. the implication        — --target implies #![freestanding]: the
#                              audits of a crate that never declared it
#                              agree, line for line
#  4. the emission shape     — the triple stamp in the C, the 3-header
#                              freestanding TU, the naked _start with
#                              the x86-64 raw-exit branch
#  5. the image              — the end-to-end link: ELF64 x86-64,
#                              entry 0x100000, _start the lowest symbol,
#                              ZERO undefined symbols, and the probe
#                              runs on the host with exit 42
#  6. the orchestrator       — hlcross --target drives hlc --target
#                              plus the freestanding link (and the
#                              registry lists the bare-metal triples)
#  7. the linker script      — targets/x86_64-unknown-none.ld: _start
#                              kept and placed first, the metadata
#                              sections, the boot-header keeps
#  8. the tools              — hlfmt stable, hllint clean on the new
#                              sources
# ============================================================================

import "./harness.hls"
import "std.str"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

struct FailP {
    stem: str,
    needle: str,
    why: str
}

struct LdCheck {
    needle: str,
    why: str
}

struct ElfHdr {
    ok: bool,
    ei_class: int,
    ei_data: int,
    machine: int,
    entry: int
}

fn triple() -> str {
    return "x86_64-unknown-none"
}

fn demo() -> str {
    return "examples/bare_x86_64.hls"
}

fn bad_triple_msg() -> str {
    return "unknown bare-metal target 'armv7-unknown-none' (expected "
    + "x86_64-unknown-none | aarch64-unknown-none | riscv64-unknown-none)"
}

fn fail_programs() -> list[FailP] {
    return[
    FailP {
        stem: "fail_bare_float_literal", needle: "float literals are not available",
        why: "a float literal in an expression"
    },
    FailP {
        stem: "fail_bare_float_param", needle: "the type 'float' is not available",
        why: "a float parameter annotation"
    },
    FailP {
        stem: "fail_bare_float_ret", needle: "the type 'float' is not available",
        why: "a float return annotation"
    },
    FailP {
        stem: "fail_bare_float_field", needle: "the type 'list[float]' is not available",
        why: "a float struct field"
    },
    FailP {
        stem: "fail_bare_float_variant", needle: "the type 'float' is not available",
        why: "a float enum payload"
    },
    FailP {
        stem: "fail_bare_float_let", needle: "the type 'float' is not available",
        why: "a float let annotation"
    },
    FailP {
        stem: "fail_bare_float_listelem", needle: "the type 'list[float]' is not available",
        why: "float as a generic list argument"
    },
    FailP {
        stem: "fail_bare_float_generic", needle: "the type 'Cell[float]' is not available",
        why: "float as a generic struct argument"
    },
    ]
}

fn script_checks() -> list[LdCheck] {
    return[
    LdCheck {
        needle: "ENTRY(_start)", why: "the entry is _start"
    },
    LdCheck {
        needle: ". = 0x100000;", why: "the base is 1 MiB"
    },
    LdCheck {
        needle: "KEEP(*(.text._start))", why: "_start is kept and placed first"
    },
    LdCheck {
        needle: "KEEP(*(.multiboot_header))",
        why: "the Multiboot2 header survives --gc-sections (Stage 85 interop)"
    },
    LdCheck {
        needle: "KEEP(*(.limine_requests))",
        why: "the Limine requests survive --gc-sections (Stage 85 interop)"
    },
    LdCheck {
        needle: "__halis_metadata_start",
        why: "the Stage 84 metadata section is bounded"
    },
    LdCheck {
        needle: "__halis_sections_start",
        why: "the Stage 84 custom-section region is bounded"
    },
    LdCheck {
        needle: "*(.eh_frame)",
        why: "eh_frame is discarded (no unwind tables in an image with no unwinder)"
    },
    LdCheck {
        needle: "NOLOAD",
        why: "bss is NOLOAD (a bare image has no loader to zero it page by page)"
    },
    ]
}

fn imply_src() -> str {
    return "# No crate attribute — the triple is the promise.\n" +
    "fn main() -> int {\n" +
    "    let mut acc: int = 0\n" +
    "    let mut i: int = 0\n" +
    "    while i < 4 {\n" +
    "        acc = acc + i\n" +
    "        i = i + 1\n" +
    "    }\n" +
    "    return acc - 6 + 42\n" +
    "}\n"
}

fn std_imp_src() -> str {
    return "import \"std.str\"\n" +
    "\n" +
    "fn main() -> int {\n" +
    "    return 0\n" +
    "}\n"
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

fn find_last(s: str, sub: str) -> int {
    let mut i: int = s.len() - sub.len()
    while i >= 0 {
        if s.slice(i, i + sub.len()) == sub {
            return i
        }
        i = i - 1
    }
    return -1
}

# normalise(text) — strip the front-end-specific prefix and the line
# suffix so the two compilers' diagnostics compare byte for byte (the
# old battery's three re.sub passes, as byte logic — same convention
# as the Stage 86/91 gates).
fn normalise(text: str) -> str {
    let mut t: str = text.trim()
    # "^panic: "
    if t.starts_with("panic: ") {
        t = t.slice(7, t.len())
    }
    # "^[a-z ]*error: " — an optional front-end name, then the error.
    let e: int = t.find("error: ")
    if e >= 0 {
        let mut all_az: bool = true
        let mut i: int = 0
        while i < e {
            let c: int = t.byte_at(i)
            if !((c >= 97 && c <= 122) || c == 32) {
                all_az = false
                break
            }
            i = i + 1
        }
        if all_az {
            t = t.slice(e + 7, t.len())
        }
    }
    # " \(line N[:M]\)$" — the trailing position suffix.
    let l: int = find_last(t, " (line ")
    if l >= 0 {
        let mut j: int = l + 7
        let mut shape_ok: bool = true
        let mut digits: int = 0
        while j < t.len() && t.byte_at(j) >= 48 && t.byte_at(j) <= 57 {
            j = j + 1
            digits = digits + 1
        }
        if digits == 0 {
            shape_ok = false
        }
        if shape_ok && j < t.len() && t.byte_at(j) == 58 {
            j = j + 1
            let mut d2: int = 0
            while j < t.len() && t.byte_at(j) >= 48 && t.byte_at(j) <= 57 {
                j = j + 1
                d2 = d2 + 1
            }
            if d2 == 0 {
                shape_ok = false
            }
        }
        if shape_ok && j < t.len() && t.byte_at(j) == 41 {
            j = j + 1
            if j == t.len() {
                t = t.slice(0, l)
            }
        }
    }
    return t
}

# first_diag(text) — the first line of a diagnostic, normalised.
fn first_diag(text: str) -> str {
    return normalise(first_line(text))
}

# boot_check_target(src, with_target) — the lab interpreter's --check
# with the triple attached (or not, for the hosted-boundary probes).
fn boot_check_target(acc: Acc, src: str, with_target: bool) -> RunResult uses Proc {
    let args: list[str] = ["--check", "--target", triple(), src]
    if !with_target {
        let plain: list[str] = ["--check", src]
        return boot(acc, plain)
    }
    return boot(acc, args)
}

# hlc_compile_target(src, out_c, with_target) — the self-hosted
# compiler under --target.
fn hlc_compile_target(acc: Acc, src: str, out_c: str, with_target: bool) -> RunResult uses Proc {
    let args: list[str] = ["--target", triple(), src, out_c]
    if !with_target {
        let plain: list[str] = [src, out_c]
        return run_capture(hlc_path(acc), plain)
    }
    return run_capture(hlc_path(acc), args)
}

# audit_mode_lines(out) — the audit's crate-mode/target lines, the way
# the battery filtered them.
fn audit_mode_lines(out: str) -> list[str] {
    let lines: list[str] = out.split("\n")
    let sel: list[str] = []
    let mut i: int = 0
    while i < lines.len() {
        let l: str = lines.get(i)
        if l.contains("Crate mode") || l.contains("Target:") {
            sel.push(l.trim())
        }
        i = i + 1
    }
    return sel
}

fn lists_eq(a: list[str], b: list[str]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let mut i: int = 0
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn str_in_list(xs: list[str], v: str) -> bool {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) == v {
            return true
        }
        i = i + 1
    }
    return false
}

fn is_ws_byte(c: int) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

# find_from(s, sub, from) — str.find with a start offset (the scan
# helper the include extraction needs).
fn find_from(s: str, sub: str, from: int) -> int {
    let mut start: int = from
    if start < 0 {
        start = 0
    }
    if start > s.len() {
        return -1
    }
    let at: int = s.slice(start, s.len()).find(sub)
    if at < 0 {
        return -1
    }
    return start + at
}

# include_headers(src) — every `#include <...>` header name, in order
# (the battery's re.findall of the angle includes).
fn include_headers(src: str) -> list[str] {
    let out: list[str] = []
    let mut from: int = 0
    while from < src.len() {
        let at: int = find_from(src, "#include", from)
        if at < 0 {
            break
        }
        let mut j: int = at + 8
        while j < src.len() && is_ws_byte(src.byte_at(j)) {
            j = j + 1
        }
        if j < src.len() && src.byte_at(j) == 60 {
            let close: int = find_from(src, ">", j + 1)
            if close > j {
                out.push(src.slice(j + 1, close))
                from = close + 1
            } else {
                from = at + 8
            }
        } else {
            from = at + 8
        }
    }
    return out
}

# inc_eq_3(inc) — the header set equals the 3-header freestanding TU
# (duplicates ignored, exactly what the battery's sorted(set(...)) did).
fn inc_eq_3(inc: list[str]) -> bool {
    let want: list[str] = ["stdbool.h", "stddef.h", "stdint.h"]
    let mut i: int = 0
    while i < inc.len() {
        if !str_in_list(want, inc.get(i)) {
            return false
        }
        i = i + 1
    }
    let mut j: int = 0
    while j < want.len() {
        if !str_in_list(inc, want.get(j)) {
            return false
        }
        j = j + 1
    }
    return true
}

# last_field(line) — the last whitespace-separated token (nm output).
fn last_field(line: str) -> str {
    let t: str = line.trim()
    if t == "" {
        return ""
    }
    let mut i: int = t.len() - 1
    while i >= 0 {
        let c: int = t.byte_at(i)
        if c == 32 || c == 9 {
            return t.slice(i + 1, t.len())
        }
        i = i - 1
    }
    return t
}

# sym_list(out) — nm's symbol column, one per non-empty line, in the
# order nm printed them (nm -n sorts by address).
fn sym_list(out: str) -> list[str] {
    let lines: list[str] = out.split("\n")
    let syms: list[str] = []
    let mut i: int = 0
    while i < lines.len() {
        let l: str = lines.get(i)
        if l.trim() != "" {
            syms.push(last_field(l))
        }
        i = i + 1
    }
    return syms
}

# elf_header(path) — (ei_class, ei_data, e_machine, e_entry) of an
# ELF64 image, read byte by byte (read_file is byte-transparent).
fn elf_header(path: str) -> ElfHdr uses Fs {
    let h: ElfHdr = ElfHdr {
        ok: false, ei_class: 0, ei_data: 0, machine: 0, entry: 0
    }
    if !file_exists(path) {
        return h
    }
    let blob: str = read_file(path)
    if blob.len() < 64 {
        return h
    }
    # "\x7fELF"
    if blob.byte_at(0) != 127 || blob.byte_at(1) != 69 || blob.byte_at(2) != 76
    || blob.byte_at(3) != 70 {
        return h
    }
    h.ok = true
    h.ei_class = blob.byte_at(4)
    h.ei_data = blob.byte_at(5)
    # e_machine: little-endian uint16 at offset 18
    h.machine = blob.byte_at(18) + blob.byte_at(19) * 256
    # e_entry: little-endian uint64 at offset 24 (MSB first, so the
    # checked multiply never leaves the i64 range for real entries)
    let mut e: int = 0
    let mut i: int = 31
    while i >= 24 {
        e = e * 256 + blob.byte_at(i)
        i = i - 1
    }
    h.entry = e
    return h
}

# ----------------------------------------------------------------------------
# 1. the CLI surface: the triples and the refused combinations
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    section("1. the CLI surface: the triples and the refused combinations")
    let never: str = scratch(acc, "never.c")
    # An unknown triple: refused by both front-ends, the SAME words,
    # the registry named.
    let b: RunResult = boot(acc, ["--check", "--target", "armv7-unknown-none", demo()])
    let h: RunResult = run_capture(hlc_path(acc),
    ["--target", "armv7-unknown-none", demo(), never])
    # hlc's CLI diagnostics print to stdout (println); boot's to stderr.
    let b_text: str = b.combined.trim()
    let h_text: str = h.combined.trim()
    if b.code == 0 || h.code == 0 {
        fail_msg(acc, "CLI: an unknown triple was accepted (boot rc=" + b.code.to_str()
        + ", hlc rc=" + h.code.to_str() + ")")
    } else if normalise(b_text) != normalise(h_text) {
        fail_msg(acc, "CLI: front-ends disagree on the unknown-triple words: boot: "
        + clip(b_text, 100) + " | hlc: " + clip(h_text, 100))
    } else if !b_text.contains(bad_triple_msg()) {
        fail_msg(acc, "CLI: the unknown-triple diagnostic does not name the registry: "
        + clip(b_text, 160))
    } else {
        pass_msg(acc, "CLI: an unknown triple is refused with the registry, both front-ends")
    }
    # --target-feature under --target: the integer-only refusal.
    let feat_msg: str = "--target-feature is not available on target " + triple()
    + " (bare-metal targets are integer-only: SIMD intrinsics use "
    + "floating-point registers)"
    let b2: RunResult = boot(acc, ["--check", "--target", triple(),
    "--target-feature", "neon", demo()])
    let h2: RunResult = run_capture(hlc_path(acc),
    ["--target", triple(), "--target-feature", "neon", demo(), never])
    let b2_text: str = b2.combined.trim()
    let h2_text: str = h2.combined.trim()
    if b2.code == 0 || h2.code == 0 {
        fail_msg(acc, "CLI: --target-feature under --target was accepted")
    } else if normalise(b2_text) != normalise(h2_text) {
        fail_msg(acc, "CLI: front-ends disagree on the --target-feature words: boot: "
        + clip(b2_text, 100) + " | hlc: " + clip(h2_text, 100))
    } else if !b2_text.contains(feat_msg) {
        fail_msg(acc, "CLI: the --target-feature diagnostic is not the integer-only one: "
        + clip(b2_text, 160))
    } else {
        pass_msg(acc, "CLI: --target-feature refused on the triple, same words from both")
    }
    # --no-libc under --target: the hosted-mode vs freestanding refusal.
    let nolc_msg: str = "--no-libc is not available on target " + triple()
    + " (the bare-metal triples build freestanding images, not "
    + "hosted no-libc ones)"
    let h3: RunResult = run_capture(hlc_path(acc),
    ["--target", triple(), "--no-libc", demo(), never])
    if h3.code == 0 {
        fail_msg(acc, "CLI: --no-libc under --target was accepted")
    } else if !h3.combined.trim().contains(nolc_msg) {
        fail_msg(acc, "CLI: the --no-libc diagnostic is not the mode-conflict one: "
        + clip(h3.combined, 160))
    } else {
        pass_msg(acc, "CLI: --no-libc refused on the triple (hosted mode vs freestanding)")
    }
    # The triple compiles a legal program.
    let cli_ok: str = scratch(acc, "cli_ok.c")
    let h4: RunResult = run_capture(hlc_path(acc), ["--target", triple(), demo(), cli_ok])
    if h4.code != 0 {
        fail_msg(acc, "CLI: the triple was refused on a legal program: " + clip(h4.err, 120))
    } else {
        pass_msg(acc, "CLI: the triple compiles a legal program (exit 0)")
    }
}

# ----------------------------------------------------------------------------
# 2. the integer-only rule: the fail programs, both front-ends
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    section("2. the integer-only rule: the fail programs, both front-ends")
    let fps: list[FailP] = fail_programs()
    let mut i: int = 0
    while i < fps.len() {
        let fp: FailP = fps.get(i)
        let src: str = "tests/bare/" + fp.stem + ".hls"
        let b: RunResult = boot_check_target(acc, src, true)
        let h: RunResult = hlc_compile_target(acc, src, scratch(acc, fp.stem + ".c"), true)
        if b.code == 0 {
            fail_msg(acc, fp.stem + ": boot accepted a float under --target (" + fp.why + ")")
            i = i + 1
            continue
        }
        if h.code == 0 {
            fail_msg(acc, fp.stem + ": hlc accepted a float under --target (" + fp.why + ")")
            i = i + 1
            continue
        }
        let bmsg: str = first_diag(b.combined)
        let hmsg: str = first_diag(h.combined)
        if bmsg != hmsg {
            fail_msg(acc, fp.stem + ": boot and hlc disagree on the words: boot: "
            + bmsg + " | hlc: " + hmsg)
            i = i + 1
            continue
        }
        if !bmsg.contains(fp.needle) {
            fail_msg(acc, fp.stem + ": diagnostic does not name the construct ('"
            + fp.needle + "'): " + bmsg)
            i = i + 1
            continue
        }
        pass_msg(acc, fp.stem + " rejected identically by both front-ends (" + fp.why + ")")
        i = i + 1
    }
    # The boundary: every fail program is a LEGAL hosted crate. They
    # live in tests/bare/ (not tests/fail/) precisely because the rule
    # is conditional on the triple.
    let mut legal: bool = true
    let mut j: int = 0
    while j < fps.len() {
        let fp2: FailP = fps.get(j)
        let rr: RunResult = boot_check_target(acc, "tests/bare/" + fp2.stem + ".hls", false)
        if rr.code != 0 {
            legal = false
            fail_msg(acc, fp2.stem + ": rejected WITHOUT --target — the rule is not "
            + "triple-conditional: " + first_line(rr.combined))
        }
        j = j + 1
    }
    if legal {
        pass_msg(acc, "boundary: all 8 probes compile as hosted crates without --target")
    }
}

# ----------------------------------------------------------------------------
# 3. the implication: --target implies #![freestanding]
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. the implication: --target implies #![freestanding]")
    let ipath: str = write_src(acc, "imply.hls", imply_src())
    let b: RunResult = boot(acc, ["--target", triple(), "--audit", ipath])
    let h: RunResult = run_capture(hlc_path(acc), ["--target", triple(), "--audit", ipath])
    let b_lines: list[str] = audit_mode_lines(b.out)
    let h_lines: list[str] = audit_mode_lines(h.out)
    if b.code != 0 || h.code != 0 {
        fail_msg(acc, "imply: an audit failed (boot rc=" + b.code.to_str()
        + ", hlc rc=" + h.code.to_str() + ")")
    } else if b_lines.len() != 2 || h_lines.len() != 2 {
        fail_msg(acc, "imply: expected the crate-mode and target lines from both audits: boot: ["
        + str_join(b_lines, ", ") + "] hlc: [" + str_join(h_lines, ", ") + "]")
    } else if !lists_eq(b_lines, h_lines) {
        fail_msg(acc, "imply: the audits disagree: boot: [" + str_join(b_lines, ", ")
        + "] hlc: [" + str_join(h_lines, ", ") + "]")
    } else if !b_lines.get(1).contains("Target: " + triple() + " (bare-metal, integer-only)") {
        fail_msg(acc, "imply: the target line is not stated: [" + str_join(b_lines, ", ") + "]")
    } else {
        pass_msg(acc, "imply: the audits agree — #![freestanding] implied, target stated")
    }
    # And the std boundary travels with the implication.
    let spath: str = write_src(acc, "stdimp.hls", std_imp_src())
    let br: RunResult = boot_check_target(acc, spath, true)
    if br.code == 0 {
        fail_msg(acc, "imply: std imports survived the freestanding implication")
    } else if !br.combined.trim().contains("the std module is disabled") {
        fail_msg(acc, "imply: the std rejection is not the freestanding one: "
        + first_diag(br.combined))
    } else {
        pass_msg(acc, "imply: std imports are refused under the bare-metal triple")
    }
}

# ----------------------------------------------------------------------------
# 4. the emission shape: the stamp, the TU, the exit branch
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("4. the emission shape: the stamp, the TU, the exit branch")
    let demo_c: str = scratch(acc, "demo.c")
    let h: RunResult = hlc_compile_target(acc, demo(), demo_c, true)
    if h.code != 0 {
        fail_msg(acc, "shape: the demo failed to compile under --target: "
        + clip(h.combined, 160))
        return
    }
    let src: str = read_file(demo_c)
    let inc: list[str] = include_headers(src)
    if !inc_eq_3(inc) {
        fail_msg(acc, "shape: the freestanding TU includes more than the 3 headers: ["
        + str_join(inc, ", ") + "]")
    } else if !src.contains("target: " + triple()
    + " (bare-metal, integer-only, freestanding)") {
        fail_msg(acc, "shape: the C does not carry the triple stamp")
    } else if !src.contains("void _start(void)") {
        fail_msg(acc, "shape: the naked _start is missing")
    } else if !src.contains("__builtin_trap") || src.contains("exit(101)") {
        fail_msg(acc, "shape: panics do not trap (or libc exit leaked in)")
    } else if !src.contains("movl $60, %eax") || !src.contains("syscall") {
        fail_msg(acc, "shape: the x86-64 raw-exit branch is missing from _start")
    } else {
        pass_msg(acc, "shape: 3-header TU, triple stamp, naked _start, x86-64 exit")
    }
}

# ----------------------------------------------------------------------------
# 5. the image: linked, inspected, and RUN on this host
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("5. the image: linked, inspected, and RUN on this host")
    let demo_c: str = scratch(acc, "demo.c")
    let img: str = scratch(acc, "bare_x86_64")
    let g: RunResult = run_capture("gcc", ["-O2", "-mgeneral-regs-only", "-ffreestanding",
    "-nostdlib", "-nostartfiles", "-fno-stack-protector", "-fno-pie", "-no-pie",
    "-ffunction-sections", "-Wl,--gc-sections,-T,targets/" + triple() + ".ld",
    "-o", img, demo_c])
    if g.code != 0 {
        fail_msg(acc, "image: the link failed: " + clip(g.err, 200))
        return
    }
    let hdr: ElfHdr = elf_header(img)
    if !hdr.ok {
        fail_msg(acc, "image: not an ELF file")
    } else if hdr.ei_class != 2 || hdr.ei_data != 1 || hdr.machine != 62 {
        fail_msg(acc, "image: wrong ELF identity (class=" + hdr.ei_class.to_str()
        + " data=" + hdr.ei_data.to_str() + " machine=" + hdr.machine.to_str()
        + " — want 64-bit LE EM_X86_64=62)")
    } else if hdr.entry != 1048576 {
        fail_msg(acc, "image: entry " + hdr.entry.to_str()
        + " is not the script's base 0x100000")
    } else {
        pass_msg(acc, "image: ELF64 LE, EM_X86_64, entry at the 1 MiB base")
    }
    let nmn: RunResult = run_capture("nm", ["-n", img])
    if nmn.code != 0 {
        fail_msg(acc, "image: nm failed")
    } else {
        let syms: list[str] = sym_list(nmn.out)
        if !str_in_list(syms, "_start") {
            fail_msg(acc, "image: no _start symbol")
        } else if syms.get(0) != "_start" {
            fail_msg(acc, "image: the lowest symbol is " + syms.get(0)
            + ", not _start (the base must be the entry)")
        } else {
            pass_msg(acc, "image: _start is the lowest symbol (the base is the entry)")
        }
    }
    let undef: RunResult = run_capture("nm", ["-u", img])
    if undef.code == 0 && undef.out.trim() != "" {
        fail_msg(acc, "image: undefined symbols survive: " + clip(undef.out, 120))
    } else {
        pass_msg(acc, "image: zero undefined symbols (no libc, nothing external)")
    }
    let rr: RunResult = run_capture(img, [])
    if rr.code != 42 {
        fail_msg(acc, "image: the probe exited " + rr.code.to_str() + ", not 42")
    } else {
        pass_msg(acc, "image: the bare-metal probe runs on this host and exits 42")
    }
}

# ----------------------------------------------------------------------------
# 6. the orchestrator: hlcross drives the whole pipeline
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    section("6. the orchestrator: hlcross drives the whole pipeline")
    let out_bin: str = scratch(acc, "cross_bin")
    let keep_c: str = scratch(acc, "cross.c")
    let cr: RunResult = run_capture("python3", ["tools/hlcross.py", demo(), out_bin,
    "--target", triple(), "--keep-c", keep_c])
    if cr.code != 0 {
        fail_msg(acc, "orchestrator: hlcross failed (rc=" + cr.code.to_str() + "): "
        + clip(cr.combined, 200))
    } else {
        let csrc: str = read_or(keep_c, "")
        let rr: RunResult = run_capture(out_bin, [])
        if !csrc.contains("target: " + triple()
        + " (bare-metal, integer-only, freestanding)") {
            fail_msg(acc, "orchestrator: the kept C lost the triple stamp (hlc --target "
            + "was not passed through)")
        } else if rr.code != 42 {
            fail_msg(acc, "orchestrator: the hlcross image exited " + rr.code.to_str()
            + ", not 42")
        } else {
            pass_msg(acc, "orchestrator: hlcross --target built a working image "
            + "(hlc --target + freestanding link)")
        }
    }
    # The registry names the bare-metal triples (Stage 93 names its own
    # triple and the RISC-V one that has been registered since Stage 26;
    # the AArch64 entry arrives with Stage 94).
    let lst: RunResult = run_capture("python3", ["tools/hlcross.py", "--list-targets"])
    let registered: bool = lst.out.contains("x86_64-unknown-none")
    && lst.out.contains("riscv64-unknown-none")
    if lst.code != 0 || !registered {
        fail_msg(acc, "orchestrator: --list-targets does not name the bare-metal triples")
    } else {
        pass_msg(acc, "orchestrator: the registry names the bare-metal triples")
    }
}

# ----------------------------------------------------------------------------
# 7. the linker script: the shape of the image
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Fs {
    section("7. the linker script: the shape of the image")
    let script: str = read_or("targets/" + triple() + ".ld", "")
    let checks: list[LdCheck] = script_checks()
    let mut bad_script: bool = false
    let mut i: int = 0
    while i < checks.len() {
        let c: LdCheck = checks.get(i)
        if !script.contains(c.needle) {
            fail_msg(acc, "script: " + c.why + " — missing '" + c.needle + "'")
            bad_script = true
        }
        i = i + 1
    }
    if !bad_script {
        if script.find("KEEP(*(.text._start))") > script.find("*(.text .text.*)") {
            fail_msg(acc, "script: .text._start must be placed BEFORE the general .text glob")
        } else {
            pass_msg(acc, "script: entry, base, _start-first, metadata, boot keeps, "
            + "discards — all in place")
        }
    }
}

# ----------------------------------------------------------------------------
# 8. the tools: hlfmt stable, hllint clean
# ----------------------------------------------------------------------------
fn sec8(acc: Acc) -> void uses IO, Proc {
    section("8. the tools: hlfmt stable, hllint clean")
    let fmt1: RunResult = run_capture("./bin/hlfmt", [demo()])
    let fmt2: RunResult = run_capture("./bin/hlfmt", [demo()])
    if fmt1.code == 0 && fmt2.code == 0 && fmt1.out == fmt2.out && fmt1.out.trim() != "" {
        pass_msg(acc, "tools: hlfmt stable on the demo")
    } else {
        fail_msg(acc, "tools: hlfmt unstable or empty on the demo")
    }
    let lint_files: list[str] = [demo(), "tests/bare/fail_bare_float_literal.hls"]
    let mut lint_ok: bool = true
    let mut i: int = 0
    while i < lint_files.len() {
        let f: str = lint_files.get(i)
        let lint: RunResult = run_capture("python3", ["tools/hllint.py", f])
        if lint.code != 0 {
            lint_ok = false
            fail_msg(acc, "tools: hllint findings on " + f + ": " + clip(lint.combined, 200))
        }
        i = i + 1
    }
    if lint_ok {
        pass_msg(acc, "tools: hllint clean on the demo and the probes")
    }
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("triple-x86_64")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    sec8(acc)
    return finish(acc, "Stage 93 -- target x86_64-unknown-none, the first bare-metal triple")
}
