# ============================================================================
# tests/acc/dma_acceptance.hls — Stage 89 acceptance gate, in Halis
# (the Halis twin of what was tests/dma_acceptance.py; same six sections,
# same assertions, same needles — the harness is tests/acc/harness.hls
# and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make dma-acceptance` (which compiles this file to bin/acc-dma
# and runs it from the repo root).
#
#  1. core/dma.hls     — the enum / structs / surface, the `core.*`-only
#                        import, no effects
#  2. the constructors  — the CHECKED ones: a zero length, a misaligned
#                        address, an address that does not fit the
#                        descriptor's width, a mapping past the window and
#                        an over-large bounce transfer all panic
#  3. the model         — five behaviour probes on the interpreter AND on
#                        both the hosted and `-nostdlib` native paths
#  4. the ok-test       — clean on all three paths
#  5. the demo + tools  — the demo runs; hlfmt and hllint are clean
#  6. the properties    — the six rules a driver actually relies on,
#                        asserted explicitly so a later change to the
#                        module cannot quietly drop one
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.regex"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

struct PanicP {
    desc: str,      # what the program constructs
    needle: str,    # the panic message it must carry
    body: str       # the program
}

struct Probe {
    name: str,
    want: int,
    desc: str,
    body: str
}

struct PropP {
    desc: str,
    body: str
}

fn ok_test() -> str {
    return "tests/ok/feat_stage89_dma.hls"
}

fn demo() -> str {
    return "examples/dma_demo.hls"
}

fn core_dma() -> str {
    return "core/dma.hls"
}

fn core_fns() -> list[str] {
    return [
        "dma_alignment_ok", "dma_is_aligned", "dma_size_ok", "dma_direction_name",
        "dma_needs_flush", "dma_needs_invalidate", "dma_needs_both",
        "dma_addr_bits", "dma_addr_bytes", "dma_addr_ok", "dma_desc_new",
        "dma_desc_end", "dma_desc_covers", "dma_desc_one_page", "dma_desc_pages",
        "dma_page_shift", "dma_window_new", "dma_window_end", "dma_window_has",
        "dma_window_remaining", "dma_map_ok", "dma_map", "dma_unmap",
        "dma_all_unmapped", "bounce_new", "bounce_fits", "bounce_begin",
        "bounce_end", "bounce_cost_bytes",
    ]
}

fn panic_programs() -> list[PanicP] {
    return [
        PanicP {
            desc: "a zero-length DMA descriptor",
            needle: "a zero-length transfer is a bug",
            body: "import \"core.dma\"\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    let d: DmaDesc = dma_desc_new(1048576, 0, DmaDirection.ToDevice, 64, 4096)\n" +
                  "    if d.length != 0 {\n" +
                  "        return 1\n" +
                  "    }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        PanicP {
            desc: "a misaligned DMA descriptor",
            needle: "meet the device's alignment",
            body: "import \"core.dma\"\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    let d: DmaDesc = dma_desc_new(1048577, 4096, DmaDirection.ToDevice, 64, 4096)\n" +
                  "    if d.addr != 1048577 {\n" +
                  "        return 1\n" +
                  "    }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        PanicP {
            desc: "an address wider than the descriptor",
            needle: "the descriptor's width",
            body: "import \"core.dma\"\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    let d: DmaDesc = dma_desc_new(1099511627776, 4096, DmaDirection.ToDevice, 32, 4096)\n" +
                  "    if d.addr_bits != 32 {\n" +
                  "        return 1\n" +
                  "    }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        PanicP {
            desc: "a mapping past the window",
            needle: "the end of the window",
            body: "import \"core.dma\"\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    let w: DmaWindow = dma_window_new(1048576, 4096, 0)\n" +
                  "    let w2: DmaWindow = dma_map(w, 8192)\n" +
                  "    if w2.mapped != 8192 {\n" +
                  "        return 1\n" +
                  "    }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        PanicP {
            desc: "a bounce transfer larger than the buffer",
            needle: "the transfer does not fit the bounce buffer",
            body: "import \"core.dma\"\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    let b: BounceBuf = bounce_new(2097152, 4096, 256)\n" +
                  "    let b2: BounceBuf = bounce_begin(b, 8192)\n" +
                  "    if b2.length != 4096 {\n" +
                  "        return 1\n" +
                  "    }\n" +
                  "    return 0\n" +
                  "}\n"
        },
    ]
}

fn probes() -> list[Probe] {
    return [
        Probe {
            name: "alignment",
            want: 0,
            desc: "the alignment and size rules a device states, as a testable pair",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    if !dma_alignment_ok(4) || !dma_alignment_ok(4096) { return 1 }\n" +
                  "    if dma_alignment_ok(3) || dma_alignment_ok(0) { return 2 }\n" +
                  "    if !dma_is_aligned(1048576, 4096) || dma_is_aligned(1048577, 4096) { return 3 }\n" +
                  "    if dma_size_ok(0, 1) || !dma_size_ok(4096, 512) { return 4 }\n" +
                  "    if dma_size_ok(4097, 512) { return 5 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "coherency",
            want: 0,
            desc: "the flush/invalidate rule each direction follows",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    if !dma_needs_flush(DmaDirection.ToDevice) { return 1 }\n" +
                  "    if dma_needs_invalidate(DmaDirection.ToDevice) { return 2 }\n" +
                  "    if dma_needs_flush(DmaDirection.FromDevice) { return 3 }\n" +
                  "    if !dma_needs_invalidate(DmaDirection.FromDevice) { return 4 }\n" +
                  "    if !dma_needs_both(DmaDirection.Both) { return 5 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "descriptor",
            want: 0,
            desc: "the descriptor, its address width, and page containment",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    if !dma_addr_ok(1099511627776, 64) { return 1 }\n" +
                  "    if dma_addr_ok(1099511627776, 32) { return 2 }\n" +
                  "    let d: DmaDesc = dma_desc_new(1048576, 4096, DmaDirection.ToDevice, 64, 4096)\n" +
                  "    if dma_desc_end(d) != 1052672 { return 3 }\n" +
                  "    if !dma_desc_covers(d, 1048576, 4096) { return 4 }\n" +
                  "    if dma_desc_covers(d, 1048576, 8192) { return 5 }\n" +
                  "    if !dma_desc_one_page(d, 12) || dma_desc_pages(d, 12) != 1 { return 6 }\n" +
                  "    let s: DmaDesc = dma_desc_new(1048576, 8192, DmaDirection.FromDevice, 64, 4096)\n" +
                  "    if dma_desc_one_page(s, 12) { return 7 }\n" +
                  "    if dma_desc_pages(s, 12) != 2 { return 8 }\n" +
                  "    if dma_page_shift(4096) != 12 { return 9 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "window",
            want: 0,
            desc: "the device-visible window and the map/unmap bookkeeping",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    let mut w: DmaWindow = dma_window_new(1048576, 4096, 0)\n" +
                  "    if !dma_window_has(w, 1048576) || dma_window_has(w, 1048576 + 4096) { return 1 }\n" +
                  "    if !dma_all_unmapped(w) { return 2 }\n" +
                  "    w = dma_map(w, 2048)\n" +
                  "    if dma_all_unmapped(w) { return 3 }\n" +
                  "    w = dma_map(w, 2048)\n" +
                  "    if w.mapped != 4096 { return 4 }\n" +
                  "    if dma_map_ok(w, 1) { return 5 }\n" +
                  "    w = dma_unmap(w, 4096)\n" +
                  "    if !dma_all_unmapped(w) { return 6 }\n" +
                  "    if dma_unmap(w, 4096).mapped != 0 { return 7 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "bounce",
            want: 0,
            desc: "the bounce buffer, its in-flight discipline, and its cost model",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    let b: BounceBuf = bounce_new(2097152, 65536, 256)\n" +
                  "    if !bounce_fits(b, 65536) || bounce_fits(b, 65537) { return 1 }\n" +
                  "    if bounce_fits(b, 0) { return 2 }\n" +
                  "    let busy: BounceBuf = bounce_begin(b, 1024)\n" +
                  "    if !busy.in_flight { return 3 }\n" +
                  "    if bounce_end(busy).in_flight { return 4 }\n" +
                  "    if bounce_cost_bytes(1024) != 2048 { return 5 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
    ]
}

fn props() -> list[PropP] {
    return [
        PropP {
            desc: "a descriptor names a PHYSICAL address",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    let low: DmaDesc = dma_desc_new(1048576, 4096, DmaDirection.ToDevice, 64, 4096)\n" +
                  "    if !dma_addr_ok(low.addr, 64) { return 1 }\n" +
                  "    # An address a 32-bit descriptor cannot hold, above 4 GiB.\n" +
                  "    let high: int = 5497558138880\n" +
                  "    if dma_addr_ok(high, 32) { return 2 }\n" +
                  "    if !dma_addr_ok(high, 64) { return 3 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        PropP {
            desc: "a short descriptor is detected, not discovered",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    let d: DmaDesc = dma_desc_new(1048576, 4096, DmaDirection.ToDevice, 64, 4096)\n" +
                  "    if dma_desc_covers(d, 1048576, 8192) { return 1 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        PropP {
            desc: "an address outside the window is refused",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    let w: DmaWindow = dma_window_new(1048576, 1048576, 0)\n" +
                  "    if dma_window_has(w, 8388608) { return 1 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        PropP {
            desc: "pages are freed only after the unmap",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    let mut w: DmaWindow = dma_window_new(1048576, 4096, 0)\n" +
                  "    w = dma_map(w, 4096)\n" +
                  "    if dma_all_unmapped(w) { return 1 }\n" +
                  "    w = dma_unmap(w, 4096)\n" +
                  "    if !dma_all_unmapped(w) { return 2 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        PropP {
            desc: "a second transfer cannot start on a busy bounce buffer",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    let b: BounceBuf = bounce_new(2097152, 4096, 256)\n" +
                  "    let busy: BounceBuf = bounce_begin(b, 1024)\n" +
                  "    if !busy.in_flight { return 1 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        PropP {
            desc: "a from-device transfer invalidates and a to-device one flushes",
            body: "import \"core.dma\"\n" +
                  "fn main() -> int {\n" +
                  "    if !dma_needs_invalidate(DmaDirection.FromDevice) { return 1 }\n" +
                  "    if dma_needs_invalidate(DmaDirection.ToDevice) { return 2 }\n" +
                  "    if !dma_needs_flush(DmaDirection.ToDevice) { return 3 }\n" +
                  "    if dma_needs_flush(DmaDirection.FromDevice) { return 4 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
    ]
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

# decl_word(src, kw, name) — the old battery's re.search(r"\bkw\s+name\b"):
# a word-boundary regex, not a plain contains() (a "fn dma_desc_end" line
# must not satisfy a "fn dma_desc" probe).
fn decl_word(src: str, kw: str, name: str) -> bool {
    let rr: Result[Regex, str] = regex_compile(kw + "\\s+" + name + "\\b")
    if result_is_err(rr) {
        return false
    }
    let re: Regex = result_unwrap(rr)
    return regex_is_match(re, src)
}

# import_paths(src) — the ordered list of `import "..."` paths.
fn import_paths(src: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i).trim()
        if line.starts_with("import ") {
            let rest: str = line.slice(7, line.len()).trim()
            if rest.starts_with("\"") {
                let tail: str = rest.slice(1, rest.len())
                let end: int = tail.find("\"")
                if end > 0 {
                    out.push(tail.slice(0, end))
                }
            }
        }
        i = i + 1
    }
    return out
}

# hlc_run(acc, src) — compile + link + run through the NATIVE compiler,
# hosted path (gcc -O2 -Werror). spawned=false carries the diagnostics
# when the compile or the link failed.
fn hlc_run(acc: Acc, src: str) -> RunResult uses Fs, Proc {
    let r: RunResult = RunResult {
        code: -1,
        out: "",
        err: "",
        combined: "",
        spawned: false
    }
    let c_path: str = scratch(acc, stem(src) + ".c")
    let exe: str = scratch(acc, stem(src) + ".bin")
    let comp: RunResult = run_capture(hlc_path(acc), [src, c_path])
    if comp.code != 0 {
        r.combined = comp.combined
        return r
    }
    let cc: RunResult = run_capture("gcc", ["-O2", "-Werror", "-o", exe, c_path, "-lm", "-pthread"])
    if cc.code != 0 {
        r.combined = cc.combined
        return r
    }
    let runr: RunResult = run_capture(exe, [])
    runr.spawned = true
    return runr
}

# hlc_run_fs(acc, src) — the `-nostdlib` twin: freestanding compile flags,
# gc-sections, no libc on the link line.
fn hlc_run_fs(acc: Acc, src: str) -> RunResult uses Fs, Proc {
    let r: RunResult = RunResult {
        code: -1,
        out: "",
        err: "",
        combined: "",
        spawned: false
    }
    let c_path: str = scratch(acc, stem(src) + ".fs.c")
    let exe: str = scratch(acc, stem(src) + ".fs")
    let comp: RunResult = run_capture(hlc_path(acc), [src, c_path])
    if comp.code != 0 {
        r.combined = comp.combined
        return r
    }
    let cc: RunResult = run_capture("gcc", ["-O2", "-ffreestanding", "-nostdlib",
        "-ffunction-sections", "-fno-stack-protector", "-Wl,--gc-sections", "-o", exe, c_path])
    if cc.code != 0 {
        r.combined = cc.combined
        return r
    }
    let runr: RunResult = run_capture(exe, [])
    runr.spawned = true
    return runr
}

# write_probe(acc, fname, body) — write a probe source into the scratch
# root (the old battery's write(name, text)).
fn write_probe(acc: Acc, fname: str, body: str) -> str uses Fs, Proc {
    return write_src(acc, fname, body)
}

# write_probe_fs(acc, fname, body) — the freestanding twin: the
# #![freestanding] crate attribute is prepended.
fn write_probe_fs(acc: Acc, fname: str, body: str) -> str uses Fs, Proc {
    return write_src(acc, fname, "#![freestanding]\n" + body)
}

# strip_no_std(text) — remove the first exact `#![no_std]` line (the old
# battery's re.sub(r"(?m)^#!\[no_std\]$", "", text, count=1)).
fn strip_no_std(text: str) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: str = ""
    let mut removed: bool = false
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if !removed && line == "#![no_std]" {
            removed = true
            i = i + 1
            continue
        }
        out = out + line + "\n"
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# 1. core/dma.hls
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs {
    section("1. core/dma.hls")
    if !file_exists(core_dma()) {
        fail_msg(acc, "dma: core/dma.hls missing")
        return
    }
    let src: str = read_file(core_dma())
    if decl_word(src, "enum", "DmaDirection") {
        pass_msg(acc, "dma: core.dma declares enum DmaDirection")
    } else {
        fail_msg(acc, "dma: core.dma missing enum DmaDirection")
    }
    let structs: list[str] = ["DmaDesc", "DmaWindow", "BounceBuf"]
    let mut si: int = 0
    while si < structs.len() {
        let s: str = structs.get(si)
        if decl_word(src, "struct", s) {
            pass_msg(acc, "dma: core.dma declares struct " + s)
        } else {
            fail_msg(acc, "dma: core.dma missing struct " + s)
        }
        si = si + 1
    }
    let imports: list[str] = import_paths(src)
    if imports.len() == 1 && imports.get(0) == "core.result" {
        pass_msg(acc, "dma: core.dma imports only core.result (freestanding-safe)")
    } else {
        fail_msg(acc, "dma: core.dma imports " + str_join(imports, ", "))
    }
    # No `uses` on any fn line, no `extern` declaration (comment lines
    # excluded, the old battery's decls filter).
    let lines: list[str] = src.split("\n")
    let mut has_effects: bool = false
    let mut has_extern: bool = false
    let mut li: int = 0
    while li < lines.len() {
        let line: str = lines.get(li)
        if line.trim().starts_with("#") {
            li = li + 1
            continue
        }
        if line.starts_with("fn ") && line.contains(" uses ") {
            has_effects = true
        }
        if line.trim().starts_with("extern") {
            has_extern = true
        }
        li = li + 1
    }
    if !has_effects && !has_extern {
        pass_msg(acc, "dma: core.dma declares no effects and no externs")
    } else {
        fail_msg(acc, "dma: core.dma declares effects or externs")
    }
    let fns: list[str] = core_fns()
    let mut fi: int = 0
    while fi < fns.len() {
        let f: str = fns.get(fi)
        if decl_word(src, "fn", f) {
            pass_msg(acc, "dma: core.dma exposes " + f)
        } else {
            fail_msg(acc, "dma: core.dma missing " + f)
        }
        fi = fi + 1
    }
}

# ----------------------------------------------------------------------------
# 2. the constructors are checked
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    section("2. the constructors are checked")
    let ps: list[PanicP] = panic_programs()
    let mut i: int = 0
    while i < ps.len() {
        let p: PanicP = ps.get(i)
        let path: str = write_probe(acc, "panic_" + i.to_str() + ".hls", p.body)
        let chk: RunResult = boot_check(acc, path)
        if chk.code != 0 {
            fail_msg(acc, "dma: " + p.desc + " must be ACCEPTED by the checker")
            i = i + 1
            continue
        }
        let r: RunResult = boot(acc, [path])
        if r.code == 101 && r.combined.contains(p.needle) {
            pass_msg(acc, "dma: " + p.desc + " panics at run time")
        } else {
            fail_msg(acc, "dma: " + p.desc + " did not panic: exit=" + r.code.to_str()
                + " " + clip(r.combined, 100))
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 3. the model
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. the model")
    let ps: list[Probe] = probes()
    let mut i: int = 0
    while i < ps.len() {
        let p: Probe = ps.get(i)
        let path: str = write_probe(acc, "probe_" + p.name + ".hls", p.body)
        let r: RunResult = boot(acc, [path])
        if r.code != p.want {
            fail_msg(acc, "dma: probe " + p.name + " (interp) exit=" + r.code.to_str()
                + " want=" + p.want.to_str() + " — " + clip(r.combined, 100))
            i = i + 1
            continue
        }
        let code: RunResult = hlc_run(acc, path)
        if !code.spawned || code.code != p.want {
            fail_msg(acc, "dma: probe " + p.name + " (native) exit=" + code.code.to_str()
                + " want=" + p.want.to_str() + " — " + clip(code.combined, 100))
            i = i + 1
            continue
        }
        let fs_path: str = write_probe_fs(acc, "probe_" + p.name + "_fs.hls", p.body)
        let fcode: RunResult = hlc_run_fs(acc, fs_path)
        if !fcode.spawned || fcode.code != p.want {
            fail_msg(acc, "dma: probe " + p.name + " (-nostdlib) exit=" + fcode.code.to_str()
                + " want=" + p.want.to_str() + " — " + clip(fcode.combined, 100))
            i = i + 1
            continue
        }
        pass_msg(acc, "dma: " + p.name + " — " + p.desc)
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 4. the ok-test
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("4. the ok-test")
    let r: RunResult = boot(acc, [ok_test()])
    if r.code == 0 {
        pass_msg(acc, "dma: the ok-test is clean on the interpreter")
    } else {
        fail_msg(acc, "dma: ok-test interpreter exit=" + r.code.to_str())
    }
    let code: RunResult = hlc_run(acc, ok_test())
    if code.spawned && code.code == 0 {
        pass_msg(acc, "dma: the ok-test is clean natively")
    } else {
        fail_msg(acc, "dma: ok-test native exit=" + code.code.to_str()
            + " (" + clip(code.combined, 120) + ")")
    }
    let text: str = strip_no_std(read_file(ok_test()))
    let fs_path: str = write_probe_fs(acc, "ok_fs.hls", text)
    let fcode: RunResult = hlc_run_fs(acc, fs_path)
    if fcode.spawned && fcode.code == 0 {
        pass_msg(acc, "dma: the ok-test links -nostdlib and exits 0 (freestanding)")
    } else {
        fail_msg(acc, "dma: the freestanding ok-test exit=" + fcode.code.to_str()
            + " (" + clip(fcode.combined, 120) + ")")
    }
}

# ----------------------------------------------------------------------------
# 5. the demo + tools
# ----------------------------------------------------------------------------
struct ToolLeg {
    label: str,
    argv: list[str]
}

fn sec5(acc: Acc) -> void uses IO, Proc {
    section("5. the demo + tools")
    let code: RunResult = hlc_run(acc, demo())
    if code.spawned && code.code == 0 {
        pass_msg(acc, "dma: examples/dma_demo.hls runs, exit 0")
    } else {
        fail_msg(acc, "dma: the demo exit=" + code.code.to_str()
            + " (" + clip(code.combined, 120) + ")")
    }
    let tools: list[ToolLeg] = [
        ToolLeg { label: "hlfmt -c (ok-test)", argv: ["tools/hlfmt.py", "-c", ok_test()] },
        ToolLeg { label: "hlfmt -c (demo)", argv: ["tools/hlfmt.py", "-c", demo()] },
        ToolLeg { label: "hlfmt -c (core)", argv: ["tools/hlfmt.py", "-c", core_dma()] },
        ToolLeg { label: "hllint (ok-test)", argv: ["tools/hllint.py", ok_test()] },
    ]
    let mut i: int = 0
    while i < tools.len() {
        let t: ToolLeg = tools.get(i)
        let r: RunResult = run_capture("python3", t.argv)
        if r.code == 0 {
            pass_msg(acc, "dma: " + t.label)
        } else {
            fail_msg(acc, "dma: " + t.label + ": " + clip(r.combined, 140))
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 6. the properties a driver relies on
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    section("6. the properties a driver relies on")
    let ps: list[PropP] = props()
    let mut i: int = 0
    while i < ps.len() {
        let p: PropP = ps.get(i)
        let path: str = write_probe(acc, "prop_" + (i + 1).to_str() + ".hls", p.body)
        let r: RunResult = boot(acc, [path])
        if r.code != 0 {
            fail_msg(acc, "dma: property '" + p.desc + "' not held")
            i = i + 1
            continue
        }
        let code: RunResult = hlc_run(acc, path)
        if !code.spawned || code.code != 0 {
            fail_msg(acc, "dma: property '" + p.desc + "' not held natively")
            i = i + 1
            continue
        }
        pass_msg(acc, "dma: " + p.desc)
        i = i + 1
    }
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("dma")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    return finish(acc, "Stage 89 -- core.dma: DMA-safe buffer types")
}
