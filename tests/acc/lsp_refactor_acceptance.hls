fn sibling_src() -> str {
    return "fn pick(kind: int) -> int uses IO {\n"
        + "    if kind == 1 {\n"
        + "        let label: str = \"one\"\n"
        + "        println(label)\n"
        + "    }\n"
        + "    if kind == 2 {\n"
        + "        let label: str = \"two\"\n"
        + "        println(label)\n"
        + "    }\n"
        + "    return kind\n"
        + "}\n"
}

fn two_fn_src() -> str {
    return "fn alpha(n: int) -> int {\n"
        + "    return n + 1\n"
        + "}\n"
        + "\n"
        + "fn beta(n: int) -> int {\n"
        + "    return n * 2\n"
        + "}\n"
        + "\n"
        + "fn main() -> int uses IO {\n"
        + "    println(alpha(1).to_str())\n"
        + "    println(beta(2).to_str())\n"
        + "    return 0\n"
        + "}\n"
}

