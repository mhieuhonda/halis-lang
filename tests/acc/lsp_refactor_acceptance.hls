# ============================================================================
# tests/acc/lsp_refactor_acceptance.hls — Stage 115 acceptance gate, in
# Halis (the native twin of the retired tests/lsp_refactor_acceptance.py;
# same eight sections, same laws, same needles — the harness is
# tests/acc/harness.hls and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make lsp-refactor-acceptance`.
#
#  1. the scope law    — a local renames exactly the occurrences its
#                        declaration binds; the top-level contract
#                        survives
#  2. the renames      — fields move through the dot, methods move with
#                        their impls, ambiguity is an error
#  3. the inlines      — one splice, one deletion, and the refusals
#  4. the extracts     — the probe decides the type; targets, arms and
#                        junk all refuse
#  5. the protocol     — capabilities, version, determinism,
#                        invalidation
#  6. the utf-16 line  — the rocket shifts bytes, not characters
#  7. the edits land   — every offered edit applied, re-checked, re-run
#  8. the corpus       — smoke green, boot pinned, fmt stable, lint
#                        clean, the round-trip re-checks
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.json"
import "std.result"
import "std.thread"

# ----------------------------------------------------------------------------
# The battery's check grammar (names verbatim, [OK]/[FAIL] flags).
# ----------------------------------------------------------------------------

fn chk(acc: Acc, name: str, okc: bool, detail: str) -> bool uses IO {
    return check(acc, name, okc, detail)
}

struct LspOut {
    results: list[JsonValue],
    rc: int,
    err: str,
    init: JsonValue
}

# frame(obj) — one request frame's JSON.
fn frame(obj: JsonValue) -> str {
    let body: str = json_stringify(obj)
    let crlf: str = chr(13) + chr(10)
    return "Content-Length: " + body.len().to_str() + crlf + crlf + body
}

fn req(method: str, id: int, params: JsonValue) -> JsonValue {
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
        sval: "", arr: [],
        obj_keys: ["id", "jsonrpc", "method", "params"],
        obj_vals: [json_int(id), json_str("2.0"), json_str(method), params] }
}

fn note(method: str, params: JsonValue) -> JsonValue {
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
        sval: "", arr: [],
        obj_keys: ["jsonrpc", "method", "params"],
        obj_vals: [json_str("2.0"), json_str(method), params] }
}

fn td_object(uri: str, version: int, text: str) -> JsonValue {
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
        sval: "", arr: [],
        obj_keys: ["text", "uri", "version"],
        obj_vals: [json_str(text), json_str(uri), json_int(version)] }
}

fn jstr(v: JsonValue, key: str) -> str {
    let x: JsonValue = json_object_get(v, key)
    if json_is_str(x) {
        return json_str_value(x)
    }
    return ""
}

fn jint(v: JsonValue, key: str) -> int {
    let x: JsonValue = json_object_get(v, key)
    if json_is_int(x) {
        return json_int_value(x)
    }
    return -1
}

fn jobj(v: JsonValue, key: str) -> JsonValue {
    let x: JsonValue = json_object_get(v, key)
    if json_is_object(x) {
        return x
    }
    return json_null()
}

fn jbool(v: JsonValue, key: str) -> bool {
    let x: JsonValue = json_object_get(v, key)
    if json_is_bool(x) {
        return json_bool_value(x)
    }
    return false
}

fn jarray(v: JsonValue, key: str) -> list[JsonValue] {
    let x: JsonValue = json_object_get(v, key)
    if json_is_array(x) {
        return x.arr
    }
    let empty: list[JsonValue] = []
    return empty
}

fn is_null(v: JsonValue) -> bool {
    return json_is_null(v)
}

fn parse_uint(s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
        } else {
            break
        }
        i = i + 1
    }
    return v
}

# crlfcrlf() — the frame separator, four real bytes.
fn crlfcrlf() -> str {
    let c: str = chr(13) + chr(10)
    return c + c
}

# parse_frames(buf) — the server's frames back into parsed JSON values.
fn parse_frames(buf: str) -> list[JsonValue] {
    let msgs: list[JsonValue] = []
    let mut rest: str = buf
    let mut guard: int = 0
    while rest.contains("Content-Length:") && guard < 1000 {
        guard = guard + 1
        let i: int = index_of_str(rest, "Content-Length:")
        let j: int = index_of_str(rest.slice(i, rest.len()), crlfcrlf())
        if j < 0 {
            break
        }
        let hdr: str = rest.slice(i + 15, i + j)
        let n: int = parse_uint(hdr.trim())
        if j + 4 + n > rest.len() {
            break
        }
        msgs.push(parse_json_or_null(rest.slice(j + 4, j + 4 + n)))
        rest = rest.slice(j + 4 + n, rest.len())
    }
    return msgs
}

fn parse_json_or_null(text: str) -> JsonValue {
    let r: Result[JsonValue, str] = json_parse_result(text)
    if result_is_ok(r) {
        return result_unwrap(r)
    }
    return json_null()
}

fn index_of_str(hay: str, needle: str) -> int {
    let mut i: int = 0
    while i + needle.len() <= hay.len() {
        if hay.slice(i, i + needle.len()) == needle {
            return i
        }
        i = i + 1
    }
    return -1
}

# ----------------------------------------------------------------------------
# The session — one server run over stdio, the way an editor drives it.
# Requests target open 0; pre-change k is flushed before request k.
# ----------------------------------------------------------------------------

struct PreChange {
    req_idx: int,
    open_idx: int,
    text: str
}

fn session(acc: Acc, ws_name: str, opens_rels: list[str],
opens_text: list[str], req_methods: list[str],
req_params: list[JsonValue], pre_changes: list[PreChange]) -> LspOut
uses Fs, Proc {
    let base: str = scratch(acc, ws_name)
    let uris: list[str] = []
    let mut i: int = 0
    while i < opens_rels.len() {
        uris.push("file://" + path_join3(base, opens_rels.get(i)))
        i = i + 1
    }
    let payload: list[str] = []
    payload.push(frame(req("initialize", 1, json_null())))
    i = 0
    while i < opens_rels.len() {
        payload.push(frame(note("textDocument/didOpen",
            JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
                sval: "", arr: [], obj_keys: ["textDocument"],
                obj_vals: [td_object(uris.get(i), 1,
                opens_text.get(i))] })))
        i = i + 1
    }
    i = 0
    while i < req_methods.len() {
        let mut pi: int = 0
        while pi < pre_changes.len() {
            if pre_changes.get(pi).req_idx == i {
                let pc: PreChange = pre_changes.get(pi)
                payload.push(frame(note("textDocument/didChange",
                    JsonValue { kind: "object", bval: false, ival: 0,
                        fval: 0.0, sval: "", arr: [],
                        obj_keys: ["contentChanges", "textDocument"],
                        obj_vals: [
                        JsonValue { kind: "array", bval: false, ival: 0,
                            fval: 0.0, sval: "",
                            arr: [td_object("", 0, pc.text)],
                            obj_keys: [], obj_vals: [] },
                        td_object(uris.get(pc.open_idx), 2, "")] })))
            }
            pi = pi + 1
        }
        let p: JsonValue = req_params.get(i)
        let with_td: JsonValue = JsonValue { kind: "object", bval: false,
            ival: 0, fval: 0.0, sval: "", arr: [],
            obj_keys: ["textDocument"],
            obj_vals: [td_object(uris.get(0), 0, "")] }
        payload.push(frame(req(req_methods.get(i), 100 + i,
        merge_objects(with_td, p))))
        i = i + 1
    }
    payload.push(frame(req("shutdown", 2, json_null())))
    payload.push(frame(note("exit", json_null())))

    let r: RunResult = run_feed("./bin/hls-lsp", [], str_join(payload, ""))
    let out: LspOut = LspOut { results: [], rc: r.code, err: r.err,
                               init: json_null() }
    let frames: list[JsonValue] = parse_frames(r.out)
    let mut k: int = 0
    while k < req_methods.len() {
        out.results.push(json_null())
        k = k + 1
    }
    k = 0
    while k < frames.len() {
        let m: JsonValue = frames.get(k)
        let id: int = jint(m, "id")
        if id == 1 {
            out.init = json_object_get(m, "result")
        }
        if id >= 100 && id - 100 < out.results.len() {
            out.results.set(id - 100, json_object_get(m, "result"))
        }
        k = k + 1
    }
    return out
}

fn no_pre() -> list[PreChange] {
    return []
}

# merge_objects(a, b) — a's keys, then b's keys overriding.
fn merge_objects(a: JsonValue, b: JsonValue) -> JsonValue {
    if !json_is_object(b) {
        return a
    }
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    let mut i: int = 0
    while i < a.obj_keys.len() {
        keys.push(a.obj_keys.get(i))
        vals.push(a.obj_vals.get(i))
        i = i + 1
    }
    i = 0
    while i < b.obj_keys.len() {
        let k: str = b.obj_keys.get(i)
        let mut found: bool = false
        let mut j: int = 0
        while j < keys.len() {
            if keys.get(j) == k {
                vals.set(j, b.obj_vals.get(i))
                found = true
            }
            j = j + 1
        }
        if !found {
            keys.push(k)
            vals.push(b.obj_vals.get(i))
        }
        i = i + 1
    }
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
                       sval: "", arr: [], obj_keys: keys, obj_vals: vals }
}

# ----------------------------------------------------------------------------
# Edit application (client side): LSP ranges are UTF-16.
# ----------------------------------------------------------------------------

# utf16_to_idx(line, units) — UTF-16 unit offset -> byte index in line.
fn utf16_to_idx(line: str, units: int) -> int {
    let mut n: int = 0
    let mut i: int = 0
    while i < line.len() && n < units {
        let c: int = line.byte_at(i)
        if c >= 240 {
            n = n + 2
            i = i + 4
        } else if c >= 224 {
            n = n + 1
            i = i + 3
        } else if c >= 192 {
            n = n + 1
            i = i + 2
        } else {
            n = n + 1
            i = i + 1
        }
    }
    return i
}

# line_starts(text) — byte offset of every line's first byte.
fn line_starts(text: str) -> list[int] {
    let offs: list[int] = [0]
    let mut i: int = 0
    while i < text.len() {
        if text.byte_at(i) == 10 {
            offs.push(i + 1)
        }
        i = i + 1
    }
    return offs
}

# line_of(text, offs, off) — the 0-based line of a byte offset.
fn line_of_off(offs: list[int], off: int) -> int {
    let mut lo: int = 0
    let mut hi: int = offs.len() - 1
    while lo < hi {
        let mid: int = (lo + hi + 1) / 2
        if offs.get(mid) <= off {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    return lo
}

# line_text_of(text, offs, line0) — the line's bytes, newline excluded.
fn line_text_of(text: str, offs: list[int], line0: int) -> str {
    let a: int = offs.get(line0)
    let mut b: int = text.len()
    if line0 + 1 < offs.len() {
        b = offs.get(line0 + 1) - 1
    }
    if b > a {
        return text.slice(a, b)
    }
    return ""
}

# pos_to_off(text, offs, pos) — an LSP position to a byte offset.
fn pos_to_off(text: str, offs: list[int], pos: JsonValue) -> int {
    let l0: int = jint(pos, "line")
    let c16: int = jint(pos, "character")
    let line: str = line_text_of(text, offs, l0)
    let col: int = utf16_to_idx(line, c16)
    return offs.get(l0) + col
}

# apply_lsp_edits(text, edits) — apply bottom-up, positions UTF-16.
fn apply_lsp_edits(text: str, edits: list[JsonValue]) -> str {
    let offs: list[int] = line_starts(text)
    # sort the edits by start offset DESCENDING (an insertion sort over
    # a copy — the caller's list keeps its order)
    let sorted: list[JsonValue] = []
    let mut i: int = 0
    while i < edits.len() {
        sorted.push(edits.get(i))
        i = i + 1
    }
    i = 1
    while i < sorted.len() {
        let it: JsonValue = sorted.get(i)
        let it_off: int = pos_to_off(text, offs,
        jobj(jobj(it, "range"), "start"))
        let mut j: int = i - 1
        let mut pos_i: int = i
        while j >= 0 {
            let prev: JsonValue = sorted.get(j)
            let prev_off: int = pos_to_off(text, offs,
            jobj(jobj(prev, "range"), "start"))
            if prev_off < it_off {
                sorted.set(j + 1, prev)
                pos_i = j
                j = j - 1
            } else {
                break
            }
        }
        sorted.set(pos_i, it)
        i = i + 1
    }
    let mut out: str = text
    i = 0
    while i < sorted.len() {
        let e: JsonValue = sorted.get(i)
        let a: int = pos_to_off(out, line_starts(out),
        jobj(jobj(e, "range"), "start"))
        let b: int = pos_to_off(out, line_starts(out),
        jobj(jobj(e, "range"), "end"))
        out = out.slice(0, a) + jstr(e, "newText") + out.slice(b, out.len())
        i = i + 1
    }
    return out
}

# edits_of(result) — flatten a WorkspaceEdit into one edit list (the
# rename shape {changes} and the CodeAction shape {edit:{changes}}).
fn edits_of(result: JsonValue) -> list[JsonValue] {
    if json_is_null(result) {
        let empty: list[JsonValue] = []
        return empty
    }
    let mut changes: JsonValue = jobj(result, "changes")
    if json_is_null(changes) {
        let inner: JsonValue = jobj(result, "edit")
        if !json_is_null(inner) {
            changes = jobj(inner, "changes")
        }
    }
    if !json_is_object(changes) {
        let empty2: list[JsonValue] = []
        return empty2
    }
    let mut ci: int = 0
    while ci < changes.obj_keys.len() {
        let v: JsonValue = changes.obj_vals.get(ci)
        if json_is_array(v) {
            return v.arr
        }
        ci = ci + 1
    }
    let empty3: list[JsonValue] = []
    return empty3
}

# action_of_kind(result, kind) — the CodeAction of that kind, or null.
fn action_of_kind(result: JsonValue, kind: str) -> JsonValue {
    if json_is_null(result) {
        return json_null()
    }
    if json_is_array(result) {
        let mut i: int = 0
        while i < result.arr.len() {
            let a: JsonValue = result.arr.get(i)
            if jstr(a, "kind") == kind {
                return a
            }
            i = i + 1
        }
    }
    return json_null()
}

fn line_of(text: str, needle: str) -> int {
    let offs: list[int] = line_starts(text)
    let mut i: int = 0
    while i < offs.len() {
        if line_text_of(text, offs, i).contains(needle) {
            return i
        }
        i = i + 1
    }
    return -1
}

# col_of(text, line0, needle) — the UTF-16 column of needle in a line.
fn col_of(text: str, line0: int, needle: str) -> int {
    let offs: list[int] = line_starts(text)
    let line: str = line_text_of(text, offs, line0)
    let byte_col: int = index_of_str(line, needle)
    if byte_col < 0 {
        return -1
    }
    let prefix: str = line.slice(0, byte_col)
    return utf16_len(prefix)
}

# utf16_len(s) — the LSP character units of a string.
fn utf16_len(s: str) -> int {
    let mut n: int = 0
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c >= 240 {
            n = n + 2
            i = i + 4
        } else if c >= 224 {
            n = n + 1
            i = i + 3
        } else if c >= 192 {
            n = n + 1
            i = i + 2
        } else {
            n = n + 1
            i = i + 1
        }
    }
    return n
}

# range_json(sl, sc, el, ec) — a request range.
fn range_json(sl: int, sc: int, el: int, ec: int) -> JsonValue {
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
        sval: "", arr: [],
        obj_keys: ["start", "end"],
        obj_vals: [
            JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
                sval: "", arr: [],
                obj_keys: ["line", "character"],
                obj_vals: [json_int(sl), json_int(sc)] },
            JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
                sval: "", arr: [],
                obj_keys: ["line", "character"],
                obj_vals: [json_int(el), json_int(ec)] }] }
}

# rename_params(line0, char16, new_name) — a rename request's params.
fn rename_params(line0: int, char16: int, new_name: str) -> JsonValue {
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
        sval: "", arr: [],
        obj_keys: ["position", "newName"],
        obj_vals: [
            JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
                sval: "", arr: [],
                obj_keys: ["line", "character"],
                obj_vals: [json_int(line0), json_int(char16)] },
            json_str(new_name)] }
}

# action_params(rng) — a codeAction request's params.
fn action_params(rng: JsonValue) -> JsonValue {
    return JsonValue { kind: "object", bval: false, ival: 0, fval: 0.0,
        sval: "", arr: [], obj_keys: ["range"], obj_vals: [rng] }
}

# one_open(s) / one_req helpers — the small list constructors.
fn one_open(s: str) -> list[str] {
    return [s]
}

fn one_text(s: str) -> list[str] {
    return [s]
}

fn one_method(s: str) -> list[str] {
    return [s]
}

fn one_param(p: JsonValue) -> list[JsonValue] {
    return [p]
}

