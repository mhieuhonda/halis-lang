# ============================================================================
# tests/acc/irqsafe_acceptance.hls — Stage 91 acceptance gate, in Halis
# (the Halis twin of what was tests/irqsafe_acceptance.py; same seven
# sections, same assertions, same needles — the harness is
# tests/acc/harness.hls and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make irqsafe-acceptance` (which compiles this file to
# bin/acc-irqsafe and runs it from the repo root).
#
#  1. the proof rejects        — every fail program is refused by BOTH
#                                compilers with the SAME words (modulo
#                                the known prefix), and each names its
#                                own construct
#  2. the witness chain        — the transitive shape: handler -> helper
#                                -> offender, the shortest path, and a
#                                deterministic answer across front-ends
#  3. the audit lines          — `boot.py --audit` and `hlc --audit` both
#                                publish the per-handler proof lines
#  4. the ok-test              — feat_stage91_irqsafe on the interpreter,
#                                natively, and linked -nostdlib (the
#                                freestanding image of the same source)
#  5. the classification       — synthesized probes: every may-allocate
#                                construct rejected in a handler; every
#                                borrow-shaped scalar operation accepted
#  6. the demo                 — irqsafe_demo identical on the
#                                interpreter and natively (-Werror), the
#                                proof lines in its --audit
#  7. the tools                — hlfmt stable, hllint clean on the new
#                                sources
# ============================================================================

import "./harness.hls"
import "std.str"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

struct FailP {
    stem: str,
    needle: str,
    why: str
}

struct AllocP {
    stem: str,
    needle: str,
    prog: str
}

fn ok_test() -> str {
    return "tests/ok/feat_stage91_irqsafe.hls"
}

fn demo() -> str {
    return "examples/irqsafe_demo.hls"
}

fn fail_programs() -> list[FailP] {
    return [
        FailP { stem: "fail_stage91_irq_alloc_list", needle: "builds a list",
                why: "a list literal in the handler itself" },
        FailP { stem: "fail_stage91_irq_alloc_transitive", needle: "concatenates strings",
                why: "a helper that concatenates strings" },
        FailP { stem: "fail_stage91_irq_alloc_builtin", needle: "calls the builtin 'read_file'",
                why: "a helper that reads a file" },
        FailP { stem: "fail_stage91_irq_alloc_clone", needle: "clones a heap value",
                why: "a clone() in the handler" },
        FailP { stem: "fail_stage91_irq_alloc_extern", needle: "a C call this proof cannot see into",
                why: "an extern call (opaque to the proof)" },
        FailP { stem: "fail_stage91_irq_alloc_mapnew", needle: "calls the builtin 'map_new'",
                why: "a map construction in the handler" },
        FailP { stem: "fail_stage91_irq_alloc_default", needle: "the field default of struct 'Log'",
                why: "a struct field default that builds a list" },
        FailP { stem: "fail_stage91_irq_tostr", needle: "converts a value to its text form",
                why: "str(int) in the handler" },
    ]
}

# The may-allocate constructs — each must be rejected in a handler. The
# `push` variant's queue arrives THROUGH the frame (a list is
# pointer-typed, exactly like the Stage 86 frame shapes) so 'push' is
# the handler's only construct — a list literal would win the
# first-site rule and the witness would name the wrong thing.
fn may_alloc() -> list[AllocP] {
    return [
        AllocP {
            stem: "listlit", needle: "builds a list",
            prog: "struct Frame { p: int }\n" +
                  "\n" +
                  "#[irq_handler(90)]\n" +
                  "fn probe_isr(frame: Frame) -> void {\n" +
                  "    let xs: list[int] = [1]\n" +
                  "    return\n" +
                  "}\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    return 0\n" +
                  "}\n"
        },
        AllocP {
            stem: "mapnew", needle: "calls the builtin 'map_new'",
            prog: "struct Frame { p: int }\n" +
                  "\n" +
                  "#[irq_handler(90)]\n" +
                  "fn probe_isr(frame: Frame) -> void {\n" +
                  "    let m: map[str, int] = map_new()\n" +
                  "    return\n" +
                  "}\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    return 0\n" +
                  "}\n"
        },
        AllocP {
            stem: "concat", needle: "concatenates strings",
            prog: "struct Frame { p: int }\n" +
                  "\n" +
                  "#[irq_handler(90)]\n" +
                  "fn probe_isr(frame: Frame) -> void {\n" +
                  "    let s: str = \"a\" + \"b\"\n" +
                  "    return\n" +
                  "}\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    return 0\n" +
                  "}\n"
        },
        AllocP {
            stem: "tostr", needle: "converts a value to its text form",
            prog: "struct Frame { p: int }\n" +
                  "\n" +
                  "#[irq_handler(90)]\n" +
                  "fn probe_isr(frame: Frame) -> void {\n" +
                  "    let s: str = str(frame.p)\n" +
                  "    return\n" +
                  "}\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    return 0\n" +
                  "}\n"
        },
        AllocP {
            stem: "inttostr", needle: "converts a value to its text form",
            prog: "struct Frame { p: int }\n" +
                  "\n" +
                  "#[irq_handler(90)]\n" +
                  "fn probe_isr(frame: Frame) -> void {\n" +
                  "    let s: str = frame.p.to_str()\n" +
                  "    return\n" +
                  "}\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    return 0\n" +
                  "}\n"
        },
        AllocP {
            stem: "clone", needle: "clones a heap value",
            prog: "struct Frame { p: int }\n" +
                  "\n" +
                  "#[irq_handler(90)]\n" +
                  "fn probe_isr(frame: Frame) -> void {\n" +
                  "    let name: str = clone(\"q\")\n" +
                  "    return\n" +
                  "}\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    return 0\n" +
                  "}\n"
        },
        AllocP {
            stem: "push", needle: "calls 'list.push'",
            prog: "#[irq_handler(90)]\n" +
                  "fn probe_isr(q: list[int]) -> void {\n" +
                  "    q.push(2)\n" +
                  "    return\n" +
                  "}\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    return 0\n" +
                  "}\n"
        },
        AllocP {
            stem: "slice", needle: "calls 'str.slice'",
            prog: "struct Frame { p: int }\n" +
                  "\n" +
                  "#[irq_handler(90)]\n" +
                  "fn probe_isr(frame: Frame) -> void {\n" +
                  "    let s: str = \"abc\".slice(0, 1)\n" +
                  "    return\n" +
                  "}\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    return 0\n" +
                  "}\n"
        },
        AllocP {
            stem: "range", needle: "calls the builtin 'range'",
            prog: "struct Frame { p: int }\n" +
                  "\n" +
                  "#[irq_handler(90)]\n" +
                  "fn probe_isr(frame: Frame) -> void {\n" +
                  "    let xs: list[int] = range(0, 4)\n" +
                  "    return\n" +
                  "}\n" +
                  "\n" +
                  "fn main() -> int {\n" +
                  "    return 0\n" +
                  "}\n"
        },
    ]
}

fn witness_hls() -> str {
    return "struct Frame { p: int }\n" +
           "\n" +
           "#[irq_handler(63)]\n" +
           "fn deep_isr(frame: Frame) -> void {\n" +
           "    middle(frame.p)\n" +
           "    return\n" +
           "}\n" +
           "\n" +
           "fn middle(n: int) -> int {\n" +
           "    return builder(n)\n" +
           "}\n" +
           "\n" +
           "fn builder(n: int) -> int {\n" +
           "    let s: str = \"x\" + \"y\"\n" +
           "    return n\n" +
           "}\n" +
           "\n" +
           "fn main() -> int {\n" +
           "    return 0\n" +
           "}\n"
}

fn short_hls() -> str {
    return "struct Frame { p: int }\n" +
           "\n" +
           "#[irq_handler(64)]\n" +
           "fn short_isr(frame: Frame) -> void {\n" +
           "    let s: str = \"a\" + \"b\"\n" +
           "    return\n" +
           "}\n" +
           "\n" +
           "fn main() -> int {\n" +
           "    return 0\n" +
           "}\n"
}

# The borrow-shaped world — everything here is accepted, because a
# handler that only reads, indexes, compares and counts is legal.
fn safe_probe_hls() -> str {
    return "struct Frame { p: int }\n" +
           "\n" +
           "fn clamp(n: int, lo: int, hi: int) -> int {\n" +
           "    if n < lo {\n" +
           "        return lo\n" +
           "    }\n" +
           "    if n > hi {\n" +
           "        return hi\n" +
           "    }\n" +
           "    return n\n" +
           "}\n" +
           "\n" +
           "#[irq_handler(91)]\n" +
           "fn safe_isr(frame: Frame) -> void {\n" +
           "    let n: int = clamp(frame.p, 0, 100)\n" +
           "    let mut i: int = 0\n" +
           "    while i < n {\n" +
           "        i = i + 2\n" +
           "    }\n" +
           "    if \"abc\".contains(\"b\") != true {\n" +
           "        return\n" +
           "    }\n" +
           "    let code: int = \"42\".to_int()\n" +
           "    if code != 42 {\n" +
           "        return\n" +
           "    }\n" +
           "    return\n" +
           "}\n" +
           "\n" +
           "fn main() -> int {\n" +
           "    return 0\n" +
           "}\n"
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

# find_last(s, sub) — the last occurrence of sub in s, -1 when absent.
fn find_last(s: str, sub: str) -> int {
    let mut i: int = s.len() - sub.len()
    while i >= 0 {
        if s.slice(i, i + sub.len()) == sub {
            return i
        }
        i = i - 1
    }
    return -1
}

# normalise(text) — strip the front-end-specific prefix and the line
# suffix so the two compilers' diagnostics compare byte for byte (the
# old battery's three re.sub passes, as byte logic).
fn normalise(text: str) -> str {
    let mut t: str = text.trim()
    # "^panic: "
    if t.starts_with("panic: ") {
        t = t.slice(7, t.len())
    }
    # "^[a-z ]*error: " — an optional front-end name, then the error.
    let e: int = t.find("error: ")
    if e >= 0 {
        let mut all_az: bool = true
        let mut i: int = 0
        while i < e {
            let c: int = t.byte_at(i)
            if !((c >= 97 && c <= 122) || c == 32) {
                all_az = false
                break
            }
            i = i + 1
        }
        if all_az {
            t = t.slice(e + 7, t.len())
        }
    }
    # " \(line N[:M]\)$" — the trailing position suffix.
    let l: int = find_last(t, " (line ")
    if l >= 0 {
        let mut j: int = l + 7
        let mut shape_ok: bool = true
        let mut digits: int = 0
        while j < t.len() && t.byte_at(j) >= 48 && t.byte_at(j) <= 57 {
            j = j + 1
            digits = digits + 1
        }
        if digits == 0 {
            shape_ok = false
        }
        if shape_ok && j < t.len() && t.byte_at(j) == 58 {
            j = j + 1
            let mut d2: int = 0
            while j < t.len() && t.byte_at(j) >= 48 && t.byte_at(j) <= 57 {
                j = j + 1
                d2 = d2 + 1
            }
            if d2 == 0 {
                shape_ok = false
            }
        }
        if shape_ok && j < t.len() && t.byte_at(j) == 41 {
            j = j + 1
            if j == t.len() {
                t = t.slice(0, l)
            }
        }
    }
    return t
}

# rewrite_no_std(text) — the first exact `#![no_std]` LINE becomes
# `#![freestanding]` (anchored to the whole line: the header COMMENT
# also contains the token, and a naive first-occurrence replace
# rewrites the comment, leaves the real attribute alone, and the
# -nostdlib link then segfaults on a hosted image). Returns "" when no
# line matched.
fn rewrite_no_std(text: str) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: str = ""
    let mut done: bool = false
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if !done && line == "#![no_std]" {
            out = out + "#![freestanding]" + "\n"
            done = true
        } else {
            out = out + line + "\n"
        }
        i = i + 1
    }
    if !done {
        return ""
    }
    return out
}

# first_diag(text) — the first line of a diagnostic, normalised.
fn first_diag(text: str) -> str {
    return normalise(first_line(text))
}

# native_run(acc, src) — hlc + gcc -Werror + run; the RunResult's
# spawned is false when the compile or the link failed (combined then
# carries the diagnostics).
fn native_run(acc: Acc, src: str) -> RunResult uses Fs, Proc {
    let r: RunResult = RunResult {
        code: -1, out: "", err: "", combined: "", spawned: false
    }
    let c_path: str = scratch(acc, stem(src) + ".c")
    let exe: str = scratch(acc, stem(src) + ".bin")
    let comp: RunResult = run_capture(hlc_path(acc), [src, c_path])
    if comp.code != 0 {
        r.combined = "hlc failed: " + comp.combined
        return r
    }
    let cc: RunResult = run_capture("gcc", ["-O2", "-Werror", "-o", exe, c_path, "-lm", "-pthread"])
    if cc.code != 0 {
        r.combined = "gcc failed: " + cc.combined
        return r
    }
    let runr: RunResult = run_capture(exe, [])
    runr.spawned = true
    return runr
}

# ----------------------------------------------------------------------------
# 1. the proof rejects: the fail programs, both front-ends
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Proc {
    section("1. the proof rejects: the fail programs, both front-ends")
    let fps: list[FailP] = fail_programs()
    let mut i: int = 0
    while i < fps.len() {
        let fp: FailP = fps.get(i)
        let src: str = "tests/fail/" + fp.stem + ".hls"
        let b: RunResult = boot_check(acc, src)
        let h: RunResult = run_capture(hlc_path(acc), ["--audit", src])
        if b.code == 0 {
            fail_msg(acc, fp.stem + ": boot accepted a handler that may allocate (" + fp.why + ")")
            i = i + 1
            continue
        }
        if h.code == 0 {
            fail_msg(acc, fp.stem + ": hlc accepted a handler that may allocate (" + fp.why + ")")
            i = i + 1
            continue
        }
        let bmsg: str = first_diag(b.combined)
        let hmsg: str = first_diag(h.combined)
        if bmsg != hmsg {
            fail_msg(acc, fp.stem + ": boot and hlc disagree on the words: boot: "
                + bmsg + " | hlc: " + hmsg)
            i = i + 1
            continue
        }
        if !bmsg.contains(fp.needle) {
            fail_msg(acc, fp.stem + ": diagnostic does not name the construct ('"
                + fp.needle + "'): " + bmsg)
            i = i + 1
            continue
        }
        pass_msg(acc, fp.stem + " rejected identically by both front-ends (" + fp.why + ")")
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 2. the witness chain: transitive, shortest, deterministic
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    section("2. the witness chain: transitive, shortest, deterministic")
    let wpath: str = write_src(acc, "witness.hls", witness_hls())
    let b: RunResult = boot_check(acc, wpath)
    let h: RunResult = run_capture(hlc_path(acc), ["--audit", wpath])
    if b.code != 1 || h.code == 0 {
        fail_msg(acc, "witness: the three-deep chain was not rejected (boot rc="
            + b.code.to_str() + ", hlc rc=" + h.code.to_str() + ")")
    } else {
        let bmsg: str = first_diag(b.combined)
        let hmsg: str = first_diag(h.combined)
        if bmsg != hmsg {
            fail_msg(acc, "witness: front-ends disagree: " + bmsg + " vs " + hmsg)
        } else if !bmsg.contains("deep_isr -> middle -> builder") {
            fail_msg(acc, "witness: the chain is not the full path: " + bmsg)
        } else if !bmsg.contains("concatenates strings") {
            fail_msg(acc, "witness: the offending node is not named: " + bmsg)
        } else {
            pass_msg(acc, "witness: the full transitive chain is named identically by both")
        }
    }

    # The SHORTEST path wins: with two routes to the same offender, the
    # diagnostic names the direct one.
    let spath: str = write_src(acc, "short.hls", short_hls())
    let sb: RunResult = boot_check(acc, spath)
    let sh: RunResult = run_capture(hlc_path(acc), ["--audit", spath])
    if sb.code != 1 {
        fail_msg(acc, "short: the direct site was not rejected")
    } else if !first_diag(sb.combined).contains("short_isr — 'short_isr' concatenates strings") {
        fail_msg(acc, "short: the direct site is not reported as the handler itself: "
            + clip(sb.combined, 120))
    } else if first_diag(sb.combined) != first_diag(sh.combined) {
        fail_msg(acc, "short: front-ends disagree")
    } else {
        pass_msg(acc, "short: a direct site is reported as the handler itself, both front-ends")
    }
}

# ----------------------------------------------------------------------------
# 3. the audit lines
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Proc {
    section("3. the audit lines")
    let b: RunResult = boot(acc, ["--audit", demo()])
    let h: RunResult = run_capture(hlc_path(acc), ["--audit", demo()])
    if b.code != 0 || h.code != 0 {
        fail_msg(acc, "audit: --audit failed (boot rc=" + b.code.to_str()
            + ", hlc rc=" + h.code.to_str() + ")")
        return
    }
    if !b.out.contains("Interrupt safety (Stage 91)") {
        fail_msg(acc, "audit: boot --audit does not publish the proof header")
        return
    }
    if !b.out.contains("IRQ vector 32: 'pit_isr' — allocation-free") {
        fail_msg(acc, "audit: boot --audit misses the pit_isr proof line")
        return
    }
    if !b.out.contains("IRQ vector 44: 'disk_isr' — allocation-free") {
        fail_msg(acc, "audit: boot --audit misses the disk_isr proof line")
        return
    }
    if !h.out.contains("Interrupt safety (Stage 91)") {
        fail_msg(acc, "audit: hlc --audit does not publish the proof header")
        return
    }
    if !h.out.contains("IRQ vector 32: 'pit_isr' — allocation-free") {
        fail_msg(acc, "audit: hlc --audit misses the pit_isr proof line")
        return
    }
    let b_lines: str = grep_lines(b.out, "allocation-free")
    let h_lines: str = grep_lines(h.out, "allocation-free")
    if b_lines != h_lines {
        fail_msg(acc, "audit: the two front-ends publish different proof lines")
    } else {
        pass_msg(acc, "audit: both front-ends publish the same per-handler proof lines")
    }
}

# grep_lines(text, needle) — the lines containing the needle, joined by
# "\n" (list equality as text equality).
fn grep_lines(text: str, needle: str) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: str = ""
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i).contains(needle) {
            out = out + lines.get(i) + "\n"
        }
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# 4. the ok-test on all three paths
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("4. the ok-test on all three paths")
    let interp: RunResult = boot(acc, [ok_test()])
    if interp.code == 0 {
        pass_msg(acc, "irqsafe: feat_stage91_irqsafe runs on the interpreter (exit 0)")
    } else {
        fail_msg(acc, "irqsafe: feat_stage91_irqsafe interpreter rc=" + interp.code.to_str()
            + ": " + clip(interp.combined, 200))
    }

    let nat: RunResult = native_run(acc, ok_test())
    if nat.spawned && nat.code == 0 {
        pass_msg(acc, "irqsafe: feat_stage91_irqsafe compiles -Werror and runs natively (exit 0)")
    } else {
        fail_msg(acc, "irqsafe: feat_stage91_irqsafe native rc=" + nat.code.to_str()
            + ": " + clip(nat.combined, 200))
    }

    # The freestanding image of the same source.
    let fs_text: str = rewrite_no_std(read_file(ok_test()))
    if fs_text == "" {
        fail_msg(acc, "irqsafe: the ok-test has no #![no_std] line to rewrite")
        return
    }
    let fs_src: str = write_src(acc, "irqsafe_fs.hls", fs_text)
    let fs_c: str = scratch(acc, "irqsafe_fs.c")
    let r: RunResult = run_capture(hlc_path(acc), [fs_src, fs_c])
    if r.code != 0 {
        fail_msg(acc, "irqsafe: freestanding emission failed: " + clip(r.combined, 200))
        return
    }
    if !read_or(fs_c, "").contains("HL_FREESTANDING") {
        fail_msg(acc, "irqsafe: the freestanding rewrite produced a hosted TU")
        return
    }
    let exe: str = scratch(acc, "irqsafe_fs")
    let g: RunResult = run_capture("gcc", ["-O2", "-ffreestanding", "-nostdlib",
        "-ffunction-sections", "-fno-stack-protector", "-Wl,--gc-sections", "-o", exe, fs_c])
    if g.code != 0 {
        fail_msg(acc, "irqsafe: freestanding link failed: " + clip(g.combined, 300))
        return
    }
    let rr: RunResult = run_capture(exe, [])
    if rr.code == 0 {
        pass_msg(acc, "irqsafe: the same source links -nostdlib and exits 0")
    } else {
        fail_msg(acc, "irqsafe: freestanding binary rc=" + rr.code.to_str())
    }
}

# ----------------------------------------------------------------------------
# 5. the classification: probes on both sides
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("5. the classification: probes on both sides")
    let ps: list[AllocP] = may_alloc()
    let mut i: int = 0
    while i < ps.len() {
        let p: AllocP = ps.get(i)
        let path: str = write_src(acc, "alloc_" + p.stem + ".hls", p.prog)
        let b: RunResult = boot_check(acc, path)
        let h: RunResult = run_capture(hlc_path(acc), ["--audit", path])
        let bmsg: str = first_diag(b.combined)
        let hmsg: str = first_diag(h.combined)
        if b.code != 1 || h.code == 0 {
            fail_msg(acc, "probe " + p.stem + ": accepted (boot rc=" + b.code.to_str()
                + ", hlc rc=" + h.code.to_str() + ")")
        } else if !bmsg.contains(p.needle) || !hmsg.contains(p.needle) {
            fail_msg(acc, "probe " + p.stem + ": wrong words (boot: " + bmsg
                + " | hlc: " + hmsg + ")")
        } else if bmsg != hmsg {
            fail_msg(acc, "probe " + p.stem + ": front-ends disagree")
        } else {
            pass_msg(acc, "probe " + p.stem + " rejected: " + p.needle)
        }
        i = i + 1
    }

    let spath: str = write_src(acc, "safe_probe.hls", safe_probe_hls())
    let b: RunResult = boot_check(acc, spath)
    let h: RunResult = run_capture(hlc_path(acc), ["--audit", spath])
    if b.code != 0 || h.code != 0 {
        fail_msg(acc, "safe probe: rejected (boot rc=" + b.code.to_str() + ": "
            + clip(b.combined, 160) + " | hlc rc=" + h.code.to_str() + ")")
    } else {
        pass_msg(acc, "safe probe accepted: reads, compares, to_int, a pure helper")
    }
}

# ----------------------------------------------------------------------------
# 6. the demo
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    section("6. the demo")
    let d_interp: RunResult = boot(acc, [demo()])
    let nat: RunResult = native_run(acc, demo())
    if d_interp.code == 0 && nat.spawned && nat.code == 0 && nat.out == d_interp.out {
        pass_msg(acc, "irqsafe_demo: identical output on the interpreter and natively")
    } else {
        fail_msg(acc, "irqsafe_demo: interpreter rc=" + d_interp.code.to_str()
            + ", native rc=" + nat.code.to_str() + " (outputs differ or failed)")
    }

    let h: RunResult = run_capture(hlc_path(acc), ["--audit", demo()])
    if h.combined.contains("IRQ vector 32: 'pit_isr' — allocation-free (proved over") {
        pass_msg(acc, "irqsafe_demo: hlc --audit carries the proof lines")
    } else {
        fail_msg(acc, "irqsafe_demo: proof lines missing from hlc --audit")
    }
}

# ----------------------------------------------------------------------------
# 7. the tools
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Proc {
    section("7. the tools")
    let fmt1: RunResult = run_capture("python3", ["tools/hlfmt.py", demo()])
    let fmt2: RunResult = run_capture("python3", ["tools/hlfmt.py", demo()])
    if fmt1.code == 0 && fmt2.code == 0 && fmt1.out == fmt2.out {
        pass_msg(acc, "hlfmt: stable formatting on the demo")
    } else {
        fail_msg(acc, "hlfmt: unstable or failed on the demo")
    }

    let lint: RunResult = run_capture("python3", ["tools/hllint.py", demo()])
    let lint2: RunResult = run_capture("python3", ["tools/hllint.py", ok_test()])
    if lint.code == 0 && lint2.code == 0 {
        pass_msg(acc, "hllint: no findings on the demo or the ok-test")
    } else {
        fail_msg(acc, "hllint: findings (demo rc=" + lint.code.to_str()
            + ", ok rc=" + lint2.code.to_str() + ")")
    }
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("irqsafe")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    return finish(acc, "Stage 91 -- verified interrupt-safety (no alloc in IRQ context)")
}
