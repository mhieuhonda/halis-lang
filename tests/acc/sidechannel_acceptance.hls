# ============================================================================
# tests/acc/sidechannel_acceptance.hls — Stage 101 acceptance gate, in Halis
# (the Halis twin of tests/sidechannel_acceptance.py; same eight sections,
# same assertions, same needles — the harness is tests/acc/harness.hls and
# the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make sidechannel-acceptance` (which compiles this file and runs
# it from the repo root).
#
# The old battery reached into the lab interpreter's Python internals
# (load_program/check/analyze_sidechannel) for its first three sections;
# the gate asks the same questions through the front door — the Stage 101
# CLI (`python3 tools/hlprove.py <file> --sidechannel`), which prints the
# same analysis (findings with kind/line/text, the policy notes, the
# incoming flows, the CLEAN verdicts). Two engine facts the report states
# only implicitly are pinned through their observable consequences:
#   - `returns_secret` — the marking of a returned value — is asserted by
#     giving the probe a caller that BRANCHES on the marked call (the
#     caller's BRANCH finding exists only if the return is secret);
#   - the probe sources are byte-identical to the battery's, so the
#     `line N:` numbers in the needles are the battery's own.
#
#  1. the engine          — the sink battery: branch / index / loop-bound
#                           / division findings pinned exactly, the
#                           constant-time idioms pinned CLEAN
#  2. the soundness flips — public index into a secret list, secret index
#                           into a public list, the flow-sensitive kill,
#                           the loop widening, the push taint, the join
#  3. the propagation     — the interprocedural chain (leak at the
#                           bottom, incoming edges at every level) and
#                           recursion terminating the fixpoint
#  4. the CLI             — `hlprove --sidechannel` on the demo: every
#                           sink kind, the policy note, the totals
#  5. the demo            — interpreter and native agree byte for byte
#  6. the audit parity    — boot.py --audit and hlc --audit print the
#                           same #[secrets(...)] block, word for word
#  7. the fail tests      — both front-ends reject the malformed
#                           markings with the same words
#  8. the tools           — hlfmt stable, hllint clean on the new sources
# ============================================================================

import "./harness.hls"
import "std.str"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

fn demo() -> str {
    return "examples/sidechannel_demo.hls"
}

fn ok_test() -> str {
    return "tests/ok/feat_stage101_sidechannel.hls"
}

struct FailCase {
    stem: str,
    needle: str,
    why: str
}

fn fail_programs() -> list[FailCase] {
    return [
        FailCase {
            stem: "fail_stage101_secret_unknown_param",
            needle: "which is not a parameter of",
            why: "a secret name that marks nothing hides the hazard"
        },
        FailCase {
            stem: "fail_stage101_secret_dup",
            needle: "appears more than once on one function",
            why: "two markings merge into one list, so the attr is refused"
        },
        FailCase {
            stem: "fail_stage101_secret_empty",
            needle: "needs at least one parameter name",
            why: "an empty list marks nothing"
        },
    ]
}

# ----------------------------------------------------------------------------
# Probe sources — byte-identical to the battery's engine_on() texts
# (leading newline included: the `line N:` numbers in the needles are
# the battery's own).
# ----------------------------------------------------------------------------

fn probe_lookup() -> str {
    return "\n" +
        "#[secrets(b)]\n" +
        "fn lookup(sbox: list[int], b: int) -> int {\n" +
        "    return sbox.get(b)\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_cmp() -> str {
    return "\n" +
        "#[secrets(key)]\n" +
        "fn cmp(key: str, probe: str) -> int {\n" +
        "    let mut i: int = 0\n" +
        "    while i < key.len() {\n" +
        "        if key.byte_at(i) != probe.byte_at(i) {\n" +
        "            return i\n" +
        "        }\n" +
        "        i = i + 1\n" +
        "    }\n" +
        "    return -1\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_workload() -> str {
    return "\n" +
        "#[secrets(rounds)]\n" +
        "fn workload(rounds: int) -> int {\n" +
        "    let mut acc: int = 0\n" +
        "    for i: int in range(0, rounds) {\n" +
        "        acc = acc + i\n" +
        "    }\n" +
        "    acc = acc % rounds\n" +
        "    return acc\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

# The battery checked `rep.returns_secret` on pick; through the CLI the
# marking of the RETURN is observable only through its consequence, so
# the probe carries a caller that branches on pick's result — the
# caller's BRANCH finding exists only if the return is secret.
fn probe_pick() -> str {
    return "\n" +
        "#[secrets(mask)]\n" +
        "fn pick(mask: int, a: int, b: int) -> int {\n" +
        "    return a * mask + b * (1 - mask)\n" +
        "}\n" +
        "\n" +
        "fn probe_caller(x: int) -> int {\n" +
        "    if pick(x, 1, 2) > 0 {\n" +
        "        return 1\n" +
        "    }\n" +
        "    return 0\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_matchsink() -> str {
    return "\n" +
        "enum Op {\n" +
        "    Add,\n" +
        "    Mul,\n" +
        "}\n" +
        "\n" +
        "fn pick_op(s: int) -> Op {\n" +
        "    if s > 10 {\n" +
        "        return Op.Add\n" +
        "    }\n" +
        "    return Op.Mul\n" +
        "}\n" +
        "\n" +
        "#[secrets(s)]\n" +
        "fn apply(s: int) -> int {\n" +
        "    let op: Op = pick_op(s)\n" +
        "    return match op {\n" +
        "        Op.Add => s + 1,\n" +
        "        Op.Mul => s * 2\n" +
        "    }\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_read0() -> str {
    return "\n" +
        "#[secrets(xs)]\n" +
        "fn read0(xs: list[int]) -> int {\n" +
        "    return xs.get(0)\n" +
        "}\n" +
        "\n" +
        "fn probe_caller(x: list[int]) -> int {\n" +
        "    if read0(x) > 0 {\n" +
        "        return 1\n" +
        "    }\n" +
        "    return 0\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_sneaky() -> str {
    return "\n" +
        "#[secrets(idx)]\n" +
        "fn sneaky(idx: int, pub_table: list[int]) -> int {\n" +
        "    return pub_table.get(idx)\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_killed() -> str {
    return "\n" +
        "#[secrets(s)]\n" +
        "fn killed(s: int) -> int {\n" +
        "    let mut x: int = s\n" +
        "    x = 0\n" +
        "    if x > 0 {\n" +
        "        return 1\n" +
        "    }\n" +
        "    return 0\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_widened() -> str {
    return "\n" +
        "#[secrets(s)]\n" +
        "fn widened(s: int) -> int {\n" +
        "    let mut t: int = 0\n" +
        "    let mut j: int = 0\n" +
        "    while j < 10 {\n" +
        "        t = s\n" +
        "        j = j + 1\n" +
        "    }\n" +
        "    if t > 0 {\n" +
        "        return 1\n" +
        "    }\n" +
        "    return 0\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_pushed() -> str {
    return "\n" +
        "#[secrets(s)]\n" +
        "fn pushed(s: int) -> int {\n" +
        "    let xs: list[int] = []\n" +
        "    xs.push(s)\n" +
        "    if xs.get(0) > 0 {\n" +
        "        return 1\n" +
        "    }\n" +
        "    return 0\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_joined() -> str {
    return "\n" +
        "#[secrets(s)]\n" +
        "fn joined(s: int, pub_flag: bool) -> int {\n" +
        "    let mut x: int = 0\n" +
        "    if pub_flag {\n" +
        "        x = s\n" +
        "    } else {\n" +
        "        x = 7\n" +
        "    }\n" +
        "    if x > 3 {\n" +
        "        return 1\n" +
        "    }\n" +
        "    return 0\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_chain() -> str {
    return "\n" +
        "fn deep(x: int) -> int {\n" +
        "    let mut y: int = 0\n" +
        "    if x > 64 {\n" +
        "        y = x - 64\n" +
        "    } else {\n" +
        "        y = x + 1\n" +
        "    }\n" +
        "    return y\n" +
        "}\n" +
        "\n" +
        "fn mid(k: int) -> int {\n" +
        "    return deep(k * 3)\n" +
        "}\n" +
        "\n" +
        "#[secrets(master)]\n" +
        "fn top(master: int) -> int {\n" +
        "    return mid(master)\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_rec() -> str {
    return "\n" +
        "#[secrets(acc)]\n" +
        "fn rec(n: int, acc: int) -> int {\n" +
        "    if n <= 0 {\n" +
        "        return acc\n" +
        "    }\n" +
        "    return rec(n - 1, acc + 2)\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

fn probe_plain() -> str {
    return "\n" +
        "fn plain(x: int) -> int {\n" +
        "    if x > 0 {\n" +
        "        return 1\n" +
        "    }\n" +
        "    return 0\n" +
        "}\n" +
        "\n" +
        "fn main() -> int { return 0 }\n"
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

# prove(acc, args) — the Stage 101/102 front door, spawned as a child.
fn prove(acc: Acc, args: list[str]) -> RunResult uses Proc {
    let argv: list[str] = [path_join3(acc.root, "tools/hlprove.py")]
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    return run_capture("python3", argv)
}

# sc_run(acc, name, src) — engine_on(): write the probe into the scratch
# world and run the side-channel analysis over it.
fn sc_run(acc: Acc, name: str, src: str) -> RunResult uses Fs, Proc {
    let p: str = write_src(acc, "sc_" + name + ".hls", src)
    return prove(acc, [p, "--sidechannel"])
}

# cli_section(out, name) — the report's per-fn block: from the
# "  <name>:" header line to the next two-space header (the next fn, or
# the TOTAL line). "" when the fn has no block (the battery's
# reports.get(fn) returning None).
fn cli_section(out: str, name: str) -> str {
    let lines: list[str] = out.split("\n")
    let mut start: int = -1
    let mut i: int = 0
    while i < lines.len() {
        if lines.get(i) == "  " + name + ":" {
            start = i
            break
        }
        i = i + 1
    }
    if start < 0 {
        return ""
    }
    let mut end: int = lines.len()
    let mut j: int = start + 1
    while j < lines.len() {
        let l: str = lines.get(j)
        if l.starts_with("  ") && !l.starts_with("    ") {
            end = j
            break
        }
        j = j + 1
    }
    let mut joined: str = ""
    let mut k: int = start
    while k < end {
        if k > start {
            joined = joined + "\n"
        }
        joined = joined + lines.get(k)
        k = k + 1
    }
    return joined
}

# first_line(text) — Python's splitlines()[0].
fn first_line_of(text: str) -> str {
    let lines: list[str] = text.split("\n")
    if lines.len() > 0 {
        return lines.get(0)
    }
    return ""
}

# normalise(text) — the battery's Stage 86/91/93 convention: strip the
# front-end-specific prefix and the line suffix.
#   re.sub(r"^panic: ", "", ...)          — hlc's panic prefix
#   re.sub(r"^[a-z ]*error: ", "", ...)   — "compile error: "/"type error: "
#   re.sub(r" \(line \d+(?::\d+)?\)\s*$", "", ...) — the location suffix
fn normalise(text: str) -> str {
    let mut out: str = text.trim()
    if out.starts_with("panic: ") {
        out = out.slice(7, out.len())
    }
    let at: int = out.find("error: ")
    if at >= 0 {
        let mut all_lower: bool = true
        let mut i: int = 0
        while i < at {
            let c: int = out.byte_at(i)
            if !((c >= 97 && c <= 122) || c == 32) {
                all_lower = false
            }
            i = i + 1
        }
        if all_lower {
            out = out.slice(at + 7, out.len())
        }
    }
    return strip_line_suffix(out)
}

# strip_line_suffix(out) — the ` \(line N(:M)?\)\s*$` rule: rstrip, then
# a trailing "(line N)" or "(line N:M)" after a space and an opening
# paren comes off with the paren pair.
fn strip_line_suffix(out: str) -> str {
    let mut t: str = out
    while t.len() > 0 {
        let c: int = t.byte_at(t.len() - 1)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            t = t.slice(0, t.len() - 1)
        } else {
            break
        }
    }
    if !t.ends_with(")") {
        return t
    }
    # the LAST " (line " — the suffix must sit at the very end
    let mut at: int = -1
    let mut from: int = 0
    let mut scanning: bool = true
    while scanning {
        let nxt: int = t.slice(from, t.len()).find(" (line ")
        if nxt < 0 {
            scanning = false
        } else {
            at = from + nxt
            from = at + 1
        }
    }
    if at < 0 {
        return t
    }
    let inner: str = t.slice(at + 7, t.len() - 1)
    if line_num_ok(inner) {
        return t.slice(0, at)
    }
    return t
}

# line_num_ok(s) — \d+ or \d+:\d+ (the regex's number grammar).
fn line_num_ok(s: str) -> bool {
    if s.len() == 0 {
        return false
    }
    let mut digits: int = 0
    let mut colons: int = 0
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c >= 48 && c <= 57 {
            digits = digits + 1
        } else {
            if c == 58 {
                if colons > 0 || digits == 0 {
                    return false
                }
                colons = colons + 1
                digits = 0
            } else {
                return false
            }
        }
        i = i + 1
    }
    return digits > 0
}

# audit_block(out, header) — the battery's audit_secrets_block(): the
# header line plus every indented continuation.
fn audit_block(out: str, header: str) -> list[str] {
    let lines: list[str] = out.split("\n")
    let mut block: list[str] = []
    let mut grabbing: bool = false
    let mut i: int = 0
    while i < lines.len() {
        let ln: str = lines.get(i)
        if !grabbing && ln.starts_with(header) {
            grabbing = true
            block.push(ln)
        } else {
            if grabbing {
                if ln.starts_with("    ") {
                    block.push(ln)
                } else {
                    break
                }
            }
        }
        i = i + 1
    }
    return block
}

fn blocks_equal(a: list[str], b: list[str]) -> bool {
    if a.len() != b.len() {
        return false
    }
    let mut i: int = 0
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false
        }
        i = i + 1
    }
    return true
}

# ----------------------------------------------------------------------------
# 1. the engine
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    section("1. the engine")

    # -- the INDEX sink: a secret byte selecting a table entry ------------
    let r: RunResult = sc_run(acc, "lookup", probe_lookup())
    let sec: str = cli_section(r.combined, "lookup")
    check(acc, "lookup: one INDEX finding naming the sbox.get call",
        grep_count(sec, ": BRANCH — ") == 0
            && grep_count(sec, ": INDEX — ") == 1
            && grep_count(sec, ": LOOP-BOUND — ") == 0
            && grep_count(sec, ": DIVISION — ") == 0
            && sec.contains(": INDEX — `sbox.get(b)`"),
        clip(r.combined, 120))

    # -- the BRANCH sink: the early-exit compare ---------------------------
    let r2: RunResult = sc_run(acc, "cmp", probe_cmp())
    let sec2: str = cli_section(r2.combined, "cmp")
    check(acc, "cmp: one BRANCH finding on the byte compare (the while stays "
        + "public: len is policy)",
        grep_count(sec2, ": BRANCH — ") == 1
            && grep_count(sec2, ": INDEX — ") == 0
            && grep_count(sec2, ": LOOP-BOUND — ") == 0
            && grep_count(sec2, ": DIVISION — ") == 0
            && sec2.contains("key.byte_at(i)"),
        clip(r2.combined, 120))
    check(acc, "cmp: the len() use is counted as a policy note",
        sec2.contains(".len() on a secret value: 1 use(s) — public by policy"),
        clip(sec2, 90))

    # -- the LOOP-BOUND and DIVISION sinks ---------------------------------
    let r3: RunResult = sc_run(acc, "workload", probe_workload())
    let sec3: str = cli_section(r3.combined, "workload")
    check(acc, "workload: LOOP-BOUND on range(0, rounds) and DIVISION on the "
        + "modulo",
        grep_count(sec3, ": BRANCH — ") == 0
            && grep_count(sec3, ": INDEX — ") == 0
            && grep_count(sec3, ": LOOP-BOUND — ") == 1
            && grep_count(sec3, ": DIVISION — ") == 1
            && sec3.contains(": LOOP-BOUND — `range(0, rounds)`"),
        clip(r3.combined, 120))

    # -- the constant-time idiom stays CLEAN --------------------------------
    let r4: RunResult = sc_run(acc, "pick", probe_pick())
    let pick_sec: str = cli_section(r4.combined, "pick")
    let caller_sec: str = cli_section(r4.combined, "probe_caller")
    check(acc, "pick: CLEAN (data-only flow), the return is still marked secret",
        pick_sec.contains("CLEAN: no secret-dependent control flow")
            && caller_sec.contains(": BRANCH — ")
            && caller_sec.contains("pick(x, 1, 2) > 0"),
        clip(r4.combined, 160))

    # -- the match sink ------------------------------------------------------
    let r5: RunResult = sc_run(acc, "matchsink", probe_matchsink())
    let apply_sec: str = cli_section(r5.combined, "apply")
    let pop_sec: str = cli_section(r5.combined, "pick_op")
    check(acc, "match: a match on a secret-derived scrutinee (in return "
        + "position) is a BRANCH sink",
        grep_count(apply_sec, ": BRANCH — ") == 1
            && apply_sec.contains(": BRANCH — `op`"),
        clip(apply_sec, 120))
    check(acc, "match: the helper that derived the scrutinee leaks too",
        pop_sec.contains(": BRANCH — ") && pop_sec.contains("s > 10"),
        clip(pop_sec, 120))
}

# ----------------------------------------------------------------------------
# 2. the soundness flips
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    section("2. the soundness flips")
    # Every case below is one a naive source-taint pass would get WRONG.

    # a PUBLIC index into a SECRET list: the address is the constant, only
    # the VALUE is secret — no INDEX finding (and no branch).
    let r: RunResult = sc_run(acc, "read0", probe_read0())
    let read_sec: str = cli_section(r.combined, "read0")
    let caller_sec: str = cli_section(r.combined, "probe_caller")
    check(acc, "read0: a public index into a secret list is data flow only",
        read_sec.contains("secret roots: xs")
            && read_sec.contains("CLEAN: no secret-dependent control flow")
            && caller_sec.contains(": BRANCH — ")
            && caller_sec.contains("read0(x) > 0"),
        clip(r.combined, 160))

    # a SECRET index into a PUBLIC list: the address follows the secret —
    # the INDEX finding fires even though the list is public.
    let r2: RunResult = sc_run(acc, "sneaky", probe_sneaky())
    let sneaky_sec: str = cli_section(r2.combined, "sneaky")
    check(acc, "sneaky: a secret index into a public table is an INDEX leak",
        sneaky_sec.contains(": INDEX — `pub_table.get(idx)`"),
        clip(sneaky_sec, 120))

    # the flow-sensitive kill: a variable that CARRIED a secret and was
    # reassigned a public value before the branch — no leak.
    let r3: RunResult = sc_run(acc, "killed", probe_killed())
    check(acc, "killed: the reassignment kills the marking before the branch",
        cli_section(r3.combined, "killed")
            .contains("CLEAN: no secret-dependent control flow"),
        clip(r3.combined, 120))

    # the loop widening: the variable becomes secret INSIDE the loop; the
    # branch after the loop must still see it.
    let r4: RunResult = sc_run(acc, "widened", probe_widened())
    let wid_sec: str = cli_section(r4.combined, "widened")
    check(acc, "widened: a secret assigned inside the loop reaches the branch "
        + "after it",
        wid_sec.contains(": BRANCH — ") && wid_sec.contains("t > 0"),
        clip(wid_sec, 120))

    # the push taint: pushing a secret element taints the container, and a
    # later branch on its content is a leak.
    let r5: RunResult = sc_run(acc, "pushed", probe_pushed())
    let push_sec: str = cli_section(r5.combined, "pushed")
    check(acc, "pushed: the push taints the list; the content branch is a leak",
        push_sec.contains(": BRANCH — ") && push_sec.contains("xs.get(0) > 0"),
        clip(push_sec, 120))

    # a join: secret on one arm only — the joined variable stays secret.
    let r6: RunResult = sc_run(acc, "joined", probe_joined())
    let join_sec: str = cli_section(r6.combined, "joined")
    check(acc, "joined: the if/else join keeps the secret arm secret",
        join_sec.contains(": BRANCH — ") && join_sec.contains("x > 3"),
        clip(join_sec, 120))
}

# ----------------------------------------------------------------------------
# 3. the propagation
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. the propagation")

    # three helper levels; the leak is found INSIDE the deepest fn, with
    # the incoming chain printed at every level.
    let r: RunResult = sc_run(acc, "chain", probe_chain())
    let deep_sec: str = cli_section(r.combined, "deep")
    let mid_sec: str = cli_section(r.combined, "mid")
    let top_sec: str = cli_section(r.combined, "top")
    check(acc, "chain: the leak is reported at the deepest fn's own line",
        deep_sec.contains(": BRANCH — ") && deep_sec.contains("x > 64"),
        clip(deep_sec, 120))
    check(acc, "chain: mid reports the incoming secret 'k' from top",
        mid_sec.contains("incoming: 'k' passes a secret 'k' from top"),
        clip(mid_sec, 120))
    check(acc, "chain: top's parameter is a secret root (#[secrets])",
        top_sec.contains("secret roots: master"),
        clip(top_sec, 120))

    # recursion: the fixpoint terminates and the self-flow is handled.
    let r2: RunResult = sc_run(acc, "rec", probe_rec())
    check(acc, "recursion: the fixpoint terminates on a self-recursive fn",
        cli_section(r2.combined, "rec").contains("secret roots: acc"),
        clip(r2.combined, 120))

    # a program with no markings: the CLI says so honestly (CLI section
    # re-checks the exact words; here the engine returns nothing).
    let r3: RunResult = sc_run(acc, "plain", probe_plain())
    check(acc, "plain: no markings, no propagation — nothing is reported",
        r3.combined.contains("nothing to audit"),
        clip(r3.combined, 120))
}

# ----------------------------------------------------------------------------
# 4. the CLI
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Proc {
    section("4. the CLI")
    let r: RunResult = prove(acc, [demo(), "--sidechannel"])
    if r.code != 0 {
        fail_msg(acc, "hlprove --sidechannel exited " + r.code.to_str())
    } else {
        pass_msg(acc, "hlprove --sidechannel runs clean on the demo")
        let txt: str = r.out
        check(acc, "cli: the INDEX sink names the sbox call",
            txt.contains("line 40: INDEX — `sbox.get(b)`"), "")
        check(acc, "cli: the BRANCH sink names the byte compare",
            txt.contains("line 47: BRANCH — `(key.byte_at(i) != probe.byte_at(i))`"), "")
        check(acc, "cli: the LOOP-BOUND sink names the range",
            txt.contains("line 58: LOOP-BOUND — `range(0, rounds)`"), "")
        check(acc, "cli: the DIVISION sink names the modulo",
            txt.contains("line 61: DIVISION — `(acc % rounds)`"), "")
        check(acc, "cli: the deep branch carries its incoming chain",
            txt.contains("incoming: 'x' passes a secret 'x' from schedule_step"), "")
        check(acc, "cli: the policy note is printed where it applies",
            txt.contains(".len() on a secret value: 1 use(s) — public by policy"), "")
        check(acc, "cli: the constant-time idiom is CLEAN",
            txt.contains("CLEAN: no secret-dependent control flow"), "")
        check(acc, "cli: the totals line closes the report",
            txt.contains("SIDECHANNEL TOTAL: 5 leaks — 2 branch, 1 index, "
                + "1 loop-bound, 1 division — in 4 of 8 secret-handling fns"), "")
    }

    let plain: RunResult = prove(acc, [ok_test(), "--sidechannel"])
    check(acc, "cli: the ok-test's constant-time shapes audit CLEAN",
        plain.code == 0 && plain.out.contains("SIDECHANNEL TOTAL: 0 leaks"),
        "rc=" + plain.code.to_str())

    let none: RunResult = prove(acc, ["examples/hello.hls", "--sidechannel"])
    check(acc, "cli: a program with no markings says so honestly",
        none.code == 0 && none.out.contains("nothing to audit"),
        "rc=" + none.code.to_str())
}

# ----------------------------------------------------------------------------
# 5. the demo
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("5. the demo")
    let interp: RunResult = boot(acc, [demo()])
    check(acc, "the demo runs on the interpreter (rc=0)", interp.code == 0,
        "rc=" + interp.code.to_str())

    if !file_exists("./bin/hlc") {
        fail_msg(acc, "bin/hlc missing — run make bootstrap first")
        return
    }
    let c_out: str = scratch(acc, "sidechannel_demo.c")
    let comp: RunResult = run_capture("./bin/hlc", [demo(), c_out])
    if comp.code != 0 {
        fail_msg(acc, "hlc refused the demo (rc=" + comp.code.to_str() + ")")
        return
    }
    let exe: str = scratch(acc, "sidechannel_demo")
    let cc: RunResult = run_capture("cc", ["-O2", "-Werror", "-o", exe, c_out,
        "-lm", "-pthread"])
    if cc.code != 0 {
        fail_msg(acc, "cc refused the generated C (rc=" + cc.code.to_str() + ")")
        return
    }
    let native: RunResult = run_capture(exe, [])
    if native.code == 0 && native.out == interp.out {
        pass_msg(acc, "native (-O2 -Werror) output identical to the interpreter")
    } else {
        fail_msg(acc, "native output diverges (rc=" + native.code.to_str() + ")")
    }
}

# ----------------------------------------------------------------------------
# 6. the audit parity
# ----------------------------------------------------------------------------
# boot.py --audit and hlc --audit must print the SAME #[secrets(...)]
# block, word for word (the marking is a language-level fact, so the
# two front-ends must state it identically).
fn sec6(acc: Acc) -> void uses IO, Proc {
    section("6. the audit parity")
    let b: RunResult = boot(acc, ["--audit", demo()])
    let h: RunResult = run_capture("./bin/hlc", ["--audit", demo()])
    let b_block: list[str] = audit_block(b.out, "  #[secrets(...)] annotations:")
    let h_block: list[str] = audit_block(h.out, "  #[secrets(...)] annotations:")
    if b_block.len() > 0 && blocks_equal(b_block, h_block) {
        pass_msg(acc, "audit parity: " + b_block.len().to_str()
            + " #[secrets(...)] lines identical from both front-ends")
        let mut i: int = 0
        while i < b_block.len() {
            pass_msg(acc, "    " + b_block.get(i).trim())
            i = i + 1
        }
    } else {
        fail_msg(acc, "audit parity: blocks differ — boot: "
            + clip(block_dump(b_block), 200) + " / hlc: "
            + clip(block_dump(h_block), 200))
    }
}

fn block_dump(block: list[str]) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < block.len() {
        out = out + block.get(i) + " | "
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# 7. the fail tests
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Fs, Proc {
    section("7. the fail tests")
    let cases: list[FailCase] = fail_programs()
    let mut i: int = 0
    while i < cases.len() {
        let fc: FailCase = cases.get(i)
        let src: str = "tests/fail/" + fc.stem + ".hls"
        let b: RunResult = boot(acc, ["--check", src])
        let outc: str = scratch(acc, fc.stem + ".c")
        let h: RunResult = run_capture("./bin/hlc", [src, outc])
        if b.code == 0 {
            fail_msg(acc, fc.stem + ": boot accepted the malformed marking ("
                + fc.why + ")")
        } else {
            if h.code == 0 {
                fail_msg(acc, fc.stem + ": hlc accepted the malformed marking ("
                    + fc.why + ")")
            } else {
                let bmsg: str = normalise(first_line_of(b.combined))
                let hmsg: str = normalise(first_line_of(h.combined))
                if bmsg != hmsg {
                    fail_msg(acc, fc.stem
                        + ": boot and hlc disagree on the words: boot: " + bmsg
                        + " / hlc: " + hmsg)
                } else {
                    if !bmsg.contains(fc.needle) {
                        fail_msg(acc, fc.stem
                            + ": diagnostic does not name the rule ('"
                            + fc.needle + "'): " + bmsg)
                    } else {
                        pass_msg(acc, fc.stem
                            + " rejected identically by both front-ends ("
                            + fc.why + ")")
                    }
                }
            }
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 8. the tools
# ----------------------------------------------------------------------------
fn sec8(acc: Acc) -> void uses IO, Fs, Proc {
    section("8. the tools")
    let files: list[str] = [demo(), ok_test()]
    let mut i: int = 0
    while i < files.len() {
        let f: str = files.get(i)
        let original: str = read_file(f)
        let p1: str = scratch(acc, "fmt" + i.to_str() + "a.hls")
        write_file(p1, original)
        let _f1: RunResult = run_capture("./bin/hlfmt", ["-w", p1])
        let p2: str = scratch(acc, "fmt" + i.to_str() + "b.hls")
        cp(p1, p2)
        let _f2: RunResult = run_capture("./bin/hlfmt", ["-w", p2])
        let once: str = read_file(p1)
        let twice: str = read_file(p2)
        check(acc, "hlfmt: stable formatting on " + f, once == twice, "")
        i = i + 1
    }

    let l1: RunResult = run_capture("python3",
        [path_join3(acc.root, "tools/hllint.py"), demo()])
    let l2: RunResult = run_capture("python3",
        [path_join3(acc.root, "tools/hllint.py"), ok_test()])
    check(acc, "hllint: no findings on the demo or the ok-test",
        l1.code == 0 && l2.code == 0, "")
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("sidechannel")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    sec8(acc)
    return finish(acc, "Stage 101 -- the cryptographic side-channel analysis")
}
