# ============================================================================
# tests/acc/idt_acceptance.hls — Stage 86 acceptance gate, in Halis
# (the Halis twin of what was tests/idt_acceptance.py; same seven
# sections, same assertions, same needles — the harness is
# tests/acc/harness.hls and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make idt-acceptance` (which compiles this file to bin/acc-idt
# and runs it from the repo root).
#
#  1. the crate attribute + guards — `#[irq_handler(N)]` parses, the bare
#                                   form still works, and the vector
#                                   rules fire with the same diagnostic
#                                   from BOTH compilers
#  2. core/interrupt.hls          — the enums / surface, the
#                                   `core.*`-only import, no effects
#  3. the emitted stub + table     — a freestanding image gets one naked
#                                   save/restore stub per declared
#                                   vector and a binding table, gcc
#                                   links it `-Werror`, and `nm` shows
#                                   the symbols
#  4. no SSE in an ISR             — the whole reason the stub exists:
#                                   the emitted C must NOT carry
#                                   `__attribute__((interrupt))` on the
#                                   Halis function, and the image must
#                                   link at all
#  5. boot<->hlc parity            — all six fail programs, identical
#                                   text
#  6. behaviour probes            — the descriptor arithmetic, the
#                                   selector bound, the IST byte, the
#                                   32-bit offset split, the page-fault
#                                   error-code decode, the exception
#                                   table and the 8259 remap
#  7. the demos + tools           — interrupt_demo identical on the
#                                   interpreter and natively,
#                                   boot_kernel's declarations link,
#                                   hlfmt/hllint clean
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.regex"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

struct FailP {
    name: str,
    needle: str,
    desc: str
}

struct Probe {
    name: str,
    want: int,
    desc: str,
    body: str
}

struct ToolLeg {
    label: str,
    argv: list[str]
}

fn ok_test() -> str {
    return "tests/ok/feat_stage86_interrupt.hls"
}

fn demo() -> str {
    return "examples/interrupt_demo.hls"
}

fn kernel() -> str {
    return "examples/boot_kernel.hls"
}

fn core_interrupt() -> str {
    return "core/interrupt.hls"
}

fn fail_programs() -> list[FailP] {
    return [
        FailP { name: "fail_stage86_irq_vector_range", needle: "out of range",
                desc: "a vector above 255" },
        FailP { name: "fail_stage86_irq_vector_twice", needle: "appears more than once",
                desc: "two #[irq_handler(N)] on one function" },
        FailP { name: "fail_stage86_irq_vector_dup", needle: "two functions declare",
                desc: "two functions claiming one vector" },
        FailP { name: "fail_stage86_irq_ret", needle: "requires the function to return 'void'",
                desc: "a handler that returns int" },
        FailP { name: "fail_stage86_irq_params", needle: "requires exactly one parameter",
                desc: "a handler with two parameters" },
        FailP { name: "fail_stage86_irq_param_scalar", needle: "pointer-typed value",
                desc: "an int frame parameter" },
    ]
}

fn bare_hls() -> str {
    return "#[irq_handler]\n" +
           "fn handler(frame: list[int]) -> void {\n" +
           "    return\n" +
           "}\n" +
           "\n" +
           "fn main() -> int {\n" +
           "    return 0\n" +
           "}\n"
}

fn decl_hls() -> str {
    return "#[irq_handler(14)]\n" +
           "fn on_page_fault(frame: list[int]) -> void {\n" +
           "    return\n" +
           "}\n" +
           "\n" +
           "#[irq_handler(8)]\n" +
           "fn on_double(frame: list[int]) -> void {\n" +
           "    return\n" +
           "}\n" +
           "\n" +
           "fn main() -> int {\n" +
           "    return 0\n" +
           "}\n"
}

fn core_fns() -> list[str] {
    return [
        "gdt_selector", "gdt_selector_ok", "gdt_encode",
        "gdt_decode_access", "gdt_decode_flags", "gdt_decode_base",
        "gdt_decode_limit", "gdt_is_code", "gdt_is_data",
        "gdt_is_system", "gdt_is_long", "gdt_dpl", "gdt_check",
        "gdt_flag_long", "gdt_flag_default32", "gdt_flag_granularity",
        "tss_ist_encode", "tss_ist_decode", "tss_is_busy",
        "tss_set_busy", "idt_gate_ok", "idt_gate_is_interrupt",
        "idt_gate_is_trap", "idt_ist_pack", "idt_ist_unpack",
        "idt_offset_split", "idt_offset_join", "idt_offset_fits",
        "idt_entry_ok", "page_fault_decode", "page_fault_code",
        "page_fault_is_present", "page_fault_is_write",
        "page_fault_is_user", "page_fault_is_fetch",
        "page_fault_address_bits", "exc_name", "exc_pushes_error",
        "exc_is_fault", "exc_default_ist", "pic_vector_irq",
        "pic_vector_needs_eoi", "pic_remap_ok",
    ]
}

fn probes() -> list[Probe] {
    return [
        Probe {
            name: "gdt-roundtrip",
            want: 0,
            desc: "a descriptor round-trips through encode and decode",
            body: "import \"core.interrupt\"\n" +
                  "import \"core.result\"\n" +
                  "fn main() -> int {\n" +
                  "    # 8 bytes: limit[15:0] | base[15:0] | base[23:16] | limit[19:16] | flags | access | base[31:24]\n" +
                  "    let d: list[int] = gdt_encode(152, 4, 0, 1048575)\n" +
                  "    if gdt_decode_access(d.get(1)) != 152 { return 1 }\n" +
                  "    if gdt_decode_flags(d.get(1)) != 4 { return 2 }\n" +
                  "    if gdt_decode_base(d.get(0), d.get(1)) != 0 { return 3 }\n" +
                  "    # The limit's top nibble shares a byte with the flags: leaving it\n" +
                  "    # out truncates every limit above 64 KiB to 0xFFFF, which still\n" +
                  "    # looks like a valid 64-KiB segment.\n" +
                  "    if gdt_decode_limit(d.get(0), d.get(1)) != 1048575 { return 4 }\n" +
                  "    let b: list[int] = gdt_encode(146, 3, 291, 4095)\n" +
                  "    if gdt_decode_base(b.get(0), b.get(1)) != 291 { return 5 }\n" +
                  "    if gdt_decode_limit(b.get(0), b.get(1)) != 4095 { return 6 }\n" +
                  "    let n: list[int] = gdt_encode(0, 0, 0, 0)\n" +
                  "    if n.get(0) != 0 || n.get(1) != 0 { return 7 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "gdt-classes",
            want: 0,
            desc: "the code/data and system bits, and the two invalid combinations",
            body: "import \"core.interrupt\"\n" +
                  "fn main() -> int {\n" +
                  "    # The class bit is 0x08 and S is 0x10: reading one as the other\n" +
                  "    # makes every data descriptor look like code.\n" +
                  "    if !gdt_is_code(24) || gdt_is_code(18) { return 1 }\n" +
                  "    if !gdt_is_data(18) || gdt_is_data(24) { return 2 }\n" +
                  "    if gdt_is_system(24) || gdt_is_system(18) { return 3 }\n" +
                  "    if !gdt_is_system(137) { return 4 }\n" +
                  "    if gdt_fault_name(gdt_check(0, 0, true)) != \"not-present\" { return 5 }\n" +
                  "    if gdt_fault_name(gdt_check(137, 0, false)) != \"system-segment\" { return 6 }\n" +
                  "    # L with DB is architecturally invalid: the CPU #GPs on load.\n" +
                  "    if gdt_fault_name(gdt_check(152, 6, true)) != \"long-with-db\" { return 7 }\n" +
                  "    if gdt_fault_name(gdt_check(146, 4, false)) != \"long-without-code\" { return 8 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "selectors",
            want: 0,
            desc: "the selector bound, and the TI bit a kernel never wants",
            body: "import \"core.interrupt\"\n" +
                  "fn main() -> int {\n" +
                  "    if gdt_selector(1, 0) != 8 || gdt_selector(5, 3) != 43 { return 1 }\n" +
                  "    if gdt_selector_index(43) != 5 || gdt_selector_rpl(43) != 3 { return 2 }\n" +
                  "    # The index occupies bits 3..15, so the largest well-formed GDT\n" +
                  "    # selector is (1023 << 3) | 3 = 8187 — NOT 8191, which has TI set.\n" +
                  "    if gdt_max_selector() != 8187 { return 3 }\n" +
                  "    if gdt_selector(1023, 3) != 8187 { return 4 }\n" +
                  "    if gdt_selector_ok(12) { return 5 }\n" +
                  "    if gdt_selector_ok(8188) { return 6 }\n" +
                  "    if gdt_limine_handoff_selector64_code() != 40 { return 7 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "ist-and-gates",
            want: 0,
            desc: "the IST byte, the gate types, and the TSS busy bit",
            body: "import \"core.interrupt\"\n" +
                  "fn main() -> int {\n" +
                  "    # The IST is the gate's OWN byte (offset 4), not the low nibble of\n" +
                  "    # the type/attribute byte (offset 5) — packing it there overwrites\n" +
                  "    # the gate TYPE.\n" +
                  "    if !idt_ist_byte_ok(7) || idt_ist_byte_ok(8) { return 1 }\n" +
                  "    if idt_ist_unpack(idt_ist_pack(5)) != 5 { return 2 }\n" +
                  "    if !idt_gate_ok(idt_attr_present() + idt_gate_interrupt()) { return 3 }\n" +
                  "    if idt_gate_ok(idt_gate_interrupt()) { return 4 }\n" +
                  "    if !idt_gate_is_trap(idt_attr_present() + idt_gate_trap()) { return 5 }\n" +
                  "    if tss_is_busy(tss_set_busy(0, true)) != true { return 6 }\n" +
                  "    if tss_ist_decode(tss_ist_encode(0, 1)) != 1 { return 7 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "offset-split",
            want: 0,
            desc: "the 32-bit offset split and the reachability rule",
            body: "import \"core.interrupt\"\n" +
                  "fn main() -> int {\n" +
                  "    let p: list[int] = idt_offset_split(305419896)\n" +
                  "    if p.get(0) != 22136 || p.get(1) != 4660 || p.get(2) != 0 { return 1 }\n" +
                  "    if idt_offset_join(p.get(0), p.get(1), p.get(2)) != 305419896 { return 2 }\n" +
                  "    # A 32-bit offset is all a gate can reach, which is what forces the\n" +
                  "    # higher-half relocation. The upper half is tested with a LOGICAL\n" +
                  "    # shift: an arithmetic shift of -1 by 32 still yields -1.\n" +
                  "    if !idt_offset_fits(4294967295) || idt_offset_fits(4294967296) { return 3 }\n" +
                  "    if idt_offset_fits(-1) { return 4 }\n" +
                  "    if !idt_entry_ok(idt_attr_present() + idt_gate_interrupt(), 8, 1048576) { return 5 }\n" +
                  "    if idt_entry_ok(idt_attr_present() + idt_gate_interrupt(), 8, -1) { return 6 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "page-fault",
            want: 0,
            desc: "the page-fault error code decodes and round-trips",
            body: "import \"core.interrupt\"\n" +
                  "fn main() -> int {\n" +
                  "    # bit 0 P, bit 1 W/R, bit 2 U/S, bit 3 reserved, bit 4 I/D.\n" +
                  "    if page_fault_cause_name(page_fault_decode(0)) != \"read-not-present\" { return 1 }\n" +
                  "    if page_fault_cause_name(page_fault_decode(2)) != \"write-not-present\" { return 2 }\n" +
                  "    if page_fault_cause_name(page_fault_decode(3)) != \"write-protected\" { return 3 }\n" +
                  "    if page_fault_cause_name(page_fault_decode(7)) != \"user-write-protected\" { return 4 }\n" +
                  "    if page_fault_cause_name(page_fault_decode(16)) != \"instruction-fetch\" { return 5 }\n" +
                  "    # The reserved bit is checked first: every other answer is\n" +
                  "    # meaningless once it is set.\n" +
                  "    if page_fault_cause_name(page_fault_decode(8)) != \"reserved-bit-set\" { return 6 }\n" +
                  "    let mut c: int = 0\n" +
                  "    while c < 8 {\n" +
                  "        if page_fault_code(page_fault_decode(c)) != c { return 7 }\n" +
                  "        c = c + 1\n" +
                  "    }\n" +
                  "    if !page_fault_is_present(page_fault_decode(3)) { return 8 }\n" +
                  "    if page_fault_is_present(page_fault_decode(2)) { return 9 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "exceptions",
            want: 0,
            desc: "the 32 exception vectors, and which push an error code",
            body: "import \"core.interrupt\"\n" +
                  "fn main() -> int {\n" +
                  "    if exc_count() != 32 { return 1 }\n" +
                  "    if exc_name(14) != \"page-fault\" || exc_name(8) != \"double-fault\" { return 2 }\n" +
                  "    if exc_name(22) != \"\" { return 3 }\n" +
                  "    # Getting the error-pushing set wrong is not a crash — it is a\n" +
                  "    # handler reading its fault address from the wrong stack slot.\n" +
                  "    if !exc_pushes_error(8) || !exc_pushes_error(14) || !exc_pushes_error(17) { return 4 }\n" +
                  "    if exc_pushes_error(0) || exc_pushes_error(3) { return 5 }\n" +
                  "    if !exc_is_fault(14) || exc_is_fault(3) { return 6 }\n" +
                  "    # A double fault happened when the kernel could not push a frame, so\n" +
                  "    # its handler must run on a stack set up in advance.\n" +
                  "    if exc_default_ist(8) != 1 || exc_default_ist(14) != 0 { return 7 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "pic",
            want: 0,
            desc: "the 8259 remap, the IRQ numbering and the EOI rules",
            body: "import \"core.interrupt\"\n" +
                  "fn main() -> int {\n" +
                  "    if pic_master_vector_base() != 32 || pic_slave_vector_base() != 40 { return 1 }\n" +
                  "    if pic_vector_irq(32) != 0 || pic_vector_irq(47) != 15 { return 2 }\n" +
                  "    if pic_vector_ok(48) { return 3 }\n" +
                  "    # An exception never needs an EOI.\n" +
                  "    if pic_vector_needs_eoi(14) { return 4 }\n" +
                  "    if !pic_vector_needs_slave_eoi(40) || pic_vector_needs_slave_eoi(39) { return 5 }\n" +
                  "    if pic_remap_ok(8, 40) || pic_remap_ok(40, 32) { return 6 }\n" +
                  "    if !pic_remap_ok(32, 40) { return 7 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
    ]
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

fn decl_word(src: str, kw: str, name: str) -> bool {
    let rr: Result[Regex, str] = regex_compile(kw + "\\s+" + name + "\\b")
    if result_is_err(rr) {
        return false
    }
    let re: Regex = result_unwrap(rr)
    return regex_is_match(re, src)
}

fn import_paths(src: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i).trim()
        if line.starts_with("import ") {
            let rest: str = line.slice(7, line.len()).trim()
            if rest.starts_with("\"") {
                let tail: str = rest.slice(1, rest.len())
                let end: int = tail.find("\"")
                if end > 0 {
                    out.push(tail.slice(0, end))
                }
            }
        }
        i = i + 1
    }
    return out
}

# replace_first(text, old, new) — Python's str.replace(old, new, 1).
fn replace_first(text: str, old: str, new: str) -> str {
    let at: int = text.find(old)
    if at < 0 {
        return text
    }
    return text.slice(0, at) + new + text.slice(at + old.len(), text.len())
}

# rewrite_no_std_line(text) — the first exact `#![no_std]` LINE becomes
# `#![freestanding]` (line-anchored: the header comment also contains
# the token).
fn rewrite_no_std_line(text: str) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: str = ""
    let mut done: bool = false
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if !done && line == "#![no_std]" {
            out = out + "#![freestanding]" + "\n"
            done = true
        } else {
            out = out + line + "\n"
        }
        i = i + 1
    }
    return out
}

# normalise(text) — strip the front-end-specific prefixes so the two
# compilers' diagnostics compare byte for byte.
fn normalise(text: str) -> str {
    let mut t: str = text.trim()
    if t.starts_with("panic: ") {
        t = t.slice(7, t.len())
    }
    let e: int = t.find("error: ")
    if e >= 0 {
        let mut all_az: bool = true
        let mut i: int = 0
        while i < e {
            let c: int = t.byte_at(i)
            if !((c >= 97 && c <= 122) || c == 32) {
                all_az = false
                break
            }
            i = i + 1
        }
        if all_az {
            t = t.slice(e + 7, t.len())
        }
    }
    return t
}

# hlc_run(acc, src) — hlc + gcc -O2 (no -Werror in this battery) + run.
fn hlc_run(acc: Acc, src: str) -> RunResult uses Fs, Proc {
    let r: RunResult = RunResult {
        code: -1, out: "", err: "", combined: "", spawned: false
    }
    let c_path: str = scratch(acc, stem(src) + ".c")
    let exe: str = scratch(acc, stem(src) + ".bin")
    let comp: RunResult = run_capture(hlc_path(acc), [src, c_path])
    if comp.code != 0 {
        r.combined = comp.combined
        return r
    }
    let cc: RunResult = run_capture("gcc", ["-O2", "-o", exe, c_path, "-lm", "-pthread"])
    if cc.code != 0 {
        r.combined = cc.combined
        return r
    }
    let runr: RunResult = run_capture(exe, [])
    runr.spawned = true
    return runr
}

# ----------------------------------------------------------------------------
# 1. the crate attribute + guards
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    section("1. the crate attribute + guards")
    # The BARE form must still be accepted: the kernel supplies the
    # vector, so it also supplies the stub, exactly as before Stage 86.
    let bare: str = write_src(acc, "bare.hls", bare_hls())
    let bare_c: str = scratch(acc, "bare.c")
    let r: RunResult = run_capture(hlc_path(acc), [bare, bare_c])
    if r.code == 0 {
        pass_msg(acc, "idt: the bare #[irq_handler] form still compiles")
    } else {
        fail_msg(acc, "idt: the bare form rejected: " + clip(r.combined, 120))
    }
    # ...and it must NOT get a stub: there is no vector to stub.
    if !read_or(bare_c, "").contains("hl_irq_stub_") {
        pass_msg(acc, "idt: the bare form emits no stub (the kernel supplies it)")
    } else {
        fail_msg(acc, "idt: the bare form emitted a stub")
    }

    # A declared vector, in a crate with no imports, must compile.
    let decl: str = write_src(acc, "decl.hls", decl_hls())
    let decl_c: str = scratch(acc, "decl.c")
    let rd: RunResult = run_capture(hlc_path(acc), [decl, decl_c])
    if rd.code == 0 {
        pass_msg(acc, "idt: #[irq_handler(N)] compiles")
    } else {
        fail_msg(acc, "idt: #[irq_handler(N)] rejected: " + clip(rd.combined, 120))
    }
    let rb: RunResult = boot_check(acc, decl)
    if rb.code == 0 {
        pass_msg(acc, "idt: #[irq_handler(N)] accepted by Stage-0 too")
    } else {
        fail_msg(acc, "idt: Stage-0 rejected #[irq_handler(N)]: " + clip(rb.combined, 120))
    }
}

# ----------------------------------------------------------------------------
# 2. core/interrupt.hls
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO, Fs {
    section("2. core/interrupt.hls")
    if !file_exists(core_interrupt()) {
        fail_msg(acc, "idt: core/interrupt.hls missing")
        return
    }
    let src: str = read_file(core_interrupt())
    let enums: list[str] = ["GdtFault", "PageFaultCause"]
    let mut ei: int = 0
    while ei < enums.len() {
        let e: str = enums.get(ei)
        if decl_word(src, "enum", e) {
            pass_msg(acc, "idt: core.interrupt declares enum " + e)
        } else {
            fail_msg(acc, "idt: core.interrupt missing enum " + e)
        }
        ei = ei + 1
    }
    let imports: list[str] = import_paths(src)
    if imports.len() == 1 && imports.get(0) == "core.result" {
        pass_msg(acc, "idt: core.interrupt imports only core.result (freestanding-safe)")
    } else {
        fail_msg(acc, "idt: core.interrupt imports " + str_join(imports, ", "))
    }
    let lines: list[str] = src.split("\n")
    let mut has_effects: bool = false
    let mut has_extern: bool = false
    let mut li: int = 0
    while li < lines.len() {
        let line: str = lines.get(li)
        if line.trim().starts_with("#") {
            li = li + 1
            continue
        }
        if line.starts_with("fn ") && line.contains(" uses ") {
            has_effects = true
        }
        if line.trim().starts_with("extern") {
            has_extern = true
        }
        li = li + 1
    }
    if !has_effects && !has_extern {
        pass_msg(acc, "idt: core.interrupt declares no effects and no externs")
    } else {
        fail_msg(acc, "idt: core.interrupt declares effects or externs")
    }
    let fns: list[str] = core_fns()
    let mut fi: int = 0
    while fi < fns.len() {
        let f: str = fns.get(fi)
        if decl_word(src, "fn", f) {
            pass_msg(acc, "idt: core.interrupt exposes " + f)
        } else {
            fail_msg(acc, "idt: core.interrupt missing " + f)
        }
        fi = fi + 1
    }
}

# ----------------------------------------------------------------------------
# 3. the emitted stub + table
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. the emitted stub + table")
    let text: str = read_or(scratch(acc, "decl.c"), "")
    let stubs: list[str] = ["hl_irq_stub_8", "hl_irq_stub_14"]
    let mut i: int = 0
    while i < stubs.len() {
        if text.contains(stubs.get(i)) {
            pass_msg(acc, "idt: a stub was emitted for " + stubs.get(i))
        } else {
            fail_msg(acc, "idt: no stub for " + stubs.get(i))
        }
        i = i + 1
    }
    if text.contains("hl_idt_bindings[]") {
        pass_msg(acc, "idt: the binding table is emitted")
    } else {
        fail_msg(acc, "idt: the binding table is missing")
    }
    if text.contains("void hl_idt_install(") && text.contains("lidt") {
        pass_msg(acc, "idt: the installer is emitted (it loads the IDTR)")
    } else {
        fail_msg(acc, "idt: the installer is missing")
    }
    if text.contains("naked, used") {
        pass_msg(acc, "idt: the stub is naked and used")
    } else {
        fail_msg(acc, "idt: the stub is not naked/used")
    }
    # The push sequence is 11 registers = 88 bytes, and iretq unwinds them.
    if text.contains("\"pushq %r11\\n\"") && text.contains("addq $88, %rsp")
            && text.contains("iretq") {
        pass_msg(acc, "idt: the stub saves 11 registers and unwinds with iretq")
    } else {
        fail_msg(acc, "idt: the stub's save/restore sequence is wrong")
    }
    # The error-code vectors get the vector number; the others must not.
    if text.contains("movl $14, %eax") && text.contains("movl $8, %eax") {
        pass_msg(acc, "idt: the error-pushing vectors carry their number")
    } else {
        fail_msg(acc, "idt: the stubs do not pass the vector for an error-code vector")
    }

    # The IMAGE: compile it -Werror and read the symbols off the object.
    # A RELOCATABLE link is what matters here (the section and symbol
    # shape), and it keeps the check independent of whether the entry
    # symbol is present in a given program.
    let obj: str = scratch(acc, "decl.o")
    let g: RunResult = run_capture("gcc", ["-O2", "-Werror", "-ffreestanding",
        "-fno-pie", "-c", scratch(acc, "decl.c"), "-o", obj])
    if g.code != 0 {
        fail_msg(acc, "idt: the annotated image did not compile -Werror: "
            + clip(g.combined, 160))
        return
    }
    if !which("nm") {
        fail_msg(acc, "idt: nm not available")
        return
    }
    let syms: RunResult = run_capture("nm", [obj])
    let stext: str = syms.out
    let wants: list[str] = ["hl_irq_stub_8", "hl_irq_stub_14", "hl_idt_bindings",
                            "hl_idt_install", "hl_idt", "hl_idtr"]
    let mut j: int = 0
    while j < wants.len() {
        if stext.contains(wants.get(j)) {
            pass_msg(acc, "idt: the image carries " + wants.get(j))
        } else {
            fail_msg(acc, "idt: the image has no " + wants.get(j))
        }
        j = j + 1
    }
    if stext.contains("T hl_irq_stub_14") {
        pass_msg(acc, "idt: the stub is in .text (a real code symbol)")
    } else {
        fail_msg(acc, "idt: the stub is not a code symbol")
    }
}

# ----------------------------------------------------------------------------
# 4. no SSE in an ISR
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("4. no SSE in an ISR")
    # The whole reason the stub exists: gcc REJECTS SSE inside a function
    # carrying the `interrupt` attribute, and a Halis body always uses it.
    # The vector form therefore must not carry the attribute, and the
    # bare form (which has no vector to stub) must still carry it.
    let text: str = read_or(scratch(acc, "decl.c"), "")
    if !text.contains("__attribute__((interrupt))") {
        pass_msg(acc, "idt: the vector form does NOT use gcc's interrupt attribute")
    } else {
        fail_msg(acc, "idt: the vector form still emits __attribute__((interrupt))")
    }
    let bare_text: str = read_or(scratch(acc, "bare.c"), "")
    if bare_text.contains("__attribute__((interrupt))") {
        pass_msg(acc, "idt: the bare form still uses gcc's interrupt attribute")
    } else {
        fail_msg(acc, "idt: the bare form lost gcc's interrupt attribute")
    }
    # And a Halis handler with a list parameter (the case that never
    # compiled) must now build.
    if !text.contains("interrupt))") && text.contains("naked") {
        pass_msg(acc, "idt: a Halis handler with a pointer parameter links")
    } else {
        fail_msg(acc, "idt: a Halis handler with a pointer parameter still does not link")
    }
}

# ----------------------------------------------------------------------------
# 5. boot<->hlc parity
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("5. boot<->hlc parity")
    let fps: list[FailP] = fail_programs()
    let mut i: int = 0
    while i < fps.len() {
        let fp: FailP = fps.get(i)
        let path: str = "tests/fail/" + fp.name + ".hls"
        if !file_exists(path) {
            fail_msg(acc, "idt: " + path + " missing")
            i = i + 1
            continue
        }
        let rb: RunResult = boot_check(acc, path)
        if rb.code != 1 {
            fail_msg(acc, "idt: " + fp.name + " not rejected by boot")
            i = i + 1
            continue
        }
        let rh: RunResult = run_capture(hlc_path(acc), ["--audit", path])
        if rh.code == 0 {
            fail_msg(acc, "idt: " + fp.name + " accepted by hlc (parity)")
            i = i + 1
            continue
        }
        let a: str = normalise(rb.combined)
        let b: str = normalise(rh.combined)
        if !a.contains(fp.needle) {
            fail_msg(acc, "idt: " + fp.name + " rejected without its diagnostic (" + fp.desc + ")")
            i = i + 1
            continue
        }
        if a != b {
            fail_msg(acc, "idt: " + fp.name + " diagnostics differ: boot: "
                + a + " | hlc: " + b)
            i = i + 1
            continue
        }
        pass_msg(acc, "idt: " + fp.name + " rejected by both compilers (" + fp.desc + ")")
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 6. behaviour probes
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Fs, Proc {
    section("6. behaviour probes")
    let ps: list[Probe] = probes()
    let mut i: int = 0
    while i < ps.len() {
        let p: Probe = ps.get(i)
        let path: str = write_src(acc, "probe_" + p.name + ".hls", p.body)
        let r: RunResult = boot(acc, [path])
        if r.code != p.want {
            fail_msg(acc, "idt: probe " + p.name + " (interp) exit=" + r.code.to_str()
                + " want=" + p.want.to_str() + " — " + clip(r.combined, 100))
            i = i + 1
            continue
        }
        let code: RunResult = hlc_run(acc, path)
        if !code.spawned || code.code != p.want {
            fail_msg(acc, "idt: probe " + p.name + " (native) exit=" + code.code.to_str()
                + " want=" + p.want.to_str() + " — " + clip(code.combined, 100))
            i = i + 1
            continue
        }
        pass_msg(acc, "idt: " + p.name + " — " + p.desc)
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 7. the demos + tools
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Fs, Proc {
    section("7. the demos + tools")
    let r: RunResult = boot(acc, [ok_test()])
    if r.code == 0 {
        pass_msg(acc, "idt: the ok-test is clean on the interpreter")
    } else {
        fail_msg(acc, "idt: ok-test interpreter exit=" + r.code.to_str())
    }
    let code: RunResult = hlc_run(acc, ok_test())
    if code.spawned && code.code == 0 {
        pass_msg(acc, "idt: the ok-test is clean natively")
    } else {
        fail_msg(acc, "idt: ok-test native exit=" + code.code.to_str())
    }
    let fs_ok: str = write_src(acc, "ok_fs.hls", rewrite_no_std_line(read_file(ok_test())))
    let fs_c: str = scratch(acc, "ok_fs.c")
    let fc: RunResult = run_capture(hlc_path(acc), [fs_ok, fs_c])
    if fc.code != 0 {
        fail_msg(acc, "idt: the ok-test did not compile as freestanding")
    } else {
        let exe: str = scratch(acc, "ok_fs")
        let g: RunResult = run_capture("gcc", ["-O2", "-ffreestanding", "-nostdlib",
            "-ffunction-sections", "-fno-stack-protector", "-Wl,--gc-sections",
            "-o", exe, fs_c])
        let runr: RunResult = run_capture(exe, [])
        if g.code == 0 && runr.code == 0 {
            pass_msg(acc, "idt: the ok-test links -nostdlib and exits 0 (freestanding)")
        } else {
            fail_msg(acc, "idt: the freestanding ok-test failed: " + clip(g.combined, 120))
        }
    }

    let ri: RunResult = boot(acc, [demo()])
    let nat: RunResult = hlc_run(acc, demo())
    if ri.code == 0 && nat.spawned && nat.code == 0 && nat.out.contains("DEMO OK") {
        pass_msg(acc, "idt: interrupt_demo runs on both, DEMO OK")
    } else {
        fail_msg(acc, "idt: interrupt_demo interp=" + ri.code.to_str()
            + " native=" + nat.code.to_str())
    }
    if ri.out == nat.out {
        pass_msg(acc, "idt: interrupt_demo output is byte-identical (differential)")
    } else {
        fail_msg(acc, "idt: interrupt_demo differs between interpreter and native")
    }

    # A real image whose handlers are declared: the stubs and table must
    # be in the LINKED binary.
    let mut ktext: str = read_file(kernel())
    # The scratch tree sits one level DEEPER than the old battery's
    # tests/_gate_* dir (tests/.acc-scratch/idt/), so the shipped
    # ../link.ld reference needs one more hop to reach the repo root.
    ktext = str_replace(ktext, "#![link_script(\"../link.ld\")]", "#![link_script(\"../../../link.ld\")]")
    ktext = replace_first(ktext, "fn main() -> int {",
        "#[irq_handler(14)]\n" +
        "fn on_page_fault(frame: list[int]) -> void {\n" +
        "    return\n" +
        "}\n" +
        "\n" +
        "#[irq_handler(8)]\n" +
        "fn on_double_fault(frame: list[int]) -> void {\n" +
        "    return\n" +
        "}\n" +
        "\n" +
        "fn main() -> int {")
    let kr: str = write_src(acc, "kernel.hls", ktext)
    let kc: str = scratch(acc, "kernel.c")
    let kcomp: RunResult = run_capture(hlc_path(acc), [kr, kc])
    if kcomp.code != 0 {
        fail_msg(acc, "idt: the kernel with declared handlers did not compile")
        return
    }
    if !which("nm") {
        fail_msg(acc, "idt: nm not available")
        return
    }
    let kelf: str = scratch(acc, "kernel.elf")
    let g: RunResult = run_capture("gcc", ["-O2", "-Werror", "-ffreestanding", "-nostdlib",
        "-fno-pie", "-no-pie", "-fno-stack-protector", "-T", "link.ld", "-o", kelf, kc])
    if g.code != 0 {
        fail_msg(acc, "idt: the kernel with declared handlers did not link: "
            + clip(g.combined, 160))
        return
    }
    let syms: RunResult = run_capture("nm", [kelf])
    let stext: str = syms.out
    if stext.contains("hl_irq_stub_14") && stext.contains("hl_irq_stub_8") {
        pass_msg(acc, "idt: the kernel image carries a stub per declared vector")
    } else {
        fail_msg(acc, "idt: the kernel image is missing a stub")
    }
    if stext.contains("hl_idt_bindings") {
        pass_msg(acc, "idt: the kernel image carries the binding table")
    } else {
        fail_msg(acc, "idt: the kernel image is missing the binding table")
    }

    let tools: list[ToolLeg] = [
        ToolLeg { label: "hlfmt -c (ok-test)", argv: ["./bin/hlfmt", "-c", ok_test()] },
        ToolLeg { label: "hlfmt -c (demo)", argv: ["./bin/hlfmt", "-c", demo()] },
        ToolLeg { label: "hlfmt -c (core)", argv: ["./bin/hlfmt", "-c", core_interrupt()] },
        ToolLeg { label: "hllint (ok-test)", argv: ["python3", "tools/hllint.py", ok_test()] },
    ]
    let mut i: int = 0
    while i < tools.len() {
        let t: ToolLeg = tools.get(i)
        let rest: list[str] = []
        let mut k: int = 1
        while k < t.argv.len() {
            rest.push(t.argv.get(k))
            k = k + 1
        }
        let tr: RunResult = run_capture(t.argv.get(0), rest)
        if tr.code == 0 {
            pass_msg(acc, "idt: " + t.label)
        } else {
            fail_msg(acc, "idt: " + t.label + ": " + clip(tr.combined, 140))
        }
        i = i + 1
    }
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("idt")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    return finish(acc, "Stage 86 -- core.interrupt: IDT/GDT declaration syntax")
}
