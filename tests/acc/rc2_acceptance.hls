# ============================================================================
# tests/acc/rc2_acceptance.hls — Stage 147 acceptance gate, in Halis
# (the Halis twin of tests/rc2_acceptance.py; same five sections, same
# assertions, same needles — the harness is tests/acc/harness.hls and
# the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Five sections over the REAL CLIs (bin/hlc, bin/hls-rc) and a REAL
# scratch git repository (tests/.acc-scratch/rc2/, the gate's scratch
# world) — the successor candidate is rehearsed end to end on a world
# built for the purpose, and the bug fixes this round ships are pinned
# as laws.
#
# The battery set GIT_* env vars for every child so the scratch
# commits carry a pinned committer day; the gate does the same with
# std.env before the first child spawns. The battery captured stdout
# and stderr in SEPARATE pipes, so the gate matches needles against
# r.out / r.err exactly where the battery did.
#
# The battery's broken-pipe leg (Popen piped into `head -1`) is a
# shell one-liner here: the pipeline's stderr lands in a scratch file
# and the gate reads it back — boot.py's stderr either way.
#
#  1. the regression   — the invocation errors the RC2 fixes restored:
#     law                 a missing input file refuses on BOTH
#                         front-ends (exit 2, `error: cannot open file
#                         <path>` — no panic, no compile-error shape),
#                         the audit path with it, an unwritable output
#                         destination is refused up front (before
#                         codegen), and a broken stdout pipe dies
#                         silently the way the native binary always has
#                         (no traceback);
#  2. the working       — the same CLIs on the paths that always
#     paths               worked: a program runs, compiles, audits;
#                         --check holds; the refusals did not eat the
#                         road;
#  3. the real-tree     — the freeze still holds on the live tree: the
#     candidate laws      gate names every commit since the anchor
#                         BUGFIX or CHORE, readiness is green, and the
#                         three version markers speak with one voice;
#  4. the successor     — the RC2 choreography rehearsed on a scratch
#     rehearsal           world: the rc.1 candidate declared, then the
#                         successor cut the same way — Stage 147
#                         ticked, the markers moved, the old anchor
#                         left with the release commit, rc.2 declared,
#                         the gate green across the whole rc.1..rc.2
#                         range, the record rendered and drift-checked;
#  5. the corpus        — tests/ok/feat_stage147_rc2.hls is hlfmt-
#     showcase            canonical, hllint-clean, boots through the
#                         real checker, runs green on the interpreter
#                         and (when bin/hlc exists) matches natively
#                         byte for byte.
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.json"
import "std.result"
import "std.env"

# ----------------------------------------------------------------------------
# The gate's data (the battery's constants).
# ----------------------------------------------------------------------------

fn freeze_digest() -> str {
    return "84d1068f80d62f3f741785ce2241b423fa5bd36b4e28e0a872c6e772e4decaf6"
}

fn showcase() -> str {
    return "tests/ok/feat_stage147_rc2.hls"
}

fn showcase_out() -> str {
    return "stage 147: v1.0.0-rc.2\n"
        + "  RC2 laws OK: successor, stages, refusals, diff gate, "
        + "window\n"
}

# ----------------------------------------------------------------------------
# Port helpers — the battery's world builders and needle tools.
# ----------------------------------------------------------------------------

fn header(title: str) -> void uses IO {
    println("")
    println("--- " + title + " ---")
}

# rc(args) — the battery's rc(*argv, cwd=None): the child runs with the
# gate's cwd (the repo root); --root rides in args where the battery
# passes it.
fn rc(args: list[str]) -> RunResult uses Proc {
    return run_capture("./bin/hls-rc", args)
}

fn git(repo: str, args: list[str]) -> RunResult uses Proc {
    let argv: list[str] = ["-C", repo]
    let mut i: int = 0
    while i < args.len() {
        argv.push(args.get(i))
        i = i + 1
    }
    return run_capture("git", argv)
}

# wf(repo, rel, content) — write inside a world, parents made.
fn wf(repo: str, rel: str, content: str) -> void uses Fs, Proc {
    let p: str = path_join3(repo, rel)
    mkdirs(path_dir3(p))
    write_file(p, content)
}

fn rf(repo: str, rel: str) -> str uses Fs {
    return read_file(path_join3(repo, rel))
}

fn commit_all(repo: str, msg: str) -> str uses Proc {
    git(repo, ["add", "-A"])
    git(repo, ["commit", "-q", "-m", msg])
    let r: RunResult = git(repo, ["rev-parse", "HEAD"])
    return r.out.trim()
}

# JSON accessors with the battery's .get(key, default) semantics —
# std.json's typed accessors panic on a kind mismatch, so guard first.
fn jget_str(v: JsonValue, key: str) -> str {
    let x: JsonValue = json_object_get(v, key)
    if json_is_str(x) {
        return json_str_value(x)
    }
    return ""
}

fn jget_int(v: JsonValue, key: str) -> int {
    let x: JsonValue = json_object_get(v, key)
    if json_is_int(x) {
        return json_int_value(x)
    }
    return 0
}

fn parse_json_or_null(text: str) -> JsonValue {
    let rr: Result[JsonValue, str] = json_parse_result(text)
    if result_is_ok(rr) {
        return result_unwrap(rr)
    }
    return json_null()
}

# The candidate line's legal states, read off the real tree:
# 'eve' — the anchor stands, no line declared; 'released' — the
# anchor retired with the release commit and the LTS line is
# declared. Anything else is a half-cut release, and a half-cut
# release is not a state. This gate certified the line's middle;
# after the release it must still run — the kit inherits both ends.
fn release_state() -> str uses Fs {
    let anchor: bool = file_exists(".hls-rc.json")
    let line: bool = file_exists(".hls-lts.json")
    if anchor && !line {
        return "eve"
    }
    if line && !anchor {
        return "released"
    }
    return "half-cut"
}

# the head release of the tree's record — the first `## [v...]`
# line of RELEASES.md (the heading's version without the release `v`)
fn real_head_version() -> str uses Fs {
    let src: str = read_or("RELEASES.md", "")
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        if line.starts_with("## [v") {
            let end: int = line.find("]")
            let start: int = line.find("[v")
            if end > start {
                return line.slice(start + 2, end)
            }
        }
        i = i + 1
    }
    return ""
}

# ----------------------------------------------------------------------------
# The scratch worlds.
# ----------------------------------------------------------------------------

# roadmap(closed_through) — the stage table, live-shaped.
fn roadmap(closed_through: int) -> str {
    let rows: list[str] = []
    let mut n: int = 1
    while n <= 150 {
        let mut st: str = "⬜"
        if n <= closed_through {
            st = "✅"
        }
        rows.push("| " + n.to_str() + " | stage " + n.to_str()
            + " title | " + st + " | (done in v0.1.0) |")
        n = n + 1
    }
    return "# ROADMAP\n\n"
        + "| # | Stage | Status | Effort |\n"
        + "|---|-------|--------|--------|\n"
        + str_join(rows, "\n") + "\n"
}

# scratch_world(name, version, closed_through, with_anchor) — a
# minimal compliant world at changelog `version`, stages closed
# through closed_through; with_anchor cuts the matching candidate on
# paper (declare) so the tree carries an anchor.
fn scratch_world(acc: Acc, name: str, version: str, closed_through: int,
    with_anchor: bool) -> str uses IO, Fs, Proc, Exit {
    let repo: str = scratch(acc, name)
    mkdirs(repo)
    let init: RunResult = git(repo, ["init", "-q", "-b", "main"])
    if init.code != 0 {
        # a world that is not its own repository would commit into the
        # gate's OUTER repo — refuse loudly instead
        println("rc2-acceptance: git init failed in " + repo + " — "
            + init.err)
        exit(2)
    }
    wf(repo, "ROADMAP.md", roadmap(closed_through))
    wf(repo, "CHANGELOG.md",
        "## [v" + version + "] — the candidate\n- the body\n")
    wf(repo, "snapshot/MANIFEST.json",
        "{\"closure\": {}, \"version\": \"v" + version + "\"}")
    wf(repo, "editors/vscode/halis/package.json",
        "{\"name\": \"halis\", \"version\": \"" + version + "\"}")
    wf(repo, "LTS.md", "the promise\n")
    wf(repo, "snapshot/hlc.c", "int main(void){return 0;}\n")
    git(repo, ["add", "-A"])
    git(repo, ["commit", "-q", "-m", "seed"])
    let frozen: str = git(repo, ["rev-parse", "HEAD"]).out.trim()
    let freeze: str = "{\"digest\": \"" + freeze_digest()
        + "\", \"frozen_commit\": \"" + frozen
        + "\", \"release\": \"0.159.0-alpha\", \"stage\": 141"
        + ", \"surface\": {\"syntax\": {\"keywords\": [\"fn\"]}}"
        + ", \"surface_version\": 1, \"tool\": \"hls-freeze\"}"
    wf(repo, "tests/api_freeze.json", freeze)
    git(repo, ["add", "-A"])
    git(repo, ["commit", "-q", "-m", "the freeze document"])
    if with_anchor {
        let r: RunResult = rc(["declare", "--tag", "v" + version,
            "--root", repo])
        if r.code != 0 {
            fail_msg(acc, "scratch " + name + ": the base candidate did "
                + "not declare: " + clip(r.combined, 160))
        }
        git(repo, ["add", "-A"])
        git(repo, ["commit", "-q", "-m", "release: the base candidate"])
    }
    return repo
}

# ----------------------------------------------------------------------------
# 1. the regression law — the invocation errors refuse, named
# ----------------------------------------------------------------------------

fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    header("1. the regression law — the invocation errors refuse, named")
    let missing: str = path_join3(acc.scratch_base, "never-there.hls")

    let r: RunResult = boot(acc, [missing])
    check(acc, "boot.py: a missing entry file refuses (exit 2, was a "
        + "compile-error shape)", r.code == 2, "")
    check(acc, "boot.py: the refusal names the path on stderr",
        r.err.contains("error: cannot open file") && r.err.contains(missing),
        "")
    check(acc, "boot.py: no traceback, no panic — an invocation error is "
        + "not a crash",
        !r.err.contains("Traceback") && !r.err.contains("panic"), "")

    let r2: RunResult = run_capture("./bin/hlc",
        [missing, path_join3(acc.scratch_base, "out.c")])
    check(acc, "hlc: a missing input file refuses (exit 2, was panic 101)",
        r2.code == 2, "")
    check(acc, "hlc: the refusal names the path",
        r2.out.contains("error: cannot open file") && r2.out.contains(missing),
        "")
    check(acc, "hlc: no panic on the path the user named",
        !r2.combined.contains("panic"), "")

    let r3: RunResult = run_capture("./bin/hlc", ["--audit", missing])
    check(acc, "hlc --audit: the same refusal on the audit path",
        r3.code == 2 && r3.out.contains("error: cannot open file"), "")

    let hello: str = write_src(acc, "hello.hls",
        "fn main() -> int uses IO {\n    println(\"hello rc2\")\n"
        + "    return 0\n}\n")

    let r4: RunResult = run_capture("./bin/hlc",
        [hello, path_join3(acc.scratch_base, "no-such-dir/out.c")])
    check(acc, "hlc: an output destination without its directory refuses "
        + "up front (exit 2)",
        r4.code == 2 && r4.out.contains("cannot write file"), "")
    check(acc, "hlc: no post-codegen panic on the destination",
        !r4.combined.contains("panic"), "")

    let r5: RunResult = run_capture("./bin/hlc", ["--symbols",
        path_join3(acc.scratch_base, "no-such-dir/s.json"), hello,
        path_join3(acc.scratch_base, "out_ok.c")])
    check(acc, "hlc: the --symbols destination refuses the same way",
        r5.code == 2 && r5.out.contains("cannot write file"), "")

    # the broken pipe: the interpreter dies like the native binary.
    # The battery Popen'd boot.py into `head -1`; a shell pipeline is
    # the same act — the pipeline's stderr (boot.py's, head writes
    # nothing) lands in a scratch file the gate reads back.
    let errfile: str = scratch(acc, "pipe-err.txt")
    let boot_py: str = path_join3(acc.root, "tools/hlinterp/boot.py")
    let pipe_cmd: str = "(python3 '" + shell_quote(boot_py) + "' '"
        + shell_quote(hello) + "' | head -1 > /dev/null) 2>'"
        + shell_quote(errfile) + "'"
    sh(pipe_cmd)
    let err: str = read_or(errfile, "")
    check(acc, "boot.py: a closed stdout pipe dies silently (the native "
        + "shape), no traceback",
        !err.contains("BrokenPipeError") && !err.contains("Traceback"), "")
}

# ----------------------------------------------------------------------------
# 2. the working paths — the refusals did not eat the road
# ----------------------------------------------------------------------------

fn sec2(acc: Acc) -> void uses IO, Fs, Proc {
    header("2. the working paths — the refusals did not eat the road")
    let hello: str = path_join3(acc.scratch_base, "hello.hls")
    let r: RunResult = boot(acc, [hello])
    check(acc, "boot.py: a program still runs",
        r.code == 0 && r.out.contains("hello rc2"), "")
    let r2: RunResult = boot(acc, ["--check", hello])
    check(acc, "boot.py: --check still holds",
        r2.code == 0 && r2.out.contains("OK"), "")
    if file_exists("bin/hlc") && which("gcc") {
        let out_c: str = scratch(acc, "hello.c")
        let r3: RunResult = run_capture("./bin/hlc", [hello, out_c])
        check(acc, "hlc: a program still compiles", r3.code == 0, "")
        let r4: RunResult = run_capture("./bin/hlc", ["--audit", hello])
        check(acc, "hlc: --audit still audits", r4.code == 0, "")
    }
}

# ----------------------------------------------------------------------------
# 3. the real-tree candidate laws — the freeze holds
# ----------------------------------------------------------------------------

fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    header("3. the real-tree candidate laws — the freeze holds")
    let r: RunResult = rc(["readiness"])
    if release_state() == "released" {
        check(acc, "the REAL tree is released (readiness refuses on both "
            + "laws, named)",
            r.code == 1 && r.out.contains("NOT READY: the roadmap law")
                && r.out.contains("NOT READY: the lts law"), "")
        let g: RunResult = rc(["gate"])
        check(acc, "the gate refuses on the missing anchor (retired with "
            + "the release commit)",
            g.code == 1 && g.combined.contains("no anchor"), "")
    } else {
        check(acc, "the REAL tree is ready",
            r.code == 0 && r.out.contains("READY"), "")
        let g: RunResult = rc(["gate"])
        check(acc, "the gate over the live range names only BUGFIX and CHORE",
            g.code == 0, "")
    }
    let head_v: str = real_head_version()
    let man_v: str = jget_str(parse_json_or_null(read_or(
        "snapshot/MANIFEST.json", "")), "version")
    let vs_v: str = jget_str(parse_json_or_null(read_or(
        "editors/vscode/halis/package.json", "")), "version")
    check(acc, "the three markers speak with one voice (" + head_v + ")",
        man_v == "v" + head_v && vs_v == head_v,
        "manifest=" + man_v + " vscode=" + vs_v)
}

# ----------------------------------------------------------------------------
# 4. the successor rehearsal — the RC2 cut on a scratch world
# ----------------------------------------------------------------------------

fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    header("4. the successor rehearsal — the RC2 cut on a scratch world")
    let repo: str = scratch_world(acc, "rc2-rehearsal", "1.0.0-rc.1", 146,
        true)
    let anchor_before: JsonValue = parse_json_or_null(
        rf(repo, ".hls-rc.json"))
    check(acc, "the scratch world carries the rc.1 anchor",
        jget_str(anchor_before, "tag") == "v1.0.0-rc.1", "")
    check(acc, "the anchor names rc.2 as the successor",
        jget_str(anchor_before, "next") == "v1.0.0-rc.2", "")

    # the RC2 choreography: Stage 147 ticked, the markers moved, the
    # old anchor leaves with the release commit
    wf(repo, "ROADMAP.md", roadmap(147))
    wf(repo, "CHANGELOG.md",
        "## [v1.0.0-rc.2] — Stage 147: the bug-fix round\n- the body\n")
    wf(repo, "snapshot/MANIFEST.json",
        "{\"closure\": {}, \"version\": \"v1.0.0-rc.2\"}")
    wf(repo, "editors/vscode/halis/package.json",
        "{\"name\": \"halis\", \"version\": \"1.0.0-rc.2\"}")
    git(repo, ["rm", "-q", ".hls-rc.json"])
    let rc1_sha: str = jget_str(anchor_before, "sha")
    commit_all(repo, "docs: stage 147 markers, the successor line")

    let r: RunResult = rc(["declare", "--tag", "v1.0.0-rc.2", "--root", repo])
    check(acc, "rc.2 declares on the successor line (the old anchor left "
        + "with the release commit)", r.code == 0, "")
    if r.code != 0 {
        println(clip(r.combined, 400))
    } else {
        let anchor: JsonValue = parse_json_or_null(rf(repo, ".hls-rc.json"))
        check(acc, "the fresh anchor records rc.2 at Stage 147",
            jget_str(anchor, "tag") == "v1.0.0-rc.2"
                && jget_int(anchor, "stage") == 147, "")
        check(acc, "the successor of rc.2 is rc.3",
            jget_str(anchor, "next") == "v1.0.0-rc.3", "")
        let rr: RunResult = rc(["report", "--out", "RC.md", "--root", repo])
        check(acc, "the record renders from the fresh anchor",
            rr.code == 0, "")
        commit_all(repo, "release: v1.0.0-rc.2 anchored, the record rendered")
        let rg: RunResult = rc(["gate", "--range", rc1_sha + "..HEAD",
            "--root", repo])
        check(acc, "the gate over the whole rc.1..rc.2 range is green",
            rg.code == 0, "")
        let rc3: RunResult = rc(["report", "--check", "--root", repo])
        check(acc, "the record is the anchored render (drift refused)",
            rc3.code == 0, "")
    }
}

# ----------------------------------------------------------------------------
# 5. the corpus showcase — the RC2 laws in pure HLS
# ----------------------------------------------------------------------------

fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    header("5. the corpus showcase — the RC2 laws in pure HLS")
    # the formatter's canonical form, checked directly
    let fmt_out: RunResult = run_capture("./bin/hlfmt", [showcase()])
    let src: str = read_file(showcase())
    check(acc, "the showcase is hlfmt-canonical",
        fmt_out.code == 0 && fmt_out.out == src, "")
    let lint: RunResult = run_capture("python3",
        ["tools/hllint.py", showcase()])
    check(acc, "the showcase is hllint-clean",
        lint.code == 0 && lint.out.contains("no warnings"), "")
    let chk: RunResult = boot(acc, ["--check", showcase()])
    check(acc, "the showcase passes the real checker", chk.code == 0, "")
    let run: RunResult = boot(acc, [showcase()])
    check(acc, "the showcase runs green on the interpreter",
        run.code == 0 && run.out == showcase_out(), "")
    if file_exists("bin/hlc") && which("gcc") {
        let out_c: str = scratch(acc, "showcase.c")
        let comp: RunResult = run_capture("./bin/hlc", [showcase(), out_c])
        if comp.code != 0 {
            fail_msg(acc, "the showcase does not compile natively: "
                + clip(comp.combined, 160))
        } else {
            let binp: str = scratch(acc, "showcase")
            let link: RunResult = run_capture("gcc",
                ["-O2", "-o", binp, out_c, "-lm", "-pthread"])
            if link.code != 0 {
                fail_msg(acc, "the showcase binary does not link")
            } else {
                let nat: RunResult = run_capture(binp, [])
                check(acc, "the showcase matches natively, byte for byte",
                    nat.code == 0 && nat.out == showcase_out(), "")
            }
        }
    }
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    # the battery's GIT_ENV — every child (git, the kit) sees the
    # pinned identity and the pinned committer day
    env_set_var("GIT_AUTHOR_NAME", "rc147-gate")
    env_set_var("GIT_AUTHOR_EMAIL", "rc147-gate@example.invalid")
    env_set_var("GIT_COMMITTER_NAME", "rc147-gate")
    env_set_var("GIT_COMMITTER_EMAIL", "rc147-gate@example.invalid")
    env_set_var("GIT_COMMITTER_DATE", "2026-10-28T09:00:00+00:00")
    env_set_var("GIT_AUTHOR_DATE", "2026-10-28T09:00:00+00:00")
    let acc: Acc = acc_new("rc2")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    return finish(acc, "Stage 147 -- v1.0.0-rc.2, the bug-fix round")
}
