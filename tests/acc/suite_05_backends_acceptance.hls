# ============================================================================
# tests/acc/suite_05_backends_acceptance.hls — the backends suite, in Halis.
# ----------------------------------------------------------------------------
# The Halis twin of the old tests/suites/suite_05_backends.sh (a sourced
# fragment of the original run_tests.sh): same sections, same tools, same
# needles — the harness is tests/acc/harness.hls and the gate runs native,
# built by bin/hlc.
#
# The old suite shared the bash $TMP and the ok()/bad() counters; this gate
# is standalone: every probe lives under tests/.acc-scratch/suite_05_backends/
# (wiped fresh by acc_new) and check() counts automatically. The native
# compiler the suite chains through (the old $TMP/hlc1) is rebuilt here when
# the legs need it. The bash `PASS=$((PASS+1))` node-less skips are kept as
# silent pass increments (skip_pass) so the totals line up branch for branch.
#
#  10. Stage 22 cross    — hlcross targets/host/rejection, the host-target
#                          differential, portable-C hygiene, the foreign
#                          SKIP path, hls-pkg lock/verify --target, the
#                          cross-acceptance gate
#  11. Stage 23 wasm     — hlwasm targets, the <10 KB hello.wasm, glue
#                          budgets, the node differential, extern "js"
#                          imports, clean unsupported-construct errors
#  12. Stage 24 wasm-opt — hlwasm_opt reductions, the optimized run, the
#                          CLI flags, the hls-pkg wasm32 build, the 1000
#                          -LOC webapp budgets, hlserve + hlwasm_pack
#                          surfaces, the serve/wasm-pack gates
#  13. Stage 25 aarch64  — NEON intrinsics + guard + x86 fallback, the
#                          hlcross/hlaarch64 surfaces, pac+bti, the NEON
#                          bootstrap determinism
# ============================================================================

import "./harness.hls"
import "std.str"

# ----------------------------------------------------------------------------
# The shared native-compiler build (the old $TMP/hlc1): Stage-0 interprets
# the compiler source over itself, gcc links the result. Every leg that
# needs a native hlc goes through this; the second caller reuses the path.
# ----------------------------------------------------------------------------

fn hlc1_path(acc: Acc) -> str uses Proc {
    return scratch(acc, "hlc1")
}

fn build_hlc1(acc: Acc, name: str) -> str uses IO, Fs, Proc {
    let hlc1: str = hlc1_path(acc)
    if file_exists(hlc1) {
        return hlc1
    }
# The suite driver prebuilds ONE native compiler for every gate
    # (snapshot/hlc.c under gcc) and exports its path in
    # HL_TEST_HLC1. The fixed-point law (make bootstrap, pinned in
    # suite_01) makes that binary exactly the one this gate would
    # build here from the interpreter's own emission, so sharing it
    # saves one interpreter self-compile per gate without changing
    # what the legs verify. A standalone gate run (no driver, no
    # var) falls through to the in-gate build below unchanged.
    let shared: str = env_get("HL_TEST_HLC1")
    if shared != "" && file_exists(shared) {
        return shared
    }
    println("  [..] building the native compiler (" + name + ")")
    let s1: str = scratch(acc, "hlc_nat.c")
    let r: RunResult = run_capture("python3",
        ["tools/hlinterp/boot.py", "src/hlc.hls", "src/hlc.hls", s1])
    if r.code != 0 {
        return ""
    }
    if run_capture("gcc", ["-O2", "-o", hlc1, s1, "-lm", "-pthread"]).code != 0 {
        return ""
    }
    return hlc1
}

# c_has(path, needle) — grep -q via the grep binary.
fn c_has(path: str, needle: str) -> bool uses Proc {
    return run_capture("grep", ["-q", needle, path]).code == 0
}

# c_has_any(path, needles) — the bash `grep -q "a\|b\|..."` alternation.
fn c_has_any(path: str, needles: list[str]) -> bool uses Proc {
    let mut i: int = 0
    while i < needles.len() {
        if c_has(path, needles.get(i)) {
            return true
        }
        i = i + 1
    }
    return false
}

# file_contains(path, needle) — grep without spawning (small text files:
# lockfiles, logs, generated JS glue).
fn file_contains(path: str, needle: str) -> bool uses Fs {
    return read_file(path).contains(needle)
}

# parse_uint(s) — the digits of s as an int (0 when none).
fn parse_uint(s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
        }
        i = i + 1
    }
    return v
}

# count_matching_lines(path, pattern) — grep -c on a file via the binary.
fn count_matching_lines(path: str, pattern: str) -> int uses Proc {
    let r: RunResult = run_capture("grep", ["-c", pattern, path])
    if r.code != 0 {
        return 0
    }
    return parse_uint(first_line(r.out))
}

# stat_size(path) — `stat -c %s` (0 when missing).
fn stat_size(path: str) -> int uses Proc {
    let r: RunResult = run_capture("stat", ["-c", "%s", path])
    if r.code != 0 {
        return 0
    }
    return parse_uint(first_line(r.out))
}

# is_triple(s) — the `grep -qE "^[a-z0-9_-]+$"` host-triple shape.
fn is_triple(s: str) -> bool {
    if s.len() == 0 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        let lower: bool = c >= 97 && c <= 122
        let digit: bool = c >= 48 && c <= 57
        if !lower && !digit && c != 95 && c != 45 {
            return false
        }
        i = i + 1
    }
    return true
}

# filter_prefixes(text, prefixes) — the `grep -v '^a' | grep -v '^b'`
# pipeline the wasm run differential uses.
fn filter_prefixes(text: str, prefixes: list[str]) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: str = ""
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        let mut dropped: bool = false
        let mut j: int = 0
        while j < prefixes.len() {
            if line.starts_with(prefixes.get(j)) {
                dropped = true
            }
            j = j + 1
        }
        if !dropped {
            out = out + line + "\n"
        }
        i = i + 1
    }
    return out
}

# reduction_positive(report) — the `grep -qE "reduction:\s+[1-9]"` probe:
# some line has `reduction:` followed by whitespace and a nonzero digit.
fn reduction_positive(report: str) -> bool {
    let lines: list[str] = report.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i)
        let at: int = line.find("reduction:")
        if at >= 0 {
            let mut j: int = at + "reduction:".len()
            while j < line.len() && (line.byte_at(j) == 32 || line.byte_at(j) == 9) {
                j = j + 1
            }
            if j < line.len() {
                let c: int = line.byte_at(j)
                if c >= 49 && c <= 57 {
                    return true
                }
            }
        }
        i = i + 1
    }
    return false
}

# skip_pass(acc, msg) — the bash `echo SKIP; PASS=$((PASS+1))`: counts a
# pass silently and names the skip, keeping the totals branch-for-branch.
fn skip_pass(acc: Acc, msg: str) -> void uses IO {
    acc.pass = acc.pass + 1
    println(msg)
}

# first_lines(text, n) — the `head -n` evidence idiom.
fn first_lines(text: str, n: int) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: str = ""
    let mut i: int = 0
    while i < lines.len() && i < n {
        out = out + lines.get(i) + "\n"
        i = i + 1
    }
    return out
}

# tail_lines(text, n) — the `tail -n` evidence idiom for fail details.
fn tail_lines(text: str, n: int) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: str = ""
    let mut start: int = lines.len() - n
    if start < 0 {
        start = 0
    }
    let mut i: int = start
    while i < lines.len() {
        if lines.get(i).trim() != "" {
            out = out + lines.get(i).trim() + " | "
        }
        i = i + 1
    }
    return out
}

# ----------------------------------------------------------------------------
# 10. Stage 22: cross-compilation targets (Linux/macOS/Windows/FreeBSD)
# ----------------------------------------------------------------------------

fn section_cross(acc: Acc) -> void uses IO, Fs, Proc {
    section("10. Stage 22: cross-compilation targets (Linux/macOS/Windows/FreeBSD)")

    let cross_f: str = "tests/ok/feat_stage22_cross.hls"
    let cross_interp: str = run_capture("python3",
        ["tools/hlinterp/boot.py", cross_f]).out

    # (a) the expected platform-independent output.
    check(acc, "cross: feat_stage22_cross platform-independent output correct",
          cross_interp.contains("1 + 1 = 2")
              && cross_interp.contains("10 * 10 = 100")
              && cross_interp.contains("str_to_upper_ascii('hello') = HELLO")
              && cross_interp.contains("sorted: 1,1,2,3,4,5,6,9"),
          clip(first_lines(cross_interp, 8), 120))

    # (b) --list-targets prints the Stage 22 target set.
    let list_out: str = run_capture("python3", ["tools/hlcross.py", "--list-targets"]).combined
    check(acc, "cross: --list-targets prints the Stage 22 target set",
          list_out.contains("x86_64-linux-gnu")
              && list_out.contains("aarch64-apple-darwin")
              && list_out.contains("x86_64-pc-windows-msvc")
              && list_out.contains("x86_64-unknown-freebsd"),
          "cross: --list-targets missing expected targets")

    # (c) --show-host prints a non-empty canonical triple.
    let host_triple: str = run_capture("python3",
        ["tools/hlcross.py", "--show-host"]).out.trim()
    check(acc, "cross: --show-host detected '" + host_triple + "'",
          host_triple != "" && is_triple(host_triple),
          "cross: --show-host did not return a triple")

    # (d) an unknown target is rejected with a clear error.
    let d: RunResult = run_capture("python3",
        ["tools/hlcross.py", cross_f, "/tmp/bad_cross", "--target", "foo-bar-baz"])
    check(acc, "cross: unknown target rejected with clear error",
          d.combined.contains("unknown target"),
          "cross: unknown target not rejected")

    # (e) cross-compile to the HOST target; the binary must match the
    # interpreter and the C must stay portable.
    let hlc1: str = build_hlc1(acc, "cross section")
    let cross_host: str = scratch(acc, "cross_host")
    let cross_host_c: str = scratch(acc, "cross_host.c")
    let e: RunResult = run_capture("python3",
        ["tools/hlcross.py", cross_f, cross_host, "--target", host_triple,
         "--hlc", hlc1, "--keep-c", cross_host_c])
    if e.code == 0 {
        let host_out: str = run_capture(cross_host, []).out
        check(acc, "cross: host-target binary output == interpreter (byte-identical)",
              host_out.trim() == cross_interp.trim(),
              "cross: host-target binary diverged from interpreter " + clip(host_out, 80))
        let mut leaked: list[str] = []
        leaked.push("hl_simd_add_i32x4")
        leaked.push("hl_simd_mul_i32x4")
        leaked.push("_mm_mullo_epi32")
        leaked.push("__hlc_pgo_counts")
        leaked.push("__builtin_expect")
        check(acc, "cross: C source is portable (no PGO/SIMD intrinsic machinery in unflagged build)",
              !c_has_any(cross_host_c, leaked),
              "cross: C source leaked target-specific machinery (PGO/SIMD intrinsics)")
    } else {
        check(acc, "cross: host-target binary output == interpreter (byte-identical)",
              false, "cross: host-target cross-compile failed " + clip(e.combined, 120))
    }

    # (f) cross-compile to a FOREIGN target — no cross-linker means SKIP
    # (exit 3) with the C source still written.
    let foreign: str = "aarch64-apple-darwin"
    if host_triple != foreign {
        let cross_foreign: str = scratch(acc, "cross_foreign")
        let cross_foreign_c: str = scratch(acc, "cross_foreign.c")
        let f: RunResult = run_capture("python3",
            ["tools/hlcross.py", cross_f, cross_foreign,
             "--target", foreign, "--hlc", hlc1,
             "--keep-c", cross_foreign_c])
        if f.code == 0 {
            let fmt: RunResult = run_capture("python3",
                ["-c", "import sys; sys.path.insert(0, 'tools')\n"
                    + "from hlcross import detect_binary_format\n"
                    + "print(detect_binary_format('" + cross_foreign + "'))"])
            check(acc, "cross: " + foreign + " binary produced (format: "
                        + fmt.out.trim() + ") — cross-linker available",
                  true, "")
        } else if f.code == 3 {
            check(acc, "cross: " + foreign + " SKIP (no cross-linker) — C source written for target-side compilation",
                  stat_size(cross_foreign_c) > 0,
                  "cross: " + foreign + " SKIP but no C source written")
        } else {
            check(acc, "cross: " + foreign + " SKIP (no cross-linker) — C source written for target-side compilation",
                  false, "cross: " + foreign + " failed unexpectedly (rc="
                      + f.code.to_str() + ") " + clip(f.combined, 120))
        }
    }

    # (g) hls-pkg lock --target stamps the lockfile with the target triple.
    let pkg: str = scratch(acc, "stage22_pkg")
    mkdirs(pkg)
    write_file(path_join3(pkg, "hls-pkg.toml"),
        "[package]\n"
            + "name = \"stage22-test\"\n"
            + "version = \"0.1.0\"\n"
            + "authors = [\"test\"]\n"
            + "description = \"Stage 22 lockfile target test\"\n"
            + "[dependencies]\n"
            + "[effects]\n"
            + "allowed = []\n")
    write_file(path_join3(pkg, "main.hls"),
        "fn main() -> int uses IO {\n"
            + "    println(\"stage22 pkg\")\n"
            + "    return 0\n"
            + "}\n")
    sh("cd '" + shell_quote(pkg) + "' && python3 '"
        + shell_quote(path_join3(acc.root, "tools/hls-pkg.py"))
        + "' lock --target aarch64-apple-darwin >pkg.log 2>&1")
    check(acc, "cross: hls-pkg lock --target stamps the lockfile",
          file_contains(path_join3(pkg, "hls-pkg.lock"),
                        "\"target\": \"aarch64-apple-darwin\""),
          "cross: hls-pkg lock --target did not stamp the lockfile "
              + clip(read_or(path_join3(pkg, "pkg.log"), ""), 120))

    # (h) hls-pkg verify --target checks the lockfile's target matches.
    sh("cd '" + shell_quote(pkg) + "' && python3 '"
        + shell_quote(path_join3(acc.root, "tools/hls-pkg.py"))
        + "' verify --target aarch64-apple-darwin >pkg_verify.log 2>&1")
    check(acc, "cross: hls-pkg verify --target matches",
          file_contains(path_join3(pkg, "pkg_verify.log"),
                        "lockfile target: aarch64-apple-darwin (matches --target)"),
          "cross: hls-pkg verify --target did not match "
              + clip(read_or(path_join3(pkg, "pkg_verify.log"), ""), 120))

    # (i) hls-pkg verify --target detects a mismatch.
    let i_rc: int = sh("cd '" + shell_quote(pkg) + "' && python3 '"
        + shell_quote(path_join3(acc.root, "tools/hls-pkg.py"))
        + "' verify --target x86_64-pc-windows-gnu >pkg_mismatch.log 2>&1")
    check(acc, "cross: hls-pkg verify --target detects mismatch (rejected)",
          i_rc != 0 && file_contains(path_join3(pkg, "pkg_mismatch.log"),
                                     "lockfile target mismatch"),
          "cross: hls-pkg verify --target did not detect mismatch "
              + clip(read_or(path_join3(pkg, "pkg_mismatch.log"), ""), 120))

    # (j) make cross-acceptance runs end-to-end on the host target.
    let j: RunResult = run_capture("make", ["cross-acceptance"])
    check(acc, "cross: make cross-acceptance runs end-to-end (host target)",
          j.code == 0 && j.combined.contains("ACCEPTANCE OK: cross-compilation pipeline"),
          clip(tail_lines(j.combined, 5), 120))
}

# ----------------------------------------------------------------------------
# 11. Stage 23: WebAssembly backend (wasm32-unknown-unknown)
# ----------------------------------------------------------------------------

fn section_wasm(acc: Acc) -> void uses IO, Fs, Proc {
    section("11. Stage 23: WebAssembly backend (wasm32-unknown-unknown)")

    let wasm_f: str = "examples/hello.hls"

    # (a) --list-targets prints the wasm target set.
    let wl: RunResult = run_capture("python3", ["tools/hlwasm.py", "--list-targets"])
    check(acc, "wasm: --list-targets prints the Stage 23 target set",
          wl.combined.contains("wasm32-unknown-unknown")
              && wl.combined.contains("wasm32-unknown-emscripten"),
          "wasm: --list-targets missing expected targets")

    # (b) hello.hls compiles to a <10 KB wasm binary.
    let hello_base: str = scratch(acc, "hello_wasm")
    let b: RunResult = run_capture("python3",
        ["tools/hlwasm.py", wasm_f, hello_base])
    if b.code == 0 {
        let wasm_size: int = stat_size(hello_base + ".wasm")
        check(acc, "wasm: hello.hls compiles to " + wasm_size.to_str() + "-byte wasm (< 10 KB)",
              wasm_size < 10240 && wasm_size > 0,
              "wasm: hello.hls wasm is " + wasm_size.to_str() + " bytes (>= 10 KB)")
        # (c) .js and .html glue files are produced (and the jsffi-free
        # glue stays under 5 KB).
        if file_exists(hello_base + ".js") && file_exists(hello_base + ".html") {
            check(acc, "wasm: .js + .html glue files produced", true, "")
            let js_size: int = stat_size(hello_base + ".js")
            check(acc, "wasm: jsffi-free glue is " + js_size.to_str() + "-byte (< 5 KB, tree-shaken)",
                  js_size < 5120 && js_size > 0,
                  "wasm: jsffi-free glue is " + js_size.to_str() + " bytes (>= 5 KB)")
        } else {
            check(acc, "wasm: .js + .html glue files produced",
                  false, "wasm: .js or .html glue missing")
        }
    } else {
        check(acc, "wasm: hello.hls compiles to 0-byte wasm (< 10 KB)",
              false, "wasm: hello.hls compile failed " + clip(b.combined, 120))
    }

    # (d) running the wasm in Node.js matches the interpreter (skipped
    # gracefully without node).
    if which("node") {
        let interp_out: str = run_capture("python3",
            ["tools/hlinterp/boot.py", wasm_f]).out
        let run_base: str = scratch(acc, "hello_wasm2")
        let d: RunResult = run_capture("python3",
            ["tools/hlwasm.py", wasm_f, run_base, "--run"])
        if d.code == 0 {
            let mut prefixes: list[str] = []
            prefixes.push("wrote ")
            prefixes.push("note:")
            prefixes.push("wasm-opt: ")
            let wasm_out: str = filter_prefixes(d.combined, prefixes)
            check(acc, "wasm: hello.hls wasm output == interpreter (byte-identical)",
                  interp_out.trim() == wasm_out.trim(),
                  "wasm: hello.hls wasm output differs from interpreter "
                      + clip(wasm_out, 80))
        } else {
            check(acc, "wasm: hello.hls wasm output == interpreter (byte-identical)",
                  false, "wasm: hello.hls wasm run failed " + clip(d.combined, 120))
        }
    } else {
        skip_pass(acc, "  [SKIP] wasm: node.js not installed (output-match test skipped)")
    }

    # (e) extern "js" blocks are accepted by the parser.
    let jsffi_hls: str = write_src(acc, "test_jsffi.hls",
        "extern \"js\" {\n"
            + "    fn js_alert(msg: str) -> void uses IO\n"
            + "    fn js_random() -> int uses IO\n"
            + "}\n"
            + "fn main() -> int uses IO {\n"
            + "    js_alert(\"hello\")\n"
            + "    # Deep-scan-13 fix: CALL js_random too — the wasm-opt dead-import\n"
            + "    # elimination correctly removes an import that is never used.\n"
            + "    let r: int = js_random() % 2\n"
            + "    return r\n"
            + "}\n")
    let e: RunResult = run_capture("python3",
        ["tools/hlinterp/boot.py", "--check", jsffi_hls])
    check(acc, "wasm: extern \"js\" block accepted by the parser/checker",
          e.code == 0, "wasm: extern \"js\" block rejected")

    # (f) compiling a program with extern "js" produces the right wasm imports.
    let jsffi_base: str = scratch(acc, "test_jsffi")
    let f: RunResult = run_capture("python3",
        ["tools/hlwasm.py", jsffi_hls, jsffi_base])
    if f.code == 0 {
        let probe: RunResult = run_capture("python3",
            ["-c", "import sys\n"
                + "with open('" + jsffi_base + ".wasm', 'rb') as fh:\n"
                + "    data = fh.read()\n"
                + "# Look for the import names in the binary.\n"
                + "assert b'js_alert' in data, 'js_alert import missing'\n"
                + "assert b'js_random' in data, 'js_random import missing'\n"
                + "print('OK')\n"])
        check(acc, "wasm: extern \"js\" functions become wasm imports",
              probe.code == 0 && probe.combined.contains("OK"),
              "wasm: extern \"js\" imports not found in wasm " + clip(probe.combined, 120))
    } else {
        check(acc, "wasm: extern \"js\" functions become wasm imports",
              false, "wasm: compile of extern \"js\" program failed " + clip(f.combined, 120))
    }

    # (g) unsupported constructs raise clean errors (not silent crashes).
    let unsupp_hls: str = write_src(acc, "test_unsupp.hls",
        "struct Point { x: int, y: int }\n"
            + "fn main() -> int uses IO {\n"
            + "    let p: Point = Point { x: 1, y: 2 }\n"
            + "    return 0\n"
            + "}\n")
    let unsupp_base: str = scratch(acc, "test_unsupp")
    let g: RunResult = run_capture("python3",
        ["tools/hlwasm.py", unsupp_hls, unsupp_base])
    check(acc, "wasm: unsupported construct raises clean error",
          g.combined.contains("not yet supported by --emit wasm"),
          "wasm: unsupported construct did not raise clean error")

    # (h) make wasm-acceptance runs end-to-end.
    let h: RunResult = run_capture("make", ["wasm-acceptance"])
    check(acc, "wasm: make wasm-acceptance runs end-to-end",
          h.code == 0 && h.combined.contains("ACCEPTANCE OK"),
          clip(tail_lines(h.combined, 5), 120))
}

# ----------------------------------------------------------------------------
# 12. Stage 24: wasm-opt integration + emscripten bridge
# ----------------------------------------------------------------------------

fn section_wasm24(acc: Acc) -> void uses IO, Fs, Proc {
    section("12. Stage 24: wasm-opt integration + emscripten bridge")

    # (a) hlwasm_opt --report on hello.wasm produces a real size reduction.
    let hello24: str = scratch(acc, "hello_wasm24")
    let hello24_opt: str = scratch(acc, "hello_wasm24_opt")
    let a1: RunResult = run_capture("python3",
        ["tools/hlwasm.py", "examples/hello.hls", hello24, "--wasm-opt", "off"])
    let a2: RunResult = run_capture("python3",
        ["tools/hlwasm_opt.py", hello24 + ".wasm", hello24_opt + ".wasm", "--report"])
    if a1.code == 0 && a2.code == 0 {
        check(acc, "wasm24: hlwasm_opt reduces hello.wasm size (reduction > 0%)",
              reduction_positive(a2.combined),
              "wasm24: hlwasm_opt reported 0% reduction " + clip(a2.combined, 120))
    } else {
        check(acc, "wasm24: hlwasm_opt reduces hello.wasm size (reduction > 0%)",
              false, "wasm24: hlwasm_opt failed " + clip(a2.combined, 120))
    }

    # (b) the optimized wasm still runs correctly (skipped without node).
    if which("node") {
        let interp_out: str = run_capture("python3",
            ["tools/hlinterp/boot.py", "examples/hello.hls"]).out
        let run24: str = scratch(acc, "hello_wasm24_run")
        let b: RunResult = run_capture("python3",
            ["tools/hlwasm.py", "examples/hello.hls", run24, "--wasm-opt", "auto"])
        if b.code == 0 {
            let node: RunResult = run_capture("node", ["-e",
                "const fs=require('fs');\n"
                    + "const w=fs.readFileSync('" + run24 + ".wasm');\n"
                    + "const g=fs.readFileSync('" + run24 + ".js','utf-8');\n"
                    + "eval(g);\n"
                    + "Halis.run(new Uint8Array(w)).then(c=>{}).catch(e=>{console.error(e.message);process.exit(1);});\n"])
            check(acc, "wasm24: optimized hello.wasm output == interpreter (byte-identical)",
                  node.out.trim() == interp_out.trim(),
                  "wasm24: optimized hello.wasm output differs from interpreter "
                      + clip(node.out, 80))
        } else {
            check(acc, "wasm24: optimized hello.wasm output == interpreter (byte-identical)",
                  false, "wasm24: optimized hello.hls compile failed")
        }
    } else {
        skip_pass(acc, "  [SKIP] wasm24: node.js not installed (output-match test skipped)")
    }

    # (c) the --wasm-opt CLI flag accepts auto/on/off.
    let c1: RunResult = run_capture("python3",
        ["tools/hlwasm.py", "examples/hello.hls", scratch(acc, "wasm24_off"),
         "--wasm-opt", "off"])
    let c2: RunResult = run_capture("python3",
        ["tools/hlwasm.py", "examples/hello.hls", scratch(acc, "wasm24_on"),
         "--wasm-opt", "on"])
    let c3: RunResult = run_capture("python3",
        ["tools/hlwasm.py", "examples/hello.hls", scratch(acc, "wasm24_auto"),
         "--wasm-opt", "auto"])
    check(acc, "wasm24: --wasm-opt flag accepts auto/on/off",
          c1.code == 0 && c2.code == 0 && c3.code == 0,
          "wasm24: --wasm-opt flag failed")

    # (d) the --glue flag accepts compact/verbose (compact is smaller).
    let gc: str = scratch(acc, "wasm24_glue_c")
    let gv: str = scratch(acc, "wasm24_glue_v")
    let d1: RunResult = run_capture("python3",
        ["tools/hlwasm.py", "examples/hello.hls", gc, "--glue", "compact"])
    let d2: RunResult = run_capture("python3",
        ["tools/hlwasm.py", "examples/hello.hls", gv, "--glue", "verbose"])
    if d1.code == 0 && d2.code == 0 {
        let compact_size: int = stat_size(gc + ".js")
        let verbose_size: int = stat_size(gv + ".js")
        check(acc, "wasm24: --glue compact (" + compact_size.to_str()
                    + " B) < verbose (" + verbose_size.to_str() + " B)",
              compact_size < verbose_size && compact_size > 0,
              "wasm24: --glue compact not smaller than verbose")
    } else {
        check(acc, "wasm24: --glue compact (0 B) < verbose (0 B)",
              false, "wasm24: --glue flag failed")
    }

    # (e) hls-pkg build --target wasm32 runs (uses hlwasm + wasm-opt).
    let pkg24: str = scratch(acc, "stage24_pkg")
    mkdirs(pkg24)
    write_file(path_join3(pkg24, "hls-pkg.toml"),
        "[package]\n"
            + "name = \"stage24-test\"\n"
            + "version = \"0.1.0\"\n"
            + "description = \"Stage 24 test package.\"\n")
    write_file(path_join3(pkg24, "main.hls"),
        "fn main() -> int uses IO {\n"
            + "    println(\"Stage 24 hls-pkg wasm32 build\")\n"
            + "    return 0\n"
            + "}\n")
    let e_rc: int = sh("cd '" + shell_quote(pkg24) + "' && python3 '"
        + shell_quote(path_join3(acc.root, "tools/hls-pkg.py"))
        + "' build --target wasm32-unknown-unknown >pkg.log 2>&1")
    if e_rc == 0 {
        check(acc, "wasm24: hls-pkg build --target wasm32 produces .wasm",
              file_exists(path_join3(pkg24, ".hls-pkg-build/pkg_wasm.wasm")),
              "wasm24: hls-pkg build --target wasm32 did not produce .wasm "
                  + clip(tail_lines(read_or(path_join3(pkg24, "pkg.log"), ""), 3), 120))
    } else {
        check(acc, "wasm24: hls-pkg build --target wasm32 produces .wasm",
              false, "wasm24: hls-pkg build --target wasm32 failed "
                  + clip(tail_lines(read_or(path_join3(pkg24, "pkg.log"), ""), 5), 120))
    }

    # (f) the 1000-LOC web app: LOC, wasm + glue budgets, wasm-opt reduction.
    let webapp_loc: int = count_lines(read_or("examples/web_app_1000loc.hls", ""))
    check(acc, "wasm24: examples/web_app_1000loc.hls is " + webapp_loc.to_str() + " LOC (>= 1000)",
          webapp_loc >= 1000,
          "wasm24: examples/web_app_1000loc.hls is only " + webapp_loc.to_str() + " LOC (< 1000)")

    let webapp: str = scratch(acc, "webapp24")
    let wf: RunResult = run_capture("python3",
        ["tools/hlwasm.py", "examples/web_app_1000loc.hls", webapp])
    if wf.code == 0 {
        let wasm_size: int = stat_size(webapp + ".wasm")
        let js_size: int = stat_size(webapp + ".js")
        check(acc, "wasm24: webapp wasm is " + wasm_size.to_str() + " bytes (< 100 KB)",
              wasm_size < 102400 && wasm_size > 0,
              "wasm24: webapp wasm is " + wasm_size.to_str() + " bytes (>= 100 KB)")
        check(acc, "wasm24: webapp JS glue is " + js_size.to_str() + " bytes (< 8 KB, tree-shaken jsffi stubs)",
              js_size < 8192 && js_size > 0,
              "wasm24: webapp JS glue is " + js_size.to_str() + " bytes (>= 8 KB)")
        let noopt: str = scratch(acc, "webapp24_noopt")
        let no: RunResult = run_capture("python3",
            ["tools/hlwasm.py", "examples/web_app_1000loc.hls", noopt,
             "--wasm-opt", "off"])
        if no.code == 0 {
            let raw_size: int = stat_size(noopt + ".wasm")
            let pct: RunResult = run_capture("python3",
                ["-c", "print(round((" + raw_size.to_str() + " - " + wasm_size.to_str()
                    + ") * 100.0 / " + raw_size.to_str() + ", 1))"])
            let gate: RunResult = run_capture("python3",
                ["-c", "import sys; sys.exit(0 if " + pct.out.trim() + " >= 25.0 else 1)"])
            check(acc, "wasm24: wasm-opt reduction is " + pct.out.trim() + "% (>= 25%)",
                  gate.code == 0,
                  "wasm24: wasm-opt reduction is " + pct.out.trim() + "% (< 25%)")
            check(acc, "wasm24: optimized webapp wasm is " + wasm_size.to_str() + " bytes (< 10 KB absolute)",
                  wasm_size < 10240,
                  "wasm24: optimized webapp wasm is " + wasm_size.to_str() + " bytes (>= 10 KB absolute)")
        } else {
            check(acc, "wasm24: wasm-opt reduction is 0% (>= 25%)",
                  false, "wasm24: --wasm-opt off build failed")
        }
    } else {
        check(acc, "wasm24: webapp wasm is 0 bytes (< 100 KB)",
              false, "wasm24: webapp compile failed " + clip(wf.combined, 120))
    }

    # (g) the compact JS glue includes the struct-marshalling API.
    check(acc, "wasm24: compact JS glue includes struct-marshalling API",
          file_exists(webapp + ".js")
              && file_contains(webapp + ".js", "H.readStruct")
              && file_contains(webapp + ".js", "H.writeStruct")
              && file_contains(webapp + ".js", "H.registerStruct"),
          "wasm24: compact JS glue missing struct-marshalling API")

    # (h) make webapp-acceptance runs end-to-end.
    let h: RunResult = run_capture("make", ["webapp-acceptance"])
    check(acc, "wasm24: make webapp-acceptance runs end-to-end",
          h.code == 0 && h.combined.contains("ACCEPTANCE OK"),
          clip(tail_lines(h.combined, 5), 120))

    # (i) hlserve (dev server) imports without error and has a main().
    let i: RunResult = run_capture("python3",
        ["-c", "import sys; sys.path.insert(0, 'tools'); import hlserve; assert hasattr(hlserve, 'main'); print('OK')"])
    check(acc, "wasm24: tools/hlserve.py imports and has main()",
          i.combined.contains("OK"), "wasm24: tools/hlserve.py import failed")

    # (i-bis) Stage 75: the modular hlserve_parts/ package keeps the
    # Stage 24 surface and accepts the new CLI flags.
    let i2: RunResult = run_capture("python3", ["-c",
        "import sys\n"
            + "sys.path.insert(0, 'tools')\n"
            + "import hlserve\n"
            + "# Stage 24 compat surface.\n"
            + "assert hasattr(hlserve, 'main'), 'missing main'\n"
            + "assert hasattr(hlserve, 'compile_bundle'), 'missing compile_bundle'\n"
            + "assert hasattr(hlserve, 'FileWatcher'), 'missing FileWatcher'\n"
            + "assert hasattr(hlserve, 'EventBus'), 'missing EventBus'\n"
            + "assert hasattr(hlserve, 'DevHTTPHandler'), 'missing DevHTTPHandler'\n"
            + "assert hasattr(hlserve, 'DevServer'), 'missing DevServer'\n"
            + "# Stage 75 new modules are importable as top-level modules.\n"
            + "sys.path.insert(0, 'tools/hlserve_parts')\n"
            + "import hlserve_cli, hlserve_common, hlserve_config, hlserve_watcher\n"
            + "import hlserve_compiler, hlserve_hmr, hlserve_overlay, hlserve_proxy\n"
            + "import hlserve_tls, hlserve_server\n"
            + "# CLI parser accepts the new flags.\n"
            + "ap = hlserve_cli.build_arg_parser()\n"
            + "args = ap.parse_args(['--open', '--https', '--proxy', '/api=http://localhost:3001'])\n"
            + "assert args.open is True\n"
            + "assert args.https is True\n"
            + "assert args.proxy == ['/api=http://localhost:3001']\n"
            + "print('OK')\n"])
    check(acc, "wasm75: hlserve Stage 24 surface preserved + 10 new modules + new CLI flags",
          i2.combined.contains("OK"), "wasm75: hlserve Stage 75 surface check failed")

    # (i-ter) Stage 75: the serve-acceptance smoke test passes end-to-end.
    let i3: RunResult = run_capture("make", ["serve-acceptance"])
    check(acc, "wasm75: make serve-acceptance runs end-to-end (10 test sections)",
          i3.code == 0 && i3.combined.contains("ACCEPTANCE OK: Stage 75"),
          clip(tail_lines(i3.combined, 5), 120))

    # (j) Stage 76: the hls-wasm-pack publish pipeline surface.
    let j: RunResult = run_capture("python3", ["-c",
        "import sys\n"
            + "sys.path.insert(0, 'tools')\n"
            + "import hlwasm_pack\n"
            + "assert hasattr(hlwasm_pack, 'main'), 'missing main'\n"
            + "sys.path.insert(0, 'tools/hlwasm_pack_parts')\n"
            + "import hwp_common, hwp_manifest, hwp_scan, hwp_types, hwp_glue\n"
            + "import hwp_build, hwp_pack, hwp_publish, hwp_validate, hwp_cli\n"
            + "# CLI parser accepts all six subcommands.\n"
            + "# Deep-scan-28 fix: catch SystemExit so the demo scan + validator\n"
            + "# asserts actually execute.\n"
            + "ap = hwp_cli.build_arg_parser()\n"
            + "for sub in ('new', 'build', 'pack', 'publish', 'check', 'test'):\n"
            + "    try:\n"
            + "        ap.parse_args([sub, '--help'])\n"
            + "    except SystemExit:\n"
            + "        pass\n"
            + "# The demo scans to the expected publish surface.\n"
            + "surface = hwp_scan.scan_file('examples/wasm_pack_demo.hls')\n"
            + "names = {f['name'] for f in surface['functions']}\n"
            + "assert {'pack_add', 'pack_greet', 'pack_axis_name', 'pack_sum_to'} <= names, names\n"
            + "assert any(s['name'] == 'Vec2' for s in surface['structs'])\n"
            + "assert any(e['name'] == 'Axis' for e in surface['enums'])\n"
            + "# TS mapping spot-checks.\n"
            + "assert hwp_types.halis_to_ts('list[int]') == 'Array<number>'\n"
            + "assert hwp_types.halis_to_ts('Option[str]') == 'string | null'\n"
            + "# Name/version validators.\n"
            + "assert hwp_manifest.is_valid_name('@myorg/my-lib')\n"
            + "assert not hwp_manifest.is_valid_name('../escape')\n"
            + "assert hwp_manifest.is_valid_version('0.95.0-alpha')\n"
            + "assert not hwp_manifest.is_valid_version('1.2')\n"
            + "print('OK')\n"])
    check(acc, "wasm76: hlwasm_pack surface + 10 new modules + demo scan + validators",
          j.combined.contains("OK"), "wasm76: hlwasm_pack Stage 76 surface check failed")

    # (j-bis) Stage 76: the wasm-pack-acceptance suite passes end-to-end.
    let j2: RunResult = run_capture("make", ["wasm-pack-acceptance"])
    check(acc, "wasm76: make wasm-pack-acceptance runs end-to-end (10 test sections)",
          j2.code == 0 && j2.combined.contains("ACCEPTANCE OK: Stage 76"),
          clip(tail_lines(j2.combined, 5), 120))
}

# ----------------------------------------------------------------------------
# 13. Stage 25: AArch64 backend tuning (NEON + PAC + BTI)
# ----------------------------------------------------------------------------

fn section_aarch64(acc: Acc) -> void uses IO, Fs, Proc {
    section("13. Stage 25: AArch64 backend tuning (NEON + PAC + BTI)")

    # (a)-(d) the Stage-0 compiler emits NEON intrinsics under
    # --target-feature neon; the C still compiles + runs on x86_64.
    let neon_c: str = scratch(acc, "simd_neon.c")
    let a: RunResult = run_capture("python3",
        ["tools/hlinterp/boot.py", "src/hlc.hls", "examples/simd_demo.hls",
         neon_c, "--target-feature", "neon"])
    if a.code == 0 {
        let neon_count: int = count_matching_lines(neon_c,
            "vaddq_s32\\|vsubq_s32\\|vmulq_s32\\|vminq_s32\\|vmaxq_s32")
        check(acc, "aarch64: --target-feature neon emits NEON intrinsics (" + neon_count.to_str() + " sites)",
              neon_count > 0,
              "aarch64: --target-feature neon did not emit any NEON intrinsics")
        check(acc, "aarch64: --target-feature neon includes <arm_neon.h>",
              c_has(neon_c, "<arm_neon.h>"),
              "aarch64: <arm_neon.h> not included in NEON C source")
        check(acc, "aarch64: C source has __aarch64__/__ARM_NEON__ guard",
              c_has(neon_c, "defined(__aarch64__)")
                  || c_has(neon_c, "defined(__ARM_NEON__)"),
              "aarch64: missing __aarch64__/__ARM_NEON__ guard")
        let x86_bin: str = scratch(acc, "simd_neon_x86")
        if run_capture("gcc",
                ["-O2", "-o", x86_bin, neon_c, "-lm", "-pthread"]).code == 0 {
            check(acc, "aarch64: NEON C source compiles + runs on x86_64 (scalar fallback)",
                  run_capture(x86_bin, []).code == 0,
                  "aarch64: NEON C source compiles on x86_64 but doesn't run cleanly")
        } else {
            check(acc, "aarch64: NEON C source compiles + runs on x86_64 (scalar fallback)",
                  false, "aarch64: NEON C source fails to compile on x86_64")
        }
    } else {
        check(acc, "aarch64: --target-feature neon emits NEON intrinsics (0 sites)",
              false, "aarch64: --target-feature neon compile failed")
    }

    # (e) hlcross --list-targets prints the AArch64 target set.
    let list_out: str = run_capture("python3", ["tools/hlcross.py", "--list-targets"]).combined
    check(acc, "aarch64: hlcross --list-targets includes AArch64 targets",
          list_out.contains("aarch64-linux-gnu")
              && list_out.contains("aarch64-apple-darwin"),
          "aarch64: hlcross --list-targets missing AArch64 targets")

    # (f) hlcross accepts the aarch64 alias.
    let f: RunResult = run_capture("python3",
        ["tools/hlcross.py", "examples/hello.hls", scratch(acc, "aarch64_alias"),
         "--target", "aarch64", "--keep-c", scratch(acc, "aarch64_alias.c")])
    check(acc, "aarch64: hlcross accepts the 'aarch64' alias",
          f.combined.contains("no cross-linker found")
              || f.combined.contains("ELF aarch64"),
          "aarch64: hlcross did not accept the 'aarch64' alias")

    # (g) the hlaarch64.py helper exists and has a main().
    let g: RunResult = run_capture("python3",
        ["-c", "import sys; sys.path.insert(0, 'tools'); import hlaarch64; assert hasattr(hlaarch64, 'main'); print('OK')"])
    check(acc, "aarch64: tools/hlaarch64.py imports and has main()",
          g.combined.contains("OK"), "aarch64: tools/hlaarch64.py import failed")

    # (h) hlaarch64 --list-targets prints the security levels.
    let h: RunResult = run_capture("python3", ["tools/hlaarch64.py", "--list-targets"])
    check(acc, "aarch64: hlaarch64 --list-targets prints pac+bti + bti security levels",
          h.combined.contains("pac-ret+bti") && h.combined.contains("bti"),
          "aarch64: hlaarch64 --list-targets missing security levels")

    # (i) hlaarch64 compiles simd_bench.hls with NEON + PAC+BTI (exit 0
    # or the no-cross-linker SKIP 3 — the C source is written either way).
    let bench_c: str = scratch(acc, "aarch64_bench.c")
    let i: RunResult = run_capture("python3",
        ["tools/hlaarch64.py", "benchmarks/simd_bench.hls",
         scratch(acc, "aarch64_bench"), "--target", "aarch64-linux-gnu",
         "--target-feature", "neon", "--security", "pac+bti",
         "--keep-c", bench_c])
    if i.code == 0 || i.code == 3 {
        check(acc, "aarch64: hlaarch64 produces C source with NEON intrinsics + arm_neon.h",
              (c_has(bench_c, "vaddq_s32")
                  || c_has(bench_c, "vsubq_s32")
                  || c_has(bench_c, "vmulq_s32"))
                  && c_has(bench_c, "<arm_neon.h>"),
              "aarch64: hlaarch64 C source missing NEON intrinsics")
    } else {
        check(acc, "aarch64: hlaarch64 produces C source with NEON intrinsics + arm_neon.h",
              false, "aarch64: hlaarch64 compile failed unexpectedly " + clip(i.combined, 120))
    }

    # (j) make aarch64-acceptance runs end-to-end.
    let j: RunResult = run_capture("make", ["aarch64-acceptance"])
    check(acc, "aarch64: make aarch64-acceptance runs end-to-end",
          j.code == 0 && j.combined.contains("ACCEPTANCE OK"),
          clip(tail_lines(j.combined, 5), 120))

    # (k) bootstrap still deterministic with the NEON changes (the flag
    # does not touch hlc.hls's own codegen).
    let k1_c: str = scratch(acc, "hlc_neon.c")
    let k2_c: str = scratch(acc, "hlc_neon2.c")
    let k1: RunResult = run_capture("python3",
        ["tools/hlinterp/boot.py", "src/hlc.hls", "src/hlc.hls", k1_c])
    let k2: RunResult = run_capture("python3",
        ["tools/hlinterp/boot.py", "src/hlc.hls", "src/hlc.hls", k2_c,
         "--target-feature", "neon"])
    check(acc, "aarch64: bootstrap deterministic with --target-feature neon",
          k1.code == 0 && k2.code == 0
              && run_capture("cmp", ["-s", k1_c, k2_c]).code == 0,
          "aarch64: bootstrap not deterministic with --target-feature neon")
}

# ----------------------------------------------------------------------------
# main
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Fs, Proc, Exit {
    let acc: Acc = acc_new("suite_05_backends")
    section_cross(acc)
    section_wasm(acc)
    section_wasm24(acc)
    section_aarch64(acc)
    return finish(acc, "suite 05 -- backends (cross, wasm, wasm-opt, aarch64)")
}
