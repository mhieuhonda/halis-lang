# ============================================================================
# tests/acc/serve_acceptance.hls — Stage 75 acceptance gate, in Halis
# (same ten sections, same laws, same needles as the Python-era
# battery that retired with the dev server's .py — the harness is
# tests/acc/harness.hls, the gate runs native, built by bin/hlc, and
# every unit question goes through the tool's own --probe front door
# while the end-to-end legs spawn the REAL bin/hlserve server and
# drive it with this gate's own raw TCP clients).
# ----------------------------------------------------------------------------
# Run with `make serve-acceptance`.
#
#  1. Import surface (Stage 24 compat) — the facade + 10 components
#  2. CLI parser — the typical invocation's parsed values
#  3. Config file (hls.serve.toml / .json) + proxy-spec parsing
#  4. WebSocket handshake + frames (RFC 6455 vector, frame bytes)
#  5. FileWatcher fires on change (real server, real recompile)
#  6. Compile diagnostic parsing + the overlay dict shape
#  7. Overlay injection (before </body>, disabled = unchanged, banner)
#  8. Proxy rule longest-prefix lookup
#  9. End-to-end HTTP (real server): /, /out.wasm, /static, SPA
#     fallback, /source, 404, failed-compile banner
# 10. End-to-end WebSocket handshake (101, accept key, hello frame)
#
# The HTTP and WebSocket clients are THIS GATE'S OWN code (std.net):
# the battery's urllib/raw-socket helpers, retired with the .py.
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.json"
import "std.result"
import "std.net"
import "std.time"
import "std.thread"
import "std.base64"
import "std.sha256"

# ----------------------------------------------------------------------------
# The battery's check grammar (names verbatim, [OK]/[FAIL] flags).
# ----------------------------------------------------------------------------

fn chk(acc: Acc, name: str, okc: bool, detail: str) -> bool uses IO {
    return check(acc, name, okc, detail)
}

# ----------------------------------------------------------------------------
# Process plumbing: free ports, spawn, wait-for-port, kill by pid.
# ----------------------------------------------------------------------------

fn srv_probe(argv: list[str]) -> RunResult uses Proc {
    let full: list[str] = []
    full.push("--probe")
    let mut i: int = 0
    while i < argv.len() {
        full.push(argv.get(i))
        i = i + 1
    }
    return run_capture("./bin/hlserve", full)
}

# srv_free_port — a port the gate can hand to a server: bind, close,
# return. The .py era's bind(('127.0.0.1', 0)) race, unchanged.
fn srv_free_port() -> int uses Net, Clock {
    let mut p: int = 20000 + int_and(time_now_seconds(), 8191)
    let mut tries: int = 0
    while tries < 500 {
        let r: Result[TcpListener, str] = tcp_listen_or("127.0.0.1", p,
        1)
        if result_is_ok(r) {
            let l: TcpListener = result_unwrap(r)
            l.close()
            return p
        }
        p = p + 1
        if p >= 40000 {
            p = 20000
        }
        tries = tries + 1
    }
    return 0
}

# srv_wait_port — poll until something accepts, 5 s deadline.
fn srv_wait_port(port: int) -> bool uses Net, Clock, Conc {
    let deadline: int = time_now_seconds() + 5
    while time_now_seconds() < deadline {
        let r: Result[TcpStream, str] = tcp_connect_or("127.0.0.1", port)
        if result_is_ok(r) {
            let s: TcpStream = result_unwrap(r)
            s.close()
            return true
        }
        thread_sleep_ms(100)
    }
    return false
}

# srv_kill — SIGTERM the child, SIGKILL as the backstop.
fn srv_kill(pid: int) -> void uses Proc, Clock, Conc {
    let _a: RunResult = run_capture("kill", [pid.to_str()])
    thread_sleep_ms(300)
    let _b: RunResult = run_capture("kill", ["-9", pid.to_str()])
}

# ----------------------------------------------------------------------------
# The gate's own HTTP client (the battery's urllib helper, retired).
# ----------------------------------------------------------------------------

struct HttpResp {
    status: int,
    ctype: str,
    cenc: str,
    body: str
}

# srv_fetch — GET with optional extra headers, read to EOF (the dev
# server answers Connection: close), parse the response.
fn srv_fetch(port: int, path: str, extra_headers: list[str]) -> HttpResp
uses Net {
    let out: HttpResp = HttpResp {
        status: 0, ctype: "", cenc: "",
        body: ""
    }
    let cr: Result[TcpStream, str] = tcp_connect_or("127.0.0.1", port)
    if result_is_err(cr) {
        return out
    }
    let s: TcpStream = result_unwrap(cr)
    let crlf: str = chr(13) + "\n"
    let mut req: str = "GET " + path + " HTTP/1.1" + crlf
    + "Host: localhost" + crlf
    + "Connection: close" + crlf
    let mut i: int = 0
    while i < extra_headers.len() {
        req = req + extra_headers.get(i) + crlf
        i = i + 1
    }
    req = req + crlf
    let _w: int = net_write(s.fd, req)
    let mut resp: str = ""
    let mut chunk: str = s.read(65536)
    let mut rounds: int = 0
    while chunk != "" && rounds < 512 {
        resp = resp + chunk
        chunk = s.read(65536)
        rounds = rounds + 1
    }
    s.close()
    # parse: status line, headers, body after the blank line.
    let sep: int = resp.find(crlf + crlf)
    if sep < 0 {
        return out
    }
    let head: str = resp.slice(0, sep)
    let mut body: str = resp.slice(sep + 4, resp.len())
    let lines: list[str] = head.split(crlf)
    if lines.len() > 0 {
        let parts: list[str] = lines.get(0).split(" ")
        if parts.len() >= 2 && is_digits_s(parts.get(1)) {
            out.status = to_int_s(parts.get(1))
        }
    }
    let mut j: int = 1
    while j < lines.len() {
        let line: str = lines.get(j)
        let colon: int = line.find(":")
        if colon > 0 {
            let name: str = str_to_lower_ascii(line.slice(0, colon)
            .trim())
            let val: str = line.slice(colon + 1, line.len()).trim()
            if name == "content-type" {
                out.ctype = val
            } else if name == "content-encoding" {
                out.cenc = val
            } else if name == "transfer-encoding" {
                # chunked bodies would need de-chunking; the dev
                # server always sends Content-Length. Kept for
                # robustness.
                if val == "chunked" {
                    body = srv_dechunk(body)
                }
            }
        }
        j = j + 1
    }
    out.body = body
    return out
}

# srv_dechunk — HTTP/1.1 chunked transfer decoding.
fn srv_dechunk(body: str) -> str {
    let crlf: str = chr(13) + "\n"
    let mut out: str = ""
    let mut rest: str = body
    while true {
        let line_end: int = rest.find(crlf)
        if line_end < 0 {
            break
        }
        let size_line: str = rest.slice(0, line_end)
        let semi: int = size_line.find(";")
        let mut size_txt: str = size_line
        if semi >= 0 {
            size_txt = size_line.slice(0, semi)
        }
        if !is_digits_s(size_txt.trim()) {
            break
        }
        let n: int = to_int_s(size_txt.trim())
        rest = rest.slice(line_end + 2, rest.len())
        if n == 0 {
            break
        }
        if rest.len() < n {
            out = out + rest
            rest = ""
            break
        }
        out = out + rest.slice(0, n)
        rest = rest.slice(n, rest.len())
        if rest.starts_with(crlf) {
            rest = rest.slice(2, rest.len())
        }
    }
    return out
}

# srv_ws_handshake — the raw RFC 6455 client: send the upgrade,
# read the 101, return (response_head, hello_frame_json_or_empty).
fn srv_ws_handshake(port: int) -> list[str] uses Net {
    let out: list[str] = []
    let cr: Result[TcpStream, str] = tcp_connect_or("127.0.0.1", port)
    if result_is_err(cr) {
        out.push("")
        out.push("")
        return out
    }
    let s: TcpStream = result_unwrap(cr)
    let crlf: str = chr(13) + "\n"
    let req: str = "GET /ws HTTP/1.1" + crlf
    + "Host: localhost" + crlf
    + "Upgrade: websocket" + crlf
    + "Connection: Upgrade" + crlf
    + "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==" + crlf
    + "Sec-WebSocket-Version: 13" + crlf + crlf
    let _w: int = net_write(s.fd, req)
    let mut resp: str = ""
    let mut chunk: str = s.read(4096)
    let mut rounds: int = 0
    while chunk != "" && rounds < 32 {
        resp = resp + chunk
        chunk = s.read(4096)
        rounds = rounds + 1
    }
    let blank: int = resp.find(crlf + crlf)
    if blank < 0 {
        out.push("")
        out.push("")
        s.close()
        return out
    }
    let head: str = resp.slice(0, blank)
    out.push(head)
    # the hello frame follows the handshake in the same read.
    let rest: str = resp.slice(blank + 4, resp.len())
    if rest.len() >= 2 {
        let b0: int = rest.byte_at(0)
        let b1: int = rest.byte_at(1)
        let plen: int = int_and(b1, 127)
        if int_and(b0, 15) == 1 && rest.len() >= 2 + plen {
            out.push(rest.slice(2, 2 + plen))
        } else {
            out.push("")
        }
    } else {
        out.push("")
    }
    s.close()
    return out
}

fn is_digits_s(s: str) -> bool {
    if s.len() == 0 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        if s.byte_at(i) < 48 || s.byte_at(i) > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

fn to_int_s(s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        v = v * 10 + (s.byte_at(i) - 48)
        i = i + 1
    }
    return v
}

# ----------------------------------------------------------------------------
# Spawn plumbing — a server in its own scratch world, its log on a
# file the gate greps.
# ----------------------------------------------------------------------------

struct SrvProc {
    pid: int,
    port: int,
    dir: str,
    log: str,
    wlog: str # the watcher child's own log (bundle_dir/watch.log)
}

# srv_spawn_server — the caller pre-builds the world; the log goes
# next to it so the watcher's chatter is greppable.
fn srv_spawn_server(acc: Acc, dir: str, input: str, bundle: str,
public_dir: str, port: int) -> SrvProc uses Proc {
    let log: str = path_join3(dir, "server.log")
    # the pre-compile, the server's own initial compile done from
    # outside: same backend (bin/hlwasm), same arguments. The server
    # then runs with --no-compile --no-watch: it spawns nothing, and
    # the watcher is armed as a SIBLING loop (see srv_arm_watcher).
    let cargs: list[str] = []
    cargs.push("--target")
    cargs.push("wasm32-unknown-unknown")
    cargs.push("--glue")
    cargs.push("compact")
    cargs.push(input)
    cargs.push(bundle)
    let _c: RunResult = run_capture("./bin/hlwasm", cargs)
    let args: list[str] = []
    args.push("--input")
    args.push(input)
    args.push("--bundle")
    args.push(bundle)
    args.push("--port")
    args.push(port.to_str())
    args.push("--listen")
    args.push("127.0.0.1:" + port.to_str())
    if public_dir != "" {
        args.push("--public-dir")
        args.push(public_dir)
    }
    args.push("--history-fallback")
    args.push("--compress")
    args.push("--overlay")
    args.push("--no-color")
    args.push("--no-compile")
    args.push("--no-watch")
    # stdout+stderr -> the log file, via sh (the .py era's
    # subprocess redirect, same shape).
    let mut cmd: str = "exec './bin/hlserve'"
    let mut i: int = 0
    while i < args.len() {
        cmd = cmd + " '" + shell_quote(args.get(i)) + "'"
        i = i + 1
    }
    cmd = cmd + " > '" + shell_quote(log) + "' 2>&1"
    let argv: list[str] = []
    argv.push("-c")
    argv.push(cmd)
    let pid: int = proc_spawn("sh", argv, 2, 2, 2)
    let wlog: str = path_join3(bundle_dir_of(bundle), "watch.log")
    let sp: SrvProc = SrvProc {
        pid: pid, port: port, dir: dir,
        log: log,
        wlog: wlog
    }
    return sp
}

# srv_arm_watcher — the sibling watch loop: a sh loop re-arming
# bin/hlserve --watch-poll every debounce until the server pid dies.
# The job json is the same document the server's own --no-watch off
# path would have written.
fn srv_arm_watcher(acc: Acc, sp: SrvProc, input: str, bundle: str,
debounce_ms: int) -> void uses Fs, Proc {
    let job_path: str = path_join3(bundle_dir_of(bundle),
    ".hlserve-watch.json")
    let dvals: list[JsonValue] = []
    dvals.push(json_str(bundle_dir_of(input)))
    dvals.push(json_str("."))
    let keys: list[str] = []
    let vals: list[JsonValue] = []
    keys.push("dirs")
    vals.push(json_array(dvals))
    keys.push("input")
    vals.push(json_str(input))
    keys.push("bundle_dir")
    vals.push(json_str(bundle_dir_of(bundle)))
    keys.push("bundle_base")
    vals.push(json_str(bundle_name_of(bundle)))
    keys.push("target")
    vals.push(json_str("wasm32-unknown-unknown"))
    keys.push("wasm_opt")
    vals.push(json_str("auto"))
    keys.push("glue")
    vals.push(json_str("compact"))
    keys.push("log")
    vals.push(json_str(sp.wlog))
    write_file(job_path, json_stringify(json_object(keys, vals)))
    let cmd: str = "while kill -0 " + sp.pid.to_str()
    + " 2>/dev/null; do ./bin/hlserve --watch-poll '"
    + shell_quote(job_path) + "' >>'" + shell_quote(sp.wlog)
    + "' 2>&1; sleep 0.2; done"
    let wargv: list[str] = []
    wargv.push("-c")
    wargv.push(cmd)
    let _w: int = proc_spawn("sh", wargv, 2, 2, 2)
}

# bundle_name_of — the bundle path's base name.
fn bundle_name_of(bundle: str) -> str {
    let mut i: int = bundle.len() - 1
    while i >= 0 {
        if bundle.byte_at(i) == 47 {
            return bundle.slice(i + 1, bundle.len())
        }
        i = i - 1
    }
    return bundle
}

# bundle_dir_of — the bundle path's directory (the watcher child's
# log lives there: <bundle>/watch.log).
fn bundle_dir_of(bundle: str) -> str {
    let mut i: int = bundle.len() - 1
    while i >= 0 {
        if bundle.byte_at(i) == 47 {
            return bundle.slice(0, i)
        }
        i = i - 1
    }
    return "."
}

# ----------------------------------------------------------------------------
# The sections.
# ----------------------------------------------------------------------------

fn s1_surface(acc: Acc) -> void uses IO, Proc {
    section("1. the import surface (Stage 24 compat)")
    let r: RunResult = srv_probe(["surface"])
    let names: list[str] = []
    names.push("main")
    names.push("compile_bundle")
    names.push("FileWatcher")
    names.push("EventBus")
    names.push("DevHTTPHandler")
    names.push("DevServer")
    let mut i: int = 0
    while i < names.len() {
        chk(acc, "public export present: " + names.get(i),
        r.out.contains("has " + names.get(i) + "=1"), r.out)
        i = i + 1
    }
    let mods: list[str] = []
    mods.push("hlserve_cli")
    mods.push("hlserve_common")
    mods.push("hlserve_config")
    mods.push("hlserve_watcher")
    mods.push("hlserve_compiler")
    mods.push("hlserve_hmr")
    mods.push("hlserve_overlay")
    mods.push("hlserve_proxy")
    mods.push("hlserve_tls")
    mods.push("hlserve_server")
    i = 0
    while i < mods.len() {
        chk(acc, "component present: " + mods.get(i),
        r.out.contains("mod " + mods.get(i) + "=1"), "")
        i = i + 1
    }
    chk(acc, "the probe exits 0", r.code == 0, r.err)
}

fn s2_cli(acc: Acc) -> void uses IO, Proc {
    section("2. the CLI parser")
    let r: RunResult = srv_probe(["parse-args", "--input",
    "examples/hello.hls", "--port", "3000", "--open", "--proxy",
    "/api=http://localhost:3001"])
    chk(acc, "the typical invocation parses --input",
    r.out.contains("input=examples/hello.hls"), r.out)
    chk(acc, "the typical invocation parses --port",
    r.out.contains("port=3000"), "")
    chk(acc, "--open parses as a boolean flag",
    r.out.contains("open=1"), "")
    chk(acc, "--proxy parses into the rule list",
    r.out.contains("proxy=['/api=http://localhost:3001']"), "")
    let d: RunResult = srv_probe(["parse-args"])
    chk(acc, "defaults hold without flags",
    d.out.contains("input=examples/hello.hls")
    && d.out.contains("port=3000") && d.out.contains("open=0"),
    d.out)
}

fn s3_config(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. the config file (TOML + JSON) + proxy specs")
    let toml: str = scratch(acc, "hls.serve.toml")
    write_file(toml, "# the dev server's config\n"
    + "input = \"app.hls\"\n"
    + "port = 8081\n"
    + "open = true\n"
    + "https = false\n"
    + "\n[watch]\n"
    + "dirs = [\"src\", \"std\"]\n"
    + "debounce_ms = 250\n"
    + "\n[[proxy]]\n"
    + "path = \"/api\"\n"
    + "target = \"http://localhost:3001\"\n")
    let rt: RunResult = srv_probe(["config", toml])
    chk(acc, "the TOML config parses: input", rt.code == 0
    && rt.out.contains("cfg_input=app.hls"), rt.out + rt.err)
    chk(acc, "the TOML config parses: port",
    rt.out.contains("cfg_port=8081"), "")
    chk(acc, "the TOML config parses: open",
    rt.out.contains("cfg_open=1"), "")
    chk(acc, "the TOML config parses: watch dirs",
    rt.out.contains("cfg_watch=src,std"), "")
    chk(acc, "the TOML config parses: debounce",
    rt.out.contains("cfg_debounce=250"), "")
    chk(acc, "the TOML config parses: proxy rows",
    rt.out.contains("cfg_nproxy=1")
    && rt.out.contains("cfg_proxy0=/api=http://localhost:3001"),
    "")

    let json_path: str = scratch(acc, "hls.serve.json")
    write_file(json_path, "{\"input\": \"app.json.hls\", "
    + "\"port\": 9090, \"open\": false, \"watch\": "
    + "{\"dirs\": [\"src\"], \"debounce_ms\": 300}}")
    let rj: RunResult = srv_probe(["config", json_path])
    chk(acc, "the JSON config parses: input", rj.code == 0
    && rj.out.contains("cfg_input=app.json.hls"), rj.out + rj.err)
    chk(acc, "the JSON config parses: port + debounce",
    rj.out.contains("cfg_port=9090")
    && rj.out.contains("cfg_debounce=300"), "")

    let rp: RunResult = srv_probe(["proxy-spec"])
    chk(acc, "a proxy spec parses into prefix + target",
    rp.out.contains("prefix=/api")
    && rp.out.contains("target=http://localhost:3001"), rp.out)
    chk(acc, "two specs parse", rp.out.contains("nspecs=2"), "")
    chk(acc, "a malformed spec is rejected",
    rp.out.contains("malformed=1"), "")
    chk(acc, "a target without a scheme is rejected",
    rp.out.contains("scheme=1"), "")
}

fn s4_ws_unit(acc: Acc) -> void uses IO, Proc {
    section("4. the WebSocket handshake + frames (RFC 6455)")
    let r: RunResult = srv_probe(["ws-unit"])
    chk(acc, "the handshake answers 101 Switching Protocols",
    r.out.contains("HTTP/1.1 101 Switching Protocols"), r.out)
    chk(acc, "the RFC 6455 §4.2.2 vector: Sec-WebSocket-Accept",
    r.out.contains("Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo="),
    "")
    chk(acc, "the handshake carries Upgrade + Connection",
    r.out.contains("Upgrade: websocket")
    && r.out.contains("Connection: Upgrade"), "")
    chk(acc, "a text frame encodes FIN+opcode 0x1",
    r.out.contains("frame0=129"), "")
    chk(acc, "a short payload encodes its length inline",
    r.out.contains("frame1=5") && r.out.contains("fpayload=hello"),
    "")
    chk(acc, "a 200-byte payload switches to the 16-bit length",
    r.out.contains("longb1=126") && r.out.contains("longext=200"),
    "")
}

fn s5_watcher(acc: Acc) -> void uses IO, Fs, Proc, Net, Clock, Conc {
    section("5. the file watcher (real server, real recompile)")
    let dir: str = scratch(acc, "watch")
    mkdirs(dir)
    let port: int = srv_free_port()
    let input: str = path_join3(dir, "a.hls")
    write_file(input, "fn main() -> int {\n    return 0\n}\n")
    let sp: SrvProc = srv_spawn_server(acc, dir, input,
    path_join3(dir, "out"), "", port)
    srv_arm_watcher(acc, sp, input, path_join3(dir, "out"), 200)
    let up: bool = srv_wait_port(port)
    chk(acc, "the server comes up on a free port", up && sp.pid > 0,
    "")
    # the seeded file must NOT fire (the table was seeded at
    # construction): one debounce cycle of quiet.
    thread_sleep_ms(1000)
    let log1: str = read_file(sp.log)
    chk(acc, "the seeded file fires nothing",
    !log1.contains("recompiling"), log1)
    # the rewrite fires ONE recompile naming the file (the content
    # changes, so the poller sees it whatever the mtime granularity).
    write_file(input, "fn main() -> int {\n    return 0\n}\n\n"
    + "// a touch comment so the poller sees the change\n")
    let mut fired: bool = false
    let mut tries: int = 0
    while tries < 30 && !fired {
        thread_sleep_ms(200)
        fired = read_file(sp.log).contains("recompiling")
        tries = tries + 1
    }
    chk(acc, "the rewrite fires a recompile", fired,
    read_file(sp.log))
    let log2: str = read_file(sp.log)
    chk(acc, "the recompile names the changed file",
    log2.contains("changed: a.hls"), log2)
    srv_kill(sp.pid)
}

fn s6_diag(acc: Acc) -> void uses IO, Proc {
    section("6. the diagnostic parser + the overlay dict shape")
    let r: RunResult = srv_probe(["diag"])
    chk(acc, "three diagnostics parse from the sample",
    r.out.contains("ndiag=3"), r.out)
    chk(acc, "error with file:line:col",
    r.out.contains("diag=error|examples/foo.hls|12|5|undefined variable `x`"),
    "")
    chk(acc, "warning with file:line:col",
    r.out.contains("diag=warning|examples/foo.hls|13|1|unused import"),
    "")
    chk(acc, "note with file:line (col 0)",
    r.out.contains("diag=note|examples/foo.hls|14|0|see previous declaration"),
    "")
    chk(acc, "non-diagnostic lines are skipped (wrote out.wasm)",
    !r.out.contains("wrote out.wasm"), "")
    chk(acc, "non-diagnostic lines are skipped (no file:line)",
    !r.out.contains("random line"), "")
    chk(acc, "the overlay dict shape (json.dumps separators)",
    r.out.contains("odict={\"severity\": \"error\", \"file\": \"f.hls\", \"line\": 7, \"col\": 3, \"message\": \"boom\"}"),
    "")
}

fn s7_overlay(acc: Acc) -> void uses IO, Proc {
    section("7. the overlay injection")
    let r: RunResult = srv_probe(["overlay"])
    let hin: str = value_after(r.out, "hin=")
    let o1: str = value_after(r.out, "o1=")
    let o2: str = value_after(r.out, "o2=")
    let o3: str = value_after(r.out, "o3=")
    let snip: str = value_after(r.out, "snip=")
    chk(acc, "the probe answers (base64 vectors)",
    hin != "" && o1 != "" && o2 != "" && o3 != "" && snip != "",
    r.out)
    chk(acc, "the HMR client snippet is identified",
    snip.starts_with("<script id=\"hlserve-hmr-client\">"), snip)
    let o1_html: str = base64_decode(o1)
    let hin_html: str = base64_decode(hin)
    chk(acc, "the snippet is injected before </body>",
    o1_html.contains(snip) && o1_html.contains("</body>"), "")
    chk(acc, "the original markup is preserved",
    o1_html.contains("<p>hi</p>"), "")
    chk(acc, "--no-overlay leaves the page byte-identical",
    o2 == hin, "")
    let o3_html: str = base64_decode(o3)
    chk(acc, "the status banner carries the compile failure",
    o3_html.contains("[hls-serve] compile failed"), o3_html)
    chk(acc, "the banner sits at the top of <body>",
    o3_html.contains("<body><div style=\"background:#fee"),
    o3_html)
}

fn s8_proxy(acc: Acc) -> void uses IO, Proc {
    section("8. the proxy rule longest-prefix lookup")
    let r: RunResult = srv_probe(["proxy-lookup"])
    chk(acc, "/api/v2/users hits the longest prefix",
    r.out.contains("m /api/v2/users=http://b:2"), r.out)
    chk(acc, "/api/users falls back to the shorter prefix",
    r.out.contains("m /api/users=http://a:1"), "")
    chk(acc, "/nope matches nothing",
    r.out.contains("m /nope=None"), "")
    chk(acc, "/api matches its own rule",
    r.out.contains("m /api=http://a:1"), "")
}

fn s9_http(acc: Acc) -> void uses IO, Fs, Proc, Net, Clock, Conc {
    section("9. end-to-end HTTP (real server)")
    let dir: str = scratch(acc, "e2e")
    mkdirs(dir)
    mkdirs(path_join3(dir, "public"))
    let port: int = srv_free_port()
    let input: str = path_join3(dir, "app.hls")
    write_file(input, "fn main() -> int {\n    return 0\n}\n")
    write_file(path_join3(dir, "public/logo.svg"),
    "<svg xmlns=\"http://www.w3.org/2000/svg\"></svg>")
    let sp: SrvProc = srv_spawn_server(acc, dir, input,
    path_join3(dir, "out"), path_join3(dir, "public"), port)
    srv_arm_watcher(acc, sp, input, path_join3(dir, "out"), 200)
    let up: bool = srv_wait_port(port)
    if !up {
        chk(acc, "the server comes up", false, read_file(sp.log))
        srv_kill(sp.pid)
        return
    }
    # the pre-compile ran synchronously in srv_spawn_server (the
    # same bin/hlwasm backend, same arguments); its outputs exist.
    chk(acc, "the initial compile runs through bin/hlwasm",
    file_exists(path_join3(dir, "out.wasm")), read_file(sp.log))
    let wasm_magic: str = chr(0) + "asm" + chr(1) + chr(0) + chr(0)
    + chr(0)
    write_file(path_join3(dir, "out.html"),
    "<!DOCTYPE html><html><head></head><body><p>FIXTURE-HTML</p></body></html>")
    write_file(path_join3(dir, "out.wasm"),
    wasm_magic + "WASMBYTES")
    write_file(path_join3(dir, "out.js"), "// FIXTURE-JS\n")

    let r1: HttpResp = srv_fetch(port, "/", [])
    chk(acc, "GET / answers 200", r1.status == 200,
    r1.status.to_str() + " " + r1.body)
    chk(acc, "GET / serves the bundle html",
    r1.ctype.starts_with("text/html")
    && r1.body.contains("FIXTURE-HTML"), r1.ctype)
    chk(acc, "GET / carries the HMR overlay snippet",
    r1.body.contains("hlserve-hmr-client"), "")

    let r2: HttpResp = srv_fetch(port, "/out.wasm", [])
    chk(acc, "GET /out.wasm answers 200 + application/wasm",
    r2.status == 200 && r2.ctype == "application/wasm", r2.ctype)
    chk(acc, "the wasm body is the fixture bytes",
    r2.body.starts_with(wasm_magic)
    && r2.body.contains("WASMBYTES"), "")

    let r3: HttpResp = srv_fetch(port, "/out.js", [])
    chk(acc, "GET /out.js answers 200 + js content type",
    r3.status == 200
    && r3.ctype.starts_with("application/javascript"), r3.ctype)

    let r4: HttpResp = srv_fetch(port, "/static/logo.svg", [])
    chk(acc, "GET /static/logo.svg serves the public dir",
    r4.status == 200 && r4.ctype == "image/svg+xml"
    && r4.body.contains("<svg"), r4.ctype + " " + r4.body)

    let r5: HttpResp = srv_fetch(port, "/some/deep/route", [])
    chk(acc, "the SPA history fallback serves the index",
    r5.status == 200 && r5.ctype.starts_with("text/html")
    && r5.body.contains("FIXTURE-HTML"), r5.status.to_str())

    let r6: HttpResp = srv_fetch(port, "/source", [])
    chk(acc, "GET /source serves the input source",
    r6.status == 200 && r6.ctype.starts_with("text/plain")
    && r6.body.contains("fn main()"), r6.status.to_str())

    let r7: HttpResp = srv_fetch(port, "/no/such/file.hls", [])
    chk(acc, "a missing asset is a 404 (before the fallback)",
    r7.status == 404, r7.status.to_str())

    # the failed-compile banner: break the input, let the watcher
    # recompile and fail, then the index carries the error.
    write_file(input, "fn main() -> int { return 1 + }\n")
    let mut failed: bool = false
    let mut tries: int = 0
    while tries < 40 && !failed {
        thread_sleep_ms(200)
        failed = read_file(sp.log).contains("compile FAILED")
        tries = tries + 1
    }
    chk(acc, "the failed recompile is logged", failed,
    read_file(sp.log))
    let r8: HttpResp = srv_fetch(port, "/", [])
    chk(acc, "GET / serves the failed-compile banner",
    r8.status == 200
    && r8.body.contains("[hls-serve] compile raised: HLError: expected expression but got '}' (line 1:31)"),
    r8.body)
    srv_kill(sp.pid)
}

fn s10_ws_e2e(acc: Acc) -> void uses IO, Fs, Proc, Net, Clock, Conc {
    section("10. end-to-end WebSocket handshake (real server)")
    let dir: str = scratch(acc, "wse2e")
    mkdirs(dir)
    let port: int = srv_free_port()
    let input: str = path_join3(dir, "app.hls")
    write_file(input, "fn main() -> int {\n    return 0\n}\n")
    let sp: SrvProc = srv_spawn_server(acc, dir, input,
    path_join3(dir, "out"), "", port)
    let up: bool = srv_wait_port(port)
    if !up {
        chk(acc, "the server comes up for the ws leg", false,
        read_file(sp.log))
        srv_kill(sp.pid)
        return
    }
    let hs: list[str] = srv_ws_handshake(port)
    let head: str = hs.get(0)
    let hello: str = hs.get(1)
    chk(acc, "the upgrade answers 101 Switching Protocols",
    head.contains("HTTP/1.1 101 Switching Protocols"), head)
    chk(acc, "the accept key matches the RFC vector",
    head.contains("s3pPLMBiTxaQ9kYGzzhZRbK+xOo="), head)
    chk(acc, "the hello frame arrives", hello != "", head)
    let rr: Result[JsonValue, str] = json_parse_result(hello)
    if result_is_err(rr) {
        chk(acc, "the hello frame is valid JSON", false, hello)
        srv_kill(sp.pid)
        return
    }
    let doc: JsonValue = result_unwrap(rr)
    let t: JsonValue = json_object_get(doc, "type")
    let v: JsonValue = json_object_get(doc, "version")
    let sname: JsonValue = json_object_get(doc, "server")
    chk(acc, "the hello frame says hello",
    json_is_str(t) && json_str_value(t) == "hello", hello)
    chk(acc, "the hello frame carries the protocol version",
    json_is_int(v) && json_int_value(v) == 1, hello)
    chk(acc, "the hello frame names the server",
    json_is_str(sname)
    && json_str_value(sname).contains("hls-serve"), hello)
    srv_kill(sp.pid)
}

# value_after — the probe grammar's value extraction (first match,
# to end of line).
fn value_after(text: str, key: str) -> str {
    let idx: int = text.find(key)
    if idx < 0 {
        return ""
    }
    let rest: str = text.slice(idx + key.len(), text.len())
    let nl: int = rest.find("\n")
    if nl < 0 {
        return rest
    }
    return rest.slice(0, nl)
}

fn main() -> int uses IO, Fs, Proc, Args, Exit, Net, Clock, Conc {
    let acc: Acc = acc_new("serve")
    section("Stage 75 — hls-serve (webpack-dev-server equivalent)")
    s1_surface(acc)
    s2_cli(acc)
    s3_config(acc)
    s4_ws_unit(acc)
    s5_watcher(acc)
    s6_diag(acc)
    s7_overlay(acc)
    s8_proxy(acc)
    s9_http(acc)
    s10_ws_e2e(acc)
    return finish(acc,
    "Stage 75 -- hls-serve (webpack-dev-server equivalent)")
}
