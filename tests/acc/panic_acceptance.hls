# ============================================================================
# tests/acc/panic_acceptance.hls — Stage 81 acceptance gate, in Halis
# (the Halis twin of what was tests/panic_acceptance.py; same seven
# sections, same assertions, same needles — the harness is
# tests/acc/harness.hls and the gate runs native, built by bin/hlc).
# ----------------------------------------------------------------------------
# Run with `make panic-acceptance` (which compiles this file to
# bin/acc-panic and runs it from the repo root).
#
# The old battery reached into the lab interpreter's Python internals
# (_resolve_import, tokenize/Parser) for its first two sections; the
# gate asks the same questions through the front door.
#
#  1. core.panic import resolution (+ traversal guards)
#  2. core.panic parses standalone (zero imports)
#  3. Stage-0 enforcement (hosted demo panics w/ marker; ok-test clean)
#  4. Behavior probes (interpreter): PanicInfo geometry, formatting,
#     action codes, PanicLog eviction, guard panics (each 101),
#     handler-fires (marker + 101), handler-exit-wins (42)
#  5. Self-hosted emission (hlc) + native parity: the hook armed, the
#     marker before the default report, exit-wins 42, the no_std and
#     freestanding ok-tests, boot/hlc parity on the fails
#  6. hlfmt stability over every Stage 81 file
#  7. --audit: every panic function pure; the ok-test's handler too
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.regex"

# ----------------------------------------------------------------------------
# The gate's data.
# ----------------------------------------------------------------------------

struct Probe {
    name: str,
    want: int,
    body: str
}

fn demo() -> str {
    return "examples/panic_demo.hls"
}

fn ok_test() -> str {
    return "tests/ok/feat_stage81_panic.hls"
}

fn core_panic() -> str {
    return "core/panic.hls"
}

fn core_modules() -> list[str] {
    return ["option", "result", "iter", "clone", "eq", "alloc", "mem", "panic"]
}

fn fail_programs() -> list[list[str]] {
    return [
        ["fail_panic_dup_handler", "only one #[panic_handler]"],
        ["fail_panic_bad_sig", "#[panic_handler] requires exactly one"],
        ["fail_panic_bad_ret", "#[panic_handler] must return"],
    ]
}

fn must_fns() -> list[str] {
    return ["panic_info_new", "panic_info_msg", "panic_info_file",
            "panic_info_line", "panic_info_has_location",
            "panic_format", "panic_action_name", "panic_action_code",
            "panic_default_code", "panic_log_new", "panic_log_push",
            "panic_log_len", "panic_log_dropped", "panic_log_get",
            "panic_log_clear", "panic_check"]
}

fn probes() -> list[Probe] {
    return [
        Probe {
            name: "info geometry + format",
            want: 0,
            body: "import \"core.panic\"\n" +
                  "fn main() -> int {\n" +
                  "    let i: PanicInfo = panic_info_new(\"boom\", \"k.hls\", 9)\n" +
                  "    if panic_format(i) != \"boom (at k.hls:9)\" { return 1 }\n" +
                  "    if !panic_info_has_location(i) { return 2 }\n" +
                  "    if panic_format(panic_info_new(\"b\", \"\", 0)) != \"b\" { return 3 }\n" +
                  "    if panic_action_name(PanicAction.Exit) != \"exit\" { return 4 }\n" +
                  "    if panic_action_code(PanicAction.Reboot) != 0 { return 5 }\n" +
                  "    if panic_default_code() != 101 { return 6 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "log eviction + drops",
            want: 0,
            body: "import \"core.panic\"\n" +
                  "fn main() -> int {\n" +
                  "    let l: PanicLog = panic_log_new(2)\n" +
                  "    panic_log_push(l, \"a\")\n" +
                  "    panic_log_push(l, \"b\")\n" +
                  "    panic_log_push(l, \"c\")\n" +
                  "    if panic_log_len(l) != 2 { return 1 }\n" +
                  "    if panic_log_get(l, 0) != \"b\" { return 2 }\n" +
                  "    if panic_log_get(l, 1) != \"c\" { return 3 }\n" +
                  "    if panic_log_dropped(l) != 1 { return 4 }\n" +
                  "    panic_log_clear(l)\n" +
                  "    if panic_log_len(l) != 0 || panic_log_dropped(l) != 0 { return 5 }\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "guard: negative line",
            want: 101,
            body: "import \"core.panic\"\n" +
                  "fn main() -> int {\n" +
                  "    let _: PanicInfo = panic_info_new(\"m\", \"f\", -1)\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "guard: zero capacity",
            want: 101,
            body: "import \"core.panic\"\n" +
                  "fn main() -> int {\n" +
                  "    let _: PanicLog = panic_log_new(0)\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "guard: log get OOB",
            want: 101,
            body: "import \"core.panic\"\n" +
                  "fn main() -> int {\n" +
                  "    let l: PanicLog = panic_log_new(2)\n" +
                  "    panic_log_push(l, \"only\")\n" +
                  "    let _: str = panic_log_get(l, 5)\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "guard: panic_check fires",
            want: 101,
            body: "import \"core.panic\"\n" +
                  "fn main() -> int {\n" +
                  "    panic_check(1 == 2, \"math is broken\")\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "handler fires before default",
            want: 101,
            body: "#[panic_handler]\n" +
                  "fn panic_handler(msg: str) -> void uses IO {\n" +
                  "    println(\"hook saw: \" + msg)\n" +
                  "}\n" +
                  "fn main() -> int uses IO {\n" +
                  "    let _: int = panic(\"probe fault\")\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "handler exit wins",
            want: 42,
            body: "#[panic_handler]\n" +
                  "fn panic_handler(msg: str) -> void uses Exit {\n" +
                  "    exit(42)\n" +
                  "}\n" +
                  "fn main() -> int {\n" +
                  "    let _: int = panic(\"boom\")\n" +
                  "    return 0\n" +
                  "}\n"
        },
        Probe {
            name: "nested panic guarded",
            want: 101,
            body: "#[panic_handler]\n" +
                  "fn panic_handler(msg: str) -> void {\n" +
                  "    let _: int = panic(\"handler blew up\")\n" +
                  "}\n" +
                  "fn main() -> int {\n" +
                  "    let _: int = panic(\"original fault\")\n" +
                  "    return 0\n" +
                  "}\n"
        },
    ]
}

# ----------------------------------------------------------------------------
# Shared legs.
# ----------------------------------------------------------------------------

fn decl_word(src: str, kw: str, name: str) -> bool {
    let rr: Result[Regex, str] = regex_compile(kw + "\\s+" + name + "\\b")
    if result_is_err(rr) {
        return false
    }
    let re: Regex = result_unwrap(rr)
    return regex_is_match(re, src)
}

fn import_paths(src: str) -> list[str] {
    let out: list[str] = []
    let lines: list[str] = src.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i).trim()
        if line.starts_with("import ") {
            let rest: str = line.slice(7, line.len()).trim()
            if rest.starts_with("\"") {
                let tail: str = rest.slice(1, rest.len())
                let end: int = tail.find("\"")
                if end > 0 {
                    out.push(tail.slice(0, end))
                }
            }
        }
        i = i + 1
    }
    return out
}

fn swap_no_std(text: str) -> str {
    let at: int = text.find("\n#![no_std]\n")
    if at < 0 {
        return text
    }
    return text.slice(0, at) + "\n#![freestanding]\n"
        + text.slice(at + 12, text.len())
}

fn drop_no_std(text: str) -> str {
    let at: int = text.find("#![no_std]\n")
    if at < 0 {
        return text
    }
    return text.slice(0, at) + text.slice(at + 11, text.len())
}

# ----------------------------------------------------------------------------
# 1. core.panic resolution + traversal guards
# ----------------------------------------------------------------------------
fn sec1(acc: Acc) -> void uses IO, Fs, Proc {
    section("1. core.panic import resolution (+ traversal guards)")
    let p: str = write_src(acc, "res_panic.hls",
        "import \"core.panic\"\n" +
        "\n" +
        "fn main() -> int {\n" +
        "    return 0\n" +
        "}\n")
    let r: RunResult = boot_check(acc, p)
    check(acc, "core.panic resolves", r.code == 0, clip(r.combined, 60))
    let mods: list[str] = core_modules()
    let mut i: int = 0
    while i < mods.len() {
        let m: str = mods.get(i)
        let q: str = write_src(acc, "res_" + m + ".hls",
            "import \"core." + m + "\"\n" +
            "\n" +
            "fn main() -> int {\n" +
            "    return 0\n" +
            "}\n")
        let rq: RunResult = boot_check(acc, q)
        check(acc, "core." + m + " still resolves", rq.code == 0, "")
        i = i + 1
    }
    let s: str = write_src(acc, "res_std_str.hls",
        "import \"std.str\"\n" +
        "\n" +
        "fn main() -> int {\n" +
        "    return 0\n" +
        "}\n")
    let rs: RunResult = boot_check(acc, s)
    check(acc, "std.str still resolves", rs.code == 0, "")
    let evils: list[str] = ["core.../secret", "core./x", "core"]
    let mut j: int = 0
    while j < evils.len() {
        let e: str = evils.get(j)
        let q: str = write_src(acc, "guard_" + j.to_str() + ".hls",
            "import \"" + e + "\"\n" +
            "\n" +
            "fn main() -> int {\n" +
            "    return 0\n" +
            "}\n")
        let rq: RunResult = boot_check(acc, q)
        check(acc, "guard '" + e + "'", rq.code != 0, clip(rq.combined, 70))
        j = j + 1
    }
}

# ----------------------------------------------------------------------------
# 2. core.panic parses standalone + imports are core-only
# ----------------------------------------------------------------------------
fn sec2(acc: Acc) -> void uses IO {
    section("2. core.panic parses standalone + core-only imports")
    let src: str = read_or(core_panic(), "")
    check(acc, "core/panic.hls parses", src.len() > 0 && top_kinds_pos(src), "shape ok")
    check(acc, "both structs present",
        decl_word(src, "struct", "PanicInfo") && decl_word(src, "struct", "PanicLog"), "")
    check(acc, "PanicAction enum present", decl_word(src, "enum", "PanicAction"), "")
    # Imports: the module needs nothing beyond the core language.
    let imps: list[str] = import_paths(src)
    let mut all_core: bool = true
    let mut k: int = 0
    while k < imps.len() {
        if !imps.get(k).starts_with("core.") {
            all_core = false
        }
        k = k + 1
    }
    check(acc, "imports are core-only", all_core, str_join(imps, ", "))
    let fns: list[str] = must_fns()
    let mut missing: str = ""
    let mut j: int = 0
    while j < fns.len() {
        if !decl_word(src, "fn", fns.get(j)) {
            missing = missing + " " + fns.get(j)
        }
        j = j + 1
    }
    check(acc, "all reference functions present", missing == "", clip(missing, 90))
    let lines: list[str] = src.split("\n")
    let mut fn_count: int = 0
    let mut li: int = 0
    while li < lines.len() {
        if lines.get(li).starts_with("fn ") {
            fn_count = fn_count + 1
        }
        li = li + 1
    }
    check(acc, "function count sane (>= 15)", fn_count >= 15, fn_count.to_str())
}

fn top_kinds_pos(src: str) -> bool {
    let lines: list[str] = src.split("\n")
    let mut has_s: bool = false
    let mut has_e: bool = false
    let mut has_f: bool = false
    let mut i: int = 0
    while i < lines.len() {
        let l: str = lines.get(i)
        if l.starts_with("struct ") {
            has_s = true
        }
        if l.starts_with("enum ") {
            has_e = true
        }
        if l.starts_with("fn ") {
            has_f = true
        }
        i = i + 1
    }
    return has_s && has_e && has_f
}

# ----------------------------------------------------------------------------
# 3. Stage-0 enforcement (hosted demo + no_std / freestanding ok-test)
# ----------------------------------------------------------------------------
fn sec3(acc: Acc) -> void uses IO, Fs, Proc {
    section("3. Stage-0 enforcement (demo panics w/ marker; ok-test clean)")
    let rd: RunResult = boot_check(acc, demo())
    check(acc, "hosted demo checks", rd.code == 0, clip(rd.combined, 60))
    let rd2: RunResult = boot(acc, [demo()])
    check(acc, "hosted demo panics (exit 101)", rd2.code == 101,
        "rc=" + rd2.code.to_str())
    check(acc, "handler marker on stdout", rd2.out.contains("kernel panic: demo fault"), "")
    check(acc, "default report still on stderr", rd2.err.contains("panic: demo fault"), "")
    let rt: RunResult = boot_check(acc, ok_test())
    check(acc, "no_std ok-test checks", rt.code == 0, clip(rt.combined, 60))
    let rt2: RunResult = boot(acc, [ok_test()])
    check(acc, "no_std ok-test runs (exit 0)", rt2.code == 0, "rc=" + rt2.code.to_str())
    let fs_src: str = swap_no_std(read_file(ok_test()))
    let fs_p: str = write_src(acc, "ok_fs.hls", fs_src)
    let rf: RunResult = boot_check(acc, fs_p)
    check(acc, "freestanding ok-test checks", rf.code == 0, clip(rf.combined, 60))
    let rf2: RunResult = boot(acc, [fs_p])
    check(acc, "freestanding ok-test runs (exit 0)", rf2.code == 0,
        "rc=" + rf2.code.to_str())
    let bare_src: str = drop_no_std(read_file(ok_test()))
    let bare_p: str = write_src(acc, "ok_bare.hls", bare_src)
    let rb: RunResult = boot(acc, [bare_p])
    check(acc, "hosted (no crate attr) ok-test runs (exit 0)", rb.code == 0,
        "rc=" + rb.code.to_str())
    let ra: RunResult = boot(acc, ["--audit", ok_test()])
    check(acc, "--audit shows no_std", ra.code == 0 && ra.out.contains("#![no_std]"), "")
    let p: str = write_src(acc, "extern_probe.hls",
        "#![no_std]\nimport \"core.panic\"\n" +
        "extern \"C\" {\n    fn malloc(n: int) -> int uses IO\n}\n" +
        "fn main() -> int { return 0 }\n")
    let r: RunResult = boot_check(acc, p)
    check(acc, "no_std extern rejected",
        r.code == 1 && r.combined.contains("not available in #![no_std]"),
        clip(r.combined, 90))
    let fails: list[list[str]] = fail_programs()
    let mut i: int = 0
    while i < fails.len() {
        let f: list[str] = fails.get(i)
        let rj: RunResult = boot_check(acc, "tests/fail/" + f.get(0) + ".hls")
        check(acc, "rejected: " + f.get(0) + ".hls",
            rj.code == 1 && rj.combined.contains(f.get(1)),
            clip(rj.combined, 100))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 4. Targeted behavior probes (interpreter)
# ----------------------------------------------------------------------------
fn sec4(acc: Acc) -> void uses IO, Fs, Proc {
    section("4. Behavior probes (interpreter)")
    let ps: list[Probe] = probes()
    let mut i: int = 0
    while i < ps.len() {
        let p: Probe = ps.get(i)
        let path: str = write_src(acc, "probe_" + i.to_str() + ".hls", p.body)
        let r: RunResult = boot(acc, [path])
        let mut okp: bool = r.code == p.want
        let detail: str = "rc=" + r.code.to_str() + " want=" + p.want.to_str()
        if p.want == 101 && p.name == "handler fires before default" {
            okp = okp && r.out.contains("hook saw: probe fault")
        }
        if p.want == 101 && p.name == "nested panic guarded" {
            okp = okp && r.err.contains("original fault")
        }
        check(acc, "probe: " + p.name, okp, detail)
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 5. Self-hosted emission (hlc) + native parity
# ----------------------------------------------------------------------------
fn sec5(acc: Acc) -> void uses IO, Fs, Proc {
    section("5. Self-hosted emission (hlc) + native parity")
    let out: str = scratch(acc, "panic.c")
    let r: RunResult = boot(acc, ["src/hlc.hls", demo(), out])
    check(acc, "hlc emits hosted C", r.code == 0 && file_exists(out),
        clip(r.combined, 100))
    let src: str = read_or(out, "")
    let mre: Result[Regex, str] = regex_compile("int main\\s*\\(")
    let mut has_main: bool = false
    if result_is_ok(mre) {
        if regex_is_match(result_unwrap(mre), src) {
            has_main = true
        }
    }
    check(acc, "hosted main kept", has_main, "")
    check(acc, "no _start entry", !src.contains("void _start"), "")
    check(acc, "panic hook armed",
        src.contains("hl_panic_hook = usf_panic_handler;"), "")
    check(acc, "handler body compiled", src.contains("usf_panic_handler"), "")
    check(acc, "hook machinery present",
        src.contains("hl_panic_hook") && src.contains("hl_in_panic"), "")
    # Compile the emitted C and run it; the handler marker must print
    # BEFORE the default report, exit code 101.
    let binp: str = scratch(acc, "panic.bin")
    let g: RunResult = run_capture("gcc", ["-O2", "-o", binp, out, "-lm", "-pthread"])
    if g.code == 0 {
        let nat: RunResult = run_capture(binp, [])
        check(acc, "native marker before default",
            nat.out.contains("kernel panic: demo fault")
                && nat.err.contains("panic: demo fault"),
            "rc=" + nat.code.to_str())
        check(acc, "native demo exit 101", nat.code == 101,
            "rc=" + nat.code.to_str())
    } else {
        check(acc, "native panic_demo links", false, "gcc failed")
    }
    # The exit-wins probe exits 42 natively too.
    let wprobe: str = write_src(acc, "exitwins.hls",
        "#[panic_handler]\n" +
        "fn panic_handler(msg: str) -> void uses Exit {\n" +
        "    exit(42)\n" +
        "}\n" +
        "fn main() -> int {\n" +
        "    let _: int = panic(\"boom\")\n" +
        "    return 0\n" +
        "}\n")
    let outw: str = scratch(acc, "exitwins.c")
    let rw: RunResult = boot(acc, ["src/hlc.hls", wprobe, outw])
    check(acc, "hlc emits exit-wins C", rw.code == 0 && file_exists(outw), "")
    let wbin: str = scratch(acc, "exitwins.bin")
    let gw: RunResult = run_capture("gcc", ["-O2", "-o", wbin, outw, "-lm", "-pthread"])
    if gw.code == 0 {
        let nat: RunResult = run_capture(wbin, [])
        check(acc, "native exit-wins exit 42", nat.code == 42,
            "rc=" + nat.code.to_str())
    } else {
        check(acc, "native exit-wins links", false, "gcc failed")
    }
    # The no_std ok-test compiles to hosted C and exits 0 natively.
    let out3: str = scratch(acc, "ok.c")
    let r3: RunResult = boot(acc, ["src/hlc.hls", ok_test(), out3])
    check(acc, "hlc emits no_std ok C", r3.code == 0 && file_exists(out3), "")
    let src3: str = read_or(out3, "")
    check(acc, "ok hook armed", src3.contains("hl_panic_hook = usf_panic_handler;"), "")
    let okbin: str = scratch(acc, "ok.bin")
    let g3: RunResult = run_capture("gcc", ["-O2", "-o", okbin, out3, "-lm", "-pthread"])
    if g3.code == 0 {
        let nat: RunResult = run_capture(okbin, [])
        check(acc, "native ok-test exit 0", nat.code == 0,
            "rc=" + nat.code.to_str())
    } else {
        check(acc, "native ok-test links", false, "gcc failed")
    }
    # Freestanding parity.
    let fs_src: str = swap_no_std(read_file(ok_test()))
    let fs_p: str = write_src(acc, "ok_fs2.hls", fs_src)
    let interp: RunResult = boot(acc, [fs_p])
    let out2: str = scratch(acc, "fs.c")
    let r2: RunResult = boot(acc, ["src/hlc.hls", fs_p, out2])
    check(acc, "hlc emits freestanding C", r2.code == 0 && file_exists(out2),
        clip(r2.combined, 100))
    let src2: str = read_or(out2, "")
    check(acc, "freestanding _start arms hook",
        src2.contains("void _start") && src2.contains("hl_panic_hook = usf_panic_handler;"),
        "")
    check(acc, "freestanding traps by default", src2.contains("__builtin_trap"), "")
    let bin2: str = scratch(acc, "fs.bin")
    let g2: RunResult = run_capture("gcc", ["-O2", "-ffreestanding", "-nostdlib",
        "-ffunction-sections", "-fno-stack-protector", "-Wl,--gc-sections",
        "-o", bin2, out2])
    if g2.code == 0 {
        let nat2: RunResult = run_capture(bin2, [])
        check(acc, "freestanding native == interpreter",
            nat2.code == interp.code,
            "interp=" + interp.code.to_str() + " nat=" + nat2.code.to_str())
    } else {
        check(acc, "freestanding binary links", false, "gcc failed")
    }
    # Boot/hlc parity on the fail programs.
    let fails: list[list[str]] = fail_programs()
    let mut i: int = 0
    while i < fails.len() {
        let f: list[str] = fails.get(i)
        let outf: str = scratch(acc, "fail.c")
        let rf: RunResult = boot(acc, ["src/hlc.hls", "tests/fail/" + f.get(0) + ".hls", outf])
        check(acc, "hlc rejects " + f.get(0) + ".hls",
            rf.code != 0 && rf.combined.contains("panic_handler"),
            clip(rf.combined, 120))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 6. hlfmt stability
# ----------------------------------------------------------------------------
fn sec6(acc: Acc) -> void uses IO, Proc {
    section("6. hlfmt stability over every Stage 81 file")
    let files: list[str] = [core_panic(), demo(), ok_test(),
        "tests/fail/fail_panic_dup_handler.hls",
        "tests/fail/fail_panic_bad_sig.hls",
        "tests/fail/fail_panic_bad_ret.hls"]
    let mut i: int = 0
    while i < files.len() {
        let r: RunResult = run_capture("python3", ["tools/hlfmt.py", "-c", files.get(i)])
        check(acc, "hlfmt clean: " + basename(files.get(i)),
            !r.out.contains("NOT formatted"), clip(r.out, 80))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 7. --audit shows every panic function pure
# ----------------------------------------------------------------------------
fn sec7(acc: Acc) -> void uses IO, Proc {
    section("7. --audit: every panic function pure (no uses)")
    let r: RunResult = boot(acc, ["--audit", ok_test()])
    let out: str = r.out
    check(acc, "audit ran", r.code == 0, "")
    let must: list[str] = must_fns()
    let mut missing: str = ""
    let mut i: int = 0
    while i < must.len() {
        if !out.contains(must.get(i)) {
            missing = missing + " " + must.get(i)
        }
        i = i + 1
    }
    check(acc, "all panic fns in audit output", missing == "", clip(missing, 90))
    let lines: list[str] = out.split("\n")
    let mut bad: str = ""
    let mut handler_pure: bool = false
    let mut handler_seen: bool = false
    let mut li: int = 0
    while li < lines.len() {
        let s: str = lines.get(li).trim()
        let mut fi: int = 0
        while fi < must.len() {
            if s.starts_with(must.get(fi) + " ") {
                if !s.contains("(none - pure)") && !s.contains("(none)") {
                    bad = bad + " " + s
                }
                break
            }
            fi = fi + 1
        }
        if !handler_seen && s.starts_with("panic_handler ") {
            handler_seen = true
            if s.contains("(none - pure)") || s.contains("(none)") {
                handler_pure = true
            }
        }
        li = li + 1
    }
    check(acc, "all panic fns declared pure", bad == "", clip(bad, 90))
    if handler_seen {
        check(acc, "ok-test handler pure", handler_pure, "")
    } else {
        fail_msg(acc, "ok-test handler not in audit output")
    }
    check(acc, "crate mode reported",
        out.contains("Crate mode:") && out.contains("#![no_std]"), "")
}

fn main() -> int uses IO, Fs, Proc, Args, Exit {
    let acc: Acc = acc_new("panic")
    sec1(acc)
    sec2(acc)
    sec3(acc)
    sec4(acc)
    sec5(acc)
    sec6(acc)
    sec7(acc)
    return finish(acc, "Stage 81 -- core.panic + #[panic_handler]")
}
