# ============================================================================
# tests/acc/suite_01_boot_acceptance.hls — the boot suite, in Halis.
# ----------------------------------------------------------------------------
# The Halis twin of the old tests/suites/suite_01_boot.sh (the first sourced
# fragment of the original run_tests.sh): same four sections, same laws —
# the harness is tests/acc/harness.hls and the gate runs native, built by
# bin/hlc. Run with `make suite-01-boot-acceptance`.
#
#  1. Stage-0 valid programs    — every tests/ok crate runs on the boot
#                                 interpreter (exit 0, or the test's own
#                                 101 panic); a snapshot pins the bytes
#  2. Stage-0 expected failures — every tests/fail crate is rejected by
#                                 --check with exit 1
#  3. Differential             — interpreter vs Stage-0-compiled native
#                                 (byte + exit parity, per file); libcurl
#                                 probed exactly like the shell did. The
#                                 per-file C comes from ONE native compiler
#                                 (HL_TEST_HLC1 from the driver, or the
#                                 in-gate build) — the fixed-point law pins
#                                 it byte-equal to the interpreter's own
#                                 emission, and the interpreter itself stays
#                                 the oracle every file runs through
#  3b. memory stress           — the stress binary holds RSS flat under a
#                                 256 MB address-space limit
#
# The interpreter legs batch: ONE `boot.py --batch` process runs the
# whole corpus (and one more with --check for the fail corpus) and
# writes one rc + base64(stdout) + base64(stderr) record per file, so
# the per-file observations are the same bytes a per-file spawn would
# capture without paying a Python ignition per probe. Sections 1 and 3
# share the one run log — the differential compares the same interpreted
# bytes against the native binary, exactly as the two separate runs
# (deterministic by construction) did before.
#
# Shell-to-Halis notes: the old harness shared one mktemp TMP and ok/bad
# counters; this gate keeps every probe under tests/.acc-scratch/
# suite_01_boot/ (wiped by acc_new) and lets the harness count. The
# `$(...)` trailing-newline strip is part of the old comparisons — both
# sides are stripped the same way before comparing.
# ============================================================================

import "./harness.hls"
import "std.str"
import "std.env"
import "std.base64"

# strip_trailing_nl(s) — the `$(...)` semantics the shell compared under.
fn strip_trailing_nl(s: str) -> str {
    let mut end: int = s.len()
    while end > 0 && s.byte_at(end - 1) == 10 {
        end = end - 1
    }
    return s.slice(0, end)
}

# first_lines(text, n) — the `head -n N` window.
fn first_lines(text: str, n: int) -> str {
    let lines: list[str] = text.split("\n")
    let mut out: str = ""
    let mut i: int = 0
    while i < n && i < lines.len() {
        out = out + lines.get(i) + "\n"
        i = i + 1
    }
    return out
}

# ok_corpus() — tests/ok/*.hls, sorted (fs_read_dir order matches the
# shell glob).
fn ok_corpus() -> list[str] uses Fs {
    let names: list[str] = fs_read_dir("tests/ok")
    let out: list[str] = []
    let mut i: int = 0
    while i < names.len() {
        let n: str = names.get(i)
        if n.len() > 4 && n.slice(n.len() - 4, n.len()) == ".hls" {
            out.push(path_join3("tests/ok", n))
        }
        i = i + 1
    }
    return out
}

# fail_corpus() — tests/fail/*.hls, sorted.
fn fail_corpus() -> list[str] uses Fs {
    let names: list[str] = fs_read_dir("tests/fail")
    let out: list[str] = []
    let mut i: int = 0
    while i < names.len() {
        let n: str = names.get(i)
        if n.len() > 4 && n.slice(n.len() - 4, n.len()) == ".hls" {
            out.push(path_join3("tests/fail", n))
        }
        i = i + 1
    }
    return out
}

# is_freestanding(src) — the `#![freestanding]` crate attribute inside
# the first five lines.
fn is_freestanding(src: str) -> bool uses Fs {
    return first_lines(read_file(src), 5).contains("#![freestanding]")
}

# LinkFlags — the libcurl probe outcome (cflags, libs).
struct LinkFlags {
    cflags: str,
    libs: str
}

# curl_link_flags() — the Stage-37 probe: curl-config, then pkg-config;
# empty libs means no libcurl, the guarded stub stays.
fn curl_link_flags() -> LinkFlags uses Proc {
    let mut f: LinkFlags = LinkFlags { cflags: "", libs: "" }
    let cc: RunResult = run_capture("curl-config", ["--cflags"])
    let cl: RunResult = run_capture("curl-config", ["--libs"])
    if cl.code == 0 && cl.out.trim() != "" {
        f.cflags = cc.out.trim()
        f.libs = cl.out.trim()
    } else {
        let pc: RunResult = run_capture("pkg-config", ["--cflags", "libcurl"])
        let pl: RunResult = run_capture("pkg-config", ["--libs", "libcurl"])
        if pl.code == 0 && pl.out.trim() != "" {
            f.cflags = pc.out.trim()
            f.libs = pl.out.trim()
        }
    }
    return f
}

# gcc_link(acc, c_src, bin_out, freestanding, cflags, libs) — the two
# link recipes the suite carries (freestanding crates enter via _start
# with no libc; hosted crates link libc, libm, pthreads, libcurl).
fn gcc_link(acc: Acc, c_src: str, bin_out: str, freestanding: bool,
            cflags: str, libs: str) -> bool uses Proc {
    if freestanding {
        let argv: list[str] = ["-O2", "-ffreestanding", "-nostdlib",
            "-ffunction-sections", "-fno-stack-protector",
            "-Wl,--gc-sections", "-o", bin_out, c_src]
        return run_capture("gcc", argv).code == 0
    }
    let argv: list[str] = ["-O2"]
    if cflags != "" {
        let parts: list[str] = cflags.split(" ")
        let mut i: int = 0
        while i < parts.len() {
            if parts.get(i) != "" {
                argv.push(parts.get(i))
            }
            i = i + 1
        }
    }
    argv.push("-o")
    argv.push(bin_out)
    argv.push(c_src)
    argv.push("-lm")
    argv.push("-pthread")
    if libs != "" {
        let lparts: list[str] = libs.split(" ")
        let mut j: int = 0
        while j < lparts.len() {
            if lparts.get(j) != "" {
                argv.push(lparts.get(j))
            }
            j = j + 1
        }
    }
    return run_capture("gcc", argv).code == 0
}

# ----------------------------------------------------------------------------
# 1. Stage-0: valid programs
# ----------------------------------------------------------------------------

# BatchLog — the decoded `boot.py --batch` records, index-aligned with
# the corpus list the log was built from (the batch preserves list
# order; the path field is cross-checked on every lookup).
struct BatchLog {
    paths: list[str],
    rcs: list[int],
    outs: list[str],
    errs: list[str]
}

# batch_lookup(log, path) — the record for path (rc 2 / empty strings
# when the batch never produced it — the caller reports a failed probe,
# the same verdict a dead spawn would have earned).
fn batch_lookup(log: BatchLog, path: str) -> BatchLog {
    let mut i: int = 0
    while i < log.paths.len() {
        if log.paths.get(i) == path {
            let one: BatchLog = BatchLog {
                paths: [path],
                rcs: [log.rcs.get(i)],
                outs: [log.outs.get(i)],
                errs: [log.errs.get(i)]
            }
            return one
        }
        i = i + 1
    }
    return BatchLog { paths: [], rcs: [2], outs: [""], errs: [""] }
}

# batch_run(acc, files, check_mode) — ONE boot.py process for the whole
# list; the log lands under the gate's scratch world and is parsed back
# into BatchLog. A batch that cannot even start returns an empty log
# (rc 2 in every record) — the probes then fail by name, loudly.
fn batch_run(acc: Acc, files: list[str], check_mode: bool) -> BatchLog
        uses IO, Fs, Proc {
    let list_path: str = scratch(acc, "batch_list.txt")
    let log_path: str = scratch(acc, "batch_log.tsv")
    let mut text: str = ""
    let mut i: int = 0
    while i < files.len() {
        text = text + files.get(i) + "\n"
        i = i + 1
    }
    write_file(list_path, text)
    let argv: list[str] = ["tools/hlinterp/boot.py", "--batch",
                           list_path, log_path]
    if check_mode {
        argv.push("--check")
    }
    let r: RunResult = run_capture("python3", argv)
    let log: BatchLog = BatchLog { paths: [], rcs: [], outs: [], errs: [] }
    if r.code != 0 {
        return log
    }
    let raw: str = read_file(log_path)
    let lines: list[str] = raw.split("\n")
    let mut j: int = 0
    while j < lines.len() {
        let ln: str = lines.get(j)
        if ln != "" {
            let fields: list[str] = ln.split("\t")
            if fields.len() == 4 {
                log.paths.push(base64_decode(fields.get(1)))
                log.rcs.push(parse_uint(fields.get(0)))
                log.outs.push(base64_decode(fields.get(2)))
                log.errs.push(base64_decode(fields.get(3)))
            }
        }
        j = j + 1
    }
    return log
}

fn section_ok(acc: Acc, run_log: BatchLog) -> void uses IO, Fs, Proc {
    section("1. Stage-0: valid programs")
    let files: list[str] = ok_corpus()
    let mut i: int = 0
    while i < files.len() {
        let f: str = files.get(i)
        let name: str = stem(f)
        let rec: BatchLog = batch_lookup(run_log, f)
        let code: int = rec.rcs.get(0)
        let out: str = rec.outs.get(0)
        if code == 0 || code == 101 {
            let snap: str = path_join3("tests/snapshots", name + ".txt")
            if file_exists(snap)
                    && strip_trailing_nl(out) != strip_trailing_nl(read_file(snap)) {
                check(acc, name, false, "differs from snapshot")
            } else {
                check(acc, name, true, "")
            }
        } else {
            check(acc, name, false, "exit=" + code.to_str())
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 2. Stage-0: programs EXPECTED TO FAIL
# ----------------------------------------------------------------------------

fn section_fail(acc: Acc, check_log: BatchLog) -> void uses IO, Fs, Proc {
    section("2. Stage-0: programs EXPECTED TO FAIL")
    let files: list[str] = fail_corpus()
    let mut i: int = 0
    while i < files.len() {
        let f: str = files.get(i)
        let name: str = stem(f)
        let rec: BatchLog = batch_lookup(check_log, f)
        check(acc, name + " -> " + clip(first_line(rec.errs.get(0)), 60),
              rec.rcs.get(0) == 1,
              "should be rejected but exit=" + rec.rcs.get(0).to_str())
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 3. Self-compile + differential testing (interpreter vs native)
# ----------------------------------------------------------------------------

# build_hlc1 — the native compiler the differential leg chains through.
# The suite driver prebuilds ONE native compiler for every gate
# (snapshot/hlc.c under gcc) and exports its path in HL_TEST_HLC1; the
# fixed-point law (make bootstrap, re-proven by suite_03's own cmp of
# the interpreter's emission against the native one) makes that binary
# produce exactly the C the interpreter-driven compile below would —
# so sharing it saves an interpreter self-compile PER CORPUS FILE
# (272 × ~0.7 s of Python per run) without changing what the legs
# verify: the interpreter stays the ORACLE every file is run through,
# the native side is still compiled and linked and run per file, and
# the byte + exit parity law is untouched. A standalone gate run (no
# driver, no var) falls through to the in-gate build below unchanged.
fn build_hlc1(acc: Acc) -> str uses IO, Proc {
    let hlc1: str = scratch(acc, "hlc1")
    if file_exists(hlc1) {
        return hlc1
    }
    let shared: str = env_get("HL_TEST_HLC1")
    if shared != "" && file_exists(shared) {
        return shared
    }
    let s1: str = scratch(acc, "hlc_nat.c")
    let r: RunResult = run_capture("python3",
        ["tools/hlinterp/boot.py", "src/hlc.hls", "src/hlc.hls", s1])
    if r.code != 0 {
        return ""
    }
    if run_capture("gcc", ["-O2", "-o", hlc1, s1, "-lm", "-pthread"]).code != 0 {
        return ""
    }
    return hlc1
}

fn section_differential(acc: Acc, run_log: BatchLog) -> void uses IO, Fs, Proc {
    section("3. Self-compile + differential testing (interpreter vs native)")
    let hlc1: str = build_hlc1(acc)
    let flags: LinkFlags = curl_link_flags()
    let files: list[str] = ok_corpus()
    let mut i: int = 0
    while i < files.len() {
        let f: str = files.get(i)
        let name: str = stem(f)
        let rec: BatchLog = batch_lookup(run_log, f)
        let c_path: str = scratch(acc, name + ".c")
        let hlc: RunResult = run_capture(hlc1, [f, c_path])
        if hlc1 == "" || hlc.code != 0 {
            check(acc, name, false, "hlc compile failed")
            i = i + 1
            continue
        }
        let bin_path: str = scratch(acc, name + ".bin")
        if !gcc_link(acc, c_path, bin_path, is_freestanding(f),
                     flags.cflags, flags.libs) {
            check(acc, name, false, "gcc error")
            i = i + 1
            continue
        }
        let nat: RunResult = run_capture(bin_path, [])
        if strip_trailing_nl(rec.outs.get(0)) == strip_trailing_nl(nat.out)
                && rec.rcs.get(0) == nat.code {
            check(acc, name, true, "native matches interpreter")
        } else {
            check(acc, name, false, "interp=" + rec.rcs.get(0).to_str()
                + " nat=" + nat.code.to_str()
                + " interp head: " + clip(rec.outs.get(0), 60))
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# 3b. Stage 8-beta memory-stress (native RSS must stay flat)
# ----------------------------------------------------------------------------

fn section_memcheck(acc: Acc) -> void uses IO, Fs, Proc {
    section("3b. Stage 8-beta memory-stress (native RSS must stay flat)")
    let stress_c: str = scratch(acc, "stress.c")
    let stress_bin: str = scratch(acc, "stress")
    # The C comes from the shared native compiler when the driver
    # exported one (the fixed-point law makes it the same compiler the
    # interpreted chain would drive); the interpreter fallback stays
    # for standalone runs. The RSS law does not care which of the two
    # byte-equal compilers emitted the file.
    let mut compiled: bool = false
    let shared: str = env_get("HL_TEST_HLC1")
    if shared != "" && file_exists(shared) {
        compiled = run_capture(shared,
            ["tests/memcheck/stress_leak.hls", stress_c]).code == 0
    }
    if !compiled {
        compiled = run_capture("python3",
            ["tools/hlinterp/boot.py", "src/hlc.hls",
             "tests/memcheck/stress_leak.hls", stress_c]).code == 0
    }
    compiled = compiled
        && run_capture("gcc",
            ["-O2", "-o", stress_bin, stress_c, "-lm", "-pthread"]).code == 0
    if !compiled {
        check(acc, "stress_leak", false, "compile failed")
        return
    }
    let out_path: str = scratch(acc, "stress.out")
    let rc: int = sh("ulimit -v 262144; '" + shell_quote(stress_bin)
        + "' > '" + shell_quote(out_path) + "' 2>/dev/null")
    if rc != 0 {
        check(acc, "stress_leak", false,
              "failed under 256MB ulimit (exit=" + rc.to_str() + ")")
        return
    }
    let out: str = read_file(out_path)
    if !out.contains("rss_delta_pages=") {
        check(acc, "stress_leak", false,
              "no rss_delta_pages= line in output (stress binary crashed before reporting?)")
        return
    }
    let line: str = first_line(out.slice(out.len() - clip_len(out, 4096), out.len()))
    let pos: int = find_after(line, "rss_delta_pages=")
    let delta: int = parse_uint(slice_to_space(line, pos))
    if delta <= 1024 {
        check(acc, "stress_leak under 256MB ulimit", true,
              "rss delta=" + delta.to_str() + " pages")
    } else {
        check(acc, "stress_leak under 256MB ulimit", false,
              "RSS grew by " + delta.to_str() + " pages")
    }
}

# clip_len(text, n) — the window start for reading a file's tail.
fn clip_len(text: str, n: int) -> int {
    if text.len() <= n {
        return 0
    }
    return text.len() - n
}

# find_after(hay, needle) — the offset just past needle's first occurrence
# in hay (0 when absent).
fn find_after(hay: str, needle: str) -> int {
    let mut i: int = 0
    while i + needle.len() <= hay.len() {
        if hay.slice(i, i + needle.len()) == needle {
            return i + needle.len()
        }
        i = i + 1
    }
    return 0
}

# slice_to_space(s, from) — s[from .. ) up to the next space/newline.
fn slice_to_space(s: str, from: int) -> str {
    let mut i: int = from
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c == 32 || c == 10 || c == 9 {
            return s.slice(from, i)
        }
        i = i + 1
    }
    return s.slice(from, s.len())
}

# parse_uint(s) — the digits of s as an int (0 when none).
fn parse_uint(s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48)
        } else {
            break
        }
        i = i + 1
    }
    return v
}

# ----------------------------------------------------------------------------
# main
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Fs, Proc, Exit {
    let acc: Acc = acc_new("suite_01_boot")
    # One interpreter process per mode for the whole gate: the ok
    # corpus runs once (sections 1 and 3 share the log), the fail
    # corpus is checked once.
    let run_log: BatchLog = batch_run(acc, ok_corpus(), false)
    let check_log: BatchLog = batch_run(acc, fail_corpus(), true)
    section_ok(acc, run_log)
    section_fail(acc, check_log)
    section_differential(acc, run_log)
    section_memcheck(acc)
    return finish(acc, "suite 01 -- boot (Stage-0 corpus, differential, memcheck)")
}
