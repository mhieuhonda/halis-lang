# ============================================================================
# tests/rt_libs/deadline_rt.hls — the wall-clock deadline canary
# ----------------------------------------------------------------------------
# The NANOS axis' control sample: every cycle busy-waits until it has
# burned ~40 ms of monotonic clock (instant_now_ns, the Stage 49
# builtin), then prints its marker. Under --budget-ms 10 every cycle's
# window is four deadlines deep, so the FIRST mark already closes an
# over-deadline cycle and the runtime dies with
#
#   panic: soft real-time violation: cycle 0 took X ns (deadline 10000000 ns)
#
# The busy-wait (no thread sleep, no Conc effect) keeps the workload a
# plain single-threaded hosted program: the mode's documented shape.
# ============================================================================

# burn ~40 ms of wall clock: a read-check spin around the monotonic
# builtin (the deadline axis is MEASURED by the runtime's own clock at
# the mark; the workload's job is only to make the window long)
fn spin_until(deadline: int) -> int uses Clock {
    let mut spins: int = 0
    while instant_now_ns() < deadline {
        spins = spins + 1
    }
    return spins
}

fn main() -> int uses IO, Clock {
    let cycle_ms: int = 40
    let mut i: int = 0
    while i < 6 {
        let start: int = instant_now_ns()
        let _: int = spin_until(start + cycle_ms * 1000000)
        println("__HLRT_CYCLE__ " + i.to_str())
        i = i + 1
    }
    println("done")
    return 0
}
