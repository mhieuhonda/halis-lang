# ============================================================================
# tests/rt_libs/steady_rt.hls — the hls-rt steady-state workload
# ----------------------------------------------------------------------------
# The Stage 126 shape of the Stage 125 convention: an ordinary Halis
# program whose steady state is a fixed batch of allocation churn per
# cycle, with one `__HLRT_CYCLE__ <i>` marker printed at the END of each
# cycle (strictly increasing from 0). argv[1] carries the cycle count
# (absent, the default 24) — the same plan-driving convention hls-rss
# uses, so one workload source serves both verifiers' shape.
#
# The churn per cycle is IDENTICAL (no i-dependent sizes), so a clean
# run's per-cycle ledger is a constant line: the verifier's determinism
# assertion (max allocs == median allocs) holds per binary, and any
# growth across cycles would be a leak the Stage 125 instruments own.
# ============================================================================

fn churn_round(i: int) -> int {
    let mut checksum: int = 0
    # strings: build, clone, byte-read, drop
    let s: str = "round-" + i.to_str() + "-payload-0123456789"
    checksum = checksum + s.len()
    let c: str = clone(s)
    checksum = checksum + c.byte_at(2)
    drop(c)
    # a list that grows and shrinks within the round
    let xs: list[int] = [i, i + 1, i + 2, i + 3]
    xs.push(i * 3)
    checksum = checksum + xs.pop() + xs.get(2)
    # a map that fills and empties within the round
    let m: map[str, int] = map_new()
    m.set("alpha", i)
    m.set("beta", i * 2)
    checksum = checksum + m.get_or("beta", 0)
    return checksum
}

# rounds per cycle: sized so one cycle is a native millisecond — the
# window a per-cycle ledger can describe without noise
fn batch() -> int {
    return 300
}

fn cycle_once(base: int) -> int {
    let mut checksum: int = 0
    let mut j: int = 0
    let k: int = batch()
    while j < k {
        checksum = checksum + churn_round(base + j)
        j = j + 1
    }
    return checksum
}

fn main() -> int uses IO {
    let mut cycles: int = 24
    let a: list[str] = args()
    if a.len() > 1 {
        cycles = a.get(1).to_int()
    }
    let mut checksum: int = 0
    let mut i: int = 0
    while i < cycles {
        checksum = checksum + cycle_once(i * batch())
        println("__HLRT_CYCLE__ " + i.to_str())
        i = i + 1
    }
    println("checksum=" + checksum.to_str())
    return 0
}
