# ============================================================================
# tests/rt_libs/no_cycles_rt.hls — an honest non-workload
# ----------------------------------------------------------------------------
# A program that never prints a cycle marker: it runs, it allocates, it
# exits 0 — and there is nothing the verifier can certify. A bound
# claimed over zero observed cycles is a rumour; the tool must answer
# RT INCONCLUSIVE ("only 0 measured cycle(s)") and exit 1, never pad
# the run with assumptions. Ordinary output survives untouched: a
# workload may talk.
# ============================================================================

fn main() -> int uses IO {
    let mut i: int = 0
    while i < 5 {
        println("ordinary line " + i.to_str())
        i = i + 1
    }
    return 0
}
