# ============================================================================
# tests/rt_libs/warmup_rt.hls — the warmup-semantics canary
# ----------------------------------------------------------------------------
# Exactly ONE fat cycle — the FIRST one — then a steady, quiet line.
# Under a budget the fat cycle breaks, this is the workload that proves
# --warmup means what it says:
#
#   no warmup           -> RT REFUSED (cycle 0 over budget, exit 1)
#   --warmup 1          -> RT BOUNDED (cycle 0 measured but not enforced;
#                          every later cycle is inside)
#
# The runtime reads the same HLRT_WARMUP the tool passes, so enforcement
# and verdict skip the SAME cycle — a plan that fills its working set in
# cycle 0 is bounded from cycle 1 on, and says so.
# ============================================================================

fn fat_cycle() -> int {
    let mut checksum: int = 0
    let mut j: int = 0
    while j < 400 {
        let s: str = "warm-" + j.to_str() + "-payload-0123456789abcdef"
        checksum = checksum + s.len()
        j = j + 1
    }
    return checksum
}

fn main() -> int uses IO {
    let mut i: int = 0
    while i < 12 {
        if i == 0 {
            let _: int = fat_cycle()
        } else {
            let s: str = "quiet-" + i.to_str()
            let _: int = s.len()
        }
        println("__HLRT_CYCLE__ " + i.to_str())
        i = i + 1
    }
    println("done")
    return 0
}
