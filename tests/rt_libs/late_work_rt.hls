# ============================================================================
# tests/rt_libs/late_work_rt.hls — the coverage canary
# ----------------------------------------------------------------------------
# The markers here close eight perfectly-bounded cycles — and then the
# program does its real work AFTER the last mark (a 4000-allocation
# burst in the exit tail). The ledger is clean, the exit is 0, and the
# verifier must still refuse to certify: the markers describe a program
# the ledger does not show. The honest answer is RT INCONCLUSIVE
# ("the markers do not cover the work"), never a pass earned by
# marking only the quiet part of the run.
# ============================================================================

fn main() -> int uses IO {
    # the marked phase: eight tiny, identical cycles
    let mut i: int = 0
    while i < 8 {
        let s: str = "quiet-" + i.to_str()
        let _: int = s.len()
        println("__HLRT_CYCLE__ " + i.to_str())
        i = i + 1
    }
    # the unmarked phase: a 4000-allocation burst the tail must expose
    let mut checksum: int = 0
    let mut j: int = 0
    while j < 4000 {
        let s: str = "late-" + j.to_str() + "-payload"
        checksum = checksum + s.len()
        j = j + 1
    }
    println("checksum=" + checksum.to_str())
    return 0
}
