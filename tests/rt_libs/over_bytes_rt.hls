# ============================================================================
# tests/rt_libs/over_bytes_rt.hls — the allocation-bytes canary
# ----------------------------------------------------------------------------
# The BYTES axis' control sample: FEW allocations, BIG payload. Each
# cycle after the first doubles a one-character string until it spans
# 16 KiB — about 15 allocations carrying 32 KiB of cumulative bytes in
# one window. Under --budget-bytes 8192 (allocs unchecked) cycle 0
# stays clean and cycle 1 dies at its mark:
#
#   panic: soft real-time violation: cycle 1 allocated X bytes (budget 8192)
#
# The exact X is the window's cumulative ask (doubling sums), printed
# by the runtime from the instrument's ledger — the canary's job is to
# make X cross the budget while the ALLOCS axis never could.
# ============================================================================

fn main() -> int uses IO {
    let mut i: int = 0
    while i < 8 {
        if i > 0 {
            # ~8 KiB of final string, ~14 concats, ~16 KiB cumulative
            # ask in one window — comfortably over an 8 KiB budget
            let mut s: str = "y"
            let mut len: int = 1
            while len < 8192 {
                s = s + s
                len = len * 2
            }
            let _: int = s.len()
        }
        println("__HLRT_CYCLE__ " + i.to_str())
        i = i + 1
    }
    println("done")
    return 0
}
