# ============================================================================
# tests/rt_libs/over_allocs_rt.hls — the allocation-count canary
# ----------------------------------------------------------------------------
# Each cycle makes MORE allocations than the last (a linear ramp: the
# cycle-i loop performs `base + i * step` string concats, each one a
# fresh heap allocation). Under any fixed --budget-allocs the run is
# guaranteed to close a cycle over budget — this is the control sample
# that proves in-process enforcement can fail, and it does: the runtime
# dies at the mark with
#
#   panic: soft real-time violation: cycle N made X allocations (budget B)
#
# exit 101, the Stage 81 panic path. The exact N depends on the
# runtime's own per-cycle overhead (the marker println allocates too),
# so the verifier asserts the shape and the axis, never a pinned index.
# ============================================================================

fn ramp(base: int, step: int) -> int {
    let n: int = base + step
    let mut s: str = "x"
    let mut j: int = 0
    while j < n {
        s = s + "x"
        j = j + 1
    }
    return s.len()
}

fn main() -> int uses IO {
    # cycle i allocates base + (i+1) * step times: 40, 80, 120, ...
    let base: int = 20
    let step: int = 40
    let mut i: int = 0
    while i < 12 {
        let _: int = ramp(base, i * step)
        println("__HLRT_CYCLE__ " + i.to_str())
        i = i + 1
    }
    println("done")
    return 0
}
