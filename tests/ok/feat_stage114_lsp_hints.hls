# feat_stage114_lsp_hints.hls — Stage 114 (v0.133.0-alpha):
# LSP inlay hints (parameter names, binding types).
#
# What the differential suite pins HERE is the surface the language
# server now annotates — the same signatures and the same match
# payloads the editor decorates:
#
#   python3 tools/hls-lsp.py  (textDocument/inlayHint)
#   python3 boot/boot.py tests/ok/feat_stage114_lsp_hints.hls
#
# The program: plain calls whose arguments the server names (the
# curated builtin table mirrors SPEC section 8; local fns and methods
# resolve from the parsed program the same way the checker resolves
# them), enum-variant constructors whose payloads carry no names and
# therefore earn NO hint, and match arms whose payload bindings are
# the only bindings in the language written without an annotation —
# the checker instantiates their types (Circle's r is an int, Rect's
# w and h are ints), which is exactly what the server prints as
# `: int` after each binding. Deterministic output; interpreter and
# native agree byte for byte.

fn add(a: int, b: int) -> int {
    return a + b
}

fn shout(s: str, times: int) -> str {
    let mut out: str = s
    let mut i: int = 0
    while i < times {
        out = out + s
        i = i + 1
    }
    return out
}

enum Shape {
    Circle(int),
    Rect(int, int),
    Point
}

fn area(sh: Shape) -> int {
    return match sh {
        Shape.Circle(r) => 3 * r * r,
        Shape.Rect(w, h) => w * h,
        Shape.Point => 0
    }
}

struct Tagged {
    label: str,
    value: int
}

fn describe(t: Tagged) -> str {
    return t.label + "=" + t.value.to_str()
}

fn main() -> int uses IO {
    let sum: int = add(40, 2)
    println(sum.to_str())
    let banner: str = shout("hi", 2)
    println(banner)
    let a1: int = area(Shape.Circle(3))
    let a2: int = area(Shape.Rect(4, 5))
    let a3: int = area(Shape.Point)
    println((a1 + a2 + a3).to_str())
    let t: Tagged = Tagged {
        label: "n", value: 7
    }
    println(describe(t))
    return 0
}
