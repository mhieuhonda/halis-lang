# Test lists: nesting, index assignment, for-in, length snapshot
fn sum(xs: list[int]) -> int {
    let mut t: int = 0
    for v: int in xs {
        t = t + v
    }
    return t
}

fn main() -> int uses IO {
    let xs: list[int] = [10, 20, 30]
    xs.push(40)
    println("len=" + xs.len().to_str())
    println("get2=" + xs.get(2).to_str())
    xs.set(1, 99)
    println("set1=" + xs.get(1).to_str())
    xs[0] = 11
    println("idx0=" + xs[0].to_str())
    println("sum=" + sum(xs).to_str())

    # nested list
    let grid: list[list[int]] = [[1, 2], [3, 4, 5]]
    println("grid_len=" + grid.len().to_str())
    println("grid_1_2=" + grid.get(1).get(2).to_str())
    let row: list[int] = grid.get(0)
    row.push(9)
    println("row_after_push=" + row.len().to_str())
    println("grid_0_still=" + grid.get(0).len().to_str())

    # list of strings / struct
    let names: list[str] = ["An", "Binh", "Chi"]
    for n: str in names {
        print(n + ";")
    }
    println("")
    # length snapshot: pushing during iteration does not increase loop count
    let grow: list[int] = [1]
    let mut seen: int = 0
    for v: int in grow {
        grow.push(v + 100)
        seen = seen + 1
    }
    println("seen=" + seen.to_str() + " now=" + grow.len().to_str())

    # for-in on an expression
    let mut t: int = 0
    for v: int in range(2, 6) {
        t = t + v
    }
    println("range_sum=" + t.to_str())
    let mut c: int = 0
    for v: int in range(5, 5) {
        c = c + 1
    }
    println("empty_range=" + c.to_str())
    return 0
}
