# Test the standard library: std.str, std.math, std.json, std.url, std.html.
import "std.str"
import "std.math"
import "std.json"
import "std.url"
import "std.html"

fn main() -> int uses IO {
    # std.str
    println("repeat=" + str_repeat("ab", 3))
    println("reverse=" + str_reverse("hello"))
    println("join=" + str_join(["x", "y", "z"], "-"))
    println("replace=" + str_replace("a-b-c", "-", "+"))
    println("upper=" + str_to_upper_ascii("Hello"))
    println("lower=" + str_to_lower_ascii("Hello"))
    println("count=" + str_count("aaa", "a").to_str())
    println("pad_left=[" + str_pad_left("12", 5, "0") + "]")

    # std.math
    println("max=" + math_max_int(3, 7).to_str())
    println("clamp=" + math_clamp_int(15, 0, 10).to_str())
    println("power=" + math_power_int(2, 10).to_str())
    println("sqrt=" + math_sqrt(2.0).to_str())

    # std.json
    let v: JsonValue = json_parse("{\"name\":\"Hieu\",\"age\":30}")
    println("name=" + json_object_get(v, "name").sval)
    println("age=" + json_object_get(v, "age").ival.to_str())
    let keys: list[str] = ["a", "b"]
    let vals: list[JsonValue] = [json_int(1), json_int(2)]
    let obj: JsonValue = json_object(keys, vals)
    println("json=" + json_stringify(obj))

    # std.url
    let u: Url = url_parse("http://example.com:8080/path?q=1#f")
    println("scheme=" + u.scheme)
    println("host=" + u.host)
    println("port=" + u.port.to_str())
    println("path=" + u.path)
    println("query=" + u.query)
    println("encoded=" + url_encode("a b c"))
    println("decoded=" + url_decode("a%20b%20c"))

    # std.html
    println("escaped=" + html_escape("<b>"))
    println("tag=" + html_tag("p", map_new(), "hello"))

    return 0
}
