# feat_contract_loop.hls — Stage 17: const-range loops + minlen facts.
# The for-range bound [0, 64) and the requires len >= 64 jointly prove
# every byte access in bounds; the loop counter increment is proven
# overflow-free.

fn sum_block(block: str) -> int
    requires block.len() >= 64
    requires block.len() <= 1000
{
    let mut acc: int = 0
    for i: int in range(0, 64) {
        if block.byte_at(i) >= 128 {
            acc = acc + 1
        }
    }
    return acc
}

fn main() -> int uses IO {
    let s: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let n: int = sum_block(s)
    println("uppercase-ish bytes=" + n.to_str() + " len=" + s.len().to_str())
    return 0
}
