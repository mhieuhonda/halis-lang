# panic/exit có kiểu "never": thoả mãn mọi đường return
fn boom_or_id(n: int) -> int {
    if n < 0 {
        panic("so am")
    }
    return n
}

fn main() -> int uses IO {
    println("ok1=" + boom_or_id(5).to_str())
    let xs: list[int] = []
    if xs.len() == 0 {
        println("danh sach rong")
    }
    println("ok2")
    return 0
}
