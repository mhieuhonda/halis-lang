# panic/exit has type "never": satisfies all return paths
fn boom_or_id(n: int) -> int {
    if n < 0 {
        panic("negative")
    }
    return n
}

fn main() -> int uses IO {
    println("ok1=" + boom_or_id(5).to_str())
    let xs: list[int] = []
    if xs.len() == 0 {
        println("empty list")
    }
    println("ok2")
    return 0
}
