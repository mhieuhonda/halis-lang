# feat_stage115_lsp_refactor.hls — Stage 115 (v0.134.0-alpha):
# LSP refactor actions (rename, extract, inline).
#
# What the differential suite pins HERE is the exact surface the
# language server rewrites — the same lets, loops, matches, structs and
# methods the refactor engine classifies before it offers to move a
# line:
#
#   python3 tools/hls-lsp.py  (textDocument/codeAction, textDocument/rename)
#   python3 boot/boot.py tests/ok/feat_stage115_lsp_refactor.hls
#
# The program: a pure helper whose result the server can inline into a
# single call site (one use, no reassignment — the safe shape), a
# selection with exactly one well-defined type for the probe to bind
# (`base * 2` is an int, and only an int), a mut binding reassigned in
# a loop the engine must REFUSE to inline, sibling blocks declaring the
# same name that a scope-aware rename keeps apart, a struct whose field
# renames through the dot, and a method whose impl declaration renames
# with its call sites. Deterministic output; interpreter and native
# agree byte for byte.

fn double(n: int) -> int {
    return n * 2
}

enum Shape {
    Circle(int),
    Square(int)
}

fn perimeter(sh: Shape) -> int {
    return match sh {
        Shape.Circle(r) => 6 * r,
        Shape.Square(s) => 4 * s
    }
}

struct Counter {
    step: int
}

impl Counter {
    fn bump(self: Counter) -> int {
        return self.step + 1
    }
}

fn loop_sum(limit: int) -> int {
    let mut acc: int = 0
    let mut i: int = 0
    while i < limit {
        acc = acc + double(i)
        i = i + 1
    }
    return acc
}

fn main() -> int uses IO {
    let base: int = 21
    let doubled: int = double(base)
    println(doubled.to_str())
    let scaled: int = base * 2 + 1
    println(scaled.to_str())
    println(loop_sum(4).to_str())
    let a: int = perimeter(Shape.Circle(2))
    let b: int = perimeter(Shape.Square(3))
    println((a + b).to_str())
    let c: Counter = Counter {
        step: 9
    }
    println(c.bump().to_str())
    if doubled > 40 {
        let label: str = "big"
        println(label)
    } else {
        let label: str = "small"
        println(label)
    }
    return 0
}
