# test_generic.hls — verify generics (struct, fn) and default field values
import "std.option"

struct Box[T] {
    value: T
}

struct Pair[A, B] {
    first: A,
    second: B
}

struct Point {
    x: int,
    y: int = 0,
    z: int = 0
}

fn box_make[T](v: T) -> Box[T] {
    return Box { value: v }
}

fn box_get[T](b: Box[T]) -> T {
    return b.value
}

fn identity[T](x: T) -> T {
    return x
}

fn first_of_pair[A, B](p: Pair[A, B]) -> A {
    return p.first
}

fn main() -> int uses IO {
    let bi: Box[int] = box_make(42)
    println("box int = " + box_get(bi).to_str())  # 42

    let bs: Box[str] = box_make("hello")
    println("box str = " + box_get(bs))  # hello

    let p: Pair[int, str] = Pair { first: 1, second: "two" }
    println("pair first = " + first_of_pair(p).to_str())  # 1

    # generic function inference
    let n: int = identity(100)
    let s: str = identity("world")
    println("identity int = " + n.to_str())  # 100
    println("identity str = " + s)  # world

    # struct with default field values
    let pt1: Point = Point { x: 5 }
    println("pt1 = " + pt1.x.to_str() + "," + pt1.y.to_str() + "," + pt1.z.to_str())  # 5,0,0

    let pt2: Point = Point { x: 1, y: 2 }
    println("pt2 = " + pt2.x.to_str() + "," + pt2.y.to_str() + "," + pt2.z.to_str())  # 1,2,0

    let pt3: Point = Point { x: 1, y: 2, z: 3 }
    println("pt3 = " + pt3.x.to_str() + "," + pt3.y.to_str() + "," + pt3.z.to_str())  # 1,2,3

    return 0
}
