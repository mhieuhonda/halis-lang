# feat_stage82_stack.hls — Stage 82: a `#![no_std]` crate exercising
# `core.stack` end to end: page arithmetic, StackConfig validation +
# geometry, offset classification, probes (panicking and non-panicking),
# remaining/overflow predicates, the frame cost model, chain/depth math,
# planning, fault names, and the canary pair — plus the integration with
# `core.panic` (the guard panics route through the Stage 81 handler, and
# a stack plan feeds a PanicLog). Exit code is 0 on success (the
# differential suite compares interpreter-vs-native exit codes); any
# positive exit code is the number of the first failed assertion.
#![no_std]

import "core.stack"
import "core.panic"

# An effect-free handler (no `uses` — the `#![no_std]` mode bans
# capabilities). The ok-test never panics; the handler only proves the
# two modules compose in the same crate.
#[panic_handler]
fn panic_handler(msg: str) -> void {
    let info: PanicInfo = panic_info_new(msg, "stack.hls", 0)
    let text: str = panic_format(info)
    if text.len() == 0 {
        return
    }
}

fn main() -> int {
    # ------------------------------------------------------------------
    # Page arithmetic (1..10)
    # ------------------------------------------------------------------
    if stack_page_size() != 4096 {
        return 1
    }
    if stack_page_align(4096) != 4096 {
        return 2
    }
    if stack_page_align(8191) != 4096 {
        return 3
    }
    if stack_page_align(12288) != 12288 {
        return 4
    }
    if stack_page_align_up(1) != 4096 {
        return 5
    }
    if stack_page_align_up(4096) != 4096 {
        return 6
    }
    if stack_page_align_up(4097) != 8192 {
        return 7
    }
    if stack_pages_for(0) != 0 {
        return 8
    }
    if stack_pages_for(1) != 1 {
        return 9
    }
    if stack_pages_for(4097) != 2 {
        return 10
    }

    # ------------------------------------------------------------------
    # StackConfig geometry + validation passing side (11..22)
    # ------------------------------------------------------------------
    let cfg: StackConfig = stack_config_new(16384, 2, 1048576)
    if stack_usable_bytes(cfg) != 16384 {
        return 11
    }
    if stack_guard_bytes(cfg) != 8192 {
        return 12
    }
    if stack_total_footprint(cfg) != 24576 {
        return 13
    }
    if stack_bottom(cfg) != 1032192 {
        return 14
    }
    if stack_guard_base(cfg) != 1024000 {
        return 15
    }
    if stack_total_footprint_size(8192, 1) != 12288 {
        return 16
    }
    # A one-page stack with a one-page guard.
    let tiny: StackConfig = stack_config_new(4096, 1, 8192)
    if stack_bottom(tiny) != 4096 {
        return 17
    }
    if stack_guard_base(tiny) != 0 {
        return 18
    }
    if stack_total_footprint(tiny) != 8192 {
        return 19
    }
    # Usable bytes is the declared size (mirror accessor).
    if stack_usable_bytes(tiny) != 4096 {
        return 20
    }
    # Offsets: 1 is the first legal write below the top.
    if stack_offset_valid(cfg, 1) == false {
        return 21
    }
    if stack_offset_valid(cfg, 16384) == false {
        return 22
    }

    # ------------------------------------------------------------------
    # Offset classification (23..30)
    # ------------------------------------------------------------------
    if stack_fault_code(stack_classify_offset(cfg, 1)) != 0 {
        return 23
    }
    if stack_fault_code(stack_classify_offset(cfg, 16384)) != 0 {
        return 24
    }
    # Past the size = the guard region (16385..24576).
    if stack_fault_code(stack_classify_offset(cfg, 16385)) != 1 {
        return 25
    }
    if stack_fault_code(stack_classify_offset(cfg, 24576)) != 1 {
        return 26
    }
    # Beyond the guard = unmapped nonsense.
    if stack_fault_code(stack_classify_offset(cfg, 24577)) != 2 {
        return 27
    }
    if stack_fault_code(stack_classify_offset(cfg, 0)) != 2 {
        return 28
    }
    if stack_fault_code(stack_classify_offset(cfg, -4)) != 2 {
        return 29
    }
    if stack_offset_valid(cfg, 16385) {
        return 30
    }

    # ------------------------------------------------------------------
    # Probes + predicates (31..40)
    # ------------------------------------------------------------------
    if stack_probe(cfg, 16) != 1048560 {
        return 31
    }
    if stack_probe(tiny, 4096) != 4096 {
        return 32
    }
    if stack_try_probe(cfg, 8) != 1048568 {
        return 33
    }
    # The non-panicking probe refuses the guard region.
    if stack_try_probe(cfg, 16385) != -1 {
        return 34
    }
    if stack_try_probe(cfg, 0) != -1 {
        return 35
    }
    if stack_has_overflow(cfg, 16384) {
        return 36
    }
    if stack_has_overflow(cfg, 16385) == false {
        return 37
    }
    if stack_remaining(cfg, 0) != 16384 {
        return 38
    }
    if stack_remaining(cfg, 16384) != 0 {
        return 39
    }
    if stack_remaining(cfg, 8192) != 8192 {
        return 40
    }

    # ------------------------------------------------------------------
    # Frame cost + chain math (41..50)
    # ------------------------------------------------------------------
    # Base overhead alone: 32 bytes.
    if stack_frame_cost(0, 0, 0) != 32 {
        return 41
    }
    # Two locals, one param, three call sites: 32 + 16 + 8 + 48.
    if stack_frame_cost(16, 1, 3) != 104 {
        return 42
    }
    if stack_chain_bytes(64, 0) != 0 {
        return 43
    }
    if stack_chain_bytes(64, 10) != 640 {
        return 44
    }
    if stack_max_depth(16384, 64) != 256 {
        return 45
    }
    if stack_max_depth(8192, 4096) != 2 {
        return 46
    }
    if stack_chain_fits(16384, 64, 256) == false {
        return 47
    }
    if stack_chain_fits(16384, 64, 257) {
        return 48
    }
    if stack_chain_fits(16384, 1, 16384) == false {
        return 49
    }
    if stack_chain_fits(16384, 2, 8193) {
        return 50
    }

    # ------------------------------------------------------------------
    # Planning (51..56)
    # ------------------------------------------------------------------
    # 64-byte frame, 100 deep: chain 6400, plus one page of slack
    # (interrupt frames, ABI padding), rounded to pages => 12288.
    let plan: StackConfig = stack_plan_new(64, 100, 1, 1048576)
    if stack_usable_bytes(plan) != 12288 {
        return 51
    }
    if stack_guard_bytes(plan) != 4096 {
        return 52
    }
    # The plan always fits its own workload (the plan's invariant).
    if stack_chain_fits(stack_usable_bytes(plan), 64, 100) == false {
        return 53
    }
    # A page-aligned chain still gets its slack page: 128*256 = 32768
    # + 4096 = 36864 (the slack is unconditional, so the plan is
    # deterministic without case analysis).
    let exact: StackConfig = stack_plan_new(128, 256, 1, 1048576)
    if stack_usable_bytes(exact) != 36864 {
        return 54
    }
    # Depth 0 still reserves the slack page (interrupt frames, ABI).
    let idle: StackConfig = stack_plan_new(64, 0, 2, 1048576)
    if stack_usable_bytes(idle) != 4096 {
        return 55
    }
    if stack_has_overflow(idle, 4096) {
        return 56
    }

    # ------------------------------------------------------------------
    # Fault names + canary (57..63)
    # ------------------------------------------------------------------
    if stack_fault_name(StackFault.None) != "none" {
        return 57
    }
    if stack_fault_name(StackFault.GuardPage) != "guard-page" {
        return 58
    }
    if stack_fault_name(StackFault.BadOffset) != "bad-offset" {
        return 59
    }
    if stack_fault_code(StackFault.None) != 0 {
        return 60
    }
    if stack_fault_code(StackFault.GuardPage) != 1 {
        return 61
    }
    if stack_fault_code(StackFault.BadOffset) != 2 {
        return 62
    }
    if stack_canary_value() != 6510615555426900570 {
        return 63
    }
    if stack_canary_ok(stack_canary_value()) == false {
        return 64
    }
    # A disturbed canary (zero-writes are the classic smash) is caught.
    if stack_canary_ok(0) {
        return 65
    }

    # ------------------------------------------------------------------
    # Integration: a stack plan feeding the Stage 81 post-mortem log
    # (66..69)
    # ------------------------------------------------------------------
    let log: PanicLog = panic_log_new(4)
    let mut d: int = 1
    while d <= 3 {
        let budget: StackConfig = stack_plan_new(64, d, 1, 1048576)
        panic_log_push(log, "depth " + d.to_str() + " needs "
        + stack_usable_bytes(budget).to_str())
        d = d + 1
    }
    if panic_log_len(log) != 3 {
        return 66
    }
    if panic_log_get(log, 0) != "depth 1 needs 8192" {
        return 67
    }
    if panic_log_get(log, 2) != "depth 3 needs 8192" {
        return 68
    }
    if panic_log_dropped(log) != 0 {
        return 69
    }

    return 0
}
