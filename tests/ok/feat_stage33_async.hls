# tests/ok/feat_stage33_async.hls — Stage 33 (v0.52.0-alpha): async/await
# zero-runtime futures.
#
# Exercises every primitive:
#   - async_spawn(f, args...) -> Future[T]
#   - await(fut) -> T
#   - future_ready(v) -> Future[T]
#   - future_poll(fut) -> Option[T]
#   - future_select(futs) -> int
#
# And the std.async combinators:
#   - async_run_all_int(futs) -> list[int]
#   - async_race_int(futs) -> int
#   - async_all_ok(futs) -> bool
#   - async_any_ok(futs) -> bool

import "std.async"
import "std.option"

fn square(n: int) -> int {
    return n * n
}

fn slow_double(n: int) -> int uses Conc {
    let t: Task[int] = spawn(square, n)
    return t.join()
}

fn is_positive(n: int) -> bool {
    return n > 0
}

fn main() -> int uses IO, Conc {
    # async_spawn + await
    let f: Future[int] = async_spawn(slow_double, 7)
    let r: int = await(f)
    if r != 49 {
        panic("async_spawn(slow_double, 7) failed: got " + r.to_str())
    }

    # future_ready + await
    let f2: Future[int] = future_ready(42)
    if await(f2) != 42 {
        panic("future_ready(42) failed")
    }

    # future_poll on a ready future
    let f3: Future[int] = future_ready(99)
    let p: Option[int] = future_poll(f3)
    if !option_is_some(p) {
        panic("future_poll on ready future should be Some")
    }
    if option_unwrap(p) != 99 {
        panic("future_poll value mismatch")
    }

    # future_poll on a pending future (async_spawn not yet done)
    # NOTE: we can't guarantee the future is pending, so just verify
    # that poll eventually returns Some after await completes.
    let f4: Future[int] = async_spawn(slow_double, 5)
    let r4: int = await(f4)
    if r4 != 25 {
        panic("async_spawn(slow_double, 5) failed: got " + r4.to_str())
    }

    # future_select
    let f5: Future[int] = future_ready(100)
    let f6: Future[int] = future_ready(200)
    let idx: int = future_select([f5, f6])
    if idx < 0 || idx > 1 {
        panic("future_select returned invalid index: " + idx.to_str())
    }

    # async_run_all_int
    let f7: Future[int] = async_spawn(slow_double, 3)
    let f8: Future[int] = async_spawn(slow_double, 4)
    let f9: Future[int] = async_spawn(slow_double, 5)
    let results: list[int] = async_run_all_int([f7, f8, f9])
    if results.get(0) != 9 || results.get(1) != 16 || results.get(2) != 25 {
        panic("async_run_all_int failed")
    }

    # async_race_int
    let f10: Future[int] = async_spawn(slow_double, 10)
    let race_result: int = async_race_int([f10])
    if race_result != 100 {
        panic("async_race_int failed: got " + race_result.to_str())
    }

    # async_all_ok (all true)
    let b1: Future[bool] = future_ready(true)
    let b2: Future[bool] = future_ready(true)
    if !async_all_ok([b1, b2]) {
        panic("async_all_ok (all true) should be true")
    }

    # async_all_ok (one false)
    let b3: Future[bool] = future_ready(true)
    let b4: Future[bool] = future_ready(false)
    if async_all_ok([b3, b4]) {
        panic("async_all_ok (one false) should be false")
    }

    # async_any_ok (at least one true)
    let b5: Future[bool] = future_ready(true)
    let b6: Future[bool] = future_ready(true)
    if !async_any_ok([b5, b6]) {
        panic("async_any_ok (all true) should be true")
    }

    println("stage33 async ok")
    return 0
}
