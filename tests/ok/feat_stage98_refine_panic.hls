# Stage 98 (v0.117.0-alpha): a refinement violation at RUNTIME must be
# a clean panic (exit 101) in BOTH implementations, before any
# subsequent statement runs. The value comes from a non-constant
# expression, so the compile-time constant check defers to the guard.

fn step(v: int) -> int {
    return v - 1
}

fn main() -> int uses IO {
    let n: int = 0
    let p: int where self > 0 = step(n)
    # unreachable in a correct implementation: the guard on the line
    # above must fire first, in the interpreter and in the native build
    println("unreachable")
    return 0
}
