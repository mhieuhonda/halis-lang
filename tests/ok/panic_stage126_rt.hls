# ============================================================================
# tests/ok/panic_stage126_rt.hls — Stage 126 acceptance: enforce-over
# panics through the Stage 81 path with the canonical message
# ----------------------------------------------------------------------------
# rt_cycle_enforce is the model's enforcement primitive: a within-budget
# cycle returns, an over-budget one panics. This fixture closes an
# over-budget cycle on purpose — the run MUST die with exit 101 and the
# canonical soft-real-time message, byte-for-byte the string the native
# runtime's in-process enforcement prints (the model and the runtime
# cannot disagree about what a violation looks like).
#
# The master suite accepts exit 101 for panic fixtures; the Stage 126
# acceptance additionally asserts the message shape on both backends.
# ============================================================================

import "core.rt"

fn main() -> int uses IO {
    let b: RtBudget = rt_budget_new(1000, 0, 0)
    let c: RtCycle = RtCycle {
        index: 7, allocs: 1200, bytes: 0,
        live_bytes: 0, nanos: 0
    }
    # over the allocs budget by 200: the enforce dies here —
    # "soft real-time violation: cycle 7 made 1200 allocations (budget 1000)"
    rt_cycle_enforce(c, b)
    println("unreachable: an over-budget cycle must not return")
    return 0
}
