# Test the import system: split code across two files.
# This file imports a helper module that defines `add_numbers` and a struct.
#
# Deep-scan-21 fix: the previous import path "../modules/helper.hls"
# was rejected by the deep-scan-19 path-traversal guard (which
# forbids `..` segments in import paths to prevent services that
# compile untrusted HLS from reading arbitrary host files via
# crafted import paths). The fix: move the helper into a
# subdirectory of the importing file's directory (`tests/ok/modules/`)
# and use a downward-only relative path.
import "modules/helper.hls"

fn main() -> int uses IO {
    let a: int = add_numbers(3, 4)
    println("3 + 4 = " + a.to_str())
    let p: Point = make_point(5, 7)
    println("point x=" + p.x.to_str() + " y=" + p.y.to_str())
    return 0
}
