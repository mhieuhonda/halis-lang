# Deep-scan-7: range() with a HUGE upper bound must panic cleanly
# instead of exhausting memory. The cap is 1M elements; any request
# for more is rejected with an HLPanic exit code 101.
#
# We use a more moderate range to make the test fast.
fn main() -> int uses IO {
    let xs: list[int] = range(0, 100)
    let mut sum: int = 0
    let mut i: int = 0
    while i < xs.len() {
        sum = sum + xs.get(i)
        i = i + 1
    }
    println("range(0, 100) sum: " + sum.to_str())
    return 0
}
