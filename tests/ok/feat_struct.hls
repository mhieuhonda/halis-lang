# Kiểm thử struct: phương thức, mut self, struct lồng, tham chiếu
struct Point {
    x: int,
    y: int
}

struct Rect {
    top_left: Point,
    bottom_right: Point
}

impl Point {
    fn dist2(self: Point) -> int {
        return self.x * self.x + self.y * self.y
    }
    fn move_x(mut self: Point, d: int) -> void {
        self.x = self.x + d
    }
    fn same(self: Point, other: Point) -> bool {
        return self.x == other.x && self.y == other.y
    }
}

impl Rect {
    fn width(self: Rect) -> int {
        return self.bottom_right.x - self.top_left.x
    }
    fn stretch(mut self: Rect, w: int) -> void {
        self.bottom_right.move_x(w)
    }
}

fn make_point(x: int, y: int) -> Point {
    return Point { x: x, y: y }
}

fn main() -> int uses IO {
    let p: Point = make_point(3, 4)
    println("dist2=" + p.dist2().to_str())
    p.move_x(1)
    println("x_after=" + p.x.to_str())

    # tham chiếu: q cùng trỏ tới p
    let q: Point = p
    q.move_x(10)
    println("ref_shared=" + p.x.to_str())

    let r: Rect = Rect {
        top_left: Point { x: 0, y: 0 },
        bottom_right: Point { x: 10, y: 5 }
    }
    println("width=" + r.width().to_str())
    r.stretch(7)
    println("width_after=" + r.width().to_str())
    println("same=" + p.same(Point { x: 14, y: 4 }).to_str())

    # struct trong danh sách
    let pts: list[Point] = [make_point(1, 1), make_point(2, 2)]
    let mut total: int = 0
    for pt: Point in pts {
        total = total + pt.dist2()
    }
    println("total_d2=" + total.to_str())

    # gán trường
    let mut origin: Point = make_point(0, 0)
    origin.x = 100
    println("origin_x=" + origin.x.to_str())
    return 0
}
