# feat_stage111_cap_family.hls — Stage 111 (v0.130.0-alpha).
# Cap[IO] is the family token: exactly like `uses IO` expands to
# {IO, Fs, Clock, Args, Exit} at parse time, ONE Cap[IO] parameter
# confers the whole hosted family. The worker below prints and reads a
# file it just wrote (Fs + IO) holding only Cap[IO].

fn worker(c: Cap[IO]) -> int {
    write_file("/tmp/halis_cap_family_demo.txt", "authority via one token\n")
    let body: str = read_file("/tmp/halis_cap_family_demo.txt")
    println(body)
    return body.len()
}

fn main() -> int {
    let io: Cap[IO] = cap_take("IO")
    let n: int = worker(io)
    println("len=" + n.to_str())
    return 0
}
