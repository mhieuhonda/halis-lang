# feat_stdlib_csv.hls — verify std.csv parsing and round-trip.
import "std.csv"

fn main() -> int uses IO {
    # Simple parse.
    let src: str = "a,b,c\n1,2,3"
    let rows: list[list[str]] = csv_parse_default(src)
    if rows.len() != 2 {
        println("FAIL: row count " + rows.len().to_str())
        return 1
    }
    let row0: list[str] = rows.get(0)
    if row0.len() != 3 || row0.get(0) != "a" || row0.get(2) != "c" {
        println("FAIL: row0")
        return 1
    }
    let row1: list[str] = rows.get(1)
    if row1.get(1) != "2" {
        println("FAIL: row1[1] = " + row1.get(1))
        return 1
    }

    # Quoted field with embedded comma.
    let q: str = "id,desc\n1,\"hello, world\"\n2,plain"
    let q_rows: list[list[str]] = csv_parse_default(q)
    let r1: list[str] = q_rows.get(1)
    if r1.get(1) != "hello, world" {
        println("FAIL: quoted comma = " + r1.get(1))
        return 1
    }

    # Quoted field with escaped double-quote ("") .
    let eq: str = "x,y\n1,\"has \"\"quotes\"\"\"\n2,end"
    let eq_rows: list[list[str]] = csv_parse_default(eq)
    let er1: list[str] = eq_rows.get(1)
    if er1.get(1) != "has \"quotes\"" {
        println("FAIL: escaped quotes = " + er1.get(1))
        return 1
    }

    # Round-trip: parse -> stringify should preserve quoted fields.
    let original: str = "name,note\nAlice,\"Hello, World\"\nBob,\"Line\nbreak\""
    let parsed: list[list[str]] = csv_parse_default(original)
    let rebuilt: str = csv_stringify_default(parsed)
    if rebuilt != original {
        println("FAIL: round-trip")
        println("original:")
        println(original)
        println("rebuilt:")
        println(rebuilt)
        return 1
    }

    # Tab-separated via custom delimiter (9 = TAB).
    let tabs: str = "a\tb\tc\n1\t2\t3"
    let tab_rows: list[list[str]] = csv_parse(tabs, 9)
    if tab_rows.len() != 2 {
        println("FAIL: tab row count")
        return 1
    }

    println("OK: csv")
    return 0
}
