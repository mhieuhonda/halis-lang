# tests/ok/feat_stage32_bench.hls — Stage 32 (v0.51.0-alpha) regression test.
#
# Exercises every optimised stdlib function introduced or rewritten
# in Stage 32:
#   - str_repeat / str_pad_left / str_pad_right (O(n) join-based)
#   - json_stringify / jsonp_encode_string (O(n) join-based)
#   - list_sort_int_asc / list_sort_int_desc (pre-sized + shift)
#   - bits_and / bits_or / bits_xor / bits_not / bits_shl / bits_shr /
#     bits_sar / bits_popcount / bits_clz / bits_ctz / bits_byte /
#     bits_bytes_be / bits_bytes_le / bits_from_bytes_be /
#     bits_from_bytes_le (now backed by native int_and / int_or / ...)
#   - crypto_crc32 / crypto_fnv1a_32 (now using native bitwise builtins)
#   - hex_encode (O(n) join + slice lookup)
#
# This test does NOT time the functions (that's the job of hls-bench.py);
# it only verifies CORRECTNESS after the Stage 32 rewrites. If any of
# the optimisations introduced a behavioural change, this test fails.

import "std.str"
import "std.list"
import "std.json"
import "std.bits"
import "std.crypto"
import "std.hex"

fn main() -> int uses IO {
    # ---- str_repeat (was: O(n²) accumulating concat) ----
    if str_repeat("ab", 5) != "ababababab" {
        panic("str_repeat(ab,5) failed")
    }
    if str_repeat("", 5) != "" {
        panic("str_repeat(empty,5) failed")
    }
    if str_repeat("x", 0) != "" {
        panic("str_repeat(x,0) failed")
    }

    # ---- str_pad_left / str_pad_right (was: O(n²) gap-fill) ----
    if str_pad_left("x", 5, "0") != "0000x" {
        panic("str_pad_left failed")
    }
    if str_pad_right("x", 5, "0") != "x0000" {
        panic("str_pad_right failed")
    }
    if str_pad_left("ab", 6, "xyz") != "xxyzab" {
        panic("str_pad_left overshoot failed")
    }

    # ---- json_stringify (was: O(n²) accumulating concat) ----
    let jv: JsonValue = json_object(
        ["name", "scores", "active"],
        [json_str("alice"), json_array([json_int(95), json_int(88), json_int(72)]), json_bool(true)]
    )
    if json_stringify(jv) != "{\"name\":\"alice\",\"scores\":[95,88,72],\"active\":true}" {
        panic("json_stringify object failed")
    }
    let jarr: JsonValue = json_array([json_int(1), json_int(2), json_int(3)])
    if json_stringify(jarr) != "[1,2,3]" {
        panic("json_stringify array failed")
    }

    # ---- list_sort_int_asc / list_sort_int_desc (pre-sized + shift) ----
    let xs: list[int] = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]
    let sorted_asc: list[int] = list_sort_int_asc(xs)
    if sorted_asc.get(0) != 1 || sorted_asc.get(10) != 9 {
        panic("list_sort_int_asc failed")
    }
    let sorted_desc: list[int] = list_sort_int_desc(xs)
    if sorted_desc.get(0) != 9 || sorted_desc.get(10) != 1 {
        panic("list_sort_int_desc failed")
    }
    # Empty list edge case.
    let empty: list[int] = []
    if list_sort_int_asc(empty).len() != 0 {
        panic("list_sort_int_asc(empty) failed")
    }
    if list_sort_int_desc(empty).len() != 0 {
        panic("list_sort_int_desc(empty) failed")
    }

    # ---- bits_* (now backed by native int_and / int_or / ...) ----
    if bits_and(12, 10) != 8 {
        panic("bits_and failed")
    }
    if bits_or(12, 10) != 14 {
        panic("bits_or failed")
    }
    if bits_xor(12, 10) != 6 {
        panic("bits_xor failed")
    }
    if bits_not(0) != -1 {
        panic("bits_not(0) failed")
    }
    if bits_not(-1) != 0 {
        panic("bits_not(-1) failed")
    }
    if bits_shl(1, 4) != 16 {
        panic("bits_shl 1<<4 failed")
    }
    if bits_shl(1, 63) != -9223372036854775808 {
        panic("bits_shl 1<<63 failed")
    }
    if bits_shr(-1, 0) != -1 {
        panic("bits_shr -1>>0 failed")
    }
    if bits_shr(-1, 1) != 9223372036854775807 {
        panic("bits_shr -1>>1 failed")
    }
    if bits_sar(-1024, 4) != -64 {
        panic("bits_sar -1024>>4 failed")
    }
    if bits_popcount(0) != 0 {
        panic("bits_popcount(0) failed")
    }
    if bits_popcount(255) != 8 {
        panic("bits_popcount(255) failed")
    }
    if bits_popcount(-1) != 64 {
        panic("bits_popcount(-1) failed")
    }
    if bits_clz(0) != 64 {
        panic("bits_clz(0) failed")
    }
    if bits_clz(1) != 63 {
        panic("bits_clz(1) failed")
    }
    if bits_ctz(0) != 64 {
        panic("bits_ctz(0) failed")
    }
    if bits_ctz(256) != 8 {
        panic("bits_ctz(256) failed")
    }
    # Byte / multi-byte helpers.
    if bits_byte(305419896, 0) != 120 {
        panic("bits_byte(0x12345678, 0) failed")
    }
    let bs: list[int] = bits_bytes_be(1311768467463790320)
    if bs.get(0) != 18 || bs.get(7) != 240 {
        panic("bits_bytes_be failed")
    }
    if bits_from_bytes_be(bs) != 1311768467463790320 {
        panic("bits_from_bytes_be roundtrip failed")
    }
    let bsle: list[int] = bits_bytes_le(1311768467463790320)
    if bsle.get(0) != 240 || bsle.get(7) != 18 {
        panic("bits_bytes_le failed")
    }
    if bits_from_bytes_le(bsle) != 1311768467463790320 {
        panic("bits_from_bytes_le roundtrip failed")
    }

    # ---- crypto_crc32 / crypto_fnv1a_32 (now using native bitwise) ----
    # CRC-32 of "hello" = 0x3610a686 = 907060870
    if crypto_crc32("hello") != 907060870 {
        panic("crypto_crc32(hello) failed: got " + crypto_crc32("hello").to_str())
    }
    # FNV-1a 32 of "hello" = 0x4f9f2cab = 1335831723
    if crypto_fnv1a_32("hello") != 1335831723 {
        panic("crypto_fnv1a_32(hello) failed: got " + crypto_fnv1a_32("hello").to_str())
    }

    # ---- hex_encode (O(n) join + slice lookup) ----
    if hex_encode("hello") != "68656c6c6f" {
        panic("hex_encode(hello) failed: got " + hex_encode("hello"))
    }
    if hex_encode("") != "" {
        panic("hex_encode(empty) failed")
    }

    println("stage32 ok")
    return 0
}
