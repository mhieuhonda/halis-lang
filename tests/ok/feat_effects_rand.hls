# tests/ok/feat_effects_rand.hls — Stage 9 release (v0.20.0-alpha).
#
# Demonstrates the newly-activated Rand effect. rand_int(max) returns
# a uniform random int in [0, max); rand_float() returns a uniform
# random float in [0.0, 1.0); rand_seed(s) seeds the PRNG. The same
# seed produces the SAME sequence in both Stage-0 (Python) and the
# native runtime (C) — the LCG is shared between the two backends so
# differential testing passes.

fn roll_sum(seed: int, n: int) -> int uses Rand {
    rand_seed(seed)
    let mut total: int = 0
    let mut i: int = 0
    while i < n {
        total = total + rand_int(1000)
        i = i + 1
    }
    return total
}

fn float_sum(seed: int, n: int) -> float uses Rand {
    rand_seed(seed)
    let mut total: float = 0.0
    let mut i: int = 0
    while i < n {
        total = total + rand_float()
        i = i + 1
    }
    return total
}

fn main() -> int uses IO, Rand {
    let s: int = roll_sum(42, 100)
    println("sum of 100 d1000s with seed 42: " + s.to_str())

    # Same seed produces the same sequence (deterministic).
    let s2: int = roll_sum(42, 100)
    println("repeat with same seed: " + s2.to_str())

    # Different seed produces a different sequence.
    let s3: int = roll_sum(43, 100)
    println("different seed (43): " + s3.to_str())

    let f: float = float_sum(12345, 5)
    println("float sum (5x rand_float): " + f.to_str())

    return 0
}
