# feat_clone — Stage 8-alpha: independent deep copy via clone()
# Verifies that clone() produces an independent value (mutating the clone
# does not affect the original).

fn main() -> int uses IO {
    let xs: list[int] = [1, 2, 3]
    let ys: list[int] = clone(xs)
    ys.push(4)
    if xs.len() == 3 && ys.len() == 4 {
        println("clone is independent")
    } else {
        println("clone failed")
        return 1
    }
    let s1: str = "abc"
    let s2: str = clone(s1)
    if s1 == s2 {
        println("clone of str ok")
    }
    return 0
}
