# feat_deep_scan5_json.hls — regression tests for the deep-scan-5 JSON
# fixes: json_parse_result (non-panicking parse of untrusted input),
# inf/nan serialising as null (RFC 8259), and number validation
# (malformed numbers give positioned errors instead of raw to_int /
# to_float panics). Differential: interpreter and native must agree.
import "std.json"

fn main() -> int uses IO {
    # Valid document round-trip.
    let v: JsonValue = json_parse("{\"a\": [1, 2.5, \"x\"], \"b\": true, \"n\": null}")
    println(json_stringify(v))

    # inf / NaN are not representable in JSON -> null (RFC 8259 §6).
    let pinf: float = 1.0 / 0.0
    let inf_v: JsonValue = json_float(pinf)
    println("inf=" + json_stringify(inf_v))
    let nan_v: JsonValue = json_float(pinf - pinf)
    println("nan=" + json_stringify(nan_v))
    let finite: JsonValue = json_float(1.5)
    println("finite=" + json_stringify(finite))

    # json_parse_result: malformed input returns Result.Err with a
    # positioned message (no panic).
    let cases: list[str] = ["{", "-", "1e", "9223372036854775808", "[1,]"]
    let mut i: int = 0
    while i < cases.len() {
        let r: Result[JsonValue, str] = json_parse_result(cases.get(i))
        println("case" + i.to_str() + "=" + result_err_or(r, "OK"))
        i = i + 1
    }
    # Valid input through the Result API.
    let ok_r: Result[JsonValue, str] = json_parse_result("[1, 2]")
    println("valid=" + result_err_or(ok_r, "OK"))
    return 0
}
