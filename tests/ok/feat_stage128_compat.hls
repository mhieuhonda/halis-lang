# feat_stage128_compat.hls — Stage 128 (v0.146.0-alpha): the
# backwards-compatibility test suite over every prior ok corpus.
#
# What the differential suite pins HERE is the classification the tool
# lives on — the same verdict lattice `hls-compat` computes when it
# replays 170 releases' worth of acceptance fixtures against today's
# toolchain:
#
#   python3 tools/hls-compat.py
#
#   hls-compat: 170 release tags censused
#   hls-compat: union corpus: 24591 file-instances -> 326 unique
#   programs (dedup 75.4x)
#   hls-compat: verdict COMPATIBLE — ... 0 regressions
#
# The program: a miniature compat ledger — the verdict lattice (green,
# expected-panic, waived, regression, reconciled), the two-way ledger
# law (a failure without an entry is a regression; an entry without a
# failure is stale), the content-dedup law (an unchanged program is
# verified once, however many releases shipped it), and the
# time-travel law (a program green under its own release and green
# today agrees; green then and failing now is a waiver's job to name).
# This very file enters the corpus at the next release — the suite's
# own canary, green the day it is born and expected green ever after.

# The verdict lattice, as a value: exit 0 is green, exit 101 is the
# expected-panic convention the suite itself has always accepted, and
# anything else is a failure whose meaning depends on the ledger.
enum Verdict {
    Compatible,
    ExpectedPanic,
    Waived,
    Regression,
    Reconciled
}

fn verdict_str(v: Verdict) -> str {
    return match v {
        Verdict.Compatible => "COMPATIBLE",
        Verdict.ExpectedPanic => "COMPATIBLE-PANIC",
        Verdict.Waived => "WAIVED",
        Verdict.Regression => "REGRESSION",
        Verdict.Reconciled => "RECONCILED"
    }
}

# The classification rule: a run's exit code plus the ledger's answer
# for that exact program decide the verdict. Green is green; a failure
# the ledger names is waived; a failure it does not name is the alarm.
# A ledgered program that runs green again has outlived its waiver.
fn classify(exit: int, in_ledger: bool) -> Verdict {
    if exit == 0 {
        if in_ledger {
            return Verdict.Reconciled
        }
        return Verdict.Compatible
    }
    if exit == 101 {
        if in_ledger {
            return Verdict.Reconciled
        }
        return Verdict.ExpectedPanic
    }
    if in_ledger {
        return Verdict.Waived
    }
    return Verdict.Regression
}

# The two-way ledger law: the failures and the entries must face each
# other exactly. A failure with no entry is a regression; an entry
# with no failure is a stale excuse. Both directions are problems —
# the ledger is a living document, not an archive of reasons.
fn ledger_faces_failures(failures: list[str], entries: list[str]) -> bool {
    let seen_fail: map[str, int] = map_new()
    let mut i: int = 0
    while i < failures.len() {
        seen_fail.set(failures.get(i), 1)
        i = i + 1
    }
    let seen_entry: map[str, int] = map_new()
    i = 0
    while i < entries.len() {
        seen_entry.set(entries.get(i), 1)
        if !seen_fail.has(entries.get(i)) {
            return false
        }
        i = i + 1
    }
    i = 0
    while i < failures.len() {
        if !seen_entry.has(failures.get(i)) {
            return false
        }
        i = i + 1
    }
    return true
}

# The dedup law: the corpus is content-addressed. A program shipped by
# N releases but never changed is ONE program, run once — the census
# keys on what the program IS, not on which tag happened to carry it.
fn unique_programs(instances: list[str]) -> int {
    let seen: map[str, int] = map_new()
    let mut i: int = 0
    while i < instances.len() {
        seen.set(instances.get(i), 1)
        i = i + 1
    }
    return seen.len()
}

# The time-travel law: the witness runs the program under its own
# release and under today's toolchain. Agreement is the norm; the only
# sanctioned disagreement is old-green-to-new-failed, and only when
# the ledger names it. Old-green to new-green with a waiver would mean
# the waiver lies; new-green to old-failed would mean the release
# shipped a red corpus.
fn travel_ok(old_green: bool, new_green: bool, waived: bool) -> bool {
    if old_green && new_green {
        return !waived
    }
    if old_green && !new_green {
        return waived
    }
    return false
}

fn main() -> int uses IO {
    let mut checks: int = 0

    # The lattice: five verdicts, five roads through classify. The two
    # green exits keep their distinction — the expected-panic fixtures
    # have been green since v0.1.0's corpus and say so by exiting 101.
    if verdict_str(classify(0, false)) != "COMPATIBLE" {
        panic("exit 0 unledgered must be COMPATIBLE")
    }
    if verdict_str(classify(101, false)) != "COMPATIBLE-PANIC" {
        panic("exit 101 unledgered must be COMPATIBLE-PANIC")
    }
    if verdict_str(classify(1, true)) != "WAIVED" {
        panic("a failure the ledger names is WAIVED")
    }
    if verdict_str(classify(1, false)) != "REGRESSION" {
        panic("a failure the ledger does not name is REGRESSION")
    }
    if verdict_str(classify(0, true)) != "RECONCILED" {
        panic("a ledgered program that runs green is RECONCILED")
    }
    checks = checks + 1

    # The two-way law, both directions: the five census-visible
    # sanctioned breaks of the real ledger (import, asm, perfection,
    # hex64, xxHash) face five failures and nothing else — the drift
    # and resurrect kinds are the time-travel leg's to verify, not the
    # census's.
    let real_failures: list[str] = []
    real_failures.push("import")
    real_failures.push("asm")
    real_failures.push("perfection")
    real_failures.push("hex64")
    real_failures.push("xxhash")
    let real_entries: list[str] = []
    real_entries.push("import")
    real_entries.push("asm")
    real_entries.push("perfection")
    real_entries.push("hex64")
    real_entries.push("xxhash")
    if !ledger_faces_failures(real_failures, real_entries) {
        panic("the real ledger faces its failures exactly")
    }
    let short_entries: list[str] = []
    short_entries.push("import")
    short_entries.push("asm")
    if ledger_faces_failures(real_failures, short_entries) {
        panic("an entry short is a failure the tool must catch")
    }
    let short_failures: list[str] = []
    short_failures.push("import")
    if ledger_faces_failures(short_failures, real_entries) {
        panic("a failure short is a regression the tool must catch")
    }
    checks = checks + 1

    # The dedup law: one program shipped by six releases, another by
    # two, a third by two more — 10 instances, 3 programs. The census
    # runs three times, not ten.
    let shipped: list[str] = []
    shipped.push("arith")
    shipped.push("arith")
    shipped.push("arith")
    shipped.push("match")
    shipped.push("match")
    shipped.push("arith")
    shipped.push("import")
    shipped.push("import")
    shipped.push("arith")
    shipped.push("arith")
    if unique_programs(shipped) != 3 {
        panic("10 instances over 3 programs must dedup to 3")
    }
    checks = checks + 1

    # The time-travel law: agreement, the sanctioned break, and the
    # two lies the witness exists to catch.
    if !travel_ok(true, true, false) {
        panic("old-green new-green agrees (unwaived)")
    }
    if !travel_ok(true, false, true) {
        panic("old-green new-failed is the waiver's one sanction")
    }
    if travel_ok(true, true, true) {
        panic("a waiver on a green program lies")
    }
    if travel_ok(false, true, false) {
        panic("a release that shipped its own corpus red is not agreement")
    }
    checks = checks + 1

    # The canary: this file joins the corpus at the next release, and
    # every check above is a claim about the code the tool shares with
    # the compiler — the arithmetic of "still works" made executable.
    if checks != 4 {
        panic("expected 4 checks, ran " + checks.to_str())
    }
    println("compat ledger: every prior ok corpus, replayed today")
    println("verdicts: 5, ledger law: two-way, dedup: content-keyed")
    println("checks passed: " + checks.to_str())
    return 0
}
