# feat_conc_spawn.hls — Stage 16 (v0.27.0-alpha): spawn + join.
# spawn(f, args...) starts a task; the Task[R] handle joins exactly once.

fn double(n: int) -> int {
    return n * 2
}

fn greet(name: str) -> int uses IO {
    println("hello from task: " + name)
    return name.len()
}

fn noop() -> int {
    return 7
}

fn main() -> int uses IO, Conc {
    # 1. spawn with an int argument (primitive — Copy, passes raw).
    let t1: Task[int] = spawn(double, 21)
    let r1: int = t1.join()
    println("double=" + r1.to_str())

    # 2. spawn with a str literal (fresh allocation — private).
    let t2: Task[int] = spawn(greet, "hieu")
    let r2: int = t2.join()
    println("len=" + r2.to_str())

    # 3. spawn with no arguments at all.
    let t3: Task[int] = spawn(noop)
    let r3: int = t3.join()
    println("noop=" + r3.to_str())
    return 0
}
