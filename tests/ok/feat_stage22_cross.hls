# feat_stage22_cross.hls — Stage 22 (v0.41.0-alpha) cross-compilation test.
#
# A small program that exercises the standard library + IO + arithmetic
# — the kind of program that should cross-compile to ANY of the
# supported targets (Linux/macOS/Windows/FreeBSD) and produce the same
# stdout on every target. The differential suite (sections 1/3) covers
# the interpreter vs native build; Stage 22 adds the cross-compiled
# build as a third path (where the cross-linker is available).
#
# The program is deliberately simple: it doesn't use platform-specific
# features (no extern "C", no file paths, no environment variables).
# Its output depends only on the HLS standard library, which is pure
# HLS and target-independent.

import "std.list"
import "std.str"

fn build_summary() -> str {
    let xs: list[int] = [3, 1, 4, 1, 5, 9, 2, 6]
    let sorted: list[int] = list_sort_int_asc(xs)
    # Build a comma-separated summary string.
    let parts: list[str] = []
    let mut i: int = 0
    while i < sorted.len() {
        parts.push(sorted.get(i).to_str())
        i = i + 1
    }
    return "sorted: " + join(parts, ",")
}

fn main() -> int uses IO {
    println("=== Stage 22 cross-compilation test ===")
    println("platform-independent output:")
    println("  1 + 1 = " + (1 + 1).to_str())
    println("  10 * 10 = " + (10 * 10).to_str())
    println("  str_to_upper_ascii('hello') = " + str_to_upper_ascii("hello"))
    println("  " + build_summary())
    println("=== end ===")
    return 0
}
