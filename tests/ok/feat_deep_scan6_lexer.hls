# feat_deep_scan6_lexer.hls — exercises the SCAN-C fix for scientific
# float notation in HLS literals (the lexer previously split `1e10` into
# float `1` + ident `e10`).

fn main() -> int uses IO {
    let a: float = 1.5
    let b: float = 1e3        # = 1000.0
    let c: float = 1.5e-3     # = 0.0015
    let d: float = 9.223372036854776e18  # INT64_MAX as a double
    println("a=" + a.to_str())
    println("b=" + b.to_str())
    println("c=" + c.to_str())
    if d > 1e17 {
        println("d is big")
    }
    return 0
}
