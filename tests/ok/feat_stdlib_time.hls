# feat_stdlib_time.hls — verify std.time formatting helpers (pure parts only).
import "std.time"

fn main() -> int uses IO {
    # Format HH:MM:SS.mmm
    if time_format_hms(0) != "00:00:00.000" {
        println("FAIL: hms(0) = " + time_format_hms(0))
        return 1
    }
    if time_format_hms(1) != "00:00:00.001" {
        println("FAIL: hms(1)")
        return 1
    }
    if time_format_hms(999) != "00:00:00.999" {
        println("FAIL: hms(999)")
        return 1
    }
    if time_format_hms(1000) != "00:00:01.000" {
        println("FAIL: hms(1000)")
        return 1
    }
    if time_format_hms(61000) != "00:01:01.000" {
        println("FAIL: hms(61000)")
        return 1
    }
    if time_format_hms(3661500) != "01:01:01.500" {
        println("FAIL: hms(3661500) = " + time_format_hms(3661500))
        return 1
    }
    # Negative clamps to zero.
    if time_format_hms(-100) != "00:00:00.000" {
        println("FAIL: hms(-100)")
        return 1
    }
    # ISO-8601-style compact.
    if time_format_iso8601(0) != "T+0.000" {
        println("FAIL: iso(0)")
        return 1
    }
    if time_format_iso8601(1500) != "T+1.500" {
        println("FAIL: iso(1500)")
        return 1
    }
    # Human-readable durations.
    if time_human_ms(500) != "500ms" {
        println("FAIL: human(500)")
        return 1
    }
    if time_human_ms(1500) != "1s 500ms" {
        println("FAIL: human(1500) = " + time_human_ms(1500))
        return 1
    }
    if time_human_ms(63000) != "1m 3s 0ms" {
        println("FAIL: human(63000) = " + time_human_ms(63000))
        return 1
    }
    if time_human_ms(3723456) != "1h 2m 3s 456ms" {
        println("FAIL: human(3723456) = " + time_human_ms(3723456))
        return 1
    }
    # Elapsed clamps to 0 when end < start.
    if time_elapsed_ms(100, 50) != 0 {
        println("FAIL: elapsed(neg)")
        return 1
    }
    if time_elapsed_ms(100, 250) != 150 {
        println("FAIL: elapsed(150)")
        return 1
    }
    # Stopwatch lap on real clock should be non-negative.
    let start: int = time_stopwatch_start()
    let lap: int = time_stopwatch_lap(start)
    if lap < 0 {
        println("FAIL: lap negative")
        return 1
    }
    println("OK: time")
    return 0
}
