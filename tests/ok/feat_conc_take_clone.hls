# feat_conc_take_clone.hls — Stage 16 (v0.27.0-alpha): ownership across
# the task boundary. clone(x) gives the task a PRIVATE deep copy (the
# sender keeps its value untouched); take(x) transfers the binding's
# value (the binding becomes moved — the compiler rejects any later use).

fn reader(data: list[int]) -> int {
    let mut sum: int = 0
    let mut i: int = 0
    while i < data.len() {
        sum = sum + data.get(i)
        i = i + 1
    }
    return sum
}

fn echo(s: str) -> str {
    return s
}

fn main() -> int uses IO, Conc {
    let xs: list[int] = [1, 2, 3, 4, 5]
    # clone: the task gets a private copy; xs stays usable afterwards.
    let t1: Task[int] = spawn(reader, clone(xs))
    let r1: int = t1.join()
    println("clone-sum=" + r1.to_str() + " still-own=" + xs.len().to_str())

    # take: the binding's value transfers; xs2 is moved after this.
    let xs2: list[int] = [10, 20, 30]
    let t2: Task[int] = spawn(reader, take(xs2))
    let r2: int = t2.join()
    println("take-sum=" + r2.to_str())

    # A call result is allowed (freshly owned); the boundary deep-copies
    # it defensively so aliasing cannot leak across threads.
    let t3: Task[str] = spawn(echo, echo("abc"))
    let r3: str = t3.join()
    println("echo=" + r3 + " len=" + r3.len().to_str())
    return 0
}
