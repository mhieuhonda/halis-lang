# feat_stage30_stack.hls — Stage 30 (v0.47.0-alpha): #[stack] forced
# layout + all borrow-safe use forms (get / set / len / index / for-in)
# across int, float and bool element types. The escape analysis proves
# each #[stack] binding never escapes its creating frame; the native
# C backend lays them out as typed stack arrays (zero heap objects,
# zero refcount traffic) with identical observable behaviour.
fn fib_stack(n: int) -> int {
    #[stack]
    let window: list[int] = [0, 1]
    let mut i: int = 0
    while i < n {
        let next: int = window.get(0) + window.get(1)
        window.set(0, window.get(1))
        window.set(1, next)
        i = i + 1
    }
    return window.get(0)
}

fn index_and_iter() -> int {
    #[stack]
    let xs: list[int] = [10, 20, 30]
    xs[1] = xs[0] + xs[2]
    let mut t: int = 0
    for v: int in xs {
        t = t + v
    }
    return t + xs.len()
}

fn float_window() -> str {
    #[stack]
    let fs: list[float] = [1.5, 2.5]
    fs.set(0, fs.get(0) * 2.0)
    return fs.get(0).to_str()
}

fn bool_flags() -> str {
    #[stack]
    let bs: list[bool] = [true, false]
    bs.set(1, !bs.get(0))
    return bs.get(1).to_str()
}

fn main() -> int uses IO {
    println("fib_stack(40) = " + fib_stack(40).to_str())
    println("index_and_iter = " + index_and_iter().to_str())
    println("float_window = " + float_window())
    println("bool_flags = " + bool_flags())
    return 0
}
