# feat_stage107_tlog.hls — Stage 107 (v0.126.0-alpha): hls-tlog, the
# transparency-log gossip protocol (multi-source verify).
#
# What the differential suite pins HERE is the gossip arithmetic the
# tool runs across N copies of the ledger — the same contract
# `hls-tlog` enforces when it compares sources:
#
#   python3 tools/hls-tlog.py selftest
#   python3 boot/boot.py tests/ok/feat_stage107_tlog.hls
#
# The program: the classification table as predicates over the five
# comparison facts, the lag bound (a mirror is behind by exactly the
# difference, never a record short of it), the chain binding (prev
# hash + record, one flipped byte moves everything after), the
# rollback line a signed witness draws, and the proof's position law
# (length = seq + tail). Deterministic output; interpreter and native
# agree byte for byte.

import "std.str"
import "std.crypto"

# The pair class, as the tool computes it: same length is an
# agree-or-fork question; different lengths are the shorter's
# containment question — found_at 0 means nowhere (diverged), the
# shorter's own length means behind (lag), anything else is a
# renumbered history (fork). 0 agree, 1 fork, 2 lag, 3 diverged.
fn class_of(same_len: bool, heads_eq: bool, found_at: int,
            shorter_len: int) -> int {
    if same_len && heads_eq {
        return 0
    }
    if same_len && !heads_eq {
        return 1
    }
    if found_at == shorter_len {
        return 2
    }
    if found_at > 0 {
        return 1
    }
    return 3
}

# The lag arithmetic: a lagging mirror is missing exactly
# longer - shorter records — the difference, never off by one.
fn lag_of(longer_len: int, shorter_len: int) -> int {
    if longer_len < shorter_len {
        panic("lag_of: the longer view is longer")
    }
    return longer_len - shorter_len
}

# The chain binding in miniature: digest over prev + body; the same
# history repeats, a flipped byte moves it.
fn chain_toy(prev: str, body: str) -> str {
    return crypto_fnv1a_64_hex(prev + body)
}

# The witness verdict the tool reduces to: the log below a signed
# length is a rollback (evidence), at or above it the witness holds.
fn witness_ok(current_len: int, witnessed_len: int) -> bool {
    return current_len >= witnessed_len
}

# The proof's position law: the log length the proof names must be
# exactly the record's seq plus the tail it carries.
fn proof_len_ok(seq: int, tail: int, length: int) -> bool {
    return length == seq + tail
}

fn main() -> int uses IO {
    let mut checks: int = 0

    # The classification table, the tool's whole vocabulary: agree,
    # fork, lag, the renumbered fork, the diverged history.
    if class_of(true, true, 0, 4) != 0 || class_of(true, false, 0, 7) != 1 {
        panic("same-length rows: agree or fork, nothing between")
    }
    if class_of(false, false, 4, 4) != 2 {
        panic("the head at the claimed length is lag")
    }
    if class_of(false, false, 9, 4) != 1 {
        panic("the head elsewhere is a renumbered history")
    }
    if class_of(false, false, 0, 4) != 3 {
        panic("the head nowhere is diverged")
    }
    checks = checks + 1

    # The lag bound: 9 against 4 is exactly 5 records behind.
    if lag_of(9, 4) != 5 {
        panic("a lagging mirror is behind by the difference")
    }
    if lag_of(4, 4) != 0 {
        panic("equal views have no lag")
    }
    checks = checks + 1

    # The chain binding: prev + body hashes the same twice, and one
    # flipped hex character of prev moves it — the reason a rewritten
    # record cannot keep the history's hash.
    let h: str = chain_toy("abcd1234", "seq:7,kind:sign")
    if chain_toy("abcd1234", "seq:7,kind:sign") != h {
        panic("the same history must hash the same")
    }
    if chain_toy("abcd1235", "seq:7,kind:sign") == h {
        panic("a flipped byte must move the chain hash")
    }
    if chain_toy("abcd1234", "seq:7,kind:publish") == h {
        panic("a different record must move the chain hash too")
    }
    checks = checks + 1

    # The witness line: below the signed length is evidence, at it
    # the log IS the witnessed bytes, above it the history grew.
    if witness_ok(2, 4) {
        panic("a log below a signed length is a rollback")
    }
    if !witness_ok(4, 4) || !witness_ok(6, 4) {
        panic("at or above the witnessed length the witness holds")
    }
    checks = checks + 1

    # The proof's position law: seq 3 with a 2-record tail names
    # length 5, nothing else.
    if !proof_len_ok(3, 2, 5) {
        panic("the proof's length is seq plus tail")
    }
    if proof_len_ok(3, 2, 4) || proof_len_ok(3, 2, 6) {
        panic("a miscounted proof is a forged proof")
    }
    if !str_starts_with("hls-tlog-proof-app-3.proof.json",
                        "hls-tlog-proof-") {
        panic("the proof file names its tool and its record")
    }
    checks = checks + 1

    if checks != 5 {
        panic("expected 5 checks, ran " + checks.to_str())
    }
    println("transparency gossip: many views, one history, zero vibes")
    println("checks passed: " + checks.to_str())
    return 0
}
