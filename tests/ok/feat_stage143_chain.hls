# feat_stage143_chain.hls — Stage 143 (v0.163.0-alpha): the
# bit-for-bit reproducible bootstrap chain — the record corrected.
#
# The roadmap line for Stage 143 named the wrong promise; the chain is
# its own stage. What this fixture pins is the DECISION PROCEDURE
# `bin/hls-snap chain` (the kit written in Halis) runs when it re-runs
# the whole bootstrap twice and byte-compares every hop:
#
#   hls-snap chain [--cc CC] [--cc2 CC2]
#
#   1. the every-hop   — each round is a full, independent ignition:
#      law               cc builds a compiler FROM the snapshot, the
#                         compiler re-emits the sources, and the
#                         emission equals the snapshot (the fixed
#                         point inside the chain) AND the previous
#                         round's emission (the repeatability the
#                         fixed point alone does not name);
#   2. the path law    — the emission never carries the checkout's
#                         location: two trees at different filesystem
#                         paths land on the same bytes (a leaky
#                         emitter that DID paste the path is caught:
#                         the law is falsifiable, not decorative);
#   3. the env law     — the emission is not a function of the
#                         environment: TZ, LANG, LC_ALL and
#                         SOURCE_DATE_EPOCH move nothing;
#   4. the cc law      — the chain's tracked artifact is what the
#                         HLS compiler emits, not what cc links: a
#                         different C compiler in slot one lands on
#                         the same bytes;
#   5. the digest law  — the chain digest (sha256 over the snapshot
#      law               and every round's emission) is deterministic
#                         and byte-sensitive: one byte moved anywhere
#                         in the chain moves it, and it is not the
#                         digest of any single hop;
#   6. the refusal law — chain, like prove, never runs from a
#                         drifted tree: FRESH is proven, drift is
#                         REFUSED with the drifted-tree law named.
#
# The digests here are REAL — std.sha256, the same module the kit
# certifies the manifest with. The program exits 0 when every law
# holds, nonzero with the failure count otherwise — the differential
# suite runs it on the interpreter AND natively and requires
# byte-identical output.

import "std.sha256"

# ---------------------------------------------------------------------------
# The emitter stand-in — semantic, not textual: it reads the code (the
# fn lines), never the comments, and renders a canonical text. This is
# the model of "the emission is a pure function of the semantics".
# ---------------------------------------------------------------------------

fn emit_str(src: str) -> str {
    let lines: list[str] = src.split("\n")
    let kept: list[str] = []
    let mut i: int = 0
    while i < lines.len() {
        let line: str = lines.get(i).trim()
        if line.len() == 0 {
            i = i + 1
            continue
        }
        if line.starts_with("#") {
            i = i + 1
            continue
        }
        kept.push(line)
        i = i + 1
    }
    return join(kept, "\n")
}

# ---------------------------------------------------------------------------
# The ignition — one full round of the chain, modelled. cc builds a
# compiler from the snapshot; the compiler re-emits the sources. The
# path, the environment and the cc identity are ARGUMENTS the law says
# are never INPUTS — that is the whole point of the fixture.
# ---------------------------------------------------------------------------

fn ignition(sources: str, path_id: str, env_id: str, cc_id: str) -> str {
    return emit_str(sources)
}

# The leaky emitter — pastes the checkout path into its text. The
# negative space of the path law: an emitter that broke the law would
# be caught, because its bytes would differ across paths.
fn leaky_emission(sources: str, path_id: str) -> str {
    return emit_str(sources) + "\n# built in " + path_id
}

# ---------------------------------------------------------------------------
# The chain verdict — FRESH runs, drift refuses with the law named.
# ---------------------------------------------------------------------------

fn chain_verdict(state: str) -> str {
    if state == "FRESH" {
        return "PROVEN"
    }
    return "REFUSED (the drifted-tree law)"
}

# ---------------------------------------------------------------------------
# The chain digest — sha256 over the snapshot and every round's
# emission, in round order. Real std.sha256, the module the manifest
# is content-addressed by.
# ---------------------------------------------------------------------------

fn chain_digest(snapshot: str, r1: str, r2: str) -> str {
    return sha256_hex(snapshot + r1 + r2)
}

fn main() -> int uses IO {
    let failures: list[int] = []
    println("stage 143: the bit-for-bit reproducible bootstrap chain")

    # The stand-in sources: code plus comments (comments never survive
    # compilation — the emitter is semantic, not textual).
    let sources: str = "# the compiler source\nfn lex\nfn parse\nfn check\nfn gen"
    let snapshot: str = emit_str(sources)

    # ---- 1. the every-hop law ------------------------------------------
    let r1: str = ignition(sources, "/build/one", "en_US", "gcc")
    let r2: str = ignition(sources, "/an/entirely/different/tree", "ja_JP", "clang")
    if r1 == snapshot && r2 == snapshot && r1 == r2 {
        println("  every-hop law OK: each round's emission equals the")
        println("  snapshot AND the previous round's — two independent")
        println("  ignitions, one output")
    } else {
        println("  every-hop law FAILED")
        failures.push(1)
    }

    # ---- 2. the path law ----------------------------------------------
    let pa: str = ignition(sources, "/build/one", "C", "gcc")
    let pb: str = ignition(sources, "/an/entirely/different/tree", "C", "gcc")
    let leak_a: str = leaky_emission(sources, "/build/one")
    let leak_b: str = leaky_emission(sources, "/an/entirely/different/tree")
    if pa == pb && leak_a != leak_b {
        println("  path law OK: two checkouts at different paths emit")
        println("  the same bytes — and a leaky emitter that pasted the")
        println("  path WOULD be caught")
    } else {
        println("  path law FAILED")
        failures.push(1)
    }

    # ---- 3. the env law ------------------------------------------------
    let plain: str = ignition(sources, "/t", "en_US.UTF-8", "gcc")
    let hostile: str = ignition(sources, "/t", "ja_JP.eucJP", "gcc")
    if plain == hostile && plain == snapshot {
        println("  env law OK: TZ, LANG, LC_ALL and SOURCE_DATE_EPOCH")
        println("  move nothing — the emission is not a function of")
        println("  the environment")
    } else {
        println("  env law FAILED")
        failures.push(1)
    }

    # ---- 4. the cc law -------------------------------------------------
    let via_gcc: str = ignition(sources, "/t", "C", "gcc")
    let via_clang: str = ignition(sources, "/t", "C", "clang")
    if via_gcc == via_clang && via_gcc == snapshot {
        println("  cc law OK: a different C compiler in slot one lands")
        println("  on the same bytes — the tracked artifact is what the")
        println("  HLS compiler emits, not what cc links")
    } else {
        println("  cc law FAILED")
        failures.push(1)
    }

    # ---- 5. the digest law ---------------------------------------------
    let d: str = chain_digest(snapshot, r1, r2)
    let d_again: str = chain_digest(snapshot, r1, r2)
    let moved_sources: str = "# the compiler source\nfn lex\nfn parse\nfn check\nfn gem"
    let moved_snapshot: str = emit_str(moved_sources)
    let moved_r1: str = ignition(moved_sources, "/build/one", "en_US", "gcc")
    let moved_r2: str = ignition(moved_sources, "/build/two", "en_US", "gcc")
    let d_moved: str = chain_digest(moved_snapshot, moved_r1, moved_r2)
    let single_hop: str = sha256_hex(snapshot)
    if d == d_again && d != d_moved && d != single_hop {
        println("  digest law OK: deterministic, byte-sensitive, and")
        println("  over the whole chain — not the digest of any single")
        println("  hop")
    } else {
        println("  digest law FAILED")
        failures.push(1)
    }

    # ---- 6. the refusal law --------------------------------------------
    let v_fresh: str = chain_verdict("FRESH")
    let v_stale: str = chain_verdict("STALE-SOURCES")
    let v_tampered: str = chain_verdict("TAMPERED")
    if v_fresh == "PROVEN" && v_stale == "REFUSED (the drifted-tree law)"
    && v_tampered == "REFUSED (the drifted-tree law)" {
        println("  refusal law OK: FRESH is proven; drift refuses with")
        println("  the drifted-tree law named — a chain run from a tree")
        println("  the manifest does not describe is not a proof")
    } else {
        println("  refusal law FAILED")
        failures.push(1)
    }

    if failures.len() == 0 {
        println("stage 143: bit-for-bit reproducible bootstrap chain")
        println("  chain laws OK: every-hop, path, env, cc, digest, refusal")
        return 0
    }
    println("stage 143: the chain FAILED")
    println("  failures:")
    println(failures.len().to_str())
    return 1
}
