# feat_stage139_size.hls — Stage 139 (v0.157.0-alpha): the
# per-commit binary-size regression dashboard.
#
# What this fixture pins is the DECISION PROCEDURE the dashboard
# runs — the same laws `tools/hls-size.py` applies when it files a
# record, classifies a workload against its baseline, applies a
# sanction, refuses a stale binary, refuses a foreign machine and
# renders the dashboard:
#
#   hls-size record | sanction | gate | dashboard | history
#
#   1. the class      — binary size is the axis with NO noise, so
#      law              the vocabulary is closed and small:
#                       no-change 0, regressed 1, improved 2,
#                       new 3, vanished 4. One byte of growth is a
#                       regression; one byte of shrink is an
#                       improvement; equality is no-change. There
#                       is no within-noise and no significance —
#                       bytes are counted, never estimated;
#   2. the worst      — a workload is judged on ALL FIVE of its
#      axis law         axes: ANY axis growing regresses the
#                       workload; a workload improves only when
#                       EVERY axis shrank-or-held and at least one
#                       strictly shrank; everything else is
#                       no-change;
#   3. the gate law   — exactly the regressed and vanished classes
#                       fail the gate, and only when unsanctioned;
#                       new, improved and no-change never fail it;
#                       one unsanctioned regression fails the
#                       whole gate;
#   4. the sanction   — a sanction matches by workload NAME; a
#      law              sanctioned regression is loud but green; a
#                       sanction on a workload that did not regress
#                       is stale (counted, never applied); a
#                       sanction cannot excuse a different
#                       workload;
#   5. the pinning    — a record is pinned to a commit: 40 hex
#      law              characters, lowercase, nothing else — and
#                       the compiler identity is pinned twice over:
#                       the source digest and the binary digest are
#                       64 hex characters each;
#   6. the machine    — records compare only when the cc, the arch
#      law              and the recipe all match: sizes from two
#                       toolchains are two different languages of
#                       the same program, and the gate refuses to
#                       translate between them;
#   7. the stale      — a native record whose compiler BINARY was
#      binary law       already filed against a DIFFERENT compiler
#                       SOURCE is refused: the binary was not
#                       rebuilt. A doc-only commit leaves the
#                       source unchanged, so the same binary is
#                       expected there; a fresh binary under a
#                       changed source is a rebuild, not a stale
#                       pin;
#   8. the trend      — the sparkline normalizes the record series
#      band law         to [min, max] over 8 bands with INTEGER
#                       half-up math; the endpoints map to bands 0
#                       and 7; a constant series maps to the mid
#                       band 3;
#   9. the count law  — the tracked suite carries exactly 5
#                       workloads, every workload is measured on
#                       exactly 5 axes, the tool speaks exactly 5
#                       commands, the vocabulary counts exactly 5
#                       classes — the numbers the acceptance gate
#                       pins.
#
# The program exits 0 when every law holds, nonzero with the law's
# number otherwise — the differential suite runs it on the
# interpreter AND natively and requires byte-identical output.
#
# This file enters the corpus at this release — green the day it is
# born, already written in the dialect the dashboard speaks.

# ----------------------------------------------------------------------
# Section 1 — the class law. Five classes, closed vocabulary; the
# byte compare is the whole law and there is no noise band.
# ----------------------------------------------------------------------
fn is_fail_class(cls: int) -> bool {
    return cls == 1 || cls == 4
}

fn classify(cur: int, base: int) -> int {
    # The truth table, in bytes. cur > base grows, cur < base
    # shrinks, equality holds — nothing else is consulted.
    if cur > base {
        return 1
    }
    if cur < base {
        return 2
    }
    return 0
}

fn test_class_law() -> int {
    # Growth of ANY size is a regression — one byte hides behind no
    # band.
    if classify(101, 100) != 1 {
        return 1
    }
    if classify(100000001, 100000000) != 1 {
        return 2
    }
    # Shrink of any size is an improvement.
    if classify(99, 100) != 2 {
        return 3
    }
    if classify(0, 100000000) != 2 {
        return 4
    }
    # Equality is no-change, at zero as everywhere else.
    if classify(100, 100) != 0 {
        return 5
    }
    if classify(0, 0) != 0 {
        return 6
    }
    # The ordering holds: regressed and vanished are the failing
    # classes; nothing else is.
    if !is_fail_class(1) || !is_fail_class(4) {
        return 7
    }
    if is_fail_class(0) || is_fail_class(2) || is_fail_class(3) {
        return 8
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 2 — the worst-axis law. Five axes judge one workload: any
# growth regresses it, an all-clear with one strict shrink improves
# it, everything else holds.
# ----------------------------------------------------------------------
fn worst_axis(c0: int, b0: int, c1: int, b1: int, c2: int, b2: int,
c3: int, b3: int, c4: int, b4: int) -> int {
    let mut saw_regressed: bool = false
    let mut saw_improved: bool = false
    let mut i: int = 0
    while i < 5 {
        let mut cur: int = 0
        let mut base: int = 0
        if i == 0 {
            cur = c0
            base = b0
        }
        if i == 1 {
            cur = c1
            base = b1
        }
        if i == 2 {
            cur = c2
            base = b2
        }
        if i == 3 {
            cur = c3
            base = b3
        }
        if i == 4 {
            cur = c4
            base = b4
        }
        let cls: int = classify(cur, base)
        if cls == 1 {
            saw_regressed = true
        }
        if cls == 2 {
            saw_improved = true
        }
        i = i + 1
    }
    if saw_regressed {
        return 1
    }
    if saw_improved {
        return 2
    }
    return 0
}

fn test_worst_axis_law() -> int {
    # All five held: no-change.
    if worst_axis(7, 7, 8, 8, 9, 9, 10, 10, 11, 11) != 0 {
        return 1
    }
    # One axis grew one byte: the workload regressed, the four holds
    # cannot outvote it.
    if worst_axis(7, 7, 9, 8, 9, 9, 10, 10, 11, 11) != 1 {
        return 2
    }
    # Growth anywhere is enough — even the last axis, even one byte.
    if worst_axis(7, 7, 8, 8, 9, 9, 10, 10, 12, 11) != 1 {
        return 3
    }
    # Growth AND shrink is still regressed: the worst axis wins.
    if worst_axis(7, 8, 9, 8, 9, 9, 10, 10, 11, 11) != 1 {
        return 4
    }
    # Every axis shrank-or-held with one strict shrink: improved.
    if worst_axis(7, 7, 8, 9, 9, 9, 10, 10, 11, 11) != 2 {
        return 5
    }
    # All five strictly shrank: improved.
    if worst_axis(6, 7, 8, 9, 8, 9, 9, 10, 10, 11) != 2 {
        return 6
    }
    # Zero is a size: a bss that held zero stays zero.
    if worst_axis(0, 0, 8, 8, 9, 9, 10, 10, 11, 11) != 0 {
        return 7
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 3 — the gate law. One unsanctioned regression (or vanished
# workload) fails the whole gate; sanctioned rows and every other
# class stay green.
# ----------------------------------------------------------------------
fn gate_fails(classes: list[int], sanctioned: list[bool]) -> bool {
    let n: int = classes.len()
    let mut i: int = 0
    while i < n {
        if is_fail_class(classes[i]) && !sanctioned[i] {
            return true
        }
        i = i + 1
    }
    return false
}

fn test_gate_law() -> int {
    # An all-hold ledger passes.
    if gate_fails([0, 0, 0], [false, false, false]) {
        return 1
    }
    # Improvements and new workloads never fail it.
    if gate_fails([2, 3, 0], [false, false, false]) {
        return 2
    }
    # One unsanctioned regression fails the whole gate.
    if !gate_fails([0, 1, 0], [false, false, false]) {
        return 3
    }
    # A vanished workload fails it too.
    if !gate_fails([0, 4, 0], [false, false, false]) {
        return 4
    }
    # A sanctioned regression is loud but green.
    if gate_fails([0, 1, 0], [false, true, false]) {
        return 5
    }
    if gate_fails([4, 1, 0], [true, true, false]) {
        return 6
    }
    # Two regressions, one sanction: the other one still fails it.
    if !gate_fails([1, 1, 0], [false, true, false]) {
        return 7
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 4 — the sanction law. A sanction matches by NAME: it
# excuses the workload it names on the row that regressed, it goes
# stale on a workload that did not regress, and it cannot excuse a
# different workload's regression.
# ----------------------------------------------------------------------
fn sanction_saves(classes: list[int], names: list[str],
regressed: str) -> bool {
    let n: int = classes.len()
    let mut i: int = 0
    while i < n {
        if is_fail_class(classes[i]) && names[i] == regressed {
            return true
        }
        i = i + 1
    }
    return false
}

fn test_sanction_law() -> int {
    let names: list[str] = ["floor", "grid", "match"]
    # The sanction names the regressed workload: saved.
    if !sanction_saves([0, 1, 0], names, "grid") {
        return 1
    }
    # A sanction on a workload that held is stale, and the other
    # regression still fails the gate.
    if sanction_saves([1, 0, 0], names, "grid") {
        return 2
    }
    if !gate_fails([1, 0, 0],
    [false, sanction_saves([1, 0, 0], names, "grid"),
    false]) {
        return 3
    }
    # A sanction cannot excuse a different workload.
    if sanction_saves([0, 1, 0], names, "floor") {
        return 4
    }
    # The tool's own row sanctions like any other.
    if !sanction_saves([1, 0, 0],
    ["hlc_self", "floor", "grid"], "hlc_self") {
        return 5
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 5 — the pinning law. The commit is 40 hex characters and
# the two digests are 64 each, lowercase, nothing else.
# ----------------------------------------------------------------------
fn is_hex(s: str) -> bool {
    if s.len() == 0 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        let ok: bool = (c >= 48 && c <= 57)
        || (c >= 97 && c <= 102)
        if !ok {
            return false
        }
        i = i + 1
    }
    return true
}

fn is_commit_sha(s: str) -> bool {
    return s.len() == 40 && is_hex(s)
}

fn is_digest(s: str) -> bool {
    return s.len() == 64 && is_hex(s)
}

fn test_pinning_law() -> int {
    if !is_commit_sha("24e9d1d7351c9bb1a18413bcf87f01a39db6e668") {
        return 1
    }
    if is_commit_sha("24E9D1D7351C9BB1A18413BCF87F01A39DB6E668") {
        return 2
    }
    if is_commit_sha("24e9d1d7351c9bb1a18413bcf87f01a39db6e66") {
        return 3
    }
    if is_commit_sha("") {
        return 4
    }
    if !is_digest("070b9094a913c1e399aa28d6032d6c70c4af00703c20ee143edc667c2836e2ab") {
        return 5
    }
    if is_digest("070b9094a913c1e399aa28d6032d6c70c4af00703c20ee143edc667c2836e2a") {
        return 6
    }
    if is_digest("070B9094A913C1E399AA28D6032D6C70C4AF00703C20EE143EDC667C2836E2AB") {
        return 7
    }
    if is_digest("not-a-digest-at-all-0123456789012345678901234567890123") {
        return 8
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 6 — the machine law. cc, arch and recipe must all match;
# one mismatch refuses the comparison.
# ----------------------------------------------------------------------
fn machine_matches(cc_a: bool, arch_a: bool, recipe_a: bool) -> bool {
    return cc_a && arch_a && recipe_a
}

fn test_machine_law() -> int {
    # All three agree: the records compare.
    if !machine_matches(true, true, true) {
        return 1
    }
    # Any single disagreement refuses — a different gcc, a different
    # architecture, a different link recipe.
    if machine_matches(false, true, true) {
        return 2
    }
    if machine_matches(true, false, true) {
        return 3
    }
    if machine_matches(true, true, false) {
        return 4
    }
    if machine_matches(false, false, false) {
        return 5
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 7 — the stale-binary law. The same binary bytes cannot be
# the build of two different compiler sources.
# ----------------------------------------------------------------------
fn stale_binary(bin_same: bool, source_same: bool) -> int {
    # 0 = filed, 1 = refused (stale), 2 = expected (doc-only)
    if bin_same && !source_same {
        return 1
    }
    if bin_same && source_same {
        return 2
    }
    return 0
}

fn test_stale_binary_law() -> int {
    # Same binary under a different source: refused.
    if stale_binary(true, false) != 1 {
        return 1
    }
    # Same binary under the same source (the doc-only commit):
    # expected, not stale.
    if stale_binary(true, true) != 2 {
        return 2
    }
    # A fresh binary is a rebuild: filed, never refused as stale.
    if stale_binary(false, false) != 0 {
        return 3
    }
    if stale_binary(false, true) != 0 {
        return 4
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 8 — the trend band law. The sparkline normalizes the
# series to [min, max] over 8 bands with INTEGER half-up math; the
# endpoints map to bands 0 and 7; a constant series maps to the mid
# band 3.
# ----------------------------------------------------------------------
fn band_of(v: int, lo: int, hi: int) -> int {
    if hi <= lo {
        return 3
    }
    let span: int = hi - lo
    return((v - lo) * 14 + span) / (2 * span)
}

fn test_trend_band_law() -> int {
    # The endpoints.
    if band_of(10, 10, 20) != 0 {
        return 1
    }
    if band_of(20, 10, 20) != 7 {
        return 2
    }
    # Half-up math: the midpoint rounds UP into band 4.
    if band_of(15, 10, 20) != 4 {
        return 3
    }
    # A constant series is the mid band 3, every point.
    if band_of(7, 7, 7) != 3 {
        return 4
    }
    if band_of(0, 0, 0) != 3 {
        return 5
    }
    # One step above the floor with a span of 7: (1*14 + 7) // 14
    # = 1 — band 1, not band 2.
    if band_of(11, 10, 17) != 1 {
        return 6
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 9 — the count law. Five workloads, five axes, five
# commands, five classes — the numbers the acceptance gate pins.
# ----------------------------------------------------------------------
fn test_count_law() -> int {
    let suite: list[str] = ["startup_floor", "str_table", "fn_grid",
    "struct_grid", "match_matrix"]
    if suite.len() != 5 {
        return 1
    }
    let axes: list[str] = ["c_bytes", "bin_bytes", "text_bytes",
    "data_bytes", "bss_bytes"]
    if axes.len() != 5 {
        return 2
    }
    let commands: list[str] = ["record", "sanction", "gate",
    "dashboard", "history"]
    if commands.len() != 5 {
        return 3
    }
    # The vocabulary counts exactly 5 classes; 0..4 each name one
    # and none repeats.
    let mut i: int = 0
    while i < 5 {
        if is_fail_class(i) && i != 1 && i != 4 {
            return 4
        }
        i = i + 1
    }
    return 0
}

# ----------------------------------------------------------------------
# main — every law, in order, first failure named.
# ----------------------------------------------------------------------
fn main() -> int uses IO {
    let sections: list[str] = ["class", "worst-axis", "gate",
    "sanction", "pinning", "machine",
    "stale-binary", "trend-band", "count"]
    let mut failures: int = 0
    let results: list[int] = [test_class_law(),
    test_worst_axis_law(),
    test_gate_law(),
    test_sanction_law(),
    test_pinning_law(),
    test_machine_law(),
    test_stale_binary_law(),
    test_trend_band_law(),
    test_count_law()]
    let mut i: int = 0
    while i < results.len() {
        if results[i] != 0 {
            println("size law " + sections[i] + " FAILED case "
            + results[i].to_str())
            failures = failures + 1
        }
        i = i + 1
    }
    if failures > 0 {
        println(failures.to_str() + " size laws failed")
        return 1
    }
    println("all 9 size laws hold")
    return 0
}
