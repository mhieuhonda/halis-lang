# feat_deep_scan25_boundary_clone.hls — deep-scan-25 regression: the
# boot interpreter's stream_send / future_ready sent owned values by
# REFERENCE across the task boundary (chan.send, spawn, async_spawn,
# gen_spawn and the native codegen all deep-copy; the two stream
# builtins did not). A method-call result like xs.get(0) aliases the
# caller's list, so a producer mutation after the send was visible to
# the consumer — a cross-thread data race the Send/boundary system
# exists to prevent. The interpreter now deep-copies at both boundaries
# (same clone(...) exemption as chan.send), matching the native
# gen_own_arg behaviour.
fn main() -> int uses IO, Conc {
    # 1. stream_send must copy the aliased element.
    let mut xs: list[list[int]] = [[1, 2], [3, 4]]
    let st: Stream[list[int]] = stream_new(4)
    stream_send(st, xs.get(0))
    xs.get(0).set(0, 42)
    let got: list[int] = stream_recv(st)
    if got.get(0) != 1 {
        panic("stream_send aliased the caller's list (got 42-style value)")
    }
    # 2. future_ready must copy the value too.
    let mut ys: list[int] = [5, 6]
    let fut: Future[list[int]] = future_ready(ys)
    ys.set(0, 99)
    let got2: list[int] = await(fut)
    if got2.get(0) != 5 {
        panic("future_ready aliased the caller's list (got 99)")
    }
    # 3. clone(...) stays exempt from the extra defensive copy: sending
    # an explicit clone then mutating the ORIGINAL is still safe, and
    # the value arrives intact.
    let mut zs: list[int] = [7, 8]
    let st2: Stream[list[int]] = stream_new(4)
    stream_send(st2, clone(zs))
    zs.set(0, 111)
    let got3: list[int] = stream_recv(st2)
    if got3.get(0) != 7 {
        panic("clone(...) send path broken")
    }
    # 4. Primitives cross by value as before; the channel keeps its
    # independent copy semantics (already tested by Stage 16).
    let ch: Chan[list[int]] = chan_new()
    ch.send(xs.get(1))
    xs.get(1).set(0, 77)
    let got4: list[int] = ch.recv()
    if got4.get(0) != 3 {
        panic("chan.send clone semantics broken")
    }
    println("boundary clone OK")
    return 0
}
