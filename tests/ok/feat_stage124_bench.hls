# ============================================================================
# tests/ok/feat_stage124_bench.hls — Stage 124 acceptance: the bench
# convention is ordinary Halis
# ----------------------------------------------------------------------------
# This file is the Stage 124 ok corpus: a valid Halis program whose
# shape is exactly what a benchmark suite holds — benchmark functions
# (the `bench_<name>` convention hls-bench drives), a companion
# `units_<name>` throughput declaration, and the deterministic work
# those functions do. It demonstrates the language-side contract of
# the Stage 124 benchmark runner:
#
#   * a benchmark is an ORDINARY function — the same checker checks
#     it, the same backends compile it, nothing about the convention
#     is special to the runner;
#   * the runner times the CALL, not the result — so a benchmark may
#     return a value (bench_grow does) and the value stays usable;
#   * the units declaration is a plain `fn units_<name>() -> int`.
#
# The output is deterministic (arithmetic on the results, no clocks —
# clocks belong to the RUNNER, not to the benchmark), so interpreter
# and native agree byte for byte:
#
#   python3 boot/boot.py tests/ok/feat_stage124_bench.hls
#   bin/hlc tests/ok/feat_stage124_bench.hls out.c && gcc ...
#
# The measurement itself (drivers, protocol, statistics, baselines)
# lives in tools/hls-bench.py and its acceptance gate
# (tests/bench_acceptance.py, `make bench-acceptance`).
# ============================================================================

fn bench_grow() -> str {
    let mut s: str = ""
    let mut i: int = 0
    while i < 6 {
        s = s + "hk"
        i = i + 1
    }
    return s
}

fn units_grow() -> int {
    return 12
}

fn bench_total() {
    let mut total: int = 0
    let mut i: int = 0
    while i < 40 {
        total = total + i * i
        i = i + 1
    }
    if total != 20540 {
        panic("the deterministic bench drifted")
    }
}

fn units_total() -> int {
    return 40
}

fn main() uses IO {
    # the runner calls benchmarks exactly this way — the call is the
    # unit of measurement, and its result (if any) stays ordinary.
    bench_total()
    let grown: str = bench_grow()
    println("grown: " + grown)
    println("grown len: " + grown.len().to_str())
    println("units: " + units_grow().to_str() + ", " +
    units_total().to_str())
    println("stage124 bench fns ran ok")
}
