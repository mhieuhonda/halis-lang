# test_option_result.hls — verify Option, Result, and `?` operator
import "std.option"
import "std.result"

fn first_or_none(xs: list[int]) -> Option[int] {
    if xs.len() == 0 {
        return Option.None
    }
    return Option.Some(xs.get(0))
}

fn use_first(xs: list[int]) -> Option[int] {
    let v: int = first_or_none(xs)?
    return Option.Some(v + 1)
}

fn parse_pair(s: str) -> Result[int, str] {
    let parts: list[str] = s.split(",")
    if parts.len() != 2 {
        return Result.Err("expected two parts")
    }
    let a: int = int_parse(parts.get(0))?
    let b: int = int_parse(parts.get(1))?
    return Result.Ok(a + b)
}

fn main() -> int uses IO {
    let xs: list[int] = [10, 20, 30]
    let r1: Option[int] = use_first(xs)
    println("use_first(xs) = " + option_unwrap(r1).to_str())  # 11

    let empty: list[int] = []
    let r2: Option[int] = use_first(empty)
    if option_is_none(r2) {
        println("use_first(empty) = None")
    }

    let p1: Result[int, str] = parse_pair("3,4")
    let s: str = match p1 {
        Result.Ok(v) => "Ok(" + v.to_str() + ")",
        Result.Err(e) => "Err(" + e + ")"
    }
    println("parse_pair(\"3,4\") = " + s)  # Ok(7)

    let p2: Result[int, str] = parse_pair("3,abc")
    let s2: str = match p2 {
        Result.Ok(v) => "Ok(" + v.to_str() + ")",
        Result.Err(e) => "Err(" + e + ")"
    }
    println("parse_pair(\"3,abc\") = " + s2)  # Err(invalid character in integer literal)

    return 0
}
