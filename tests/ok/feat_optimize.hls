# Stage 11 regression test: a program rich in constant arithmetic + an
# unused binding. The HLIR optimiser folds the constants and DCEs the
# unused binding; the native codegen (which does not yet consume HLIR)
# still produces the correct output via gcc -O2.
#
# This file is a differential test: Stage-0 (interpreter) and native hlc
# must produce the same output (and exit code).

fn compute() -> int {
    let a: int = 7
    let b: int = 11
    let s: int = a + b              # 18
    let p: int = a * b              # 77
    let unused: int = s * p * 1000  # dead - should be DCE'd
    return s + p                    # 95
}

fn main() -> int uses IO {
    println("result = " + compute().to_str())
    return 0
}
