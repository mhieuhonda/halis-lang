# ============================================================================
# feat_stage109_ffi_taint.hls — Stage 109 (v0.128.0-alpha): taint-tracking
# through FFI boundaries (positive path)
# ----------------------------------------------------------------------------
# Verifies that:
#   1. An extern fn marked #[taint_source] types every call result as
#      tainted[ret] — the FFI boundary is a first-class taint source.
#   2. taint_unwrap is the explicit escape hatch (hlprove --taint lists
#      the site with its provenance; the checker is satisfied either way).
#   3. The taint flows through user functions (a user fn taking
#      tainted[int] carries the marking; the report's fixpoint names it).
#   4. str-side mechanics: a sanitizer (sanitize_path) cuts the chain
#      and returns a CLEAN str that may reach a sink.
#
# The extern used is libc's toupper(): int -> int, so the native build is
# ABI-honest (the int64_t declaration mismatches gcc's builtin knowledge
# by a WARNING, and the call resolves to libc's toupper exactly as the
# FFI type-mapping note in examples/ffi_demo.hls documents). The marking
# reads like an auditor writes it: a C-side normalizer is NOT a
# sanitizer — uppercasing an attacker-supplied byte leaves it
# attacker-supplied — so the return is untrusted. This program is also a
# differential test: the interpreter (ctypes) and the native build must
# agree byte for byte.
# ============================================================================

import "std.sanitize"
import "std.taint"

extern "C" {
    #[taint_source]
    fn toupper(c: int) -> int uses IO
}

# The taint flows through user code: the parameter is marked by the
# fixpoint in hlprove --taint, and the unwrap inside is the hatch.
fn normalize(b: tainted[int]) -> int {
    return taint_unwrap(b)
}

fn main() -> int uses IO {
    # 1. The FFI source: raw is tainted[int], typed by the checker from
    #    the #[taint_source] marking. ('a' -> 'A'.)
    let raw: tainted[int] = toupper(97)

    # 2. The hatch: unwrapped data is clean-typed.
    let b: int = taint_unwrap(raw)
    println("byte: " + b.to_str())

    # 3. The taint flows through a user fn (the wrap survives).
    let t2: tainted[int] = taint_mark(b)
    let b2: int = normalize(t2)
    println("byte2: " + b2.to_str())

    # 4. str-side mechanics over a locally-marked value: the sanitizer
    #    cuts the chain and the result may reach a sink.
    let p: tainted[str] = taint_mark("project/bin/tool.hls")
    let clean: str = sanitize_path(p)
    println("clean: " + clean)

    return 0
}
