# Test control flow: if/else-if/else, while, break, continue
fn classify(n: int) -> str {
    if n < 0 {
        return "negative"
    } else if n == 0 {
        return "zero"
    } else if n < 10 {
        return "small"
    } else {
        return "large"
    }
}

fn collatz_steps(n0: int) -> int {
    let mut n: int = n0
    let mut steps: int = 0
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        steps = steps + 1
    }
    return steps
}

fn main() -> int uses IO {
    println(classify(-5))
    println(classify(0))
    println(classify(7))
    println(classify(99))
    println("collatz27=" + collatz_steps(27).to_str())

    # break / continue
    let mut i: int = 0
    let mut acc: int = 0
    while true {
        i = i + 1
        if i == 3 {
            continue
        }
        if i > 8 {
            break
        }
        acc = acc + i
    }
    println("acc=" + acc.to_str())

    # for with break
    let xs: list[int] = [5, 6, 7, 8, 9]
    for v: int in xs {
        if v == 8 {
            break
        }
        print(v.to_str() + ",")
    }
    println("")
    # nested while loops
    let mut a: int = 0
    let mut count: int = 0
    while a < 3 {
        let mut b: int = 0
        while b < 3 {
            if b == 2 {
                b = b + 1
                continue
            }
            count = count + 1
            b = b + 1
        }
        a = a + 1
    }
    println("nested=" + count.to_str())
    # early return
    println("early=" + "x")
    return 0
}
