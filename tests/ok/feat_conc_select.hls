# feat_conc_select.hls — Stage 16 (v0.27.0-alpha): select over channels.
# select(chs) blocks until any channel has a pending message and returns
# the index of the first ready channel (list order). With all channels
# pre-loaded the result is deterministic.

fn main() -> int uses IO, Conc {
    let a: Chan[int] = chan_new()
    let b: Chan[int] = chan_new()
    let c: Chan[int] = chan_new()
    a.send(100)
    b.send(200)
    c.send(300)
    let chs: list[Chan[int]] = [a, b, c]
    let idx: int = select(chs)
    let va: int = a.recv()
    let vb: int = b.recv()
    let vc: int = c.recv()
    println("idx=" + idx.to_str() + " a=" + va.to_str() + " b=" + vb.to_str() + " c=" + vc.to_str())

    # select with only some channels ready (a empty): returns b's index.
    let chs2: list[Chan[int]] = [a, b]
    b.send(42)
    let idx2: int = select(chs2)
    let vb2: int = b.recv()
    println("idx2=" + idx2.to_str() + " b=" + vb2.to_str())
    return 0
}
