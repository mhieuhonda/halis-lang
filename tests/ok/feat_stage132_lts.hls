# feat_stage132_lts.hls — Stage 132 (v0.150.0-alpha): the LTS branch
# policy (`backport-only after v1.0`).
#
# What this fixture pins is the DECISION PROCEDURE the policy runs —
# the same laws `tools/hls-lts.py` applies when it judges a commit,
# a tag or a release on an LTS branch:
#
#   hls-lts classify | backport | tag-patch | audit
#
#   1. the classifier  — the message prefix table: fix/bugfix/revert/
#      law             hotfix/regression name a BUGFIX; feat/feature/add/
#                      stage/spec/stdlib/perf/opt/refactor are FEATURE;
#                      chore/release/docs/doc/test/tests/ci/meta are
#                      CHORE; and EVERYTHING else is UNKNOWN — the
#                      fail-closed law ("semver: ..." and a bare
#                      "Stage 131 (v0.149.0-alpha): ..." carry no
#                      recognized prefix, so they are refused on an
#                      LTS branch, not waved through);
#   2. the tag law     — an LTS tag is `vMAJOR.MINOR.PATCH` and
#                      nothing else: the leading v is mandatory, the
#                      three components are digits without leading
#                      zeros, and a pre-release or build suffix is a
#                      refusal (an LTS release is a release); the
#                      major.minor stays the base's — patch-only is
#                      the whole point of an LTS line;
#   3. the chain law   — the release chain is gapless: patch +1 each
#                      release over the base, no skips (v1.0.0 ->
#                      v1.0.1 -> v1.0.2; a v1.0.3 after v1.0.1 means
#                      a release was LOST, which is exactly what an
#                      audit exists to catch);
#   4. the trailer law — a backport's provenance is one line
#                      `Backported-from: <40 hex>`; shorter, longer
#                      or non-hex values are not provenance (a
#                      trailer the audit cannot re-check is a
#                      refusal, fail-closed like everything else);
#   5. the empty-      — a release carries at least one commit since
#      release law       the previous tag: tagging the same commit
#                      twice is noise, and a changelog of noise is
#                      how policy drift starts.
#
# The program exits 0 when every law holds, 10+section*10+case
# otherwise — the differential suite runs it on the interpreter AND
# natively and requires byte-identical output.
#
# This file enters the corpus at this release — green the day it is
# born, already written in the dialect the policy speaks.

# ----------------------------------------------------------------------
# The class codes, as the tool reports them.
# ----------------------------------------------------------------------
fn cls_bugfix() -> int {
    return 0
}

fn cls_feature() -> int {
    return 1
}

fn cls_chore() -> int {
    return 2
}

fn cls_unknown() -> int {
    return 3
}

# ----------------------------------------------------------------------
# The classifier law. The subject's prefix decides; the default is
# UNKNOWN. A prefix is `word: ` — a bare word with no colon is no
# prefix at all ("Stage 131 (...): ..." is UNKNOWN, a stage release
# is not waved onto an LTS branch by its capital S).
# ----------------------------------------------------------------------
fn classify_subject(s: str) -> int {
    if s.starts_with("fix:") || s.starts_with("bugfix:") {
        return cls_bugfix()
    }
    if s.starts_with("revert:") || s.starts_with("hotfix:") {
        return cls_bugfix()
    }
    if s.starts_with("regression:") {
        return cls_bugfix()
    }
    if s.starts_with("feat:") || s.starts_with("feature:") {
        return cls_feature()
    }
    if s.starts_with("add:") || s.starts_with("stage:") {
        return cls_feature()
    }
    if s.starts_with("spec:") || s.starts_with("stdlib:") {
        return cls_feature()
    }
    if s.starts_with("perf:") || s.starts_with("opt:") {
        return cls_feature()
    }
    if s.starts_with("refactor:") {
        return cls_feature()
    }
    if s.starts_with("chore:") || s.starts_with("release:") {
        return cls_chore()
    }
    if s.starts_with("docs:") || s.starts_with("doc:") {
        return cls_chore()
    }
    if s.starts_with("test:") || s.starts_with("tests:") {
        return cls_chore()
    }
    if s.starts_with("ci:") || s.starts_with("meta:") {
        return cls_chore()
    }
    return cls_unknown()
}

# ----------------------------------------------------------------------
# The tag law: `vMAJOR.MINOR.PATCH`, digits only, no leading zeros,
# no pre-release, no build. Returns the key (major*10^6 + minor*10^3
# + patch, the encoding the corpus has used since Stage 131) or -1.
# ----------------------------------------------------------------------
fn digits_to_int(s: str) -> int {
    let n: int = s.len()
    if n == 0 {
        return -1
    }
    if n > 1 {
        if s.byte_at(0) == 48 {
            return -1
        }
    }
    let mut v: int = 0
    let mut i: int = 0
    while i < n {
        let b: int = s.byte_at(i)
        if b < 48 || b > 57 {
            return -1
        }
        v = v * 10 + (b - 48)
        i = i + 1
    }
    return v
}

fn sem_key(major: int, minor: int, patch: int) -> int {
    return major * 1000000 + minor * 1000 + patch
}

fn parse_lts_tag(tag: str) -> int {
    let n: int = tag.len()
    if n < 2 {
        return -1
    }
    if tag.byte_at(0) != 118 {
        return -1
    }
    let mut i: int = 1
    let mut comps: list[int] = []
    let mut cur: str = ""
    while i < n {
        let c: str = tag.slice(i, i + 1)
        if c == "." {
            comps.push(digits_to_int(cur))
            cur = ""
        } else {
            if c == "-" || c == "+" {
                return -1
            }
            cur = cur + c
        }
        i = i + 1
    }
    comps.push(digits_to_int(cur))
    if comps.len() != 3 {
        return -1
    }
    if comps[0] < 0 || comps[1] < 0 || comps[2] < 0 {
        return -1
    }
    return sem_key(comps[0], comps[1], comps[2])
}

# The version law: an LTS tag keeps the base's major.minor and takes
# exactly the expected patch. Returns "" when it obeys, the reason
# otherwise (the tool prints the rule, the fixture just pins it).
fn tag_law(base: int, want: int, tag: str) -> str {
    let v: int = parse_lts_tag(tag)
    if v < 0 {
        return "not a plain vMAJOR.MINOR.PATCH tag"
    }
    let bm: int = base / 1000000
    let bn: int = (base / 1000) % 1000
    let vm: int = v / 1000000
    let vn: int = (v / 1000) % 1000
    if vm != bm || vn != bn {
        return "changes major.minor — an LTS branch is patch-only"
    }
    if want >= 0 && v != want {
        return "off the chain"
    }
    return ""
}

# ----------------------------------------------------------------------
# The chain law: gapless +1 over the base. The tags arrive as keys
# (same major.minor guaranteed by the tag law), sorted ascending.
# ----------------------------------------------------------------------
fn chain_law(base: int, tags: list[int]) -> int {
    let mut expect: int = base % 1000 + 1
    let n: int = tags.len()
    let mut i: int = 0
    while i < n {
        if tags[i] != sem_key(base / 1000000, (base / 1000) % 1000,
        expect) {
            return 1 + i
        }
        expect = expect + 1
        i = i + 1
    }
    return 0
}

# ----------------------------------------------------------------------
# The trailer law: one line `Backported-from: <40 hex>`.
# ----------------------------------------------------------------------
fn is_hex40(s: str) -> bool {
    if s.len() != 40 {
        return false
    }
    let mut i: int = 0
    while i < 40 {
        let b: int = s.byte_at(i)
        let isd: bool = b >= 48 && b <= 57
        let isl: bool = b >= 97 && b <= 102
        if !(isd || isl) {
            return false
        }
        i = i + 1
    }
    return true
}

fn trailer_of_line(line: str) -> str {
    let pfx: str = "Backported-from: "
    if !line.starts_with(pfx) {
        return ""
    }
    let rest: str = line.slice(pfx.len(), line.len())
    if !is_hex40(rest) {
        return ""
    }
    return rest
}

fn trailer_sha(msg: str) -> str {
    let n: int = msg.len()
    let mut i: int = 0
    let mut cur: str = ""
    while i < n {
        let c: str = msg.slice(i, i + 1)
        if c == "\n" {
            let f: str = trailer_of_line(cur)
            if f != "" {
                return f
            }
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    return trailer_of_line(cur)
}

# The commit message is also judged: a branch commit without a
# trailer must classify CHORE; a commit with one must have a
# checkable upstream. The fixture pins the first half: an unclean
# subject on the branch is a violation unless it is bookkeeping.
fn branch_commit_ok(subject: str, trailer: str) -> bool {
    if trailer != "" {
        return true
    }
    return classify_subject(subject) == cls_chore()
}

# ----------------------------------------------------------------------
# The empty-release law: a release carries at least one commit since
# the previous tag. Encoded over the tag target keys: releasing the
# same commit as the last release is refused.
# ----------------------------------------------------------------------
fn release_ok(head: int, since: int) -> bool {
    return head != since
}

# ----------------------------------------------------------------------
# The test sections. Each returns 0 when its laws hold.
# ----------------------------------------------------------------------
fn test_classifier() -> int {
    if classify_subject("fix: widget crash on empty input")
    != cls_bugfix() {
        return 1
    }
    if classify_subject("bugfix: restore shipped behaviour")
    != cls_bugfix() {
        return 2
    }
    if classify_subject("revert: bad constant") != cls_bugfix() {
        return 3
    }
    if classify_subject("hotfix: unbreak the build") != cls_bugfix() {
        return 4
    }
    if classify_subject("regression: 0.149 broke str_join")
    != cls_bugfix() {
        return 5
    }
    if classify_subject("feat: new widget") != cls_feature() {
        return 6
    }
    if classify_subject("stage: 133") != cls_feature() {
        return 7
    }
    if classify_subject("spec: grammar change") != cls_feature() {
        return 8
    }
    if classify_subject("perf: rewrite the parser loop")
    != cls_feature() {
        return 9
    }
    if classify_subject("stdlib: new string api") != cls_feature() {
        return 10
    }
    if classify_subject("chore: changelog note") != cls_chore() {
        return 11
    }
    if classify_subject("docs: readme fix") != cls_chore() {
        return 12
    }
    if classify_subject("tests: pin the law") != cls_chore() {
        return 13
    }
    # The fail-closed law: no recognized prefix -> UNKNOWN.
    if classify_subject("semver: SemVer 2.0.0 module")
    != cls_unknown() {
        return 14
    }
    if classify_subject("Stage 131 (v0.149.0-alpha): a release")
    != cls_unknown() {
        return 15
    }
    if classify_subject("bare message no prefix") != cls_unknown() {
        return 16
    }
    if classify_subject("") != cls_unknown() {
        return 17
    }
    # A prefix word WITHOUT the colon is no prefix ("fixit" is not
    # "fix").
    if classify_subject("fixit: not a fix") != cls_unknown() {
        return 18
    }
    return 0
}

fn test_tag_law() -> int {
    let base: int = sem_key(1, 0, 0)
    # A plain patch tag obeys.
    if tag_law(base, sem_key(1, 0, 1), "v1.0.1") != "" {
        return 1
    }
    # Not v-prefixed, not a plain tag.
    if tag_law(base, -1, "1.0.1") == "" {
        return 2
    }
    # Leading zeros are the semver grammar's refusal.
    if tag_law(base, -1, "v01.0.1") == "" {
        return 3
    }
    # Pre-release and build suffixes are refusals on an LTS line.
    if tag_law(base, -1, "v1.0.1-pre") == "" {
        return 4
    }
    if tag_law(base, -1, "v1.0.1+build") == "" {
        return 5
    }
    # The major.minor is the base's: minor and major bumps are
    # features, and an LTS is patch-only.
    if tag_law(base, -1, "v1.1.0") == "" {
        return 6
    }
    if tag_law(base, -1, "v2.0.0") == "" {
        return 7
    }
    # Garbage is a refusal.
    if tag_law(base, -1, "release-1.0-hotfix") == "" {
        return 8
    }
    if tag_law(base, -1, "v1.0") == "" {
        return 9
    }
    # Off the chain: v1.0.2 when v1.0.1 is expected.
    if tag_law(base, sem_key(1, 0, 1), "v1.0.2") == "" {
        return 10
    }
    return 0
}

fn test_chain_law() -> int {
    let base: int = sem_key(1, 0, 0)
    # The gapless chain: 1, 2, 3.
    let good: list[int] = [sem_key(1, 0, 1), sem_key(1, 0, 2),
    sem_key(1, 0, 3)]
    if chain_law(base, good) != 0 {
        return 1
    }
    # An empty chain obeys trivially (nothing cut yet).
    let none: list[int] = []
    if chain_law(base, none) != 0 {
        return 2
    }
    # A gap: 1, 3 — the third tag arrived while the second was lost.
    let gapped: list[int] = [sem_key(1, 0, 1), sem_key(1, 0, 3)]
    if chain_law(base, gapped) == 0 {
        return 3
    }
    # A duplicate patch is a broken chain too.
    let dup: list[int] = [sem_key(1, 0, 1), sem_key(1, 0, 1)]
    if chain_law(base, dup) == 0 {
        return 4
    }
    # Starting below the base+1 floor (a re-cut of the base) breaks
    # the chain.
    let refloor: list[int] = [sem_key(1, 0, 0), sem_key(1, 0, 1)]
    if chain_law(base, refloor) == 0 {
        return 5
    }
    return 0
}

fn test_trailer_law() -> int {
    let sha: str = "0123456789abcdef0123456789abcdef01234567"
    # A well-formed trailer is recognized — alone or among lines.
    if trailer_sha("Backported-from: " + sha) != sha {
        return 1
    }
    let msg: str = "fix: widget crash on empty input\n\nBackported-from: "
    + sha + "\n(cherry picked from commit " + sha + ")\n"
    if trailer_sha(msg) != sha {
        return 2
    }
    # Not a trailer: no prefix, wrong length, non-hex.
    if trailer_sha("cherry picked from commit " + sha) != "" {
        return 3
    }
    if trailer_sha("Backported-from: 0123") != "" {
        return 4
    }
    if trailer_sha("Backported-from: " + sha + "0") != "" {
        return 5
    }
    if trailer_sha("Backported-from: 0123456789abcdef0123456789abcde"
    + "g") != "" {
        return 6
    }
    # The empty message has no provenance.
    if trailer_sha("") != "" {
        return 7
    }
    # The branch-commit gate: no trailer -> only chores may stand.
    if !branch_commit_ok("chore: changelog note", "") {
        return 8
    }
    if branch_commit_ok("feat: sneaky feature", "") {
        return 9
    }
    if branch_commit_ok("bare no prefix", "") {
        return 10
    }
    # With a checkable trailer, the subject may be anything the
    # upstream fix carried.
    if !branch_commit_ok("fix: honest-looking subject", sha) {
        return 11
    }
    return 0
}

fn test_release_law() -> int {
    # A release needs a commit since the last tag.
    if !release_ok(101, 100) {
        return 1
    }
    # Tagging the same commit twice is refused.
    if release_ok(101, 101) {
        return 2
    }
    # ...and the first release needs a commit since the base.
    if release_ok(100, 100) {
        return 3
    }
    return 0
}

fn main() -> int uses IO {
    println("stage 132: hls-lts")
    let mut r: int = test_classifier()
    if r != 0 {
        return 10 + r
    }
    r = test_tag_law()
    if r != 0 {
        return 20 + r
    }
    r = test_chain_law()
    if r != 0 {
        return 30 + r
    }
    r = test_trailer_law()
    if r != 0 {
        return 40 + r
    }
    r = test_release_law()
    if r != 0 {
        return 50 + r
    }
    println("  LTS policy OK: classifier, tag law, chain, trailer, "
    + "release")
    return 0
}
