# feat_stage117_fmt_config.hls — Stage 117 (v0.136.0-alpha):
# hlfmt reads a team configuration file, .hlfmt.toml.
#
# This file is the runnable half of the gate: a config-aware formatter
# pass (any indent_width, indent_style, max_blank_lines, final_newline)
# must change NOTHING but whitespace, so the markers printed below are
# the semantic witness — interpreter and native print the same lines
# before the pass, and the SAME lines after a pass under a non-default
# config. The file is formatted under the DEFAULTS (the pre-117
# constants), which is also the proof that Stage 117 changes nothing
# for teams that never write the file.
#
#   python3 boot/boot.py tests/ok/feat_stage117_fmt_config.hls

# sums the digits of n the slow, readable way
fn digit_sum(n: int) -> int {
    let mut total: int = 0
    let mut rest: int = n
    while rest > 0 {
        total = total + rest % 10
        rest = rest / 10
    }
    return total
}

fn pow2(k: int) -> int {
    let mut acc: int = 1
    let mut i: int = 0
    while i < k {
        acc = acc * 2
        i = i + 1
    }
    return acc
}

struct Priced {
    name: str,
    cents: int
}

enum Shape {
    Dot,
    Ring
}

fn area(s: Shape) -> int {
    return match s {
        # a dot counts one
        Shape.Dot => 1,
        # a ring counts four
        Shape.Ring => 4
    }
}

fn label(p: Priced) -> str {
    return p.name
}

fn main() -> int uses IO {
    println("s117 start")
    let ds: int = digit_sum(98765)
    println(ds.to_str()) # trailing note on a call
    let p8: int = pow2(8)
    println(p8.to_str())
    let item: Priced = Priced {
        # a note inside a struct literal
        name: "cfg",
        cents: 2500
    }
    println(label(item))
    println(item.cents.to_str())
    println(area(Shape.Dot).to_str())
    println(area(Shape.Ring).to_str())
    if ds == 35 {
        # 9+8+7+6+5 — the digits line up
        println("digit sum ok")
    } else {
        println("digit sum off")
    }
    if p8 != 256 {
        println("pow off")
    } else {
        # the power of two the config test expects
        println("pow ok")
    }
    let mut walk: int = 0
    let mut step: int = 0
    while step < 3 {
        walk = walk + pow2(step)
        step = step + 1
    }
    println(walk.to_str()) # 1+2+4
    return 0
}
# EOF note — every config must keep this line too.
