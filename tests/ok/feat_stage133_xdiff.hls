# feat_stage133_xdiff.hls — Stage 133 (v0.151.0-alpha): the cross-impl
# differential suite.
#
# What this fixture pins is the DECISION PROCEDURE the suite runs —
# the same laws `tools/hls-xdiff.py` applies when it sits four
# implementations of the language down at one table:
#
#   hls-xdiff: interp | native | wasm | llvm(static)
#
#   1. the channel  — backends may RENDER one double differently
#      law            (printf says "0.750000", the wasm glue's JS
#                     Number says "0.75"; printf says "-nan", JS says
#                     "NaN"); the oracle compares them on a shared
#                     canonical form. But the channel is a NARROW
#                     license: short forms ("1.5"), version strings
#                     ("1.10") and integers ("9007199254740993") are
#                     never rewritten, so a divergence there is real;
#   2. the halt     — exit codes compare as CLASSES when a backend
#      law            halts: hosted panic is 101, the wasm alpha
#                     halts every panic/exit through one trap that
#                     propagates no code. All-clean is exact; uniform
#                     101 with a wasm trap is panic-equal; uniform
#                     hosted N with a trap is halt-gap; a halt on one
#                     side and a clean run on the other is DIVERGENCE
#                     — the loudest alarm the suite owns;
#   3. the ledger   — a divergence is a FINDING: the ledger names it
#      law            with its per-backend state signature. Observed
#                     signature == entry -> sanctioned; the program
#                     clean again -> STALE (trim the entry); the
#                     states moved -> MISMATCH (re-diagnose); no
#                     entry -> the regression alarm. Two-way, like
#                     the Stage 128 ledger;
#   4. the purity   — a program is comparable only when its output is
#      gate           a function of its source: crate modes have no
#                     hosted main; wall-clock/rand/fs/net/thread/
#                     process imports make output a function of the
#                     WORLD. Every exclusion names its reason.
#
# The program exits 0 when every law holds, 10+section*10+case
# otherwise — the differential suite runs it on the interpreter AND
# natively (and, where the wasm alpha can take it, on wasm) and
# requires byte-identical output.
#
# This file enters the corpus at this release — green the day it is
# born, already written in the dialect the suite speaks.

# ----------------------------------------------------------------------
# Verdict codes, as the tool reports them.
# ----------------------------------------------------------------------
fn v_exact() -> int {
    return 0
}

fn v_normalized() -> int {
    return 1
}

fn v_panic_equal() -> int {
    return 2
}

fn v_halt_gap() -> int {
    return 3
}

fn v_divergence() -> int {
    return 9
}

# Ledger statuses.
fn l_sanctioned() -> int {
    return 0
}

fn l_stale() -> int {
    return 1
}

fn l_mismatch() -> int {
    return 2
}

fn l_unledgered() -> int {
    return 3
}

# ----------------------------------------------------------------------
# Section 1 — the channel law.
#
# The canonical form of a float token rounds to the printf channel's
# six decimals; both sides run through the SAME canonicalizer, so
# equal doubles yield equal strings. What the channel may never do is
# rewrite a token that is already representation-free: a short
# decimal ("1.5"), a version string ("1.10"), an integer. The table
# below is the tool's own first-sweep pairs: each row is (raw printf,
# raw JS, same-double?). The last two rows are the license's LIMITS —
# pairs the channel must NOT reconcile.
# ----------------------------------------------------------------------

# digit count after the decimal point (0 when there is none) — the
# suspicion test: printf always emits six decimals, JS emits three or
# more only for real fractions.
fn decimals_of(s: str) -> int {
    let n: int = s.len()
    let mut i: int = 0
    let mut seen_dot: bool = false
    let mut count: int = 0
    while i < n {
        let b: int = s.byte_at(i)
        if seen_dot {
            if b >= 48 && b <= 57 {
                count = count + 1
            }
        }
        if b == 46 {
            seen_dot = true
        }
        i = i + 1
    }
    return count
}

# integer digits before the dot (or all digits when no dot) — seven
# or more means the printf channel renders it in full while JS may
# abbreviate: channel noise either way.
fn int_digits_of(s: str) -> int {
    let n: int = s.len()
    let mut i: int = 0
    let mut count: int = 0
    while i < n {
        let b: int = s.byte_at(i)
        if b == 46 {
            return count
        }
        if b >= 48 && b <= 57 {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

# the suspicion law: would printf and JS render this token
# differently from its value? six decimals -> yes (printf's own
# shape); three-plus -> yes; seven-plus integer digits -> yes; a
# short form -> never.
fn is_channel_token(s: str) -> bool {
    if decimals_of(s) >= 3 {
        return true
    }
    if int_digits_of(s) >= 7 {
        return true
    }
    return false
}

# the raw-equality shortcut: identical raw bytes are identical, no
# channel needed — and a short form ("1.5") rendered by both sides
# must stay raw so a real difference stays visible. The verdict is
# the suite's own: exact when the bytes match, normalized when only
# the channel reconciles them, divergence when neither applies.
fn channel_pair_verdict(raw_printf: str, raw_js: str, same_double: bool) -> int {
    if raw_printf == raw_js {
        return v_exact()
    }
    if !same_double {
        return v_divergence()
    }
    # same double, different bytes: only the channel may reconcile
    # them, and only when at least ONE token is channel noise (the
    # other side may have written the value short). A version-string
    # pair ("1.10" vs "1.1") is not channel noise on either side —
    # the bytes stand.
    if is_channel_token(raw_printf) || is_channel_token(raw_js) {
        return v_normalized()
    }
    return v_divergence()
}

fn test_channel_law() -> int {
    # the suspicion law itself
    if is_channel_token("0.750000") {
        # printf's six decimals are channel noise
    } else {
        return 11
    }
    if is_channel_token("0.75") {
        return 12
    }
    if is_channel_token("1.10") {
        return 13
    }
    if is_channel_token("123456789012345680.0") {
        # nineteen integer digits: JS may abbreviate, printf will not
    } else {
        return 14
    }
    # the first-sweep pairs, as the suite verdicts them
    if channel_pair_verdict("0.750000", "0.75", true) != v_normalized() {
        return 15
    }
    if channel_pair_verdict("0.123457", "0.12345678901", true) != v_normalized() {
        # same double; printf rounds at six decimals, JS does not
        return 16
    }
    if channel_pair_verdict("0.750001", "0.75", false) != v_divergence() {
        return 17
    }
    if channel_pair_verdict("1.10", "1.1", false) != v_divergence() {
        return 18
    }
    if channel_pair_verdict("9007199254740993", "9007199254740994", false) != v_divergence() {
        return 19
    }
    if channel_pair_verdict("abc", "abc", true) != v_exact() {
        # identical raw bytes need no channel
        return 110
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 2 — the halt law.
#
# (hosted_exit, wasm_trapped) -> verdict. The wasm alpha halts every
# panic and every exit(N) through one `unreachable` trap: the HALT is
# propagated, the CODE is not. The classes:
#   clean everywhere                    -> exact
#   hosted 101 everywhere, wasm trapped -> panic-equal
#   hosted uniform N, wasm trapped      -> halt-gap (named)
#   clean on one side, halt on other    -> divergence
#   hosted codes disagree               -> divergence
#   trap-free halt codes disagree       -> divergence
# ----------------------------------------------------------------------

fn halt_verdict(interp_exit: int, native_exit: int, wasm_exit: int,
wasm_trapped: bool) -> int {
    let interp_halted: bool = interp_exit != 0
    let native_halted: bool = native_exit != 0
    let wasm_halted: bool = wasm_exit != 0
    if !interp_halted && !native_halted && !wasm_halted {
        return v_exact()
    }
    if interp_halted && native_halted && wasm_halted {
        if wasm_trapped {
            if interp_exit == 101 && native_exit == 101 {
                return v_panic_equal()
            }
            if interp_exit == native_exit {
                return v_halt_gap()
            }
            return v_divergence()
        }
        if interp_exit == native_exit && interp_exit == wasm_exit {
            if interp_exit == 101 {
                return v_panic_equal()
            }
            return v_exact()
        }
        return v_divergence()
    }
    # some halted, some clean — the loudest alarm
    return v_divergence()
}

fn test_halt_law() -> int {
    if halt_verdict(0, 0, 0, false) != v_exact() {
        return 21
    }
    if halt_verdict(101, 101, 1, true) != v_panic_equal() {
        return 22
    }
    if halt_verdict(7, 7, 1, true) != v_halt_gap() {
        return 23
    }
    if halt_verdict(0, 0, 1, true) != v_divergence() {
        return 24
    }
    if halt_verdict(101, 101, 0, false) != v_divergence() {
        return 25
    }
    if halt_verdict(101, 7, 1, true) != v_divergence() {
        return 26
    }
    if halt_verdict(3, 3, 4, false) != v_divergence() {
        return 27
    }
    if halt_verdict(7, 7, 7, false) != v_exact() {
        return 28
    }
    if halt_verdict(101, 101, 101, false) != v_panic_equal() {
        return 29
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 3 — the ledger law.
#
# An entry names a program, the culprit backend and the per-backend
# states observed at diagnosis time. The judgment:
#   divergence observed, entry matches      -> sanctioned (green)
#   program clean again, entry present      -> STALE (the entry must
#                                             be trimmed — two-way)
#   divergence observed, states moved       -> MISMATCH (re-diagnose)
#   divergence observed, no entry           -> unledgered (ALARM)
# ----------------------------------------------------------------------

fn ledger_judge(has_entry: bool, observed_wasm_ok: bool,
observed_divergence: bool, entry_wasm_ok: bool) -> int {
    if observed_divergence {
        if !has_entry {
            # no entry names this divergence: the regression alarm
            return l_unledgered()
        }
        # the program still diverges: the entry must name the SAME
        # state the suite now observes
        if observed_wasm_ok == entry_wasm_ok {
            return l_sanctioned()
        }
        return l_mismatch()
    }
    # the program compares clean: any entry naming it is stale
    return l_stale()
}

fn test_ledger_law() -> int {
    # a ledgered divergence whose states still match: sanctioned
    if ledger_judge(true, false, true, false) != l_sanctioned() {
        return 31
    }
    # the divergence MOVED (wasm now runs clean where the entry says
    # it erred): a mismatch, never an auto-pass
    if ledger_judge(true, true, true, false) != l_mismatch() {
        return 32
    }
    # the divergence was FIXED: the entry is stale, trim it
    if ledger_judge(true, false, false, false) != l_stale() {
        return 33
    }
    if ledger_judge(true, true, false, true) != l_stale() {
        return 34
    }
    # no entry names the divergence: the alarm this suite exists to
    # wire — fail closed, never wave it through
    if ledger_judge(false, false, true, false) != l_unledgered() {
        return 35
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 4 — the purity gate.
#
# A program whose output depends on the world cannot sit at a
# differential table: its bytes measure the environment, not the
# implementation. The gate denies the crate modes, the
# environment-bound std modules and the nondeterministic builtins —
# and it must name its reasons, never silently shrink the corpus.
# ----------------------------------------------------------------------

fn import_verdict(module: str) -> int {
    # 0 = pure enough for the table, 1 = excluded
    if module == "time" || module == "env" {
        return 1
    }
    if module == "process" || module == "net" {
        return 1
    }
    if module == "fs" || module == "thread" {
        return 1
    }
    if module == "sync" || module == "http" {
        return 1
    }
    if module == "http2" || module == "websocket" {
        return 1
    }
    if module == "sse" || module == "session" {
        return 1
    }
    if module == "uuid" || module == "jsffi" {
        return 1
    }
    if module == "archive" || module == "config" {
        return 1
    }
    # the pure core the table welcome
    if module == "option" || module == "result" {
        return 0
    }
    if module == "str" || module == "math" {
        return 0
    }
    if module == "bits" || module == "hex" {
        return 0
    }
    if module == "hash" || module == "base64" {
        return 0
    }
    if module == "json" || module == "regex" {
        return 0
    }
    # unknown modules fail CLOSED: the gate must name them, not wave
    # them through
    return 1
}

fn builtin_verdict(builtin: str) -> int {
    if builtin == "clock_ms" || builtin == "clock_ns" {
        return 1
    }
    if builtin == "rand_seed" || builtin == "rand_int" {
        return 1
    }
    if builtin == "read_file" || builtin == "write_file" {
        return 1
    }
    if builtin == "net_lookup" || builtin == "hostname" {
        return 1
    }
    if builtin == "proc_exec" || builtin == "spawn" {
        return 1
    }
    if builtin == "env_get" || builtin == "args_get" {
        return 1
    }
    if builtin == "chan_new" || builtin == "chan_send" {
        return 1
    }
    if builtin == "sleep" || builtin == "read_line" {
        return 1
    }
    return 0
}

fn test_purity_gate() -> int {
    if import_verdict("time") != 1 {
        return 41
    }
    if import_verdict("net") != 1 {
        return 42
    }
    if import_verdict("thread") != 1 {
        return 43
    }
    if import_verdict("option") != 0 {
        return 44
    }
    if import_verdict("hash") != 0 {
        return 45
    }
    if import_verdict("uuid") != 1 {
        return 46
    }
    if builtin_verdict("clock_ms") != 1 {
        return 47
    }
    if builtin_verdict("rand_int") != 1 {
        return 48
    }
    if builtin_verdict("spawn") != 1 {
        return 49
    }
    if builtin_verdict("len") != 0 {
        return 410
    }
    return 0
}

# ----------------------------------------------------------------------
fn main() -> int uses IO {
    println("stage 133: hls-xdiff")
    let mut r: int = test_channel_law()
    if r != 0 {
        return 10 + r
    }
    r = test_halt_law()
    if r != 0 {
        return 20 + r
    }
    r = test_ledger_law()
    if r != 0 {
        return 30 + r
    }
    r = test_purity_gate()
    if r != 0 {
        return 40 + r
    }
    println("  cross-impl suite OK: channel, halt law, ledger, "
    + "purity gate")
    return 0
}
