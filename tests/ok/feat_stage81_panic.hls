# feat_stage81_panic.hls — Stage 81: a `#![no_std]` crate exercising
# `core.panic` end to end: PanicInfo construction + accessors, location
# presence, message formatting, PanicAction names + codes, the PanicLog
# post-mortem ring (capacity, FIFO eviction, drop counting, indexed
# reads, clearing), and the `panic_check` invariant helper — plus the
# `#[panic_handler]` attribute itself (an effect-free handler that the
# checker accepts and both backends wire, never fired here so the
# program exits 0). Exit code is 0 on success (the differential suite
# compares interpreter-vs-native exit codes). Any positive exit code is
# a failure count for the named assertion; tests are numbered so a
# non-zero exit points at the first failure.
#![no_std]

import "core.panic"

# An effect-free handler (no `uses` — the `#![no_std]` mode bans
# capabilities, so this is the only shape allowed here). It formats
# the report and drops it: without OS calls there is nowhere to send
# it, exactly like a kernel before serial is up. A `#![freestanding]`
# build of this same file must link `-nostdlib` and answer 0.
#[panic_handler]
fn panic_handler(msg: str) -> void {
    let info: PanicInfo = panic_info_new(msg, "", 0)
    let text: str = panic_format(info)
    if text.len() == 0 {
        return
    }
}

fn main() -> int {
    # ------------------------------------------------------------------
    # PanicInfo construction + accessors (1..12)
    # ------------------------------------------------------------------
    let info: PanicInfo = panic_info_new("boom", "kernel.hls", 42)
    if panic_info_msg(info) != "boom" {
        return 1
    }
    if panic_info_file(info) != "kernel.hls" {
        return 2
    }
    if panic_info_line(info) != 42 {
        return 3
    }
    if !panic_info_has_location(info) {
        return 4
    }
    let bare: PanicInfo = panic_info_new("bare", "", 0)
    if panic_info_has_location(bare) {
        return 5
    }
    let nofile: PanicInfo = panic_info_new("x", "", 7)
    if panic_info_has_location(nofile) {
        return 6
    }
    let noline: PanicInfo = panic_info_new("y", "a.hls", 0)
    if panic_info_has_location(noline) {
        return 7
    }
    let empty_msg: PanicInfo = panic_info_new("", "a.hls", 1)
    if panic_info_msg(empty_msg) != "" {
        return 8
    }
    if !panic_info_has_location(empty_msg) {
        return 9
    }
    if panic_info_line(bare) != 0 {
        return 10
    }
    if panic_info_file(bare) != "" {
        return 11
    }
    if panic_info_msg(noline) != "y" {
        return 12
    }
    # ------------------------------------------------------------------
    # panic_format (13..20)
    # ------------------------------------------------------------------
    if panic_format(info) != "boom (at kernel.hls:42)" {
        return 13
    }
    if panic_format(bare) != "bare" {
        return 14
    }
    if panic_format(nofile) != "x" {
        return 15
    }
    if panic_format(noline) != "y" {
        return 16
    }
    if panic_format(empty_msg) != " (at a.hls:1)" {
        return 17
    }
    let big: PanicInfo = panic_info_new("fault", "sched.hls", 1000000)
    if panic_format(big) != "fault (at sched.hls:1000000)" {
        return 18
    }
    let line1: PanicInfo = panic_info_new("m", "f.hls", 1)
    if panic_format(line1) != "m (at f.hls:1)" {
        return 19
    }
    if panic_format(panic_info_new("z", "", 0)) != "z" {
        return 20
    }
    # ------------------------------------------------------------------
    # PanicAction names + codes (21..29)
    # ------------------------------------------------------------------
    if panic_action_name(PanicAction.Trap) != "trap" {
        return 21
    }
    if panic_action_name(PanicAction.Exit) != "exit" {
        return 22
    }
    if panic_action_name(PanicAction.Reboot) != "reboot" {
        return 23
    }
    if panic_action_code(PanicAction.Trap) != 101 {
        return 24
    }
    if panic_action_code(PanicAction.Exit) != 101 {
        return 25
    }
    if panic_action_code(PanicAction.Reboot) != 0 {
        return 26
    }
    if panic_default_code() != 101 {
        return 27
    }
    if panic_action_code(PanicAction.Trap) != panic_default_code() {
        return 28
    }
    if panic_action_code(PanicAction.Reboot) == panic_default_code() {
        return 29
    }
    # ------------------------------------------------------------------
    # PanicLog: capacity + push + reads (30..48)
    # ------------------------------------------------------------------
    let log: PanicLog = panic_log_new(3)
    if panic_log_len(log) != 0 {
        return 30
    }
    if panic_log_dropped(log) != 0 {
        return 31
    }
    panic_log_push(log, "first")
    if panic_log_len(log) != 1 {
        return 32
    }
    if panic_log_get(log, 0) != "first" {
        return 33
    }
    panic_log_push(log, "second")
    panic_log_push(log, "third")
    if panic_log_len(log) != 3 {
        return 34
    }
    if panic_log_get(log, 0) != "first" {
        return 35
    }
    if panic_log_get(log, 1) != "second" {
        return 36
    }
    if panic_log_get(log, 2) != "third" {
        return 37
    }
    if panic_log_dropped(log) != 0 {
        return 38
    }
    # Over capacity: oldest evicted, loss counted.
    panic_log_push(log, "fourth")
    if panic_log_len(log) != 3 {
        return 39
    }
    if panic_log_get(log, 0) != "second" {
        return 40
    }
    if panic_log_get(log, 1) != "third" {
        return 41
    }
    if panic_log_get(log, 2) != "fourth" {
        return 42
    }
    if panic_log_dropped(log) != 1 {
        return 43
    }
    panic_log_push(log, "fifth")
    panic_log_push(log, "sixth")
    if panic_log_get(log, 0) != "fourth" {
        return 44
    }
    if panic_log_get(log, 2) != "sixth" {
        return 45
    }
    if panic_log_dropped(log) != 3 {
        return 46
    }
    # Clearing resets entries and the loss count, keeps capacity.
    panic_log_clear(log)
    if panic_log_len(log) != 0 {
        return 47
    }
    if panic_log_dropped(log) != 0 {
        return 48
    }
    panic_log_push(log, "after-clear")
    if panic_log_len(log) != 1 {
        return 49
    }
    if panic_log_get(log, 0) != "after-clear" {
        return 50
    }
    # A capacity-1 log evicts on every second push.
    let tiny: PanicLog = panic_log_new(1)
    panic_log_push(tiny, "one")
    panic_log_push(tiny, "two")
    if panic_log_len(tiny) != 1 {
        return 51
    }
    if panic_log_get(tiny, 0) != "two" {
        return 52
    }
    if panic_log_dropped(tiny) != 1 {
        return 53
    }
    # ------------------------------------------------------------------
    # panic_check: passing invariants do not fire (54..58)
    # ------------------------------------------------------------------
    panic_check(true, "unreachable")
    panic_check(1 == 1, "unreachable")
    panic_check(panic_log_len(log) == 1, "unreachable")
    panic_check(panic_info_line(info) == 42, "unreachable")
    let ok: bool = panic_info_has_location(info) && panic_log_dropped(log) == 0
    panic_check(ok, "unreachable")
    if !ok {
        return 54
    }
    if panic_log_len(tiny) != 1 {
        return 55
    }
    if panic_default_code() == 0 {
        return 56
    }
    if panic_format(info) == "" {
        return 57
    }
    if panic_action_name(PanicAction.Exit) == "trap" {
        return 58
    }
    return 0
}
