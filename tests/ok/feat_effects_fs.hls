# feat_effects_fs — Stage 9-alpha: fine-grained Fs effect (filesystem only)
fn read_first_line(path: str) -> str uses Fs {
    let content: str = read_file(path)
    let lines: list[str] = content.split("\n")
    if lines.len() == 0 {
        return ""
    }
    return lines.get(0)
}

fn main() -> int uses IO {
    # IO blanket grants Fs too, so this works.
    let s: str = read_first_line("examples/data.txt")
    println("first line: " + s)
    return 0
}
