# feat_proof_sound_slice.hls — Stage-17 perfection (deep-scan-10)
# soundness regression: s.slice(a, b) requires a PROVEN a <= b — the
# old engine granted bnd_safe whenever a's upper bound was unknown
# (slice(5, 2) was elided). Both implementations must panic
# identically (101).
fn cut(s: str, a: int, b: int) -> str
    requires a >= 0
    requires b >= 0
    requires b <= s.len()
{
    return s.slice(a, b)
}
fn main() -> int uses IO {
    let r: str = cut("abcdefgh", 5, 2)
    println(r)
    return 0
}
