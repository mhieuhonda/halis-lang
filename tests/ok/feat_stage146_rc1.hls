# feat_stage146_rc1.hls — Stage 146 (v1.0.0-rc.1): the release
# candidate, the feature freeze declared.
#
# What this fixture pins is the DECISION PROCEDURE the candidate kit
# (`tools/hls-rc.hls`) runs when it judges a tag, a commit or a
# roadmap on the road to v1.0.0:
#
#   hls-rc readiness | declare | gate
#
#   1. the rc        — a candidate of v1.0.0 is `v1.0.0-rc.N` (or
#      grammar          rcN), N in 1..4: a bare v1.0.0 is the LTS
#                       release (Stage 150), not a candidate; the
#                       channels this tree retired (-alpha) name
#                       nothing; build metadata names a build, not a
#                       candidate; the number carries no leading
#                       zero and starts at 1 — a fifth rc is a
#                       roadmap amendment, not a release decision;
#   2. the rc.N      — candidate N closes Stage 145+N, and by the
#      stage mapping    time the candidate is declared the row is
#                       already ticked by the release that carries
#                       it: rc.1 -> Stage 146, rc.4 -> Stage 149;
#   3. the rc        — the candidate is the NEWEST release the tree
#      precedence       has ever named: it sorts strictly after every
#      law              existing tag (numeric identifiers compare
#                       numerically, alphanumeric ASCII-lexically,
#                       numeric < alphanumeric, a longer identifier
#                       list wins over its own prefix, and 1.0.0
#                       itself outranks every 1.0.0-rc.N);
#   4. the admission — past the anchor the line takes BUGFIX (fix /
#      law              bugfix / revert / hotfix / regression) and
#                       CHORE (chore / release / docs / test / ci /
#                       meta); FEATURE (feat / feature / add / stage
#                       / spec / stdlib / perf / opt / refactor) and
#                       UNKNOWN (no recognized prefix — the
#                       classifier is fail-closed) are refused;
#   5. the readiness — the roadmap's closed stages form a contiguous
#      contiguity law   prefix and the open set is the RC tail: a
#                       feature stage still open past Stage 145
#                       contradicts a candidate whose surface was
#                       frozen at Stage 141.
#
# Versions are keys: the core numbers packed as
# major*1000000 + minor*1000 + patch, the pre-release as identifier
# lists — the encoding keeps every comparison a plain int compare
# and the interpreter and the native binary agree byte for byte.
#
# The program exits 0 when every law holds, 10+section*10+case
# otherwise.
#
# This file enters the corpus at this release — green the day it is
# born, already speaking the dialect the candidate speaks.

# ----------------------------------------------------------------------
# The identifier comparison: numeric identifiers compare numerically,
# alphanumeric ASCII-lexically, and numeric < alphanumeric (semver
# 2.0.0 §11.4).
# ----------------------------------------------------------------------
fn id_is_numeric(s: str) -> bool {
    if s.len() == 0 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        if c < 48 || c > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

fn id_value(s: str) -> int {
    let mut v: int = 0
    let mut i: int = 0
    while i < s.len() {
        v = v * 10 + (s.byte_at(i) - 48)
        i = i + 1
    }
    return v
}

fn id_cmp(a: str, b: str) -> int {
    let na: bool = id_is_numeric(a)
    let nb: bool = id_is_numeric(b)
    if na && nb {
        if id_value(a) < id_value(b) {
            return -1
        }
        if id_value(a) > id_value(b) {
            return 1
        }
        return 0
    }
    if na {
        return -1
    }
    if nb {
        return 1
    }
    let mut n: int = a.len()
    if b.len() < n {
        n = b.len()
    }
    let mut i: int = 0
    while i < n {
        let ca: int = a.byte_at(i)
        let cb: int = b.byte_at(i)
        if ca < cb {
            return -1
        }
        if ca > cb {
            return 1
        }
        i = i + 1
    }
    if a.len() < b.len() {
        return -1
    }
    if a.len() > b.len() {
        return 1
    }
    return 0
}

# ----------------------------------------------------------------------
# The pre-release comparison: split on '.', pairwise, the longer list
# wins over its own prefix, and an ABSENT pre-release outranks every
# pre-release of the same core.
# ----------------------------------------------------------------------
fn pre_cmp(a: list[str], b: list[str]) -> int {
    if a.len() == 0 && b.len() == 0 {
        return 0
    }
    if a.len() == 0 {
        return 1
    }
    if b.len() == 0 {
        return -1
    }
    let mut n: int = a.len()
    if b.len() < n {
        n = b.len()
    }
    let mut i: int = 0
    while i < n {
        let c: int = id_cmp(a.get(i), b.get(i))
        if c != 0 {
            return c
        }
        i = i + 1
    }
    if a.len() < b.len() {
        return -1
    }
    if a.len() > b.len() {
        return 1
    }
    return 0
}

# ----------------------------------------------------------------------
# A release key: the core packed, the pre-release as identifiers.
# The candidate law compares the core first, then the pre-release.
# ----------------------------------------------------------------------
struct Ver {
    core: int,
    pre: list[str]
}

fn ver(core: int, pre: list[str]) -> Ver {
    return Ver {
        core: core, pre: pre
    }
}

fn ver_cmp(a: Ver, b: Ver) -> int {
    if a.core < b.core {
        return -1
    }
    if a.core > b.core {
        return 1
    }
    return pre_cmp(a.pre, b.pre)
}

fn core3(major: int, minor: int, patch: int) -> int {
    return major * 1000000 + minor * 1000 + patch
}

# ----------------------------------------------------------------------
# The candidate grammar: v1.0.0-rc.N (or rcN), N in 1..4. The law
# returns "" for a legal candidate, or the refusal's name.
# ----------------------------------------------------------------------
fn rc_num_of(pre: list[str]) -> int {
    # two shapes: ["rc", "N"] or ["rcN"]; -1 when neither. The number
    # is "0" or [1-9][0-9]* — a leading zero is not a number (rc.02
    # is a rendering, not a candidate).
    if pre.len() == 2 && pre.get(0) == "rc" {
        let num: str = pre.get(1)
        if num.len() > 1 && num.byte_at(0) == 48 {
            return -1
        }
        if id_is_numeric(num) {
            return id_value(num)
        }
        return -1
    }
    if pre.len() == 1 && pre.get(0).len() > 2
    && pre.get(0).slice(0, 2) == "rc" {
        let num: str = pre.get(0).slice(2, pre.get(0).len())
        if num.len() > 1 && num.byte_at(0) == 48 {
            return -1
        }
        if id_is_numeric(num) {
            return id_value(num)
        }
        return -1
    }
    return -1
}

fn rc_law(major: int, minor: int, patch: int, pre: list[str]) -> str {
    if major != 1 || minor != 0 || patch != 0 {
        return "the candidate line is 1.0.0"
    }
    if pre.len() == 0 {
        return "a bare v1.0.0 is the LTS release, not a candidate"
    }
    let n: int = rc_num_of(pre)
    if n < 1 {
        return "the pre-release is not an rc channel"
    }
    if n > 4 {
        return "the roadmap planned four candidates"
    }
    return ""
}

# ----------------------------------------------------------------------
# The stage mapping: candidate N closes Stage 145+N.
# ----------------------------------------------------------------------
fn rc_stage(n: int) -> int {
    return 145 + n
}

# ----------------------------------------------------------------------
# The admission law: the prefix vocabulary, one classifier for every
# gate (the LTS policy's own table; the candidate inherits it).
# A fix may be marked Security: — the marking rides beside the class
# and changes nothing about admission.
# ----------------------------------------------------------------------
fn class_of(p: str) -> str {
    if p == "fix" || p == "bugfix" || p == "revert" || p == "hotfix"
    || p == "regression" {
        return "BUGFIX"
    }
    if p == "feat" || p == "feature" || p == "add" || p == "stage"
    || p == "spec" || p == "stdlib" || p == "perf" || p == "opt"
    || p == "refactor" {
        return "FEATURE"
    }
    if p == "chore" || p == "release" || p == "docs" || p == "doc"
    || p == "test" || p == "tests" || p == "ci" || p == "meta" {
        return "CHORE"
    }
    return "UNKNOWN"
}

fn may_land(cls: str) -> bool {
    return cls == "BUGFIX" || cls == "CHORE"
}

# ----------------------------------------------------------------------
# The readiness contiguity law: the closed stages form a contiguous
# prefix, the open set is the tail, and no stage before 146 may still
# be open. A cancelled row (no status cell) is closed by definition.
# status: 1 = ticked, 2 = open, 0 = cancelled.
# ----------------------------------------------------------------------
fn first_open_of(status: list[int]) -> int {
    let mut i: int = 0
    while i < status.len() {
        if status.get(i) == 2 {
            return i + 1
        }
        i = i + 1
    }
    return 0
}

fn roadmap_law(status: list[int]) -> str {
    let first_open: int = first_open_of(status)
    if first_open == 0 {
        return "every stage is ticked — nothing left to candidate for"
    }
    let mut i: int = first_open
    while i < status.len() {
        if status.get(i) != 2 {
            return "the open set must be a contiguous run"
        }
        i = i + 1
    }
    if first_open < 146 {
        return "a feature stage still open contradicts a candidate"
    }
    return ""
}

# ======================================================================
# The batteries.
# ======================================================================

fn test_grammar() -> int {
    # the legal shapes, both spellings
    if rc_law(1, 0, 0, ["rc", "1"]) != "" {
        return 1
    }
    if rc_law(1, 0, 0, ["rc4"]) != "" {
        return 2
    }
    # a bare v1.0.0 is the LTS release
    if rc_law(1, 0, 0, []) == "" {
        return 3
    }
    # the channels this tree retired
    if rc_law(1, 0, 0, ["alpha"]) == "" {
        return 4
    }
    if rc_law(1, 0, 0, ["beta", "1"]) == "" {
        return 5
    }
    # another line entirely
    if rc_law(0, 166, 0, ["rc", "1"]) == "" {
        return 6
    }
    if rc_law(1, 0, 1, ["rc", "1"]) == "" {
        return 7
    }
    if rc_law(2, 0, 0, ["rc", "1"]) == "" {
        return 8
    }
    # the numbering
    if rc_law(1, 0, 0, ["rc", "0"]) == "" {
        return 9
    }
    if rc_law(1, 0, 0, ["rc", "5"]) == "" {
        return 10
    }
    if rc_law(1, 0, 0, ["rc", "02"]) == "" {
        return 11
    }
    return 0
}

fn test_stage_map() -> int {
    if rc_stage(1) != 146 {
        return 1
    }
    if rc_stage(2) != 147 {
        return 2
    }
    if rc_stage(3) != 148 {
        return 3
    }
    if rc_stage(4) != 149 {
        return 4
    }
    return 0
}

fn test_precedence() -> int {
    # the candidate is newer than everything the tree ever named
    let rc1: Ver = ver(core3(1, 0, 0), ["rc", "1"])
    let rc2: Ver = ver(core3(1, 0, 0), ["rc", "2"])
    let rc4: Ver = ver(core3(1, 0, 0), ["rc4"])
    let last_alpha: Ver = ver(core3(0, 166, 0), ["alpha"])
    let line1: Ver = ver(core3(1, 0, 0), [])
    if ver_cmp(rc1, last_alpha) <= 0 {
        return 1
    }
    if ver_cmp(rc1, rc2) >= 0 {
        return 2
    }
    if ver_cmp(rc2, rc4) >= 0 {
        return 3
    }
    if ver_cmp(rc4, rc1) <= 0 {
        return 4
    }
    # the release outranks its own candidates
    if ver_cmp(rc1, line1) >= 0 {
        return 5
    }
    if ver_cmp(line1, rc2) <= 0 {
        return 6
    }
    # numeric identifiers compare numerically: rc.2 < rc.10
    let rc10: Ver = ver(core3(1, 0, 0), ["rc", "10"])
    if ver_cmp(rc2, rc10) >= 0 {
        return 7
    }
    # numeric < alphanumeric
    let one: Ver = ver(core3(1, 0, 0), ["1"])
    let rcw: Ver = ver(core3(1, 0, 0), ["rc"])
    if ver_cmp(one, rcw) >= 0 {
        return 8
    }
    # a longer list wins over its own prefix
    if ver_cmp(rcw, rc1) >= 0 {
        return 9
    }
    # alphanumeric compares ASCII-lexically: alpha < beta < rc
    let alpha: Ver = ver(core3(1, 0, 0), ["alpha"])
    let beta: Ver = ver(core3(1, 0, 0), ["beta"])
    if ver_cmp(alpha, beta) >= 0 {
        return 10
    }
    if ver_cmp(beta, rcw) >= 0 {
        return 11
    }
    return 0
}

fn test_admission() -> int {
    if !may_land(class_of("fix")) {
        return 1
    }
    if !may_land(class_of("revert")) {
        return 2
    }
    if !may_land(class_of("hotfix")) {
        return 3
    }
    if !may_land(class_of("chore")) {
        return 4
    }
    if !may_land(class_of("docs")) {
        return 5
    }
    if !may_land(class_of("tests")) {
        return 6
    }
    if may_land(class_of("feat")) {
        return 7
    }
    if may_land(class_of("add")) {
        return 8
    }
    if may_land(class_of("stage")) {
        return 9
    }
    if may_land(class_of("spec")) {
        return 10
    }
    if may_land(class_of("stdlib")) {
        return 11
    }
    if may_land(class_of("perf")) {
        return 12
    }
    if may_land(class_of("refactor")) {
        return 13
    }
    # fail-closed: no recognized prefix, no landing
    if may_land(class_of("just a thing")) {
        return 14
    }
    return 0
}

fn test_readiness() -> int {
    # the tree at rc.1: 145 closed, the tail from 146
    let mut a: list[int] = []
    let mut i: int = 0
    while i < 145 {
        a.push(1)
        i = i + 1
    }
    i = 0
    while i < 5 {
        a.push(2)
        i = i + 1
    }
    if roadmap_law(a) != "" {
        return 1
    }
    # the candidate declared: 146 ticked, the tail from 147
    let mut b: list[int] = []
    i = 0
    while i < 146 {
        b.push(1)
        i = i + 1
    }
    i = 0
    while i < 4 {
        b.push(2)
        i = i + 1
    }
    if roadmap_law(b) != "" {
        return 2
    }
    # a feature stage still open
    let mut c: list[int] = []
    i = 0
    while i < 144 {
        c.push(1)
        i = i + 1
    }
    c.push(2)
    i = 0
    while i < 5 {
        c.push(2)
        i = i + 1
    }
    if roadmap_law(c) == "" {
        return 3
    }
    # a hole in the open tail
    let mut d: list[int] = []
    i = 0
    while i < 146 {
        d.push(1)
        i = i + 1
    }
    d.push(2)
    d.push(1)
    i = 0
    while i < 2 {
        d.push(2)
        i = i + 1
    }
    if roadmap_law(d) == "" {
        return 4
    }
    # everything ticked: nothing left to candidate for
    let mut e: list[int] = []
    i = 0
    while i < 150 {
        e.push(1)
        i = i + 1
    }
    if roadmap_law(e) == "" {
        return 5
    }
    # a cancelled row is closed by definition
    let mut f: list[int] = []
    i = 0
    while i < 145 {
        f.push(1)
        i = i + 1
    }
    f.push(0)
    i = 0
    while i < 4 {
        f.push(2)
        i = i + 1
    }
    if roadmap_law(f) != "" {
        return 6
    }
    return 0
}

fn main() -> int uses IO {
    println("stage 146: v1.0.0-rc.1")
    let mut r: int = test_grammar()
    if r != 0 {
        return 10 + r
    }
    r = test_stage_map()
    if r != 0 {
        return 20 + r
    }
    r = test_precedence()
    if r != 0 {
        return 30 + r
    }
    r = test_admission()
    if r != 0 {
        return 40 + r
    }
    r = test_readiness()
    if r != 0 {
        return 50 + r
    }
    println("  RC1 laws OK: grammar, stages, precedence, admission, readiness")
    return 0
}
