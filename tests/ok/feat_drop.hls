# feat_drop — Stage 8-alpha: explicit deterministic cleanup via drop()
# Verifies that drop() releases a binding and that binding can be revived via
# `let mut` reassignment.

fn main() -> int uses IO {
    let mut s: str = "alpha"
    drop(s)
    s = "beta"
    println("s=" + s)
    drop(s)
    return 0
}
