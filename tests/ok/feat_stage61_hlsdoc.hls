    println("  ok")
    println("--- hlsdoc_module_has_item (cross-ref resolution) ---")
    test_module_has_item()
    println("  ok")
    println("--- hlsdoc_extract_name ---")
    test_extract_name()
    println("  ok")
    println("--- hlsdoc_kind_name ---")
    test_kind_name()
    println("  ok")
    println("--- hlsdoc_anchor ---")
    test_anchor()
    println("  ok")
    println("--- hlsdoc_render_summary (plain-text) ---")
    test_render_summary()
    println("  ok")
    println("--- hlsdoc_render_search_index (JSON) ---")
