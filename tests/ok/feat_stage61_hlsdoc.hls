    println("  ok")
    println("--- hlsdoc_write_html (Fs effect) ---")
    test_write_html()
    println("  ok")
    println("--- hlsdoc_write_search_index (Fs effect) ---")
    test_write_search_index()
    println("  ok")
    println("--- hlsdoc_parse_module (no doc comments) ---")
