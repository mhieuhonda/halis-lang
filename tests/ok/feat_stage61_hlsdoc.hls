    println("  ok")
    println("--- hlsdoc_render_html (section headers as <h3>) ---")
    test_render_section_headers()
    println("  ok")
    println("--- hlsdoc_render_html (HTML escaping in doc comments) ---")
    test_render_escape_in_doc()
    println("  ok")
    println("--- hlsdoc_parse_module (impl block methods) ---")
    test_parse_impl_methods()
    println("  ok")
    println("--- differential safety (same source, same output) ---")
    test_differential_safety()
    println("  ok")
    println("")
    println("ACCEPTANCE OK: Stage 61 — std.hlsdoc (rustdoc-style API docs generator)")
    println("  hlsdoc_parse_module (extracts fn/struct/enum/impl + doc comments)")
    println("  Doc comment convention: '# ' lines above a declaration")
    println("  hlsdoc_render_html (complete HTML page with <style> + <script>)")
    println("  Cross-references: [name] -> <a href=#name> if name is a declared item")
    println("  Section headers: '## Title' -> <h3>Title</h3>")
    println("  Search index (JSON) + embedded vanilla JS search (no framework)")
    println("  hlsdoc_escape_html (security: & < > \" ' escaped, script injection blocked)")
    println("  hlsdoc_escape_json (JSON string escaping incl. control bytes)")
    println("  hlsdoc_split_paragraphs + hlsdoc_module_has_item + hlsdoc_extract_name")
    println("  hlsdoc_render_summary (plain-text listing)")
    println("  hlsdoc_write_html / hlsdoc_write_search_index (Fs effect)")
    println("  Pure-HLS implementation (no new compiler builtins)")
    println("  differential (interpreter == native) verified green.")
    return 0
}
