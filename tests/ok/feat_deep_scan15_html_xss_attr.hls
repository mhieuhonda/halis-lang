# Deep-scan-15 regression: std/html.hls html_tag attribute-key XSS.
#
# Companion to fail_deep_scan15_html_xss_tag.hls — this one tests
# the attribute KEY path (the previous implementation only escaped
# attribute VALUES, leaving the key wide-open for injection).

import "std.html"

fn main() -> int uses IO {
    # Injection attempt via attribute key: the user-controlled key
    # contains a space and a quote, so _html_validate_name rejects
    # the key (and thus the whole tag).
    let attrs: map[str, str] = map_new()
    attrs.set("onmouseover=\"alert(1)", "x")
    let s: str = html_tag("div", attrs, "")
    println("injected: " + s)
    return 0
}
