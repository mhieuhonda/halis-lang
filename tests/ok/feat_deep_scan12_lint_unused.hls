# Deep-scan-12 regression: hllint L001 no longer reports a
# false-positive on `let _ = expr` (DSS-T-10). The `let _` binding
# is the idiomatic way to discard a value; L001 used to flag it as
# unused. Also, the L001 `_`-prefix skip mirrors Python / Rust /
# Go conventions for "intentionally unused" bindings.

fn side_effect(x: int) -> int uses IO {
    println("side_effect: " + x.to_str())
    return x
}

fn main() -> int uses IO {
    # `let _ = expr` is the standard pattern for "evaluate for the
    # side effect, discard the result". L001 must NOT flag this.
    let _: int = side_effect(1)
    # An underscore-prefixed name is also conventionally unused.
    let _ignored: int = side_effect(2)
    # A regular binding IS flagged if it's never used. We don't test
    # that here — the existing feat_lint_cfaware.hls covers it.
    return 0
}
