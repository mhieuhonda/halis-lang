# feat_deep_scan29_conc_loop.hls — deep-scan-30: spawn-family builtins
# inside loops WITH continue. The deep-scan-28 loop fixpoint re-analysis
# re-visits the loop body; the spawn-family builtins (spawn, async_spawn,
# gen_spawn, stream_map_int, ...) rewrite their call node on the first
# visit (drop the fn-name argument, record the target), so re-running
# the full validation on the rewritten node used to reject a VALID
# program ("spawn() argument 1 must be a function name" / "target
# function does not exist: i"). Both the boot checker and the native
# hlc checker now re-validate only the remaining user arguments and
# return the cached type.
#
# This program must compile AND produce identical output on the boot
# interpreter and the native binary (differential).
fn worker(n: int) -> int {
    return n * 10
}

fn main() -> int uses Conc, IO {
    # (1) spawn inside a while loop with continue.
    let mut i: int = 0
    let mut acc: int = 0
    while i < 4 {
        i = i + 1
        if i == 1 { continue }
        let t: Task[int] = spawn(worker, i)
        acc = acc + t.join()
    }
    println("A" + acc.to_str())

    # (2) async_spawn + await inside a for-in loop with continue.
    let mut out: int = 0
    for x: int in [1, 2, 3, 4] {
        if x == 2 { continue }
        let f: Future[int] = async_spawn(worker, x)
        out = out + await(f)
    }
    println("B" + out.to_str())
    return 0
}
