# feat_stage27_soundness.hls — Stage 27 perfection (v0.50.1-alpha)
# deep-scan-16 regression test: the soundness fix in the boot checker
# (union_moved) must REJECT use-after-move programs whose post-
# construct state is unsafe at runtime.
#
# This file contains a POSITIVE test (the drop-then-revive pattern
# still works correctly). The corresponding NEGATIVE tests are in
# tests/fail/fail_uaf_*.hls.

# The IDIOMATIC "drop then revive" pattern: take(xs) moves the
# binding, then `xs = [...]` revives it via mut reassignment.
# The soundness fix preserves this pattern (check_assign's revive
# step clears the moved flag).
fn drop_then_revive(c: bool, mut xs: list[int]) -> int {
    if c {
        let _: list[int] = take(xs)
        xs = [99]   # revive the binding
    }
    return xs[0]
}

# The same pattern works inside a loop body too.
fn drop_revive_in_loop(n: int) -> int {
    let mut xs: list[int] = [1, 2, 3]
    let mut i: int = 0
    while i < n {
        let _: list[int] = take(xs)
        xs = [i]   # revive
        i = i + 1
    }
    return xs[0]
}

fn main() -> int uses IO {
    let r1: int = drop_then_revive(true, [1, 2, 3])
    let r2: int = drop_revive_in_loop(2)
    if r1 == 99 && r2 == 1 {
        println("ACCEPTANCE OK: drop-then-revive pattern still works")
    } else {
        println("FAIL: r1=" + r1.to_str() + " r2=" + r2.to_str())
        return 1
    }
    return 0
}
