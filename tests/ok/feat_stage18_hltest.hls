# ============================================================================
# tests/ok/feat_stage18_hltest.hls — Stage 18 acceptance: hltest + quickcheck
# ----------------------------------------------------------------------------
# This file is BOTH a valid Halis program (you can run it via `boot.py`)
# AND a hltest test file (you can run it via `tools/hltest.py`). The
# top-level `main()` runs every `test_*` function so the differential
# suite (which executes `main()` under the interpreter and the native
# compiler and compares outputs) gets the same answer as hltest.
# ============================================================================

import "std.test"
import "std.quickcheck"


# --- assert_eq ---------------------------------------------------------------

fn test_assert_eq_int_pass() {
    assert_eq_int(1 + 1, 2)
    assert_eq_int(42, 42)
    assert_eq_int_msg(7 * 6, 42, "multiply")
}

fn test_assert_eq_str_pass() {
    assert_eq_str("hello" + " " + "world", "hello world")
    assert_eq_str_msg("a" + "b", "ab", "concat")
}

fn test_assert_eq_bool_pass() {
    assert_eq_bool(true, true)
    assert_eq_bool(false, false)
}

fn test_assert_ne_pass() {
    assert_ne_int(1, 2)
    assert_ne_str("foo", "bar")
}


# --- boolean checks ----------------------------------------------------------

fn test_assert_true_pass() {
    assert_true(1 == 1)
    assert_true_msg(2 > 1, "two greater than one")
}

fn test_assert_false_pass() {
    assert_false(1 == 2)
    assert_false(1 > 2)
}


# --- numeric / length --------------------------------------------------------

fn test_assert_int_range_pass() {
    assert_int_range(5, 0, 10)
    assert_int_range(0, 0, 10)
    assert_int_range(10, 0, 10)
}

fn test_assert_len_pass() {
    assert_len_str("hello", 5)
    assert_len_int([1, 2, 3], 3)
    assert_len_str("", 0)
}


# --- float ------------------------------------------------------------------

fn test_assert_float_pass() {
    assert_eq_float(1.5 + 1.5, 3.0)
    assert_approx_eq_float(1.0 / 3.0, 0.333, 0.001)
}


# --- quickcheck-style properties --------------------------------------------

# Property: integer addition is commutative.
fn prop_add_comm(x: int, y: int) -> bool {
    return x + y == y + x
}

fn test_add_commutative() uses Rand {
    let mut i: int = 0
    while i < 50 {
        let x: int = qc_int_range(-1000, 1000)
        let y: int = qc_int_range(-1000, 1000)
        if !prop_add_comm(x, y) {
            qc_fail("add_comm", "x=" + x.to_str() + " y=" + y.to_str())
        }
        i = i + 1
    }
}

# Property: string length is preserved by concatenation.
fn prop_concat_len(a: str, b: str) -> bool {
    let c: str = a + b
    return c.len() == a.len() + b.len()
}

fn test_concat_len() uses Rand {
    let mut i: int = 0
    while i < 50 {
        let a: str = qc_str()
        let b: str = qc_str()
        if !prop_concat_len(a, b) {
            qc_fail("concat_len", "a=" + a + " b=" + b)
        }
        i = i + 1
    }
}

# Property: doubling then halving (via subtraction) returns the original
# for values well within int64 range. This exercises the overflow-check
# path under random inputs.
fn prop_double_half(x: int) -> bool {
    if x <= -4611686018427387904 || x >= 4611686018427387904 {
        return true  # skip extreme corners
    }
    let d: int = x + x
    return d - x == x
}

fn test_double_half() uses Rand {
    let mut i: int = 0
    while i < 50 {
        let x: int = qc_int_range(-1000000, 1000000)
        if !prop_double_half(x) {
            qc_fail("double_half", "x=" + x.to_str())
        }
        i = i + 1
    }
}


# --- main (for differential testing) ----------------------------------------
# Runs every test_* function in sequence. If any panics, the panic
# propagates and the program exits 101. The differential suite checks
# that the interpreter and the native compiler both produce the same
# (exit 0, "all stage-18 tests pass\n") result.

fn main() -> int uses IO, Rand {
    test_assert_eq_int_pass()
    test_assert_eq_str_pass()
    test_assert_eq_bool_pass()
    test_assert_ne_pass()
    test_assert_true_pass()
    test_assert_false_pass()
    test_assert_int_range_pass()
    test_assert_len_pass()
    test_assert_float_pass()
    test_add_commutative()
    test_concat_len()
    test_double_half()
    println("all stage-18 tests pass")
    return 0
}
