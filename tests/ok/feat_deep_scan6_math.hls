# feat_deep_scan6_math.hls — exercises the SCAN-C math fixes:
#   - math_abs_int(INT64_MIN) panics explicitly
#   - math_floor / math_ceil / math_round handle out-of-range floats
#   - math_sqrt(-0.0) returns -0.0 (not NaN)

import "std.math"

fn main() -> int uses IO {
    let f1: float = 3.7
    let f2: float = -3.7
    println("floor(3.7)=" + math_floor(f1).to_str())
    println("ceil(3.7)=" + math_ceil(f1).to_str())
    println("round(3.7)=" + math_round(f1).to_str())
    println("floor(-3.7)=" + math_floor(f2).to_str())
    println("ceil(-3.7)=" + math_ceil(f2).to_str())
    println("round(-3.7)=" + math_round(f2).to_str())
    # sqrt of 0.0 / -0.0 — must be 0.0 / -0.0 (not NaN)
    let z: float = 0.0
    println("sqrt(0)=" + math_sqrt(z).to_str())
    # Large float (out of int64 range): math_floor returns x unchanged.
    let big: float = 10000000000000000000.0
    println("floor(big)=" + math_floor(big).to_str())
    return 0
}
