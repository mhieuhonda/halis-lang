# Deep-scan-15 regression: std/bits.hls fixes for INT64_MIN edge cases.
#
# Three HIGH-severity bugs fixed in this commit:
#   1. bits_not(INT64_MIN) previously panicked because `0 - INT64_MIN - 1`
#      overflowed checked arithmetic. The XOR identity `~x = x ^ -1`
#      produces the same result without arithmetic negation.
#   2. bits_from_bytes_be([128, 0, 0, 0, 0, 0, 0, 0]) previously panicked
#      because the accumulator `r = r * 256 + b` overflowed at the final
#      iteration (2^63 exceeds INT64_MAX). The new implementation uses
#      bits_set to set individual bits via bits_pow2 (which special-cases
#      bit 63 = INT64_MIN).
#   3. bits_from_bytes_le([0, 0, 0, 0, 0, 0, 0, 128]) — same overflow,
#      same fix.
#
# The acceptance is that all three calls succeed and return the correct
# two's-complement value. Both the interpreter and native paths must
# produce identical output (the differential test enforces this).

import "std.bits"

fn main() -> int uses IO {
    let mn: int = -9223372036854775808
    let mx: int = 9223372036854775807

    # bits_not(INT64_MIN) must equal INT64_MAX (the XOR identity).
    let not_mn: int = bits_not(mn)
    println("bits_not(INT64_MIN)=" + not_mn.to_str())
    if not_mn != mx {
        println("FAIL: expected INT64_MAX")
        return 1
    }

    # bits_not(INT64_MAX) must equal INT64_MIN (inverse direction).
    let not_mx: int = bits_not(mx)
    println("bits_not(INT64_MAX)=" + not_mx.to_str())
    if not_mx != mn {
        println("FAIL: expected INT64_MIN")
        return 1
    }

    # bits_not(0) = -1, bits_not(-1) = 0 (existing sanity).
    println("bits_not(0)=" + bits_not(0).to_str())
    println("bits_not(-1)=" + bits_not(-1).to_str())
    println("bits_not(5)=" + bits_not(5).to_str())

    # bits_from_bytes_be with bit 63 set: [128, 0, 0, 0, 0, 0, 0, 0]
    # must equal INT64_MIN. The old accumulator panicked here.
    let bs_msb: list[int] = [128, 0, 0, 0, 0, 0, 0, 0]
    let v_be: int = bits_from_bytes_be(bs_msb)
    println("bits_from_bytes_be([128,0,...])=" + v_be.to_str())
    if v_be != mn {
        println("FAIL: expected INT64_MIN")
        return 1
    }

    # bits_from_bytes_le with bit 63 set: [0, 0, 0, 0, 0, 0, 0, 128]
    # must equal INT64_MIN (LE byte order).
    let bs_lsb: list[int] = [0, 0, 0, 0, 0, 0, 0, 128]
    let v_le: int = bits_from_bytes_le(bs_lsb)
    println("bits_from_bytes_le([0,...,128])=" + v_le.to_str())
    if v_le != mn {
        println("FAIL: expected INT64_MIN")
        return 1
    }

    # Round-trip: bytes_be(bytes_from_be(x)) == x for x = INT64_MIN.
    let rt: list[int] = bits_bytes_be(v_be)
    let rt_v: int = bits_from_bytes_be(rt)
    println("round-trip be INT64_MIN=" + rt_v.to_str())
    if rt_v != mn {
        println("FAIL: round-trip broke")
        return 1
    }

    # Round-trip with INT64_MAX too (positive bit 63 unset).
    let bs_max: list[int] = [127, 255, 255, 255, 255, 255, 255, 255]
    let v_max: int = bits_from_bytes_be(bs_max)
    println("bits_from_bytes_be([127,255,...])=" + v_max.to_str())
    if v_max != mx {
        println("FAIL: expected INT64_MAX")
        return 1
    }

    println("deep-scan-15 bits: OK")
    return 0
}
