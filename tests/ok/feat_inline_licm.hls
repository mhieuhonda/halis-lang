# ============================================================================
# feat_inline_licm.hls — Stage 11 release: inline_small + LICM passes
# ----------------------------------------------------------------------------
# Verifies that:
#   1. A small `pure` helper is inlined at its call sites (the call
#      instruction is replaced by the inlined body — observable via
#      --opt-stats as the callee being removed from the call graph).
#   2. Loop-invariant expressions are hoisted out of the loop body
#      (the loop runs faster; output is unchanged).
#   3. The optimiser preserves semantics — the output matches the
#      interpreter's run of the same program (differential test).
# ============================================================================

# A small pure helper — should be inlined at every call site.
fn square(x: int) -> int pure {
    return x * x
}

# A second pure helper — should also be inlined.
fn add_one(x: int) -> int pure {
    return x + 1
}

fn main() -> int uses IO {
    # 1. Direct inlining — square(5) becomes 25 at compile time via
    #    constant folding after inlining.
    let a: int = square(5)
    println("square(5) = " + a.to_str())

    # 2. Inlining with a runtime argument.
    let n: int = 7
    let b: int = square(n)
    println("square(7) = " + b.to_str())

    # 3. Two inlined calls in one expression.
    let c: int = add_one(square(3))
    println("add_one(square(3)) = " + c.to_str())

    # 4. Loop-invariant computation: `factor = base * 2` doesn't change
    #    inside the loop. LICM should hoist it out.
    let base: int = 10
    let mut sum: int = 0
    let mut i: int = 0
    while i < 5 {
        let factor: int = base * 2
        sum = sum + factor
        i = i + 1
    }
    println("sum = " + sum.to_str())

    return 0
}
