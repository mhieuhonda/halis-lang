# Helper module imported by feat_import.hls.
# Defines a function and a struct that the importer uses.
#
# Deep-scan-21 fix: this file was moved from tests/modules/helper.hls
# to tests/ok/modules/helper.hls so that feat_import.hls can import
# it via a downward-only relative path (avoiding the deep-scan-19
# path-traversal guard that forbids '..' segments).

struct Point {
    x: int,
    y: int
}

fn add_numbers(a: int, b: int) -> int {
    return a + b
}

fn make_point(x: int, y: int) -> Point {
    return Point { x: x, y: y }
}
