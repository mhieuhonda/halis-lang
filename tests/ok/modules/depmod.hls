# depmod.hls — the imported sibling of feat_stage130_deprecated.hls:
# a module that deprecates two of its own functions, one with a
# message and one bare, each with a live replacement. The ok fixture
# imports this module and calls the deprecated names — the L013
# cross-module case the linter exists for (a deprecation in a module
# you import is the case the warning is FOR), while the program
# itself runs green on both backends: deprecation is metadata, not
# behaviour.

#[deprecated("use depmod_fast(v) — the old form double-counts zero")]
fn depmod_slow(v: int) -> int {
    if v == 0 {
        return 1
    }
    return v * 2
}

fn depmod_fast(v: int) -> int {
    if v == 0 {
        return 1
    }
    return v * 2
}

#[deprecated]
fn depmod_legacy(v: int) -> int {
    return v + 7
}

fn depmod_modern(v: int) -> int {
    return v + 7
}
