# tests/ok/feat_deep_scan33_rfc.hls — regression pack for the
# deep-scan-33 std fixes:
#   * json_stream (#35): the streaming reader now enforces RFC 8259
#     separator rules — missing commas ([1 2], {"a":1 "b":2}), trailing
#     commas ([1,], {"a":1,}), value-less members ({"a":}), doubled or
#     leading commas are errors; every valid shape still parses.
#   * regex (#40/#42): a completely empty quantifier {} is a compile
#     error (it used to drop the atom); \x{...} above U+10FFFF is an
#     error (it used to wrap past 64 bits into a different code point).
#   * collections (#41): HashSetInt membership verifies the stored
#     value, not just the hash key.

import "std.json_stream"
import "std.regex"
import "std.collections"

fn jt_parse(src: str) -> Result[list[JsonToken], str] {
    let r: JsonReader = json_reader_new()
    let fr: Result[int, str] = json_reader_feed(r, src)
    if !result_is_ok(fr) {
        return Result.Err(result_err_or(fr, ""))
    }
    let fin: Result[int, str] = json_reader_finish(r)
    if !result_is_ok(fin) {
        return Result.Err(result_err_or(fin, ""))
    }
    return json_reader_drain(r, 1000000)
}

fn must_ok(src: str, tag: str) -> int uses IO {
    let p: Result[list[JsonToken], str] = jt_parse(src)
    if !result_is_ok(p) {
        println("FAIL valid JSON rejected: " + tag + " -> " + result_err_or(p, "?"))
        return 1
    }
    return 0
}

fn must_err(src: str, tag: str) -> int uses IO {
    let p: Result[list[JsonToken], str] = jt_parse(src)
    if result_is_ok(p) {
        println("FAIL invalid JSON accepted: " + tag)
        return 1
    }
    return 0
}

fn main() -> int uses IO {
    if must_ok("[1, 2, 3]", "array") != 0 { return 1 }
    if must_ok("[]", "empty array") != 0 { return 1 }
    if must_ok("{\"a\": 1, \"b\": 2}", "object") != 0 { return 1 }
    if must_ok("{}", "empty object") != 0 { return 1 }
    if must_ok("[1, [2, 3], {\"k\": 4}]", "nested") != 0 { return 1 }
    if must_ok("true", "scalar") != 0 { return 1 }
    if must_err("[1 2]", "missing comma") != 0 { return 1 }
    if must_err("[1,]", "trailing comma array") != 0 { return 1 }
    if must_err("{\"a\":}", "value-less member") != 0 { return 1 }
    if must_err("{\"a\":1,}", "trailing comma object") != 0 { return 1 }
    if must_err("[1,,2]", "double comma") != 0 { return 1 }
    if must_err("[,1]", "leading comma") != 0 { return 1 }
    if must_err("{\"a\":1 \"b\":2}", "object missing comma") != 0 { return 1 }
    if must_err("{\"a\"}", "member without value") != 0 { return 1 }
    println("json rfc ok")

    let e1: Result[Regex, str] = regex_compile("a{}")
    if result_is_ok(e1) { return 1 }
    let e2: Result[Regex, str] = regex_compile("a{2}")
    if !result_is_ok(e2) { return 1 }
    let e3: Result[Regex, str] = regex_compile("\\x{110000}")
    if result_is_ok(e3) { return 1 }
    let e4: Result[Regex, str] = regex_compile("\\x{10FFFF}")
    if !result_is_ok(e4) { return 1 }
    println("regex errors ok")

    let s: HashSetInt = hashset_int_new()
    hashset_int_add(s, 42)
    if !hashset_int_contains(s, 42) { return 1 }
    if hashset_int_contains(s, 43) { return 1 }
    println("hashset ok")
    return 0
}
