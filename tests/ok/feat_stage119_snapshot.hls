# ============================================================================
# tests/ok/feat_stage119_snapshot.hls — Stage 119 acceptance: snapshot testing
# ----------------------------------------------------------------------------
# This file is BOTH a valid Halis program (you can run it via `boot.py`)
# AND a hltest test file (you can run it via `tools/hltest.py`). Every
# test_* function records named snapshots through std.test's
# assert_snapshot; the committed store
# (tests/ok/__snapshots__/feat_stage119_snapshot.snap) pins each value
# byte for byte, and `main()` calls every test in order so the
# differential suite (interpreter vs native) exercises the same records
# — the protocol bytes are println output, whose Stage-0/native parity
# is a standing invariant, so ONE store serves both backends.
#
#   python3 tools/hltest.py tests/ok/feat_stage119_snapshot.hls
#   python3 tools/hltest.py -u tests/ok/feat_stage119_snapshot.hls
# ============================================================================

import "std.test"

# render_rows: a deterministic renderer — the shape of code snapshot
# tests are FOR (build something structured, pin it whole). The values
# double deterministically, so the output is a pure function of the
# input list.
fn render_rows(rows: list[int]) -> str {
    let lines: list[str] = []
    let mut i: int = 0
    while i < rows.len() {
        lines.push(i.to_str() + ": " + rows[i].to_str() +
        " -> " + (rows[i] * 2).to_str())
        i = i + 1
    }
    return join(lines, "\n")
}

# --- one flat value ---------------------------------------------------------

fn test_snapshot_plain() uses IO {
    assert_snapshot("greeting", "hello, snapshot")
}

# --- a rendered multi-line value --------------------------------------------

fn test_snapshot_multiline() uses IO {
    assert_snapshot("rows", render_rows([3, 1, 4, 1, 5, 9, 2, 6]))
}

# --- byte-exact edges: spaces and trailing newlines are DATA ----------------
#
# The store never trims, re-encodes, or normalises anything: leading and
# trailing spaces survive, and a value that ends in its own newline is
# distinct from one that does not.
fn test_snapshot_edges() uses IO {
    assert_snapshot("padded", "  keep my spaces  ")
    assert_snapshot("trailing-newline", "last line\n")
}

# --- the empty value: zero bytes, still a record ----------------------------

fn test_snapshot_empty() uses IO {
    assert_snapshot("empty", "")
}

# --- two named snapshots in one test ----------------------------------------
#
# Each call is its own record; names stay unique within the test, and
# the runner compares them independently.
fn test_snapshot_two_records() uses IO {
    assert_snapshot("first", "one")
    assert_snapshot("second", "two")
}

# --- diagnostic output interleaves safely -----------------------------------
#
# println lines between records are NOT part of any value: the stream
# parser skips them verbatim, and the value framing (length prefix +
# separator) keeps the records exact. The last value deliberately does
# not end in a newline of its own to prove the separator is framing,
# not content.
fn test_snapshot_interleaved() uses IO {
    println("computing...")
    assert_snapshot("computed", "value-under-test")
    println("done")
}

# --- main (for differential testing) ----------------------------------------
# Runs every test_* function in sequence. If any panics, the panic
# propagates and the program exits 101. The differential suite checks
# that the interpreter and the native compiler produce byte-identical
# protocol output.

fn main() -> int uses IO {
    test_snapshot_plain()
    test_snapshot_multiline()
    test_snapshot_edges()
    test_snapshot_empty()
    test_snapshot_two_records()
    test_snapshot_interleaved()
    println("all stage-119 snapshot tests pass")
    return 0
}
