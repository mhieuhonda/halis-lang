# feat_proof_sound_nz.hls — Stage-17 perfection (deep-scan-10)
# soundness regression: reassigning a variable must invalidate its
# `!= 0` fact (the old engine kept div_safe after `y = 0`). Both
# implementations must panic identically (101).
fn f(mut y: int, x: int) -> int
    requires y != 0
{
    y = 0
    return x / y
}
fn main() -> int {
    return f(5, 10)
}
