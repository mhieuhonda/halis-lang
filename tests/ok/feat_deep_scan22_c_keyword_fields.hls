# tests/ok/feat_deep_scan22_c_keyword_fields.hls — Stage 53 deep-scan-22
# (HIGH severity): C keyword field names.
#
# Bug: HLS allows struct field names that collide with C reserved
# words (long, short, int, char, double, float, default, void,
# unsigned, signed, register, volatile, const, static, extern, auto,
# ...). The C codegen emitted these verbatim as C field names,
# producing C compile errors like "expected identifier or '(' before
# 'long'".
#
# Fix: c_field_name() uniformly prefixes ALL HLS field names with
# "f_" in the C codegen, so no field name can collide with a C
# keyword, ever. The mangling is invisible to HLS source (the HLS
# code writes `obj.long`, the C code uses `obj->f_long`).
#
# This test exercises every C keyword that's also a plausible HLS
# field name. If the codegen regresses, this test fails to COMPILE
# (the C compile step panics with "expected identifier or '(' before
# 'long'").

import "std.str"

# A struct with C-keyword field names.
struct KeywordFields {
    long: int,           # C keyword "long"
    short: int,          # C keyword "short"
    int_field: int,      # NOT a keyword — sanity check
    default: str,        # C keyword "default"
    void: int,           # C keyword "void"
    const_val: int,      # NOT a keyword — sanity check
    static_val: int,     # "static" — keyword
    unsigned: int,       # C keyword "unsigned"
    signed: int,         # C keyword "signed"
    register_val: int,   # "register" — keyword
    volatile_val: int,   # "volatile" — keyword
    extern_val: int,     # "extern" — keyword
    auto_val: int,       # "auto" — keyword
    break_val: int,      # "break" — keyword
    case_val: int,       # "case" — keyword
    continue_val: int,   # "continue" — keyword
    do_val: int,         # "do" — keyword
    else_val: int,       # "else" — keyword
    for_val: int,        # "for" — keyword
    goto_val: int,       # "goto" — keyword
    if_val: int,         # "if" — keyword
    return_val: int,     # "return" — keyword
    sizeof_val: int,     # "sizeof" — keyword
    struct_val: int,     # "struct" — keyword
    switch_val: int,     # "switch" — keyword
    typedef_val: int,    # "typedef" — keyword
    union_val: int,      # "union" — keyword
    while_val: int,      # "while" — keyword
    inline_val: int,     # "inline" — keyword
    restrict_val: int,   # "restrict" — keyword
    char_val: int,       # "char" — keyword
    double_val: float,   # "double" — keyword
    float_val: float,    # "float" — keyword
}

fn make_keyword_fields() -> KeywordFields {
    return KeywordFields {
        long: 1,
        short: 2,
        int_field: 3,
        default: "hello",
        void: 4,
        const_val: 5,
        static_val: 6,
        unsigned: 7,
        signed: 8,
        register_val: 9,
        volatile_val: 10,
        extern_val: 11,
        auto_val: 12,
        break_val: 13,
        case_val: 14,
        continue_val: 15,
        do_val: 16,
        else_val: 17,
        for_val: 18,
        goto_val: 19,
        if_val: 20,
        return_val: 21,
        sizeof_val: 22,
        struct_val: 23,
        switch_val: 24,
        typedef_val: 25,
        union_val: 26,
        while_val: 27,
        inline_val: 28,
        restrict_val: 29,
        char_val: 30,
        double_val: 3.14,
        float_val: 2.71,
    }
}

fn test_keyword_field_read() -> int uses IO {
    let k: KeywordFields = make_keyword_fields()
    # Read each field — if the codegen didn't mangle, this would be a
    # C compile error.
    eq_int(k.long, 1, "long field read")
    eq_int(k.short, 2, "short field read")
    eq_int(k.int_field, 3, "int_field read")
    eq_str(k.default, "hello", "default field read")
    eq_int(k.void, 4, "void field read")
    eq_int(k.const_val, 5, "const_val read")
    eq_int(k.static_val, 6, "static_val read")
    eq_int(k.unsigned, 7, "unsigned field read")
    eq_int(k.signed, 8, "signed field read")
    eq_int(k.register_val, 9, "register_val read")
    eq_int(k.volatile_val, 10, "volatile_val read")
    eq_int(k.extern_val, 11, "extern_val read")
    eq_int(k.auto_val, 12, "auto_val read")
    eq_int(k.break_val, 13, "break_val read")
    eq_int(k.case_val, 14, "case_val read")
    eq_int(k.continue_val, 15, "continue_val read")
    eq_int(k.do_val, 16, "do_val read")
    eq_int(k.else_val, 17, "else_val read")
    eq_int(k.for_val, 18, "for_val read")
    eq_int(k.goto_val, 19, "goto_val read")
    eq_int(k.if_val, 20, "if_val read")
    eq_int(k.return_val, 21, "return_val read")
    eq_int(k.sizeof_val, 22, "sizeof_val read")
    eq_int(k.struct_val, 23, "struct_val read")
    eq_int(k.switch_val, 24, "switch_val read")
    eq_int(k.typedef_val, 25, "typedef_val read")
    eq_int(k.union_val, 26, "union_val read")
    eq_int(k.while_val, 27, "while_val read")
    eq_int(k.inline_val, 28, "inline_val read")
    eq_int(k.restrict_val, 29, "restrict_val read")
    eq_int(k.char_val, 30, "char_val read")
    eq_float(k.double_val, 3.14, "double_val read")
    eq_float(k.float_val, 2.71, "float_val read")
    return 0
}

fn test_keyword_field_write() -> int uses IO {
    let mut k: KeywordFields = make_keyword_fields()
    # Write each field — if the codegen didn't mangle, this would be a
    # C compile error.
    k.long = 100
    k.short = 200
    k.default = "world"
    k.void = 400
    k.unsigned = 700
    eq_int(k.long, 100, "long field write")
    eq_int(k.short, 200, "short field write")
    eq_str(k.default, "world", "default field write")
    eq_int(k.void, 400, "void field write")
    eq_int(k.unsigned, 700, "unsigned field write")
    return 0
}

# Helpers
fn ok(actual: bool, msg: str) -> void uses IO {
    if !actual {
        panic("FAIL " + msg)
    }
}

fn eq_int(actual: int, expected: int, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_str(actual: str, expected: str, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected '" + expected + "', got '" + actual + "'")
    }
}

fn eq_float(actual: float, expected: float, msg: str) -> void uses IO {
    let mut diff: float = actual - expected
    if diff < 0.0 {
        diff = 0.0 - diff
    }
    if diff > 0.000001 {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn main() -> int uses IO {
    println("=== Stage 53 deep-scan-22: C keyword field names ===")
    println("")
    println("--- read every C-keyword-named field ---")
    test_keyword_field_read()
    println("  ok")
    println("--- write to C-keyword-named fields ---")
    test_keyword_field_write()
    println("  ok")
    println("")
    println("ACCEPTANCE OK: Stage 53 deep-scan-22 — C keyword field names")
    println("  Struct fields can be named long / short / default / void / ...")
    println("  The C codegen uniformly mangles field names with 'f_' prefix")
    println("  HLS source uses obj.long; C code uses obj->f_long")
    println("  No C compile error possible from C-keyword-named fields.")
    return 0
}
