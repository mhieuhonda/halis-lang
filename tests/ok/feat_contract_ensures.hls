# feat_contract_ensures.hls — Stage 17: ensures clauses (checked at
# runtime under --contracts by the interpreter; call-site-checked for
# literal arguments statically).

fn abs_val(x: int) -> int
    ensures result >= 0
{
    if x < 0 {
        return -x
    }
    return x
}

fn add_pos(a: int, b: int) -> int
    requires a >= 0
    requires b >= 0
    ensures result >= a
{
    return a + b
}

fn main() -> int uses IO {
    let a: int = abs_val(-5)
    let b: int = add_pos(3, 4)
    println("abs=" + a.to_str() + " add=" + b.to_str())
    return 0
}
