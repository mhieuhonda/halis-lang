# feat_stage103_supplychain.hls — Stage 103 (v0.122.0-alpha):
# hls-audit, the transitive supply-chain effect report.
#
# The audit tool is analysis-only: it reads a tree, it compiles
# nothing. What the differential suite pins HERE is the program the
# demo shapes describe — an entry whose imports form a small supply
# chain (two toolchain modules), the same program `hls-audit` reports
# on:
#
#   python3 tools/hls-audit.py tests/ok/feat_stage103_supplychain.hls
#
#   root: tests/ok/feat_stage103_supplychain.hls
#   modules: 3 (2 toolchain, 0 dependency, 1 workspace)
#   IO introduced by the entry; nothing enters from the chain
#
# The program itself: a tiny "manifest reader" that mimics what the
# audit reasons about — a root surface, a dependency edge, an
# introduced effect — and asserts the arithmetic the attribution
# relies on (union, depth, chain length). Deterministic output;
# interpreter and native agree byte for byte.

import "std.str"
import "std.option"

fn chain_len(depth: int) -> int {
    # root -> dep1 -> ... -> depN: N edges, N+1 nodes
    if depth < 0 {
        panic("chain_len: depth must not be negative")
    }
    return depth + 1
}

fn union_size(a: int, b: int, shared: int) -> int {
    # |A ∪ B| = |A| + |B| - |A ∩ B|
    return a + b - shared
}

fn label(effect: str, introducer: str, depth: int) -> str {
    let mut s: str = effect + " @ " + introducer + " (depth "
    s = s + depth.to_str()
    s = s + ")"
    return s
}

fn main() -> int uses IO {
    let mut checks: int = 0

    # The demo tree: root (IO), netcheck (IO + Net), geo (Clock).
    let root_surface: int = 1
    let netcheck_surface: int = 2
    let geo_surface: int = 1
    let shared_io: int = 1
    let total: int = union_size(union_size(root_surface,
    netcheck_surface, shared_io),
    geo_surface, 0)
    if total != 3 {
        panic("program surface must be 3 effects, got " + total.to_str())
    }
    checks = checks + 1

    # Chains: two hops to geo (3 nodes), one hop to netcheck (2).
    if chain_len(2) != 3 || chain_len(1) != 2 || chain_len(0) != 1 {
        panic("chain arithmetic wrong")
    }
    checks = checks + 1

    # Attribution labels — the report's lines, in miniature.
    println(label("Net", "netcheck.hls", 1))
    println(label("Clock", "geo.hls", 2))
    println(label("IO", "audit_demo.hls", 0))
    checks = checks + 1

    # Option shapes the report's "no policy" verdict.
    let policy: Option[int] = Option.None
    if option_is_none(policy) {
        println("policy: (none — report only)")
    } else {
        panic("policy must be unset in the demo")
    }
    checks = checks + 1

    # std.str rides along (toolchain, pure): the introducer prefix.
    let mod_name: str = "examples/audit_libs/geo.hls"
    if !str_contains(mod_name, "geo") {
        panic("module key must keep its path")
    }
    println("checks passed: " + checks.to_str())
    return 0
}
