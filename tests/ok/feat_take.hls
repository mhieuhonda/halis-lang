# feat_take — Stage 8-alpha: explicit ownership transfer via take()
# Verifies that take() moves a value out (binding becomes moved) and the
# moved value can be passed to a consuming function.

struct Buffer {
    data: str
}

impl Buffer {
    fn total_len(self: Buffer) -> int {
        return self.data.len()
    }
}

fn make_buf(s: str) -> Buffer {
    return Buffer { data: s }
}

fn main() -> int uses IO {
    let b: Buffer = make_buf("hello world")
    let n: int = b.total_len()
    if n == 11 {
        println("method-call before take ok")
    }
    # Now take the data out of b.
    let s: str = take(b).data
    println("taken data: " + s)
    return 0
}
