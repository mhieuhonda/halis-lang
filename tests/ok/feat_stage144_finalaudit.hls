# feat_stage144_finalaudit.hls — Stage 144 (v0.165.0-alpha):
# the FINAL independent third-party security audit, the engagement
# that gates the v1.0 release candidates.
#
# What this fixture pins is the DECISION PROCEDURE the kit runs —
# the same laws `tools/hls-finalaudit.py` applies when it pins the
# three anchors, labels a pass, judges a remediation, seals the
# ledger and answers the gate:
#
#   hls-finalaudit engage | brief | evidence | file | triage
#                        | signoff | gate | report | status
#
#   1. the anchor     — the final audit pins THREE anchors at the
#      law             signature: what the toolchain guarantees,
#                       what the surface is, what the shipped
#                       compiler bytes are. A signature without
#                       all three is not final; the drift names
#                       the anchor that moved, never all three;
#
#   2. the independence — the roster decides the label (inherited
#      law for closure    from Stage 140), and the closure needs
#                       MORE than labels: an independent pass on
#                       record and the latest pass green — an
#                       audit that closes on the project's own
#                       evidence is a rubber stamp with a paper
#                       trail;
#
#   3. the landing    — a remediation must EXIST, LAND (an
#      law             ancestor of the tree being released), and
#                       POSTDATE the finding it fixes — a fix
#                       that predates its finding is a
#                       contradiction;
#
#   4. the state      — seven states, ordered vacant -> open ->
#      law             underway -> reported -> responded ->
#                       remediated -> sealed; sealed is a signoff
#                       on record, and the signoff could only be
#                       written from remediated plus the closure
#                       laws;
#
#   5. the seal       — after the seal nothing appends: what
#      law             comes after the seal is the next audit,
#                       not an amendment. Readers still read, the
#                       chain still verifies, and the signoff is
#                       the project's act — an auditor cannot
#                       seal their own audit;
#
#   6. the gate       — the gate is red until the seal, and
#      law             green only when the sealed tree is an
#                       ancestor of the candidate's HEAD (the
#                       release is cut from the audited tree or
#                       its descendants, never around the audit),
#                       the three anchors still pinned, and every
#                       fix still landed;
#
#   7. the count      — the numbers the acceptance gate pins:
#      law             9 commands, 7 states, 3 anchors, 5
#                       severities, 3 verdicts, 5 entry kinds, 2
#                       reproducer modes, 2 pass outcomes;
#
#   8. the honesty    — drift is a fact the pass records, not a
#      law             refusal it hides; a failed pass is
#                       recorded, not skipped; a green pass
#                       carrying refusals is a contradiction; and
#                       the report never calls a self-run pass
#                       independent.
#
# The program exits 0 when every law holds, nonzero with the
# law's number otherwise — the differential suite runs it on the
# interpreter AND natively and requires byte-identical output.
#
# This file enters the corpus at this release — green the day it
# is born, already written in the dialect the kit speaks.

# ----------------------------------------------------------------------
# Section 1 — the anchor law. Three anchors, each a digest, one per
# Phase X pillar; a signature without all three is not final, and
# the drift names the anchor that moved.
# ----------------------------------------------------------------------
fn anchor_index(name: str) -> int {
    let names: list[str] = ["guarantee-scope",
    "api-freeze", "bootstrap-snapshot"]
    let mut i: int = 0
    while i < names.len() {
        if names[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

fn anchors_pinned(has_scope: bool, has_freeze: bool,
has_snapshot: bool) -> bool {
    if !has_scope || !has_freeze || !has_snapshot {
        return false
    }
    return true
}

fn drift_names_the_moved(pinned: str, live: str) -> bool {
    if pinned == live {
        return false
    }
    return true
}

fn test_anchor_law() -> int {
    # The three pillars, at their indexes.
    if anchor_index("guarantee-scope") != 0 {
        return 1
    }
    if anchor_index("api-freeze") != 1 {
        return 2
    }
    if anchor_index("bootstrap-snapshot") != 2 {
        return 3
    }
    if anchor_index("surface") != -1 {
        return 4
    }
    # A signature without all three anchors is not final.
    if !anchors_pinned(true, true, true) {
        return 5
    }
    if anchors_pinned(true, true, false) {
        return 6
    }
    if anchors_pinned(false, true, true) {
        return 7
    }
    if anchors_pinned(true, false, true) {
        return 8
    }
    # The drift names the anchor that moved — the one that held is
    # not named.
    if !drift_names_the_moved("a1111111111111111111111111111111111",
    "b2222222222222222222222222222222222") {
        return 9
    }
    if drift_names_the_moved("a1111111111111111111111111111111111",
    "a1111111111111111111111111111111111") {
        return 10
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 2 — the independence law, for closure. The roster decides
# the label; the seal demands more: an independent pass AND the
# latest pass green.
# ----------------------------------------------------------------------
fn label_of(on_roster: bool) -> str {
    if on_roster {
        return "INDEPENDENT"
    }
    return "SELF-ASSESSED"
}

fn may_close(has_independent: bool, latest_ok: bool) -> bool {
    if !has_independent {
        return false
    }
    if !latest_ok {
        return false
    }
    return true
}

fn test_independence_law() -> int {
    let roster: list[str] = ["Dana Fischer", "Ravi Chandran"]
    # The label follows the roster, never the mood.
    if label_of(roster[0] == "Dana Fischer") != "INDEPENDENT" {
        return 1
    }
    if label_of("mhieuhonda" == roster[0]) != "SELF-ASSESSED" {
        return 2
    }
    # Closure needs an independent pass and a green latest pass.
    if !may_close(true, true) {
        return 3
    }
    if may_close(false, true) {
        return 4
    }
    if may_close(true, false) {
        return 5
    }
    if may_close(false, false) {
        return 6
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 3 — the landing law. Exist, land, postdate: three named
# refusals, one happy path.
# ----------------------------------------------------------------------
fn is_commit_sha(s: str) -> bool {
    if s.len() != 40 {
        return false
    }
    let mut i: int = 0
    while i < s.len() {
        let c: int = s.byte_at(i)
        let ok: bool = (c >= 48 && c <= 57)
        || (c >= 97 && c <= 102)
        if !ok {
            return false
        }
        i = i + 1
    }
    return true
}

fn lands(exists: bool, is_ancestor: bool) -> bool {
    if !exists {
        return false
    }
    if !is_ancestor {
        return false
    }
    return true
}

fn postdates(committed: int, filed: int) -> bool {
    if committed < filed {
        return false
    }
    return true
}

fn fix_accepted(exists: bool, is_ancestor: bool,
committed: int, filed: int) -> bool {
    if !lands(exists, is_ancestor) {
        return false
    }
    if !postdates(committed, filed) {
        return false
    }
    return true
}

fn test_landing_law() -> int {
    # The fix grammar is 40 hex.
    if !is_commit_sha("f0f0ec1b07cf0d3d9bbee1a3c3f12039d8405abc") {
        return 1
    }
    if is_commit_sha("f0f0") {
        return 2
    }
    # A fix that exists nowhere is a promise.
    if lands(false, true) {
        return 3
    }
    # A fix that has not landed is a promise too — a different one,
    # named differently.
    if lands(true, false) {
        return 4
    }
    if !lands(true, true) {
        return 5
    }
    # A fix that predates its finding is a contradiction.
    if postdates(1000, 2000) {
        return 6
    }
    if !postdates(2000, 1000) {
        return 7
    }
    if !postdates(2000, 2000) {
        return 8
    }
    # The three together: the only happy path lands and postdates.
    if !fix_accepted(true, true, 3000, 2000) {
        return 9
    }
    if fix_accepted(true, true, 1000, 2000) {
        return 10
    }
    if fix_accepted(true, false, 3000, 2000) {
        return 11
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 4 — the state law. Seven states, ordered; sealed is the
# signoff on record, and the signoff could only be written from
# remediated plus the closure laws.
# ----------------------------------------------------------------------
fn state_index(s: str) -> int {
    let words: list[str] = ["vacant", "open", "underway",
    "reported", "responded", "remediated", "sealed"]
    let mut i: int = 0
    while i < words.len() {
        if words[i] == s {
            return i
        }
        i = i + 1
    }
    return -1
}

fn derive_state(has_entries: bool, has_pass: bool,
n_findings: int, n_triaged: int, n_accepted: int,
n_fixed: int, has_signoff: bool) -> int {
    if !has_entries {
        return 0
    }
    if has_signoff {
        return 6
    }
    if !has_pass {
        return 1
    }
    if n_findings == 0 {
        return 2
    }
    if n_triaged < n_findings {
        return 3
    }
    if n_fixed < n_accepted {
        return 4
    }
    return 5
}

fn test_state_law() -> int {
    # The seven states, at their ranks, in order.
    if state_index("vacant") != 0 || state_index("open") != 1
    || state_index("underway") != 2 {
        return 1
    }
    if state_index("reported") != 3 || state_index("responded") != 4
    || state_index("remediated") != 5 {
        return 2
    }
    if state_index("sealed") != 6 {
        return 3
    }
    if state_index("closed") != -1 || state_index("") != -1 {
        return 4
    }
    # The ladder, walked.
    if derive_state(false, false, 0, 0, 0, 0, false) != 0 {
        return 5
    }
    if derive_state(true, false, 0, 0, 0, 0, false) != 1 {
        return 6
    }
    if derive_state(true, true, 0, 0, 0, 0, false) != 2 {
        return 7
    }
    if derive_state(true, true, 2, 1, 1, 1, false) != 3 {
        return 8
    }
    if derive_state(true, true, 2, 2, 1, 0, false) != 4 {
        return 9
    }
    if derive_state(true, true, 2, 2, 1, 1, false) != 5 {
        return 10
    }
    # The seal: a signoff on record, whatever else the census says —
    # the writer could only reach it through the closure laws.
    if derive_state(true, true, 2, 2, 1, 1, true) != 6 {
        return 11
    }
    if derive_state(true, false, 0, 0, 0, 0, true) != 6 {
        return 12
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 5 — the seal law. After the seal nothing appends; the
# readers still read; the signoff is the project's act.
# ----------------------------------------------------------------------
fn appends_allowed(sealed: bool) -> bool {
    if sealed {
        return false
    }
    return true
}

fn readers_still_read(sealed: bool) -> bool {
    if sealed {
        return true
    }
    return true
}

fn can_seal(by_is_auditor: bool) -> bool {
    if by_is_auditor {
        return false
    }
    return true
}

fn test_seal_law() -> int {
    # Before the seal, the writers write.
    if !appends_allowed(false) {
        return 1
    }
    # After the seal, nothing appends.
    if appends_allowed(true) {
        return 2
    }
    # The readers read either way — the record is closed, not
    # destroyed.
    if !readers_still_read(false) || !readers_still_read(true) {
        return 3
    }
    # The signoff is the project's act; an auditor cannot seal
    # their own audit.
    if can_seal(true) {
        return 4
    }
    if !can_seal(false) {
        return 5
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 6 — the gate law. Red until sealed; green only when the
# sealed tree is an ancestor of the candidate's HEAD, the anchors
# still pinned, every fix still landed.
# ----------------------------------------------------------------------
fn gate(sealed: bool, sealed_is_ancestor: bool,
anchors_hold: bool, fixes_land: bool) -> bool {
    if !sealed {
        return false
    }
    if !sealed_is_ancestor {
        return false
    }
    if !anchors_hold {
        return false
    }
    if !fixes_land {
        return false
    }
    return true
}

fn test_gate_law() -> int {
    # Red until sealed — everything before the seal is red, whatever
    # else holds.
    if gate(false, true, true, true) {
        return 1
    }
    # The release is never cut around the audit.
    if gate(true, false, true, true) {
        return 2
    }
    # The artifact that moved after the seal is not the artifact
    # that was audited.
    if gate(true, true, false, true) {
        return 3
    }
    # A fix that no longer lands is a promise, not a fix.
    if gate(true, true, true, false) {
        return 4
    }
    # The one green world.
    if !gate(true, true, true, true) {
        return 5
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 7 — the count law. The numbers the acceptance gate pins:
# 9 commands, 7 states, 3 anchors, 5 severities, 3 verdicts, 5
# entry kinds, 2 reproducer modes, 2 pass outcomes.
# ----------------------------------------------------------------------
fn test_count_law() -> int {
    let commands: list[str] = ["engage", "brief", "evidence",
    "file", "triage", "signoff", "gate", "report", "status"]
    if commands.len() != 9 {
        return 1
    }
    let states: list[str] = ["vacant", "open", "underway",
    "reported", "responded", "remediated", "sealed"]
    if states.len() != 7 {
        return 2
    }
    let anchors: list[str] = ["guarantee-scope", "api-freeze",
    "bootstrap-snapshot"]
    if anchors.len() != 3 {
        return 3
    }
    let severities: list[str] = ["critical", "high", "medium",
    "low", "info"]
    if severities.len() != 5 {
        return 4
    }
    let verdicts: list[str] = ["accepted", "disputed",
    "out-of-scope"]
    if verdicts.len() != 3 {
        return 5
    }
    let kinds: list[str] = ["engagement", "evidence", "finding",
    "triage", "signoff"]
    if kinds.len() != 5 {
        return 6
    }
    let repro_modes: list[str] = ["path", "text"]
    if repro_modes.len() != 2 {
        return 7
    }
    let outcomes: list[str] = ["ok", "failed"]
    if outcomes.len() != 2 {
        return 8
    }
    return 0
}

# ----------------------------------------------------------------------
# Section 8 — the honesty law. Drift is a fact recorded, not a
# refusal hidden; both outcomes are recorded; the report never
# calls a self-run pass independent.
# ----------------------------------------------------------------------
fn drift_recorded(pinned: str, ran: str) -> bool {
    if pinned != ran {
        return true
    }
    return false
}

fn outcome_recorded(outcome: str) -> bool {
    if outcome == "ok" {
        return true
    }
    if outcome == "failed" {
        return true
    }
    return false
}

fn honest_label(independent: bool) -> str {
    if independent {
        return "INDEPENDENT"
    }
    return "SELF-ASSESSED"
}

fn test_honesty_law() -> int {
    # The pass that ran another artifact names it — the one that
    # ran the engaged one does not.
    if !drift_recorded("a1111111111111111111111111111111111",
    "b2222222222222222222222222222222222") {
        return 1
    }
    if drift_recorded("a1111111111111111111111111111111111",
    "a1111111111111111111111111111111111") {
        return 2
    }
    # Both outcomes are recorded; "skipped" is not an outcome.
    if !outcome_recorded("ok") || !outcome_recorded("failed") {
        return 3
    }
    if outcome_recorded("skipped") {
        return 4
    }
    # The report never calls a self-run pass independent.
    if honest_label(false) != "SELF-ASSESSED" {
        return 5
    }
    if honest_label(true) != "INDEPENDENT" {
        return 6
    }
    return 0
}

# ----------------------------------------------------------------------
# main — every law, in order, first failure named.
# ----------------------------------------------------------------------
fn main() -> int uses IO {
    let sections: list[str] = ["anchor", "independence",
    "landing", "state", "seal", "gate", "count", "honesty"]
    let mut failures: int = 0
    let results: list[int] = [test_anchor_law(),
    test_independence_law(),
    test_landing_law(),
    test_state_law(),
    test_seal_law(),
    test_gate_law(),
    test_count_law(),
    test_honesty_law()]
    let mut i: int = 0
    while i < results.len() {
        if results[i] != 0 {
            println("finalaudit law " + sections[i]
            + " FAILED case " + results[i].to_str())
            failures = failures + 1
        }
        i = i + 1
    }
    if failures > 0 {
        println(failures.to_str() + " finalaudit laws failed")
        return 1
    }
    println("all 8 finalaudit laws hold")
    return 0
}
