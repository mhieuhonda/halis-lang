# Deep-scan-12 regression: std/url.hls url_decode vs
# url_component_decode (DSS-T-22). Before the fix, url_decode
# unconditionally translated `+` → space, which is wrong for path
# and fragment components (RFC 3986 says `+` is literal there).
# The new url_component_decode leaves `+` as a literal `+`.

import "std.url"

fn main() -> int uses IO {
    # url_decode: `+` → space (form-encoding, for query strings).
    let q: str = url_decode("a+b")
    if q != "a b" {
        println("FAIL: url_decode('a+b') = '" + q + "' (want 'a b')")
        return 1
    }
    # url_component_decode: `+` is literal (RFC 3986, for paths/fragments).
    let p: str = url_component_decode("a+b")
    if p != "a+b" {
        println("FAIL: url_component_decode('a+b') = '" + p + "' (want 'a+b')")
        return 1
    }
    # Both decode %XX.
    let e1: str = url_decode("a%20b")
    if e1 != "a b" {
        println("FAIL: url_decode('a%20b') = '" + e1 + "' (want 'a b')")
        return 1
    }
    let e2: str = url_component_decode("a%20b")
    if e2 != "a b" {
        println("FAIL: url_component_decode('a%20b') = '" + e2 + "' (want 'a b')")
        return 1
    }
    println("ok: url_decode + url_component_decode semantics")
    return 0
}
