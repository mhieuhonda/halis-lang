# feat_stage26_riscv.hls — Stage 26 (v0.49.0-alpha): RISC-V 64 backend test.
#
# Verifies that:
#   (a) The Halis program runs correctly under the boot interpreter
#       (which exercises the same code paths as the native compiler
#       minus the SIMD intrinsics — the portable scalar fallback).
#   (b) The pure integer arithmetic (fib_iter, riscv_sum_range) returns
#       the expected values.
#   (c) The std.simd kernels (simd_i32x4_add / simd_i32x4_sub /
#       simd_i32x4_mul / simd_i32x4_min / simd_i32x4_max) work
#       correctly on the portable path (the RVV intrinsics are verified
#       by the C source inspection in tests/run_tests.sh section 15).
#   (d) has_feature("rvv") const-folds correctly (false when
#       --target-feature rvv is NOT passed, true when it IS passed).
#
# This is the Stage 26 acceptance test (the rvv-demo example is a
# separate file at examples/riscv_demo.hls; this is the ok-test variant
# that runs in the test suite under the boot interpreter).

import "std.simd"

# fib_iter: pure integer Fibonacci (no IO, no allocation).
fn fib_iter(n: int) -> int {
    let mut a: int = 0
    let mut b: int = 1
    let mut i: int = 0
    while i < n {
        let t: int = a + b
        a = b
        b = t
        i = i + 1
    }
    return a
}

# riscv_sum_range: pure integer sum (no IO, no allocation).
fn riscv_sum_range(n: int) -> int {
    let mut total: int = 0
    let mut i: int = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

# riscv_rvv_demo: std.simd kernels (portable path; RVV intrinsics
# are emitted by the native compiler under --target-feature rvv).
fn riscv_rvv_demo() -> int {
    let a: I32x4 = simd_i32x4_from(1, 2, 3, 4)
    let b: I32x4 = simd_i32x4_splat(10)
    let sum: I32x4 = simd_i32x4_add(a, b)
    let s0: int = simd_i32x4_lane(sum, 0)
    let s1: int = simd_i32x4_lane(sum, 1)
    let s2: int = simd_i32x4_lane(sum, 2)
    let s3: int = simd_i32x4_lane(sum, 3)
    # sum = [11, 12, 13, 14] -> 11 + 12 + 13 + 14 = 50
    return s0 + s1 + s2 + s3
}

# riscv_rvv_sub: tests simd_i32x4_sub on the portable path.
fn riscv_rvv_sub() -> int {
    let a: I32x4 = simd_i32x4_from(100, 200, 300, 400)
    let b: I32x4 = simd_i32x4_from(1, 2, 3, 4)
    let diff: I32x4 = simd_i32x4_sub(a, b)
    # diff = [99, 198, 297, 396] -> 99 + 198 + 297 + 396 = 990
    return simd_i32x4_lane(diff, 0) + simd_i32x4_lane(diff, 1)
        + simd_i32x4_lane(diff, 2) + simd_i32x4_lane(diff, 3)
}

# riscv_rvv_mul: tests simd_i32x4_mul on the portable path.
fn riscv_rvv_mul() -> int {
    let a: I32x4 = simd_i32x4_from(2, 3, 4, 5)
    let b: I32x4 = simd_i32x4_splat(10)
    let prod: I32x4 = simd_i32x4_mul(a, b)
    # prod = [20, 30, 40, 50] -> 20 + 30 + 40 + 50 = 140
    return simd_i32x4_lane(prod, 0) + simd_i32x4_lane(prod, 1)
        + simd_i32x4_lane(prod, 2) + simd_i32x4_lane(prod, 3)
}

# riscv_rvv_min: tests simd_i32x4_min on the portable path.
fn riscv_rvv_min() -> int {
    let a: I32x4 = simd_i32x4_from(10, 20, 30, 40)
    let b: I32x4 = simd_i32x4_from(25, 15, 35, 5)
    let m: I32x4 = simd_i32x4_min(a, b)
    # min = [10, 15, 30, 5] -> 10 + 15 + 30 + 5 = 60
    return simd_i32x4_lane(m, 0) + simd_i32x4_lane(m, 1)
        + simd_i32x4_lane(m, 2) + simd_i32x4_lane(m, 3)
}

# riscv_rvv_max: tests simd_i32x4_max on the portable path.
fn riscv_rvv_max() -> int {
    let a: I32x4 = simd_i32x4_from(10, 20, 30, 40)
    let b: I32x4 = simd_i32x4_from(25, 15, 35, 5)
    let m: I32x4 = simd_i32x4_max(a, b)
    # max = [25, 20, 35, 40] -> 25 + 20 + 35 + 40 = 120
    return simd_i32x4_lane(m, 0) + simd_i32x4_lane(m, 1)
        + simd_i32x4_lane(m, 2) + simd_i32x4_lane(m, 3)
}

fn main() -> int uses IO {
    let fib10: int = fib_iter(10)
    let sum100: int = riscv_sum_range(100)
    let rvv: int = riscv_rvv_demo()
    let rvv_sub: int = riscv_rvv_sub()
    let rvv_mul: int = riscv_rvv_mul()
    let rvv_min: int = riscv_rvv_min()
    let rvv_max: int = riscv_rvv_max()
    println("Stage 26 RISC-V 64 backend test")
    println("  fib_iter(10) = " + fib10.to_str() + " (expected 55)")
    println("  riscv_sum_range(100) = " + sum100.to_str() + " (expected 5050)")
    println("  riscv_rvv_demo() = " + rvv.to_str() + " (expected 50)")
    println("  riscv_rvv_sub() = " + rvv_sub.to_str() + " (expected 990)")
    println("  riscv_rvv_mul() = " + rvv_mul.to_str() + " (expected 140)")
    println("  riscv_rvv_min() = " + rvv_min.to_str() + " (expected 60)")
    println("  riscv_rvv_max() = " + rvv_max.to_str() + " (expected 120)")
    if has_feature("rvv") {
        println("  has_feature(\"rvv\"): true (compiled with --target-feature rvv)")
    } else {
        println("  has_feature(\"rvv\"): false (portable path; compile with --target-feature rvv)")
    }
    if fib10 == 55 && sum100 == 5050 && rvv == 50 && rvv_sub == 990
        && rvv_mul == 140 && rvv_min == 60 && rvv_max == 120 {
        println("ACCEPTANCE OK: Stage 26 RISC-V test passes")
        return 0
    }
    println("FAIL: Stage 26 RISC-V test mismatch")
    return 1
}
