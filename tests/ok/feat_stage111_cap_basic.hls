# feat_stage111_cap_basic.hls — Stage 111 (v0.130.0-alpha).
# Capability tokens: Cap[Net] as a VALUE. main splits the token off the
# process authority with cap_take("Net") and hands it to fetch — whose
# signature CARRIES the authority (a Cap[Net] parameter grants the body
# the Net effect without a `uses` clause). fetch calls net_lookup; the
# same program shape without the parameter is the fail-side twin
# (fail_stage111_cap_missing_grant).

fn fetch(c: Cap[Net]) -> str {
    return net_lookup("localhost")
}

fn main() -> int {
    let io: Cap[IO] = cap_take("IO")
    let net: Cap[Net] = cap_take("Net")
    let ip: str = fetch(net)
    println("localhost -> " + ip)
    return 0
}
