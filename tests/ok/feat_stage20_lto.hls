import "std.list"

fn main() -> int uses IO {
    let data: list[int] = [5, 3, 9, 1, 7, 3, 8, 2, 6, 4, 0, 9]
    let sorted: list[int] = list_sort_int_asc(data)
    let mut i: int = 0
    while i < sorted.len() {
        print(sorted.get(i).to_str() + " ")
        i = i + 1
    }
    println("")
    println("rev-first = " + list_reverse_int(sorted).get(0).to_str())
    return 0
}
