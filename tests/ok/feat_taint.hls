# ============================================================================
# feat_taint.hls — Stage 10-alpha: taint tracking (positive path)
# ----------------------------------------------------------------------------
# Verifies that:
#   1. taint_mark + taint_unwrap round-trips a value.
#   2. tainted_args() returns the program's argv, each wrapped as
#      tainted[str], and we can unwrap and print them after a sanitize
#      step (using std.sanitize.sanitize_command to make them shell-safe).
#   3. Sanitized values CAN be passed to sinks (the whole point).
#   4. Pure queries on tainted values (len, starts_with) work and do
#      not raise a taint-sink violation.
#
# This program is also a differential test: native hlc must produce the
# same output as Stage-0.
# ============================================================================

import "std.sanitize"
import "std.taint"

fn main() -> int uses Args, IO {
    # 1. Basic mark/unwrap round-trip.
    let t: tainted[str] = taint_mark("hello")
    let s: str = taint_unwrap(t)
    println("unwrapped: " + s)

    # 2. Pure query on a tainted value (no sink violation).
    let n: int = taint_check_len(t)
    println("len: " + n.to_str())

    # 3. Tainted argv: each argument is tainted; we MUST sanitize before
    #    printing (or use taint_unwrap as the explicit escape hatch).
    let argv: list[tainted[str]] = tainted_args()
    println("argc: " + argv.len().to_str())
    if argv.len() > 1 {
        # Sanitize and print the first argument.
        let cleaned: str = sanitize_command(argv.get(1))
        println("arg1: " + cleaned)
    } else {
        println("arg1: (none)")
    }

    # 4. Sanitizers at work — show that each one passes through (or
    #    panics, which we don't trigger here).
    let html_in: tainted[str] = taint_mark("<script>alert('xss')</script>")
    let html_out: str = sanitize_html(html_in)
    println("html: " + html_out)

    let path_in: tainted[str] = taint_mark("data/input.txt")
    let path_out: str = sanitize_path(path_in)
    println("path: " + path_out)

    let sql_in: tainted[str] = taint_mark("users")
    let sql_out: str = sanitize_sql_identifier(sql_in)
    println("sql_id: " + sql_out)

    let lit_in: tainted[str] = taint_mark("O'Brien")
    let lit_out: str = sanitize_sql_string(lit_in)
    println("sql_lit: " + lit_out)

    let fname_in: tainted[str] = taint_mark("output.txt")
    let fname_out: str = sanitize_filename(fname_in)
    println("filename: " + fname_out)

    return 0
}
