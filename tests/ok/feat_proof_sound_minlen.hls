# feat_proof_sound_minlen.hls — Stage-17 perfection (deep-scan-10)
# soundness regression: reassigning a container must invalidate its
# minimum-length fact (the old engine kept the stale `len >= 3` after
# `xs = [1]` and proved an OOB index). Both implementations must panic
# identically (101).
fn f(mut xs: list[int], i: int) -> int
    requires xs.len() >= 3
    requires i >= 0
    requires i <= 2
{
    xs = [1]
    return xs[i]
}
fn main() -> int {
    return f([1, 2, 3], 2)
}
