# feat_stage145_ltspolicy.hls — Stage 145 (v0.166.0-alpha): the
# published LTS policy (`3 years bug-fix, 5 years security`).
#
# What this fixture pins is the DECISION PROCEDURE the window law
# runs — the same arithmetic `tools/hls-lts.py` applies when it
# judges a line, a fix or a release on an LTS branch:
#
#   hls-lts window | backport | tag-patch | audit
#
#   1. the calendar  — `base + N years` is the same month and day
#      law             (an anniversary), with February 29 clamped to
#                      the 28th when the target year is not a leap
#                      year: a line born 2024-02-29 is bug-fixed
#                      through 2027-02-28, not through a day that
#                      does not exist;
#   2. the phase     — three phases, and the horizon day belongs
#      machine          to the phase it closes: support runs THROUGH
#                      the anniversary, so the third birthday is
#                      the last full-support day, the fifth is the
#                      last supported day, and the day after each
#                      is the next phase already;
#   3. the marking   — a `Security: <reason>` line makes a fix a
#      law             security fix: the name matches case-
#                      insensitively, the FIRST such line decides,
#                      and an empty value is not a marking — no
#                      trailer, no security claim (fail-closed,
#                      like everything in this policy);
#   4. the admission — in the active phase any fix may land; in
#      law             the security phase only marked ones; in eol
#                      nothing at all — a dead line takes nothing.
#                      And a release cut in the security phase
#                      carries at least one marked backport: a
#                      chore-only release is how a security line
#                      pretends to be alive.
#
# Dates are keys, y*10000 + m*100 + d — the encoding the corpus has
# used since Stage 131 — so every comparison is a plain int compare
# and the interpreter and the native binary agree byte for byte.
#
# The program exits 0 when every law holds, 10+section*10+case
# otherwise.
#
# This file enters the corpus at this release — green the day it is
# born, already speaking the dialect the policy speaks.

# ----------------------------------------------------------------------
# The phase codes, as the tool reports them.
# ----------------------------------------------------------------------
fn phase_active() -> int {
    return 0
}

fn phase_security() -> int {
    return 1
}

fn phase_eol() -> int {
    return 2
}

# ----------------------------------------------------------------------
# The calendar law. A date is a key: y*10000 + m*100 + d.
# ----------------------------------------------------------------------
fn date_key(y: int, m: int, d: int) -> int {
    return y * 10000 + m * 100 + d
}

fn year_of(k: int) -> int {
    return k / 10000
}

fn month_of(k: int) -> int {
    let m: int = k / 100
    return m % 100
}

fn day_of(k: int) -> int {
    return k % 100
}

fn is_leap(y: int) -> bool {
    if y % 4 != 0 {
        return false
    }
    if y % 100 != 0 {
        return true
    }
    return y % 400 == 0
}

fn days_in_month(y: int, m: int) -> int {
    if m == 2 {
        if is_leap(y) {
            return 29
        }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    return 31
}

# The anniversary: same month and day, February 29 clamped to the
# 28th when the target year cannot hold it.
fn add_years(k: int, n: int) -> int {
    let y: int = year_of(k) + n
    let m: int = month_of(k)
    let mut d: int = day_of(k)
    if d > days_in_month(y, m) {
        d = days_in_month(y, m)
    }
    return date_key(y, m, d)
}

# ----------------------------------------------------------------------
# The phase machine. The horizons: base + 3 years (full support) and
# base + 5 years (security support). The horizon day itself belongs
# to the phase it closes.
# ----------------------------------------------------------------------
fn phase_of(base: int, at: int) -> int {
    let bug_fix_until: int = add_years(base, 3)
    let security_until: int = add_years(base, 5)
    if at <= bug_fix_until {
        return phase_active()
    }
    if at <= security_until {
        return phase_security()
    }
    return phase_eol()
}

# ----------------------------------------------------------------------
# The marking law. A `Security: <reason>` line in the message: the
# name case-insensitive, the first such line decides, an empty value
# is not a marking. A line is a line wherever it stands — but it
# must BE the line: leading whitespace is allowed, a word in front
# of the name is not.
# ----------------------------------------------------------------------
fn to_lower(s: str) -> str {
    let n: int = s.len()
    let mut out: str = ""
    let mut i: int = 0
    while i < n {
        let b: int = s.byte_at(i)
        if b >= 65 && b <= 90 {
            out = out + chr(b + 32)
        } else {
            out = out + s.slice(i, i + 1)
        }
        i = i + 1
    }
    return out
}

fn strip_spaces(s: str) -> str {
    let n: int = s.len()
    let mut i: int = 0
    let mut j: int = n
    let mut go: bool = true
    while go {
        go = false
        if i < j {
            if s.slice(i, i + 1) == " " {
                i = i + 1
                go = true
            }
        }
    }
    go = true
    while go {
        go = false
        if j > i {
            if s.slice(j - 1, j) == " " {
                j = j - 1
                go = true
            }
        }
    }
    return s.slice(i, j)
}

fn line_is_security(line: str) -> bool {
    return to_lower(line).starts_with("security:")
}

# The value after the colon, spaces trimmed. The caller has already
# confirmed the line carries the trailer name (which is 9 letters
# and the colon, so the value starts at index 9).
fn security_value_of(line: str) -> str {
    return strip_spaces(line.slice(9, line.len()))
}

# The first Security line decides, wherever it stands; an empty value
# is no claim.
fn security_value(msg: str) -> str {
    let n: int = msg.len()
    let mut i: int = 0
    let mut cur: str = ""
    while i < n {
        let c: str = msg.slice(i, i + 1)
        if c == "\n" {
            let line: str = strip_spaces(cur)
            if line_is_security(line) {
                return security_value_of(line)
            }
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    let last: str = strip_spaces(cur)
    if line_is_security(last) {
        return security_value_of(last)
    }
    return ""
}

# ----------------------------------------------------------------------
# The admission law. The window decides whether a fix may land;
# the class law (Stage 132) has already said WHAT the fix is.
# ----------------------------------------------------------------------
fn fix_may_land(phase: int, marked: bool) -> bool {
    if phase == phase_eol() {
        return false
    }
    if phase == phase_security() {
        return marked
    }
    return true
}

# The release law: a release cut in the security phase carries at
# least one marked backport since the previous tag.
fn release_may_cut(phase: int, marked_backports: int) -> bool {
    if phase == phase_eol() {
        return false
    }
    if phase == phase_security() {
        return marked_backports > 0
    }
    return true
}

# ----------------------------------------------------------------------
# The test sections. Each returns 0 when its laws hold.
# ----------------------------------------------------------------------
fn test_calendar() -> int {
    # The leap-year grammar.
    if !is_leap(2000) {
        return 1
    }
    if is_leap(1900) {
        return 2
    }
    if !is_leap(2024) {
        return 3
    }
    if is_leap(2023) {
        return 4
    }
    # Month lengths.
    if days_in_month(2023, 2) != 28 {
        return 5
    }
    if days_in_month(2024, 2) != 29 {
        return 6
    }
    if days_in_month(2023, 4) != 30 {
        return 7
    }
    if days_in_month(2023, 12) != 31 {
        return 8
    }
    # The plain anniversary.
    if add_years(date_key(2020, 6, 15), 3) != date_key(2023, 6, 15) {
        return 9
    }
    if add_years(date_key(2021, 1, 31), 5) != date_key(2026, 1, 31) {
        return 10
    }
    # The February-29 clamp: the anniversary lands on a day that
    # exists, never on March 1st.
    if add_years(date_key(2020, 2, 29), 3) != date_key(2023, 2, 28) {
        return 11
    }
    if add_years(date_key(2020, 2, 29), 5) != date_key(2025, 2, 28) {
        return 12
    }
    if add_years(date_key(2024, 2, 29), 3) != date_key(2027, 2, 28) {
        return 13
    }
    if add_years(date_key(2024, 2, 29), 5) != date_key(2029, 2, 28) {
        return 14
    }
    # A February-29 base into a leap target keeps the day.
    if add_years(date_key(2020, 2, 29), 4) != date_key(2024, 2, 29) {
        return 15
    }
    return 0
}

fn test_phase_machine() -> int {
    let base: int = date_key(2020, 6, 15)
    # The day before and the day of the third anniversary: still
    # active — the horizon day belongs to the phase it closes.
    if phase_of(base, date_key(2023, 6, 14)) != phase_active() {
        return 1
    }
    if phase_of(base, date_key(2023, 6, 15)) != phase_active() {
        return 2
    }
    # The day after: security-only.
    if phase_of(base, date_key(2023, 6, 16)) != phase_security() {
        return 3
    }
    # The fifth birthday is the last supported day.
    if phase_of(base, date_key(2025, 6, 15)) != phase_security() {
        return 4
    }
    if phase_of(base, date_key(2025, 6, 16)) != phase_eol() {
        return 5
    }
    # The base day itself, and deep inside the window.
    if phase_of(base, base) != phase_active() {
        return 6
    }
    if phase_of(base, date_key(2022, 1, 1)) != phase_active() {
        return 7
    }
    # A clamped horizon runs the same machine: a line born on
    # February 29 ends its phases on February 28.
    let leap: int = date_key(2024, 2, 29)
    if phase_of(leap, date_key(2027, 2, 28)) != phase_active() {
        return 8
    }
    if phase_of(leap, date_key(2027, 3, 1)) != phase_security() {
        return 9
    }
    if phase_of(leap, date_key(2029, 2, 28)) != phase_security() {
        return 10
    }
    if phase_of(leap, date_key(2029, 3, 1)) != phase_eol() {
        return 11
    }
    return 0
}

fn test_marking_law() -> int {
    # The marked fix, canonical shape.
    if security_value("fix: the taint escape\n\n"
    + "Security: CVE-2027-1234") != "CVE-2027-1234" {
        return 1
    }
    # The name is case-insensitive, the value is trimmed, and a
    # line is a line wherever it stands — leading whitespace is
    # allowed, a word in front of the name is not.
    if security_value("security: high") != "high" {
        return 2
    }
    if security_value("  SECURITY:   spaced   ") != "spaced" {
        return 3
    }
    if security_value("fix: x\nSecurity: mid-message\nmore prose")
    != "mid-message" {
        return 4
    }
    if security_value("notes: the Security: docs say") != "" {
        return 5
    }
    # An empty value is not a marking — fail-closed.
    if security_value("fix: x\n\nSecurity:") != "" {
        return 6
    }
    if security_value("fix: x\n\nSecurity:    ") != "" {
        return 7
    }
    # The FIRST such line decides, even when it is empty.
    if security_value("Security:\nsecurity: the real one") != "" {
        return 8
    }
    # No trailer, no claim.
    if security_value("fix: plain bug fix") != "" {
        return 9
    }
    if security_value("") != "" {
        return 10
    }
    # A word that merely contains the name is not the name.
    if security_value("notsecurity: nope") != "" {
        return 11
    }
    if security_value("security-critical: nope") != "" {
        return 12
    }
    return 0
}

fn test_admission_law() -> int {
    # The active phase takes any fix.
    if !fix_may_land(phase_active(), false) {
        return 1
    }
    if !fix_may_land(phase_active(), true) {
        return 2
    }
    # The security phase takes only marked fixes.
    if fix_may_land(phase_security(), false) {
        return 3
    }
    if !fix_may_land(phase_security(), true) {
        return 4
    }
    # A dead line takes nothing — not even a marked fix.
    if fix_may_land(phase_eol(), false) {
        return 5
    }
    if fix_may_land(phase_eol(), true) {
        return 6
    }
    # The release law: chore-only releases are refused in the
    # security phase; a marked backport cuts green; the active
    # phase cuts with whatever it carries.
    if release_may_cut(phase_security(), 0) {
        return 7
    }
    if !release_may_cut(phase_security(), 1) {
        return 8
    }
    if !release_may_cut(phase_active(), 0) {
        return 9
    }
    if release_may_cut(phase_eol(), 2) {
        return 10
    }
    return 0
}

fn main() -> int uses IO {
    println("stage 145: hls-lts windows")
    let mut r: int = test_calendar()
    if r != 0 {
        return 10 + r
    }
    r = test_phase_machine()
    if r != 0 {
        return 20 + r
    }
    r = test_marking_law()
    if r != 0 {
        return 30 + r
    }
    r = test_admission_law()
    if r != 0 {
        return 40 + r
    }
    println("  LTS windows OK: calendar, phases, marking, admission")
    return 0
}
