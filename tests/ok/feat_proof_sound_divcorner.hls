# feat_proof_sound_divcorner.hls — Stage-17 perfection (deep-scan-10)
# soundness regression: an UNBOUNDED-below dividend may BE INT64_MIN —
# the INT64_MIN / -1 overflow corner must not be proven away. Both
# implementations must panic identically (101).
fn f(x: int, y: int) -> int
    requires y < 0
{
    return x / y
}
fn main() -> int {
    return f(-9223372036854775808, -1)
}
