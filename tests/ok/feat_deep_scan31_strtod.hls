# ============================================================================
# feat_deep_scan31_strtod.hls — regression: decimal and exponent parsing.
# ----------------------------------------------------------------------------
# The no-libc strtod once applied the decimal exponent backwards (dividing
# where it should multiply), so "2.5" parsed as 250.0 and "1e3" as 0.001 in
# --no-libc builds. This locks the str→float contract for the hosted path;
# the no-libc twin is exercised by the fixed-point chain (bootstrap-nolibc
# compiles the compiler itself with --no-libc, where float parsing runs on
# the corrected hl_nl_strtod).
# ============================================================================

fn main() -> int uses IO {
    if "2.5".to_float() != 2.5 {
        panic("to_float: \"2.5\" must parse as 2.5")
    }
    if "1e3".to_float() != 1000.0 {
        panic("to_float: \"1e3\" must parse as 1000.0")
    }
    if "0.125".to_float() != 0.125 {
        panic("to_float: \"0.125\" must parse as 0.125")
    }
    if "-4.75".to_float() != -4.75 {
        panic("to_float: \"-4.75\" must parse as -4.75")
    }
    if "2.5e-2".to_float() != 0.025 {
        panic("to_float: \"2.5e-2\" must parse as 0.025")
    }
    if "3.0".to_float() != 3.0 {
        panic("to_float: \"3.0\" must parse as 3.0")
    }
    println("to_float decimals and exponents ok")
    return 0
}
