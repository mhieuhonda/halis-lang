# tests/ok/feat_stage73_jsffi_callback.hls — Stage 73
# (v0.92.0-alpha): std.jsffi_callback — the JS->HLS callback
# bookkeeping module (the native/C-backend companion of the wasm32
# extern "js" surface; the callback MECHANISM itself lives in the
# wasm backend — see tools/hlwasm.py + tools/jsffi_check.js and
# examples/jsffi_stage73_demo.hls, exercised by make
# jsffi-acceptance in Node.js).
#
# Exercises (pure HLS, differential interpreter == native):
#   - JsffiCallback rows (jsffi_callback_new)
#   - jsffi_callback_find (by name) + jsffi_callback_by_id
#   - jsffi_callback_describe (one line per row)
#   - an empty table
#   - the dispatch PATTERN itself: a jsffi_on_callback-style handler
#     driven by cb_id over JSON strings (concatenation only — the
#     same subset the wasm demo uses), proving the bookkeeping ids
#     line up with the handler's if/else chain

import "std.jsffi_callback"
import "std.str"
import "std.option"
import "std.result"

fn ok(actual: bool, msg: str) -> void uses IO {
    if !actual {
        panic("FAIL " + msg)
    }
}

fn eq_int(actual: int, expected: int, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_str(actual: str, expected: str, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected '" + expected + "', got '" + actual + "'")
    }
}

# A dispatch handler in the jsffi_on_callback shape: cb_id -> work.
# (The real wasm entry point has this exact signature; here it is
# driven directly to keep the test native-runnable.)
fn demo_dispatch(cb_id: int, arg: str) -> str {
    if cb_id == 1 {
        return "{\"received\":true,\"cb\":1,\"echo\":" + arg + "}"
    }
    if cb_id == 2 {
        return "pong"
    }
    return "{}"
}

fn test_table() -> int uses IO {
    let table: list[JsffiCallback] = []
    table.push(jsffi_callback_new(1, "echo",
        "receives {..}; returns {received:true, echo:{..}}"))
    table.push(jsffi_callback_new(2, "ping",
        "receives any string containing 'ping'; returns 'pong'"))
    table.push(jsffi_callback_new(99, "internal",
        "reserved; returns {}"))
    eq_int(table.len(), 3, "row count")
    eq_str(table.get(0).name, "echo", "row 0 name")
    eq_int(table.get(1).cb_id, 2, "row 1 cb_id")
    eq_str(table.get(2).protocol, "reserved; returns {}", "row 2 protocol")
    # Lookup by name / by id.
    eq_int(jsffi_callback_find(table, "echo"), 0, "find echo")
    eq_int(jsffi_callback_find(table, "ping"), 1, "find ping")
    eq_int(jsffi_callback_find(table, "nope"), -1, "find missing")
    eq_int(jsffi_callback_by_id(table, 99), 2, "by id 99")
    eq_int(jsffi_callback_by_id(table, 7), -1, "by id missing")
    # Describe renders one line per row.
    let text: str = jsffi_callback_describe(table)
    eq_str(text,
        "cb_id 1 (echo): receives {..}; returns {received:true, echo:{..}}\n"
        + "cb_id 2 (ping): receives any string containing 'ping'; returns 'pong'\n"
        + "cb_id 99 (internal): reserved; returns {}",
        "describe output")
    # The empty table renders as an empty string.
    let empty: list[JsffiCallback] = []
    eq_str(jsffi_callback_describe(empty), "", "empty table")
    return 0
}

fn test_dispatch_pattern() -> int uses IO {
    # The bookkeeping ids line up with the handler's if/else chain.
    let table: list[JsffiCallback] = []
    table.push(jsffi_callback_new(1, "echo", "envelope"))
    table.push(jsffi_callback_new(2, "ping", "pong"))
    let payload: str = "{\"cmd\":\"echo\",\"msg\":\"hi\"}"
    let out1: str = demo_dispatch(1, payload)
    eq_str(out1, "{\"received\":true,\"cb\":1,\"echo\":" + payload + "}",
        "echo dispatch")
    let out2: str = demo_dispatch(2, "ping please")
    eq_str(out2, "pong", "ping dispatch")
    let out3: str = demo_dispatch(42, "anything")
    eq_str(out3, "{}", "unknown cb_id")
    # Every row in the table is handled (or intentionally reserved).
    let mut i: int = 0
    let mut handled: int = 0
    while i < table.len() {
        let row: JsffiCallback = table.get(i)
        let reply: str = demo_dispatch(row.cb_id, "probe")
        if reply != "{}" {
            handled = handled + 1
        }
        i = i + 1
    }
    eq_int(handled, 2, "both live rows dispatch")
    return 0
}

fn run_tests() -> int uses IO {
    let mut passed: int = 0
    let tests: list[str] = [
        "test_table",
        "test_dispatch_pattern"
    ]
    let mut i: int = 0
    while i < tests.len() {
        let name: str = tests.get(i)
        println("RUN  " + name)
        if name == "test_table" {
            let _r: int = test_table()
        } else if name == "test_dispatch_pattern" {
            let _r: int = test_dispatch_pattern()
        }
        println("PASS " + name)
        passed = passed + 1
        i = i + 1
    }
    println("")
    println("=== " + passed.to_str() + "/" + tests.len().to_str() + " tests PASSED ===")
    return 0
}

fn main() -> int uses IO {
    return run_tests()
}
