# feat_effects_pure — Stage 9-alpha: pure function (no uses clause) is statically
# guaranteed to have no side effects.
fn pure_sum_squares(n: int) -> int {
    # No `uses` clause => compiler guarantees purity.
    let mut s: int = 0
    let mut i: int = 0
    while i < n {
        s = s + i * i
        i = i + 1
    }
    return s
}

fn pure_str_join(xs: list[str]) -> str {
    # No `uses` clause => pure.
    if xs.len() == 0 {
        return ""
    }
    let mut out: str = xs.get(0)
    let mut i: int = 1
    while i < xs.len() {
        out = out + "," + xs.get(i)
        i = i + 1
    }
    return out
}

fn main() -> int uses IO {
    let n: int = pure_sum_squares(10)
    # 0 + 1 + 4 + 9 + 16 + 25 + 36 + 49 + 64 + 81 = 285
    if n != 285 {
        println("pure_sum_squares wrong: " + n.to_str())
        return 1
    }
    let xs: list[str] = ["a", "b", "c"]
    let joined: str = pure_str_join(xs)
    if joined != "a,b,c" {
        println("pure_str_join wrong: " + joined)
        return 1
    }
    println("pure functions verified")
    return 0
}
