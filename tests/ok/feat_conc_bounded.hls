# ============================================================================
# feat_conc_bounded.hls — Stage-16 perfection (v0.29.0-alpha): bounded
# channels with backpressure.
#
# A producer pushes 8 messages through a channel capped at 2: the send
# blocks while the channel is full, so the producer cannot run ahead by
# more than `cap` messages (backpressure). The consumer drains 8 and the
# task is joined. Single-consumer => FIFO order => deterministic output
# (differentially testable interpreter <-> native).
# ============================================================================

fn producer(ch: Chan[int], n: int) -> int uses Conc {
    let mut i: int = 0
    while i < n {
        # Blocks while the bounded channel holds cap=2 messages.
        ch.send(i)
        i = i + 1
    }
    return 0
}

fn main() -> int uses Conc, IO {
    let ch: Chan[int] = chan_new_bounded(2)
    let t: Task[int] = spawn(producer, clone(ch), 8)
    let mut total: int = 0
    let mut got: int = 0
    while got < 8 {
        total = total + ch.recv()
        got = got + 1
    }
    let rc: int = t.join()
    let len_after: int = ch.len()
    println("total=" + total.to_str() + " rc=" + rc.to_str()
            + " remaining=" + len_after.to_str())
    return 0
}
