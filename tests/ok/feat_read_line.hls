# ============================================================================
# feat_read_line.hls — Stage 10 release: read_line() taint source
# ----------------------------------------------------------------------------
# Verifies that:
#   1. read_line() returns a tainted[str] (third taint source after
#      tainted_args and read_file_tainted).
#   2. The result is rejected by sinks (must be sanitised first).
#   3. After sanitisation, the value can be safely printed.
#   4. The IO effect is required (declaring `pure` or `uses Fs` would
#      fail at check time).
#
# This is a differential test (Stage-0 vs native hlc). The test runner
# pipes "hello_world" into stdin (no spaces — sanitize_command rejects
# shell metacharacters including spaces).
# ============================================================================

import "std.sanitize"
import "std.taint"

fn main() -> int uses IO {
    # 1. read_line returns a tainted value. The IO effect is required.
    let line: tainted[str] = read_line()

    # 2. Pure queries work without untainting.
    let n: int = taint_check_len(line)
    println("len: " + n.to_str())

    # 3. Sanitise before passing to a sink. sanitize_command strips
    #    shell metacharacters; the test input "hello_world" has none.
    let cleaned: str = sanitize_command(line)
    println("echo: " + cleaned)

    return 0
}

