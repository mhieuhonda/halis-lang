# tests/ok/feat_stage58_config.hls — Stage 58 (v0.79.0-alpha): std.config.
#
# Exercises:
#   - ConfigSchema builder (config_schema_new + str/int/float/bool keys
#     with defaults + no_default variants + env override).
#   - impl ConfigSchema method twins (.str_key / .int_key / .float_key /
#     .bool_key / .str_key_no_default / .int_key_no_default / .env).
#   - TOML parser (toml_parse): tables, dotted-paths, key=value, strings,
#     ints, floats, bools, comments, multi-line strings, inline tables,
#     arrays, hex/oct/bin literals, inf/nan.
#   - JSON config (config_parse_file delegates to std.json for content
#     starting with '{').
#   - Layering: defaults < file < env (env overrides file overrides
#     defaults).
#   - Type coercion: str -> int, str -> float, str -> bool, int -> float,
#     int -> bool, float -> int, bool -> int.
#   - Dotted-path lookup (config_get_path, config_get_str/int/float/bool).
#   - config_has — does a path exist?
#   - config_set_str / _int / _float / _bool — mutate cfg in-place.
#   - config_serialize — render cfg as TOML (round-trip).
#   - config_describe — render schema as human-readable listing.
#   - config_load_file — read a file from disk (Fs effect).
#   - config_load — pure load (no Fs, but Proc for env).
#   - ConfigLoadError structure (layer / key / message).
#   - Env-var name derivation (PREFIX_KEY -> PREFIX_SECTION_KEY).
#   - Explicit env_name override.
#   - Coercion failures (invalid int / float / bool -> load error).
#
# The test uses synthetic file content + explicit env_set/env_unset so
# the output is fully reproducible and differential-safe
# (interpreter == native).

import "std.config"
import "std.str"
import "std.result"

# ============================================================================
# Helpers
# ============================================================================

fn ok(actual: bool, msg: str) -> void uses IO {
    if !actual {
        panic("FAIL " + msg)
    }
}

fn eq_int(actual: int, expected: int, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_str(actual: str, expected: str, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected '" + expected + "', got '" + actual + "'")
    }
}

fn eq_bool(actual: bool, expected: bool, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_float(actual: float, expected: float, msg: str) -> void uses IO {
    let mut diff: float = actual - expected
    if diff < 0.0 {
        diff = 0.0 - diff
    }
    if diff > 0.000001 {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn contains(haystack: str, needle: str) -> bool {
    return haystack.contains(needle)
}

# ============================================================================
# Test 1: TOML parser — basic key=value.
# ============================================================================

fn test_toml_basic() -> int uses IO {
    let toml: str = "name = \"myapp\"\nport = 8080\ndebug = true\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_basic: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "name", ""), "myapp", "toml_basic: name")
    eq_int(config_get_int(cfg, "port", 0), 8080, "toml_basic: port")
    eq_bool(config_get_bool(cfg, "debug", false), true, "toml_basic: debug")
    return 0
}

# ============================================================================
# Test 2: TOML parser — nested tables.
# ============================================================================

fn test_toml_nested() -> int uses IO {
    let toml: str = "[server]\nhost = \"0.0.0.0\"\nport = 9000\n\n[db]\nhost = \"db.local\"\nport = 5432\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_nested: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "server.host", ""), "0.0.0.0", "toml_nested: server.host")
    eq_int(config_get_int(cfg, "server.port", 0), 9000, "toml_nested: server.port")
    eq_str(config_get_str(cfg, "db.host", ""), "db.local", "toml_nested: db.host")
    eq_int(config_get_int(cfg, "db.port", 0), 5432, "toml_nested: db.port")
    return 0
}

# ============================================================================
# Test 3: TOML parser — dotted table headers.
# ============================================================================

fn test_toml_dotted_header() -> int uses IO {
    let toml: str = "[server.tls]\ncert = \"/etc/ssl/cert.pem\"\nkey = \"/etc/ssl/key.pem\"\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_dotted: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "server.tls.cert", ""), "/etc/ssl/cert.pem", "toml_dotted: cert")
    eq_str(config_get_str(cfg, "server.tls.key", ""), "/etc/ssl/key.pem", "toml_dotted: key")
    return 0
}

# ============================================================================
# Test 4: TOML parser — inline tables.
# ============================================================================

fn test_toml_inline_table() -> int uses IO {
    let toml: str = "point = {x = 1, y = 2}\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_inline: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_int(config_get_int(cfg, "point.x", 0), 1, "toml_inline: x")
    eq_int(config_get_int(cfg, "point.y", 0), 2, "toml_inline: y")
    return 0
}

# ============================================================================
# Test 5: TOML parser — arrays.
# ============================================================================

fn test_toml_array() -> int uses IO {
    let toml: str = "ports = [8080, 9090, 9091]\nhosts = [\"a.com\", \"b.com\"]\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_array: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    let ports: ConfigValue = config_get_path(cfg, "ports")
    ok(ports.kind == config_kind_array(), "toml_array: ports is array")
    eq_int(ports.array_items.len(), 3, "toml_array: 3 ports")
    eq_int(ports.array_items.get(0).int_val, 8080, "toml_array: ports[0]")
    eq_int(ports.array_items.get(1).int_val, 9090, "toml_array: ports[1]")
    eq_int(ports.array_items.get(2).int_val, 9091, "toml_array: ports[2]")
    let hosts: ConfigValue = config_get_path(cfg, "hosts")
    ok(hosts.kind == config_kind_array(), "toml_array: hosts is array")
    eq_int(hosts.array_items.len(), 2, "toml_array: 2 hosts")
    eq_str(hosts.array_items.get(0).str_val, "a.com", "toml_array: hosts[0]")
    eq_str(hosts.array_items.get(1).str_val, "b.com", "toml_array: hosts[1]")
    return 0
}

# ============================================================================
# Test 6: TOML parser — comments.
# ============================================================================

fn test_toml_comments() -> int uses IO {
    let toml: str = "# top comment\nname = \"myapp\"  # inline comment\n# another comment\nport = 8080\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_comments: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "name", ""), "myapp", "toml_comments: name")
    eq_int(config_get_int(cfg, "port", 0), 8080, "toml_comments: port")
    return 0
}

# ============================================================================
# Test 7: TOML parser — multi-line strings.
# ============================================================================

fn test_toml_multiline() -> int uses IO {
    let toml: str = "description = \"\"\"Line 1\nLine 2\nLine 3\"\"\"\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_multiline: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    let desc: str = config_get_str(cfg, "description", "")
    ok(desc.contains("Line 1"), "toml_multiline: contains Line 1")
    ok(desc.contains("Line 2"), "toml_multiline: contains Line 2")
    ok(desc.contains("Line 3"), "toml_multiline: contains Line 3")
    return 0
}

# ============================================================================
# Test 8: TOML parser — literal strings.
# ============================================================================

fn test_toml_literal_string() -> int uses IO {
    # Literal strings preserve backslashes verbatim. In HLS source,
    # '\\d' is a str of length 2 (backslash + d). We want the TOML
    # literal string '\d+\.' (6 chars: \, d, +, \, .).
    let toml: str = "regex = '\\d+\\.'\npath = 'C:\\Users\\test'\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_literal: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    # Literal strings preserve backslashes verbatim. The TOML literal
    # '\\d+\\.' (in HLS source, '\\d' = backslash+d) becomes the str
    # '\d+\.' (4 chars: \, d, +, \, .) — wait, '\d+\.' is 5 chars.
    # Let's just check the contents character-by-character.
    let regex_val: str = config_get_str(cfg, "regex", "")
    eq_int(regex_val.len(), 5, "toml_literal: regex is 5 chars (\\d+\\.)")
    ok(regex_val.contains("d"), "toml_literal: regex contains 'd'")
    ok(regex_val.contains("+"), "toml_literal: regex contains '+'")
    ok(regex_val.contains("."), "toml_literal: regex contains '.'")
    # Path with backslashes preserved.
    let path_val: str = config_get_str(cfg, "path", "")
    ok(path_val.contains("Users"), "toml_literal: path contains 'Users'")
    ok(path_val.contains("test"), "toml_literal: path contains 'test'")
    return 0
}

# ============================================================================
# Test 9: TOML parser — number literals (hex, oct, bin, underscores, floats).
# ============================================================================

fn test_toml_numbers() -> int uses IO {
    let toml: str = "hex = 0xFF\noct = 0o777\nbin = 0b1010\nunderscored = 1_000_000\nfloat = 3.14\nexp = 1.5e10\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_numbers: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_int(config_get_int(cfg, "hex", 0), 255, "toml_numbers: hex 0xFF")
    eq_int(config_get_int(cfg, "oct", 0), 511, "toml_numbers: oct 0o777")
    eq_int(config_get_int(cfg, "bin", 0), 10, "toml_numbers: bin 0b1010")
    eq_int(config_get_int(cfg, "underscored", 0), 1000000, "toml_numbers: 1_000_000")
    eq_float(config_get_float(cfg, "float", 0.0), 3.14, "toml_numbers: float 3.14")
    eq_float(config_get_float(cfg, "exp", 0.0), 1.5e10, "toml_numbers: exp 1.5e10")
    return 0
}

# ============================================================================
# Test 10: TOML parser — boolean literals.
# ============================================================================

fn test_toml_bools() -> int uses IO {
    let toml: str = "a = true\nb = false\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_bools: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_bool(config_get_bool(cfg, "a", false), true, "toml_bools: a=true")
    eq_bool(config_get_bool(cfg, "b", true), false, "toml_bools: b=false")
    return 0
}

# ============================================================================
# Test 11: TOML parser — quoted keys.
# ============================================================================

fn test_toml_quoted_keys() -> int uses IO {
    let toml: str = "\"my-key\" = 1\n'another.key' = 2\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    ok(result_is_ok(r), "toml_quoted: parse ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_int(config_get_int(cfg, "my-key", 0), 1, "toml_quoted: my-key")
    eq_int(config_get_int(cfg, "another.key", 0), 2, "toml_quoted: another.key")
    return 0
}

# ============================================================================
# Test 12: config_load — defaults layer.
# ============================================================================

fn test_defaults_layer() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "myapp", "app name")
        .int_key("port", 8080, "port")
        .bool_key("debug", false, "debug mode")
    # No file, no env.
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, "", "")
    ok(result_is_ok(r), "defaults: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "name", ""), "myapp", "defaults: name")
    eq_int(config_get_int(cfg, "port", 0), 8080, "defaults: port")
    eq_bool(config_get_bool(cfg, "debug", false), false, "defaults: debug")
    return 0
}

# ============================================================================
# Test 13: config_load — file overrides defaults.
# ============================================================================

fn test_file_layer() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "myapp", "app name")
        .int_key("port", 8080, "port")
        .bool_key("debug", false, "debug mode")
    let toml: str = "name = \"fromfile\"\nport = 9000\ndebug = true\n"
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, toml, "")
    ok(result_is_ok(r), "file: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "name", ""), "fromfile", "file: name overridden")
    eq_int(config_get_int(cfg, "port", 0), 9000, "file: port overridden")
    eq_bool(config_get_bool(cfg, "debug", false), true, "file: debug overridden")
    return 0
}

# ============================================================================
# Test 14: config_load — env overrides file.
# ============================================================================

fn test_env_layer() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "myapp", "app name")
        .int_key("port", 8080, "port")
    # Set env vars.
    env_set("MYAPP_NAME", "fromenv")
    env_set("MYAPP_PORT", "7777")
    # File also has values — env should win.
    let toml: str = "name = \"fromfile\"\nport = 9000\n"
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, toml, "MYAPP")
    env_unset("MYAPP_NAME")
    env_unset("MYAPP_PORT")
    ok(result_is_ok(r), "env: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "name", ""), "fromenv", "env: name from env")
    eq_int(config_get_int(cfg, "port", 0), 7777, "env: port from env")
    return 0
}

# ============================================================================
# Test 15: config_load — nested key env derivation.
# ============================================================================

fn test_env_nested() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .int_key("server.port", 8080, "port")
    env_set("MYAPP_SERVER_PORT", "12345")
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, "", "MYAPP")
    env_unset("MYAPP_SERVER_PORT")
    ok(result_is_ok(r), "env_nested: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_int(config_get_int(cfg, "server.port", 0), 12345, "env_nested: server.port from env")
    return 0
}

# ============================================================================
# Test 16: config_load — explicit env_name override.
# ============================================================================

fn test_env_explicit() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "default", "app name")
        .env("name", "APP_NAME")
    env_set("APP_NAME", "explicit")
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, "", "MYAPP")
    env_unset("APP_NAME")
    ok(result_is_ok(r), "env_explicit: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "name", ""), "explicit", "env_explicit: from APP_NAME")
    return 0
}

# ============================================================================
# Test 17: config_load — JSON config.
# ============================================================================

fn test_json_config() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "default", "app name")
        .int_key("port", 8080, "port")
        .float_key("timeout", 30.0, "timeout")
    let json: str = "{\"name\":\"fromjson\",\"port\":7777,\"timeout\":60.5}"
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, json, "")
    ok(result_is_ok(r), "json: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "name", ""), "fromjson", "json: name")
    eq_int(config_get_int(cfg, "port", 0), 7777, "json: port")
    eq_float(config_get_float(cfg, "timeout", 0.0), 60.5, "json: timeout")
    return 0
}

# ============================================================================
# Test 18: config_load — type coercion (str -> int / float / bool).
# ============================================================================

fn test_coercion() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .int_key("port", 8080, "port")
        .float_key("timeout", 30.0, "timeout")
        .bool_key("debug", false, "debug")
    # File has str values — should be coerced to the schema's types.
    let toml: str = "port = \"9000\"\ntimeout = \"60.5\"\ndebug = \"true\"\n"
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, toml, "")
    ok(result_is_ok(r), "coercion: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_int(config_get_int(cfg, "port", 0), 9000, "coercion: port str->int")
    eq_float(config_get_float(cfg, "timeout", 0.0), 60.5, "coercion: timeout str->float")
    eq_bool(config_get_bool(cfg, "debug", false), true, "coercion: debug str->bool")
    return 0
}

# ============================================================================
# Test 19: config_load — coercion failure (invalid int).
# ============================================================================

fn test_coercion_failure() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .int_key("port", 8080, "port")
    # File has a non-numeric str — should fail.
    let toml: str = "port = \"not_a_number\"\n"
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, toml, "")
    ok(result_is_err(r), "coercion_fail: load failed (as expected)")
    let e: ConfigLoadError = result_err_or(r, ConfigLoadError {layer:"",key:"",message:""})
    eq_str(e.layer, "file", "coercion_fail: layer=file")
    eq_str(e.key, "port", "coercion_fail: key=port")
    ok(contains(e.message, "invalid int"), "coercion_fail: message mentions 'invalid int'")
    return 0
}

# ============================================================================
# Test 20: config_load — env coercion failure.
# ============================================================================

fn test_env_coercion_failure() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .int_key("port", 8080, "port")
    env_set("MYAPP_PORT", "not_a_number")
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, "", "MYAPP")
    env_unset("MYAPP_PORT")
    ok(result_is_err(r), "env_coercion_fail: load failed (as expected)")
    let e: ConfigLoadError = result_err_or(r, ConfigLoadError {layer:"",key:"",message:""})
    eq_str(e.layer, "env", "env_coercion_fail: layer=env")
    eq_str(e.key, "port", "env_coercion_fail: key=port")
    ok(contains(e.message, "MYAPP_PORT"), "env_coercion_fail: message mentions env var")
    return 0
}

# ============================================================================
# Test 21: config_has — path existence check.
# ============================================================================

fn test_config_has() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "myapp", "app name")
        .int_key("server.port", 8080, "port")
    let toml: str = "[server]\nport = 9000\n"
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, toml, "")
    ok(result_is_ok(r), "has: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    ok(config_has(cfg, "name"), "has: name exists")
    ok(config_has(cfg, "server.port"), "has: server.port exists")
    ok(!config_has(cfg, "missing"), "has: missing key not exists")
    ok(!config_has(cfg, "server.host"), "has: server.host not in file (no default)")
    return 0
}

# ============================================================================
# Test 22: config_set_* — mutate cfg in-place (CLI overlay).
# ============================================================================

fn test_config_set() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "default", "app name")
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, "", "")
    ok(result_is_ok(r), "set: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    # Before.
    eq_str(config_get_str(cfg, "name", ""), "default", "set: name before")
    # Mutate.
    config_set_str(cfg, "name", "overridden")
    eq_str(config_get_str(cfg, "name", ""), "overridden", "set: name after set_str")
    # New path.
    config_set_int(cfg, "new.path", 42)
    eq_int(config_get_int(cfg, "new.path", 0), 42, "set: new.path after set_int")
    return 0
}

# ============================================================================
# Test 23: config_serialize — round-trip TOML.
# ============================================================================

fn test_serialize() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "myapp", "app name")
        .int_key("port", 8080, "port")
        .bool_key("debug", false, "debug")
    let toml: str = "name = \"myapp\"\nport = 8080\ndebug = false\n"
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, toml, "")
    ok(result_is_ok(r), "serialize: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    let out: str = config_serialize(cfg)
    ok(contains(out, "name = \"myapp\""), "serialize: name")
    ok(contains(out, "port = 8080"), "serialize: port")
    ok(contains(out, "debug = false"), "serialize: debug")
    return 0
}

# ============================================================================
# Test 24: config_serialize — nested tables.
# ============================================================================

fn test_serialize_nested() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("server.host", "localhost", "host")
        .int_key("server.port", 8080, "port")
    let toml: str = "[server]\nhost = \"0.0.0.0\"\nport = 9000\n"
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, toml, "")
    ok(result_is_ok(r), "serialize_nested: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    let out: str = config_serialize(cfg)
    ok(contains(out, "[server]"), "serialize_nested: [server] header")
    ok(contains(out, "host = \"0.0.0.0\""), "serialize_nested: host")
    ok(contains(out, "port = 9000"), "serialize_nested: port")
    return 0
}

# ============================================================================
# Test 25: config_describe — human-readable schema listing.
# ============================================================================

fn test_describe() -> int uses IO {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "myapp", "app name")
        .int_key("port", 8080, "port number")
        .str_key_no_default("secret", "secret key (required)")
    let desc: str = config_describe(schema)
    ok(contains(desc, "Config schema"), "describe: header")
    ok(contains(desc, "name : str"), "describe: name entry")
    ok(contains(desc, "[default: myapp]"), "describe: name default")
    ok(contains(desc, "port : int"), "describe: port entry")
    ok(contains(desc, "[default: 8080]"), "describe: port default")
    ok(contains(desc, "secret : str"), "describe: secret entry")
    ok(contains(desc, "(required)"), "describe: secret required")
    ok(contains(desc, "app name"), "describe: name desc")
    ok(contains(desc, "port number"), "describe: port desc")
    return 0
}

# ============================================================================
# Test 26: config_load_file — read a file from disk (Fs effect).
# ============================================================================

fn test_load_file() -> int uses IO, Fs, Proc {
    # Write a temp config file.
    write_file("/tmp/feat_stage58_test.toml", "name = \"fromfile\"\nport = 9999\n")
    # Load it.
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "default", "app name")
        .int_key("port", 8080, "port")
    let r: Result[ConfigValue, ConfigLoadError] = config_load_file(schema, "/tmp/feat_stage58_test.toml", "")
    ok(result_is_ok(r), "load_file: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "name", ""), "fromfile", "load_file: name")
    eq_int(config_get_int(cfg, "port", 0), 9999, "load_file: port")
    return 0
}

# ============================================================================
# Test 27: impl ConfigSchema method twins.
# ============================================================================

fn test_method_twins() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "default", "app name")
        .int_key("port", 8080, "port")
        .float_key("timeout", 30.0, "timeout")
        .bool_key("debug", false, "debug")
        .env("port", "APP_PORT")
    let desc: str = config_describe(schema)
    ok(contains(desc, "name : str"), "twins: str_key via .str_key")
    ok(contains(desc, "port : int"), "twins: int_key via .int_key")
    ok(contains(desc, "timeout : float"), "twins: float_key via .float_key")
    ok(contains(desc, "debug : bool"), "twins: bool_key via .bool_key")
    ok(contains(desc, "[env: APP_PORT]"), "twins: env via .env")
    return 0
}

# ============================================================================
# Test 28: builder immutability — config_schema_str returns a NEW schema.
# ============================================================================

fn test_builder_immutability() -> int uses IO {
    let s0: ConfigSchema = config_schema_new()
    let s1: ConfigSchema = config_schema_str(s0, "name", "default", "app name")
    # s0 has no entries.
    eq_int(s0.entries.len(), 0, "immut: s0 has 0 entries")
    # s1 has 1 entry.
    eq_int(s1.entries.len(), 1, "immut: s1 has 1 entry")
    return 0
}

# ============================================================================
# Test 29: no_default keys — required, not present in defaults.
# ============================================================================

fn test_no_default() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key_no_default("secret", "API secret")
    # No file, no env — secret should be missing.
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, "", "")
    ok(result_is_ok(r), "no_default: load ok (no error for missing required)")
    let cfg: ConfigValue = result_unwrap(r)
    ok(!config_has(cfg, "secret"), "no_default: secret not in cfg (no default)")
    # With file — secret should be present.
    let toml: str = "secret = \"mykey\"\n"
    let r2: Result[ConfigValue, ConfigLoadError] = config_load(schema, toml, "")
    ok(result_is_ok(r2), "no_default: load ok with file")
    let cfg2: ConfigValue = result_unwrap(r2)
    ok(config_has(cfg2, "secret"), "no_default: secret present from file")
    eq_str(config_get_str(cfg2, "secret", ""), "mykey", "no_default: secret value")
    return 0
}

# ============================================================================
# Test 30: empty file content — defaults only.
# ============================================================================

fn test_empty_file() -> int uses IO, Proc {
    let schema: ConfigSchema = config_schema_new()
        .str_key("name", "myapp", "app name")
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, "", "")
    ok(result_is_ok(r), "empty: load ok")
    let cfg: ConfigValue = result_unwrap(r)
    eq_str(config_get_str(cfg, "name", ""), "myapp", "empty: name from default")
    return 0
}

