# feat_deep_scan5_stdlib.hls — regression tests for the deep-scan-5
# stdlib fixes: base64 strict padding (valid inputs only here — the
# malformed ones panic and are covered by fail tests), URL port
# validation + empty query segments, CSV stray quotes, and the
# sanitize hardening (backslash paths / NUL in SQL strings / cmd.exe
# metacharacters). Differential: interpreter and native must agree.
import "std.base64"
import "std.csv"
import "std.url"
import "std.sanitize"

fn main() -> int uses IO {
    # base64 valid vectors (RFC 4648).
    println(base64_decode("Zm9vYmFy"))
    println(base64_decode("Zg=="))
    println(base64_decode("Zm8="))
    println(base64_decode(""))

    # URL: valid port + empty query segments skipped.
    let u: Url = url_parse("http://host:8080/p?a=1&&b=2#frag")
    println("port=" + u.port.to_str())
    let q: map[str, str] = url_query_parse("&a=1&&b=2")
    println("qkeys=" + q.keys().len().to_str())
    println("qa=" + q.get_or("a", "?"))

    # CSV: stray quote mid-field is a literal; real quoted fields work.
    let rows: list[list[str]] = csv_parse_default("ab\"cd,e\n\"x,y\",z\n")
    println("r0=" + rows.get(0).get(0) + "|" + rows.get(0).get(1))
    println("r1=" + rows.get(1).get(0) + "|" + rows.get(1).get(1))

    # sanitize: valid inputs still pass.
    println(sanitize_path(taint_mark("a/b/c.txt")))
    println(sanitize_command(taint_mark("plain-arg_1.txt")))
    println(sanitize_sql_string(taint_mark("it''s")))
    return 0
}
