# Deep-scan-12 regression: hllint L007 now detects dead code after
# an if-then-else where BOTH branches return (DSS-T-11). Previously
# L007 only flagged statements after a top-level `return`, missing
# the common pattern of `if cond { return X } else { return Y }`
# followed by more statements (which are unreachable).

fn classify(n: int) -> int uses IO {
    if n < 0 {
        return -1
    } else {
        return 1
    }
    # This statement is UNREACHABLE — both branches of the if above
    # return. L007 should flag it.
    println("this should be unreachable")
    return 0
}

fn main() -> int uses IO {
    let r: int = classify(5)
    println("classify(5)=" + r.to_str())
    let r2: int = classify(-5)
    println("classify(-5)=" + r2.to_str())
    return 0
}
