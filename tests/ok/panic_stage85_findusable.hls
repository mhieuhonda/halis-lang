# Expect: exit 101, panic "mem_find_usable: min_len must be positive"
# mem_find_usable is the call a page allocator makes on day one, so a
# zero-size request is a programming error: answering "the first
# region" would hand out memory the caller never asked for.
import "core.boot"

fn main() -> int {
    let mut rs: list[MemRegion] = []
    rs.push(mem_region_new(4096, 65536, MemKind.Usable))
    if mem_find_usable(rs, 0, 4096) != 4096 {
        return 1
    }
    return 0
}
