# feat_stage19_pgo.hls — Stage 19 (v0.35.0-alpha) acceptance demo.
#
# Exercises the three PGO machinery pieces in ONE deterministic program:
#   1. --pgo-generate: profile counters at every fn entry, branch and
#      loop back-edge; a .hlcprof file is written at process exit.
#   2. --pgo-use=<profile>: the recompile emits __builtin_expect hints
#      for biased branches, hot/cold function attributes, static-inline
#      hints and hoisted string literals in hot functions.
#   3. The trained binary produces BYTE-IDENTICAL output (semantics are
#      unaffected — PGO only changes layout, never meaning).
#
# The differential suite (interpreter <-> native) covers the unflagged
# build; run_tests.sh's Stage 19 section additionally compiles this file
# with --pgo-generate and --pgo-use and compares all three outputs.

fn classify(n: int) -> str {
    # Deliberately biased branches: most inputs are even and positive.
    if n % 2 == 0 {
        if n > 0 {
            return "even-positive"
        }
        return "even-nonpositive"
    }
    if n > 0 {
        return "odd-positive"
    }
    return "odd-nonpositive"
}

fn sum_upto(n: int) -> int {
    # A hot loop: under --pgo-generate the back-edge counter records the
    # iteration count; under --pgo-use the loop condition is
    # __builtin_expect-hinted (loops that iterate -> expect 1).
    let mut total: int = 0
    let mut i: int = 0
    while i < n {
        total = total + i
        i = i + 1
    }
    return total
}

fn main() -> int uses IO {
    # Loop over a range + branch dispatch -> both profile site kinds.
    let mut counts: map[str, int] = map_new()
    for i: int in range(0, 12) {
        let c: str = classify(i)
        counts.set(c, counts.get_or(c, 0) + 1)
    }
    let keys: list[str] = counts.keys()
    let mut i: int = 0
    while i < keys.len() {
        println("classify: " + keys.get(i) + " = " + counts.get_or(keys.get(i), 0).to_str())
        i = i + 1
    }
    println("sum_upto(1000) = " + sum_upto(1000).to_str())
    println("join builtin: " + join(["a", "b", "c"], "+"))
    return 0
}
