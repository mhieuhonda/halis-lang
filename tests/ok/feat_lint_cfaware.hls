# Test: hllint L005 control-flow-aware rule (Stage 14 release).
#
# Stage 14 release: hllint now tracks control flow — it only warns on
# an `option_unwrap(x)` / `result_unwrap(x)` when there has been no
# `is_some(x)` / `is_ok(x)` check in the same block (or in the
# `if`-then branch leading up to it). This file exercises both cases.
#
# Program output is just "OK" — the test runner checks that the
# program compiles and runs cleanly (it's a valid HLS program; the
# lint warnings are checked separately by tests/lint_smoke.sh).

import "std.option"
import "std.result"

# CASE 1: unsafe unwrap (no prior check) — should warn L005.
fn unsafe_unwrap(x: int) -> int uses IO {
    let r: Result[int, int] = Result.Ok(x)
    return result_unwrap(r)
}

# CASE 2: safe unwrap (prior is_ok in same block) — should NOT warn.
fn safe_unwrap(x: int) -> int uses IO {
    let r: Result[int, int] = Result.Ok(x)
    if result_is_ok(r) {
        return result_unwrap(r)
    }
    return 0
}

# CASE 3: safe unwrap (if-is_some-then unwrap pattern).
fn safe_unwrap_option(x: int) -> int uses IO {
    let o: Option[int] = Option.Some(x)
    if option_is_some(o) {
        return option_unwrap(o)
    }
    return 0
}

# CASE 4: unsafe unwrap in while body (no prior check in same block).
fn unsafe_in_loop(x: int) -> int uses IO {
    let r: Result[int, int] = Result.Ok(x)
    while x > 0 {
        return result_unwrap(r)
    }
    return 0
}

# CASE 5: unwrap on a Result literal, not an identifier — should NOT warn
# (we can't track whether a literal is checked).
fn unwrap_literal() -> int uses IO {
    let r: Result[int, int] = Result.Ok(42)
    return result_unwrap(r)
}

fn main() -> void uses IO {
    println("OK")
}
