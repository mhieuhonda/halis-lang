# Deep-scan-15 regression: std/quickcheck.hls qc_int_range overflow
# on wide ranges. The previous implementation computed `hi - lo + 1`
# unconditionally, which overflows int64 (Halis panics) when the span
# exceeds INT64_MAX values — the canonical case is
#   qc_int_range(0, INT64_MAX)
# which is a one-line panic.
#
# The new implementation detects the would-overflow case before the
# subtraction (by examining signs and using `INT64_MAX - hi` instead)
# and falls back to a full-range draw via the qc_int path.
#
# Acceptance: qc_int_range() with wide-range bounds no longer panics
# and produces a value inside [lo, hi]. The differential test (interp
# vs native) catches any divergence — the function uses rand_int,
# which is deterministic under rand_seed, so both paths agree.

import "std.quickcheck"
import "std.bits"

fn main() -> int uses IO, Rand {
    # Seed for determinism (the rand sequence is the same in interp and native).
    rand_seed(42)

    # Wide range that previously panicked: [0, INT64_MAX].
    let mx: int = 9223372036854775807
    let a: int = qc_int_range(0, mx)
    println("qc_int_range(0, INT64_MAX)=" + a.to_str())
    if a < 0 || a > mx {
        println("FAIL: result outside [0, INT64_MAX]")
        return 1
    }

    # The other wide-range case: [INT64_MIN, INT64_MAX].
    let mn: int = -9223372036854775808
    let b: int = qc_int_range(mn, mx)
    println("qc_int_range(INT64_MIN, INT64_MAX)=" + b.to_str())
    if b < mn || b > mx {
        println("FAIL: result outside [INT64_MIN, INT64_MAX]")
        return 1
    }

    # Small range — the original formula path. Both endpoints
    # inclusive: qc_int_range(0, 9) may return 0 or 9.
    let mut seen0: bool = false
    let mut seen9: bool = false
    let mut k: int = 0
    while k < 1000 {
        let x: int = qc_int_range(0, 9)
        if x < 0 || x > 9 {
            println("FAIL: small-range result out of bounds: " + x.to_str())
            return 1
        }
        if x == 0 { seen0 = true }
        if x == 9 { seen9 = true }
        k = k + 1
    }
    println("qc_int_range(0, 9): saw 0=" + seen0.to_str() + " saw 9=" + seen9.to_str())

    # Empty range (lo > hi) — the contract is "return lo".
    let empty: int = qc_int_range(10, 5)
    println("qc_int_range(10, 5)=" + empty.to_str())
    if empty != 10 {
        println("FAIL: empty range should return lo")
        return 1
    }

    println("deep-scan-15 qc_int_range: OK")
    return 0
}
