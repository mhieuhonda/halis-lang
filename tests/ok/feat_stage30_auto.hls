# feat_stage30_auto.hls — Stage 30 (v0.47.0-alpha): automatic (un-
# annotated) escape analysis. Non-escaping list[primitive] bindings
# silently pick the stack layout; escaping ones silently fall back to
# the heap. #[boxed] opts out explicitly. Observable behaviour is
# identical on both layouts (the differential suite proves it).
fn poly_eval(x: int) -> int {
    # escape-free: index reads + .len only -> stack (auto)
    let coeffs: list[int] = [3, 2, 1]
    let mut acc: int = 0
    let mut i: int = 0
    while i < coeffs.len() {
        acc = acc * x + coeffs[i]
        i = i + 1
    }
    return acc
}

fn make_table(n: int) -> list[int] {
    # escapes via return -> heap (auto fallback)
    let mut xs: list[int] = [0, 1, 2]
    xs.set(0, n)
    return xs
}

fn boxed_opt_out() -> int {
    # escape-free, but pinned to the heap layout by #[boxed]
    #[boxed]
    let xs: list[int] = [10, 20, 30]
    let mut t: int = 0
    for v: int in xs {
        t = t + v
    }
    return t
}

fn float_auto() -> str {
    let parts: list[float] = [0.25, 0.5, 0.25]
    let mut total: float = 0.0
    for p: float in parts {
        total = total + p
    }
    return total.to_str()
}

fn main() -> int uses IO {
    println("poly_eval(5) = " + poly_eval(5).to_str())
    let table: list[int] = make_table(42)
    println("table = " + table.get(0).to_str() + " len " + table.len().to_str())
    println("boxed_opt_out = " + boxed_opt_out().to_str())
    println("float_auto = " + float_auto())
    return 0
}
