# feat_stage111_cap_struct.hls — Stage 111 (v0.130.0-alpha).
# Capabilities are ordinary values: they can live in struct fields and
# travel with the data. Two rules the demo pins down:
#   1. a Cap field is plumbing — it does NOT confer authority by itself
#      (act() also takes the token as a direct parameter, which is what
#      its body is granted against);
#   2. cap_effect_name reads the token's static identity back out.
# A struct containing a Cap cannot be cloned (authority duplication) —
# that rule is fail_stage111_cap_clone_struct's subject.

struct Conn {
    target: str,
    auth: Cap[Net]
}

fn act(conn: Conn, c: Cap[Net]) -> str {
    return net_lookup(conn.target)
}

fn main() -> int {
    let io: Cap[IO] = cap_take("IO")
    let net: Cap[Net] = cap_take("Net")
    let conn: Conn = Conn { target: "localhost", auth: net }
    println("token: " + cap_effect_name(conn.auth))
    let ip: str = act(conn, net)
    println("localhost -> " + ip)
    return 0
}
