# Deep-scan-15 regression: std/html.hls html_tag XSS hardening.
#
# The previous implementation escaped attribute VALUES but interpolated
# the attribute KEY and the tag NAME verbatim. A user-controlled key
# like `onmouseover="alert(1)"` would appear in the output verbatim,
# producing valid HTML with an injected event handler. The same
# applies to the tag NAME (e.g. `script`, `img onerror=...`).
#
# The new implementation validates both against a strict allow-list:
# identifiers must match `[A-Za-z][A-Za-z0-9_-]*` so no whitespace,
# quote, equals, or angle bracket can sneak in.
#
# These tests are in tests/fail/ because html_tag now PANICS on
# invalid names — confirming the XSS guard fires.

import "std.html"

fn main() -> int uses IO {
    # Injection attempt via tag name: `<script>alert(1)</script>` has
    # a space in it, so _html_validate_name rejects the tag.
    let attrs: map[str, str] = map_new()
    let s: str = html_tag("script>alert(1)//", attrs, "")
    println("injected: " + s)
    return 0
}
