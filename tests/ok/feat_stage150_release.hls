# feat_stage150_release.hls — Stage 150 (v1.0.0): the LTS release,
# the road kept.
#
# What this fixture pins is what a v1.0.0 IS — the laws the release
# day ran on while the whole road watched:
#
#   1. the order      — the release day is an ordered machine: the
#      law               eve holds, the markers move, the tag is cut,
#                        the line opens, the kit retires, the witness
#                        reads. A step runs when its predecessor is
#                        done; the one idempotent step is the line
#                        init (declaring the SAME line again is a
#                        no-op, not noise);
#   2. the hand-off   — the boundary between the kits is exactly one
#      law               artifact: the v1.0.0 tag. The last
#                        candidate's successor and the line's base
#                        are the same release; before it the RC kit
#                        answers, after it the LTS kit does, and the
#                        two never answer together;
#   3. the retirement — a retired kit refuses, NAMED (exit 1) — it
#      law               does not pretend (0), does not crash (101).
#                        Readiness after the release names TWO laws:
#                        the roadmap law (every stage ticked —
#                        nothing left to candidate for) and the lts
#                        law (a line is declared — a candidate opens
#                        none);
#   4. the window     — the clock the line opens, counted in
#      law               anniversaries of the base day: bug fixes
#                        through the third, security through the
#                        fifth, nothing after — the horizon day
#                        belongs to the phase it closes, and a
#                        February 29 birthday clamps to the 28th
#                        when the target year is not leap;
#   5. the marker     — the version is one voice in three mouths:
#      law               the changelog heading, the snapshot
#                        manifest, the editor manifest. They agree,
#                        or the tree refuses to speak of a release
#                        at all;
#   6. the line law   — one declaration per repository: a
#                        pre-release is not a base, a pre-1.0 tag is
#                        not a line, a tag that does not exist opens
#                        nothing, the same declaration again is
#                        idempotent, a different base is a new
#                        policy decision — refused, not merged.
#
# The exit-code classes are the C runtime's own: 0 the law held, 1 a
# named refusal, 2 a usage error, 101 a runtime panic. The
# interpreter and the native binary agree on every class.
#
# The program exits 0 when every law holds, 10+section*10+case
# otherwise.

# ----------------------------------------------------------------------
# The order law: the release day's steps, in the only order they
# work. Step ids: 0 the eve (the last candidate anchored), 1 the
# markers move (the release docs), 2 the tag is cut, 3 the LTS line
# opens, 4 the RC kit retires, 5 the witness reads the clock.
# ----------------------------------------------------------------------
fn step_name(step: int) -> str {
    if step == 0 {
        return "eve"
    }
    if step == 1 {
        return "docs"
    }
    if step == 2 {
        return "tag"
    }
    if step == 3 {
        return "line"
    }
    if step == 4 {
        return "retired"
    }
    if step == 5 {
        return "witness"
    }
    return ""
}

# may_run(step, completed) — the machine's law: a step runs when its
# predecessor is done and itself is not yet. The one exception is
# the line init: declaring the SAME line again is an idempotent
# no-op (the tool says so and changes nothing), not a second step.
fn may_run(step: int, completed: int) -> bool {
    if step < 0 || step > 5 {
        return false
    }
    if step <= completed {
        return step == 3
    }
    return step == completed + 1
}

# the wrong orders, named: a tag before its markers, a line before
# its tag, a retirement before its line, a witness before all —
# each is a machine trying to run a step on a world its
# predecessor never built.
fn wrong_order(step: int, completed: int) -> bool {
    return step > completed + 1
}

# ----------------------------------------------------------------------
# The hand-off law: which kit answers, and when. The boundary is
# the v1.0.0 tag — before it the candidate line owns the road,
# after it the support line does. The two never answer together.
# ----------------------------------------------------------------------
fn answers(kit: str, line_open: bool) -> str {
    if kit == "rc" {
        if line_open {
            return "refused"
        }
        return "readiness gate report signoff"
    }
    if kit == "lts" {
        if line_open {
            return "status window backport tag-patch audit"
        }
        return "refused"
    }
    return ""
}

# The boundary artifact, named twice: the fourth candidate's
# successor and the 1.0 line's base are the SAME tag — one
# boundary, two kits, no gap.
fn successor_of(n: int) -> str {
    if n == 4 {
        return "v1.0.0"
    }
    if n >= 1 && n <= 3 {
        return "v1.0.0-rc." + (n + 1).to_str()
    }
    return ""
}

fn base_of_line(major: int, minor: int) -> str {
    return "v" + major.to_str() + "." + minor.to_str() + ".0"
}

# ----------------------------------------------------------------------
# The retirement law: a retired kit refuses, NAMED — the classes
# the refusal speaks (0 the law held, 1 a named refusal, 2 a usage
# error, 101 a runtime panic), and the two laws readiness names
# after the release.
# ----------------------------------------------------------------------
fn class_of_exit(code: int) -> str {
    if code == 0 {
        return "OK"
    }
    if code == 1 {
        return "REFUSAL"
    }
    if code == 2 {
        return "USAGE"
    }
    if code == 101 {
        return "PANIC"
    }
    return "UNKNOWN"
}

fn retired_voice(code: int, names_law: bool) -> str {
    if code == 1 && names_law {
        return "refused, named"
    }
    if code == 0 {
        return "pretends"
    }
    if code == 101 {
        return "crashes"
    }
    return "wrong"
}

# readiness after the release names BOTH laws that refuse it: the
# roadmap law (every stage ticked) and the lts law (a line is
# declared). One name is a half refusal — the retirement speaks
# two.
fn post_release_refusals(roadmap_done: bool, line_open: bool) -> int {
    let mut n: int = 0
    if roadmap_done {
        n = n + 1
    }
    if line_open {
        n = n + 1
    }
    return n
}

# ----------------------------------------------------------------------
# The window law: the clock the line opens. base + N years is the
# same month and day — an anniversary, not a count of days — and
# the horizon day belongs to the phase it closes: the third
# birthday is the last full-support day, the fifth the last
# supported one.
# ----------------------------------------------------------------------
fn is_leap(year: int) -> bool {
    if year % 400 == 0 {
        return true
    }
    if year % 100 == 0 {
        return false
    }
    return year % 4 == 0
}

# add_years — the calendar law: February 29 clamps to the 28th when
# the target year is not leap (a line born 2024-02-29 is bug-fixed
# through 2027-02-28). Every other month-day crosses the years
# unchanged.
fn add_years(year: int, month: int, day: int, n: int) -> str {
    let y: int = year + n
    let mut d: int = day
    if month == 2 && day == 29 && !is_leap(y) {
        d = 28
    }
    let mut m: str = month.to_str()
    if month < 10 {
        m = "0" + m
    }
    let mut dd: str = d.to_str()
    if d < 10 {
        dd = "0" + dd
    }
    return y.to_str() + "-" + m + "-" + dd
}

fn bug_fix_until(year: int, month: int, day: int) -> str {
    return add_years(year, month, day, 3)
}

fn security_until(year: int, month: int, day: int) -> str {
    return add_years(year, month, day, 5)
}

# phase_at(t) — t is whole years past the base day. The horizon
# itself belongs to the phase it closes: t == 3 is still active
# (the third birthday is the last full-support day), t == 5 still
# security (the fifth is the last supported day), the day after is
# the next phase.
fn phase_at(t: int) -> str {
    if t < 0 {
        return "before the line"
    }
    if t <= 3 {
        return "active"
    }
    if t <= 5 {
        return "security"
    }
    return "eol"
}

# lands_in_phase — what the line accepts: any BUGFIX backport and
# chores in active; SECURITY-marked fixes only in security; nothing
# at all in eol — a dead line takes no chores either.
fn lands_in_phase(phase: str, security_marked: bool) -> bool {
    if phase == "active" {
        return true
    }
    if phase == "security" {
        return security_marked
    }
    return false
}

# ----------------------------------------------------------------------
# The marker law: the version is one voice in three mouths. The
# changelog heading and the editor manifest speak it bare; the
# snapshot manifest wears the release `v` (the tag wears it, the
# heading does not). They agree, or the tree refuses to speak of a
# release at all.
# ----------------------------------------------------------------------
fn markers_agree(head: str, manifest: str, editor: str) -> bool {
    return manifest == "v" + head && editor == head
}

fn disagreeing_voices(head: str, manifest: str, editor: str) -> int {
    let mut n: int = 0
    if manifest != "v" + head {
        n = n + 1
    }
    if editor != head {
        n = n + 1
    }
    return n
}

# the voice the release speaks: 1.0.0 — the head version the whole
# line walked toward, rc.1 through rc.4.
fn release_voice() -> str {
    return "1.0.0"
}

# ----------------------------------------------------------------------
# The line law: one declaration per repository. The verdicts the
# tool speaks, in the order the wrong turns tried them: a
# pre-release is not a base, a pre-1.0 tag is not a line, a tag
# that does not exist opens nothing, the release declares, the
# same declaration again is idempotent, a different base is a new
# policy decision — refused, not merged.
# ----------------------------------------------------------------------
fn init_verdict(tag: str, tag_exists: bool, line_open: bool) -> str {
    if tag == "v1.0.0-rc.4" {
        return "refused: a pre-release is not an LTS base"
    }
    if tag == "v0.166.0" {
        return "refused: the policy begins at v1.0"
    }
    if tag == "v1.0.0" && !tag_exists {
        return "refused: the tag does not exist in the repository"
    }
    if line_open && tag != "v1.0.0" {
        return "refused: one declaration per repository"
    }
    if line_open && tag == "v1.0.0" {
        return "idempotent no-op"
    }
    if tag == "v1.0.0" {
        return "declared"
    }
    return "refused: not a semantic version at all"
}

# the declaration's shape: the branch is release/MAJOR.MINOR, the
# base is the tag itself, and the base sha is the commit the tag
# names — the line opens WHERE the release stands, not where the
# work went after.
fn line_branch(major: int, minor: int) -> str {
    return "release/" + major.to_str() + "." + minor.to_str()
}

# ======================================================================
# The batteries.
# ======================================================================

fn test_order() -> int {
    # the steps name themselves, in order
    if step_name(0) != "eve" {
        return 1
    }
    if step_name(1) != "docs" {
        return 2
    }
    if step_name(2) != "tag" {
        return 3
    }
    if step_name(3) != "line" {
        return 4
    }
    if step_name(4) != "retired" {
        return 5
    }
    if step_name(5) != "witness" {
        return 6
    }
    if step_name(6) != "" {
        return 7
    }
    # the machine walks forward one step at a time
    let mut done: int = -1
    let mut step: int = 0
    while step <= 5 {
        if !may_run(step, done) {
            return 10 + step
        }
        done = step
        step = step + 1
    }
    # the idempotent step: the line init re-runs, nothing else does
    if !may_run(3, 5) {
        return 20
    }
    if may_run(0, 5) {
        return 21
    }
    if may_run(1, 5) {
        return 22
    }
    if may_run(2, 5) {
        return 23
    }
    if may_run(4, 5) {
        return 24
    }
    if may_run(5, 5) {
        return 25
    }
    # the wrong orders are named, not guessed
    if !wrong_order(2, 0) {
        return 30
    }
    if !wrong_order(3, 1) {
        return 31
    }
    if !wrong_order(4, 2) {
        return 32
    }
    if !wrong_order(5, 3) {
        return 33
    }
    if wrong_order(1, 0) {
        return 34
    }
    if wrong_order(5, 4) {
        return 35
    }
    # outside the machine, no step runs at all
    if may_run(-1, 0) || may_run(6, 5) {
        return 40
    }
    return 0
}

fn test_handoff() -> int {
    # the boundary is one artifact, named by both kits
    if successor_of(4) != "v1.0.0" {
        return 1
    }
    if base_of_line(1, 0) != "v1.0.0" {
        return 2
    }
    if successor_of(4) != base_of_line(1, 0) {
        return 3
    }
    # the candidate chain walks rc.1..rc.4 and stops there
    if successor_of(1) != "v1.0.0-rc.2" {
        return 4
    }
    if successor_of(2) != "v1.0.0-rc.3" {
        return 5
    }
    if successor_of(3) != "v1.0.0-rc.4" {
        return 6
    }
    if successor_of(5) != "" {
        return 7
    }
    # before the tag the RC kit answers and the LTS kit refuses
    if answers("rc", false) != "readiness gate report signoff" {
        return 8
    }
    if answers("lts", false) != "refused" {
        return 9
    }
    # after the tag the LTS kit answers and the RC kit refuses
    if answers("rc", true) != "refused" {
        return 10
    }
    if answers("lts", true)
    != "status window backport tag-patch audit" {
        return 11
    }
    # no kit, no answer — a stranger is not a voice here
    if answers("make", true) != "" {
        return 12
    }
    if answers("", false) != "" {
        return 13
    }
    return 0
}

fn test_retirement() -> int {
    # the retirement speaks two laws, or it has not spoken
    if post_release_refusals(true, true) != 2 {
        return 1
    }
    if post_release_refusals(false, true) != 1 {
        return 2
    }
    if post_release_refusals(true, false) != 1 {
        return 3
    }
    if post_release_refusals(false, false) != 0 {
        return 4
    }
    # the refusal classes: a retired kit exits 1 and names its law
    if class_of_exit(1) != "REFUSAL" {
        return 5
    }
    if retired_voice(1, true) != "refused, named" {
        return 6
    }
    # it does not pretend the world is still its own
    if retired_voice(0, true) != "pretends" {
        return 7
    }
    # and it does not crash on the hand-off
    if retired_voice(101, true) != "crashes" {
        return 8
    }
    # a refusal that names no law is not the retirement's voice
    if retired_voice(1, false) != "wrong" {
        return 9
    }
    # the other classes keep their names
    if class_of_exit(0) != "OK" {
        return 10
    }
    if class_of_exit(2) != "USAGE" {
        return 11
    }
    if class_of_exit(101) != "PANIC" {
        return 12
    }
    if class_of_exit(42) != "UNKNOWN" {
        return 13
    }
    return 0
}

fn test_window() -> int {
    # the release line's own clock: cut 2026-10-29, bug fixes
    # through 2029-10-29, security through 2031-10-29 —
    # anniversaries, not day counts
    if bug_fix_until(2026, 10, 29) != "2029-10-29" {
        return 1
    }
    if security_until(2026, 10, 29) != "2031-10-29" {
        return 2
    }
    # the calendar law: a February 29 birthday clamps to the 28th
    # when the target year is not leap
    if !is_leap(2024) {
        return 3
    }
    if is_leap(2027) {
        return 4
    }
    if is_leap(2100) {
        return 5
    }
    if !is_leap(2000) {
        return 6
    }
    if bug_fix_until(2024, 2, 29) != "2027-02-28" {
        return 7
    }
    if security_until(2024, 2, 29) != "2029-02-28" {
        return 8
    }
    # a leap target year keeps its day
    if bug_fix_until(2020, 2, 29) != "2023-02-28" {
        return 9
    }
    # the horizon belongs to the phase it closes: whole years past
    # the base day
    if phase_at(-1) != "before the line" {
        return 10
    }
    if phase_at(0) != "active" {
        return 11
    }
    if phase_at(3) != "active" {
        return 12
    }
    if phase_at(4) != "security" {
        return 13
    }
    if phase_at(5) != "security" {
        return 14
    }
    if phase_at(6) != "eol" {
        return 15
    }
    # what lands where: a plain fix in active, a marked fix in
    # security, nothing in eol
    if !lands_in_phase("active", false) {
        return 16
    }
    if !lands_in_phase("active", true) {
        return 17
    }
    if lands_in_phase("security", false) {
        return 18
    }
    if !lands_in_phase("security", true) {
        return 19
    }
    if lands_in_phase("eol", false) {
        return 20
    }
    if lands_in_phase("eol", true) {
        return 21
    }
    # the release day itself is active — the window runs from the
    # base day, and today is zero years past it
    if phase_at(0) != "active" {
        return 22
    }
    return 0
}

fn test_marker() -> int {
    # the voice the release speaks
    if release_voice() != "1.0.0" {
        return 1
    }
    # one voice, three mouths: the manifest wears the v, the other
    # two speak bare
    if !markers_agree("1.0.0", "v1.0.0", "1.0.0") {
        return 2
    }
    if !markers_agree("1.0.0-rc.4", "v1.0.0-rc.4", "1.0.0-rc.4") {
        return 3
    }
    # a mouth that disagrees is named, and the tree refuses to
    # speak of a release at all
    if markers_agree("1.0.0", "v1.0.0-rc.4", "1.0.0") {
        return 4
    }
    if disagreeing_voices("1.0.0", "v1.0.0-rc.4", "1.0.0") != 1 {
        return 5
    }
    if disagreeing_voices("1.0.0", "v0.9.0", "0.9.0") != 2 {
        return 6
    }
    if disagreeing_voices("1.0.0", "v1.0.0", "1.0.0") != 0 {
        return 7
    }
    # the v is the manifest's alone: a bare manifest voice is a
    # disagreement even when the words otherwise match
    if markers_agree("1.0.0", "1.0.0", "1.0.0") {
        return 8
    }
    if disagreeing_voices("1.0.0", "1.0.0", "1.0.0") != 1 {
        return 9
    }
    return 0
}

fn test_line() -> int {
    # the wrong turns, in the order the release day refused them
    if init_verdict("v1.0.0-rc.4", true, false)
    != "refused: a pre-release is not an LTS base" {
        return 1
    }
    if init_verdict("v0.166.0", true, false)
    != "refused: the policy begins at v1.0" {
        return 2
    }
    if init_verdict("v1.0.0", false, false)
    != "refused: the tag does not exist in the repository" {
        return 3
    }
    # the cut: the release declares the line
    if init_verdict("v1.0.0", true, false) != "declared" {
        return 4
    }
    # the idempotent no-op: the same declaration again
    if init_verdict("v1.0.0", true, true) != "idempotent no-op" {
        return 5
    }
    # a different base is a new policy decision — refused, not
    # merged
    if init_verdict("v1.1.0", true, true)
    != "refused: one declaration per repository" {
        return 6
    }
    if init_verdict("v2.0.0", true, true)
    != "refused: one declaration per repository" {
        return 7
    }
    # the declaration's shape: branch release/1.0 from v1.0.0
    if line_branch(1, 0) != "release/1.0" {
        return 8
    }
    if line_branch(1, 0) + " from " + base_of_line(1, 0)
    != "release/1.0 from v1.0.0" {
        return 9
    }
    # the line's base is a `.0` — a patch is never a base
    if base_of_line(1, 1) != "v1.1.0" {
        return 10
    }
    return 0
}

fn main() -> int uses IO {
    println("stage 150: v1.0.0")
    let mut r: int = test_order()
    if r != 0 {
        return 10 + r
    }
    r = test_handoff()
    if r != 0 {
        return 20 + r
    }
    r = test_retirement()
    if r != 0 {
        return 30 + r
    }
    r = test_window()
    if r != 0 {
        return 40 + r
    }
    r = test_marker()
    if r != 0 {
        return 50 + r
    }
    r = test_line()
    if r != 0 {
        return 60 + r
    }
    println("  RELEASE laws OK: order, handoff, retirement, window, "
    + "marker, line")
    return 0
}
