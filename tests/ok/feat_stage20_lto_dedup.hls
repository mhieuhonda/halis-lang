# feat_stage20_lto_dedup.hls — Stage 20 perfection (v0.39.0-alpha) test.
#
# Verifies generic specialisation DEDUP: two modules instantiating the
# same generic with the same type arguments share ONE specialisation.
# The LTO-compiled binary must:
#   1. produce byte-identical output to the interpreter,
#   2. contain exactly ONE instantiation of Pair[int, int] (not two).
#
# The program imports std.list (which instantiates several generics
# internally) and adds its own generic Pair[T, U] with two call sites
# that share the same instantiation. Under --lto the emitted C must
# contain exactly one usf_Pair_int_int body (mangled name).

import "std.list"

# A small generic struct, instantiated at TWO call sites with the
# SAME type arguments. LTO must dedup these into ONE specialisation.
struct Pair[T, U] {
    first: T,
    second: U
}

# A generic function on Pair, also deduped when called twice at the
# same instantiation.
fn pair_first[T, U](p: Pair[T, U]) -> T {
    return p.first
}

fn pair_second[T, U](p: Pair[T, U]) -> U {
    return p.second
}

fn make_pair_int(a: int, b: int) -> Pair[int, int] {
    return Pair { first: a, second: b }
}

# A second call site with the SAME instantiation (Pair[int, int]).
fn swap_pair_int(p: Pair[int, int]) -> Pair[int, int] {
    return Pair { first: p.second, second: p.first }
}

fn main() -> int uses IO {
    let p1: Pair[int, int] = make_pair_int(10, 20)
    let p2: Pair[int, int] = swap_pair_int(p1)
    # The pair_first / pair_second helpers are called twice each at
    # the same instantiation — under --lto each dedups to ONE body.
    let a: int = pair_first(p1)
    let b: int = pair_second(p1)
    let c: int = pair_first(p2)
    let d: int = pair_second(p2)
    println("p1 = (" + a.to_str() + ", " + b.to_str() + ")")
    println("p2 = (" + c.to_str() + ", " + d.to_str() + ")")
    # Also exercise std.list to ensure cross-module generic dedup works.
    let xs: list[int] = [3, 1, 4, 1, 5, 9, 2, 6]
    let mut sum: int = 0
    let mut i: int = 0
    while i < xs.len() {
        sum = sum + xs.get(i)
        i = i + 1
    }
    println("list sum = " + sum.to_str())
    return 0
}
