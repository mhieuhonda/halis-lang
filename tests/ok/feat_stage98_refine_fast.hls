# Stage 98 (v0.117.0-alpha): the proof boundary. Guards PROVEN at
# compile time (constant values, same-pred flow, interval facts) are
# elided by the codegen; everything else keeps its runtime guard. The
# -O fast build must produce byte-identical output to the interpreter.

fn nonneg(v: int) -> int where self >= 0 {
    if v < 0 {
        return 0 - v
    }
    return v
}

fn pick(flag: bool, a: int, b: int) -> int {
    if flag {
        return a
    }
    return b
}

fn main() -> int uses IO {
    # constant value: compile-time proven, no runtime guard
    let a: int where self >= 0 = 5
    println("a = " + a.to_str())

    # same-pred flow: a already satisfies the identical pred
    let b: int where self >= 0 = a
    println("b = " + b.to_str())

    # interval-proven: 5 + a is provably >= 0 from the facts
    let c: int where self >= 0 = a + 5
    println("c = " + c.to_str())

    # runtime value through a refined return: guard passes
    let d: int where self >= 0 = nonneg(0 - 12)
    println("d = " + d.to_str())

    # NOT provable (pick's result is TOP): the guard must stay
    let e: int where self >= 0 = pick(true, 3, 0 - 3)
    println("e = " + e.to_str())

    # a proven non-zero divisor feeds a checked division
    let f: int where self != 0 = nonneg(9) + 1
    println("f = " + (100 / f).to_str())
    return 0
}
