# feat_nostd_core.hls — Stage 78: a `#![no_std]` crate exercising
# every `core` module (option, result, iter, clone, eq). Exit code is
# 0 on success (the differential suite compares interpreter-vs-native
# exit codes, and section 1 requires 0/101). Any positive exit code
# is a failure count.
#![no_std]

import "core.option"
import "core.result"
import "core.iter"
import "core.clone"
import "core.eq"

struct Cfg {
    name: str,
    retries: int
}

impl Cfg {
    fn eq_of(self: Cfg, other: Cfg) -> bool {
        return self.name == other.name && self.retries == other.retries
    }
    fn clone_of(self: Cfg) -> Cfg {
        return Cfg {
            name: clone(self.name), retries: self.retries
        }
    }
}

fn main() -> int {
    let mut failures: int = 0
    # option
    let o: Option[int] = Option.Some(7)
    let non: Option[int] = Option.None
    if !option_is_some(o) {
        failures = failures + 1
    }
    if option_unwrap(o) != 7 {
        failures = failures + 1
    }
    if option_unwrap_or(non, 3) != 3 {
        failures = failures + 1
    }
    if !option_is_none(non) {
        failures = failures + 1
    }
    # result
    if !result_is_ok(parse_int("42")) {
        failures = failures + 1
    }
    if result_unwrap(parse_int("42")) != 42 {
        failures = failures + 1
    }
    if !result_is_err(parse_int("4x")) {
        failures = failures + 1
    }
    if result_unwrap_err(parse_int("")) != "empty integer literal" {
        failures = failures + 1
    }
    # iter
    let xs: list[int] = [1, 2, 3, 4]
    if iter_count(xs) != 4 {
        failures = failures + 1
    }
    if iter_sum_int(xs) != 10 {
        failures = failures + 1
    }
    let mut it: ListIter[int] = list_iter(xs)
    if option_unwrap_or(iter_next(it), 0) != 1 {
        failures = failures + 1
    }
    if iter_remaining(it) != 3 {
        failures = failures + 1
    }
    # clone
    let ys: list[int] = clone_list_of(xs)
    ys.push(5)
    if xs.len() != 4 {
        failures = failures + 1
    }
    if ys.len() != 5 {
        failures = failures + 1
    }
    if !option_is_some(clone_some(o)) {
        failures = failures + 1
    }
    let cfg: Cfg = Cfg {
        name: "net", retries: 3
    }
    let cfg2: Cfg = cfg.clone_of()
    cfg2.retries = 9
    if cfg.retries != 3 {
        failures = failures + 1
    }
    # eq
    if !eq_list_int([1, 2], [1, 2]) {
        failures = failures + 1
    }
    if eq_list_int([1, 2], [1, 3]) {
        failures = failures + 1
    }
    if !eq_list_str(["a"], ["a"]) {
        failures = failures + 1
    }
    if !eq_list_bool([true], [true]) {
        failures = failures + 1
    }
    if !eq_option_int(Option.Some(1), Option.Some(1)) {
        failures = failures + 1
    }
    if !eq_option_str(Option.Some("x"), Option.Some("x")) {
        failures = failures + 1
    }
    let m1: map[str, int] = map_new()
    m1.set("a", 1)
    m1.set("b", 2)
    let m2: map[str, int] = map_new()
    m2.set("b", 2)
    m2.set("a", 1)
    if !eq_map_str_int(m1, m2) {
        failures = failures + 1
    }
    if !cfg.eq_of(cfg) {
        failures = failures + 1
    }
    if cfg.eq_of(cfg2) {
        failures = failures + 1
    }
    return failures
}
