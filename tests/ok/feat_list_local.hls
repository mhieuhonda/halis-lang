# feat_list_local.hls — regression test (Stage 8-beta deep scan):
# list literals containing LOCAL variables. The old codegen emitted a
# separate hl_lit_N() helper function per literal, but generated the
# element expressions in the ENCLOSING function's context — any element
# referencing a local produced C identifiers that do not exist inside
# the helper, so the program failed to compile natively (the interpreter
# worked, hiding the bug). List literals are now emitted inline as
# statement expressions.

fn main() -> int uses IO {
    let a: int = 10
    let b: int = 20
    let xs: list[int] = [a, b, 30, a + b]
    println("sum=" + (xs.get(0) + xs.get(1) + xs.get(2) + xs.get(3)).to_str())

    let s: str = "x"
    let t: str = "y"
    let ys: list[str] = [s, t, s + t]
    println("ys=" + ys.get(0) + ys.get(1) + ys.get(2))
    println("len=" + ys.len().to_str())

    # nested literals referencing locals
    let zss: list[list[int]] = [[a, b], [b, a], [a + a]]
    println("nested=" + zss.get(2).get(0).to_str())
    return 0
}
