# feat_stage27_perfection.hls — Stage 27 perfection (v0.50.2-alpha)
# deep-scan-17 positive regression test.
#
# Verifies that the deep-scan-17 checker hardening does NOT reject
# valid asm! programs. The new checks added in v0.50.2-alpha are:
#
#   1. String-form constraints are validated against an allowlist of
#      known x86-64 register names + GCC constraint letters.
#   2. Duplicate options are rejected.
#   3. `pure` + `noreturn` combination is rejected.
#   4. `pure` without `nomem` is rejected.
#   5. `imm` constraint on non-`in` operands is rejected.
#   6. Direction-prefix/constraint mismatch (e.g. `in("=r") x`) is
#      rejected.
#
# This file exercises all the forms that SHOULD still work after the
# hardening: bare asm, output-only with `reg`, input+output with
# specific-register constraints, pure+nomem, noreturn, late_out,
# inout, and the GCC single-letter constraint form (e.g. "a").
#
# The asm!-containing functions are NOT called from main() — the boot
# interpreter raises a clean error if they were. The acceptance is
# verified by `make asm-acceptance` (C-source-level + objdump) and
# by the boot --check mode (type + effect validity).

import "std.bits"

# Bare asm! — no operands, no options. Default clobber list applies
# ("cc" + "memory" — safe defaults; the user can opt out with
# options(preserves_flags) and options(nomem) respectively).
fn asm_bare() -> void {
    asm!("nop")
}

# Output-only with the `reg` bare constraint. The codegen emits
# `=r(x)` — gcc allocates any general-purpose register.
fn asm_set_zero() -> int {
    let mut x: int = 0
    asm!("mov $0, {0}", out(reg) x)
    return x
}

# inout with the `reg` bare constraint. The codegen emits `+r(x)`.
fn asm_incr_one(mut x: int) -> int {
    asm!("add $1, {0}", inout(reg) x)
    return x
}

# late_out with the `reg` bare constraint. The codegen emits `=&r(x)`.
# Late-clobber outputs must NOT alias any input register — gcc is
# told the output is written BEFORE all inputs are consumed.
fn asm_late_out() -> int {
    let mut x: int = 0
    asm!("xor {0}, {0}", late_out(reg) x)
    return x
}

# Specific-register form: pin output to EAX (gcc constraint letter "a").
fn asm_out_eax() -> int {
    let mut x: int = 0
    asm!("mov $42, {0}", out("eax") x)
    return x
}

# Input + output with specific-register constraints (the inb()
# acceptance pattern from the original Stage 27 test).
fn asm_inb(port: int) -> int {
    let mut val: int = 0
    asm!("in %w1, %b0", in("edx") port, out("eax") val, options(nomem, preserves_flags))
    return bits_and(val, 255)
}

# GCC single-letter constraint form ("a" / "d" instead of "eax" /
# "edx"). The codegen passes these through verbatim (they ARE the
# GCC constraint letters).
fn asm_single_letter(x: int) -> int {
    let mut y: int = 0
    asm!("mov {1}, {0}", in("a") x, out("d") y, options(nomem, preserves_flags))
    return y
}

# A pure asm! with both required companions: an output AND nomem.
# The codegen drops `__volatile__` (gcc may elide if outputs unused).
fn asm_pure_ok(x: int) -> int {
    let mut y: int = 0
    asm!("mov {1}, {0}", in(reg) x, out(reg) y, options(pure, nomem, preserves_flags))
    return y
}

# A noreturn asm! as the LAST statement of a void function. The
# codegen emits `__builtin_unreachable()` after the asm.
fn asm_halt() -> void {
    asm!("hlt", options(nomem, noreturn))
}

# main() does NOT call any asm!-containing function (the boot
# interpreter would raise an error). The acceptance is verified
# by inspecting the C source and by compiling it with gcc.
fn main() -> int uses IO {
    println("Stage 27 perfection (v0.50.2-alpha) deep-scan-17 regression test")
    println("  asm_bare()                           -> (declared)")
    println("  asm_set_zero() -> int                -> (declared)")
    println("  asm_incr_one(x: int) -> int          -> (declared)")
    println("  asm_late_out() -> int                -> (declared)")
    println("  asm_out_eax() -> int                 -> (declared)")
    println("  asm_inb(port: int) -> int            -> (declared)")
    println("  asm_single_letter(x: int) -> int     -> (declared)")
    println("  asm_pure_ok(x: int) -> int           -> (declared)")
    println("  asm_halt() -> void                   -> (declared)")
    println("ACCEPTANCE OK: deep-scan-17 hardening does not break valid asm!")
    return 0
}
