# tests/ok/panic_rand_zero.hls — Stage 9 release (v0.20.0-alpha).
#
# rand_int(0) must panic with a clear message ("requires a positive
# max"). Same behaviour in both Stage-0 and the native binary, so
# differential testing passes (exit code 101 = panic).

fn main() -> int uses IO, Rand {
    let r: int = rand_int(0)
    println("unreachable: " + r.to_str())
    return 0
}
