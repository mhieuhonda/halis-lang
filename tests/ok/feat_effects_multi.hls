# feat_effects_multi — Stage 9-alpha: combination of fine-grained effects
# `uses Fs, Clock` grants only filesystem and clock — not IO (console), Args, or Exit.

fn save_timestamp(path: str) -> int uses Fs, Clock {
    let t: int = clock_ms()
    let content: str = "timestamp=" + t.to_str() + "\n"
    write_file(path, content)
    return t
}

fn read_first_line(path: str) -> str uses Fs {
    let content: str = read_file(path)
    let lines: list[str] = content.split("\n")
    if lines.len() == 0 {
        return ""
    }
    return lines.get(0)
}

fn main() -> int uses IO {
    # IO blanket grants Fs + Clock (and more), so both callees are satisfied.
    let path: str = "/tmp/hls_effects_multi_test.txt"
    let t: int = save_timestamp(path)
    # Avoid printing the timestamp directly — it's non-deterministic across
    # runs and would break differential testing. Instead verify the written
    # file is readable and starts with the expected prefix.
    let line: str = read_first_line(path)
    if !line.starts_with("timestamp=") {
        println("FAIL: written file does not contain expected prefix")
        return 1
    }
    println("Fs + Clock combined verified")
    return 0
}
