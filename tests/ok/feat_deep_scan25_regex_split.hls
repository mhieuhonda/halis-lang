# feat_deep_scan25_regex_split.hls — deep-scan-25 regression: the
# zero-width branch of regex_split advanced pos by one WITHOUT emitting
# the skipped byte, so the parts no longer concatenated back to the
# input ("abc" split on "b*" returned five EMPTY parts — the letters
# vanished). The fix keeps `last` (start of the unemitted segment) and
# mirrors Python re.split's zero-width rule: an empty match at p emits
# text[last..p] and moves the scan to p+1 without consuming the byte,
# so the byte joins the NEXT segment. The old behaviour also misused
# pos (scan position) instead of the segment start for the remainder,
# which dropped bytes after trailing zero-width matches.
import "std.regex"
fn eq_str_checked(got: str, want: str, label: str) {
    if got != want {
        panic(label + ": got '" + got + "', want '" + want + "'")
    }
}
fn eq_int_checked(got: int, want: int, label: str) {
    if got != want {
        panic(label + ": got " + got.to_str() + ", want " + want.to_str())
    }
}
fn concat_parts(parts: list[str]) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < parts.len() {
        out = out + parts.get(i)
        i = i + 1
    }
    return out
}
fn main() -> int uses IO {
    let rb: Regex = result_unwrap(regex_compile("b*"))
    let p1: list[str] = regex_split(rb, "abc", 0)
    # Python re.split(r'b*', "abc") == ['', 'a', '', 'c', '']
    eq_int_checked(p1.len(), 5, "b*.count")
    eq_str_checked(p1.get(0), "", "b*.0")
    eq_str_checked(p1.get(1), "a", "b*.1")
    eq_str_checked(p1.get(2), "", "b*.2")
    eq_str_checked(p1.get(3), "c", "b*.3")
    eq_str_checked(p1.get(4), "", "b*.4")
    let rx: Regex = result_unwrap(regex_compile("x*"))
    let p2: list[str] = regex_split(rx, "abc", 0)
    # ['', 'a', 'b', 'c', '']
    eq_int_checked(p2.len(), 5, "x*.count")
    eq_str_checked(p2.get(1), "a", "x*.1")
    eq_str_checked(p2.get(2), "b", "x*.2")
    eq_str_checked(p2.get(3), "c", "x*.3")
    if concat_parts(p2) != "abc" {
        panic("x* split does not reconstruct the input")
    }
    let ra: Regex = result_unwrap(regex_compile("a*"))
    let p3: list[str] = regex_split(ra, "aab", 0)
    # ['', '', 'b', '']
    eq_int_checked(p3.len(), 4, "a*.count")
    eq_str_checked(p3.get(2), "b", "a*.2")
    # Non-empty separators behave as before (incl. max_parts and the
    # trailing-separator empty part).
    let rc: Regex = result_unwrap(regex_compile(","))
    let p4: list[str] = regex_split(rc, "a,b,c,d,e", 3)
    eq_int_checked(p4.len(), 3, "comma.max.count")
    eq_str_checked(p4.get(2), "c,d,e", "comma.max.remainder")
    let p5: list[str] = regex_split(rc, "a,", 0)
    eq_int_checked(p5.len(), 2, "comma.trailing.count")
    eq_str_checked(p5.get(1), "", "comma.trailing.empty")
    let p6: list[str] = regex_split(rc, "a,b", 0)
    eq_int_checked(p6.len(), 2, "comma.plain.count")
    eq_str_checked(p6.get(0) + "," + p6.get(1), "a,b", "comma.reconstruct")
    println("regex split OK")
    return 0
}
