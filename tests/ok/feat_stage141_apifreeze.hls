# feat_stage141_apifreeze.hls — Stage 141 (v0.159.0-alpha): the
# API freeze — syntax + stdlib locked.
#
# What this fixture pins is the DECISION PROCEDURE the kit runs —
# the same laws `tools/hls-freeze.py` applies when it derives the
# surface, classifies drift, takes an amendment and replays the
# chain:
#
#   hls-freeze snapshot | verify | amend | report | status
#
#   1. the drift     — the vocabulary is closed at three words:
#      vocabulary    REMOVED (in the freeze, gone from the tree),
#                    ADDED (in the tree, absent from the freeze —
#                    post-freeze additions are drift too: the API
#                    is locked, not merely backwards-compatible)
#                    and CHANGED (present in both, different);
#                    the classification is total over (frozen?,
#                    live?, differs?) and nothing else is a
#                    verdict;
#   2. the amendment — no reason, no amendment; no delta, no
#      law           amendment (a no-op is noise); a real
#                    amendment moves the digest, appends exactly
#                    one record, and records the delta the diff
#                    computed — never a hand-written story;
#   3. the digest    — 64 lowercase hex; the same surface always
#      law           hashes to the same digest; one changed
#                    export changes the digest; a document whose
#                    digest does not match its own surface is
#                    refused (it disagrees with itself);
#   4. the chain     — entry one chains from 64 zeros; every
#      law           hash is 64 lowercase hex; seq runs 1..n
#                    with no hole; the next entry's prev is the
#                    previous entry's chain; a tampered entry
#                    breaks the replay at its line;
#   5. the count     — the frozen census pins the syntax counts:
#      law           25 keywords, 2 reserved identifiers, 8
#                    two-char + 19 one-char tokens, 9 effects,
#                    5 crate attributes, 16 function attributes,
#                    8 builtin-method receivers carrying 35
#                    methods; these can only move through an
#                    amendment, and an amendment updates this
#                    fixture in the same commit;
#   6. the method    — the receiver law: every receiver answers
#      law           exactly its roster (str 12, int 3, float 3,
#                    bool 1, list 5, map 5, chan 5, task 1) and
#                    no receiver answers a junk name;
#   7. the contract  — the freeze pins the CONTRACT, not the
#      law           bytes: a comment-only edit moves no row
#                    (the surface is signatures, not text), so
#                    an honest verify stays green across a
#                    reformat and a signature edit does not;
#   8. the state     — snapshot once (a second snapshot is
#      machine       refused while a freeze exists), verify green
#                    on identical and red on any drift, amend
#                    absorbs the drift and returns to green,
#                    report never renders from a drifted tree.
#
# The program exits 0 when every law holds, nonzero with the
# law's number otherwise — the differential suite runs it on the
# interpreter AND natively and requires byte-identical output.
#
# This file enters the corpus at this release — green the day it
# is born, already written in the dialect the freeze speaks.

# ----------------------------------------------------------------------
# Section 1 — the drift vocabulary. Three words, closed; the
# classification is total and nothing outside it is a verdict.
# ----------------------------------------------------------------------
fn drift_word(in_frozen: bool, in_live: bool, differs: bool) -> str {
    if in_frozen && in_live {
        if differs {
            return "CHANGED"
        }
        return "SAME"
    }
    if in_frozen && !in_live {
        return "REMOVED"
    }
    if !in_frozen && in_live {
        return "ADDED"
    }
    return "SAME"
}

fn valid_drift_word(w: str) -> bool {
    return w == "REMOVED" || w == "ADDED" || w == "CHANGED"
    || w == "SAME"
}

fn check_drift_totality() -> bool {
    # (frozen?, live?, differs?) -> the one word each.
    if drift_word(true, true, true) != "CHANGED" {
        return false
    }
    if drift_word(true, true, false) != "SAME" {
        return false
    }
    if drift_word(true, false, false) != "REMOVED" {
        return false
    }
    if drift_word(false, true, false) != "ADDED" {
        return false
    }
    # A row that is in neither world is not drift at all — the
    # classification never mentions what nobody has.
    if drift_word(false, false, false) != "SAME" {
        return false
    }
    if drift_word(false, false, true) != "SAME" {
        return false
    }
    # The vocabulary is closed: every output the function can
    # produce is one of the four words, and the three drift words
    # are exactly the non-SAME ones.
    if !valid_drift_word("REMOVED") {
        return false
    }
    if !valid_drift_word("ADDED") {
        return false
    }
    if !valid_drift_word("CHANGED") {
        return false
    }
    if !valid_drift_word("SAME") {
        return false
    }
    if valid_drift_word("UPDATED") {
        return false
    }
    if valid_drift_word("MERGED") {
        return false
    }
    if valid_drift_word("") {
        return false
    }
    return true
}

# ----------------------------------------------------------------------
# Section 2 — the amendment law. No reason, no amendment; no delta,
# no amendment; a real amendment records what the diff computed.
# ----------------------------------------------------------------------
fn amendment_refused(reason: str, delta: int) -> bool {
    # A whitespace-only reason is no reason at all.
    let reasonless: bool = reason.trim().len() == 0
    let noisy: bool = delta == 0
    return reasonless || noisy
}

fn check_amendment_law() -> bool {
    if !amendment_refused("", 3) {
        return false
    }
    if !amendment_refused("   ", 3) {
        return false
    }
    if !amendment_refused("a real reason", 0) {
        return false
    }
    if amendment_refused("a real reason", 1) {
        return false
    }
    if amendment_refused("a real reason", 7) {
        return false
    }
    return true
}

# ----------------------------------------------------------------------
# Section 3 — the digest law. 64 lowercase hex, deterministic,
# avalanche on one change, self-agreement enforced.
# ----------------------------------------------------------------------
fn hex_digit_val(c: str) -> int {
    let lower: str = c
    if lower == "0" {
        return 0
    }
    if lower == "1" {
        return 1
    }
    if lower == "2" {
        return 2
    }
    if lower == "3" {
        return 3
    }
    if lower == "4" {
        return 4
    }
    if lower == "5" {
        return 5
    }
    if lower == "6" {
        return 6
    }
    if lower == "7" {
        return 7
    }
    if lower == "8" {
        return 8
    }
    if lower == "9" {
        return 9
    }
    if lower == "a" {
        return 10
    }
    if lower == "b" {
        return 11
    }
    if lower == "c" {
        return 12
    }
    if lower == "d" {
        return 13
    }
    if lower == "e" {
        return 14
    }
    if lower == "f" {
        return 15
    }
    return -1
}

# A tiny stand-in for the real sha256 over the surface: a
# deterministic, avalanche-prone fold of the export names — the LAWS
# (width, alphabet, determinism, avalanche, self-agreement) are what
# the fixture pins, not the hash's internals.
fn surface_hash(rows: list[str]) -> str {
    let alphabet: str = "0123456789abcdef"
    let mut h: int = 5381
    let mut i: int = 0
    while i < rows.len() {
        let row: str = rows.get(i)
        let mut j: int = 0
        while j < row.len() {
            h = (h * 33 + row.byte_at(j)) % 2147483647
            j = j + 1
        }
        # A fixed separator byte between rows: the fold of
        # ["ab"] differs from the fold of ["a", "b"].
        h = (h * 33 + 46) % 2147483647
        i = i + 1
    }
    let mut out: str = ""
    let mut hk: int = h
    let mut k: int = 0
    while k < 64 {
        # iterative mixing: the k-th character folds the whole
        # state, so two different surfaces collide only on a full
        # 31-bit match — the avalanche law holds by construction
        hk = (hk * 33 + k) % 2147483647
        out = out + alphabet.slice(hk % 16, hk % 16 + 1)
        k = k + 1
    }
    return out
}

fn is_hex64(s: str) -> bool {
    if s.len() != 64 {
        return false
    }
    let mut i: int = 0
    while i < 64 {
        let c: str = s.slice(i, i + 1)
        if hex_digit_val(c) < 0 {
            return false
        }
        i = i + 1
    }
    return true
}

fn check_digest_law() -> bool {
    let rows_a: list[str] = ["std.hex.fns.hex_byte", "std.str.fns.trim"]
    let rows_b: list[str] = ["std.hex.fns.hex_byte", "std.str.fns.trim"]
    let d1: str = surface_hash(rows_a)
    let d2: str = surface_hash(rows_b)
    # determinism: the same surface, the same digest
    if d1 != d2 {
        return false
    }
    if !is_hex64(d1) {
        return false
    }
    # avalanche: one changed export, a different digest
    let rows_c: list[str] = ["std.hex.fns.hex_byte", "std.str.fns.trims"]
    let d3: str = surface_hash(rows_c)
    if d3 == d1 {
        return false
    }
    if !is_hex64(d3) {
        return false
    }
    # order is part of the canonical form: the same rows in a
    # different order are a different canonical rendering
    let rows_d: list[str] = ["std.str.fns.trim", "std.hex.fns.hex_byte"]
    if surface_hash(rows_d) == d1 {
        return false
    }
    # a row that is only a prefix of another folds differently
    let rows_e: list[str] = ["std.hex.fns.hex_byte"]
    let rows_f: list[str] = ["std.hex.fns.hex_bytex"]
    if surface_hash(rows_e) == surface_hash(rows_f) {
        return false
    }
    return true
}

# ----------------------------------------------------------------------
# Section 4 — the chain law. Genesis from 64 zeros, seq 1..n with
# no hole, prev binding, replay names the broken line.
# ----------------------------------------------------------------------
fn is_zeros64(s: str) -> bool {
    if s.len() != 64 {
        return false
    }
    let mut i: int = 0
    while i < 64 {
        if s.slice(i, i + 1) != "0" {
            return false
        }
        i = i + 1
    }
    return true
}

fn chain_link_ok(seq: int, prev: str, chain_hash: str) -> bool {
    if seq < 1 {
        return false
    }
    if !is_hex64(prev) {
        return false
    }
    if !is_hex64(chain_hash) {
        return false
    }
    if seq == 1 && !is_zeros64(prev) {
        return false
    }
    if seq > 1 && is_zeros64(prev) {
        return false
    }
    if chain_hash == prev {
        return false
    }
    return true
}

fn replay_ok(seq: list[int], prevs: list[str], hashes: list[str]) -> int {
    # Returns 0 when the replay holds; else the 1-based index of
    # the first broken record. The replay binds every record to
    # the one before it — the arithmetic is the family's.
    let mut expect: int = 1
    let mut want_prev: str = ""
    let mut i: int = 0
    while i < 64 {
        want_prev = want_prev + "0"
        i = i + 1
    }
    i = 0
    while i < seq.len() {
        if seq.get(i) != expect {
            return i + 1
        }
        if prevs.get(i) != want_prev {
            return i + 1
        }
        if !chain_link_ok(seq.get(i), prevs.get(i), hashes.get(i)) {
            return i + 1
        }
        want_prev = hashes.get(i)
        expect = expect + 1
        i = i + 1
    }
    return 0
}

fn check_chain_law() -> bool {
    let h1: str = surface_hash(["entry one"])
    let h2: str = surface_hash(["entry two"])
    let mut zeros: str = ""
    let mut i: int = 0
    while i < 64 {
        zeros = zeros + "0"
        i = i + 1
    }
    # a sound two-entry chain replays clean
    let seqs: list[int] = [1, 2]
    let prevs: list[str] = [zeros, h1]
    let hashes: list[str] = [h1, h2]
    if replay_ok(seqs, prevs, hashes) != 0 {
        return false
    }
    # a hole in the numbering breaks the replay at its line
    let seqs_gap: list[int] = [1, 3]
    if replay_ok(seqs_gap, prevs, hashes) != 2 {
        return false
    }
    # a broken prev binding breaks the replay at its line
    let prevs_bad: list[str] = [zeros, zeros]
    if replay_ok(seqs, prevs_bad, hashes) != 2 {
        return false
    }
    # genesis is mandatory: entry one chaining from a non-zero
    # prev is refused
    let prevs_genesis: list[str] = [h2, h1]
    if replay_ok(seqs, prevs_genesis, hashes) != 1 {
        return false
    }
    # a tampered hash (same shape, different content) breaks the
    # replay: the next entry's prev no longer binds
    let hashes_tamper: list[str] = [h2, h2]
    if replay_ok(seqs, prevs, hashes_tamper) != 2 {
        return false
    }
    # the chain-link grammar itself
    if !chain_link_ok(1, zeros, h1) {
        return false
    }
    if chain_link_ok(1, h1, h1) {
        return false
    }
    if chain_link_ok(0, zeros, h1) {
        return false
    }
    if chain_link_ok(1, zeros, h1.slice(0, 63)) {
        return false
    }
    if chain_link_ok(1, zeros, "ZZZ") {
        return false
    }
    return true
}

# ----------------------------------------------------------------------
# Sections 5 + 6 — the count law and the method-surface law. The
# frozen census pins the syntax counts and the method roster; these
# can only move through an amendment, and an amendment updates this
# fixture in the same commit.
# ----------------------------------------------------------------------
fn count_in(words: list[str], w: str) -> int {
    # how many times w appears in words (the census is a set, so
    # the honest answer is 0 or 1 — and the count law requires 1)
    let mut n: int = 0
    let mut i: int = 0
    while i < words.len() {
        if words.get(i) == w {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn check_count_law(keywords: list[str], reserved: list[str],
two_char: list[str], one_char: list[str],
effects: list[str], crate_attrs: list[str],
fn_attrs: list[str]) -> bool {
    if keywords.len() != 25 {
        return false
    }
    if reserved.len() != 2 {
        return false
    }
    if two_char.len() != 8 {
        return false
    }
    if one_char.len() != 19 {
        return false
    }
    if effects.len() != 9 {
        return false
    }
    if crate_attrs.len() != 5 {
        return false
    }
    if fn_attrs.len() != 16 {
        return false
    }
    # the sets are sets: no duplicates hide in the census
    if count_in(keywords, "fn") != 1 {
        return false
    }
    if count_in(keywords, "where") != 1 {
        return false
    }
    if count_in(keywords, "asm") != 1 {
        return false
    }
    if count_in(effects, "IO") != 1 {
        return false
    }
    if count_in(effects, "Conc") != 1 {
        return false
    }
    if count_in(crate_attrs, "freestanding") != 1 {
        return false
    }
    if count_in(fn_attrs, "deprecated") != 1 {
        return false
    }
    if count_in(fn_attrs, "inline(always)") != 1 {
        return false
    }
    # the reserved pair is exactly the future-proofing pair
    if reserved.get(0) != "secure" {
        return false
    }
    if reserved.get(1) != "trait" {
        return false
    }
    return true
}

fn receiver_method_count(receiver: str, methods: list[str]) -> int {
    # The roster, receiver by receiver. A junk name answers to
    # nobody; every roster name answers to exactly its receiver.
    if receiver == "str" {
        let roster: list[str] = ["len", "byte_at", "slice", "find",
        "contains", "starts_with", "ends_with", "split", "trim",
        "to_int", "to_str", "to_float"]
        let mut n: int = 0
        let mut i: int = 0
        while i < methods.len() {
            let mut j: int = 0
            while j < roster.len() {
                if methods.get(i) == roster.get(j) {
                    n = n + 1
                }
                j = j + 1
            }
            i = i + 1
        }
        return n
    }
    if receiver == "int" || receiver == "float" {
        let roster2: list[str] = ["to_str", "to_int", "to_float",
        "abs"]
        let mut n2: int = 0
        let mut i2: int = 0
        while i2 < methods.len() {
            let mut j2: int = 0
            while j2 < roster2.len() {
                if methods.get(i2) == roster2.get(j2) {
                    n2 = n2 + 1
                }
                j2 = j2 + 1
            }
            i2 = i2 + 1
        }
        if receiver == "int" {
            # int answers to_str, to_float, abs — to_int is not
            # an int method
            let mut real: int = 0
            if count_in(methods, "to_str") == 1 {
                real = real + 1
            }
            if count_in(methods, "to_float") == 1 {
                real = real + 1
            }
            if count_in(methods, "abs") == 1 {
                real = real + 1
            }
            if n2 != real {
                return -1
            }
            return n2
        }
        # float answers to_str, to_int, abs — to_float is not a
        # float method
        let mut realf: int = 0
        if count_in(methods, "to_str") == 1 {
            realf = realf + 1
        }
        if count_in(methods, "to_int") == 1 {
            realf = realf + 1
        }
        if count_in(methods, "abs") == 1 {
            realf = realf + 1
        }
        if n2 != realf {
            return -1
        }
        return n2
    }
    if receiver == "bool" {
        if methods.len() == 1 && methods.get(0) == "to_str" {
            return 1
        }
        return -1
    }
    if receiver == "list" || receiver == "map" || receiver == "chan" {
        if methods.len() != 5 {
            return -1
        }
        return methods.len()
    }
    if receiver == "task" {
        if methods.len() == 1 && methods.get(0) == "join" {
            return 1
        }
        return -1
    }
    return -1
}

fn check_method_law(recv_names: list[str], recv_counts: list[int]) -> bool {
    # Eight receivers, exactly; every receiver carries its roster
    # size; the total is 35.
    if recv_names.len() != 8 {
        return false
    }
    let mut total: int = 0
    let mut i: int = 0
    while i < recv_names.len() {
        if recv_counts.get(i) < 0 {
            return false
        }
        total = total + recv_counts.get(i)
        i = i + 1
    }
    if total != 35 {
        return false
    }
    # the receiver set is closed
    if count_in(recv_names, "str") != 1 {
        return false
    }
    if count_in(recv_names, "int") != 1 {
        return false
    }
    if count_in(recv_names, "float") != 1 {
        return false
    }
    if count_in(recv_names, "bool") != 1 {
        return false
    }
    if count_in(recv_names, "list") != 1 {
        return false
    }
    if count_in(recv_names, "map") != 1 {
        return false
    }
    if count_in(recv_names, "chan") != 1 {
        return false
    }
    if count_in(recv_names, "task") != 1 {
        return false
    }
    return true
}

# ----------------------------------------------------------------------
# Section 7 — the contract law. The freeze pins the CONTRACT, not
# the bytes: a comment-only edit moves no row; a signature edit
# does. An honest verify distinguishes them.
# ----------------------------------------------------------------------
fn row_changes_on_edit(edit_kind: str) -> bool {
    # The surface is signatures: which edit kinds move a row?
    if edit_kind == "comment" {
        return false
    }
    if edit_kind == "blank-line" {
        return false
    }
    if edit_kind == "header-comment" {
        return false
    }
    if edit_kind == "param-type" {
        return true
    }
    if edit_kind == "return-type" {
        return true
    }
    if edit_kind == "effect-clause" {
        return true
    }
    if edit_kind == "variant-removed" {
        return true
    }
    if edit_kind == "field-removed" {
        return true
    }
    if edit_kind == "fn-added" {
        return true
    }
    if edit_kind == "fn-removed" {
        return true
    }
    return true
}

fn check_contract_law() -> bool {
    if row_changes_on_edit("comment") {
        return false
    }
    if row_changes_on_edit("blank-line") {
        return false
    }
    if row_changes_on_edit("header-comment") {
        return false
    }
    if !row_changes_on_edit("param-type") {
        return false
    }
    if !row_changes_on_edit("return-type") {
        return false
    }
    if !row_changes_on_edit("effect-clause") {
        return false
    }
    if !row_changes_on_edit("variant-removed") {
        return false
    }
    if !row_changes_on_edit("field-removed") {
        return false
    }
    if !row_changes_on_edit("fn-added") {
        return false
    }
    if !row_changes_on_edit("fn-removed") {
        return false
    }
    return true
}

# ----------------------------------------------------------------------
# Section 8 — the state machine. Snapshot once; verify green on
# identical and red on any drift; amend absorbs and returns to
# green; report never renders from drift.
# ----------------------------------------------------------------------
fn check_state_machine() -> bool {
    # The machine's states: (has_freeze, drift_points, amendments).
    # snapshot: refused while a freeze exists, allowed when not
    if !has_freeze_snapshot_refused(true) {
        return false
    }
    if has_freeze_snapshot_refused(false) {
        return false
    }
    # verify: green only on zero drift
    if !verify_green(0) {
        return false
    }
    if verify_green(1) {
        return false
    }
    if verify_green(12) {
        return false
    }
    # report: never renders from drift
    if report_refused(0) {
        return false
    }
    if !report_refused(1) {
        return false
    }
    # amend: absorbs drift and returns to green; refuses no-ops
    if !amend_absorbs(1, 0) {
        return false
    }
    if !amend_absorbs(9, 4) {
        return false
    }
    if amend_absorbs(0, 4) {
        return false
    }
    return true
}

fn has_freeze_snapshot_refused(has_freeze: bool) -> bool {
    # snapshot is ONCE: refused whenever a freeze already exists.
    return has_freeze
}

fn verify_green(drift_points: int) -> bool {
    return drift_points == 0
}

fn report_refused(drift_points: int) -> bool {
    return drift_points > 0
}

fn amend_absorbs(drift_points: int, amendments_before: int) -> bool {
    # An amendment with real drift succeeds and the state returns
    # to green with one more record; a no-op (zero drift) is
    # refused — noise is how real amendments stop being read.
    if drift_points == 0 {
        return false
    }
    return amendments_before >= 0
}

# ----------------------------------------------------------------------
fn check_drift_totality_pub() -> bool {
    return check_drift_totality()
}

fn main() -> int uses IO {
    let mut failures: int = 0

    if !check_drift_totality_pub() {
        failures = failures + 1
    }
    if !check_amendment_law() {
        failures = failures + 1
    }
    if !check_digest_law() {
        failures = failures + 1
    }
    if !check_chain_law() {
        failures = failures + 1
    }
    if !check_contract_law() {
        failures = failures + 1
    }
    if !check_state_machine() {
        failures = failures + 1
    }

    # The count law, over the frozen census as this release pins it.
    let keywords: list[str] = ["asm", "break", "continue", "else",
    "ensures", "enum", "extern", "false", "fn", "for", "if", "impl",
    "import", "in", "let", "match", "mut", "pure", "requires",
    "return", "struct", "true", "uses", "where", "while"]
    let reserved: list[str] = ["secure", "trait"]
    # the one-char token alphabet: exactly nineteen symbols
    let one_char: list[str] = ["(", ")", "{", "}", "[", "]", ",",
    ":", ".", "<", ">", "+", "-", "*", "/", "%", "!", "=", "?"]
    let effects: list[str] = ["Args", "Clock", "Conc", "Exit", "Fs",
    "IO", "Net", "Proc", "Rand"]
    let crate_attrs: list[str] = ["boot_header", "freestanding",
    "link_script", "no_std", "stack_size"]
    let fn_attrs: list[str] = ["align", "cold", "ct", "deprecated",
    "hot", "inline(always)", "inline(never)", "irq_handler",
    "no_red_zone", "panic_handler", "section", "secrets",
    "stack_size", "tail_call", "taint_sink", "taint_source"]

    # the two-char list above is the SORTED alphabet including the
    # one-char symbols for the count law's token arithmetic: the
    # frozen two-char roster is exactly eight
    let two_char_roster: list[str] = ["!=", "&&", "->", "<=", ">=",
    "==", "=>", "||"]
    if two_char_roster.len() != 8 {
        failures = failures + 1
    }

    if !check_count_law(keywords, reserved, two_char_roster,
    one_char, effects, crate_attrs, fn_attrs) {
        failures = failures + 1
    }

    # The method law, receiver by receiver.
    let recv_names: list[str] = ["str", "int", "float", "bool",
    "list", "map", "chan", "task"]
    let str_methods: list[str] = ["len", "byte_at", "slice", "find",
    "contains", "starts_with", "ends_with", "split", "trim",
    "to_int", "to_str", "to_float"]
    let int_methods: list[str] = ["to_str", "to_float", "abs"]
    let float_methods: list[str] = ["to_str", "to_int", "abs"]
    let bool_methods: list[str] = ["to_str"]
    let list_methods: list[str] = ["len", "push", "get", "set",
    "pop"]
    let map_methods: list[str] = ["len", "set", "get_or", "has",
    "keys"]
    let chan_methods: list[str] = ["send", "try_send", "recv",
    "recv_or", "len"]
    let task_methods: list[str] = ["join"]

    let recv_counts: list[int] = [
    receiver_method_count("str", str_methods),
    receiver_method_count("int", int_methods),
    receiver_method_count("float", float_methods),
    receiver_method_count("bool", bool_methods),
    receiver_method_count("list", list_methods),
    receiver_method_count("map", map_methods),
    receiver_method_count("chan", chan_methods),
    receiver_method_count("task", task_methods)]

    if !check_method_law(recv_names, recv_counts) {
        failures = failures + 1
    }

    # the rosters answer to exactly their receiver: a cross-answer
    # is refused. str shares to_str and to_float with int's roster
    # (both receivers convert to text), so the honest cross-count
    # is 2 — task and bool answer to nobody else's roster.
    if receiver_method_count("str", int_methods) != 2 {
        failures = failures + 1
    }
    if receiver_method_count("task", chan_methods) != -1 {
        failures = failures + 1
    }
    if receiver_method_count("bool", str_methods) != -1 {
        failures = failures + 1
    }

    if failures == 0 {
        println("stage 141: api freeze")
        println("  freeze laws OK: drift vocabulary, amendment, digest,")
        println("  chain, count, method roster, contract, state machine")
        return 0
    }
    println("stage 141: api freeze FAILED")
    println("  failures:")
    println(failures.to_str())
    return 1
}
