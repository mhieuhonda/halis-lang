# tests/ok/feat_proc_concat.hls — regression test for v0.20.0-alpha
# double-free bug in proc_exec with fresh-expression argument.
#
# BUG: when `proc_exec(cmd + " " + ip)` is called with a fresh
# expression argument (e.g. a string concat), the codegen hoisted
# the concat into a temporary with __attribute__((cleanup(...))), then
# passed the temporary to hl_proc_exec (which CONSUMES its argument —
# calls hl_str_release). The cleanup attribute released the temporary
# AGAIN at scope exit → double-free → "malloc(): unaligned tcache chunk
# detected" crash. The fix is to mark net_lookup and proc_exec as
# "non-borrowed" (i.e. consume) builtins in builtin_arg_borrowed so
# the codegen treats their argument as transferred (not borrowed).
#
# This test exercises both consume builtins (net_lookup AND proc_exec)
# with a fresh-expression argument. Without the fix, it crashes.

fn net_then_proc(host: str, cmd: str) -> int uses Net, Proc {
    let ip: str = net_lookup(host)
    # `cmd + " " + ip` is a fresh concat expression consumed by proc_exec.
    let rc: int = proc_exec(cmd + " " + ip)
    return rc
}

fn main() -> int uses IO, Net, Proc {
    let rc: int = net_then_proc("localhost", "echo")
    # Multiple printlns with concat — the previous crash happened
    # during the second println due to heap corruption from the
    # double-free in net_then_proc.
    println("hello " + "world")
    println("rc=" + rc.to_str() + " again=" + rc.to_str())
    return 0
}
