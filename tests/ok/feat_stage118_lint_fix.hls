# feat_stage118_lint_fix.hls — Stage 118 (v0.137.0-alpha):
# hllint autofix mode (--fix / --diff).
#
# This file is the runnable half of the gate: it carries one warning
# of every fixable rule that a VALID (checker-clean, runnable) program
# can carry — an unused binding whose value still has to run, an
# unused function, an ignored Result, a `uses` clause the body never
# earns — and prints the markers below. The gate fixes a COPY of this
# file with `hllint --fix` and requires the SAME markers from the
# fixed copy, interpreter and native alike: the autofix must change
# nothing but the lint verdict. (L007 dead code is gate-side only: the
# checker rejects a file that carries it, so a fixture with it could
# not ship in tests/ok/ — the rescue story lives in
# tests/lint_fix_acceptance.py.)
#
#   python3 boot/boot.py tests/ok/feat_stage118_lint_fix.hls
#   python3 tools/hllint.py --fix <a copy of this file>

import "std.result"

# noisy's print is a side effect the binding's value must keep even
# after the L001 autofix renames the binding away.
fn noisy(tag: str) -> int uses IO {
    println("noisy " + tag)
    return tag.len()
}

# orphan2 is never called — the L002 autofix renames its definition
# (an unused function has no call sites to chase).
fn orphan2(x: int) -> int {
    return x + 1
}

# parse_it returns a Result; calling it as a statement is an L004 —
# the autofix binds a discard with the checker's own type text.
fn parse_it(s: str) -> Result[int, int] {
    if s.len() == 0 {
        return Result.Err(1)
    }
    return Result.Ok(s.len())
}

# pure_calc declares IO but touches nothing impure — an L006; the
# autofix deletes the clause and the signature tells the truth.
fn pure_calc(x: int) -> int uses IO {
    return x * 2
}

fn main() -> int uses IO {
    let doomed: int = noisy("one")
    parse_it("hi")
    println("calc " + pure_calc(21).to_str())
    println("len " + noisy("two").to_str())
    return 0
}
