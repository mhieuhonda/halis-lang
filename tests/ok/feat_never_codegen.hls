# feat_never_codegen.hls — verifies BUG-004 fix: never-typed expressions
# (panic/exit, all-never matches) on the RHS of a `let` or `assign`, or
# as the value of a `return`, must compile to valid C (no `void` value
# bound to a variable).

import "std.option"

enum Action { Stop, Go }

fn die_on_stop(a: Action) -> int {
    # All-arms-never match — used as the return value.
    return match a {
        Action.Stop => panic("stopped"),
        Action.Go => panic("internal: unreachable")
    }
}

fn consume(s: str) -> int uses IO {
    let n: int = s.len()
    if n == 0 {
        # `let _ = panic(...)` — RHS is never, no variable is bound.
        let _: int = panic("empty string not allowed")
    }
    return n
}

fn main() -> int uses IO {
    let n: int = consume("hello")
    println("consume(hello)=" + n.to_str())

    # All-arms-never match as expression statement.
    let _: int = die_on_stop(Action.Stop)
    return 0
}
