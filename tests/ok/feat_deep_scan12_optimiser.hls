# Deep-scan-12 regression: tools/ir/optimize.py inline_small no
# longer emits invalid `OP_LOAD ("lit", ...)` for literal call
# arguments (DSS-T-12), and the constant folder no longer folds
# `True == 1` to True (DSS-T-13, HLS bool and int are distinct types).
# This program exercises both: a pure function that returns a
# constant, and a function that returns True/False. The IR optimizer
# should produce correct output identical to the interpreter.

# A pure function that returns a constant — the inliner used to emit
# OP_LOAD ("lit", 42) for the return value, which is invalid IR.
fn answer() -> int pure {
    return 42
}

# A pure function that returns a boolean constant — the constant
# folder used to fold `True == 1` to True (miscompiling bool-typed
# comparisons), and would have folded `True == True` correctly.
fn yes() -> bool pure {
    return true
}

# A pure function that uses its parameter — the inliner used to
# mis-rewrite the parameter's reference to the call's argument
# (correctly) but then emit `OP_LOAD ("lit", X)` for literal args.
fn add_one(x: int) -> int pure {
    return x + 1
}

fn main() -> int uses IO {
    # Calls with literal arguments — both should be inlined and
    # produce correct results. The differential test (interpreter
    # vs native) catches any codegen divergence from the optimizer.
    println(answer().to_str())
    println(yes().to_str())
    println(add_one(99).to_str())
    # A literal-arg call with a bool result — the `True == True`
    # fold should produce True (a bool), not 1 (an int).
    if yes() == true {
        println("bool eq ok")
    } else {
        println("bool eq FAIL")
    }
    return 0
}
