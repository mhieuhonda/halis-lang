# feat_bare_pattern.hls — Stage-17 perfection (deep-scan-10): match
# arm patterns may omit the `Enum.` prefix (SPEC §5 grammar: the
# prefix is optional); the checker resolves the enum from the
# scrutinee's type.
enum Color { Red, Green, Blue }

fn code(c: Color) -> int {
    return match c {
        Red => 1,
        Green => 2,
        Blue => 3,
    }
}

fn main() -> int uses IO {
    let total: int = code(Color.Red) + code(Color.Green) + code(Color.Blue)
    println("total=" + total.to_str())
    return 0
}
