# feat_stage12_release.hls — exercises the Stage 12 release's struct /
# enum / field-access features that the LLVM backend now lowers.

struct Point {
    x: int,
    y: int,
}

enum Color {
    Red,
    Green,
    Blue,
}

fn make_point(x: int, y: int) -> Point {
    return Point { x: x, y: y }
}

fn color_index(c: Color) -> int {
    return match c {
        Color.Red => 0,
        Color.Green => 1,
        Color.Blue => 2,
    }
}

fn main() -> int uses IO {
    let p: Point = make_point(3, 4)
    let c: Color = Color.Green
    println("point: x=" + p.x.to_str() + ", y=" + p.y.to_str())
    println("color index: " + color_index(c).to_str())
    return 0
}
