# Expect: exit 101, panic "mmio_read_field: the field does not fit in a 64-bit register"
# A field ending past bit 63 has no mask; reading it silently returns
# garbage, so the checked accessor refuses instead.
import "core.mmio"

fn main() -> int {
    let f: MmioField = MmioField { shift: 62, width: 4 }
    if mmio_read_field(0, f) != 0 {
        return 1
    }
    return 0
}
