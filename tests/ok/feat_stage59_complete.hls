    println("  Shell kinds: bash / zsh / fish / powershell")
    println("  complete_render(parser, name, shell) dispatcher (pure, no IO)")
    println("  Bash: _init_completion + compgen -W (long/short opts) + compgen -f (files)")
    println("  Zsh: #compdef + _arguments spec + _values for subcommands + value types")
    println("  Fish: complete -c name -l/-s/-d/-r lines + subcommand lines")
    println("  PowerShell: Register-ArgumentCompleter + scriptblock + Get-ChildItem")
    println("  complete_shell_from_str (case-insensitive: bash/sh, zsh, fish, pwsh/ps)")
    println("  complete_escape_bash/zsh/fish (single quote -> '\\'\\'') + powershell (doubled)")
    println("  complete_install_filename (per-shell convention) + complete_install_path")
    println("  complete_is_safe_name (rejects /, .., leading -, spaces, special chars)")
    println("  complete_list_shells (human-readable listing + install paths)")
    println("  complete_install (Fs effect — write_file to canonical path)")
    println("  Pure-HLS implementation (no new compiler builtins)")
    println("  differential (interpreter == native) verified green.")
    return 0
}
