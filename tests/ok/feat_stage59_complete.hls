    println("  ok")
    println("--- complete_escape_bash ---")
    test_escape_bash()
    println("  ok")
    println("--- complete_escape_zsh ---")
    test_escape_zsh()
    println("  ok")
    println("--- complete_escape_fish ---")
    test_escape_fish()
    println("  ok")
    println("--- complete_escape_powershell ---")
    test_escape_powershell()
    println("  ok")
    println("--- complete_install_filename ---")
    test_install_filename()
    println("  ok")
    println("--- complete_install_path ---")
    test_install_path()
    println("  ok")
    println("--- complete_is_safe_name ---")
    test_safe_name()
    println("  ok")
    println("--- complete_list_shells ---")
    test_list_shells()
    println("  ok")
    println("--- complete_install (Fs effect) ---")
