# Expect: exit 101, panic "mmio_region_new: a device window must be page-aligned"
# Stage 87: a device window's BASE must be page-aligned. A mis-computed
# MMIO base is the most damaging bug a driver can have, and the one a
# driver can least afford to discover on the bus.
import "core.mmio"

fn main() -> int {
    let r: MmioRegion = mmio_region_new(67108865, 4096, false)
    if r.base != 67108865 {
        return 1
    }
    return 0
}
