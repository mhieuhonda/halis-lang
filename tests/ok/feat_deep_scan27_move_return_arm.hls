# feat_deep_scan27_move_return_arm.hls — deep-scan-27 regression: hlc's
# move-union logic now REFINES terminating arms out of the post-if
# state (path_terminates — return / break / continue / never-typed
# tail), mirroring the boot checker. Previously hlc rejected this
# pattern with a spurious "use of moved value" on the fall-through use
# of `xs`, even though the only execution path reaching it never moved
# the value (the shipped examples/conc_pipeline.hls worker pattern).
fn pick(xs: list[int], flag: bool) -> int {
    if flag {
        let m: int = xs.len()
        drop(xs)
        return m
    }
    # The then-arm ALWAYS exits (return), so `xs` is still owned here.
    return xs.len()
}

fn pick_nested(xs: list[int], a: bool, b: bool) -> int {
    if a {
        if b {
            drop(xs)
            return -1
        }
        return -2
    }
    return xs.len()
}

fn main() -> int uses IO {
    let xs: list[int] = [10, 20, 30]
    let a: int = pick(xs, false)
    let b: int = pick(clone(xs), true)
    let c: int = pick_nested(clone(xs), false, true)
    let d: int = pick_nested(clone(xs), true, true)
    println(a.to_str())
    println(b.to_str())
    println(c.to_str())
    println(d.to_str())
    return 0
}
