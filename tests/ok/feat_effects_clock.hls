# feat_effects_clock — Stage 9-alpha: fine-grained Clock effect
fn time_now_ms() -> int uses Clock {
    return clock_ms()
}

fn main() -> int uses IO {
    let t1: int = time_now_ms()
    let mut i: int = 0
    let mut acc: int = 0
    while i < 1000 {
        acc = acc + i
        i = i + 1
    }
    let t2: int = time_now_ms()
    let dt: int = t2 - t1
    if dt >= 0 {
        println("clock advanced: ok")
    } else {
        println("clock went backwards!")
        return 1
    }
    return 0
}
