# Stage 10-beta regression test: BUG-4 (str.to_float scientific notation).
# The previous str.to_float rejected any non-digit/non-dot char, including
# 'e'/'E'. So json_parse("1e5") would panic. The fix accepts optional
# scientific notation exponent.
import "std.json"

fn main() -> int uses IO {
    let v: JsonValue = json_parse("1e5")
    if json_is_float(v) {
        let f: float = json_float_value(v)
        println("1e5 = " + f.to_str())
    } else {
        println("1e5 not parsed as float (BUG)")
        return 1
    }

    let v2: JsonValue = json_parse("1.5e-3")
    if json_is_float(v2) {
        let f2: float = json_float_value(v2)
        println("1.5e-3 = " + f2.to_str())
    }

    let v3: JsonValue = json_parse("-2.5E10")
    if json_is_float(v3) {
        let f3: float = json_float_value(v3)
        println("-2.5E10 = " + f3.to_str())
    }
    return 0
}

