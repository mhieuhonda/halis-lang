# feat_conc_send_struct.hls — Stage 16 (v0.27.0-alpha): sending owned
# composites through channels. The boundary ownership rule deep-copies
# values that are not provably private, so no aliasing can leak across
# the task boundary (the sender's mutations are never visible to the
# receiver and vice versa).

struct Job {
    name: str,
    payload: list[int]
}

fn worker(mail: Chan[Job]) -> int uses IO, Conc {
    let j: Job = mail.recv()
    let mut sum: int = 0
    let mut i: int = 0
    while i < j.payload.len() {
        sum = sum + j.payload.get(i)
        i = i + 1
    }
    println("job " + j.name + " sum=" + sum.to_str())
    return sum
}

fn main() -> int uses IO, Conc {
    let mail: Chan[Job] = chan_new()
    let t: Task[int] = spawn(worker, clone(mail))
    # A composite literal is a fresh value — it crosses the boundary as-is.
    mail.send(Job { name: "scan", payload: [1, 2, 3, 4] })
    let r: int = t.join()
    println("result=" + r.to_str())

    # take(x) transfers the binding's value into the channel; the binding
    # is moved afterwards (use is a compile error).
    let mail2: Chan[Job] = chan_new()
    let t2: Task[int] = spawn(worker, clone(mail2))
    let owned: Job = Job { name: "take", payload: [10, 20] }
    mail2.send(take(owned))
    let r2: int = t2.join()
    println("result2=" + r2.to_str())
    return 0
}
