# feat_stage149_rc4.hls — Stage 149 (v1.0.0-rc.4): the fourth release
# candidate, the sign-off.
#
# What this fixture pins is what an RC4 IS — the laws the last
# approval stood on while the surface stayed frozen:
#
#   1. the signature — a signature names its signer and its day, and
#      law             it is cut once: an anonymous approval is not a
#                      signature (a blank name is a usage error), a
#                      candidate without an anchor has nothing to
#                      sign, and a second stroke over a live
#                      signature is refused — one signature per
#                      candidate;
#   2. the green law — a signature lands only on a tree that is green
#                      AT THE SIGNING MOMENT: the readiness laws, the
#                      freeze gate and the clean tree are re-derived
#                      where the signature is cut, and any red law
#                      refuses it with its name;
#   3. the order law  — the signing choreography is an ordered
#                      machine: the markers move, the anchor is cut,
#                      the signature lands, the record renders, the
#                      release commits, the witness checks. A step
#                      runs when its predecessor is done; the one
#                      idempotent step is the record render (the
#                      render is deterministic per state);
#   4. the witness    — `signoff --check` re-derives the verdict at
#      law             every gate: an unsigned candidate says so, a
#                      signature whose laws turned red is refused
#                      with the law's name, and a signature whose
#                      laws are green holds again — the signature is
#                      re-earned, not archived;
#   5. the refusal    — the exit-code classes the kit speaks (0 the
#      taxonomy         law held, 1 a named refusal, 2 a usage error,
#                      101 a runtime panic), and the RC4 rule the
#                      destination law added: an unwritable output
#                      path is a usage error with its name (exit 2),
#                      never a panic (101) — the same law the
#                      compiler's own outputs took in RC2.
#
# The exit-code classes are the C runtime's own: 0 the law held, 1 a
# named refusal, 2 a usage error, 101 a runtime panic. The
# interpreter and the native binary agree on every class.
#
# The program exits 0 when every law holds, 10+section*10+case
# otherwise.

# ----------------------------------------------------------------------
# The order law: the signing choreography's steps, in the only order
# they work. Step ids: 0 the docs (the markers move), 1 the declare
# (the anchor), 2 the signoff (the signature), 3 the record (the
# render), 4 the release (the commit and the tag), 5 the witness (the
# check re-derives).
# ----------------------------------------------------------------------
fn step_name(step: int) -> str {
    if step == 0 {
        return "docs"
    }
    if step == 1 {
        return "declare"
    }
    if step == 2 {
        return "signoff"
    }
    if step == 3 {
        return "record"
    }
    if step == 4 {
        return "release"
    }
    if step == 5 {
        return "witness"
    }
    return ""
}

# may_run(step, completed) — the machine's law: a step runs when its
# predecessor is done and itself is not yet. The one exception is the
# record render: the render is deterministic per state, so rendering
# the record again changes nothing (an idempotent step, not a second
# one).
fn may_run(step: int, completed: int) -> bool {
    if step < 0 || step > 5 {
        return false
    }
    if step <= completed {
        return step == 3
    }
    return step == completed + 1
}

# ----------------------------------------------------------------------
# The signature law: the signing decision table, in the kit's own
# order. The name law is a USAGE error (the invocation was wrong);
# every law after it is a named refusal.
# ----------------------------------------------------------------------
fn sign_verdict(name_blank: bool, anchored: bool, already: bool,
dirty: bool, ready: bool, gate_green: bool) -> str {
    if name_blank {
        return "usage: a signature names its signer"
    }
    if !anchored {
        return "refused: no anchor"
    }
    if already {
        return "refused: one signature per candidate"
    }
    if dirty {
        return "refused: the tree is dirty"
    }
    if !ready {
        return "refused: not ready"
    }
    if !gate_green {
        return "refused: the gate"
    }
    return "signed"
}

# The name law's class: a blank signer is the invocation's fault, not
# the tree's — a usage error, never a refusal.
fn name_law_class() -> str {
    return "USAGE"
}

# The once law: a live signature is not overwritten. The candidate's
# word stands until the candidate itself is re-cut.
fn resign_verdict(already: bool) -> str {
    if already {
        return "refused: one signature per candidate"
    }
    return "signed"
}

# ----------------------------------------------------------------------
# The green law: a signature lands only on a green tree. The readiness
# table is the six laws readiness speaks; the signature is judged on
# ALL of them at once — one red law refuses the whole signature.
# ----------------------------------------------------------------------
fn readiness_law_name(i: int) -> str {
    if i == 0 {
        return "the repo law"
    }
    if i == 1 {
        return "the roadmap law"
    }
    if i == 2 {
        return "the freeze law"
    }
    if i == 3 {
        return "the marker law"
    }
    if i == 4 {
        return "the snapshot law"
    }
    if i == 5 {
        return "the lts law"
    }
    return ""
}

# all_green(laws) — the conjunctive law: the signature reads the whole
# table, and one false speaks for the whole verdict.
fn all_green(a: bool, b: bool, c: bool, d: bool, e: bool,
f: bool) -> bool {
    return a && b && c && d && e && f
}

# ----------------------------------------------------------------------
# The witness law: the check re-derives the verdict. The refusal order
# is the kit's own: an unsigned candidate says so first, then the
# readiness, then the gate, then the record — and the name the check
# speaks is the law that turned red.
# ----------------------------------------------------------------------
fn witness_verdict(signed: bool, ready: bool, gate_green: bool,
record_ok: bool) -> str {
    if !signed {
        return "refused: unsigned"
    }
    if !ready {
        return "refused: readiness"
    }
    if !gate_green {
        return "refused: the gate law"
    }
    if !record_ok {
        return "refused: the record law"
    }
    return "green"
}

# The witness is a re-derivation, not a lookup: the SAME signature
# changes its verdict when the world moves under it.
fn witness_moves(ready_before: bool, ready_after: bool,
gate_before: bool, gate_after: bool) -> bool {
    let before: str = witness_verdict(true, ready_before, gate_before,
    true)
    let after: str = witness_verdict(true, ready_after, gate_after,
    true)
    return before != after
}

# ----------------------------------------------------------------------
# The refusal taxonomy: the classes a tool's exit codes name (the
# classes RC2 drew for the compiler, RC4 extends to the kit's own
# outputs).
#   0    the law held
#   1    a named refusal (a law spoke)
#   2    a usage error (the invocation was wrong)
#   101  a runtime panic (the program ran and tripped)
# ----------------------------------------------------------------------
fn class_of_exit(code: int) -> str {
    if code == 0 {
        return "OK"
    }
    if code == 1 {
        return "REFUSAL"
    }
    if code == 2 {
        return "USAGE"
    }
    if code == 101 {
        return "PANIC"
    }
    return "UNKNOWN"
}

# dest_verdict(out_is_dir, parent_exists) — the destination law: an
# output path is judged BEFORE the work, with its name. A directory
# sitting where the file would be, and a parent that does not exist,
# are both the invocation's fault — usage errors, never panics.
fn dest_verdict(out_is_dir: bool, parent_exists: bool) -> str {
    if out_is_dir {
        return "refused: a directory sits there"
    }
    if !parent_exists {
        return "refused: the directory does not exist"
    }
    return "written"
}

# The destination refusals name their class: exit 2, both of them —
# the panic class (101) is reserved for a program that RAN and
# tripped, and a destination check that fires before the render is
# not that.
fn dest_exit_class(out_is_dir: bool, parent_exists: bool) -> str {
    let v: str = dest_verdict(out_is_dir, parent_exists)
    if v == "written" {
        return "OK"
    }
    return "USAGE"
}

# ----------------------------------------------------------------------
# The anchor's own shape: the signature rides IN the anchor, between
# sha and stage — alphabetical, like every other field — and an
# unsigned anchor renders exactly the bytes declare wrote.
# ----------------------------------------------------------------------
fn anchor_field_name(i: int) -> str {
    if i == 0 {
        return "day"
    }
    if i == 1 {
        return "freeze_digest"
    }
    if i == 2 {
        return "kit"
    }
    if i == 3 {
        return "next"
    }
    if i == 4 {
        return "sha"
    }
    if i == 5 {
        return "signoff"
    }
    if i == 6 {
        return "stage"
    }
    if i == 7 {
        return "tag"
    }
    return ""
}

# signoff_slot(signed) — the field index the signature occupies: 5
# when the anchor is signed, absent (here: -1) when it is not.
fn signoff_slot(signed: bool) -> int {
    if signed {
        return 5
    }
    return -1
}

# ======================================================================
# The tests.
# ======================================================================

fn test_signature() -> int {
    # the name law: a blank signer is a usage error, whatever the tree
    if sign_verdict(true, true, false, false, true, true)
    != "usage: a signature names its signer" {
        return 1
    }
    if name_law_class() != "USAGE" {
        return 2
    }
    # the anchor law: no anchor, nothing to sign
    if sign_verdict(false, false, false, false, true, true)
    != "refused: no anchor" {
        return 3
    }
    # the once law: a live signature is not overwritten
    if resign_verdict(true) != "refused: one signature per candidate" {
        return 4
    }
    if resign_verdict(false) != "signed" {
        return 5
    }
    # the tree law: a signature judges a committed tree
    if sign_verdict(false, true, false, true, true, true)
    != "refused: the tree is dirty" {
        return 6
    }
    # the green law: a red readiness refuses the whole signature
    if sign_verdict(false, true, false, false, false, true)
    != "refused: not ready" {
        return 7
    }
    # the gate law: commits outside the freeze are not covered
    if sign_verdict(false, true, false, false, true, false)
    != "refused: the gate" {
        return 8
    }
    # the landing: every law green, the signature cuts
    if sign_verdict(false, true, false, false, true, true) != "signed" {
        return 9
    }
    return 0
}

fn test_green() -> int {
    # the conjunctive law: all six hold
    if !all_green(true, true, true, true, true, true) {
        return 1
    }
    # one red law speaks for the whole verdict — each of them
    if all_green(false, true, true, true, true, true) {
        return 2
    }
    if all_green(true, false, true, true, true, true) {
        return 3
    }
    if all_green(true, true, false, true, true, true) {
        return 4
    }
    if all_green(true, true, true, false, true, true) {
        return 5
    }
    if all_green(true, true, true, true, false, true) {
        return 6
    }
    if all_green(true, true, true, true, true, false) {
        return 7
    }
    # the laws are named, in the order readiness speaks them
    if readiness_law_name(0) != "the repo law" {
        return 8
    }
    if readiness_law_name(3) != "the marker law" {
        return 9
    }
    if readiness_law_name(5) != "the lts law" {
        return 10
    }
    if readiness_law_name(6) != "" {
        return 11
    }
    return 0
}

fn test_order() -> int {
    # the machine: each step runs exactly when its predecessor is done
    if !may_run(0, -1) {
        return 1
    }
    if !may_run(1, 0) {
        return 2
    }
    if !may_run(2, 1) {
        return 3
    }
    if !may_run(5, 4) {
        return 4
    }
    # a step ahead of the world does not run
    if may_run(3, 1) {
        return 5
    }
    # the one idempotent step: the record render, deterministic per
    # state — re-rendering changes nothing
    if !may_run(3, 3) {
        return 6
    }
    if may_run(2, 2) {
        return 7
    }
    if may_run(4, 4) {
        return 8
    }
    # out of range is no step at all
    if may_run(6, 5) {
        return 9
    }
    if may_run(-1, 0) {
        return 10
    }
    # the names the machine speaks
    if step_name(2) != "signoff" {
        return 11
    }
    if step_name(5) != "witness" {
        return 12
    }
    return 0
}

fn test_witness() -> int {
    # the unsigned law: the check says so, named
    if witness_verdict(false, true, true, true) != "refused: unsigned" {
        return 1
    }
    # the re-derivation laws: each red law named, in the kit's order
    if witness_verdict(true, false, true, true)
    != "refused: readiness" {
        return 2
    }
    if witness_verdict(true, true, false, true)
    != "refused: the gate law" {
        return 3
    }
    if witness_verdict(true, true, true, false)
    != "refused: the record law" {
        return 4
    }
    # the green re-derivation: the signature holds again
    if witness_verdict(true, true, true, true) != "green" {
        return 5
    }
    # the witness moves: the SAME signature changes its verdict when
    # the world moves under it — re-earned, not archived
    if !witness_moves(true, false, true, true) {
        return 6
    }
    if !witness_moves(true, true, true, false) {
        return 7
    }
    if witness_moves(true, true, true, true) {
        return 8
    }
    return 0
}

fn test_taxonomy() -> int {
    # the classes the kit speaks
    if class_of_exit(0) != "OK" {
        return 1
    }
    if class_of_exit(1) != "REFUSAL" {
        return 2
    }
    if class_of_exit(2) != "USAGE" {
        return 3
    }
    if class_of_exit(101) != "PANIC" {
        return 4
    }
    # the destination law: both refusals named
    if dest_verdict(true, true) != "refused: a directory sits there" {
        return 5
    }
    if dest_verdict(false, false)
    != "refused: the directory does not exist" {
        return 6
    }
    if dest_verdict(false, true) != "written" {
        return 7
    }
    # and both are USAGE — never a panic; the check fires before the
    # work, and a panic is for a program that ran and tripped
    if dest_exit_class(true, true) != "USAGE" {
        return 8
    }
    if dest_exit_class(false, false) != "USAGE" {
        return 9
    }
    if dest_exit_class(false, true) != "OK" {
        return 10
    }
    return 0
}

fn test_anchor() -> int {
    # the anchor's field order, alphabetical: the signature's slot
    if anchor_field_name(4) != "sha" {
        return 1
    }
    if anchor_field_name(5) != "signoff" {
        return 2
    }
    if anchor_field_name(6) != "stage" {
        return 3
    }
    # a signed anchor carries the signature at its slot
    if signoff_slot(true) != 5 {
        return 4
    }
    # an unsigned anchor carries no signoff field at all — declare's
    # bytes are the bytes an unsigned anchor renders
    if signoff_slot(false) != -1 {
        return 5
    }
    return 0
}

fn main() -> int uses IO {
    println("stage 149: v1.0.0-rc.4")
    let mut r: int = test_signature()
    if r != 0 {
        return 10 + r
    }
    r = test_green()
    if r != 0 {
        return 20 + r
    }
    r = test_order()
    if r != 0 {
        return 30 + r
    }
    r = test_witness()
    if r != 0 {
        return 40 + r
    }
    r = test_taxonomy()
    if r != 0 {
        return 50 + r
    }
    r = test_anchor()
    if r != 0 {
        return 60 + r
    }
    println("  RC4 laws OK: signature, green, order, witness, refusal, "
    + "anchor")
    return 0
}
