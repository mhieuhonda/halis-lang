# Regression tests for Stage 15-beta deep scan fixes.
# Each test exercises a specific bug that was found and fixed during the
# deep codebase scan, so the fix cannot silently regress later.

import "std.result"

# ------------------------------------------------------------------
# BUG-SC-2: match arm bindings may shadow outer bindings (SPEC section 5).
# ------------------------------------------------------------------
fn test_match_shadow() -> int {
    let x: int = 100
    let r: Result[int, str] = Result.Ok(7)
    return match r {
        Result.Ok(x) => x + 1,        # `x` shadows the outer `x`
        Result.Err(_) => 0,
    }
}

# ------------------------------------------------------------------
# BUG-SC-5: `let`/`assign` with `never` RHS diverges (no return needed).
# ------------------------------------------------------------------
fn diverges_via_let() -> int {
    let x: int = panic("boom")
}

fn diverges_via_assign() -> int uses Exit {
    let mut y: int = 0
    y = exit(1)
}

# ------------------------------------------------------------------
# BUG-SC-3: take() as an argument to a generic function must not
# spuriously fail with "use of moved value" due to double-checking.
# (The list-literal variant of this bug is the same root cause; we
# test it via a generic function call here because the native codegen
# has a separate issue with list literals referencing locals.)
# ------------------------------------------------------------------
fn identity[T](x: T) -> T {
    return x
}

fn take_first_elem() -> int {
    let s: str = "hello"
    let t: str = identity(take(s))
    return t.len()
}

# ------------------------------------------------------------------
# BUG-SC-4: for-loop body may shrink the list without crashing.
# ------------------------------------------------------------------
fn for_loop_shrink() -> int {
    let xs: list[int] = [1, 2, 3, 4, 5]
    let mut sum: int = 0
    for x: int in xs {
        sum = sum + x
        if x == 3 {
            xs.pop()     # shrink the list mid-iteration
        }
    }
    return sum
}

# ------------------------------------------------------------------
# BUG-SC-13: struct field default values are type-checked at declaration.
# (Negative case tested in fail/fail_struct_default_type.hls)
# ------------------------------------------------------------------
struct Counter {
    count: int = 0,
    name: str = "default",
}

fn struct_defaults_ok() -> int {
    let c: Counter = Counter { count: 5 }
    return c.count + c.name.len()
}

fn main() -> int uses IO {
    let mut n: int = 0
    n = n + test_match_shadow()                 # expect 8
    n = n + take_first_elem()                    # expect 2
    n = n + for_loop_shrink()                    # expect 1+2+3+4 = 10 (pop stops last)
    n = n + struct_defaults_ok()                 # expect 5 + 7 = 12
    println(str(n))
    # diverges_via_let / diverges_via_assign are not called here; they
    # exist only to verify the checker ACCEPTS them (no "does not return
    # on all paths" error).
    return 0
}
