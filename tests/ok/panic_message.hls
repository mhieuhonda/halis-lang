# Expect: exit 101, panic with a custom message, printed to stderr
fn check_age(age: int) -> int {
    if age < 0 {
        panic("age cannot be negative")
    }
    return age
}

fn main() -> int uses IO {
    println("checking age...")
    let t: int = check_age(-1)
    println("age = " + t.to_str())
    return 0
}
