# Kỳ vọng: exit 101, panic với thông điệp tùy chỉnh, in ra stderr
fn kiem_tra_tuoi(tuoi: int) -> int {
    if tuoi < 0 {
        panic("tuoi khong the am")
    }
    return tuoi
}

fn main() -> int uses IO {
    println("kiem tra tuoi...")
    let t: int = kiem_tra_tuoi(-1)
    println("tuoi = " + t.to_str())
    return 0
}
