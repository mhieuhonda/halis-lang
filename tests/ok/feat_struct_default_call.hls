# feat_struct_default_call — Stage deep-scan-4 regression (BUG-DS4-2):
# struct field defaults may call (pure) functions. The checker used to
# crash with `KeyError: None` on any default containing a call because the
# call graph had no node for struct-default checking. The interpreter and
# the C backend both evaluate defaults in the calling context, so calling
# a pure function from a default must work end-to-end.
fn one() -> int {
    return 1
}

fn default_tag(prefix: str) -> str {
    return prefix + "-default"
}

struct Config {
    retries: int,
    offset: int = one(),
    tag: str = default_tag("cfg")
}

fn main() -> int uses IO {
    # Fully-specified literal: defaults are not evaluated, values used.
    let a: Config = Config { retries: 3, offset: 10, tag: "explicit" }
    # Partial literal: `offset` and `tag` come from the default exprs.
    let b: Config = Config { retries: 5 }
    println("a.offset=" + a.offset.to_str() + " a.tag=" + a.tag)
    println("b.offset=" + b.offset.to_str() + " b.tag=" + b.tag)
    if a.offset == 10 && b.offset == 1 && b.tag == "cfg-default" {
        println("defaults ok")
        return 0
    }
    return 1
}
