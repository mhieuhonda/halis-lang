# feat_proof_sound_lelen.hls — Stage-17 perfection (deep-scan-10)
# soundness regression: `i <= xs.len()` must NOT prove xs[i] (i == len
# is out of bounds; the old engine ignored the strict/non-strict
# distinction entirely). Both implementations must panic identically
# (101).
fn get(xs: list[int], i: int) -> int
    requires i >= 0
    requires i <= xs.len()
{
    return xs[i]
}
fn main() -> int {
    let xs: list[int] = [10, 20, 30]
    return get(xs, 3)
}
