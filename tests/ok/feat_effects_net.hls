# tests/ok/feat_effects_net.hls — Stage 9 release (v0.20.0-alpha).
#
# Demonstrates the newly-activated Net effect: net_lookup() resolves a
# hostname to its first IPv4 address. The program declares `uses Net`
# (and `uses IO` for println) — a function WITHOUT `uses Net` cannot
# call net_lookup() even through five function layers (see the
# corresponding fail test, fail_effect_net_missing).

fn resolve(host: str) -> str uses Net {
    return net_lookup(host)
}

fn main() -> int uses IO, Net {
    let ip: str = resolve("localhost")
    println("localhost -> " + ip)
    return 0
}
