# Expect: exit 101, panic "mem_region_new: length must be >= 0"
# A region of negative size is a firmware bug; letting it through makes
# mem_region_end smaller than its base, so every "does this region
# contain x" answer is wrong in the one direction that matters.
import "core.boot"

fn main() -> int {
    let r: MemRegion = mem_region_new(4096, -8, MemKind.Usable)
    if r.length != 0 {
        return 1
    }
    return 0
}
