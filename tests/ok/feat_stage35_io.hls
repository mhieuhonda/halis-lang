# tests/ok/feat_stage35_io.hls — Stage 35 (v0.54.0-alpha): std.io module.
#
# Exercises every type and method:
#   - Cursor: read_byte, read_str, read_until, read_line, position,
#     length, remaining, is_eof, peek_byte, seek, rewind, buffer,
#     write_byte, write_str, write_str_at, flush
#   - BufReader: read_byte, read_str, read_until, read_line, position,
#     length, remaining, is_eof, peek_byte, path, buffer
#   - BufWriter: write_byte, write_str, flush, path, pending_len,
#     is_flushed
#   - Chain: read_byte, read_str, read_until, position, length,
#     remaining, is_eof, num_readers
#   - helpers: io_read_all_cursor, io_read_all_bufreader,
#     io_read_all_chain, io_read_lines_cursor, io_read_lines_bufreader
#   - hex: io_to_hex, io_from_hex
#
# The test writes a fixture file via write_file (existing builtin), reads
# it back via BufReader, writes a computed file via BufWriter + flush,
# reads it back via BufReader, and verifies every output.

import "std.io"
import "std.option"
import "std.str"

# ============================================================================
# Section 1: Cursor — in-memory Read + Write.
# ============================================================================

fn test_cursor() -> int uses IO {
    let c: Cursor = cursor_new("Hello, Halis!")
    if c.length() != 13 {
        panic("Cursor.length")
    }
    if c.remaining() != 13 {
        panic("Cursor.remaining")
    }
    if c.position() != 0 {
        panic("Cursor.position initial")
    }

    # read_byte
    let b: Option[int] = c.read_byte()
    let bv: int = match b { Option.Some(v) => v, Option.None => -1 }
    if bv != 72 {
        panic("Cursor.read_byte: expected 72 (H), got " + bv.to_str())
    }
    if c.position() != 1 {
        panic("Cursor.position after read_byte")
    }

    # read_str
    let s: str = c.read_str(5)
    if s != "ello," {
        panic("Cursor.read_str(5): expected 'ello,', got '" + s + "'")
    }
    if c.position() != 6 {
        panic("Cursor.position after read_str(5)")
    }
    if c.remaining() != 7 {
        panic("Cursor.remaining after read_str(5)")
    }

    # peek_byte
    let p: Option[int] = c.peek_byte()
    let pv: int = match p { Option.Some(v) => v, Option.None => -1 }
    if pv != 32 {
        panic("Cursor.peek_byte: expected 32 (space), got " + pv.to_str())
    }
    if c.position() != 6 {
        panic("Cursor.position after peek_byte (should not advance)")
    }

    # read at EOF
    let c2: Cursor = cursor_new("hi")
    let _b1: Option[int] = c2.read_byte()
    let _b2: Option[int] = c2.read_byte()
    let b3: Option[int] = c2.read_byte()
    let b3_some: bool = match b3 { Option.Some(_) => true, Option.None => false }
    if b3_some {
        panic("Cursor.read_byte at EOF should return None")
    }
    if !c2.is_eof() {
        panic("Cursor.is_eof should be true after consuming all bytes")
    }

    # read_str at EOF returns short read
    let c3: Cursor = cursor_new("ab")
    let rs: str = c3.read_str(100)
    if rs != "ab" {
        panic("Cursor.read_str past EOF: expected 'ab', got '" + rs + "'")
    }
    let rs2: str = c3.read_str(100)
    if rs2 != "" {
        panic("Cursor.read_str at EOF should return ''")
    }

    # read_until
    let u: Cursor = cursor_new("key=val;next")
    let first: str = u.read_until(59)  # ';'
    if first != "key=val;" {
        panic("Cursor.read_until(';'): expected 'key=val;', got '" + first + "'")
    }
    let second: str = u.read_until(59)
    if second != "next" {
        panic("Cursor.read_until(';') at EOF: expected 'next', got '" + second + "'")
    }

    # read_line — strip \n and \r\n. HLS string literals don't support
    # \r, so we build the CRLF test with chr(13).
    let crlf: str = "line1\nline2" + chr(13) + "\nline3"
    let l: Cursor = cursor_new(crlf)
    if l.read_line() != "line1" {
        panic("Cursor.read_line 1")
    }
    if l.read_line() != "line2" {
        panic("Cursor.read_line 2 (CRLF)")
    }
    if l.read_line() != "line3" {
        panic("Cursor.read_line 3")
    }
    if l.read_line() != "" {
        panic("Cursor.read_line at EOF should be ''")
    }

    # seek + rewind
    let r: Cursor = cursor_new("abcdef")
    let _d: str = r.read_str(3)
    if r.position() != 3 {
        panic("Cursor.position after read_str(3)")
    }
    r.rewind()
    if r.position() != 0 {
        panic("Cursor.rewind")
    }
    let all: str = r.read_str(6)
    if all != "abcdef" {
        panic("Cursor after rewind: expected 'abcdef', got '" + all + "'")
    }

    # seek past end panics — test via a separate cursor (we can't catch
    # panics; we just don't trigger it here).

    # write_byte + write_str (append semantics)
    let w: Cursor = cursor_empty()
    w.write_str("hello")
    if w.buffer() != "hello" {
        panic("Cursor.write_str: buffer should be 'hello'")
    }
    if w.length() != 5 {
        panic("Cursor.length after write_str")
    }
    w.write_str(" ")
    w.write_byte(119)  # 'w'
    w.write_byte(111)  # 'o'
    w.write_byte(114)  # 'r'
    w.write_byte(108)  # 'l'
    w.write_byte(100)  # 'd'
    if w.buffer() != "hello world" {
        panic("Cursor writes: expected 'hello world', got '" + w.buffer() + "'")
    }
    if w.length() != 11 {
        panic("Cursor.length after writes: expected 11, got " + w.length().to_str())
    }

    # write_str_at (back-patch)
    let pp: Cursor = cursor_empty()
    pp.write_str("00")        # placeholder
    pp.write_str(":payload")  # body
    pp.write_str_at("12", 0)  # overwrite "00" with "12"
    if pp.buffer() != "12:payload" {
        panic("Cursor.write_str_at: expected '12:payload', got '" + pp.buffer() + "'")
    }

    # flush is a no-op (provided for trait uniformity)
    w.flush()

    # io_read_all_cursor
    let r2: Cursor = cursor_new("abc")
    let all2: str = io_read_all_cursor(r2)
    if all2 != "abc" {
        panic("io_read_all_cursor: expected 'abc', got '" + all2 + "'")
    }
    return 0
}

# ============================================================================
# Section 2: BufReader — buffered file reader.
# ============================================================================

fn test_buf_reader() -> int uses IO, Fs {
    # Write a fixture file using write_file (existing builtin).
    write_file("/tmp/halis_stage35_io_test.txt", "alpha\nbeta\ngamma\ndelta\n")

    let r: BufReader = buf_reader_from_file("/tmp/halis_stage35_io_test.txt")
    if r.path() != "/tmp/halis_stage35_io_test.txt" {
        panic("BufReader.path")
    }
    if r.length() != 23 {
        panic("BufReader.length: expected 23, got " + r.length().to_str())
    }

    # read_line
    if r.read_line() != "alpha" {
        panic("BufReader.read_line 1")
    }

    # read_str (3 bytes from "beta")
    if r.read_str(3) != "bet" {
        panic("BufReader.read_str")
    }

    # remaining content: "a\ngamma\ndelta\n" (14 bytes: 'a' + '\n' + 'gamma\n' + 'delta\n')
    if r.remaining() != 14 {
        panic("BufReader.remaining: expected 14, got " + r.remaining().to_str())
    }

    # io_read_lines_bufreader (new reader)
    let r2: BufReader = buf_reader_from_file("/tmp/halis_stage35_io_test.txt")
    let lines: list[str] = io_read_lines_bufreader(r2)
    if lines.len() != 4 {
        panic("io_read_lines_bufreader: expected 4 lines, got " + lines.len().to_str())
    }
    if lines.get(0) != "alpha" { panic("io_read_lines_bufreader line 0") }
    if lines.get(1) != "beta" { panic("io_read_lines_bufreader line 1") }
    if lines.get(2) != "gamma" { panic("io_read_lines_bufreader line 2") }
    if lines.get(3) != "delta" { panic("io_read_lines_bufreader line 3") }

    # buf_reader_from_str — in-memory variant
    let mr: BufReader = buf_reader_from_str("in-memory")
    if mr.path() != "<memory>" {
        panic("buf_reader_from_str path")
    }
    if mr.length() != 9 {
        panic("buf_reader_from_str length")
    }
    let mline: str = mr.read_str(9)
    if mline != "in-memory" {
        panic("buf_reader_from_str read_str")
    }
    return 0
}

# ============================================================================
# Section 3: BufWriter — buffered file writer.
# ============================================================================

fn test_buf_writer() -> int uses IO, Fs {
    let w: BufWriter = buf_writer_new("/tmp/halis_stage35_io_out.txt")
    if w.path() != "/tmp/halis_stage35_io_out.txt" {
        panic("BufWriter.path")
    }
    if !w.is_flushed() {
        panic("BufWriter.is_flushed should be true initially")
    }
    if w.pending_len() != 0 {
        panic("BufWriter.pending_len should be 0 initially")
    }

    w.write_str("first line\n")
    w.write_str("second line\n")
    w.write_byte(116)  # 't'
    w.write_byte(104)  # 'h'
    w.write_byte(105)  # 'i'
    w.write_byte(114)  # 'r'
    w.write_byte(100)  # 'd'
    w.write_str(" line\n")

    if w.is_flushed() {
        panic("BufWriter.is_flushed should be false after writes")
    }
    if w.pending_len() != 34 {
        panic("BufWriter.pending_len: expected 34, got " + w.pending_len().to_str())
    }

    w.flush()
    if !w.is_flushed() {
        panic("BufWriter.is_flushed should be true after flush")
    }
    if w.pending_len() != 0 {
        panic("BufWriter.pending_len should be 0 after flush")
    }

    # Verify by reading back via BufReader.
    let r: BufReader = buf_reader_from_file("/tmp/halis_stage35_io_out.txt")
    let content: str = io_read_all_bufreader(r)
    let expected: str = "first line\nsecond line\nthird line\n"
    if content != expected {
        panic("BufWriter content mismatch: expected [" + expected + "], got [" + content + "]")
    }
    return 0
}

# ============================================================================
# Section 4: Chain — concatenate multiple Cursor readers.
# ============================================================================

fn test_chain() -> int uses IO {
    let a: Cursor = cursor_new("AAAA")
    let b: Cursor = cursor_new("BB")
    let c: Cursor = cursor_new("CCCCC")
    let ch: Chain = chain_new([a, b, c])

    if ch.num_readers() != 3 {
        panic("Chain.num_readers")
    }
    if ch.length() != 11 {
        panic("Chain.length: expected 11, got " + ch.length().to_str())
    }

    # read_str across boundary
    let first5: str = ch.read_str(5)
    if first5 != "AAAAB" {
        panic("Chain.read_str(5): expected 'AAAAB', got '" + first5 + "'")
    }

    # read 6 more (spans into the third cursor)
    let next6: str = ch.read_str(6)
    if next6 != "BCCCCC" {
        panic("Chain.read_str(6): expected 'BCCCCC', got '" + next6 + "'")
    }

    # read the rest (EOF)
    let rest: str = ch.read_str(100)
    if rest != "" {
        panic("Chain.read_str at EOF: expected '', got '" + rest + "'")
    }
    if !ch.is_eof() {
        panic("Chain.is_eof should be true")
    }

    # read_until across boundary
    let x: Cursor = cursor_new("xx")
    let y: Cursor = cursor_new("yy\n")
    let ch2: Chain = chain_new([x, y])
    let u: str = ch2.read_until(10)  # '\n'
    if u != "xxyy\n" {
        panic("Chain.read_until('\\n'): expected 'xxyy\\n', got '" + u + "'")
    }

    # io_read_all_chain
    let p: Cursor = cursor_new("hel")
    let q: Cursor = cursor_new("lo")
    let ch3: Chain = chain_new([p, q])
    let all: str = io_read_all_chain(ch3)
    if all != "hello" {
        panic("io_read_all_chain: expected 'hello', got '" + all + "'")
    }

    # io_read_lines_cursor
    let lc: Cursor = cursor_new("a\nb\nc")
    let lines: list[str] = io_read_lines_cursor(lc)
    if lines.len() != 3 {
        panic("io_read_lines_cursor: expected 3 lines, got " + lines.len().to_str())
    }
    if lines.get(0) != "a" { panic("io_read_lines_cursor line 0") }
    if lines.get(1) != "b" { panic("io_read_lines_cursor line 1") }
    if lines.get(2) != "c" { panic("io_read_lines_cursor line 2") }
    return 0
}

# ============================================================================
# Section 5: hex helpers.
# ============================================================================

fn test_hex() -> int uses IO {
    # Encode
    if io_to_hex(cursor_new("")) != "" {
        panic("io_to_hex('')")
    }
    if io_to_hex(cursor_new("Hi")) != "4869" {
        let h: str = io_to_hex(cursor_new("Hi"))
        panic("io_to_hex('Hi'): expected '4869', got '" + h + "'")
    }
    # bytes: chr(255) chr(254) -> "fffe"
    let bs: str = chr(255) + chr(254)
    if io_to_hex(cursor_new(bs)) != "fffe" {
        let h: str = io_to_hex(cursor_new(bs))
        panic("io_to_hex(bytes): expected 'fffe', got '" + h + "'")
    }

    # Round-trip
    let original: Cursor = cursor_new("Hello, Halis!")
    let encoded: str = io_to_hex(original)
    let decoded: Cursor = io_from_hex(encoded)
    let back: str = decoded.buffer()
    if back != "Hello, Halis!" {
        panic("hex round-trip: expected 'Hello, Halis!', got '" + back + "'")
    }

    # Hex of a 4-byte prefix
    let cur: Cursor = cursor_new("Hello, Halis!")
    let first4: str = cur.read_str(4)
    let hex_first4: str = io_to_hex(cursor_new(first4))
    if hex_first4 != "48656c6c" {
        panic("hex_first4: expected '48656c6c', got '" + hex_first4 + "'")
    }
    return 0
}

# ============================================================================
# Section 6: Integration — build a CSV file via BufWriter, parse via
# BufReader + Cursor.
# ============================================================================

fn test_pipeline() -> int uses IO, Fs {
    let names: list[str] = ["alice", "bob", "carol"]
    let values: list[int] = [10, 20, 30]

    let w: BufWriter = buf_writer_new("/tmp/halis_stage35_pipe.csv")
    w.write_str("name,value\n")
    let mut i: int = 0
    while i < names.len() {
        w.write_str(names.get(i))
        w.write_str(",")
        w.write_str(values.get(i).to_str())
        w.write_str("\n")
        i = i + 1
    }
    w.flush()

    let r: BufReader = buf_reader_from_file("/tmp/halis_stage35_pipe.csv")
    let lines: list[str] = io_read_lines_bufreader(r)
    if lines.len() != 4 {
        panic("pipeline: expected 4 lines, got " + lines.len().to_str())
    }
    if lines.get(0) != "name,value" { panic("pipeline line 0") }
    if lines.get(1) != "alice,10" { panic("pipeline line 1") }
    if lines.get(2) != "bob,20" { panic("pipeline line 2") }
    if lines.get(3) != "carol,30" { panic("pipeline line 3") }

    # Use a Cursor to parse one line in memory.
    let sample: Cursor = cursor_new("alice,10")
    let name_with_comma: str = sample.read_until(44)  # ','
    if name_with_comma != "alice," {
        panic("pipeline parse: expected 'alice,', got '" + name_with_comma + "'")
    }
    let value: str = io_read_all_cursor(sample)
    if value != "10" {
        panic("pipeline parse value: expected '10', got '" + value + "'")
    }
    return 0
}

fn main() -> int uses IO, Fs {
    if test_cursor() != 0 { return 1 }
    if test_buf_reader() != 0 { return 2 }
    if test_buf_writer() != 0 { return 3 }
    if test_chain() != 0 { return 4 }
    if test_hex() != 0 { return 5 }
    if test_pipeline() != 0 { return 6 }
    println("stage35 io ok")
    return 0
}
