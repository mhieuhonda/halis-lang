# feat_conc_deadlock_detect.hls — Stage 16 (v0.27.0-alpha): the runtime
# deadlock detector. When EVERY thread that could produce work is blocked
# on a channel operation and no messages are pending anywhere, the
# program can never make progress — the runtime halts with a clean panic
# (exit code 101) instead of hanging forever. Both the interpreter and
# the native binary detect the same condition.

fn blocked_worker(ch: Chan[int]) -> int uses Conc {
    # This recv can never be satisfied: nobody will ever send on ch.
    let v: int = ch.recv()
    return v
}

fn main() -> int uses IO, Conc {
    let ch: Chan[int] = chan_new()
    let t: Task[int] = spawn(blocked_worker, clone(ch))
    # main joins a task that is blocked forever => deadlock detected.
    let r: int = t.join()
    println("unreachable=" + r.to_str())
    return 0
}
