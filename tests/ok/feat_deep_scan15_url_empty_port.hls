# Deep-scan-15 regression: std/url.hls empty-port consistency.
#
# The previous implementation panicked on an empty port after ':' in
# the IPv6 path (e.g. `http://[::1]:`) but silently left port=0 on
# the non-IPv6 path (e.g. `http://host:/`). Same input shape, opposite
# behavior — a latent divergence bug. The new implementation panics
# on both paths consistently.
#
# This test file is in tests/fail/ because we expect the parser to
# reject the malformed input with a clean panic, NOT silently produce
# a Url with port=0.

import "std.url"

fn main() -> int uses IO {
    let u: Url = url_parse("http://host:/")
    println("port=" + u.port.to_str())
    return 0
}
