# feat_deep_scan28_loop_edges.hls — deep-scan-28: break/continue edges
# and the loop-top condition re-check must reject UNSOUND move patterns
# (fail_uaf_break_revive / fail_uaf_continue / fail_uaf_loop_cond) while
# keeping every sound pattern working. This program exercises the sound
# side of each rule and must produce byte-identical output on the boot
# interpreter and the native binary.
fn main() -> int uses IO {
    # (1) drop-then-revive in a loop body (no break/continue): still fine.
    let mut xs: list[int] = [1]
    let mut i: int = 0
    while i < 3 {
        i = i + 1
        let _: list[int] = take(xs)
        xs = [i]
    }
    println("A" + xs.len().to_str())

    # (2) break edge with NO move: binding stays alive after the loop.
    let mut ys: list[int] = [4, 5]
    let mut j: int = 0
    while j < 10 {
        j = j + 1
        if j > 2 { break }
    }
    println("B" + (ys.len() + j).to_str())

    # (3) break edge BEFORE the move, revive after: the break path
    # observes the pre-move state; the fall-through path revives.
    let mut zs: list[int] = [8]
    let mut k: int = 0
    while k < 5 {
        k = k + 1
        if k == 2 { break }
        let _: list[int] = take(zs)
        zs = [k]
    }
    println("C" + zs.len().to_str())

    # (4) continue edge with NO move: nothing feeds a moved state into
    # the next iteration.
    let mut acc: int = 0
    let mut m: int = 0
    while m < 6 {
        m = m + 1
        if m == 2 { continue }
        acc = acc + m
    }
    println("D" + acc.to_str())

    # (5) move + revive on BOTH paths (continue arm revives too): the
    # continue edge carries an unmoved state, so the next iteration is
    # sound and must be accepted.
    let mut ws: list[int] = [2]
    let mut n: int = 0
    while n < 4 {
        n = n + 1
        if n == 2 {
            let _: list[int] = take(ws)
            ws = [n]
            continue
        }
        ws = [n]
    }
    println("E" + ws.len().to_str())
    return 0
}
