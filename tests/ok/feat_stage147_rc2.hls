# feat_stage147_rc2.hls — Stage 147 (v1.0.0-rc.2): the second release
# candidate, the bug-fix round.
#
# What this fixture pins is what an RC2 IS — the laws the successor
# candidate stands on while the surface stays frozen:
#
#   1. the successor  — rc.2 is rc.1's successor on the road the
#      chain            anchor records (`next`): every candidate sorts
#                       strictly after its predecessor, rc.4's
#                       successor is the release itself, and the
#                       release outranks every candidate of its line;
#   2. the refusal    — the RC2 bug-fix round drew the line between
#      taxonomy         the failure CLASSES a tool must keep apart:
#                       an invocation error (a missing input file, an
#                       unwritable destination) is a NAMED refusal
#                       (exit 2, `error: ...` naming the path), not a
#                       runtime panic (exit 101) and not a compile
#                       error (exit 1); the taxonomy is the contract
#                       the RC2 fixes restored;
#   3. the diff-gate  — past the freeze a fix that grows the surface
#      re-class law     is the FEATURE it really is: a `fix:` commit
#                       adding a std/ or core/ file, naming a new
#                       public fn, or editing SPEC.md does not land
#                       (the rules may move through the amendment
#                       chain, not through a fix);
#   4. the window     — the candidate line still admits only BUGFIX
#      law              and CHORE after rc.1: the freeze travels with
#                       the successor, it does not reset.
#
# The exit-code classes are the C runtime's own: 0 the law held,
# 1 a compile-time error, 2 a usage/named refusal, 101 a runtime
# panic. The interpreter and the native binary agree on every class.
#
# The program exits 0 when every law holds, 10+section*10+case
# otherwise.

# ----------------------------------------------------------------------
# The successor chain: candidate N+1 follows candidate N; the fourth
# candidate's successor is the release.
# ----------------------------------------------------------------------
fn successor_of(n: int) -> str {
    if n < 1 || n > 4 {
        return ""
    }
    if n == 4 {
        return "v1.0.0"
    }
    return "v1.0.0-rc." + (n + 1).to_str()
}

fn stage_of(n: int) -> int {
    # candidate N closes Stage 145+N (the roadmap's own mapping)
    return 145 + n
}

# ----------------------------------------------------------------------
# The pre-release precedence (the §11.4 subset the chain needs):
# rc.N compares numerically, and a bare release outranks its rc's.
# ----------------------------------------------------------------------
fn pre_rank(pre_n: int) -> int {
    # rc.1 -> -4 ... rc.4 -> -1, the release itself -> 0
    if pre_n == 0 {
        return 0
    }
    return pre_n - 5
}

fn outranks(a_n: int, b_n: int) -> bool {
    # a_n = 0 means the release (v1.0.0), n in 1..4 means rc.N
    let ra: int = pre_rank(a_n)
    let rb: int = pre_rank(b_n)
    return ra > rb
}

# ----------------------------------------------------------------------
# The refusal taxonomy: the classes a tool's exit codes name.
#   0    the law held
#   1    a compile error (the source was read; the checker spoke)
#   2    a usage error or a named refusal (the invocation was wrong)
#   101  a runtime panic (the program ran and tripped)
# An invocation error — a file the user NAMED that the tool cannot
# open, a destination it cannot write — is class 2 with the path
# named, never class 101 and never a traceback.
# ----------------------------------------------------------------------
fn class_of_exit(code: int) -> str {
    if code == 0 {
        return "OK"
    }
    if code == 1 {
        return "COMPILE-ERROR"
    }
    if code == 2 {
        return "REFUSAL"
    }
    if code == 101 {
        return "PANIC"
    }
    return "UNKNOWN"
}

# The invocation law: a missing input file (exists=false) must be
# refused (class REFUSAL, exit 2), never PANIC, never COMPILE-ERROR.
fn invocation_law(exists: bool, code: int) -> str {
    if exists {
        return ""
    }
    if class_of_exit(code) != "REFUSAL" {
        return "a missing input file is an invocation error, not a panic"
    }
    return ""
}

# The destination law: an output path whose directory is missing is
# refused up front (exit 2), not discovered as a panic after codegen.
fn destination_law(dir_exists: bool, code: int) -> str {
    if dir_exists {
        return ""
    }
    if class_of_exit(code) != "REFUSAL" {
        return "an unwritable destination is an invocation error, not a panic"
    }
    return ""
}

# ----------------------------------------------------------------------
# The diff-gate re-class law: past the freeze a `fix:` commit is the
# FEATURE it really is when it grows the surface. The flags model the
# diff gate's three detectors.
# ----------------------------------------------------------------------
fn fix_lands(adds_std_file: bool, adds_public_fn: bool, edits_spec: bool) -> bool {
    if adds_std_file {
        return false
    }
    if adds_public_fn {
        return false
    }
    if edits_spec {
        return false
    }
    return true
}

# ----------------------------------------------------------------------
# The window law: the admission table travels with the successor.
# ----------------------------------------------------------------------
fn may_land(prefix: str) -> bool {
    if prefix == "fix" || prefix == "bugfix" || prefix == "revert"
    || prefix == "hotfix" || prefix == "regression" {
        return true
    }
    if prefix == "chore" || prefix == "release" || prefix == "docs"
    || prefix == "doc" || prefix == "test" || prefix == "tests"
    || prefix == "ci" || prefix == "meta" {
        return true
    }
    return false
}

# ======================================================================
# The batteries.
# ======================================================================

fn test_successor_chain() -> int {
    # rc.1's successor is rc.2 — the record RC.md carried
    if successor_of(1) != "v1.0.0-rc.2" {
        return 1
    }
    if successor_of(2) != "v1.0.0-rc.3" {
        return 2
    }
    if successor_of(3) != "v1.0.0-rc.4" {
        return 3
    }
    # the fourth candidate's successor is the release itself
    if successor_of(4) != "v1.0.0" {
        return 4
    }
    # no successor outside the candidate line
    if successor_of(0) != "" {
        return 5
    }
    if successor_of(5) != "" {
        return 6
    }
    # the chain sorts strictly upward
    if !outranks(2, 1) {
        return 7
    }
    if !outranks(3, 2) {
        return 8
    }
    if !outranks(4, 3) {
        return 9
    }
    # the release outranks every candidate of its own line
    if !outranks(0, 4) {
        return 10
    }
    if !outranks(0, 1) {
        return 11
    }
    # and nothing sorts after itself
    if outranks(2, 2) {
        return 12
    }
    return 0
}

fn test_stage_map() -> int {
    if stage_of(1) != 146 {
        return 1
    }
    if stage_of(2) != 147 {
        return 2
    }
    if stage_of(3) != 148 {
        return 3
    }
    if stage_of(4) != 149 {
        return 4
    }
    return 0
}

fn test_refusal_taxonomy() -> int {
    # the four classes are distinct
    if class_of_exit(0) != "OK" {
        return 1
    }
    if class_of_exit(1) != "COMPILE-ERROR" {
        return 2
    }
    if class_of_exit(2) != "REFUSAL" {
        return 3
    }
    if class_of_exit(101) != "PANIC" {
        return 4
    }
    if class_of_exit(3) != "UNKNOWN" {
        return 5
    }
    # the invocation law: a missing file refuses, named, at exit 2
    if invocation_law(false, 2) != "" {
        return 6
    }
    if invocation_law(false, 101) == "" {
        return 7
    }
    if invocation_law(false, 1) == "" {
        return 8
    }
    # an existing file is nobody's refusal
    if invocation_law(true, 0) != "" {
        return 9
    }
    # the destination law: an unwritable destination refuses up front
    if destination_law(false, 2) != "" {
        return 10
    }
    if destination_law(false, 101) == "" {
        return 11
    }
    if destination_law(true, 0) != "" {
        return 12
    }
    return 0
}

fn test_diff_gate() -> int {
    # a real fix lands
    if !fix_lands(false, false, false) {
        return 1
    }
    # a fix that grows the surface is the feature it really is
    if fix_lands(true, false, false) {
        return 2
    }
    if fix_lands(false, true, false) {
        return 3
    }
    if fix_lands(false, false, true) {
        return 4
    }
    if fix_lands(true, true, true) {
        return 5
    }
    return 0
}

fn test_window() -> int {
    # BUGFIX lands
    if !may_land("fix") {
        return 1
    }
    if !may_land("revert") {
        return 2
    }
    if !may_land("hotfix") {
        return 3
    }
    # CHORE lands
    if !may_land("chore") {
        return 4
    }
    if !may_land("release") {
        return 5
    }
    if !may_land("docs") {
        return 6
    }
    if !may_land("test") {
        return 7
    }
    if !may_land("ci") {
        return 8
    }
    # FEATURE and UNKNOWN do not
    if may_land("feat") {
        return 9
    }
    if may_land("spec") {
        return 10
    }
    if may_land("stdlib") {
        return 11
    }
    if may_land("perf") {
        return 12
    }
    if may_land("refactor") {
        return 13
    }
    if may_land("hls-rc") {
        return 14
    }
    return 0
}

fn main() -> int uses IO {
    println("stage 147: v1.0.0-rc.2")
    let mut r: int = test_successor_chain()
    if r != 0 {
        return 10 + r
    }
    r = test_stage_map()
    if r != 0 {
        return 20 + r
    }
    r = test_refusal_taxonomy()
    if r != 0 {
        return 30 + r
    }
    r = test_diff_gate()
    if r != 0 {
        return 40 + r
    }
    r = test_window()
    if r != 0 {
        return 50 + r
    }
    println("  RC2 laws OK: successor, stages, refusals, diff gate, window")
    return 0
}
