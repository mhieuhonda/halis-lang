# tests/ok/feat_effects_proc.hls — Stage 9 release (v0.20.0-alpha).
#
# Demonstrates the newly-activated Proc effect. proc_exec(cmd) runs a
# shell command via system() and returns the exit code (0 on success,
# 1..255 on failure). The program declares `uses Proc` so the checker
# accepts the call; a function WITHOUT `uses Proc` cannot call
# proc_exec() even through five function layers (see the corresponding
# fail test, fail_effect_proc_missing).

fn run_cmd(cmd: str) -> int uses Proc {
    return proc_exec(cmd)
}

fn main() -> int uses IO, Proc {
    let rc: int = run_cmd("true")
    println("true rc=" + rc.to_str())

    let rc2: int = run_cmd("false")
    println("false rc=" + rc2.to_str())

    let rc3: int = run_cmd("exit 42")
    println("exit 42 rc=" + rc3.to_str())

    return 0
}
