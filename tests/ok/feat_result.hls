# feat_result.hls — verify Result[T, E] type from stdlib with `?` operator
import "std.result"

fn parse_pair(s: str) -> Result[int, str] {
    let parts: list[str] = s.split(",")
    if parts.len() != 2 {
        return Result.Err("expected two parts")
    }
    let a: int = int_parse(parts.get(0))?
    let b: int = int_parse(parts.get(1))?
    return Result.Ok(a + b)
}

fn safe_div(a: int, b: int) -> Result[int, str] {
    if b == 0 {
        return Result.Err("division by zero")
    }
    return Result.Ok(a / b)
}

fn chained(a: int, b: int, c: int) -> Result[int, str] {
    # `?` propagates errors through the chain.
    let q: int = safe_div(a, b)?
    let r: int = safe_div(q, c)?
    return Result.Ok(r)
}

fn main() -> int uses IO {
    let p1: Result[int, str] = parse_pair("3,4")
    println(match p1 {
        Result.Ok(v) => "Ok(" + v.to_str() + ")",
        Result.Err(e) => "Err(" + e + ")"
    })

    let p2: Result[int, str] = parse_pair("3,abc")
    println(match p2 {
        Result.Ok(v) => "Ok(" + v.to_str() + ")",
        Result.Err(e) => "Err(" + e + ")"
    })

    let p3: Result[int, str] = parse_pair("only-one-part")
    println(match p3 {
        Result.Ok(v) => "Ok(" + v.to_str() + ")",
        Result.Err(e) => "Err(" + e + ")"
    })

    let r1: Result[int, str] = chained(100, 5, 2)
    println(match r1 {
        Result.Ok(v) => "chained(100, 5, 2) = " + v.to_str(),
        Result.Err(e) => "chained error: " + e
    })

    let r2: Result[int, str] = chained(100, 0, 2)
    println(match r2 {
        Result.Ok(v) => "chained(100, 0, 2) = " + v.to_str(),
        Result.Err(e) => "chained error: " + e
    })

    return 0
}
