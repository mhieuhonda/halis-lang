# ============================================================================
# feat_conc_bounded_deadlock.hls — Stage-16 perfection (v0.29.0-alpha):
# the perfected deadlock detector catches a cycle the old `msgs == 0`
# guard could never see.
#
# A task fills a bounded channel (cap 1) and then blocks SENDING to the
# full channel — there is no consumer. The main thread joins. Every
# thread is blocked, messages ARE pending (on the full channel) — under
# the pre-v0.29 detector this hung forever; the waiter-aware scan now
# proves no consumer exists and halts cleanly: panic (exit 101) with the
# same message in the interpreter and the native runtime.
# ============================================================================

fn fill(ch: Chan[int], n: int) -> int uses Conc {
    let mut i: int = 0
    while i < n {
        ch.send(i)
        i = i + 1
    }
    return 0
}

fn main() -> int uses Conc {
    let ch: Chan[int] = chan_new_bounded(1)
    let t: Task[int] = spawn(fill, clone(ch), 5)
    let rc: int = t.join()
    return rc
}
