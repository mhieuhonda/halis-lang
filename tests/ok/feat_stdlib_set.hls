# tests/ok/feat_stdlib_set.hls — exercise std.set (non-roadmap upgrade).
import "std.set"
import "std.str"

fn main() -> int uses IO {
    let s: map[str, bool] = set_str_new()
    if set_str_size(s) != 0 {
        panic("set_str_new size != 0")
    }
    if set_str_contains(s, "x") {
        panic("empty set contains x?")
    }

    set_str_add(s, "alpha")
    set_str_add(s, "beta")
    set_str_add(s, "gamma")
    set_str_add(s, "alpha")  # duplicate add — should be a no-op
    if set_str_size(s) != 3 {
        panic("size after 3 unique adds != 3")
    }
    if !set_str_contains(s, "beta") {
        panic("set should contain beta")
    }
    if set_str_contains(s, "delta") {
        panic("set should NOT contain delta")
    }

    # from_list
    let xs: list[str] = ["a", "b", "c", "a", "b", "d"]
    let s2: map[str, bool] = set_str_from_list(xs)
    if set_str_size(s2) != 4 {
        panic("set_str_from_list should dedup to 4 unique elements")
    }

    # to_list (insertion-ordered)
    let members: list[str] = set_str_to_list(s2)
    if members.len() != 4 {
        panic("to_list length != 4")
    }
    if members.get(0) != "a" {
        panic("to_list[0] != a")
    }
    if members.get(3) != "d" {
        panic("to_list[3] != d")
    }

    # union
    let a: map[str, bool] = set_str_from_list(["x", "y", "z"])
    let b: map[str, bool] = set_str_from_list(["y", "z", "w"])
    let u: map[str, bool] = set_str_union(a, b)
    if set_str_size(u) != 4 {
        panic("union size != 4")
    }
    if !set_str_contains(u, "x") {
        panic("union missing x")
    }
    if !set_str_contains(u, "w") {
        panic("union missing w")
    }

    # intersect
    let i: map[str, bool] = set_str_intersect(a, b)
    if set_str_size(i) != 2 {
        panic("intersect size != 2")
    }
    if !set_str_contains(i, "y") {
        panic("intersect missing y")
    }
    if !set_str_contains(i, "z") {
        panic("intersect missing z")
    }
    if set_str_contains(i, "x") {
        panic("intersect should not contain x")
    }

    # diff
    let d: map[str, bool] = set_str_diff(a, b)
    if set_str_size(d) != 1 {
        panic("diff size != 1")
    }
    if !set_str_contains(d, "x") {
        panic("diff should contain x")
    }

    # equal
    if !set_str_equal(a, set_str_from_list(["x", "y", "z"])) {
        panic("set_str_equal same-content failed")
    }
    if set_str_equal(a, b) {
        panic("set_str_equal different-content failed")
    }
    let empty: map[str, bool] = set_str_new()
    let empty2: map[str, bool] = set_str_new()
    if !set_str_equal(empty, empty2) {
        panic("two empty sets should be equal")
    }
    if set_str_equal(empty, a) {
        panic("empty set should not equal non-empty")
    }

    println("set ok")
    return 0
}
