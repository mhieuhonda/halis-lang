# feat_deep_scan25_checked_casts.hls — deep-scan-25 regression: the
# native runtime's float -> int64 conversion rejected out-of-range
# doubles with `v > 9.2233720368547757e18`, but that literal ROUNDS to
# exactly 2^63 as a double, so v == 2^63 slipped past the check into
# the (int64_t) cast — undefined behaviour that silently produced a
# garbage value (observed as INT64_MAX) where the boot interpreter
# panicked. The fixed runtime uses `>= 2^63`; this test pins the
# behaviour on BOTH sides via the differential runner (interp panics,
# native must panic identically: exit 101).
fn main() -> int uses IO {
    # In-range conversions still work (truncation toward zero).
    if 0.9.to_int() != 0 {
        panic("0.9.to_int")
    }
    if(-0.9).to_int() != 0 {
        panic("-0.9.to_int")
    }
    if 1.9999.to_int() != 1 {
        panic("1.9999.to_int")
    }
    # The largest double STRICTLY below 2^63 is 2^63 - 1024 (the ulp
    # below 2^63 is 1024; note 2^63 - 512 is not representable and its
    # literal rounds to 2^63 itself).
    if 9223372036854774784.0.to_int() != 9223372036854774784 {
        panic("largest double below 2^63 must convert exactly")
    }
    if(-9223372036854775808.0).to_int() != -9223372036854775808 {
        panic("exactly INT64_MIN must convert")
    }
    println("checked casts OK")
    # Deep-scan-25: 2^63 must PANIC (integer overflow / out of range),
    # never wrap. Reaching this line in the interpreter is a bug; the
    # native build must also die here (differential: both exit 101).
    let f: float = 9223372036854775808.0
    let n: int = f.to_int()
    println(n.to_str())
    return 0
}
