# feat_stage111_cap_name.hls — Stage 111 (v0.130.0-alpha).
# cap_effect_name(c) -> str — the ONLY way to observe a token (they are
# opaque: no fields, no printing, no equality). Every token round-trips
# to exactly the effect name it was minted with, on both front-ends.

fn main() -> int {
    let a: Cap[Net] = cap_take("Net")
    let b: Cap[Fs] = cap_take("Fs")
    let c: Cap[IO] = cap_take("IO")
    let d: Cap[Conc] = cap_take("Conc")
    println(cap_effect_name(a))
    println(cap_effect_name(b))
    println(cap_effect_name(c))
    println(cap_effect_name(d))
    return 0
}
