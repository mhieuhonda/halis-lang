# feat_stdlib_list.hls — verify std.list helpers.
import "std.list"

fn main() -> int uses IO {
    let xs: list[int] = [3, 1, 4, 1, 5, 9, 2, 6]

    # Reverse.
    let r: list[int] = list_reverse_int(xs)
    if r.get(0) != 6 || r.get(7) != 3 {
        println("FAIL: reverse")
        return 1
    }

    # Contains / index_of.
    if !list_contains_int(xs, 9) {
        println("FAIL: contains 9")
        return 1
    }
    if list_contains_int(xs, 100) {
        println("FAIL: contains 100")
        return 1
    }
    if list_index_of_int(xs, 4) != 2 {
        println("FAIL: index_of 4")
        return 1
    }
    if list_index_of_int(xs, 100) != -1 {
        println("FAIL: index_of 100")
        return 1
    }

    # Max / min.
    if list_max_int(xs) != 9 || list_min_int(xs) != 1 {
        println("FAIL: max/min")
        return 1
    }

    # Sort ascending.
    let asc: list[int] = list_sort_int_asc(xs)
    # Expected: [1, 1, 2, 3, 4, 5, 6, 9]
    let expected: list[int] = [1, 1, 2, 3, 4, 5, 6, 9]
    let mut i: int = 0
    while i < asc.len() {
        if asc.get(i) != expected.get(i) {
            println("FAIL: sort at idx " + i.to_str())
            return 1
        }
        i = i + 1
    }

    # Sort descending.
    let desc: list[int] = list_sort_int_desc(xs)
    if desc.get(0) != 9 || desc.get(7) != 1 {
        println("FAIL: sort desc")
        return 1
    }

    # Concat.
    let a: list[int] = [1, 2, 3]
    let b: list[int] = [4, 5]
    let cat: list[int] = list_concat_int(a, b)
    if cat.len() != 5 || cat.get(0) != 1 || cat.get(4) != 5 {
        println("FAIL: concat")
        return 1
    }

    # Take / drop.
    if list_take_int(cat, 3).len() != 3 {
        println("FAIL: take")
        return 1
    }
    if list_drop_int(cat, 3).len() != 2 {
        println("FAIL: drop")
        return 1
    }
    # Take more than length -> clamped.
    if list_take_int(cat, 100).len() != 5 {
        println("FAIL: take > len")
        return 1
    }

    # Dedup on sorted list.
    let sorted: list[int] = [1, 1, 2, 3, 3, 3, 4]
    let dedup: list[int] = list_dedup_sorted_int(sorted)
    if dedup.len() != 4 {
        println("FAIL: dedup len " + dedup.len().to_str())
        return 1
    }

    # Equal.
    if !list_equal_int(a, [1, 2, 3]) {
        println("FAIL: equal")
        return 1
    }
    if list_equal_int(a, [1, 2, 4]) {
        println("FAIL: equal should differ")
        return 1
    }

    println("OK: list")
    return 0
}
