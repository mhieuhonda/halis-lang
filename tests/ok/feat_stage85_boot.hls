# ============================================================================
# tests/ok/feat_stage85_boot.hls — Stage 85: boot-protocol headers
# ----------------------------------------------------------------------------
# #![no_std] so the same source runs on the interpreter, natively, and
# linked -nostdlib: the module and the language features under test carry
# no libc dependency. Exit 0 = all assertions passed; a non-zero code
# names the first assertion that failed.
# ============================================================================

#![no_std]

import "core.boot"
import "core.result"
import "core.section"

# A memory map with every kind the two protocols can report, in base
# order (both protocols guarantee sorted order, and a kernel may binary
# search on it).
fn fixture() -> list[MemRegion] {
    let mut rs: list[MemRegion] = []
    rs.push(mem_region_new(0, 4096, MemKind.Reserved))
    rs.push(mem_region_new(4096, 65536, MemKind.Usable))
    rs.push(mem_region_new(1048576, 1048576, MemKind.Usable))
    rs.push(mem_region_new(2097152, 4096, MemKind.AcpiReclaimable))
    rs.push(mem_region_new(2097152 + 4096, 4096, MemKind.AcpiNvs))
    rs.push(mem_region_new(4194304, 8192, MemKind.BootloaderReclaimable))
    rs.push(mem_region_new(8388608, 16384, MemKind.ExecutableAndModules))
    rs.push(mem_region_new(16777216, 32768, MemKind.Framebuffer))
    rs.push(mem_region_new(33554432, 4096, MemKind.ReservedMapped))
    rs.push(mem_region_new(67108864, 4096, MemKind.Unknown))
    rs.push(mem_region_new(134217728, 4096, mem_kind_from_e820(99)))
    return rs
}

fn main() -> int {
    # ------------------------------------------------------------------
    # Multiboot2 constants (1..12)
    # ------------------------------------------------------------------
    if mb2_magic() != 3897708758 {
        return 1
    }
    if hex64(mb2_magic()) != "0x00000000e85250d6" {
        return 2
    }
    if mb2_arch_i386() != 0 {
        return 3
    }
    if mb2_tag_end() != 0 || mb2_tag_cmdline() != 1 {
        return 4
    }
    if mb2_tag_bootloader() != 2 || mb2_tag_module() != 3 {
        return 5
    }
    if mb2_tag_basic_meminfo() != 4 || mb2_tag_mmap() != 6 {
        return 6
    }
    if mb2_tag_framebuffer() != 8 || mb2_tag_elf_sections() != 9 {
        return 7
    }
    if mb2_tag_old_mmap() != 65536 || mb2_tag_old_framebuffer() != 65537 {
        return 8
    }
    if mb2_tag_name(0) != "end" || mb2_tag_name(6) != "mmap" {
        return 9
    }
    if mb2_tag_name(8) != "framebuffer" || mb2_tag_name(65536) != "old-mmap" {
        return 10
    }
    if mb2_tag_name(42) != "unknown" {
        return 11
    }
    # Information tags are filled in by the LOADER; the header is what
    # the loader scanned for. Conflating the two is a classic bug.
    if mb2_tag_is_information(mb2_tag_mmap()) != true {
        return 12
    }

    # ------------------------------------------------------------------
    # The checksum rule (13..20)
    # ------------------------------------------------------------------
    if mb2_checksum(mb2_magic(), 0, 40) != 397258498 {
        return 13
    }
    # The spec's invariant: all four header fields sum to zero, modulo
    # 2^32. That is the whole validity test.
    if mb2_sum32(mb2_magic(), 0, 40, mb2_checksum(mb2_magic(), 0, 40)) != 0 {
        return 14
    }
    if mb2_field32(4294967296) != 0 || mb2_field32(0) != 0 {
        return 15
    }
    if mb2_field32(-1) != 4294967295 {
        return 16
    }
    if mb2_checksum(mb2_magic(), 0, 24) != 397258514 {
        return 17
    }
    if !mb2_header_ok(mb2_magic(), 0, 24, mb2_checksum(mb2_magic(), 0, 24)) {
        return 18
    }
    if mb2_header_ok(mb2_magic() + 1, 0, 24, mb2_checksum(mb2_magic(), 0, 24)) {
        return 19
    }
    if mb2_header_ok(mb2_magic(), 1, 24, mb2_checksum(mb2_magic(), 0, 24)) {
        return 20
    }
    if mb2_header_ok(mb2_magic(), 0, 16, mb2_checksum(mb2_magic(), 0, 24)) {
        return 21
    }
    if mb2_header_ok(mb2_magic(), 0, 24, 0) {
        return 22
    }

    # ------------------------------------------------------------------
    # Header construction and validation (20..30)
    # ------------------------------------------------------------------
    let h: Mb2Header = mb2_header_new([])
    if h.length != 24 || h.tags.len() != 1 {
        return 23
    }
    if h.tags.get(0).tag_type != 0 || h.tags.get(0).size != 8 {
        return 24
    }
    if !mb2_header_well_formed(h) {
        return 25
    }
    if mb2_tag_present(h, mb2_tag_end()) != true {
        return 26
    }
    if mb2_tag_count(h, mb2_tag_module()) != 0 {
        return 27
    }
    if mb2_tag_at(h, mb2_tag_end(), 0) != 0 {
        return 28
    }
    if mb2_tag_at(h, mb2_tag_module(), 0) != -1 {
        return 29
    }
    # A header whose length disagrees with the sum of its tags is one a
    # kernel must not walk.
    let mut bad: list[MbTag] = []
    bad.push(mb_tag_new(mb2_tag_cmdline(), [65, 0]))
    let hb: Mb2Header = mb2_header_new(bad)
    if hb.length != 16 + 10 + 8 {
        return 30
    }
    if mb2_tag_count(hb, mb2_tag_cmdline()) != 1 {
        return 31
    }
    if !mb2_tag_present(hb, mb2_tag_cmdline()) {
        return 32
    }
    if !mb_tag_payload_ok(hb.tags.get(0)) {
        return 33
    }
    # A tag smaller than its own 8-byte prefix is malformed: a loader
    # walking it would run off the end of the list.
    if mb_tag_payload_ok(MbTag {
        tag_type: 4, size: 4, payload: []
    }) {
        return 34
    }
    if mb_tag_payload_ok(MbTag {
        tag_type: 4, size: 8, payload: [1, 2]
    }) {
        return 35
    }
    if !mb_tag_payload_ok(MbTag {
        tag_type: 4, size: 12, payload: [1, 2]
    }) {
        return 36
    }

    # ------------------------------------------------------------------
    # Limine request IDs (34..46)
    # ------------------------------------------------------------------
    let common: list[int] = limine_common_magic()
    if common.get(0) != -4057218587309601912 {
        return 37
    }
    if common.get(1) != 757423339400917115 {
        return 38
    }
    let memmap: list[int] = limine_id_memmap()
    if memmap.len() != 4 {
        return 39
    }
    if memmap.get(0) != common.get(0) || memmap.get(1) != common.get(1) {
        return 40
    }
    if hex64(memmap.get(2)) != "0x67cf3d9d378a806f" {
        return 41
    }
    if hex64(memmap.get(3)) != "0xe304acdfc50c3c62" {
        return 42
    }
    if hex64(limine_id_framebuffer().get(2)) != "0x9d5827dcd881dd75" {
        return 43
    }
    if hex64(limine_id_rsdp().get(2)) != "0xc5e77b6b397e7b43" {
        return 44
    }
    if hex64(limine_id_hhdm().get(2)) != "0x48dcf1cb8ad2b852" {
        return 45
    }
    if hex64(limine_id_stack_size().get(2)) != "0x224ef0460a8e8926" {
        return 46
    }
    if hex64(limine_id_bootloader_info().get(2)) != "0xf55038d8e2a1202f" {
        return 47
    }
    # The delimiters, and the base-revision tag.
    if hex64(limine_id_end().get(0)) != "0xadc0e0531bb10d03" {
        return 48
    }
    if limine_id_start().len() != 4 {
        return 49
    }

    # ------------------------------------------------------------------
    # Feature matching is exact, not prefix (47..56)
    # ------------------------------------------------------------------
    if !limine_id_is(memmap, limine_id_memmap()) {
        return 50
    }
    if limine_id_is(memmap, limine_id_framebuffer()) {
        return 51
    }
    if limine_id_is([memmap.get(0), memmap.get(1)], memmap) {
        return 52
    }
    if limine_id_is([memmap.get(0), memmap.get(1), memmap.get(2), 0], memmap) {
        return 53
    }
    if limine_id_name(memmap) != "memmap" {
        return 54
    }
    if limine_id_name(limine_id_framebuffer()) != "framebuffer" {
        return 55
    }
    if limine_id_name([1, 2, 3, 4]) != "" {
        return 56
    }
    if limine_id_name(limine_id_hhdm()) != "hhdm" {
        return 57
    }
    if limine_id_name(limine_id_stack_size()) != "stack-size" {
        return 58
    }
    if limine_id_name(limine_id_bootloader_info()) != "bootloader-info" {
        return 59
    }

    # ------------------------------------------------------------------
    # The request list (57..70)
    # ------------------------------------------------------------------
    let mut fs: list[LimineFeature] = []
    fs.push(limine_feature_new(limine_id_memmap(), 0))
    fs.push(limine_feature_new(limine_id_framebuffer(), 0))
    fs.push(limine_feature_new(limine_id_hhdm(), 0))
    if !limine_features_unique(fs) {
        return 60
    }
    if limine_feature_find(fs, memmap) != 0 {
        return 61
    }
    if limine_feature_find(fs, limine_id_rsdp()) != -1 {
        return 62
    }
    if limine_feature_requested(fs, memmap) != true {
        return 63
    }
    if limine_feature_requested(fs, limine_id_rsdp()) != false {
        return 64
    }
    let mut dup: list[LimineFeature] = []
    dup.push(limine_feature_new(memmap, 0))
    dup.push(limine_feature_new(memmap, 1))
    if limine_features_unique(dup) {
        return 65
    }
    # The end delimiter terminates the list.
    let delim: list[int] = limine_id_end()
    let mut words: list[int] = []
    words.push(delim.get(0))
    words.push(delim.get(1))
    if !limine_features_terminated(words) {
        return 66
    }
    # The delimiter only counts in the LAST two words: a loader that saw
    # one mid-list would stop reading the requests after it.
    let mut unterminated: list[int] = []
    unterminated.push(1)
    unterminated.push(2)
    unterminated.push(3)
    if limine_features_terminated(unterminated) {
        return 67
    }
    let mut mid: list[int] = []
    mid.push(delim.get(0))
    mid.push(delim.get(1))
    mid.push(4)
    if limine_features_terminated(mid) {
        return 68
    }
    if limine_features_terminated([1, 2]) {
        return 69
    }
    # The base-revision tag: the loader zeroes the third word when it
    # honoured the request and leaves it when it did not.
    let rev: list[int] = limine_base_revision(3)
    if hex64(rev.get(0)) != "0xf9562b2d5c95a6c8" {
        return 70
    }
    if limine_base_revision_honoured(rev) {
        return 71
    }
    let mut ok: list[int] = rev
    ok.set(2, 0)
    if !limine_base_revision_honoured(ok) {
        return 72
    }
    let mut wrong: list[int] = rev
    wrong.set(0, 1)
    if limine_base_revision_honoured(wrong) {
        return 73
    }
    if limine_base_revision_honoured([1, 2]) {
        return 74
    }

    # ------------------------------------------------------------------
    # The memory-map model: one enum for two wire encodings (71..86)
    # ------------------------------------------------------------------
    if mem_kind_id(mem_kind_from_e820(1)) != mem_kind_id(MemKind.Usable) {
        return 75
    }
    if mem_kind_id(mem_kind_from_e820(2)) != mem_kind_id(MemKind.Reserved) {
        return 76
    }
    if mem_kind_id(mem_kind_from_e820(3)) != mem_kind_id(MemKind.AcpiReclaimable) {
        return 77
    }
    if mem_kind_id(mem_kind_from_e820(4)) != mem_kind_id(MemKind.AcpiNvs) {
        return 78
    }
    if mem_kind_id(mem_kind_from_e820(5)) != mem_kind_id(MemKind.BadMemory) {
        return 79
    }
    if mem_kind_id(mem_kind_from_e820(6)) != mem_kind_id(MemKind.Unknown) {
        return 80
    }
    # Limine starts at 0 where E820 starts at 1 — the whole point of
    # mapping both into one enum.
    if mem_kind_id(mem_kind_from_limine(0)) != mem_kind_id(MemKind.Usable) {
        return 81
    }
    if mem_kind_id(mem_kind_from_limine(1)) != mem_kind_id(MemKind.Reserved) {
        return 82
    }
    if mem_kind_id(mem_kind_from_limine(5)) != mem_kind_id(MemKind.BootloaderReclaimable) {
        return 83
    }
    if mem_kind_id(mem_kind_from_limine(6)) != mem_kind_id(MemKind.ExecutableAndModules) {
        return 84
    }
    if mem_kind_id(mem_kind_from_limine(7)) != mem_kind_id(MemKind.Framebuffer) {
        return 85
    }
    if mem_kind_id(mem_kind_from_limine(8)) != mem_kind_id(MemKind.ReservedMapped) {
        return 86
    }
    if mem_kind_id(mem_kind_from_limine(9)) != mem_kind_id(MemKind.Unknown) {
        return 87
    }
    if mem_kind_code_e820(MemKind.Usable) != 1 {
        return 88
    }
    if mem_kind_code_e820(MemKind.Usable) != mem_kind_code_e820(mem_kind_from_e820(1)) {
        return 89
    }
    # A Limine-only kind has no E820 name; -1 says so rather than
    # inventing a number.
    if mem_kind_code_e820(MemKind.Framebuffer) != -1 {
        return 90
    }

    # ------------------------------------------------------------------
    # Reclaimability (87..95)
    # ------------------------------------------------------------------
    if !mem_kind_usable_now(MemKind.Usable) {
        return 91
    }
    if mem_kind_usable_now(MemKind.BootloaderReclaimable) {
        return 92
    }
    if !mem_kind_reclaimable(MemKind.BootloaderReclaimable) {
        return 93
    }
    if !mem_kind_reclaimable(MemKind.AcpiReclaimable) {
        return 94
    }
    if mem_kind_reclaimable(MemKind.AcpiNvs) {
        return 95
    }
    if mem_kind_reclaimable(MemKind.BadMemory) {
        return 96
    }
    if mem_kind_reclaimable(MemKind.Reserved) {
        return 97
    }
    if mem_kind_reclaimable(MemKind.Unknown) {
        return 98
    }
    if mem_kind_name(MemKind.BootloaderReclaimable) != "bootloader-reclaimable" {
        return 99
    }

    # ------------------------------------------------------------------
    # The physical-memory-manager questions (96..115)
    # ------------------------------------------------------------------
    let rs: list[MemRegion] = fixture()
    if rs.len() != 11 {
        return 100
    }
    if mem_usable_bytes(rs) != 65536 + 1048576 {
        return 101
    }
    if mem_reclaimable_bytes(rs) != 65536 + 1048576 + 4096 + 8192 {
        return 102
    }
    if mem_largest_usable(rs) != 1048576 {
        return 103
    }
    if mem_count_usable(rs) != 2 {
        return 104
    }
    if !mem_sorted(rs) {
        return 105
    }
    if !mem_no_overlaps(rs) {
        return 106
    }
    # The first region that SATISFIES the request, or -1.
    if mem_find_usable(rs, 4096, 4096) != 4096 {
        return 107
    }
    if mem_find_usable(rs, 65536, 4096) != 4096 {
        return 108
    }
    if mem_find_usable(rs, 65537, 4096) != 1048576 {
        return 109
    }
    if mem_find_usable(rs, 1099511627776, 4096) != -1 {
        return 110
    }
    # Alignment moves the start, and the region must still satisfy the
    # request afterwards.
    if mem_find_usable(rs, 4096, 1048576) != 1048576 {
        return 111
    }
    # Address lookups.
    if mem_contains(rs, 0) != 0 {
        return 112
    }
    if mem_contains(rs, 1048676) != 2 {
        return 113
    }
    # 1000000 falls in the gap between the 64 KiB region and the 1-MiB
    # one: it belongs to no region at all.
    if mem_contains(rs, 1000000) != -1 {
        return 114
    }
    if mem_region_end(rs.get(1)) != 69632 {
        return 115
    }
    if mem_region_contains(rs.get(1), 69631) != true {
        return 116
    }
    if mem_region_contains(rs.get(1), 69632) != false {
        return 117
    }
    if mem_regions_overlap(rs.get(1), rs.get(2)) != false {
        return 118
    }
    if mem_regions_overlap(rs.get(1), rs.get(1)) != true {
        return 119
    }

    # ------------------------------------------------------------------
    # Consistency checks the map itself must pass (116..126)
    # ------------------------------------------------------------------
    let mut shuffled: list[MemRegion] = []
    shuffled.push(rs.get(5))
    shuffled.push(rs.get(0))
    shuffled.push(rs.get(3))
    if mem_sorted(shuffled) {
        return 120
    }
    let fixed: list[MemRegion] = mem_sort(shuffled)
    if !mem_sorted(fixed) {
        return 121
    }
    # shuffled was [4194304, 0, 2097152]; sorted is [0, 2097152, 4194304].
    if fixed.get(0).base != 0 || fixed.get(2).base != 4194304 {
        return 122
    }
    if fixed.len() != 3 {
        return 123
    }
    # Two usable regions sharing a byte is a map a page allocator would
    # turn into a double allocation.
    let mut clash: list[MemRegion] = []
    clash.push(mem_region_new(4096, 8192, MemKind.Usable))
    clash.push(mem_region_new(4096 + 4096, 8192, MemKind.Usable))
    if mem_no_overlaps(clash) {
        return 124
    }
    # A framebuffer sharing a page with a usable region is normal.
    let mut mixed: list[MemRegion] = []
    mixed.push(mem_region_new(4096, 8192, MemKind.Usable))
    mixed.push(mem_region_new(4096 + 4096, 8192, MemKind.Framebuffer))
    if !mem_no_overlaps(mixed) {
        return 125
    }
    # A zero-length region overlaps nothing and contains nothing.
    if mem_regions_overlap(mem_region_new(0, 0, MemKind.Usable), rs.get(1)) {
        return 126
    }
    if mem_usable_bytes([]) != 0 {
        return 127
    }
    if mem_count_usable([]) != 0 {
        return 128
    }
    if mem_largest_usable([]) != 0 {
        return 129
    }
    if mem_find_usable([], 4096, 4096) != -1 {
        return 130
    }

    # ------------------------------------------------------------------
    # The framebuffer (127..145)
    # ------------------------------------------------------------------
    let fb: Framebuffer = fb_new(1073741824, 1024, 768, 4096, 32, FbKind.Rgb)
    if !fb_geometry_ok(fb) {
        return 131
    }
    if fb_size(fb) != 4096 * 768 {
        return 132
    }
    if fb_min_pitch(fb) != 4096 {
        return 133
    }
    if fb_kind_name(FbKind.Rgb) != "rgb" || fb_kind_name(FbKind.Indexed) != "indexed" {
        return 134
    }
    # A padded mode: 640 px of 32bpp is 2560 bytes of pixels, but the
    # firmware reports a 4096-byte pitch, so each line is padded out.
    # A kernel that computed the stride as width * bytes-per-pixel
    # would shear the whole image.
    let padded: Framebuffer = fb_new(1073741824, 640, 480, 4096, 32, FbKind.Rgb)
    if fb_min_pitch(padded) != 2560 {
        return 135
    }
    if fb_size(padded) != 4096 * 480 {
        return 136
    }
    if padded.width * 4 == padded.pitch {
        return 137
    }
    # 24 bpp packed RGB is legitimate.
    if !fb_geometry_ok(fb_raw(1073741824, 1024, 768, 3072, 24, FbKind.Rgb)) {
        return 138
    }
    # The unchecked constructor is how a kernel models firmware bytes;
    # fb_geometry_ok is what rejects them.
    if fb_geometry_ok(fb_raw(0, 1024, 768, 4096, 32, FbKind.Rgb)) {
        return 139
    }
    if fb_geometry_ok(fb_raw(1073741824, 1024, 768, 2048, 32, FbKind.Rgb)) {
        return 140
    }
    if fb_geometry_ok(fb_raw(1073741824, 1024, 768, 4096, 15, FbKind.Rgb)) {
        return 141
    }
    if fb_geometry_ok(fb_raw(1073741824, 0, 768, 4096, 32, FbKind.Rgb)) {
        return 142
    }
    if fb_geometry_ok(fb_raw(1073741824, 1024, 0, 4096, 32, FbKind.Rgb)) {
        return 143
    }
    if fb_geometry_ok(fb_raw(1073741824, 1024, 768, 0, 32, FbKind.Rgb)) {
        return 144
    }
    if fb_geometry_ok(fb_raw(1073741824, 1024, 768, 4096, 0, FbKind.Rgb)) {
        return 145
    }
    if fb_size(fb_raw(0, 0, 0, 0, 0, FbKind.Rgb)) != 0 {
        return 146
    }
    if fb_report(fb).find("1024x768") < 0 {
        return 147
    }
    if fb_report(fb).find("32bpp") < 0 {
        return 148
    }
    if mem_report(rs).find("memory map") != 0 {
        return 149
    }
    if boot_protocol_name(true) != "multiboot2" {
        return 150
    }

    # ------------------------------------------------------------------
    # The boot report warns about the ways a map can be unusable (146..152)
    # ------------------------------------------------------------------
    if boot_protocol_name(false) != "limine" {
        return 151
    }
    let rep: str = boot_report("limine", rs, fb, true)
    if rep.find("2 usable region") < 0 {
        return 152
    }
    if rep.find("framebuffer: 1024x768") < 0 {
        return 153
    }
    if boot_report("limine", rs, fb, false).find("framebuffer: none") < 0 {
        return 154
    }
    let mut broken: list[MemRegion] = []
    broken.push(mem_region_new(8388608, 4096, MemKind.Usable))
    broken.push(mem_region_new(0, 4096, MemKind.Usable))
    if boot_report("limine", broken, fb, true).find("not sorted") < 0 {
        return 155
    }
    let mut none: list[MemRegion] = []
    none.push(mem_region_new(0, 4096, MemKind.Reserved))
    if boot_report("limine", none, fb, true).find("no usable memory") < 0 {
        return 156
    }
    let mut clash2: list[MemRegion] = []
    clash2.push(mem_region_new(4096, 8192, MemKind.Usable))
    clash2.push(mem_region_new(4096 + 4096, 8192, MemKind.Usable))
    if boot_report("limine", clash2, fb, true).find("overlap") < 0 {
        return 157
    }
    return 0
}
