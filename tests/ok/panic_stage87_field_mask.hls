# Expect: exit 101, panic "mmio_field_new: width must be 1..64"
# Stage 87: a bit field is 1..64 bits wide. A width outside that has no
# mask, and a driver that builds one anyway gets a shift somewhere else.
import "core.mmio"

fn main() -> int {
    let f: MmioField = mmio_field_new(4, 65)
    if f.width != 65 {
        return 1
    }
    return 0
}
