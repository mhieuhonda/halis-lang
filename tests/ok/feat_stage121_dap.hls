# ============================================================================
# tests/ok/feat_stage121_dap.hls — Stage 121 acceptance: VS Code debugger
# ----------------------------------------------------------------------------
# This file is the Stage 121 ok corpus: a valid Halis program whose shape
# is exactly the surface the debug adapter walks — the nested calls the
# stepper crosses, the loop the breakpoint lands in, the struct and enum
# values the variables view expands, the method frame whose locals the
# scopes request reads:
#
#   python3 boot/boot.py tests/ok/feat_stage121_dap.hls
#   python3 tools/hls-dap.py          (launch this file, breakpoint, step)
#
# The program: a small warehouse ledger. stock_value walks a list of
# Item structs (the variables view expands the fields), count_kind
# matches a Kind enum (the payload the debugger shows as Variant(data)),
# Item.value is an impl method (its frame names the receiver self), and
# loudest folds a list with an if-chain (the step-over target). Every
# call is at least two frames deep so stackTrace, stepIn and stepOut
# have real structure to report. Deterministic output; interpreter and
# native agree byte for byte.
# ============================================================================

struct Item {
    name: str,
    qty: int,
    unit: int
}

enum Kind {
    Food(int),
    Tool(int),
    Spare(int)
}

impl Item {
    fn value(self: Item) -> int {
        return self.qty * self.unit
    }

    fn label(self: Item) -> str {
        return self.name + " x" + self.qty.to_str()
    }
}

fn item_value(it: Item) -> int {
    return it.value()
}

fn stock_value(items: list[Item]) -> int {
    let mut total: int = 0
    let mut i: int = 0
    while i < items.len() {
        total = total + item_value(items[i])
        i = i + 1
    }
    return total
}

fn kind_shelf(k: Kind) -> int {
    return match k {
        Kind.Food(shelf) => shelf,
        Kind.Tool(shelf) => shelf,
        Kind.Spare(shelf) => shelf
    }
}

fn loudest(items: list[Item]) -> str {
    let mut best: int = 0
    let mut name: str = ""
    let mut i: int = 0
    while i < items.len() {
        let v: int = item_value(items[i])
        if v > best {
            best = v
            name = items[i].name
        }
        i = i + 1
    }
    return name
}

fn main() uses IO {
    let inv: list[Item] = [
    Item {
        name: "rice", qty: 12, unit: 3
    },
    Item {
        name: "drill", qty: 4, unit: 25
    },
    Item {
        name: "bolt", qty: 500, unit: 1
    }
    ]
    let shelves: list[Kind] = [
    Kind.Food(1),
    Kind.Tool(7),
    Kind.Spare(9)
    ]

    println("value: " + stock_value(inv).to_str())
    println("loudest: " + loudest(inv))

    let mut j: int = 0
    while j < shelves.len() {
        let k: Kind = shelves[j]
        println("shelf " + kind_shelf(k).to_str() + " kind " +
        match k {
            Kind.Food(_) => "food",
            Kind.Tool(_) => "tool",
            Kind.Spare(_) => "spare"
        })
        j = j + 1
    }

    let first: Item = inv[0]
    println("first: " + first.label() + " value " +
    first.value().to_str())
}
