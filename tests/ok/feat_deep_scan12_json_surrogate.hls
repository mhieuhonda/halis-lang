# Deep-scan-12 regression: std/json.hls invalid low surrogate must
# return json_null() cleanly, NOT panic on chr(negative) for a low
# below 56320 (DSS-T-03). Before the fix, jsonp_err recorded the
# problem but execution fell through to `cp = 65536 + ... + (low -
# 56320)` with a garbage low, then jsonp_push_utf8 emitted invalid
# UTF-8 (or panicked). The fix returns json_null() at the error
# site; the outer parser surfaces the deferred error and returns
# Err to the caller. The program should exit cleanly.

import "std.json"

fn main() -> int uses IO {
    # A high surrogate followed by an invalid low surrogate (0x0000
    # instead of 0xDC00..0xDFFF). The parser must reject this cleanly.
    let bad: str = "\"\\uD800\\u0000\""
    let r: Result[JsonValue, str] = json_parse_result(bad)
    # The error must surface (the surrogate pair is invalid); the
    # Result should be Err. Before the fix, the parser silently
    # emitted invalid UTF-8 bytes — this test would have panicked.
    if result_is_err(r) {
        println("ok: invalid surrogate rejected")
        return 0
    }
    println("FAIL: invalid surrogate accepted")
    return 1
}
