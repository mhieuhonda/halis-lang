# feat_proof_sound_whilecond.hls — Stage-17 perfection (deep-scan-10)
# soundness regression: a while CONDITION is re-evaluated every
# iteration with loop-modified values — the old engine annotated it
# with the loop-ENTRY facts, proving an OOB index (the native -O fast
# build SIGSEGV'd at i == 1). The invariant analysis now governs the
# condition. Both implementations must panic identically (101).
fn f(xs: list[int]) -> int
    requires xs.len() >= 1
{
    let mut i: int = 0
    let mut t: int = 0
    while xs[i] < 100 {
        t = t + xs[i]
        i = i + 1
    }
    return t
}
fn main() -> int uses IO {
    let xs: list[int] = [5]
    return f(xs)
}
