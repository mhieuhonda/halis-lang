# feat_deep_scan24_generic_codehash.hls — deep-scan-24 regression: the
# self-hosted compiler's codegen for a generic fn body must resolve the
# element type through the CURRENT INSTANTIATION before the box/unbox
# dispatch. The raw checker annotation on a generic body is the type
# PARAM itself (T for `xs: list[T]`), so xs.get(i) / xs[i] / xs.pop()
# emitted the identity hl_unbox_ptr and the boxed pointer was returned
# as the int64 VALUE (garbage like 94444786390144) — a silent
# interpreter/native differential that no earlier test covered (every
# previous generic test returned either structs or non-list params).
#
# This file exercises all three lowerings inside generic fns:
#   list.get (xs.get(i)), index (xs[i]) and list.pop (xs.pop()).
fn pick_get[T](xs: list[T], i: int) -> T {
    return xs.get(i)
}

fn pick_index[T](xs: list[T], i: int) -> T {
    return xs[i]
}

fn take_last[T](xs: list[T]) -> T {
    let v: T = xs.pop()
    return v
}

fn main() -> int uses IO {
    let a: int = pick_get([10, 20], 1)
    println("pick_get  = " + a.to_str())
    let b: int = pick_index([30, 40], 0)
    println("pick_index = " + b.to_str())
    let c: int = take_last([50, 60])
    println("take_last  = " + c.to_str())
    # float instantiation (second monomorphisation of each fn)
    let d: float = pick_get([1.5, 2.5], 0)
    println("pick_get f = " + d.to_str())
    return 0
}
