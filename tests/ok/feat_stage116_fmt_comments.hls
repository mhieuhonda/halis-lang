# feat_stage116_fmt_comments.hls — Stage 116 (v0.135.0-alpha):
# hlfmt preserves comments in ALL positions.
#
# This file is the runnable half of the gate: every comment position the
# formatter must survive appears here BETWEEN real statements — banners
# above declarations, trailing notes after statements and braces,
# interior block comments, mid-expression notes, comments inside
# argument lists, struct bodies and match arms, on brace lines, between
# an if and its else, and the trailing EOF note. Interpreter and native
# must print the same markers BEFORE formatting, and the SAME markers
# after a pass of `hlfmt -w` — formatting changes nothing but
# whitespace, so the program below is the semantic witness that none of
# those comments (and none of the statements around them) were lost,
# duplicated, or reordered.
#
#   python3 boot/boot.py tests/ok/feat_stage116_fmt_comments.hls

# A banner directly above a declaration attaches to it.
fn add(a: int, b: int) -> int {
    # interior comment at the top of a block
    return a + b  # trailing note on a statement
}

#[inline(always)]
fn twice(x: int) -> int {
    # the attribute line above is NOT a comment and must not move
    return x * 2  # trailing after an attributed fn
}

struct Meter {
    # a comment inside a struct body
    name: str,
    unit: int
}

enum Level {
    Low,
    High
}

fn pick(l: Level) -> int {
    return match l {
        # small units rank low
        Level.Low => 10,
        # everything else ranks high
        Level.High => 20
    }
}

fn spread(a: int,
          # a note between parameters
          b: int) -> int {
    return a - b  # trailing on the only statement
}

fn main() -> int uses IO {
    println("s116 start")
    # comment between statements
    let s: int = add(40, 2)
    println(s.to_str())  # trailing on a call
    let t: int = twice(21)
    println(t.to_str())
    let m: Meter = Meter {
        # note inside a struct literal
        name: "bar",
        unit: 1
    }
    println(m.name.len().to_str())
    println(pick(Level.Low).to_str())
    let d: int = spread(50,
        # mid-call note
        8)
    println(d.to_str())
    let wrapped: int = add(
        # first-arg note
        100,
        23)
    println(wrapped.to_str())
    if s == 42 {
        # a comment inside an if-block
        println("answer ok")
    }  # trailing on the closing brace
    if s != 42 {
        println("wrong answer")
    } else {
        # the else branch confirms the law
        println("else ok")
    }
    # comment before a closing brace
    return 0
}
# EOF note — the last line a formatter must not eat.
