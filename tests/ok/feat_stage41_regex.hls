# Main — run all tests in sequence, panic on first failure.
# ============================================================================

fn main() -> void uses IO {
    println("=== Stage 41 (v0.60.0-alpha): std.regex tests ===")
    println("")
    test_literal()
    test_quantifiers()
    test_alternation()
    test_capture_groups()
    test_char_class()
    test_anchors()
    test_dot()
    test_escapes()
    test_replace()
    test_split()
    test_find_all()
    test_compile_errors()
    test_complex()
    test_find_at()
    test_match_text()
    test_redos_safety()
    println("")
    println("ALL REGEX TESTS PASSED")
}
