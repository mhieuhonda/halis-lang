# ============================================================================
# tests/ok/feat_stage123_repl.hls — Stage 123 acceptance: the REPL
# ----------------------------------------------------------------------------
# This file is the Stage 123 ok corpus: a valid Halis program whose shape is
# exactly what a live hls-repl session builds — the definitions a user types
# at the prompt (a struct with an impl method, an enum matched by a helper,
# a generic fn), and a main whose `uses IO` is the session block's grown
# capability. Its output is the canonical transcript's result lines, so the
# acceptance gate can replay the SAME session at the real prompt and compare
# the `=` lines the REPL prints with what the compiled program prints:
#
#   python3 tools/hls-repl.py            (pipe the canonical session in)
#   python3 boot/boot.py tests/ok/feat_stage123_repl.hls
#
# Deterministic output; interpreter and native agree byte for byte.
# ============================================================================

import "std.str"

struct Acc {
    total: int,
    count: int
}

enum Op {
    Add(int),
    Sub(int),
    Mul(int)
}

impl Acc {
    fn push(self: Acc, v: int) -> Acc {
        return Acc {
            total: self.total + v,
            count: self.count + 1
        }
    }

    fn mean(self: Acc) -> int {
        return self.total / self.count
    }
}

fn apply(acc: Acc, op: Op) -> Acc {
    return match op {
        Op.Add(v) => acc.push(v),
        Op.Sub(v) => acc.push(0 - v),
        Op.Mul(v) => acc.push(acc.total * v)
    }
}

fn last_of[T](xs: list[T]) -> T {
    return xs[xs.len() - 1]
}

fn op_name(op: Op) -> str {
    return match op {
        Op.Add(_) => "add",
        Op.Sub(_) => "sub",
        Op.Mul(_) => "mul"
    }
}

fn main() uses IO {
    let a: Acc = Acc {
        total: 0, count: 0
    }
    let a2: Acc = apply(a, Op.Add(10))
    let a3: Acc = apply(a2, Op.Add(32))
    println("= Acc { total: " + a3.total.to_str() + ", count: " +
    a3.count.to_str() + " }")
    println("= " + a3.mean().to_str())

    println("= " + apply(a3, Op.Sub(2)).total.to_str())

    let ops: list[Op] = [Op.Add(1), Op.Mul(5), Op.Sub(9)]
    let mut i: int = 0
    while i < ops.len() {
        println("= \"" + op_name(ops[i]) + "\"")
        i = i + 1
    }

    println("= \"repl.hls\"")
    println("= " + (1 < 2).to_str())
    let tail: list[int] = [7, 8]
    println("= [7, 8] (len=" + tail.len().to_str() + ")")

    println("= " + last_of([3, 1, 4, 1, 5]).to_str())
    println("= \"" + last_of(["x", "y", "z"]) + "\"")
}
