# ============================================================================
# feat_audit_pure.hls — Stage 9-beta: `--audit` flag + `pure` keyword
# ----------------------------------------------------------------------------
# This program is used by tests/run_tests.sh to verify:
#   1. The `pure` keyword is accepted by the lexer/parser.
#   2. A pure function that calls only other pure functions is OK.
#   3. The `--audit` flag prints the capability tree.
#
# The program itself, when executed, prints the sum of doubled values to
# verify pure functions still produce correct results.
# ============================================================================

# A pure function — no effects, no transitive calls to anything effectful.
fn double(x: int) -> int pure {
    return x + x
}

# A pure function calling another pure function.
fn quadruple(x: int) -> int pure {
    return double(double(x))
}

# A pure function using only pure builtins (len, range, list ops).
fn sum_first(n: int) -> int pure {
    let xs: list[int] = range(0, n)
    let mut total: int = 0
    let mut i: int = 0
    while i < xs.len() {
        total = total + xs.get(i)
        i = i + 1
    }
    return total
}

fn main() -> int uses IO {
    let a: int = double(21)
    let b: int = quadruple(5)
    let c: int = sum_first(10)
    println("double(21)=" + a.to_str())
    println("quadruple(5)=" + b.to_str())
    println("sum_first(10)=" + c.to_str())
    return 0
}
