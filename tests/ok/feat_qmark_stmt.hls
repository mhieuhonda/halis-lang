# feat_qmark_stmt.hls — Stage-17 perfection (deep-scan-10): `foo()?`
# as an expression-statement is the idiomatic propagate-and-discard
# form (the parser used to reject it).
import "std.result"

fn may_fail(n: int) -> Result[int, str] {
    if n < 0 {
        return Result.Err("negative")
    }
    return Result.Ok(n)
}

fn user() -> Result[int, str] {
    may_fail(1)?
    may_fail(2)?
    return Result.Ok(42)
}

fn main() -> int uses IO {
    let r: Result[int, str] = user()
    println("value=" + result_unwrap_or(r, -1).to_str())
    return 0
}
