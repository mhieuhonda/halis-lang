# feat_stage148_rc3.hls — Stage 148 (v1.0.0-rc.3): the third release
# candidate, the final dry-run.
#
# What this fixture pins is what an RC3 IS — the laws the final
# dry-run stood on while the surface stayed frozen:
#
#   1. the sequence   — the release day is an ordered machine: the
#      law               markers move, the tag is cut, the LTS line
#                        opens, the RC kit retires, the line is
#                        maintained. A step runs when its predecessor
#                        is done; the one idempotent step is the line
#                        init (declaring the same line again is a
#                        no-op, not noise);
#   2. the hand-off   — the boundary between the two kits is exactly
#      law               one artifact: the v1.0.0 tag. Before it the
#                        RC kit answers (readiness, gate, report);
#                        after it the LTS kit answers (status,
#                        window, backport, tag-patch, audit). The
#                        last candidate's successor and the line's
#                        base are the same release;
#   3. the retirement — a retired kit refuses, named (exit 1) — it
#      law               does not panic (101), does not exit 0, and
#                        readiness after the release names TWO laws:
#                        the roadmap law (nothing left to candidate
#                        for) and the lts law (a line is declared);
#   4. the order law  — every step's precondition is the previous
#                        step's postcondition: the tag needs the
#                        markers moved, the line needs the tag, the
#                        backport needs the line and a fix to carry,
#                        the patch needs the backport;
#   5. the window law — the clock the line opens, counted in
#                        anniversaries of the base day: bug fixes
#                        through the third, security through the
#                        fifth, nothing after — and the release day
#                        itself is active (the horizon day belongs
#                        to the phase it closes).
#
# The exit-code classes are the C runtime's own: 0 the law held, 1 a
# named refusal, 2 a usage error, 101 a runtime panic. The
# interpreter and the native binary agree on every class.
#
# The program exits 0 when every law holds, 10+section*10+case
# otherwise.

# ----------------------------------------------------------------------
# The sequence law: the release day's steps, in the only order they
# work. Step ids: 0 the eve (the last candidate anchored), 1 the
# markers move (the release docs), 2 the tag is cut, 3 the LTS line
# opens, 4 the RC kit retires, 5 the line is maintained.
# ----------------------------------------------------------------------
fn step_name(step: int) -> str {
    if step == 0 {
        return "eve"
    }
    if step == 1 {
        return "docs"
    }
    if step == 2 {
        return "tag"
    }
    if step == 3 {
        return "line"
    }
    if step == 4 {
        return "retired"
    }
    if step == 5 {
        return "maintained"
    }
    return ""
}

# may_run(step, completed) — the machine's law: a step runs when its
# predecessor is done and itself is not yet. The one exception is the
# line init: declaring the SAME line again is an idempotent no-op
# (the tool says so and changes nothing), not a second step.
fn may_run(step: int, completed: int) -> bool {
    if step < 0 || step > 5 {
        return false
    }
    if step <= completed {
        return step == 3
    }
    return step == completed + 1
}

# ----------------------------------------------------------------------
# The hand-off law: which kit answers, and when. The boundary is the
# v1.0.0 tag — before it the candidate line owns the road, after it
# the support line does.
# ----------------------------------------------------------------------
fn answers(kit: str, line_open: bool) -> str {
    if kit == "rc" {
        if line_open {
            return "refused"
        }
        return "readiness gate report"
    }
    if kit == "lts" {
        if line_open {
            return "status window backport tag-patch audit"
        }
        return "refused"
    }
    return ""
}

# The boundary artifact: the fourth candidate's successor and the
# 1.0 line's base are the SAME tag — one boundary, two kits, no gap.
fn successor_of(n: int) -> str {
    if n == 4 {
        return "v1.0.0"
    }
    if n >= 1 && n <= 3 {
        return "v1.0.0-rc." + (n + 1).to_str()
    }
    return ""
}

fn base_of_line(major: int, minor: int) -> str {
    return "v" + major.to_str() + "." + minor.to_str() + ".0"
}

# ----------------------------------------------------------------------
# The refusal taxonomy: the classes a tool's exit codes name (the
# classes the RC2 round drew, reused by the retirement law).
#   0    the law held
#   1    a named refusal (a law spoke)
#   2    a usage error (the invocation was wrong)
#   101  a runtime panic (the program ran and tripped)
# ----------------------------------------------------------------------
fn class_of_exit(code: int) -> str {
    if code == 0 {
        return "OK"
    }
    if code == 1 {
        return "REFUSAL"
    }
    if code == 2 {
        return "USAGE"
    }
    if code == 101 {
        return "PANIC"
    }
    return "UNKNOWN"
}

# The retired voice: a kit that has handed its jurisdiction over
# refuses, NAMED — it does not pretend the world is still its own
# (exit 0) and it does not crash on the hand-off (101).
fn retired_voice(code: int, names_law: bool) -> str {
    if code == 1 && names_law {
        return "refused, named"
    }
    if code == 0 {
        return "pretends"
    }
    if code == 101 {
        return "crashes"
    }
    return "wrong"
}

# readiness after the release names BOTH laws that refuse it: the
# roadmap law (every stage ticked — there is nothing left to
# candidate for) and the lts law (a line is declared — a candidate
# opens none).
fn post_release_refusals(roadmap_done: bool, line_open: bool) -> int {
    let mut n: int = 0
    if roadmap_done {
        n = n + 1
    }
    if line_open {
        n = n + 1
    }
    return n
}

# ----------------------------------------------------------------------
# The order law: the init verdicts the dry-run took in the wrong
# order, and the one it took in the right one. A pre-release is not
# a base; a pre-1.0 tag is not a line; a tag that does not exist
# cannot open one.
# ----------------------------------------------------------------------
fn init_verdict(tag: str, tag_exists: bool) -> str {
    if tag == "v1.0.0-rc.4" {
        return "refused: a pre-release is not an LTS base"
    }
    if tag == "v0.166.0" {
        return "refused: the policy begins at v1.0"
    }
    if tag == "v1.0.0" && !tag_exists {
        return "refused: the tag does not exist in the repository"
    }
    if tag == "v1.0.0" {
        return "declared"
    }
    return "refused: not a semantic version at all"
}

# The maintenance order: a backport needs the line open AND a fix on
# main to carry; the patch release needs the backport it carries.
fn backport_needs(line_open: bool, fix_on_main: bool) -> bool {
    return line_open && fix_on_main
}

fn patch_needs(backport_landed: bool) -> bool {
    return backport_landed
}

# ----------------------------------------------------------------------
# The window law: the clock the line opens, counted in anniversaries
# of the base day. The horizon day belongs to the phase it closes:
# the third birthday is the last full-support day, the fifth the
# last supported one.
# ----------------------------------------------------------------------
fn phase_at_anniversary(t: int) -> str {
    if t < 0 {
        return "before the line"
    }
    if t <= 3 {
        return "active"
    }
    if t <= 5 {
        return "security"
    }
    return "eol"
}

# What lands on the line in each phase: a plain fix backports in
# active, needs the Security mark in security, and nothing at all
# lands in eol — a dead line takes nothing.
fn lands_in_phase(phase: str, security_marked: bool) -> bool {
    if phase == "active" {
        return true
    }
    if phase == "security" {
        return security_marked
    }
    return false
}

# ======================================================================
# The batteries.
# ======================================================================

fn test_sequence() -> int {
    # the steps name themselves, in order
    if step_name(0) != "eve" {
        return 1
    }
    if step_name(1) != "docs" {
        return 2
    }
    if step_name(2) != "tag" {
        return 3
    }
    if step_name(3) != "line" {
        return 4
    }
    if step_name(4) != "retired" {
        return 5
    }
    if step_name(5) != "maintained" {
        return 6
    }
    if step_name(6) != "" || step_name(-1) != "" {
        return 7
    }
    # a step runs when its predecessor is done
    if !may_run(1, 0) {
        return 8
    }
    if !may_run(2, 1) {
        return 9
    }
    if !may_run(3, 2) {
        return 10
    }
    if !may_run(4, 3) {
        return 11
    }
    if !may_run(5, 4) {
        return 12
    }
    # nothing skips ahead, nothing runs early
    if may_run(2, 0) {
        return 13
    }
    if may_run(5, 0) {
        return 14
    }
    if may_run(0, 0) {
        return 15
    }
    # a finished step is done — except the line init, which is
    # idempotent on the same declaration
    if may_run(1, 1) {
        return 16
    }
    if may_run(2, 2) {
        return 17
    }
    if !may_run(3, 3) {
        return 18
    }
    return 0
}

fn test_handoff() -> int {
    # before the tag: the RC kit answers, the LTS kit refuses
    if answers("rc", false) != "readiness gate report" {
        return 1
    }
    if answers("lts", false) != "refused" {
        return 2
    }
    # after the line: the LTS kit answers, the RC kit refuses
    if answers("lts", true) != "status window backport tag-patch audit" {
        return 3
    }
    if answers("rc", true) != "refused" {
        return 4
    }
    # a kit nobody knows answers nothing
    if answers("ci", true) != "" {
        return 5
    }
    # the boundary is one artifact: rc.4's successor IS the 1.0
    # line's base
    if successor_of(4) != "v1.0.0" {
        return 6
    }
    if base_of_line(1, 0) != "v1.0.0" {
        return 7
    }
    if successor_of(4) != base_of_line(1, 0) {
        return 8
    }
    # the candidates before it succeed each other, not the release
    if successor_of(1) != "v1.0.0-rc.2" {
        return 9
    }
    if successor_of(3) != "v1.0.0-rc.4" {
        return 10
    }
    if successor_of(0) != "" || successor_of(5) != "" {
        return 11
    }
    return 0
}

fn test_retirement() -> int {
    # the four classes stay distinct
    if class_of_exit(0) != "OK" {
        return 1
    }
    if class_of_exit(1) != "REFUSAL" {
        return 2
    }
    if class_of_exit(2) != "USAGE" {
        return 3
    }
    if class_of_exit(101) != "PANIC" {
        return 4
    }
    if class_of_exit(7) != "UNKNOWN" {
        return 5
    }
    # the retired voice: refused, named — never pretending, never
    # crashing, never mis-classed
    if retired_voice(1, true) != "refused, named" {
        return 6
    }
    if retired_voice(0, true) != "pretends" {
        return 7
    }
    if retired_voice(101, true) != "crashes" {
        return 8
    }
    if retired_voice(1, false) != "wrong" {
        return 9
    }
    # readiness after the release names BOTH refusals
    if post_release_refusals(true, true) != 2 {
        return 10
    }
    if post_release_refusals(true, false) != 1 {
        return 11
    }
    if post_release_refusals(false, false) != 0 {
        return 12
    }
    return 0
}

fn test_order() -> int {
    # the wrong turns the dry-run took first
    if init_verdict("v1.0.0-rc.4", true)
    != "refused: a pre-release is not an LTS base" {
        return 1
    }
    if init_verdict("v0.166.0", true)
    != "refused: the policy begins at v1.0" {
        return 2
    }
    if init_verdict("v1.0.0", false)
    != "refused: the tag does not exist in the repository" {
        return 3
    }
    if init_verdict("not-a-tag", true)
    != "refused: not a semantic version at all" {
        return 4
    }
    # the right one, in the only order it works
    if init_verdict("v1.0.0", true) != "declared" {
        return 5
    }
    # the maintenance order
    if !backport_needs(true, true) {
        return 6
    }
    if backport_needs(true, false) {
        return 7
    }
    if backport_needs(false, true) {
        return 8
    }
    if !patch_needs(true) {
        return 9
    }
    if patch_needs(false) {
        return 10
    }
    return 0
}

fn test_window() -> int {
    # the release day is active, and so is every day through the
    # third anniversary (the horizon belongs to the phase it closes)
    if phase_at_anniversary(0) != "active" {
        return 1
    }
    if phase_at_anniversary(3) != "active" {
        return 2
    }
    # the day after the third birthday is security-only
    if phase_at_anniversary(4) != "security" {
        return 3
    }
    # the fifth birthday is the last supported day
    if phase_at_anniversary(5) != "security" {
        return 4
    }
    if phase_at_anniversary(6) != "eol" {
        return 5
    }
    # before the line existed the clock said nothing
    if phase_at_anniversary(-1) != "before the line" {
        return 6
    }
    # what lands in each phase
    if !lands_in_phase("active", false) {
        return 7
    }
    if !lands_in_phase("security", true) {
        return 8
    }
    if lands_in_phase("security", false) {
        return 9
    }
    if lands_in_phase("eol", true) {
        return 10
    }
    return 0
}

fn main() -> int uses IO {
    println("stage 148: v1.0.0-rc.3")
    let mut r: int = test_sequence()
    if r != 0 {
        return 10 + r
    }
    r = test_handoff()
    if r != 0 {
        return 20 + r
    }
    r = test_retirement()
    if r != 0 {
        return 30 + r
    }
    r = test_order()
    if r != 0 {
        return 40 + r
    }
    r = test_window()
    if r != 0 {
        return 50 + r
    }
    println("  RC3 laws OK: sequence, handoff, retirement, order, window")
    return 0
}
