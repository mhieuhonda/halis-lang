# feat_stage106_signed.hls — Stage 106 (v0.125.0-alpha): hls-sign,
# the signed packages (minisign, ed25519).
#
# What the differential suite pins HERE is the arithmetic the
# signature files and the release statement live on — the same
# contract `hls-sign` enforces when it signs a release:
#
#   python3 tools/hls-sign.py selftest
#   python3 boot/boot.py tests/ok/feat_stage106_signed.hls
#
# The program: the base64 geometry of the minisign lines (Ed(2) +
# sig(64) -> 88 characters, the 42-byte public blob -> 56), the
# two-signature trust rule as an AND (a rewritten trusted comment is
# a refusal, not a footnote), the key id's sixteen hex characters,
# the tamper evidence (one flipped character moves the digest — the
# reason a flipped tree byte moves content_sha256), and the release
# statement's versioned file name. Deterministic output; interpreter
# and native agree byte for byte.

import "std.str"
import "std.crypto"

# base64 length: ceil(n / 3) * 4. The minisign line is base64 of
# Ed(2) + sig(64) = 66 bytes -> 88 characters, no padding ambiguity.
fn b64_len(n: int) -> int {
    if n <= 0 {
        panic("b64_len: a payload has bytes")
    }
    return((n + 2) / 3) * 4
}

# Trust is the AND of the payload signature AND the trusted-comment
# signature — minisign's discipline, three refusals out of four rows.
fn trust(payload_ok: bool, comment_ok: bool) -> bool {
    return payload_ok && comment_ok
}

# The statement name is versioned: tool, package, version, suffix —
# the file a counterparty can find without a manifest.
fn statement_named(tool_prefix: str, name: str, version: str) -> str {
    return tool_prefix + name + "-" + version + ".release.json"
}

fn main() -> int uses IO {
    let mut checks: int = 0

    # The line geometry: 66 bytes -> 88 chars; the public blob
    # Ed(2) + id(8) + pk(32) = 42 bytes -> 56 chars; and the raw
    # signature is 64 bytes, the Ed25519 output the RFC pins.
    if b64_len(66) != 88 || b64_len(42) != 56 {
        panic("the base64 geometry of the minisign lines is wrong")
    }
    if b64_len(64) != 88 {
        panic("a raw 64-byte signature base64s to 88 too")
    }
    checks = checks + 1

    # The trust table: only both-signatures-hold is trust. A comment
    # rewritten after signing is exactly the (true, false) row.
    if !trust(true, true) {
        panic("both signatures holding is trust")
    }
    if trust(true, false) || trust(false, true) || trust(false, false) {
        panic("any other row is a refusal")
    }
    checks = checks + 1

    # The key id: eight digest bytes, sixteen hex characters, naming
    # the key in the ledger and the statement alike.
    let id_bytes: int = 8
    if id_bytes * 2 != 16 {
        panic("the key id is 16 hex characters")
    }
    if !str_starts_with("minisign public key", "minisign") {
        panic("the public key file speaks minisign's comment")
    }
    checks = checks + 1

    # Tamper evidence: one flipped character moves the digest — the
    # miniature of the release contract, where a flipped tree byte
    # moves content_sha256 and the signature stops matching.
    let a: str = crypto_fnv1a_64_hex("hls-release-statement/v1")
    let b: str = crypto_fnv1a_64_hex("hls-release-statement/v2")
    if a == b {
        panic("a flipped byte must move the digest")
    }
    if crypto_fnv1a_64_hex("hls-release-statement/v1") != a {
        panic("the same bytes must hash the same")
    }
    checks = checks + 1

    # The versioned statement file name: findable, unambiguous, and
    # never a bare schema constant in a directory of releases.
    let st: str = statement_named("hls-sign-", "rel_app", "2.3.4")
    if !str_starts_with(st, "hls-sign-rel_app-") {
        panic("the statement names its tool and its package")
    }
    if !str_ends_with(st, "-2.3.4.release.json") {
        panic("the statement names its version")
    }
    checks = checks + 1

    if checks != 5 {
        panic("expected 5 checks, ran " + checks.to_str())
    }
    println("signed packages: two signatures, one name, zero vibes")
    println("checks passed: " + checks.to_str())
    return 0
}
