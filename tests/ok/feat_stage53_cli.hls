# ============================================================================
# Test 14: --flag=value for bool flag (explicit true / false).
# ============================================================================

fn test_bool_flag_explicit_value() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv1: list[str] = ["testapp", "--verbose=false", "input.txt"]
    let r1: CliResult = cli_parse(p, argv1)
    ok(r1.ok, "bool-false: parse ok")
    eq_bool(cli_get_bool(r1, "verbose"), false, "bool-false: verbose=false (explicit)")

    let argv2: list[str] = ["testapp", "--verbose=true", "input.txt"]
    let r2: CliResult = cli_parse(p, argv2)
    ok(r2.ok, "bool-true: parse ok")
    eq_bool(cli_get_bool(r2, "verbose"), true, "bool-true: verbose=true (explicit)")

    let argv3: list[str] = ["testapp", "--verbose=1", "input.txt"]
    let r3: CliResult = cli_parse(p, argv3)
    ok(r3.ok, "bool-1: parse ok")
    eq_bool(cli_get_bool(r3, "verbose"), true, "bool-1: verbose=true (1)")

    let argv4: list[str] = ["testapp", "--verbose=0", "input.txt"]
    let r4: CliResult = cli_parse(p, argv4)
    ok(r4.ok, "bool-0: parse ok")
    eq_bool(cli_get_bool(r4, "verbose"), false, "bool-0: verbose=false (0)")
    return 0
}

# ============================================================================
# Test 15: missing required arg rejection.
# ============================================================================

fn test_missing_required() -> int uses Proc, IO {
    let p0: CliParser = cli_parser_new("reqapp", "1.0.0")
    let p1: CliParser = cli_parser_str_opt_no_default(p0, "name", "n", "Name", true)
    let p2: CliParser = cli_parser_str_positional(p1, "input", "Input file", true)

    # Missing both required args.
    let argv1: list[str] = ["reqapp"]
    let r1: CliResult = cli_parse(p2, argv1)
    ok(!r1.ok, "missing-req: parse failed (as expected)")
    ok(r1.error.contains("missing required argument"), "missing-req: error mentions 'missing required argument'")
    ok(r1.error.contains("--name"), "missing-req: error mentions --name")
    ok(r1.error.contains("<input>"), "missing-req: error mentions <input>")

    # Provide one, missing the other.
    let argv2: list[str] = ["reqapp", "--name", "alice"]
    let r2: CliResult = cli_parse(p2, argv2)
    ok(!r2.ok, "missing-req-2: parse failed (still missing input)")
    ok(r2.error.contains("missing required argument"), "missing-req-2: error mentions 'missing required argument'")
    ok(r2.error.contains("<input>"), "missing-req-2: error mentions <input>")
    ok(!r2.error.contains("--name"), "missing-req-2: error does NOT mention --name (it was provided)")

    # Provide both — succeeds.
    let argv3: list[str] = ["reqapp", "--name", "bob", "data.txt"]
    let r3: CliResult = cli_parse(p2, argv3)
    ok(r3.ok, "missing-req-3: parse ok (both required provided)")
    eq_str(cli_get_str(r3, "name"), "bob", "missing-req-3: name=bob")
    eq_str(cli_get_str(r3, "input"), "data.txt", "missing-req-3: input=data.txt")
    return 0
}

# ============================================================================
# Test 16: env-var fallback.
# ============================================================================

fn test_env_fallback() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    # Set TESTAPP_PORT env var, don't pass --port on CLI.
    env_set("TESTAPP_PORT", "7777")
    let argv: list[str] = ["testapp", "input.txt"]
    let r: CliResult = cli_parse(p, argv)
    ok(r.ok, "env: parse ok")
    eq_int(cli_get_int(r, "port"), 7777, "env: port=7777 (from env)")
    # Cleanup.
    env_unset("TESTAPP_PORT")

    # CLI takes precedence over env.
    env_set("TESTAPP_PORT", "7777")
    let argv2: list[str] = ["testapp", "--port=9999", "input.txt"]
    let r2: CliResult = cli_parse(p, argv2)
    ok(r2.ok, "env-cli-precedence: parse ok")
    eq_int(cli_get_int(r2, "port"), 9999, "env-cli-precedence: port=9999 (CLI overrides env)")
    env_unset("TESTAPP_PORT")
    return 0
}

# ============================================================================
# Test 17: cli_has distinguishes "provided" from "default".
# ============================================================================

fn test_cli_has_vs_default() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    # Don't pass --port — port should be 8080 (default), but cli_has
    # returns false (it was not EXPLICITLY provided).
    let argv: list[str] = ["testapp", "input.txt"]
    let r: CliResult = cli_parse(p, argv)
    ok(r.ok, "has-vs-default: parse ok")
    eq_int(cli_get_int(r, "port"), 8080, "has-vs-default: port=8080 (default)")
    ok(!cli_has(r, "port"), "has-vs-default: cli_has(port)=false (default, not explicit)")

    # Pass --port explicitly.
    let argv2: list[str] = ["testapp", "--port=8080", "input.txt"]
    let r2: CliResult = cli_parse(p, argv2)
    ok(r2.ok, "has-explicit: parse ok")
    eq_int(cli_get_int(r2, "port"), 8080, "has-explicit: port=8080 (explicit)")
    ok(cli_has(r2, "port"), "has-explicit: cli_has(port)=true (explicit)")
    return 0
}

# ============================================================================
# Test 18: int positional arg.
# ============================================================================

fn test_int_positional() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv: list[str] = ["testapp", "input.txt", "42"]
    let r: CliResult = cli_parse(p, argv)
    ok(r.ok, "int-pos: parse ok")
    eq_str(cli_get_str(r, "input"), "input.txt", "int-pos: input=input.txt")
    eq_int(cli_get_int(r, "count"), 42, "int-pos: count=42")

    # Invalid int positional — type-safe rejection.
    let argv2: list[str] = ["testapp", "input.txt", "notanumber"]
    let r2: CliResult = cli_parse(p, argv2)
    ok(!r2.ok, "int-pos-bad: parse failed (as expected)")
    ok(r2.error.contains("invalid integer value"), "int-pos-bad: error mentions 'invalid integer value'")
    # Deep-scan-22 fix: positional error uses <name> not --name.
    ok(r2.error.contains("<count>"), "int-pos-bad: error uses <count> (positional syntax)")
    return 0
}

# ============================================================================
# Test 19: cli_print_help produces expected lines.
# ============================================================================

fn test_help_output() -> int uses Proc, IO {
    # We can't easily capture stdout in a unit test, so this is a
    # smoke test — just verify cli_print_help runs without panicking.
    # The differential test (interpreter vs native) verifies the OUTPUT
    # is byte-identical between backends.
    let p: CliParser = build_test_parser()
    cli_print_help(p)
    println("  (help printed above)")
    return 0
}

# ============================================================================
# Test 20: cli_print_version produces expected output.
# ============================================================================

fn test_version_output() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    cli_print_version(p)
    println("  (version printed above)")
    return 0
}

# ============================================================================
# Test 21: --flag without value sets bool=true.
# ============================================================================

fn test_bool_flag_presence() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv1: list[str] = ["testapp", "--verbose", "input.txt"]
    let r1: CliResult = cli_parse(p, argv1)
    ok(r1.ok, "flag-presence: parse ok")
    eq_bool(cli_get_bool(r1, "verbose"), true, "flag-presence: verbose=true (--verbose)")

    let argv2: list[str] = ["testapp", "-v", "input.txt"]
    let r2: CliResult = cli_parse(p, argv2)
    ok(r2.ok, "flag-presence-short: parse ok")
    eq_bool(cli_get_bool(r2, "verbose"), true, "flag-presence-short: verbose=true (-v)")

    # Without the flag — default false.
    let argv3: list[str] = ["testapp", "input.txt"]
    let r3: CliResult = cli_parse(p, argv3)
    ok(r3.ok, "flag-presence-none: parse ok")
    eq_bool(cli_get_bool(r3, "verbose"), false, "flag-presence-none: verbose=false (not given)")
    return 0
}

# ============================================================================
# Test 22: option without value (at end of argv) is an error.
# ============================================================================

fn test_option_missing_value() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv: list[str] = ["testapp", "--port"]
    let r: CliResult = cli_parse(p, argv)
    ok(!r.ok, "opt-no-value: parse failed (as expected)")
    ok(r.error.contains("requires a value"), "opt-no-value: error mentions 'requires a value'")
    return 0
}

# ============================================================================
# Main — run all tests sequentially.
# ============================================================================

fn main() -> int uses Args, Proc, IO {
    println("=== Stage 53: std.cli (type-safe argument parser) ===")
    println("")
    println("--- typical invocation (-v --port=9000 input) ---")
    test_typical_invocation()
    println("  ok")
    println("--- short option with separate value (-p 3000 --host 0.0.0.0) ---")
    test_short_option_separate_value()
    println("  ok")
    println("--- defaults applied (only positional given) ---")
    test_defaults_applied()
    println("  ok")
    println("--- --help / -h sets help_requested ---")
    test_help_flag()
    println("  ok")
    println("--- --version / -V sets version_requested ---")
    test_version_flag()
    println("  ok")
    println("--- subcommand 'init' (no remaining args) ---")
    test_subcommand_init()
    println("  ok")
    println("--- subcommand 'build' with extra args (remaining populated) ---")
    test_subcommand_build_with_args()
    println("  ok")
    println("--- -- end-of-options marker ---")
    test_end_of_options()
    println("  ok")
    println("--- invalid int value (type-safe rejection at parse time) ---")
    test_invalid_int_rejected()
    println("  ok")
    println("--- invalid float value ---")
    test_invalid_float_rejected()
    println("  ok")
    println("--- unknown option rejection ---")
    test_unknown_option_rejected()
    println("  ok")
    println("--- valid float value (--timeout 5.5) ---")
    test_float_value()
    println("  ok")
    println("--- short option with =value (-p=4000) ---")
    test_short_option_eq_value()
    println("  ok")
    println("--- bool flag with explicit value (--verbose=false/true/1/0) ---")
    test_bool_flag_explicit_value()
    println("  ok")
    println("--- missing required arg rejection ---")
    test_missing_required()
    println("  ok")
    println("--- env-var fallback (PORT env -> port option) ---")
    test_env_fallback()
    println("  ok")
    println("--- cli_has distinguishes 'provided' from 'default' ---")
    test_cli_has_vs_default()
    println("  ok")
    println("--- int positional arg (with type-safe rejection) ---")
    test_int_positional()
    println("  ok")
    println("--- cli_print_help smoke test ---")
    test_help_output()
    println("  ok")
    println("--- cli_print_version smoke test ---")
    test_version_output()
    println("  ok")
    println("--- bool flag presence (--verbose / -v) ---")
    test_bool_flag_presence()
    println("  ok")
    println("--- option without value at end of argv (error) ---")
    test_option_missing_value()
    println("  ok")
    println("")
    println("ACCEPTANCE OK: Stage 53 — std.cli (type-safe argument parser)")
    println("  CliParser builder (flag / int_opt / str_opt / float_opt / positional)")
    println("  Type-safe parsing (invalid int/float/bool rejected at parse time)")
    println("  Long/short options (--port / -p) with =value and separate value")
    println("  Bool flags (--verbose / -v) with optional explicit value")
    println("  Defaults (applied when option not given; cli_has=false)")
    println("  Env-var fallback (cli_parser_env; CLI takes precedence over env)")
    println("  Subcommands (init / build; remaining args go to cli_remaining_args)")
    println("  --help / -h and --version / -V (implicit, always registered)")
    println("  -- end-of-options marker (rest treated as positional)")
    println("  Required arg validation (missing required -> error)")
    println("  Help text generation (cli_print_help) and version (cli_print_version)")
    println("  Pure-HLS implementation (no new compiler builtins)")
    println("  differential (interpreter == native) verified green.")
    return 0
}
