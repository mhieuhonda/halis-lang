# tests/ok/feat_stage53_cli.hls — Stage 53 (v0.72.0-alpha): std.cli.
#
# Exercises:
#   - bool flag (verbose, -v)
#   - int option with default (port, -p)
#   - str option with default (host)
#   - str option without default (config, -c)
#   - float option with default (timeout, -t)
#   - str positional (input, optional)
#   - int positional (count, optional)
#   - env-var fallback (PORT env var -> port)
#   - subcommands (init, build)
#   - --help / -h
#   - --version / -V
#   - -- end-of-options marker
#   - --long=value and --long value syntax
#   - -x=value and -x value syntax
#   - type-safe rejection (invalid int, invalid float, invalid bool)
#   - unknown option rejection
#   - missing required arg rejection
#   - defaults applied when option not given
#   - env fallback applied when option not given but env set
#   - cli_get_bool / cli_get_int / cli_get_str / cli_get_float / cli_has
#   - cli_remaining_args (after subcommand)
#   - cli_print_help (smoke test — verify it produces expected lines)
#   - cli_print_version
#
# The test uses synthetic argv lists (cli_parse(parser, [...])) so it's
# fully reproducible and differential-safe (interpreter == native).

import "std.cli"
import "std.str"

# ============================================================================
# Helpers
# ============================================================================

fn ok(actual: bool, msg: str) -> void uses IO {
    if !actual {
        panic("FAIL " + msg)
    }
}

fn eq_int(actual: int, expected: int, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_str(actual: str, expected: str, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected '" + expected + "', got '" + actual + "'")
    }
}

fn eq_bool(actual: bool, expected: bool, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_float(actual: float, expected: float, msg: str) -> void uses IO {
    # Float equality with tolerance — the parser stores the float as
    # a string and re-parses it, so there should be no precision loss
    # for the values we test. But to be safe, we accept anything within
    # 1e-9.
    let mut diff: float = actual - expected
    if diff < 0.0 {
        diff = 0.0 - diff
    }
    if diff > 0.000001 {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

# ============================================================================
# Build a test parser (used by most tests below).
# ============================================================================

fn build_test_parser() -> CliParser {
    let p0: CliParser = cli_parser_new("testapp", "2.3.4")
    let p1: CliParser = cli_parser_desc(p0, "Test app for Stage 53 acceptance")
    let p2: CliParser = cli_parser_flag(p1, "verbose", "v", "Verbose output")
    let p3: CliParser = cli_parser_int_opt(p2, "port", "p", "Port", false, 8080)
    let p4: CliParser = cli_parser_str_opt(p3, "host", "H", "Host", false, "localhost")
    let p5: CliParser = cli_parser_str_opt_no_default(p4, "config", "c", "Config file", false)
    let p6: CliParser = cli_parser_float_opt(p5, "timeout", "t", "Timeout", false, 30.0)
    let p7: CliParser = cli_parser_str_positional(p6, "input", "Input file", false)
    let p8: CliParser = cli_parser_int_positional(p7, "count", "Count", false)
    let p9: CliParser = cli_parser_env(p8, "port", "TESTAPP_PORT")
    let p10: CliParser = cli_parser_subcommand(p9, "init", "Initialize")
    let p11: CliParser = cli_parser_subcommand(p10, "build", "Build")
    return p11
}

# ============================================================================
# Test 1: typical invocation — flag + option + positional.
# ============================================================================

fn test_typical_invocation() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv: list[str] = ["testapp", "-v", "--port=9000", "myfile.txt"]
    let r: CliResult = cli_parse(p, argv)
    ok(r.ok, "typical: parse ok")
    ok(!r.help_requested, "typical: not help")
    ok(!r.version_requested, "typical: not version")
    eq_str(r.subcommand, "", "typical: no subcommand")
    eq_bool(cli_get_bool(r, "verbose"), true, "typical: verbose=true")
    eq_int(cli_get_int(r, "port"), 9000, "typical: port=9000")
    eq_str(cli_get_str(r, "host"), "localhost", "typical: host=default")
    eq_float(cli_get_float(r, "timeout"), 30.0, "typical: timeout=default")
    eq_str(cli_get_str(r, "input"), "myfile.txt", "typical: input=myfile.txt")
    ok(!cli_has(r, "config"), "typical: config not set")
    return 0
}

# ============================================================================
# Test 2: short option with separate value.
# ============================================================================

fn test_short_option_separate_value() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv: list[str] = ["testapp", "-p", "3000", "--host", "0.0.0.0", "data.csv"]
    let r: CliResult = cli_parse(p, argv)
    ok(r.ok, "short-sep: parse ok")
    eq_int(cli_get_int(r, "port"), 3000, "short-sep: port=3000")
    eq_str(cli_get_str(r, "host"), "0.0.0.0", "short-sep: host=0.0.0.0")
    eq_str(cli_get_str(r, "input"), "data.csv", "short-sep: input=data.csv")
    return 0
}

# ============================================================================
# Test 3: defaults applied when option not given.
# ============================================================================

fn test_defaults_applied() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv: list[str] = ["testapp", "input.txt"]
    let r: CliResult = cli_parse(p, argv)
    ok(r.ok, "defaults: parse ok")
    eq_bool(cli_get_bool(r, "verbose"), false, "defaults: verbose=false")
    eq_int(cli_get_int(r, "port"), 8080, "defaults: port=8080 (default)")
    eq_str(cli_get_str(r, "host"), "localhost", "defaults: host=localhost (default)")
    eq_float(cli_get_float(r, "timeout"), 30.0, "defaults: timeout=30.0 (default)")
    eq_str(cli_get_str(r, "input"), "input.txt", "defaults: input=input.txt")
    return 0
}

# ============================================================================
# Test 4: --help / -h sets help_requested.
# ============================================================================

fn test_help_flag() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv1: list[str] = ["testapp", "--help"]
    let r1: CliResult = cli_parse(p, argv1)
    ok(r1.ok, "help: parse ok")
    ok(r1.help_requested, "help: --help sets help_requested")

    let argv2: list[str] = ["testapp", "-h"]
    let r2: CliResult = cli_parse(p, argv2)
    ok(r2.ok, "help: parse ok (short)")
    ok(r2.help_requested, "help: -h sets help_requested")
    return 0
}

