# Test 5: --version / -V sets version_requested.
# ============================================================================

fn test_version_flag() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv1: list[str] = ["testapp", "--version"]
    let r1: CliResult = cli_parse(p, argv1)
    ok(r1.ok, "version: parse ok")
    ok(r1.version_requested, "version: --version sets version_requested")

    let argv2: list[str] = ["testapp", "-V"]
    let r2: CliResult = cli_parse(p, argv2)
    ok(r2.ok, "version: parse ok (short)")
    ok(r2.version_requested, "version: -V sets version_requested")
