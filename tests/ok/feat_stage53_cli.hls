# ============================================================================

fn test_short_option_eq_value() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv: list[str] = ["testapp", "-p=4000", "input.txt"]
    let r: CliResult = cli_parse(p, argv)
