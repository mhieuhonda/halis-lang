# ============================================================================
# Test 6: subcommand "init" — sets subcommand, no remaining args.
# ============================================================================

fn test_subcommand_init() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv: list[str] = ["testapp", "init"]
    let r: CliResult = cli_parse(p, argv)
    ok(r.ok, "sub-init: parse ok")
    eq_str(r.subcommand, "init", "sub-init: subcommand=init")
    eq_int(cli_remaining_args(r).len(), 0, "sub-init: no remaining args")
    return 0
}

# ============================================================================
# Test 7: subcommand "build" with extra args — remaining contains them.
# ============================================================================

fn test_subcommand_build_with_args() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv: list[str] = ["testapp", "build", "--release", "--target=wasm32"]
    let r: CliResult = cli_parse(p, argv)
    ok(r.ok, "sub-build: parse ok")
    eq_str(r.subcommand, "build", "sub-build: subcommand=build")
    let rem: list[str] = cli_remaining_args(r)
    eq_int(rem.len(), 2, "sub-build: 2 remaining args")
    eq_str(rem.get(0), "--release", "sub-build: remaining[0]=--release")
    eq_str(rem.get(1), "--target=wasm32", "sub-build: remaining[1]=--target=wasm32")
    return 0
}

# ============================================================================
# Test 8: -- end-of-options marker.
# ============================================================================

fn test_end_of_options() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv: list[str] = ["testapp", "--", "--weird-filename"]
    let r: CliResult = cli_parse(p, argv)
    ok(r.ok, "endopt: parse ok")
    eq_str(cli_get_str(r, "input"), "--weird-filename", "endopt: input=--weird-filename")
    return 0
}

# ============================================================================
# Test 9: invalid int value (type-safe rejection at parse time).
# ============================================================================

fn test_invalid_int_rejected() -> int uses Proc, IO {
    let p: CliParser = build_test_parser()
    let argv: list[str] = ["testapp", "--port=abc", "input.txt"]
    let r: CliResult = cli_parse(p, argv)
    ok(!r.ok, "int-reject: parse failed (as expected)")
    ok(r.error.contains("invalid integer value"), "int-reject: error mentions 'invalid integer value'")
    ok(r.error.contains("abc"), "int-reject: error mentions the bad value 'abc'")
    return 0
}

