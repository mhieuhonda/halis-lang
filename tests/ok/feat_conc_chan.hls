# feat_conc_chan.hls — Stage 16 (v0.27.0-alpha): channels + request/reply.
# Deterministic pattern: request channel has exactly ONE receiver (the
# worker); reply channel has exactly ONE receiver (main). FIFO per channel
# makes the whole exchange deterministic.

fn worker(req: Chan[int], rep: Chan[int]) -> int uses Conc {
    let mut total: int = 0
    let mut i: int = 0
    while i < 4 {
        let v: int = req.recv()
        total = total + v
        rep.send(v * 10)
        i = i + 1
    }
    return total
}

fn main() -> int uses IO, Conc {
    let req: Chan[int] = chan_new()
    let rep: Chan[int] = chan_new()
    let t: Task[int] = spawn(worker, clone(req), clone(rep))
    req.send(1)
    req.send(2)
    req.send(3)
    req.send(4)
    let mut acc: int = 0
    let mut i: int = 0
    while i < 4 {
        acc = acc + rep.recv()
        i = i + 1
    }
    let total: int = t.join()
    println("replies=" + acc.to_str() + " total=" + total.to_str())

    # chan.len() reports the pending message count.
    let ch: Chan[str] = chan_new()
    ch.send("a")
    ch.send("b")
    println("pending=" + ch.len().to_str())
    let a: str = ch.recv()
    let b: str = ch.recv()
    println("got=" + a + b + " pending=" + ch.len().to_str())
    return 0
}
