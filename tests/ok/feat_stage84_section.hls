# ============================================================================
# tests/ok/feat_stage84_section.hls — Stage 84: custom sections + link script
# ----------------------------------------------------------------------------
# #![no_std] so the same source runs in the interpreter, natively, and
# linked -nostdlib: the module and the language features under test carry
# no libc dependency. Exit 0 = all assertions passed; a non-zero code
# names the first assertion that failed.
# ============================================================================

#![no_std]

import "core.option"
import "core.result"
import "core.section"

# A small but complete kernel-style script: a base address, a
# location-counter assignment, an aligned code section, a pinned
# read-only section, a metadata section named after its input, an
# initialised section, and a NOLOAD bss with symbols.
fn t_script() -> str {
    return "/* test image */\nENTRY(_start)\nSECTIONS\n{\n    . = 0x100000;\n    .text : ALIGN(4)\n    {\n        KEEP(*(.text .text.*))\n    }\n    .rodata 0x200000 : ALIGN(8)\n    {\n        *(.rodata .rodata.*)\n    }\n    .halis_metadata : ALIGN(16)\n    {\n        __halis_metadata_start = .;\n        KEEP(*(.halis.metadata))\n    }\n    .data : ALIGN(8)\n    {\n        *(.data .data.*)\n    }\n    .bss (NOLOAD) : ALIGN(4096)\n    {\n        *(.bss .bss.*)\n        *(COMMON)\n    }\n    _end = .;\n}\n"
}
fn t_sizes() -> map[str, int] {
    let mut m: map[str, int] = map_new()
    m.set(".text", 4096)
    m.set(".rodata", 512)
    m.set(".halis_metadata", 64)
    m.set(".data", 256)
    m.set(".bss", 16384)
    return m
}

fn t_sections() -> list[OutputSection] {
    return result_unwrap(parse_link_script(t_script()))
}

fn main() -> int {
    # ------------------------------------------------------------------
    # Name validation (1..20) — the rules both compilers enforce
    # ------------------------------------------------------------------
    if section_fault_code(section_check(".text.boot")) != 0 {
        return 1
    }
    if section_fault_code(section_check(".text")) != 6 {
        return 2
    }
    if section_fault_code(section_check(".rodata")) != 6 {
        return 3
    }
    if section_fault_code(section_check(".data")) != 6 {
        return 4
    }
    if section_fault_code(section_check(".bss")) != 6 {
        return 5
    }
    if section_fault_code(section_check(".halis.metadata")) != 6 {
        return 6
    }
    if section_fault_code(section_check(".halis.sections")) != 6 {
        return 7
    }
    if section_fault_code(section_check("")) != 1 {
        return 8
    }
    # A leading LETTER is legal too — only a digit is not, because
    # "0text" reads as a linker expression rather than a section name.
    if section_fault_code(section_check("text.boot")) != 0 {
        return 9
    }
    if section_fault_code(section_check("0text")) != 3 {
        return 10
    }
    if section_fault_code(section_check("$x")) != 3 {
        return 11
    }
    if section_fault_code(section_check(".text boot")) != 4 {
        return 12
    }
    if section_fault_code(section_check(".text/boot")) != 4 {
        return 13
    }
    if section_fault_code(section_check(".text..boot")) != 5 {
        return 14
    }
    if section_fault_code(section_check("..")) != 5 {
        return 15
    }
    if section_fault_code(section_check("_boot_stub")) != 0 {
        return 16
    }
    if section_fault_code(section_check(".$boot")) != 0 {
        return 17
    }
    if section_fault_code(section_check(".TXT9")) != 0 {
        return 18
    }
    if section_fault_name(section_check("")) != "empty" {
        return 19
    }
    if section_check_why(".text") == "" {
        return 20
    }

    # ------------------------------------------------------------------
    # The length limit (21..22)
    # ------------------------------------------------------------------
    if section_max_name() != 64 {
        return 21
    }
    let mut long_ok: str = ".text."
    let mut li: int = 0
    while li < 58 {
        long_ok = long_ok + "a"
        li = li + 1
    }
    if long_ok.len() != 64 {
        return 22
    }
    if section_fault_code(section_check(long_ok)) != 0 {
        return 23
    }
    if section_fault_code(section_check(long_ok + "a")) != 2 {
        return 24
    }
    if section_check_why(long_ok + "a").find("65") < 0 {
        return 25
    }

    # ------------------------------------------------------------------
    # Alignment (26..30)
    # ------------------------------------------------------------------
    if !section_align_ok(1) || !section_align_ok(64) || !section_align_ok(4096) {
        return 26
    }
    if section_align_ok(0) || section_align_ok(-8) {
        return 27
    }
    if section_align_ok(3) || section_align_ok(48) || section_align_ok(1000) {
        return 28
    }
    if section_max_align() != 65536 {
        return 29
    }
    if !section_align_ok(65536) || section_align_ok(131072) {
        return 30
    }

    # ------------------------------------------------------------------
    # Section kinds (31..40)
    # ------------------------------------------------------------------
    if section_kind_name(section_kind(".text")) != "text" {
        return 31
    }
    if section_kind_name(section_kind(".text.boot")) != "text" {
        return 32
    }
    if section_kind_name(section_kind(".rodata.str")) != "rodata" {
        return 33
    }
    if section_kind_name(section_kind(".data.rel.ro")) != "data" {
        return 34
    }
    if section_kind_name(section_kind(".bss")) != "bss" {
        return 35
    }
    if section_kind_name(section_kind(".tbss")) != "noload" {
        return 36
    }
    if section_kind_name(section_kind(".halis.metadata")) != "other" {
        return 37
    }
    if section_kind_name(section_kind("")) != "other" {
        return 38
    }
    if !section_kind_has_bytes(section_kind(".text")) || section_kind_has_bytes(section_kind(".bss")) {
        return 39
    }
    if section_kind_executable(section_kind(".text.isr")) != true {
        return 40
    }
    if section_kind_executable(section_kind(".data")) != false {
        return 41
    }
    if section_kind_writable(section_kind(".text.isr")) != false {
        return 42
    }
    if section_kind_writable(section_kind(".data.x")) != true {
        return 43
    }
    if section_kind_has_bytes(section_kind(".tbss")) != false {
        return 44
    }

    # ------------------------------------------------------------------
    # Script reading (45..56)
    # ------------------------------------------------------------------
    let secs: list[OutputSection] = t_sections()
    if secs.len() != 5 {
        return 45
    }
    if secs.get(0).name != ".text" || secs.get(1).name != ".rodata" {
        return 46
    }
    if secs.get(4).name != ".bss" {
        return 47
    }
    if secs.get(0).align != 4 || secs.get(1).align != 8 {
        return 48
    }
    if secs.get(2).align != 16 || secs.get(4).align != 4096 {
        return 49
    }
    if secs.get(4).noload != true || secs.get(0).noload != false {
        return 50
    }
    if secs.get(0).inputs.len() != 2 {
        return 51
    }
    if secs.get(0).inputs.get(0) != ".text" || secs.get(0).inputs.get(1) != ".text.*" {
        return 52
    }
    if secs.get(1).vma != 2097152 {
        return 53
    }
    if secs.get(0).vma != 0 {
        return 54
    }
    if script_fault_code(ScriptFault.None) != 0 {
        return 55
    }
    if script_fault_name(ScriptFault.NoSectionsBlock) != "no-sections-block" {
        return 56
    }

    # ------------------------------------------------------------------
    # A script with no SECTIONS block is rejected, not guessed at
    # ------------------------------------------------------------------
    let none: list[OutputSection] = []
    if result_is_ok(parse_link_script("ENTRY(_start)\n")) {
        return 57
    }
    if script_fault_code(result_unwrap_err(parse_link_script("ENTRY(_start)\n"))) != 1 {
        return 58
    }
    if result_is_ok(parse_link_script("")) {
        return 59
    }
    if script_placed_patterns("no sections here").len() != 0 {
        return 60
    }

    # ------------------------------------------------------------------
    # Coverage (61..70)
    # ------------------------------------------------------------------
    if script_covers(secs, ".text.boot_stub") != ".text" {
        return 61
    }
    if script_covers(secs, ".text") != ".text" {
        return 62
    }
    if script_covers(secs, ".text.ANYTHING") != ".text" {
        return 63
    }
    if script_covers(secs, ".textx") != "" {
        return 64
    }
    if script_covers(secs, ".rodata.pool") != ".rodata" {
        return 65
    }
    if script_covers(secs, ".halis.metadata") != ".halis_metadata" {
        return 66
    }
    if script_covers(secs, ".data.x") != ".data" {
        return 67
    }
    if script_covers(secs, ".bss.heap") != ".bss" {
        return 68
    }
    if script_covers(secs, ".bogus") != "" {
        return 69
    }
    if script_covers(none, ".text") != "" {
        return 70
    }
    if pattern_matches(".text*", ".text.boot") != true {
        return 71
    }
    if pattern_matches(".text", ".text.boot") != false {
        return 72
    }
    if script_covers_text(t_script(), ".text.isr") != ".text" {
        return 73
    }

    # ------------------------------------------------------------------
    # Placed patterns (74..77)
    # ------------------------------------------------------------------
    let pats: list[str] = script_placed_patterns(t_script())
    let mut has_text: bool = false
    let mut has_wild: bool = false
    let mut i: int = 0
    while i < pats.len() {
        if pats.get(i) == ".text" {
            has_text = true
        }
        if pats.get(i) == ".text.*" {
            has_wild = true
        }
        i = i + 1
    }
    if !has_text || !has_wild {
        return 74
    }
    if pats.len() < 7 {
        return 75
    }
    if ls_sections_block("no sections here") != "" {
        return 76
    }
    if ls_sections_block(t_script()).len() < 40 {
        return 77
    }

    # ------------------------------------------------------------------
    # Comments are stripped, so a section named inside one is not real
    # ------------------------------------------------------------------
    if script_covers(secs, ".comment") != "" {
        return 78
    }
    if ls_strip_comments("a /* b */ c").find("b") >= 0 {
        return 79
    }
    # Newlines inside a comment are preserved so the line-oriented
    # output-section scan still lines up: "a /* b\n*/ c" keeps the
    # newline, "a /* b */ c" collapses to 4 bytes.
    if ls_strip_comments("a /* b */ c").len() != 4 {
        return 80
    }

    # ------------------------------------------------------------------
    # The placement solver (81..95)
    # ------------------------------------------------------------------
    let laid: Result[ImageLayout, LayoutFault] = layout_image(1048576, secs, t_sizes())
    if result_is_err(laid) {
        return 81
    }
    let l: ImageLayout = result_unwrap(laid)
    if l.base != 1048576 {
        return 82
    }
    if l.entries.len() != 5 {
        return 83
    }
    if l.entries.get(0).vma != 1048576 {
        return 84
    }
    if l.entries.get(0).size != 4096 {
        return 85
    }
    # .rodata is PINNED at 0x200000 by the script, so the counter jumps.
    if l.entries.get(1).vma != 2097152 {
        return 86
    }
    if l.entries.get(2).vma != 2097664 {
        return 87
    }
    if l.entries.get(3).vma != 2097728 {
        return 88
    }
    if l.entries.get(4).vma != 2101248 {
        return 89
    }
    # .bss is ALIGN(4096) and follows .data at 0x1FFFE0, so it rounds
    # up to 0x201000 and runs 16 KiB to 0x205000.
    if l.end != 2117632 {
        return 90
    }
    if layout_file_bytes(l) != 4928 {
        return 91
    }
    if layout_load_end(l) != 2097984 {
        return 92
    }
    if !layout_contains(l, 1048580) {
        return 93
    }
    if layout_contains(l, 1048570) {
        return 94
    }
    if layout_section_at(l, 2097160) != ".rodata" {
        return 95
    }
    if layout_section_at(l, 0) != "" {
        return 96
    }
    if ls_strip_comments("a /* b\n*/ c").len() != 5 {
        return 113
    }
    # An unterminated comment swallows the rest of the file — which is
    # what a real linker does too.
    if ls_strip_comments("a /* unterminated").find("unterminated") >= 0 {
        return 114
    }
    # 0x201000 = 2101248 is the first byte of .bss: .data ends at
    # 0x1FFFE0 and ALIGN(4096) rounds up to the next page.
    if !layout_contains(l, 2101300) {
        return 97
    }
    if layout_section_at(l, 2101300) != ".bss" {
        return 98
    }

    # ------------------------------------------------------------------
    # Faults the solver reports instead of producing a wrong image
    # ------------------------------------------------------------------
    if layout_fault_code(LayoutFault.None) != 0 {
        return 99
    }
    if layout_fault_name(LayoutFault.Overlap) != "overlap" {
        return 100
    }
    let bad_align: list[OutputSection] = [
    OutputSection {
        name: ".text", vma: 0, align: 3, noload: false, inputs: []
    }
    ]
    if layout_fault_code(result_unwrap_err(layout_image(1048576, bad_align, t_sizes()))) != 3 {
        return 101
    }
    let neg: map[str, int] = map_new()
    neg.set(".text", -8)
    if layout_fault_code(result_unwrap_err(layout_image(1048576, secs, neg))) != 2 {
        return 102
    }
    # Two pinned sections that overlap are an error, not a silent image.
    let overlap: list[OutputSection] = [
    OutputSection {
        name: ".text", vma: 1048576, align: 4, noload: false, inputs: []
    },
    OutputSection {
        name: ".data", vma: 1048600, align: 4, noload: false, inputs: []
    }
    ]
    if layout_fault_code(result_unwrap_err(layout_image(0, overlap, t_sizes()))) != 1 {
        return 103
    }
    # A NOLOAD section may share bytes with its neighbour on purpose (a
    # guard region is carved out of the space after it) — never an error.
    let guard: list[OutputSection] = [
    OutputSection {
        name: ".bss", vma: 1048576, align: 4, noload: false, inputs: []
    },
    OutputSection {
        name: ".guard", vma: 1048576, align: 4, noload: true, inputs: []
    }
    ]
    if result_is_err(layout_image(0, guard, t_sizes())) {
        return 104
    }
    # align_up
    if align_up(0, 16) != 0 || align_up(1, 16) != 16 {
        return 105
    }
    if align_up(16, 16) != 16 || align_up(17, 16) != 32 {
        return 106
    }
    if align_up(4095, 4096) != 4096 {
        return 107
    }

    # ------------------------------------------------------------------
    # The rendered link map (108..112)
    # ------------------------------------------------------------------
    let map: str = layout_render(l)
    if map.find(".text") < 0 || map.find("0x100000") < 0 {
        return 108
    }
    if map.find("0x200000") < 0 {
        return 109
    }
    if map.find("Halis image layout") != 0 {
        return 110
    }
    if hex64(0) != "0x0" || hex64(255) != "0xff" {
        return 111
    }
    if hex64(4096) != "0x1000" {
        return 112
    }
    return 0
}
