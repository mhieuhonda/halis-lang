# feat_stage111_cap_spawn.hls — Stage 111 (v0.130.0-alpha).
# Authority crosses a task boundary the same way it crosses a fn
# boundary: explicitly. The token is minted fresh at the spawn site
# (cap_take is main-only; a bare-ident owned argument cannot cross a
# spawn — Stage 16's freshness rule), the worker's Cap[Net] parameter
# grants its body, and main's grants cover the worker's computed Net
# requirement through the fixpoint. join() makes the output
# deterministic for the differential gates.

fn fetch(c: Cap[Net]) -> int {
    let ip: str = net_lookup("localhost")
    return ip.len()
}

fn main() -> int {
    let io: Cap[IO] = cap_take("IO")
    let conc: Cap[Conc] = cap_take("Conc")
    let t: Task[int] = spawn(fetch, cap_take("Net"))
    let n: int = t.join()
    println("resolved, len=" + n.to_str())
    return 0
}
