# feat_shortcircuit_slice.hls — v0.36.0-alpha regression test.
#
# Found while building the Stage 20 LTO machinery: the C backend's
# statement-level expression hoisting pulled fresh pointer
# subexpressions out of the RIGHT operand of `&&`, evaluating them
# eagerly and destroying HLS's lazy short-circuit semantics. The
# interpreter never evaluated the slice below on the `k.len() < 2`
# path; the native build did — and panicked "invalid string slice".
# The fix scopes the right operand's fresh subexpressions inside a GCC
# statement expression at the operand position.
#
# Both implementations must agree, byte for byte, on every path.

fn short_id(s: str, n: int) -> str {
    # A tiny helper whose RESULT feeds an && comparison (fresh value in
    # the right operand).
    if n <= 0 {
        return s
    }
    return s.slice(0, n)
}

fn main() -> int uses IO {
    let k: str = "f"
    # 1-char key: the slice in the right operand is OUT OF BOUNDS if
    # evaluated eagerly. The guard must protect it.
    if k.len() >= 2 && k.slice(0, 2) == "xx" {
        println("branch A (wrong)")
    } else {
        println("short-circuit protected the slice")
    }
    # Same shape with ||: the LEFT operand is true, so the right
    # operand's out-of-bounds slice is never evaluated.
    if k.len() < 2 || k.slice(0, 2) == "f" {
        println("or-guard fired")
    } else {
        println("or-guard fell through")
    }
    # A call result in the right operand (fresh value, lazily scoped).
    let s: str = "hello"
    if s.len() == 0 && short_id(s, 2) == "no" {
        println("empty path")
    } else {
        println("call not evaluated: len=" + s.len().to_str())
    }
    # Nested chains: a && b && (slice guard).
    let t: str = "abcdef"
    if t.len() >= 4 && t.slice(0, 4) == "abcd" && t.slice(0, 2) == "ab" {
        println("chain ok")
    }
    # Slice that IS in bounds — both sides evaluated, result correct.
    if t.len() >= 2 && t.slice(0, 2) == "ab" {
        println("in-bounds slice ok")
    }
    return 0
}
