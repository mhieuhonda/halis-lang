# Stage 10-beta regression test: BUG-A2 (check_call / check_method
# double-check_expr pattern). The previous code re-ran check_expr on each
# argument of a generic call, re-executing side effects like take() which
# would mark the binding as moved. The fix caches the first-pass type per
# argument and reuses it in the second pass.
#
# This test uses `take(x)` as an argument to a generic function. Without
# the fix, the second check_expr call would see x as moved and spuriously
# raise "use of moved value: x".
import "std.option"

fn identity[T](x: T) -> T {
    return x
}

fn main() -> int uses IO {
    let s: str = "hello"
    # take(s) marks s as moved, but the result is passed to a generic
    # function — the BUG-A2 fix prevents the double-check from re-marking s.
    let r: str = identity(take(s))
    println("r = " + r)
    return 0
}
