# test_deep_scan8_fixes.hls — regression tests for deep-scan-8 bug fixes
#
# BUG 1: print(42) should be a compile error (sink type validation)
# BUG 2: uses IO, Fs should NOT be a duplicate effect error
# BUG 3-6: hlbindgen struct/enum/ABI fixes (tested via tools, not here)
# BUG 7: formatter \r/\xNN escape fix (tested via tools, not here)
#
# This file verifies that the COMPILER correctly handles the edge cases
# that were fixed in deep-scan-8. The bindgen/formatter fixes are tested
# by the Stage 14/15 test suite (scripts/stage_14_15_tests.py).

# Test: uses IO, Fs should compile (not report duplicate Fs)
fn io_and_fs() -> int uses IO, Fs {
    let s: str = read_file("test.txt")
    print(s)
    return 0
}

# Test: uses IO alone (IO family expansion)
fn io_only() -> int uses IO {
    print("hello")
    return 0
}

# Test: uses Fs alone (explicit, not via IO)
fn fs_only() -> int uses Fs {
    let s: str = read_file("test.txt")
    return 0
}

# Test: uses IO, Net (independent effects)
fn io_and_net() -> int uses IO, Net {
    print("looking up...")
    let ip: str = net_lookup("example.com")
    print(ip)
    return 0
}

# Test: pure function (no effects)
fn double(x: int) -> int pure {
    return x * 2
}

# Test: multiple effects without IO
fn multi_effects() -> int uses Fs, Clock {
    let s: str = read_file("test.txt")
    let t: int = clock_ms()
    return t
}

# Test: main with IO
fn main() -> int uses IO {
    let x: int = double(21)
    print(x.to_str())
    return 0
}
