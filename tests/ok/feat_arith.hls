# Kiểm thử số học & kiểu cơ bản
fn main() -> int uses IO {
    let a: int = 7
    let b: int = 3
    println("add=" + (a + b).to_str())
    println("sub=" + (a - b).to_str())
    println("mul=" + (a * b).to_str())
    println("div=" + (a / b).to_str())
    println("mod=" + (a % b).to_str())
    println("negmod=" + ((0 - a) % b).to_str())
    let x: float = 1.5
    let y: float = 2.0
    println("fdiv=" + (x / y).to_str())
    println("fmul=" + (x * y).to_str())
    let big: int = 9007199254740993
    println("big=" + big.to_str())
    let flag: bool = a > b && !(b > a)
    println("flag=" + flag.to_str())
    let i64min: int = -9223372036854775808
    let i64max: int = 9223372036854775807
    println("min=" + i64min.to_str())
    println("max=" + i64max.to_str())
    let us: int = 1_000_000
    println("us=" + us.to_str())
    return 0
}
