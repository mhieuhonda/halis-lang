# feat_deep_scan24_generic_empty.hls — deep-scan-24 regression: a generic
# fn's parameter whose type is CONCRETE (mentions no type parameter) must
# provide a contextual type hint to its argument, mirroring the
# non-generic call path. The old generic-inference loop checked every
# argument with hint=None, so an empty list literal passed to a concrete
# `list[int]` parameter of a generic fn was falsely rejected with
# "empty list literal requires a type in the surrounding context" while
# the identical non-generic call was accepted.
#
# Also covers the two sibling deep-scan-24 checker fixes:
#   - `?` rejects enums with BOTH 'Ok' and 'Some' (ok-variant ambiguity)
#   - contracts reject user-defined `len` methods that take arguments
fn count_flags(flags: list[bool], n: int) -> int {
    let mut total: int = 0
    let mut i: int = 0
    while i < n {
        total = total + flags.len()
        i = i + 1
    }
    return total
}

fn fill(n: int, m: int) -> list[int] {
    let mut out: list[int] = []
    let mut i: int = 0
    while i < n {
        out.push(i * m)
        i = i + 1
    }
    return out
}

fn first_or[T](xs: list[T], fallback: list[int]) -> T {
    if xs.len() > 0 {
        return xs.get(0)
    }
    panic("empty list")
}

fn main() -> int uses IO {
    # Concrete list[bool] param of a NON-generic fn accepts [] (hint from
    # the parameter type).
    let a: int = count_flags([], 3)
    println("count_flags([], 3) = " + a.to_str())
    let b: list[int] = fill(3, 2)
    println("fill(3, 2).len() = " + b.len().to_str())
    # T is inferred from [1, 2]; the concrete fallback: list[int] param
    # accepts the empty literal via the contextual hint (deep-scan-24).
    let c: int = first_or([1, 2], [])
    println("first_or([1, 2], []) = " + c.to_str())
    return 0
}
