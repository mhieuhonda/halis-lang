# feat_stage105_repro.hls — Stage 105 (v0.124.0-alpha): hls-repro,
# the reproducible-build verification across distros.
#
# What the differential suite pins HERE is the arithmetic the tool's
# buildinfo lives on — the same numbers `hls-repro` computes when it
# rebuilds a tree and stamps the claim:
#
#   python3 tools/hls-repro.py tests/ok/feat_stage105_repro.hls
#
#   root: tests/ok/feat_stage105_repro.hls
#   2 modules in the tree; 1 toolchain, 1 workspace
#
# The program: a tiny "repro ledger" — the epoch derivation's range
# bound, the profile rotation (window, shift, wrap), the
# canonical-C-name invariant (one name, every root — the STT_FILE
# lesson), the buildinfo's boolean contract (byte-identical AND
# smoke-consistent), and the verify rule that a shifted slice must
# still land on the same verdict. Deterministic output; interpreter
# and native agree byte for byte.

import "std.str"

# The derived epoch: the digest prefix read as hex, mod 2^31. The
# range is the invariant — never negative, never the clock.
fn derive_epoch(d: list[int]) -> int {
    let mut acc: int = 0
    let mut k: int = 0
    while k < d.len() {
        if d[k] < 0 || d[k] > 15 {
            panic("derive_epoch: nibble out of range")
        }
        acc = acc * 16 + d[k]
        k = k + 1
    }
    return acc % 2147483648
}

# The rotation: build i under profile (i + offset) % P. A verify
# run shifts the offset — a different slice of the matrix, the same
# recipe.
fn rotation(i: int, profiles: int, offset: int) -> int {
    if profiles < 1 {
        panic("rotation: at least one profile")
    }
    if i < 0 || offset < 0 {
        panic("rotation: negative index")
    }
    return(i + offset) % profiles
}

# The byte contract: builds agree when the C is byte-identical AND
# the binary is byte-identical. The smoke is a bonus, never the
# contract.
fn reproducible(c_equal: bool, bin_equal: bool) -> bool {
    return c_equal && bin_equal
}

fn main() -> int uses IO {
    let mut checks: int = 0

    # The epoch bounds: zero prefix -> 0, ff prefix -> 2^31 - 1,
    # deadbeef -> 1588444911. Whatever the digest, the second is
    # sane and stable.
    let zeros: list[int] = [0, 0, 0, 0, 0, 0, 0, 0]
    let ffs: list[int] = [15, 15, 15, 15, 15, 15, 15, 15]
    let deadbeef: list[int] = [13, 14, 10, 13, 11, 14, 14, 15]
    if derive_epoch(zeros) != 0 {
        panic("the zero prefix must derive to epoch 0")
    }
    if derive_epoch(ffs) != 2147483647 {
        panic("the ff prefix must derive to 2^31 - 1")
    }
    if derive_epoch(deadbeef) != 1588444911 {
        panic("the deadbeef epoch must be 1588444911")
    }
    checks = checks + 1

    # The rotation: five profiles, the window 0..2, the shifted
    # window 1..3, the wrap at the edge. The shifted slice shares
    # NO profile with the original two-build window — verify runs
    # under environments the original never saw.
    if rotation(0, 5, 0) != 0 || rotation(1, 5, 0) != 1 {
        panic("the unshifted window is 0,1")
    }
    if rotation(0, 5, 1) != 1 || rotation(1, 5, 1) != 2 {
        panic("the shifted window is 1,2")
    }
    if rotation(4, 5, 1) != 0 {
        panic("the rotation wraps at the profile count")
    }
    checks = checks + 1

    # The canonical C name: the same string in every build root, so
    # the assembler's symbol table carries the same bytes
    # everywhere. A build whose intermediate name leaked would
    # differ in exactly one symbol-table byte — the signature this
    # stage's diagnoser names.
    let c_name: str = "build/hl_repro.c"
    if !str_starts_with(c_name, "build/") {
        panic("the canonical C name lives under build/")
    }
    if str_contains(c_name, "/work") || str_contains(c_name, "/a") {
        panic("the canonical C name must not carry a root pattern")
    }
    checks = checks + 1

    # The byte contract: both artifacts, not either.
    if !reproducible(true, true) || reproducible(true, false)
    || reproducible(false, true) {
        panic("reproducible is AND over C and binary")
    }
    checks = checks + 1

    # The verify rule: the fresh slice must land on the same hashes
    # — the verdict is about the bytes, not the environment.
    let same_c: bool = derive_epoch(deadbeef) == 1588444911
    let same_bin: bool = rotation(4, 5, 1) == rotation(0, 5, 0)
    if !reproducible(same_c, same_bin) {
        panic("a shifted slice must reproduce the verdict")
    }
    checks = checks + 1

    if checks != 5 {
        panic("expected 5 checks, ran " + checks.to_str())
    }
    println("repro ledger: one hash per artifact, no clock in sight")
    println("checks passed: " + checks.to_str())
    return 0
}
