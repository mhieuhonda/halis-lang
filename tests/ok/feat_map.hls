# Test map: set/get_or/has/keys (insertion order), map with complex values
struct Stats {
    name: str,
    count: int
}

fn main() -> int uses IO {
    let m: map[str, int] = map_new()
    m.set("one", 1)
    m.set("two", 2)
    m.set("three", 3)
    println("len=" + m.len().to_str())
    println("two=" + m.get_or("two", 0).to_str())
    println("missing=" + m.get_or("five", -1).to_str())
    m.set("two", 22)
    println("overwrite=" + m.get_or("two", 0).to_str())
    println("len_still=" + m.len().to_str())
    println("has_three=" + m.has("three").to_str())
    println("has_four=" + m.has("four").to_str())
    let keys: list[str] = m.keys()
    let mut i: int = 0
    while i < keys.len() {
        print(keys.get(i) + " ")
        i = i + 1
    }
    println("")

    # map with struct value
    let reg: map[str, Stats] = map_new()
    reg.set("cpu", Stats { name: "cpu", count: 8 })
    reg.set("gpu", Stats { name: "gpu", count: 2 })
    let c: Stats = reg.get_or("cpu", Stats { name: "none", count: 0 })
    println("cpu_count=" + c.count.to_str())

    # map with list value
    let groups: map[str, list[str]] = map_new()
    let fruits: list[str] = ["Apple", "Orange"]
    groups.set("fruits", fruits)
    println("group0=" + groups.get_or("fruits", []).get(0))

    # map keyword as variable name is allowed (map is not a keyword)
    let phone: map[str, str] = map_new()
    phone.set("hl", "Hieu Louis")
    println("hl=" + phone.get_or("hl", "?"))
    return 0
}
