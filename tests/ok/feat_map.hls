# Kiểm thử map: set/get_or/has/keys (thứ tự chèn), map lồng giá trị phức tạp
struct Stats {
    name: str,
    count: int
}

fn main() -> int uses IO {
    let m: map[str, int] = map_new()
    m.set("mot", 1)
    m.set("hai", 2)
    m.set("ba", 3)
    println("len=" + m.len().to_str())
    println("hai=" + m.get_or("hai", 0).to_str())
    println("missing=" + m.get_or("nam", -1).to_str())
    m.set("hai", 22)
    println("overwrite=" + m.get_or("hai", 0).to_str())
    println("len_still=" + m.len().to_str())
    println("has_ba=" + m.has("ba").to_str())
    println("has_bon=" + m.has("bon").to_str())
    let keys: list[str] = m.keys()
    let mut i: int = 0
    while i < keys.len() {
        print(keys.get(i) + " ")
        i = i + 1
    }
    println("")

    # map giá trị struct
    let reg: map[str, Stats] = map_new()
    reg.set("cpu", Stats { name: "cpu", count: 8 })
    reg.set("gpu", Stats { name: "gpu", count: 2 })
    let c: Stats = reg.get_or("cpu", Stats { name: "none", count: 0 })
    println("cpu_count=" + c.count.to_str())

    # map giá trị danh sách
    let groups: map[str, list[str]] = map_new()
    let vien: list[str] = ["Ca", "Cam"]
    groups.set("trai_cay", vien)
    println("group0=" + groups.get_or("trai_cay", []).get(0))

    # từ khoá "map" làm biến không được (từ khoá? không — map không phải từ khoá)
    let dien_thoai: map[str, str] = map_new()
    dien_thoai.set("hl", "Hieu Louis")
    println("hl=" + dien_thoai.get_or("hl", "?"))
    return 0
}
