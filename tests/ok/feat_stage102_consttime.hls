# feat_stage102_consttime.hls — Stage 102 (v0.121.0-alpha): the #[ct]
# attribute and the constant-time verifier, exercised as an ordinary
# differential-tested program. Every claimed function keeps its secret
# in DATA flow only — the branch-free selection, the sequential MAC
# with a public index, the arithmetic-only call chain — exactly the
# shapes `hlprove --consttime` discharges as VERIFIED, so the program
# runs identically on the interpreter, the native build and the
# -O fast build.
#
# pick:   branch-free selection (a secret multiplied, never branched on)
# fold:   byte_at with a PUBLIC index; the len() gate is public by
#         policy (the verifier counts the use, never a leak)
# expand: the claim holds through the schedule_step chain — three fns
#         of arithmetic-only reach, VERIFIED transitively

#[secrets(mask)]
#[ct]
fn pick(mask: int, a: int, b: int) -> int {
    return a * mask + b * (1 - mask)
}

#[secrets(acc, k)]
#[ct]
fn fold(mut acc: int, k: str) -> int {
    let mut i: int = 0
    while i < k.len() {
        acc = acc + k.byte_at(i) * 31
        i = i + 1
    }
    return acc
}

fn schedule_step(k: int) -> int {
    return k * 7 + 31
}

#[secrets(master)]
#[ct]
fn expand(master: int) -> int {
    return schedule_step(schedule_step(master))
}

fn main() -> int uses IO {
    let mut total: int = 0
    total = total + pick(1, 5, 9)
    total = total + pick(0, 5, 9)
    total = total + fold(0, "abc")
    println(total.to_str())
    println(expand(3).to_str())
    return 0
}
