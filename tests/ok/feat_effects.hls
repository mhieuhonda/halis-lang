# Test the effects system: pure function vs uses IO
fn sum(a: int, b: int) -> int {
    return a + b
}

fn report(total: int) -> int uses IO {
    println("total = " + total.to_str())
    println("trailing text")
    return 0
}

fn call_indirect(n: int) -> int uses IO {
    # indirectly call an IO function (deeper layer)
    return report(sum(n, 1))
}

fn main() -> int uses IO {
    let t: int = sum(40, 2)
    println("pure ok = " + t.to_str())
    call_indirect(10)
    let n_args: int = args().len()
    println("arg count = " + n_args.to_str())
    return 0
}
