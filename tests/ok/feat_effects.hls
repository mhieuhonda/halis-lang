# Kiểm thử hệ thống hiệu ứng: hàm thuần tuý vs uses IO
fn tinh_tong(a: int, b: int) -> int {
    return a + b
}

fn bao_cao(tong: int) -> int uses IO {
    println("tong = " + tong.to_str())
    println("van ban kem theo")
    return 0
}

fn goi_gian_tiep(n: int) -> int uses IO {
    # gọi hàm IO gián tiếp (xuống dòng deeper)
    return bao_cao(tinh_tong(n, 1))
}

fn main() -> int uses IO {
    let t: int = tinh_tong(40, 2)
    println("pure ok = " + t.to_str())
    goi_gian_tiep(10)
    let n_args: int = args().len()
    println("so tham so dong lenh = " + n_args.to_str())
    return 0
}
