# panic_stage127_det.hls — Stage 127 (v0.145.0-alpha): the deterministic
# scheduler's deadlock verdict. Every task blocks on a channel nobody
# will ever feed and main joins one of them: the all-blocked moment
# arrives, and BOTH schedulers must report it — the preemptive runtime
# through its counter-based scan, the det rotation through the
# empty-ready-queue scan — with the same canonical Stage 16 message and
# exit 101. Run it unarmed, or with HL_DET_SCHED=1: same verdict.

fn stuck(ch: Chan[int]) -> int uses Conc {
    let v: int = ch.recv()
    return v
}

fn main() -> int uses IO, Conc {
    let ch: Chan[int] = chan_new()
    let t: Task[int] = spawn(stuck, clone(ch))
    let r: int = t.join()
    println("unreachable=" + r.to_str())
    return 0
}
