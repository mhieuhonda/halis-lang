# feat_match.hls — verify match expression with exhaustive patterns
enum Color {
    Red,
    Green,
    Blue
}

enum Tree {
    Leaf,
    Node(int, Tree, Tree)
}

fn color_to_str(c: Color) -> str {
    return match c {
        Color.Red => "red",
        Color.Green => "green",
        Color.Blue => "blue"
    }
}

fn tree_sum(t: Tree) -> int {
    return match t {
        Tree.Leaf => 0,
        Tree.Node(v, l, r) => v + tree_sum(l) + tree_sum(r)
    }
}

fn tree_max(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

fn tree_depth(t: Tree) -> int {
    return match t {
        Tree.Leaf => 0,
        Tree.Node(_, l, r) => tree_max(tree_depth(l), tree_depth(r)) + 1
    }
}

fn main() -> int uses IO {
    let c: Color = Color.Green
    println("color: " + color_to_str(c))

    let t: Tree = Tree.Node(10, Tree.Node(20, Tree.Leaf, Tree.Leaf), Tree.Node(30, Tree.Leaf, Tree.Leaf))
    println("sum: " + tree_sum(t).to_str())
    println("depth: " + tree_depth(t).to_str())
    return 0
}
