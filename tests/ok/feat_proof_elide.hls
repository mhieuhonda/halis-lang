# feat_proof_elide.hls — Stage 17: the interval prover. These functions'
# arithmetic and accesses are PROVEN safe by their contracts — under
# -O fast the native codegen elides the panic checks (guarded by the
# entry precondition assertions). The differential test compares the
# fast build's output with the interpreter's: they must match exactly.

fn mix(acc: int, b: int) -> int
    requires acc >= 0
    requires acc <= 1000000006
    requires b >= 0
    requires b <= 255
{
    return (acc * 31 + b) % 1000000007
}

fn sum_bounded(x: int, y: int) -> int
    requires x >= 0
    requires x <= 1000000000
    requires y >= 0
    requires y <= 1000000000
{
    return x + y
}

fn get_byte(s: str, i: int) -> int
    requires i >= 0
    requires i < 8
    requires s.len() >= 8
{
    return s.byte_at(i)
}

fn div_nonzero(a: int, b: int) -> int
    requires b > 0
    requires b <= 1000
{
    return a / b
}

fn main() -> int uses IO {
    let a: int = mix(999999999, 200)
    let b: int = sum_bounded(1000000000, 999999999)
    let c: int = get_byte("proven12", 5)
    let d: int = div_nonzero(84, 2)
    println("mix=" + a.to_str() + " sum=" + b.to_str() + " byte=" + c.to_str() + " div=" + d.to_str())
    return 0
}
