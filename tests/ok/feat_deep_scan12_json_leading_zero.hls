# Deep-scan-12 regression: std/json.hls rejects leading zeros in
# numbers per RFC 8259 §6 (DSS-T-21). Before the fix, "0123" was
# silently parsed as 123, corrupting data on round-trip.

import "std.json"

fn main() -> int uses IO {
    # Valid: "0" alone.
    let r0: Result[JsonValue, str] = json_parse_result("0")
    if !result_is_ok(r0) {
        println("FAIL: '0' rejected")
        return 1
    }
    # Valid: "123" (no leading zero).
    let r123: Result[JsonValue, str] = json_parse_result("123")
    if !result_is_ok(r123) {
        println("FAIL: '123' rejected")
        return 1
    }
    # Invalid: "0123" (leading zero). Must NOT be parsed as 123.
    let rbad: Result[JsonValue, str] = json_parse_result("0123")
    if result_is_ok(rbad) {
        # The fix records a deferred error at the parser level; the
        # Result API surfaces it as Err. (Without the fix, the
        # parser returned json_int(123) silently.)
        println("FAIL: leading zero silently accepted as 123")
        return 1
    }
    println("ok: leading zeros rejected")
    return 0
}
