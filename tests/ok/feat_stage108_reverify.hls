# feat_stage108_reverify.hls — Stage 108: memory-safety re-verification
# under -O fast (proof replay). The replay's arithmetic, pinned as
# checkable numbers the differential suite can compare between the
# interpreter and every native backend: the interval algebra, the
# widening discipline, the four replay answers, and the two routes a
# bounds proof may take.

fn ovf_provable(lo_a: int, hi_a: int, lo_b: int, hi_b: int) -> bool pure {
    # the prover's form: the bounds stay inside int64, so the interval
    # sum is decided WITHOUT ever computing an overflowing value —
    # hi_a + hi_b fits iff hi_a <= MAX - hi_b (bounds non-negative
    # here, the shape every contract seeds)
    let sum_lo: int = lo_a + lo_b
    if sum_lo > 9223372036854775807 {
        return false
    }
    return hi_a <= 9223372036854775807 - hi_b
}

fn excludes_zero(lo: int, hi: int) -> bool pure {
    if hi < 0 {
        return true
    }
    if lo > 0 {
        return true
    }
    return false
}

fn bnd_provable(idx_lo: int, idx_hi: int, minlen: int) -> bool pure {
    if idx_lo < 0 {
        return false
    }
    return idx_hi < minlen
}

fn widen_growth(old_hi: int, new_hi: int) -> int pure {
    if new_hi > old_hi {
        return -1
    }
    return old_hi
}

fn join_lo(lo_a: int, lo_b: int) -> int pure {
    let mut lo: int = lo_a
    if lo_b < lo {
        lo = lo_b
    }
    return lo
}

fn replay_class(proven_before: bool, survives: bool, proven_after: bool) -> int pure {
    # 0 replayed, 1 lost-proof (the fail), 2 replayed-checked,
    # 3 eliminated (the vacuous discharge)
    if proven_before {
        if survives {
            if proven_after {
                return 0
            }
            return 1
        }
        return 3
    }
    if survives {
        return 2
    }
    return 3
}

fn main() -> int uses IO {
    # 1. the interval algebra at the int64 edges
    let edge_ok: bool = ovf_provable(0, 9223372036854775806, 1, 1)
    let edge_bad: bool = ovf_provable(0, 9223372036854775807, 1, 1)
    if edge_ok != true || edge_bad != false {
        println("FAIL: interval algebra at the edges")
        return 1
    }

    # 2. the divisor rule: 0 outside, straddling, negative-only
    let d1: bool = excludes_zero(1, 64)
    let d2: bool = excludes_zero(-1, 1)
    let d3: bool = excludes_zero(-64, -1)
    if d1 != true || d2 != false || d3 != true {
        println("FAIL: excludes_zero")
        return 1
    }

    # 3. the bounds routes: numeric below the minlen, and the
    # delta-0 upper bound that must NEVER prove an index
    let b1: bool = bnd_provable(0, 63, 64)
    let b2: bool = bnd_provable(0, 64, 64)
    let b3: bool = bnd_provable(-1, 3, 64)
    if b1 != true || b2 != false || b3 != false {
        println("FAIL: bounds routes")
        return 1
    }

    # 4. widening: growth escapes to infinity (-1), stability is kept
    let w1: int = widen_growth(3, 7)
    let w2: int = widen_growth(7, 7)
    let j1: int = join_lo(0, 2)
    if w1 != -1 || w2 != 7 || j1 != 0 {
        println("FAIL: widening or join")
        return 1
    }

    # 5. the four replay answers
    let r0: int = replay_class(true, true, true)
    let r1: int = replay_class(true, true, false)
    let r2: int = replay_class(false, true, true)
    let r3: int = replay_class(true, false, true)
    if r0 != 0 || r1 != 1 || r2 != 2 || r3 != 3 {
        println("FAIL: replay law")
        return 1
    }

    # 6. the surviving-proof invariant: arithmetic signed by the
    # contract below re-derives identically on the other side of the
    # optimiser — the number is the claim
    let mixed: int = mix(999999999, 200)
    let scaled: int = scale(mixed)
    if scaled != 999999959 {
        println("FAIL: the replayed claim")
        return 1
    }
    println("stage108 reverify: interval edges, divisor rule, bounds routes, widening, law, replayed claim — all hold")
    return 0
}

fn mix(acc: int, b: int) -> int
requires acc >= 0
requires acc <= 1000000006
requires b >= 0
requires b <= 255
{
    # the canonical Stage 17 shape: (acc * 31 + b) % 1000000007 is
    # PROVEN by the seeds — under -O fast the checks are elided, and
    # Stage 108's replay is what keeps that elision honest
    return(acc * 31 + b) % 1000000007
}

fn scale(v: int) -> int
requires v >= 0
requires v <= 9223372036854775806
{
    # x * 1 and x + 0 are the algebraic identities the annotator may
    # certify without bounds; the replay audits exactly this
    return v * 1 + 0
}
