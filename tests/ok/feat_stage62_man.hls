# tests/ok/feat_stage62_man.hls — Stage 62 (v0.77.0-alpha): std.man.
#
# Exercises:
#   - ManPage builder (man_new / with_date / with_source / with_manual /
#     with_desc / with_long_desc / with_author / with_bugs / with_examples
#     / with_see_also / with_exit_codes / with_after_help)
#   - man_add_example / man_add_see_also / man_add_exit_code (list
#     appending variants)
#   - impl ManPage method twins (p.with_date(...).with_source(...) etc.)
#   - man_render(page, parser) — pure render to nroff source
#   - man_render_default(parser) — sensible-default render with today's date
#   - .TH line (NAME SECTION DATE SOURCE MANUAL)
#   - .SH NAME (name \- one-line description)
#   - .SH SYNOPSIS (built-in -h/-V + every declared option + positionals
#     + subcommands)
#   - .SH DESCRIPTION (long_desc split into paragraphs via .PP)
#   - .SH OPTIONS (.TP per option, with default/env/required annotations)
#   - .SH POSITIONAL ARGUMENTS (only when the parser declares positionals)
#   - .SH SUBCOMMANDS (when the parser declares subcommands)
#   - .SH ENVIRONMENT (when any option has an env-var fallback)
#   - .SH EXIT STATUS (man_add_exit_code entries)
#   - .SH EXAMPLES (.PP + .RS + .nf/.fi code block per example)
#   - .SH AUTHORS (when author is set)
#   - .SH BUGS (when bugs URL is set)
#   - .SH SEE ALSO (.BR name (section) per entry)
#   - .SH VERSION
#   - man_escape: groff metacharacter escaping (\\, -, leading ., control bytes)
#   - man_section_name: 1->User Commands, 3->Library Functions, etc.
#   - man_install_path: canonical install path computation
#   - man_is_safe_name: rejects '/', '..', leading '-', and unsafe chars
#   - man_format_iso_date: pure timestamp -> YYYY-MM-DD (Hinnant's algo,
#     pre-epoch edge cases)
#   - man_split_paragraphs: multi-paragraph split on blank lines
#
# The test uses synthetic CliParser values and a FIXED date string
# (man_with_date("2026-09-09")) so the rendered output is fully
# reproducible and differential-safe (interpreter == native).
# man_render_default is exercised separately — it reads the wall clock
# and is smoke-tested (exit 0 + must contain today's year).

import "std.man"
import "std.cli"
import "std.str"

# ============================================================================
# Helpers
# ============================================================================

fn ok(actual: bool, msg: str) -> void uses IO {
    if !actual {
        panic("FAIL " + msg)
    }
}

fn eq_int(actual: int, expected: int, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_str(actual: str, expected: str, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected '" + expected + "', got '" + actual + "'")
    }
}

fn eq_bool(actual: bool, expected: bool, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

# contains helper — does haystack contain needle?
fn contains_str(haystack: str, needle: str) -> bool {
    return haystack.contains(needle)
}

# ============================================================================
# Build a test CliParser (mirrors the Stage-53 acceptance parser shape).
# ============================================================================

fn build_test_parser() -> CliParser {
    let p0: CliParser = cli_parser_new("myapp", "1.2.3")
    let p1: CliParser = cli_parser_desc(p0, "A sample application for Stage 62 acceptance")
    let p2: CliParser = cli_parser_flag(p1, "verbose", "v", "Enable verbose output")
    let p3: CliParser = cli_parser_int_opt(p2, "port", "p", "Port number", false, 8080)
    let p4: CliParser = cli_parser_str_opt(p3, "host", "H", "Host to bind", false, "localhost")
    let p5: CliParser = cli_parser_str_opt_no_default(p4, "config", "c", "Config file path", false)
    let p6: CliParser = cli_parser_float_opt(p5, "timeout", "t", "Connection timeout (seconds)", false, 30.0)
    let p7: CliParser = cli_parser_str_positional(p6, "input", "Input file", true)
    let p8: CliParser = cli_parser_int_positional(p7, "count", "Repeat count", false)
    let p9: CliParser = cli_parser_env(p8, "port", "MYAPP_PORT")
    let p10: CliParser = cli_parser_subcommand(p9, "init", "Initialize the project")
    let p11: CliParser = cli_parser_subcommand(p10, "build", "Build the project")
    return p11
}

# Build a comprehensive ManPage for the test parser.
fn build_test_man_page() -> ManPage {
    let p0: ManPage = man_new("myapp", man_section_user_commands(), "1.2.3")
    let p1: ManPage = man_with_desc(p0, "sample application")
    let p2: ManPage = man_with_date(p1, "2026-09-09")
    let p3: ManPage = man_with_source(p2, "myapp 1.2.3")
    let p4: ManPage = man_with_manual(p3, "User Commands")
    let p5: ManPage = man_with_author(p4, "Jane Doe <jane@example.com>")
    let p6: ManPage = man_with_bugs(p5, "https://github.com/mhieuhonda/halis-lang/issues")
    let p7: ManPage = man_with_long_desc(p6, "myapp is a sample application that exercises every feature of std.man.\n\nIt demonstrates the multi-paragraph DESCRIPTION section, the OPTIONS table, the POSITIONAL ARGUMENTS list, the SUBCOMMANDS list, the ENVIRONMENT variables, and the EXAMPLES section.")
    let p8: ManPage = man_with_after_help(p7, "Exit codes follow the BSD convention: 0 success, 1 usage error, 2 missing required argument.")
    let p9: ManPage = man_add_exit_code(p8, 0, "Success.")
    let p10: ManPage = man_add_exit_code(p9, 1, "Usage error (invalid flag, unknown subcommand).")
    let p11: ManPage = man_add_exit_code(p10, 2, "Missing required argument.")
    let p12: ManPage = man_add_example(p11, "Run with verbose logging", "myapp --verbose input.txt")
    let p13: ManPage = man_add_example(p12, "Bind to a custom port", "myapp -p 9000 input.txt")
    let p14: ManPage = man_add_see_also(p13, "myapp-config", 5)
    return p14
}

# ============================================================================
# Test 1: man_section_name returns the canonical section name.
# ============================================================================

fn test_section_names() -> int uses IO {
    eq_str(man_section_name(1), "User Commands", "section_name: 1")
    eq_str(man_section_name(2), "System Calls", "section_name: 2")
    eq_str(man_section_name(3), "Library Functions", "section_name: 3")
    eq_str(man_section_name(4), "Special Files", "section_name: 4")
    eq_str(man_section_name(5), "File Formats", "section_name: 5")
    eq_str(man_section_name(6), "Games", "section_name: 6")
    eq_str(man_section_name(7), "Miscellaneous", "section_name: 7")
    eq_str(man_section_name(8), "System Administration", "section_name: 8")
    # Unknown section -> safe default
    eq_str(man_section_name(99), "User Commands", "section_name: unknown defaults to User Commands")
    return 0
}

# ============================================================================
# Test 2: man_escape escapes the four groff metacharacter classes.
# ============================================================================

fn test_man_escape() -> int uses IO {
    # 1. Backslash -> doubled (renders as a literal backslash).
    eq_str(man_escape("a\\b"), "a\\\\b", "escape: backslash doubled")
    # 2. Hyphen -> escaped hyphen.
    eq_str(man_escape("--verbose"), "\\-\\-verbose", "escape: hyphen becomes \\-")
    # 3. Leading '.' on a line -> zero-width-space prefix.
    eq_str(man_escape(".foo"), "\\&.foo", "escape: leading dot gets \\& prefix")
    # 4. Leading '\'' on a line -> zero-width-space prefix.
    eq_str(man_escape("'foo"), "\\&'foo", "escape: leading apostrophe gets \\& prefix")
    # 5. Interior '.' -> left as-is.
    eq_str(man_escape("a.b"), "a.b", "escape: interior dot unchanged")
    # 6. Leading dot on subsequent line (after \n) -> prefixed.
    eq_str(man_escape("line1\n.foo"), "line1\n\\&.foo", "escape: leading dot on line 2 prefixed")
    # 7. Control bytes (form-feed, vertical tab) stripped.
    # Use chr(12) (form-feed) and chr(11) (vertical tab).
    eq_str(man_escape("a" + chr(12) + "b"), "ab", "escape: form-feed stripped")
    eq_str(man_escape("a" + chr(11) + "b"), "ab", "escape: vertical tab stripped")
    # 8. Tab and newline preserved.
    eq_str(man_escape("a\tb"), "a\tb", "escape: tab preserved")
    eq_str(man_escape("a\nb"), "a\nb", "escape: newline preserved")
    # 9. Empty input.
    eq_str(man_escape(""), "", "escape: empty input")
    return 0
}

# ============================================================================
# Test 3: man_render produces a complete nroff document with all sections.
# ============================================================================

fn test_man_render_basic() -> int uses IO {
    let parser: CliParser = build_test_parser()
    let page: ManPage = build_test_man_page()
    let out: str = man_render(page, parser)

    # .TH line contains the name, section, date, source, manual.
    # NOTE: every .TH field is escaped via man_escape, so hyphens in the
    # date render as "\-" (literal hyphen, never a soft hyphen that the
    # typesetter could break on).
    ok(contains_str(out, ".TH \"myapp\" \"1\" \"2026\\-09\\-09\" \"myapp 1.2.3\" \"User Commands\""),
        "render: .TH line correct (with date hyphens escaped)")

    # NAME section.
    ok(contains_str(out, ".SH \"NAME\""), "render: NAME section header")
    ok(contains_str(out, "myapp \\- sample application"),
        "render: NAME line (name \\- desc)")

    # SYNOPSIS section.
    ok(contains_str(out, ".SH \"SYNOPSIS\""), "render: SYNOPSIS section header")
    ok(contains_str(out, ".B myapp"), "render: SYNOPSIS app name")
    ok(contains_str(out, "[\\fB\\-h\\fR|\\fB\\-\\-help\\fR]"), "render: SYNOPSIS -h/--help")
    ok(contains_str(out, "[\\fB\\-V\\fR|\\fB\\-\\-version\\fR]"), "render: SYNOPSIS -V/--version")

    # The declared options should appear in the SYNOPSIS.
    ok(contains_str(out, "\\fB\\-v\\fR"), "render: SYNOPSIS -v (verbose short)")
    ok(contains_str(out, "\\fB\\-\\-verbose\\fR"), "render: SYNOPSIS --verbose")
    ok(contains_str(out, "\\fB\\-p\\fR"), "render: SYNOPSIS -p (port short)")
    ok(contains_str(out, "\\fB\\-\\-port\\fR"), "render: SYNOPSIS --port")
    ok(contains_str(out, "\\fIINT\\fR"), "render: SYNOPSIS INT placeholder")

    # Required positional.
    ok(contains_str(out, "\\fB<input>\\fR"), "render: SYNOPSIS required positional <input>")

    # Optional positional in brackets.
    ok(contains_str(out, "[\\fB<count>\\fR]"), "render: SYNOPSIS optional positional <count>")

    # Subcommand placeholder.
    ok(contains_str(out, "\\fISUBCOMMAND\\fR"), "render: SYNOPSIS subcommand placeholder")

    # DESCRIPTION section.
    ok(contains_str(out, ".SH \"DESCRIPTION\""), "render: DESCRIPTION header")
    ok(contains_str(out, "myapp is a sample application"), "render: DESCRIPTION first paragraph")
    ok(contains_str(out, ".PP"), "render: DESCRIPTION paragraph separator (.PP)")
    ok(contains_str(out, "It demonstrates the multi\\-paragraph"), "render: DESCRIPTION second paragraph")

    # After-help.
    ok(contains_str(out, "Exit codes follow the BSD convention"), "render: after_help text")

    # OPTIONS section.
    ok(contains_str(out, ".SH \"OPTIONS\""), "render: OPTIONS header")
    ok(contains_str(out, "Print this help message and exit."), "render: -h description")
    ok(contains_str(out, "Print the version string and exit."), "render: -V description")
    ok(contains_str(out, "Enable verbose output"), "render: --verbose description")
    ok(contains_str(out, "[default: 8080]"), "render: --port default annotation")
    ok(contains_str(out, "[default: localhost]"), "render: --host default annotation")
    ok(contains_str(out, "[default: 30"), "render: --timeout default annotation")
    ok(contains_str(out, "[env: MYAPP_PORT]"), "render: --port env annotation")

    # POSITIONAL ARGUMENTS section.
    ok(contains_str(out, ".SH \"POSITIONAL ARGUMENTS\""), "render: POSITIONAL ARGUMENTS header")
    ok(contains_str(out, "Input file (required)"), "render: <input> description with required annotation")

    # SUBCOMMANDS section.
    ok(contains_str(out, ".SH \"SUBCOMMANDS\""), "render: SUBCOMMANDS header")
    ok(contains_str(out, "\\fBinit\\fR"), "render: subcommand init")
    ok(contains_str(out, "Initialize the project"), "render: init description")
    ok(contains_str(out, "\\fBbuild\\fR"), "render: subcommand build")
    ok(contains_str(out, "Build the project"), "render: build description")

    # ENVIRONMENT section.
    ok(contains_str(out, ".SH \"ENVIRONMENT\""), "render: ENVIRONMENT header")
    ok(contains_str(out, "\\fBMYAPP_PORT\\fR"), "render: env var name")
    # The env var description contains "--port" which is escaped to "\-\-port".
    ok(contains_str(out, "Fallback for the \\-\\-port option"), "render: env var description")

    # EXIT STATUS section.
    ok(contains_str(out, ".SH \"EXIT STATUS\""), "render: EXIT STATUS header")
    ok(contains_str(out, "\\fB0\\fR"), "render: exit code 0")
    ok(contains_str(out, "Success."), "render: exit code 0 description")
    ok(contains_str(out, "Usage error"), "render: exit code 1 description")
    ok(contains_str(out, "Missing required argument."), "render: exit code 2 description")

    # EXAMPLES section.
    ok(contains_str(out, ".SH \"EXAMPLES\""), "render: EXAMPLES header")
    ok(contains_str(out, "Run with verbose logging"), "render: example 1 title")
    # The body contains "--verbose" which is escaped to "\-\-verbose".
    ok(contains_str(out, "myapp \\-\\-verbose input.txt"), "render: example 1 body (with escaped hyphens)")
    ok(contains_str(out, ".nf"), "render: example no-fill marker")
    ok(contains_str(out, ".fi"), "render: example fill marker")

    # AUTHORS section.
    ok(contains_str(out, ".SH \"AUTHORS\""), "render: AUTHORS header")
    ok(contains_str(out, "Jane Doe <jane@example.com>"), "render: author line")

    # BUGS section.
    ok(contains_str(out, ".SH \"BUGS\""), "render: BUGS header")
    # The URL contains hyphens (e.g., "halis-lang") which are escaped to "\-".
    ok(contains_str(out, "Report bugs to <https://github.com/mhieuhonda/halis\\-lang/issues>"),
        "render: bugs URL (with hyphen escaped)")

    # SEE ALSO section.
    ok(contains_str(out, ".SH \"SEE ALSO\""), "render: SEE ALSO header")
    # The see-also name "myapp-config" has its hyphen escaped to "\-".
    ok(contains_str(out, ".BR myapp\\-config (5)"), "render: see-also entry")

    # VERSION section.
    ok(contains_str(out, ".SH \"VERSION\""), "render: VERSION header")
    ok(contains_str(out, "myapp 1.2.3"), "render: version string")

    # The output ends with a trailing newline.
    ok(out.ends_with("\n"), "render: trailing newline")

    return 0
}

# ============================================================================
# Test 4: man_render omits sections that have no entries.
# ============================================================================

fn test_man_render_minimal() -> int uses IO {
    # A minimal parser with NO options, NO positionals, NO subcommands.
    let p0: CliParser = cli_parser_new("empty", "0.1.0")
    let m0: ManPage = man_new("empty", 1, "0.1.0")
    let out: str = man_render(m0, p0)

    # .TH line.
    ok(contains_str(out, ".TH \"empty\" \"1\""), "minimal: .TH line")
    # NAME with no description.
    ok(contains_str(out, ".SH \"NAME\"\nempty"), "minimal: NAME = empty name only")
    # SYNOPSIS — only -h / -V, no extra options.
    ok(contains_str(out, "[\\fB\\-h\\fR|\\fB\\-\\-help\\fR]"), "minimal: SYNOPSIS -h/--help")
    # NO POSITIONAL ARGUMENTS section.
    ok(!contains_str(out, ".SH \"POSITIONAL ARGUMENTS\""), "minimal: no POSITIONAL ARGUMENTS section")
    # NO SUBCOMMANDS section.
    ok(!contains_str(out, ".SH \"SUBCOMMANDS\""), "minimal: no SUBCOMMANDS section")
    # NO ENVIRONMENT section.
    ok(!contains_str(out, ".SH \"ENVIRONMENT\""), "minimal: no ENVIRONMENT section")
    # NO EXAMPLES section.
    ok(!contains_str(out, ".SH \"EXAMPLES\""), "minimal: no EXAMPLES section")
    # NO AUTHORS / BUGS / SEE ALSO sections.
    ok(!contains_str(out, ".SH \"AUTHORS\""), "minimal: no AUTHORS section")
    ok(!contains_str(out, ".SH \"BUGS\""), "minimal: no BUGS section")
    ok(!contains_str(out, ".SH \"SEE ALSO\""), "minimal: no SEE ALSO section")
    # DESCRIPTION fallback.
    ok(contains_str(out, "empty is a command-line tool."), "minimal: default DESCRIPTION fallback")
    # VERSION.
    ok(contains_str(out, ".SH \"VERSION\"\nempty 0.1.0"), "minimal: VERSION section")
    return 0
}

# ============================================================================
# Test 5: impl ManPage method twins work (builder chaining).
# ============================================================================

fn test_method_twins() -> int uses IO {
    let p: CliParser = build_test_parser()
    let m: ManPage = man_new("myapp", 1, "1.2.3")
        .with_desc("sample")
        .with_date("2026-09-09")
        .with_source("myapp 1.2.3")
        .with_manual("User Commands")
        .with_author("Jane Doe")
        .with_bugs("https://example.com/bugs")
        .with_after_help("Extra text.")
        .add_exit_code(0, "Success.")
        .add_example("Example 1", "myapp")
        .add_see_also("foo", 1)
    let out: str = m.render(p)

    # Verify the chained builders applied.
    ok(contains_str(out, "myapp \\- sample"), "methods: desc applied via .with_desc")
    ok(contains_str(out, ".TH \"myapp\" \"1\" \"2026\\-09\\-09\""), "methods: date applied via .with_date")
    ok(contains_str(out, "Jane Doe"), "methods: author applied via .with_author")
    ok(contains_str(out, "https://example.com/bugs"), "methods: bugs applied via .with_bugs")
    ok(contains_str(out, "Extra text."), "methods: after_help applied via .with_after_help")
    ok(contains_str(out, "Success."), "methods: exit code applied via .add_exit_code")
    ok(contains_str(out, "Example 1"), "methods: example applied via .add_example")
    ok(contains_str(out, ".BR foo (1)"), "methods: see-also applied via .add_see_also")
    return 0
}

# ============================================================================
# Test 6: man_is_safe_name rejects unsafe names.
# ============================================================================

fn test_safe_name() -> int uses IO {
    # Safe names.
    ok(man_is_safe_name("myapp"), "safe: myapp")
    ok(man_is_safe_name("my-app"), "safe: my-app")
    ok(man_is_safe_name("my_app"), "safe: my_app")
    ok(man_is_safe_name("my.app"), "safe: my.app")
    ok(man_is_safe_name("a1b2c3"), "safe: a1b2c3")

    # Unsafe names.
    ok(!man_is_safe_name(""), "unsafe: empty")
    ok(!man_is_safe_name("my/app"), "unsafe: contains /")
    ok(!man_is_safe_name("my..app"), "unsafe: contains ..")
    ok(!man_is_safe_name("../etc/passwd"), "unsafe: traversal")
    ok(!man_is_safe_name("-foo"), "unsafe: leading hyphen (parsed as flag by man)")
    ok(!man_is_safe_name("my app"), "unsafe: contains space")
    ok(!man_is_safe_name("my;app"), "unsafe: contains semicolon")
    return 0
}

# ============================================================================
# Test 7: man_install_path constructs the canonical install path.
# ============================================================================

fn test_install_path() -> int uses IO {
    eq_str(man_install_path("myapp", 1, "/usr/local"),
        "/usr/local/share/man/man1/myapp.1",
        "install_path: section 1 under /usr/local")
    eq_str(man_install_path("my-app", 3, "/usr"),
        "/usr/share/man/man3/my-app.3",
        "install_path: hyphenated name section 3 under /usr")
    eq_str(man_install_path("myapp", 8, "/opt/myapp"),
        "/opt/myapp/share/man/man8/myapp.8",
        "install_path: section 8 under custom prefix")

    # Unsafe name panics.
    let mut panicked: bool = false
    let mut dummy: int = 0
    if dummy == 0 {
        # Wrap the panic-prone call in a try-style guard. HLS has no
        # try/catch; we use a `let _ = ...` to force evaluation, and
        # rely on the fact that man_install_path panics before
        # returning. We split the test: do the safe ones first (above),
        # then we EXPECT the unsafe ones to panic — but since we can't
        # catch panics, we instead just verify the safe ones above and
        # document the panic behavior here.
        dummy = 1
    }
    ok(!panicked, "install_path: did not panic on safe inputs (sanity)")
    return 0
}

# ============================================================================
# Test 8: man_format_iso_date (pure timestamp -> YYYY-MM-DD).
# Tests the Hinnant civil-from-days algorithm including pre-epoch edges.
# ============================================================================

fn test_format_iso_date() -> int uses IO {
    # Epoch zero: 1970-01-01.
    eq_str(man_format_iso_date(0), "1970-01-01", "iso: epoch = 1970-01-01")

    # Mid-day: 1970-01-01 12:00 UTC = 12 * 3600 * 1000 ms.
    eq_str(man_format_iso_date(43200000), "1970-01-01", "iso: same day despite +12h")

    # Day 1: 1970-01-02.
    eq_str(man_format_iso_date(86400000), "1970-01-02", "iso: day 1 = 1970-01-02")

    # 2026-09-09 — verified externally:
    # 2026-09-09T00:00:00Z = (56 years * 365.25 days) ~ 20589 days
    # Actually let me compute: from 1970 to 2026 = 56 years.
    # Days: 56*365 + 14 leap days (1972, 1976, ..., 2024) = 20440 + 14 = 20454
    # Plus days from 1970-01-01 to 2026-01-01: that's 20454 days.
    # Plus days from 2026-01-01 to 2026-09-09:
    #   Jan=31, Feb=28 (2026 not leap), Mar=31, Apr=30, May=31, Jun=30, Jul=31, Aug=31 = 243
    #   Plus 9 days in Sep = 252 - 1 (we want Sep 9 = day 252, but we counted Jan 1 as day 0)
    # Total: 20454 + 251 = 20705 days from 1970-01-01 to 2026-09-09.
    # In ms: 20705 * 86400000 = 1,788,912,000,000.
    eq_str(man_format_iso_date(1788912000000), "2026-09-09", "iso: 2026-09-09 from epoch ms")

    # Pre-epoch: 1969-12-31 (one day before epoch).
    eq_str(man_format_iso_date(-86400000), "1969-12-31", "iso: pre-epoch 1969-12-31")

    # Leap day: 2024-02-29 (year divisible by 4, not by 100, but by 400 — actually 2024/4=506 with no remainder so leap).
    # Days from 1970-01-01 to 2024-02-29:
    # 54 years (1970-2024) * 365 = 19710 days
    # Leap days: 1972, 1976, ..., 2024 -> but 2024's leap day IS Feb 29.
    #   So we count leaps from 1972 to 2020 = (2020-1972)/4 + 1 = 13 leap days
    #   Then for 2024-02-29 itself, 2024 IS leap, so add 1 for the 2024 leap day.
    # Plus days from 2024-01-01 to 2024-02-29: Jan=31, Feb 29 = day 59 (Jan 1 = day 0, so Feb 29 = day 59)
    # Total: 19710 + 13 + 59 = 19782 days.
    # In ms: 19782 * 86400000 = 1,709,164,800,000.
    eq_str(man_format_iso_date(1709164800000), "2024-02-29", "iso: leap day 2024-02-29")

    # Year boundary: 2000-01-01 (Y2K).
    # Days from 1970-01-01 to 2000-01-01:
    # 30 years * 365 = 10950
    # Leap days 1972-2000 (inclusive of 2000? no, 2000-01-01 is BEFORE 2000-02-29).
    #   Leaps 1972, 1976, ..., 1996 = (1996-1972)/4 + 1 = 7 leaps.
    # Total: 10950 + 7 = 10957 days.
    # In ms: 10957 * 86400000 = 946,684,800,000.
    eq_str(man_format_iso_date(946684800000), "2000-01-01", "iso: Y2K 2000-01-01")
    return 0
}

# ============================================================================
# Test 9: man_split_paragraphs splits on blank lines.
# ============================================================================

fn test_split_paragraphs() -> int uses IO {
    let text: str = "Para 1 line 1.\nPara 1 line 2.\n\nPara 2.\n\nPara 3 line 1."
    let paras: list[str] = man_split_paragraphs(text)
    eq_int(paras.len(), 3, "split: 3 paragraphs")
    eq_str(paras.get(0), "Para 1 line 1.\nPara 1 line 2.", "split: paragraph 1")
    eq_str(paras.get(1), "Para 2.", "split: paragraph 2")
    eq_str(paras.get(2), "Para 3 line 1.", "split: paragraph 3")

    # Single paragraph, no blank lines.
    let single: str = "Just one paragraph."
    let sp: list[str] = man_split_paragraphs(single)
    eq_int(sp.len(), 1, "split: single paragraph")

    # Empty input.
    let empty: list[str] = man_split_paragraphs("")
    eq_int(empty.len(), 0, "split: empty input -> 0 paragraphs")

    # Leading / trailing blank lines.
    let padded: str = "\n\nHello.\n\n\n"
    let pp: list[str] = man_split_paragraphs(padded)
    eq_int(pp.len(), 1, "split: leading/trailing blanks ignored")
    eq_str(pp.get(0), "Hello.", "split: paragraph content correct")
    return 0
}

# ============================================================================
# Test 10: man_render_default uses the parser's name/version and a sane date.
# This is the LIVE entry point — it reads the wall clock. We can't compare
# the exact date (it varies), but we CAN verify:
#   - The .TH line contains section 1 and "User Commands".
#   - The .TH line contains a 10-char date (YYYY-MM-DD format).
#   - The .TH line's source is "<name> <version>".
#   - The full NAME section reads "name \- <desc>".
# ============================================================================

fn test_render_default() -> int uses IO, Clock {
    let parser: CliParser = build_test_parser()
    let out: str = man_render_default(parser)

    # The .TH line should reference myapp, section 1, "User Commands" manual.
    ok(contains_str(out, ".TH \"myapp\" \"1\""), "default: .TH has myapp section 1")
    ok(contains_str(out, "\"User Commands\""), "default: .TH has User Commands manual")
    ok(contains_str(out, "\"myapp 1.2.3\""), "default: .TH has source myapp 1.2.3")

    # The date should be in YYYY-MM-DD format (with hyphens escaped to
    # `\-` by man_escape). Extract it from the .TH line by splitting
    # on the quote char, then UNescape `\-` back to `-` to validate.
    let th_line: str = out.slice(0, out.find("\n"))
    # The .TH line format: .TH "NAME" "SECTION" "DATE" "SOURCE" "MANUAL"
    # Find the 3rd quote pair (index 5 in the split-by-quote array).
    let fields: list[str] = th_line.split("\"")
    # fields = ['.TH ', 'myapp', ' ', '1', ' ', '<date-escaped>', ' ', 'myapp 1.2.3', ...]
    # The date is at index 5.
    if fields.len() >= 6 {
        let date_escaped: str = fields.get(5)
        # Unescape "\-" back to "-" for validation.
        let date_parts: list[str] = date_escaped.split("\\-")
        let date: str = str_join(date_parts, "-")
        eq_int(date.len(), 10, "default: date is 10 chars (YYYY-MM-DD) after unescape")
        # Year should be 4 digits starting with "20" (we're in the 21st century).
        ok(date.starts_with("20"), "default: date starts with '20' (21st century)")
        # Month in [01, 12].
        let month: str = date.slice(5, 7)
        let m: int = man_safe_parse_int(month)
        ok(m >= 1 && m <= 12, "default: month in [1, 12]")
        # Day in [01, 31].
        let day: str = date.slice(8, 10)
        let d: int = man_safe_parse_int(day)
        ok(d >= 1 && d <= 31, "default: day in [1, 31]")
    } else {
        panic("FAIL default: .TH line has fewer than 6 quote-delimited fields")
    }

    # NAME section: "myapp \- <desc>" where desc is the parser's desc.
    ok(contains_str(out, "myapp \\- A sample application for Stage 62 acceptance"),
        "default: NAME section uses parser.desc")
    return 0
}

# Helper — parse int safely (returns -1 on failure). Used by the date
# validation above (int_parse returns Result; we want a flat int).
fn man_safe_parse_int(s: str) -> int {
    let r: Result[int, str] = int_parse(s)
    if result_is_ok(r) {
        return result_unwrap_or(r, -1)
    }
    return -1
}

# ============================================================================
# Test 11: man_render escapes user-controlled text in option descriptions.
# This is the security-critical test: an attacker who controls a CliParser
# description should NOT be able to inject groff requests.
# ============================================================================

fn test_security_escape() -> int uses IO {
    # An attacker-controlled description that tries to inject `.sy rm -rf /`
    # at the START of a line. Modern man viewers disable .sy, but old ones
    # do not — we escape at the source by prepending a zero-width space
    # (`\&`) before any leading `.` or `'` so the line is not interpreted
    # as a groff request.
    let malicious_desc: str = ".sy rm -rf /"
    let p0: CliParser = cli_parser_new("safeapp", "1.0.0")
    let p1: CliParser = cli_parser_flag(p0, "evil", "e", malicious_desc)
    let m: ManPage = man_new("safeapp", 1, "1.0.0")
    let out: str = man_render(m, p1)

    # The escaped output should contain the leading-dot neutralisation
    # (`\&.sy` so groff does not interpret it as a request).
    ok(contains_str(out, "\\&.sy"), "security: leading dot neutralised with \\& prefix")
    # The hyphens in "rm -rf" should be escaped to "\-".
    ok(contains_str(out, "rm \\-rf"), "security: hyphens in description escaped")
    # The raw ".sy rm -rf /" (without the escape prefix) should NOT appear
    # as a complete line.
    ok(!contains_str(out, "\n.sy rm -rf /\n"), "security: raw malicious line NOT present")
    return 0
}

# ============================================================================
# Test 12: man_render escapes backslashes in user-controlled text.
# ============================================================================

fn test_security_backslash() -> int uses IO {
    # Input value: `evil \-n` (8 chars: e,v,i,l,space,backslash,hyphen,n).
    # In HLS source, this is "evil \\-n" (the \\ is an escape for one backslash).
    let malicious_desc: str = "evil \\-n"
    let p0: CliParser = cli_parser_new("safeapp2", "1.0.0")
    let p1: CliParser = cli_parser_flag(p0, "evil2", "e", malicious_desc)
    let m: ManPage = man_new("safeapp2", 1, "1.0.0")
    let out: str = man_render(m, p1)
    # The backslash in the input is doubled (escape -> "\\\\" in value),
    # and the hyphen is escaped (-> "\-" in value). So the output value
    # is `evil \\\-n` (3 backslashes + hyphen + n) = 10 chars. In HLS
    # source, that's "evil \\\\\\-n" (6 backslashes -> 3 backslashes).
    ok(contains_str(out, "evil \\\\\\-n"), "security: backslash doubled in description")
    return 0
}

# ============================================================================
# Test 13: man_write + man_install actually write a file (smoke).
# This test carries Fs effect — it writes to /tmp (a real file). The
# content is then read back via read_file and verified to match the
# rendered string. (The native binary will write the same content; the
# differential test compares the STDOUT only — this test's stdout is
# the PASS lines, not the file content.)
# ============================================================================

fn test_write_file() -> int uses IO, Fs {
    let parser: CliParser = build_test_parser()
    let page: ManPage = build_test_man_page()
    let rendered: str = man_render(page, parser)

    # man_write — write to /tmp/man_test_out.1.
    let path: str = "/tmp/feat_stage62_man_test.1"
    man_write(rendered, path)

    # Read it back and compare.
    let content: str = read_file(path)
    eq_str(content, rendered, "write: file content matches rendered string")
    return 0
}

# ============================================================================
# Test 14: man_install_path for various sections.
# ============================================================================

fn test_install_path_various() -> int uses IO {
    # Sections 1 through 8.
    eq_str(man_install_path("foo", 1, "/usr/local"), "/usr/local/share/man/man1/foo.1", "install_path_various: section 1")
    eq_str(man_install_path("foo", 2, "/usr/local"), "/usr/local/share/man/man2/foo.2", "install_path_various: section 2")
    eq_str(man_install_path("foo", 3, "/usr/local"), "/usr/local/share/man/man3/foo.3", "install_path_various: section 3")
    eq_str(man_install_path("foo", 4, "/usr/local"), "/usr/local/share/man/man4/foo.4", "install_path_various: section 4")
    eq_str(man_install_path("foo", 5, "/usr/local"), "/usr/local/share/man/man5/foo.5", "install_path_various: section 5")
    eq_str(man_install_path("foo", 6, "/usr/local"), "/usr/local/share/man/man6/foo.6", "install_path_various: section 6")
    eq_str(man_install_path("foo", 7, "/usr/local"), "/usr/local/share/man/man7/foo.7", "install_path_various: section 7")
    eq_str(man_install_path("foo", 8, "/usr/local"), "/usr/local/share/man/man8/foo.8", "install_path_various: section 8")
    return 0
}

# ============================================================================
# Test 15: ManSeeAlso struct + see_also list rendering (multiple entries).
# ============================================================================

fn test_multiple_see_also() -> int uses IO {
    let p: CliParser = cli_parser_new("multi", "1.0.0")
    let m0: ManPage = man_new("multi", 1, "1.0.0")
    let m1: ManPage = man_add_see_also(m0, "foo", 1)
    let m2: ManPage = man_add_see_also(m1, "bar", 3)
    let m3: ManPage = man_add_see_also(m2, "baz", 8)
    let out: str = man_render(m3, p)

    # All three should appear.
    ok(contains_str(out, ".BR foo (1)"), "see_also: foo(1)")
    ok(contains_str(out, ".BR bar (3)"), "see_also: bar(3)")
    ok(contains_str(out, ".BR baz (8)"), "see_also: baz(8)")
    return 0
}

# ============================================================================
# Test 16: Builder immutability — man_with_* returns a NEW ManPage.
# ============================================================================

fn test_builder_immutability() -> int uses IO {
    let p: CliParser = cli_parser_new("immut", "1.0.0")
    let m0: ManPage = man_new("immut", 1, "1.0.0")
    let m1: ManPage = man_with_desc(m0, "first desc")

    # m0 should NOT have the desc set.
    let out0: str = man_render(m0, p)
    ok(!contains_str(out0, "first desc"), "immutability: m0 has no desc")

    # m1 SHOULD have the desc set.
    let out1: str = man_render(m1, p)
    ok(contains_str(out1, "immut \\- first desc"), "immutability: m1 has the desc")
    return 0
}

