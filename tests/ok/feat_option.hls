import "std.option"

fn first_or_none(xs: list[int]) -> Option[int] {
    if xs.len() == 0 {
        return Option.None
    }
    return Option.Some(xs.get(0))
}

fn main() -> int uses IO {
    let xs: list[int] = [10, 20]
    let r: Option[int] = first_or_none(xs)
    if option_is_some(r) {
        println("first = " + option_unwrap(r).to_str())
    }
    return 0
}
