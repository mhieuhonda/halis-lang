# feat_generic_method.hls — generic methods on a non-generic struct.
# Verifies BUG-002 fix: type-param inference for the method's own type
# parameters now writes into the correct slot of the type map (previously
# the inference was a no-op due to a list_slice_from() throwaway).
struct Container {
    value: int
}

impl Container {
    fn identity[U](self: Container, x: U) -> U {
        return x
    }
}

fn main() -> int uses IO {
    let c: Container = Container { value: 42 }
    let n: int = c.identity(99)
    let s: str = c.identity("hello")
    println("n=" + n.to_str())
    println("s=" + s)
    return 0
}
