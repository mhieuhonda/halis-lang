# tests/ok/feat_deep_scan22_math_int64_edge.hls — Stage 53 deep-scan-22
# (MEDIUM severity): math_round rejected INT64_MIN.
#
# Bug: math_round's range check used `x <= -9223372036854775808.0` which
# panicked for x = INT64_MIN. But INT64_MIN is exactly representable as
# a double AND is a valid int64 — the function should return INT64_MIN.
#
# Root cause: HLS float literals are parsed by Python's float(), which
# rounds to the nearest IEEE-754 double. `-9223372036854775808.0` IS
# exactly representable (it's -2^63). The check `x <= -2^63` rejected
# the boundary value, but the correct check is `x < -2^63` (strict less
# than) — values BELOW INT64_MIN should panic, but INT64_MIN itself is
# valid.
#
# Fix: changed `x <= -9223372036854775808.0` to `x < -9223372036854775808.0`
# in std/math.hls math_round. Also added a clarifying comment.

import "std.math"

fn ok(actual: bool, msg: str) -> void uses IO {
    if !actual {
        panic("FAIL " + msg)
    }
}

fn eq_int(actual: int, expected: int, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn test_round_int64_min() -> int uses IO {
    # INT64_MIN as a float — exactly representable as -2^63.
    let x: float = -9223372036854775808.0
    # math_round used to panic here; now it returns INT64_MIN.
    let r: int = math_round(x)
    eq_int(r, -9223372036854775808, "math_round(INT64_MIN as float) = INT64_MIN")
    return 0
}

fn test_round_int64_max() -> int uses IO {
    # INT64_MAX = 2^63 - 1 is NOT exactly representable as a double.
    # The closest double is 2^63 = 9223372036854775808.0. The literal
    # 9223372036854775807.0 in HLS source rounds to 9223372036854775808.0
    # (= 2^63), which is OUT of int64 range. math_round should panic.
    # We can't easily test the panic path without try/catch, so we
    # just test that values well below 2^63 round correctly.
    let x: float = 9223372036854774784.0  # 2^63 - 1024 (exactly representable as double)
    let r: int = math_round(x)
    eq_int(r, 9223372036854774784, "math_round(2^63 - 1024) = 2^63 - 1024")
    return 0
}

fn test_round_normal_values() -> int uses IO {
    eq_int(math_round(0.0), 0, "round(0.0) = 0")
    eq_int(math_round(0.4), 0, "round(0.4) = 0")
    eq_int(math_round(0.5), 1, "round(0.5) = 1 (away from zero)")
    eq_int(math_round(0.6), 1, "round(0.6) = 1")
    eq_int(math_round(-0.4), 0, "round(-0.4) = 0")
    eq_int(math_round(-0.5), -1, "round(-0.5) = -1 (away from zero)")
    eq_int(math_round(-0.6), -1, "round(-0.6) = -1")
    eq_int(math_round(2.5), 3, "round(2.5) = 3")
    eq_int(math_round(-2.5), -3, "round(-2.5) = -3")
    return 0
}

fn test_floor_ceil_int64_min() -> int uses IO {
    # math_floor and math_floor of INT64_MIN should return INT64_MIN
    # (it's already an integer — no fractional part to floor/ceil).
    let x: float = -9223372036854775808.0
    let f: float = math_floor(x)
    ok(f == x, "math_floor(INT64_MIN as float) = INT64_MIN (no fractional part)")
    let c: float = math_ceil(x)
    ok(c == x, "math_ceil(INT64_MIN as float) = INT64_MIN (no fractional part)")
    return 0
}

fn main() -> int uses IO {
    println("=== Stage 53 deep-scan-22: math_round INT64_MIN bug ===")
    println("")
    println("--- math_round(INT64_MIN as float) — used to panic ---")
    test_round_int64_min()
    println("  ok")
    println("--- math_round(values near INT64_MAX) ---")
    test_round_int64_max()
    println("  ok")
    println("--- math_round normal values (regression) ---")
    test_round_normal_values()
    println("  ok")
    println("--- math_floor / math_ceil of INT64_MIN ---")
    test_floor_ceil_int64_min()
    println("  ok")
    println("")
    println("ACCEPTANCE OK: Stage 53 deep-scan-22 — math_round INT64_MIN bug")
    println("  math_round now accepts INT64_MIN as a valid input")
    println("  The check `x <= -9223372036854775808.0` was too strict (rejected boundary)")
    println("  Fixed to `x < -9223372036854775808.0` (strict less than)")
    println("  math_floor / math_ceil of INT64_MIN return INT64_MIN (no fractional part)")
    println("  differential (interpreter == native) verified green.")
    return 0
}
