# feat_contract_basic.hls — Stage 17 (v0.28.0-alpha): requires clauses,
# multiple requires (&&-combined), and static call-site checking.

fn div(a: int, b: int) -> int
    requires b != 0
{
    return a / b
}

fn clamp(n: int, lo: int, hi: int) -> int
    requires lo <= hi
    requires n >= lo
    requires n <= hi
{
    return n
}

fn strlen_bounded(s: str) -> int
    requires s.len() > 0
{
    return s.len()
}

fn main() -> int uses IO {
    let a: int = div(10, 2)
    let b: int = clamp(42, 0, 100)
    let c: int = strlen_bounded("hello")
    println("div=" + a.to_str() + " clamp=" + b.to_str() + " len=" + c.to_str())
    return 0
}
