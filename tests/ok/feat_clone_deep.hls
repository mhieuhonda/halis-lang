# feat_clone_deep.hls — Stage 8-beta (v0.19.0-alpha): clone() now supports
# EVERY owned type, including structs and enums (per-instantiation codegen
# helpers in the native compiler; deep_clone in the interpreter).

struct Inner {
    label: str,
    nums: list[int]
}

struct Outer {
    name: str,
    inner: Inner,
    words: list[str]
}

enum Tree {
    Leaf(int),
    Node(str, list[Tree])
}

fn sum_children(children: list[Tree]) -> int {
    let mut acc: int = 0
    let mut i: int = 0
    while i < children.len() {
        acc = acc + deep_sum(children.get(i))
        i = i + 1
    }
    return acc
}

fn deep_sum(t: Tree) -> int {
    return match t {
        Tree.Leaf(v) => v,
        Tree.Node(_, children) => sum_children(children)
    }
}

fn main() -> int uses IO {
    # clone a nested struct: mutating the clone must not touch the original
    let a: Outer = Outer {
        name: "original",
        inner: Inner { label: "in", nums: [1, 2, 3] },
        words: ["alpha", "beta"]
    }
    let b: Outer = clone(a)
    b.name = "clone"
    b.inner.nums.push(99)
    b.words.push("gamma")
    println("a.name=" + a.name + " nums=" + a.inner.nums.len().to_str()
        + " words=" + a.words.len().to_str())
    println("b.name=" + b.name + " nums=" + b.inner.nums.len().to_str()
        + " words=" + b.words.len().to_str())

    # clone a recursive enum
    let t: Tree = Tree.Node("root", [Tree.Leaf(1), Tree.Node("mid", [Tree.Leaf(2), Tree.Leaf(3)])])
    let t2: Tree = clone(t)
    println("t.sum=" + deep_sum(t).to_str())
    println("t2.sum=" + deep_sum(t2).to_str())

    # clone a list of structs (per-instantiation helper)
    let pts: list[Inner] = [Inner { label: "x", nums: [10] }, Inner { label: "y", nums: [20, 30] }]
    let pts2: list[Inner] = clone(pts)
    # mutating the clone's element must not affect the original
    let first: Inner = pts2.get(0)
    # (get borrows; clone again to own an independent copy)
    let owned: Inner = clone(first)
    owned.nums.push(1000)
    println("pts[0].nums=" + pts.get(0).nums.len().to_str())
    println("pts2[0].nums=" + pts2.get(0).nums.len().to_str())

    # clone a map with struct values
    let m: map[str, Inner] = map_new()
    m.set("k", Inner { label: "v", nums: [5, 6] })
    let m2: map[str, Inner] = clone(m)
    let mv: Inner = m2.get_or("k", Inner { label: "d", nums: [] })
    mv.nums.push(7)
    println("m[k].nums=" + m.get_or("k", Inner { label: "d", nums: [] }).nums.len().to_str())
    println("m2[k].nums=" + m2.get_or("k", Inner { label: "d", nums: [] }).nums.len().to_str())
    return 0
}
