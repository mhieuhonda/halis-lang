# feat_stdlib_base64.hls — verify std.base64 RFC 4648 test vectors.
import "std.base64"

fn main() -> int uses IO {
    # RFC 4648 §10 test vectors.
    if base64_encode("") != "" {
        println("FAIL: b64 empty")
        return 1
    }
    if base64_encode("f") != "Zg==" {
        println("FAIL: b64 'f' -> " + base64_encode("f"))
        return 1
    }
    if base64_encode("fo") != "Zm8=" {
        println("FAIL: b64 'fo'")
        return 1
    }
    if base64_encode("foo") != "Zm9v" {
        println("FAIL: b64 'foo'")
        return 1
    }
    if base64_encode("foob") != "Zm9vYg==" {
        println("FAIL: b64 'foob'")
        return 1
    }
    if base64_encode("fooba") != "Zm9vYmE=" {
        println("FAIL: b64 'fooba'")
        return 1
    }
    if base64_encode("foobar") != "Zm9vYmFy" {
        println("FAIL: b64 'foobar'")
        return 1
    }
    # Round-trip decode.
    if base64_decode("Zm9vYmFy") != "foobar" {
        println("FAIL: b64d 'foobar'")
        return 1
    }
    # URL-safe variant must NOT have '+' or '/'.
    let url_e: str = base64url_encode("Hello, World!")
    if url_e.contains("+") || url_e.contains("/") {
        println("FAIL: base64url has std chars: " + url_e)
        return 1
    }
    # Round-trip via url-safe decode.
    if base64url_decode(url_e) != "Hello, World!" {
        println("FAIL: b64url round-trip")
        return 1
    }
    println("OK: base64")
    return 0
}
