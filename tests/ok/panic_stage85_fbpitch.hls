# Expect: exit 101, panic "fb_new: pitch is narrower than one line of pixels"
# fb_new is the CHECKED constructor. Firmware data goes through fb_raw
# so a parser can hand a bad mode to fb_geometry_ok rather than
# panicking three instructions into early boot.
import "core.boot"

fn main() -> int {
    let f: Framebuffer = fb_new(1073741824, 1024, 768, 2048, 32, FbKind.Rgb)
    if f.pitch != 2048 {
        return 1
    }
    return 0
}
