# feat_proof_sound_range.hls — Stage-17 perfection (deep-scan-10)
# soundness regression: for i in range(a, b) seeds i in [a, b-1] —
# the old engine seeded [0, count-1], which is wrong whenever a != 0
# (the native -O fast build read out of bounds). Both implementations
# must panic identically (101).
fn sum(xs: list[int]) -> int
    requires xs.len() >= 4
{
    let mut t: int = 0
    for i: int in range(1, 5) {
        t = t + xs[i]
    }
    return t
}
fn main() -> int uses IO {
    let xs: list[int] = [10, 20, 30, 40]
    return sum(xs)
}
