# feat_deep_scan27_nested_generic.hls — deep-scan-27 regression: the
# self-hosted compiler's codegen must re-bind a generic callee's type
# args when the call sits inside ANOTHER generic fn's body. The checker
# annotates the generic body once, with the enclosing fn's type params
# still symbolic — previously the instantiated body of `outer[int]`
# emitted a call to the UNBOUND `usf_inner__T` and the codegen also
# emitted bogus `T* usf_inner__T(T*)` prototypes + bodies (unknown type
# name `T` — a hard error under GCC 14's C23 default). Neither state is
# reachable from any earlier test: every previous generic test called
# generic fns only from concrete contexts.
fn inner[T](x: T) -> T {
    return x
}

fn outer[T](x: T) -> T {
    return inner(x)
}

fn main() -> int uses IO {
    let a: int = outer(5)
    let b: str = outer("hi")
    let c: bool = outer(true)
    println(a.to_str())
    println(b)
    if c {
        println("true-branch")
    }
    return 0
}
