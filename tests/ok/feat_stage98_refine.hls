# Stage 98 (v0.117.0-alpha): refinement types — the main differential.
# Refined parameters, return types, let annotations and struct fields,
# with guards exercised on both sides of the proof boundary: constant
# values are checked at compile time, runtime values pass the emitted
# guards. The interpreter and the native build must agree byte for byte.

struct Account {
    owner: str where self.len() > 0,
    balance: int where self >= 0
}

# a refined parameter: the callee may rely on the invariant
fn withdraw(a: Account, amt: int where self > 0) -> Account {
    return Account{ owner: a.owner, balance: a.balance - amt }
}

# a refined return type: every caller receives a certified value
fn abs_diff(a: int, b: int) -> int where self >= 0 {
    if a > b {
        return a - b
    }
    return b - a
}

# a refined parameter that proves division safety inside the body
fn halve(d: int where self != 0, n: int) -> int {
    return n / d
}

# same-pred flow: a value already carrying the pred needs no re-check
fn clamp_nonneg(v: int) -> int where self >= 0 {
    if v < 0 {
        return 0
    }
    return v
}

impl Account {
    fn deposit(self: Account, amt: int where self > 0) -> Account {
        return Account{ owner: self.owner, balance: self.balance + amt }
    }
    fn summary(self: Account) -> str {
        return self.owner + ": " + self.balance.to_str()
    }
}

fn main() -> int uses IO {
    # constant field values: checked at compile time, guarded in the ctor
    let acc: Account = Account{ owner: "alice", balance: 100 }
    println(acc.summary())

    # refined parameter, runtime value: entry guard passes
    let acc2: Account = withdraw(acc, 30)
    println(acc2.summary())

    # method receiver + refined method parameter
    let acc3: Account = acc2.deposit(5)
    println(acc3.summary())

    # refined return type, runtime value: return guard passes
    println(abs_diff(3, 10).to_str())
    println(abs_diff(10, 3).to_str())

    # refined lets with runtime values
    let n: int = 42
    let r: int where self >= 0 = abs_diff(n, 100)
    println("r = " + r.to_str())

    # same-pred flow: r already satisfies "self >= 0"
    let r2: int where self >= 0 = r
    println("r2 = " + r2.to_str())

    # str refinement on a let
    let name: str where self.len() > 0 = "carol"
    println("name ok")

    # division proven safe by the parameter refinement
    println(halve(2, 84).to_str())
    println(halve(0 - 2, 84).to_str())

    # the clamped value flows into a refined let with the same pred
    let c: int where self >= 0 = clamp_nonneg(0 - 9)
    println("c = " + c.to_str())

    # refined value feeds arithmetic that keeps the invariant
    let acc4: Account = withdraw(acc3, acc3.balance)
    println("empty: " + acc4.balance.to_str())
    return 0
}
