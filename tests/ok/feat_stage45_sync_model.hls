# tests/ok/feat_stage45_sync_model.hls — Stage 45 (v0.64.0-alpha):
# hlmodel state-machine model of the 2-thread / 2-lock acquisition
# protocol that std.sync.Mutex supports deadlock-free.
#
# The model represents two threads (A, B) acquiring two mutexes (m1,
# m2) in a CONSISTENT order (always m1 before m2). The state is the
# pair of "what each thread currently holds". The events are the
# acquire / release operations. The invariant is that the system
# never reaches a state where both threads hold a lock AND are
# waiting for the other's lock (the classic deadlock).
#
# This is a FINITE-STATE model: 9 states (3 hold-states per thread
# x 3 hold-states per thread, where hold-state in {None, m1, m1+m2}).
# The deadlock state is NOT in the model — the invariant verifies
# it's unreachable.
#
# Run with:
#   python3 tools/hlmodel.py tests/ok/feat_stage45_sync_model.hls \
#       --fn step --invariant no_deadlock --init Init

enum SyncState {
    Init,
    A_has_m1,
    A_has_both,
    B_has_m1,
    B_has_both,
    A_has_m1_B_has_m1,
    A_has_both_B_has_m1,
    A_has_both_B_has_both,
    Deadlock
}

enum SyncEvent {
    A_acquire_m1,
    A_acquire_m2,
    A_release_m1,
    A_release_m2,
    B_acquire_m1,
    B_acquire_m2,
    B_release_m1,
    B_release_m2
}

# The transition function. Both threads acquire m1 first, then m2.
# A thread can only acquire m1 if neither thread holds it. A thread
# can only acquire m2 if it holds m1 AND neither thread holds m2.
# A release of m1 (resp. m2) requires the thread to hold m2 (resp.
# m1) — i.e., locks are released in LIFO order (the opposite of
# acquisition).
#
# Under this protocol, the deadlock state (both threads hold m1 and
# wait for the other's m2) is unreachable: only ONE thread can hold
# m1 at a time, so the "both hold m1" state never arises. The
# invariant `no_deadlock` asserts this on every reachable state.
fn step(s: SyncState, e: SyncEvent) -> SyncState {
    return match s {
        SyncState.Init => match e {
            SyncEvent.A_acquire_m1 => SyncState.A_has_m1,
            SyncEvent.B_acquire_m1 => SyncState.B_has_m1,
            _ => SyncState.Init
        },
        SyncState.A_has_m1 => match e {
            SyncEvent.A_acquire_m2 => SyncState.A_has_both,
            SyncEvent.A_release_m1 => SyncState.Init,
            _ => SyncState.A_has_m1
        },
        SyncState.A_has_both => match e {
            SyncEvent.A_release_m2 => SyncState.A_has_m1,
            _ => SyncState.A_has_both
        },
        SyncState.B_has_m1 => match e {
            SyncEvent.B_acquire_m2 => SyncState.B_has_both,
            SyncEvent.B_release_m1 => SyncState.Init,
            _ => SyncState.B_has_m1
        },
        SyncState.B_has_both => match e {
            SyncEvent.B_release_m2 => SyncState.B_has_m1,
            _ => SyncState.B_has_both
        },
        SyncState.A_has_m1_B_has_m1 => SyncState.A_has_m1_B_has_m1,
        SyncState.A_has_both_B_has_m1 => SyncState.A_has_both_B_has_m1,
        SyncState.A_has_both_B_has_both => SyncState.A_has_both_B_has_both,
        SyncState.Deadlock => SyncState.Deadlock
    }
}

# The invariant: the system is never in the Deadlock state (and never
# in the "both hold m1" state, which is the precondition for deadlock
# under the opposite-ordering protocol that we are NOT using). HLS
# does not allow == on enum types, so we use a match expression.
fn no_deadlock(s: SyncState) -> bool {
    return match s {
        SyncState.Deadlock => false,
        SyncState.A_has_m1_B_has_m1 => false,
        SyncState.A_has_both_B_has_m1 => false,
        SyncState.A_has_both_B_has_both => false,
        _ => true
    }
}

fn main() -> int uses IO {
    println("Stage 45 sync model — see hlmodel output for the exhaustive check.")
    return 0
}
