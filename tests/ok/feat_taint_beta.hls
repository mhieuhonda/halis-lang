# Stage 10-beta test: read_file_tainted + taint helpers.
# Verifies:
#   1. read_file_tainted returns tainted[str] (cannot be passed to println).
#   2. The new helpers (taint_check_byte_at, taint_concat, taint_concat_clean)
#      work correctly.
#   3. The sink rejection still works (compile-time taint enforcement).
import "std.sanitize"
import "std.taint"

fn read_first(path: str) -> tainted[str] uses Fs {
    return read_file_tainted(path)
}

fn main() -> int uses Fs, IO {
    let content: tainted[str] = read_first("examples/data.txt")
    let n: int = taint_check_len(content)
    if n == 0 {
        println("(empty)")
        return 0
    }
    let first: int = taint_check_byte_at(content, 0)
    println("first byte: " + first.to_str())

    let combined: tainted[str] = taint_concat(content, taint_mark(" (tainted)"))
    println("combined len: " + taint_check_len(combined).to_str())

    let prefixed: tainted[str] = taint_concat_clean(content, "<<<")
    println("prefixed len: " + taint_check_len(prefixed).to_str())

    # Sanitize via sanitize_html — file content with newlines/spaces is OK
    # (newlines are not HTML metacharacters, only < > & " ' / are).
    let safe: str = sanitize_html(content)
    println("sanitized: " + safe)
    return 0
}

