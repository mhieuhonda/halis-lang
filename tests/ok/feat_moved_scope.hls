# feat_moved_scope.hls — verifies BUG-003 fix: moves done inside if/while/for
# child scopes don't leak out — the branch may not execute, so any binding
# "moved" inside should still be considered unmoved after the construct.

fn main() -> int uses IO {
    let mut s: str = "hello"

    # Move inside an if-then — binding should still be usable after.
    if s.len() > 0 {
        drop(s)
    }
    # Reassign to revive — without BUG-003 fix, this would be rejected
    # because `s` is considered still-moved.
    s = "revived"
    println("after if: " + s)

    # Move inside a while body — same thing, zero iterations possible.
    let mut t: str = "world"
    while false {
        drop(t)
    }
    t = "still ok"
    println("after while: " + t)

    # Move inside a for body.
    let xs: list[int] = [1, 2, 3]
    let mut u: str = "before"
    for x: int in xs {
        drop(u)
        u = "during"
    }
    # After the loop, u may or may not have been moved (depending on
    # whether the loop ran), so it must be considered "alive".
    u = "after"
    println("after for: " + u)
    return 0
}
