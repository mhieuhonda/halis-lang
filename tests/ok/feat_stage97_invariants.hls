# ============================================================================
# tests/ok/feat_stage97_invariants.hls — Stage 97: SMT-based loop-
# invariant inference
# ----------------------------------------------------------------------------
# The stage's engine is TOOL-SIDE (hlprove --infer-invariants): loops
# are summarised, candidates are generated from templates, and z3
# decides initiation + preservation. Inference is analysis-only — it
# changes NO compilation — so this ok-test pins the OTHER half of the
# contract: every loop shape the engine reasons about (counter +
# accumulator strengthening, step-k overshoot bounds, congruence
# classes, for-range entry equations, conditional updates, unmodeled
# non-affine bodies) is an ORDINARY program that runs identically on
# the interpreter and natively. The invariants themselves are gated in
# tests/invariant_acceptance.py (make invariant-acceptance).
# ============================================================================

# Strengthening showcase: s' = s + i is inductive for s >= 0 only
# together with i >= 0 — the engine accepts the counter first.
fn sum_to(n: int) -> int
    requires n >= 0
{
    let mut s: int = 0
    let mut i: int = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    return s
}

# Step-2 loop: the condition-derived bound is i <= n + 1 (overshoot),
# not i <= n; the congruence i ≡ 0 (mod 2) also survives.
fn step_two(n: int) -> int
    requires n >= 0
{
    let mut i: int = 0
    while i < n {
        i = i + 2
    }
    return i
}

# Congruence: +4 steps keep x ≡ 0 (mod 4) — a non-interval fact.
fn by_fours(n: int) -> int
    requires n >= 0
{
    let mut x: int = 0
    let mut k: int = 0
    while k < n {
        x = x + 4
        k = k + 1
    }
    return x
}

# for-range: the loop variable is fresh-bound per iteration; the
# entry equation anchors i >= 0 and the range bound gives i <= n.
fn range_sum(n: int) -> int
    requires n >= 0
{
    let mut s: int = 0
    for i: int in range(0, n) {
        s = s + i
    }
    return s
}

# Conditional updates: i' = i + 1 | i + 2 — both branches preserve
# i >= 0; the disjunctive transition is encoded, not guessed.
fn drift(n: int) -> int
    requires n >= 0
{
    let mut i: int = 0
    while i < n {
        if i % 2 == 0 {
            i = i + 1
        } else {
            i = i + 2
        }
    }
    return i
}

# An unmodeled body (non-affine update through a call): the engine
# reports the variable unmodeled and claims NOTHING — the program
# itself is of course unaffected.
fn collatz_steps(mut x: int, cap: int) -> int
    requires cap >= 0
{
    let mut steps: int = 0
    let mut guard: int = 0
    while x > 1 && guard < cap {
        if x % 2 == 0 {
            x = x / 2
        } else {
            x = 3 * x + 1
        }
        guard = guard + 1
    }
    steps = guard
    return steps
}

# The skipper: i >= 0 is honestly REJECTED (1 steps to -1); the tight
# bound i >= -1 is what the solver accepts.
fn skipper(n: int) -> int
    requires n >= 0
{
    let mut i: int = n
    while i > 0 {
        i = i - 2
    }
    return i
}

fn expect(cond: bool, msg: str) -> void {
    if !cond {
        panic("stage97: " + msg)
    }
}

fn main() -> int uses IO {
    expect(sum_to(10) == 45, "sum_to(10)")
    expect(sum_to(0) == 0, "sum_to(0) — the empty loop")
    expect(step_two(10) == 10, "step_two(10)")
    expect(step_two(11) == 12, "step_two(11) — the overshoot is real")
    expect(by_fours(5) == 20, "by_fours(5)")
    expect(range_sum(10) == 45, "range_sum(10)")
    expect(range_sum(0) == 0, "range_sum(0) — vacuous range")
    expect(drift(10) >= 10, "drift(10) lands past the bound")
    expect(collatz_steps(27, 1000) == 111, "collatz steps for 27")
    expect(collatz_steps(1, 1000) == 0, "collatz steps for 1")
    expect(skipper(5) == -1, "skipper(5) — the -1 the prover saw")
    expect(skipper(4) == 0, "skipper(4) — even n lands exactly on 0")
    println("stage97 ok")
    return 0
}
