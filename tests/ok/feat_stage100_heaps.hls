# ============================================================================
# tests/ok/feat_stage100_heaps.hls — Stage 100: the separation-logic
# fragment (heap shapes)
# ----------------------------------------------------------------------------
# The stage's engine is TOOL-SIDE (hlprove --shapes): alias classes,
# separation verdicts and cursor-loop shape triples are REPORTS — the
# fragment is analysis-only and changes NO compilation. This ok-test
# pins the other half of the contract: every loop the engine reasons
# about (for-range anchored on len, while-anchored walks, set/get
# read-modify-write at the cursor, var range starts under a requires,
# two lists walking in one function) is an ORDINARY program that runs
# identically on the interpreter and natively. The shape verdicts
# themselves are gated in tests/shapes_acceptance.py
# (make shapes-acceptance).
# ============================================================================

# The flagship for-range walk: writes stay in the cursor cell.
fn fill(xs: list[int], m: int) -> int {
    for i: int in range(0, xs.len()) {
        xs[i] = i * m
    }
    return 0
}

# The while-anchored walk: the condition is the anchor, step +1 after
# the accesses.
fn double_all(xs: list[int]) -> int {
    let mut i: int = 0
    while i < xs.len() {
        xs[i] = xs[i] * 2
        i = i + 1
    }
    return 0
}

# Read-modify-write through set/get at the cursor: the frame accepts
# set(cursor, ..) exactly like xs[cursor] = ..
fn bump_all(xs: list[int]) -> int {
    let mut i: int = 0
    while i < len(xs) {
        xs.set(i, xs.get(i) + 1)
        i = i + 1
    }
    return 0
}

# A var range start: in bounds only under a requires — the seeded entry
# fact is what pins the shape's initiation.
fn fill_from(xs: list[int], start: int) -> int
    requires start >= 0
{
    for i: int in range(start, xs.len()) {
        xs[i] = 7
    }
    return 0
}

# Two roots, two walks, one function: each loop's frame only covers its
# own anchor's cells; the separation verdict between dst and src stays
# honest (refused — both caller-owned).
fn rotate_pair(a: list[int], b: list[int]) -> int {
    let mut i: int = 0
    while i < a.len() {
        a[i] = a[i] + b[i]
        i = i + 1
    }
    for j: int in range(0, b.len()) {
        b[j] = j
    }
    return 0
}

# A fresh buffer allocated inside the function: own(a) * own(buf) is
# PROVEN separation — one side is allocated here, disjoint from every
# pre-existing object.
fn seeded(a: list[int]) -> int {
    let buf: list[int] = [1, 2, 3]
    let mut t: int = 0
    for k: int in range(0, buf.len()) {
        t = t + a[k] * buf[k]
    }
    return t
}

fn show(tag: str, xs: list[int]) -> str {
    let mut out: str = tag + ":"
    for v: int in xs {
        out = out + " " + v.to_str()
    }
    return out
}

fn main() -> int uses IO {
    let xs: list[int] = [1, 2, 3, 4]
    fill(xs, 3)
    println(show("fill", xs))
    double_all(xs)
    println(show("doubled", xs))
    bump_all(xs)
    println(show("bumped", xs))

    let ys: list[int] = [5, 6, 7, 8]
    fill_from(ys, 2)
    println(show("filled_from", ys))

    let p: list[int] = [1, 0, 0, 0]
    let q: list[int] = [2, 2, 2, 2]
    rotate_pair(p, q)
    println(show("p", p))
    println(show("q", q))

    let r: list[int] = [4, 5, 6]
    println("seeded=" + seeded(r).to_str())
    println(show("r_unmoved", r))
    return 0
}
