# feat_freestanding_basic.hls — Stage 77: a minimal `#![freestanding]`
# crate (no libc, no OS calls, no std). Pure computation only; the
# exit code is 0 on success (the differential suite compares
# interpreter-vs-native exit codes, and section 1 requires 0/101).
# Any positive exit code is a failure count (a broken implementation
# turns the suite red, as intended).
#![freestanding]

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn fact(n: int) -> int {
    let mut acc: int = 1
    let mut i: int = 2
    while i <= n {
        acc = acc * i
        i = i + 1
    }
    return acc
}

fn main() -> int {
    let mut failures: int = 0
    if fib(10) != 55 {
        failures = failures + 1
    }
    if fact(5) != 120 {
        failures = failures + 1
    }
    let xs: list[int] = [3, 1, 4, 1, 5]
    if xs.len() != 5 {
        failures = failures + 1
    }
    if xs.get(2) != 4 {
        failures = failures + 1
    }
    let m: map[str, int] = map_new()
    m.set("k", 41)
    if m.get_or("k", 0) != 41 {
        failures = failures + 1
    }
    # int rendering works freestanding (hand-rolled %lld, Stage 77).
    if(120).to_str() != "120" {
        failures = failures + 1
    }
    if(-7).to_str() != "-7" {
        failures = failures + 1
    }
    # The float predicates stay available (exact bit tests, no libm).
    if math_isnan(0.0) {
        failures = failures + 1
    }
    if !math_isfinite(1.5) {
        failures = failures + 1
    }
    if math_signbit(-2.5) != true {
        failures = failures + 1
    }
    return failures
}
