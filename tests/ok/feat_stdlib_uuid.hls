# feat_stdlib_uuid.hls — verify std.uuid generation and validation.
import "std.uuid"

fn main() -> int uses IO {
    # Deterministic v4 UUID: same inputs -> same UUID.
    let u1: str = uuid_v4_deterministic("ns", 1)
    let u1_again: str = uuid_v4_deterministic("ns", 1)
    if u1 != u1_again {
        println("FAIL: v4 deterministic")
        return 1
    }
    # Different counter -> different UUID.
    let u2: str = uuid_v4_deterministic("ns", 2)
    if u1 == u2 {
        println("FAIL: v4 should differ on counter")
        return 1
    }
    # Different namespace -> different UUID.
    let u3: str = uuid_v4_deterministic("other-ns", 1)
    if u1 == u3 {
        println("FAIL: v4 should differ on namespace")
        return 1
    }

    # Length and format.
    if u1.len() != 36 {
        println("FAIL: v4 length = " + u1.len().to_str())
        return 1
    }
    if !uuid_is_valid(u1) {
        println("FAIL: v4 not valid format")
        return 1
    }
    # Version nibble must be 4.
    if u1.byte_at(14) != 52 {        # '4'
        println("FAIL: v4 version nibble = " + chr(u1.byte_at(14)))
        return 1
    }
    # Variant nibble must be 8, 9, a, or b.
    let v_nibble: int = u1.byte_at(19)
    if v_nibble != 56 && v_nibble != 57 && v_nibble != 97 && v_nibble != 98 {
        println("FAIL: v4 variant nibble = " + chr(v_nibble))
        return 1
    }

    # v5-like.
    let n1: str = uuid_v5_like("ns", "/path/to/x")
    let n1_again: str = uuid_v5_like("ns", "/path/to/x")
    if n1 != n1_again {
        println("FAIL: v5 deterministic")
        return 1
    }
    let n2: str = uuid_v5_like("ns", "/path/to/y")
    if n1 == n2 {
        println("FAIL: v5 should differ on name")
        return 1
    }
    if uuid_version(n1) != 5 {
        println("FAIL: v5 version = " + uuid_version(n1).to_str())
        return 1
    }

    # Validation: rejects non-UUID strings.
    if uuid_is_valid("not-a-uuid") {
        println("FAIL: should reject 'not-a-uuid'")
        return 1
    }
    if !uuid_is_valid("12345678-1234-4123-8123-123456789012") {
        println("FAIL: should accept canonical form")
        return 1
    }

    println("OK: uuid")
    return 0
}
