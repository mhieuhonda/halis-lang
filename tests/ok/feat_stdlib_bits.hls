# tests/ok/feat_stdlib_bits.hls — exercise std.bits (non-roadmap upgrade).
import "std.bits"
import "std.str"

fn main() -> int uses IO {
    # Bitwise NOT (two's complement identity: ~x = -x - 1).
    if bits_not(0) != -1 {
        panic("bits_not(0) failed")
    }
    if bits_not(5) != -6 {
        panic("bits_not(5) failed")
    }
    if bits_not(-1) != 0 {
        panic("bits_not(-1) failed")
    }

    # Single-bit get / set.
    if bits_get(10, 0) != 0 {
        panic("bits_get bit 0 failed")
    }
    if bits_get(10, 1) != 1 {
        panic("bits_get bit 1 failed")
    }
    if bits_get(10, 3) != 1 {
        panic("bits_get bit 3 failed")
    }
    if bits_set(0, 5, 1) != 32 {
        panic("bits_set 5,1 failed")
    }
    if bits_set(32, 5, 0) != 0 {
        panic("bits_set 5,0 failed")
    }
    # Set a bit that's already set: no-op.
    if bits_set(32, 5, 1) != 32 {
        panic("bits_set already-set failed")
    }

    # AND / OR / XOR on small values.
    if bits_and(12, 10) != 8 {
        panic("bits_and failed")
    }
    if bits_or(12, 10) != 14 {
        panic("bits_or failed")
    }
    if bits_xor(12, 10) != 6 {
        panic("bits_xor failed")
    }

    # Shifts.
    if bits_shl(1, 4) != 16 {
        panic("bits_shl 1<<4 failed")
    }
    if bits_shl(1, 63) != -9223372036854775808 {
        panic("bits_shl 1<<63 failed")
    }
    if bits_shr(256, 4) != 16 {
        panic("bits_shr 256>>4 failed")
    }
    if bits_shr(-1, 0) != -1 {
        panic("bits_shr -1>>0 failed")
    }
    # -1 has all bits set; logical right shift by 1 = 2^63 - 1.
    if bits_shr(-1, 1) != 9223372036854775807 {
        panic("bits_shr -1>>1 failed")
    }
    if bits_sar(-1024, 4) != -64 {
        panic("bits_sar -1024>>4 failed")
    }

    # Popcount / clz / ctz.
    if bits_popcount(0) != 0 {
        panic("bits_popcount(0) failed")
    }
    if bits_popcount(255) != 8 {
        panic("bits_popcount(255) failed")
    }
    if bits_popcount(-1) != 64 {
        panic("bits_popcount(-1) failed")
    }
    if bits_clz(0) != 64 {
        panic("bits_clz(0) failed")
    }
    if bits_clz(1) != 63 {
        panic("bits_clz(1) failed")
    }
    if bits_ctz(0) != 64 {
        panic("bits_ctz(0) failed")
    }
    if bits_ctz(8) != 3 {
        panic("bits_ctz(8) failed")
    }

    # Byte helpers.
    # x = 0x123456789ABCDEF0 = 1311768467463790320 (decimal, fits int64).
    let big: int = 1311768467463790320
    if bits_byte(big, 0) != 240 {
        panic("bits_byte 0 failed")
    }
    if bits_byte(big, 7) != 18 {
        panic("bits_byte 7 failed")
    }
    # y = 0x0102030405060708 = 72623859790382856 (decimal).
    let y: int = 72623859790382856
    let be: list[int] = bits_bytes_be(y)
    if be.get(0) != 1 {
        panic("bits_bytes_be[0] failed")
    }
    if be.get(7) != 8 {
        panic("bits_bytes_be[7] failed")
    }
    let le: list[int] = bits_bytes_le(y)
    if le.get(0) != 8 {
        panic("bits_bytes_le[0] failed")
    }
    if le.get(7) != 1 {
        panic("bits_bytes_le[7] failed")
    }
    if bits_from_bytes_be(be) != y {
        panic("bits_from_bytes_be roundtrip failed")
    }
    if bits_from_bytes_le(le) != y {
        panic("bits_from_bytes_le roundtrip failed")
    }

    println("bits ok")
    return 0
}
