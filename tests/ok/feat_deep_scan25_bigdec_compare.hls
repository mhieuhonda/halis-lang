# feat_deep_scan25_bigdec_compare.hls — deep-scan-25 regression: the
# magnitude comparator behind bigdecimal_lt/gt/le/ge used "the longer
# digit list wins" after equal prefixes, so equal values with different
# scales mis-ordered: eq(1.5, 1.50) was true while lt(1.5, 1.50) was
# ALSO true (and ge false) — a violation of the total order. The fix:
# magnitudes are equal iff every extra digit is zero; any non-zero
# extra digit makes the longer number strictly larger.
import "std.math"
fn bigdec_of(s: str) -> BigDecimal {
    let r: Result[BigDecimal, str] = bigdecimal_from_str(s)
    if !result_is_ok(r) {
        panic("bigdecimal_from_str failed for '" + s + "'")
    }
    return result_unwrap(r)
}
fn check_ord(a: str, b: str, want_lt: bool, label: str) {
    let x: BigDecimal = bigdec_of(a)
    let y: BigDecimal = bigdec_of(b)
    let lt: bool = bigdecimal_lt(x, y)
    let gt: bool = bigdecimal_gt(x, y)
    let eq: bool = bigdecimal_eq(x, y)
    if lt != want_lt {
        panic(label + ": lt is " + lt.to_str() + ", want " + want_lt.to_str())
    }
    if gt && want_lt {
        panic(label + ": both lt and gt")
    }
    if eq && (lt || gt) {
        panic(label + ": eq together with lt/gt")
    }
    if !eq && !lt && !gt {
        panic(label + ": neither eq, lt nor gt (broken total order)")
    }
    # Consistency of the derived operators.
    if bigdecimal_le(x, y) != !(gt) {
        panic(label + ": le inconsistent with gt")
    }
    if bigdecimal_ge(x, y) != !(lt) {
        panic(label + ": ge inconsistent with lt")
    }
}
fn main() -> int uses IO {
    # Equal values with different scales: lt/gt must be FALSE.
    check_ord("1.5", "1.50", false, "1.5 vs 1.50")
    check_ord("1.50", "1.5", false, "1.50 vs 1.5")
    check_ord("0.1", "0.10", false, "0.1 vs 0.10")
    check_ord("1.5000000", "1.5", false, "1.5000000 vs 1.5")
    check_ord("-1.5", "-1.50", false, "-1.5 vs -1.50")
    check_ord("0", "0.0", false, "0 vs 0.0")
    # Strictly smaller / larger still ordered correctly.
    check_ord("1.5", "1.6", true, "1.5 vs 1.6")
    check_ord("1.5", "1.52", true, "1.5 vs 1.52")
    check_ord("2.0", "1.50", false, "2.0 vs 1.50 (gt case)")
    check_ord("0.05", "0.5", true, "0.05 vs 0.5")
    check_ord("-2", "-1.50", true, "-2 vs -1.50")
    println("bigdecimal compare OK")
    return 0
}
