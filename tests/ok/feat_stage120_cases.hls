# ============================================================================
# tests/ok/feat_stage120_cases.hls — Stage 120 acceptance: parameterised
# (table-driven) tests
# ----------------------------------------------------------------------------
# This file is BOTH a valid Halis program (you can run it via `boot.py`)
# AND a hltest test file (you can run it via `tools/hltest.py`). Every
# test_* function taking exactly one parameter is a TABLE test: its
# cases live in the companion cases_* function as
# `list[std.test.TestCase[R]]`, the runner executes the table once per
# row, and every row is reported as its own test named
# `test_<name>#<case-name>`. main() mirrors the runner (loop over the
# table, call the test per row) so the differential suite exercises the
# same code on the interpreter and the native binary.
#
#   python3 tools/hltest.py tests/ok/feat_stage120_cases.hls
#   python3 tools/hltest.py --grep "#boundary" tests/ok/feat_stage120_cases.hls
# ============================================================================

import "std.test"

# --- struct rows: inputs + expected output travel together ------------------

struct AddCase {
    a: int,
    b: int,
    want: int
}

fn cases_add() -> list[TestCase[AddCase]] {
    return[
    TestCase {
        name: "positives", row: AddCase {
            a: 1, b: 2, want: 3
        }
    },
    TestCase {
        name: "zero-left", row: AddCase {
            a: 0, b: 5, want: 5
        }
    },
    TestCase {
        name: "negative", row: AddCase {
            a: -2, b: -3, want: -5
        }
    }
    ]
}

fn test_add(c: AddCase) {
    assert_eq_int_msg(c.a + c.b, c.want, "sum")
}

# --- str rows: the row payload can be a primitive ----------------------------

fn cases_greeting() -> list[TestCase[str]] {
    return[
    TestCase {
        name: "empty", row: ""
    },
    TestCase {
        name: "short", row: "hi"
    }
    ]
}

fn test_greeting(s: str) {
    let mut greeted: str = "hello " + s
    if s == "" {
        greeted = "hello"
    }
    assert_len_str(greeted, greeted.len())
}

# --- enum rows: payload-less enums are finite tables -------------------------

enum Shape {
    Triangle,
    Square
}

fn cases_sides() -> list[TestCase[Shape]] {
    return[
    TestCase {
        name: "triangle", row: Shape.Triangle
    },
    TestCase {
        name: "square", row: Shape.Square
    }
    ]
}

fn test_sides(s: Shape) {
    let want: int = match s {
        Shape.Triangle => 3,
        Shape.Square => 4
    }
    assert_eq_int(shape_sides(s), want)
}

fn shape_sides(s: Shape) -> int {
    return match s {
        Shape.Triangle => 3,
        Shape.Square => 4
    }
}

# --- a row can skip itself ----------------------------------------------------
#
# mark_skip inside one row reports THAT row as SKIP; the table's other
# rows still run and pass. Here the divisor row with base 1 is trivia
# we choose not to assert in this suite.

struct ModCase {
    base: int,
    v: int,
    want: int
}

fn cases_mod() -> list[TestCase[ModCase]] {
    return[
    TestCase {
        name: "ten", row: ModCase {
            base: 10, v: 42, want: 2
        }
    },
    TestCase {
        name: "trivial", row: ModCase {
            base: 1, v: 42, want: 0
        }
    },
    TestCase {
        name: "seven", row: ModCase {
            base: 7, v: 42, want: 0
        }
    }
    ]
}

fn test_mod(c: ModCase) {
    if c.base == 1 {
        mark_skip("x % 1 is a constant; nothing interesting to assert")
    }
    assert_eq_int_msg(c.v % c.base, c.want, "remainder")
}

# --- a row can snapshot: records key on test_x#case --------------------------
#
# The snapshot store (tests/ok/__snapshots__/feat_stage120_cases.snap)
# pins one record per row; the row-qualified test key is what Stage 120
# adds to the store grammar.

struct BoundCase {
    v: int,
    lo: int,
    hi: int
}

fn cases_bound() -> list[TestCase[BoundCase]] {
    return[
    TestCase {
        name: "inside", row: BoundCase {
            v: 5, lo: 0, hi: 10
        }
    },
    TestCase {
        name: "boundary", row: BoundCase {
            v: 10, lo: 0, hi: 10
        }
    }
    ]
}

fn test_bound(c: BoundCase) uses IO {
    assert_true_msg(c.v >= c.lo && c.v <= c.hi, "in range")
    let mut line: str = c.v.to_str() + " in [" + c.lo.to_str()
    line = line + ", " + c.hi.to_str() + "]"
    assert_snapshot("range-line", line)
}

# --- main (for differential testing) -----------------------------------------
# Mirrors the runner: for every table test, loop over the table and call
# the test once per row. If any assertion fails, the panic propagates
# and the program exits 101; the differential suite requires the
# interpreter and the native binary to agree on the output bytes.

fn main() -> int uses IO {
    let add_rows: list[TestCase[AddCase]] = cases_add()
    let mut i: int = 0
    while i < add_rows.len() {
        test_add(add_rows[i].row)
        i = i + 1
    }
    let greet_rows: list[TestCase[str]] = cases_greeting()
    i = 0
    while i < greet_rows.len() {
        test_greeting(greet_rows[i].row)
        i = i + 1
    }
    let side_rows: list[TestCase[Shape]] = cases_sides()
    i = 0
    while i < side_rows.len() {
        test_sides(side_rows[i].row)
        i = i + 1
    }
    let mod_rows: list[TestCase[ModCase]] = cases_mod()
    i = 0
    while i < mod_rows.len() {
        # The runner reports the "trivial" row as SKIP and moves on;
        # main mirrors that selection so the differential run exits 0.
        if mod_rows[i].row.base != 1 {
            test_mod(mod_rows[i].row)
        }
        i = i + 1
    }
    let bound_rows: list[TestCase[BoundCase]] = cases_bound()
    i = 0
    while i < bound_rows.len() {
        test_bound(bound_rows[i].row)
        i = i + 1
    }
    println("all stage-120 table tests pass")
    return 0
}
