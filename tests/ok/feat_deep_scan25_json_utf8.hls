# feat_deep_scan25_json_utf8.hls — deep-scan-25 regression: std.json's
# jsonp_push_utf8 emitted INVALID UTF-8 for every codepoint >= U+10000.
# The 4-byte branch subtracted 0x10000 from the codepoint and shifted
# the DIFFERENCE for every component — the subtract trick belongs to
# UTF-16 surrogate maths, not to the UTF-8 byte layout, so the bit-16
# position was wrong in every surrogate-pair decode (U+1D11E produced
# f0 8d 84 9e instead of f0 9d 84 9e). The fix mirrors the correct
# formula from std/json_stream.hls (bytes laid out directly on the
# codepoint). This test pins the exact bytes of the re-encoded output.
import "std.json"
fn expect_byte(s: str, idx: int, want: int, label: str) {
    if s.byte_at(idx) != want {
        panic(label + ": byte " + idx.to_str() + " = " + s.byte_at(idx).to_str()
        + ", want " + want.to_str())
    }
}
fn roundtrip(raw: str, b0: int, b1: int, b2: int, b3: int, label: str) {
    let v: JsonValue = json_parse(raw)
    let out: str = json_stringify(v)
    # The stringified form is quoted; the 4-byte sequence starts at index 1.
    expect_byte(out, 1, b0, label)
    expect_byte(out, 2, b1, label)
    expect_byte(out, 3, b2, label)
    expect_byte(out, 4, b3, label)
    # The stringified form is quote + 4 bytes + quote = 6 bytes.
    if out.len() != 6 {
        panic(label + ": encoded length " + out.len().to_str() + ", want 6")
    }
    expect_byte(out, 5, 34, label)
}
fn main() -> int uses IO {
    # U+1D11E (MUSICAL SYMBOL G CLEF) -> f0 9d 84 9e
    roundtrip("\"\\uD834\\uDD1E\"", 240, 157, 132, 158, "U+1D11E")
    # U+1F600 (GRINNING FACE)        -> f0 9f 98 80
    roundtrip("\"\\uD83D\\uDE00\"", 240, 159, 152, 128, "U+1F600")
    # U+10000 (smallest astral)      -> f0 90 80 80
    roundtrip("\"\\uD800\\uDC00\"", 240, 144, 128, 128, "U+10000")
    # U+10FFFF (largest codepoint)   -> f4 8f bf bf
    roundtrip("\"\\uDBFF\\uDFFF\"", 244, 143, 191, 191, "U+10FFFF")
    # Round-trip stability: parse -> stringify -> parse gives the same value.
    let v: JsonValue = json_parse("[\"\\uD83D\\uDE00\"]")
    let once: str = json_stringify(v)
    let twice: str = json_stringify(json_parse(once))
    if once != twice {
        panic("surrogate round-trip not stable")
    }
    println("json utf8 OK")
    return 0
}
