# ============================================================================
# feat_conc_try.hls — Stage-16 perfection (v0.29.0-alpha): the
# non-blocking channel pair.
#
#   ch.try_send(v) -> bool   — false iff a bounded channel is full
#   ch.recv_or(def) -> T     — the pending message, or `def` if empty
#
# Deterministic: no tasks race for these messages (the sender and the
# receiver are the same thread here, and the helper task only joins).
# ============================================================================

fn helper() -> int uses Conc {
    return 41
}

fn main() -> int uses Conc, IO {
    # try_send: capacity 2 -> the third offer is refused.
    let ch: Chan[int] = chan_new_bounded(2)
    let ok1: bool = ch.try_send(10)
    let ok2: bool = ch.try_send(20)
    let ok3: bool = ch.try_send(30)
    let n: int = ch.len()
    println("ok1=" + ok1.to_str() + " ok2=" + ok2.to_str()
            + " ok3=" + ok3.to_str() + " len=" + n.to_str())

    # recv_or: message when pending, default when empty.
    let a: int = ch.recv_or(-1)
    let b: int = ch.recv_or(-1)
    let c: int = ch.recv_or(-1)
    println("a=" + a.to_str() + " b=" + b.to_str() + " c=" + c.to_str())

    # try_send on an UNBOUNDED channel always succeeds (never blocks).
    let u: Chan[str] = chan_new()
    let s_ok: bool = u.try_send("hello")
    let s: str = u.recv_or("none")
    println("s_ok=" + s_ok.to_str() + " s=" + s)

    # recv_or with a non-literal (borrowed) default exercises the
    # own-wrap path; the default is returned owned.
    let dflt: str = "fallback"
    let w: str = u.recv_or(take(dflt))
    println("w=" + w)

    # The pair composes with spawn: a worker acknowledges via a bounded
    # channel of capacity 1 (request/reply shape).
    let t: Task[int] = spawn(helper)
    let r: int = t.join()
    println("helper=" + r.to_str())
    return 0
}
