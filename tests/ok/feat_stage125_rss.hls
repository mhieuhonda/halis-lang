# ============================================================================
# tests/ok/feat_stage125_rss.hls — Stage 125 acceptance: the RSS-stability
# workload convention is ordinary Halis
# ----------------------------------------------------------------------------
# This file is the Stage 125 ok corpus: a valid Halis program whose
# shape is exactly what an hls-rss workload holds — a steady-state
# loop that reads its cycle count from argv[1] (the verifier drives
# its plan through it; absent, the in-code default), performs a fixed
# churn of allocations per cycle, and prints one
# `__HLRSS_CYCLE__ <i>` marker after each cycle. The marker stream is
# the Stage 119/124 reserved-prefix discipline: the verifier parses
# it, everything else the program prints is ordinary output.
#
# The interpreter-vs-native differential law holds byte for byte: the
# marker sequence and the checksum are functions of the cycle count
# alone, and the cycle count defaults to 40 when argv is absent (the
# master suite runs this file with no arguments on both backends).
# Each cycle churns an inner batch of rounds (not one round) so one
# cycle is a native millisecond — the range the Stage 125 sampler
# resolves; a per-cycle microsecond body would outrun the instrument
# and honestly earn INCONCLUSIVE instead of a verdict.
# ============================================================================

fn churn_round(i: int) -> int {
    let mut checksum: int = 0
    # strings: build, clone, drop
    let s: str = "round-" + i.to_str() + "-payload-0123456789"
    checksum = checksum + s.len()
    let c: str = clone(s)
    checksum = checksum + c.byte_at(2)
    drop(c)
    # a list that grows and shrinks within the round
    let xs: list[int] = [i, i + 1, i + 2, i + 3]
    xs.push(i * 3)
    checksum = checksum + xs.pop() + xs.get(2)
    # a map that fills and empties within the round
    let m: map[str, int] = map_new()
    m.set("alpha", i)
    m.set("beta", i * 2)
    checksum = checksum + m.get_or("beta", 0)
    return checksum
}

fn churn_once(i: int) -> int {
    let mut checksum: int = 0
    let mut j: int = 0
    while j < 200 {
        checksum = checksum + churn_round(i * 200 + j)
        j = j + 1
    }
    return checksum
}

fn main() -> int uses IO {
    let mut cycles: int = 40
    let a: list[str] = args()
    if a.len() > 1 {
        cycles = a.get(1).to_int()
    }
    let mut checksum: int = 0
    let mut i: int = 0
    while i < cycles {
        checksum = checksum + churn_once(i)
        println("__HLRSS_CYCLE__ " + i.to_str())
        i = i + 1
    }
    println("checksum=" + checksum.to_str())
    return 0
}
