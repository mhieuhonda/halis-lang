# feat_stage104_sbom.hls — Stage 104 (v0.123.0-alpha): hls-sbom, the
# CycloneDX + SPDX bill of materials.
#
# The SBOM tool is analysis-only: it reads a tree, it compiles
# nothing. What the differential suite pins HERE is the program the
# documents describe — the same tree `hls-sbom` lists:
#
#   python3 tools/hls-sbom.py tests/ok/feat_stage104_sbom.hls
#
#   root: tests/ok/feat_stage104_sbom.hls
#   4 modules in the tree; 2 toolchain, 2 workspace; 3 edges
#   serialNumber = content digest of the component set
#
# The program itself: a tiny "component ledger" that mimics what the
# documents compute — the census (root + parts), the edge count of a
# tree, the UUID-shaped serial derived from two "hashes", the purl
# for a component, and the version stamp. Deterministic output;
# interpreter and native agree byte for byte.

import "std.str"
import "std.option"

# A tree with N nodes has N-1 edges — the documents' relationship
# count for an acyclic single-root tree.
fn edges_of(nodes: int) -> int {
    if nodes < 1 {
        panic("edges_of: a tree has at least one node")
    }
    return nodes - 1
}

# The union census: |A ∪ B| = |A| + |B| - |A ∩ B| — the census line
# for two overlapping component sets (root counted once).
fn census(a: int, b: int, shared: int) -> int {
    return a + b - shared
}

# One hex nibble of the "digest" the serial is shaped from: a digit
# or a letter a..f, exactly what the UUID characters range over.
fn nibble_char(v: int) -> str {
    if v < 10 {
        return v.to_str()
    }
    return chr(87 + v)
}

fn label(kind: str, name: str, depth: int) -> str {
    let mut s: str = kind + " " + name + " (depth "
    s = s + depth.to_str()
    s = s + ")"
    return s
}

fn main() -> int uses IO {
    let mut checks: int = 0

    # The demo tree: root + dep_a + dep_b + std.str = 4 nodes, 3
    # edges — exactly what `dependencies` renders.
    if edges_of(4) != 3 || edges_of(1) != 0 {
        panic("edge arithmetic wrong")
    }
    checks = checks + 1

    # Census: the entry tree (root, dep_a, dep_b) plus the toolchain
    # module it shares with dep_b — one std.str, counted once.
    let total: int = census(3, 3, 1)
    if total != 5 {
        panic("census must double-count the shared toolchain module, "
        + "got " + total.to_str())
    }
    let unique: int = census(total, 0, 1)
    if unique != 4 {
        panic("unique components must be 4, got " + unique.to_str())
    }
    checks = checks + 1

    # The serial: digest hex shaped into 8-4-4-4-12. The version and
    # variant nibbles are forced; the rest is the content itself.
    if nibble_char(0) != "0" || nibble_char(9) != "9" {
        panic("digit nibbles wrong")
    }
    if nibble_char(10) != "a" || nibble_char(15) != "f" {
        panic("letter nibbles wrong")
    }
    checks = checks + 1

    # A purl names a component the way the ecosystem agrees on:
    # pkg:generic/halis/<name>@<version>.
    let mut purl: str = "pkg:generic/halis/" + "audit_lib_a" + "@"
    purl = purl + "0.1.0"
    if !str_contains(purl, "@0.1.0") || !str_contains(purl, "halis/") {
        panic("purl must carry the name and the version")
    }
    checks = checks + 1

    # Labels — the properties' lines, in miniature.
    println(label("library", "dep_b", 2))
    println(label("toolchain", "std/str.hls", 1))
    println(label("application", "sbom_demo.hls", 0))
    checks = checks + 1

    # Option shapes the release gate: a release with no lockfile is
    # None — refused; the lock present is Some.
    let lock: Option[int] = Option.Some(3)
    if option_is_none(lock) {
        panic("the lockfile is present — the release may ship")
    }
    println("release: lockfile pinned, " + "3 component(s) listed")
    checks = checks + 1

    # std.str rides along (toolchain, pure): the version stamp must
    # keep its separators.
    let ver: str = "0.123.0-alpha"
    if !str_contains(ver, "alpha") {
        panic("the toolchain stamp must carry its pre-release tag")
    }
    println("checks passed: " + checks.to_str())
    return 0
}
