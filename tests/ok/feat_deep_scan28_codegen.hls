# feat_deep_scan28_codegen.hls — deep-scan-28: native codegen fixes,
# verified byte-identical against the boot interpreter:
#   1. float literals keep full precision (the old codegen rendered the
#      literal through the 6-decimal DISPLAY formatter, so 1.5e-10
#      became 0.0 in the emitted C);
#   2. distinct locals can never share one C name (2nd decl of `x` used
#      to alias a distinct local `x_2` as u_x_2);
#   3. an enum variant named a C keyword (default) emits compilable C;
#   4. a struct named a C keyword (register) emits compilable C;
#   5. float.abs() evaluates its receiver exactly once and matches the
#      IEEE abs semantics (sign of -0.0 cleared) in both engines.
fn side(v: float) -> float uses IO {
    println("eval")
    return v
}

enum Op { add(int), default(int) }

fn pick(o: Op) -> int {
    return match o {
        Op.add(v) => v,
        Op.default(v) => v * 2
    }
}

struct register { v: int }

fn main() -> int uses IO {
    # 1. float literal precision (1.5e-10 must NOT collapse to zero).
    let b: float = 1.5e-10
    if b == 0.0 {
        println("bad: b became zero")
    } else {
        println("b nonzero")
    }
    let c: float = 0.123456789012345
    println(c.to_str())

    # 2. fresh-local collision: x_2 and the 2nd decl of x are distinct.
    let mut x_2: int = 1
    let cond: bool = true
    if cond {
        let mut x: int = 2
        x = x + 1
        println(x.to_str())
    }
    if cond {
        let mut x: int = 3
        println((x + x_2).to_str())
    }

    # 3. enum variant named `default`.
    let o: Op = Op.default(7)
    println(pick(o).to_str())

    # 4. struct named `register`.
    let r: register = register { v: 5 }
    println(r.v.to_str())

    # 5. float.abs: receiver evaluated once + IEEE abs of -0.0.
    let r2: float = side(2.5).abs()
    println(r2.to_str())
    let z: float = -0.0
    println(z.abs().to_str())
    return 0
}
