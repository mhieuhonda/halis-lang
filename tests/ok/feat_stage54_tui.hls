# tests/ok/feat_stage54_tui.hls — Stage 54 (v0.73.0-alpha): std.tui.
#
# Exercises every public API of std.tui:
#   - Color codes (16-colour palette + bright variants + default + reset)
#   - tui_color_bg() (foreground -> background conversion)
#   - Style builder (fg / bg / bold / dim / italic / underline /
#     blink_slow / reverse / hidden / strikethrough)
#   - style_eq (structural equality)
#   - style_to_sgr (escape sequence generation)
#   - Cursor escapes (move_to / up / down / left / right / hide / show /
#     save / restore)
#   - Clear escapes (screen / line / to_end_of_line / from_bol)
#   - Screen mode escapes (enter / leave / wrap_enable / wrap_disable)
#   - Rect (new / area / contains / eq)
#   - Cell (new with valid/empty/multi-byte input; empty; eq)
#   - Buffer (new / get/set cell / set_str / set_str_clipped /
#     fill_rect / clear / render_into)
#   - Text widget (render + height + width)
#   - Block widget (render + height + width; clipping on small area)
#   - Paragraph widget (layout + render + clipping)
#   - Layout helpers (split_horizontal / split_vertical)
#   - Term (raw + restore + screen + clear + flush)
#
# All checks use string equality (the renderer's output is deterministic
# across interpreter and native — pure string operations on chr(27)
# escape sequences). The differential test (interpreter == native) is
# verified via the Makefile's tui-acceptance target.

import "std.tui"
import "std.str"

# ============================================================================
# Helpers
# ============================================================================

fn ok(actual: bool, msg: str) -> void uses IO {
    if !actual {
        panic("FAIL " + msg)
    }
}

fn eq_int(actual: int, expected: int, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_str(actual: str, expected: str, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected '" + expected + "' (" + expected.len().to_str() + " bytes), got '" + actual + "' (" + actual.len().to_str() + " bytes)")
    }
}

fn eq_bool(actual: bool, expected: bool, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

# ============================================================================
# Color codes — verify every constant matches its ANSI SGR value.
# ============================================================================

fn test_color_codes() -> int uses IO {
    eq_int(tui_color_reset(),    0,  "color_reset == 0")
    eq_int(tui_color_black(),    30, "color_black == 30")
    eq_int(tui_color_red(),      31, "color_red == 31")
    eq_int(tui_color_green(),    32, "color_green == 32")
    eq_int(tui_color_yellow(),   33, "color_yellow == 33")
    eq_int(tui_color_blue(),     34, "color_blue == 34")
    eq_int(tui_color_magenta(),  35, "color_magenta == 35")
    eq_int(tui_color_cyan(),     36, "color_cyan == 36")
    eq_int(tui_color_white(),    37, "color_white == 37")
    eq_int(tui_color_default(),  39, "color_default == 39")
    eq_int(tui_color_bright_black(),   90, "color_bright_black == 90")
    eq_int(tui_color_bright_red(),     91, "color_bright_red == 91")
    eq_int(tui_color_bright_green(),   92, "color_bright_green == 92")
    eq_int(tui_color_bright_yellow(),  93, "color_bright_yellow == 93")
    eq_int(tui_color_bright_blue(),    94, "color_bright_blue == 94")
    eq_int(tui_color_bright_magenta(), 95, "color_bright_magenta == 95")
    eq_int(tui_color_bright_cyan(),    96, "color_bright_cyan == 96")
    eq_int(tui_color_bright_white(),   97, "color_bright_white == 97")
    return 0
}

# ============================================================================
# tui_color_bg — foreground -> background conversion.
# ============================================================================

fn test_color_bg_conversion() -> int uses IO {
    eq_int(tui_color_bg(tui_color_black()),    40, "bg(black) == 40")
    eq_int(tui_color_bg(tui_color_red()),      41, "bg(red) == 41")
    eq_int(tui_color_bg(tui_color_green()),    42, "bg(green) == 42")
    eq_int(tui_color_bg(tui_color_white()),    47, "bg(white) == 47")
    eq_int(tui_color_bg(tui_color_default()),  49, "bg(default) == 49")
    eq_int(tui_color_bg(tui_color_bright_black()),   100, "bg(bright_black) == 100")
    eq_int(tui_color_bg(tui_color_bright_white()),   107, "bg(bright_white) == 107")
    # Pass-through: 0 (reset-all) stays 0.
    eq_int(tui_color_bg(0), 0, "bg(0) == 0 (passthrough)")
    return 0
}

# ============================================================================
# Style builder + equality + SGR escape generation.
# ============================================================================

fn test_style_builder() -> int uses IO {
    # Empty style — no SGR escape.
    let s: Style = style_new()
    eq_str(style_to_sgr(s), "", "empty style -> empty SGR")
    ok(style_eq(s, style_new()), "style_eq: empty == empty")

    # fg only.
    let s1: Style = style_fg(s, tui_color_red())
    eq_str(style_to_sgr(s1), chr(27) + "[31m", "fg(red) -> \\x1b[31m")
    ok(!style_eq(s, s1), "style_eq: empty != fg(red)")

    # fg + bg.
    let s2: Style = style_bg(s1, tui_color_bg(tui_color_blue()))
    eq_str(style_to_sgr(s2), chr(27) + "[31;44m", "fg(red)+bg(blue) -> \\x1b[31;44m")

    # fg + bg + bold.
    let s3: Style = style_bold(s2)
    eq_str(style_to_sgr(s3), chr(27) + "[31;44;1m", "fg(red)+bg(blue)+bold -> \\x1b[31;44;1m")

    # fg + bold + underline (no bg).
    let s4: Style = style_underline(style_bold(style_fg(style_new(), tui_color_green())))
    eq_str(style_to_sgr(s4), chr(27) + "[32;1;4m", "fg(green)+bold+underline -> \\x1b[32;1;4m")

    # Reverse only.
    let s5: Style = style_reverse(style_new())
    eq_str(style_to_sgr(s5), chr(27) + "[7m", "reverse -> \\x1b[7m")

    # All attributes.
    let s6: Style = style_strikethrough(
                        style_hidden(
                            style_reverse(
                                style_blink_slow(
                                    style_underline(
                                        style_italic(
                                            style_dim(
                                                style_bold(
                                                    style_fg(style_new(), tui_color_cyan())))))))))
    eq_str(style_to_sgr(s6), chr(27) + "[36;1;2;3;4;5;7;8;9m",
           "all attrs -> \\x1b[36;1;2;3;4;5;7;8;9m")
    return 0
}

# ============================================================================
# Cursor escape sequences.
# ============================================================================

fn test_cursor_escapes() -> int uses IO {
    # move_to(0, 0) -> ESC [ 1 ; 1 H (1-indexed).
    eq_str(cursor_move_to(0, 0), chr(27) + "[1;1H", "move_to(0,0) -> ESC[1;1H")
    eq_str(cursor_move_to(5, 10), chr(27) + "[11;6H", "move_to(5,10) -> ESC[11;6H (y+1, x+1)")

    # move_up / down / left / right.
    eq_str(cursor_move_up(3), chr(27) + "[3A", "move_up(3) -> ESC[3A")
    eq_str(cursor_move_down(7), chr(27) + "[7B", "move_down(7) -> ESC[7B")
    eq_str(cursor_move_right(2), chr(27) + "[2C", "move_right(2) -> ESC[2C")
    eq_str(cursor_move_left(9), chr(27) + "[9D", "move_left(9) -> ESC[9D")

    # Zero / negative — no-op.
    eq_str(cursor_move_up(0), "", "move_up(0) is no-op")
    eq_str(cursor_move_down(-1), "", "move_down(-1) is no-op")

    # hide / show.
    eq_str(cursor_hide(), chr(27) + "[?25l", "hide -> ESC[?25l")
    eq_str(cursor_show(), chr(27) + "[?25h", "show -> ESC[?25h")

    # save / restore.
    eq_str(cursor_save(), chr(27) + "7", "save -> ESC 7")
    eq_str(cursor_restore(), chr(27) + "8", "restore -> ESC 8")

    # Negative x or y panics.
    let neg_x_panicked: bool = false
    let neg_y_panicked: bool = false
    # cursor_move_to(-1, 0) should panic — we can't easily test panics
    # in HLS, so we just verify the function signature is correct (the
    # panic is exercised by the negative-input test in the demo).
    return 0
}

# ============================================================================
# Clear escapes.
# ============================================================================

fn test_clear_escapes() -> int uses IO {
    eq_str(clear_screen(), chr(27) + "[2J", "clear_screen -> ESC[2J")
    eq_str(clear_line(), chr(27) + "[2K", "clear_line -> ESC[2K")
    eq_str(clear_to_end_of_line(), chr(27) + "[0K", "clear_to_end_of_line -> ESC[0K")
    eq_str(clear_from_beginning_of_line(), chr(27) + "[1K", "clear_from_bol -> ESC[1K")
    return 0
}

# ============================================================================
# Screen mode escapes.
# ============================================================================

fn test_screen_modes() -> int uses IO {
    eq_str(screen_enter(), chr(27) + "[?1049h", "screen_enter -> ESC[?1049h")
    eq_str(screen_leave(), chr(27) + "[?1049l", "screen_leave -> ESC[?1049l")
    eq_str(wrap_disable(), chr(27) + "[?7l", "wrap_disable -> ESC[?7l")
    eq_str(wrap_enable(), chr(27) + "[?7h", "wrap_enable -> ESC[?7h")
    return 0
}

# ============================================================================
# Rect.
# ============================================================================

fn test_rect() -> int uses IO {
    let r: Rect = rect_new(2, 3, 10, 5)
    eq_int(r.x, 2, "rect.x")
    eq_int(r.y, 3, "rect.y")
    eq_int(r.width, 10, "rect.width")
    eq_int(r.height, 5, "rect.height")
    eq_int(rect_area(r), 50, "rect_area = 10*5 = 50")

    # contains — top-left is inside, bottom-right (exclusive) is not.
    ok(rect_contains(r, 2, 3), "contains: top-left inside")
    ok(rect_contains(r, 11, 7), "contains: (x+w-1, y+h-1) inside")
    ok(!rect_contains(r, 12, 7), "contains: (x+w, y+h) outside")
    ok(!rect_contains(r, 1, 3), "contains: x-1 outside")
    ok(!rect_contains(r, 2, 2), "contains: y-1 outside")

    # Equality.
    ok(rect_eq(r, rect_new(2, 3, 10, 5)), "rect_eq: same")
    ok(!rect_eq(r, rect_new(2, 3, 10, 6)), "rect_eq: different height")
    return 0
}

# ============================================================================
# Cell.
# ============================================================================

fn test_cell() -> int uses IO {
    # 1-byte char.
    let c1: Cell = cell_new("A", style_new())
    eq_str(c1.ch, "A", "cell_new(1-byte).ch")
    ok(style_eq(c1.style, style_new()), "cell_new(1-byte).style is empty")

    # Empty string -> space.
    let c2: Cell = cell_new("", style_new())
    eq_str(c2.ch, " ", "cell_new(empty).ch is space")

    # Multi-byte string -> first byte.
    let c3: Cell = cell_new("XYZ", style_new())
    eq_str(c3.ch, "X", "cell_new(multi-byte).ch is first byte")

    # cell_empty.
    let e: Cell = cell_empty()
    eq_str(e.ch, " ", "cell_empty().ch is space")
    ok(style_eq(e.style, style_new()), "cell_empty().style is empty")

    # Equality.
    ok(cell_eq(c1, cell_new("A", style_new())), "cell_eq: same")
    ok(!cell_eq(c1, c2), "cell_eq: different ch")
    ok(!cell_eq(c1, cell_new("A", style_fg(style_new(), tui_color_red()))),
       "cell_eq: different style")
    return 0
}

# ============================================================================
# Buffer — basic operations.
# ============================================================================

fn test_buffer_basics() -> int uses IO {
    let b: Buffer = buffer_new(5, 3)
    eq_int(buffer_width(b), 5, "buffer_width")
    eq_int(buffer_height(b), 3, "buffer_height")

    # Default cell is empty.
    let c0: Cell = buffer_get_cell(b, 0, 0)
    eq_str(c0.ch, " ", "buffer default cell is space")

    # Set a cell.
    let red: Style = style_fg(style_new(), tui_color_red())
    buffer_set_cell(b, 2, 1, cell_new("X", red))
    let c1: Cell = buffer_get_cell(b, 2, 1)
    eq_str(c1.ch, "X", "buffer_set_cell: ch set")
    ok(style_eq(c1.style, red), "buffer_set_cell: style set")

    # set_str — writes one cell per char.
    let blue: Style = style_fg(style_new(), tui_color_blue())
    buffer_set_str(b, 0, 0, "abc", blue)
    eq_str(buffer_get_cell(b, 0, 0).ch, "a", "set_str[0]")
    eq_str(buffer_get_cell(b, 1, 0).ch, "b", "set_str[1]")
    eq_str(buffer_get_cell(b, 2, 0).ch, "c", "set_str[2]")
    # Cell past the end of the string is unchanged (still empty).
    eq_str(buffer_get_cell(b, 3, 0).ch, " ", "set_str: cell past end unchanged")

    # set_str past the right edge — clipped (does not write past width).
    buffer_set_str(b, 3, 0, "WXYZ", style_new())
    eq_str(buffer_get_cell(b, 3, 0).ch, "W", "set_str clipped: W at x=3")
    eq_str(buffer_get_cell(b, 4, 0).ch, "X", "set_str clipped: X at x=4")
    # No cells were written past width — get_cell(5,0) would panic, so
    # we just verify cells at x=0..4 are correct.

    # set_str_clipped — explicit max_width.
    let b2: Buffer = buffer_new(10, 1)
    buffer_set_str_clipped(b2, 0, 0, "abcdefghij", style_new(), 5)
    eq_str(buffer_get_cell(b2, 0, 0).ch, "a", "clipped[0]")
    eq_str(buffer_get_cell(b2, 4, 0).ch, "e", "clipped[4]")
    eq_str(buffer_get_cell(b2, 5, 0).ch, " ", "clipped[5] is empty (clipped)")

    # fill_rect.
    let b3: Buffer = buffer_new(4, 4)
    buffer_fill_rect(b3, rect_new(1, 1, 2, 2), cell_new("#", style_new()))
    eq_str(buffer_get_cell(b3, 1, 1).ch, "#", "fill_rect: (1,1)")
    eq_str(buffer_get_cell(b3, 2, 2).ch, "#", "fill_rect: (2,2)")
    eq_str(buffer_get_cell(b3, 0, 0).ch, " ", "fill_rect: (0,0) untouched")
    eq_str(buffer_get_cell(b3, 3, 3).ch, " ", "fill_rect: (3,3) untouched")

    # clear.
    buffer_clear(b3)
    eq_str(buffer_get_cell(b3, 1, 1).ch, " ", "after clear: (1,1) is space")
    eq_str(buffer_get_cell(b3, 2, 2).ch, " ", "after clear: (2,2) is space")
    return 0
}

# ============================================================================
# Buffer — render_into produces a valid frame.
# ============================================================================

fn test_buffer_render() -> int uses IO {
    let b: Buffer = buffer_new(3, 2)
    # Row 0: "ABC" (red).
    let red: Style = style_fg(style_new(), tui_color_red())
    buffer_set_str(b, 0, 0, "ABC", red)
    # Row 1: "XYZ" (no style).
    buffer_set_str(b, 0, 1, "XYZ", style_new())

    let out: str = buffer_render_into(b)
    # Expected: cursor_move_to(0,0) + SGR + A + reset + SGR + B + reset + SGR + C + reset +
    #            cursor_move_to(0,1) + X + Y + Z
    let expected: str = cursor_move_to(0, 0) +
                        style_to_sgr(red) + "A" + tui_reset_sgr() +
                        style_to_sgr(red) + "B" + tui_reset_sgr() +
                        style_to_sgr(red) + "C" + tui_reset_sgr() +
                        cursor_move_to(0, 1) +
                        "X" + "Y" + "Z"
    eq_str(out, expected, "buffer_render_into produces expected frame")
    return 0
}

# ============================================================================
# Text widget.
# ============================================================================

fn test_text_widget() -> int uses IO {
    let green: Style = style_fg(style_new(), tui_color_green())
    let t: Text = text_new("Hello", green)
    eq_int(widget_height_Text(t), 1, "text height = 1")
    eq_int(widget_width_Text(t), 5, "text width = len(content) = 5")

    # Render into a buffer of size 10x1.
    let b: Buffer = buffer_new(10, 1)
    widget_render_Text(b, rect_new(0, 0, 10, 1), t)
    eq_str(buffer_get_cell(b, 0, 0).ch, "H", "text render: H")
    eq_str(buffer_get_cell(b, 4, 0).ch, "o", "text render: o")
    eq_str(buffer_get_cell(b, 5, 0).ch, " ", "text render: past end is empty")

    # Render into a too-small area — clipped.
    let b2: Buffer = buffer_new(10, 1)
    widget_render_Text(b2, rect_new(0, 0, 3, 1), t)
    eq_str(buffer_get_cell(b2, 0, 0).ch, "H", "text clipped: H")
    eq_str(buffer_get_cell(b2, 2, 0).ch, "l", "text clipped: l")
    eq_str(buffer_get_cell(b2, 3, 0).ch, " ", "text clipped: (3,0) empty (not written)")

    # Empty area — no-op.
    let b3: Buffer = buffer_new(10, 1)
    widget_render_Text(b3, rect_new(0, 0, 0, 1), t)
    eq_str(buffer_get_cell(b3, 0, 0).ch, " ", "text empty area: no-op")
    return 0
}

# ============================================================================
# Block widget.
# ============================================================================

fn test_block_widget() -> int uses IO {
    let yellow: Style = style_fg(style_new(), tui_color_yellow())
    let blk: Block = block_new("Title", yellow)

    # Render into a 10x3 buffer.
    let b: Buffer = buffer_new(10, 3)
    widget_render_Block(b, rect_new(0, 0, 10, 3), blk)
    # Corners.
    eq_str(buffer_get_cell(b, 0, 0).ch, "+", "block: top-left corner")
    eq_str(buffer_get_cell(b, 9, 0).ch, "+", "block: top-right corner")
    eq_str(buffer_get_cell(b, 0, 2).ch, "+", "block: bottom-left corner")
    eq_str(buffer_get_cell(b, 9, 2).ch, "+", "block: bottom-right corner")
    # Edges.
    eq_str(buffer_get_cell(b, 1, 0).ch, "-", "block: top edge")
    eq_str(buffer_get_cell(b, 0, 1).ch, "|", "block: left edge")
    eq_str(buffer_get_cell(b, 9, 1).ch, "|", "block: right edge")
    eq_str(buffer_get_cell(b, 5, 2).ch, "-", "block: bottom edge")
    # Title at (2, 0).
    eq_str(buffer_get_cell(b, 2, 0).ch, "T", "block: title T")
    eq_str(buffer_get_cell(b, 6, 0).ch, "e", "block: title e")
    # Interior — not touched by the block.
    eq_str(buffer_get_cell(b, 5, 1).ch, " ", "block: interior untouched")

    # Too small — no-op.
    let b2: Buffer = buffer_new(2, 2)
    widget_render_Block(b2, rect_new(0, 0, 1, 1), blk)
    eq_str(buffer_get_cell(b2, 0, 0).ch, " ", "block too small: no-op")

    # No title.
    let blk2: Block = block_new("", style_new())
    let b3: Buffer = buffer_new(5, 3)
    widget_render_Block(b3, rect_new(0, 0, 5, 3), blk2)
    eq_str(buffer_get_cell(b3, 2, 0).ch, "-", "block no title: (2,0) is '-' not title char")
    return 0
}

# ============================================================================
# Paragraph widget — word wrap + clipping.
# ============================================================================

fn test_paragraph_widget() -> int uses IO {
    let p: Paragraph = paragraph_new("the quick brown fox", style_new())

    # At width 10: "the quick" (9 chars) + "brown fox" (9 chars).
    let lines10: list[str] = paragraph_layout_lines(p, 10)
    eq_int(lines10.len(), 2, "paragraph width=10: 2 lines")
    eq_str(lines10.get(0), "the quick", "paragraph line 0")
    eq_str(lines10.get(1), "brown fox", "paragraph line 1")

    # At width 5: "the" + "quick" + "brown" + "fox".
    let lines5: list[str] = paragraph_layout_lines(p, 5)
    eq_int(lines5.len(), 4, "paragraph width=5: 4 lines")
    eq_str(lines5.get(0), "the", "paragraph w5 line 0")
    eq_str(lines5.get(1), "quick", "paragraph w5 line 1")
    eq_str(lines5.get(2), "brown", "paragraph w5 line 2")
    eq_str(lines5.get(3), "fox", "paragraph w5 line 3")

    # Render into a 10x2 buffer.
    let b: Buffer = buffer_new(10, 2)
    widget_render_Paragraph(b, rect_new(0, 0, 10, 2), p)
    eq_str(buffer_get_cell(b, 0, 0).ch, "t", "paragraph render: row0[0]='t'")
    eq_str(buffer_get_cell(b, 8, 0).ch, "k", "paragraph render: row0[8]='k' (last char of 'the quick')")
    eq_str(buffer_get_cell(b, 9, 0).ch, " ", "paragraph render: row0[9]=' ' (no overflow)")
    eq_str(buffer_get_cell(b, 0, 1).ch, "b", "paragraph render: row1[0]='b'")

    # Render into a 10x1 buffer — second line is clipped.
    let b2: Buffer = buffer_new(10, 1)
    widget_render_Paragraph(b2, rect_new(0, 0, 10, 1), p)
    eq_str(buffer_get_cell(b2, 0, 0).ch, "t", "paragraph clipped: row0[0]='t'")
    eq_str(buffer_get_cell(b2, 8, 0).ch, "k", "paragraph clipped: row0[8]='k'")

    # Long word that exceeds the width — placed on its own line, clipped.
    let p2: Paragraph = paragraph_new("supercalifragilistic", style_new())
    let lines: list[str] = paragraph_layout_lines(p2, 5)
    eq_int(lines.len(), 1, "paragraph long-word: 1 line (no split)")
    eq_str(lines.get(0), "supercalifragilistic", "paragraph long-word: line is the word itself")
    return 0
}

# ============================================================================
# Layout helpers.
# ============================================================================

fn test_layout() -> int uses IO {
    let area: Rect = rect_new(0, 0, 10, 6)

    # split_horizontal [1, 1, 1] -> three 2-tall rows.
    let h: list[Rect] = layout_split_horizontal(area, [1, 1, 1])
    eq_int(h.len(), 3, "split_horizontal: 3 rects")
    eq_int(h.get(0).y, 0, "split_h[0].y = 0")
    eq_int(h.get(0).height, 2, "split_h[0].height = 2")
    eq_int(h.get(1).y, 2, "split_h[1].y = 2")
    eq_int(h.get(1).height, 2, "split_h[1].height = 2")
    eq_int(h.get(2).y, 4, "split_h[2].y = 4")
    eq_int(h.get(2).height, 2, "split_h[2].height = 2")
    # Width preserved.
    eq_int(h.get(0).width, 10, "split_h[0].width = 10")

    # split_horizontal [2, 1] -> 4 + 2.
    let h2: list[Rect] = layout_split_horizontal(area, [2, 1])
    eq_int(h2.get(0).height, 4, "split_h[2,1][0].height = 4")
    eq_int(h2.get(1).height, 2, "split_h[2,1][1].height = 2")

    # split_vertical [1, 1, 1] -> three 10/3 ≈ 3-wide columns.
    let v: list[Rect] = layout_split_vertical(area, [1, 1, 1])
    eq_int(v.len(), 3, "split_vertical: 3 rects")
    eq_int(v.get(0).x, 0, "split_v[0].x = 0")
    eq_int(v.get(0).width, 3, "split_v[0].width = 3")
    eq_int(v.get(1).x, 3, "split_v[1].x = 3")
    eq_int(v.get(1).width, 3, "split_v[1].width = 3")
    eq_int(v.get(2).x, 6, "split_v[2].x = 6")
    eq_int(v.get(2).width, 3, "split_v[2].width = 3 (10-6-3=1 leftover; floor division)")

    # Empty constraints.
    let empty_h: list[Rect] = layout_split_horizontal(area, [])
    eq_int(empty_h.len(), 0, "split_horizontal([]) -> 0 rects")
    return 0
}

# ============================================================================
# Term — verify the mode transitions emit the right escape sequences.
# ============================================================================

fn test_term_modes() -> int uses IO {
    let t0: Term = term_new()
    ok(!t0.raw_on, "term_new: not raw")
    ok(!t0.screen_on, "term_new: not alt screen")
    ok(t0.wrap_on, "term_new: wrap on (default)")

    # term_raw — emits cursor_hide + wrap_disable + cursor_app_keys.
    # We can't capture stdout from the test, so this is a smoke test.
    let t1: Term = term_raw(t0)
    ok(t1.raw_on, "term_raw: raw_on=true")
    ok(!t1.wrap_on, "term_raw: wrap_on=false")

    # term_screen — emits screen_enter. Idempotent.
    let t2: Term = term_screen(t1)
    ok(t2.screen_on, "term_screen: screen_on=true")
    ok(t2.raw_on, "term_screen: raw_on preserved")
    let t3: Term = term_screen(t2)
    ok(t3.screen_on, "term_screen idempotent: screen_on still true")

    # term_clear — emits clear_screen + cursor_move_to(0,0).
    term_clear(t3)

    # term_restore — emits inverse sequences.
    let t4: Term = term_restore(t3)
    ok(!t4.raw_on, "term_restore: raw_on=false")
    ok(!t4.screen_on, "term_restore: screen_on=false")
    ok(t4.wrap_on, "term_restore: wrap_on=true (default)")

    # term_flush — no-op in v0.73.
    term_flush(t4)
    return 0
}

# ============================================================================
# Integration — render a small TUI screen with multiple widgets.
# ============================================================================

fn test_integration_screen() -> int uses IO {
    # 30x10 buffer.
    let b: Buffer = buffer_new(30, 10)

    # Block border around the whole area.
    let border: Style = style_fg(style_new(), tui_color_cyan())
    let blk: Block = block_new(" Halis TUI ", border)
    widget_render_Block(b, rect_new(0, 0, 30, 10), blk)

    # Text "Hello, World!" centered on row 4 (column 8).
    let text_style: Style = style_bold(style_fg(style_new(), tui_color_green()))
    let t: Text = text_new("Hello, World!", text_style)
    widget_render_Text(b, rect_new(8, 4, 14, 1), t)

    # Paragraph at row 6.
    let p_style: Style = style_fg(style_new(), tui_color_yellow())
    let p: Paragraph = paragraph_new("A small demo of std.tui — Stage 54", p_style)
    widget_render_Paragraph(b, rect_new(2, 6, 26, 3), p)

    # Verify the border is intact.
    eq_str(buffer_get_cell(b, 0, 0).ch, "+", "integration: top-left corner")
    eq_str(buffer_get_cell(b, 29, 9).ch, "+", "integration: bottom-right corner")
    eq_str(buffer_get_cell(b, 2, 0).ch, " ", "integration: title space at (2,0) (title starts at (3,0))")

    # Verify the text.
    eq_str(buffer_get_cell(b, 8, 4).ch, "H", "integration: text H at (8,4)")
    eq_str(buffer_get_cell(b, 20, 4).ch, "!", "integration: text ! at (20,4)")
    # Text styling is preserved.
    ok(style_eq(buffer_get_cell(b, 8, 4).style, text_style), "integration: text style preserved")

    # Verify the paragraph.
    eq_str(buffer_get_cell(b, 2, 6).ch, "A", "integration: paragraph A at (2,6)")

    # Render the frame and verify the output starts with the expected
    # escape sequence (cursor_move_to(0,0) = ESC[1;1H — 6 bytes total).
    let frame: str = buffer_render_into(b)
    ok(frame.len() > 100, "integration: frame is non-trivial")
    eq_str(frame.slice(0, 5), chr(27) + "[1;1", "integration: frame starts with ESC[1;1")
    return 0
}

