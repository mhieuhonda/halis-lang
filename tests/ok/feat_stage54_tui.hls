    test_text_widget()
    println("  ok")
    println("--- Block widget (border + title + clipping) ---")
    test_block_widget()
    println("  ok")
    println("--- Paragraph widget (word wrap + clipping) ---")
    test_paragraph_widget()
    println("  ok")
    println("--- Layout helpers (split_horizontal / split_vertical) ---")
    test_layout()
    println("  ok")
    println("--- Term (raw / restore / screen / clear / flush) ---")
