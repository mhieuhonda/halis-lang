# feat_conc_actor.hls — Stage 16 (v0.27.0-alpha): the actor pattern.
# An actor is a task that owns its state and communicates ONLY through
# message channels. No state is ever shared — the channel is the sole
# interface. Dispatch is enum-typed; match arms are pure expressions
# (HLS has no block expressions), so state updates happen after the
# pure extraction — explicit and auditable, in the language's spirit.

enum Cmd {
    Add(int),
    Get,
    Stop
}

fn counter_actor(mail: Chan[Cmd], rep: Chan[int]) -> int uses Conc {
    let mut count: int = 0
    let mut running: bool = true
    while running {
        let msg: Cmd = mail.recv()
        # Pure extraction: the payload to add (0 for non-Add messages).
        let delta: int = match msg {
            Cmd.Add(n) => n,
            Cmd.Get => 0,
            Cmd.Stop => 0
        }
        # Pure extraction: the action code (1=Add, 2=Get, 3=Stop).
        let act: int = match msg {
            Cmd.Add(n) => 1,
            Cmd.Get => 2,
            Cmd.Stop => 3
        }
        if act == 1 {
            count = count + delta
        } else if act == 2 {
            rep.send(count)
        } else if act == 3 {
            running = false
        }
    }
    return count
}

fn main() -> int uses IO, Conc {
    let mail: Chan[Cmd] = chan_new()
    let rep: Chan[int] = chan_new()
    let actor: Task[int] = spawn(counter_actor, clone(mail), clone(rep))
    mail.send(Cmd.Add(10))
    mail.send(Cmd.Add(32))
    mail.send(Cmd.Get)
    let value: int = rep.recv()
    mail.send(Cmd.Stop)
    let final: int = actor.join()
    println("get=" + value.to_str() + " final=" + final.to_str())
    return 0
}
