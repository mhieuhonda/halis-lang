# feat_stage31_tail.hls — Stage 31 (v0.48.0-alpha): verified tail calls.
#
# Every #[tail_call] function below is VERIFIED by the checker: every
# recursive call is the entire return expression, and the body flows
# only int / float / bool values (nothing needing cleanup between the
# call and the jump). The native backend lowers each verified site to
# a parameter-rebinding goto (constant stack at any depth); the
# interpreter mirrors it as a trampoline (constant Python stack).
#
# This file runs through BOTH backends in the differential suite:
# interpreter output and native output must be byte-identical.

# fib_tail: the accumulator-form Fibonacci, mod 1e9+7 (the roadmap's
# acceptance shape). Three primitive params, one verified tail site.
#[tail_call]
fn fib_tail(n: int, a: int, b: int) -> int {
    if n == 0 {
        return a
    }
    return fib_tail(n - 1, b, (a + b) % 1000000007)
}

# collatz_steps: TWO verified tail sites (the even and the odd arm).
# Proves the transform handles multiple return branches, not just the
# single-accumulator shape. n = 27 is the classic 111-step climb
# (max intermediate value 9232 — no int64 overflow).
#[tail_call]
fn collatz_steps(n: int, steps: int) -> int {
    if n == 1 {
        return steps
    }
    if n % 2 == 0 {
        return collatz_steps(n / 2, steps + 1)
    }
    return collatz_steps(3 * n + 1, steps + 1)
}

# geo_tail: float accumulator (0.5^k geometric tail). Proves the
# primitive rule covers float, and the rebind is a plain double copy.
#[tail_call]
fn geo_tail(n: int, x: float, acc: float) -> float {
    if n == 0 {
        return acc
    }
    return geo_tail(n - 1, x * 0.5, acc + x)
}

# parity_tail: bool return type — the loop feeds a bool back through
# the final return.
#[tail_call]
fn parity_tail(n: int, flip: bool) -> bool {
    if n == 0 {
        return flip
    }
    return parity_tail(n - 1, !flip)
}

# sum_tail: a plain `while` loop COEXISTS with the tail loop inside
# one #[tail_call] fn (both are constant-stack control flow), and the
# 50,000-deep recursion proves the stack really is constant in BOTH
# backends (50k real call frames would need ~2.4 MB; a Python
# recursion of 50k would blow the default limit). The `mut` parameter
# shows param locals are ordinary rebind targets.
#[tail_call]
fn sum_tail(n: int, mut acc: int) -> int {
    let mut inner: int = 0
    while inner < 3 {
        acc = acc + inner
        inner = inner + 1
    }
    if n == 0 {
        return acc
    }
    return sum_tail(n - 1, acc + n)
}

# guarded_tail: a panic guard with a string LITERAL — the one allowed
# non-primitive expression (a consume-builtin argument: transferred,
# never hoisted, never bound; provably cleanup-free at the jump).
#[tail_call]
fn guarded_tail(n: int, acc: int) -> int {
    if n < 0 {
        return panic("guarded_tail: negative depth")
    }
    if n == 0 {
        return acc
    }
    return guarded_tail(n - 1, acc + 1)
}

fn main() -> int uses IO {
    # fib_tail: exact values (mod 1e9+7).
    println("fib_tail(0) = " + fib_tail(0, 0, 1).to_str())
    println("fib_tail(1) = " + fib_tail(1, 0, 1).to_str())
    println("fib_tail(30) = " + fib_tail(30, 0, 1).to_str())
    println("fib_tail(90) = " + fib_tail(90, 0, 1).to_str())
    # A 10,000-deep run: would be 10,000 real frames (≈480 KB of C
    # stack) without the transform; with it, one frame.
    println("fib_tail(10000) = " + fib_tail(10000, 0, 1).to_str())
    # collatz: 27 takes 111 steps (two tail sites exercised).
    println("collatz_steps(27) = " + collatz_steps(27, 0).to_str())
    println("collatz_steps(1) = " + collatz_steps(1, 0).to_str())
    # floats (printed via to_str; deterministic IEEE-754 doubles).
    println("geo_tail(10, 1.0, 0.0) = " + geo_tail(10, 1.0, 0.0).to_str())
    # bool result.
    println("parity_tail(10, true) = " + parity_tail(10, true).to_str())
    println("parity_tail(7, false) = " + parity_tail(7, false).to_str())
    # while + tail recursion, 50,000 deep.
    println("sum_tail(50000, 0) = " + sum_tail(50000, 0).to_str())
    # panic-literal guard (never fires here).
    println("guarded_tail(100, 0) = " + guarded_tail(100, 0).to_str())
    return 0
}
