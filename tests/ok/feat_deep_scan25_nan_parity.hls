# feat_deep_scan25_nan_parity.hls — deep-scan-25 regression: NaN/Inf
# parity between the boot interpreter and the native runtime. The
# interpreter's f64_div/f64_mod/_libm handlers used to synthesise a
# POSITIVE Python float('nan') where the x86-64 FPU produces the
# sign-bit-set default QNaN (printed "-nan"), so the differential
# runner diverged on any printed 0.0/0.0. The interpreter now mirrors
# the hardware default QNaN and fmt_float renders the NaN sign like
# C's printf. This test avoids printing raw NaN strings (their sign is
# platform-dependent by design) and pins the PLATFORM-STABLE facts:
# which operations produce NaN at all, which produce ±Inf, and the
# signs of ±Inf and ±0.0.
fn expect_true(v: bool, label: str) {
    if !v {
        panic(label + ": expected true")
    }
}
fn expect_false(v: bool, label: str) {
    if v {
        panic(label + ": expected false")
    }
}
fn main() -> int uses IO {
    # Invalid operations produce NaN on every platform.
    expect_true(math_isnan(0.0 / 0.0), "0/0 is nan")
    expect_true(math_isnan(math_sqrt(-1.0)), "sqrt(-1) is nan")
    expect_true(math_isnan(math_log(-1.0)), "log(-1) is nan")
    expect_true(math_isnan(math_log10(-1.0)), "log10(-1) is nan")
    expect_true(math_isnan(math_log2(-1.0)), "log2(-1) is nan")
    expect_true(math_isnan(math_asin(-2.0)), "asin(-2) is nan")
    expect_true(math_isnan(math_acos(-2.0)), "acos(-2) is nan")
    expect_true(math_isnan(math_fmod(1.0, 0.0)), "fmod(1,0) is nan")
    # Propagation: NaN flowing through arithmetic stays NaN.
    let nan0: float = 0.0 / 0.0
    expect_true(math_isnan(nan0 + 1.0), "nan+1 is nan")
    expect_true(math_isnan(nan0 * 2.0), "nan*2 is nan")
    expect_true(math_isnan(0.0 / nan0), "0/nan is nan (propagates)")
    # Signed infinities: exact value and exact sign.
    expect_true(math_isinf(1.0 / 0.0), "1/0 is inf")
    expect_true(1.0 / 0.0 > 0.0, "1/0 is +inf")
    expect_true(math_isinf(-1.0 / 0.0), "-1/0 is -inf")
    expect_true(-1.0 / 0.0 < 0.0, "-1/0 is -inf (negative)")
    expect_true(math_signbit(-1.0 / 0.0), "-inf signbit set")
    expect_false(math_signbit(1.0 / 0.0), "+inf signbit clear")
    # C99 Annex F pole rules pinned by deep-scan-24, still holding.
    expect_true(math_isinf(math_pow(0.0, -1.0)), "pow(+0,-1) is +inf")
    expect_true(math_pow(0.0, -1.0) > 0.0, "pow(+0,-1) positive")
    expect_true(math_isinf(math_pow(-0.0, -3.0)), "pow(-0,-3) is -inf")
    expect_true(math_pow(-0.0, -3.0) < 0.0, "pow(-0,-3) negative")
    expect_true(math_isinf(math_tgamma(0.0)), "tgamma(+0) is +inf")
    expect_true(math_tgamma(-0.0) < 0.0, "tgamma(-0) is -inf")
    # -0.0 sign handling (platform-independent).
    expect_true(math_signbit(-0.0), "-0.0 signbit set")
    expect_false(math_signbit(0.0), "+0.0 signbit clear")
    expect_false(-0.0 < 0.0, "-0.0 compares equal to +0.0")
    # fmt_float renders NaN/Inf like C printf (sign-checked, so the
    # NaN case must accept either platform's rendering).
    let rendered: str = (0.0 / 0.0).to_str()
    if rendered != "nan" && rendered != "-nan" {
        panic("nan rendering unexpected: " + rendered)
    }
    if(1.0 / 0.0).to_str() != "inf" {
        panic("+inf rendering")
    }
    if((-1.0) / 0.0).to_str() != "-inf" {
        panic("-inf rendering")
    }
    println("nan parity OK")
    return 0
}
