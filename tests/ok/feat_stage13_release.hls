# feat_stage13_release.hls — exercises Stage 13 release functionality
# (transparency log + multi-file packages + versioning) via the stdlib.
# Direct CLI tests live in tests/run_tests.sh; this file just makes sure
# the Stage 13 release compiles + runs cleanly via the C backend too.

import "std.str"

fn main() -> int uses IO {
    # Use a few stdlib modules that the package manager should resolve.
    let s: str = "hello"
    println("len=" + s.len().to_str())
    println("upper=" + str_to_upper_ascii(s))
    return 0
}
