# Expect: exit 101, panic "lapic_reg_addr: a register id must be >= 0"
# Stage 87: an APIC register id is its offset divided by four. A
# negative id computes a negative address, and every access through it
# would read somewhere below the device window.
import "core.mmio"

fn main() -> int {
    if lapic_reg_addr(-1) != 0 {
        return 1
    }
    return 0
}
