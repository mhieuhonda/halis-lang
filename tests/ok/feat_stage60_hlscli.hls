# ============================================================================
# Test 20: hlscli_load_project — parse a hls-pkg.toml.
# ============================================================================

fn test_load_project() -> int uses IO, Fs, Proc {
    # Create the temp dir + write a hls-pkg.toml.
    let _ : int = proc_exec("mkdir -p /tmp/test_load_proj/src")
    let toml: str = "[package]\nname = \"myapp\"\nversion = \"1.2.3\"\ndescription = \"Test app\"\n\n[dependencies]\njson = \"1.0\"\nhttp = \"2.0\"\n"
    write_file("/tmp/test_load_proj/hls-pkg.toml", toml)
    let project: HlsProject = hlscli_load_project("/tmp/test_load_proj")
    eq_str(project.name, "myapp", "load: name=myapp")
    eq_str(project.version, "1.2.3", "load: version=1.2.3")
    eq_str(project.description, "Test app", "load: description")
    eq_int(project.dependencies.len(), 2, "load: 2 dependencies")
    ok(hlscli_list_contains(project.dependencies, "json"), "load: has json dep")
    ok(hlscli_list_contains(project.dependencies, "http"), "load: has http dep")
    return 0
}

