# tests/ok/feat_stage60_hlscli.hls — Stage 60 (v0.81.0-alpha): std.hlscli.
#
# Exercises:
#   - hlscli_build_parser — the launcher's own CLI parser.
#   - hlscli_main — the dispatcher (reads argv, parses, dispatches).
#   - hlscli_cmd_new — `hls new <name>` scaffolds a project.
#   - hlscli_cmd_init — `hls init` scaffolds in the current directory.
#   - hlscli_cmd_run — `hls run` compiles + runs src/main.hls.
#   - hlscli_cmd_build — `hls build` compiles without running.
#   - hlscli_cmd_test — `hls test` runs tests.
#   - hlscli_cmd_bench — `hls bench` runs benchmarks.
#   - hlscli_cmd_doc — `hls doc` generates API docs.
#   - hlscli_cmd_publish — `hls publish` (stub).
#   - hlscli_cmd_clean — `hls clean` removes target/.
#   - hlscli_cmd_update — `hls update` (stub).
#   - hlscli_cmd_completion — `hls completion --shell=bash|zsh|fish|ps`.
#   - hlscli_find_project_root — walk up looking for hls-pkg.toml.
#   - hlscli_load_project — parse hls-pkg.toml via std.config's TOML parser.
#   - hlscli_is_safe_project_name — sanitise the project name.
#   - hlscli_basename / hlscli_parent_dir — path helpers.
#   - hlscli_quote_arg / hlscli_is_shell_safe — shell quoting.
#   - hlscli_template_* — the scaffolded file templates.
#   - Env-var config (HLS_COMPILER, HLS_TARGET_DIR, HLS_RELEASE).
#
# The test scaffolds a project in /tmp, verifies the file contents, runs
# `hls run` (with HLS_COMPILER pointed at the project's bin/hlc), and
# checks the output. All output is differential-safe (the project name
# and the test file paths are fixed strings).

import "std.hlscli"
import "std.str"
import "std.cli"

# ============================================================================
# Helpers
# ============================================================================

fn ok(actual: bool, msg: str) -> void uses IO {
    if !actual {
        panic("FAIL " + msg)
    }
}

fn eq_int(actual: int, expected: int, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_str(actual: str, expected: str, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected '" + expected + "', got '" + actual + "'")
    }
}

fn contains(haystack: str, needle: str) -> bool {
    return haystack.contains(needle)
}

# hlscli_list_contains — list[str] membership check (HLS lists don't
# have a .contains method).
fn hlscli_list_contains(xs: list[str], needle: str) -> bool {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) == needle {
            return true
        }
        i = i + 1
    }
    return false
}

# ============================================================================
# Test 1: hlscli_build_parser — the parser has every subcommand.
# ============================================================================

fn test_build_parser() -> int uses IO {
    let p: CliParser = hlscli_build_parser()
    # Check the parser's name / version.
    eq_str(p.name, "hls", "parser: name=hls")
    eq_str(p.version, "0.81.0-alpha", "parser: version")
    # Check the global options.
    let mut has_release: bool = false
    let mut has_verbose: bool = false
    let mut has_target_dir: bool = false
    let mut has_compiler: bool = false
    let mut has_shell: bool = false
    let mut has_color: bool = false
    let mut i: int = 0
    while i < p.args.len() {
        let a: CliArg = p.args.get(i)
        if a.long_name == "release" { has_release = true }
        if a.long_name == "verbose" { has_verbose = true }
        if a.long_name == "target-dir" { has_target_dir = true }
        if a.long_name == "compiler" { has_compiler = true }
        if a.long_name == "shell" { has_shell = true }
        if a.long_name == "color" { has_color = true }
        i = i + 1
    }
    ok(has_release, "parser: --release registered")
    ok(has_verbose, "parser: --verbose registered")
    ok(has_target_dir, "parser: --target-dir registered")
    ok(has_compiler, "parser: --compiler registered")
    ok(has_shell, "parser: --shell registered")
    ok(has_color, "parser: --color registered")
    # Check the subcommands.
    let subs: list[str] = p.subcommands
    let mut has_new: bool = false
    let mut has_init: bool = false
    let mut has_run: bool = false
    let mut has_build: bool = false
    let mut has_test: bool = false
    let mut has_bench: bool = false
    let mut has_doc: bool = false
    let mut has_publish: bool = false
    let mut has_clean: bool = false
    let mut has_update: bool = false
    let mut has_completion: bool = false
    let mut j: int = 0
    while j < subs.len() {
        let s: str = subs.get(j)
        if s == "new" { has_new = true }
        if s == "init" { has_init = true }
        if s == "run" { has_run = true }
        if s == "build" { has_build = true }
        if s == "test" { has_test = true }
        if s == "bench" { has_bench = true }
        if s == "doc" { has_doc = true }
        if s == "publish" { has_publish = true }
        if s == "clean" { has_clean = true }
        if s == "update" { has_update = true }
        if s == "completion" { has_completion = true }
        j = j + 1
    }
    ok(has_new, "parser: subcommand 'new'")
    ok(has_init, "parser: subcommand 'init'")
    ok(has_run, "parser: subcommand 'run'")
    ok(has_build, "parser: subcommand 'build'")
    ok(has_test, "parser: subcommand 'test'")
    ok(has_bench, "parser: subcommand 'bench'")
    ok(has_doc, "parser: subcommand 'doc'")
    ok(has_publish, "parser: subcommand 'publish'")
    ok(has_clean, "parser: subcommand 'clean'")
    ok(has_update, "parser: subcommand 'update'")
    ok(has_completion, "parser: subcommand 'completion'")
    return 0
}

# ============================================================================
# Test 2: hlscli_is_safe_project_name — sanitise project names.
# ============================================================================

fn test_safe_name() -> int uses IO {
    # Safe names.
    ok(hlscli_is_safe_project_name("myapp"), "safe: myapp")
    ok(hlscli_is_safe_project_name("my-app"), "safe: my-app")
    ok(hlscli_is_safe_project_name("my_app"), "safe: my_app")
    ok(hlscli_is_safe_project_name("a1b2c3"), "safe: a1b2c3")
    # Unsafe names.
    ok(!hlscli_is_safe_project_name(""), "unsafe: empty")
    ok(!hlscli_is_safe_project_name("my/app"), "unsafe: contains /")
    ok(!hlscli_is_safe_project_name("my..app"), "unsafe: contains ..")
    ok(!hlscli_is_safe_project_name("../etc/passwd"), "unsafe: traversal")
    ok(!hlscli_is_safe_project_name("-foo"), "unsafe: leading hyphen")
    ok(!hlscli_is_safe_project_name("my app"), "unsafe: contains space")
    ok(!hlscli_is_safe_project_name("my.app"), "unsafe: contains dot (not allowed in project name)")
    return 0
}

# ============================================================================
# Test 3: hlscli_basename — last path component.
# ============================================================================

fn test_basename() -> int uses IO {
    eq_str(hlscli_basename("/home/user/myapp"), "myapp", "basename: /home/user/myapp")
    eq_str(hlscli_basename("/home/user/myapp/"), "myapp", "basename: trailing slash stripped")
    eq_str(hlscli_basename("myapp"), "myapp", "basename: no slash")
    eq_str(hlscli_basename("/"), "", "basename: root -> empty")
    eq_str(hlscli_basename(""), "", "basename: empty -> empty")
    return 0
}

# ============================================================================
# Test 4: hlscli_parent_dir — parent directory.
# ============================================================================

fn test_parent_dir() -> int uses IO {
    eq_str(hlscli_parent_dir("/home/user/myapp"), "/home/user", "parent: /home/user/myapp")
    eq_str(hlscli_parent_dir("/home/user/myapp/"), "/home/user", "parent: trailing slash stripped")
    eq_str(hlscli_parent_dir("/home"), "/", "parent: /home -> /")
    eq_str(hlscli_parent_dir("/"), "/", "parent: root -> /")
    return 0
}

# ============================================================================
# Test 5: hlscli_quote_arg — shell quoting.
# ============================================================================

fn test_quote_arg() -> int uses IO {
    eq_str(hlscli_quote_arg("simple"), "simple", "quote: simple unchanged")
    eq_str(hlscli_quote_arg("hello world"), "'hello world'", "quote: space -> single-quoted")
    eq_str(hlscli_quote_arg("a'b"), "'a'\\''b'", "quote: single quote escaped")
    eq_str(hlscli_quote_arg(""), "''", "quote: empty -> ''")
    eq_str(hlscli_quote_arg("a/b:c=d+e"), "a/b:c=d+e", "quote: safe chars unchanged")
    return 0
}

# ============================================================================
# Test 6: hlscli_is_shell_safe — detect safe chars.
# ============================================================================

fn test_shell_safe() -> int uses IO {
    ok(hlscli_is_shell_safe("simple"), "safe_shell: simple")
    ok(hlscli_is_shell_safe("a1-b_c.d:e=f+g/h"), "safe_shell: all safe chars")
    ok(!hlscli_is_shell_safe(""), "safe_shell: empty unsafe")
    ok(!hlscli_is_shell_safe("hello world"), "safe_shell: space unsafe")
    ok(!hlscli_is_shell_safe("a'b"), "safe_shell: single quote unsafe")
    ok(!hlscli_is_shell_safe("a;b"), "safe_shell: semicolon unsafe")
    ok(!hlscli_is_shell_safe("a$b"), "safe_shell: dollar unsafe")
    return 0
}

# ============================================================================
# Test 7: hlscli_template_pkg_toml — manifest template.
# ============================================================================

fn test_template_pkg_toml() -> int uses IO {
    let toml: str = hlscli_template_pkg_toml("myapp", "1.2.3")
    ok(contains(toml, "[package]"), "pkg_toml: [package] section")
    ok(contains(toml, "name = \"myapp\""), "pkg_toml: name = myapp")
    ok(contains(toml, "version = \"1.2.3\""), "pkg_toml: version = 1.2.3")
    ok(contains(toml, "[dependencies]"), "pkg_toml: [dependencies] section")
    return 0
}

