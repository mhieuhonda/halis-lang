    println("  ok")
    println("")
    println("ACCEPTANCE OK: Stage 60 — std.hlscli (cargo-style launcher)")
    println("  hlscli_build_parser (11 subcommands + 6 global options)")
    println("  hlscli_main dispatcher (reads argv, parses, dispatches)")
    println("  Subcommands: new / init / run / build / test / bench / doc /")
    println("    publish / clean / update / completion")
    println("  Project scaffolding (hls-pkg.toml + src/main.hls + .gitignore + README.md)")
    println("  hlscli_find_project_root (walk up looking for hls-pkg.toml)")
    println("  hlscli_load_project (parse hls-pkg.toml via std.config's TOML parser)")
    println("  hlscli_is_safe_project_name (rejects /, .., leading -, spaces, dots)")
    println("  hlscli_quote_arg / hlscli_is_shell_safe (shell quoting)")
    println("  hlscli_basename / hlscli_parent_dir (path helpers)")
    println("  hlscli_template_* (pkg_toml / main_hls / gitignore / readme / doc_html)")
    println("  Env-var config (HLS_COMPILER / HLS_TARGET_DIR / HLS_RELEASE)")
    println("  Profile selection (debug / release via --release or HLS_RELEASE=1)")
    println("  Subprocess spawning via proc_exec (NOT a shell wrapper — direct exec)")
    println("  Pure-HLS implementation (no new compiler builtins)")
