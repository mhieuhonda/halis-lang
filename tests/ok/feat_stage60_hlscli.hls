fn test_cmd_clean() -> int uses Args, IO, Fs, Proc {
    let p: CliParser = hlscli_build_parser()
    let argv: list[str] = ["hls", "clean"]
    let result: CliResult = cli_parse(p, argv)
    ok(result.ok, "clean: parse ok")
    # Create a temp target/ dir to clean.
    let _ : int = proc_exec("mkdir -p target/clean_test")
    let exit_code: int = hlscli_cmd_clean(result)
    eq_int(exit_code, 0, "clean: exit code 0")
    return 0
}

# ============================================================================
# Test 22: hlscli_extract_shell — parse --shell from remaining args.
# ============================================================================

fn test_extract_shell() -> int uses IO {
    # --shell=bash form.
    let rem1: list[str] = ["--shell=bash"]
    eq_str(hlscli_extract_shell(rem1), "bash", "extract: --shell=bash")
    # --shell bash form.
    let rem2: list[str] = ["--shell", "zsh"]
    eq_str(hlscli_extract_shell(rem2), "zsh", "extract: --shell zsh")
    # Mixed with other args.
    let rem3: list[str] = ["--verbose", "--shell", "fish", "--release"]
    eq_str(hlscli_extract_shell(rem3), "fish", "extract: --shell fish (with other args)")
    # Missing.
    let rem4: list[str] = ["--verbose"]
    eq_str(hlscli_extract_shell(rem4), "", "extract: --shell not present")
    # --shell with no value.
    let rem5: list[str] = ["--shell"]
    eq_str(hlscli_extract_shell(rem5), "", "extract: --shell with no value")
    return 0
}

# ============================================================================
# Test 23: env-var config (HLS_RELEASE, HLS_TARGET_DIR, HLS_COMPILER).
# ============================================================================

fn test_env_config() -> int uses Args, IO, Proc {
    let p: CliParser = hlscli_build_parser()
    # No --release flag, but HLS_RELEASE=1 set.
    env_set("HLS_RELEASE", "1")
    let argv: list[str] = ["hls", "run"]
    let result: CliResult = cli_parse(p, argv)
    ok(hlscli_is_release(result), "env_config: HLS_RELEASE=1 -> release")
    env_unset("HLS_RELEASE")
    # HLS_RELEASE=0 -> not release.
    env_set("HLS_RELEASE", "0")
    let result2: CliResult = cli_parse(p, argv)
    ok(!hlscli_is_release(result2), "env_config: HLS_RELEASE=0 -> not release")
    env_unset("HLS_RELEASE")
    # HLS_TARGET_DIR.
    env_set("HLS_TARGET_DIR", "/tmp/hls_target")
    let result3: CliResult = cli_parse(p, argv)
    eq_str(hlscli_target_dir(result3), "/tmp/hls_target", "env_config: HLS_TARGET_DIR")
    env_unset("HLS_TARGET_DIR")
    # HLS_COMPILER.
    env_set("HLS_COMPILER", "/usr/local/bin/hlc")
    let result4: CliResult = cli_parse(p, argv)
    eq_str(hlscli_compiler(result4), "/usr/local/bin/hlc", "env_config: HLS_COMPILER")
    env_unset("HLS_COMPILER")
    return 0
}

# ============================================================================
# Test 24: hlscli_template_doc_html — doc HTML template.
# ============================================================================

fn test_template_doc_html() -> int uses IO {
    let project: HlsProject = HlsProject {
        name: "myapp", version: "1.2.3", description: "Test app",
        authors: [], dependencies: [],
        has_main: true, has_lib: false, has_tests: false, has_benches: false,
        has_examples: false, root: "/tmp",
    }
    let html: str = hlscli_template_doc_html(project)
    ok(contains(html, "<!DOCTYPE html>"), "doc_html: has DOCTYPE")
    ok(contains(html, "<title>myapp — API docs</title>"), "doc_html: title")
    ok(contains(html, "<h1>myapp</h1>"), "doc_html: h1")
    ok(contains(html, "Version 1.2.3"), "doc_html: version")
    ok(contains(html, "Test app"), "doc_html: description")
    return 0
}

