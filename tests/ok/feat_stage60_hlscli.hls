# ============================================================================
# Main — run all tests sequentially.
# ============================================================================

fn main() -> int uses Args, IO, Fs, Proc {
    println("=== Stage 60: std.hlscli (cargo-style launcher) ===")
    println("")
    println("--- hlscli_build_parser (subcommands + global options) ---")
    test_build_parser()
    println("  ok")
    println("--- hlscli_is_safe_project_name ---")
    test_safe_name()
    println("  ok")
    println("--- hlscli_basename ---")
    test_basename()
    println("  ok")
    println("--- hlscli_parent_dir ---")
    test_parent_dir()
    println("  ok")
    println("--- hlscli_quote_arg (shell quoting) ---")
    test_quote_arg()
    println("  ok")
    println("--- hlscli_is_shell_safe ---")
    test_shell_safe()
    println("  ok")
    println("--- hlscli_template_pkg_toml ---")
    test_template_pkg_toml()
    println("  ok")
    println("--- hlscli_template_main_hls ---")
    test_template_main_hls()
    println("  ok")
    println("--- hlscli_template_gitignore ---")
