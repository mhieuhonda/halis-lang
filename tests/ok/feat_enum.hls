# feat_enum.hls — verify basic enum (no payloads, no generics)
enum Direction {
    North,
    South,
    East,
    West
}

enum Op {
    Add(int, int),
    Sub(int, int),
    Mul(int, int),
    Div(int, int)
}

fn dir_name(d: Direction) -> str {
    return match d {
        Direction.North => "North",
        Direction.South => "South",
        Direction.East => "East",
        Direction.West => "West"
    }
}

fn op_eval(o: Op) -> int {
    return match o {
        Op.Add(a, b) => a + b,
        Op.Sub(a, b) => a - b,
        Op.Mul(a, b) => a * b,
        Op.Div(a, b) => a / b
    }
}

fn main() -> int uses IO {
    let d: Direction = Direction.East
    println(dir_name(d))

    let ops: list[Op] = [Op.Add(2, 3), Op.Sub(10, 4), Op.Mul(5, 6), Op.Div(20, 5)]
    let mut i: int = 0
    while i < ops.len() {
        println("result[" + i.to_str() + "] = " + op_eval(ops.get(i)).to_str())
        i = i + 1
    }
    return 0
}
