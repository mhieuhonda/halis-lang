    if test_push_promise() != 0 { return 17 }
    if test_priority() != 0 { return 18 }
    if test_preface() != 0 { return 19 }
    if test_stream_state() != 0 { return 20 }
    if test_connection_alloc() != 0 { return 21 }
    if test_flow_control() != 0 { return 22 }
    if test_alpn() != 0 { return 23 }
    if test_huffman_deferral() != 0 { return 24 }
    if test_settings_validation() != 0 { return 25 }
    println("ALL HTTP/2 TESTS PASSED")
    return 0
}
