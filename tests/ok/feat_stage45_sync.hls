# tests/ok/feat_stage45_sync.hls — Stage 45 (v0.64.0-alpha): std.sync.
#
# Exercises all five synchronisation primitives:
#   - Mutex: lock, unlock, try_lock (contended and uncontended)
#   - RwLock: read_lock x N concurrent reads, write_lock exclusivity
#   - Condvar: signal / broadcast wake patterns
#   - OnceCell[int/str/bool]: set-once, get, get_or, is_init
#   - Barrier: 1-thread, N-thread rendezvous, reuse across rounds
#
# All tests are DETERMINISTIC — no real-time scheduling dependence.
# The concurrent tests use deterministic round-robin patterns: every
# task does the same number of lock/unlock cycles, the channel
# runtime serialises the operations, and the observable state at the
# end is independent of which task ran first.
#
# The differential test (interpreter == native) is byte-exact because
# the test output depends only on the FINAL state of the shared
# counters, not on the interleaving of intermediate operations.

import "std.sync"
import "std.str"
import "std.option"

# ============================================================================
# Helpers
# ============================================================================

fn ok(actual: bool, msg: str) -> void uses IO {
    if !actual {
        panic("FAIL " + msg)
    }
}

fn eq_int(actual: int, expected: int, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_str(actual: str, expected: str, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected '" + expected + "', got '" + actual + "'")
    }
}

fn eq_bool(actual: bool, expected: bool, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg)
    }
}

# ============================================================================
# Mutex tests — single-thread (deterministic)
# ============================================================================

fn test_mutex_basic() -> int uses IO, Conc {
    let m: Mutex = mutex_new()

    # Unlocked at construction.
    eq_bool(mutex_try_lock(m), true, "mutex.try_lock unlocked")
    # Now held — try_lock must fail.
    eq_bool(mutex_try_lock(m), false, "mutex.try_lock held")
    # Release and re-acquire.
    mutex_unlock(m)
    eq_bool(mutex_try_lock(m), true, "mutex.try_lock after unlock")
    mutex_unlock(m)

    # Blocking lock on an unlocked mutex returns immediately.
    mutex_lock(m)
    mutex_unlock(m)

    return 0
}

# ============================================================================
# Mutex tests — concurrent (deterministic counter increment)
# ============================================================================
# Each worker does K iterations of: lock / increment shared counter /
# unlock. The shared counter is a cap-1 channel holding an int. After
# all workers join, the counter must equal N_WORKERS * K.
#
# Worker function: free, top-level, takes (counter: Chan[int], k: int).
# The spawn boundary deep-copies the arguments (the channel is shared
# by reference — channels are Send).

fn sync_test_counter_worker(counter: Chan[int], k: int) -> void uses Conc {
    let mut i: int = 0
    let m: Mutex = mutex_new()
    while i < k {
        mutex_lock(m)
        # Read-modify-write the counter under the lock.
        let v: int = counter.recv()
        counter.send(v + 1)
        mutex_unlock(m)
        i = i + 1
    }
    # NOTE: the mutex is created per-worker here, which doesn't test
    # cross-task mutex sharing. The cross-task sharing test is below
    # (test_mutex_concurrent_shared).
}

fn test_mutex_local() -> int uses IO, Conc {
    # Each worker has its OWN mutex and counter — verifies the
    # primitive works in isolation. The shared-mutex test follows.
    let counter: Chan[int] = chan_new_bounded(1)
    counter.send(0)
    let t1: Task[void] = spawn(sync_test_counter_worker, clone(counter), 100)
    let t2: Task[void] = spawn(sync_test_counter_worker, clone(counter), 100)
    let t3: Task[void] = spawn(sync_test_counter_worker, clone(counter), 100)
    t1.join()
    t2.join()
    t3.join()
    let total: int = counter.recv()
    eq_int(total, 300, "mutex.local.3workers.x100")
    return 0
}

# Cross-task shared mutex: the mutex is created in the parent and
# passed to children via spawn. The spawn boundary-clone rule for
# channels means each child gets a reference to the SAME underlying
# hl_chan* (channels are shared, not copied).

fn sync_test_shared_mutex_worker(m: Mutex, counter: Chan[int], k: int) -> void uses Conc {
    let mut i: int = 0
    while i < k {
        mutex_lock(m)
        let v: int = counter.recv()
        counter.send(v + 1)
        mutex_unlock(m)
        i = i + 1
    }
}

fn test_mutex_shared() -> int uses IO, Conc {
    let m: Mutex = mutex_new()
    let counter: Chan[int] = chan_new_bounded(1)
    counter.send(0)
    let t1: Task[void] = spawn(sync_test_shared_mutex_worker, clone(m), clone(counter), 50)
    let t2: Task[void] = spawn(sync_test_shared_mutex_worker, clone(m), clone(counter), 50)
    let t3: Task[void] = spawn(sync_test_shared_mutex_worker, clone(m), clone(counter), 50)
    let t4: Task[void] = spawn(sync_test_shared_mutex_worker, clone(m), clone(counter), 50)
    t1.join()
    t2.join()
    t3.join()
    t4.join()
    let total: int = counter.recv()
    eq_int(total, 200, "mutex.shared.4workers.x50")
    return 0
}

# ============================================================================
# RwLock tests
# ============================================================================

fn test_rwlock_basic() -> int uses IO, Conc {
    let rw: RwLock = rwlock_new()

    # Multiple read locks can be held concurrently (in a single
    # thread — the count goes to 2 then back to 0).
    rwlock_read_lock(rw)
    rwlock_read_lock(rw)
    rwlock_read_unlock(rw)
    rwlock_read_unlock(rw)

    # Write lock is exclusive — after write_lock, a read_lock would
    # block. We don't test that here (would hang the test); the
    # exclusivity is verified structurally by the protocol.
    rwlock_write_lock(rw)
    rwlock_write_unlock(rw)

    # After write_unlock, read_lock works again.
    rwlock_read_lock(rw)
    rwlock_read_unlock(rw)

    return 0
}

# Concurrent readers + a single writer. The writer waits for all
# readers to finish, then increments the counter, then releases.
# Deterministic because we join all tasks before checking.

fn sync_test_rwlock_reader(rw: RwLock, counter: Chan[int], k: int) -> void uses Conc {
    let mut i: int = 0
    while i < k {
        rwlock_read_lock(rw)
        # Read the counter (no modification under read lock).
        let _v: int = counter.recv()
        counter.send(_v)  # peek
        rwlock_read_unlock(rw)
        i = i + 1
    }
}

fn sync_test_rwlock_writer(rw: RwLock, counter: Chan[int], k: int) -> void uses Conc {
    let mut i: int = 0
    while i < k {
        rwlock_write_lock(rw)
        let v: int = counter.recv()
        counter.send(v + 1)
        rwlock_write_unlock(rw)
        i = i + 1
    }
}

fn test_rwlock_concurrent() -> int uses IO, Conc {
    let rw: RwLock = rwlock_new()
    let counter: Chan[int] = chan_new_bounded(1)
    counter.send(0)

    # 3 readers x 50 reads, 1 writer x 100 increments.
    let r1: Task[void] = spawn(sync_test_rwlock_reader, clone(rw), clone(counter), 50)
    let r2: Task[void] = spawn(sync_test_rwlock_reader, clone(rw), clone(counter), 50)
    let r3: Task[void] = spawn(sync_test_rwlock_reader, clone(rw), clone(counter), 50)
    let w: Task[void] = spawn(sync_test_rwlock_writer, clone(rw), clone(counter), 100)
    r1.join()
    r2.join()
    r3.join()
    w.join()

    let total: int = counter.recv()
    eq_int(total, 100, "rwlock.concurrent.writer_increment")
    return 0
}

# ============================================================================
# Condvar tests
# ============================================================================

# Producer-consumer pattern: producer signals when work is ready,
# consumer waits. Deterministic because the consumer blocks until
# signalled.

fn sync_test_condvar_producer(cv: Condvar, m: Mutex, flag: Chan[int]) -> void uses Conc {
    # Sleep-equivalent: yield to let consumer start first. We use a
    # token-channel trick — the consumer sends a "ready" token first,
    # producer waits for it, then producer sends work + signals.
    # Without a real sleep (Stage 46), we use a small busy loop.
    let mut spin: int = 0
    while spin < 1000 {
        spin = spin + 1
    }
    mutex_lock(m)
    flag.send(1)
    condvar_signal(cv)
    mutex_unlock(m)
}

fn sync_test_condvar_consumer(cv: Condvar, m: Mutex, flag: Chan[int], out: Chan[int]) -> void uses Conc {
    mutex_lock(m)
    # Wait until flag is set. Use a peek pattern (recv + send back).
    let mut ready: bool = false
    while !ready {
        let v: int = flag.recv_or(-1)
        if v == -1 {
            # Not ready — wait on condvar.
            condvar_wait(cv, m)
        } else {
            flag.send(v)  # put back
            ready = true
        }
    }
    out.send(1)
    mutex_unlock(m)
}

fn test_condvar_signal() -> int uses IO, Conc {
    let m: Mutex = mutex_new()
    let cv: Condvar = condvar_new()
    let flag: Chan[int] = chan_new_bounded(1)
    let out: Chan[int] = chan_new_bounded(1)

    let consumer: Task[void] = spawn(sync_test_condvar_consumer, clone(cv), clone(m), clone(flag), clone(out))
    let producer: Task[void] = spawn(sync_test_condvar_producer, clone(cv), clone(m), clone(flag))
    consumer.join()
    producer.join()

    let v: int = out.recv()
    eq_int(v, 1, "condvar.signal.consumer_received")
    return 0
}

fn test_condvar_broadcast() -> int uses IO, Conc {
    # broadcast(n) wakes n waiters. We spawn n consumers, broadcast(n),
    # and verify all n complete.
    let m: Mutex = mutex_new()
    let cv: Condvar = condvar_new()
    let flag: Chan[int] = chan_new_bounded(1)
    let out: Chan[int] = chan_new_bounded(3)

    let c1: Task[void] = spawn(sync_test_condvar_consumer, clone(cv), clone(m), clone(flag), clone(out))
    let c2: Task[void] = spawn(sync_test_condvar_consumer, clone(cv), clone(m), clone(flag), clone(out))
    let c3: Task[void] = spawn(sync_test_condvar_consumer, clone(cv), clone(m), clone(flag), clone(out))

    # Let consumers reach the condvar_wait. Without a real sleep,
    # use a busy-loop yield.
    let mut spin: int = 0
    while spin < 5000 {
        spin = spin + 1
    }

    mutex_lock(m)
    flag.send(1)
    condvar_broadcast(cv, 3)
    mutex_unlock(m)

    c1.join()
    c2.join()
    c3.join()

    # Each consumer sent 1 to out.
    let v1: int = out.recv()
    let v2: int = out.recv()
    let v3: int = out.recv()
    eq_int(v1 + v2 + v3, 3, "condvar.broadcast.3waiters")
    return 0
}

# ============================================================================
# OnceCell[int/str/bool] tests
# ============================================================================

fn test_once_cell_int() -> int uses IO, Conc {
    let c: OnceCellInt = once_cell_int_new()
    eq_bool(once_cell_int_is_init(c), false, "once_cell_int.fresh.not_init")
    eq_bool(once_cell_int_set(c, 42), true, "once_cell_int.first_set.true")
    eq_bool(once_cell_int_is_init(c), true, "once_cell_int.after_set.init")
    eq_bool(once_cell_int_set(c, 99), false, "once_cell_int.second_set.false")
    eq_int(once_cell_int_get(c), 42, "once_cell_int.get.first_value")
    eq_int(once_cell_int_get_or(c, 0), 42, "once_cell_int.get_or.first_value")
    return 0
}

fn test_once_cell_str() -> int uses IO, Conc {
    let c: OnceCellStr = once_cell_str_new()
    eq_bool(once_cell_str_is_init(c), false, "once_cell_str.fresh.not_init")
    eq_bool(once_cell_str_set(c, "hello"), true, "once_cell_str.first_set.true")
    eq_bool(once_cell_str_set(c, "world"), false, "once_cell_str.second_set.false")
    eq_str(once_cell_str_get(c), "hello", "once_cell_str.get.first_value")
    eq_str(once_cell_str_get_or(c, "default"), "hello", "once_cell_str.get_or.first_value")
    return 0
}

fn test_once_cell_bool() -> int uses IO, Conc {
    let c: OnceCellBool = once_cell_bool_new()
    eq_bool(once_cell_bool_is_init(c), false, "once_cell_bool.fresh.not_init")
    eq_bool(once_cell_bool_set(c, true), true, "once_cell_bool.first_set.true")
    eq_bool(once_cell_bool_set(c, false), false, "once_cell_bool.second_set.false")
    eq_bool(once_cell_bool_get(c), true, "once_cell_bool.get.first_value")
    eq_bool(once_cell_bool_get_or(c, false), true, "once_cell_bool.get_or.first_value")
    return 0
}

# Concurrent OnceCell: 4 tasks race to set the cell. Exactly one
# must observe set() returning true; the others must observe false.
# The final value is the winner's value.

fn sync_test_once_cell_race_worker(c: OnceCellInt, worker_id: int, out: Chan[int]) -> void uses Conc {
    let won: bool = once_cell_int_set(c, worker_id * 100)
    if won {
        out.send(worker_id)
    } else {
        out.send(-1)
    }
}

fn test_once_cell_concurrent() -> int uses IO, Conc {
    let c: OnceCellInt = once_cell_int_new()
    let out: Chan[int] = chan_new_bounded(4)

    let t1: Task[void] = spawn(sync_test_once_cell_race_worker, clone(c), 1, clone(out))
    let t2: Task[void] = spawn(sync_test_once_cell_race_worker, clone(c), 2, clone(out))
    let t3: Task[void] = spawn(sync_test_once_cell_race_worker, clone(c), 3, clone(out))
    let t4: Task[void] = spawn(sync_test_once_cell_race_worker, clone(c), 4, clone(out))
    t1.join()
    t2.join()
    t3.join()
    t4.join()

    # Exactly one worker won; the other three returned -1.
    let v1: int = out.recv()
    let v2: int = out.recv()
    let v3: int = out.recv()
    let v4: int = out.recv()

    let mut winners: int = 0
    let mut winner_id: int = -1
    if v1 != -1 {
        winners = winners + 1
        winner_id = v1
    }
    if v2 != -1 {
        winners = winners + 1
        winner_id = v2
    }
    if v3 != -1 {
        winners = winners + 1
        winner_id = v3
    }
    if v4 != -1 {
        winners = winners + 1
        winner_id = v4
    }

    eq_int(winners, 1, "once_cell.concurrent.one_winner")
    # The cell's stored value must match the winner's id * 100.
    eq_int(once_cell_int_get(c), winner_id * 100, "once_cell.concurrent.winner_value")
    return 0
}

# ============================================================================
# Barrier tests
# ============================================================================

fn test_barrier_n1() -> int uses IO, Conc {
    # n=1: barrier_wait returns immediately (the caller is the
    # "last arrival" trivially).
    let b: Barrier = barrier_new(1)
    barrier_wait(b)
    # Reusable.
    barrier_wait(b)
    return 0
}

fn sync_test_barrier_worker(b: Barrier, out: Chan[int], worker_id: int) -> void uses Conc {
    # Each worker arrives at the barrier. After the barrier releases,
    # all workers send their id to out.
    barrier_wait(b)
    out.send(worker_id)
}

fn test_barrier_n4() -> int uses IO, Conc {
    let b: Barrier = barrier_new(4)
    let out: Chan[int] = chan_new_bounded(4)

    let t1: Task[void] = spawn(sync_test_barrier_worker, clone(b), clone(out), 1)
    let t2: Task[void] = spawn(sync_test_barrier_worker, clone(b), clone(out), 2)
    let t3: Task[void] = spawn(sync_test_barrier_worker, clone(b), clone(out), 3)
    let t4: Task[void] = spawn(sync_test_barrier_worker, clone(b), clone(out), 4)
    t1.join()
    t2.join()
    t3.join()
    t4.join()

    # All 4 workers sent their id. The ORDER is non-deterministic
    # (whichever worker the scheduler ran first after the barrier
    # release), but the SET is {1, 2, 3, 4}.
    let v1: int = out.recv()
    let v2: int = out.recv()
    let v3: int = out.recv()
    let v4: int = out.recv()
    eq_int(v1 + v2 + v3 + v4, 10, "barrier.n4.sum_of_ids")
    return 0
}

# Reusable barrier via fresh barriers per round. The Barrier primitive
# is single-use (see std/sync.hls for the rationale — a reusable
# barrier would require generation-tagged tokens which don't fit the
# channel-only model). The user wraps barrier_new + barrier_wait in a
# loop, creating a fresh Barrier for each round.
#
# We test this pattern by spawning 3 workers that run 3 rounds each.
# The barrier for each round is created by the parent BEFORE the
# round starts; the parent signals the round's barrier to the workers
# via a "round-started" channel. (Simpler than it sounds — see below.)
#
# Actually, the simplest pattern is: each worker creates its OWN
# barrier per round, but barriers are SHARED — so we need a parent
# to create them. The pattern below uses a "round channel": the
# parent sends a fresh Barrier to each worker at the start of each
# round.
#
# To keep the test simple, we instead verify the single-use contract
# directly: create a barrier, have N workers call barrier_wait, join
# all workers, then create a NEW barrier and do it again. This is
# the recommended pattern.
fn test_barrier_reuse() -> int uses IO, Conc {
    # Round 1: 3 workers, n=3.
    let b1: Barrier = barrier_new(3)
    let out1: Chan[int] = chan_new_bounded(3)
    let t1a: Task[void] = spawn(sync_test_barrier_worker, clone(b1), clone(out1), 1)
    let t1b: Task[void] = spawn(sync_test_barrier_worker, clone(b1), clone(out1), 2)
    let t1c: Task[void] = spawn(sync_test_barrier_worker, clone(b1), clone(out1), 3)
    t1a.join()
    t1b.join()
    t1c.join()
    let s1: int = out1.recv() + out1.recv() + out1.recv()
    eq_int(s1, 6, "barrier.reuse.round1.sum")

    # Round 2: 3 workers, n=3, fresh barrier.
    let b2: Barrier = barrier_new(3)
    let out2: Chan[int] = chan_new_bounded(3)
    let t2a: Task[void] = spawn(sync_test_barrier_worker, clone(b2), clone(out2), 4)
    let t2b: Task[void] = spawn(sync_test_barrier_worker, clone(b2), clone(out2), 5)
    let t2c: Task[void] = spawn(sync_test_barrier_worker, clone(b2), clone(out2), 6)
    t2a.join()
    t2b.join()
    t2c.join()
    let s2: int = out2.recv() + out2.recv() + out2.recv()
    eq_int(s2, 15, "barrier.reuse.round2.sum")
    return 0
}

# ============================================================================
# Main — run all tests sequentially. Order matters: the concurrent
# tests spawn tasks; if any earlier test panics, the spawned tasks
# would leak (the runtime cleans up on exit, but the panic message
# would be confusing). Sequential execution makes failures clear.
# ============================================================================

fn main() -> int uses IO, Conc {
    println("=== Stage 45: std.sync ===")
    println("")
    println("--- Mutex (basic) ---")
    test_mutex_basic()
    println("  ok")
    println("--- Mutex (local counter) ---")
    test_mutex_local()
    println("  ok")
    println("--- Mutex (shared counter) ---")
    test_mutex_shared()
    println("  ok")
    println("--- RwLock (basic) ---")
    test_rwlock_basic()
    println("  ok")
    println("--- RwLock (concurrent r/w) ---")
    test_rwlock_concurrent()
    println("  ok")
    println("--- Condvar (signal) ---")
    test_condvar_signal()
    println("  ok")
    println("--- Condvar (broadcast) ---")
    test_condvar_broadcast()
    println("  ok")
    println("--- OnceCell[int] ---")
    test_once_cell_int()
    println("  ok")
    println("--- OnceCell[str] ---")
    test_once_cell_str()
    println("  ok")
    println("--- OnceCell[bool] ---")
    test_once_cell_bool()
    println("  ok")
    println("--- OnceCell (concurrent race) ---")
    test_once_cell_concurrent()
    println("  ok")
    println("--- Barrier (n=1) ---")
    test_barrier_n1()
    println("  ok")
    println("--- Barrier (n=4) ---")
    test_barrier_n4()
    println("  ok")
    println("--- Barrier (reuse 3 rounds) ---")
    test_barrier_reuse()
    println("  ok")
    println("")
    println("ACCEPTANCE OK: Stage 45 — std.sync (Mutex, RwLock, Condvar, OnceCell, Barrier)")
    return 0
}
