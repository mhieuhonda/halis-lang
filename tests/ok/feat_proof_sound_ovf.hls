# feat_proof_sound_ovf.hls — Stage-17 perfection (deep-scan-10)
# soundness regression: an UNBOUNDED operand interval must never be
# proven overflow-free (TOP used to 'fit' int64 -> the -O fast build
# emitted a raw C + that wrapped silently). Both implementations must
# panic identically (101).
fn add(x: int, y: int) -> int
    requires x >= 0
{
    return x + y
}
fn main() -> int {
    return add(9223372036854775807, 1)
}
