# feat_match_wildcard.hls — verifies the top-level `_` wildcard pattern
# in match arms. This used to fail to parse because the lexer tokenises
# `_` as an `ident`, not as a `sym`, so `at_sym("_")` returned False.
#
# Also exercises wildcard payload bindings: `Option.Some(_)`.
import "std.option"

enum Color { Red, Green, Blue }

fn name_of(c: Color) -> str pure {
    return match c {
        Color.Red => "red",
        _ => "other"
    }
}

fn classify(o: Option[int]) -> str pure {
    return match o {
        Option.Some(_) => "has value",
        Option.None => "no value"
    }
}

fn main() -> int uses IO {
    let r: str = name_of(Color.Red)
    let g: str = name_of(Color.Green)
    let b: str = name_of(Color.Blue)
    println("Red=" + r + " Green=" + g + " Blue=" + b)

    let s1: str = classify(Option.Some(42))
    let s2: str = classify(Option.None)
    println("Some(42)=" + s1 + " None=" + s2)
    return 0
}
