# Stage 98 (v0.117.0-alpha): soundness of guard elision. The value
# below VIOLATES the refinement at runtime, but no compile-time proof
# (constant folding, same-pred flow, interval analysis) may prove it
# satisfies the predicate — so the guard MUST stay and the program must
# panic identically (exit 101, nothing printed) in both implementations.
# A wrong elision would let "unreachable" print in the native build.

fn read_zero(v: int) -> int {
    return v * v - v * v
}

fn main() -> int uses IO {
    let n: int = 7
    let z: int where self != 0 = read_zero(n)
    println("unreachable")
    return 100 / z
}
