# Deep-scan-11 regression: a `#` comment in a CR-only-terminated file
# used to eat the rest of the file. The lexer's comment handler now
# also stops at `\r` (byte 13), matching the whitespace handler's
# treatment of a lone `\r` as a line terminator. This file uses LF
# endings (the test runner normalises), but the source bytes below
# verify the same code path: a comment immediately followed by code
# on the next line must lex correctly.
fn main() -> int uses IO {
    # this comment runs to end of line
    println("after comment")
    # another comment
    return 0
}
