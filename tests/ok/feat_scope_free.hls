# feat_scope_free.hls — Stage 8-beta (v0.19.0-alpha): exact free at scope
# exit. The generated C runtime is refcounted; every binding, container
# element, struct field and function argument owns exactly one retain and
# releases it at block exit. This program churns heap allocations in
# loops and prints deterministic checksums — the interpreter and the
# native binary must agree (differential), and the native binary must
# not grow RSS (verified by tests/run_tests.sh section 6 on the stress
# variant).

struct Point {
    x: int,
    y: int,
    tag: str
}

enum Shape {
    Circle(float),
    Rect(int, int),
    Empty
}

fn make_words(n: int) -> list[str] {
    let out: list[str] = []
    let mut i: int = 0
    while i < n {
        out.push("word-" + i.to_str())
        i = i + 1
    }
    return out
}

fn total_len(words: list[str]) -> int {
    let mut acc: int = 0
    for w: str in words {
        acc = acc + w.len()
    }
    return acc
}

fn consume(s: str) -> int {
    return s.len()
}

fn make_point(i: int) -> Point {
    return Point { x: i, y: i * 2, tag: "p" + i.to_str() }
}

fn shape_area(s: Shape) -> float {
    return match s {
        Shape.Circle(r) => 3.1415 * r * r,
        Shape.Rect(a, b) => (a * b).to_float(),
        Shape.Empty => 0.0
    }
}

fn churn_strings(rounds: int) -> int {
    let mut checksum: int = 0
    let mut i: int = 0
    while i < rounds {
        # Fresh concat consumed by println-like discipline: bound, used,
        # released at iteration exit.
        let s: str = "round-" + i.to_str() + "-suffix"
        checksum = checksum + s.len()
        # clone + mutate through aliasing discipline
        let base: str = "abcdef"
        let copy: str = clone(base)
        checksum = checksum + copy.byte_at(1)
        drop(copy)
        # borrow + consume via take
        let owned: str = "value" + i.to_str()
        checksum = checksum + consume(take(owned))
        i = i + 1
    }
    return checksum
}

fn churn_lists(rounds: int) -> int {
    let mut checksum: int = 0
    let mut i: int = 0
    while i < rounds {
        let xs: list[int] = [i, i + 1, i + 2, i + 3, i + 4]
        let ys: list[int] = clone(xs)
        ys.push(99)
        checksum = checksum + ys.pop()
        checksum = checksum + xs.get(2)
        let words: list[str] = make_words(3)
        checksum = checksum + total_len(words)
        i = i + 1
    }
    return checksum
}

fn churn_maps(rounds: int) -> int {
    let mut checksum: int = 0
    let mut i: int = 0
    while i < rounds {
        let m: map[str, int] = map_new()
        m.set("alpha", i)
        m.set("beta", i * 2)
        m.set("gamma", i * 3)
        let c: map[str, int] = clone(m)
        c.set("beta", -1)
        checksum = checksum + m.get_or("beta", 0) + c.get_or("beta", 0)
        let keys: list[str] = c.keys()
        for k: str in keys {
            checksum = checksum + k.len()
        }
        # map with pointer values
        let sm: map[str, str] = map_new()
        sm.set("one", "1")
        sm.set("two", "2")
        checksum = checksum + sm.get_or("two", "?").len()
        i = i + 1
    }
    return checksum
}

fn churn_structs(rounds: int) -> int {
    let mut checksum: int = 0
    let mut i: int = 0
    while i < rounds {
        let p: Point = make_point(i)
        checksum = checksum + p.x + p.y
        let q: Point = clone(p)
        q.x = 1000
        checksum = checksum + p.x + q.x
        let s: Shape = Shape.Rect(i, i + 1)
        checksum = checksum + shape_area(s).to_int()
        let s2: Shape = clone(s)
        checksum = checksum + shape_area(s2).to_int()
        i = i + 1
    }
    return checksum
}

fn borrow_chain(a: str, b: str) -> str {
    # Returns a borrowed argument: the callee adds one retain for the
    # caller (return-of-borrow), released by the caller's binding.
    if a.len() > b.len() {
        return a
    }
    return b
}

fn main() -> int uses IO {
    println("strings=" + churn_strings(50).to_str())
    println("lists=" + churn_lists(50).to_str())
    println("maps=" + churn_maps(50).to_str())
    println("structs=" + churn_structs(50).to_str())

    # take + revive pattern
    let mut s: str = "first"
    drop(s)
    s = "second"
    println("revived=" + s)

    # borrow-chain returns
    let r: str = borrow_chain("short", "much longer string")
    println("borrow_chain=" + r)

    # discarded fresh value (expr statement) must not leak
    make_words(2)
    println("ok")
    return 0
}
