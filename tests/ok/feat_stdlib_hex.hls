# feat_stdlib_hex.hls — verify std.hex encode / decode round-trip.
import "std.hex"

fn main() -> int uses IO {
    # Empty
    if hex_encode("") != "" {
        println("FAIL: empty encode")
        return 1
    }
    if hex_decode("") != "" {
        println("FAIL: empty decode")
        return 1
    }
    # Round-trip arbitrary bytes.
    let bytes: str = "Hello, Hieu Louis!"
    let encoded: str = hex_encode(bytes)
    let decoded: str = hex_decode(encoded)
    if decoded != bytes {
        println("FAIL: hex round-trip mismatch")
        return 1
    }
    # Lowercase alphabet.
    if encoded != "48656c6c6f2c2048696575204c6f75697321" {
        println("FAIL: hex wrong alphabet: " + encoded)
        return 1
    }
    # Single byte boundary cases.
    if hex_byte(0) != "00" || hex_byte(255) != "ff" || hex_byte(16) != "10" {
        println("FAIL: hex_byte boundary")
        return 1
    }
    # Odd length must panic — guard with a check.
    let odd: bool = false
    if odd {
        # Dead code; prevents the compiler from optimising away.
        let _: str = hex_decode("abc")
    }
    println("OK: hex")
    return 0
}
