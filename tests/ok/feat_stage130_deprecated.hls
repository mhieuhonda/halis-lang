# feat_stage130_deprecated.hls — Stage 130 (v0.148.0-alpha): the
# deprecation mechanism — `#[deprecated]` / `#[deprecated("why")]` on
# a fn, and the linter's L013 deprecated-call rule.
#
# What this fixture pins is the CONTRACT, in the oldest stable core:
#
#   1. the attribute parses in both forms (bare + message) and both
#      front-ends accept it — the differential suite runs this very
#      file through boot and through the self-hosted compiler;
#   2. deprecation is pure METADATA: the deprecated fns below run
#      exactly like any other (this program exits 0 on the
#      interpreter AND natively — zero codegen, zero runtime cost);
#   3. the deprecation notice survives the formatter byte for byte
#      (hlfmt --check keeps the attribute where it is);
#   4. the linter's L013 rule warns at every call site and quotes the
#      message — the fixture carries EXACTLY the six L013 warnings
#      listed at the bottom of this file (three cross-module from
#      modules/depmod.hls, three same-file) and nothing else. That
#      census is the fixture's hygiene contract: a future change that
#      adds or drops a warning here must say so in the same commit.
#
# A call INSIDE a deprecated fn is silent (old_chain calls old_base —
# the caller is deprecated too; the census below proves the rule).

import "modules/depmod.hls"

# The deprecated pair, with a live replacement each. The bare form
# carries no message — L013 says so explicitly instead of guessing one.
#[deprecated("use fast_path(v) — the old form double-counts zero")]
fn slow_path(v: int) -> int {
    if v == 0 {
        return 1
    }
    return v * 3
}

fn fast_path(v: int) -> int {
    if v == 0 {
        return 1
    }
    return v * 3
}

#[deprecated]
fn legacy_name(v: int) -> int {
    return v + 11
}

fn modern_name(v: int) -> int {
    return v + 11
}

# A deprecated wrapper calling a deprecated primitive: L013 stays
# silent INSIDE the deprecated body (the caller is deprecated too —
# the migration's own scaffolding must not drown in its warnings).
#[deprecated("temporary glue; dies with the legacy surface")]
fn old_chain(v: int) -> int {
    return slow_path(v) + legacy_name(v)
}

fn main() -> int uses IO {
    # The deprecated calls — the ones L013 warns about:
    let a: int = slow_path(3)
    let b: int = legacy_name(4)
    let c: int = depmod_slow(5)
    let d: int = depmod_legacy(6)
    let e: int = old_chain(2)
    # The live replacements — no warning for these:
    let f: int = fast_path(3)
    let g: int = modern_name(4)
    let h: int = depmod_fast(5)
    let i: int = depmod_modern(6)
    # Deprecated and live agree where they must (the replacements are
    # real replacements, not behaviour changes):
    if a != f {
        return 1
    }
    if b != g {
        return 2
    }
    if c != h {
        return 3
    }
    if d != i {
        return 4
    }
    # 9 + 15 + 10 + 13 + 19 + 9 + 15 + 10 + 13 = 113
    let total: int = a + b + c + d + e + f + g + h + i
    if total != 113 {
        return 5
    }
    println("deprecated OK: " + total.to_str())
    return 0
}

# The L013 census this file carries (pinned by the Stage 130 gate):
#   line 63: call to deprecated 'slow_path': use fast_path(v) — the old
#            form double-counts zero
#   line 64: call to deprecated 'legacy_name' (no deprecation message
#            given)
#   line 65: call to deprecated 'depmod_slow': use depmod_fast(v) — the
#            old form double-counts zero   (the CROSS-MODULE case: the
#            notice lives in modules/depmod.hls)
#   line 66: call to deprecated 'depmod_legacy' (no deprecation message
#            given)   (cross-module, bare form)
#   line 67: call to deprecated 'old_chain': temporary glue; dies with
#            the legacy surface
# Five sites, five warnings; the deprecated bodies silent (old_chain
# calls slow_path and legacy_name and nothing fires), the live
# replacements silent.
