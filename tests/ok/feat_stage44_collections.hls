# tests/ok/feat_stage44_collections.hls — Stage 44 (v0.63.0-alpha): std.collections.
#
# Exercises all five collection types:
#   - BTreeMap: insert, lookup, remove, sorted keys, min/max
#   - HashSet: add, contains, size, union, intersect, diff
#   - LinkedList: push_back/front, pop_back/front, len, to_list
#   - RingBuf: push, push_overwrite, pop_front, peek, capacity
#   - HashMap: set, get, has, keys, update, collision handling
#
# All tests are DETERMINISTIC — pure HLS, no I/O — so the
# differential test (interpreter == native) is byte-exact.

import "std.collections"
import "std.str"
import "std.option"

# ============================================================================
# Helpers
# ============================================================================

fn ok(actual: bool, msg: str) -> void uses IO {
    if !actual {
        panic("FAIL " + msg)
    }
}

fn eq_int(actual: int, expected: int, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected " + expected.to_str() + ", got " + actual.to_str())
    }
}

fn eq_str(actual: str, expected: str, msg: str) -> void uses IO {
    if actual != expected {
        panic("FAIL " + msg + ": expected '" + expected + "', got '" + actual + "'")
    }
}

# ============================================================================
# BTreeMap tests
# ============================================================================

fn test_btreemap() -> int uses IO {
    let m: BTreeMapIntStr = btreemap_int_str_new()

    # Empty map
    ok(btreemap_int_str_is_empty(m), "btreemap.empty.is_empty")
    eq_int(btreemap_int_str_size(m), 0, "btreemap.empty.size")

    # Insert out of order — should be sorted internally
    btreemap_int_str_set(m, 3, "three")
    btreemap_int_str_set(m, 1, "one")
    btreemap_int_str_set(m, 2, "two")

    eq_int(btreemap_int_str_size(m), 3, "btreemap.size.3")
    ok(!btreemap_int_str_is_empty(m), "btreemap.not_empty")

    # Lookup
    ok(btreemap_int_str_has(m, 1), "btreemap.has.1")
    ok(btreemap_int_str_has(m, 2), "btreemap.has.2")
    ok(btreemap_int_str_has(m, 3), "btreemap.has.3")
    ok(!btreemap_int_str_has(m, 4), "btreemap.has.not.4")

    eq_str(option_unwrap(btreemap_int_str_get(m, 1)), "one", "btreemap.get.1")
    eq_str(option_unwrap(btreemap_int_str_get(m, 2)), "two", "btreemap.get.2")
    eq_str(option_unwrap(btreemap_int_str_get(m, 3)), "three", "btreemap.get.3")

    # Min/max
    eq_int(option_unwrap(btreemap_int_str_min(m)), 1, "btreemap.min")
    eq_int(option_unwrap(btreemap_int_str_max(m)), 3, "btreemap.max")

    # Keys are sorted
    let keys: list[int] = btreemap_int_str_keys(m)
    eq_int(keys.get(0), 1, "btreemap.keys[0]")
    eq_int(keys.get(1), 2, "btreemap.keys[1]")
    eq_int(keys.get(2), 3, "btreemap.keys[2]")

    # Update existing key
    btreemap_int_str_set(m, 2, "TWO")
    eq_str(option_unwrap(btreemap_int_str_get(m, 2)), "TWO", "btreemap.update")
    eq_int(btreemap_int_str_size(m), 3, "btreemap.update.size_unchanged")

    # Remove
    ok(btreemap_int_str_remove(m, 2), "btreemap.remove.2")
    eq_int(btreemap_int_str_size(m), 2, "btreemap.remove.size")
    ok(!btreemap_int_str_has(m, 2), "btreemap.remove.has_gone")
    ok(!btreemap_int_str_remove(m, 99), "btreemap.remove.not_found")

    # Min/max on empty
    let empty: BTreeMapIntStr = btreemap_int_str_new()
    ok(!option_is_some(btreemap_int_str_min(empty)), "btreemap.empty.min.none")
    ok(!option_is_some(btreemap_int_str_max(empty)), "btreemap.empty.max.none")

    println("  BTreeMap OK")
    return 0
}

# ============================================================================
# HashSet tests
# ============================================================================

fn test_hashset() -> int uses IO {
    let a: HashSetInt = hashset_int_new()
    ok(hashset_int_is_empty(a), "hashset.empty")
    hashset_int_add(a, 1)
    hashset_int_add(a, 2)
    hashset_int_add(a, 3)
    eq_int(hashset_int_size(a), 3, "hashset.size.3")

    # Duplicate add doesn't increase size
    hashset_int_add(a, 1)
    eq_int(hashset_int_size(a), 3, "hashset.dup.no_grow")

    # Contains
    ok(hashset_int_contains(a, 1), "hashset.contains.1")
    ok(hashset_int_contains(a, 2), "hashset.contains.2")
    ok(!hashset_int_contains(a, 99), "hashset.contains.not.99")

    # Set operations
    let b: HashSetInt = hashset_int_new()
    hashset_int_add(b, 3)
    hashset_int_add(b, 4)
    hashset_int_add(b, 5)

    let u: HashSetInt = hashset_int_union(a, b)
    eq_int(hashset_int_size(u), 5, "hashset.union.size")

    let inter: HashSetInt = hashset_int_intersect(a, b)
    eq_int(hashset_int_size(inter), 1, "hashset.intersect.size")
    ok(hashset_int_contains(inter, 3), "hashset.intersect.has.3")

    let diff: HashSetInt = hashset_int_diff(a, b)
    eq_int(hashset_int_size(diff), 2, "hashset.diff.size")
    ok(hashset_int_contains(diff, 1), "hashset.diff.has.1")
    ok(hashset_int_contains(diff, 2), "hashset.diff.has.2")
    ok(!hashset_int_contains(diff, 3), "hashset.diff.not.3")

    println("  HashSet OK")
    return 0
}

# ============================================================================
# LinkedList tests
# ============================================================================

fn test_linkedlist() -> int uses IO {
    let ll: LinkedListInt = linkedlist_int_new()
    ok(linkedlist_int_is_empty(ll), "ll.empty")

    linkedlist_int_push_back(ll, 1)
    linkedlist_int_push_back(ll, 2)
    linkedlist_int_push_front(ll, 0)
    linkedlist_int_push_back(ll, 3)

    eq_int(linkedlist_int_len(ll), 4, "ll.len.4")

    # Front and back
    eq_int(option_unwrap(linkedlist_int_front(ll)), 0, "ll.front")
    # back is not exposed separately in our test, check via to_list
    let lst: list[int] = linkedlist_int_to_list(ll)
    eq_int(lst.get(0), 0, "ll.list[0]")
    eq_int(lst.get(1), 1, "ll.list[1]")
    eq_int(lst.get(2), 2, "ll.list[2]")
    eq_int(lst.get(3), 3, "ll.list[3]")

    # Pop front
    eq_int(option_unwrap(linkedlist_int_pop_front(ll)), 0, "ll.pop_front.0")
    eq_int(linkedlist_int_len(ll), 3, "ll.len.after_pop_front")

    # Pop back
    eq_int(option_unwrap(linkedlist_int_pop_back(ll)), 3, "ll.pop_back.3")
    eq_int(linkedlist_int_len(ll), 2, "ll.len.after_pop_back")

    # Pop all
    linkedlist_int_pop_front(ll)
    linkedlist_int_pop_front(ll)
    ok(linkedlist_int_is_empty(ll), "ll.empty.after_all_pops")

    # Pop on empty returns None
    ok(!option_is_some(linkedlist_int_pop_front(ll)), "ll.pop_front.empty.none")

    println("  LinkedList OK")
    return 0
}

# ============================================================================
# RingBuf tests
# ============================================================================

fn test_ringbuf() -> int uses IO {
    let rb: RingBufInt = ringbuf_int_new(3)
    eq_int(ringbuf_int_capacity(rb), 3, "rb.capacity")
    ok(ringbuf_int_is_empty(rb), "rb.empty")

    # Push within capacity
    ok(ringbuf_int_push(rb, 10), "rb.push.1")
    ok(ringbuf_int_push(rb, 20), "rb.push.2")
    ok(ringbuf_int_push(rb, 30), "rb.push.3")
    eq_int(ringbuf_int_len(rb), 3, "rb.len.3")
    ok(ringbuf_int_is_full(rb), "rb.full")

    # Push when full returns false
    ok(!ringbuf_int_push(rb, 999), "rb.push.full.false")
    eq_int(ringbuf_int_len(rb), 3, "rb.len.still.3")

    # Peek front
    eq_int(option_unwrap(ringbuf_int_peek_front(rb)), 10, "rb.peek.10")

    # Pop front
    eq_int(option_unwrap(ringbuf_int_pop_front(rb)), 10, "rb.pop.10")
    eq_int(ringbuf_int_len(rb), 2, "rb.len.2")

    # Overwrite mode
    ringbuf_int_push_overwrite(rb, 40)
    ringbuf_int_push_overwrite(rb, 50)
    ringbuf_int_push_overwrite(rb, 60)  # This overwrites 20
    eq_int(ringbuf_int_len(rb), 3, "rb.overwrite.len.3")

    # Contents should be [30, 40, 50, 60] minus the overwritten 20 = [30, 40, 50, 60]
    # Wait: after popping 10, we had [20, 30]. Then:
    # push_overwrite(40) -> [20, 30, 40] (count=3, full)
    # push_overwrite(50) -> overwrites 20 -> [30, 40, 50] (head moves)
    # push_overwrite(60) -> overwrites 30 -> [40, 50, 60]
    let rb_list: list[int] = ringbuf_int_to_list(rb)
    eq_int(rb_list.get(0), 40, "rb.list[0]")
    eq_int(rb_list.get(1), 50, "rb.list[1]")
    eq_int(rb_list.get(2), 60, "rb.list[2]")

    # Clear
    ringbuf_int_clear(rb)
    ok(ringbuf_int_is_empty(rb), "rb.empty.after_clear")

    # Pop on empty returns None
    ok(!option_is_some(ringbuf_int_pop_front(rb)), "rb.pop.empty.none")

    println("  RingBuf OK")
    return 0
}

# ============================================================================
# HashMap tests
# ============================================================================

fn test_hashmap() -> int uses IO {
    let hm: HashMapIntStr = hashmap_int_str_new()
    ok(hashmap_int_str_is_empty(hm), "hashmap.empty")

    hashmap_int_str_set(hm, 42, "answer")
    hashmap_int_str_set(hm, 100, "hundred")
    hashmap_int_str_set(hm, 1000, "thousand")
    eq_int(hashmap_int_str_size(hm), 3, "hashmap.size.3")

    # Lookup
    ok(hashmap_int_str_has(hm, 42), "hashmap.has.42")
    ok(hashmap_int_str_has(hm, 100), "hashmap.has.100")
    ok(!hashmap_int_str_has(hm, 999), "hashmap.has.not.999")

    eq_str(option_unwrap(hashmap_int_str_get(hm, 42)), "answer", "hashmap.get.42")
    eq_str(option_unwrap(hashmap_int_str_get(hm, 100)), "hundred", "hashmap.get.100")

    # Update existing key (size unchanged)
    hashmap_int_str_set(hm, 42, "the answer")
    eq_str(option_unwrap(hashmap_int_str_get(hm, 42)), "the answer", "hashmap.update")
    eq_int(hashmap_int_str_size(hm), 3, "hashmap.update.size_unchanged")

    # Keys
    let keys: list[int] = hashmap_int_str_keys(hm)
    eq_int(keys.len(), 3, "hashmap.keys.len")

    # Large number of keys (stress test collision handling)
    let hm2: HashMapIntInt = hashmap_int_int_new()
    let mut i: int = 0
    while i < 100 {
        hashmap_int_int_set(hm2, i, i * i)
        i = i + 1
    }
    eq_int(hashmap_int_int_size(hm2), 100, "hashmap.stress.size")
    # Verify all lookups
    let mut j: int = 0
    while j < 100 {
        let v: Option[int] = hashmap_int_int_get(hm2, j)
        ok(option_is_some(v), "hashmap.stress.has." + j.to_str())
        eq_int(option_unwrap(v), j * j, "hashmap.stress.value." + j.to_str())
        j = j + 1
    }

    println("  HashMap OK")
    return 0
}

# ============================================================================
# Main entry point.
# ============================================================================

fn main() -> int uses IO {
    println("=== Stage 44: std.collections acceptance test ===")
    test_btreemap()
    test_hashset()
    test_linkedlist()
    test_ringbuf()
    test_hashmap()
    println("=== All Stage 44 tests passed ===")
    return 0
}
