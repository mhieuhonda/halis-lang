# Kiểm thử toàn bộ thao tác chuỗi
fn main() -> int uses IO {
    let s: str = "Hieu Louis Language"
    println("len=" + s.len().to_str())
    println("byte0=" + s.byte_at(0).to_str())
    println("byte4=" + s.byte_at(4).to_str())
    println("slice=" + s.slice(0, 10))
    println("find Louis=" + s.find("Louis").to_str())
    println("find Z=" + s.find("Z").to_str())
    println("contains=" + s.contains("Louis").to_str())
    println("starts=" + s.starts_with("Hieu").to_str())
    println("ends=" + s.ends_with("Language").to_str())
    let parts: list[str] = "a,b,,c".split(",")
    println("parts=" + parts.len().to_str())
    let mut i: int = 0
    while i < parts.len() {
        print("[" + parts.get(i) + "]")
        i = i + 1
    }
    println("")
    println("trim=[" + "  hi \n\t".trim() + "]")
    println("cat=" + "abc" + "def")
    println("cmp=" + ("abc" < "abd").to_str())
    println("eq=" + ("abc" == "abc").to_str())
    println("ne=" + ("abc" != "abd").to_str())
    println("esc=[a\tb\nc\\d\"e]")
    println("empty=[" + "" + "]")
    println("to_int=" + "-42".to_int().to_str())
    println("int_fn=" + int("123").to_str())
    println("f2i=" + 3.99.to_int().to_str())
    println("f2i_neg=" + (-3.99).to_int().to_str())
    println("i2f=" + 7.to_float().to_str())
    return 0
}
