# tests/ok/feat_stage37_net.hls — Stage 37 (v0.56.0-alpha): std.net module.
#
# Exercises:
#   - DNS:                net_lookup (existing) + dns_lookup wrapper
#   - TCP client:         tcp_connect / TcpStream.read / write / close
#   - TCP server:         tcp_listen / TcpListener.accept / close
#   - UDP:                udp_open / UdpSocket.send_to / recv_from / close
#   - The 10 new builtins: net_tcp_connect, net_tcp_listen, net_tcp_accept,
#     net_read, net_write, net_close, net_udp_open, net_udp_send_to,
#     net_udp_recv_from, net_tls_get (TLS builtin is type-checked but
#     NOT executed here — it would require network egress; the
#     acceptance test exercises TCP/UDP loopback only, which is
#     deterministic and offline).
#
# The test starts an echo server on 127.0.0.1:18037, spawns a client
# task that connects, sends "hello\n", reads the echo, and verifies
# it matches. UDP loopback is verified similarly. The test is
# DETERMINISTIC (no real network, no DNS, no libcurl) so the
# differential test (interpreter == native) is byte-exact.

import "std.net"
import "std.str"
import "std.option"
import "std.result"
# Deep-scan-20 fix (flaky test): the client retry loops below used to
# busy-loop 50 times WITHOUT sleeping — under CPU contention (e.g.
# hltest's multiprocessing pool running another file's tests at the
# same time) the spawned server thread couldn't reach listen() before
# the retries ran out, and the server's accept() timed out 30s later
# ("accept failed"). Each retry now sleeps 10ms via the
# thread_sleep_ms builtin, giving the scheduler real room; 50 attempts
# x 10ms = 500ms is far more than a thread needs to bind.

# ============================================================================
# Section 1: DNS — net_lookup on "localhost" returns 127.0.0.1 on every
# POSIX system. This is the only deterministic DNS test (real DNS lookups
# depend on the host's resolver and are not byte-exact across runs).
# ============================================================================

fn test_dns_localhost() -> int uses IO, Net {
    let ip: str = net_lookup("localhost")
    if ip != "127.0.0.1" {
        panic("net_lookup(localhost): expected '127.0.0.1', got '" + ip + "'")
    }
    println("dns localhost OK: " + ip)
    return 0
}

# ============================================================================
# Section 2: TCP echo via raw builtins (no stdlib wrappers). Spawns a
# server task that accepts one connection and echoes 6 bytes back, then
# a client that connects and reads the echo.
# ============================================================================

# echo_server_raw(port) — listen on 127.0.0.1:port, accept one client,
# read up to 1024 bytes, write them back, close. Returns 0 on success.
fn echo_server_raw(port: int) -> int uses Net {
    let lfd: int = net_tcp_listen("127.0.0.1", port, 1)
    if lfd < 0 {
        panic("echo_server_raw: listen failed on port " + port.to_str())
    }
    let cfd: int = net_tcp_accept(lfd)
    if cfd < 0 {
        net_close(lfd)
        panic("echo_server_raw: accept failed")
    }
    let data: str = net_read(cfd, 1024)
    let _w: int = net_write(cfd, data)
    net_close(cfd)
    net_close(lfd)
    return 0
}

# echo_client_raw(port) — connect to 127.0.0.1:port, send "hello\n",
# read up to 1024 bytes back, return the echo. Returns "" on failure.
fn echo_client_raw(port: int) -> str uses Net {
    let fd: int = net_tcp_connect("127.0.0.1", port)
    if fd < 0 {
        return ""
    }
    let _w: int = net_write(fd, "hello\n")
    let echo: str = net_read(fd, 1024)
    net_close(fd)
    return echo
}

# test_tcp_raw() — orchestrate: spawn the server, run the client, verify.
fn test_tcp_raw() -> int uses IO, Net, Conc, Clock {
    let port: int = 18037
    let server_task: Task[int] = spawn(echo_server_raw, port)
    # Tiny sleep would be ideal here, but Stage 37 has no sleep builtin.
    # Instead we just attempt the connect — the server's accept will
    # block until we connect, so no race. The connect call may fail if
    # the server hasn't called listen() yet; in that case we retry a
    # bounded number of times.
    # Deep-scan-20: ...and (see the import note) each retry now sleeps,
    # so the server thread actually gets the CPU to reach listen().
    let mut echo: str = ""
    let mut attempts: int = 0
    while attempts < 50 {
        echo = echo_client_raw(port)
        if echo.len() > 0 {
            break
        }
        thread_sleep_ms(10)
        attempts = attempts + 1
    }
    let _rc: int = server_task.join()
    if echo != "hello\n" {
        panic("test_tcp_raw: expected 'hello\\n', got '" + echo + "'")
    }
    println("tcp raw echo OK: '" + echo.trim() + "'")
    return 0
}

# ============================================================================
# Section 3: TCP echo via stdlib wrappers (TcpListener / TcpStream).
# Same logic as Section 2 but using the high-level API.
# ============================================================================

# echo_server_std(port) — listen via tcp_listen, accept via .accept(),
# read via .read, write via .write, close via .close.
fn echo_server_std(port: int) -> int uses Net {
    let listener: TcpListener = tcp_listen("127.0.0.1", port, 1)
    let conn: TcpStream = listener.accept()
    let data: str = conn.read(1024)
    let _w: int = conn.write(data)
    conn.close()
    listener.close()
    return 0
}

# echo_client_std(port) — connect via tcp_connect, write via .write,
# read via .read, close via .close.
fn echo_client_std(port: int) -> str uses Net {
    let r: Result[TcpStream, str] = tcp_connect_or("127.0.0.1", port)
    if !result_is_ok(r) {
        return ""
    }
    let conn: TcpStream = result_unwrap(r)
    let _w: int = conn.write("world\n")
    let echo: str = conn.read(1024)
    conn.close()
    return echo
}

# test_tcp_std() — orchestrate the stdlib echo.
fn test_tcp_std() -> int uses IO, Net, Conc, Clock {
    let port: int = 18038
    let server_task: Task[int] = spawn(echo_server_std, port)
    # Deep-scan-20: same retry/backoff fix as test_tcp_raw — the old
    # busy-loop starved the just-spawned server thread under CPU
    # contention and the accept timed out.
    let mut echo: str = ""
    let mut attempts: int = 0
    while attempts < 50 {
        echo = echo_client_std(port)
        if echo.len() > 0 {
            break
        }
        thread_sleep_ms(10)
        attempts = attempts + 1
    }
    let _rc: int = server_task.join()
    if echo != "world\n" {
        panic("test_tcp_std: expected 'world\\n', got '" + echo + "'")
    }
    println("tcp stdlib echo OK: '" + echo.trim() + "'")
    return 0
}

# ============================================================================
# Section 4: UDP loopback. Open a UDP socket, send a datagram to
# 127.0.0.1:<port>, then recv_from on the same socket. This works
# because UDP sockets can send to themselves (loopback). We bind
# implicitly by sending first; the OS assigns an ephemeral source
# port. The recv_from returns the datagram (the sender's address is
# discarded — we just verify the payload).
# ============================================================================

fn test_udp_loopback() -> int uses IO, Net {
    let sock: UdpSocket = udp_open()
    if !sock.is_open() {
        panic("test_udp: udp_open failed")
    }

    # Send a datagram to ourselves on a loopback port. We use a
    # high port number unlikely to be in use. The datagram is sent
    # to 127.0.0.1:<port>; we then recv_from on the same socket.
    # In practice, sending to a port nobody is listening on will
    # cause an ICMP "port unreachable" on Linux, which makes the
    # subsequent recv_from fail with ECONNREFUSED. To avoid this,
    # we use a connected UDP socket pattern: send to a known
    # listener. For this test, we just verify send_to succeeds;
    # the recv_from is best-effort.
    let port: int = 18039
    let n: int = sock.send_to("127.0.0.1", port, "udp-ping")
    if n < 0 {
        sock.close()
        panic("test_udp: send_to failed")
    }
    if n != 8 {
        sock.close()
        panic("test_udp: send_to returned " + n.to_str() + " (expected 8)")
    }
    println("udp send_to OK: " + n.to_str() + " bytes")

    # recv_from with a small timeout (the builtin sets a 5-second
    # SO_RCVTIMEO). We don't expect a reply (nobody is listening),
    # so this should return "" after the timeout. We don't assert
    # on the return value — the test is just that the call doesn't
    # hang forever.
    let _reply: str = sock.recv_from(1024)
    sock.close()
    println("udp loopback OK")
    return 0
}

# ============================================================================
# Section 5: Connect-failure handling. Connect to a port that's
# definitely not listening (high port number, no server). The connect
# should fail and return -1. This verifies the error path matches
# between interpreter and native.
# ============================================================================

fn test_connect_failure() -> int uses IO, Net {
    # Port 1 is reserved (root-only) and never has a listener on a
    # user-space test machine. Connecting should fail fast (RST).
    let fd: int = net_tcp_connect("127.0.0.1", 1)
    if fd >= 0 {
        # Unexpected success — close the fd and report.
        net_close(fd)
        panic("test_connect_failure: connect to port 1 unexpectedly succeeded")
    }
    println("connect failure OK: fd=" + fd.to_str())
    return 0
}

# ============================================================================
# Section 6: tls_get type-check. We don't actually call net_tls_get
# (it would require network egress and is non-deterministic). We just
# verify the type-checker accepts the call shape (the checker rejects
# tainted hosts/paths; we pass clean literals). The function is
# defined but not invoked — the test driver skips it.
# ============================================================================

fn _unused_tls_get() -> str uses Net {
    # This function is not called — it's a compile-only check that
    # net_tls_get type-checks with the right argument shape. Calling
    # it at runtime would require network egress and libcurl, which
    # is not deterministic enough for the differential test.
    return net_tls_get("example.com", 443, "/")
}

# ============================================================================
# Section 7: Taint-sink rejection (negative test, in tests/fail/).
# The corresponding fail_effect_net_tcp_connect.hls verifies the
# checker rejects a tainted host passed to net_tcp_connect. This
# section is just documentation — no positive-side test needed here.
# ============================================================================

# ============================================================================
# Main — run all sections in order. Each section returns 0 on success,
# non-zero on failure. The first non-zero return short-circuits.
# ============================================================================

fn main() -> int uses IO, Net, Conc {
    if test_dns_localhost() != 0 { return 1 }
    if test_tcp_raw() != 0 { return 2 }
    if test_tcp_std() != 0 { return 3 }
    if test_udp_loopback() != 0 { return 4 }
    if test_connect_failure() != 0 { return 5 }
    println("ALL NET TESTS PASSED")
    return 0
}
