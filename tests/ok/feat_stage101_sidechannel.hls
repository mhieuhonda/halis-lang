# feat_stage101_sidechannel.hls — Stage 101 (v0.120.0-alpha): the
# #[secrets(...)] attribute and the side-channel audit, exercised as an
# ordinary differential-tested program. Every function here keeps its
# secret in DATA flow only (multiply-and-add, sequential byte walks,
# public loop bounds) — exactly the shapes `hlprove --sidechannel`
# reports as CLEAN — so the program runs identically on the
# interpreter, the native build and the -O fast build.
#
# pick: branch-free selection (a secret multiplied, never branched on)
# fold: a sequential MAC over a secret key — byte_at with a PUBLIC
#       index (the address is the loop counter, not the secret)
# gate: branching on k.len() is public by policy (counted by the
#       audit, never a leak)

#[secrets(mask)]
fn pick(mask: int, a: int, b: int) -> int {
    return a * mask + b * (1 - mask)
}

#[secrets(k)]
fn fold(k: str) -> int {
    let mut acc: int = 0
    let mut i: int = 0
    while i < k.len() {
        acc = acc + k.byte_at(i) * 31
        i = i + 1
    }
    return acc
}

#[secrets(k)]
fn gate(k: str) -> int {
    if k.len() > 0 {
        return 1
    }
    return 0
}

fn main() -> int uses IO {
    let mut total: int = 0
    total = total + pick(1, 5, 9)
    total = total + pick(0, 5, 9)
    total = total + fold("abc")
    println(total.to_str())
    println(gate("kk").to_str())
    println(gate("").to_str())
    return 0
}
