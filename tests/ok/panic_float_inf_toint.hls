# panic_float_inf_toint.hls — deep-scan-5 regression: float.to_int() on
# infinity crashed the interpreter with a raw Python OverflowError
# traceback (the C runtime panicked cleanly). Both now panic with the
# same message. Exit code 101 expected.
fn main() -> int {
    let inf: float = 1.0 / 0.0
    let x: int = inf.to_int()
    return x
}
