# ============================================================================
# tests/bench_libs/arith_bench.hls — Stage 124: a real benchmark suite
# ----------------------------------------------------------------------------
# A module-style Halis file (no main): exactly the shape an hls-bench
# suite takes. The acceptance gate drives the real runner over this
# file — interpreter and native, fixed and adaptive plans, the units
# convention, the skip convention — so the suite exercises every part
# of the Stage 124 contract:
#
#   bench_loop_sum / units_loop_sum   a bench WITH throughput units
#   bench_str_grow                    a bench returning a value (the
#                                     driver binds it into a str sink)
#   bench_no_units                    a bench WITHOUT units (no thrpt)
#   bench_skipped                     mark_skip — SKIP, never FAIL
#
# Benchmarks are ordinary Halis functions: the ok fixture
# feat_stage124_bench.hls calls two of the same-shaped functions from
# main and prints their deterministic results, which is how the
# differential suite keeps the convention honest in-language.
# ============================================================================

import "std.bench"

fn bench_loop_sum() {
    let mut total: int = 0
    let mut i: int = 0
    while i < 100 {
        total = total + i
        i = i + 1
    }
    if total < 0 {
        panic("impossible: the sum of naturals is negative")
    }
}

fn units_loop_sum() -> int {
    return 100
}

fn bench_str_grow() -> str {
    let mut s: str = ""
    let mut i: int = 0
    while i < 8 {
        s = s + "ab"
        i = i + 1
    }
    return s
}

fn bench_no_units() {
    let mut acc: int = 7
    let mut i: int = 0
    while i < 50 {
        acc = acc * 3 - i
        acc = acc - (acc / 1000) * 1000
        i = i + 1
    }
}

fn bench_skipped() {
    mark_skip("the acceptance gate wired this bench to skip")
}
