# LLVM backend subset: dynamic lists use the boxed-element ABI (BUG-DS4-8).
fn main() -> int uses IO {
    let xs: list[int] = [10, 20, 30]
    xs.push(40)
    let mut total: int = 0
    for v: int in xs {
        total = total + v
    }
    println("total=" + total.to_str())
    let words: list[str] = ["a", "b"]
    println("len=" + words.len().to_str() + " first=" + words.get(0))
    let popped: int = xs.pop()
    println("popped=" + popped.to_str())
    return 0
}
