# LLVM backend subset: booleans are i1 end-to-end (BUG-DS4-4 regression).
fn main() -> int uses IO {
    let b: bool = 1 < 2
    let c: bool = 3 > 4
    if b && !c {
        println("bool ops ok")
    }
    let eq: bool = b == true
    let ne: bool = b != c
    println("eq=" + eq.to_str() + " ne=" + ne.to_str())
    return 0
}
