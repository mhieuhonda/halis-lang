# LLVM backend subset: division/modulo route through the runtime checked
# helpers (BUG-DS4-3): zero and INT64_MIN/-1 panic identically to the
# interpreter.
fn main() -> int uses IO {
    let q: int = 7 / 2
    let r: int = 7 % 3
    let neg: int = -7 / 2
    println("q=" + q.to_str() + " r=" + r.to_str() + " neg=" + neg.to_str())
    if q == 3 && r == 1 && neg == -3 {
        println("divmod ok")
        return 0
    }
    return 1
}
