# LLVM backend subset: string concat/compare via the runtime; relational
# comparisons go through hl_str_cmp (BUG-DS4-10).
fn main() -> int uses IO {
    let s: str = "abc"
    let t: str = "abd"
    if s < t && t > s {
        println("string ops ok")
    }
    println("len=" + s.len().to_str())
    return 0
}
