# LLVM backend subset: && / || must short-circuit (BUG-DS4-9). If the RHS
# were evaluated eagerly, 10 / x would panic on division by zero.
fn main() -> int uses IO {
    let x: int = 0
    let safe: bool = x != 0 && 10 / x > 0
    let safe2: bool = x == 0 || 10 / x > 0
    if safe == false && safe2 == true {
        println("short-circuit ok")
        return 0
    }
    println("SHORT-CIRCUIT BROKEN")
    return 1
}
