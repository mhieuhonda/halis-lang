# geom.hls — the Stage 134 gate package: struct + method closure.
#
# Vec2 is the smallest honest struct surface: a literal constructor,
# field projections in the harness, and a method (`scale`) whose body
# the type-and-call closure must drag in when some entry calls it.
# The gate pins the seed for vec_len and the method's presence in the
# emitted harness text.

struct Vec2 {
    x: float,
    y: float,
}

# vec_add(a, b) — componentwise; returns a struct, so the harness
# projects the result field by field.
fn vec_add(a: Vec2, b: Vec2) -> Vec2 {
    return Vec2 { x: a.x + b.x, y: a.y + b.y }
}

# vec_dot(a, b) — a scalar return over struct fields.
fn vec_dot(a: Vec2, b: Vec2) -> float {
    return a.x * b.x + a.y * b.y
}

# vec_len(v) — Pythagoras; a float return through math_sqrt.
fn vec_len(v: Vec2) -> float {
    return math_sqrt(v.x * v.x + v.y * v.y)
}

impl Vec2 {
    # scale(k) — the immutable-update method. A seed whose entry is
    # vec_scaled pulls THIS body in through the method closure; a seed
    # for vec_add must not (the closure is exact, not greedy).
    fn scale(self: Vec2, k: float) -> Vec2 {
        return Vec2 { x: self.x * k, y: self.y * k }
    }
}

# vec_scaled(v, k) — the entry that exercises the method closure.
fn vec_scaled(v: Vec2, k: float) -> Vec2 {
    return v.scale(k)
}

# scale_x_len(x, k) — the seedable bridge into the struct surface:
# primitive parameters, a struct literal, a method call, a float
# return. The closure must pull in BOTH the Vec2 definition and the
# scale method body; the harness projects the float result.
fn scale_x_len(x: float, k: float) -> float {
    let v: Vec2 = Vec2 { x: x, y: 0.0 }
    let s: Vec2 = v.scale(k)
    return math_sqrt(s.x * s.x + s.y * s.y)
}
