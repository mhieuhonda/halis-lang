# list_ops.hls — the Stage 134 gate package: list-parameter entry
# candidates. Lists synthesize corners by shape ([] / [1] / [3,1,2]
# / [5,4,3,2,1]), and the harness projects the result elementwise, so
# every function here seeds a differential comparison over real list
# code.

# sum_list(xs) — the accumulator walk, the classic list fold.
fn sum_list(xs: list[int]) -> int {
    let mut acc: int = 0
    let mut i: int = 0
    while i < xs.len() {
        acc = acc + xs.get(i)
        i = i + 1
    }
    return acc
}

# reverse_strs(xs) — builds a new list in reverse order.
fn reverse_strs(xs: list[str]) -> list[str] {
    let out: list[str] = []
    let mut i: int = xs.len() - 1
    while i >= 0 {
        out.push(xs.get(i))
        i = i - 1
    }
    return out
}

# contains_int(xs, want) — linear search with an early return.
fn contains_int(xs: list[int], want: int) -> bool {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) == want {
            return true
        }
        i = i + 1
    }
    return false
}

# second_of(xs) — indexing with a guard branch; the corner pool's
# empty list hits the fallback on both backends identically.
fn second_of(xs: list[int]) -> int {
    if xs.len() < 2 {
        return 0 - 1
    }
    return xs.get(1)
}
