# crashy.hls — the Stage 134 gate package: the guaranteed panic. The
# division's divisor is provably zero on EVERY corner, so the smoke
# class is panic and the seed STAYS (a panic is a legitimate
# differential observable, matched class-for-class by the native
# side: hosted panic is 101 on both).

fn crashy(b: int) -> int {
    let z: int = b - b
    return 10 / z
}
