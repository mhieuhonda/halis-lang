# pure_math.hls — the Stage 134 gate package: recursive and
# scalar-arithmetic entry candidates.
#
# gcd is the classic recursion shape (self-call, two int params);
# isqrt is Newton's method with a while loop and float-free integer
# arithmetic; lerp and clamp3 exercise the float and bool channels.
# Every function here is pure and self-contained — the whole module
# is seedable, and the gate pins exact seeds for these names.

# gcd(a, b) — Euclid's algorithm, the smallest honest recursion.
fn gcd(a: int, b: int) -> int {
    let mut x: int = a
    let mut y: int = b
    while y != 0 {
        let t: int = y
        y = x % y
        x = t
    }
    if x < 0 {
        return 0 - x
    }
    return x
}

# isqrt(n) — integer square root by Newton iterations, floor form.
fn isqrt(n: int) -> int {
    if n <= 1 {
        return n
    }
    let mut x: int = n
    let mut y: int = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

# lerp(a, b, t) — linear interpolation on the float channel. The
# differential oracle compares the two backends' float RENDERINGS;
# they agree byte for byte on printf's %f, so this is a legal seed.
fn lerp(a: float, b: float, t: float) -> float {
    return a + (b - a) * t
}

# clamp3(v, lo, hi) — three-way branch on the bool channel.
fn clamp3(v: int, lo: int, hi: int) -> int {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}
