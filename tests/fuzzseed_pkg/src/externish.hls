# externish.hls — the Stage 134 gate package: the import boundary.
#
# shout calls str_reverse, which resolves ONLY through the import of
# std.str. The seeder refuses cross-module closures by name — the
# single-file harness would either need the import inlined (a std
# module is not a seed) or fail the checker.

import "std.str"

fn shout(s: str) -> str {
    return str_reverse(s)
}
