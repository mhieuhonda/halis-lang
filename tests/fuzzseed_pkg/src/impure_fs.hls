# impure_fs.hls — the Stage 134 gate package: the declaration refusal.
#
# The body is trivially pure, but the fn DECLARES the Fs effect — the
# declaration law refuses the seed before any execution question can
# even be asked. Declared worlds are refused as loudly as used ones.

fn file_touch_count() -> int uses Fs {
    let mut n: int = 0
    let mut i: int = 0
    while i < 3 {
        n = n + i
        i = i + 1
    }
    return n
}
