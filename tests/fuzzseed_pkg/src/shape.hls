# shape.hls — the Stage 134 gate package: enum + match closure.
#
# Shape carries payloads; area_of drives it through a match; the
# enum-variant constructor call (`Shape.Circle(r)`) is the syntax the
# closure must distinguish from a module-qualified call — the type
# name resolves IN this file, so it is a constructor, not a boundary.

enum Shape {
    Circle(int),
    Box(int, int),
    Spot,
}

# area_of(s) — the match arms read the payloads; the Spot arm is the
# zero-case every enum deserves.
fn area_of(s: Shape) -> int {
    return match s {
        Shape.Circle(r) => 3 * r * r,
        Shape.Box(w, h) => w * h,
        Shape.Spot => 0,
    }
}

# make_circle(r) — constructs the enum through the variant path.
fn make_circle(r: int) -> Shape {
    return Shape.Circle(r)
}

# perimeter_of_demo() — a second match over the same enum, built on a
# locally-constructed value: the pattern names the enum (a type
# mention the closure must honor) and the arms bind its payloads.
fn perimeter_of_demo() -> int {
    let s: Shape = Shape.Box(3, 4)
    return match s {
        Shape.Circle(r) => 6 * r,
        Shape.Box(w, h) => 2 * (w + h),
        Shape.Spot => 0,
    }
}
