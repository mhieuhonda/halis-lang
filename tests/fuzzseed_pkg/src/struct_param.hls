# struct_param.hls — the Stage 134 gate package: the synthesis
# refusal. Area takes a custom struct; the seeder does not invent
# struct values (field-by-field construction is knowledge the
# signature does not carry), so the entry is refused by name.

struct Rect {
    w: int,
    h: int,
}

fn area_of_rect(r: Rect) -> int {
    return r.w * r.h
}
