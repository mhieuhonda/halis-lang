# spin.hls — the Stage 134 gate package: the guaranteed hang. The
# smoke run times out and the seed is refused (a hanging seed is
# wasted fuzz time) unless --keep-timeouts lifts the refusal.

fn spin_forever(n: int) -> int {
    let mut i: int = 0
    while i >= 0 {
        i = i + 1
    }
    return i + n
}
