# fail_stage84_section_reserved.hls — Stage 84: ".text" is placed by the
# Halis C backend itself. Handing it to a linker script would move the
# program's own code out from under the runtime, so the compilers name
# the conflict and suggest a name of the author's own.
#[section(".text")]
fn stub(x: int) -> int pure {
    return x
}

fn main() -> int {
    return stub(1)
}
