# fail_uaf_break_revive.hls — deep-scan-28: a `break` edge must not be
# erased by a later revive in the loop body. On the break path `xs` is
# still moved (take() nulled the native local), so the post-loop read
# would dereference NULL. The break-edge snapshot union (boot checker
# + hlc checker, in parity) rejects the read.
fn main() -> int {
    let mut xs: list[int] = [7]
    let mut i: int = 0
    while i < 3 {
        i = i + 1
        let _: list[int] = take(xs)
        if i > 1 { break }
        xs = [9]
    }
    let y: list[int] = xs
    return y.len()
}
