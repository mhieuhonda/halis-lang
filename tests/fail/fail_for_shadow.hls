# fail_for_shadow.hls — deep-scan-5 regression: the for-loop variable
# silently shadowed outer bindings (the `let` branch rejected shadowing
# but the `for` branch never checked — SPEC §4: no shadowing).
fn main() -> int {
    let x: int = 5
    let xs: list[int] = [1, 2, 3]
    for x: int in xs {
        println(x.to_str())
    }
    return x
}
