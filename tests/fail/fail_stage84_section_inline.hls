# fail_stage84_section_inline.hls — Stage 84: an always-inlined function
# emits no body to place, so #[section] and #[inline(always)] contradict
# each other. The check is order-independent.
#[section(".text.boot")]
#[inline(always)]
fn stub(x: int) -> int pure {
    return x
}

fn main() -> int {
    return stub(1)
}
