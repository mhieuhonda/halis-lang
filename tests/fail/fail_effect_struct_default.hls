# fail_effect_struct_default — Stage deep-scan-4: struct field DEFAULT
# expressions are evaluated at each construction (in the calling context),
# so their effects flow into every function that constructs the struct
# (BUG-DS4-2). A default that performs IO requires constructors to declare
# IO. Previously checking a default that called a function crashed the
# checker with `KeyError: None` (an internal error, not a compile error);
# after the fix the effect propagates properly.
fn banner(text: str) -> int uses IO {
    println("[" + text + "]")
    return 0
}

struct Widget {
    label: str,
    shown: int = banner("default widget")
}

fn main() -> int {
    # Constructing Widget evaluates the default (IO) — main must declare IO.
    let w: Widget = Widget { label: "w" }
    return w.shown
}
