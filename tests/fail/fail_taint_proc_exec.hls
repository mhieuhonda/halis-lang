# tests/fail/fail_taint_proc_exec.hls — Stage 9 release (v0.20.0-alpha).
#
# proc_exec is a TAINT SINK. Passing a tainted command (e.g. from
# argv) is a shell-injection vector — an attacker who controls the
# command can run arbitrary shell code in the program's privilege
# context. The checker must reject this at compile time.

fn main() -> int uses IO, Proc {
    let argv: list[tainted[str]] = tainted_args()
    if argv.len() < 2 {
        println("usage: test <command>")
        return 1
    }
    # Must be rejected: tainted command → shell injection.
    let rc: int = proc_exec(argv.get(1))
    println("rc=" + rc.to_str())
    return 0
}
