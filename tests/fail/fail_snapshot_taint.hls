# fail_snapshot_taint.hls — Stage 119: a tainted value cannot be
# snapshotted. assert_snapshot's value parameter flows into println (a
# taint sink), so a tainted argument is rejected at the call site with
# a type error naming the parameter: sanitise the value (std.sanitize)
# or unwrap it explicitly (taint_unwrap) before pinning it. A snapshot
# is exactly the kind of place untrusted data must not flow into
# silently — it would freeze attacker-controlled bytes as the expected
# output.

import "std.test"

fn main() -> int uses IO {
    let t: tainted[str] = taint_mark("untrusted")
    assert_snapshot("leak", t)
    return 0
}
