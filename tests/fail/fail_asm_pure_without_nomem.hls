# fail_asm_pure_without_nomem.hls — Stage 27 perfection (v0.50.2-alpha)
# deep-scan-17 negative test: the checker must REJECT an asm! with
# `options(pure)` but without `options(nomem)`.
#
# `pure` says the asm has no side effects beyond its outputs. The
# default clobber list includes `"memory"` (the asm may read/write
# memory). These are contradictory: a memory-touching asm IS a
# side effect, so gcc cannot elide it even if the outputs are
# unused — making `pure` a lie that produces surprising codegen.
#
# Rust's `asm!` requires `pure` to be paired with `nomem`; we
# follow the same rule for soundness.

fn bad() -> int {
    let mut x: int = 0
    asm!("nop", out(reg) x, options(pure))
    return x
}

fn main() -> int uses IO {
    return 0
}
