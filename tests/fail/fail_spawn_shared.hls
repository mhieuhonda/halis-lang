# fail_spawn_shared.hls — Stage 16 acceptance criterion: a program that
# tries to share a variable with a task OUTSIDE a channel must be a
# COMPILE ERROR (data-race freedom).
fn worker(s: str) -> int {
    return s.len()
}
fn main() -> int uses IO, Conc {
    let s: str = "shared"
    let t: Task[int] = spawn(worker, s)
    return 0
}
