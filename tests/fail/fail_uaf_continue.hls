# fail_uaf_continue.hls — deep-scan-28: a `continue` edge feeds its
# moved-state into the NEXT iteration. `xs` is moved on the continue
# path, so on iteration >= 2 the read before the revive point uses a
# nulled binding. The continue-edge re-analysis (boot checker + hlc
# checker, in parity) rejects the read.
fn main() -> int {
    let mut xs: list[int] = [7]
    let mut i: int = 0
    while i < 3 {
        i = i + 1
        let a: list[int] = xs
        if i > 1 {
            let _: list[int] = take(xs)
            continue
        }
        xs = [9]
    }
    return 0
}
