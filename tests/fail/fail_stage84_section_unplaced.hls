# fail_stage84_section_unplaced.hls — Stage 84: a `#[section]` the script
# never places is the classic silent failure — the linker treats the
# function as an orphan input section, or drops it under --gc-sections.
# The compiler reads the script and names the section it wanted.
#![link_script("../stage84/place.ld")]

#[section(".text.boot_stub")]
fn boot_stub(x: int) -> int pure {
    return x
}

#[section(".device")]
fn rng(x: int) -> int pure {
    return x
}

#[section(".elsewhere.thing")]
fn elsewhere(x: int) -> int pure {
    return x
}

fn main() -> int {
    return boot_stub(1) + rng(2) + elsewhere(3)
}
