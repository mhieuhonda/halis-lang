# The spawned fn IS a callee: its IO effect must reach the spawner
# (deep-scan-10: only b:spawn was recorded, so a uses Conc main could
# transitively print).
fn worker() -> int uses IO {
    println("side effect")
    return 1
}
fn main() -> int uses Conc {
    let t: Task[int] = spawn(worker)
    return t.join()
}
