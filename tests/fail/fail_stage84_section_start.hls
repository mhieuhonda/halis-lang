# fail_stage84_section_start.hls — Stage 84: a section name must start
# with '.', '_' or a letter. A leading digit is rejected because "0text"
# reads as a linker expression rather than a section name.
#[section("0text")]
fn stub(x: int) -> int pure {
    return x
}

fn main() -> int {
    return stub(1)
}
