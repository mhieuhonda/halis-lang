# fail_chan_new_effect.hls — deep-scan-25 regression: chan_new() never
# registered its Conc effect edge in the boot checker (the
# BUILTIN_EFFECTS entry existed but the call-graph edge was missing),
# so a pure function could create channels — a hole the self-hosted
# compiler never had. This program MUST be rejected.
fn mkchan() -> Chan[int] {
    return chan_new()
}
fn main() -> int {
    let c: Chan[int] = mkchan()
    return 0
}
