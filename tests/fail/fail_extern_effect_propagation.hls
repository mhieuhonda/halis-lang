# BUG-SC-1 regression: a function calling an extern fn declared `uses IO`
# must itself declare `uses IO` (or a superset). The extern's declared
# effects propagate through the effects fixpoint.
extern "C" {
    fn helper_puts(s: str) -> int uses IO
}

fn caller_no_effect() -> int {
    # caller_no_effect has NO `uses` clause, so it is implicitly pure.
    # Calling helper_puts (which declares `uses IO`) must be rejected.
    return helper_puts("hi")
}

fn main() -> int {
    return caller_no_effect()
}
