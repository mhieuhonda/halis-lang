# Stage 109: an #[taint_source] extern's result is tainted[str] —
# printing it is a taint-sink violation, exactly like printing any
# other tainted value. The value must be sanitised or unwrapped first.
extern "C" {
    #[taint_source]
    fn dirname(p: str) -> str uses IO
}

fn main() -> int uses IO {
    let raw: tainted[str] = dirname("project/bin/tool.hls")
    println(raw)
    return 0
}
