# tests/fail/fail_taint_net_lookup.hls — Stage 9 release (v0.20.0-alpha).
#
# net_lookup is a TAINT SINK. Passing a tainted host (e.g. from
# argv) is a DNS-rebinding vector — an attacker who controls the
# host can make the program connect to a different IP than the
# user intended. The checker must reject this at compile time.

fn main() -> int uses IO, Net {
    let argv: list[tainted[str]] = tainted_args()
    if argv.len() < 2 {
        println("usage: test <host>")
        return 1
    }
    # Must be rejected: tainted host → DNS rebinding.
    let ip: str = net_lookup(argv.get(1))
    println("ip=" + ip)
    return 0
}
