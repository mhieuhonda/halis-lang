# fail_tail_call_asm.hls — deep-scan-28: asm! operand expressions must
# go through the #[tail_call] verifier like every other statement. A
# recursive self-call hidden in an asm operand is NOT in tail position
# (it compiles to a real recursive call that grows the stack), so the
# verifier must reject the function. `let r = loopn(n + 1)` in the same
# position is already rejected; the asm operand used to slip through.
#[tail_call]
fn loopn(n: int) -> int {
    if n > 100 { return n }
    asm!("nop", in("eax") loopn(n + 1))
    return loopn(n + 1)
}
fn main() -> int {
    return loopn(0)
}
