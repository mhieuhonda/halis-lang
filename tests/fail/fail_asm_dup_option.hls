# fail_asm_dup_option.hls — Stage 27 perfection (v0.50.2-alpha)
# deep-scan-17 negative test: the checker must REJECT an asm! with
# the same option name appearing twice in the options list.
#
# Without this check, `options(nomem, nomem)` is silently accepted
# (duplicates are a no-op semantically), but it's almost always a
# typo — the user probably meant `options(nomem, preserves_flags)`
# or similar. Rejecting duplicates gives the user an early signal.

fn bad() -> void {
    asm!("nop", options(nomem, nomem))
}

fn main() -> int uses IO {
    return 0
}
