# tests/fail/fail_taint_net_tcp_connect.hls — Stage 37 (v0.56.0-alpha).
#
# Verifies the checker rejects passing a tainted[str] host to
# net_tcp_connect(). A tainted host enables SSRF + DNS rebinding
# (an attacker who controls the host can make the program connect to
# a different IP than the user intended). The user must sanitise via
# sanitize_command from std.sanitize, or taint_unwrap to accept the
# risk.

fn main() -> int uses IO, Net, Args {
    let args: list[tainted[str]] = tainted_args()
    if args.len() < 2 {
        println("usage: program <host>")
        return 1
    }
    let host: tainted[str] = args.get(1)
    # Passing tainted[str] directly to net_tcp_connect should fail.
    let fd: int = net_tcp_connect(host, 80)
    net_close(fd)
    return 0
}
