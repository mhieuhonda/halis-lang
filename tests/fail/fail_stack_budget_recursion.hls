# fail_stack_budget_recursion.hls — Stage 82: a deterministic stack
# size is impossible when a recursion cycle exists (the depth depends
# on the input), so `#![stack_size(N)]` rejects any call cycle — even
# one the programmer believes is bounded. Rejected in BOTH compilers.
#![stack_size(1048576)]

fn shrink(n: int) -> int {
    if n <= 0 {
        return 0
    }
    return shrink(n - 1)
}

fn main() -> int {
    return shrink(3)
}
