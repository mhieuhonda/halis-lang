# fail_qmark_ok_ambig.hls — deep-scan-24 regression: an enum declaring
# BOTH 'Ok(P)' and 'Some(P)' made the ? operator's ok-variant scan
# silently keep only the LAST one (the mirror of the deep-scan-5
# Err/None ambiguity). A checker-clean program then panicked at runtime
# ("? operator: enum value matched neither ok nor err variant") on a
# value of the other ok variant. The checker now rejects the
# ok-variant ambiguity the same way it rejects the error-variant one.
struct P {
    x: int
}

enum W {
    Ok(P),
    Some(P),
    Err(str)
}

fn g(e: W) -> W {
    let p: P = e?
    return W.Some(p)
}

fn main() -> int {
    return 0
}
