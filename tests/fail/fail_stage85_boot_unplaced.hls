# fail_stage85_boot_unplaced.hls — Stage 85: the emitted header lands in
# its own output section, and a linker script that does not KEEP it
# drops the exact bytes a firmware scans for. A bootloader that finds
# nothing simply refuses to boot, with no diagnostic anywhere — so the
# Stage 84 placement check is pointed at this one section.
#![freestanding]
#![link_script("no_boot_sections.ld")]
#![boot_header(multiboot2)]

fn main() -> int {
    return 0
}
