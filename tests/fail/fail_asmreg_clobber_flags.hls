# fail_asmreg_clobber_flags.hls — Stage 83: flag effects are controlled
# by options(preserves_flags), never by the clobber list. The default
# clobber list ALWAYS contains "cc" (unless preserves_flags removes
# it), so an explicit clobber("cc") entry is either redundant or — as
# here, under options(preserves_flags) — a flat contradiction. Both
# compilers reject the entry with the option that owns the effect.
fn main() -> int {
    let mut x: int = 0
    asm!("nop", out("rax") x, clobber("cc"), options(preserves_flags, nomem))
    return x
}
