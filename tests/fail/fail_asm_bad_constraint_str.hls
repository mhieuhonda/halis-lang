# fail_asm_bad_constraint_str.hls — Stage 27 perfection (v0.50.2-alpha)
# deep-scan-17 negative test: the checker must REJECT an asm! operand
# whose string-form constraint is not a recognised x86-64 register name
# or GCC constraint letter.
#
# Without this check (the deep-scan-17 fix), `out("exa") x` would
# pass the HLS checker, reach GCC as `"=exa"(x)`, and produce an
# opaque C compile error with no source-line attribution. With the
# fix, the user gets a clear HLS error pointing at the offending
# constraint.

fn bad() -> void {
    let mut x: int = 0
    asm!("nop", out("exa") x)
}

fn main() -> int uses IO {
    return 0
}
