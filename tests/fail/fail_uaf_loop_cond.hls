# fail_uaf_loop_cond.hls — deep-scan-28: the loop condition re-evaluates
# on every iteration but was only checked against the ENTRY state. After
# the first body pass moves `xs`, iteration 2's `xs.len()` reads a nulled
# binding (and the boot interpreter hangs). The post-body condition
# re-check (boot checker + hlc checker, in parity) rejects the program.
fn main() -> int {
    let mut xs: list[int] = [7, 3]
    while xs.len() > 0 {
        let _: list[int] = take(xs)
    }
    return 0
}
