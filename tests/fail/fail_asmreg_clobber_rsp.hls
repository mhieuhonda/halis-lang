# fail_asmreg_clobber_rsp.hls — Stage 83: the stack pointer is owned by
# the compiler (and the C runtime). A clobber claim on rsp/esp/sp/spl
# is a lie that would break every stack reference the compiler emits;
# an asm block that really moves rsp must restore it before falling
# through and needs no clobber entry.
fn main() -> int {
    asm!("nop", clobber("rsp"))
    return 0
}
