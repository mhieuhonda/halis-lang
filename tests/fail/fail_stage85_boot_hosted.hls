# fail_stage85_boot_hosted.hls — Stage 85: a boot header only means
# something in an image the firmware loads itself. A hosted image is
# linked with a libc that owns `_start`, so a header in it is
# decoration; the compiler says so instead of letting a kernel author
# find out at boot.
#![boot_header(multiboot2)]

fn main() -> int {
    return 0
}
