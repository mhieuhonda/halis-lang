# tests/fail/fail_taint_env_get.hls — Stage 48 (v0.67.0-alpha).
#
# env_get's key argument (arg 0) is a taint sink — a tainted key
# enables information disclosure (an attacker who controls the key
# can learn which env vars exist by observing behaviour). The
# checker rejects a tainted key at compile time.

fn read_arg_env(key: tainted[str]) -> str uses Proc {
    return env_get(key)
}

fn main() -> int uses IO, Proc, Args {
    let t: list[tainted[str]] = tainted_args()
    let key: tainted[str] = t.get(0)
    let v: str = read_arg_env(key)
    println("v=" + v)
    return 0
}
