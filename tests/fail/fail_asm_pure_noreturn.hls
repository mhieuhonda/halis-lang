# fail_asm_pure_noreturn.hls — Stage 27 perfection (v0.50.2-alpha)
# deep-scan-17 negative test: the checker must REJECT an asm! that
# specifies both `pure` and `noreturn` — these are contradictory.
#
#   `pure`     — the asm has no side effects beyond its outputs and
#                may be elided by gcc if the outputs are unused.
#   `noreturn` — the asm does not fall through; code after it is dead.
#
# A pure-noreturn asm would either be elided (silently turning a
# noreturn into a return — a SOUNDNESS BUG if the asm was guarding
# a security boundary like `hlt`) or execute (contradicting pure).
# Rust's `asm!` rejects this combination too; we follow the same
# rule.

fn bad() -> void {
    asm!("hlt", options(pure, noreturn, nomem))
}

fn main() -> int uses IO {
    return 0
}
