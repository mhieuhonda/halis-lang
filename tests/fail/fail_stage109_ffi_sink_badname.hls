# Stage 109: every #[taint_sink(...)] name must resolve to the
# extern's own parameter list — a typo'd name would declare a sink
# that sinks nothing, hiding the hazard it exists to name.
extern "C" {
    #[taint_sink(comand)]
    fn system(cmd: str) -> int uses IO
}

fn main() -> int uses IO {
    let rc: int = system("ls")
    println(rc.to_str())
    return 0
}
