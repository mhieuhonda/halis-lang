# fail_drop_in_loop_iter.hls — Stage 8-beta: drop() inside a for-in
# iterable is rejected for the same reason as take() in a loop condition
# (see fail_take_in_loop_cond.hls).
fn main() -> int uses IO {
    let xs: list[int] = [1, 2, 3]
    for v: int in after_drop(xs) {
        println(v.to_str())
    }
    return 0
}

fn after_drop(xs: list[int]) -> list[int] {
    drop(xs)
    return xs
}
