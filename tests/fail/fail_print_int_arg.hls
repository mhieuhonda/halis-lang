# fail_print_int_arg.hls — deep-scan-8 regression: print(42) must be rejected
#
# Before deep-scan-8: print(42) compiled cleanly and crashed at runtime with
# "TypeError: a bytes-like object is required, not 'int'" because the checker's
# reject_tainted_at_sink() only checked for taint, not for type mismatch.
#
# After deep-scan-8: the checker now validates that sink builtins (print,
# println, read_file, write_file, exit, etc.) receive arguments of the
# correct type at compile time.

fn main() -> int uses IO {
    print(42)
    return 0
}
