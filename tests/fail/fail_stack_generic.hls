# Stage 30: #[stack] is not supported inside generic functions yet
# (the layout would depend on the type instantiation).
fn pick[T](a: T, b: T) -> T {
    #[stack]
    let order: list[int] = [0, 1]
    if order.get(0) == 0 {
        return a
    }
    return b
}
fn main() -> int {
    return pick[int](1, 2)
}
