# fail_asmreg_float_gp.hls — Stage 83: a float operand needs an SSE
# register. GP registers cannot hold a double, and the old lowering
# emitted GCC's "r" constraint for floats (an opaque "inconsistent
# constraint" C error with no source attribution). The checker now
# rejects GP names/classes for floats and points at the SSE class.
fn main() -> int {
    let mut v: float = 1.5
    asm!("nop", in("rax") v, options(nomem))
    return 0
}
