# fail_asm_in_prefix_constraint.hls — Stage 27 perfection (v0.50.2-alpha)
# deep-scan-17 negative test: the checker must REJECT an asm! with
# a string-form constraint that has an `=` or `+` direction prefix
# but is used with the `in` direction.
#
# In GCC's extended-asm syntax, `=` means write-only output and `+`
# means read-write output. Input operands have NO prefix. A constraint
# like `in("=r") x` is therefore contradictory: the `=` says the operand
# is write-only, but `in` says it's an input (read-only). Without this
# check, the malformed constraint silently reaches GCC and produces
# a confusing error like "input operand with constraint '=r' is not
# allowed".

fn bad() -> void {
    let mut x: int = 0
    asm!("nop", in("=r") x)
}

fn main() -> int uses IO {
    return 0
}
