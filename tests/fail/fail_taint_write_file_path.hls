# fail_taint_write_file_path.hls — Stage 10-alpha: tainted path in write_file.
# The path argument to write_file is a sink — passing a tainted[str] is
# a path-traversal attack vector. The checker must reject.

fn main() -> int uses Fs {
    let t: tainted[str] = taint_mark("/etc/passwd")
    write_file(t, "pwned")
    return 0
}
