# fail_stage84_section_long.hls — Stage 84: a section name is capped at
# 64 bytes. A longer name is a mistake, and an unbounded name is a
# denial-of-service vector in the C string literal the attribute lowers
# to.
#[section(".text.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")]
fn stub(x: int) -> int pure {
    return x
}

fn main() -> int {
    return stub(1)
}
