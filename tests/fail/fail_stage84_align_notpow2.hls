# fail_stage84_align_notpow2.hls — Stage 84: #[align(N)] must be a power
# of two. gcc's `aligned` attribute silently ROUNDS a non-power-of-two
# up, so accepting one would place the function at an alignment the
# author never asked for — the rule is stated, not approximated.
#[align(48)]
fn stub(x: int) -> int pure {
    return x
}

fn main() -> int {
    return stub(1)
}
