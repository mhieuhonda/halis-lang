# fail_effect_method — Stage deep-scan-4: method calls participate in the
# effects call graph (BUG-DS4-1). A function that calls an IO-using METHOD
# must itself declare the IO effect. Previously method calls added NO edge
# to the call graph, so the entire capability system could be bypassed by
# moving an effectful call into a method.
struct Greeter {
    name: str
}

impl Greeter {
    fn hello(self: Greeter) -> int uses IO {
        println("hello " + self.name)
        return 0
    }
}

fn main() -> int {
    let g: Greeter = Greeter { name: "hieu" }
    # main calls an IO-using method without declaring IO — must be rejected.
    return g.hello()
}
