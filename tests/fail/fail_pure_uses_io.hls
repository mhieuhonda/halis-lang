# fail_pure_uses_io.hls — `pure` function that calls an effectful builtin
# should be rejected by the capability check.
fn impure(x: int) -> int pure {
    # Calling println (IO effect) from a `pure` function must fail.
    println("debug: " + x.to_str())
    return x + 1
}

fn main() -> int uses IO {
    let x: int = impure(5)
    return 0
}
