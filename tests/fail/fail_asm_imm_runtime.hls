# fail_asm_imm_runtime.hls — Stage 27 perfection (v0.50.3-alpha)
# deep-scan-18 negative test: the checker must REJECT an asm! with
# `in(imm)` constraint on a RUNTIME expression (a non-constant).
#
# GCC's `i` constraint requires the operand to be a compile-time
# constant. Without this check, `in(imm) some_var` was accepted by
# the HLS checker and reached GCC as `"i"(some_var)`, producing an
# opaque "impossible constraint" error with no source-line
# attribution. Now the user gets a clear HLS error suggesting `reg`
# instead.
#
# Note: `in(imm) 42` (integer literal) IS accepted — see
# tests/ok/feat_stage27_perfection2.hls `asm_imm_literal_ok`.

fn bad(x: int) -> void {
    asm!("mov ${0}, {0}", in(imm) x)
}

fn main() -> int uses IO {
    return 0
}
