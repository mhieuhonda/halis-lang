# A computed (non-literal) panic argument: the concatenation creates
# refcounted temporaries needing cleanup at the jump. Must be rejected.
#[tail_call]
fn f(n: int) -> int {
    if n < 0 {
        return panic("negative: " + n.to_str())
    }
    if n == 0 {
        return 0
    }
    return f(n - 1)
}

fn main() -> int {
    return f(10)
}
