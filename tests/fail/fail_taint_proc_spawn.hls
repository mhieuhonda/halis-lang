# tests/fail/fail_taint_proc_spawn.hls — Stage 47 (v0.66.0-alpha).
#
# proc_spawn's program argument (arg 0) is a taint sink — a tainted
# program enables command injection (an attacker who controls the
# program name can run an arbitrary executable in the program's
# privilege context). The checker rejects a tainted program at
# compile time. Use `sanitize_command` from std.sanitize, or
# `taint_unwrap()` if you accept the risk.

import "std.taint"

fn run_arg_program(prog: tainted[str]) -> int uses Proc {
    let empty_args: list[str] = []
    let pid: int = proc_spawn(prog, empty_args, 0, 0, 0)
    return proc_wait(pid)
}

fn main() -> int uses IO, Proc, Args {
    let t: list[tainted[str]] = tainted_args()
    let prog: tainted[str] = t.get(0)
    let rc: int = run_arg_program(prog)
    println("rc=" + rc.to_str())
    return 0
}
