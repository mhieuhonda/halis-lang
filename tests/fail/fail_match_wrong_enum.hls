# This should fail: match arm has wrong enum name.
enum Color {
    Red,
    Green,
    Blue
}

enum Shape {
    Circle(float)
}

fn color_name(c: Color) -> str {
    return match c {
        Color.Red => "red",
        Color.Green => "green",
        Color.Blue => "blue",
        Shape.Circle(_) => "shape"
    }
}

fn main() -> int {
    return 0
}
