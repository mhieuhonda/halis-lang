# tests/fail/fail_taint_cwd_set.hls — Stage 48 (v0.67.0-alpha).
#
# cwd_set's path argument (arg 0) is a taint sink — a tainted path
# enables directory traversal (an attacker who controls the path can
# cd to /etc/passwd or a sensitive directory). The checker rejects
# a tainted path at compile time.

fn cd_to_tainted(path: tainted[str]) -> int uses Proc {
    return cwd_set(path)
}

fn main() -> int uses IO, Proc, Args {
    let t: list[tainted[str]] = tainted_args()
    let path: tainted[str] = t.get(0)
    let rc: int = cd_to_tainted(path)
    println("rc=" + rc.to_str())
    return 0
}
