# tests/fail/fail_taint_env_set.hls — Stage 48 (v0.67.0-alpha).
#
# env_set's key argument (arg 0) is a taint sink — a tainted key
# enables env injection (an attacker who controls the key can set
# LD_PRELOAD / PATH / IFS / ...). The checker rejects a tainted
# key at compile time. The VALUE (arg 1) is NOT a sink (the user
# is the origin of the value they're setting).

fn set_arg_env(key: tainted[str]) -> void uses Proc {
    env_set(key, "value")
}

fn main() -> int uses IO, Proc, Args {
    let t: list[tainted[str]] = tainted_args()
    let key: tainted[str] = t.get(0)
    set_arg_env(key)
    return 0
}
