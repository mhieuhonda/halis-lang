# fail_effect_transitive_fs — Stage 9-alpha: a function with no `uses` clause
# transitively calls a function that declares `uses Fs`. Even though the
# callee DECLARES Fs, the CALLER still needs to declare Fs (or IO blanket).
fn read_first_line(path: str) -> str uses Fs {
    return read_file(path)
}

fn middleman(path: str) -> str {
    # No `uses` clause — pure by default — but calls read_first_line (Fs).
    return read_first_line(path)   # error: requires effect 'Fs' not declared
}

fn main() -> int uses IO {
    println(middleman("examples/data.txt"))
    return 0
}
