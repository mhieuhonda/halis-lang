# fail_asm_imm_out.hls — Stage 27 perfection (v0.50.2-alpha)
# deep-scan-17 negative test: the checker must REJECT an asm! with
# an `imm` constraint on a non-`in` operand.
#
# `imm` is GCC's immediate-constant constraint: the operand must be
# a compile-time constant. You can't WRITE to a constant, so
# `out(imm) x` / `inout(imm) x` / `late_out(imm) x` are all
# nonsensical. Without this check, the HLS checker would accept
# the code and GCC would emit an opaque "impossible constraint" or
# "output operands imply a non-constant value" error with no
# source-line attribution.

fn bad() -> int {
    let mut x: int = 0
    asm!("nop", out(imm) x)
    return x
}

fn main() -> int uses IO {
    return 0
}
