# fail_stage86_irq_ret.hls — Stage 86: a handler returns through IRETQ,
# so it must return void. Returning int leaves a value in a register the
# CPU never reads, and the caller resumes with a garbage frame.
#[irq_handler(14)]
fn handler(frame: list[int]) -> int {
    return 0
}

fn main() -> int {
    return 0
}
