# fail_stream_close_nonint.hls — deep-scan-25 regression: stream_close
# sends the INT64_MIN sentinel in BOTH backends, so closing a non-int
# stream type-confuses the receiver (interpreter: raw traceback; native:
# the bogus integer reaches the element type's release helper). The
# checker now rejects it — non-int producers send their own sentinel
# via stream_send. This program MUST be rejected.
fn main() -> int uses Conc {
    let st: Stream[str] = stream_new(4)
    stream_close(st)
    return 0
}
