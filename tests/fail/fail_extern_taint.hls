# Stage 15 release: passing tainted data across the FFI boundary
# must be rejected at check time. A tainted[str] passed to `system()`
# is a shell-injection vector; a tainted[int] is a command-flag
# injection vector.

extern "C" {
    fn system(cmd: str) -> int uses IO
}

fn main() -> void uses IO {
    let argv: list[tainted[str]] = tainted_args()
    let tainted_cmd: tainted[str] = argv.get(0)
    # This SHOULD be a compile error:
    let rc: int = system(tainted_cmd)
    println(rc.to_str())
}
