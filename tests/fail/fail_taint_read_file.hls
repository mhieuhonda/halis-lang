# fail_taint_read_file.hls — Stage 10-alpha: tainted path in read_file.
# A tainted path could allow an attacker to read arbitrary files
# (path-traversal / symlink attack). The checker must reject.

fn main() -> int uses Fs, IO {
    let t: tainted[str] = taint_mark("/etc/shadow")
    let contents: str = read_file(t)
    println(contents)
    return 0
}
