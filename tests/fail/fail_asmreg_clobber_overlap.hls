# fail_asmreg_clobber_overlap.hls — Stage 83: a clobbered register
# cannot also be bound to an operand. GCC's clobber list tells the
# compiler "this register is destroyed and holds nothing of yours";
# rebinding it as an input would read a destroyed value, and as an
# output would be overwritten by the clobber. Both compilers reject
# the overlap statically.
fn main() -> int {
    let mut x: int = 7
    asm!("nop", in("rax") x, clobber("rcx", "rax"), options(nomem))
    return x
}
