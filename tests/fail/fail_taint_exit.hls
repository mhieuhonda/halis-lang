# fail_taint_exit.hls — Stage 10-alpha: tainted value in exit().
# The exit code is a sink — a tainted exit code could let an attacker
# control process exit status, which other scripts may branch on.

fn main() -> int uses Exit, IO {
    let t: tainted[str] = taint_mark("42")
    # We need an int; convert after unwrap. But to demonstrate the taint
    # rule, we'll need a tainted int — let's use taint_mark on a str-to-int
    # conversion... actually, the cleaner way: a tainted[int] via taint_mark.
    let tainted_int: tainted[int] = taint_mark(42)
    exit(tainted_int)
    return 0
}
