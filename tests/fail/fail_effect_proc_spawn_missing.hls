# tests/fail/fail_effect_proc_spawn_missing.hls — Stage 47 (v0.66.0-alpha).
#
# A function WITHOUT `uses Proc` cannot call proc_spawn(). The
# capability system enforces `declared ⊇ computed` per the fixpoint;
# the compile error names the function, the missing effect, the
# violating callee, and the declared set.

fn spawn_insecure(program: str) -> int {
    let empty_args: list[str] = []
    let pid: int = proc_spawn(program, empty_args, 0, 0, 0)
    return proc_wait(pid)
}

fn main() -> int uses IO {
    let rc: int = spawn_insecure("true")
    println("rc=" + rc.to_str())
    return 0
}
