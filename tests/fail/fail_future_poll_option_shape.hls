# fail_future_poll_option_shape.hls — deep-scan-25 regression: the
# runtime hard-codes the built-in Option shape (Some/None variant
# names), but the checker accepted a user-defined enum Option with a
# different shape — the program type-checked and then NEVER matched at
# runtime ("match: no arm matched"). The checker now validates the
# Option shape at every future_poll call site. This program MUST be
# rejected.
enum Option[T] {
    Ok(T), Err
}
fn main() -> int uses Conc {
    let fut: Future[int] = future_ready(5)
    let r: Option[int] = future_poll(fut)
    return 0
}
