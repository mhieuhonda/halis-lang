# fail_extern_effect_missing.hls — deep-scan-5 regression: extern "C" fns
# bypassed the effects/capability check entirely. The fixpoint unioned the
# extern's DECLARED effects into the caller's computed set, but the
# enforcement loop looked for a witness via the extern's computed set
# (always empty) — so --check said OK while --audit printed VIOLATION.
extern "C" {
    fn strlen(s: str) -> int uses IO
}

fn main() -> int {
    let n: int = strlen("hello")
    return n
}
