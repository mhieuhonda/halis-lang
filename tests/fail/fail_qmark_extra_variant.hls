# fail_qmark_extra_variant.hls — deep-scan-5 regression: `?` on an enum
# with a THIRD variant (beyond Ok/Err) was checker-clean but guaranteed
# a runtime panic ("matched neither ok nor err variant") — and the native
# codegen read garbage union bytes. The checker now rejects it.
enum E {
    Ok(int),
    Err(str),
    Weird
}

fn g(e: E) -> E {
    let v: int = e?
    return E.Ok(v)
}

fn main() -> int {
    return 0
}
