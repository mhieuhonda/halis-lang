# tests/fail/fail_taint_env_set_var.hls — Stage 48 (v0.67.0-alpha).
#
# env_set_var (the stdlib wrapper in std/env.hls) takes a plain `str`
# for the key argument — passing a `tainted[str]` is a compile error
# (type-level taint enforcement, as the roadmap promised). This is
# in addition to the underlying env_set builtin being a taint sink
# (see fail_taint_env_set.hls).

import "std.env"

fn set_arg_env_var(key: tainted[str]) -> void uses Proc {
    env_set_var(key, "value")
}

fn main() -> int uses IO, Proc, Args {
    let t: list[tainted[str]] = tainted_args()
    let key: tainted[str] = t.get(0)
    set_arg_env_var(key)
    return 0
}
