# fail_asmreg_clobber_subreg.hls — Stage 83: clobbers must name the
# full 64-bit register. GCC treats a sub-register clobber as clobbering
# the whole register and newer GCC versions reject the narrow spelling,
# so the checker requires "rax" and rejects "eax"/"ax"/"al" up front
# (with the correct spelling in the message).
fn main() -> int {
    asm!("nop", clobber("eax"))
    return 0
}
