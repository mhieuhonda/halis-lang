# tests/fail/fail_effect_proc_missing.hls — Stage 9 release (v0.20.0-alpha).
#
# A function WITHOUT `uses Proc` cannot call proc_exec(). The
# capability system enforces `declared ⊇ computed` per the fixpoint;
# the compile error names the function, the missing effect, the
# violating callee, and the declared set.

fn run_insecure(cmd: str) -> int {
    return proc_exec(cmd)
}

fn main() -> int uses IO {
    let rc: int = run_insecure("true")
    println("rc=" + rc.to_str())
    return 0
}
