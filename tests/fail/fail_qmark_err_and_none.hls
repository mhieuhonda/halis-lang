# fail_qmark_err_and_none.hls — deep-scan-5 regression: an enum declaring
# BOTH 'Err' and 'None' made the ? operator's error-variant scan silently
# keep only the LAST one — using the other one panicked at runtime.
# The checker now rejects the ambiguity.
enum E {
    Ok(int),
    Err(str),
    None
}

fn g(e: E) -> E {
    let v: int = e?
    return E.Ok(v)
}

fn main() -> int {
    return 0
}
