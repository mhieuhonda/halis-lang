# fail_stage130_deprecated_dup.hls — Stage 130: a fn carries exactly
# ONE deprecation notice. Two lists (bare + message, or two messages)
# would disagree about the reason — the notice is the contract the
# linter quotes, and a contract cannot have two texts. Merge the
# intent into one #[deprecated("...")].
#[deprecated("use new_thing")]
#[deprecated]
fn old_thing(x: int) -> int {
    return x + 1
}

fn main() -> int {
    return 0
}
