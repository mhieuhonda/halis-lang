# Stage 109: #[taint_source] on a void extern is meaningless — there
# is no value for the taint lattice to carry, and the marking would
# read as a guarantee the type system cannot hold. Well-formedness
# error, both front-ends.
extern "C" {
    #[taint_source]
    fn notify(msg: str) -> void uses IO
}

fn main() -> int uses IO {
    notify("hi")
    return 0
}
