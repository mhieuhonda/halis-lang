# error: #[irq_handler(44)] on 'timer_isr' is not interrupt-safe — the callee concatenates strings
struct Frame { p: int }

#[irq_handler(44)]
fn timer_isr(frame: Frame) -> void {
    log_tick(frame.p)
    return
}

fn log_tick(n: int) -> str {
    return "tick " + "x"
}

fn main() -> int {
    return 0
}
