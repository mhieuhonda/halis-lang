# Stage 10-beta regression test: BUG-3 (? operator error payload type
# verification). The previous code only checked that the enclosing
# function's return type was an enum of the same base name, NOT that the
# error payload type matched the function's error type argument. So `?` on
# a Result[int, int] inside a function returning Result[int, str] would
# silently propagate an Err(int) as if it were Err(str). This MUST now be
# rejected by the checker.
import "std.result"

fn inner() -> Result[int, int] {
    return Result.Err(42)
}

fn outer() -> Result[int, str] {
    let x: int = inner()?
    return Result.Ok(x)
}

fn main() -> int {
    let _r: Result[int, str] = outer()
    return 0
}
