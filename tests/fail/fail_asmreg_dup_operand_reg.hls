# fail_asmreg_dup_operand_reg.hls — Stage 83: two operands bound to the
# same physical register. GCC would allocate one register for both
# operand slots and the asm would read/write a conflated value — the
# overlap check rejects the binding outright. (Both operands spell the
# register in its 64-bit form; a narrower spelling like "eax" is
# already rejected earlier by the width rule.)
fn main() -> int {
    let mut a: int = 1
    let mut b: int = 2
    asm!("nop", in("rax") a, out("rax") b, options(nomem))
    return a + b
}
