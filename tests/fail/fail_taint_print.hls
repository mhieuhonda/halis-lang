# fail_taint_print.t.hls — Stage 10-alpha: tainted value passed to a sink.
# A tainted value cannot be passed to println (a sink). The user must
# either sanitize it or explicitly call taint_unwrap.

fn main() -> int uses IO {
    let t: tainted[str] = taint_mark("hello")
    println(t)
    return 0
}
