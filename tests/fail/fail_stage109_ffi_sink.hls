# Stage 109: a parameter named in #[taint_sink(...)] is a DECLARED
# sink — a tainted argument there gets the dedicated taint-sink
# diagnostic (the blanket Stage 15 rule already rejected it; the
# marking makes the message say "sink", not "boundary").
extern "C" {
    #[taint_sink(cmd)]
    fn system(cmd: str) -> int uses IO
}

fn main() -> int uses Args, IO {
    let argv: list[tainted[str]] = tainted_args()
    let rc: int = system(argv.get(1))
    println(rc.to_str())
    return 0
}
