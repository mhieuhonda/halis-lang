# fail_asmreg_reg_width.hls — Stage 83: a named register binds exactly
# the register the source spells. `eax` is 32-bit and an int operand
# occupies all 64 bits — the old checker silently widened "eax" to
# GCC's "a" class (which binds RAX for a 64-bit operand), so the source
# lied about the hardware. Both compilers now reject the mismatch and
# name the 64-bit spelling.
fn main() -> int {
    let mut x: int = 7
    asm!("nop", in("eax") x, options(nomem))
    return x
}
