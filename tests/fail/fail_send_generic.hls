# A generic fn sending an unresolved type T across a channel: T is not
# provably Send (instantiate with Task[int] and a join handle escapes
# into another task). Deep-scan-10: the old checker returned True for
# type params.
fn w() -> int { return 1 }
fn leak[T](ch: Chan[T], v: T) -> void uses Conc {
    ch.send(take(v))
}
fn main() -> int uses Conc {
    let t: Task[int] = spawn(w)
    let ch: Chan[Task[int]] = chan_new()
    leak(ch, take(t))
    return 0
}
