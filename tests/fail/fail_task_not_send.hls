# fail_task_not_send.hls — a Task[R] join handle is NOT Send: it cannot
# cross a task boundary.
fn worker() -> int { return 1 }
fn fwd(t: Task[int]) -> int uses Conc { return t.join() }
fn main() -> int uses IO, Conc {
    let t: Task[int] = spawn(worker)
    let t2: Task[int] = spawn(fwd, t)
    return 0
}
