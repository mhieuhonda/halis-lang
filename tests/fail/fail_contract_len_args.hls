# fail_contract_len_args.hls — deep-scan-24 regression: the contract
# purity walk whitelisted ANY method node named 'len' and skipped its
# arguments entirely, so a user-defined `impl P { fn len(self: P, n: int)
# -> int }` let a contract smuggle a user-function call past the purity
# rule: `requires p.len(double(2)) > 0` compiled cleanly even though it
# calls `double` (the effect checker cannot catch a pure user fn there,
# so SPEC §26.1's contract purity rule was silently broken). Only the
# arg-less builtin `.len()` is a pure contract construct.
struct P {
    v: int
}

impl P {
    fn len(self: P, n: int) -> int {
        return n * 2
    }
}

fn double(n: int) -> int {
    return n * 2
}

fn f(p: P) -> int
    requires p.len(double(2)) > 0
{
    return p.v
}

fn main() -> int {
    return 0
}
