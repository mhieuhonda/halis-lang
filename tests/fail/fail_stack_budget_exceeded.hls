# fail_stack_budget_exceeded.hls — Stage 82: the crate's
# `#![stack_size(N)]` budget is violated by the program's worst call
# chain. main's frame (2 locals + 2 call sites = 32+16+32 = 80) plus
# leaf's frame (32) = 112 bytes > 100 — rejected in BOTH compilers
# with the same message naming the chain.
#![stack_size(100)]

fn leaf() -> int {
    return 7
}

fn main() -> int {
    let x: int = leaf()
    let y: int = leaf()
    return x + y
}
