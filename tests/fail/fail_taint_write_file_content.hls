# fail_taint_write_file_content.hls — Stage 10-alpha: tainted content in write_file.
# The content argument to write_file is a sink — passing a tainted[str]
# could write attacker-controlled content to disk (web cache poisoning,
# log injection, etc.). The checker must reject.

fn main() -> int uses Fs {
    let t: tainted[str] = taint_mark("attacker content")
    write_file("output.txt", t)
    return 0
}
