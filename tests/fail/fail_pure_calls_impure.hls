# fail_pure_calls_impure.hls — `pure` function transitively calls an
# effectful function. Should be rejected.
fn helper(s: str) -> str uses IO {
    println("trace: " + s)
    return s
}

fn bad(x: int) -> int pure {
    # Calling helper (which uses IO) from a `pure` function must fail.
    let s: str = helper("hello")
    return x + s.len()
}

fn main() -> int uses IO {
    let r: int = bad(5)
    return 0
}
