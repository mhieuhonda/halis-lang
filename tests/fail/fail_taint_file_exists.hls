# fail_taint_file_exists.hls — Stage 10-alpha: tainted path in file_exists.
# A tainted path could let an attacker probe for file existence
# (information disclosure). The checker must reject.

fn main() -> int uses Fs, IO {
    let t: tainted[str] = taint_mark("/etc/passwd")
    if file_exists(t) {
        println("exists")
    } else {
        println("missing")
    }
    return 0
}
