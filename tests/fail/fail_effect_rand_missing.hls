# tests/fail/fail_effect_rand_missing.hls — Stage 9 release (v0.20.0-alpha).
#
# A function WITHOUT `uses Rand` cannot call rand_int() / rand_float()
# / rand_seed(). The capability system enforces `declared ⊇ computed`
# per the fixpoint; the compile error names the function, the missing
# effect, the violating callee, and the declared set.

fn roll_insecure(max: int) -> int {
    return rand_int(max)
}

fn main() -> int uses IO {
    let r: int = roll_insecure(100)
    println("r=" + r.to_str())
    return 0
}
