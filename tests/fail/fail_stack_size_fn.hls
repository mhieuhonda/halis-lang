# fail_stack_size_fn.hls — Stage 28 (v0.45.0-alpha) attribute, Stage 82
# (v0.101.0-alpha) enforcement parity: `#[stack_size(N)]` asserts the
# fn's frame is <= N bytes. The estimator counts 32 base + 8 per local
# + 16 per call site; two locals = 48 > 40. The self-hosted checker
# always enforced this; boot parsed the attribute and silently ignored
# it — now both reject with the same message.
#[stack_size(40)]
fn fat() -> int {
    let a: int = 1
    let b: int = 2
    return a + b
}

fn main() -> int {
    return fat()
}
