# fail_take_in_loop_cond.hls — Stage 8-beta: take() inside a loop
# condition (or iterable) is rejected. The condition re-evaluates every
# iteration; a move would null the binding after the first pass and
# hand NULL to the callee on every later iteration (interpreter/native
# divergence). The checker rejects it up front in both compilers.
fn main() -> int uses IO {
    let s: str = "data"
    while consume(take(s)) > 0 {
        println("loop")
    }
    return 0
}

fn consume(x: str) -> int {
    return x.len()
}
