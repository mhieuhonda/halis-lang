# fail_stage84_section_dupdot.hls — Stage 84: ".." is not a legal name.
# A linker treats a double dot as a path separator in some tools, and the
# name is only ever meant to be a flat output-section identifier.
#[section(".text..boot")]
fn stub(x: int) -> int pure {
    return x
}

fn main() -> int {
    return stub(1)
}
