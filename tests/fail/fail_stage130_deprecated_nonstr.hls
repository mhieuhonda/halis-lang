# fail_stage130_deprecated_nonstr.hls — Stage 130: the deprecation
# message must be a string LITERAL. The notice is read at parse time
# (the linter quotes it verbatim; the docs render it statically), so a
# computed message is meaningless rather than merely unsupported — the
# same argument the #[section] name makes. Both front-ends reject the
# int literal with the same core message.
#[deprecated(42)]
fn old_thing(x: int) -> int {
    return x + 1
}

fn main() -> int {
    return 0
}
