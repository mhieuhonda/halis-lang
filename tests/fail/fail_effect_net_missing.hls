# tests/fail/fail_effect_net_missing.hls — Stage 9 release (v0.20.0-alpha).
#
# A function WITHOUT `uses Net` cannot call net_lookup() even through
# five function layers. The capability system enforces `declared ⊇
# computed` per the fixpoint; the compile error names the function,
# the missing effect, the violating callee, and the declared set.

fn helper1(host: str) -> str {
    return helper2(host)
}

fn helper2(host: str) -> str {
    return helper3(host)
}

fn helper3(host: str) -> str {
    return helper4(host)
}

fn helper4(host: str) -> str {
    return helper5(host)
}

fn helper5(host: str) -> str {
    return net_lookup(host)
}

fn main() -> int uses IO {
    let ip: str = helper1("localhost")
    println("ip=" + ip)
    return 0
}
