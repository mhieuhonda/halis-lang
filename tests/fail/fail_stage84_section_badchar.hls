# fail_stage84_section_badchar.hls — Stage 84: a section name may only
# contain letters, digits, '.', '_' and '$'. The class is deliberately
# tiny so the name is safe to splice into a C string literal (no quote,
# no backslash, no control character) and safe to hand to a linker as an
# input-section wildcard.
#[section(".text boot")]
fn stub(x: int) -> int pure {
    return x
}

fn main() -> int {
    return stub(1)
}
