# fail_effect_fs_missing — Stage 9-alpha: read_file requires `uses Fs`
# (or `uses IO` blanket), but this function declares no effects.
fn load(path: str) -> str {
    return read_file(path)   # error: requires effect 'Fs' not declared
}

fn main() -> int uses IO {
    println(load("examples/data.txt"))
    return 0
}
