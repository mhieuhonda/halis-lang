# Stage 111: authority does not leak transitively. main holds the
# token, but middle() takes NO capability parameter — its call into
# helper2() (which does net work) is a missing-effect violation even
# though main could have funded it. Authority must be explicit at
# every signature it crosses.
fn helper2() -> int {
    return net_lookup("localhost").len()
}
fn middle() -> int {
    return helper2()
}
fn main() -> int {
    let c: Cap[Net] = cap_take("Net")
    return middle()
}
