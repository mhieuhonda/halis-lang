# only visible on a machine, as a fault whose cause is a stack of
# "which of these ran".
#[irq_handler(14)]
fn first(frame: list[int]) -> void {
    return
}

#[irq_handler(14)]
fn second(frame: list[int]) -> void {
    return
}

fn main() -> int {
    return 0
}
