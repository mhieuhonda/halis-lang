# ============================================================================
# tests/repl_libs/session_lib.hls — Stage 123 support: a :load-able module
# ----------------------------------------------------------------------------
# A module-style Halis file (no main): exactly the shape `:load` accepts.
# The acceptance gate loads it into a live hls-repl session and drives the
# definitions it declares.
# ============================================================================

import "std.str"

struct Meter {
    reading: int
}

impl Meter {
    fn advance(self: Meter, by: int) -> Meter {
        return Meter {
            reading: self.reading + by
        }
    }
}

fn square(n: int) -> int {
    return n * n
}

fn shout(s: str) -> str {
    return str_to_upper_ascii(s) + "!"
}
