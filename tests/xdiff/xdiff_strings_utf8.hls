# xdiff_strings_utf8.hls — the Stage 133 cross-impl table: strings and
# their bytes. The backends implement str differently — the interpreter
# and the C runtime walk NUL-terminated UTF-8, the wasm module keeps
# (ptr, len) pairs in linear memory — so the SAME bytes must come out
# of both. Concatenation, equality, byte length and in-bounds byte
# access are pinned here in the wasm alpha's supported subset (no
# slice, no list literals): ASCII, a two-byte é, a three-byte ￥, the
# empty string, and a string long enough to cross any small static
# buffer in a backend's runtime.
fn main() uses IO {
    let ascii: str = "hals"
    let accented: str = "héllo"
    let wide: str = "￥100"
    println("a=" + ascii)
    println("b=" + accented)
    println("c=" + wide)
    println("alen=" + ascii.len().to_str())
    println("blen=" + accented.len().to_str())
    println("clen=" + wide.len().to_str())
    println("cat=" + ascii + "/" + accented + "/" + wide)
    println("eq1=" + (ascii == "hals").to_str())
    println("eq2=" + (ascii == accented).to_str())
    println("ne1=" + (ascii != accented).to_str())
    println("b0=" + ascii.byte_at(0).to_str())
    println("b1=" + accented.byte_at(1).to_str())
    println("empty=" + ("".len()).to_str())
    let mut long: str = ""
    let mut i: int = 0
    while i < 40 {
        long = long + "abcdef0123"
        i = i + 1
    }
    println("longlen=" + long.len().to_str())
    println("longtail=" + long.byte_at(399).to_str())
}
