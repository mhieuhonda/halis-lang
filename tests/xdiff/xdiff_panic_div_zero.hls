# xdiff_panic_div_zero.hls — the Stage 133 cross-impl table: the
# panic class. The interpreter and the native build panic with exit
# 101; the wasm alpha halts every panic through one `unreachable`
# trap (its documented alpha convention — the exit code is not
# propagated). The suite's halt law compares the CLASSES: all three
# backends must HALT before the final println, and the expected
# verdict is `panic-equal`. A backend that prints "survived" instead
# of halting rings as a divergence — that alarm is the point.
fn main() uses IO {
    let a: int = 42
    let b: int = 0
    println("before")
    println("q=" + (a / b).to_str())
    println("survived")
}
