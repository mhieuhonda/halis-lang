# xdiff_panic_overflow.hls — the Stage 133 cross-impl table: checked
# arithmetic must halt identically everywhere. SPEC: every int64
# operation is checked; INT64_MAX + 1 is a panic (exit 101), never a
# silent wrap. The C runtime panics; the wasm backend lowers checked
# add to an overflow test that traps (deep-scan-25). Same halt class,
# same bytes before the halt — that is the contract this fixture
# pins, because a wrapped i64 is the classic cross-implementation
# divergence that only shows up at the corners.
fn main() uses IO {
    let hi: int = 9223372036854775807
    println("before")
    println("boom=" + (hi + 1).to_str())
    println("survived")
}
