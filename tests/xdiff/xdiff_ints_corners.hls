# xdiff_ints_corners.hls — the Stage 133 cross-impl table: integer
# corners. Every operation here is specified to produce ONE answer
# (SPEC: checked int64 arithmetic, division truncates toward zero,
# the sign of % follows the dividend) — so every backend must print
# the same bytes. The corners are the ones whose C lowering and wasm
# lowering historically disagree: division truncation across signs,
# the mod-sign rule, INT64_MIN / INT64_MAX literals surviving the
# lexer, and the deep-scan-25 checked-arith identities.
fn main() uses IO {
    println("d1=" + (7 / 2).to_str())
    println("d2=" + (-7 / 2).to_str())
    println("d3=" + (7 / -2).to_str())
    println("d4=" + (-7 / -2).to_str())
    println("m1=" + (7 % 2).to_str())
    println("m2=" + (-7 % 2).to_str())
    println("m3=" + (7 % -2).to_str())
    println("m4=" + (-7 % -2).to_str())
    let lo: int = -9223372036854775808
    let hi: int = 9223372036854775807
    println("lo=" + lo.to_str())
    println("hi=" + hi.to_str())
    println("lo+hi=" + (lo + hi).to_str())
    println("cmp1=" + (lo < hi).to_str())
    println("cmp2=" + (hi >= hi).to_str())
    println("bool1=" + (true && !(false || false)).to_str())
    println("bool2=" + (!true || false).to_str())
    let mut n: int = 1
    let mut i: int = 0
    while i < 37 {
        n = n * 3
        i = i + 1
    }
    println("pow3_37=" + n.to_str())
}
