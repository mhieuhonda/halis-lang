# xdiff_control_flow.hls — the Stage 133 cross-impl table: control
# flow and recursion. If/else chains, while loops, for-over-range,
# continue, break, nested loops and plain recursion (no #[tail] — the
# tail-call lowering has its own ledgered divergence). The recursion
# depth and the loop trip counts are fixed, so every backend prints
# the same bytes or the table rings.
fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn classify(v: int) -> str {
    if v < 0 {
        return "neg"
    }
    if v == 0 {
        return "zero"
    }
    if v < 10 {
        return "small"
    }
    return "large"
}

fn main() uses IO {
    println("fib15=" + fib(15).to_str())
    println("c1=" + classify(-5))
    println("c2=" + classify(0))
    println("c3=" + classify(7))
    println("c4=" + classify(700))
    let mut acc: int = 0
    for i: int in range(1, 11) {
        acc = acc + i
    }
    println("range_sum=" + acc.to_str())
    let mut hits: int = 0
    let mut skips: int = 0
    for i: int in range(0, 20) {
        if i % 3 == 0 {
            continue
        }
        if i == 15 {
            break
        }
        hits = hits + 1
    }
    println("hits=" + hits.to_str())
    println("skips=" + skips.to_str())
    let mut outer: int = 0
    let mut a: int = 0
    while a < 4 {
        let mut b: int = 0
        while b < 5 {
            outer = outer + 1
            b = b + 1
        }
        a = a + 1
    }
    println("nested=" + outer.to_str())
}
