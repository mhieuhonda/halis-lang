# xdiff_floats_channel.hls — the Stage 133 cross-impl table: the float
# observation channel. The C backends observe floats through printf
# ("0.750000", "inf", "-nan"); the wasm glue observes them through JS
# Number ("0.75", "Infinity", "NaN"). These are REPRESENTATIONS of the
# same doubles, so the suite's canonicalizer maps both onto one form
# and the expected verdict for this fixture is `normalized` — but any
# difference BEYOND representation (a different double, a different
# sign, a different rounding) still rings: the canonicalizer rounds to
# the printf channel's six decimals and refuses to rewrite short forms
# and version strings. Every line here was chosen because the two
# renderers actually disagree on its raw bytes.
fn main() uses IO {
    let a: float = 0.75
    let b: float = 1.5
    let c: float = 3.141592653589793
    let d: float = 100.0
    let z: float = 0.0
    let inf: float = 1.0 / z
    let nan: float = inf - inf
    println("a=" + a.to_str())
    println("b=" + b.to_str())
    println("c=" + c.to_str())
    println("d=" + d.to_str())
    println("neg=" + (-0.5).to_str())
    println("tiny=" + 0.0000001.to_str())
    println("small=" + 0.00001.to_str())
    println("huge=" + 123456789012345678.0.to_str())
    println("inf=" + inf.to_str())
    println("nan=" + nan.to_str())
    println("sum=" + (a + b).to_str())
    println("prod=" + (c * d).to_str())
    println("cmp=" + (a < b).to_str())
}
