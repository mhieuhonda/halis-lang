# tests/guarantee_probes/sandbox_extern.hls — Stage 135 probe fixture
# for G-SBX-01. This file is NOT in tests/fail/ deliberately: without
# --sandbox it compiles clean (suite_01 would otherwise demand a
# refusal), and that is the point — the sandbox gate, not the type
# checker, is what refuses it. The ledger probe runs
#   boot.py --sandbox tests/guarantee_probes --check <this file>
# and pins the refusal message.
extern "C" {
    fn abs(n: int) -> int pure
}

fn main() -> int {
    return abs(-3)
}
