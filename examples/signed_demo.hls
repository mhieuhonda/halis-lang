# signed_demo.hls — Stage 106 (v0.125.0-alpha): hls-sign, the signed
# packages (minisign, ed25519).
#
# The tool signs a release with Ed25519 and the minisign file
# discipline. This demo is the CONTRACT the tool runs, in miniature —
# the arithmetic the four-line signature file and the release
# statement live on — and it runs itself, deterministically:
#
#   python3 tools/hls-sign.py selftest
#   python3 tools/hls-sign.py keygen --password-env PW
#   python3 tools/hls-sign.py release <pkg-dir> --password-env PW
#
# What the demo pins, in Halis the language can check without the
# crypto module: the base64 lengths the minisign lines must have, the
# key-id width, the two-signature trust rule, the tamper evidence (one
# flipped byte moves the digest), and the statement's own schema name.

import "std.str"
import "std.crypto"

# The minisign signature line is base64 of Ed(2) + sig(64) = 66 bytes;
# the trusted-comment line signs the same shape. base64 length is
# ceil(n / 3) * 4 — for 66 bytes that is 88 characters, exactly the
# line the four-line file carries.
fn b64_len(n: int) -> int {
    if n <= 0 {
        panic("b64_len: a payload has bytes")
    }
    return((n + 2) / 3) * 4
}

# The trust rule: a signature file is believed only when BOTH
# signatures hold — the one over the payload AND the one over (payload
# signature || trusted comment). One true witness is not trust.
fn trust_rule(payload_ok: bool, comment_ok: bool) -> bool {
    return payload_ok && comment_ok
}

# The key id: the first eight bytes of the digest over the public
# key, hex-printed — sixteen characters that NAME the key in the
# ledger, the statement and the signature file alike.
fn keyid_chars() -> int {
    return 8 * 2
}

# Tamper evidence in miniature: flipping one character of a digest
# input moves the hash. The release statement works the same way — a
# flipped byte anywhere in the tree is a different content_sha256, and
# the signature stops matching.
fn fnv(s: str) -> str {
    return crypto_fnv1a_64_hex(s)
}

fn main() -> int uses IO {
    let mut checks: int = 0

    # The signature lines: Ed(2) + sig(64) base64s to 88 characters —
    # and a 42-byte public blob (Ed + id(8) + pk(32)) base64s to 56.
    # If those numbers were wrong, every minisign reader would refuse
    # the file on sight.
    if b64_len(66) != 88 {
        panic("the signature line must be 88 base64 characters")
    }
    if b64_len(42) != 56 {
        panic("the public key blob must be 56 base64 characters")
    }
    checks = checks + 1

    # The trust rule is an AND: payload true + comment false is a
    # tampered trusted comment, and the file must refuse. Only
    # (true, true) is trust.
    if !trust_rule(true, true) || trust_rule(true, false)
    || trust_rule(false, true) || trust_rule(false, false) {
        panic("trust is the AND of both signatures")
    }
    checks = checks + 1

    # The key id is sixteen hex characters — eight bytes naming the
    # key everywhere without ever shipping key material.
    if keyid_chars() != 16 {
        panic("the key id is 16 hex characters")
    }
    if !str_starts_with("hls-sign-rel_app-2.3.4.release.json",
                        "hls-sign-") {
        panic("a release statement is versioned under its tool")
    }
    if !str_contains("hls-sign-rel_app-2.3.4.release.json", "-2.3.4.") {
        panic("the version rides in the file name")
    }
    checks = checks + 1

    # Tamper evidence: one flipped character changes the digest. The
    # statement pins content_sha256 the same way — the signature is
    # over THE bytes, not nearly-the bytes.
    if fnv("content_sha256") == fnv("content_sha257") {
        panic("a flipped byte must move the digest")
    }
    if fnv("halis-package-release") != fnv("halis-package-release") {
        panic("the same bytes must give the same digest")
    }
    checks = checks + 1

    # The statement's schema names the contract; the tool stamps the
    # release with the algorithm the verifier will demand.
    let schema: str = "hls-release-statement/v1"
    if !str_starts_with(schema, "hls-release-statement/") {
        panic("the schema names the document")
    }
    if !str_contains(schema, "/v1") {
        panic("the schema carries its version")
    }
    checks = checks + 1

    if checks != 5 {
        panic("expected 5 checks, ran " + checks.to_str())
    }
    println("signed-package ledger: a name behind every release claim")
    println("checks passed: " + checks.to_str())
    return 0
}
