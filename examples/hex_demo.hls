import "std.hex"

fn main() -> int uses IO {
    let h: str = hex_encode("Hello, Halis!")
    println("hex:     " + h)
    let b: str = hex_decode("48656c6c6f2c20576f726c6421")
    println("decoded: " + b)
    println("byte 0:  " + hex_byte(0))
    println("byte 1:  " + hex_byte(255))
    return 0
}
