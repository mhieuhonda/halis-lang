# sandbox_demo.hls — the Stage 110 demo: the declaration becomes
# enforcement.
#
# The program does exactly what its surface says: Fs (the read side
# only — read_file, never write_file unless asked), IO (println),
# Args (the optional "write" word). Under the derived profile
# (fs=ro) the read runs and the print runs, and that is the whole
# happy path:
#
#   python3 tools/hls-sandbox.py profile examples/sandbox_demo.hls
#   ... execution surface (checker, from main): Args, Fs, IO
#   ... fs mode: rw (derived — the reachable builtin census contains
#       the write side (write_file))
#
# With the word "write" as the first argument the program asks the
# kernel for the write side of Fs. The derivation is honest about
# that: write_file is REACHABLE, so the derived fs mode is rw — a
# capability the tree can express is a capability the filter must
# cover, whether or not this run uses it. Tighten explicitly
# (--fs ro, or [sandbox] fs = "ro" in a manifest) and the kernel
# holds the line the census would not: the openat returns EPERM,
# fopen reports failure, and write_file's own error path panics
# ("cannot write file", exit 101) — the denial surfaces as a VALUE
# the program observes, not a corpse. Under --strict the kernel
# ends the process at the syscall itself (SIGSYS, exit 159 = 128+31).
#
# Unconfined, both modes succeed — the differential.
#
# Run from the repo root (the data path is relative):
#   python3 boot/boot.py examples/sandbox_demo.hls
#   python3 boot/boot.py examples/sandbox_demo.hls write

# A deterministic rolling digest (the demo's parity check): the
# byte count and the digest must agree byte for byte between the
# interpreter and the native build, so the sandbox runs have a
# fixed thing to print. Pure — no effects, no allocation. The
# modulus keeps every intermediate below 2^35: (h + byte + 1) is
# below 10^9 + 256, times 31 below 3.2 * 10^10 — no int64
# overflow, so the overflow panic never fires on the happy path.
fn rolling_digest(data: str) -> int {
    let mut h: int = 7
    let mut i: int = 0
    while i < data.len() {
        h = ((h + data.byte_at(i) + 1) * 31) % 1000000007
        i = i + 1
    }
    return h
}

fn main() -> int uses Fs, IO, Args {
    let text: str = read_file("examples/data.txt")
    let lines: list[str] = text.split("\n")
    println("sandbox_demo: read " + text.len().to_str() + " bytes, "
            + lines.len().to_str() + " lines, digest "
            + rolling_digest(text).to_str())

    let a: list[str] = args()
    if a.len() > 1 {
        if a.get(1) == "write" {
            # The one syscall the read-only profile denies at the
            # kernel level: openat with write intent.
            write_file("build/sandbox_probe.txt", text)
            println("sandbox_demo: wrote the bytes back (unconfined)")
        }
    }
    return 0
}
