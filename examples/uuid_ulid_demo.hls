# examples/uuid_ulid_demo.hls — Stage 52 (v0.71.0-alpha): UUID v7 + ULID demo.
#
# Demonstrates:
#   - UUID v4 deterministic (Stage 10, for backwards compat)
#   - UUID v5-like (Stage 10, for backwards compat)
#   - UUID v7 (RFC 9562, time-ordered, privacy-preserving)
#   - ULID (26-char Crockford base32, lexicographically sortable)
#   - Live generation (current time + random)
#   - Deterministic generation (fixed timestamp + randomness, for testing)
#   - Format validation and version detection
#   - Timestamp extraction
#   - Lexicographic sort (the key ULID feature)

import "std.uuid"
import "std.str"

# Format an int as an 8-digit lowercase hex string (for display).
fn hex32(v: int) -> str {
    let digits: str = "0123456789abcdef"
    let out: list[str] = []
    let mut k: int = 7
    while k >= 0 {
        let nibble: int = int_and(int_shr(v, k * 4), 15)
        out.push(digits.slice(nibble, nibble + 1))
        k = k - 1
    }
    return str_join(out, "")
}

# Format a 10-byte string as hex (for display).
fn hex_bytes(s: str) -> str {
    let digits: str = "0123456789abcdef"
    let out: list[str] = []
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        out.push(digits.slice(b / 16, b / 16 + 1))
        out.push(digits.slice(b % 16, b % 16 + 1))
        i = i + 1
    }
    return str_join(out, "")
}

# Format a Unix millisecond timestamp as a human-readable date.
fn format_unix_ms(ms: int) -> str {
    let secs: int = ms / 1000
    let year: int = 1970 + secs / 31556952
    return "T+" + secs.to_str() + "s (~" + year.to_str() + ")"
}

fn main() -> int uses IO, Rand {
    println("=== Stage 52 (v0.71.0-alpha): UUID v7 + ULID demo ===")
    println("")

    # --- UUID v4 (backwards compat) ---
    println("--- UUID v4 deterministic (Stage 10, for backwards compat) ---")
    let v4_1: str = uuid_v4_deterministic("user-namespace", 1)
    let v4_2: str = uuid_v4_deterministic("user-namespace", 2)
    let v4_3: str = uuid_v4_deterministic("user-namespace", 1)
    println("v4(ns, 1)      = " + v4_1)
    println("v4(ns, 2)      = " + v4_2)
    let v4_match: str = v4_3 + "  (matches v4_1: " + (v4_1 == v4_3).to_str() + ")"
    println("v4(ns, 1)      = " + v4_match)
    println("")

    # --- UUID v5-like (backwards compat) ---
    println("--- UUID v5-like (Stage 10, for backwards compat) ---")
    let v5: str = uuid_v5_like("https://example.com", "/users/42")
    println("v5(example.com, /users/42) = " + v5)
    println("")

    # --- UUID v7 (RFC 9562) ---
    println("--- UUID v7 (RFC 9562, time-ordered) ---")
    let v7_rfc: str = uuid_v7_from(1645553341471, 3267, 1784793296649003341)
    println("v7 from RFC 9562 test vector:")
    println("  ts_ms=1645553341471, rand_a=3267, rand_b=1784793296649003341")
    println("  -> " + v7_rfc)
    println("  expected: 017f229f-541f-7cc3-98c4-dc0c0c43214d")
    let v7_match_str: str = (v7_rfc == "017f229f-541f-7cc3-98c4-dc0c0c43214d").to_str()
    println("  match: " + v7_match_str)
    let v7_ver: str = uuid_version(v7_rfc).to_str()
    println("  version: " + v7_ver)
    let v7_ts: int = uuid_v7_timestamp(v7_rfc)
    let v7_ts_str: str = v7_ts.to_str()
    let v7_ts_fmt: str = format_unix_ms(v7_ts)
    println("  timestamp extracted: " + v7_ts_str + " ms (" + v7_ts_fmt + ")")
    println("")
    # Live UUID v7 (uses current time + random).
    println("Live v7 UUIDs (current time + random):")
    let mut i: int = 0
    while i < 3 {
        let u: str = uuid_v7()
        let ts: int = uuid_v7_timestamp(u)
        let ts_str: str = ts.to_str()
        let ts_fmt: str = format_unix_ms(ts)
        let idx_str: str = i.to_str()
        println("  [" + idx_str + "] " + u + "  (ts=" + ts_str + " ms, " + ts_fmt + ")")
        i = i + 1
    }
    println("")

    # --- ULID ---
    println("--- ULID (Crockford base32, lexicographically sortable) ---")
    let rand_input: str = chr(1) + chr(2) + chr(3) + chr(4) + chr(5) + chr(6) + chr(7) + chr(8) + chr(9) + chr(10)
    let ulid_d: str = ulid_from(1645553341471, rand_input)
    println("ulid_from(ts=1645553341471, rand=[1..10]):")
    println("  -> " + ulid_d)
    println("  expected (matches python-ulid): 01FWH9YN0Z041061050R3GG28A")
    let ulid_match: str = (ulid_d == "01FWH9YN0Z041061050R3GG28A").to_str()
    println("  match: " + ulid_match)
    let ulid_valid: str = ulid_is_valid(ulid_d).to_str()
    println("  valid: " + ulid_valid)
    let ulid_ts: int = ulid_timestamp(ulid_d)
    let ulid_ts_fmt: str = format_unix_ms(ulid_ts)
    println("  timestamp: " + ulid_ts.to_str() + " ms (" + ulid_ts_fmt + ")")
    let rand_back: str = ulid_randomness(ulid_d)
    let rand_hex: str = hex_bytes(rand_back)
    println("  randomness (10 bytes, hex): " + rand_hex)
    println("")
    # Live ULIDs (uses current time + random).
    println("Live ULIDs (current time + random):")
    i = 0
    while i < 3 {
        let u: str = ulid()
        let ts: int = ulid_timestamp(u)
        let idx_str: str = i.to_str()
        let ts_str: str = ts.to_str()
        println("  [" + idx_str + "] " + u + "  (ts=" + ts_str + " ms)")
        i = i + 1
    }
    println("")

    # --- Lexicographic sort demo ---
    println("--- Lexicographic sort demo (ULID's killer feature) ---")
    let zero_rand: str = chr(0) + chr(0) + chr(0) + chr(0) + chr(0) + chr(0) + chr(0) + chr(0) + chr(0) + chr(0)
    let u_old: str = ulid_from(1000, zero_rand)
    let u_mid: str = ulid_from(2000, zero_rand)
    let u_new: str = ulid_from(3000, zero_rand)
    println("Old (ts=1000): " + u_old)
    println("Mid (ts=2000): " + u_mid)
    println("New (ts=3000): " + u_new)
    let sort_ok: bool = (u_old < u_mid) && (u_mid < u_new)
    println("Lexicographic sort: old < mid < new? " + sort_ok.to_str())
    let cmp_result: int = ulid_compare(u_old, u_new)
    println("ulid_compare(old, new) = " + cmp_result.to_str() + " (-1 means old < new)")
    println("")

    # --- UUID v7 lexicographic sort (within same high-timestamp field) ---
    println("--- UUID v7 lexicographic sort (high-timestamp field) ---")
    let v7_old: str = uuid_v7_from(1000, 0, 0)
    let v7_new: str = uuid_v7_from(2000, 0, 0)
    println("v7(ts=1000) = " + v7_old)
    println("v7(ts=2000) = " + v7_new)
    let v7_sort_ok: bool = v7_old < v7_new
    println("Lexicographic sort: old < new? " + v7_sort_ok.to_str())
    println("")

    println("ACCEPTANCE OK: Stage 52 — UUID v7 + ULID (time-ordered, lexicographically sortable)")
    return 0
}
