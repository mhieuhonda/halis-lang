# result_demo.hls — demonstrates Result[T, E] and the `?` operator
# Stage 7 example
import "std.result"

# A simple division that returns Result instead of panicking.
fn safe_div(a: int, b: int) -> Result[int, str] {
    if b == 0 {
        return Result.Err("division by zero")
    }
    return Result.Ok(a / b)
}

# A chain of fallible operations — `?` propagates errors early.
fn chained_div(a: int, b: int, c: int) -> Result[int, str] {
    let q: int = safe_div(a, b)?
    let r: int = safe_div(q, c)?
    return Result.Ok(r)
}

fn parse_and_double(s: str) -> Result[int, str] {
    let n: int = int_parse(s)?
    return Result.Ok(n * 2)
}

fn main() -> int uses IO {
    let r1: Result[int, str] = chained_div(100, 5, 2)
    println(match r1 {
        Result.Ok(v) => "chained_div(100, 5, 2) = " + v.to_str(),
        Result.Err(e) => "error: " + e
    })

    let r2: Result[int, str] = chained_div(100, 0, 2)
    println(match r2 {
        Result.Ok(v) => "chained_div(100, 0, 2) = " + v.to_str(),
        Result.Err(e) => "error: " + e
    })

    let r3: Result[int, str] = parse_and_double("21")
    println(match r3 {
        Result.Ok(v) => "parse_and_double(\"21\") = " + v.to_str(),
        Result.Err(e) => "error: " + e
    })

    let r4: Result[int, str] = parse_and_double("not a number")
    println(match r4 {
        Result.Ok(v) => "parse_and_double(\"not a number\") = " + v.to_str(),
        Result.Err(e) => "error: " + e
    })

    return 0
}
