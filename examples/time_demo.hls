import "std.time"

fn main() -> int uses IO {
    println("=== time formatting ===")
    println("0 ms           -> " + time_format_hms(0))
    println("1 ms           -> " + time_format_hms(1))
    println("999 ms         -> " + time_format_hms(999))
    println("1000 ms (1s)   -> " + time_format_hms(1000))
    println("61000 ms (1m1s) -> " + time_format_hms(61000))
    println("3661500 ms     -> " + time_format_hms(3661500))

    println("")
    println("=== human-readable durations ===")
    println("500 ms:    " + time_human_ms(500))
    println("1500 ms:   " + time_human_ms(1500))
    println("63000 ms:  " + time_human_ms(63000))
    println("3723456 ms: " + time_human_ms(3723456))

    println("")
    println("=== iso-8601 style ===")
    println("0 ms:      " + time_format_iso8601(0))
    println("1500 ms:   " + time_format_iso8601(1500))
    println("86400500 ms: " + time_format_iso8601(86400500))

    println("")
    println("=== stopwatch (real timing) ===")
    let start: int = time_stopwatch_start()
    # Spin a bit so the stopwatch is non-zero.
    let mut sum: int = 0
    let mut i: int = 0
    while i < 100000 {
        sum = sum + i
        i = i + 1
    }
    let lap: int = time_stopwatch_lap(start)
    println("sum=" + sum.to_str() + "  lap=" + lap.to_str() + "ms (" + time_human_ms(lap) + ")")
    return 0
}
