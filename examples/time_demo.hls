# time_demo.hls — Stage 49 (v0.68.0-alpha): std.time — Instant, Duration,
# SystemTime, sleep, timeout.
#
# This demo exercises both the new Stage 49 API and the original
# low-resolution helpers (which remain available for backwards
# compatibility):
#   - Instant::now() + instant_elapsed(): high-resolution timing
#   - Duration constructors + checked arithmetic + duration_to_str
#   - SystemTime::now() + unix_secs + to_iso8601
#   - time_sleep(Duration): block the calling thread
#   - time_timeout_ms(ms): race a future against a timer
#   - Original helpers: time_format_hms, time_human_ms, time_format_iso8601,
#     time_stopwatch_start / time_stopwatch_lap

import "std.time"
import "std.option"
import "std.result"

fn main() -> int uses IO, Clock, Conc {
    println("=== Stage 49: std.time — Instant / Duration / SystemTime / sleep / timeout ===")
    println("")

    # ----- Instant + Duration: high-resolution timing -----
    println("--- Instant + Duration (high-resolution monotonic clock) ---")
    let t0: Instant = instant_now()
    # Spin briefly so the elapsed duration is non-zero.
    let mut sum: int = 0
    let mut i: int = 0
    while i < 100000 {
        sum = sum + i
        i = i + 1
    }
    let elapsed: Duration = instant_elapsed(t0)
    println("instant_now() + spin + instant_elapsed() -> " + duration_to_str(elapsed))
    println("  elapsed.as_nanos() = " + duration_as_nanos(elapsed).to_str() + " ns")
    println("  elapsed.as_micros() = " + duration_as_micros(elapsed).to_str() + " us")
    println("  elapsed.as_millis() = " + duration_as_millis(elapsed).to_str() + " ms")
    println("")

    # ----- Duration constructors + checked arithmetic -----
    println("--- Duration constructors + checked arithmetic ---")
    let d1: Duration = duration_from_secs(3)
    let d2: Duration = duration_from_millis(500)
    let d3: Duration = duration_add(d1, d2)
    println("duration_from_secs(3) + duration_from_millis(500) = " + duration_to_str(d3))
    # 3s + 500ms = 3500ms.
    if duration_as_millis(d3) != 3500 {
        println("FAIL: 3s + 500ms != 3500ms (got " + duration_as_millis(d3).to_str() + ")")
        return 1
    }
    # Checked multiplication: 1 hour * 24 = 24 hours = 1 day.
    let one_hour: Duration = duration_from_hours(1)
    let one_day: Duration = duration_mul(one_hour, 24)
    if duration_as_days(one_day) != 1 {
        println("FAIL: 1h * 24 != 1d (got " + duration_as_days(one_day).to_str() + " d)")
        return 1
    }
    println("1 hour * 24 = " + duration_to_str(one_day) + " (1 day)")

    # Subsec accessors: 3.5 seconds has 500ms subsec.
    let subsec_ms: int = duration_subsec_millis(d3)
    if subsec_ms != 500 {
        println("FAIL: subsec_millis(3.5s) != 500 (got " + subsec_ms.to_str() + ")")
        return 1
    }
    println("subsec_millis(3.5s) = " + subsec_ms.to_str())
    println("")

    # ----- SystemTime: wall-clock timestamps -----
    println("--- SystemTime (wall-clock ms since Unix epoch) ---")
    let now: SystemTime = system_time_now()
    let unix_secs: int = system_time_unix_secs(now)
    let unix_ms: int = system_time_unix_millis(now)
    println("system_time_now().unix_secs() = " + unix_secs.to_str() + " (s since 1970-01-01)")
    println("system_time_now().unix_millis() = " + unix_ms.to_str())
    println("system_time_now().to_iso8601() = " + system_time_to_iso8601(now))
    # Sanity: unix_secs should be > 1.7e9 (year 2023+).
    if unix_secs < 1700000000 {
        println("FAIL: unix_secs too small (before 2023?)")
        return 1
    }
    println("")

    # ----- Sleep: block the calling thread -----
    println("--- time_sleep(Duration) ---")
    let sleep_dur: Duration = duration_from_millis(50)
    let s0: Instant = instant_now()
    time_sleep(sleep_dur)
    let slept: Duration = instant_elapsed(s0)
    let slept_ms: int = duration_as_millis(slept)
    println("time_sleep(50ms) -> actually slept " + slept_ms.to_str() + " ms")
    # Allow some scheduling slack — slept should be >= 40ms.
    if slept_ms < 40 {
        println("FAIL: slept " + slept_ms.to_str() + "ms (expected >= 40)")
        return 1
    }
    println("")

    # ----- Timeout: race a future against a timer -----
    println("--- time_timeout_ms (future-based timer) ---")
    let timeout_fut: Future[bool] = time_timeout_ms(30)
    let before_await: Instant = instant_now()
    let result: bool = await(timeout_fut)
    let await_elapsed: Duration = instant_elapsed(before_await)
    let await_ms: int = duration_as_millis(await_elapsed)
    println("await(time_timeout_ms(30)) -> " + result.to_str() + " (waited " + await_ms.to_str() + " ms)")
    if !result {
        println("FAIL: timeout future returned false")
        return 1
    }
    if await_ms < 20 {
        println("FAIL: await took only " + await_ms.to_str() + " ms (expected >= 20)")
        return 1
    }
    println("")

    # ----- Original low-resolution API (backwards compat) -----
    println("--- Original low-resolution API (backwards compat) ---")
    println("time_format_hms(3661500) -> " + time_format_hms(3661500))
    println("time_human_ms(3723456)  -> " + time_human_ms(3723456))
    println("time_format_iso8601(1500) -> " + time_format_iso8601(1500))
    let sw_start: int = time_stopwatch_start()
    let mut j: int = 0
    let mut _k: int = 0
    while j < 10000 {
        _k = _k + j
        j = j + 1
    }
    let lap: int = time_stopwatch_lap(sw_start)
    println("stopwatch lap = " + lap.to_str() + " ms (" + time_human_ms(lap) + ")")
    println("")

    println("ACCEPTANCE OK: Stage 49 — std.time (Instant, Duration, SystemTime, sleep, timeout)")
    return 0
}
