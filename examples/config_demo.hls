# examples/config_demo.hls — Stage 58 (v0.79.0-alpha): std.config demo.
#
# This demo exercises every feature of std.config:
#   - ConfigSchema builder (config_schema_new + str/int/float/bool keys)
#   - impl ConfigSchema method twins (.str_key/.int_key/...)
#   - Pure-HLS TOML parser (tables, dotted headers, arrays, comments)
#   - JSON config (delegates to std.json)
#   - Layered loading: defaults < file < env (env wins)
#   - Type coercion (str -> int / float / bool)
#   - Dotted-path lookup (server.port, db.host, etc.)
#   - config_has / config_get_str/int/float/bool
#   - config_serialize (round-trip TOML) + config_describe (schema)
#   - config_load_file (Fs effect — read a file from disk)
#
# The demo simulates a web server config: server.host/port, db.host/port,
# debug flag, log_level. The config is loaded from a synthetic TOML
# string (so the output is differential-safe); the env-overlay path
# is shown via env_set/env_unset with a prefix.

import "std.config"
import "std.str"

# ----------------------------------------------------------------------------
# Build the demo schema.
# ----------------------------------------------------------------------------

fn build_demo_schema() -> ConfigSchema {
    return config_schema_new()
        .str_key("name", "myapp", "Application name")
        .str_key("server.host", "localhost", "Server bind host")
        .int_key("server.port", 8080, "Server bind port")
        .bool_key("server.tls", false, "Enable TLS")
        .str_key("db.host", "localhost", "Database host")
        .int_key("db.port", 5432, "Database port")
        .str_key("db.name", "myapp", "Database name")
        .str_key("db.user", "myapp", "Database user")
        .str_key_no_default("db.password", "Database password (required)")
        .str_key("log.level", "info", "Log level (off/error/warn/info/debug/trace)")
        .bool_key("debug", false, "Enable debug mode")
        .float_key("timeout", 30.0, "Request timeout (seconds)")
        .env("db.password", "DB_PASSWORD")
}

# ----------------------------------------------------------------------------
# Demo 1 — schema description.
# ----------------------------------------------------------------------------

fn demo_describe() -> void uses IO {
    let schema: ConfigSchema = build_demo_schema()
    println(config_describe(schema))
}

# ----------------------------------------------------------------------------
# Demo 2 — TOML parse + dotted-path lookup.
# ----------------------------------------------------------------------------

fn demo_toml_parse() -> void uses IO {
    let toml: str = "# Demo config\n" +
        "name = \"myapp\"\n" +
        "\n" +
        "[server]\n" +
        "host = \"0.0.0.0\"\n" +
        "port = 9000\n" +
        "tls = true\n" +
        "\n" +
        "[db]\n" +
        "host = \"db.example.com\"\n" +
        "port = 5433\n" +
        "name = \"prod_db\"\n" +
        "user = \"appuser\"\n" +
        "password = \"s3cr3t\"\n" +
        "\n" +
        "[log]\n" +
        "level = \"debug\"\n" +
        "\n" +
        "debug = true\n" +
        "timeout = 60.5\n"
    let r: Result[ConfigValue, str] = toml_parse(toml)
    if result_is_err(r) {
        println("ERROR: " + result_err_or(r, ""))
        return
    }
    let cfg: ConfigValue = result_unwrap(r)
    println("Parsed config:")
    println("  name        = " + config_get_str(cfg, "name", ""))
    println("  server.host = " + config_get_str(cfg, "server.host", ""))
    println("  server.port = " + config_get_int(cfg, "server.port", 0).to_str())
    println("  server.tls  = " + config_get_bool(cfg, "server.tls", false).to_str())
    println("  db.host     = " + config_get_str(cfg, "db.host", ""))
    println("  db.port     = " + config_get_int(cfg, "db.port", 0).to_str())
    println("  db.name     = " + config_get_str(cfg, "db.name", ""))
    println("  db.password = " + config_get_str(cfg, "db.password", ""))
    println("  log.level   = " + config_get_str(cfg, "log.level", ""))
    println("  debug       = " + config_get_bool(cfg, "debug", false).to_str())
    println("  timeout     = " + config_get_float(cfg, "timeout", 0.0).to_str())
}

# ----------------------------------------------------------------------------
# Demo 3 — layered loading (defaults < file < env).
# ----------------------------------------------------------------------------

fn demo_layering() -> void uses IO, Proc {
    let schema: ConfigSchema = build_demo_schema()
    let toml: str = "[server]\nport = 9000\n[db]\npassword = \"fromfile\"\n"
    # Set env vars to override.
    env_set("MYAPP_SERVER_PORT", "12345")
    env_set("MYAPP_DEBUG", "true")
    env_set("DB_PASSWORD", "fromenv")

    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, toml, "MYAPP")
    env_unset("MYAPP_SERVER_PORT")
    env_unset("MYAPP_DEBUG")
    env_unset("DB_PASSWORD")

    if result_is_err(r) {
        let e: ConfigLoadError = result_err_or(r, ConfigLoadError {layer:"",key:"",message:""})
        println("ERROR (" + e.layer + " / " + e.key + "): " + e.message)
        return
    }
    let cfg: ConfigValue = result_unwrap(r)
    println("Layered config (defaults < file < env):")
    println("  server.port = " + config_get_int(cfg, "server.port", 0).to_str()
        + " (env=12345 overrides file=9000 overrides default=8080)")
    println("  server.host = " + config_get_str(cfg, "server.host", "")
        + " (default=localhost, not in file or env)")
    println("  debug        = " + config_get_bool(cfg, "debug", false).to_str()
        + " (env=true overrides default=false)")
    println("  db.password  = " + config_get_str(cfg, "db.password", "")
        + " (env=DB_PASSWORD overrides file=fromfile)")
    println("  name         = " + config_get_str(cfg, "name", "")
        + " (default=myapp, not in file or env)")
}

# ----------------------------------------------------------------------------
# Demo 4 — JSON config.
# ----------------------------------------------------------------------------

fn demo_json_config() -> void uses IO, Proc {
    let schema: ConfigSchema = build_demo_schema()
    let json: str = "{\"name\":\"fromjson\",\"server\":{\"host\":\"json.host\",\"port\":7777},\"debug\":true}"
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, json, "")
    if result_is_err(r) {
        let e: ConfigLoadError = result_err_or(r, ConfigLoadError {layer:"",key:"",message:""})
        println("ERROR: " + e.message)
        return
    }
    let cfg: ConfigValue = result_unwrap(r)
    println("JSON config:")
    println("  name        = " + config_get_str(cfg, "name", ""))
    println("  server.host = " + config_get_str(cfg, "server.host", ""))
    println("  server.port = " + config_get_int(cfg, "server.port", 0).to_str())
    println("  debug       = " + config_get_bool(cfg, "debug", false).to_str())
}

# ----------------------------------------------------------------------------
# Demo 5 — config_serialize (round-trip TOML).
# ----------------------------------------------------------------------------

fn demo_serialize() -> void uses IO, Proc {
    let schema: ConfigSchema = build_demo_schema()
    let toml: str = "[server]\nhost = \"0.0.0.0\"\nport = 9000\n[db]\nhost = \"db.local\"\n"
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, toml, "")
    if result_is_err(r) {
        let e: ConfigLoadError = result_err_or(r, ConfigLoadError {layer:"",key:"",message:""})
        println("ERROR: " + e.message)
        return
    }
    let cfg: ConfigValue = result_unwrap(r)
    println("Serialized (round-trip TOML):")
    println(config_serialize(cfg))
}

# ----------------------------------------------------------------------------
# Demo 6 — config_load_file (read from disk, Fs effect).
# ----------------------------------------------------------------------------

fn demo_load_file() -> void uses IO, Fs, Proc {
    # Write a temp config file.
    let toml: str = "name = \"fromfile\"\n[server]\nport = 9999\n"
    write_file("/tmp/config_demo.toml", toml)
    let schema: ConfigSchema = build_demo_schema()
    let r: Result[ConfigValue, ConfigLoadError] = config_load_file(schema, "/tmp/config_demo.toml", "")
    if result_is_err(r) {
        let e: ConfigLoadError = result_err_or(r, ConfigLoadError {layer:"",key:"",message:""})
        println("ERROR: " + e.message)
        return
    }
    let cfg: ConfigValue = result_unwrap(r)
    println("config_load_file (/tmp/config_demo.toml):")
    println("  name        = " + config_get_str(cfg, "name", ""))
    println("  server.port = " + config_get_int(cfg, "server.port", 0).to_str())
    println("  server.host = " + config_get_str(cfg, "server.host", "")
        + " (default, not in file)")
}

# ----------------------------------------------------------------------------
# Demo 7 — coercion failure (invalid int in env).
# ----------------------------------------------------------------------------

fn demo_coercion_failure() -> void uses IO, Proc {
    let schema: ConfigSchema = build_demo_schema()
    env_set("MYAPP_SERVER_PORT", "not_a_port")
    let r: Result[ConfigValue, ConfigLoadError] = config_load(schema, "", "MYAPP")
    env_unset("MYAPP_SERVER_PORT")
    if result_is_err(r) {
        let e: ConfigLoadError = result_err_or(r, ConfigLoadError {layer:"",key:"",message:""})
        println("Coercion failure (env var with invalid int):")
        println("  layer   = " + e.layer)
        println("  key     = " + e.key)
        println("  message = " + e.message)
    } else {
        println("Expected error but got Ok")
    }
}

# ----------------------------------------------------------------------------
# Main — run all demos.
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Fs, Proc {
    println("=== Stage 58 (v0.79.0-alpha): std.config — layered config loader ===")
    println("")
    println("--- Schema description ---")
    demo_describe()
    println("")
    println("--- TOML parse + dotted-path lookup ---")
    demo_toml_parse()
    println("")
    println("--- Layered loading (defaults < file < env) ---")
    demo_layering()
    println("")
    println("--- JSON config ---")
    demo_json_config()
    println("")
    println("--- config_serialize (round-trip TOML) ---")
    demo_serialize()
    println("")
    println("--- config_load_file (Fs effect) ---")
    demo_load_file()
    println("")
    println("--- Coercion failure (invalid int in env) ---")
    demo_coercion_failure()
    println("")
    println("ACCEPTANCE OK: Stage 58 — std.config demo runs clean.")
    return 0
}
