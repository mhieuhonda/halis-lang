# simd_demo.hls — Stage 21 (v0.37.0-alpha): the std.simd tour.
#
# Runs on EVERY backend (interpreter / native / any arch) via the
# portable implementation; compile with
#   hlc --target-feature avx2 simd_demo.hls out.c
# to engage the native intrinsic fast paths (identical output).

import "std.simd"

fn main() -> int uses IO {
    let a: I32x4 = simd_i32x4_from(1, 2, 3, 4)
    let b: I32x4 = simd_i32x4_splat(100)
    let sum: I32x4 = simd_i32x4_add(a, b)
    println("lanes: " + simd_i32x4_lane(sum, 0).to_str() + " "
        + simd_i32x4_lane(sum, 1).to_str() + " "
        + simd_i32x4_lane(sum, 2).to_str() + " "
        + simd_i32x4_lane(sum, 3).to_str())

    let xs: list[int] = [3, 1, 4, 1, 5, 9, 2, 6]
    let v: I32x4 = simd_i32x4_gather(xs, 0)
    let doubled: I32x4 = simd_i32x4_add(v, v)
    simd_i32x4_scatter(xs, 4, doubled)
    println("after gather+double+scatter: " + join(
        [xs.get(4).to_str(), xs.get(5).to_str(), xs.get(6).to_str(), xs.get(7).to_str()], " "))

    let ys: list[int] = [10, 20, 30, 40, 50, 60, 70, 80]
    println("transform_sum(3,1): " + simd_transform_sum_i32x4(xs, ys, 3, 1).to_str())
    println("correlate8: " + simd_correlate8_sum_i32x4(xs, 3, 1, 4, 1, 5, 9, 2, 6).to_str())

    if has_feature("avx2") {
        println("compiled with --target-feature avx2 (intrinsics active)")
    } else {
        println("portable path (compile with --target-feature avx2 for intrinsics)")
    }
    println("CPU has AVX2: " + simd_cpu_supports("avx2").to_str())
    return 0
}
