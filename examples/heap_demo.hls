# examples/heap_demo.hls — Stage 100 (v0.119.0-alpha): the separation-
# logic fragment — heap shapes. `hlprove --shapes` reads the HEAP out of
# these functions: every list binding gets an alias class (assignment
# aliases — Halis values are references; clone(..) is fresh; unknown
# provenance is the wildcard), written classes get separation verdicts
# (own(a) * own(b) — proven from freshness evidence, never assumed:
# f(xs, xs) is legal and aliases the parameters), and every cursor walk
# anchored directly on xs.len() gets its shape triple decided:
#
#   {lseg(xs, 0, i) * cell(xs, i) * lseg(xs, i+1, xs.len())} body {...}
#
# — initiation and preservation go to the SMT backend (z3, or cvc5 with
# --cvc5), the frame check (writes stay in the cursor cell, no push/pop)
# is what lets len(xs) be a loop-invariant Int in the encoding. The
# fragment is analysis-only: everything below runs identically on the
# interpreter and natively.
#
#   make shapes F=examples/heap_demo.hls
#   make shapes-smt F=examples/heap_demo.hls
#   make shapes-acceptance        — the full Stage 100 gate

# The flagship walk: for-range anchored on the list's own extent. The
# shape is proven and both cursor accesses (read + write) are in bounds
# by shape — the interval engine alone cannot prove this loop (widening
# loses i < xs.len()).
fn double_all(xs: list[int]) -> int {
    for i: int in range(0, xs.len()) {
        xs[i] = xs[i] * 2
    }
    return 0
}

# The same walk in while form: the anchor is the condition itself, the
# cursor steps +1 after the accesses. Proven — the frame holds (every
# write is xs[i], no push/pop), so len(xs) is fixed in the obligations.
fn square_all(xs: list[int]) -> int {
    let mut i: int = 0
    while i < xs.len() {
        xs.set(i, xs.get(i) * xs.get(i))
        i = i + 1
    }
    return 0
}

# A conditional bump: the shape survives (i' = i | i + 1), but the
# access after the `if` is NOT claimed — after a bump the cursor may
# sit at len(xs), where xs[i] would be out of bounds. The refusal is
# the tool being right about a real hazard, not being shy.
fn bump_some(xs: list[int], flag: bool) -> int {
    let mut i: int = 0
    while i < xs.len() {
        if flag {
            i = i + 1
        }
        xs[i] = 5
    }
    return 0
}

# A frame violation on purpose: xs[0] is not the cursor cell, so the
# visited prefix is NOT untouched and the shape is refused.
fn smear(xs: list[int]) -> int {
    let mut i: int = 0
    while i < xs.len() {
        xs[0] = i
        i = i + 1
    }
    return 0
}

# Separation, refused honestly: both writes go through caller-owned
# classes, and f(a, a) at the call site would alias them — without
# fresh evidence the fragment claims nothing.
fn tag_both(a: list[int], b: list[int]) -> int {
    a[0] = 1
    b[0] = 2
    return 0
}

# Separation, proven: buf is allocated INSIDE the function, so its
# cells are disjoint from every pre-existing object — own(a) * own(buf).
fn seed(a: list[int]) -> int {
    let buf: list[int] = [0, 0, 0]
    for k: int in range(0, buf.len()) {
        buf[k] = a[k] + 1
    }
    a[0] = buf[0] + buf[1] + buf[2]
    return 0
}

fn show(tag: str, xs: list[int]) -> str {
    let mut out: str = tag + ":"
    for v: int in xs {
        out = out + " " + v.to_str()
    }
    return out
}

fn main() -> int uses IO {
    let xs: list[int] = [1, 2, 3, 4]
    double_all(xs)
    println(show("doubled", xs))
    square_all(xs)
    println(show("squared", xs))
    smear(xs)
    println(show("smeared", xs))
    let ys: list[int] = [10, 20, 30]
    tag_both(xs, ys)
    println(show("tagged", ys))
    seed(ys)
    println(show("seeded", ys))
    return 0
}
