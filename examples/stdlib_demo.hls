import "std.str"
import "std.math"
import "std.json"

fn main() -> int uses IO {
    println("=== std.str ===")
    println("repeat: " + str_repeat("ab", 3))
    println("reverse: " + str_reverse("hello"))
    println("join: " + str_join(["a", "b", "c"], "-"))
    println("replace: " + str_replace("a-b-c", "-", "+"))
    println("upper: " + str_to_upper_ascii("hello World"))
    println("lower: " + str_to_lower_ascii("HELLO World"))
    println("count: " + str_count("ababab", "ab").to_str())
    println("pad_left: [" + str_pad_left("12", 5, "0") + "]")
    println("pad_right: [" + str_pad_right("12", 5, " ") + "]")

    println("=== std.math ===")
    println("abs(-5)=" + math_abs_int(-5).to_str())
    println("max(3,7)=" + math_max_int(3, 7).to_str())
    println("clamp(15,0,10)=" + math_clamp_int(15, 0, 10).to_str())
    println("power(2,10)=" + math_power_int(2, 10).to_str())
    println("sqrt(2)=" + math_sqrt(2.0).to_str())
    println("floor(3.7)=" + math_floor(3.7).to_str())
    println("ceil(3.2)=" + math_ceil(3.2).to_str())
    println("round(2.5)=" + math_round(2.5).to_str())
    println("sum_int=" + math_sum_int([1, 2, 3, 4, 5]).to_str())

    println("=== std.json ===")
    let src: str = "{\"name\":\"Hieu\",\"age\":30,\"items\":[1,2,3],\"active\":true}"
    let v: JsonValue = json_parse(src)
    let name: JsonValue = json_object_get(v, "name")
    println("name=" + name.sval)
    let age: JsonValue = json_object_get(v, "age")
    println("age=" + age.ival.to_str())
    let items: JsonValue = json_object_get(v, "items")
    println("items_len=" + items.arr.len().to_str())
    let active: JsonValue = json_object_get(v, "active")
    println("active=" + active.bval.to_str())

    # Round-trip
    println("roundtrip=" + json_stringify(v))

    # Build a JSON value
    let keys: list[str] = ["lang", "version"]
    let vals: list[JsonValue] = [json_str("Hieu Louis"), json_int(2)]
    let obj: JsonValue = json_object(keys, vals)
    println("built=" + json_stringify(obj))

    return 0
}
