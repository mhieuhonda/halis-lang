# math_demo.hls — Stage 50 (v0.69.0-alpha): std.math — IEEE-754 edge cases,
# libm-backed transcendental functions, special functions, BigDecimal.
#
# This demo exercises the new Stage 50 API:
#   - IEEE-754 predicates: isnan, isinf, isfinite, signbit
#   - Trig: sin, cos, tan, asin, acos, atan, atan2, sinh, cosh, tanh
#   - Exp/log: exp, log, log10, log2, pow, sqrt, cbrt
#   - Helpers: hypot, fmod, copysign
#   - Special: erf, erfc, tgamma, lgamma
#   - Constants: pi, e, pos_inf, neg_inf, nan
#   - BigDecimal: arbitrary-precision decimal arithmetic

import "std.math"
import "std.result"
import "std.str"

fn approx(a: float, b: float, eps: float) -> bool {
    if math_isnan(a) && math_isnan(b) {
        return true
    }
    if a == b {
        return true
    }
    let mut d: float = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d < eps
}

fn show(label: str, v: float) -> void uses IO {
    println(label + " = " + v.to_str())
}

fn unwrap_bd(r: Result[BigDecimal, str]) -> BigDecimal uses IO {
    return match r {
        Result.Ok(v) => v,
        Result.Err(msg) => panic("bigdecimal_from_str failed: " + msg)
    }
}

fn main() -> int uses IO {
    println("=== Stage 50: std.math — IEEE-754 + transcendental + BigDecimal ===")
    println("")

    # ----- IEEE-754 edge cases -----
    println("--- IEEE-754 edge cases ---")
    show("pi", math_pi())
    show("e", math_e())
    show("sqrt(2)", math_sqrt(2.0))
    show("sin(pi/2)", math_sin(math_pi() / 2.0))
    show("cos(pi)", math_cos(math_pi()))
    show("exp(1)", math_exp(1.0))
    show("log(e)", math_log(math_e()))
    show("log10(1000)", math_log10(1000.0))
    show("log2(8)", math_log2(8.0))
    show("pow(2, 10)", math_pow(2.0, 10.0))
    show("hypot(3, 4)", math_hypot(3.0, 4.0))
    show("cbrt(27)", math_cbrt(27.0))
    show("erf(1)", math_erf(1.0))
    show("tgamma(5)", math_tgamma(5.0))
    show("lgamma(5)", math_lgamma(5.0))

    # NaN / Inf / signed zero handling.
    println("")
    println("--- NaN / Inf / signed zero ---")
    let nan_v: float = 0.0 / 0.0
    let inf_v: float = 1.0 / 0.0
    let neg_inf_v: float = 0.0 - 1.0 / 0.0
    println("isnan(NaN) = " + math_isnan(nan_v).to_str())
    println("isinf(+Inf) = " + math_isinf(inf_v).to_str())
    println("isinf(-Inf) = " + math_isinf(neg_inf_v).to_str())
    println("isfinite(1.0) = " + math_isfinite(1.0).to_str())
    println("signbit(-1.0) = " + math_signbit(-1.0).to_str())
    println("copysign(3, -1) = " + math_copysign(3.0, -1.0).to_str())

    # ----- BigDecimal — exact decimal arithmetic -----
    println("")
    println("--- BigDecimal (exact decimal arithmetic) ---")
    let a: BigDecimal = unwrap_bd(bigdecimal_from_str("0.1"))
    let b: BigDecimal = unwrap_bd(bigdecimal_from_str("0.2"))
    let sum: BigDecimal = bigdecimal_add(a, b)
    println("BigDecimal: 0.1 + 0.2 = " + bigdecimal_to_str(sum))
    # Should print "0.3" exactly (not 0.30000000000000004 like IEEE-754).

    let c: BigDecimal = unwrap_bd(bigdecimal_from_str("0.1"))
    let sq: BigDecimal = bigdecimal_mul(c, c)
    println("BigDecimal: 0.1 * 0.1 = " + bigdecimal_to_str(sq))
    # Should print "0.01" exactly.

    let big1: BigDecimal = bigdecimal_from_int(1000000000)
    let big2: BigDecimal = bigdecimal_from_int(2000000000)
    let big_sum: BigDecimal = bigdecimal_add(big1, big2)
    println("BigDecimal: 1e9 + 2e9 = " + bigdecimal_to_str(big_sum))

    let neg_a: BigDecimal = bigdecimal_from_int(-50)
    let pos_b: BigDecimal = bigdecimal_from_int(25)
    let diff: BigDecimal = bigdecimal_sub(pos_b, neg_a)
    println("BigDecimal: 25 - (-50) = " + bigdecimal_to_str(diff))

    # Verify the canonical IEEE-754 counter-example.
    if bigdecimal_to_str(sum) == "0.3" {
        println("BigDecimal: 0.1 + 0.2 == 0.3 (exact) — IEEE-754 counter-example verified")
    } else {
        println("FAIL: 0.1 + 0.2 != 0.3")
        return 1
    }

    println("")
    println("ACCEPTANCE OK: Stage 50 — std.math (IEEE-754 + transcendental + BigDecimal)")
    return 0
}
