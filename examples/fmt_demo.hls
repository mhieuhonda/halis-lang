# fmt_demo.hls — Stage 42 (v0.61.0-alpha): std.fmt demo.
#
# This demo shows the std.fmt API — Rust-style Display / Debug traits
# and the format-string interpreter. The library follows the same
# convention as std.io (Stage 35): monomorphic helpers per concrete
# type (Display and Debug), with a FmtValue enum for heterogeneous
# format args.
#
# The demo:
#   1. Display formatters for int, str, bool, float.
#   2. Debug formatters (with quoting and escapes for strings).
#   3. Format-string interpreter — basic placeholders.
#   4. Explicit positional indexes ({0}, {1}, ...).
#   5. Debug specifier {:?}.
#   6. Width and alignment ({:>N}, {:<N}, {:^N}).
#   7. Zero-pad ({:0N}).
#   8. Number bases ({:b}, {:o}, {:x}, {:X}).
#   9. Float precision ({:.P}).
#  10. Width + precision combinations.
#  11. Literal braces ({{ and }}).
#  12. Error handling (missing args, bad specifiers).
#  13. Real-world format strings (table rows, status lines, etc.).

import "std.fmt"
import "std.str"
import "std.option"
import "std.result"

# ============================================================================
# Helper: format-or-panic.
# ============================================================================

fn fp(format: str, args: list[FmtValue]) -> str {
    let r: Result[str, str] = fmt(format, args)
    if !result_is_ok(r) {
        panic("fmt(" + format + ") failed: " + result_err_or(r, ""))
    }
    return result_unwrap(r)
}

# ============================================================================
# Section 1: Display formatters.
# ============================================================================

fn section_display() -> int uses IO {
    println("=== Section 1: Display formatters ===")
    println("  fmt_display_int(42)    = '" + fmt_display_int(42) + "'")
    println("  fmt_display_int(-17)   = '" + fmt_display_int(-17) + "'")
    println("  fmt_display_str(\"hello\") = '" + fmt_display_str("hello") + "'")
    println("  fmt_display_bool(true) = '" + fmt_display_bool(true) + "'")
    println("  fmt_display_bool(false) = '" + fmt_display_bool(false) + "'")
    println("  fmt_display_float(3.14) = '" + fmt_display_float(3.14) + "'")
    println("  fmt_display_float(0.0)  = '" + fmt_display_float(0.0) + "'")
    return 0
}

# ============================================================================
# Section 2: Debug formatters (with quoting and escapes for strings).
# ============================================================================

fn section_debug() -> int uses IO {
    println("")
    println("=== Section 2: Debug formatters ===")
    println("  fmt_debug_int(42)      = '" + fmt_debug_int(42) + "'")
    println("  fmt_debug_bool(true)  = '" + fmt_debug_bool(true) + "'")
    println("  fmt_debug_str(\"hello\") = '" + fmt_debug_str("hello") + "'")
    println("  fmt_debug_str(\"hello\\nworld\") = '" + fmt_debug_str("hello\nworld") + "'")
    println("  fmt_debug_str(\"a\\tb\")        = '" + fmt_debug_str("a\tb") + "'")
    println("  fmt_debug_str(\"a\\\\b\")        = '" + fmt_debug_str("a\\b") + "'")
    println("  fmt_debug_str(\"a\\\"b\")        = '" + fmt_debug_str("a\"b") + "'")
    # Control bytes use \xNN.
    let s_with_ctrl: str = "x" + chr(1) + "y"
    println("  fmt_debug_str(\"x\\x01y\")      = '" + fmt_debug_str(s_with_ctrl) + "'")
    println("  fmt_debug_float(3.14)  = '" + fmt_debug_float(3.14) + "'")
    return 0
}

# ============================================================================
# Section 3: basic fmt() placeholders.
# ============================================================================

fn section_basic() -> int uses IO {
    println("")
    println("=== Section 3: basic fmt() placeholders ===")
    println("  " + fp("Hello, {}!", [FmtValue.Str("World")]))
    println("  " + fp("{} + {} = {}", [FmtValue.Int(2), FmtValue.Int(3), FmtValue.Int(5)]))
    println("  " + fp("name={}, age={}, active={}", [
        FmtValue.Str("Alice"),
        FmtValue.Int(30),
        FmtValue.Bool(true)
    ]))
    println("  " + fp("pi={}", [FmtValue.Float(3.14159)]))
    return 0
}

# ============================================================================
# Section 4: explicit positional index.
# ============================================================================

fn section_explicit_index() -> int uses IO {
    println("")
    println("=== Section 4: explicit positional index ===")
    println("  " + fp("{0} and {1}", [FmtValue.Str("foo"), FmtValue.Str("bar")]))
    println("  " + fp("{0} and {1} and {0}", [FmtValue.Str("foo"), FmtValue.Str("bar")]))
    println("  " + fp("{2}-{1}-{0}", [FmtValue.Int(1), FmtValue.Int(2), FmtValue.Int(3)]))
    return 0
}

# ============================================================================
# Section 5: Debug specifier {:?}.
# ============================================================================

fn section_debug_spec() -> int uses IO {
    println("")
    println("=== Section 5: Debug specifier {:?} ===")
    println("  " + fp("{:?}", [FmtValue.Str("hello")]))
    println("  " + fp("{:?}", [FmtValue.Str("a\nb\tc")]))
    println("  " + fp("{:?}", [FmtValue.Int(42)]))
    println("  " + fp("{:?}", [FmtValue.Bool(false)]))
    return 0
}

# ============================================================================
# Section 6: width and alignment.
# ============================================================================

fn section_width() -> int uses IO {
    println("")
    println("=== Section 6: width and alignment ===")
    println("  right:  '" + fp("[{:>10}]", [FmtValue.Int(42)]) + "'")
    println("  left:   '" + fp("[{:<10}]", [FmtValue.Int(42)]) + "'")
    println("  center: '" + fp("[{:^10}]", [FmtValue.Int(42)]) + "'")
    println("  right str:  '" + fp("[{:>10}]", [FmtValue.Str("hi")]) + "'")
    println("  left str:   '" + fp("[{:<10}]", [FmtValue.Str("hi")]) + "'")
    println("  center str: '" + fp("[{:^10}]", [FmtValue.Str("hi")]) + "'")
    println("  default (no align):")
    println("    '" + fp("[{:5}]", [FmtValue.Str("ab")]) + "'  (str defaults left)")
    println("    '" + fp("[{:5}]", [FmtValue.Int(42)]) + "'  (int defaults right)")
    return 0
}

# ============================================================================
# Section 7: zero-pad.
# ============================================================================

fn section_zero_pad() -> int uses IO {
    println("")
    println("=== Section 7: zero-pad ===")
    println("  " + fp("[{:05}]", [FmtValue.Int(42)]))
    println("  " + fp("[{:05}]", [FmtValue.Int(-42)]))
    println("  " + fp("[{:05}]", [FmtValue.Int(0)]))
    println("  " + fp("[{:08x}]", [FmtValue.Int(255)]))
    return 0
}

# ============================================================================
# Section 8: number bases.
# ============================================================================

fn section_bases() -> int uses IO {
    println("")
    println("=== Section 8: number bases ===")
    println("  bin 255: " + fp("[{:b}]", [FmtValue.Int(255)]))
    println("  oct 64:  " + fp("[{:o}]", [FmtValue.Int(64)]))
    println("  hex 255: " + fp("[{:x}]", [FmtValue.Int(255)]))
    println("  HEX 255: " + fp("[{:X}]", [FmtValue.Int(255)]))
    println("  hex 171: " + fp("[{:x}]", [FmtValue.Int(171)]))
    return 0
}

# ============================================================================
# Section 9: float precision.
# ============================================================================

fn section_precision() -> int uses IO {
    println("")
    println("=== Section 9: float precision ===")
    println("  pi (2 dp):  " + fp("[{:.2}]", [FmtValue.Float(3.14159)]))
    println("  pi (0 dp):  " + fp("[{:.0}]", [FmtValue.Float(3.14159)]))
    println("  1.5 (4 dp): " + fp("[{:.4}]", [FmtValue.Float(1.5)]))
    println("  0.1 (10):   " + fp("[{:.10}]", [FmtValue.Float(0.1)]))
    println("  99.99 (0):  " + fp("[{:.0}]", [FmtValue.Float(99.99)]))
    return 0
}

# ============================================================================
# Section 10: width + precision combinations.
# ============================================================================

fn section_combinations() -> int uses IO {
    println("")
    println("=== Section 10: width + precision ===")
    println("  " + fp("[{:>10.2}]", [FmtValue.Float(3.14159)]))
    println("  " + fp("[{:<10.4}]", [FmtValue.Float(1.5)]))
    println("  " + fp("[{:^12.3}]", [FmtValue.Float(2.71828)]))
    return 0
}

# ============================================================================
# Section 11: literal braces.
# ============================================================================

fn section_literal_braces() -> int uses IO {
    println("")
    println("=== Section 11: literal braces ===")
    println("  " + fp("{{literal}}", []))
    println("  " + fp("{{count = {}}}", [FmtValue.Int(42)]))
    println("  " + fp("pre{{mid}}post", []))
    return 0
}

# ============================================================================
# Section 12: error handling.
# ============================================================================

fn section_errors() -> int uses IO {
    println("")
    println("=== Section 12: error handling ===")
    let e1: Result[str, str] = fmt("{} {}", [FmtValue.Int(1)])
    println("  missing arg:    " + result_err_or(e1, ""))
    let e2: Result[str, str] = fmt("{:z}", [FmtValue.Int(1)])
    println("  bad specifier:  " + result_err_or(e2, ""))
    let e3: Result[str, str] = fmt("hello {", [])
    println("  unmatched '{':   " + result_err_or(e3, ""))
    let e4: Result[str, str] = fmt("{:>99999}", [FmtValue.Int(1)])
    println("  width too big:  " + result_err_or(e4, ""))
    return 0
}

# ============================================================================
# Section 13: real-world format strings.
# ============================================================================

fn section_real_world() -> int uses IO {
    println("")
    println("=== Section 13: real-world examples ===")
    # Table row.
    let table: str = fp("| {:<10} | {:>5} | {:>8} |", [
        FmtValue.Str("apple"),
        FmtValue.Int(42),
        FmtValue.Float(3.14)
    ])
    println("  table row:")
    println("    " + table)

    let table2: str = fp("| {:<10} | {:>5} | {:>8} |", [
        FmtValue.Str("banana"),
        FmtValue.Int(7),
        FmtValue.Float(0.5)
    ])
    println("    " + table2)

    # Status line.
    let status: str = fp("[{:?}] {} processed {} items in {}ms", [
        FmtValue.Str("INFO"),
        FmtValue.Str("worker-1"),
        FmtValue.Int(100),
        FmtValue.Int(23)
    ])
    println("  status line:")
    println("    " + status)

    # Hex dump.
    let hexdump: str = fp("addr={:08x} size={:4} bytes", [
        FmtValue.Int(255),
        FmtValue.Int(16)
    ])
    println("  hex dump:")
    println("    " + hexdump)

    # Date format.
    let date: str = fp("{:04}-{:02}-{:02}", [
        FmtValue.Int(2024),
        FmtValue.Int(12),
        FmtValue.Int(25)
    ])
    println("  date:           " + date)

    # Error message with multiple fields.
    let err_msg: str = fp("ERROR: failed to open '{:?}' (errno={}, msg={})", [
        FmtValue.Str("/etc/passwd\n"),
        FmtValue.Int(13),
        FmtValue.Str("Permission denied")
    ])
    println("  error message:")
    println("    " + err_msg)

    # Currency-like format.
    let price: str = fp("${:.2}", [FmtValue.Float(19.99)])
    println("  price:          " + price)

    let total: str = fp("${:.2}", [FmtValue.Float(99.5)])
    println("  total:          " + total)
    return 0
}

# ============================================================================
# Main.
# ============================================================================

fn main() -> void uses IO {
    println("===========================================================")
    println("  Stage 42 (v0.61.0-alpha): std.fmt demo")
    println("  Display / Debug traits + format! macro analogue")
    println("===========================================================")
    section_display()
    section_debug()
    section_basic()
    section_explicit_index()
    section_debug_spec()
    section_width()
    section_zero_pad()
    section_bases()
    section_precision()
    section_combinations()
    section_literal_braces()
    section_errors()
    section_real_world()
    println("")
    println("FMT DEMO COMPLETE")
}
