# audit_demo.hls — Stage 103 (v0.122.0-alpha): the supply-chain
# effect report demo.
#
# A small program whose DEPENDENCIES do more than the program
# announces. Read the header: `uses IO` — that is all THIS file
# declares. But the import tree underneath it resolves hosts,
# measures elapsed time, and crosses one C boundary:
#
#   audit_demo.hls
#   |- std.str                      [toolchain] (pure string help)
#   `- audit_libs/netcheck.hls      [workspace]
#      |- geo.hls                   [workspace] — Clock, intrinsic
#      |  `- std.str                [toolchain]
#      `- (extern "C" labs, declared pure)
#
# The report tells you what the header does not:
#
#   python3 tools/hls-audit.py examples/audit_demo.hls
#   python3 tools/hls-audit.py examples/audit_demo.hls --allow IO,Fs
#   python3 tools/hls-audit.py examples/audit_demo.hls --json
#
#   Net   introduced by netcheck.hls (the DNS lookup)
#   Clock introduced by geo.hls, entering through netcheck's import
#   IO    introduced twice — the entry file AND netcheck's log_line —
#         one effect, two introduction points, both drawn
#
# Gate the chain and the clock is the finding (it is not in the
# allow list):
#
#   python3 tools/hls-audit.py examples/audit_demo.hls --allow IO,Net
#   ... verdict: VIOLATED — Clock (introduced by geo.hls)
#   ...       via: audit_demo.hls -> netcheck.hls -> geo.hls
#
# The demo itself runs: it times one (fake) lookup and prints the
# shapes the report reasoned about. Nothing here is compiled
# differently by being audited — the report reads the tree, it does
# not touch it.

import "std.str"
import "audit_libs/netcheck.hls"

fn main() -> int uses IO {
    let host: str = "localhost"
    println("auditing the tree of one lookup for " + host)
    println("  key       = " + cache_key(host))
    println("  elapsed   = the clock ticks here (Clock, introduced"
    + " by geo.hls)")
    println("  c_labs    = libc labs, wrapped by delta_ms (the extern"
    + " the report names)")
    println("surface: IO declared here; Net and Clock arrive with "
    + "the imports")
    return 0
}
