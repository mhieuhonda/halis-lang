# auditlog_demo.hls — Stage 112 (v0.131.0-alpha): hls-auditlog, the
# audit-log signing (every privileged op hashed + chained).
#
# Run it, then look at what the toolchain wrote about itself:
#
#   python3 boot/boot.py examples/auditlog_demo.hls
#   python3 tools/hls-auditlog.py list
#   python3 tools/hls-auditlog.py verify
#   python3 tools/hls-auditlog.py sign          # a signed checkpoint
#   python3 tools/hls-auditlog.py verify-sign hls-audit-ckpt-*.ckpt.json -p hls-sign.pub
#
# The program narrates the stage's vocabulary in miniature: entries
# chain (prev + body, deterministically), refusals occupy a seq
# exactly like successes, the op inventory is a closed set of dotted
# family.action names, the checkpoint verdicts reduce to three
# answers over two facts, and the checkpoint op always lands one
# past the history it pinned. The audit log is the forensic trail —
# this program is the same arithmetic, checked live.

import "std.str"
import "std.crypto"

# An entry is prev + body hashed — flip either and the chain moves.
fn entry_hash(prev: str, body: str) -> str {
    return crypto_fnv1a_64_hex(prev + body)
}

# The chain in miniature: four ops, one of them refused — the head
# walks four steps no matter what the outcome word was.
fn chain_head(p0: str, refused_at: int) -> str {
    let mut prev: str = p0
    let mut i: int = 0
    while i < 4 {
        let mut body: str = "op" + i.to_str() + ":body"
        if i == refused_at {
            body = body + "!"
        }
        prev = entry_hash(prev, body)
        i = i + 1
    }
    return prev
}

# The verdict table: rollback / rewritten / held, over the log's
# length and the head comparison. 0 held, 1 rewritten, 2 rollback.
fn verdict(cur_len: int, ck_len: int, heads_eq: bool) -> int {
    if cur_len < ck_len {
        return 2
    }
    if heads_eq {
        return 0
    }
    return 1
}

fn main() -> int uses IO {
    println("== hls-auditlog, in miniature ==")

    # Determinism: the same history hashes to the same head.
    let a: str = chain_head("00", -1)
    let b: str = chain_head("00", -1)
    if a != b {
        panic("the same history must hash to the same head")
    }
    println("  the chain replays: same entries, same head")

    # A refusal moves the head as surely as a success.
    let plain: str = chain_head("00", -1)
    let refused: str = chain_head("00", 2)
    if plain == refused {
        panic("a refusal must be visible in the head")
    }
    println("  a refused op occupies a seq: the head moves")

    # The verdicts: below the signed length is evidence; a wrong
    # head is a rewrite; a match holds at and above the length.
    if verdict(3, 4, true) != 2 {
        panic("shrunk under a promise: rollback")
    }
    if verdict(4, 4, false) != 1 || verdict(7, 4, false) != 1 {
        panic("wrong head: rewritten")
    }
    if verdict(4, 4, true) != 0 || verdict(7, 4, true) != 0 {
        panic("matching head: held")
    }
    println("  the checkpoint verdicts: rollback / rewritten / held")

    # The inventory is closed and dotted: five families.
    if !str_starts_with("pkg.lock", "pkg.")
            || !str_starts_with("sign.release", "sign.")
            || !str_starts_with("sandbox.run", "sandbox.")
            || !str_starts_with("tlog.witness", "tlog.")
            || !str_starts_with("auditlog.checkpoint", "auditlog.") {
        panic("every op names its family")
    }
    println("  the inventory: pkg. sign. sandbox. tlog. auditlog.")

    println("audit log demo: hashed, chained, signed, zero vibes")
    return 0
}
