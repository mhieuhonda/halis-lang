# fibonacci.hls — recursion + loops, overflow-checked arithmetic.
#
# Stage 30 (v0.47.0-alpha): fib_loop's inner loop is the roadmap's
# escape-analysis acceptance target — "the inner loop allocates zero
# heap objects". The sliding window [a, b] is a #[stack] list: the
# checker PROVED it never escapes fib_loop's frame (every use is a
# borrow-safe .get/.set receiver), so the C backend lays it out as a
# plain int64_t[2] array in the frame. Zero hl_list structs, zero
# boxed elements, zero refcount traffic — verified by the
# `make escape-acceptance` gate (valgrind --tool=massif when
# available, else the -Wl,--wrap=malloc interposer).
#
# fib(n) itself stays on the recursive path (checked arithmetic, the
# classic compiler stress shape); fib_loop is the O(n) iterative path.
#
# Stage 31 (v0.48.0-alpha): fib_tail is the roadmap's verified
# tail-call acceptance target — "runs fib(1_000_000) without stack
# overflow". The #[tail_call] attribute asserts the recursive call is
# in tail position (a compile error if not); the checker verifies the
# whole body needs NO cleanup between the call and the return, and
# the codegen lowers the recursion to a parameter-rebinding `goto` —
# a jmp, not a call. Stack usage is constant regardless of depth:
# fib_tail(1_000_000) uses the same frame as fib_tail(1). The
# interpreter mirrors the transform as a trampoline, so the Stage-0
# path runs the same depth with zero Python recursion. Verified by
# the `make tail-acceptance` gate (native run under `ulimit -s 1024`
# — a 1M-deep call chain at ~48 bytes/frame would need ~48 MB of
# stack; the loop fits in kilobytes).

fn fib(n: int) -> int {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

# fib_loop: the iterative O(n) path. The #[stack] window list is
# created and consumed entirely inside this frame — the escape
# analysis proved it, and #[stack] turns that proof into a compile-time
# guarantee (any escaping use would be a compile error naming the site).
fn fib_loop(n: int) -> int {
    #[stack]
    let window: list[int] = [0, 1]
    let mut i: int = 0
    while i < n {
        # window.get / window.set are in-frame borrows — the classic
        # sliding-window update, now with zero heap traffic.
        let next: int = window.get(0) + window.get(1)
        window.set(0, window.get(1))
        window.set(1, next)
        i = i + 1
    }
    # After n iterations the window holds [F(n), F(n+1)].
    return window.get(0)
}

# fib_tail: the Stage 31 verified tail-call target. The accumulator
# form (a, b) = (F(n), F(n+1)) is the classic tail-recursive
# Fibonacci; the modulo keeps every intermediate in int64 range so
# fib_tail(1_000_000) is exact modular arithmetic, not overflow.
#[tail_call]
fn fib_tail(n: int, a: int, b: int) -> int {
    if n == 0 {
        return a
    }
    # The ONLY recursive call — and it is the entire return
    # expression, in verified tail position with primitive-only
    # dataflow (the checker rejects anything needing cleanup at the
    # jump). Native codegen: evaluate the three arguments into temps,
    # rebind (n, a, b), `goto hl_tail_restart`. Interpreter: the same
    # rebind in a trampoline loop. Constant stack, both backends.
    return fib_tail(n - 1, b, (a + b) % 1000000007)
}

# spin_fib: calls the inner loop `rounds` times so the acceptance gate
# can observe allocation behaviour over many iterations (20,000
# rounds keeps the interpreter under ~10 s while the boxed twin still
# allocates 640,000+ objects). Pure (no
# uses clause) — the compiler statically guarantees it performs no
# I/O, which is exactly what a zero-allocation inner loop should be.
fn spin_fib(rounds: int) -> int {
    let mut acc: int = 0
    let mut r: int = 0
    while r < rounds {
        acc = acc + fib_loop(30)
        r = r + 1
    }
    return acc
}

fn main() -> int uses IO {
    let mut i: int = 0
    while i < 12 {
        print(fib(i).to_str() + " ")
        i = i + 1
    }
    println("")
    println("fib_loop(70) = " + fib_loop(70).to_str())
    # The acceptance workload: 20,000 iterations of the (stack-laid-out)
    # inner loop (kept interpreter-friendly; the #[boxed] twin still
    # allocates 640,000+ heap objects for the gate). Output stays deterministic so the interpreter and the
    # native binary remain byte-identical (differential suite).
    println("spin_fib(20000) = " + spin_fib(20000).to_str())
    # Stage 31: the verified tail-call workload. Default depth is
    # 100,000 (fast for the differential suite); passing a CLI
    # argument overrides it — `./fibonacci 1000000` (or
    # `boot.py examples/fibonacci.hls 1000000`) runs the roadmap's
    # literal acceptance depth. args()[0] is the program name on both
    # the interpreter and the native binary (wordcount convention),
    # so the depth argument is args()[1]. Either way the stack is
    # constant: the recursion is a goto, not a call.
    let mut depth: int = 100000
    if args().len() > 1 {
        depth = int(args().get(1))
    }
    println("fib_tail(" + depth.to_str() + ") = " + fib_tail(depth, 0, 1).to_str())
    return 0
}
