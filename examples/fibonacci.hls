# fibonacci.hls — de quy + vong lap, so hoc kiem tra tran
fn fib(n: int) -> int {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn fib_vong(n: int) -> int {
    let mut a: int = 0
    let mut b: int = 1
    let mut i: int = 0
    while i < n {
        let t: int = a + b
        a = b
        b = t
        i = i + 1
    }
    return a
}

fn main() -> int uses IO {
    let mut i: int = 0
    while i < 12 {
        print(fib(i).to_str() + " ")
        i = i + 1
    }
    println("")
    println("fib_vong(70) = " + fib_vong(70).to_str())
    return 0
}
