# examples/pkg_demo.hls — Stage 13 demo: a "package" entry point.
#
# This file demonstrates the structure a real `hls-pkg` entry point
# would take. To actually run it via `hls-pkg`, you would:
#
#   $ cd /tmp
#   $ hls-pkg (bin/hls-pkg, built by make) init mypkg
#   $ cd mypkg
#   $ hls-pkg (bin/hls-pkg, built by make) add std.str \
#       https://github.com/mhieuhonda/halis-lang.git std/str.hls
#   $ # edit hls-pkg.toml to set effects.allowed = ["IO"]
#   $ hls-pkg (bin/hls-pkg, built by make) lock
#   $ hls-pkg (bin/hls-pkg, built by make) audit
#   $ hls-pkg (bin/hls-pkg, built by make) build
#
# (You'd also replace main.hls with this file's content.)

import "std.str"

fn greet(name: str) -> str {
    return str_repeat("Hello, ", 1) + name + "!"
}

fn main() -> int uses IO {
    let names: list[str] = ["Hieu", "Louis", "World"]
    for n: str in names {
        println(greet(n))
    }
    return 0
}
