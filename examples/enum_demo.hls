# enum_demo.hls — demonstrates enums, match, and recursive types
# Stage 7 example

enum Color {
    Red,
    Green,
    Blue
}

enum Shape {
    Circle(float),
    Rect(float, float),
    Point
}

enum Tree {
    Leaf,
    Node(int, Tree, Tree)
}

fn color_name(c: Color) -> str {
    return match c {
        Color.Red => "red",
        Color.Green => "green",
        Color.Blue => "blue"
    }
}

fn shape_area(s: Shape) -> float {
    return match s {
        Shape.Circle(r) => r * r * 3.14159,
        Shape.Rect(w, h) => w * h,
        Shape.Point => 0.0
    }
}

fn tree_sum(t: Tree) -> int {
    return match t {
        Tree.Leaf => 0,
        Tree.Node(v, l, r) => v + tree_sum(l) + tree_sum(r)
    }
}

fn tree_max(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

fn tree_depth(t: Tree) -> int {
    return match t {
        Tree.Leaf => 0,
        Tree.Node(_, l, r) => tree_max(tree_depth(l), tree_depth(r)) + 1
    }
}

fn main() -> int uses IO {
    let c: Color = Color.Blue
    println("color: " + color_name(c))

    let shapes: list[Shape] = [Shape.Circle(2.0), Shape.Rect(3.0, 4.0), Shape.Point]
    let mut i: int = 0
    while i < shapes.len() {
        println("area = " + shape_area(shapes.get(i)).to_str())
        i = i + 1
    }

    let t: Tree = Tree.Node(1,
        Tree.Node(2, Tree.Leaf, Tree.Leaf),
        Tree.Node(3, Tree.Node(4, Tree.Leaf, Tree.Leaf), Tree.Leaf))
    println("tree sum = " + tree_sum(t).to_str())
    println("tree depth = " + tree_depth(t).to_str())
    return 0
}
