# util_tribonacci: Tribonacci sequence T(n) for n in [0, 12].
fn util_tribonacci(n: int) -> int {
    if n == 0 {
        return 0
    }
    if n == 1 {
        return 0
    }
    if n == 2 {
        return 1
    }
    let mut a: int = 0
    let mut b: int = 0
    let mut c: int = 1
    let mut i: int = 3
    while i <= n {
        let t: int = a + b + c
        a = b
        b = c
        c = t
        i = i + 1
    }
    return c
}

# util_lucas: Lucas number L(n) for n in [0, 15].
fn util_lucas(n: int) -> int {
    if n == 0 {
        return 2
    }
    if n == 1 {
        return 1
    }
    let mut a: int = 2
    let mut b: int = 1
    let mut i: int = 2
    while i <= n {
        let t: int = a + b
        a = b
        b = t
        i = i + 1
    }
    return b
}

# util_padovan: Padovan sequence P(n) for n in [0, 15].
fn util_padovan(n: int) -> int {
    if n < 3 {
        return 1
    }
    let mut a: int = 1
    let mut b: int = 1
    let mut c: int = 1
    let mut i: int = 3
    while i <= n {
        let t: int = a + b
        a = b
        b = c
        c = t
        i = i + 1
    }
    return c
}

# util_perrin: Perrin sequence P(n) for n in [0, 15].
fn util_perrin(n: int) -> int {
    if n == 0 {
        return 3
    }
    if n == 1 {
        return 0
    }
    if n == 2 {
        return 2
    }
    let mut a: int = 3
    let mut b: int = 0
    let mut c: int = 2
    let mut i: int = 3
    while i <= n {
        let t: int = a + b
        a = b
        b = c
        c = t
        i = i + 1
    }
    return c
}
