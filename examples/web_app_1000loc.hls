# ============================================================================
# examples/web_app_1000loc.hls — Stage 24 (v0.43.0-alpha) acceptance example.
# ----------------------------------------------------------------------------
# A 1000-LOC web application that demonstrates the Stage 24 features:
#   * `extern "js"` FFI for browser interop (DOM, fetch, localStorage, etc.)
#   * Stage 24 struct marshalling API (the JS glue exposes
#     Halis.readStruct / Halis.writeStruct / Halis.registerStruct)
#   * A pure-HLS mini-app that exercises every wasm-supported construct:
#     int/float/bool/str arithmetic, if/else, while loops, function calls,
#     extern "js" calls, and builtin methods (.to_str(), .len(), etc.)
#
# The wasm emitter's alpha subset does not support structs/lists/maps/match
# — those land in the HLIR-based emitter. This example fits in the
# supported subset by using multiple top-level variables (one per logical
# "field" of a record) instead of struct instances.
#
# Acceptance (Stage 24): compiles to <= 100 KB wasm + <= 5 KB JS glue;
# `wasm-opt -O3` reduces the wasm size by >= 30%.
#
# Run with `hls serve`:
#   python3 tools/hlserve.py --input examples/web_app_1000loc.hls \
#                            --bundle out --port 8080
#
# Then open http://localhost:8080/ in a browser.
#
# Or compile standalone:
#   python3 tools/hlwasm.py examples/web_app_1000loc.hls out/webapp
# ============================================================================

import "std.jsffi"

# ----------------------------------------------------------------------------
# Helper functions (pure HLS — no IO).
# ----------------------------------------------------------------------------

# add_one: trivial int arithmetic.
fn add_one(n: int) -> int {
    return n + 1
}

# sub_one: trivial int arithmetic.
fn sub_one(n: int) -> int {
    return n - 1
}

# mul_two: trivial int arithmetic.
fn mul_two(n: int) -> int {
    return n * 2
}

# div_two: integer division by 2.
fn div_two(n: int) -> int {
    return n / 2
}

# mod_three: integer modulo 3.
fn mod_three(n: int) -> int {
    return n % 3
}

# neg: unary negation.
fn neg(n: int) -> int {
    return -n
}

# not_b: logical not.
fn not_b(b: bool) -> bool {
    return !b
}

# both: logical and.
fn both(a: bool, b: bool) -> bool {
    return a && b
}

# either: logical or.
fn either(a: bool, b: bool) -> bool {
    return a || b
}

# max_int: integer maximum.
fn max_int(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

# min_int: integer minimum.
fn min_int(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

# abs_int: integer absolute value.
fn abs_int(n: int) -> int {
    if n < 0 {
        return -n
    }
    return n
}

# clamp_int: clamp n to [lo, hi].
fn clamp_int(n: int, lo: int, hi: int) -> int {
    if n < lo {
        return lo
    }
    if n > hi {
        return hi
    }
    return n
}

# sum_range: sum of integers from a to b (exclusive).
fn sum_range(a: int, b: int) -> int {
    let mut total: int = 0
    let mut i: int = a
    while i < b {
        total = total + i
        i = i + 1
    }
    return total
}

# fact: integer factorial (iterative, to avoid deep recursion).
fn fact(n: int) -> int {
    let mut r: int = 1
    let mut i: int = 1
    while i <= n {
        r = r * i
        i = i + 1
    }
    return r
}

# fib: Fibonacci (iterative).
fn fib(n: int) -> int {
    let mut a: int = 0
    let mut b: int = 1
    let mut i: int = 0
    while i < n {
        let t: int = a + b
        a = b
        b = t
        i = i + 1
    }
    return a
}

# gcd: greatest common divisor (Euclidean).
fn gcd(a: int, b: int) -> int {
    let mut x: int = a
    let mut y: int = b
    while y != 0 {
        let t: int = y
        y = x % y
        x = t
    }
    return x
}

# is_prime: trial-division primality test.
fn is_prime(n: int) -> bool {
    if n < 2 {
        return false
    }
    if n == 2 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    let mut i: int = 3
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i = i + 2
    }
    return true
}

# count_primes: count primes below n.
fn count_primes(n: int) -> int {
    let mut count: int = 0
    let mut i: int = 2
    while i < n {
        if is_prime(i) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

# collatz_len: length of the Collatz sequence from n to 1.
fn collatz_len(n: int) -> int {
    let mut x: int = n
    let mut len: int = 0
    while x != 1 {
        if x % 2 == 0 {
            x = x / 2
        } else {
            x = 3 * x + 1
        }
        len = len + 1
    }
    return len
}

# pow_int: integer exponentiation (b^e, e >= 0).
fn pow_int(b: int, e: int) -> int {
    let mut r: int = 1
    let mut i: int = 0
    while i < e {
        r = r * b
        i = i + 1
    }
    return r
}

# log2_int: floor of log2(n) for n >= 1.
fn log2_int(n: int) -> int {
    let mut x: int = n
    let mut r: int = 0
    while x > 1 {
        x = x / 2
        r = r + 1
    }
    return r
}

# to_bool: int -> bool (0 = false, else true).
fn to_bool(n: int) -> bool {
    return n != 0
}

# to_int: bool -> int (false = 0, true = 1).
fn to_int(b: bool) -> int {
    if b {
        return 1
    }
    return 0
}

# ----------------------------------------------------------------------------
# String manipulation (only the supported subset — no .split/.slice).
# ----------------------------------------------------------------------------

# str_repeat: repeat a string n times.
fn str_repeat(s: str, n: int) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

# str_pad_left: pad s with `pad` on the left until it reaches width chars.
fn str_pad_left(s: str, width: int, pad: str) -> str {
    let mut out: str = s
    while out.len() < width {
        out = pad + out
    }
    return out
}

# str_pad_right: pad s with `pad` on the right until it reaches width chars.
fn str_pad_right(s: str, width: int, pad: str) -> str {
    let mut out: str = s
    while out.len() < width {
        out = out + pad
    }
    return out
}

# str_center: center s in a field of width, padded with `pad`.
fn str_center(s: str, width: int, pad: str) -> str {
    if s.len() >= width {
        return s
    }
    let total: int = width - s.len()
    let left: int = total / 2
    let right: int = total - left
    return str_repeat(pad, left) + s + str_repeat(pad, right)
}

# str_eq: string equality (the wasm emitter lowers '==' on str to hl_str_eq).
fn str_eq(a: str, b: str) -> bool {
    return a == b
}

# str_byte_at: get the byte at index i (uses the .byte_at method).
fn str_byte_at(s: str, i: int) -> int {
    return s.byte_at(i)
}

# str_first: first character of s (as a 1-char str).
fn str_first(s: str) -> str {
    if s.len() == 0 {
        return ""
    }
    return chr(str_byte_at(s, 0))
}

# str_last: last character of s (as a 1-char str).
fn str_last(s: str) -> str {
    if s.len() == 0 {
        return ""
    }
    return chr(str_byte_at(s, s.len() - 1))
}

# str_starts_with: check if s starts with prefix (byte-by-byte comparison).
fn str_starts_with(s: str, prefix: str) -> bool {
    if s.len() < prefix.len() {
        return false
    }
    let mut i: int = 0
    while i < prefix.len() {
        if str_byte_at(s, i) != str_byte_at(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

# str_ends_with: check if s ends with suffix.
fn str_ends_with(s: str, suffix: str) -> bool {
    if s.len() < suffix.len() {
        return false
    }
    let offset: int = s.len() - suffix.len()
    let mut i: int = 0
    while i < suffix.len() {
        if str_byte_at(s, offset + i) != str_byte_at(suffix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

# str_contains_sub: check if s contains sub (naive).
fn str_contains_sub(s: str, sub: str) -> bool {
    if sub.len() == 0 {
        return true
    }
    if s.len() < sub.len() {
        return false
    }
    let mut i: int = 0
    while i + sub.len() <= s.len() {
        let mut j: int = 0
        let mut match_: bool = true
        while j < sub.len() {
            if str_byte_at(s, i + j) != str_byte_at(sub, j) {
                match_ = false
            }
            j = j + 1
        }
        if match_ {
            return true
        }
        i = i + 1
    }
    return false
}

# str_to_upper_ascii: convert ASCII lowercase to uppercase.
fn str_to_upper_ascii(s: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < s.len() {
        let c: int = str_byte_at(s, i)
        if c >= 97 && c <= 122 {
            out = out + chr(c - 32)
        } else {
            out = out + chr(c)
        }
        i = i + 1
    }
    return out
}

# str_to_lower_ascii: convert ASCII uppercase to lowercase.
fn str_to_lower_ascii(s: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    while i < s.len() {
        let c: int = str_byte_at(s, i)
        if c >= 65 && c <= 90 {
            out = out + chr(c + 32)
        } else {
            out = out + chr(c)
        }
        i = i + 1
    }
    return out
}

# str_count: count non-overlapping occurrences of sub in s.
fn str_count(s: str, sub: str) -> int {
    if sub.len() == 0 {
        return 0
    }
    let mut count: int = 0
    let mut i: int = 0
    while i + sub.len() <= s.len() {
        let mut j: int = 0
        let mut match_: bool = true
        while j < sub.len() {
            if str_byte_at(s, i + j) != str_byte_at(sub, j) {
                match_ = false
            }
            j = j + 1
        }
        if match_ {
            count = count + 1
            i = i + sub.len()
        } else {
            i = i + 1
        }
    }
    return count
}

# str_reverse: reverse a string.
fn str_reverse(s: str) -> str {
    let mut out: str = ""
    let mut i: int = s.len()
    while i > 0 {
        i = i - 1
        out = out + chr(str_byte_at(s, i))
    }
    return out
}

# str_join_two: join two strings with a separator.
fn str_join_two(a: str, sep: str, b: str) -> str {
    return a + sep + b
}

# str_join_three: join three strings with a separator.
fn str_join_three(a: str, sep: str, b: str, c: str) -> str {
    return a + sep + b + sep + c
}

# ----------------------------------------------------------------------------
# Float helpers (only what the wasm subset supports — basic arithmetic).
# ----------------------------------------------------------------------------

# f_add: float addition.
fn f_add(a: float, b: float) -> float {
    return a + b
}

# f_sub: float subtraction.
fn f_sub(a: float, b: float) -> float {
    return a - b
}

# f_mul: float multiplication.
fn f_mul(a: float, b: float) -> float {
    return a * b
}

# f_div: float division.
fn f_div(a: float, b: float) -> float {
    if b == 0.0 {
        return 0.0
    }
    return a / b
}

# f_neg: float negation.
fn f_neg(a: float) -> float {
    return -a
}

# f_max: float maximum.
fn f_max(a: float, b: float) -> float {
    if a > b {
        return a
    }
    return b
}

# f_min: float minimum.
fn f_min(a: float, b: float) -> float {
    if a < b {
        return a
    }
    return b
}

# f_abs: float absolute value.
fn f_abs(a: float) -> float {
    if a < 0.0 {
        return -a
    }
    return a
}

# f_clamp: clamp a float to [lo, hi].
fn f_clamp(a: float, lo: float, hi: float) -> float {
    if a < lo {
        return lo
    }
    if a > hi {
        return hi
    }
    return a
}

# f_to_int: floor a float to int (no FractionalOverflowError in the alpha).
fn f_to_int(a: float) -> int {
    return a.to_int()
}

# int_to_f: int to float.
fn int_to_f(a: int) -> float {
    return a.to_float()
}

# f_pow_int: float raised to an integer power (e >= 0).
fn f_pow_int(b: float, e: int) -> float {
    let mut r: float = 1.0
    let mut i: int = 0
    while i < e {
        r = r * b
        i = i + 1
    }
    return r
}

# f_sqrt_approx: approximate sqrt(x) via Newton's method.
fn f_sqrt_approx(x: float) -> float {
    if x < 0.0 {
        return 0.0
    }
    if x == 0.0 {
        return 0.0
    }
    let mut r: float = x
    let mut i: int = 0
    while i < 30 {
        r = (r + x / r) / 2.0
        i = i + 1
    }
    return r
}

# f_pi: a float approximation of pi (3.14159265358979).
fn f_pi() -> float {
    return 3.14159265358979
}

# f_e: a float approximation of e (2.71828182845905).
fn f_e() -> float {
    return 2.71828182845905
}

# f_deg2rad: convert degrees to radians.
fn f_deg2rad(deg: float) -> float {
    return deg * f_pi() / 180.0
}

# f_rad2deg: convert radians to degrees.
fn f_rad2deg(rad: float) -> float {
    return rad * 180.0 / f_pi()
}

# f_circle_area: area of a circle of radius r.
fn f_circle_area(r: float) -> float {
    return f_pi() * r * r
}

# f_circle_circumference: circumference of a circle of radius r.
fn f_circle_circumference(r: float) -> float {
    return 2.0 * f_pi() * r
}

# ----------------------------------------------------------------------------
# Bit manipulation helpers (using arithmetic — the wasm subset doesn't
# expose bitwise ops, but we can simulate them).
# ----------------------------------------------------------------------------

# is_even: n is even.
fn is_even(n: int) -> bool {
    return n % 2 == 0
}

# is_odd: n is odd.
fn is_odd(n: int) -> bool {
    return n % 2 != 0
}

# is_power_of_two: n is a positive power of 2.
fn is_power_of_two(n: int) -> bool {
    if n < 1 {
        return false
    }
    let mut x: int = n
    while x > 1 {
        if x % 2 != 0 {
            return false
        }
        x = x / 2
    }
    return true
}

# next_power_of_two: smallest power of 2 >= n.
fn next_power_of_two(n: int) -> int {
    if n <= 1 {
        return 1
    }
    let mut p: int = 1
    while p < n {
        p = p * 2
    }
    return p
}

# digit_sum: sum of decimal digits of n.
fn digit_sum(n: int) -> int {
    let mut x: int = abs_int(n)
    let mut s: int = 0
    while x > 0 {
        s = s + x % 10
        x = x / 10
    }
    return s
}

# digit_count: number of decimal digits of n (0 if n==0).
fn digit_count(n: int) -> int {
    if n == 0 {
        return 1
    }
    let mut x: int = abs_int(n)
    let mut c: int = 0
    while x > 0 {
        c = c + 1
        x = x / 10
    }
    return c
}

# reverse_digits: reverse the decimal digits of n.
fn reverse_digits(n: int) -> int {
    let mut x: int = abs_int(n)
    let mut r: int = 0
    while x > 0 {
        r = r * 10 + x % 10
        x = x / 10
    }
    if n < 0 {
        return -r
    }
    return r
}

# is_palindrome_int: is n a decimal palindrome?
fn is_palindrome_int(n: int) -> bool {
    return n == reverse_digits(n)
}

# ----------------------------------------------------------------------------
# Stage 24 extern "js" demo wrappers.
# ----------------------------------------------------------------------------

# js_log: convenience wrapper for js_console_log.
fn js_log(msg: str) -> void uses IO {
    js_console_log(msg)
}

# js_warn: convenience wrapper for js_console_warn.
fn js_warn(msg: str) -> void uses IO {
    js_console_warn(msg)
}

# js_err: convenience wrapper for js_console_error.
fn js_err(msg: str) -> void uses IO {
    js_console_error(msg)
}

# js_set_text: convenience wrapper for js_dom_set_text.
fn js_set_text(id: str, text: str) -> void uses IO {
    js_dom_set_text(id, text)
}

# js_append: convenience wrapper for js_dom_append.
fn js_append(id: str, html: str) -> void uses IO {
    js_dom_append(id, html)
}

# js_now: convenience wrapper for js_now_ms.
fn js_now() -> int uses IO {
    return js_now_ms()
}

# js_rand_int: convenience wrapper for js_random_int.
fn js_rand_int(max_val: int) -> int uses IO {
    return js_random_int(max_val)
}

# js_rand_float: convenience wrapper for js_random.
fn js_rand_float() -> float uses IO {
    return js_random()
}

# js_get: convenience wrapper for js_localstorage_get.
fn js_get(key: str) -> str uses IO {
    return js_localstorage_get(key)
}

# js_set: convenience wrapper for js_localstorage_set.
fn js_set(key: str, val: str) -> void uses IO {
    js_localstorage_set(key, val)
}

# js_fetch_url: convenience wrapper for js_fetch.
fn js_fetch_url(url: str) -> str uses IO {
    return js_fetch(url)
}

# js_wait: convenience wrapper for js_set_timeout.
fn js_wait(ms: int) -> void uses IO {
    js_set_timeout(ms)
}

# ----------------------------------------------------------------------------
# Stage 24 struct-marshalling demo. The wasm emitter's alpha subset
# doesn't support struct field access (structs land in the HLIR emitter
# later), so we simulate a "Point" struct using two int variables
# (x, y) and serialize to JSON manually.
# ----------------------------------------------------------------------------

# point_to_json: serialize a (x, y) pair to a JSON string.
fn point_to_json(x: int, y: int) -> str {
    return "{\"x\":" + x.to_str() + ",\"y\":" + y.to_str() + "}"
}

# point_distance: Euclidean distance between two points.
fn point_distance(x1: int, y1: int, x2: int, y2: int) -> float {
    let dx: int = x1 - x2
    let dy: int = y1 - y2
    let sq: int = dx * dx + dy * dy
    return f_sqrt_approx(int_to_f(sq))
}

# point_manhattan: Manhattan distance.
fn point_manhattan(x1: int, y1: int, x2: int, y2: int) -> int {
    return abs_int(x1 - x2) + abs_int(y1 - y2)
}

# point_quadrant: which quadrant is (x, y) in? Returns 0 (origin), 1-4.
fn point_quadrant(x: int, y: int) -> int {
    if x == 0 && y == 0 {
        return 0
    }
    if x >= 0 && y >= 0 {
        return 1
    }
    if x < 0 && y >= 0 {
        return 2
    }
    if x < 0 && y < 0 {
        return 3
    }
    return 4
}

# ----------------------------------------------------------------------------
# "Todo list" — simulated with local variables in main() (since the
# wasm subset doesn't support structs/lists, and HLS doesn't allow
# top-level let mut). Each "todo" is identified by an int id; its
# title, done-ness, and priority are stored as local variables in
# main(). The todo_format / todo_summary functions take their values
# as parameters.
# ----------------------------------------------------------------------------

# todo_status_str: render the done state as "[x]" or "[ ]".
fn todo_status_str(done: bool) -> str {
    if done {
        return "[x]"
    }
    return "[ ]"
}

# todo_priority_str: render the priority as a string label.
fn todo_priority_str(p: int) -> str {
    if p >= 3 {
        return "HIGH"
    }
    if p == 2 {
        return "med"
    }
    return "low"
}

# todo_format: format a todo line for the JS UI.
fn todo_format(id: int, title: str, done: bool, priority: int) -> str {
    return "#" + id.to_str() + " " + todo_status_str(done) + " (" +
        todo_priority_str(priority) + ") " + title
}

# todo_summary_done: count how many of the 5 todos are done.
fn todo_summary_done(d1: bool, d2: bool, d3: bool, d4: bool, d5: bool) -> int {
    let mut count: int = 0
    if d1 {
        count = count + 1
    }
    if d2 {
        count = count + 1
    }
    if d3 {
        count = count + 1
    }
    if d4 {
        count = count + 1
    }
    if d5 {
        count = count + 1
    }
    return count
}

# todo_summary_high: count how many of the 5 todos are high-priority.
fn todo_summary_high(p1: int, p2: int, p3: int, p4: int, p5: int) -> int {
    let mut count: int = 0
    if p1 >= 3 {
        count = count + 1
    }
    if p2 >= 3 {
        count = count + 1
    }
    if p3 >= 3 {
        count = count + 1
    }
    if p4 >= 3 {
        count = count + 1
    }
    if p5 >= 3 {
        count = count + 1
    }
    return count
}

# ----------------------------------------------------------------------------
# Tiny markdown formatter — alpha subset only (no .split/.slice). The
# formatter walks the input character-by-character and emits a
# transformed string.
# ----------------------------------------------------------------------------

# md_escape_star: replace '*' with '[B]' markers (toggle style).
fn md_escape_star(s: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    let mut on: bool = false
    while i < s.len() {
        let c: int = str_byte_at(s, i)
        if c == 42 {
            if on {
                out = out + "[/B]"
            } else {
                out = out + "[B]"
            }
            on = !on
        } else {
            out = out + chr(c)
        }
        i = i + 1
    }
    return out
}

# md_escape_backtick: replace '`' with '[C]' markers (toggle style).
fn md_escape_backtick(s: str) -> str {
    let mut out: str = ""
    let mut i: int = 0
    let mut on: bool = false
    while i < s.len() {
        let c: int = str_byte_at(s, i)
        if c == 96 {
            if on {
                out = out + "[/C]"
            } else {
                out = out + "[C]"
            }
            on = !on
        } else {
            out = out + chr(c)
        }
        i = i + 1
    }
    return out
}

# md_format: apply both transformations.
fn md_format(s: str) -> str {
    return md_escape_backtick(md_escape_star(s))
}

# ----------------------------------------------------------------------------
# Random number utilities (Stage 24 js_random demo).
# ----------------------------------------------------------------------------

# roll_dice: roll N six-sided dice, return the sum.
fn roll_dice(n: int) -> int uses IO {
    let mut total: int = 0
    let mut i: int = 0
    while i < n {
        total = total + js_rand_int(6) + 1
        i = i + 1
    }
    return total
}

# benchmark_random: how many ms does K random ints take?
fn benchmark_random(k: int) -> int uses IO {
    let start: int = js_now()
    let mut sum: int = 0
    let mut i: int = 0
    while i < k {
        sum = sum + js_rand_int(1000)
        i = i + 1
    }
    return js_now() - start
}

# pick_one: pick one of three strings based on js_random_int(3).
fn pick_one(a: str, b: str, c: str) -> str uses IO {
    let r: int = js_rand_int(3)
    if r == 0 {
        return a
    }
    if r == 1 {
        return b
    }
    return c
}

# ----------------------------------------------------------------------------
# localStorage demo.
# ----------------------------------------------------------------------------

# store_set: write a key/value pair.
fn store_set(key: str, val: str) -> void uses IO {
    js_set(key, val)
}

# store_get: read a key, returning a default if missing.
fn store_get(key: str, default_val: str) -> str uses IO {
    let v: str = js_get(key)
    if v == "" {
        return default_val
    }
    return v
}

