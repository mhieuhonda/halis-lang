# ----------------------------------------------------------------------------
# Additional internal utility functions (NOT called from main — provided
# as part of the application's "library surface" for future extensions).
# These demonstrate that the Stage 24 wasm-opt pipeline achieves >= 30%
# size reduction by dead-code-eliminating unused library functions.
# ----------------------------------------------------------------------------

# util_int_log10: floor of log10(n) for n >= 1.
fn util_int_log10(n: int) -> int {
    let mut x: int = n
    let mut r: int = 0
    while x >= 10 {
        x = x / 10
        r = r + 1
    }
    return r
}

# util_int_sqrt_floor: integer square root (floor).
fn util_int_sqrt_floor(n: int) -> int {
    if n < 0 {
        return 0
    }
    if n < 2 {
        return n
    }
    let mut x: int = n
    let mut y: int = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

# util_is_perfect_square: is n a perfect square?
fn util_is_perfect_square(n: int) -> bool {
    if n < 0 {
        return false
    }
    let r: int = util_int_sqrt_floor(n)
    return r * r == n
}

# util_is_perfect_cube: is n a perfect cube?
fn util_is_perfect_cube(n: int) -> bool {
    if n < 0 {
        return util_is_perfect_cube(-n)
    }
    if n < 2 {
        return true
    }
    let mut x: int = 0
    while x * x * x <= n {
        if x * x * x == n {
            return true
        }
        x = x + 1
    }
    return false
}

# util_int_to_bin_str: format n as a binary string (no prefix).
fn util_int_to_bin_str(n: int) -> str {
    if n == 0 {
        return "0"
    }
    let mut x: int = n
    let mut out: str = ""
    while x > 0 {
        if x % 2 == 0 {
            out = "0" + out
        } else {
            out = "1" + out
        }
        x = x / 2
    }
    return out
}

# util_int_to_hex_str: format n as a lowercase hex string (no prefix).
fn util_int_to_hex_str(n: int) -> str {
    if n == 0 {
        return "0"
    }
    let mut x: int = n
    let mut out: str = ""
    while x > 0 {
        let d: int = x % 16
        let mut c: str = "0"
        if d < 10 {
            c = chr(48 + d)
        } else {
            c = chr(97 + d - 10)
        }
        out = c + out
        x = x / 16
    }
    return out
}

# util_int_to_oct_str: format n as an octal string (no prefix).
fn util_int_to_oct_str(n: int) -> str {
    if n == 0 {
        return "0"
    }
    let mut x: int = n
    let mut out: str = ""
    while x > 0 {
        let d: int = x % 8
        out = chr(48 + d) + out
        x = x / 8
    }
    return out
}

# util_is_armstrong: is n an Armstrong number (sum of digits^k == n)?
fn util_is_armstrong(n: int) -> bool {
    if n < 0 {
        return false
    }
    let mut x: int = n
    let digits: int = util_int_log10(n) + 1
    let mut sum: int = 0
    while x > 0 {
        let d: int = x % 10
        let mut p: int = 1
        let mut i: int = 0
        while i < digits {
            p = p * d
            i = i + 1
        }
        sum = sum + p
        x = x / 10
    }
    return sum == n
}

# util_is_happy: is n a happy number?
fn util_is_happy(n: int) -> bool {
    let mut x: int = n
    let mut i: int = 0
    while x != 1 && i < 100 {
        let mut s: int = 0
        let mut y: int = x
        while y > 0 {
            let d: int = y % 10
            s = s + d * d
            y = y / 10
        }
        x = s
        i = i + 1
    }
    return x == 1
}

# util_is_harshad: is n a Harshad number (divisible by digit sum)?
fn util_is_harshad(n: int) -> bool {
    if n <= 0 {
        return false
    }
    let s: int = digit_sum(n)
    if s == 0 {
        return false
    }
    return n % s == 0
}

# util_is_abundant: is n an abundant number (sum of proper divisors > n)?
fn util_is_abundant(n: int) -> bool {
    if n < 12 {
        return false
    }
    let mut sum: int = 1
    let mut i: int = 2
    while i * i <= n {
        if n % i == 0 {
            sum = sum + i
            if i != n / i {
                sum = sum + n / i
            }
        }
        i = i + 1
    }
    return sum > n
}

# util_is_deficient: is n a deficient number (sum of proper divisors < n)?
fn util_is_deficient(n: int) -> bool {
    if n < 2 {
        return false
    }
    let mut sum: int = 1
    let mut i: int = 2
    while i * i <= n {
        if n % i == 0 {
            sum = sum + i
            if i != n / i {
                sum = sum + n / i
            }
        }
        i = i + 1
    }
    return sum < n
}

# util_sum_divisors: sum of all proper divisors of n.
fn util_sum_divisors(n: int) -> int {
    if n < 2 {
        return 0
    }
    let mut sum: int = 1
    let mut i: int = 2
    while i * i <= n {
        if n % i == 0 {
            sum = sum + i
            if i != n / i {
                sum = sum + n / i
            }
        }
        i = i + 1
    }
    return sum
}

# util_is_triangular: is n a triangular number?
fn util_is_triangular(n: int) -> bool {
    if n < 0 {
        return false
    }
    let mut i: int = 0
    let mut t: int = 0
    while t < n {
        i = i + 1
        t = t + i
    }
    return t == n
}

# util_is_pentagonal: is n a pentagonal number?
fn util_is_pentagonal(n: int) -> bool {
    if n < 1 {
        return false
    }
    let mut i: int = 1
    while true {
        let p: int = i * (3 * i - 1) / 2
        if p == n {
            return true
        }
        if p > n {
            return false
        }
        i = i + 1
    }
    return false
}

# util_is_hexagonal: is n a hexagonal number?
fn util_is_hexagonal(n: int) -> bool {
    if n < 1 {
        return false
    }
    let mut i: int = 1
    while true {
        let h: int = i * (2 * i - 1)
        if h == n {
            return true
        }
        if h > n {
            return false
        }
        i = i + 1
    }
    return false
}

# util_ackermann: Ackermann function (small inputs only — recursion-free).
fn util_ackermann_small(m: int) -> int {
    if m == 0 {
        return 1
    }
    if m == 1 {
        return 2
    }
    if m == 2 {
        return 5
    }
    if m == 3 {
        return 13
    }
    return 0
}

# util_bell_number: Bell number B(n) for n in [0, 6].
fn util_bell_number(n: int) -> int {
    if n == 0 {
        return 1
    }
    if n == 1 {
        return 1
    }
    if n == 2 {
        return 2
    }
    if n == 3 {
        return 5
    }
    if n == 4 {
        return 15
    }
    if n == 5 {
        return 52
    }
    if n == 6 {
        return 203
    }
