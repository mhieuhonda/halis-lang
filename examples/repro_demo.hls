# repro_demo.hls — Stage 105 (v0.124.0-alpha): hls-repro, the
# reproducible-build verification across distros.
#
# The tool builds the same tree N times in N isolated roots under N
# deliberately different environments and requires the artifacts to
# come back byte-identical. This demo is the arithmetic the tool
# runs, in miniature — and it runs itself, deterministically, the
# same contract every artifact of a reproducible build must hold:
#
#   python3 tools/hls-repro.py examples/repro_demo.hls
#   python3 tools/hls-repro.py examples/repro_demo.hls --builds 3
#   python3 tools/hls-repro.py --verify examples/hls-repro.buildinfo.json
#
# The demo's own output is part of the proof: run the tool on THIS
# file and the buildinfo's smoke stdout hash is over these exact
# bytes — the program that describes the recipe is itself a
# reproducible build of the recipe's engine.

import "std.str"

# The epoch policy: content, not clock. The tree digest's first
# eight hex characters become a sane unix second —
# int(d[:8], 16) % 2^31 — so a tree that has never heard of
# SOURCE_DATE_EPOCH still builds with a stable one. "deadbeef" is
# the digest prefix here; the nibbles are its digits.
fn epoch_from(d: list[int]) -> int {
    if d.len() != 8 {
        panic("epoch_from: a digest prefix is eight nibbles")
    }
    let mut acc: int = 0
    let mut k: int = 0
    while k < 8 {
        if d[k] < 0 || d[k] > 15 {
            panic("epoch_from: a nibble is 0..15")
        }
        acc = acc * 16 + d[k]
        k = k + 1
    }
    return acc % 2147483648
}

# The matrix: B builds and P profiles — each build runs under its
# own profile, the rotation is (i + offset) % P, so a shifted offset
# (what --verify uses) slides the whole window without ever
# repeating a pair inside one run.
fn rotation(i: int, profiles: int, offset: int) -> int {
    if profiles < 1 {
        panic("rotation: at least one profile")
    }
    if i < 0 || offset < 0 {
        panic("rotation: indexes must not go negative")
    }
    return(i + offset) % profiles
}

# The canonical-name invariant: every build's intermediate C has the
# SAME name, so the symbol table the assembler writes carries the
# same bytes everywhere. One name, every build — the lesson of the
# one-byte STT_FILE divergence this stage was built to catch.
fn canonical(a: str, b: str) -> bool {
    return a == b
}

fn main() -> int uses IO {
    let mut checks: int = 0

    # The epoch: whatever the digest, the derived second lands in
    # [0, 2^31) — sane unix range, never the wall clock. The demo
    # prefix "deadbeef" is 3735928559, and 3735928559 % 2^31 =
    # 1588444911; an all-zero prefix derives to 0 and an all-ff
    # prefix to 2^31 - 1: the boundaries hold.
    let deadbeef: list[int] = [13, 14, 10, 13, 11, 14, 14, 15]
    if epoch_from(deadbeef) != 1588444911 {
        panic("the deadbeef epoch must be 1588444911")
    }
    let zeros: list[int] = [0, 0, 0, 0, 0, 0, 0, 0]
    if epoch_from(zeros) != 0 {
        panic("the zero prefix derives to epoch 0")
    }
    let ffs: list[int] = [15, 15, 15, 15, 15, 15, 15, 15]
    if epoch_from(ffs) != 2147483647 {
        panic("the ff prefix derives to 2^31 - 1")
    }
    checks = checks + 1

    # The rotation: five profiles, builds 0..2 — the window; a
    # verify shift of 1 moves every window by one and wraps the
    # last back to the front.
    if rotation(0, 5, 0) != 0 || rotation(2, 5, 0) != 2 {
        panic("rotation window wrong")
    }
    if rotation(2, 5, 1) != 3 || rotation(4, 5, 1) != 0 {
        panic("the shifted rotation must wrap")
    }
    checks = checks + 1

    # The canonical name: build/hl_repro.c in EVERY build root —
    # equal to itself across the matrix, never to the machine.
    if !canonical("build/hl_repro.c", "build/hl_repro.c") {
        panic("the canonical C name must equal itself")
    }
    if canonical("build/hl_repro.c", "build/hello_repro.c") {
        panic("a non-canonical name must not pass")
    }
    checks = checks + 1

    println("reproducible-build ledger for one small tree")
    println("  epoch     = derived from the tree digest (content,"
    + " not clock)")
    println("  matrix    = builds x profiles, one hermetic root"
    + " each")
    println("  c name    = build/hl_repro.c in every root (the"
    + " STT_FILE lesson)")
    println("  verify    = a shifted profile slice must return"
    + " the same bytes")
    checks = checks + 1

    if checks != 4 {
        panic("expected 4 checks, ran " + checks.to_str())
    }
    println("checks passed: " + checks.to_str())
    return 0
}
