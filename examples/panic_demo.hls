# ============================================================================
# examples/panic_demo.hls — Stage 81 (v0.100.0-alpha)
# ----------------------------------------------------------------------------
# A hosted program demonstrating the `#[panic_handler]` override: the
# handler logs the fault with a kernel-style prefix, then returns and
# the runtime's default action still runs (report on stderr, exit
# 101). The exit code is 101 — the panic happened; the handler only
# observed it. A handler that wants a different halt action calls
# `exit(code)` itself (see the exit-wins probe in
# tests/panic_acceptance.py).
#
# Build + run (hosted toolchain):
#   bin/hlc examples/panic_demo.hls /tmp/panic_demo.c
#   gcc -O2 -o /tmp/panic_demo /tmp/panic_demo.c -lm -pthread
#   /tmp/panic_demo; echo "exit=$?"   # exit=101
#
# Or directly on the interpreter:
#   python3 boot/boot.py examples/panic_demo.hls; echo "exit=$?"
# ============================================================================

import "core.panic"

# The program's single panic handler: exactly one `str` parameter
# (the panic message), `void` return. It may declare effects — this
# hosted demo logs over `IO`; a `#![no_std]` / `#![freestanding]`
# handler is effect-free by the mode rules and records into a
# `PanicLog` instead (see tests/ok/feat_stage81_panic.hls).
#[panic_handler]
fn panic_handler(msg: str) -> void uses IO {
    println("kernel panic: " + msg)
    let logged: str = panic_format(panic_info_new(msg, "panic_demo.hls", 27))
    println("logged: " + logged)
}

fn main() -> int uses IO {
    println("about to panic")
    let _: int = panic("demo fault")
    return 0
}
