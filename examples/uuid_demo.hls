import "std.uuid"

fn main() -> int uses IO {
    println("=== deterministic UUIDs ===")
    let u1: str = uuid_v4_deterministic("user-namespace", 1)
    let u2: str = uuid_v4_deterministic("user-namespace", 2)
    let u3: str = uuid_v4_deterministic("user-namespace", 1)
    println("u1 (ns, 1): " + u1)
    println("u2 (ns, 2): " + u2)
    println("u3 (ns, 1): " + u3 + "  (must equal u1: " + (u1 == u3).to_str() + ")")

    println("")
    println("=== name-based UUIDs (v5-like) ===")
    let n1: str = uuid_v5_like("https://example.com", "/users/42")
    let n2: str = uuid_v5_like("https://example.com", "/users/43")
    let n3: str = uuid_v5_like("https://example.com", "/users/42")
    println("n1 (/users/42): " + n1)
    println("n2 (/users/43): " + n2)
    println("n3 (/users/42): " + n3 + "  (must equal n1: " + (n1 == n3).to_str() + ")")

    println("")
    println("=== validation ===")
    println("u1 valid:        " + uuid_is_valid(u1).to_str())
    println("u1 version:      " + uuid_version(u1).to_str())
    println("n1 valid:        " + uuid_is_valid(n1).to_str())
    println("n1 version:      " + uuid_version(n1).to_str())
    println("'not-a-uuid':    " + uuid_is_valid("not-a-uuid").to_str())
    println("short valid fmt: " + uuid_is_valid("12345678-1234-4123-8123-123456789012").to_str())

    println("")
    println("=== batch generation ===")
    let mut i: int = 0
    while i < 5 {
        let u: str = uuid_v4_deterministic("batch", i)
        println("  batch#" + i.to_str() + " -> " + u)
        i = i + 1
    }
    return 0
}
