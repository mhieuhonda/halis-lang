# Stage 98 (v0.117.0-alpha): refinement types — the acceptance demo.
#
# A refinement type is `T where <pred>`: a primitive value guaranteed
# (by runtime guard, or by compile-time proof) to satisfy the pure
# predicate over `self`. Four slot kinds carry refinements:
#
#   fn params        fn transfer(amount: int where self > 0)
#   return types     -> int where self >= 0
#   let annotations  let fee: int where self >= 0 = ...
#   struct fields    balance: int where self >= 0
#
# A violation is a clean panic (exit 101). What the prover can prove
# statically (constants, same-predicate flow, interval facts) runs
# guard-free; everything else is checked at the boundary.

struct Ledger {
    id: str where self.len() > 0,
    funds: int where self >= 0
}

# `amount > 0` is checked at fn entry — the callee may rely on it.
fn apply(l: Ledger, amount: int where self != 0) -> Ledger {
    return Ledger{ id: l.id, funds: l.funds + amount }
}

# every return value is certified non-negative
fn square_diff(a: int, b: int) -> int where self >= 0 {
    let d: int = a - b
    if d < 0 {
        return 0 - d
    }
    return d
}

# the refinements compose into a PROOF: `num >= 0` bounds the
# dividend (no INT64_MIN corner), `den != 0` proves the divisor —
# under `-O fast` the division's panic check is elided entirely
fn ratio(num: int where self >= 0, den: int where self != 0) -> int {
    return num / den
}

fn main() -> int uses IO {
    let book: Ledger = Ledger{ id: "main", funds: 500 }
    println("open:    " + book.summary())

    let after_fee: Ledger = apply(book, 0 - 75)
    println("fee:     " + after_fee.summary())

    let after_gift: Ledger = apply(after_fee, 120)
    println("gift:    " + after_gift.summary())

    println("diff:    " + square_diff(after_gift.funds, 400).to_str())

    # same-predicate flow: `gift` already satisfies "self != 0"
    let den: int where self != 0 = after_gift.funds
    println("ratio:   " + ratio(90000, den).to_str())

    # a proven chain: square_diff is >= 0, so the let needs no guard
    let m: int where self >= 0 = square_diff(3, 9)
    println("margin:  " + m.to_str())
    return 0
}

impl Ledger {
    fn summary(self: Ledger) -> str {
        return self.id + " (" + self.funds.to_str() + ")"
    }
}
