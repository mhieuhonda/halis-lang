# secure_demo.hls — minh hoa triet ly bao mat cua Hieu Louis
#
# 1. HAM THUAN TUY DUOC BAO DAM TINH: ham pure() khong the ghi dia,
#    in ra man hinh, doc mang — tren toi gian la loi bien dich.
# 2. MOI PHEP TOAN DUOC KIEM TRA: tran so nguyen, chia 0, truy cap
#    mang ngoai pham vi — deu la panic an toan (khong co undefined behavior).
# 3. KHONG CO NULL, khong co bien chua khoi tao, khong co trang thai an.

fn pure(n: int) -> int {
    # Khong co 'uses IO' => trinh bien dich BAO DAM ham nay thuan tuy
    let mut t: int = 0
    let mut i: int = 0
    while i < n {
        t = t + i * i
        i = i + 1
    }
    return t
}

fn main() -> int uses IO {
    println("1. Ham thuan tuy: pure(100) = " + pure(100).to_str())
    println("   (bao dam boi he thong effects — khong the goi IO)")

    println("2. So hoc kiem tra tran:")
    let x: int = 9223372036854775807
    println("   x = INT64_MAX = " + x.to_str())
    println("   Thu cong x + 1...")
    println("   Ket qua = " + (x + 1).to_str())
    println("   (dong nay khong bao gio duoc in — panic an toan)")
    return 0
}
