# secure_demo.hls — demonstrates Halis's security philosophy
#
# 1. PURE FUNCTIONS ARE GUARANTEED: the sum_pure() function cannot write to
#    disk, print to the screen, or read the network — attempting to is a
#    compile error. (Stage 9-beta added the explicit `pure` keyword so
#    purity can be asserted, not just inferred from the absence of `uses`.)
# 2. EVERY OPERATION IS CHECKED: integer overflow, divide-by-zero,
#    out-of-bounds array access — all are safe panics (no undefined behaviour).
# 3. NO NULL, no uninitialised variables, no hidden state.

fn sum_pure(n: int) -> int pure {
    # No 'uses' clause AND explicitly marked `pure` => the compiler
    # GUARANTEES this function is pure (transitively calls nothing
    # effectful). Trying to add `uses IO` here would be a parse-time
    # error: `pure` and `uses` are mutually exclusive.
    let mut total: int = 0
    let mut i: int = 0
    while i < n {
        total = total + i * i
        i = i + 1
    }
    return total
}

fn main() -> int uses IO {
    println("1. Pure function: sum_pure(100) = " + sum_pure(100).to_str())
    println("   (guaranteed by the effects system — cannot call IO)")

    println("2. Overflow-checked arithmetic:")
    let x: int = 9223372036854775807
    println("   x = INT64_MAX = " + x.to_str())
    println("   Attempting x + 1...")
    println("   Result = " + (x + 1).to_str())
    println("   (this line is never printed — safe panic)")
    return 0
}
