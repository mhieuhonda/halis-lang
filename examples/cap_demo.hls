# cap_demo.hls — Stage 111 (v0.130.0-alpha): capability tokens.
#
# Before Stage 111 the ONLY way to authorize an effect was the `uses`
# clause: a static word on a signature, checked against the call-graph
# fixpoint. Stage 111 adds the VALUE form: `Cap[E]` is a first-class
# token naming one of the nine effects. The rules:
#
#   1. Tokens are minted by cap_take("E") — only in `main` (the process
#      entry holds every effect ambiently) or inside a fn that already
#      declares `uses E`.
#   2. A direct Cap[E] parameter GRANTS its body the effect E — no
#      `uses` clause needed. The signature says exactly what the body
#      may do; hls-audit's --audit rows agree.
#   3. Authority does not leak transitively: a fn that received no
#      token (and declared nothing) still cannot act.
#   4. Tokens are opaque (no fields, no printing — read them back with
#      cap_effect_name), move-only (clone() is rejected — duplicating a
#      token would mint authority), and they may sit in struct fields
#      (as plumbing; a field alone confers nothing — see fail tests).
#
# Cap[IO] is the family token, mirroring `uses IO`: one token covers
# {IO, Fs, Clock, Args, Exit}.

struct Fetcher {
    host: str,
    # plumbing: travels with the struct, does NOT authorize by itself.
    grant: Cap[Net]
}

# The Cap[Net] parameter IS the authorization for net_lookup().
fn fetch(f: Fetcher, c: Cap[Net]) -> str {
    return net_lookup(f.host)
}

# No capability parameter, no `uses` — this body stays effect-free.
fn announce(msg: str, io: Cap[IO]) -> int {
    println(msg)
    return 0
}

fn main() -> int {
    # main splits tokens off the process authority.
    let io: Cap[IO] = cap_take("IO")
    let net: Cap[Net] = cap_take("Net")
    let f: Fetcher = Fetcher { host: "localhost", grant: net }

    println("token: " + cap_effect_name(net))
    let ip: str = fetch(f, net)
    println("localhost -> " + ip)
    announce("authority was explicit at every step", io)
    return 0
}
