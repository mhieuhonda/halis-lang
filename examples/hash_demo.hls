# examples/hash_demo.hls — Stage 43 (v0.62.0-alpha): std.hash
#
# Demonstrates the four hash algorithms in std.hash:
#   - SipHash-2-4 (default, DoS-resistant)
#   - xxHash64 (fast, non-crypto)
#   - FNV-1a 64-bit (small code)
#   - CityHash64 (tuned for short strings)
#
# Also shows the Hash trait helpers (hash_int, hash_str, hash_bool,
# hash_float, hash_combine) and the uniform Hasher enum API.
#
# All output is deterministic — no I/O beyond println. The
# differential test (interpreter == native) is byte-exact.

import "std.hash"
import "std.str"
import "std.fmt"
import "std.option"
import "std.result"

fn main() -> int uses IO {
    println("=== Stage 43: std.hash ===")
    println("")

    # --- SipHash-2-4 ----------------------------------------------------
    println("--- SipHash-2-4 (DoS-resistant, keyed) ---")
    let sip1: int = siphash_str("hello")
    println("  siphash_str(\"hello\")        = " + sip1.to_str())
    println("  siphash_str(\"hello, world\")  = " + siphash_str("hello, world").to_str())
    println("  siphash_str(\"\")              = " + siphash_str("").to_str())

    # Keyed SipHash with a per-process random key
    let k0: int = 1234567890
    let k1: int = 9876543210
    let sip_keyed: int = siphash_str_keyed("hello", k0, k1)
    println("  siphash_str_keyed(\"hello\")   = " + sip_keyed.to_str())

    # Streaming SipHash
    let h: SipHasher = siphash_new()
    siphash_write_str(h, "hello ")
    siphash_write_str(h, "world")
    println("  streaming siphash(\"hello world\") = " + siphash_finish(h).to_str())
    println("")

    # --- xxHash64 -------------------------------------------------------
    println("--- xxHash64 (fast, non-crypto) ---")
    println("  xxhash_str(\"hello\")          = " + xxhash_str("hello").to_str())
    println("  xxhash_str(\"\")                = " + xxhash_str("").to_str())
    println("  xxhash_str_seeded(\"hello\", 42) = " + xxhash_str_seeded("hello", 42).to_str())

    # Long input (exercises the accumulator path)
    let long_str: str = "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog."
    println("  xxhash_str(long_str)          = " + xxhash_str(long_str).to_str())
    println("")

    # --- FNV-1a 64-bit --------------------------------------------------
    println("--- FNV-1a 64-bit (small code, deterministic) ---")
    println("  fnv_str(\"\")                   = " + fnv_str("").to_str())
    println("  fnv_str(\"hello\")              = " + fnv_str("hello").to_str())
    println("  fnv_str(\"The quick brown fox\") = " + fnv_str("The quick brown fox").to_str())
    println("")

    # --- CityHash64 -----------------------------------------------------
    println("--- CityHash64 (tuned for short strings) ---")
    println("  cityhash_str(\"\")              = " + cityhash_str("").to_str())
    println("  cityhash_str(\"hello\")         = " + cityhash_str("hello").to_str())
    println("  cityhash_str(long_str)        = " + cityhash_str(long_str).to_str())
    println("")

    # --- Hash trait helpers (monomorphic per type) ----------------------
    println("--- Hash trait helpers ---")
    println("  hash_int(42)                  = " + hash_int(42).to_str())
    println("  hash_int(-1)                  = " + hash_int(-1).to_str())
    println("  hash_int(0)                   = " + hash_int(0).to_str())
    println("  hash_str(\"hello\")             = " + hash_str("hello").to_str())
    println("  hash_bool(true)               = " + hash_bool(true).to_str())
    println("  hash_bool(false)              = " + hash_bool(false).to_str())
    println("  hash_float(3.14)              = " + hash_float(3.14).to_str())
    println("  hash_combine(42, 100)         = " + hash_combine(42, 100).to_str())
    println("  hash_combine(100, 42)         = " + hash_combine(100, 42).to_str())
    println("")

    # --- Uniform Hasher enum API ----------------------------------------
    println("--- Uniform Hasher enum API ---")
    let algos: list[int] = [0, 1, 2, 3]
    let names: list[str] = ["SipHash", "xxHash", "FNV", "CityHash"]
    let mut i: int = 0
    while i < 4 {
        let hasher: Hasher = hasher_new(algos.get(i))
        hasher_write_str(hasher, "hello")
        let result: int = hasher_finish(hasher)
        println("  " + names.get(i) + "(\"hello\") = " + result.to_str())
        i = i + 1
    }
    println("")

    # --- Determinism check ----------------------------------------------
    println("--- Determinism check (same input -> same hash) ---")
    let a1: int = siphash_str("test")
    let a2: int = siphash_str("test")
    if a1 == a2 {
        println("  SipHash deterministic: OK")
    } else {
        println("  SipHash deterministic: FAIL")
    }

    let b1: int = xxhash_str("test")
    let b2: int = xxhash_str("test")
    if b1 == b2 {
        println("  xxHash deterministic: OK")
    } else {
        println("  xxHash deterministic: FAIL")
    }

    # --- Different inputs produce different hashes ----------------------
    println("")
    println("--- Avalanche (different inputs -> different hashes) ---")
    let h1: int = siphash_str("hello")
    let h2: int = siphash_str("hellp")  # one byte different
    if h1 != h2 {
        println("  SipHash avalanche: OK (one-byte change -> different hash)")
    } else {
        println("  SipHash avalanche: FAIL")
    }

    let x1: int = xxhash_str("hello")
    let x2: int = xxhash_str("hellp")
    if x1 != x2 {
        println("  xxHash avalanche: OK")
    } else {
        println("  xxHash avalanche: FAIL")
    }

    println("")
    println("=== Stage 43 demo complete ===")
    return 0
}

# fmt_or_panic helper for the demo.
fn fmt_or_panic(format: str, args: list[FmtValue]) -> str {
    let r: Result[str, str] = fmt(format, args)
    if !result_is_ok(r) {
        panic("fmt failed: " + result_err_or(r, ""))
    }
    return result_unwrap(r)
}
