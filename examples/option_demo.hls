# option_demo.hls — demonstrates Option[T] and the `?` operator
# Stage 7 example
import "std.option"

fn first_or_none(xs: list[int]) -> Option[int] {
    if xs.len() == 0 {
        return Option.None
    }
    return Option.Some(xs.get(0))
}

fn use_first(xs: list[int]) -> Option[int] {
    let v: int = first_or_none(xs)?
    return Option.Some(v + 100)
}

fn main() -> int uses IO {
    let xs: list[int] = [10, 20, 30]
    let r: Option[int] = use_first(xs)
    if option_is_some(r) {
        println("use_first([10, 20, 30]) = " + option_unwrap(r).to_str())
    }

    let empty: list[int] = []
    let r2: Option[int] = use_first(empty)
    if option_is_none(r2) {
        println("use_first([]) = None")
    }
    return 0
}
