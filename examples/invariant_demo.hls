# examples/invariant_demo.hls — Stage 97 (v0.116.0-alpha): SMT-based
# loop-invariant inference. Every loop below is summarised by
# `hlprove --infer-invariants` (entry facts, per-variable transition
# relation, condition), candidates are generated from templates, and
# z3 decides initiation + preservation. The invariants are REPORTS —
# inference is analysis-only and changes no compilation, so the
# interpreter and the native binary agree byte for byte.
#
#   make invariant-acceptance   — the full Stage 97 gate
#   make infer F=examples/invariant_demo.hls
#   make infer-smt F=examples/invariant_demo.hls

# The classic strengthening case: `s >= 0` is inductive only together
# with `i >= 0` (the step s' = s + i needs i non-negative), which is
# exactly why the verifier accepts candidates on counters first.
fn sum_to(n: int) -> int
    requires n >= 0
{
    let mut s: int = 0
    let mut i: int = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    return s
}

# The condition-derived bound for a step-2 loop is NOT i <= n — the
# last iteration can overshoot to n + 1 — and the solver confirms the
# tighter claim only in its weakened form.
fn step_two(n: int) -> int
    requires n >= 0
{
    let mut i: int = 0
    while i < n {
        i = i + 2
    }
    return i
}

# A congruence invariant — outside the interval engine's reach: the
# step +4 preserves x ≡ 0 (mod 4) forever.
fn by_fours(n: int) -> int
    requires n >= 0
{
    let mut x: int = 0
    let mut k: int = 0
    while k < n {
        x = x + 4
        k = k + 1
    }
    return x
}

# for-range: the loop variable is fresh-bound from the range start and
# steps by 1; the entry equation anchors i >= 0, the range bound gives
# i <= n (vacuous when n == 0 — the "loop runs" guard handles it).
fn range_sum(n: int) -> int
    requires n >= 0
{
    let mut s: int = 0
    for i: int in range(0, n) {
        s = s + i
    }
    return s
}

# The honest refusal: i' = i - 2 from i > 0 can cross zero in ONE step
# (i == 1 steps to -1), so the entry fact i >= 0 is NOT inductive — the
# solver finds the escaping state and the candidate is REJECTED, not
# reported. (The loop really does end at -1 for odd n.)
fn skipper(n: int) -> int
    requires n >= 0
{
    let mut i: int = n
    while i > 0 {
        i = i - 2
    }
    return i
}

fn main() -> int uses IO {
    println("sum_to(10)   = " + sum_to(10).to_str())
    println("step_two(10) = " + step_two(10).to_str())
    println("by_fours(5)  = " + by_fours(5).to_str())
    println("range_sum(10)= " + range_sum(10).to_str())
    println("skipper(5)   = " + skipper(5).to_str())
    return 0
}
