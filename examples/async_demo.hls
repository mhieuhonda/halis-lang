# async_demo.hls — Stage 33 (v0.52.0-alpha): async/await zero-runtime futures.
#
# This demo shows the three primitives:
#   async_spawn(f, args...) -> Future[T]  start an async computation
#   await(fut) -> T                        block until the future is ready
#   future_select(futs) -> int             race multiple futures
#
# Plus the higher-level combinators from std.async:
#   async_run_all_int(futs) -> list[int]   collect all results in order
#   async_race_int(futs) -> int            first to finish wins
#
# Zero-runtime: a Future[T] is a cap-1 bounded channel (the same runtime
# primitive as Stage 16's Chan[T]). No per-future heap allocation beyond
# the channel itself. await is a channel recv — one mutex op, no
# allocation. The work-stealing executor is the OS thread scheduler
# (each async_spawn creates a detached pthread; the OS does the stealing).

import "std.async"

fn square(n: int) -> int {
    return n * n
}

fn slow_compute(n: int) -> int uses Conc {
    # Simulate I/O by spawning a helper task and joining it.
    let t: Task[int] = spawn(square, n)
    return t.join()
}

fn main() -> int uses IO, Conc {
    # 1. async_spawn + await: the basic pattern.
    let f: Future[int] = async_spawn(slow_compute, 7)
    let r: int = await(f)
    println("async_spawn(slow_compute, 7) = " + r.to_str())
    if r != 49 {
        return 1
    }

    # 2. future_ready: an immediately-ready future (no task spawned).
    let f2: Future[int] = future_ready(42)
    let r2: int = await(f2)
    println("future_ready(42) = " + r2.to_str())
    if r2 != 42 {
        return 2
    }

    # 3. future_poll: non-blocking check (returns Option[T]).
    let f3: Future[int] = future_ready(99)
    let p: Option[int] = future_poll(f3)
    if !option_is_some(p) {
        println("future_poll on a ready future should return Some")
        return 3
    }
    println("future_poll(99) = Some(" + option_unwrap(p).to_str() + ")")

    # 4. future_select: race multiple futures, return the first ready index.
    let f4: Future[int] = future_ready(100)
    let f5: Future[int] = future_ready(200)
    let futs: list[Future[int]] = [f4, f5]
    let idx: int = future_select(futs)
    println("future_select picked index " + idx.to_str())

    # 5. async_run_all_int: collect results from multiple concurrent futures.
    let f6: Future[int] = async_spawn(slow_compute, 5)
    let f7: Future[int] = async_spawn(slow_compute, 6)
    let f8: Future[int] = async_spawn(slow_compute, 7)
    let all_futs: list[Future[int]] = [f6, f7, f8]
    let results: list[int] = async_run_all_int(all_futs)
    println("async_run_all: " + results.get(0).to_str() + ", "
            + results.get(1).to_str() + ", " + results.get(2).to_str())
    if results.get(0) != 25 || results.get(1) != 36 || results.get(2) != 49 {
        return 4
    }

    # 6. async_race_int: first to finish wins.
    let r_fut: Future[int] = async_spawn(slow_compute, 10)
    let r_result: int = async_race_int([r_fut])
    println("async_race: " + r_result.to_str())
    if r_result != 100 {
        return 5
    }

    println("ALL ASYNC TESTS PASSED")
    return 0
}
