# migrate_demo.hls — Stage 129 (v0.147.0-alpha): hls-migrate, the
# migration tool (`hls migrate`).
#
# The tool upgrades a source tree from an old release's dialect to a
# newer one: six codemod rules derived from the project's real,
# ledgered breaking changes, fired oldest-first, each gated by the
# version the source is written in. This demo is the engine in
# miniature — the version-gate arithmetic, the verdict lattice and
# the re-rendering laws the auto-edits apply, on numbers small
# enough to check by hand:
#
#   python3 tools/hls-migrate.py tests/migrate_tree --from v0.1.0
#   python3 tools/hls-migrate.py tests/migrate_tree --from v0.34.0-alpha --to v1.0
#   python3 tools/hls-migrate.py tests/migrate_tree --apply --verify
#   python3 tools/hls-migrate.py --rules
#
# The demo's own claim is the one the tool makes about every file it
# walks: the golden values below are POST-migration forms — a pinned
# digest that disagrees with the spec algorithm is recomputed, a
# minimal-digit hex64 golden becomes the full 16-digit word, a
# pre-slash html golden gains the escaped slash — and after the walk
# they are all fixed points: running the tool again finds nothing.

import "std.hash"
import "std.html"

# The verdict lattice, as a value: what the tool reports per finding.
# CLEAN means nothing to do, AUTO means a mechanical rewrite, MANUAL
# means advice a human must act on (a '..' import is never rewritten
# — rewriting one would change what the program loads), GATED means
# the source dialect already carries the change.
#
#   CLEAN / AUTO / MANUAL / GATED  — reported as codes 0/1/2/3 below,
#   because the enum form of eq is match-driven.
enum Verdict {
    Clean,
    Auto,
    Manual,
    Gated
}

fn code(v: Verdict) -> int {
    return match v {
        Verdict.Clean => 0,
        Verdict.Auto => 1,
        Verdict.Manual => 2,
        Verdict.Gated => 3
    }
}

fn name(v: Verdict) -> str {
    return match v {
        Verdict.Clean => "CLEAN",
        Verdict.Auto => "AUTO",
        Verdict.Manual => "MANUAL",
        Verdict.Gated => "GATED"
    }
}

# The gate: a rule fires when the source dialect --from predates the
# rule's breaking change (since > --from). A release tag is compared
# as its (major, minor, patch) key — the version-sort law the census
# also obeys: 9 < 10 < 100, never alphabetical.
fn key(major: int, minor: int, patch: int) -> int {
    return(major * 100000 + minor * 1000 + patch) * 10
}

# The six real rules with their real since-versions, oldest first.
# The roadmap phrase --from v0.34.0-alpha --to v1.0 fires exactly the
# four post-v0.34 rules and gates the two pre-v0.34 dialects off.
fn gate(from_key: int, since_key: int) -> Verdict {
    if since_key > from_key {
        return Verdict.Auto
    }
    return Verdict.Gated
}

fn demo_gate() -> int uses IO {
    let v0: int = key(0, 1, 0)
    let v34: int = key(0, 34, 0)
    let v110: int = key(0, 110, 0)
    let mut auto: int = 0
    # every rule's since-version, oldest first — all six fire on a
    # v0.1 dialect:
    if code(gate(v0, key(0, 8, 0))) == code(Verdict.Auto) {
        auto = auto + 1
    }
    if code(gate(v0, key(0, 20, 0))) == code(Verdict.Auto) {
        auto = auto + 1
    }
    if code(gate(v0, key(0, 51, 1))) == code(Verdict.Auto) {
        auto = auto + 1
    }
    if code(gate(v0, key(0, 82, 0))) == code(Verdict.Auto) {
        auto = auto + 1
    }
    if code(gate(v0, key(0, 102, 0))) == code(Verdict.Auto) {
        auto = auto + 1
    }
    if code(gate(v0, key(0, 103, 0))) == code(Verdict.Auto) {
        auto = auto + 1
    }
    if auto != 6 {
        return 1
    }
    # the roadmap phrase: 4 of the 6 fire, 2 are gated off:
    if code(gate(v34, key(0, 8, 0))) != code(Verdict.Gated) {
        return 2
    }
    if code(gate(v34, key(0, 20, 0))) != code(Verdict.Gated) {
        return 3
    }
    if code(gate(v34, key(0, 51, 1))) != code(Verdict.Auto) {
        return 4
    }
    if code(gate(v34, key(0, 82, 0))) != code(Verdict.Auto) {
        return 5
    }
    if code(gate(v34, key(0, 102, 0))) != code(Verdict.Auto) {
        return 6
    }
    if code(gate(v34, key(0, 103, 0))) != code(Verdict.Auto) {
        return 7
    }
    # a v0.110 dialect is CLEAN on the whole bed:
    if code(gate(v110, key(0, 103, 0))) != code(Verdict.Gated) {
        return 8
    }
    println("  gate: v0.1 fires 6/6, v0.34 fires 4/6, v0.110 -> "
    + name(Verdict.Gated))
    return 0
}

# The hex64 word law: the reference rendering the hex64-word rule
# re-renders every golden to — 16 lower-case digits of the unsigned
# two's-complement pattern (computed nibble by nibble, because 2^64
# does not fit an int64).
fn hex_digit(d: int) -> str {
    if d < 10 {
        return chr(48 + d)
    }
    return chr(97 + d - 10)
}

fn mig_hex64(v: int) -> str {
    let mut n: int = v
    let mut ds: list[int] = []
    let mut i: int = 0
    while i < 16 {
        ds.push(int_and(n, 15))
        n = int_shr(n, 4)
        i = i + 1
    }
    let mut out: str = "0x"
    let mut k: int = 15
    while k >= 0 {
        out = out + hex_digit(ds.get(k))
        k = k - 1
    }
    return out
}

fn demo_words() -> int {
    # "0x0" -> the full word; "-0x1" -> the two's-complement word:
    if mig_hex64(0) != "0x0000000000000000" {
        return 1
    }
    if mig_hex64(-1) != "0xffffffffffffffff" {
        return 2
    }
    if mig_hex64(-9223372036854775807 - 1) != "0x8000000000000000" {
        return 3
    }
    return 0
}

fn demo_goldens() -> int {
    # The post-migration goldens, as the walk leaves them:
    if xxhash_str("hello") != 2794345569481354659 {
        return 1
    }
    if html_escape("</b>") != "&lt;&#x2F;b&gt;" {
        return 2
    }
    return 0
}

fn main() -> int uses IO {
    println("stage 129 demo: hls migrate")
    let mut r: int = demo_gate()
    if r != 0 {
        return 10 + r
    }
    r = demo_words()
    if r != 0 {
        return 20 + r
    }
    r = demo_goldens()
    if r != 0 {
        return 30 + r
    }
    println("  migrate demo OK: the walk is a fixed point")
    return 0
}
