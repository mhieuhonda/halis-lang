# geo.hls — a Stage 103 audit fixture: the DEEP module.
#
# geo performs no I/O itself; its one effect is the Clock (elapsed
# timing is a measurable host observation). Everything else it does
# rides on the toolchain's string module.
#
# The supply-chain report charges Clock to THIS module (intrinsic)
# and shows it entering the program through netcheck's import:
#
#   python3 tools/hls-audit.py examples/audit_demo.hls

import "std.str"

# Elapsed milliseconds since an arbitrary epoch — the caller uses
# this to time network operations. Clock is the point: a duration
# measured from the host clock.
fn elapsed_ms() -> int uses Clock {
    return clock_ms()
}

# Pure string shaping for cache keys (no effects of its own — the
# std.str import stays in the toolchain column of the report).
fn cache_key(host: str) -> str {
    return "geo:" + host
}
