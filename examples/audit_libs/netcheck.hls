# netcheck.hls — a Stage 103 audit fixture: the MIDDLE module.
#
# This is the module a supply-chain report exists to expose: it looks
# like a small networking helper, and it is. But it PULLS IN geo
# (whose Clock flows through it untouched — reachable here, intrinsic
# there), it declares ONE C extern (a trust boundary the effect
# algebra can only name, not prove), and it does real Net work of
# its own.
#
# In the report:
#   - Net      is intrinsic HERE (net_lookup)
#   - IO       is intrinsic HERE (println in log_line) and at the
#              entry file too — one effect, two introduction points
#   - Clock    is REACHABLE here, intrinsic in geo — attribution
#              charges geo and draws the chain through this import

import "geo.hls"

# The FFI surface: one C function the audit names but cannot prove
# anything about (the Stage-15 rule — a promise about code the
# toolchain cannot see would be a lie). Declared pure by the author
# (libc's labs — a pure arithmetic query); the report shows the
# boundary either way.
extern "C" {
    fn labs(n: int) -> int pure
}

# The C boundary, wrapped: the absolute duration between two clock
# reads. Pure calling pure — no effect enters through this frame.
fn delta_ms(t0: int, t1: int) -> int {
    return labs(t1 - t0)
}

# Structured logging — the IO introduction point of this module.
fn log_line(s: str) -> void uses IO {
    println("[netcheck] " + s)
}

# DNS resolution — the Net introduction point of this tree.
fn resolve_host(host: str) -> str uses Net {
    return net_lookup(host)
}

# The composition the entry file actually calls: time the lookup,
# log the outcome. Net + Clock + IO all meet in this one frame —
# which is why the timing of resolve_or_log leaks nothing HERE (the
# duration is logged, never branched on).
fn resolve_or_log(host: str) -> int uses Net, Clock, IO {
    let t0: int = elapsed_ms()
    let ip: str = net_lookup(host)
    let t1: int = elapsed_ms()
    log_line("resolved " + host + " in " + delta_ms(t0, t1).to_str()
    + " ms")
    return ip.len()
}
