# examples/man_demo.hls — Stage 62 (v0.77.0-alpha): std.man demo.
#
# This demo exercises every feature of std.man:
#   - ManPage builder (man_new + with_desc / with_date / with_source /
#     with_manual / with_author / with_bugs / with_long_desc /
#     with_after_help / with_examples / with_see_also / with_exit_codes)
#   - man_add_example / man_add_see_also / man_add_exit_code (the
#     list-appending variants)
#   - impl ManPage method twins (.with_* / .add_*)
#   - man_render(page, parser) — pure render to nroff source
#   - man_render_default(parser) — live clock entry point
#   - man_escape — the security-critical groff metacharacter escaper
#   - man_section_name — the 8 canonical sections
#   - man_install_path — the canonical install path computation
#   - man_is_safe_name — the name sanitiser (rejects /, .., leading -)
#   - man_format_iso_date — the Hinnant civil-from-days algorithm
#   - man_split_paragraphs — the multi-paragraph DESCRIPTION splitter
#
# The demo is differential-safe: every stdout line is a pure function
# of fixed inputs (a synthetic CliParser + a fixed date). The live
# man_render_default reads the wall clock — its output is printed for
# the human reader but its date is NOT compared against a snapshot
# (it varies by day).

import "std.man"
import "std.cli"
import "std.str"

# ----------------------------------------------------------------------------
# Helper — print a header between sections.
# ----------------------------------------------------------------------------

fn section(title: str) -> void uses IO {
    println("")
    println("--- " + title + " ---")
}

# ----------------------------------------------------------------------------
# Build a demo CliParser — a realistic CLI shape with options, positionals,
# subcommands, and env-var fallbacks.
# ----------------------------------------------------------------------------

fn build_demo_parser() -> CliParser {
    let p0: CliParser = cli_parser_new("myapp", "1.2.3")
    let p1: CliParser = cli_parser_desc(p0, "A sample application that builds a man page")
    let p2: CliParser = cli_parser_flag(p1, "verbose", "v", "Enable verbose output")
    let p3: CliParser = cli_parser_int_opt(p2, "port", "p", "Port number to listen on", false, 8080)
    let p4: CliParser = cli_parser_str_opt(p3, "host", "H", "Host to bind", false, "localhost")
    let p5: CliParser = cli_parser_float_opt(p4, "timeout", "t", "Connection timeout (seconds)", false, 30.0)
    let p6: CliParser = cli_parser_str_positional(p5, "input", "Input file", true)
    let p7: CliParser = cli_parser_int_positional(p6, "count", "Repeat count", false)
    let p8: CliParser = cli_parser_env(p7, "port", "MYAPP_PORT")
    let p9: CliParser = cli_parser_subcommand(p8, "init", "Initialize the project")
    let p10: CliParser = cli_parser_subcommand(p9, "build", "Build the project")
    return p10
}

# ----------------------------------------------------------------------------
# Build a comprehensive ManPage using the builder pattern.
# ----------------------------------------------------------------------------

fn build_demo_man_page() -> ManPage {
    let m0: ManPage = man_new("myapp", man_section_user_commands(), "1.2.3")
    let m1: ManPage = man_with_desc(m0, "sample application that builds a man page")
    let m2: ManPage = man_with_date(m1, "2026-09-09")
    let m3: ManPage = man_with_source(m2, "myapp 1.2.3")
    let m4: ManPage = man_with_manual(m3, "User Commands")
    let m5: ManPage = man_with_author(m4, "Jane Doe <jane@example.com>")
    let m6: ManPage = man_with_bugs(m5, "https://github.com/mhieuhonda/halis-lang/issues")
    let m7: ManPage = man_with_long_desc(m6,
        "myapp is a sample application that demonstrates every feature of std.man.\n\n" +
        "It builds a CliParser, populates a ManPage via the builder pattern, and renders the complete nroff source via man_render.\n\n" +
        "The output is a valid groff/nroff man page that can be installed at " +
        "/usr/local/share/man/man1/myapp.1 and viewed with `man myapp`.")
    let m8: ManPage = man_with_after_help(m7,
        "Exit codes follow the BSD convention: 0 success, 1 usage error, 2 missing required argument.")
    let m9: ManPage = man_add_exit_code(m8, 0, "Success.")
    let m10: ManPage = man_add_exit_code(m9, 1, "Usage error (invalid flag, unknown subcommand).")
    let m11: ManPage = man_add_exit_code(m10, 2, "Missing required argument.")
    let m12: ManPage = man_add_example(m11, "Run with verbose logging",
        "myapp --verbose input.txt")
    let m13: ManPage = man_add_example(m12, "Bind to a custom port",
        "myapp -p 9000 input.txt")
    let m14: ManPage = man_add_example(m13, "Use an env var for the port",
        "MYAPP_PORT=9000 myapp input.txt")
    let m15: ManPage = man_add_see_also(m14, "myapp-config", 5)
    return m15
}

# ----------------------------------------------------------------------------
# Demo 1 — section names.
# ----------------------------------------------------------------------------

fn demo_section_names() -> void uses IO {
    section("Section 1 -> User Commands, 3 -> Library Functions, etc.")
    let s1: str = man_section_name(man_section_user_commands())
    let s3: str = man_section_name(man_section_library_functions())
    let s8: str = man_section_name(man_section_system_administration())
    println("  section 1 -> " + s1)
    println("  section 3 -> " + s3)
    println("  section 8 -> " + s8)
}

# ----------------------------------------------------------------------------
# Demo 2 — man_escape (the security escaper).
# ----------------------------------------------------------------------------

fn demo_escape() -> void uses IO {
    section("man_escape: groff metacharacter escaping")
    let inputs: list[str] = [
        "plain text",
        "hyphenated-word",
        "back\\slash",
        ".leading-dot",
        "'leading-apostrophe",
        "tab\tand\nnewline",
        "control" + chr(12) + "char",
    ]
    let mut i: int = 0
    while i < inputs.len() {
        let src: str = inputs.get(i)
        let esc: str = man_escape(src)
        println("  input : " + man_show_chars(src))
        println("  output: " + man_show_chars(esc))
        i = i + 1
    }
}

# man_show_chars(s) — render a string with control chars visible (for
# the demo output; not part of the std.man API). Replaces \t, \n, \r,
# and other control bytes with their hex code in brackets.
fn man_show_chars(s: str) -> str {
    let n: int = s.len()
    let out: list[str] = []
    let mut i: int = 0
    while i < n {
        let b: int = s.byte_at(i)
        if b == 9 {
            out.push("[TAB]")
        } else if b == 10 {
            out.push("[LF]")
        } else if b == 13 {
            out.push("[CR]")
        } else if b < 32 {
            out.push("[0x" + man_hex_byte(b) + "]")
        } else {
            out.push(s.slice(i, i + 1))
        }
        i = i + 1
    }
    return str_join(out, "")
}

fn man_hex_byte(b: int) -> str {
    let hi: int = b / 16
    let lo: int = b % 16
    return man_hex_digit(hi) + man_hex_digit(lo)
}

fn man_hex_digit(n: int) -> str {
    if n < 10 {
        return n.to_str()
    }
    if n == 10 { return "a" }
    if n == 11 { return "b" }
    if n == 12 { return "c" }
    if n == 13 { return "d" }
    if n == 14 { return "e" }
    return "f"
}

# ----------------------------------------------------------------------------
# Demo 3 — man_format_iso_date (Hinnant civil-from-days).
# ----------------------------------------------------------------------------

fn demo_iso_date() -> void uses IO {
    section("man_format_iso_date: Hinnant civil-from-days (pre-epoch safe)")
    let timestamps: list[int] = [
        0,                  # 1970-01-01 (epoch)
        -86400000,          # 1969-12-31 (pre-epoch)
        1788912000000,      # 2026-09-09
        1709164800000,      # 2024-02-29 (leap day)
        946684800000,       # 2000-01-01 (Y2K)
    ]
    let mut i: int = 0
    while i < timestamps.len() {
        let ms: int = timestamps.get(i)
        let iso: str = man_format_iso_date(ms)
        println("  ms=" + ms.to_str() + " -> " + iso)
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# Demo 4 — man_install_path (canonical install path computation).
# ----------------------------------------------------------------------------

fn demo_install_path() -> void uses IO {
    section("man_install_path: canonical install path")
    let names: list[str] = ["myapp", "my-app", "my_app"]
    let sections: list[int] = [1, 3, 5, 8]
    let mut i: int = 0
    while i < names.len() {
        let nm: str = names.get(i)
        let mut j: int = 0
        while j < sections.len() {
            let s: int = sections.get(j)
            let path: str = man_install_path(nm, s, "/usr/local")
            println("  " + nm + " section " + s.to_str() + " -> " + path)
            j = j + 1
        }
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# Demo 5 — full man_render output.
# ----------------------------------------------------------------------------

fn demo_full_render() -> void uses IO {
    section("man_render: full nroff source (the first 40 lines)")
    let parser: CliParser = build_demo_parser()
    let page: ManPage = build_demo_man_page()
    let out: str = man_render(page, parser)
    # Print the first 40 lines so the reader sees the structure.
    let lines: list[str] = out.split("\n")
    let limit: int = 40
    let mut i: int = 0
    while i < lines.len() && i < limit {
        println("  " + lines.get(i))
        i = i + 1
    }
    if lines.len() > limit {
        println("  ... (" + (lines.len() - limit).to_str() + " more lines)")
    }
}

# ----------------------------------------------------------------------------
# Demo 6 — impl ManPage method twins (builder chaining).
# ----------------------------------------------------------------------------

fn demo_method_chain() -> void uses IO {
    section("impl ManPage method twins (builder chain)")
    let parser: CliParser = build_demo_parser()
    let m: ManPage = man_new("myapp", 1, "1.2.3")
        .with_desc("via method chain")
        .with_date("2026-09-09")
        .with_source("myapp 1.2.3")
        .with_manual("User Commands")
        .with_author("Jane Doe")
        .with_bugs("https://example.com/bugs")
        .with_after_help("Extra after-help text.")
        .add_exit_code(0, "Success.")
        .add_example("Example 1", "myapp")
        .add_see_also("foo", 1)
    let out: str = m.render(parser)
    # Just print the .TH line and the NAME section as a smoke test.
    let lines: list[str] = out.split("\n")
    let mut i: int = 0
    while i < lines.len() && i < 5 {
        println("  " + lines.get(i))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# Demo 7 — man_render_default (live clock entry point).
# This carries the Clock effect — it reads the wall clock for today's date.
# ----------------------------------------------------------------------------

fn demo_render_default() -> void uses IO, Clock {
    section("man_render_default: live clock, sane defaults (first 5 lines)")
    let parser: CliParser = build_demo_parser()
    let out: str = man_render_default(parser)
    let lines: list[str] = out.split("\n")
    let mut i: int = 0
    while i < lines.len() && i < 5 {
        println("  " + lines.get(i))
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# Main — run all demos.
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Clock, Fs {
    println("=== Stage 62 (v0.77.0-alpha): std.man — man-page generator ===")
    println("")
    demo_section_names()
    demo_escape()
    demo_iso_date()
    demo_install_path()
    demo_full_render()
    demo_method_chain()
    demo_render_default()
    println("")
    println("ACCEPTANCE OK: Stage 62 — std.man demo runs clean.")
    return 0
}
