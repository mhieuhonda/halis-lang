# examples/set_demo.hls — demonstrate std.set (non-roadmap upgrade).
#
# Build a set of unique words from a small "document" and use set
# operations to compare it against a "stopwords" set, then print
# the difference (the document's content words).
#
# Run:  python3 boot/boot.py examples/set_demo.hls

import "std.set"
import "std.str"

fn main() -> int uses IO {
    # A tiny "document" — list of words with duplicates.
    let doc: list[str] = ["the", "quick", "brown", "fox", "the", "lazy",
                         "dog", "quick", "fox", "jumps"]
    let words: map[str, bool] = set_str_from_list(doc)
    println("unique words: " + set_str_size(words).to_str())

    # Common English stopwords.
    let stopwords: map[str, bool] = set_str_from_list(["the", "a", "an",
                                                       "of", "to", "and",
                                                       "is", "in", "on"])

    # Content words = words - stopwords.
    let content: map[str, bool] = set_str_diff(words, stopwords)
    let content_list: list[str] = set_str_to_list(content)
    println("content words (" + content_list.len().to_str() + "): " +
            str_join(content_list, ", "))

    # Two documents — how many words do they share?
    let doc2: list[str] = ["the", "slow", "brown", "bear", "sleeps"]
    let words2: map[str, bool] = set_str_from_list(doc2)
    let shared: map[str, bool] = set_str_intersect(words, words2)
    let shared_list: list[str] = set_str_to_list(shared)
    println("shared with doc2: [" + str_join(shared_list, ", ") + "]")

    # Combined vocabulary.
    let vocab: map[str, bool] = set_str_union(words, words2)
    println("combined vocabulary size: " + set_str_size(vocab).to_str())
    return 0
}
