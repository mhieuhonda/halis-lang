# pkg_audit_demo — the root package of the Stage 103 package demo.
#
# The manifest declares ONE dependency (audit_lib_a) and allows ONE
# effect (IO). But the tree underneath is two deep, and the package
# two hops away reads files and reads the clock:
#
#   pkg_audit_demo           allowed = [IO]        surface: IO
#   `- audit_lib_a           (pure — a string helper)
#      `- audit_lib_b        surface: Fs, Clock    <-- the finding
#
# `hls-pkg audit` prints the top level flat: audit_lib_a, no effects.
# Nothing it can say names audit_lib_b — the nested manifest was
# never opened. hls-audit walks INTO audit_lib_a, finds the nested
# dep, audits lib_b through the wrapper contract, and fails the run:
#
#   python3 tools/hls-audit.py --pkg examples/pkg_audit_demo
#   ... Fs    (introduced by audit_lib_b)
#   ...       via: pkg_audit_demo -> audit_lib_a -> audit_lib_b
#   ... Clock (introduced by audit_lib_b)
#   ...       via: pkg_audit_demo -> audit_lib_a -> audit_lib_b
#   ... verdict: VIOLATED — 2 effect(s) outside the allowed set
#
# Allow them and the same run exits 0:
#   python3 tools/hls-audit.py --pkg examples/pkg_audit_demo \
#       --allow IO,Fs,Clock

fn main() -> int uses IO {
    println("pkg_audit_demo: one dep on paper, two in the tree")
    return 0
}
