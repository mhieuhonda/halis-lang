# ============================================================================
# examples/bare_x86_64.hls — Stage 93 (v0.112.0-alpha)
# ----------------------------------------------------------------------------
# The bare-metal triple probe: the SAME source is compiled
#
#     bin/hlc --target x86_64-unknown-none examples/bare_x86_64.hls out.c
#
# linked with targets/x86_64-unknown-none.ld (no libc, no crt0, entry
# _start, integer-only) and RUNS directly on any x86-64 host — a
# freestanding image needs no OS cooperation beyond the raw exit
# syscall the naked _start already carries (Stage 77).
#
#   make triple-x86_64 F=examples/bare_x86_64.hls
#   bin/bare_x86_64; echo "exit=$?"        # exit=42
#
# The program is integer-only BY RULE: under --target the compiler
# rejects float literals and float annotations (the FPU is not enabled
# before a kernel saves its state), so the checksum below is built from
# the integer arithmetic a real early-boot probe would use.
# ============================================================================

#![freestanding]

# A rolling multiply-add pass over the boot banner — the canonical
# "the integers work" probe a kernel runs before it trusts its own
# console. (The core language has no bitwise operators; the wrap is an
# ordinary modulo, which is exactly what an integer-only probe should
# rely on.)
fn banner_checksum() -> int {
    let banner: list[int] = [104, 97, 108, 105, 115]  # "halis"
    let mut h: int = 7
    let mut i: int = 0
    while i < banner.len() {
        h = (h * 31 + banner.get(i)) % 268435456
        i = i + 1
    }
    return h
}

# The GCD the boot sector of legend used as its smoke test.
fn gcd(a: int, b: int) -> int {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}

fn main() -> int {
    let cs: int = banner_checksum()
    let g: int = gcd(1071, 462)          # 21
    let primes_under_20: int = 8         # 2 3 5 7 11 13 17 19
    # The checksum's low decimal digit is 0 for the fixed banner, so
    # the probe closes at exactly 0 + 21 + 8 + 13 = 42. Any drift in
    # the integer pipeline (a wrong multiply, a lost carry, a broken
    # modulo) moves the exit code off 42 — that is the whole point.
    return cs % 10 + g + primes_under_20 + 13
}
