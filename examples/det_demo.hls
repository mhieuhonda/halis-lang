# det_demo.hls — Stage 127 (v0.145.0-alpha): the deterministic
# scheduler, end to end. A request/reply pipeline whose output ORDER
# depends on the interleaving: preemptively the two replies can arrive
# in either order (a flaky test); under the mode they cannot.
#
# Try it three ways:
#
#   # 1. preemptive (the interleaving is the OS's business):
#   make run F=examples/det_demo.hls
#
#   # 2. deterministic (the FIFO baton rotation; output is identical
#   #    on EVERY run, interpreter and native alike):
#   HL_DET_SCHED=1 python3 boot/boot.py --det examples/det_demo.hls
#   make run F=examples/det_demo.hls   # then: HL_DET_SCHED=1 ./det_demo
#
#   # 3. certified + the interleaving made visible (every scheduling
#   #    point, byte-identical on both backends):
#   python3 tools/hls-det.py --trace examples/det_demo.hls

fn worker(id: int, jobs: Chan[int], results: Chan[int]) -> int uses Conc {
    let mut go: int = 1
    while go == 1 {
        let j: int = jobs.recv()
        if j < 0 {
            go = 0
        } else {
            # The reply ORDER is interleaving-sensitive: two workers
            # race to answer. Under det, the rotation fixes who answers
            # first — the trace names them.
            results.send(j * 10 + id)
        }
    }
    return id
}

fn main() -> int uses IO, Conc {
    let jobs: Chan[int] = chan_new()
    let results: Chan[int] = chan_new()
    let w1: Task[int] = spawn(worker, 1, clone(jobs), clone(results))
    let w2: Task[int] = spawn(worker, 2, clone(jobs), clone(results))

    jobs.send(5)
    jobs.send(6)
    jobs.send(-1)
    jobs.send(-1)

    let first: int = results.recv()
    let second: int = results.recv()
    let r1: int = w1.join()
    let r2: int = w2.join()

    # The SUM is interleaving-independent; the ORDER is not. Under the
    # rotation the first reply is always worker 1's (the child's first
    # turn comes before its parent's next) and the second is always
    # worker 2's (the queue alternates — a fairness the preemptive
    # scheduler does not promise, where one fast worker can answer both).
    println("first=" + first.to_str() + " second=" + second.to_str())
    println("sum=" + (first + second).to_str() + " r1=" + r1.to_str() + " r2=" + r2.to_str())
    return 0
}
