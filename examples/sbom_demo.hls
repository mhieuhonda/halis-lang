# sbom_demo.hls — Stage 104 (v0.123.0-alpha): the bill of materials
# demo.
#
# A release is a list of parts. This program's tree IS the list —
# three workspace files and one toolchain module, each hashed, each
# wired to the next by an import edge — and hls-sbom writes it down
# in the two formats the industry already reads:
#
#   sbom_demo.hls                    (application — the release root)
#   |- std.str                       [toolchain]  (pure string help)
#   `- sbom_libs/dep_a.hls           [workspace]
#      |- sbom_libs/dep_b.hls        [workspace] — Clock + Fs
#      |  `- std.str                 [toolchain]
#      `- std.str                    [toolchain]
#
#   python3 tools/hls-sbom.py examples/sbom_demo.hls
#   python3 tools/hls-sbom.py examples/sbom_demo.hls --format cdx --stdout
#   python3 tools/hls-sbom.py examples/sbom_demo.hls --format spdx --stdout
#   python3 tools/hls-sbom.py examples/sbom_demo.hls --json
#
# The CycloneDX document: one application (this file), three file
# components, SHA-256 per component, the graph in `dependencies`,
# the audit's effect split riding along as properties. The SPDX
# document: the same parts as packages, the same edges as DESCRIBES
# + DEPENDS_ON relationships, CC0-1.0. The serialNumber is derived
# from the component hashes — change one byte in dep_b and the
# serial changes; re-run unchanged and nothing moves.
#
# The demo itself runs: a tiny "release check" that exercises the
# tree the documents describe (a localhost lookup through dep_a, a
# manifest query and a clock read in dep_b). Output is deterministic
# — interpreter and native agree byte for byte, the same contract
# every demo here holds. Nothing is compiled differently by being
# listed; the SBOM reads the tree, it does not touch it.

import "std.str"
import "sbom_libs/dep_a.hls"

fn yn(b: bool) -> str {
    if b {
        return "true"
    }
    return "false"
}

fn main() -> int uses IO, Net, Clock, Fs {
    println("bill of materials for one small release")
    println("  parts      = " + probe_parts())
    println("  dep_a      = one localhost lookup (Net, listed as a"
    + " property)")
    let seen: bool = has_manifest()
    println("  manifest   = present: " + yn(seen))
    let t0: int = read_stamp()
    let t1: int = read_stamp()
    println("  clock      = monotonic: " + yn(t0 <= t1))
    println("surface: the union the documents stamp as"
    + " hls:effects:surface — Net, Clock, Fs, IO")
    return 0
}
