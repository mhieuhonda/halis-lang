# examples/ffi_demo.hls — Stage 15 demo: Safe C FFI.
#
# This program declares three external C functions (abs, strlen, toupper)
# and calls them. Each call goes through the FFI fence: the function
# must declare `uses IO` (or `pure` for functions with no side effects).
#
# Run:
#   python3 boot/boot.py examples/ffi_demo.hls
#
# To generate the extern block from a C header:
#   python3 tools/hlbindgen.py /usr/include/stdlib.h > /tmp/stdlib_externs.hls

extern "C" {
    fn abs(n: int) -> int pure
    fn strlen(s: str) -> int uses IO
    fn toupper(c: int) -> int pure
}

fn shout(s: str) -> str uses IO {
    let n: int = strlen(s)
    let mut out: str = ""
    let mut i: int = 0
    while i < n {
        let b: int = s.byte_at(i)
        let upper: int = toupper(b)
        out = out + chr(upper)
        i = i + 1
    }
    return out
}

fn main() -> int uses IO {
    let x: int = abs(-99)
    println("abs(-99) = " + x.to_str())

    let len: int = strlen("Hieu Louis FFI")
    println("strlen(\"Hieu Louis FFI\") = " + len.to_str())

    let shouted: str = shout("hello, ffi world")
    println("shout(\"hello, ffi world\") = " + shouted)

    return 0
}
