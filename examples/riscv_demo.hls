# riscv_demo.hls — Stage 26 (v0.49.0-alpha): RISC-V 64 backend foundation.
#
# This program demonstrates the two RISC-V 64 targets:
#
#   1. riscv64gc-unknown-linux-gnu — full Linux user-mode (RV64GC).
#      Compile with: make riscv-bench F=examples/riscv_demo.hls
#      The RVV (RISC-V Vector) intrinsics are emitted under
#      --target-feature rvv (the std.simd kernels lower to
#      __riscv_vadd_vv_i32m1 / __riscv_vsub_vv_i32m1 / __riscv_vmul_vv_i32m1
#      / __riscv_vmin_vv_i32m1 / __riscv_vmax_vv_i32m1 for i32x4,
#      __riscv_vadd_vv_f64m1 / __riscv_vsub_vv_f64m1 / __riscv_vmul_vv_f64m1
#      for f64x2). The same C source compiles on every host via the
#      scalar fallback in the #else branch.
#
#   2. riscv64-unknown-none — bare-metal (no OS, no libc, for OS work).
#      Compile with: make riscv-bare-metal F=examples/riscv_demo.hls
#      The C source is freestanding: no libc calls from the user code
#      (the Halis runtime's libc-using helpers — hl_die, hl_print,
#      hl_alloc, etc. — are dead-code-eliminated by the linker under
#      -ffunction-sections -fdata-sections -Wl,--gc-sections when the
#      user code does not call IO builtins).
#
# The `bare_main` function below is the freestanding entry point: it
# performs pure integer arithmetic (no IO, no allocation) and returns
# 0. The `main` function (the Linux user-mode entry) demonstrates the
# RVV path: it calls the std.simd kernels which lower to RVV intrinsics
# under --target-feature rvv.
#
# Acceptance (Stage 26): `make cross TARGET=riscv64-unknown-none` produces
# a bare-metal binary that runs in QEMU; the binary contains zero libc
# references (verified by `nm <binary> | grep ' U printf'` returning
# nothing). `make riscv-acceptance` verifies the RVV intrinsics are
# emitted in the C source for the Linux target.

import "std.simd"

# fib_iter: pure integer Fibonacci (no IO, no allocation).
# This is the body of the freestanding `bare_main` function. The
# arithmetic uses Halis's checked int64 arithmetic (the `+` operator
# lowers to hl_add_i64, which calls hl_die on overflow — the only
# runtime helper that can reach libc; under -ffunction-sections
# -fdata-sections -Wl,--gc-sections, the linker removes hl_die when
# no overflow occurs in the actual call sites, which is the case for
# fib_iter(20) on every input — the values fit in int64).
fn fib_iter(n: int) -> int {
    let mut a: int = 0
    let mut b: int = 1
    let mut i: int = 0
    while i < n {
        let t: int = a + b
        a = b
        b = t
        i = i + 1
    }
    return a
}

# riscv_sum_range: pure integer sum (no IO, no allocation).
# Returns n * (n + 1) / 2 (the closed-form for sum 1..n). Used by
# bare_main as a smoke test that the arithmetic lowering works on
# the bare-metal target (no libc, no malloc, no printf).
fn riscv_sum_range(n: int) -> int {
    let mut total: int = 0
    let mut i: int = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

# riscv_rvv_demo: demonstrates the RVV intrinsic fast paths for std.simd.
# Under --target-feature rvv, the simd_i32x4_add / simd_i32x4_sub /
# simd_i32x4_mul calls lower to __riscv_vadd_vv_i32m1 / __riscv_vsub_vv_i32m1
# / __riscv_vmul_vv_i32m1 in the #if __riscv && __riscv_v branch. The
# same C source compiles on every host via the scalar fallback in the
# #else branch. This is the Stage 26 RVV codegen acceptance demo.
fn riscv_rvv_demo() -> int {
    let a: I32x4 = simd_i32x4_from(1, 2, 3, 4)
    let b: I32x4 = simd_i32x4_splat(10)
    let sum: I32x4 = simd_i32x4_add(a, b)
    let s0: int = simd_i32x4_lane(sum, 0)
    let s1: int = simd_i32x4_lane(sum, 1)
    let s2: int = simd_i32x4_lane(sum, 2)
    let s3: int = simd_i32x4_lane(sum, 3)
    # sum = [11, 12, 13, 14] -> 11 + 12 + 13 + 14 = 50
    return s0 + s1 + s2 + s3
}

# main: the Linux user-mode entry point. Demonstrates the RVV path
# (calls riscv_rvv_demo) and prints the result. The IO builtins
# (println) pull in libc — this entry is NOT used for the bare-metal
# target (the bare-metal target's entry is `bare_main`, which is
# declared below).
fn main() -> int uses IO {
    let fib10: int = fib_iter(10)
    let sum100: int = riscv_sum_range(100)
    let rvv: int = riscv_rvv_demo()
    println("Stage 26 RISC-V 64 backend demo")
    println("  fib_iter(10) = " + fib10.to_str() + " (expected 55)")
    println("  riscv_sum_range(100) = " + sum100.to_str() + " (expected 5050)")
    println("  riscv_rvv_demo() = " + rvv.to_str() + " (expected 50)")
    if has_feature("rvv") {
        println("  compiled with --target-feature rvv (RVV intrinsics active)")
    } else {
        println("  portable path (compile with --target-feature rvv for RVV intrinsics)")
    }
    println("  CPU has RVV: " + simd_cpu_supports("rvv").to_str())
    if fib10 == 55 && sum100 == 5050 && rvv == 50 {
        println("ACCEPTANCE OK: Stage 26 RISC-V demo passes")
        return 0
    }
    println("FAIL: Stage 26 RISC-V demo mismatch")
    return 1
}
