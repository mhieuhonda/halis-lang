# audit_lib_a — the MIDDLE package of the Stage 103 package demo.
#
# It declares audit_lib_b as a dependency — and that is the whole
# point of the stage: `hls-pkg audit` stops at the top level and
# never opens lib_b's manifest, so lib_b's Fs + Clock were invisible
# to every report the package manager could draw. hls-audit walks
# INTO this manifest, finds the nested path dep, and names lib_b at
# depth 2 with the chain pkg_audit_demo -> audit_lib_a -> audit_lib_b.
#
# The path is repo-root-relative (the hls-pkg contract for path deps
# — resolve_dependency confines to the repo root); hls-audit also
# accepts package-relative paths for nested deps, whichever the
# manifest author means.

fn describe(cfg: str) -> str {
    return "audit_lib_a:" + cfg
}
