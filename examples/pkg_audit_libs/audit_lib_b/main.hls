# audit_lib_b — the DEEP package of the Stage 103 package demo.
#
# Its surface is the finding: it reads a file and reads the clock.
# Whatever allows it, the ROOT's supply-chain report names it here,
# two hops from the root:
#
#   python3 tools/hls-audit.py --pkg examples/pkg_audit_demo
#
# A LIBRARY package: no main — hls-audit audits it through the same
# wrapper contract hls-pkg lock uses (a generated wrapper imports the
# entry and declares a pure main).

fn read_config() -> str uses Fs {
    return read_file("config.txt")
}

fn since_start(t0: int) -> int uses Clock {
    return clock_ms() - t0
}

fn both() -> str uses Fs, Clock {
    let t0: int = clock_ms()
    let cfg: str = read_file("config.txt")
    return cfg + "@" + (clock_ms() - t0).to_str()
}
