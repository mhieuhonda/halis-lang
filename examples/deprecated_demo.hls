# deprecated_demo.hls — Stage 130 (v0.148.0-alpha): the deprecation
# mechanism — `#[deprecated]` / `#[deprecated("why")]` on a fn, and
# the linter's L013 deprecated-call rule.
#
# The attribute is pure METADATA: both front-ends accept it, the
# emitted C carries nothing for it, and a deprecated fn runs exactly
# like any other. The linter is the alarm — it warns at every call
# site and quotes the message:
#
#   python3 tools/hllint.py examples/deprecated_demo.hls
#   examples/deprecated_demo.hls:22: warning [L013] call to deprecated
#       'shout': use announce(s) — the old form loses the trailing
#       newline
#   examples/deprecated_demo.hls:23: warning [L013] call to deprecated
#       'legacy_id' (no deprecation message given)
#
# The demo itself runs green: calling a deprecated function is not an
# error — it is a note that you are standing on an API the authors
# have promised to remove.

#[deprecated("use announce(s) — the old form loses the trailing newline")]
fn shout(s: str) -> str {
    return s + "!"
}

fn announce(s: str) -> str {
    return s + "!\n"
}

#[deprecated]
fn legacy_id(v: int) -> int {
    return 1000 + v
}

fn modern_id(v: int) -> int {
    return 1000 + v
}

fn main() -> int uses IO {
    # The deprecated calls (the linter warns; the program runs):
    let a: str = shout("hello")
    let b: int = legacy_id(7)
    # The live replacements:
    let c: str = announce("hello")
    let d: int = modern_id(7)
    if a != "hello!" {
        return 1
    }
    if c != "hello!\n" {
        return 2
    }
    if b != d {
        return 3
    }
    print(a + "\n")
    print(c)
    println("deprecated demo OK: " + b.to_str())
    return 0
}
