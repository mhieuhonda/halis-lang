# consttime_demo.hls — Stage 102 (v0.121.0-alpha): the constant-time
# verifier demo.
#
# A small crypto toolkit whose critical fns CARRY the claim:
#
#   python3 tools/hlprove.py examples/consttime_demo.hls --consttime
#
# `#[ct]` asserts "constant-time over every secret that reaches me".
# The claim is proven, not trusted: the verifier re-runs the Stage 101
# fixpoint in each claim's own taint universe (only this fn's
# #[secrets(...)] parameters are roots) and either discharge it —
# VERIFIED — or refute it with the sink line and the incoming chain —
# VIOLATED, and the run exits 1. The demo's claims all verify:
#
#   ct_pick      branch-free selection (a secret multiplied, never
#                branched on, never used as an address)
#   ct_fold      a sequential MAC: byte_at with a PUBLIC index (the
#                address is the loop counter), the len() gate is
#                public by policy — counted, never hidden
#   ct_expand    the claim holds THROUGH the call chain: the secret
#                crosses two schedule_step hops, both arithmetic-only,
#                so the reach is three fns and the verdict is still
#                VERIFIED
#
# early_exit is deliberately leaky (the classic compare-and-return
# timing oracle) and deliberately UNclaimed: the verifier has nothing
# to say about it, the Stage 101 audit (hlprove --sidechannel) is the
# tool that reports it. Analysis reports; the claim gates.
#
# The markings change no codegen: the interpreter and the native
# binary agree byte for byte.
#
#   make run F=examples/consttime_demo.hls

#[secrets(mask)]
#[ct]
fn ct_pick(mask: int, a: int, b: int) -> int {
    return a * mask + b * (1 - mask)
}

#[secrets(acc, k)]
#[ct]
fn ct_fold(mut acc: int, k: str) -> int {
    let mut i: int = 0
    while i < k.len() {
        acc = acc + k.byte_at(i) * 31
        i = i + 1
    }
    return acc
}

fn schedule_step(k: int) -> int {
    return k * 7 + 31
}

#[secrets(master)]
#[ct]
fn ct_expand(master: int) -> int {
    return schedule_step(schedule_step(master))
}

#[secrets(key)]
fn early_exit(key: str, probe: str) -> int {
    let mut i: int = 0
    while i < probe.len() {
        if key.byte_at(i) != probe.byte_at(i) {
            return i
        }
        i = i + 1
    }
    return -1
}

fn main() -> int uses IO {
    println(ct_pick(1, 10, 20).to_str())
    println(ct_pick(0, 10, 20).to_str())
    println(ct_fold(0, "abc").to_str())
    println(ct_expand(5).to_str())
    println(early_exit("hhhh", "hhhh").to_str())
    return 0
}
