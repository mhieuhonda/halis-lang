# sidechannel_demo.hls — Stage 101 (v0.120.0-alpha): the side-channel
# audit demo.
#
# A small crypto toolkit whose secrets are MARKED with #[secrets(...)]
# and whose hazards the `hlprove --sidechannel` pass reports:
#
#   python3 tools/hlprove.py examples/sidechannel_demo.hls --sidechannel
#
# The toolkit carries every sink kind the pass knows, next to the
# constant-time idioms that stay CLEAN:
#
#   ct_pick      branch-free selection — a secret multiplied, never
#                branched on, never used as an address: CLEAN
#   table_lookup sbox.get(b) — the address follows the secret byte:
#                INDEX (the classic T-table cache hazard)
#   early_exit   the compare returns at the first differing byte:
#                BRANCH (the classic timing oracle)
#   workload     the loop bound and the final modulo are the secret:
#                LOOP-BOUND + DIVISION
#   key_len_gate branches on k.len() — PUBLIC BY POLICY, counted and
#                printed, never a leak (the report states this
#                assumption instead of hiding it)
#   expand       the secret crosses two helper calls and the leak is
#                found INSIDE round_mix, at its own line, with the
#                incoming chain printed: interprocedural by fixpoint
#
# The analysis is audit-only: the program runs identically with or
# without the markings, and the interpreter and the native binary
# agree byte for byte.
#
#   make run F=examples/sidechannel_demo.hls

#[secrets(mask)]
fn ct_pick(mask: int, a: int, b: int) -> int {
    return a * mask + b * (1 - mask)
}

#[secrets(b)]
fn table_lookup(sbox: list[int], b: int) -> int {
    return sbox.get(b)
}

#[secrets(key)]
fn early_exit(key: str, probe: str) -> int {
    let mut i: int = 0
    while i < probe.len() {
        if key.byte_at(i) != probe.byte_at(i) {
            return i
        }
        i = i + 1
    }
    return -1
}

#[secrets(rounds)]
fn workload(rounds: int) -> int {
    let mut acc: int = 0
    for i: int in range(0, rounds) {
        acc = acc + i * 3
    }
    acc = acc % rounds
    return acc
}

#[secrets(k)]
fn key_len_gate(k: str) -> int {
    if k.len() > 0 {
        return 1
    }
    return 0
}

fn round_mix(x: int) -> int {
    let mut y: int = 0
    if x > 96 {
        y = x - 96
    } else {
        y = x + 31
    }
    return y
}

fn schedule_step(k: int) -> int {
    return round_mix(k * 7)
}

#[secrets(master)]
fn expand(master: int) -> int {
    let r1: int = schedule_step(master)
    return schedule_step(r1)
}

fn main() -> int uses IO {
    let box: list[int] = [101, 102, 103, 104]
    println(ct_pick(1, 10, 20).to_str())
    println(table_lookup(box, 2).to_str())
    println(early_exit("hhhh", "hhhh").to_str())
    println(workload(12).to_str())
    println(key_len_gate("kk").to_str())
    println(expand(42).to_str())
    return 0
}
