# examples/complete_demo.hls — Stage 59 (v0.80.0-alpha): std.complete demo.
#
# This demo exercises every feature of std.complete:
#   - complete_render(parser, name, shell) for bash / zsh / fish / powershell
#   - complete_shell_from_str — parse shell name from CLI
#   - complete_install — write file to canonical install path
#   - complete_list_shells — human-readable listing
#
# The demo prints the first 30 lines of each shell's completion script
# (so the reader can see the structure without scrolling forever).

import "std.complete"
import "std.cli"
import "std.str"

# ----------------------------------------------------------------------------
# Build the demo parser — a realistic CLI shape.
# ----------------------------------------------------------------------------

fn build_demo_parser() -> CliParser {
    let p0: CliParser = cli_parser_new("myapp", "1.2.3")
    let p1: CliParser = cli_parser_desc(p0, "A sample application for Stage 59")
    let p2: CliParser = cli_parser_flag(p1, "verbose", "v", "Enable verbose output")
    let p3: CliParser = cli_parser_int_opt(p2, "port", "p", "Port number", false, 8080)
    let p4: CliParser = cli_parser_str_opt(p3, "host", "H", "Host to bind", false, "localhost")
    let p5: CliParser = cli_parser_str_opt(p4, "config", "c", "Config file", false, "")
    let p6: CliParser = cli_parser_float_opt(p5, "timeout", "t", "Timeout seconds", false, 30.0)
    let p7: CliParser = cli_parser_str_positional(p6, "input", "Input file", true)
    let p8: CliParser = cli_parser_subcommand(p7, "init", "Initialize the project")
    let p9: CliParser = cli_parser_subcommand(p8, "build", "Build the project")
    let p10: CliParser = cli_parser_subcommand(p9, "test", "Run tests")
    return p10
}

# ----------------------------------------------------------------------------
# Demo 1 — list supported shells.
# ----------------------------------------------------------------------------

fn demo_list_shells() -> void uses IO {
    println(complete_list_shells())
}

# ----------------------------------------------------------------------------
# Demo 2 — bash completion (first 30 lines).
# ----------------------------------------------------------------------------

fn demo_bash() -> void uses IO {
    let p: CliParser = build_demo_parser()
    let script: str = complete_render(p, "myapp", complete_shell_bash())
    println("=== bash completion (first 30 lines) ===")
    let lines: list[str] = script.split("\n")
    let mut i: int = 0
    while i < lines.len() && i < 30 {
        println(lines.get(i))
        i = i + 1
    }
    if lines.len() > 30 {
        println("... (" + (lines.len() - 30).to_str() + " more lines)")
    }
}

