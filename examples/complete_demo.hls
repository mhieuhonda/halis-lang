# ----------------------------------------------------------------------------
# Demo 6 — complete_shell_from_str (parse shell name from CLI).
# ----------------------------------------------------------------------------

fn demo_parse_shell() -> void uses IO {
    println("")
    println("=== complete_shell_from_str (parse shell name) ===")
    let inputs: list[str] = ["bash", "BASH", "sh", "zsh", "Zsh", "fish",
        "powershell", "pwsh", "ps", "unknown"]
    let mut i: int = 0
    while i < inputs.len() {
        let s: str = inputs.get(i)
        let kind: int = complete_shell_from_str(s)
        let name: str = complete_shell_name(kind)
        println("  '" + s + "' -> " + kind.to_str() + " (" + name + ")")
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# Demo 7 — complete_install (write file to canonical path).
# ----------------------------------------------------------------------------

fn demo_install() -> void uses IO, Fs {
    let p: CliParser = build_demo_parser()
    # Write to /tmp (a real install would use /etc/bash_completion.d).
    complete_install(p, "myapp", complete_shell_bash(), "/tmp")
    let content: str = read_file("/tmp/myapp")
    let lines: list[str] = content.split("\n")
    println("")
    println("=== complete_install (bash -> /tmp/myapp) ===")
    println("  wrote " + lines.len().to_str() + " lines to /tmp/myapp")
    println("  first line: " + lines.get(0))
    # Also install zsh and fish for completeness.
    complete_install(p, "myapp", complete_shell_zsh(), "/tmp")
    complete_install(p, "myapp", complete_shell_fish(), "/tmp")
    println("  also wrote /tmp/_myapp (zsh) and /tmp/myapp.fish (fish)")
}

# ----------------------------------------------------------------------------
# Main — run all demos.
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Fs {
    println("=== Stage 59 (v0.80.0-alpha): std.complete — shell-completion generator ===")
    println("")
    demo_list_shells()
    demo_bash()
    demo_zsh()
    demo_fish()
    demo_powershell()
    demo_parse_shell()
    demo_install()
    println("")
    println("ACCEPTANCE OK: Stage 59 — std.complete demo runs clean.")
    return 0
}
