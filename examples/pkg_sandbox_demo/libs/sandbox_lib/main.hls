# sandbox_lib — the dependency of the Stage 110 package demo.
#
# A LIBRARY package: no main. Its surface is the supply-chain story —
# Fs (read_file) and Clock (clock_ms), both inside the root's
# [effects].allowed, so the fail-closed gate hls-sandbox runs before
# arming passes. The root imports it relatively, so the entry's
# checker-computed surface includes what these functions actually
# do — the profile that gets armed covers the code that really runs.

fn report(path: str) -> str uses Fs {
    return read_file(path)
}

fn stamp() -> int uses Clock {
    return clock_ms()
}
