# pkg_sandbox_demo — the root package of the Stage 110 package demo.
#
# The entry imports its one declared dependency (sandbox_lib — the
# manifest tree `hls-audit --pkg` walks) and does exactly what the
# [sandbox] section pins: reads (Fs through the lib's read_file),
# consults the clock (Clock through the lib's clock_ms), prints
# (IO). Nothing else — and the profile the tool derives from this
# tree arms exactly that:
#
#   python3 tools/hls-sandbox.py profile --pkg examples/pkg_sandbox_demo
#   ... execution surface (checker, from main): Clock, Fs, IO
#   ... fs mode: ro (derived — the reachable builtin census is
#       read-only (read_file))
#   ... gate: manifest [effects].allowed (drift 0, unauditable 0,
#       violations 0)
#
# The output stays deterministic (the byte count, not the clock
# reading) so the interpreter/native differential holds byte for
# byte; the clock is still CONSULTED — the effect is real, the
# printout is just disciplined.
#
# The release statement pins the posture for consumers:
#   python3 tools/hls-sandbox.py release --pkg examples/pkg_sandbox_demo
#   python3 tools/hls-sandbox.py verify-release --pkg examples/pkg_sandbox_demo

import "libs/sandbox_lib/main.hls"

fn main() -> int uses IO, Fs, Clock {
    let t0: int = stamp()
    let text: str = report("examples/data.txt")
    let dt: int = stamp() - t0
    # dt is consulted but not printed: the digest of the bytes is
    # the deterministic thing this package reports.
    let mut h: int = 7
    let mut i: int = 0
    while i < text.len() {
        h = ((h + text.byte_at(i) + 1) * 31) % 1000000007
        i = i + 1
    }
    if dt < 0 {
        println("pkg_sandbox_demo: clock ran backwards")
        return 1
    }
    println("pkg_sandbox_demo: " + text.len().to_str() + " bytes, digest "
            + h.to_str())
    return 0
}
