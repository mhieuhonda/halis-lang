# inline_attrs_demo.hls — Stage 29 (v0.46.0-alpha): inline / hot / cold attributes.
#
# Demonstrates the four Stage 29 attributes on user functions:
#
#   #[inline(always)] - force inline at every call site. The LTO
#                       inliner bypasses the per-callee budget AND
#                       the per-program inline-site cap for this
#                       function. The C signature carries
#                       `static inline __attribute__((always_inline))`.
#   #[inline(never)]  - forbid inlining at every call site. The LTO
#                       inliner skips this function entirely; the C
#                       signature carries __attribute__((noinline)).
#   #[hot]            - mark the function hot. Overrides PGO: the C
#                       signature carries __attribute__((hot)) which
#                       hints gcc to inline-aggressively, layout the
#                       function near other hot code, and apply hot
#                       optimisations. Mutually exclusive with #[cold].
#   #[cold]           - mark the function cold. Overrides PGO: the C
#                       signature carries __attribute__((cold)) which
#                       hints gcc to layout the function away from
#                       hot code and apply cold-path optimisations
#                       (smaller code, more sharing). Mutually
#                       exclusive with #[hot].
#
# Acceptance: the optimiser's inline decisions match the annotations
# 100% (verified via `--opt-stats`). Run `make inline-acceptance` to
# verify:
#   (a) #[inline(always)] on `small_hot_helper` => inlined at every
#       call site under --lto (the LTO stats report shows it in the
#       "inlined callees" list, with 0 out-of-line call sites in
#       the C source)
#   (b) #[inline(never)] on `big_rare_path` => never inlined; the C
#       signature carries __attribute__((noinline))
#   (c) #[hot] on `hot_loop` => the C signature carries
#       __attribute__((hot)) (overrides PGO when a profile is loaded)
#   (d) #[cold] on `cold_path` => the C signature carries
#       __attribute__((cold)) (overrides PGO when a profile is loaded)
#   (e) `--opt-stats` prints a per-function table showing the
#       annotations and their source (annotated vs PGO vs heuristic)
#   (f) `hllint` warns (L011) when #[inline(always)] is on a function
#       > 50 statements (likely a mistake).

# A small hot helper. Inlining at every call site is beneficial
# (the function is so small that the call overhead dominates). The
# Stage 29 LTO integration forces inlining even when the heuristic
# would have refused (e.g., if the function was called inside a
# tight loop with many other inline candidates).
#[inline(always)]
fn small_hot_helper(x: int) -> int {
    return x + 1
}

# A big rare path. The body is too large to inline usefully; the
# user marks it #[inline(never)] to forbid the inliner from ever
# expanding it at a call site (the call overhead is dwarfed by
# the body's work). The C signature carries
# __attribute__((noinline)) as a SECOND layer of defence (gcc will
# refuse to inline even if the LTO inliner missed it).
#[inline(never)]
fn big_rare_path(x: int) -> int {
    let mut s: int = 0
    let mut i: int = 0
    while i < x {
        s = s + i * 2
        i = i + 1
    }
    return s
}

# A hot loop. The user has marked it #[hot] (without an inline
# annotation), so the optimiser still decides whether to inline
# based on its size — but the C signature carries
# __attribute__((hot)) which:
#   - hints gcc to inline-aggressively at every call site (the
#     gcc inliner respects the hot attribute as a strong hint)
#   - lays out the function near other hot code (improves I-cache
#     locality)
#   - applies hot-path optimisations (more aggressive inlining,
#     unrolling, vectorisation)
# When --pgo-use is active, #[hot] OVERRIDES the profile's hot/cold
# classification (the user's explicit annotation wins).
#[hot]
fn hot_loop(n: int) -> int {
    let mut i: int = 0
    let mut s: int = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    return s
}

# A cold path (an error handler that's almost never taken). The
# user marks it #[cold] so gcc lays it out away from hot code
# (improving I-cache locality of the hot path) and applies
# cold-path optimisations (smaller code, more sharing between
# cold paths).
#[cold]
fn cold_path(x: int) -> int {
    if x < 0 {
        return 0
    }
    return x
}

# main() exercises all four attributes. Note that:
#   - small_hot_helper(5) is inlined at this call site under --lto
#   - big_rare_path(10) is NOT inlined (call stays in the C source)
#   - hot_loop(100) MAY be inlined by gcc (gcc's own inliner
#     respects the hot attribute) — the LTO inliner treats it like
#     an un-annotated function (it's not #[inline(always)] or
#     #[inline(never)])
#   - cold_path(-1) is laid out cold by gcc (no inline decision
#     from the LTO inliner)
fn main() -> int uses IO {
    let a: int = small_hot_helper(5)
    let b: int = big_rare_path(10)
    let c: int = hot_loop(100)
    let d: int = cold_path(-1)
    println("small_hot_helper(5) = " + a.to_str() + " (inlined at call site under --lto)")
    println("big_rare_path(10) = " + b.to_str() + " (NOT inlined - #[inline(never)] honoured)")
    println("hot_loop(100) = " + c.to_str() + " (gcc may inline - #[hot] hint)")
    println("cold_path(-1) = " + d.to_str() + " (laid out cold by gcc - #[cold] hint)")
    return 0
}
