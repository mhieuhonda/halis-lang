# conn_machine.hls — Stage 17 (v0.28.0-alpha): a model-checked state
# machine. `hlmodel` enumerates every (state, event) pair and EXECUTES
# the transition function; with --invariant it BFS-checks the
# reachable states.
#
#   python3 tools/hlmodel.py examples/conn_machine.hls --fn step \
#       --invariant all_valid --init Closed

enum ConnState { Closed, Connecting, Open, Failed }
enum ConnEvent { Connect, Connected, Fail, Close }

fn step(s: ConnState, e: ConnEvent) -> ConnState {
    return match s {
        ConnState.Closed => match e {
            ConnEvent.Connect => ConnState.Connecting,
            _ => ConnState.Closed
        },
        ConnState.Connecting => match e {
            ConnEvent.Connected => ConnState.Open,
            ConnEvent.Fail => ConnState.Failed,
            _ => ConnState.Connecting
        },
        ConnState.Open => match e {
            ConnEvent.Close => ConnState.Closed,
            ConnEvent.Fail => ConnState.Failed,
            _ => ConnState.Open
        },
        ConnState.Failed => match e {
            ConnEvent.Connect => ConnState.Connecting,
            _ => ConnState.Failed
        }
    }
}

fn all_valid(s: ConnState) -> bool {
    # Invariant predicate placeholder: every state is acceptable; the
    # interesting property (full reachability, no dead states) is
    # reported by hlmodel's BFS itself.
    return true
}

fn main() -> int uses IO {
    println("run hlmodel on this file (see the header comment)")
    return 0
}
