# io_demo.hls — Stage 35 (v0.54.0-alpha): std.io module demo.
#
# This demo shows the four std.io types:
#   Cursor      — in-memory Read + Write over a `str`
#   BufReader   — buffered file reader (Read only)
#   BufWriter   — buffered file writer (Write only, flush to file)
#   Chain       — concatenate multiple Cursor readers into one Read
#
# It exercises:
#   - read_byte / read_str / read_until / read_line / peek_byte / seek
#   - write_byte / write_str / write_str_at / flush
#   - position / length / remaining / is_eof / rewind
#   - chain reads across cursor boundaries
#   - hex helpers (io_to_hex / io_from_hex)
#   - the line-reader helper (io_read_lines_cursor)
#
# The demo writes to /tmp/halis_io_demo.txt (a known-clean path the
# sandbox does not constrain) so it can run both inside and outside a
# sandbox without configuration.

import "std.io"
import "std.option"
import "std.str"

# ============================================================================
# Section 1: Cursor — the in-memory Read + Write.
# ============================================================================

fn section_cursor() -> int uses IO {
    println("=== Cursor ===")

    # Read API.
    let c: Cursor = cursor_new("Hello, Halis!")
    println("len=" + c.length().to_str())
    println("remaining=" + c.remaining().to_str())

    let b: Option[int] = c.read_byte()
    let bs: str = match b { Option.Some(v) => v.to_str(), Option.None => "none" }
    println("byte0=" + bs)

    let s: str = c.read_str(5)
    println("read_str(5)=" + s)
    println("pos=" + c.position().to_str())
    println("remaining=" + c.remaining().to_str())

    # peek_byte — look ahead without consuming.
    let p: Option[int] = c.peek_byte()
    let ps: str = match p { Option.Some(v) => v.to_str(), Option.None => "none" }
    println("peek=" + ps)

    # read_until — stop at a delimiter, include it in the result.
    let u: Cursor = cursor_new("name=alice;age=30")
    let first: str = u.read_until(59)  # ';'
    println("until ';'=[" + first + "]")
    let second: str = u.read_until(59)
    println("until ';'=[" + second + "]")

    # read_line — strip trailing \n and \r\n (HLS string literals
    # don't support \r escape, so we build the CRLF test with chr(13)).
    let crlf: str = "line1\nline2" + chr(13) + "\nline3"
    let l: Cursor = cursor_new(crlf)
    println("line1=[" + l.read_line() + "]")
    println("line2=[" + l.read_line() + "]")
    println("line3=[" + l.read_line() + "]")

    # seek + rewind — re-read the buffer.
    let r: Cursor = cursor_new("abcdef")
    let _discard: str = r.read_str(3)
    r.rewind()
    println("after_rewind=[" + r.read_str(6) + "]")

    # Write API (append semantics).
    let w: Cursor = cursor_empty()
    w.write_str("hello")
    w.write_str(" ")
    w.write_byte(119)  # 'w'
    w.write_byte(111)  # 'o'
    w.write_byte(114)  # 'r'
    w.write_byte(108)  # 'l'
    w.write_byte(100)  # 'd'
    println("cursor_after_writes=[" + w.buffer() + "]")

    # write_str_at — back-patch a length prefix.
    let pp: Cursor = cursor_empty()
    pp.write_str("00")        # placeholder length
    pp.write_str(":payload")  # body
    pp.write_str_at("12", 0)  # overwrite "00" with "12"
    println("backpatched=[" + pp.buffer() + "]")

    # flush is a no-op for Cursor (provided for trait uniformity).
    w.flush()
    println("after_flush_ok")
    return 0
}

# ============================================================================
# Section 2: BufReader — buffered file reader.
# ============================================================================

fn section_buf_reader() -> int uses IO, Fs {
    println("=== BufReader ===")

    # Write a fixture file using write_file (existing builtin).
    write_file("/tmp/halis_io_demo.txt", "alpha\nbeta\ngamma\ndelta\n")

    let r: BufReader = buf_reader_from_file("/tmp/halis_io_demo.txt")
    println("path=" + r.path())
    println("len=" + r.length().to_str())

    # Read the first line.
    let line1: str = r.read_line()
    println("line1=[" + line1 + "]")

    # Read the next 3 bytes (skipping the \n that read_line didn't consume
    # is automatic — read_line advances past the \n).
    let next3: str = r.read_str(3)
    println("next3=[" + next3 + "]")

    # io_read_lines_bufreader — read all remaining lines in one call.
    let r2: BufReader = buf_reader_from_file("/tmp/halis_io_demo.txt")
    let lines: list[str] = io_read_lines_bufreader(r2)
    println("lines.len=" + lines.len().to_str())
    println("line0=" + lines.get(0))
    println("line1=" + lines.get(1))
    println("line2=" + lines.get(2))
    println("line3=" + lines.get(3))
    return 0
}

# ============================================================================
# Section 3: BufWriter — buffered file writer.
# ============================================================================

fn section_buf_writer() -> int uses IO, Fs {
    println("=== BufWriter ===")

    let w: BufWriter = buf_writer_new("/tmp/halis_io_demo_out.txt")
    println("path=" + w.path())
    println("pending_before=" + w.pending_len().to_str())
    println("flushed_before=" + w.is_flushed().to_str())

    w.write_str("first line\n")
    w.write_str("second line\n")
    w.write_byte(116)  # 't'
    w.write_byte(104)  # 'h'
    w.write_byte(105)  # 'i'
    w.write_byte(114)  # 'r'
    w.write_byte(100)  # 'd'
    w.write_str(" line\n")

    println("pending_after_writes=" + w.pending_len().to_str())
    println("flushed_after_writes=" + w.is_flushed().to_str())

    w.flush()
    println("flushed_after_flush=" + w.is_flushed().to_str())

    # Verify by reading back via BufReader.
    let r: BufReader = buf_reader_from_file("/tmp/halis_io_demo_out.txt")
    let content: str = io_read_all_bufreader(r)
    let expected: str = "first line\nsecond line\nthird line\n"
    if content == expected {
        println("bufwriter_content OK")
    } else {
        println("bufwriter_content FAIL")
        println("got=[" + content + "]")
        println("exp=[" + expected + "]")
        return 1
    }
    return 0
}

# ============================================================================
# Section 4: Chain — concatenate multiple Cursor readers.
# ============================================================================

fn section_chain() -> int uses IO {
    println("=== Chain ===")

    let a: Cursor = cursor_new("AAAA")
    let b: Cursor = cursor_new("BB")
    let c: Cursor = cursor_new("CCCCC")
    let ch: Chain = chain_new([a, b, c])

    println("num_readers=" + ch.num_readers().to_str())
    println("total_len=" + ch.length().to_str())

    # Read 5 bytes — should span the first cursor into the second.
    let first5: str = ch.read_str(5)
    println("read_str(5)=[" + first5 + "]")

    # Read 6 more bytes — should span the second into the third.
    let next6: str = ch.read_str(6)
    println("read_str(6)=[" + next6 + "]")

    # Read the rest — end of chain.
    let rest: str = ch.read_str(100)
    println("rest=[" + rest + "]")

    let after: str = ch.read_str(10)
    println("after_eof=[" + after + "]")
    println("is_eof=" + ch.is_eof().to_str())

    # read_until across boundary.
    let x: Cursor = cursor_new("xx")
    let y: Cursor = cursor_new("yy\n")
    let ch2: Chain = chain_new([x, y])
    let u: str = ch2.read_until(10)  # '\n'
    println("until_newline=[" + u + "]")
    return 0
}

# ============================================================================
# Section 5: hex helpers — common I/O-adjacent operation.
# ============================================================================

fn section_hex() -> int uses IO {
    println("=== Hex ===")

    # Encode.
    let h1: str = io_to_hex(cursor_new(""))
    println("hex('')=[" + h1 + "]")
    let h2: str = io_to_hex(cursor_new("Hi"))
    println("hex('Hi')=[" + h2 + "]")
    let h3: str = io_to_hex(cursor_new(chr(255) + chr(254)))
    println("hex(bytes)=[" + h3 + "]")

    # Round-trip: encode then decode.
    let original: Cursor = cursor_new("Hello, Halis!")
    let encoded: str = io_to_hex(original)
    let decoded: Cursor = io_from_hex(encoded)
    let back: str = decoded.buffer()
    if back == "Hello, Halis!" {
        println("hex_round_trip OK")
    } else {
        println("hex_round_trip FAIL")
        return 1
    }

    # Read the first 4 bytes of "Hello..." as hex.
    let cur: Cursor = cursor_new("Hello, Halis!")
    let first4: str = cur.read_str(4)
    let hex_first4: str = io_to_hex(cursor_new(first4))
    println("hex_first4=[" + hex_first4 + "]")
    return 0
}

# ============================================================================
# Section 6: Integration — a small "build a CSV" pipeline using every type.
# ============================================================================

fn section_pipeline() -> int uses IO, Fs {
    println("=== Pipeline ===")

    # Source data: a list of (name, value) pairs.
    let names: list[str] = ["alice", "bob", "carol"]
    let values: list[int] = [10, 20, 30]

    # Use a BufWriter to build a CSV file.
    let w: BufWriter = buf_writer_new("/tmp/halis_io_demo_pipe.csv")
    w.write_str("name,value\n")
    let mut i: int = 0
    while i < names.len() {
        w.write_str(names.get(i))
        w.write_str(",")
        w.write_str(values.get(i).to_str())
        w.write_str("\n")
        i = i + 1
    }
    w.flush()

    # Read it back with a BufReader and parse the lines.
    let r: BufReader = buf_reader_from_file("/tmp/halis_io_demo_pipe.csv")
    let lines: list[str] = io_read_lines_bufreader(r)
    println("csv_lines=" + lines.len().to_str())
    let mut j: int = 0
    while j < lines.len() {
        println("  line " + j.to_str() + "=[" + lines.get(j) + "]")
        j = j + 1
    }

    # Use a Cursor to parse one line in memory.
    let sample: Cursor = cursor_new("alice,10")
    let name: str = sample.read_until(44)  # ','
    # Strip the trailing comma (read_until includes the delimiter).
    let name_only: str = name.slice(0, name.len() - 1)
    let value: str = io_read_all_cursor(sample)
    println("parsed_name=[" + name_only + "]")
    println("parsed_value=[" + value + "]")
    return 0
}

fn main() -> int uses IO, Fs {
    if section_cursor() != 0 { return 1 }
    if section_buf_reader() != 0 { return 2 }
    if section_buf_writer() != 0 { return 3 }
    if section_chain() != 0 { return 4 }
    if section_hex() != 0 { return 5 }
    if section_pipeline() != 0 { return 6 }
    println("ALL IO TESTS PASSED")
    return 0
}
