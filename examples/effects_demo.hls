# Quick sanity test: fine-grained effects
fn read_config(path: str) -> str uses Fs {
    return read_file(path)
}

fn elapsed_ms() -> int uses Clock {
    return clock_ms()
}

fn program_args() -> list[str] uses Args {
    return args()
}

fn pure_compute(n: int) -> int {
    # No uses clause — pure by default
    let mut s: int = 0
    let mut i: int = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    return s
}

fn main() -> int uses IO {
    # IO blanket grants all five effects
    let n: int = pure_compute(10)
    println("sum(0..10) = " + n.to_str())
    let ms: int = elapsed_ms()
    println("clock_ms = " + ms.to_str())
    let a: list[str] = program_args()
    println("argc = " + a.len().to_str())
    return 0
}
