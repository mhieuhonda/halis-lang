# ============================================================================
# examples/freestanding_demo.hls — Stage 77 (v0.96.0-alpha)
# ----------------------------------------------------------------------------
# A `#![freestanding]` kernel-style program: no libc, no OS calls, no
# std — pure computation only, entered via `_start`.
#
# Build (on a hosted Linux toolchain):
#   bin/hlc examples/freestanding_demo.hls /tmp/fs_demo.c
#   gcc -O2 -ffreestanding -nostdlib -ffunction-sections \
#       -fno-stack-protector -Wl,--gc-sections \
#       -o /tmp/fs_demo /tmp/fs_demo.c
#   /tmp/fs_demo; echo "exit=$?"
#
# NOTE ON THE SUBSET: freestanding code must be pure (no `uses`), may
# not import `std.*` or declare `extern` blocks, and may not use the
# float library (libm), str<->float conversions, or float %.
# Everything else — ints, bools, strings, lists, maps, structs,
# enums, generics, match, `?`, clone — works, backed by the 1 MiB
# static bump arena (reclamation arrives with `core.alloc`, Stage 79).
# ============================================================================

#![freestanding]

enum OptionInt {
    SomeInt(int),
    NoneInt
}

struct Point {
    x: int,
    y: int
}

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn fact(n: int) -> int {
    let mut acc: int = 1
    let mut i: int = 2
    while i <= n {
        acc = acc * i
        i = i + 1
    }
    return acc
}

fn lookup_or(xs: list[int], i: int, dflt: int) -> int {
    if i < 0 || i >= xs.len() {
        return dflt
    }
    return xs.get(i)
}

fn point_sum(p: Point) -> int {
    return p.x + p.y
}

fn first_positive(xs: list[int]) -> OptionInt {
    let mut i: int = 0
    while i < xs.len() {
        if xs.get(i) > 0 {
            return OptionInt.SomeInt(xs.get(i))
        }
        i = i + 1
    }
    return OptionInt.NoneInt
}

fn main() -> int {
    # Pure integer work: the exit code is the computed checksum.
    let f10: int = fib(10)
    let f5: int = fact(5)
    let xs: list[int] = [3, 1, 4, 1, 5]
    let a: int = lookup_or(xs, 2, 0)
    let b: int = lookup_or(xs, 99, 7)
    let p: Point = Point {
        x: 20, y: 22
    }
    let ps: int = point_sum(p)
    let fp: int = match first_positive(xs) {
        OptionInt.SomeInt(v) => v,
        OptionInt.NoneInt => 0
    }
    # 55 + 120 + 4 + 7 + 42 + 3 = 231
    return f10 + f5 + a + b + ps + fp
}
