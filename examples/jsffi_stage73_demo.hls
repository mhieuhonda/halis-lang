# examples/jsffi_stage73_demo.hls — Stage 73 (v0.92.0-alpha):
# std.jsffi — JavaScript FFI for the WebAssembly target.
#
# Exercises:
#   - the expanded extern "js" surface (console extras, JSON bridge,
#     URL encoding, environment info, performance timing)
#   - AUTO struct marshalling: the structs below are DECLARED but
#     never constructed here — the wasm emitter exports
#     hl_struct_descriptors() and the JS glue registers every one of
#     them at instantiation ("a Halis struct becomes a JS object"
#     with zero manual setup)
#   - JS -> HLS callbacks: jsffi_on_callback is detected by hlwasm
#     and exported as hl_call_halis; the JS side reaches it through
#     Halis.callHalis(cbId, json)
#
# NOTE ON THE SUBSET: the freestanding wasm emitter (Stage 24) lowers
# let / if / while / for-range / calls / literals — struct literals,
# match, and method calls land with the HLIR emitter, so this demo
# stays inside the supported subset (int_to_str & friends instead of
# .to_str(), manual substring search instead of str.contains).
#
# Build + run:
#   python3 tools/hlwasm.py examples/jsffi_stage73_demo.hls \
#       /tmp/jsffi73 --run

import "std.jsffi"

# ----------------------------------------------------------------------------
# Structs — declared for the AUTO-MARSHALLING descriptors. The wasm
# ABI passes them as i32 pointers; the layouts (field offsets) are
# computed by the emitter and shipped to the JS glue through
# hl_struct_descriptors(), so Halis.readStruct / Halis.writeStruct
# work for both WITHOUT any manual Halis.registerStruct call.
# ----------------------------------------------------------------------------

struct Point {
    x: float,
    y: float,
    tag: str,
    active: bool,
    count: int
}

struct Measurement {
    id: int,
    label: str,
    value: float,
    ok: bool
}

# ----------------------------------------------------------------------------
# JS -> HLS callback dispatch (the handler_id pattern — HLS has no
# function pointers, so the callback handler if/else chains on cb_id).
# ----------------------------------------------------------------------------

fn JSFFI_CB_ECHO() -> int { return 1 }
fn JSFFI_CB_PING() -> int { return 2 }

# contains_sub(hay, needle) — substring search inside the wasm-subset
# (no method calls on the wasm32 target).
fn contains_sub(hay: str, needle: str) -> bool {
    let n: int = hay.len()
    let m: int = needle.len()
    if m > n {
        return false
    }
    let mut i: int = 0
    while i <= n - m {
        let mut same: bool = true
        let mut j: int = 0
        while j < m {
            if hay.byte_at(i + j) != needle.byte_at(j) {
                same = false
            }
            j = j + 1
        }
        if same {
            return true
        }
        i = i + 1
    }
    return false
}

# jsffi_on_callback — THE JS -> HLS ENTRY POINT. hlwasm detects this
# exact signature and exports hl_call_halis; the JS glue's
# Halis.callHalis(cbId, json) lands here.
fn jsffi_on_callback(cb_id: int, arg: str) -> str uses IO {
    if cb_id == JSFFI_CB_ECHO() {
        # Echo the payload back inside an acknowledgement envelope.
        return "{\"received\":true,\"cb\":1,\"echo\":" + arg + "}"
    }
    if cb_id == JSFFI_CB_PING() {
        if contains_sub(arg, "ping") {
            return "pong"
        }
        return "unknown-cmd"
    }
    return "{}"
}

# ----------------------------------------------------------------------------
# main — prints markers the acceptance test greps for.
# ----------------------------------------------------------------------------

fn main() -> int uses IO {
    println("=== Halis jsffi — Stage 73 (v0.92.0-alpha) ===")

    # Console (the basics plus the Stage 73 extras).
    js_console_log("hello from wasm via js_console_log")
    js_console_warn("a warning from Halis")
    js_console_error("an error from Halis")
    js_console_table("[{\"lang\":\"Halis\",\"stage\":73}]")
    let hits: int = js_console_count("hits")
    let hits2: int = js_console_count("hits")
    println("console count: " + hits.to_str() + " then "
        + hits2.to_str())
    js_console_count_reset("hits")
    let hits3: int = js_console_count("hits")
    println("count after reset: " + hits3.to_str())
    js_console_time("demo")
    js_console_time_end("demo")

    # JSON bridge.
    let canonical: str = js_json_canonical("{\"b\":2,\"a\":1}")
    println("canonical json: " + canonical)
    let valid: bool = js_json_valid("{\"ok\":true}")
    let invalid: bool = js_json_valid("{not json")
    println("json valid/invalid: " + valid.to_str() + "/"
        + invalid.to_str())

    # URL encoding.
    println("url encoded: " + js_url_encode("a b&c=d"))
    println("url decoded: " + js_url_decode("a%20b%26c%3Dd"))

    # Environment info (Node.js defaults where the API is absent).
    println("platform: " + js_platform_name())
    println("language: " + js_language())
    println("online: " + js_online().to_str())

    # Performance timing.
    let t0: float = js_performance_now()
    let mut spin: int = 0
    while spin < 1000 {
        spin = spin + 1
    }
    let t1: float = js_performance_now()
    let elapsed: float = t1 - t0
    println("perf loop elapsed (ms): " + elapsed.to_str())

    # Random + math.
    let r: float = js_random()
    println("random in [0,1): " + (r >= 0.0 && r < 1.0).to_str())

    # Monotonic + wall-clock time.
    let now: int = js_now_ms()
    println("now_ms is positive: " + (now > 0).to_str())
    let iso: str = js_date_now_iso()
    println("iso timestamp shape: " + iso)

    # localStorage (absent in Node: the defaults degrade cleanly).
    println("localstorage keys (node default): "
        + js_localstorage_key_count().to_str())

    # The callback protocol (the JsffiCallback table helper in
    # std.jsffi renders this on the native/C backend; the wasm subset
    # has no list literals yet, so the demo prints the protocol
    # directly).
    println("--- callback protocol ---")
    println("cb_id " + JSFFI_CB_ECHO().to_str() + " (echo): "
        + "receives {..}; returns {received:true, echo:{..}}")
    println("cb_id " + JSFFI_CB_PING().to_str() + " (ping): "
        + "receives any string containing 'ping'; returns 'pong'")

    # The structs declared above are marshalled on the JS side (the
    # acceptance test round-trips Point through
    # Halis.writeStruct/readStruct with NO manual registration).
    println("struct descriptors exported: true")
    println("=== jsffi demo done ===")
    return 0
}
