# examples/collections_demo.hls — Stage 44 (v0.63.0-alpha): std.collections
#
# Demonstrates the five collection types in std.collections:
#   - BTreeMap (ordered map with O(log n) lookup)
#   - HashSet (set with union/intersect/diff)
#   - LinkedList (doubly-linked, O(1) push/pop both ends)
#   - RingBuf (fixed-capacity circular buffer)
#   - HashMap (general map with non-str keys)
#
# All output is deterministic — no I/O beyond println. The
# differential test (interpreter == native) is byte-exact.

import "std.collections"
import "std.str"
import "std.option"

fn main() -> int uses IO {
    println("=== Stage 44: std.collections ===")
    println("")

    # --- BTreeMap -------------------------------------------------------
    println("--- BTreeMap (ordered, O(log n) lookup) ---")
    let m: BTreeMapIntStr = btreemap_int_str_new()
    btreemap_int_str_set(m, 3, "three")
    btreemap_int_str_set(m, 1, "one")
    btreemap_int_str_set(m, 2, "two")
    btreemap_int_str_set(m, 5, "five")
    btreemap_int_str_set(m, 4, "four")
    println("  size = " + btreemap_int_str_size(m).to_str())
    println("  min = " + option_unwrap(btreemap_int_str_min(m)).to_str())
    println("  max = " + option_unwrap(btreemap_int_str_max(m)).to_str())
    # Keys are sorted
    let keys: list[int] = btreemap_int_str_keys(m)
    let mut i: int = 0
    let mut keys_str: str = "  keys = ["
    while i < keys.len() {
        if i > 0 {
            keys_str = keys_str + ", "
        }
        keys_str = keys_str + keys.get(i).to_str()
        i = i + 1
    }
    keys_str = keys_str + "]"
    println(keys_str)
    # Remove a key
    btreemap_int_str_remove(m, 3)
    println("  after remove(3), size = " + btreemap_int_str_size(m).to_str())
    println("  has 3 = " + btreemap_int_str_has(m, 3).to_str())
    println("  has 4 = " + btreemap_int_str_has(m, 4).to_str())
    println("")

    # --- HashSet --------------------------------------------------------
    println("--- HashSet (union / intersect / diff) ---")
    let a: HashSetInt = hashset_int_new()
    hashset_int_add(a, 1)
    hashset_int_add(a, 2)
    hashset_int_add(a, 3)
    hashset_int_add(a, 4)
    let b: HashSetInt = hashset_int_new()
    hashset_int_add(b, 3)
    hashset_int_add(b, 4)
    hashset_int_add(b, 5)
    hashset_int_add(b, 6)
    println("  set A size = " + hashset_int_size(a).to_str())
    println("  set B size = " + hashset_int_size(b).to_str())
    let u: HashSetInt = hashset_int_union(a, b)
    println("  A union B size = " + hashset_int_size(u).to_str())
    let inter: HashSetInt = hashset_int_intersect(a, b)
    println("  A intersect B size = " + hashset_int_size(inter).to_str())
    let diff: HashSetInt = hashset_int_diff(a, b)
    println("  A diff B size = " + hashset_int_size(diff).to_str())
    println("")

    # --- LinkedList -----------------------------------------------------
    println("--- LinkedList (O(1) push/pop both ends) ---")
    let ll: LinkedListInt = linkedlist_int_new()
    linkedlist_int_push_back(ll, 2)
    linkedlist_int_push_back(ll, 3)
    linkedlist_int_push_front(ll, 1)
    linkedlist_int_push_back(ll, 4)
    linkedlist_int_push_front(ll, 0)
    println("  len = " + linkedlist_int_len(ll).to_str())
    let ll_list: list[int] = linkedlist_int_to_list(ll)
    let mut j: int = 0
    let mut ll_str: str = "  list = ["
    while j < ll_list.len() {
        if j > 0 {
            ll_str = ll_str + ", "
        }
        ll_str = ll_str + ll_list.get(j).to_str()
        j = j + 1
    }
    ll_str = ll_str + "]"
    println(ll_str)
    let popped: Option[int] = linkedlist_int_pop_front(ll)
    println("  pop_front = " + option_unwrap(popped).to_str())
    let popped2: Option[int] = linkedlist_int_pop_back(ll)
    println("  pop_back = " + option_unwrap(popped2).to_str())
    println("  len after pops = " + linkedlist_int_len(ll).to_str())
    println("")

    # --- RingBuf --------------------------------------------------------
    println("--- RingBuf (fixed-capacity circular buffer) ---")
    let rb: RingBufInt = ringbuf_int_new(3)
    ringbuf_int_push_overwrite(rb, 10)
    ringbuf_int_push_overwrite(rb, 20)
    ringbuf_int_push_overwrite(rb, 30)
    println("  after 3 pushes, len = " + ringbuf_int_len(rb).to_str())
    # Push past capacity — overwrites oldest
    ringbuf_int_push_overwrite(rb, 40)
    println("  after overwrite push, len = " + ringbuf_int_len(rb).to_str())
    println("  front = " + option_unwrap(ringbuf_int_peek_front(rb)).to_str())
    let rb_list: list[int] = ringbuf_int_to_list(rb)
    let mut k: int = 0
    let mut rb_str: str = "  contents = ["
    while k < rb_list.len() {
        if k > 0 {
            rb_str = rb_str + ", "
        }
        rb_str = rb_str + rb_list.get(k).to_str()
        k = k + 1
    }
    rb_str = rb_str + "]"
    println(rb_str)
    # Non-overwriting push returns false when full
    let ok: bool = ringbuf_int_push(rb, 999)
    println("  push when full returns false = " + (!ok).to_str())
    println("")

    # --- HashMap --------------------------------------------------------
    println("--- HashMap (non-str keys via SipHash) ---")
    let hm: HashMapIntStr = hashmap_int_str_new()
    hashmap_int_str_set(hm, 42, "answer")
    hashmap_int_str_set(hm, 100, "hundred")
    hashmap_int_str_set(hm, 1000, "thousand")
    println("  size = " + hashmap_int_str_size(hm).to_str())
    let v42: Option[str] = hashmap_int_str_get(hm, 42)
    println("  hm[42] = " + option_unwrap(v42))
    println("  has 100 = " + hashmap_int_str_has(hm, 100).to_str())
    println("  has 999 = " + hashmap_int_str_has(hm, 999).to_str())
    # Update existing key
    hashmap_int_str_set(hm, 42, "the answer")
    let v42b: Option[str] = hashmap_int_str_get(hm, 42)
    println("  hm[42] after update = " + option_unwrap(v42b))
    println("  size after update = " + hashmap_int_str_size(hm).to_str())
    println("")

    println("=== Stage 44 demo complete ===")
    return 0
}
