import "std.str"
import "std.math"
import "std.json"
import "std.url"
import "std.html"

# web_demo.hls — Demonstrate Hieu Louis as a web programming language.
# Shows URL parsing, JSON handling, and HTML escaping — the building blocks
# of a server-side web application.

fn main() -> int uses IO {
    println("=== URL Parsing ===")
    let u: Url = url_parse("https://user:pass@example.com:8443/api/v1?q=hello&page=2#frag")
    println("scheme:   " + u.scheme)
    println("user:     " + u.user)
    println("password: " + u.password)
    println("host:     " + u.host)
    println("port:     " + u.port.to_str())
    println("path:     " + u.path)
    println("query:    " + u.query)
    println("fragment: " + u.fragment)
    println("rebuilt:  " + url_stringify(u))

    println("")
    println("=== Query String ===")
    let qs: str = "name=Hieu+Louis&lang=HLS&ver=2"
    let q: map[str, str] = url_query_parse(qs)
    let keys: list[str] = q.keys()
    let mut i: int = 0
    while i < keys.len() {
        println("  " + keys.get(i) + " = " + q.get_or(keys.get(i), ""))
        i = i + 1
    }
    let m: map[str, str] = map_new()
    m.set("a", "1")
    m.set("b", "hello world")
    m.set("c", "100%")
    println("rebuilt: " + url_query_stringify(m))

    println("")
    println("=== URL Encoding ===")
    println("encode 'hello world': " + url_encode("hello world"))
    println("encode 'a/b?c=d&e': " + url_encode("a/b?c=d&e"))
    println("decode 'hello%20world': " + url_decode("hello%20world"))
    println("decode 'a+b': " + url_decode("a+b"))

    println("")
    println("=== HTML Escaping ===")
    println("escape:    " + html_escape("<script>alert('xss')</script>"))
    println("unescape:  " + html_unescape("&lt;script&gt;alert(&#39;xss&#39;)&lt;/script&gt;"))
    let attrs: map[str, str] = map_new()
    attrs.set("class", "btn")
    attrs.set("href", "/search?q=<script>")
    println("tag:       " + html_tag("a", attrs, "Click me"))

    println("")
    println("=== JSON (web API response) ===")
    let api_src: str = "{\"user\":{\"id\":42,\"name\":\"Hieu Louis\"},\"posts\":[{\"id\":1,\"title\":\"Hello\"},{\"id\":2,\"title\":\"World\"}],\"ok\":true}"
    let api: JsonValue = json_parse(api_src)
    let user: JsonValue = json_object_get(api, "user")
    println("user.id   = " + json_object_get(user, "id").ival.to_str())
    println("user.name = " + json_object_get(user, "name").sval)
    let posts: JsonValue = json_object_get(api, "posts")
    println("posts.len = " + posts.arr.len().to_str())
    let mut p: int = 0
    while p < posts.arr.len() {
        let post: JsonValue = posts.arr.get(p)
        let title: JsonValue = json_object_get(post, "title")
        println("  post[" + p.to_str() + "].title = " + title.sval)
        p = p + 1
    }

    println("")
    println("=== Build a JSON response ===")
    let r_keys: list[str] = ["status", "code", "msg"]
    let r_vals: list[JsonValue] = [json_str("ok"), json_int(200), json_str("Hello from HLS!")]
    let r: JsonValue = json_object(r_keys, r_vals)
    println("response: " + json_stringify(r))

    println("")
    println("=== Render an HTML list from JSON data ===")
    # Imagine we received this JSON from an API
    let users_src: str = "[{\"name\":\"Alice\"},{\"name\":\"Bob\"},{\"name\":\"Charlie\"}]"
    let users: JsonValue = json_parse(users_src)
    println("<ul>")
    let mut u_i: int = 0
    while u_i < users.arr.len() {
        let user_obj: JsonValue = users.arr.get(u_i)
        let name: JsonValue = json_object_get(user_obj, "name")
        let li_attrs: map[str, str] = map_new()
        println("  " + html_tag("li", li_attrs, name.sval))
        u_i = u_i + 1
    }
    println("</ul>")

    return 0
}
