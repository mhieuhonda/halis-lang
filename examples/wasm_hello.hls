# ============================================================
# wasm_hello.hls — WebAssembly target demo (Stage 23)
# ============================================================
# Compiles to a <10 KB .wasm binary that runs in any browser
# or Node.js. Demonstrates:
#   - string literals + concatenation
#   - integer arithmetic + int_to_str
#   - function calls + recursion (fib)
#   - for-range loops
#   - extern "js" FFI (via std.jsffi)
#
# Build:
#   python3 tools/hlwasm.py examples/wasm_hello.hls /tmp/wasm_hello
#   open /tmp/wasm_hello.html   # in a browser
#
# Or run in Node.js:
#   python3 tools/hlwasm.py examples/wasm_hello.hls /tmp/wasm_hello --run
# ============================================================

import "std.jsffi"

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() -> int uses IO {
    # Print to the Halis console (the JS glue captures this).
    println("=== Halis WebAssembly Demo (Stage 23) ===")
    println("")

    # String concatenation + int_to_str
    println("fib(20) = " + fib(20).to_str())
    println("fib(30) = " + fib(30).to_str())

    # for-range loop
    let mut sum: int = 0
    for i: int in range(1, 11) {
        sum = sum + i
    }
    println("sum(1..10) = " + sum.to_str())

    # Call into JavaScript via std.jsffi
    js_console_log("This message came from Halis via js_console_log!")
    js_console_warn("This is a warning from Halis.")

    # Get a random number from JS
    let r: int = js_random_int(100)
    println("js_random_int(100) = " + r.to_str())

    println("")
    println("WebAssembly binary size: see the .wasm file (< 10 KB)")
    return 0
}
