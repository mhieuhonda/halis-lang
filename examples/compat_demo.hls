# compat_demo.hls — Stage 128 (v0.146.0-alpha): hls-compat, the
# backwards-compatibility test suite over every prior ok corpus.
#
# The tool censuses every release tag in the repository, replays each
# release's acceptance corpus against today's toolchain, and diffs
# the failures against a ledger of sanctioned breaks. This demo is
# the engine in miniature — the census arithmetic, the verdict
# lattice and the ledger law, run on a toy history of three releases
# so the numbers are small enough to check by hand:
#
#   python3 tools/hls-compat.py
#   python3 tools/hls-compat.py --native
#   python3 tools/hls-compat.py --time-travel
#   python3 tools/hls-compat.py --discover
#
# The demo's own claim is the one the suite makes about every
# program: this file compiles and runs green on today's toolchain,
# and the day it is cut into a release it joins the corpus the next
# release will have to keep green — compatibility is a promise made
# forward, about code written in the past.

import "std.str"

# The census: three releases' corpora, as (file, content) pairs. A
# fixture that never changed between releases is the SAME program —
# the census keys on content, so 7 instances collapse to 4 programs.
# The counts below are the real numbers the toy history produces:
# v1 ships 3, v2 ships 3 (one grown, one unchanged, one new), v3
# ships 1 (the new file, unchanged since v2).
fn census_size(instances: int, programs: int) -> bool {
    return instances >= programs && programs > 0
}

# The verdict lattice: exit 0 is green, exit 101 is the
# expected-panic convention, a failure the ledger names is waived,
# a failure it does not name is the regression the suite exists to
# catch, and a ledgered program that runs green again is reconciled —
# the entry is stale and must be trimmed.
fn classify(exit: int, in_ledger: bool) -> str {
    if exit == 0 {
        if in_ledger {
            return "RECONCILED"
        }
        return "COMPATIBLE"
    }
    if exit == 101 {
        if in_ledger {
            return "RECONCILED"
        }
        return "COMPATIBLE-PANIC"
    }
    if in_ledger {
        return "WAIVED"
    }
    return "REGRESSION"
}

# The ledger law, both directions at once: every failure faces an
# entry, every entry faces a failure. One side short in either
# direction is the tool's loudest finding.
fn ledger_faces(failures: int, entries: int) -> bool {
    return failures == entries && failures > 0
}

# The time-travel law: a program green under its own release and
# green today agrees; old-green to new-failed is the one sanctioned
# disagreement, and only a ledger entry may carry it. Any other
# combination — a waiver on a green program, a release that shipped
# its own corpus red — is a lie the witness exists to catch.
fn travel_ok(old_green: bool, new_green: bool, waived: bool) -> bool {
    if old_green && new_green {
        return !waived
    }
    if old_green && !new_green {
        return waived
    }
    return false
}

fn main() -> int uses IO {
    let mut checks: int = 0

    # The census: 7 instances across three releases, 4 distinct
    # programs (arith unchanged three times, match grown once,
    # import and section new). The dedup factor is what makes the
    # whole history replayable per commit: 7 over 4 here, 24591 over
    # 326 in the real repository.
    if !census_size(7, 4) {
        panic("7 instances must census to 4 programs")
    }
    if census_size(4, 7) {
        panic("programs cannot exceed instances")
    }
    checks = checks + 1

    # The lattice: every road through classify, including the one the
    # suite never wants to see printed about a real corpus.
    if classify(0, false) != "COMPATIBLE" {
        panic("exit 0 is COMPATIBLE")
    }
    if classify(101, false) != "COMPATIBLE-PANIC" {
        panic("exit 101 is the expected-panic convention")
    }
    if classify(1, true) != "WAIVED" {
        panic("a named failure is WAIVED")
    }
    if classify(1, false) != "REGRESSION" {
        panic("an unnamed failure is REGRESSION")
    }
    if classify(0, true) != "RECONCILED" {
        panic("a ledgered green program is RECONCILED")
    }
    checks = checks + 1

    # The ledger: the toy history has one sanctioned break (the
    # import guard, say) and one ledger entry naming it. Faces exact.
    if !ledger_faces(1, 1) {
        panic("one failure faces one entry")
    }
    if ledger_faces(1, 2) {
        panic("an entry without a failure is stale")
    }
    if ledger_faces(2, 1) {
        panic("a failure without an entry is a regression")
    }
    checks = checks + 1

    # The time-travel witness: agreement, the sanctioned break, and
    # the two lies.
    if !travel_ok(true, true, false) {
        panic("green then, green now: agreement")
    }
    if !travel_ok(true, false, true) {
        panic("green then, failed now: the waiver's one sanction")
    }
    if travel_ok(true, true, true) {
        panic("a waiver on a green program lies")
    }
    if travel_ok(false, true, false) {
        panic("a red release is not agreement")
    }
    checks = checks + 1

    if checks != 4 {
        panic("expected 4 checks, ran " + checks.to_str())
    }
    println("compat census: 7 instances -> 4 programs (dedup 1.75x)")
    println("compat lattice: 5 verdicts; ledger: 1 waiver, faces exact")
    println("compat travel: old-green/new-green agrees, the break is named")
    println("checks passed: " + checks.to_str())
    return 0
}
