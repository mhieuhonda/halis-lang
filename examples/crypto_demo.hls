import "std.crypto"
import "std.hex"

fn main() -> int uses IO {
    println("=== FNV-1a 32-bit ===")
    println("empty:    " + crypto_fnv1a_32("").to_str())
    println("a:        " + crypto_fnv1a_32("a").to_str())
    println("foobar:   " + crypto_fnv1a_32("foobar").to_str())
    println("Hieu Louis: " + crypto_fnv1a_32("Hieu Louis").to_str())

    println("")
    println("=== FNV-1a 64-bit ===")
    println("empty:    " + crypto_fnv1a_64_hex(""))
    println("a:        " + crypto_fnv1a_64_hex("a"))
    println("foobar:   " + crypto_fnv1a_64_hex("foobar"))
    println("Hieu Louis: " + crypto_fnv1a_64_hex("Hieu Louis"))

    println("")
    println("=== djb2 ===")
    println("empty:    " + crypto_djb2("").to_str())
    println("Hello:    " + crypto_djb2("Hello").to_str())
    println("Hieu Louis: " + crypto_djb2("Hieu Louis").to_str())

    println("")
    println("=== sdbm ===")
    println("empty:    " + crypto_sdbm("").to_str())
    println("Hello:    " + crypto_sdbm("Hello").to_str())
    println("Hieu Louis: " + crypto_sdbm("Hieu Louis").to_str())

    println("")
    println("=== CRC-32 ===")
    println("empty:        " + crypto_crc32_hex(""))
    println("123456789:    " + crypto_crc32_hex("123456789") + "  (expect cbf43926)")
    println("Hello, World:  " + crypto_crc32_hex("Hello, World!"))

    println("")
    println("=== XOR demo ===")
    let a: str = "Hello"
    let b: str = "World"
    let x: str = crypto_xor(a, b)
    println("a:        " + hex_encode(a))
    println("b:        " + hex_encode(b))
    println("a XOR b:  " + hex_encode(x))
    let recovered: str = crypto_xor(x, b)
    println("recover:  " + recovered)
    return 0
}
