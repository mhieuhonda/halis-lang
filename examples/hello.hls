# ============================================================
# hello.hls — Your first program in Halis
# ============================================================

fn greet(name: str) -> str {
    return "Hello, " + name + "!"
}

fn main() -> int uses IO {
    println(greet("Halis"))
    println("A high-security programming language, compiled native.")
    println("Compiled by a compiler written in HLS itself.")
    return 0
}
