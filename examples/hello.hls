# ============================================================
# hello.hls — Chương trình đầu tiên của bạn bằng Hieu Louis
# ============================================================

fn chao(ten: str) -> str {
    return "Xin chao, " + ten + "!"
}

fn main() -> int uses IO {
    println(chao("Hieu Louis"))
    println("Ngon ngu lap trinh bao mat cao, bien dich native.")
    println("Bien dich boi trinh bien dich viet bang chinh HLS.")
    return 0
}
