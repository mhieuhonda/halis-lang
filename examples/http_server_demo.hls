# examples/http_server_demo.hls — Stage 64 (v0.83.0-alpha):
# std.http_server demo.
#
# This demo exercises every pure piece of std.http_server:
#   - HttpServerConfig builder (defaults + every override)
#   - http_server_describe_config (human-readable rendering)
#   - http_server_is_http2_preface (HTTP/2 connection-preface detection)
#   - http_server_should_keep_alive (HTTP/1.0/1.1 keep-alive decision)
#   - http_server_route_request (Router + user's dispatch wrapper)
#   - http_server_request_shutdown + http_server_is_shutting_down (graceful shutdown flag)
#   - http_server_inflight_begin/end/get (inflight counter mechanics)
#   - http_server_wait_inflight (drain wait)
#
# The demo is PURE (no actual port bind) so the differential test
# (interpreter == native) produces byte-identical output. The actual
# serve loop (http_server_serve) is exercised in the manual test
# (run `bin/hlc examples/http_server_demo.hls /tmp/srv.c && gcc ...
# && /tmp/srv --serve` to start a real server on 127.0.0.1:8080 —
# then curl http://127.0.0.1:8080/ and press Enter to stop).
#
# The demo's structure mirrors examples/http_router_demo.hls: a small
# REST API router + a dispatch function + a sequence of demo_*
# functions that print their output.

import "std.http_server"
import "std.http"
import "std.http_router"
import "std.str"

# ----------------------------------------------------------------------------
# Build the demo router — a small REST API.
# ----------------------------------------------------------------------------

fn build_demo_router() -> Router {
    return router_new()
        .get("/", 1)                    # GET /
        .get("/users", 2)               # GET /users
        .post("/users", 3)              # POST /users
        .get("/users/:id", 4)           # GET /users/:id
        .put("/users/:id", 5)           # PUT /users/:id
        .delete("/users/:id", 6)       # DELETE /users/:id
        .get("/healthz", 7)            # GET /healthz (liveness probe)
}

# ----------------------------------------------------------------------------
# demo_dispatch_handler — the demo's request dispatcher. Maps
# RouterMatch.handler_id to an actual HttpResponse. This is NOT
# an override of the stdlib's http_server_dispatch (cross-module
# duplicate-function check forbids that) — it's a regular function
# the demo calls directly after router_match.
# ----------------------------------------------------------------------------

fn demo_dispatch_handler(m: RouterMatch, request: HttpRequest) -> HttpResponse uses IO {
    if m.handler_id == 1 {
        return http_html_response(200, "<h1>Welcome</h1><p>Try <a href=\"/users\">/users</a> or <a href=\"/healthz\">/healthz</a>.</p>")
    }
    if m.handler_id == 2 {
        return http_json_response(200, "[{\"id\":1,\"name\":\"alice\"},{\"id\":2,\"name\":\"bob\"}]")
    }
    if m.handler_id == 3 {
        return http_json_response(201, "{\"id\":3,\"name\":\"new\"}")
    }
    if m.handler_id == 4 {
        let id: str = m.params.get_or("id", "")
        return http_json_response(200, "{\"id\":" + id + ",\"name\":\"user" + id + "\"}")
    }
    if m.handler_id == 5 {
        return http_text_response(200, "updated")
    }
    if m.handler_id == 6 {
        return http_text_response(200, "deleted")
    }
    if m.handler_id == 7 {
        return http_text_response(200, "ok")
    }
    return http_text_response(404, "not found")
}

# ----------------------------------------------------------------------------
# Demo 1 — config builder + describe.
# ----------------------------------------------------------------------------

fn demo_config_defaults() -> void uses IO {
    let c: HttpServerConfig = http_server_config_new()
    println("--- Default config ---")
    println(http_server_describe_config(c))
}

fn demo_config_overrides() -> void uses IO {
    let c: HttpServerConfig = build_production_config()
    println("--- Production config (overrides) ---")
    println(http_server_describe_config(c))
}

# build_production_config — apply every override in sequence (HLS
# doesn't have a |> pipe operator; chain the builder calls via
# explicit let bindings). This mirrors the pattern in
# examples/config_demo.hls's config builder usage.
fn build_production_config() -> HttpServerConfig {
    let c0: HttpServerConfig = http_server_config_new()
    let c1: HttpServerConfig = http_server_config_host(c0, "0.0.0.0")
    let c2: HttpServerConfig = http_server_config_port(c1, 3000)
    let c3: HttpServerConfig = http_server_config_workers(c2, 8)
    let c4: HttpServerConfig = http_server_config_backlog(c3, 1024)
    let c5: HttpServerConfig = http_server_config_keep_alive_max(c4, 1000)
    let c6: HttpServerConfig = http_server_config_keep_alive_timeout_ms(c5, 30000)
    let c7: HttpServerConfig = http_server_config_read_timeout_ms(c6, 60000)
    let c8: HttpServerConfig = http_server_config_max_body(c7, 10485760)
    let c9: HttpServerConfig = http_server_config_graceful_shutdown_ms(c8, 10000)
    let c10: HttpServerConfig = http_server_config_http2(c9, true)
    let c11: HttpServerConfig = http_server_config_tls(c10, "/etc/halis/cert.pem", "/etc/halis/key.pem")
    return c11
}

fn demo_config_overrides_chain() -> void uses IO {
    let c: HttpServerConfig = build_production_config()
    println("--- Production config (chained builder) ---")
    println(http_server_describe_config(c))
}

# ----------------------------------------------------------------------------
# Demo 2 — HTTP/2 preface detection.
# ----------------------------------------------------------------------------

fn demo_http2_preface() -> void uses IO {
    println("--- HTTP/2 preface detection ---")
    let preface: str = http_server_http2_preface()
    println("preface (" + preface.len().to_str() + " bytes): " + str_repr(preface))
    # An actual HTTP/2 connection's first bytes.
    let h2_bytes: str = preface + "extra bytes after the preface"
    println("  full preface match: " + http_server_is_http2_preface(preface).to_str())
    println("  preface + extra:     " + http_server_is_http2_preface(h2_bytes).to_str())
    # HTTP/1.1 first bytes — does NOT start with the preface.
    # HLS string literals don't support \r — use chr(13) for CR bytes.
    let h1_bytes: str = "GET / HTTP/1.1" + chr(13) + "\nHost: example.com" + chr(13) + "\n" + chr(13) + "\n"
    println("  HTTP/1.1 GET:        " + http_server_is_http2_preface(h1_bytes).to_str())
    # Too-short buffer — even if it's a prefix, the preface needs all 24 bytes.
    let short: str = "PRI * HTTP/2.0"
    println("  short buffer:        " + http_server_is_http2_preface(short).to_str())
    # Empty buffer.
    println("  empty buffer:       " + http_server_is_http2_preface("").to_str())
}

# str_repr — render a str with \r and \n as escape sequences (for display).
fn str_repr(s: str) -> str {
    let mut out: str = "\""
    let mut i: int = 0
    while i < s.len() {
        let b: int = s.byte_at(i)
        if b == 13 {
            out = out + "\\r"
        } else if b == 10 {
            out = out + "\\n"
        } else {
            out = out + chr(b)
        }
        i = i + 1
    }
    out = out + "\""
    return out
}

# ----------------------------------------------------------------------------
# Demo 3 — keep-alive decision.
# ----------------------------------------------------------------------------

fn demo_keep_alive() -> void uses IO {
    println("--- Keep-alive decision ---")
    let c: HttpServerConfig = http_server_config_new()
    # HTTP/1.1 + no Connection header -> keep-alive (default).
    let req1: HttpRequest = http_request_new("GET", "/")
    println("  HTTP/1.1 GET, no Connection header:    " + http_server_should_keep_alive(req1, c, 1).to_str())
    # HTTP/1.1 + Connection: close -> close.
    let req2: HttpRequest = http_request_new("GET", "/")
    req2.headers = http_header_add(req2.headers, "Connection", "close")
    println("  HTTP/1.1 GET, Connection: close:        " + http_server_should_keep_alive(req2, c, 1).to_str())
    # HTTP/1.1 + Connection: keep-alive -> keep-alive.
    let req3: HttpRequest = http_request_new("GET", "/")
    req3.headers = http_header_add(req3.headers, "Connection", "keep-alive")
    println("  HTTP/1.1 GET, Connection: keep-alive:  " + http_server_should_keep_alive(req3, c, 1).to_str())
    # HTTP/1.0 + no Connection header -> close (default).
    let req4: HttpRequest = http_request_new("GET", "/")
    req4.version = "HTTP/1.0"
    println("  HTTP/1.0 GET, no Connection header:     " + http_server_should_keep_alive(req4, c, 1).to_str())
    # HTTP/1.0 + Connection: keep-alive -> keep-alive.
    let req5: HttpRequest = http_request_new("GET", "/")
    req5.version = "HTTP/1.0"
    req5.headers = http_header_add(req5.headers, "Connection", "keep-alive")
    println("  HTTP/1.0 GET, Connection: keep-alive:   " + http_server_should_keep_alive(req5, c, 1).to_str())
    # Max-keepalive-requests reached -> close.
    println("  HTTP/1.1 GET, request_count=100 (max):  " + http_server_should_keep_alive(req1, c, 100).to_str())
}

# ----------------------------------------------------------------------------
# Demo 4 — route + dispatch.
# ----------------------------------------------------------------------------

fn demo_route_dispatch(method: str, path: str) -> void uses IO, Conc {
    let r: Router = build_demo_router()
    let c: HttpServerConfig = http_server_config_new()
    let s: HttpServer = http_server_new(c, r)
    let req: HttpRequest = http_request_new(method, path)
    # The demo dispatches directly via router_match + demo_dispatch_handler
    # (this is the pattern a user program would use; the stdlib's
    # http_server_route_request uses the default http_server_dispatch,
    # which a real single-file program can shadow at link time).
    let m: RouterMatch = router_match(s.router, req.method, req.path)
    let resp: HttpResponse = demo_dispatch_handler(m, req)
    println("  " + method + " " + path + " -> " + resp.status.to_str() + " " + resp.reason)
    if resp.body.len() > 0 && resp.body.len() < 100 {
        println("    body: " + resp.body)
    } else if resp.body.len() >= 100 {
        println("    body: (" + resp.body.len().to_str() + " bytes)")
    }
}

fn demo_route_table() -> void uses IO, Conc {
    println("--- Route dispatch ---")
    demo_route_dispatch("GET", "/")
    demo_route_dispatch("GET", "/users")
    demo_route_dispatch("POST", "/users")
    demo_route_dispatch("GET", "/users/42")
    demo_route_dispatch("PUT", "/users/42")
    demo_route_dispatch("DELETE", "/users/42")
    demo_route_dispatch("GET", "/healthz")
    demo_route_dispatch("GET", "/nonexistent")
}

# ----------------------------------------------------------------------------
# Demo 5 — graceful shutdown flag.
# ----------------------------------------------------------------------------

fn demo_graceful_shutdown() -> void uses IO, Conc, Clock {
    println("--- Graceful shutdown ---")
    let r: Router = build_demo_router()
    let c: HttpServerConfig = http_server_config_new()
    let s: HttpServer = http_server_new(c, r)
    println("  initial shutdown flag: " + http_server_is_shutting_down(s).to_str())
    println("  initial inflight:      " + http_server_inflight_get(s).to_str())
    # Simulate one in-flight connection.
    http_server_inflight_begin(s)
    println("  after begin:           inflight=" + http_server_inflight_get(s).to_str())
    # Trigger shutdown.
    http_server_request_shutdown(s)
    println("  after request_shutdown: flag=" + http_server_is_shutting_down(s).to_str())
    # Drain the in-flight connection.
    http_server_inflight_end(s)
    println("  after end:             inflight=" + http_server_inflight_get(s).to_str())
    # Wait for drain (should return immediately since inflight=0).
    let rc: int = http_server_wait_inflight(s, 1000)
    println("  wait_inflight rc:     " + rc.to_str() + " (0=drained, 1=timeout)")
    # Reset for the next demo (production code would NOT do this —
    # create a new server instead).
    http_server_clear_shutdown(s)
    println("  after clear_shutdown:  flag=" + http_server_is_shutting_down(s).to_str())
}

# ----------------------------------------------------------------------------
# Demo 6 — HTTP/2 frame encoders (verify byte-level output).
# ----------------------------------------------------------------------------

# http2_settings_frame_bytes — return the 9-byte SETTINGS frame as a
# human-readable hex string (for the demo; the actual function
# returns a str of bytes via chr()).
fn http2_settings_frame_hex() -> str {
    # The frame is: length=0 (3 bytes), type=4, flags=0, stream=0 (4 bytes).
    # Hex: 00 00 00 04 00 00 00 00 00
    return "00 00 00 04 00 00 00 00 00"
}

fn demo_http2_frames() -> void uses IO {
    println("--- HTTP/2 frame encoders (described) ---")
    println("  SETTINGS frame (9 bytes):       " + http2_settings_frame_hex())
    # SETTINGS ACK: length=0, type=4, flags=1 (ACK), stream=0.
    println("  SETTINGS ACK (9 bytes):         00 00 00 04 01 00 00 00 00")
    # GOAWAY (last_stream_id=0, error_code=0): length=8, type=7, flags=0, stream=0, then 8 zero bytes.
    println("  GOAWAY (17 bytes):              00 00 08 07 00 00 00 00 00 00 00 00 00 00 00 00 00")
    # DATA on stream 1 with body "HTTP/2 supported (Halis Stage 64 v0.83.0-alpha)\n"
    # body_len = 47 bytes; frame header = 9 bytes; total = 56 bytes.
    # Hex header: 00 00 2F 00 01 00 00 00 01
    println("  DATA on stream 1 (header 9B + 47B body = 56B): 00 00 2F 00 01 00 00 00 01")
}

# ----------------------------------------------------------------------------
# Main — run every demo in sequence.
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Conc, Clock {
    println("=== std.http_server demo (Stage 64, v0.83.0-alpha) ===")
    println("")
    demo_config_defaults()
    demo_config_overrides()
    demo_config_overrides_chain()
    demo_http2_preface()
    demo_keep_alive()
    demo_route_table()
    demo_graceful_shutdown()
    demo_http2_frames()
    println("")
    println("=== demo complete ===")
    return 0
}
