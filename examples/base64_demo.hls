import "std.base64"
import "std.hex"

fn main() -> int uses IO {
    println("=== base64 ===")
    let enc: str = base64_encode("Hello, Hieu Louis!")
    println("encoded: " + enc)
    let dec: str = base64_decode(enc)
    println("decoded: " + dec)

    println("")
    println("=== base64url ===")
    let url_enc: str = base64url_encode("Hello, Hieu Louis!")
    println("encoded: " + url_enc)
    let url_dec: str = base64url_decode(url_enc)
    println("decoded: " + url_dec)

    println("")
    println("=== round-trip arbitrary bytes ===")
    let original: str = chr(0) + chr(1) + chr(255) + chr(128) + "Hi!"
    let enc2: str = base64_encode(original)
    println("b64:    " + enc2)
    let dec2: str = base64_decode(enc2)
    println("hex:    " + hex_encode(dec2))
    println("match:  " + (original == dec2).to_str())

    println("")
    println("=== JWT-style payload ===")
    let payload: str = "{\"sub\":\"1234567890\",\"name\":\"Hieu Louis\",\"admin\":true}"
    let jwt_part: str = base64url_encode(payload)
    println("jwt:    " + jwt_part)
    let back: str = base64url_decode(jwt_part)
    println("back:   " + back)
    return 0
}
