# ============================================================================
# examples/nostd_demo.hls — Stage 78 (v0.97.0-alpha)
# ----------------------------------------------------------------------------
# A `#![no_std]` program: no `std`, but hosted libc is kept (the C
# backend still emits `main` and links normally). Everything the
# program touches comes from `core.*` — the freestanding-safe module
# family — or the pure core language itself.
#
# Build + run (hosted toolchain; the exit code IS the output — a
# no_std crate performs no I/O by construction):
#   bin/hlc examples/nostd_demo.hls /tmp/nostd_demo.c
#   gcc -O2 -o /tmp/nostd_demo /tmp/nostd_demo.c -lm -pthread
#   /tmp/nostd_demo; echo "exit=$?"   # exit=0
#
# The same crate with `#![freestanding]` instead of `#![no_std]`
# links with `-nostdlib` and enters via `_start` (Stage 77).
# ============================================================================

#![no_std]

import "core.option"
import "core.result"
import "core.iter"
import "core.clone"
import "core.eq"

struct Route {
    path: str,
    cost: int
}

impl Route {
    fn eq_of(self: Route, other: Route) -> bool {
        return self.path == other.path && self.cost == other.cost
    }
    fn clone_of(self: Route) -> Route {
        return Route {
            path: clone(self.path), cost: self.cost
        }
    }
}

fn cheapest(routes: list[Route]) -> Option[Route] {
    let mut it: ListIter[Route] = list_iter(routes)
    let mut best: Option[Route] = Option.None
    while iter_has_next(it) {
        let cur: Option[Route] = iter_next(it)
        if option_is_some(cur) {
            let r: Route = option_unwrap(cur)
            if option_is_none(best) {
                best = Option.Some(r)
            } else {
                let b: Route = option_unwrap(best)
                if r.cost < b.cost {
                    best = Option.Some(r)
                }
            }
        }
    }
    return best
}

fn parse_port(s: str) -> Result[int, str] {
    let r: Result[int, str] = parse_int(s)
    if result_is_err(r) {
        return Result.Err(result_unwrap_err(r))
    }
    let port: int = result_unwrap(r)
    if port < 0 || port > 65535 {
        return Result.Err("port out of range")
    }
    return Result.Ok(port)
}

fn main() -> int {
    let mut failures: int = 0
    # routing table scan via the Iterator protocol
    let routes: list[Route] = [Route {
        path: "a", cost: 9
    }, Route {
        path: "b", cost: 3
    }, Route {
        path: "c", cost: 7
    }]
    let win: Option[Route] = cheapest(routes)
    if !option_is_some(win) {
        failures = failures + 1
    }
    if option_unwrap(win).cost != 3 {
        failures = failures + 1
    }
    # the losers are untouched (value semantics via clone_of)
    let r0: Route = routes.get(0).clone_of()
    r0.cost = 0
    if routes.get(0).cost != 9 {
        failures = failures + 1
    }
    if !r0.eq_of(r0) {
        failures = failures + 1
    }
    # port parsing via Result (no panics on bad input)
    if result_unwrap(parse_port("8080")) != 8080 {
        failures = failures + 1
    }
    if !result_is_err(parse_port("http")) {
        failures = failures + 1
    }
    if !result_is_err(parse_port("99999")) {
        failures = failures + 1
    }
    # container equality across key orders
    let m1: map[str, int] = map_new()
    m1.set("rx", 10)
    m1.set("tx", 20)
    let m2: map[str, int] = clone_map_of(m1)
    m2.set("tx", 21)
    if !eq_map_str_int(m1, clone_map_of(m1)) {
        failures = failures + 1
    }
    if eq_map_str_int(m1, m2) {
        failures = failures + 1
    }
    # iterator exhaustion
    let nums: list[int] = [5, 6]
    if iter_count(nums) != 2 {
        failures = failures + 1
    }
    if iter_sum_int(nums) != 11 {
        failures = failures + 1
    }
    return failures
}
