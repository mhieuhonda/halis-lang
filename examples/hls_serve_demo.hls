# ============================================================================
# examples/hls_serve_demo.hls — Stage 75 (v0.94.0-alpha)
# ----------------------------------------------------------------------------
# A small web app that exercises the ``hls-serve`` dev server's HMR
# features. Designed to be served with::
#
#   make serve F=examples/hls_serve_demo.hls PORT=3000
#   # or:
#   python3 tools/hlserve.py --input examples/hls_serve_demo.hls \
#   #   --bundle out --port 3000 --open
#
# What this demo shows off (that the Stage 24 ``hlserve.py`` did not):
#
#   * Hot reload — the wasm module is hot-swapped without a full page
#     reload; the JS-side state survives. Edit this file (change the
#     headline below), save; the wasm re-instantiates while the page
#     keeps its DOM state.
#   * Compile-error overlay — introduce a syntax error in this file
#     and save; a red overlay pops up with file:line + message; fix
#     the error and save; the overlay auto-dismisses.
#   * Build stats footer — a small green footer in the bottom-right
#     shows the wasm/js bundle size + the last compile time.
#   * Console forwarding — every print() / println() in the wasm
#     program is mirrored to the dev server's terminal via the
#     WebSocket "log" channel.
#   * SPA history fallback — visit http://localhost:3000/deep/route
#     and the dev server still serves the HTML (no 404).
#   * HTTP proxy — start a backend on port 3001 and add a proxy:
#       --proxy /api=http://localhost:3001
#     A request to /api/users hits the backend (preserving /api in
#     the path).
#
# The demo uses the Stage 73 std.jsffi extern "js" surface (console +
# performance timing). No new compiler builtins; this is a pure
# tooling-stage demo.

import "std.jsffi"

# A struct purely for the auto-marshalling descriptors (Stage 73).
struct Counter {
    clicks: int,
    label: str,
}

fn jsffi_on_callback(cb_id: int, arg: str) -> str uses IO {
    if cb_id == 1 {
        # "ping" callback — returns the elapsed microseconds since
        # the program started, as a str.
        let now_us: int = js_now_ms() * 1000
        return "pong:" + now_us.to_str()
    }
    if cb_id == 2 {
        # "describe" callback — returns a static descriptor string.
        # (The Counter struct above is declared purely for the
        # auto-marshalling descriptors; we don't construct it here
        # because the freestanding wasm emitter doesn't yet support
        # struct literals.)
        return "primary:1"
    }
    return ""
}

fn main() -> int uses IO {
    let t0_ms: int = js_now_ms()
    println("[hls-serve-demo] booting up...")

    # Print the headline. Edit this line and save to test HMR —
    # the wasm re-instantiates and you'll see the new message in
    # the dev server's terminal (via the WS log channel).
    let headline: str = "Hello from hls-serve Stage 75!"
    js_console_log(headline)
    println("[hls-serve-demo] headline: " + headline)

    # Print the callback protocol so the dev-server terminal sees it.
    println("[hls-serve-demo] callback protocol:")
    println("  cb_id=1 -> ping (returns elapsed us)")
    println("  cb_id=2 -> describe (returns Counter.label:clicks)")

    let t1_ms: int = js_now_ms()
    let elapsed: int = t1_ms - t0_ms
    println("[hls-serve-demo] ready (elapsed=" + elapsed.to_str() + " ms)")

    return 0
}
