# actor_demo.hls — Stage 16 (v0.27.0-alpha): the actor model.
#
# An actor = a task + a mailbox channel. The actor owns its state
# exclusively; the ONLY way to touch that state is to send it a message.
# No locks, no shared memory — the compiler-enforced ownership rules make
# data races impossible by construction.
#
# This is a tiny key-value store actor: Set / Get / Del / Stop messages,
# a map[str, str] owned by the actor, replies via a per-request channel.

enum Req {
    Set(str, str),
    Get(str),
    Del(str),
    Stop
}

fn kv_actor(mail: Chan[Req], rep: Chan[str]) -> int uses Conc {
    let store: map[str, str] = map_new()
    let mut running: bool = true
    while running {
        let msg: Req = mail.recv()
        # Pure message decoding (match arms are expressions in HLS).
        let kind: int = match msg {
            Req.Set(k, v) => 1,
            Req.Get(k) => 2,
            Req.Del(k) => 3,
            Req.Stop => 4
        }
        let key: str = match msg {
            Req.Set(k, v) => k,
            Req.Get(k) => k,
            Req.Del(k) => k,
            Req.Stop => ""
        }
        let val: str = match msg {
            Req.Set(k, v) => v,
            Req.Get(k) => "",
            Req.Del(k) => "",
            Req.Stop => ""
        }
        if kind == 1 {
            store.set(key, val)
            rep.send("stored")
        } else if kind == 2 {
            rep.send(store.get_or(key, "<missing>"))
        } else if kind == 3 {
            if store.has(key) {
                store.set(key, "")
                rep.send("deleted")
            } else {
                rep.send("absent")
            }
        } else if kind == 4 {
            running = false
        }
    }
    return store.len()
}

fn main() -> int uses IO, Conc {
    let mail: Chan[Req] = chan_new()
    let rep: Chan[str] = chan_new()
    let actor: Task[int] = spawn(kv_actor, clone(mail), clone(rep))

    mail.send(Req.Set("user", "hieu"))
    let r1: str = rep.recv()
    mail.send(Req.Set("lang", "halis"))
    let r2: str = rep.recv()
    mail.send(Req.Get("user"))
    let got: str = rep.recv()
    mail.send(Req.Get("nope"))
    let missing: str = rep.recv()
    mail.send(Req.Stop)
    let final: int = actor.join()

    println(r1 + "/" + r2 + " user=" + got + " nope=" + missing
            + " final-size=" + final.to_str())
    return 0
}
