# ============================================================================
# examples/wasm_pack_demo.hls — Stage 76 (v0.95.0-alpha)
# ----------------------------------------------------------------------------
# A small Halis web library that exercises the ``hls-wasm-pack``
# publish pipeline. Designed to be packed with::
#
#   python3 tools/hlwasm_pack.py build examples/wasm_pack_demo.hls \
#       --out pkg --target bundler --name wasm-pack-demo
#   python3 tools/hlwasm_pack.py check pkg
#   python3 tools/hlwasm_pack.py pack --pkg pkg
#   python3 tools/hlwasm_pack.py publish wasm-pack-demo-0.1.0.tgz
#       # dry-run by default; add --no-dry-run to really publish
#
# What this demo shows off (that raw ``hlwasm`` did not):
#
#   * A library surface (pure helpers + a struct + an enum) that the
#     pack scanner turns into TypeScript declarations (``.d.ts``).
#   * The Stage 73 ``std.jsffi`` extern surface (console + JSON
#     bridge) so the packed package is immediately useful from JS.
#   * JS -> HLS callbacks (``jsffi_on_callback``) — reached from JS
#     via ``Halis.callHalis(cbId, json)`` in every packed target.
#
# NOTE ON THE SUBSET: the freestanding wasm emitter (Stage 24) lowers
# let / if / while / for-range / calls / literals — struct literals,
# match, and method calls land with the HLIR emitter, so this demo
# stays inside the supported subset (structs are DECLARED for the
# auto-marshalling descriptors but never constructed here, exactly
# like the Stage 73 demo).
# ============================================================================

import "std.jsffi"

# ----------------------------------------------------------------------------
# Library surface — declared for the AUTO-MARSHALLING descriptors
# (Stage 73) and for the .d.ts struct/interface emission (Stage 76).
# ----------------------------------------------------------------------------

struct Vec2 {
    x: float,
    y: float,
    label: str,
    visible: bool,
    weight: int
}

enum Axis {
    X,
    Y,
    Both
}

# ----------------------------------------------------------------------------
# Pure helpers — these become the exported TypeScript functions.
# ----------------------------------------------------------------------------

fn pack_add(a: int, b: int) -> int {
    return a + b
}

fn pack_greet(name: str) -> str {
    return "Hello, " + name + "!"
}

fn pack_axis_name(axis: int) -> str {
    if axis == 0 {
        return "X"
    }
    if axis == 1 {
        return "Y"
    }
    return "Both"
}

fn pack_sum_to(n: int) -> int {
    let mut total: int = 0
    let mut i: int = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

# ----------------------------------------------------------------------------
# JS -> HLS callback dispatch (the handler_id pattern — HLS has no
# function pointers, so the callback handler if/else chains on cb_id).
# ----------------------------------------------------------------------------

fn jsffi_on_callback(cb_id: int, arg: str) -> str uses IO {
    if cb_id == 1 {
        return pack_greet(arg)
    }
    if cb_id == 2 {
        return pack_add(40, 2).to_str()
    }
    return ""
}

fn main() -> int uses IO {
    println("[wasm-pack-demo] booting up...")
    println("[wasm-pack-demo] pack_add(40, 2) = " + pack_add(40, 2).to_str())
    println("[wasm-pack-demo] " + pack_greet("wasm-pack"))
    println("[wasm-pack-demo] axis(1) = " + pack_axis_name(1))
    println("[wasm-pack-demo] sum_to(100) = " + pack_sum_to(100).to_str())

    # Reachable from JS after packing: console + JSON bridge.
    js_console_log(pack_greet("bundler"))
    let ok: bool = js_json_valid("{\"demo\": true}")
    if ok {
        println("[wasm-pack-demo] js_json_valid = true")
    }
    println("[wasm-pack-demo] callback protocol:")
    println("  cb_id=1 -> greet (returns greeting for arg)")
    println("  cb_id=2 -> add (returns 42)")
    println("[wasm-pack-demo] ready")
    return 0
}
