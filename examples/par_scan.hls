# par_scan.hls — Stage 16 (v0.27.0-alpha): parallel work distribution.
#
# The classic fan-out / fan-in pattern: N worker tasks, one work channel,
# one result channel. Each worker pulls jobs until it sees the sentinel
# (-1), computes, and pushes results back. This is the same shape as a
# threaded web server (jobs = requests) and is the pattern the Stage 16
# benchmark (benchmarks/conc_bench.hls) scales across cores.

fn work(n: int) -> int {
    # CPU-bound payload: a small integer loop.
    let mut acc: int = 0
    let mut i: int = 0
    while i < n {
        acc = acc + (i % 7)
        i = i + 1
    }
    return acc
}

fn worker(id: int, jobs: Chan[int], results: Chan[int]) -> int uses Conc {
    let mut done: int = 0
    let mut running: bool = true
    while running {
        let n: int = jobs.recv()
        if n < 0 {
            running = false
        } else {
            results.send(work(n))
            done = done + 1
        }
    }
    return done
}

fn main() -> int uses IO, Conc {
    let jobs: Chan[int] = chan_new()
    let results: Chan[int] = chan_new()
    let nw: int = 4
    let mut ts: list[Task[int]] = []
    let mut w: int = 0
    while w < nw {
        ts.push(spawn(worker, w, clone(jobs), clone(results)))
        w = w + 1
    }
    # Fan out.
    let mut j: int = 0
    while j < 16 {
        jobs.send(50000)
        j = j + 1
    }
    # Sentinels: one per worker.
    let mut s: int = 0
    while s < nw {
        jobs.send(-1)
        s = s + 1
    }
    # Fan in.
    let mut total: int = 0
    let mut r: int = 0
    while r < 16 {
        total = total + results.recv()
        r = r + 1
    }
    let mut handled: int = 0
    let mut k: int = 0
    while k < nw {
        let t: Task[int] = ts.get(k)
        handled = handled + t.join()
        k = k + 1
    }
    println("workers=" + nw.to_str() + " jobs=16 total=" + total.to_str()
            + " handled=" + handled.to_str())
    return 0
}
