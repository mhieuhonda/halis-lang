# ============================================================================
# examples/websocket_demo.hls — Stage 65 (v0.84.0-alpha): std.websocket
# ----------------------------------------------------------------------------
# Demonstrates every pure piece of the WebSocket protocol API:
#   * SHA-1 hash on the canonical FIPS 180-4 test vectors
#   * ws_accept_key on the RFC 6455 §1.3 example (and a second vector)
#   * ws_handshake_response (full 101 Switching Protocols response)
#   * ws_validate_upgrade (accept valid, reject wrong method,
#     reject missing Upgrade header)
#   * ws_validate_accept (correct match, MITM detection)
#   * ws_validate_upgrade_response (101 with correct Accept, 200 rejected,
#     MITM accept rejected)
#   * ws_pick_subprotocol (multiple, single, none)
#   * ws_frame_encode_with_key (byte-level: masked text frame "Hello"
#     with mask key 0x12 0x34 0x56 0x78, verified byte-by-byte)
#   * ws_frame_decode round trip (text, binary, close with code+reason,
#     ping/pong)
#   * ws_close_payload / ws_parse_close_payload (round trip)
#   * ws_describe_frame (close with code + reason rendered)
#   * ws_handshake_request (full client-side request, with subprotocol)
#   * ws_opcode_name / ws_close_code_name (human-readable)
#
# The demo is pure (no actual network) so the differential test
# (interpreter == native) produces byte-identical output.
# ============================================================================

import "std.websocket"
import "std.sha1"
import "std.http"
import "std.str"

# ============================================================================
# Section 1: SHA-1 FIPS 180-4 test vectors.
# ============================================================================

fn demo_sha1() -> void uses IO {
    println("--- SHA-1 FIPS 180-4 test vectors ---")
    println("sha1_hex('')       = " + sha1_hex(""))
    println("  expected           = da39a3ee5e6b4b0d3255bfef95601890afd80709")
    println("sha1_hex('abc')    = " + sha1_hex("abc"))
    println("  expected           = a9993e364706816aba3e25717850c26c9cd0d89d")
    println("sha1_hex(448-bit)  = " + sha1_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
    println("  expected           = 84983e441c3bd26ebaae4aa1f95129e5e54670f1")
    println("")
    return
}

# ============================================================================
# Section 2: ws_accept_key — RFC 6455 §1.3 canonical example.
# ============================================================================

fn demo_accept_key() -> void uses IO {
    println("--- ws_accept_key (RFC 6455 §1.3 canonical) ---")
    let key: str = "dGhlIHNhbXBsZSBub25jZQ=="
    let accept: str = ws_accept_key(key)
    println("  client_key = " + key)
    println("  accept     = " + accept)
    println("  expected   = s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")
    if accept == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=" {
        println("  [MATCH]")
    } else {
        println("  [MISMATCH]")
    }
    println("")
    return
}

# ============================================================================
# Section 3: ws_handshake_response — the full 101 Switching Protocols.
# ============================================================================

fn demo_handshake_response() -> void uses IO {
    println("--- ws_handshake_response (101 Switching Protocols) ---")
    let key: str = "dGhlIHNhbXBsZSBub25jZQ=="
    println("Without subprotocol:")
    print(ws_handshake_response(key, ""))
    println("With subprotocol 'chat':")
    print(ws_handshake_response(key, "chat"))
    return
}

# ============================================================================
# Section 4: ws_validate_upgrade — accept valid, reject invalid.
# ============================================================================

fn demo_validate_upgrade() -> void uses IO {
    println("--- ws_validate_upgrade ---")
    # Valid.
    let mut req: HttpRequest = http_request_new("GET", "/ws")
    req.version = "HTTP/1.1"
    req.headers = http_header_add(req.headers, "Host", "example.com")
    req.headers = http_header_add(req.headers, "Upgrade", "websocket")
    req.headers = http_header_add(req.headers, "Connection", "Upgrade")
    req.headers = http_header_add(req.headers, "Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ==")
    req.headers = http_header_add(req.headers, "Sec-WebSocket-Version", "13")
    let r: Result[str, str] = ws_validate_upgrade(req)
    if result_is_ok(r) {
        println("  valid request -> Ok(" + result_unwrap(r) + ")")
    } else {
        println("  valid request -> Err(" + result_err_or(r, "") + ")")
    }
    # Wrong method (POST).
    let mut bad: HttpRequest = http_request_new("POST", "/ws")
    bad.version = "HTTP/1.1"
    bad.headers = http_header_add(bad.headers, "Host", "example.com")
    bad.headers = http_header_add(bad.headers, "Upgrade", "websocket")
    bad.headers = http_header_add(bad.headers, "Connection", "Upgrade")
    bad.headers = http_header_add(bad.headers, "Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ==")
    bad.headers = http_header_add(bad.headers, "Sec-WebSocket-Version", "13")
    let r2: Result[str, str] = ws_validate_upgrade(bad)
    if result_is_ok(r2) {
        println("  POST request -> Ok (unexpected!)")
    } else {
        println("  POST request -> Err(" + result_err_or(r2, "") + ")")
    }
    println("")
    return
}

# ============================================================================
# Section 5: ws_validate_accept — match correct, reject wrong.
# ============================================================================

fn demo_validate_accept() -> void uses IO {
    println("--- ws_validate_accept (MITM detection) ---")
    let key: str = "dGhlIHNhbXBsZSBub25jZQ=="
    let correct_accept: str = ws_accept_key(key)
    let mitm_accept: str = "tampered-accept-value-here"
    println("  correct accept -> " + ws_validate_accept(correct_accept, key).to_str())
    println("  MITM accept    -> " + ws_validate_accept(mitm_accept, key).to_str())
    println("")
    return
}

# ============================================================================
# Section 6: ws_frame_encode_with_key — byte-level RFC 6455 wire format.
# ============================================================================

fn demo_frame_encode() -> void uses IO {
    println("--- ws_frame_encode_with_key (byte-level RFC 6455) ---")
    let mk: str = chr(18) + chr(52) + chr(86) + chr(120)        # 0x12 0x34 0x56 0x78
    let frame: str = ws_frame_encode_with_key(ws_opcode_text(), "Hello", mk)
    println("  masked text frame 'Hello' with mask 0x12345678:")
    let mut hex_str: str = "    "
    let mut i: int = 0
    let hex_digits: str = "0123456789abcdef"
    while i < frame.len() {
        let b: int = frame.byte_at(i)
        hex_str = hex_str + hex_digits.slice(b / 16, b / 16 + 1) + hex_digits.slice(b % 16, b % 16 + 1) + " "
        i = i + 1
    }
    println(hex_str)
    println("  expected:        81 85 12 34 56 78 5a 51 3a 14 7d")
    # Decode back.
    let r: Result[WsFrame, str] = ws_frame_decode(frame)
    if result_is_ok(r) {
        let f: WsFrame = result_unwrap(r)
        println("  decoded: " + ws_describe_frame(f))
        println("  payload: '" + f.payload + "'")
    } else {
        println("  decode failed: " + result_err_or(r, ""))
    }
    println("")
    return
}

# ============================================================================
# Section 7: Close frame round trip + describe.
# ============================================================================

fn demo_close_frame() -> void uses IO {
    println("--- Close frame round trip ---")
    let close_payload: str = ws_close_payload(ws_close_normal(), "goodbye")
    let close_frame: str = ws_frame_encode_with_key(ws_opcode_close(), close_payload, "")
    let r: Result[WsFrame, str] = ws_frame_decode(close_frame)
    if result_is_ok(r) {
        let f: WsFrame = result_unwrap(r)
        println("  decoded: " + ws_describe_frame(f))
        let cp_r: Result[WsClosePayload, str] = ws_parse_close_payload(f.payload)
        if result_is_ok(cp_r) {
            let cp: WsClosePayload = result_unwrap(cp_r)
            println("  close_code = " + cp.code.to_str() + " (" + ws_close_code_name(cp.code) + ")")
            println("  reason     = '" + cp.reason + "'")
        }
    }
    println("")
    return
}

# ============================================================================
# Section 8: ws_handshake_request — full client-side request.
# ============================================================================

fn demo_handshake_request() -> void uses IO {
    println("--- ws_handshake_request (client side) ---")
    let req: str = ws_handshake_request("example.com", 80, "/ws", "dGhlIHNhbXBsZSBub25jZQ==", "chat")
    print(req)
    return
}

# ============================================================================
# Section 9: opcode and close-code names.
# ============================================================================

fn demo_names() -> void uses IO {
    println("--- Opcode / close-code names ---")
    println("  opcode 0  = " + ws_opcode_name(0))
    println("  opcode 1  = " + ws_opcode_name(1))
    println("  opcode 2  = " + ws_opcode_name(2))
    println("  opcode 8  = " + ws_opcode_name(8))
    println("  opcode 9  = " + ws_opcode_name(9))
    println("  opcode 10 = " + ws_opcode_name(10))
    println("  close 1000 = " + ws_close_code_name(1000))
    println("  close 1001 = " + ws_close_code_name(1001))
    println("  close 1002 = " + ws_close_code_name(1002))
    println("  close 1007 = " + ws_close_code_name(1007))
    println("  close 1009 = " + ws_close_code_name(1009))
    println("  close 1011 = " + ws_close_code_name(1011))
    println("  close 4001 = " + ws_close_code_name(4001))
    return
}

# ============================================================================
# Main — run every demo section.
# ============================================================================

fn main() -> int uses IO {
    println("================================================================")
    println("Stage 65 (v0.84.0-alpha): std.websocket (RFC 6455)")
    println("================================================================")
    println("")
    demo_sha1()
    demo_accept_key()
    demo_handshake_response()
    demo_validate_upgrade()
    demo_validate_accept()
    demo_frame_encode()
    demo_close_frame()
    demo_handshake_request()
    demo_names()
    println("")
    println("================================================================")
    println("Stage 65 demo complete (pure — differential-safe).")
    println("================================================================")
    return 0
}
