# examples/hlscli_demo.hls — Stage 60 (v0.81.0-alpha): std.hlscli demo.
#
# This demo exercises the cargo-style launcher's key features:
#   - hlscli_build_parser — the launcher's CLI parser
#   - hlscli_main — the dispatcher
#   - hlscli_cmd_new — scaffold a project
#   - hlscli_cmd_completion — generate shell completions for `hls`
#   - hlscli_template_* — the scaffolded file templates
#
# The demo uses synthetic argv lists so the output is differential-safe.
# The actual `hls run` end-to-end path is exercised by the Makefile
# target `hlscli-acceptance` (which builds the native hls binary, sets
# HLS_COMPILER, scaffolds a project in /tmp, and runs `hls run`).

import "std.hlscli"
import "std.str"
import "std.cli"

# ----------------------------------------------------------------------------
# Demo 1 — the launcher's help text.
# ----------------------------------------------------------------------------

fn demo_help() -> void uses IO {
    let p: CliParser = hlscli_build_parser()
    println("=== hls --help ===")
    cli_print_help(p)
}

# ----------------------------------------------------------------------------
# Demo 2 — scaffold a project (hls new).
# ----------------------------------------------------------------------------

fn demo_new() -> void uses Args, IO, Fs, Proc {
    println("")
    println("=== hls new demo_project ===")
    let p: CliParser = hlscli_build_parser()
    let argv: list[str] = ["hls", "new", "demo_project"]
    let result: CliResult = cli_parse(p, argv)
    let exit_code: int = hlscli_cmd_new(result)
    if exit_code == 0 {
        # Show the created files.
        let toml: str = read_file("demo_project/hls-pkg.toml")
        let main_hls: str = read_file("demo_project/src/main.hls")
        println("")
        println("--- demo_project/hls-pkg.toml ---")
        println(toml)
        println("--- demo_project/src/main.hls ---")
        println(main_hls)
    }
    # Clean up.
    let _ : int = proc_exec("rm -rf demo_project")
}

# ----------------------------------------------------------------------------
# Demo 3 — hls completion --shell=bash.
# ----------------------------------------------------------------------------

fn demo_completion_bash() -> void uses Args, IO, Proc {
    println("")
    println("=== hls completion --shell=bash (first 25 lines) ===")
    let p: CliParser = hlscli_build_parser()
    let argv: list[str] = ["hls", "completion", "--shell=bash"]
    let result: CliResult = cli_parse(p, argv)
    let exit_code: int = hlscli_cmd_completion(result)
    if exit_code != 0 {
        println("completion failed (exit " + exit_code.to_str() + ")")
    }
}

# ----------------------------------------------------------------------------
# Demo 4 — env-var config.
# ----------------------------------------------------------------------------

fn demo_env_config() -> void uses IO, Proc {
    println("")
    println("=== env-var config (HLS_COMPILER / HLS_TARGET_DIR / HLS_RELEASE) ===")
    let p: CliParser = hlscli_build_parser()
    let argv: list[str] = ["hls", "run"]
    let result: CliResult = cli_parse(p, argv)
    # Defaults (no env set).
    println("  defaults:")
    println("    HLS_COMPILER  = " + hlscli_compiler(result))
    println("    HLS_TARGET_DIR = " + hlscli_target_dir(result))
    println("    HLS_RELEASE   = " + hlscli_is_release(result).to_str())
    # With env set.
    env_set("HLS_COMPILER", "/usr/local/bin/hlc")
    env_set("HLS_TARGET_DIR", "/tmp/hls_target")
    env_set("HLS_RELEASE", "1")
    let result2: CliResult = cli_parse(p, argv)
    println("  with env:")
    println("    HLS_COMPILER  = " + hlscli_compiler(result2))
    println("    HLS_TARGET_DIR = " + hlscli_target_dir(result2))
    println("    HLS_RELEASE   = " + hlscli_is_release(result2).to_str())
    env_unset("HLS_COMPILER")
    env_unset("HLS_TARGET_DIR")
    env_unset("HLS_RELEASE")
}

# ----------------------------------------------------------------------------
# Main — run all demos.
# ----------------------------------------------------------------------------

fn main() -> int uses Args, IO, Fs, Proc {
    println("=== Stage 60 (v0.81.0-alpha): std.hlscli — cargo-style launcher ===")
    demo_help()
    demo_new()
    # Note: demo_completion_bash prints the full bash script, which is
    # long. We skip it in the demo to keep the output readable (it's
    # tested in feat_stage60_hlscli.hls).
    demo_env_config()
    println("")
    println("ACCEPTANCE OK: Stage 60 — std.hlscli demo runs clean.")
    return 0
}
