# Stage 15 release: a libcurl demo showing how to call a C library
# function via the FFI.
#
# The demo declares the most useful libcurl functions and shows the
# typical call pattern. (You'd need libcurl-dev installed and link
# with -lcurl to actually compile+run this.)
#
# Note: this file is a SHOWCASE — it type-checks cleanly but doesn't
# actually call the FFI functions in `main()` (since libcurl may not
# be installed on every CI machine). The check is performed by
# `hlbindgen` against the system libcurl headers in a separate test.

extern "C" {
    # The easy-handle is opaque from HLS's perspective. We represent
    # it as an int (a pointer-sized integer in the C ABI).
    fn curl_easy_init() -> int uses IO
    fn curl_easy_cleanup(handle: int) -> void uses IO
    fn curl_easy_setopt(handle: int, opt: int, value: int) -> int uses IO
    fn curl_easy_perform(handle: int) -> int uses IO
    fn curl_easy_getinfo(handle: int, info: int, value_out: int) -> int uses IO
    fn curl_version() -> str pure
}

# libcurl constants (CURLOPT_URL = 10002, etc.) — typically defined
# in <curl/curl.h>. Stage 15 release: bindgen can emit these as HLS
# `let` constants when --include-constants is set.
fn main() -> void uses IO {
    # Deep-scan-12 fix: this file is a SHOWCASE — it type-checks
    # cleanly but DOESN'T actually call the FFI functions in
    # main(), because libcurl is not installed on every CI
    # machine and the interpreter's `call_extern` only resolves
    # symbols in the default C library (libc), not libcurl. The
    # previous main() body DID call curl_easy_init() — which
    # panicked with "extern function not found in libc" on every
    # CI machine without libcurl preloaded.
    #
    # The showcasing nature is now honest: the extern block above
    # demonstrates the FFI declaration syntax; running this program
    # prints a single line confirming the declarations type-check.
    println("libcurl FFI showcase (declarations only — see comment above)")
}
