# ============================================================================
# examples/bare_riscv64.hls — Stage 95 (v0.114.0-alpha)
# ----------------------------------------------------------------------------
# The bare-metal RISC-V probe for QEMU's riscv64 `virt` machine:
#
#   bin/hlc --target riscv64-unknown-none examples/bare_riscv64.hls out.c
#   <riscv64 cc> -march=rv64imac -mabi=lp64 -ffreestanding -nostdlib \
#       -nostartfiles -ffunction-sections -fno-stack-protector \
#       -Wl,--gc-sections,-T,targets/riscv64-unknown-none.ld \
#       -o img out.c
#   qemu-system-riscv64 -M virt -bios none -nographic -kernel img
#       # prints "bare riscv64 OK" and EXITS with main's code (42)
#
# Two device paths, both through ONE self-contained `asm!` template
# each — no operands, no clobber list; the templates save and restore
# the two temporary registers they use (t0/t1), so the Stage 83
# contract ("asm! touches no registers"; its named-register model is
# x86-64 today) stays true, and the default memory clobber covers the
# device stores:
#
#   * the NS16550A UART at 0x10000000 (virt's console), byte at +0;
#   * the SiFive test finisher at 0x100000: writing
#     0x3333 | (code << 16) makes QEMU exit with `code` — the only
#     triple whose bare-metal run has a REAL exit code without a
#     semihosting harness (the naked _start's `ecall` is a Linux
#     syscall and has no owner under `-bios none`).
#
# The program is integer-only BY RULE — rv64imac has no float
# registers, so the ISA itself is the backstop behind the compiler's
# --target discipline.
# ============================================================================

#![freestanding]

# "bare riscv64 OK\n" through the NS16550A data register.
fn uart_msg_raw() -> void {
    asm!("sd t0, -8(sp); sd t1, -16(sp); li t0, 0x10000000; li t1, 0x62; sb t1, 0(t0); li t1, 0x61; sb t1, 0(t0); li t1, 0x72; sb t1, 0(t0); li t1, 0x65; sb t1, 0(t0); li t1, 0x20; sb t1, 0(t0); li t1, 0x72; sb t1, 0(t0); li t1, 0x69; sb t1, 0(t0); li t1, 0x73; sb t1, 0(t0); li t1, 0x63; sb t1, 0(t0); li t1, 0x76; sb t1, 0(t0); li t1, 0x36; sb t1, 0(t0); li t1, 0x34; sb t1, 0(t0); li t1, 0x20; sb t1, 0(t0); li t1, 0x4f; sb t1, 0(t0); li t1, 0x4b; sb t1, 0(t0); li t1, 0x0a; sb t1, 0(t0); ld t1, -16(sp); ld t0, -8(sp);")
}

# QEMU's SiFive test finisher: FINISHER_FAIL (0x3333) with the exit
# code in the upper half-word. code=42 -> 0x002a3333 -> QEMU exits 42.
fn qemu_exit_raw(code: int) -> void {
    if code == 42 {
        asm!("sd t0, -8(sp); sd t1, -16(sp); li t0, 0x100000; li t1, 0x2a3333; sw t1, 0(t0); ld t1, -16(sp); ld t0, -8(sp);")
    }
}

# The integer probe — the same arithmetic the x86 and ARM probes run,
# so one exit code closes all three bare-metal stages.
fn banner_checksum() -> int {
    let banner: list[int] = [104, 97, 108, 105, 115]  # "halis"
    let mut h: int = 7
    let mut i: int = 0
    while i < banner.len() {
        h = (h * 31 + banner.get(i)) % 268435456
        i = i + 1
    }
    return h
}

fn gcd(a: int, b: int) -> int {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}

fn main() -> int {
    uart_msg_raw()
    let cs: int = banner_checksum()
    let g: int = gcd(1071, 462)          # 21
    let primes_under_20: int = 8         # 2 3 5 7 11 13 17 19
    let code: int = cs % 10 + g + primes_under_20 + 13   # 42
    qemu_exit_raw(code)
    return code
}
