# examples/proof_demo.hls — Stage 17 perfection demo: contracts +
# proof-elision showcase. Every function has `requires` clauses;
# `hlprove` reports the elisions; `-O fast` compiles the elided
# version (fast binary output identical to the interpreter).

# A safe-add helper: the requires clause proves no overflow, so
# under -O fast the overflow check is elided (sound: the requires
# is asserted at the call site before the function body runs).
fn safe_add(a: int, b: int) -> int
    requires a >= 0
    requires b >= 0
    requires a <= 1000000
    requires b <= 1000000
{
    return a + b
}

# A bounded-index accessor: the requires clause proves the index
# is in [0, len-1], so under -O fast the bounds check is elided.
fn safe_byte(s: str, i: int) -> int
    requires i >= 0
    requires i < s.len()
{
    return s.byte_at(i)
}

# A non-zero divisor: the requires clause proves b != 0, so under
# -O fast the divide-by-zero check is elided.
fn safe_div(a: int, b: int) -> int
    requires b != 0
{
    return a / b
}

# A min-length accessor: the requires clause proves s.len() >= 4,
# so s.byte_at(3) is provably in-bounds under -O fast.
fn fourth_byte(s: str) -> int
    requires s.len() >= 4
{
    return s.byte_at(3)
}

fn main() -> int uses IO {
    let a: int = safe_add(500000, 600000)
    println("safe_add(500000, 600000) = " + a.to_str())
    let b: int = safe_byte("hello", 1)
    println("safe_byte(\"hello\", 1) = " + b.to_str())
    let c: int = safe_div(100, 5)
    println("safe_div(100, 5) = " + c.to_str())
    let d: int = fourth_byte("abcdefg")
    println("fourth_byte(\"abcdefg\") = " + d.to_str())
    return 0
}
