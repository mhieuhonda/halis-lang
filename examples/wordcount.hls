# wordcount.hls — read file, split strings, count with a map
# Demonstrates: I/O with checked effects + insertion-ordered map
fn count_words(content: str) -> map[str, int] {
    let counts: map[str, int] = map_new()
    let lines: list[str] = content.split("\n")
    let mut i: int = 0
    while i < lines.len() {
        let words: list[str] = lines.get(i).split(" ")
        let mut j: int = 0
        while j < words.len() {
            let w: str = words.get(j).trim()
            if w.len() > 0 {
                let prev: int = counts.get_or(w, 0)
                counts.set(w, prev + 1)
            }
            j = j + 1
        }
        i = i + 1
    }
    return counts
}

fn main() -> int uses IO {
    let a: list[str] = args()
    if a.len() < 2 {
        println("usage: wordcount <file.txt>")
        return 1
    }
    let content: str = read_file(a.get(1))
    let result: map[str, int] = count_words(content)
    let words: list[str] = result.keys()
    println("Distinct words: " + words.len().to_str())
    let mut i: int = 0
    while i < words.len() {
        let w: str = words.get(i)
        println("  " + w + ": " + result.get_or(w, 0).to_str())
        i = i + 1
    }
    return 0
}
