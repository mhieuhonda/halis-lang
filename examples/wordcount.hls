# wordcount.hls — doc tep, tach chuoi, dem bang map
# Minh hoa: I/O co kiem soat effects + map giu thu tu chen
fn dem_tu(noi_dung: str) -> map[str, int] {
    let tu_khoa: map[str, int] = map_new()
    let dong: list[str] = noi_dung.split("\n")
    let mut i: int = 0
    while i < dong.len() {
        let tu: list[str] = dong.get(i).split(" ")
        let mut j: int = 0
        while j < tu.len() {
            let t: str = tu.get(j).trim()
            if t.len() > 0 {
                let cu: int = tu_khoa.get_or(t, 0)
                tu_khoa.set(t, cu + 1)
            }
            j = j + 1
        }
        i = i + 1
    }
    return tu_khoa
}

fn main() -> int uses IO {
    let a: list[str] = args()
    if a.len() < 2 {
        println("cach dung: wordcount <tep.txt>")
        return 1
    }
    let noi_dung: str = read_file(a.get(1))
    let ket_qua: map[str, int] = dem_tu(noi_dung)
    let cac_tu: list[str] = ket_qua.keys()
    println("So tu khac nhau: " + cac_tu.len().to_str())
    let mut i: int = 0
    while i < cac_tu.len() {
        let t: str = cac_tu.get(i)
        println("  " + t + ": " + ket_qua.get_or(t, 0).to_str())
        i = i + 1
    }
    return 0
}
