# dep_a.hls — a Stage 104 SBOM fixture: the MIDDLE component.
#
# It looks like a small network helper, and it is: one Net call, one
# import of dep_b (whose Clock + Fs ride through the TREE — this
# module's own functions never call them, so its own surface is Net
# alone; the union lands on the root's hls:effects:surface). In the
# documents it is a `file` component (CycloneDX) / a LIBRARY package
# (SPDX) whose SHA-256 is over its own bytes and whose properties
# carry the same kind + effect split hls-audit prints — the SAME
# walker produced both reports.

import "std.str"
import "dep_b.hls"

# The Net introduction point of this tree: one localhost lookup.
# The report lists the component; the demo resolves it.
fn probe_parts() -> str uses Net {
    let ip: str = net_lookup("localhost")
    return "net:" + ip.len().to_str()
}

# Pure shaping — the string module stays in the toolchain column.
fn part_label(n: int) -> str {
    return "part-" + n.to_str()
}
