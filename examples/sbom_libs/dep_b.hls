# dep_b.hls — a Stage 104 SBOM fixture: the DEEP component.
#
# It performs no network work of its own; its two effects are the
# clock read and the manifest query. Both are born HERE (intrinsic),
# reachable everywhere above it — and in the SBOM both ride along as
# hls:effects:intrinsic / hls:effects:surface properties, so a
# consumer reading the bill of materials learns not just WHAT the
# parts are but WHAT THEY DO.

import "std.str"

# The Clock introduction point: one monotonic read.
fn read_stamp() -> int uses Clock {
    return clock_ms()
}

# The Fs introduction point: one existence query. A query, not a
# read — the file need not exist for the effect to be declared.
fn has_manifest() -> bool uses Fs {
    return file_exists("hls-pkg.toml")
}

# Pure string shaping (no effects of its own — the std.str import
# stays in the toolchain column of the census).
fn deep_label() -> str {
    return "dep_b: clock + fs"
}
