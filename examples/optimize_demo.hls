# Stage 11 demo — the HLIR optimiser pipeline.
#
# Run:
#   python3 boot/boot.py --emit ir examples/optimize_demo.hls
#   python3 boot/boot.py --opt-stats examples/optimize_demo.hls
#   python3 boot/boot.py examples/optimize_demo.hls
#
# The optimiser should fold `2 + 3 + 4` -> `9`, `2 * 3 * 4` -> `24`,
# and DCE the unused `temp`. The resulting `compute` function should
# become effectively `return 33` (9 + 24 = 33).

fn compute() -> int {
    let a: int = 2
    let b: int = 3
    let c: int = 4
    let sum: int = a + b + c        # 2 + 3 + 4 = 9
    let prod: int = a * b * c       # 2 * 3 * 4 = 24
    let temp: int = sum * 100       # unused - DCE should remove
    return sum + prod               # 9 + 24 = 33
}

fn main() -> int uses IO {
    println("compute() = " + compute().to_str())
    return 0
}
