import "std.csv"
import "std.str"

fn print_rows(rows: list[list[str]]) -> void uses IO {
    let mut i: int = 0
    while i < rows.len() {
        let row: list[str] = rows.get(i)
        print("  row[" + i.to_str() + "]: ")
        let mut j: int = 0
        while j < row.len() {
            if j > 0 {
                print(" | ")
            }
            print(row.get(j))
            j = j + 1
        }
        println("")
        i = i + 1
    }
}

fn main() -> int uses IO {
    println("=== simple CSV ===")
    let src1: str = "name,age,city\nAlice,30,Hanoi\nBob,25,Saigon\nCharlie,35,Hue"
    let rows1: list[list[str]] = csv_parse_default(src1)
    print_rows(rows1)

    println("")
    println("=== quoted fields with commas ===")
    let src2: str = "id,description\n1,\"Hello, World\"\n2,\"Has \"\"quotes\"\" inside\"\n3,\"Multi\nline field\""
    let rows2: list[list[str]] = csv_parse_default(src2)
    print_rows(rows2)

    println("")
    println("=== tab-separated ===")
    let src3: str = "a\tb\tc\n1\t2\t3"
    let rows3: list[list[str]] = csv_parse(src3, 9)
    print_rows(rows3)

    println("")
    println("=== round-trip ===")
    let original: str = "name,note\nAlice,\"Hello, World\"\nBob,\"Line\nbreak\""
    let parsed: list[list[str]] = csv_parse_default(original)
    let rebuilt: str = csv_stringify_default(parsed)
    println("original:")
    println(original)
    println("rebuilt:")
    println(rebuilt)
    println("equal: " + (original == rebuilt).to_str())

    println("")
    println("=== build CSV from scratch ===")
    let data: list[list[str]] = [
        ["name", "score"],
        ["Alice", "95"],
        ["Bob", "88"],
        ["Charlie", "100"]
    ]
    let csv_out: str = csv_stringify_default(data)
    println(csv_out)
    return 0
}
