# ============================================================================
# examples/boot_kernel.hls — Stage 85: a real freestanding boot image
# ----------------------------------------------------------------------------
# The other half of Stage 85 from boot_demo.hls: that one MODELS what a
# kernel does with the boot information, this one IS the image a
# firmware loads.
#
# The crate declares `#![boot_header(limine)]`, so the C backend emits
# the request list into `.limine_requests`, and `#![link_script]`, so
# the Stage 84 machinery proves the script actually places that section —
# the one check that turns "the bootloader refused to boot my kernel"
# into a compile error.
#
# Build it the way a bootloader would see it:
#     hlc examples/boot_kernel.hls /tmp/kernel.c
#     gcc -O2 -ffreestanding -nostdlib -fno-pie -no-pie \
#         -ffunction-sections -fno-stack-protector -T link.ld \
#         -o /tmp/kernel.elf /tmp/kernel.c
#     objdump -s -j .limine_requests /tmp/kernel.elf
# ============================================================================

#![freestanding]
#![stack_size(65536)]
#![link_script("../link.ld")]
#![boot_header(limine)]

import "core.boot"
import "core.result"
import "core.section"

# A request list identical to the one the C backend emits, built from
# the same constants, so a test can assert the two agree. (The emitted
# blob is what a bootloader reads; this is what a Halis-side test can
# look at.)
fn requested() -> list[LimineFeature] {
    let mut fs: list[LimineFeature] = []
    fs.push(limine_feature_new(limine_id_memmap(), 0))
    fs.push(limine_feature_new(limine_id_framebuffer(), 0))
    fs.push(limine_feature_new(limine_id_rsdp(), 0))
    fs.push(limine_feature_new(limine_id_hhdm(), 0))
    fs.push(limine_feature_new(limine_id_stack_size(), 0))
    return fs
}

# The physical-memory manager's first decision, made against a map the
# firmware would have handed us. In a real kernel this runs on the map
# the bootloader provided; modelling it here keeps the decision logic
# identical in both.
fn first_frame() -> int {
    let mut rs: list[MemRegion] = []
    rs.push(mem_region_new(0, 4096, MemKind.Reserved))
    rs.push(mem_region_new(4096, 1044416, MemKind.Usable))
    return mem_find_usable(rs, 4096, 4096)
}

# `_start` is the freestanding entry the C backend synthesises. The exit
# code is the image's answer: 0 = the boot path ran clean.
fn main() -> int {
    let fs: list[LimineFeature] = requested()
    if !limine_features_unique(fs) {
        return 1
    }
    if !limine_feature_requested(fs, limine_id_memmap()) {
        return 2
    }
    if first_frame() != 4096 {
        return 3
    }
    return 0
}
