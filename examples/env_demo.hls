# examples/env_demo.hls — Stage 48 (v0.67.0-alpha): std.env
#
# Demonstrates the std.env user-facing API:
#   - env_var: read HOME (Some) and a missing var (None)
#   - env_set_var + env_var: set and read back a custom env var
#   - env_unset_var: unset the custom var, verify it's gone
#   - env_current_dir: read the cwd (tainted by default; taint_unwrap
#     before printing — the demo's cwd is the user's own directory,
#     so untainting is safe)
#   - env_set_current_dir: change to /tmp, then back (round-trip)
#   - env_args_os: read argv as a list of tainted[str]
#   - taint-sink enforcement: a tainted key passed to env_set_var
#     is a compile error (verified separately via the fail_*.hls file).
#
# All output is deterministic in the FACTS printed (booleans, exit
# codes, env var values we set ourselves). The cwd value depends on
# where the demo is run from; the demo prints it via taint_unwrap
# (we accept the risk — the demo runs locally). The argv[0] value
# differs between interpreter (the .hls file path) and native (the
# executable path) — so the demo does NOT print argv[0]; it only
# prints the ARGUMENT COUNT (deterministic).

import "std.env"
import "std.option"
import "std.taint"
import "std.str"

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------

fn bool_str(b: bool) -> str {
    if b {
        return "true"
    }
    return "false"
}

# ----------------------------------------------------------------------------
# Demo 1: env_var — read HOME (Some) and a missing var (None).
# ----------------------------------------------------------------------------

fn demo_env_var() -> void uses IO, Proc {
    println("--- env_var (HOME + missing var) ---")
    let home: Option[tainted[str]] = env_var("HOME")
    let home_present: bool = match home {
        Option.Some(_) => true,
        Option.None => false
    }
    println("  HOME exists: " + bool_str(home_present))
    if home_present {
        let home_val: tainted[str] = match home {
            Option.Some(h) => h,
            Option.None => panic("unreachable")
        }
        # The HOME variable is the user's own — we accept the risk
        # of untainting (the demo runs locally; a real program would
        # sanitize before using it as a path).
        println("  HOME = " + taint_unwrap(home_val))
    }
    let missing: Option[tainted[str]] = env_var("HL_NOT_SET_VAR_XYZ_48")
    let missing_is_none: bool = match missing {
        Option.Some(_) => false,
        Option.None => true
    }
    println("  HL_NOT_SET_VAR_XYZ_48 is None: " + bool_str(missing_is_none))
    println("")
}

# ----------------------------------------------------------------------------
# Demo 2: env_set_var + env_var — set a custom var, read it back.
# ----------------------------------------------------------------------------

fn demo_set_var() -> void uses IO, Proc {
    println("--- env_set_var + env_var (round-trip) ---")
    env_set_var("HL_DEMO_48", "hello from Halis")
    let v: Option[tainted[str]] = env_var("HL_DEMO_48")
    let val: str = match v {
        Option.Some(s) => taint_unwrap(s),
        Option.None => panic("HL_DEMO_48 not set after env_set_var")
    }
    println("  HL_DEMO_48 = '" + val + "'")
    println("")
}

# ----------------------------------------------------------------------------
# Demo 3: env_unset_var — unset the var, verify it's gone.
# ----------------------------------------------------------------------------

fn demo_unset_var() -> void uses IO, Proc {
    println("--- env_unset_var (verify gone) ---")
    env_unset_var("HL_DEMO_48")
    let v: Option[tainted[str]] = env_var("HL_DEMO_48")
    let is_none: bool = match v {
        Option.Some(_) => false,
        Option.None => true
    }
    println("  HL_DEMO_48 is None after unset: " + bool_str(is_none))
    println("")
}

# ----------------------------------------------------------------------------
# Demo 4: env_current_dir — read the cwd.
# The cwd is tainted by default (it may be sensitive). The demo
# untaints it (the demo runs locally; a real program would sanitize
# before printing or using it as a path).
# ----------------------------------------------------------------------------

fn demo_current_dir() -> void uses IO, Proc {
    println("--- env_current_dir (read cwd) ---")
    let cwd: tainted[str] = env_current_dir()
    println("  cwd = " + taint_unwrap(cwd))
    println("")
}

# ----------------------------------------------------------------------------
# Demo 5: env_set_current_dir — round-trip to /tmp and back.
# We save the current cwd, cd to /tmp, verify, then cd back.
# The "back" step uses the saved cwd (tainted) — we taint_unwrap it
# because the demo runs locally; a real program would sanitize.
# ----------------------------------------------------------------------------

fn demo_set_current_dir() -> void uses IO, Proc {
    println("--- env_set_current_dir (round-trip to /tmp) ---")
    let saved: tainted[str] = env_current_dir()
    let rc1: int = env_set_current_dir("/tmp")
    println("  cd /tmp rc = " + rc1.to_str())
    let in_tmp: tainted[str] = env_current_dir()
    println("  now in " + taint_unwrap(in_tmp))
    let rc2: int = env_set_current_dir(taint_unwrap(saved))
    println("  cd back rc = " + rc2.to_str())
    let restored: tainted[str] = env_current_dir()
    println("  now in " + taint_unwrap(restored))
    println("")
}

# ----------------------------------------------------------------------------
# Demo 6: env_args_os — read argv as list[tainted[str]].
# We print the COUNT (deterministic — the demo is run with no extra
# args, so argc = 1) and the FIRST ARGUMENT (tainted by default —
# we taint_unwrap it because the demo runs locally; a real program
# would sanitize). The actual argv[0] value differs between
# interpreter and native, so we DON'T print it — we just verify
# the count.
# ----------------------------------------------------------------------------

fn demo_args_os() -> void uses IO, Proc {
    println("--- env_args_os (argv count) ---")
    let args: list[tainted[str]] = env_args_os()
    println("  argc = " + args.len().to_str())
    # Verify each arg is tainted (would be a compile error to pass
    # to a taint sink without untainting). We taint_unwrap the first
    # arg here because the demo runs locally; we accept the risk.
    # We DO NOT print the argv[0] value because it differs between
    # interpreter (the .hls file path) and native (the executable
    # path) — instead we verify a property of it (starts with the
    # expected prefix).
    if args.len() > 0 {
        let arg0: str = taint_unwrap(args.get(0))
        # Find the basename (chars after the last '/'). HLS does not
        # have str_rfind; we walk the string to find the last slash.
        let mut last_slash: int = -1
        let mut i: int = 0
        while i < arg0.len() {
            if arg0.byte_at(i) == 47 {
                last_slash = i
            }
            i = i + 1
        }
        # Use a mutable base; if there's no slash, base = arg0,
        # else base = arg0 after the last slash.
        let mut base: str = arg0
        if last_slash >= 0 {
            base = arg0.slice(last_slash + 1, arg0.len())
        }
        # The basename should start with "env_demo" (both interpreter
        # and native — interpreter's argv[0] is "env_demo.hls", native's
        # is "env_demo"; both start with "env_demo").
        let starts_with_env_demo: bool = base.len() >= 8
            && base.slice(0, 8) == "env_demo"
        println("  argv[0] basename starts with 'env_demo': "
                + bool_str(starts_with_env_demo))
    }
    println("")
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Proc {
    println("=== Stage 48: std.env ===")
    println("")
    demo_env_var()
    demo_set_var()
    demo_unset_var()
    demo_current_dir()
    demo_set_current_dir()
    demo_args_os()
    println("=== Stage 48 demo complete ===")
    return 0
}
