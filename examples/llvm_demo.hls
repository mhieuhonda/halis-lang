# Stage 12 demo — the LLVM IR text backend.
#
# Run:
#   python3 boot/boot.py --emit llvm examples/llvm_demo.hls
#   python3 boot/boot.py --emit llvm --target aarch64-linux examples/llvm_demo.hls
#
# The emitted LLVM IR text can be assembled by `llc` or `clang` into a
# native binary (Stage 12 release target — the runtime glue code is not
# yet wired into the LLVM backend).

fn add(a: int, b: int) -> int {
    return a + b
}

fn main() -> int uses IO {
    let x: int = 7
    let y: int = 11
    let z: int = add(x, y)
    println("7 + 11 = " + z.to_str())
    return 0
}
