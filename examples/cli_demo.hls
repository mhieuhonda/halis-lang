# examples/cli_demo.hls — Stage 53 (v0.72.0-alpha): std.cli demo.
#
# This demo exercises every feature of std.cli:
#   - bool flag (verbose, -v)
#   - int option with default (port, -p)
#   - str option with default (host)
#   - str option without default (config)
#   - float option (timeout)
#   - str positional (input, required)
#   - env-var fallback (PORT env var -> port)
#   - subcommands (init, build)
#   - --help / -h
#   - --version / -V
#   - -- end-of-options marker
#
# The demo RUNS the parser against SYNTHETIC argv lists (not the real
# process argv) so the output is deterministic and differential-safe
# (interpreter == native). The "real argv" path is shown in the
# cli_parse_from_args entry point, but not exercised here (the demo
# would have to set env vars and pass real argv, which differs between
# interpreter and native runs).

import "std.cli"
import "std.str"

# ----------------------------------------------------------------------------
# Build the demo parser.
# ----------------------------------------------------------------------------

fn build_parser() -> CliParser {
    let p0: CliParser = cli_parser_new("cli_demo", "1.0.0")
    let p1: CliParser = cli_parser_desc(p0, "Demo of std.cli (Stage 53)")
    let p2: CliParser = cli_parser_after_help(p1,
        "EXAMPLES:\n    cli_demo -v --port=8080 myfile.txt\n    cli_demo init\n    cli_demo build --release")
    let p3: CliParser = cli_parser_flag(p2, "verbose", "v", "Enable verbose output")
    let p4: CliParser = cli_parser_int_opt(p3, "port", "p", "Port number", false, 8080)
    let p5: CliParser = cli_parser_str_opt(p4, "host", "h", "Host to bind", false, "localhost")
    let p6: CliParser = cli_parser_str_opt_no_default(p5, "config", "c", "Config file", false)
    let p7: CliParser = cli_parser_float_opt(p6, "timeout", "t", "Timeout in seconds", false, 30.0)
    let p8: CliParser = cli_parser_str_positional(p7, "input", "Input file", false)
    let p9: CliParser = cli_parser_env(p8, "port", "PORT")
    let p10: CliParser = cli_parser_subcommand(p9, "init", "Initialize a new project")
    let p11: CliParser = cli_parser_subcommand(p10, "build", "Build the project")
    return p11
}

# ----------------------------------------------------------------------------
# Run a single parse case and print the outcome.
# ----------------------------------------------------------------------------

fn print_result(label: str, p: CliParser, argv: list[str]) -> void uses Proc, IO {
    println("--- " + label + " ---")
    println("$ " + p.name + " " + cli_join_argv(argv))
    let r: CliResult = cli_parse(p, argv)
    if r.help_requested {
        println("(help requested)")
        cli_print_help(p)
        return
    }
    if r.version_requested {
        println("(version requested)")
        cli_print_version(p)
        return
    }
    if !r.ok {
        println("ERROR: " + r.error)
        println("")
        return
    }
    if r.subcommand != "" {
        println("subcommand: " + r.subcommand)
        let rem: list[str] = cli_remaining_args(r)
        let mut i: int = 0
        while i < rem.len() {
            println("  remaining[" + i.to_str() + "] = " + rem.get(i))
            i = i + 1
        }
        return
    }
    if cli_has(r, "verbose") {
        println("verbose = " + cli_get_bool(r, "verbose").to_str())
    } else {
        println("verbose = (default) false")
    }
    println("port = " + cli_get_int(r, "port").to_str())
    println("host = " + cli_get_str(r, "host"))
    println("timeout = " + cli_get_float(r, "timeout").to_str())
    if cli_has(r, "config") {
        println("config = " + cli_get_str(r, "config"))
    } else {
        println("config = (not set)")
    }
    if cli_has(r, "input") {
        println("input = " + cli_get_str(r, "input"))
    } else {
        println("input = (not set)")
    }
    println("")
}

# cli_join_argv — join an argv list into a shell-style command line.
fn cli_join_argv(argv: list[str]) -> str {
    let parts: list[str] = []
    # Skip argv[0] (program name) — it's already in p.name.
    let mut i: int = 1
    while i < argv.len() {
        parts.push(argv.get(i))
        i = i + 1
    }
    return str_join(parts, " ")
}

# ----------------------------------------------------------------------------
# Main — run several parse cases.
# ----------------------------------------------------------------------------

fn main() -> int uses Args, Proc, IO {
    let p: CliParser = build_parser()

    println("=== Stage 53: std.cli demo ===")
    println("")

    # Case 1: typical invocation — flag + option + positional.
    let argv1: list[str] = ["cli_demo", "-v", "--port=9000", "myfile.txt"]
    print_result("Case 1: typical invocation", p, argv1)

    # Case 2: short option with separate value.
    let argv2: list[str] = ["cli_demo", "-p", "3000", "--host", "0.0.0.0", "data.csv"]
    print_result("Case 2: short option with separate value", p, argv2)

    # Case 3: defaults (only the positional).
    let argv3: list[str] = ["cli_demo", "input.txt"]
    print_result("Case 3: defaults (only positional)", p, argv3)

    # Case 4: --help.
    let argv4: list[str] = ["cli_demo", "--help"]
    print_result("Case 4: --help", p, argv4)

    # Case 5: -V (version).
    let argv5: list[str] = ["cli_demo", "-V"]
    print_result("Case 5: -V (version)", p, argv5)

    # Case 6: subcommand "init".
    let argv6: list[str] = ["cli_demo", "init"]
    print_result("Case 6: subcommand init", p, argv6)

    # Case 7: subcommand "build" with extra args.
    let argv7: list[str] = ["cli_demo", "build", "--release", "--target=wasm32"]
    print_result("Case 7: subcommand build with extra args", p, argv7)

    # Case 8: -- end-of-options marker.
    let argv8: list[str] = ["cli_demo", "--", "--weird-filename"]
    print_result("Case 8: -- end-of-options", p, argv8)

    # Case 9: invalid int value (type-safe rejection).
    let argv9: list[str] = ["cli_demo", "--port=abc", "input.txt"]
    print_result("Case 9: invalid int (type-safe rejection)", p, argv9)

    # Case 10: unknown option.
    let argv10: list[str] = ["cli_demo", "--unknown", "input.txt"]
    print_result("Case 10: unknown option", p, argv10)

    # Case 11: float value.
    let argv11: list[str] = ["cli_demo", "--timeout", "5.5", "input.txt"]
    print_result("Case 11: float value", p, argv11)

    # Case 12: option with =value for short.
    let argv12: list[str] = ["cli_demo", "-p=4000", "input.txt"]
    print_result("Case 12: short option with =value", p, argv12)

    println("ACCEPTANCE OK: Stage 53 — std.cli demo")
    return 0
}
