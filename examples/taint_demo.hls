# ============================================================================
# taint_demo.hls — Stage 10-alpha: taint tracking & sanitization
# ----------------------------------------------------------------------------
# Demonstrates the new (v0.7.0-alpha) taint-tracking system. Run with:
#     python3 boot/boot.py examples/taint_demo.hls "argument one" "argument two"
#
# The program:
#   1. Wraps each command-line argument as `tainted[str]` via tainted_args().
#   2. Tries (and shows the alternative) to use them safely — sanitizing
#      before each sink.
#   3. Demonstrates the pure-query helpers (no untaint) for routing.
#   4. Shows each sanitizer (HTML, path, SQL identifier, SQL string,
#      shell command, filename).
# ============================================================================

import "std.sanitize"
import "std.taint"

fn main() -> int uses Args, IO {
    let argv: list[tainted[str]] = tainted_args()
    println("=== Taint demo (Stage 10-alpha) ===")
    println("argc: " + argv.len().to_str())

    # Print each argv element. We can't pass `tainted[str]` to println —
    # must sanitize first. We use sanitize_command because shell-safe is
    # the strictest filter; HTML/path/filename would all work for stdout.
    println("")
    println("--- argv (sanitized for stdout via sanitize_command) ---")
    let mut i: int = 1
    while i < argv.len() {
        let cleaned: str = sanitize_command(argv.get(i))
        println("  argv[" + i.to_str() + "]: " + cleaned)
        i = i + 1
    }

    # Pure-query helpers: routing on a tainted value without untainting.
    if argv.len() > 1 {
        println("")
        println("--- routing on tainted argv[1] (pure query, no untaint) ---")
        if taint_check_equals(argv.get(1), "admin") {
            println("  -> admin route")
        } else if taint_check_starts_with(argv.get(1), "/api/") {
            println("  -> api route")
        } else {
            println("  -> default route")
        }
    }

    # Sanitizers at work.
    println("")
    println("--- sanitizers ---")
    let html_in: tainted[str] = taint_mark("<b>hi & bye</b>")
    println("html_escape(\"<b>hi & bye</b>\") = " + sanitize_html(html_in))

    let path_in: tainted[str] = taint_mark("data/safe.txt")
    println("sanitize_path(\"data/safe.txt\") = " + sanitize_path(path_in))

    let sql_in: tainted[str] = taint_mark("users")
    println("sanitize_sql_identifier(\"users\") = " + sanitize_sql_identifier(sql_in))

    let lit_in: tainted[str] = taint_mark("it's quoted")
    println("sanitize_sql_string(\"it's quoted\") = " + sanitize_sql_string(lit_in))

    let cmd_in: tainted[str] = taint_mark("hello")
    println("sanitize_command(\"hello\") = " + sanitize_command(cmd_in))

    let fname_in: tainted[str] = taint_mark("report-2026.txt")
    println("sanitize_filename(\"report-2026.txt\") = " + sanitize_filename(fname_in))

    return 0
}
