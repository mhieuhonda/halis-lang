# reverify_demo.hls — Stage 108: memory-safety re-verification under
# -O fast (proof replay). The tool (tools/hls-reverify.py) re-derives
# every elided check's proof on the OPTIMISED IR. This demo pins the
# ARITHMETIC the replay is made of, as checkable numbers: the interval
# algebra the law reasons over, the widening that keeps loop analysis
# sound, the four replay answers, and the invariant that a proof that
# survives its own transformations is the only proof worth carrying.

fn iv_add(lo_a: int, hi_a: int, lo_b: int, hi_b: int) -> list[int] pure {
    # the interval ADD the replay imports from boot.proof: [a]+[b] =
    # [lo_a + lo_b, hi_a + hi_b] (the top element -1 stands for an
    # unbounded side in the demo's encoding)
    let out: list[int] = [lo_a + lo_b, hi_a + hi_b]
    return out
}

fn iv_mul_const(lo: int, hi: int, k: int) -> list[int] pure {
    # conservative corner product against a non-negative constant
    let p1: int = lo * k
    let p2: int = hi * k
    return[p1, p2]
}

fn fits(lo: int, hi: int) -> bool pure {
    # int64 containment — both bounds KNOWN, else the answer is no
    # (TOP never fits: the deep-scan-10 soundness rule)
    if lo < -9223372036854775808 {
        return false
    }
    if hi > 9223372036854775807 {
        return false
    }
    return true
}

fn ovf_provable(lo_a: int, hi_a: int, lo_b: int, hi_b: int) -> bool pure {
    let sum_lo: list[int] = iv_add(lo_a, hi_a, lo_b, hi_b)
    return fits(sum_lo.get(0), sum_lo.get(1))
}

fn excludes_zero(lo: int, hi: int) -> bool pure {
    # the divisor rule: 0 provably OUTSIDE [lo, hi]
    if hi < 0 {
        return true
    }
    if lo > 0 {
        return true
    }
    return false
}

fn bnd_provable(idx_lo: int, idx_hi: int, minlen: int) -> bool pure {
    # the two bounds routes collapsed to their numeric core:
    # the index must sit in [0, minlen)
    if idx_lo < 0 {
        return false
    }
    return idx_hi < minlen
}

fn widen(lo_a: int, hi_a: int, lo_b: int, hi_b: int) -> list[int] pure {
    # the interval JOIN: min of los, max of his — None wins, encoded
    # here as -1 for +unbounded
    let mut lo: int = lo_a
    if lo_b < lo {
        lo = lo_b
    }
    let mut hi: int = hi_a
    if hi == -1 || hi_b == -1 {
        hi = -1
    } else {
        if hi_b > hi {
            hi = hi_b
        }
    }
    return[lo, hi]
}

fn widen_growth(old_hi: int, new_hi: int) -> int pure {
    # the widening operator: a bound that GREW escapes to infinity
    # (this is what makes loop analysis converge, and what keeps it
    # sound — a growing bound is never clamped back)
    if new_hi > old_hi {
        return -1
    }
    return old_hi
}

fn replay_class(proven_before: bool, survives: bool, proven_after: bool) -> int pure {
    # THE LAW, as arithmetic: 0 replayed, 1 lost-proof (fail),
    # 2 replayed-checked, 3 eliminated (vacuous)
    if proven_before {
        if survives {
            if proven_after {
                return 0
            }
            return 1
        }
        return 3
    }
    if survives {
        return 2
    }
    return 3
}

fn main() -> int uses IO {
    # the interval algebra
    let s1: list[int] = iv_add(0, 99, 1, 1)
    println("iv_add [0,99]+[1,1] = [" + s1.get(0).to_str() + "," + s1.get(1).to_str() + "]")

    # overflow provability at the int64 edges
    let near_top: bool = ovf_provable(9223372036854775806, 9223372036854775806, 1, 1)
    let ok_top: bool = ovf_provable(9223372036854775806, 9223372036854775806, 0, 0)
    println("ovf max-1 + 1 provable=" + near_top.to_str() + " max-1 + 0 provable=" + ok_top.to_str())

    # the multiplication corners the annotator is allowed to certify
    let m1: list[int] = iv_mul_const(3, 7, 0)
    let m2: list[int] = iv_mul_const(3, 7, 2)
    println("mul by 0 = [" + m1.get(0).to_str() + "," + m1.get(1).to_str() + "] mul by 2 = [" + m2.get(0).to_str() + "," + m2.get(1).to_str() + "]")

    # the divisor rule and the MIN/-1 corner
    println("div excludes_zero [-5,-1]=" + excludes_zero(-5, -1).to_str()
    + " [-1,1]=" + excludes_zero(-1, 1).to_str()
    + " [1,64]=" + excludes_zero(1, 64).to_str())

    # the bounds routes
    println("bnd i in [0,63] len>=64 provable=" + bnd_provable(0, 63, 64).to_str()
    + " i in [0,64] provable=" + bnd_provable(0, 64, 64).to_str())

    # the join and the widening
    let j: list[int] = widen(0, 3, 2, -1)
    println("join [0,3] [2,+inf) = [" + j.get(0).to_str() + "," + j.get(1).to_str() + "]")
    println("widen_growth 3->7 escapes=" + widen_growth(3, 7).to_str()
    + " 7->7 stays=" + widen_growth(7, 7).to_str())

    # the law, all four answers
    println("law proven/survives/reproves=" + replay_class(true, true, true).to_str()
    + " proven/lost=" + replay_class(true, true, false).to_str()
    + " checked/survives=" + replay_class(false, true, false).to_str()
    + " eliminated=" + replay_class(true, false, false).to_str())

    # the invariant the whole stage stands on: every claim the seed
    # prover signed must re-derive on the transformed program — here,
    # the signed arithmetic itself re-derives
    let a: int = iv_add(0, 9223372036854775806, 1, 0).get(1)
    println("replayed hi = " + a.to_str())
    return 0
}
