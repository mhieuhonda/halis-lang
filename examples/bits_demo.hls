# examples/bits_demo.hls — demonstrate std.bits (non-roadmap upgrade).
#
# Builds a tiny bit-packed buffer from a list of small integers
# (each < 16, so 4 bits each) and reads them back. Also shows the
# logical / arithmetic shift difference on a negative value.
#
# Run:  python3 boot/boot.py examples/bits_demo.hls

import "std.bits"
import "std.str"

# Pack a list of nibbles (each in [0, 15]) into a single int64
# (big-endian: first nibble occupies the highest 4 bits). Panics
# if the list has more than 16 entries (64 / 4) or any value is
# out of range.
fn pack_nibbles(xs: list[int]) -> int {
    if xs.len() > 16 {
        panic("pack_nibbles: list too long (max 16 nibbles = 64 bits)")
    }
    let mut r: int = 0
    let mut i: int = 0
    while i < xs.len() {
        let n: int = xs.get(i)
        if n < 0 || n > 15 {
            panic("pack_nibbles: nibble out of range (must be 0..15)")
        }
        # Shift r left by 4 and OR in the nibble. Use bits_or /
        # bits_shl to demonstrate the std.bits API (instead of
        # the arithmetic `r * 16 + n` which would also work).
        r = bits_or(bits_shl(r, 4), n)
        i = i + 1
    }
    return r
}

# Unpack a 64-bit value into 16 nibbles, big-endian.
fn unpack_nibbles(packed: int) -> list[int] {
    let out: list[int] = []
    let mut i: int = 0
    while i < 16 {
        # Extract nibble (15 - i) — big-endian, so the first nibble
        # is the highest 4 bits.
        let shift: int = (15 - i) * 4
        let nib: int = bits_and(bits_shr(packed, shift), 15)
        out.push(nib)
        i = i + 1
    }
    return out
}

fn main() -> int uses IO {
    let xs: list[int] = [1, 2, 3, 10, 15, 0, 7, 8]
    let packed: int = pack_nibbles(xs)
    println("packed = " + packed.to_str())
    let back: list[int] = unpack_nibbles(packed)
    # The first 8 nibbles round-trip; the remaining 8 are zero (the
    # packer left-pads with zeros via the bits_or identity).
    let mut i: int = 0
    let s: list[str] = []
    while i < back.len() {
        s.push(back.get(i).to_str())
        i = i + 1
    }
    println("unpacked = [" + str_join(s, ", ") + "]")

    # Show logical vs arithmetic shift on a negative value.
    let neg: int = -1024
    println("-1024 >> 4 (logical)      = " + bits_shr(neg, 4).to_str())
    println("-1024 >> 4 (arithmetic)   = " + bits_sar(neg, 4).to_str())
    println("-1024 popcount           = " + bits_popcount(neg).to_str())
    println("-1024 leading zeros      = " + bits_clz(neg).to_str())
    println("-1024 trailing zeros     = " + bits_ctz(neg).to_str())

    # Byte extraction (big-endian view of a 64-bit value).
    let bytes: list[int] = bits_bytes_be(packed)
    let bs: list[str] = []
    let mut j: int = 0
    while j < bytes.len() {
        let b: int = bytes.get(j)
        # Print each byte as a 2-digit hex via bits_and / bits_shr.
        let hi: int = bits_shr(b, 4)
        let lo: int = bits_and(b, 15)
        let hex_hi: str = chr("0123456789ABCDEF".byte_at(hi))
        let hex_lo: str = chr("0123456789ABCDEF".byte_at(lo))
        bs.push(hex_hi + hex_lo)
        j = j + 1
    }
    println("packed hex (big-endian)  = " + str_join(bs, " "))
    return 0
}
