# ownership_demo.hls — Stage 8-alpha ownership primitives
# Demonstrates drop(), clone(), and take() — see SPEC.md section 16.

fn consume(s: str) -> int {
    return s.len()
}

fn make_list() -> list[int] {
    return [1, 2, 3, 4, 5]
}

fn main() -> int uses IO {
    # 1. clone() — independent copy
    let xs: list[int] = [10, 20, 30]
    let ys: list[int] = clone(xs)
    ys.push(40)                # only ys changes
    println("xs.len=" + xs.len().to_str() + " ys.len=" + ys.len().to_str())  # 3 4

    # 2. take() — transfer ownership; the original binding becomes unusable
    let s1: str = "hello hieu"
    let n: int = consume(take(s1))
    println("consumed=" + n.to_str())    # consumed=10

    # 3. drop() — release a resource explicitly
    let buf: str = read_file("examples/data.txt")
    println("buf.len=" + buf.len().to_str())
    drop(buf)                  # explicit release; buf is now moved

    # 4. drop + reassign pattern (mut + revive)
    let mut s2: str = "first"
    drop(s2)
    s2 = "second"              # binding is revived — fresh ownership
    println("s2=" + s2)

    # 5. clone of struct
    return 0
}
