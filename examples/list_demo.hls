import "std.list"
import "std.str"

fn main() -> int uses IO {
    println("=== Reverse ===")
    let xs: list[int] = [1, 2, 3, 4, 5]
    let r: list[int] = list_reverse_int(xs)
    let mut i: int = 0
    while i < r.len() {
        print(r.get(i).to_str() + " ")
        i = i + 1
    }
    println("")

    println("")
    println("=== Contains / Index of ===")
    let words: list[str] = ["hieu", "louis", "lang"]
    println("contains 'louis': " + list_contains_str(words, "louis").to_str())
    println("contains 'rust':  " + list_contains_str(words, "rust").to_str())
    println("index of 'lang':   " + list_index_of_str(words, "lang").to_str())

    println("")
    println("=== Max / Min / Sort ===")
    let nums: list[int] = [42, 7, 19, 99, 3, 56]
    println("max: " + list_max_int(nums).to_str())
    println("min: " + list_min_int(nums).to_str())
    let asc: list[int] = list_sort_int_asc(nums)
    let mut j: int = 0
    print("asc:  ")
    while j < asc.len() {
        print(asc.get(j).to_str() + " ")
        j = j + 1
    }
    println("")

    println("")
    println("=== Concat / Take / Drop ===")
    let a: list[int] = [1, 2, 3]
    let b: list[int] = [4, 5, 6]
    let cat: list[int] = list_concat_int(a, b)
    print("concat: ")
    let mut k: int = 0
    while k < cat.len() {
        print(cat.get(k).to_str() + " ")
        k = k + 1
    }
    println("")
    let t: list[int] = list_take_int(cat, 4)
    print("take 4: ")
    let mut m: int = 0
    while m < t.len() {
        print(t.get(m).to_str() + " ")
        m = m + 1
    }
    println("")
    let d: list[int] = list_drop_int(cat, 4)
    print("drop 4: ")
    let mut p: int = 0
    while p < d.len() {
        print(d.get(p).to_str() + " ")
        p = p + 1
    }
    println("")

    println("")
    println("=== Dedup ===")
    let sorted: list[int] = [1, 1, 2, 3, 3, 3, 4, 5, 5]
    let dedup: list[int] = list_dedup_sorted_int(sorted)
    print("dedup: ")
    let mut q: int = 0
    while q < dedup.len() {
        print(dedup.get(q).to_str() + " ")
        q = q + 1
    }
    println("")
    return 0
}
