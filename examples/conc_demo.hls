# conc_demo.hls — Stage 16 (v0.27.0-alpha): concurrency overview.
#
# The three primitives:
#   spawn(f, args)  -> Task[R]   start a task, join it later
#   Chan[T]                       message-passing channel (MPMC, FIFO)
#   select(list[Chan[T]]) -> int  wait for the first ready channel
#
# Data-race freedom is STATIC: sharing a variable with a task outside a
# channel is a compile error — pass clone(x) or take(x) instead.

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn worker(job: int, req: Chan[int], rep: Chan[int]) -> int uses Conc {
    let answer: int = fib(job)
    rep.send(answer)
    return req.recv()
}

fn main() -> int uses IO, Conc {
    # 1. spawn + join: the task's return value comes back through join().
    let t: Task[int] = spawn(fib, 25)
    let r: int = t.join()
    println("fib(25) = " + r.to_str())

    # 2. Channels: request/reply between main and a worker task.
    let req: Chan[int] = chan_new()
    let rep: Chan[int] = chan_new()
    let w: Task[int] = spawn(worker, 20, clone(req), clone(rep))
    req.send(0)
    let answer: int = rep.recv()
    println("worker computed fib(20) = " + answer.to_str())
    req.send(1)
    let status: int = w.join()
    println("worker exited with status " + status.to_str())

    # 3. select: wait on several channels at once.
    let fast: Chan[str] = chan_new()
    let slow: Chan[str] = chan_new()
    fast.send("from-fast")
    slow.send("from-slow")
    let both: list[Chan[str]] = [fast, slow]
    let idx: int = select(both)
    let m1: str = fast.recv()
    let m2: str = slow.recv()
    println("select picked channel " + idx.to_str() + ": " + m1 + " / " + m2)
    return 0
}
