# examples/http_router_demo.hls — Stage 63 (v0.78.0-alpha):
# std.http_router demo.
#
# This demo exercises every feature of std.http_router:
#   - Router builder (router_new + get/post/put/delete/patch/head/
#     options/any + use_mw/use_for + mount)
#   - impl Router method twins (.get(...).post(...).use_mw(...).mount(...))
#   - Path parameters (/users/:id — captured into params map)
#   - Wildcard segments (/files/*path — captures the rest of the path)
#   - Multiple params in one pattern (/users/:id/posts/:pid)
#   - Query parameters (parsed from ?a=1&b=2)
#   - Middleware chains (global + prefix-scoped; onion-model merging
#     between parent and sub-routers)
#   - Sub-routers (mount one router under a prefix; nested arbitrarily)
#   - router_url_for — reverse routing (handler_id + params -> URL)
#   - router_list_routes — human-readable route listing
#   - router_dispatch (impl method) — same as router_match
#
# The demo simulates a small REST API:
#   GET  /              -> index page
#   GET  /users         -> list users
#   POST /users         -> create user
#   GET  /users/:id     -> get user by id
#   PUT  /users/:id     -> update user
#   DELETE /users/:id   -> delete user
#   GET  /files/*path   -> serve static files
#   /api/v1/*           -> mounted sub-router (REST API v1)
#   /api/v1/admin/*     -> mounted sub-sub-router (admin endpoints)
#
# The demo also includes a HANDLER DISPATCHER (the function the user
# writes — `dispatch_handler(match, request) -> HttpResponse`) that
# shows how to convert a RouterMatch into an actual HTTP response. This
# is the bridge between std.http_router (pure dispatcher) and
# std.http (the request/response types).

import "std.http_router"
import "std.http"
import "std.str"

# ----------------------------------------------------------------------------
# Build the demo router — a small REST API.
# ----------------------------------------------------------------------------

# Sub-sub-router for /api/v1/admin (admin-only endpoints).
fn build_admin_router() -> Router {
    return router_new()
        .get("/stats", 31)              # GET /api/v1/admin/stats
        .get("/users", 32)              # GET /api/v1/admin/users (list all)
        .use_mw(300)                    # admin-auth middleware
}

# Sub-router for /api/v1 (REST API v1).
fn build_api_v1_router() -> Router {
    return router_new()
        .get("/users", 21)              # GET /api/v1/users
        .get("/users/:id", 22)          # GET /api/v1/users/:id
        .post("/users", 23)             # POST /api/v1/users
        .get("/health", 24)             # GET /api/v1/health
        .mount("/admin", build_admin_router())
        .use_mw(200)                    # api-auth middleware
}

# Top-level router.
fn build_demo_router() -> Router {
    return router_new()
        .get("/", 1)                    # GET /
        .get("/users", 2)               # GET /users
        .post("/users", 3)              # POST /users
        .get("/users/:id", 4)           # GET /users/:id
        .put("/users/:id", 5)           # PUT /users/:id
        .delete("/users/:id", 6)        # DELETE /users/:id
        .get("/files/*path", 7)         # GET /files/*path (static files)
        .any("/healthz", 8)             # ANY /healthz (liveness probe)
        .mount("/api/v1", build_api_v1_router())
        .use_mw(100)                    # logging middleware (global)
        .use_for(101, "/api")           # api-rate-limit middleware
}

# ----------------------------------------------------------------------------
# Demo 1 — list every route.
# ----------------------------------------------------------------------------

fn demo_list_routes() -> void uses IO {
    let r: Router = build_demo_router()
    println("Routes:")
    println(router_list_routes(r))
}

# ----------------------------------------------------------------------------
# Demo 2 — dispatch several requests, show the match + the response.
# ----------------------------------------------------------------------------

# Dispatch a single request and print the match + response.
fn demo_dispatch(method: str, path: str) -> void uses IO {
    let r: Router = build_demo_router()
    let m: RouterMatch = router_match(r, method, path)
    println("")
    println("  " + method + " " + path)
    if !m.found {
        println("    -> 404 Not Found (no route matched)")
        println("    middleware: " + man_int_list_str(m.middleware_ids))
        return
    }
    println("    -> handler " + m.handler_id.to_str())
    # Show the params (if any).
    let keys: list[str] = m.params.keys()
    if keys.len() > 0 {
        let mut i: int = 0
        let parts: list[str] = []
        while i < keys.len() {
            let k: str = keys.get(i)
            let v: str = m.params.get_or(k, "")
            parts.push(k + "=" + v)
            i = i + 1
        }
        println("    params: " + str_join(parts, ", "))
    }
    # Show the query (if any).
    let qkeys: list[str] = m.query.keys()
    if qkeys.len() > 0 {
        let mut i: int = 0
        let parts: list[str] = []
        while i < qkeys.len() {
            let k: str = qkeys.get(i)
            let v: str = m.query.get_or(k, "")
            parts.push(k + "=" + v)
            i = i + 1
        }
        println("    query: " + str_join(parts, ", "))
    }
    # Show the middleware chain.
    println("    middleware: " + man_int_list_str(m.middleware_ids))
    # Dispatch to the actual handler (the bridge to std.http).
    let resp: HttpResponse = dispatch_handler(m)
    println("    response: " + resp.status.to_str() + " " + resp.reason)
    if resp.body.len() > 0 && resp.body.len() < 200 {
        println("    body: " + resp.body)
    } else if resp.body.len() >= 200 {
        println("    body: (" + resp.body.len().to_str() + " bytes)")
    }
}

# man_int_list_str — render a list[int] as "[1, 2, 3]".
# (Named man_ for historical reasons — this demo's helpers were
# adapted from the std.man demo.)
fn man_int_list_str(xs: list[int]) -> str {
    if xs.len() == 0 {
        return "[]"
    }
    let parts: list[str] = []
    let mut i: int = 0
    while i < xs.len() {
        parts.push(xs.get(i).to_str())
        i = i + 1
    }
    return "[" + str_join(parts, ", ") + "]"
}

# ----------------------------------------------------------------------------
# dispatch_handler — the bridge between std.http_router (pure
# dispatcher) and std.http (the request/response types).
#
# Given a RouterMatch (with found=true and a handler_id), invoke the
# actual handler function. This is the function the user writes — the
# router itself doesn't know about HttpResponse (it's a pure
# dispatcher).
#
# The middleware chain (match.middleware_ids) is NOT invoked here —
# this is just the handler. In a real server, the user's main() would
# invoke each middleware in turn BEFORE calling dispatch_handler; if
# any middleware returns a non-None response, the chain short-circuits
# and dispatch_handler is NOT called.
# ----------------------------------------------------------------------------

fn dispatch_handler(m: RouterMatch) -> HttpResponse {
    # The handler_id dispatch — the user writes a `match` on the ID.
    if !m.found {
        return http_text_response(404, "Not Found")
    }
    if m.handler_id == 1 {
        return http_html_response(200, "<h1>Welcome</h1><p>Try <a href=\"/users\">/users</a></p>")
    }
    if m.handler_id == 2 {
        # GET /users — list users.
        return http_json_response(200, "[{\"id\":1,\"name\":\"alice\"},{\"id\":2,\"name\":\"bob\"}]")
    }
    if m.handler_id == 3 {
        # POST /users — create user.
        return http_json_response(201, "{\"id\":3,\"name\":\"new\"}")
    }
    if m.handler_id == 4 {
        # GET /users/:id — get user by id.
        let id: str = m.params.get_or("id", "")
        return http_json_response(200, "{\"id\":" + id + ",\"name\":\"user" + id + "\"}")
    }
    if m.handler_id == 5 {
        # PUT /users/:id — update user.
        return http_text_response(200, "updated")
    }
    if m.handler_id == 6 {
        # DELETE /users/:id — delete user.
        return http_text_response(204, "")
    }
    if m.handler_id == 7 {
        # GET /files/*path — serve static files (simulated).
        let path: str = m.params.get_or("path", "")
        return http_text_response(200, "serving file: " + path)
    }
    if m.handler_id == 8 {
        # ANY /healthz — liveness probe.
        return http_text_response(200, "ok")
    }
    if m.handler_id == 21 {
        # GET /api/v1/users.
        return http_json_response(200, "[{\"id\":1},{\"id\":2}]")
    }
    if m.handler_id == 22 {
        # GET /api/v1/users/:id.
        let id: str = m.params.get_or("id", "")
        return http_json_response(200, "{\"id\":" + id + "}")
    }
    if m.handler_id == 23 {
        # POST /api/v1/users.
        return http_json_response(201, "{\"id\":3}")
    }
    if m.handler_id == 24 {
        # GET /api/v1/health.
        return http_json_response(200, "{\"status\":\"ok\"}")
    }
    if m.handler_id == 31 {
        # GET /api/v1/admin/stats.
        return http_json_response(200, "{\"users\":100,\"requests\":5000}")
    }
    if m.handler_id == 32 {
        # GET /api/v1/admin/users.
        return http_json_response(200, "[{\"id\":1,\"admin\":true}]")
    }
    return http_text_response(500, "no handler for id " + m.handler_id.to_str())
}

# ----------------------------------------------------------------------------
# Demo 3 — router_url_for (reverse routing).
# ----------------------------------------------------------------------------

fn demo_url_for() -> void uses IO {
    let r: Router = build_demo_router()
    println("")
    println("--- router_url_for (reverse routing) ---")
    let p1: map[str, str] = map_new()
    p1.set("id", "42")
    println("  url_for(handler=4, {id:42})    = " + router_url_for(r, 4, p1))
    let p2: map[str, str] = map_new()
    p2.set("id", "42")
    p2.set("pid", "99")
    # Note: route 4 is /users/:id, not /users/:id/posts/:pid. The demo
    # doesn't register the multi-param route at the top level, so we
    # show url_for on a single-param route and a wildcard route instead.
    println("  url_for(handler=4, {id:42})    = " + router_url_for(r, 4, p1))
    let p3: map[str, str] = map_new()
    p3.set("path", "css/main.css")
    println("  url_for(handler=7, {path:css/main.css}) = " + router_url_for(r, 7, p3))
    # Sub-router url_for.
    let p4: map[str, str] = map_new()
    p4.set("id", "42")
    println("  url_for(handler=22, {id:42})   = " + router_url_for(r, 22, p4)
        + " (sub-router prefix prepended)")
}

# ----------------------------------------------------------------------------
# Demo 4 — pattern compilation (showing the compiled segments).
# ----------------------------------------------------------------------------

fn demo_compile_pattern() -> void uses IO {
    println("")
    println("--- router_compile_pattern (compiled segments) ---")
    let patterns: list[str] = [
        "/",
        "/users",
        "/users/:id",
        "/users/:id/posts/:pid",
        "/files/*path",
        "/api/*",
    ]
    let mut i: int = 0
    while i < patterns.len() {
        let p: str = patterns.get(i)
        let segs: list[RouteSegment] = router_compile_pattern(p)
        let parts: list[str] = []
        let mut j: int = 0
        while j < segs.len() {
            let s: RouteSegment = segs.get(j)
            let mut kind_str: str = ""
            if s.kind == router_seg_literal() {
                kind_str = "Lit"
            } else if s.kind == router_seg_param() {
                kind_str = "Param"
            } else {
                kind_str = "Wild"
            }
            parts.push(kind_str + "(" + s.value + ")")
            j = j + 1
        }
        println("  " + p + " -> [" + str_join(parts, ", ") + "]")
        i = i + 1
    }
}

# ----------------------------------------------------------------------------
# Main — run all demos.
# ----------------------------------------------------------------------------

fn main() -> int uses IO {
    println("=== Stage 63 (v0.78.0-alpha): std.http_router — HTTP routing ===")
    println("")
    demo_list_routes()
    println("")
    println("--- dispatch (match + handler invocation) ---")
    demo_dispatch("GET", "/")
    demo_dispatch("GET", "/users")
    demo_dispatch("GET", "/users/42")
    demo_dispatch("POST", "/users")
    demo_dispatch("PUT", "/users/42")
    demo_dispatch("DELETE", "/users/42")
    demo_dispatch("GET", "/files/css/main.css")
    demo_dispatch("GET", "/healthz")
    demo_dispatch("POST", "/healthz")  # ANY route — matches POST too
    demo_dispatch("GET", "/users/42?tab=profile&format=json")
    demo_dispatch("GET", "/api/v1/users")
    demo_dispatch("GET", "/api/v1/users/42")
    demo_dispatch("GET", "/api/v1/admin/stats")
    demo_dispatch("GET", "/nonexistent")
    demo_url_for()
    demo_compile_pattern()
    println("")
    println("ACCEPTANCE OK: Stage 63 — std.http_router demo runs clean.")
    return 0
}
