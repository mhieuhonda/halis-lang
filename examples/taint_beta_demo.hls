# ============================================================================
# taint_beta_demo.hls — Stage 10-beta: read_file_tainted + extended audit
# ----------------------------------------------------------------------------
# Demonstrates the new (v0.8.0-alpha) Stage 10-beta taint-tracking
# features. Run with:
#     python3 boot/boot.py examples/taint_beta_demo.hls examples/data.txt
#
# The program:
#   1. Reads the contents of a file via the new read_file_tainted() builtin
#      (Stage 10-beta's second taint source, alongside tainted_args()).
#   2. Shows that the file content is tainted[str] and cannot be passed
#      directly to a sink (println) — must be sanitised first.
#   3. Uses the new taint_concat / taint_concat_clean / taint_check_byte_at
#      helpers from std.taint (BUG-6 fix added these).
#   4. Demonstrates the extended `--audit` output (run `make audit
#      F=examples/taint_beta_demo.hls` to see the taint-flow section).
# ============================================================================

import "std.sanitize"
import "std.taint"

fn main() -> int uses Args, Fs, IO {
    # Stage 10-beta: read_file_tainted returns tainted[str].
    let argv: list[str] = args()
    if argv.len() < 2 {
        println("usage: taint_beta_demo.hls <path>")
        return 1
    }
    let path: str = argv.get(1)
    let content: tainted[str] = read_file_tainted(path)
    println("=== Stage 10-beta taint demo ===")
    println("file: " + path)
    println("bytes: " + taint_check_len(content).to_str())

    # Pure-query helpers on the tainted file content.
    if taint_check_is_empty(content) {
        println("(file is empty)")
        return 0
    }

    # taint_check_byte_at — pure byte-at-index query.
    let first: int = taint_check_byte_at(content, 0)
    println("first byte ASCII: " + first.to_str())

    # taint_concat_clean — prepend a clean literal; the result REMAINS
    # tainted (cannot be passed to a sink without sanitising).
    let decorated: tainted[str] = taint_concat_clean(content, " <<END")
    println("decorated length: " + taint_check_len(decorated).to_str())

    # Sanitize the content for stdout via sanitize_html (works for
    # newlines and other non-HTML-metacharacter content).
    let safe: str = sanitize_html(content)
    println("--- file content (sanitized for stdout via sanitize_html) ---")
    println(safe)

    # Show the new audit info — the `--audit` flag now prints which
    # functions call read_file_tainted and each taint sink.
    return 0
}
