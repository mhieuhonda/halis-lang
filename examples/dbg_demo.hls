# examples/dbg_demo.hls — Stage 96 (v0.115.0-alpha)
# The debug-info demo: three functions on stable lines, so the
# `--debug` #line mapping and the `--symbols` manifest have concrete
# facts to be checked against — the DWARF 5 line table names THIS file
# at these lines, and the manifest's function rows carry this file
# with each fn's own line. Integer-only and IO-free by design: the
# same program compiles hosted (exit 42) and into the bare-metal
# image (`hlc --target x86_64-unknown-none`).

fn mix(a: int, b: int) -> int {
    let mut acc: int = a * 7
    acc = acc + b
    return acc
}

fn gcd(x: int, y: int) -> int {
    let mut a: int = x
    let mut b: int = y
    while b != 0 {
        let t: int = a % b
        a = b
        b = t
    }
    return a
}

fn main() -> int {
    let m: int = mix(6, 0)
    let g: int = gcd(1071, 462)
    if g == 21 && m == 42 {
        return 42
    }
    return 1
}
