# primes.hls — Sieve of Eratosthenes: lists, nested loops
fn sieve(n: int) -> list[int] {
    let flags: list[bool] = []
    let mut i: int = 0
    while i < n {
        flags.push(i >= 2)
        i = i + 1
    }
    let primes: list[int] = []
    let mut p: int = 2
    while p < n {
        if flags.get(p) {
            primes.push(p)
            let mut multiple: int = p * p
            while multiple < n {
                flags.set(multiple, false)
                multiple = multiple + p
            }
        }
        p = p + 1
    }
    return primes
}

fn main() -> int uses IO {
    let primes: list[int] = sieve(100)
    println("Primes < 100:")
    let mut i: int = 0
    while i < primes.len() {
        print(primes.get(i).to_str() + " ")
        i = i + 1
    }
    println("")
    println("total: " + primes.len().to_str() + " primes")
    return 0
}
