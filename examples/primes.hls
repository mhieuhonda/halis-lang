# primes.hls — sang Eratosthenes: danh sach, vong lap long
fn sang(n: int) -> list[int] {
    let flags: list[bool] = []
    let mut i: int = 0
    while i < n {
        flags.push(i >= 2)
        i = i + 1
    }
    let kq: list[int] = []
    let mut p: int = 2
    while p < n {
        if flags.get(p) {
            kq.push(p)
            let mut boi: int = p * p
            while boi < n {
                flags.set(boi, false)
                boi = boi + p
            }
        }
        p = p + 1
    }
    return kq
}

fn main() -> int uses IO {
    let cac_so: list[int] = sang(100)
    println("Cac so nguyen to < 100:")
    let mut i: int = 0
    while i < cac_so.len() {
        print(cac_so.get(i).to_str() + " ")
        i = i + 1
    }
    println("")
    println("tong cong: " + cac_so.len().to_str() + " so")
    return 0
}
