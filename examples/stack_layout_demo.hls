# stack_layout_demo.hls — Stage 30 (v0.47.0-alpha)
#
# Boxed-vs-stack layout analysis (escape analysis). A list[T] binding
# (T = int / float / bool) whose every use stays inside its creating
# function is allocated ON THE C STACK as a typed array: zero heap
# objects, zero refcount traffic. #[stack] turns the compiler's proof
# into a compile-time GUARANTEE (an escaping use is a compile error);
# #[boxed] forces the ordinary refcounted heap layout.
#
# This demo shows:
#   1. #[stack] forced (fib-style sliding window)   — stack, forced
#   2. an un-annotated escape-free list             — stack, automatic
#   3. an un-annotated list that escapes (returned) — heap (fallback)
#   4. #[boxed] on an escape-free list              — heap, forced
#   5. index syntax xs[i] and for-in on stack lists
#
# Run:   python3 boot/boot.py examples/stack_layout_demo.hls
# Report: bin/hlc --opt-stats examples/stack_layout_demo.hls /tmp/s.c
#   -> "list layout decisions (Stage 30)" table shows each binding's
#      layout (STACK / BOXED / HEAP), capacity and the reason.

# 1. #[stack] forced: every use below is a borrow-safe .get/.set
#    receiver, so the checker PROVES the window never outlives this
#    frame. Try adding `return window` or calling `sum(window)` —
#    the compiler rejects the program and names the escape site.
fn fib_stack(n: int) -> int {
    #[stack]
    let window: list[int] = [0, 1]
    let mut i: int = 0
    while i < n {
        let next: int = window.get(0) + window.get(1)
        window.set(0, window.get(1))
        window.set(1, next)
        i = i + 1
    }
    return window.get(0)
}

# 2. Automatic: no attribute at all. The escape analysis sees every
#    use is in-frame (index reads/writes, .len, for-in) and picks the
#    stack layout by itself. Boxed elements would cost 1 struct + 1
#    items buffer + 6 boxed ints = 8 heap objects here; the stack
#    layout costs 0.
fn poly_eval(x: int) -> int {
    # coefficients of 3x^2 + 2x + 1, evaluated by Horner's rule
    let coeffs: list[int] = [3, 2, 1]
    let mut acc: int = 0
    let mut i: int = 0
    while i < coeffs.len() {
        acc = acc * x + coeffs[i]
        i = i + 1
    }
    return acc
}

# 3. Escaping (returned): the list leaves the function, so the
#    analysis keeps the ordinary refcounted heap layout. No attribute
#    needed — the fallback is automatic and silent.
fn make_table(n: int) -> list[int] {
    let mut xs: list[int] = [0, 1, 2]
    xs.set(0, n)
    return xs
}

# 4. #[boxed] forced: even though this binding never escapes, the
#    user pinned it to the heap layout (e.g. to keep the refcounted
#    representation for future growth via push).
fn boxed_demo() -> int {
    #[boxed]
    let xs: list[int] = [10, 20, 30]
    let mut t: int = 0
    for v: int in xs {
        t = t + v
    }
    return t
}

# 5. for-in over a stack list + a float window, to show the typed
#    arrays work for every primitive element type.
fn sum_parts() -> str {
    let parts: list[float] = [0.25, 0.5, 0.25]
    let mut total: float = 0.0
    for p: float in parts {
        total = total + p
    }
    let flags: list[bool] = [true, false, true]
    let mut any_on: bool = false
    for f: bool in flags {
        any_on = any_on || f
    }
    return total.to_str() + "," + any_on.to_str()
}

fn main() -> int uses IO {
    println("[1] #[stack] forced   : fib_stack(40) = " + fib_stack(40).to_str())
    println("[2] auto (escape-free): poly_eval(5)  = " + poly_eval(5).to_str())
    let table: list[int] = make_table(42)
    println("[3] escaping -> heap  : table.get(0)  = " + table.get(0).to_str()
    + " (len " + table.len().to_str() + ")")
    println("[4] #[boxed] forced   : boxed_demo()  = " + boxed_demo().to_str())
    println("[5] for-in + floats   : sum_parts()   = " + sum_parts())
    println("")
    println("See the per-binding decisions with:")
    println("    bin/hlc --opt-stats examples/stack_layout_demo.hls /tmp/s.c")
    return 0
}
