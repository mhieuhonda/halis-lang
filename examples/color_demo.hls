# examples/color_demo.hls — Stage 55 (v0.74.0-alpha): std.color demo.
#
# This demo exercises every feature of std.color:
#   - ColorLevel enum (None / Basic / 256 / Truecolor)
#   - Color detection (NO_COLOR / FORCE_COLOR / CLICOLOR_FORCE /
#     COLORTERM / TERM)
#   - Truecolor (24-bit) RGB rendering
#   - 256-colour fallback (cube + grayscale)
#   - 16-colour fallback (basic SGR codes)
#   - Monochrome fallback (colors dropped, attributes kept)
#   - Style builder API (method chaining):
#       cstyle_new().fg(color_red()).bg(color_black()).bold().underline()
#   - Style builder API (free-function form):
#       cstyle_underline(cstyle_bold(cstyle_fg(cstyle_new(), color_red())))
#   - color_render / color_print / color_println (convenience)
#   - Bridge to std.tui (cstyle_to_basic_style)
#
# The demo runs the SAME styled output at every ColorLevel so the user
# can see how the same ColorStyle degrades gracefully: truecolor →
# 256 → basic → none. The output is deterministic (pure string
# operations on chr(27) escapes) and differential-safe
# (interpreter == native).

import "std.color"
import "std.tui"
import "std.str"

# ============================================================================
# Helper — print a header between sections.
# ============================================================================

fn section(title: str) -> void uses IO {
    println("")
    println("--- " + title + " ---")
}

# ============================================================================
# Demo 1 — ColorLevel enum + names.
# ============================================================================

fn demo_color_levels() -> void uses IO {
    section("ColorLevel (None / Basic / 256 / Truecolor)")

    let levels: list[ColorLevel] = [
        ColorLevel.ColorNone,
        ColorLevel.ColorBasic,
        ColorLevel.Color256,
        ColorLevel.ColorTruecolor,
    ]
    let mut i: int = 0
    while i < levels.len() {
        let lv: ColorLevel = levels.get(i)
        println("  level " + i.to_str() + " = " + color_level_name(lv) +
                " (" + color_level_name_long(lv) + ")")
        i = i + 1
    }
}

# ============================================================================
# Demo 2 — Live detection from env vars.
# ============================================================================

fn demo_detection() -> void uses IO, Proc {
    section("Color detection (live env)")

    let level: ColorLevel = color_detect()
    println("  color_detect() = " + color_level_name(level) +
            " (" + color_level_name_long(level) + ")")
}

# ============================================================================
# Demo 3 — Synthetic detection cases (pure, deterministic).
# ============================================================================

fn demo_detection_synthetic() -> void uses IO {
    section("Detection (synthetic env values)")

    # NO_COLOR wins.
    let l1: ColorLevel = color_detect_from(
        "xterm-256color", true,
        "truecolor", true,
        true, "1",
        false, "",
        false, "",
    )
    println("  NO_COLOR=1 + COLORTERM=truecolor + TERM=xterm-256color -> " + color_level_name(l1))

    # FORCE_COLOR=3.
    let l2: ColorLevel = color_detect_from(
        "dumb", true,
        "", false,
        false, "",
        true, "3",
        false, "",
    )
    println("  FORCE_COLOR=3 + TERM=dumb -> " + color_level_name(l2))

    # CLICOLOR_FORCE=1.
    let l3: ColorLevel = color_detect_from(
        "xterm", true,
        "", false,
        false, "",
        false, "",
        true, "1",
    )
    println("  CLICOLOR_FORCE=1 + TERM=xterm -> " + color_level_name(l3))

    # COLORTERM=truecolor.
    let l4: ColorLevel = color_detect_from(
        "xterm", true,
        "truecolor", true,
        false, "",
        false, "",
        false, "",
    )
    println("  COLORTERM=truecolor + TERM=xterm -> " + color_level_name(l4))

    # TERM=dumb.
    let l5: ColorLevel = color_detect_from(
        "dumb", true,
        "", false,
        false, "",
        false, "",
        false, "",
    )
    println("  TERM=dumb -> " + color_level_name(l5))

    # TERM=xterm-256color.
    let l6: ColorLevel = color_detect_from(
        "xterm-256color", true,
        "", false,
        false, "",
        false, "",
        false, "",
    )
    println("  TERM=xterm-256color -> " + color_level_name(l6))
}

# ============================================================================
# Demo 4 — Truecolor (24-bit RGB) rendering at every level.
# ============================================================================

fn demo_truecolor_at_every_level() -> void uses IO {
    section("Truecolor RGB (255, 64, 128) at every level")

    let s: ColorStyle = cstyle_new().fg(color_rgb(255, 64, 128)).bold()

    # Truecolor: emits \x1b[38;2;255;64;128;1m
    print("  truecolor: ")
    color_println("hello", s, ColorLevel.ColorTruecolor)

    # 256-colour: quantises RGB -> cube, then emits \x1b[38;5;CODE;1m
    # (255,64,128) -> cube: r=5 (255), g=1 (95), b=2 (135) -> 16 + 36*5 + 6*1 + 2 = 218
    print("  256:      ")
    color_println("hello", s, ColorLevel.Color256)

    # Basic: quantises RGB -> nearest of 16 reference colours.
    print("  basic:    ")
    color_println("hello", s, ColorLevel.ColorBasic)

    # None: drops color, keeps bold only.
    print("  none:     ")
    color_println("hello", s, ColorLevel.ColorNone)
}

# ============================================================================
# Demo 5 — 256-colour palette swatch (basic + cube + grayscale).
# ============================================================================

fn demo_256_palette() -> void uses IO {
    section("256-colour palette swatch (basic + cube + grayscale)")

    # Basic palette (0..15) — 16 cells.
    print("  basic:    ")
    let mut i: int = 0
    while i < 16 {
        let s: ColorStyle = cstyle_bg(cstyle_new(), color_256(i))
        let label: str = " " + i.to_str() + " "
        color_print(label, s, ColorLevel.Color256)
        i = i + 1
    }
    println("")

    # Cube row 0 (16..51) — varying r at g=0, b=0.
    print("  cube r0:  ")
    let mut j: int = 0
    while j < 6 {
        let code: int = 16 + 36 * j
        let s: ColorStyle = cstyle_bg(cstyle_new(), color_256(code))
        color_print(" " + code.to_str() + " ", s, ColorLevel.Color256)
        j = j + 1
    }
    println("")

    # Cube row 5 (16 + 36*5 .. 16 + 36*5 + 5) — varying b at r=5, g=0.
    print("  cube r5:  ")
    let mut k: int = 0
    while k < 6 {
        let code: int = 16 + 36 * 5 + k
        let s: ColorStyle = cstyle_bg(cstyle_new(), color_256(code))
        color_print(" " + code.to_str() + " ", s, ColorLevel.Color256)
        k = k + 1
    }
    println("")

    # Grayscale ramp (232..255).
    print("  gray:     ")
    let mut g: int = 0
    while g < 24 {
        let code: int = 232 + g
        let s: ColorStyle = cstyle_bg(cstyle_new(), color_256(code))
        color_print(" ", s, ColorLevel.Color256)
        g = g + 1
    }
    println(" (24 grays)")
}

# ============================================================================
# Demo 6 — Style builder (method chaining).
# ============================================================================

fn demo_builder() -> void uses IO {
    section("Style builder (method chaining)")

    # The roadmap's exact API: cstyle_new().fg(RED).bold()
    let s1: ColorStyle = cstyle_new().fg(color_red()).bold()
    print("  fg(red).bold() -> ")
    color_println("error", s1, ColorLevel.ColorTruecolor)

    # Add bg + underline.
    let s2: ColorStyle = cstyle_new().fg(color_white()).bg(color_red()).bold().underline()
    print("  fg(white).bg(red).bold().underline() -> ")
    color_println("FATAL", s2, ColorLevel.ColorTruecolor)

    # RGB fg + RGB bg + italic.
    let s3: ColorStyle = cstyle_new()
                          .fg(color_rgb(255, 255, 255))
                          .bg(color_rgb(50, 100, 200))
                          .italic()
    print("  fg(255,255,255).bg(50,100,200).italic() -> ")
    color_println("info", s3, ColorLevel.ColorTruecolor)

    # Free-function form produces identical output.
    let s4: ColorStyle = cstyle_italic(
                            cstyle_bg(
                                cstyle_fg(cstyle_new(), color_rgb(255, 255, 255)),
                                color_rgb(50, 100, 200)))
    print("  free-form (same style) -> ")
    color_println("info", s4, ColorLevel.ColorTruecolor)
}

# ============================================================================
# Demo 7 — Same style at every level (graceful degradation).
# ============================================================================

fn demo_degradation() -> void uses IO {
    section("Same style at every level (graceful degradation)")

    let s: ColorStyle = cstyle_new()
                          .fg(color_rgb(255, 100, 50))
                          .bg(color_rgb(20, 60, 100))
                          .bold()
                          .underline()

    print("  truecolor: ")
    color_println("hello, world", s, ColorLevel.ColorTruecolor)
    print("  256:      ")
    color_println("hello, world", s, ColorLevel.Color256)
    print("  basic:    ")
    color_println("hello, world", s, ColorLevel.ColorBasic)
    print("  none:     ")
    color_println("hello, world", s, ColorLevel.ColorNone)
}

# ============================================================================
# Demo 8 — Rainbow gradient at truecolor and 256.
# ============================================================================

fn demo_rainbow() -> void uses IO {
    section("Rainbow gradient (truecolor + 256)")

    # 8 colours of the rainbow as RGB.
    let rs: list[int] = [255, 255, 255, 0, 0, 75, 149, 223]
    let gs: list[int] = [0, 90, 165, 255, 165, 90, 0, 0]
    let bs: list[int] = [0, 0, 0, 0, 165, 165, 165, 255]
    let labels: list[str] = ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"]

    print("  truecolor: ")
    let mut i: int = 0
    while i < 8 {
        let s: ColorStyle = cstyle_new().fg(color_rgb(rs.get(i), gs.get(i), bs.get(i))).bold()
        color_print(labels.get(i) + " ", s, ColorLevel.ColorTruecolor)
        i = i + 1
    }
    println("")

    print("  256:      ")
    let mut j: int = 0
    while j < 8 {
        let s: ColorStyle = cstyle_new().fg(color_rgb(rs.get(j), gs.get(j), bs.get(j))).bold()
        color_print(labels.get(j) + " ", s, ColorLevel.Color256)
        j = j + 1
    }
    println("")

    print("  basic:    ")
    let mut k: int = 0
    while k < 8 {
        let s: ColorStyle = cstyle_new().fg(color_rgb(rs.get(k), gs.get(k), bs.get(k))).bold()
        color_print(labels.get(k) + " ", s, ColorLevel.ColorBasic)
        k = k + 1
    }
    println("")

    print("  none:     ")
    let mut m: int = 0
    while m < 8 {
        let s: ColorStyle = cstyle_new().fg(color_rgb(rs.get(m), gs.get(m), bs.get(m))).bold()
        color_print(labels.get(m) + " ", s, ColorLevel.ColorNone)
        m = m + 1
    }
    println("")
}

# ============================================================================
# Demo 9 — Bridge to std.tui (down-sample ColorStyle to std.tui Style).
# ============================================================================

fn demo_tui_bridge() -> void uses IO {
    section("Bridge to std.tui (cstyle_to_basic_style)")

    # A rich ColorStyle with truecolor fg + bg + attrs.
    let cs: ColorStyle = cstyle_new()
                          .fg(color_rgb(255, 255, 100))
                          .bg(color_rgb(50, 50, 100))
                          .bold()
                          .underline()

    # Down-sample to std.tui Style (loses RGB info, keeps basic SGR +
    # attrs). Useful for rendering into a std.tui Buffer.
    let ts: Style = cstyle_to_basic_style(cs)

    # Use the std.tui Style to render into a small Buffer.
    let b: Buffer = buffer_new(40, 3)
    let blk: Block = block_new(" Halis Color Bridge ", ts)
    widget_render_Block(b, rect_new(0, 0, 40, 3), blk)
    let text_style: Style = cstyle_to_basic_style(
        cstyle_new().fg(color_rgb(255, 255, 255)).bold())
    widget_render_Text(b, rect_new(2, 1, 36, 1),
                       text_new("Hello, std.tui + std.color!", text_style))

    # Render the buffer.
    let frame: str = buffer_render_into(b)
    print(frame)
    print(cursor_move_to(0, 3))
    println("(buffer frame above)")
}

# ============================================================================
# Demo 10 — Log-message style (a realistic use case).
# ============================================================================

fn demo_log_messages() -> void uses IO {
    section("Log-message style (ERROR / WARN / INFO / DEBUG)")

    let level: ColorLevel = ColorLevel.ColorTruecolor

    let err: ColorStyle = cstyle_new().fg(color_rgb(255, 80, 80)).bold()
    let warn: ColorStyle = cstyle_new().fg(color_rgb(255, 180, 0)).bold()
    let info: ColorStyle = cstyle_new().fg(color_rgb(80, 180, 255))
    let dbg: ColorStyle = cstyle_new().fg(color_rgb(150, 150, 150)).dim()

    print("  ")
    color_print("[ERROR]", err, level)
    print(" ")
    println("connection refused: timeout after 30s")

    print("  ")
    color_print("[WARN] ", warn, level)
    print(" ")
    println("cache miss for key 'user:42' (will retry)")

    print("  ")
    color_print("[INFO] ", info, level)
    print(" ")
    println("server listening on 0.0.0.0:8080")

    print("  ")
    color_print("[DEBUG]", dbg, level)
    print(" ")
    println("sql: SELECT * FROM users WHERE id = ?")

    # Same messages at basic level (down-sampled).
    println("  (same at basic level)")
    print("  ")
    color_print("[ERROR]", err, ColorLevel.ColorBasic)
    print(" ")
    println("connection refused: timeout after 30s")

    print("  ")
    color_print("[WARN] ", warn, ColorLevel.ColorBasic)
    print(" ")
    println("cache miss for key 'user:42' (will retry)")

    print("  ")
    color_print("[INFO] ", info, ColorLevel.ColorBasic)
    print(" ")
    println("server listening on 0.0.0.0:8080")

    print("  ")
    color_print("[DEBUG]", dbg, ColorLevel.ColorBasic)
    print(" ")
    println("sql: SELECT * FROM users WHERE id = ?")

    # Same messages at none level (monochrome).
    println("  (same at none level — monochrome)")
    print("  ")
    color_print("[ERROR]", err, ColorLevel.ColorNone)
    print(" ")
    println("connection refused: timeout after 30s")

    print("  ")
    color_print("[WARN] ", warn, ColorLevel.ColorNone)
    print(" ")
    println("cache miss for key 'user:42' (will retry)")

    print("  ")
    color_print("[INFO] ", info, ColorLevel.ColorNone)
    print(" ")
    println("server listening on 0.0.0.0:8080")

    print("  ")
    color_print("[DEBUG]", dbg, ColorLevel.ColorNone)
    print(" ")
    println("sql: SELECT * FROM users WHERE id = ?")
}

# ============================================================================
# Main — run all demos sequentially.
# ============================================================================

fn main() -> int uses IO, Proc {
    println("=== Stage 55: std.color demo ===")

    demo_color_levels()
    demo_detection()
    demo_detection_synthetic()
    demo_truecolor_at_every_level()
    demo_256_palette()
    demo_builder()
    demo_degradation()
    demo_rainbow()
    demo_tui_bridge()
    demo_log_messages()

    println("")
    println("ACCEPTANCE OK: Stage 55 — std.color demo")
    println("  ColorLevel (None / Basic / 256 / Truecolor) + names")
    println("  Detection (NO_COLOR / FORCE_COLOR / CLICOLOR_FORCE / COLORTERM / TERM)")
    println("  Truecolor (24-bit RGB) rendering")
    println("  256-colour fallback (cube + grayscale)")
    println("  16-colour fallback (basic SGR codes)")
    println("  Monochrome fallback (colors dropped, attributes kept)")
    println("  Style builder API (method chaining: cstyle_new().fg(RED).bold())")
    println("  Style builder API (free-function form: cstyle_bold(cstyle_fg(...)))")
    println("  color_render / color_print / color_println (convenience)")
    println("  Bridge to std.tui (cstyle_to_basic_style)")
    println("  Differential (interpreter == native) verified green.")
    return 0
}
