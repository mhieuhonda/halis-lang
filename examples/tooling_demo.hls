# examples/tooling_demo.hls — Stage 14 demo: lint-friendly + format-stable.
#
# This file is formatted with `hlfmt` and passes `hllint` with no
# warnings. Run:
#
#   python3 tools/hlfmt.py -c examples/tooling_demo.hls   # exit 0
#   python3 tools/hllint.py examples/tooling_demo.hls     # no warnings
#   python3 tools/hls-lsp.py --check examples/tooling_demo.hls

fn helper(x: int) -> int {
    return x * 2
}

fn main() -> int uses IO {
    let a: int = 5
    let b: int = helper(a)
    println("a + b = " + (a + b).to_str())
    return 0
}
