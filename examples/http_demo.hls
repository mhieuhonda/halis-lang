# http_demo.hls — Stage 38 (v0.57.0-alpha): std.http module demo.
#
# This demo shows the std.http API:
#   HttpRequest / HttpResponse / HttpHeader structs
#   http_parse_request / http_parse_response (RFC 7230)
#   http_serialize_request / http_serialize_response
#   http_get (client)
#   http_serve (server, single-connection)
#   http_text_response / http_html_response / http_json_response
#
# The demo runs entirely on loopback (no real network) so it's safe
# to run in any environment. It:
#   1. Parses a sample HTTP request and prints the fields.
#   2. Serialises an HTTP response and prints the wire format.
#   3. Spawns a tiny HTTP server on 127.0.0.1:19090.
#   4. Calls http_get against the server, prints the response.
#   5. Verifies http_status_text for common codes.

import "std.http"
import "std.net"
import "std.str"
import "std.option"
import "std.result"

# ============================================================================
# Section 1: Parse a sample request.
# ============================================================================

fn section_parse() -> int uses IO {
    println("=== Parse ===")
    let raw: str = "GET /api/users?id=42 HTTP/1.1" + http_crlf()
        + "Host: api.example.com" + http_crlf()
        + "User-Agent: halis-demo/1.0" + http_crlf()
        + "Accept: application/json" + http_crlf()
        + http_crlf()
    let r: Result[HttpRequest, str] = http_parse_request(raw)
    if !result_is_ok(r) {
        println("parse failed: " + result_err_or(r, ""))
        return 1
    }
    let req: HttpRequest = result_unwrap(r)
    println("method:  " + req.method)
    println("path:    " + req.path)
    println("version: " + req.version)
    println("headers: " + req.headers.len().to_str())
    let mut i: int = 0
    while i < req.headers.len() {
        let h: HttpHeader = req.headers.get(i)
        println("  " + h.name + ": " + h.value)
        i = i + 1
    }
    println("body:    '" + req.body + "'")
    return 0
}

# ============================================================================
# Section 2: Serialise a response.
# ============================================================================

fn section_serialize() -> int uses IO {
    println("=== Serialize ===")
    let resp: HttpResponse = http_html_response(200,
        "<html><body><h1>Hello, Halis!</h1></body></html>")
    let wire: str = http_serialize_response(resp)
    println("--- wire format ---")
    # Print the wire format with visible CRLFs (replace with CRLF<-
    # would be ideal; for the demo we just print it raw, which the
    # terminal renders with newlines).
    println(wire)
    println("--- end wire ---")
    return 0
}

# ============================================================================
# Section 3: http_get + http_serve (loopback).
# ============================================================================

fn demo_server(port: int) -> int uses IO, Net {
    return http_serve("127.0.0.1", port, 1)
}

fn section_get_serve() -> int uses IO, Net, Conc {
    println("=== http_get + http_serve ===")
    let port: int = 19090
    let server_task: Task[int] = spawn(demo_server, port)
    let mut resp_body: str = ""
    let mut attempts: int = 0
    while attempts < 50 {
        let r: Result[HttpResponse, str] = http_get("127.0.0.1", port, "/hello")
        if result_is_ok(r) {
            let resp: HttpResponse = result_unwrap(r)
            if resp.status == 200 {
                resp_body = resp.body
                break
            }
        }
        attempts = attempts + 1
    }
    let _rc: int = server_task.join()
    if resp_body.len() == 0 {
        println("http_get failed after " + attempts.to_str() + " attempts")
        return 1
    }
    println("response body:")
    println(resp_body)
    return 0
}

# ============================================================================
# Section 4: http_status_text reference.
# ============================================================================

fn section_status_codes() -> int uses IO {
    println("=== Status codes ===")
    let codes: list[int] = [200, 201, 204, 301, 302, 304, 400, 401, 403, 404, 405, 408, 409, 410, 411, 413, 414, 415, 429, 431, 500, 501, 502, 503, 504, 505]
    let mut i: int = 0
    while i < codes.len() {
        let c: int = codes.get(i)
        println("  " + c.to_str() + " " + http_status_text(c))
        i = i + 1
    }
    return 0
}

# ============================================================================
# Main.
# ============================================================================

fn main() -> int uses IO, Net, Conc {
    if section_parse() != 0 { return 1 }
    if section_serialize() != 0 { return 2 }
    if section_get_serve() != 0 { return 3 }
    if section_status_codes() != 0 { return 4 }
    println("ALL HTTP DEMO TESTS PASSED")
    return 0
}
