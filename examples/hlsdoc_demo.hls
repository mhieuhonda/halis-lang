# examples/hlsdoc_demo.hls — Stage 61 (v0.82.0-alpha): std.hlsdoc demo.
#
# This demo exercises the rustdoc-style API docs generator:
#   - hlsdoc_parse_module — parse HLS source into a DocModule.
#   - hlsdoc_render_html — render as a complete HTML page.
#   - hlsdoc_render_summary — plain-text summary.
#   - hlsdoc_render_search_index — JSON search index.
#   - hlsdoc_write_html / hlsdoc_write_search_index — write to disk.
#
# The demo parses a small HLS module and renders it as HTML, writing
# the result to /tmp/hlsdoc_demo.html. The HTML has cross-references,
# section headers, a search box, and an embedded vanilla-JS search.

import "std.hlsdoc"
import "std.str"

# ----------------------------------------------------------------------------
# Build a demo HLS source string.
# ----------------------------------------------------------------------------

fn build_demo_source() -> str {
    let src: str = "# std.demo — a demo module for std.hlsdoc.\n" +
        "# This module shows the doc-comment convention: lines starting\n" +
        "# with '# ' above a declaration form the doc comment.\n\n" +
        "# Add two integers.\n" +
        "# Returns the sum.\n" +
        "# See [sub] for subtraction.\n" +
        "fn add(a: int, b: int) -> int {\n" +
        "    return a + b\n" +
        "}\n\n" +
        "# Subtract b from a.\n" +
        "# See [add] for addition.\n" +
        "fn sub(a: int, b: int) -> int {\n" +
        "    return a - b\n" +
        "}\n\n" +
        "# A user record.\n" +
        "## Fields\n" +
        "# name — the user's display name.\n" +
        "# age — the user's age in years.\n" +
        "struct User {\n" +
        "    name: str,\n" +
        "    age: int,\n" +
        "}\n\n" +
        "# An option type (generic).\n" +
        "enum Option[T] {\n" +
        "    Some(T),\n" +
        "    None\n" +
        "}\n\n" +
        "# impl User block.\n" +
        "impl User {\n" +
        "    fn greet(self: User) -> str {\n" +
        "        return self.name\n" +
        "    }\n" +
        "}\n"
    return src
}

# ----------------------------------------------------------------------------
# Demo 1 — parse + summary.
# ----------------------------------------------------------------------------

fn demo_parse_summary() -> void uses IO {
    let src: str = build_demo_source()
    let m: DocModule = hlsdoc_parse_module("std.demo", src)
    println("--- hlsdoc_parse_module + hlsdoc_render_summary ---")
    println(hlsdoc_render_summary(m))
}

# ----------------------------------------------------------------------------
# Demo 2 — render HTML + write to disk.
# ----------------------------------------------------------------------------

fn demo_render_html() -> void uses IO, Fs {
    let src: str = build_demo_source()
    let m: DocModule = hlsdoc_parse_module("std.demo", src)
    hlsdoc_write_html(m, "/tmp/hlsdoc_demo.html")
    hlsdoc_write_search_index(m, "/tmp/hlsdoc_demo_search.json")
    println("")
    println("--- hlsdoc_render_html + hlsdoc_write_html ---")
    println("Wrote /tmp/hlsdoc_demo.html (" + hlsdoc_render_html(m).len().to_str() + " bytes)")
    println("Wrote /tmp/hlsdoc_demo_search.json (" + hlsdoc_render_search_index(m).len().to_str() + " bytes)")
    println("")
    # Print the first 20 lines of the HTML.
    let html: str = hlsdoc_render_html(m)
    let lines: list[str] = html.split("\n")
    let mut i: int = 0
    while i < lines.len() && i < 20 {
        println(lines.get(i))
        i = i + 1
    }
    if lines.len() > 20 {
        println("... (" + (lines.len() - 20).to_str() + " more lines)")
    }
}

# ----------------------------------------------------------------------------
# Demo 3 — search index (JSON).
# ----------------------------------------------------------------------------

fn demo_search_index() -> void uses IO {
    let src: str = build_demo_source()
    let m: DocModule = hlsdoc_parse_module("std.demo", src)
    println("")
    println("--- hlsdoc_render_search_index (JSON) ---")
    println(hlsdoc_render_search_index(m))
}

# ----------------------------------------------------------------------------
# Main — run all demos.
# ----------------------------------------------------------------------------

fn main() -> int uses IO, Fs {
    println("=== Stage 61 (v0.82.0-alpha): std.hlsdoc — rustdoc-style API docs ===")
    demo_parse_summary()
    demo_render_html()
    demo_search_index()
    println("")
    println("ACCEPTANCE OK: Stage 61 — std.hlsdoc demo runs clean.")
    println("  Open /tmp/hlsdoc_demo.html in a browser to see the rendered docs.")
    return 0
}
