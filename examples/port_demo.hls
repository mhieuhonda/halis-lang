# ============================================================================
# examples/port_demo.hls — Stage 88: x86 I/O ports
# ----------------------------------------------------------------------------
# Two halves again:
#
#   * the PATTERN — `in`/`out` are one asm template, and the narrow-
#     template rule (Stage 87/88) is what lets an `int` operand bind a
#     sub-64 register. `outb %al, %dx` moves EIGHT bits of data through
#     a SIXTEEN-bit port number, and no single carrier type expresses
#     both: the data operand is a LETTER constraint (its width comes
#     from the template's `b` suffix) and the port operand is a NAMED
#     register (`dx`, which says its own width).
#
#     The six instructions below are REAL and `probe_ports()` really
#     issues them — but nothing CALLS it, and neither does anything
#     else: a port access is PRIVILEGED, so an image run by a host with
#     IOPL clear faults on the first instruction whether it reads or
#     writes. So `main` runs the model assertions and touches no port at
#     all, and the acceptance gate disassembly-checks the real
#     instructions instead of executing them. That is the same shape as
#     the Stage 83 demo: the stub is declared, checked and lowered, and
#     the thing that runs is the part that is safe to run.
#
#   * the MODEL — `core/port.hls`: the port number as a value, the
#     architectural port map with the widths each one actually uses, the
#     PIC and PIT sequences, the PCI field widths, and the
#     I/O-serialisation delay.
# ============================================================================

#![freestanding]

import "core.port"
import "core.result"

# The three real port instructions. Each is one asm template; the only
# difference between them is the suffix, and the suffix is what decides
# the carrier type of the data operand.
fn out8(p: int, v: int) -> void {
    asm!("outb {0}, {1}", in("a") v, in("dx") p)
    return
}

fn in8(p: int) -> int {
    let mut v: int = 0
    asm!("inb {1}, {0}", out("al") v, in("dx") p)
    return v
}

fn out16(p: int, v: int) -> void {
    asm!("outw {0}, {1}", in("a") v, in("dx") p)
    return
}

fn in16(p: int) -> int {
    let mut v: int = 0
    asm!("inw {1}, {0}", out("ax") v, in("dx") p)
    return v
}

fn out32(p: int, v: int) -> void {
    asm!("outl {0}, {1}", in("a") v, in("dx") p)
    return
}

fn in32(p: int) -> int {
    let mut v: int = 0
    asm!("inl {1}, {0}", out("eax") v, in("dx") p)
    return v
}

# The Bochs/QEMU debug port: a byte written here appears on the host's
# stderr. It is the only output a freestanding kernel has before it has
# a driver for anything, and it costs one `outb`.
fn debug_putc(c: int) -> void {
    out8(debug_port(), debug_write_byte(c))
    return
}

# A I/O-serialising delay. `outb` posts a buffer-full and the device
# samples the bus up to ~50 microseconds later; a driver that polls a
# status register straight after a command must wait for it, and the
# wait is invisible in the source.
fn io_delay() -> void {
    asm!("outb {0}, {1}", in("a") 0, in("dx") 0)
    return
}

# probe_ports: the REAL port accesses, issued but never called.
#
# A port access is privileged, so an image run by a host with IOPL clear
# faults on the first `in` — which is correct hardware behaviour and
# exactly why this function is never called. It exists so the compiler
# lowers `inb`/`inw`/`inl` and `outb`/`outw`/`outl` for real, and the
# acceptance gate disassembles the result to check that it did.
fn probe_ports() -> int {
    out8(pic_cmd_port(), pic_icw1())
    out8(pic_data_port(), 32)
    let a: int = port_read(in8(pic_data_port()), PortWidth.Byte)
    out16(pit_channel0_port(), 0)
    let b: int = port_read(in16(pit_channel0_port()), PortWidth.Word)
    out32(pci_config_data_port(), 0)
    let c: int = port_read(in32(pci_config_data_port()), PortWidth.Dword)
    return a + b + c
}

fn main() -> int {
    # ------------------------------------------------------------------
    # 1. The pattern, exercised against a real port
    # ------------------------------------------------------------------
    # The debug port is a WRITE-ONLY sink, so it is safe to run anywhere.
    # It is also the only output a freestanding kernel has before it has
    # a driver for anything.
    # ------------------------------------------------------------------
    # 2. A port number is a 16-BIT quantity
    # ------------------------------------------------------------------
    if port_number_bits() != 16 {
        return 1
    }
    if port_max() != 65535 {
        return 2
    }
    if !port_is_legal(0) || !port_is_legal(65535) {
        return 3
    }
    if port_is_legal(-1) || port_is_legal(65536) {
        return 4
    }
    # The IMMEDIATE (imm8) form is a different encoding of the same
    # instruction, and it exists only for the low 256 ports.
    if !port_has_immediate(255) || port_has_immediate(256) {
        return 5
    }
    if port_imm_ok(248) != true || port_imm_ok(300) != false {
        return 6
    }

    # ------------------------------------------------------------------
    # 3. The data width, which the template's suffix decides
    # ------------------------------------------------------------------
    if port_width_name(PortWidth.Byte) != "byte" {
        return 7
    }
    if port_data_bits(PortWidth.Byte) != 8 || port_data_bits(PortWidth.Dword) != 32 {
        return 8
    }
    if port_width_suffix(PortWidth.Byte) != "b" {
        return 9
    }
    if port_width_suffix(PortWidth.Word) != "w" || port_width_suffix(PortWidth.Dword) != "l" {
        return 10
    }
    # An 8-bit read puts the byte in AL and LEAVES the rest of the
    # accumulator alone, so the mask is the driver's job.
    if port_width_mask(PortWidth.Byte) != 255 {
        return 11
    }
    if port_width_mask(PortWidth.Dword) != 4294967295 {
        return 12
    }
    if port_read(1311768467463791224, PortWidth.Dword) != 2596070008 {
        return 13
    }
    if port_read(1311768467463791224, PortWidth.Byte) != 120 {
        return 14
    }
    if port_write(1311768467294899696, PortWidth.Dword) != 2427178480 {
        return 15
    }
    if port_write(300, PortWidth.Byte) != 44 {
        return 16
    }

    # ------------------------------------------------------------------
    # 4. The PIC, and the EOI order
    # ------------------------------------------------------------------
    if pic_cmd_port() != 32 || pic_data_port() != 33 {
        return 17
    }
    if pic_slave_cmd_port() != 160 || pic_slave_data_port() != 161 {
        return 18
    }
    # ICW4's 8086 bit: a PIC left in 8085 mode does not deliver an
    # interrupt to a protected-mode kernel, and the machine runs until
    # something else faults.
    if pic_icw1() != 17 || int_shr(pic_icw1(), 4) != 1 || pic_icw1() != 16 + pic_icw4() {
        return 19
    }
    if pic_icw4_8086() != 1 {
        return 20
    }
    # The non-specific EOI is a bare 0x20 — a control word with no more
    # bits set, which is why it is the literal 32.
    if pic_ocw2_eoi() != 32 {
        return 21
    }
    # The SLAVE's EOI goes first when the interrupt arrived on IRQ
    # 8..15. The master first is the classic mistake, and the symptom is
    # an interrupt that occasionally never retires.
    if !pic_eoi_order_is_slave_first(9) {
        return 22
    }
    if pic_eoi_order_is_slave_first(7) || pic_eoi_order_is_slave_first(16) {
        return 23
    }
    if pic_ocw3_isr_read() != 11 {
        return 24
    }

    # ------------------------------------------------------------------
    # 5. The PIT: a 16-bit counter written low byte first
    # ------------------------------------------------------------------
    if pit_channel0_port() != 64 || pit_command_port() != 67 {
        return 25
    }
    if pit_freq() != 1193182 {
        return 26
    }
    if pit_divisor(100) != 11931 {
        return 27
    }
    # A divisor of 0 means 65536: the counter is 16-bit and WRAPS. Every
    # "my timer runs 256 times too fast" bug has to know that.
    if pit_divisor(1) != 65536 {
        return 28
    }
    if pit_divisor(1193182) != 1 {
        return 29
    }
    # The two bytes go LOW FIRST. That is not a convention.
    let div: int = pit_divisor(100)
    if pit_reload_low(div) != 155 || pit_reload_high(div) != 46 {
        return 30
    }
    if speaker_gate_port() != 97 || speaker_gate_bit() != 1 {
        return 31
    }

    # ------------------------------------------------------------------
    # 6. PCI: the field widths, which are all narrow and all different
    # ------------------------------------------------------------------
    if pci_config_address_port() != 248 || pci_config_data_port() != 252 {
        return 32
    }
    # Both the address and the data port are 32-bit even though the
    # bus number is 8 bits and the register is 4.
    if pci_bus_bits() != 8 || pci_register_bits() != 4 {
        return 33
    }
    if pci_device_bits() != 5 || pci_function_bits() != 3 {
        return 34
    }
    # The enable bit, the bus in bits 23..16, the device in 15..11, the
    # function in 10..8 and the register in 7..2.
    let addr: int = pci_config_address(0, 3, 0, 4)
    if addr < 2147483648 {
        return 35
    }
    if int_and(addr, 4026531840) != 2147483648 {
        return 36
    }
    # Each field has to be MASKED before it is compared: the register
    # field sits at bits 2..5 with the enable bit above it, so a bare
    # shift reads the enable bit too.
    if int_and(int_shr(addr, pci_device_shift()), 31) != 3 {
        return 37
    }
    if int_and(int_shr(addr, pci_function_shift()), 7) != 0 {
        return 38
    }
    if int_and(int_shr(addr, pci_register_shift()), 15) != 4 {
        return 39
    }
    if int_and(int_shr(addr, pci_bus_shift()), 255) != 0 {
        return 40
    }
    if pci_vendor_id_reg() != 0 || pci_command_reg() != 4 || pci_status_reg() != 6 {
        return 40
    }
    if pci_bar0_reg() != 16 {
        return 41
    }

    # ------------------------------------------------------------------
    # 7. The ACPI PM1 status is write-1-to-clear
    # ------------------------------------------------------------------
    if pm1_control_port() != 0 || pm1_enable_port() != 2 || pm1_status_port() != 4 {
        return 42
    }
    if pm1_status_write1_to_clear() != true {
        return 43
    }

    # ------------------------------------------------------------------
    # 8. The serialisation delay
    # ------------------------------------------------------------------
    # The number is a MODEL, and a test asserts the arithmetic rather
    # than a timing — a timing test is a flaky test.
    if port_delay_cycles() != 400 {
        return 44
    }
    if port_access_cost_cycles(PortWidth.Byte) != 408 {
        return 45
    }
    if port_access_cost_cycles(PortWidth.Dword) != 432 {
        return 46
    }
    return 0
}
