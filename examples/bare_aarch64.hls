# ============================================================================
# examples/bare_aarch64.hls — Stage 94 (v0.113.0-alpha)
# ----------------------------------------------------------------------------
# The bare-metal AArch64 probe for QEMU's `virt` machine:
#
#   bin/hlc --target aarch64-unknown-none examples/bare_aarch64.hls out.c
#   <aarch64 cc> -mgeneral-regs-only -ffreestanding -nostdlib \
#       -nostartfiles -ffunction-sections -fno-stack-protector \
#       -Wl,--gc-sections,-T,targets/aarch64-unknown-none.ld \
#       -o img out.c
#   qemu-system-aarch64 -M virt -cpu cortex-a72 -nographic \
#       -kernel img          # prints "bare aarch64 OK"; Ctrl-C to quit
#
# The PL011 UART at 0x09000000 (virt's console) is written through ONE
# self-contained `asm!` template: no operands, no clobber list — the
# template saves and restores the two temporary registers it uses
# (x9/x10), so the compiler's "asm! touches no registers" assumption
# (Stage 83's contract, whose named-register model is x86-64 today)
# stays true, and the default memory clobber covers the device store.
# The program itself is integer-only BY RULE: under --target the
# compiler rejects float literals and float annotations.
#
# The exit path (the naked _start's svc #0) is a Linux syscall and has
# no effect under `-bios none`; the UART line is the run's observable,
# and main's return value (42) is what a semihosting or test-device
# harness reads.
# ============================================================================

#![freestanding]

# The PL011 banner: "bare aarch64 OK\n", one template, every byte
# through w10. Fully self-contained asm: x9 (the device base) and x10
# (the byte) are saved on the entry stack and restored before the
# template returns.
fn uart_msg_raw() -> void {
    asm!("stp x9, x10, [sp, #-16]!; mov x9, #0x09000000; movz w10, #0x62; strb w10, [x9]; movz w10, #0x61; strb w10, [x9]; movz w10, #0x72; strb w10, [x9]; movz w10, #0x65; strb w10, [x9]; movz w10, #0x20; strb w10, [x9]; movz w10, #0x61; strb w10, [x9]; movz w10, #0x61; strb w10, [x9]; movz w10, #0x72; strb w10, [x9]; movz w10, #0x63; strb w10, [x9]; movz w10, #0x68; strb w10, [x9]; movz w10, #0x36; strb w10, [x9]; movz w10, #0x34; strb w10, [x9]; movz w10, #0x20; strb w10, [x9]; movz w10, #0x4f; strb w10, [x9]; movz w10, #0x4b; strb w10, [x9]; movz w10, #0x0a; strb w10, [x9]; ldp x9, x10, [sp], #16;")
}

# The integer probe the UART banner brackets: the same arithmetic the
# x86_64-unknown-none probe runs, so one exit code (42) closes all
# three bare-metal stages.
fn banner_checksum() -> int {
    let banner: list[int] = [104, 97, 108, 105, 115]  # "halis"
    let mut h: int = 7
    let mut i: int = 0
    while i < banner.len() {
        h = (h * 31 + banner.get(i)) % 268435456
        i = i + 1
    }
    return h
}

fn gcd(a: int, b: int) -> int {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}

fn main() -> int {
    uart_msg_raw()
    let cs: int = banner_checksum()
    let g: int = gcd(1071, 462)          # 21
    let primes_under_20: int = 8         # 2 3 5 7 11 13 17 19
    return cs % 10 + g + primes_under_20 + 13
}
